    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "48B(2) Retirement age of Judges etc. of the Supreme Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-48b-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.31",
      "values:originalText": "(2) An enactment that changes the retirement age in relation to an\noffice to which this section applies does not affect the term of\noffice of a person who was appointed to such an office before the\ncommencement of that enactment unless the person has consented\nin writing to the application of the enactment to him or her.",
      "skos:definition": "(2) An enactment that changes the retirement age in relation to an\noffice to which this section applies does not affect the term of\noffice of a person who was appointed to such an office before the\ncommencement of that enactment unless the person has consented\nin writing to the application of the enactment to him or her.",
      "values:partOf": {
        "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48b"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48b-ss-2-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48b-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7241415b5dd6e9d952ae6237e87046e38d8e329494391b647cd344a330d4f13b",
      "skos:note": "No change to term of office applies unless consented to in writing."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-48b-ss-2",
      "@type": "cof:Section",
      "cof:title": "48B(2) Retirement age of Judges etc. of the Supreme Court",
      "values:kind": "subsection",
      "cof:pageNumber": 31,
      "values:originalText": "(2) An enactment that changes the retirement age in relation to an\noffice to which this section applies does not affect the term of\noffice of a person who was appointed to such an office before the\ncommencement of that enactment unless the person has consented\nin writing to the application of the enactment to him or her."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48b-ss-2-norm",
