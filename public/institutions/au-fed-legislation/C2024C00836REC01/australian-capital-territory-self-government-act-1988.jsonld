    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-60",
      "@type": "cml:Concept",
      "skos:prefLabel": "60 Borrowing from Commonwealth",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-60"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.35",
      "values:originalText": "The Finance Minister may, on behalf of the Commonwealth, out of\nmoney appropriated by the Parliament for the purpose, lend money\nto the Territory or to a Territory authority on such terms and\nconditions as that Minister determines in writing.",
      "skos:definition": "The Finance Minister may, on behalf of the Commonwealth, out of\nmoney appropriated by the Parliament for the purpose, lend money\nto the Territory or to a Territory authority on such terms and\nconditions as that Minister determines in writing.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-60-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-60-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bf94b9ed7b8cf813f01e692bbcc3f4033578d65e470e8b8690ad160962e187cd",
      "skos:note": "The Finance Minister may lend money to the Territory or a Territory authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-60",
      "@type": "cof:Section",
      "cof:title": "60 Borrowing from Commonwealth",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "The Finance Minister may, on behalf of the Commonwealth, out of\nmoney appropriated by the Parliament for the purpose, lend money\nto the Territory or to a Territory authority on such terms and\nconditions as that Minister determines in writing."
    },
