      "skos:note": "Enactments made without following the entrenching law have no effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-26-ss-4",
      "@type": "cof:Section",
