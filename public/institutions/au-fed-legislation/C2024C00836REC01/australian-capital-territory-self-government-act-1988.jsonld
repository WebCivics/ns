      "skos:note": "Must arrange for notice of resignation to be laid before the Assembly."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-13-ss-3",
      "@type": "cof:Section",
      "cof:title": "13(3) Resignation of members",
      "values:kind": "subsection",
      "cof:pageNumber": 14,
      "values:originalText": "(3) The person receiving a notice of resignation must arrange for it to\nbe laid before the Assembly as soon as practicable after receiving\nthat notice."
    },
