        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-19-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "8a3f5403bd66395a46a348501b8162e1405c3504ed47501f5900efb16871d776",
      "skos:note": "Resolution of no confidence in Chief Minister requires specific conditions to be effective."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Resolution of no confidence in Chief Minister",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "A resolution of no confidence in the Chief Minister has no effect\nunless:\n(a) it affirms a motion that is expressed to be a motion of no\nconfidence in the Chief Minister;\n(b) at least one week’s notice of the motion has been given in\naccordance with the standing rules and orders; and\n(c) the resolution is passed by at least the number of members\nnecessary to be a quorum."
    },
