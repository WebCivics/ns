      "skos:note": "Qualifications of candidates must be provided by enactment.",
      "dc:description": "enactment"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-67",
      "@type": "cof:Section",
      "cof:title": "67 Qualifications of candidates",
      "values:kind": "section",
