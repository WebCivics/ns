    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-25-ss-3",
      "@type": "cof:Section",
      "cof:title": "25(3) Notification of enactment",
      "values:kind": "subsection",
