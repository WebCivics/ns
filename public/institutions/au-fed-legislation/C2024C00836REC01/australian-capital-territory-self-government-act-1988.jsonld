    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Minutes of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
