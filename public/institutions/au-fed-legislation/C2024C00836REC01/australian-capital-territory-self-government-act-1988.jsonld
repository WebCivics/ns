    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Legislative Assembly",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.12",
      "values:originalText": "(1) There shall be a Legislative Assembly for the Australian Capital\nTerritory.\n(2) The Assembly is to consist of:\n(a) such number of members as is provided by enactment\n(subject to subsection (3)); or\n(b) until provision is made—17 members.\n(3) An enactment providing for the number of members of the\nAssembly (or an enactment amending or repealing such an\nenactment) has no effect unless it is passed by a number of\nmembers at least equal to two-thirds of the number of members\nprovided for, at that time, by or in accordance with subsection (2).\n(4) Subsection (3) has effect despite anything else in this Act.",
      "skos:definition": "(1) There shall be a Legislative Assembly for the Australian Capital\nTerritory.\n(2) The Assembly is to consist of:\n(a) such number of members as is provided by enactment\n(subject to subsection (3)); or\n(b) until provision is made—17 members.\n(3) An enactment providing for the number of members of the\nAssembly (or an enactment amending or repealing such an\nenactment) has no effect unless it is passed by a number of\nmembers at least equal to two-thirds of the number of members\nprovided for, at that time, by or in accordance with subsection (2).\n(4) Subsection (3) has effect despite anything else in this Act.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-8-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-8-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-8-ss-3"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-8-ss-4"
        }
      ],
      "cml:integrityHash": "06d51d8b64021d0254b0f9b35a0f8e0ec43a56e8baab3916141407f2c8781921"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Legislative Assembly",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "(1) There shall be a Legislative Assembly for the Australian Capital\nTerritory.\n(2) The Assembly is to consist of:\n(a) such number of members as is provided by enactment\n(subject to subsection (3)); or\n(b) until provision is made—17 members.\n(3) An enactment providing for the number of members of the\nAssembly (or an enactment amending or repealing such an\nenactment) has no effect unless it is passed by a number of\nmembers at least equal to two-thirds of the number of members\nprovided for, at that time, by or in accordance with subsection (2).\n(4) Subsection (3) has effect despite anything else in this Act."
    },
