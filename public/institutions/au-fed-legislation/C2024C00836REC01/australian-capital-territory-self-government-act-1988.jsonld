    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-25-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "25(4) Notification of enactment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-25-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.21",
      "values:originalText": "(4) Where, on the day of publication of the notice under subsection (1)\nof the passing of a proposed law, there are no copies of the law\navailable for purchase at the place, or at one or more of the places,\nspecified in the notice, the Chief Minister shall cause to be laid\nbefore the Assembly, within 15 sitting days of the Assembly after\nthat day, a statement that copies of the law were not so available\nand the reason why they were not so available.",
      "skos:definition": "(4) Where, on the day of publication of the notice under subsection (1)\nof the passing of a proposed law, there are no copies of the law\navailable for purchase at the place, or at one or more of the places,\nspecified in the notice, the Chief Minister shall cause to be laid\nbefore the Assembly, within 15 sitting days of the Assembly after\nthat day, a statement that copies of the law were not so available\nand the reason why they were not so available.",
      "values:partOf": {
        "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-25"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-25-ss-4-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-25-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aaa41986a85c9d63705111e8170e9faf1844251af82bc53fc2c43fd127ab02ba",
      "skos:note": "Chief Minister must provide a statement about law availability.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-25-ss-4",
      "@type": "cof:Section",
      "cof:title": "25(4) Notification of enactment",
      "values:kind": "subsection",
      "cof:pageNumber": 21,
      "values:originalText": "(4) Where, on the day of publication of the notice under subsection (1)\nof the passing of a proposed law, there are no copies of the law\navailable for purchase at the place, or at one or more of the places,\nspecified in the notice, the Chief Minister shall cause to be laid\nbefore the Assembly, within 15 sitting days of the Assembly after\nthat day, a statement that copies of the law were not so available\nand the reason why they were not so available."
    },
