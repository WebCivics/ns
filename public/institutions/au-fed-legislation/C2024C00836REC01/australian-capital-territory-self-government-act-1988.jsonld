    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-69a",
      "@type": "cml:Concept",
      "skos:prefLabel": "69A Acts that bind States to bind Territory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-69a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.39",
      "values:originalText": "(1) If an Act (whether or not by express provision) binds each of the\nStates, or the Crown in right of each of the States, that Act binds\nthe Territory, or the Crown in right of the Territory, by force of this\nsubsection, unless that Act specifically provides otherwise.\n(2) Subsection (1) does not affect the application of a law of the\nCommonwealth in and in relation to the Territory otherwise than as\nprovided in that subsection.",
      "skos:definition": "(1) If an Act (whether or not by express provision) binds each of the\nStates, or the Crown in right of each of the States, that Act binds\nthe Territory, or the Crown in right of the Territory, by force of this\nsubsection, unless that Act specifically provides otherwise.\n(2) Subsection (1) does not affect the application of a law of the\nCommonwealth in and in relation to the Territory otherwise than as\nprovided in that subsection.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-69a-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-69a-ss-2"
        }
      ],
      "cml:integrityHash": "9240dc63a82041514dc492ff7bd63e16ef91a62270f0a2544d54021b32797b26"
    },
