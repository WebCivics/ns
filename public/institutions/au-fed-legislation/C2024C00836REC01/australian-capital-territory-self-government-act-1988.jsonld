    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Meaning of day on which result of election declared",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.10",
      "values:originalText": "Where the results of a general election are declared on different\ndays, a reference in this Act to the day on which the result of the\nelection is declared is a reference to the last of those days.",
      "skos:definition": "Where the results of a general election are declared on different\ndays, a reference in this Act to the day on which the result of the\nelection is declared is a reference to the last of those days.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-5-norm"
        }
      ],
      "cml:integrityHash": "2adc23b783f736718d0ae124a8089c442d183f17e4de007d7d588265b92fae97",
      "skos:note": "Reference to declaration day is last of multiple days"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Meaning of day on which result of election declared",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Where the results of a general election are declared on different\ndays, a reference in this Act to the day on which the result of the\nelection is declared is a reference to the last of those days."
    },
