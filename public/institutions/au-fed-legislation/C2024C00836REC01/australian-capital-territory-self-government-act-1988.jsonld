    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Meaning of day on which election held",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.10",
      "values:originalText": "A reference in this Act to the day on which an election has been, is,\nor is to be, held, is a reference to the polling day for that election.",
      "skos:definition": "A reference in this Act to the day on which an election has been, is,\nor is to be, held, is a reference to the polling day for that election.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-4-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cb3b963f87a9c598b8d7fb327fd40cca115b7fe3f60d4dec58691d908ec95035",
      "skos:note": "Reference to polling day for an election is a reference to the day on which the election has been, is, or is to be held."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Meaning of day on which election held",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "A reference in this Act to the day on which an election has been, is,\nor is to be, held, is a reference to the polling day for that election."
    },
    {
