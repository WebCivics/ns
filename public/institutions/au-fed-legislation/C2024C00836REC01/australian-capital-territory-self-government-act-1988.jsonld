    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Conflict of interest",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.15",
      "values:originalText": "(1) A member of the Assembly who is a party to, or has a direct or\nindirect interest in, a contract made by or on behalf of the Territory\nor a Territory authority shall not take part in a discussion of a\nmatter, or vote on a question, in a meeting of the Assembly where\nthe matter or question relates directly or indirectly to that contract.\n(2) A question concerning the application of subsection (1) shall be\ndecided by the Assembly, and a contravention of that subsection\ndoes not invalidate anything done by the Assembly.",
      "skos:definition": "(1) A member of the Assembly who is a party to, or has a direct or\nindirect interest in, a contract made by or on behalf of the Territory\nor a Territory authority shall not take part in a discussion of a\nmatter, or vote on a question, in a meeting of the Assembly where\nthe matter or question relates directly or indirectly to that contract.\n(2) A question concerning the application of subsection (1) shall be\ndecided by the Assembly, and a contravention of that subsection\ndoes not invalidate anything done by the Assembly.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-15-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-15-ss-2"
        }
      ],
      "cml:integrityHash": "00174b8e53dd25d082d3cc7d88348c09bd8c3ac73778a49392bddd16f8ed4de1"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Conflict of interest",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(1) A member of the Assembly who is a party to, or has a direct or\nindirect interest in, a contract made by or on behalf of the Territory\nor a Territory authority shall not take part in a discussion of a\nmatter, or vote on a question, in a meeting of the Assembly where\nthe matter or question relates directly or indirectly to that contract.\n(2) A question concerning the application of subsection (1) shall be\ndecided by the Assembly, and a contravention of that subsection\ndoes not invalidate anything done by the Assembly."
    },
