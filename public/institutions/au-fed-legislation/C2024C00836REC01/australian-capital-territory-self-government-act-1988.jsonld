        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Spreads benefits to dependants upon ceasing office, permanent or temporary disability, or death.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iii) benefits for dependants of a person who is or was a member in the event of the death of the person;",
      "cml:conclusionText": "...benefits for dependants of a person who is or was a member in the event of the death of the person."
    },
    {
