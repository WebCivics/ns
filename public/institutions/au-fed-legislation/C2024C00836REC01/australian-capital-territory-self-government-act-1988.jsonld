    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "48AA ACT laws may give concurrent jurisdiction to the Federal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-48aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.31",
      "values:originalText": "Court of Australia\nNothing in section 48A is to be taken to imply that a law of the\nAustralian Capital Territory may not confer on the Federal Court of\nAustralia original or appellate jurisdiction in any matter in respect\nof which, by virtue of section 48A, jurisdiction is conferred on the\nSupreme Court.",
      "skos:definition": "Court of Australia\nNothing in section 48A is to be taken to imply that a law of the\nAustralian Capital Territory may not confer on the Federal Court of\nAustralia original or appellate jurisdiction in any matter in respect\nof which, by virtue of section 48A, jurisdiction is conferred on the\nSupreme Court.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48aa-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "65d066d9d9932939b3deaf8054491329fe1f20dddc3e3778028776c9fb1e794a",
      "skos:note": "Jurisdiction may be given to the Federal Court of Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-48aa",
      "@type": "cof:Section",
      "cof:title": "48AA ACT laws may give concurrent jurisdiction to the Federal",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Court of Australia\nNothing in section 48A is to be taken to imply that a law of the\nAustralian Capital Territory may not confer on the Federal Court of\nAustralia original or appellate jurisdiction in any matter in respect\nof which, by virtue of section 48A, jurisdiction is conferred on the\nSupreme Court."
    },
    {
