    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1",
      "@type": "cml:Concept",
      "dc:source": "criminal-code-amendment-hate-crimes-act-2025.pdf, p.13",
      "skos:note": "Threatening a person from a targeted group can lead to imprisonment for 7 years.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "80(1) Section 80"
      },
      "wasDerivedFrom": "criminal-code-amendment-hate-crimes-act-2025.pdf",
      "asserts": [
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-norm",
