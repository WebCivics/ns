    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1",
      "@type": "cml:Concept",
      "dc:source": "criminal-code-amendment-hate-crimes-act-2025.pdf, p.15",
      "skos:note": "Advocating hate speech that threatens public peace and order is a crime.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "80(1) Section 80"
      },
      "wasDerivedFrom": "criminal-code-amendment-hate-crimes-act-2025.pdf",
      "asserts": [
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-norm",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-1",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-2",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-3",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-4",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "bc256691c0ae8e6d9fb52e9005db554c09cdec707b5329c7fd9baf2670f2b24e",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:criminal-code-amendment-hate-crimes-act-2025#sch-1-sec-80-5-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5"
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they advocate hate speech.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits advocating hate speech.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The person advocates the causing of damage to, or the destruction of, real property or a motor vehicle."
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they are reckless in their advocacy of hate speech.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits reckless advocacy of hate speech.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The first person is reckless as to whether the damage or destruction will occur;"
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they advocate harm that threatens public peace and order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits advocating harm that threatens public peace and order.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "the damage or destruction, if it were to occur, would threaten the peace, order and good government of the Commonwealth."
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they advocate harm to protected groups.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits advocating harm to protected groups.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "the targeted group is distinguished by race, religion, sex, sexual orientation, gender identity, intersex status, disability, nationality, national or ethnic origin or political opinion;"
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they are reckless in their advocacy of harm to protected groups.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits reckless advocacy of harm to protected groups.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The first person is reckless as to whether the damage or destruction will occur;"
    },
