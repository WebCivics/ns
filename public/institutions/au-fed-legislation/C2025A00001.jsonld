        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-alleninterval-2",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-ltl-3",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-deontic-4",
        "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "353342409938f8f5ad35c99892702dc72fc7329da010c742830df912e44f49ae",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:criminal-code-amendment-hate-crimes-act-2025#sch-1-sec-80-4-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4"
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The threat, if carried out, would threaten the peace, order and good government of the Commonwealth.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The threat must overlap with the targeted group.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(d) a reasonable member of the targeted group would fear that the threat will be carried out;"
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(e) the threat, if carried out, would threaten the peace, order and good government of the Commonwealth.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits threatening a person from a targeted group.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the first person threatens to use force or violence against a person (the targeted person); and"
    },
    {
      "@id": "concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-4-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if: (a) the first person threatens to use force or violence against a person (the targeted person); and",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
