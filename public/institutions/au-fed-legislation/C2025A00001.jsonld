      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 5 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits advocating damage to real property or a motor vehicle due to targeted group characteristics.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) A person (the first person) commits an offence if: (a) the first person advocates the causing of damage to, or the destruction of, real property or a motor vehicle; and"
    },
