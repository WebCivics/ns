    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibit";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits reckless advocacy of hate speech.";
    <https://ns.webcivics.net/cml/premiseText> "The first person is reckless as to whether the damage or destruction will occur;";
    <https://ns.webcivics.net/cml/conclusionText> "The person commits an offence if they are reckless in their advocacy of hate speech.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
