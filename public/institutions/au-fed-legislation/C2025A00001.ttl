    <https://ns.webcivics.net/cml/operator> "Prohibit";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits advocating hate speech.";
    <https://ns.webcivics.net/cml/premiseText> "The person advocates the causing of damage to, or the destruction of, real property or a motor vehicle.";
    <https://ns.webcivics.net/cml/conclusionText> "The person commits an offence if they advocate hate speech.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
