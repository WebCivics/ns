concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-6-ss-5 a cml:Concept ;
    skos:prefLabel "80(5) 2BD  Threatening damage to or destruction of real property or"@en ;
    cml:realizedBy doc:sch-1-sec-80-6-ss-5 ;
    values:originalText "(5) Strict liability applies to paragraphs (1)(d) and (2)(d).  Schedule 1  Amendments  Criminal Code Amendment (Hate Crimes) Act 2025 No. 1, 2025" ;
