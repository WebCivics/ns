concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-2 a cml:Concept ;
    skos:prefLabel "2 Section 80.1A of the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-2 ;
    values:originalText "Insert: carer or assistant has the same meaning as in the Disability Discrimination Act 1992. close associate of a person means: (a) in any case—a close family member of the person; or (b) if the person is a person with a disability—a carer or assistant in relation to the person. close family member has the same meaning as in Division 102. damage does not include minor damage. disability has the same meaning as in the Disability Discrimination Act 1992.  Schedule 1  Amendments  Criminal Code Amendment (Hate Crimes) Act 2025 No. 1, 2025" ;
    skos:definition "Insert: carer or assistant has the same meaning as in the Disability Discrimination Act 1992. close associate of a person means: (a) in any case—a close family member of the person; or (b) if the person is a person with a disability—a carer or assistant in relation to the person. close family member has the same meaning as in Division 102. damage does not include minor damage. disability has the same meaning as in the Disability Discrimination Act 1992.  Schedule 1  Amendments  Criminal Code Amendment (Hate Crimes) Act 2025 No. 1, 2025"@en ;
    cml:integrityHash "f61dac737fbb977453f6463e6266641e7723865c63bc473978b487a120076559" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Defines terms related to disability and close associates." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <criminal-code-amendment-hate-crimes-act-2025.pdf> ;
    dc:source "criminal-code-amendment-hate-crimes-act-2025.pdf, p.7" ;
