    cml:premiseText "(d) the threat, if carried out, would threaten the peace,..." ;
    cml:conclusionText "The person must not carry out the threat." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

