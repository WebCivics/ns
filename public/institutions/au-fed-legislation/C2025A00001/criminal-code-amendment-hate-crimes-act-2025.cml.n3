concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-6-ss-4 a cml:Concept ;
    skos:prefLabel "80(4) 2BD  Threatening damage to or destruction of real property or"@en ;
    cml:realizedBy doc:sch-1-sec-80-6-ss-4 ;
    values:originalText "(4) The fault element for paragraphs (1)(c) and (2)(c) is recklessness. Note: For recklessness, see section 5.4." ;
    skos:definition "(4) The fault element for paragraphs (1)(c) and (2)(c) is recklessness. Note: For recklessness, see section 5.4."@en ;
