concept:criminal-code-amendment-hate-crimes-act-2025-sch-2-sec-7 a cml:Concept ;
    skos:prefLabel "7 Application provision"@en ;
    cml:realizedBy doc:sch-2-sec-7 ;
    values:originalText "The amendments made by this Schedule apply in relation to a conviction that occurs on or after the commencement of this item if the conduct constituting the offence occurs wholly on or after that commencement.  Mandatory minimum sentences and maximum penalties  Schedule 2  No. 1, 2025 Criminal Code Amendment (Hate Crimes) Act 2025" ;
    skos:definition "The amendments made by this Schedule apply in relation to a conviction that occurs on or after the commencement of this item if the conduct constituting the offence occurs wholly on or after that commencement.  Mandatory minimum sentences and maximum penalties  Schedule 2  No. 1, 2025 Criminal Code Amendment (Hate Crimes) Act 2025"@en ;
    cml:integrityHash "e4994e9fe90b750db454d5c5ba5910baa4a93fbc226b6568a25f413a82f43cb7" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Commencement provision for application of amendments" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
