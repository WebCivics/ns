doc:sch-1-sec-80-3-ss-1 a cof:Section ;
    cof:title "80(1) 2BA  Threatening force or violence against groups" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if: (a) the person threatens to use force or violence against a group (the targeted group); and  Schedule 1  Amendments  Criminal Code Amendment (Hate Crimes) Act 2025 No. 1, 2025 (b) the targeted group is distinguished by race, religion, sex, sexual orientation, gender identity, intersex status, disability, nationality, national or ethnic origin or political opinion; and (c) a reasonable member of the targeted group would fear that the threat will be carried out; and (d) the threat, if carried out, would threaten the peace, order and good government of the Commonwealth. Note: For intention, see section 5.2. Penalty: Imprisonment for 7 years." ;
    cof:pageNumber "11"^^xsd:integer .

concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-3-ss-2 a cml:Concept ;
    skos:prefLabel "80(2) 2BA  Threatening force or violence against groups"@en ;
    cml:realizedBy doc:sch-1-sec-80-3-ss-2 ;
