concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5-ss-6 a cml:Concept ;
    skos:prefLabel "80(6) 2BC  Advocating damage to or destruction of real property or"@en ;
    cml:realizedBy doc:sch-1-sec-80-5-ss-6 ;
    values:originalText "(6) Subsection (7) applies if, in a prosecution for an offence (the prosecuted offence) against subsection (1), the trier of fact: (a) is not satisfied that the defendant is guilty of the offence; but (b) is satisfied beyond reasonable doubt that the defendant is guilty of an offence (the alternative offence) against subsection (2)." ;
    skos:definition "(6) Subsection (7) applies if, in a prosecution for an offence (the prosecuted offence) against subsection (1), the trier of fact: (a) is not satisfied that the defendant is guilty of the offence; but (b) is satisfied beyond reasonable doubt that the defendant is guilty of an offence (the alternative offence) against subsection (2)."@en ;
    cml:integrityHash "387992d1f07ae9fd3540d481e000e059c38c9fdacc3edbac20d5c45d7ce2977f" ;
    values:partOf concept:criminal-code-amendment-hate-crimes-act-2025-sch-1-sec-80-5 ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Prosecution must consider alternative offence beyond reasonable doubt" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <criminal-code-amendment-hate-crimes-act-2025.pdf> ;
    dc:source "criminal-code-amendment-hate-crimes-act-2025.pdf, p.15" ;
