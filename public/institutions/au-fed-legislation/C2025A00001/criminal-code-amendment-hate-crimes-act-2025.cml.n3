    skos:prefLabel "2A Subdivision C of Division 80 of Part 5.1 of the Criminal"@en ;
    cml:realizedBy doc:sch-1-sec-2a ;
    values:originalText "Code (heading) Omit “Urging violence”, substitute “Urging or threatening violence, offences against groups or members of groups”." ;
