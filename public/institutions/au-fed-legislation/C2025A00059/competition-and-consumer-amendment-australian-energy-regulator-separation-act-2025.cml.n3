concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 After subsection 44AE(1)"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Insert: (1A) For the purposes of the finance law (within the meaning of the Public Governance, Performance and Accountability Act 2013): (a) the AER is a listed entity; and (b) the AER members are the accountable authority of the AER; and (c) the following persons are officials of the AER: (i) the AER members; (ii) the staff of the AER referred to in section 44AAC; (iii) persons assisting the AER referred to in section 44AACA; (iv) consultants engaged under section 44AACB; and (d) the purposes of the AER include the functions of the AER under Division 3 of this Part." ;
    skos:definition "Insert: (1A) For the purposes of the finance law (within the meaning of the Public Governance, Performance and Accountability Act 2013): (a) the AER is a listed entity; and (b) the AER members are the accountable authority of the AER; and (c) the following persons are officials of the AER: (i) the AER members; (ii) the staff of the AER referred to in section 44AAC; (iii) persons assisting the AER referred to in section 44AACA; (iv) consultants engaged under section 44AACB; and (d) the purposes of the AER include the functions of the AER under Division 3 of this Part."@en ;
    cml:integrityHash "fc0522d2eb8b8ca65c05e608f0fb04295a68a76adf0609bad9992b86fe4e45b5" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Defines AER officials and purposes" ;
