    {
      "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Subdivision B of Division 4 of Part IIIAA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
