    {
      "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Section 44AB",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf, p.7",
      "values:originalText": "Insert:\n\nSchedule 1  Main amendments\n\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025\nNo. 59, 2025\nAER State/Territory energy law means any of the following laws:\n(a) a uniform energy law that applies as a law of a State or\nTerritory;\n(b) a law of a State or Territory that applies a law mentioned in\nparagraph (a) as a law of its own jurisdiction;\n(c) any other provisions of a law of a State or Territory that:\n(i) relate to energy; and\n(ii) are prescribed by the regulations for the purposes of this\nparagraph;\nbeing those provisions as in force from time to time.",
      "skos:definition": "Insert:\n\nSchedule 1  Main amendments\n\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025\nNo. 59, 2025\nAER State/Territory energy law means any of the following laws:\n(a) a uniform energy law that applies as a law of a State or\nTerritory;\n(b) a law of a State or Territory that applies a law mentioned in\nparagraph (a) as a law of its own jurisdiction;\n(c) any other provisions of a law of a State or Territory that:\n(i) relate to energy; and\n(ii) are prescribed by the regulations for the purposes of this\nparagraph;\nbeing those provisions as in force from time to time.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-4-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "4e9bac0c35d99f533f5d3c7133fe37ca15a7d6ce7191c01ba191e0b48ab56136",
      "skos:note": "Defines AER State/Territory energy law"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Section 44AB",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\nSchedule 1  Main amendments\n\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025\nNo. 59, 2025\nAER State/Territory energy law means any of the following laws:\n(a) a uniform energy law that applies as a law of a State or\nTerritory;\n(b) a law of a State or Territory that applies a law mentioned in\nparagraph (a) as a law of its own jurisdiction;\n(c) any other provisions of a law of a State or Territory that:\n(i) relate to energy; and\n(ii) are prescribed by the regulations for the purposes of this\nparagraph;\nbeing those provisions as in force from time to time."
    },
