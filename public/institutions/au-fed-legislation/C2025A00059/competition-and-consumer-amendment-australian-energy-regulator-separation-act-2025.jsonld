    {
      "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After subsection 6A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf, p.7",
      "values:originalText": "Insert:\n(1AA) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Commission is a listed entity; and\n(b) the Chairperson is the accountable authority of the\nCommission; and\n(c) the following persons are officials of the Commission:\n(i) the Chairperson;\n(ii) the other members of the Commission;\n(iii) the associate members of the Commission;\n(iv) persons engaged under section 27; and\n(d) the purposes of the Commission include the functions\nconferred on the Commission by this Act.",
      "skos:definition": "Insert:\n(1AA) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Commission is a listed entity; and\n(b) the Chairperson is the accountable authority of the\nCommission; and\n(c) the following persons are officials of the Commission:\n(i) the Chairperson;\n(ii) the other members of the Commission;\n(iii) the associate members of the Commission;\n(iv) persons engaged under section 27; and\n(d) the purposes of the Commission include the functions\nconferred on the Commission by this Act.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-1-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "db47cb50c857644116e8e30909739c86f0e942087625e01b7c6d91ffff11d014",
      "skos:note": "Commission is a listed entity, Chairperson is accountable authority, and officials are defined."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 After subsection 6A(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n(1AA) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Commission is a listed entity; and\n(b) the Chairperson is the accountable authority of the\nCommission; and\n(c) the following persons are officials of the Commission:\n(i) the Chairperson;\n(ii) the other members of the Commission;\n(iii) the associate members of the Commission;\n(iv) persons engaged under section 27; and\n(d) the purposes of the Commission include the functions\nconferred on the Commission by this Act."
    },
