    {
      "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Paragraph 44AAFA(2)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf, p.11",
      "values:originalText": "Repeal the paragraph, substitute:\n(c) appear before:\n(i) the AER; or\n(ii) a specified member of the staff of the AER who is an\nSES employee or an acting SES employee; or\n(iii) a specified person assisting the AER, referred to in\nsection 44AACA, who is an SES employee or an acting\nSES employee;\nto give any such evidence (either orally or in writing) and\nproduce any such documents.\n\nSchedule 1  Main amendments\n\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025\nNo. 59, 2025",
      "skos:definition": "Repeal the paragraph, substitute:\n(c) appear before:\n(i) the AER; or\n(ii) a specified member of the staff of the AER who is an\nSES employee or an acting SES employee; or\n(iii) a specified person assisting the AER, referred to in\nsection 44AACA, who is an SES employee or an acting\nSES employee;\nto give any such evidence (either orally or in writing) and\nproduce any such documents.\n\nSchedule 1  Main amendments\n\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025\nNo. 59, 2025",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-23-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-1-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "124cafc4ef5bff9d5bfe2c854e2671afa47ed60e3451189ae87ef19d9b760df8",
      "skos:note": "Provide evidence and documents upon request",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-1-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Paragraph 44AAFA(2)(c)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the paragraph, substitute:\n(c) appear before:\n(i) the AER; or\n(ii) a specified member of the staff of the AER who is an\nSES employee or an acting SES employee; or\n(iii) a specified person assisting the AER, referred to in\nsection 44AACA, who is an SES employee or an acting\nSES employee;\nto give any such evidence (either orally or in writing) and\nproduce any such documents.\n\nSchedule 1  Main amendments\n\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025\nNo. 59, 2025"
    },
