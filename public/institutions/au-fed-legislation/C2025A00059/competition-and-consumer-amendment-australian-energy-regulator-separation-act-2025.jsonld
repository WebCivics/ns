    {
      "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nMain amendments  Schedule 1\n\nNo. 59, 2025\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nMain amendments  Schedule 1\n\nNo. 59, 2025\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sec-3-norm"
        }
      ],
      "cml:integrityHash": "e0daedf34cbdaf3dad11ed46725f4789a55b7643f81e77ae559afd6345aa4a4d",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nMain amendments  Schedule 1\n\nNo. 59, 2025\nCompetition and Consumer Amendment (Australian Energy Regulator\nSeparation) Act 2025"
    },
