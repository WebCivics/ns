          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-2-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "48f185621db5204aa434188f5502ebf04b2c964302b0a24202018f0d67ec8575",
      "skos:note": "Delegation continues in force after commencement day."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-2-sec-2",
