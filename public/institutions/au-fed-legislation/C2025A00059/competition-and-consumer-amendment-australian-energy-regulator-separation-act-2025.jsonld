    {
      "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Transfer of documents to the AER",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025.pdf, p.15",
      "values:originalText": "(1)\nThis item applies to a document if:\n(a) immediately before the commencement day, the document\nwas in the possession of the Commission; and\n(b) the document was:\n(i) given to or received by the Commission; or\n(ii) brought into existence;\nin relation to the performance of a function of the AER under\nDivision 3 of Part IIIAA of the Competition and Consumer\nAct 2010.\n(2)\nThe documents may be transferred to the AER on or after the\ncommencement day.\nNote:\nAny documents transferred are Commonwealth records for the purposes of the Archives\nAct 1983.",
      "skos:definition": "(1)\nThis item applies to a document if:\n(a) immediately before the commencement day, the document\nwas in the possession of the Commission; and\n(b) the document was:\n(i) given to or received by the Commission; or\n(ii) brought into existence;\nin relation to the performance of a function of the AER under\nDivision 3 of Part IIIAA of the Competition and Consumer\nAct 2010.\n(2)\nThe documents may be transferred to the AER on or after the\ncommencement day.\nNote:\nAny documents transferred are Commonwealth records for the purposes of the Archives\nAct 1983.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-2-sec-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025-sch-2-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8faa14f61f4e89483c2dcf3726ec4df3fccdbf2be8cc8e70fc15a88dbff74cfb",
      "skos:note": "Transfer of documents to the AER is obligatory for documents in certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-australian-energy-regulator-separation-act-2025#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Transfer of documents to the AER",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(1)\nThis item applies to a document if:\n(a) immediately before the commencement day, the document\nwas in the possession of the Commission; and\n(b) the document was:\n(i) given to or received by the Commission; or\n(ii) brought into existence;\nin relation to the performance of a function of the AER under\nDivision 3 of Part IIIAA of the Competition and Consumer\nAct 2010.\n(2)\nThe documents may be transferred to the AER on or after the\ncommencement day.\nNote:\nAny documents transferred are Commonwealth records for the purposes of the Archives\nAct 1983."
    },
