    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-67-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) The Director-General may, in writing, make a declaration (a data sharing declaration) under this subsection if the Director-General is satisfied that: (a) there is a severe and immediate, or severe and unforeseen, threat to public health; and (b) making the declaration is necessary to respond to the threat.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide a data sharing declaration.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) there is a severe and immediate, or severe and unforeseen, threat to public health; (b) making the declaration is necessary to respond to the threat."
    },
