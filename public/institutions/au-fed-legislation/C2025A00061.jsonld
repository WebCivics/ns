    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The appointment provision has a temporal relation with the Minister's power.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between appointment and Ministerial power",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "hasTemporalRelation",
      "cml:premiseText": "(1) There is to be a Director-General of the Australian Centre for Disease Control."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-1-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The appointment provision implies that the Minister's authority is affected.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of appointment on Ministerial authority",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "hasImplication",
      "cml:premiseText": "(1) There is to be a Director-General of the Australian Centre for Disease Control."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister has an obligation to appoint a Director-General.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Appointment obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "(1) There is to be a Director-General of the Australian Centre for Disease Control."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister must appoint a Director-General.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Appointment duty",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "(1) There is to be a Director-General of the Australian Centre for Disease Control."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The obligation to appoint a Director-General diffuses from the Minister to the Director-General.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
