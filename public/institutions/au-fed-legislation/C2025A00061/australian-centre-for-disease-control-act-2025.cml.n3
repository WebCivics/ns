doc:sec-23-ss-1 a cof:Section ;
    cof:title "23(1) Rules may make provision about publication of public health" ;
    values:kind "subsection" ;
    values:originalText "(1) The rules may make provision in relation to the publication of advice under section 21." ;
    cof:pageNumber "31"^^xsd:integer .

concept:australian-centre-for-disease-control-act-2025-sec-23-ss-2 a cml:Concept ;
    skos:prefLabel "23(2) Rules may make provision about publication of public health"@en ;
    cml:realizedBy doc:sec-23-ss-2 ;
    values:originalText "(2) Without limiting subsection (1), rules made for the purposes of that subsection may do any of the following: (a) provide that advice may only be published under section 21 after the end of a specified period after the advice was given (which must not be longer than the 30-day period mentioned in subsection 21(1)); (b) require the Director-General to inform a recipient of advice that the advice is proposed to be published under section 21; (c) provide for consultation that the Director-General must carry out before publishing advice under section 21; (d) provide for and in relation to procedures for publishing advice under section 21." ;
    skos:definition "(2) Without limiting subsection (1), rules made for the purposes of that subsection may do any of the following: (a) provide that advice may only be published under section 21 after the end of a specified period after the advice was given (which must not be longer than the 30-day period mentioned in subsection 21(1)); (b) require the Director-General to inform a recipient of advice that the advice is proposed to be published under section 21; (c) provide for consultation that the Director-General must carry out before publishing advice under section 21; (d) provide for and in relation to procedures for publishing advice under section 21."@en ;
    cml:integrityHash "cb64f59c21f7f039539f833ab4cc7af7dc7f14d36ac5f412bfa843d2c7634521" ;
    values:partOf concept:australian-centre-for-disease-control-act-2025-sec-23 ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Rules may require the Director-General to inform a recipient of advice that is proposed to be published under section 21." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-disease-control-act-2025.pdf> ;
    dc:source "australian-centre-for-disease-control-act-2025.pdf, p.31" ;
