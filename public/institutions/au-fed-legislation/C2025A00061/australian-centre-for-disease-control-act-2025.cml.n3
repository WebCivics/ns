    cml:hasPart concept:australian-centre-for-disease-control-act-2025-sec-24-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-disease-control-act-2025.pdf> ;
    dc:source "australian-centre-for-disease-control-act-2025.pdf, p.32" .
