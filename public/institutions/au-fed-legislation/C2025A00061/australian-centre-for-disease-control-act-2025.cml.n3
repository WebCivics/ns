doc:sec-77-ss-2 a cof:Section ;
    cof:title "77(2) Protection from liability etc." ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply in relation to a designated secrecy law. Authorised collection, use or disclosure does not result in liability for civil proceedings" ;
    cof:pageNumber "70"^^xsd:integer .

concept:australian-centre-for-disease-control-act-2025-sec-77-ss-3 a cml:Concept ;
    skos:prefLabel "77(3) Protection from liability etc."@en ;
    cml:realizedBy doc:sec-77-ss-3 ;
    values:originalText "(3) A person is not liable to civil proceedings for loss, damage or injury of any kind suffered by another person as a result of the person collecting, using or disclosing information in accordance with this Act. Authorised collection, use or disclosure does not contravene medical or other professional standards" ;
    skos:definition "(3) A person is not liable to civil proceedings for loss, damage or injury of any kind suffered by another person as a result of the person collecting, using or disclosing information in accordance with this Act. Authorised collection, use or disclosure does not contravene medical or other professional standards"@en ;
