doc:sec-72-ss-1 a cof:Section ;
    cof:title "72(1) Compensation for acquisition of property" ;
    values:kind "subsection" ;
    values:originalText "(1) If the operation of this Part would result in an acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) from a person otherwise than on just terms (within the meaning of that paragraph), the Commonwealth is liable to pay a reasonable amount of compensation to the person." ;
    cof:pageNumber "65"^^xsd:integer .

concept:australian-centre-for-disease-control-act-2025-sec-72-ss-2 a cml:Concept ;
    skos:prefLabel "72(2) Compensation for acquisition of property"@en ;
    cml:realizedBy doc:sec-72-ss-2 ;
    values:originalText "(2) If the Commonwealth and the person do not agree on the amount of the compensation, the person may institute proceedings in the Federal Court of Australia or the Supreme Court of a State or Territory for the recovery from the Commonwealth of such reasonable amount of compensation as the court determines." ;
    skos:definition "(2) If the Commonwealth and the person do not agree on the amount of the compensation, the person may institute proceedings in the Federal Court of Australia or the Supreme Court of a State or Territory for the recovery from the Commonwealth of such reasonable amount of compensation as the court determines."@en ;
    cml:integrityHash "97fc3894df89cad209e2ea14e07bae64fa24be9534c676039ea330024f543b17" ;
    values:partOf concept:australian-centre-for-disease-control-act-2025-sec-72 ;
    cof:pageNumber "65"^^xsd:integer ;
    skos:note "Compensation for acquisition of property if Commonwealth and person disagree on amount." ;
