concept:australian-centre-for-disease-control-act-2025-sec-48 a cml:Concept ;
    skos:prefLabel "48 Civil penalty for failure to comply with direction"@en ;
    cml:realizedBy doc:sec-48 ;
    values:originalText "A person is liable to a civil penalty if: (a) the person is given a direction under subsection 45(1) that requires the person to give information, or information in a class of information, to the Director-General; and (b) the person has the information; and (c) the person fails to comply with the direction. Note: This section is a continuing civil penalty provision under section 93 of the Regulatory Powers Act. Civil penalty: 60 penalty units." ;
    skos:definition "A person is liable to a civil penalty if: (a) the person is given a direction under subsection 45(1) that requires the person to give information, or information in a class of information, to the Director-General; and (b) the person has the information; and (c) the person fails to comply with the direction. Note: This section is a continuing civil penalty provision under section 93 of the Regulatory Powers Act. Civil penalty: 60 penalty units."@en ;
    cml:integrityHash "870deba1dc0c349920f815e09c7c36d4021c921b287b172f3611b3ee43997a16" ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "Failure to comply with direction results in civil penalty." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-disease-control-act-2025.pdf> ;
    dc:source "australian-centre-for-disease-control-act-2025.pdf, p.48" ;
    cml:asserts concept:australian-centre-for-disease-control-act-2025-sec-48-norm .
