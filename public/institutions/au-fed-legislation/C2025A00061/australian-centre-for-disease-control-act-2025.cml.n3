concept:australian-centre-for-disease-control-act-2025-sec-10-ss-3 a cml:Concept ;
    skos:prefLabel "10(3) Establishment and appointment"@en ;
    cml:realizedBy doc:sec-10-ss-3 ;
    values:originalText "(3) The Minister must not appoint a person as the Director-General unless satisfied that the person has appropriate expertise, qualifications or experience in public health matters. Period of appointment" ;
