concept:australian-centre-for-disease-control-act-2025-sec-46 a cml:Concept ;
    skos:prefLabel "46 Recipient of direction must comply despite other laws"@en ;
    cml:realizedBy doc:sec-46 ;
    values:originalText "(1) A person that is given a direction under subsection 45(1) must comply with the direction. (2) An entity dealing with the direction on behalf of the person may comply with the direction." ;
