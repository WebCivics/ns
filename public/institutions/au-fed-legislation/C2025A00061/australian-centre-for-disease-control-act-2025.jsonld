    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Authorisation—use or disclosure by prescribed public health",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.58",
      "values:originalText": "entities\n(1) This section applies to a prescribed public health entity that has\nbeen given information under subsection 65(1) or (2).\n(2) The prescribed public health entity, and any person employed or\nengaged by the entity, may use or disclose the information if the\nuse or disclosure is:\n(a) in the course of carrying out a prescribed public health\nactivity specified in the undertaking for the purposes of\nsubparagraph 65(4)(a)(iii); and\n(b) in accordance with the undertaking.",
      "skos:definition": "entities\n(1) This section applies to a prescribed public health entity that has\nbeen given information under subsection 65(1) or (2).\n(2) The prescribed public health entity, and any person employed or\nengaged by the entity, may use or disclose the information if the\nuse or disclosure is:\n(a) in the course of carrying out a prescribed public health\nactivity specified in the undertaking for the purposes of\nsubparagraph 65(4)(a)(iii); and\n(b) in accordance with the undertaking.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-66-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-66-ss-2"
        }
      ],
      "cml:integrityHash": "2cc497857559ff85cfec0fd662a131fd6acb805edfa1afa992271366808691f3"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-66",
      "@type": "cof:Section",
      "cof:title": "66 Authorisation—use or disclosure by prescribed public health",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "entities\n(1) This section applies to a prescribed public health entity that has\nbeen given information under subsection 65(1) or (2).\n(2) The prescribed public health entity, and any person employed or\nengaged by the entity, may use or disclose the information if the\nuse or disclosure is:\n(a) in the course of carrying out a prescribed public health\nactivity specified in the undertaking for the purposes of\nsubparagraph 65(4)(a)(iii); and\n(b) in accordance with the undertaking."
    },
    {
