    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Establishment and appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.21",
      "values:originalText": "(1) There is to be a Director-General of the Australian Centre for\nDisease Control.\nAppointment by Minister\n(2) The Director-General is to be appointed by the Minister, by written\ninstrument.\n(3) The Minister must not appoint a person as the Director-General\nunless satisfied that the person has appropriate expertise,\nqualifications or experience in public health matters.\nPeriod of appointment\n(4) The Director-General holds office for a period of 5 years unless a\nshorter period is specified in the instrument of appointment.\nNote:\nThe Director-General may be reappointed: see section 33AA of the\nActs Interpretation Act 1901.",
      "skos:definition": "(1) There is to be a Director-General of the Australian Centre for\nDisease Control.\nAppointment by Minister\n(2) The Director-General is to be appointed by the Minister, by written\ninstrument.\n(3) The Minister must not appoint a person as the Director-General\nunless satisfied that the person has appropriate expertise,\nqualifications or experience in public health matters.\nPeriod of appointment\n(4) The Director-General holds office for a period of 5 years unless a\nshorter period is specified in the instrument of appointment.\nNote:\nThe Director-General may be reappointed: see section 33AA of the\nActs Interpretation Act 1901.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-3"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-10-ss-4"
        }
      ],
      "cml:integrityHash": "ebbd93eeece69296d879d5eea8ffba0995e930ba033e9bb8c8fa566c63e9d7f7"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Establishment and appointment",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "(1) There is to be a Director-General of the Australian Centre for\nDisease Control.\nAppointment by Minister\n(2) The Director-General is to be appointed by the Minister, by written\ninstrument.\n(3) The Minister must not appoint a person as the Director-General\nunless satisfied that the person has appropriate expertise,\nqualifications or experience in public health matters.\nPeriod of appointment\n(4) The Director-General holds office for a period of 5 years unless a\nshorter period is specified in the instrument of appointment.\nNote:\nThe Director-General may be reappointed: see section 33AA of the\nActs Interpretation Act 1901."
    },
