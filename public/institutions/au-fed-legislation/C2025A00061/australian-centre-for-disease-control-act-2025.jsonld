    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.18",
      "values:originalText": "This Part establishes the Australian Centre for Disease Control and\nprovides for administrative arrangements.\nDivision 3 establishes the office of the Director-General of the\nAustralian Centre for Disease Control and confers functions and\npowers relating to public health matters on the Director-General.\nDivision 4 provides for the Centre to engage staff and consultants.\nDivisions 5 and 6 contain transparency requirements. Division 5\nrequires the Director-General to publish public health advice given\nin the performance of the Director-General’s functions, with some\nexceptions. Division 6 requires the Director-General to publish a\nregister of agreements under which the Centre receives information\nor advice relating to public health matters.\n\n\nThe Australian Centre for Disease Control  Part 2\nThe Australian Centre for Disease Control  Division 2\nSection 7\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025",
      "skos:definition": "This Part establishes the Australian Centre for Disease Control and\nprovides for administrative arrangements.\nDivision 3 establishes the office of the Director-General of the\nAustralian Centre for Disease Control and confers functions and\npowers relating to public health matters on the Director-General.\nDivision 4 provides for the Centre to engage staff and consultants.\nDivisions 5 and 6 contain transparency requirements. Division 5\nrequires the Director-General to publish public health advice given\nin the performance of the Director-General’s functions, with some\nexceptions. Division 6 requires the Director-General to publish a\nregister of agreements under which the Centre receives information\nor advice relating to public health matters.\n\n\nThe Australian Centre for Disease Control  Part 2\nThe Australian Centre for Disease Control  Division 2\nSection 7\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-6-norm"
        }
      ],
      "cml:integrityHash": "f4af44f5480c1c1acd044e81522af2dad942eefb0e8823ebf3e63110fac9299f",
      "skos:note": "Establishes the Australian Centre for Disease Control and provides administrative arrangements."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "This Part establishes the Australian Centre for Disease Control and\nprovides for administrative arrangements.\nDivision 3 establishes the office of the Director-General of the\nAustralian Centre for Disease Control and confers functions and\npowers relating to public health matters on the Director-General.\nDivision 4 provides for the Centre to engage staff and consultants.\nDivisions 5 and 6 contain transparency requirements. Division 5\nrequires the Director-General to publish public health advice given\nin the performance of the Director-General’s functions, with some\nexceptions. Division 6 requires the Director-General to publish a\nregister of agreements under which the Centre receives information\nor advice relating to public health matters.\n\n\nThe Australian Centre for Disease Control  Part 2\nThe Australian Centre for Disease Control  Division 2\nSection 7\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025"
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-6-norm",
