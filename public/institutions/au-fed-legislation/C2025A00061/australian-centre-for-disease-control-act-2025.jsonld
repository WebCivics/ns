      "skos:note": "Guidelines for certificates may be prescribed"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-53-ss-3",
      "@type": "cof:Section",
      "cof:title": "53(3) Authorisation—disclosure in the public interest",
      "values:kind": "subsection",
