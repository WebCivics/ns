    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Authorisation—consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.56",
      "values:originalText": "A person may use or disclose relevant information for a purpose if\nthe entity to which the information relates has consented to the\nperson using or disclosing the information for that purpose\n(whether the consent is express or implied).",
      "skos:definition": "A person may use or disclose relevant information for a purpose if\nthe entity to which the information relates has consented to the\nperson using or disclosing the information for that purpose\n(whether the consent is express or implied).",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-64-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-64-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af3886a8acd0e2b52e4af1e3719fad393a901a3a50c094beac21f2d2ac5198ac",
      "skos:note": "Consent required for using or disclosing relevant information."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Authorisation—consent",
