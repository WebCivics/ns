      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Prepare a modified copy of public health advice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-22-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:logicSummary": "Temporal interval between exemption and publication",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) The advice is exempt material; but (b) it is possible for the Director-General to prepare a copy of the advice, modified by deletions, that would not be exempt material."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-22-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
