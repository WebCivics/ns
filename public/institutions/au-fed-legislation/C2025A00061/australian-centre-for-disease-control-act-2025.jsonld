      "skos:note": "The Director-General holds office for a specified period."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-10-ss-4",
      "@type": "cof:Section",
      "cof:title": "10(4) Establishment and appointment",
      "values:kind": "subsection",
