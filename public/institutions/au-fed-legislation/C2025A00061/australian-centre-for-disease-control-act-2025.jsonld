        }
      ],
      "cml:integrityHash": "61f96eb5d24c879854aac6cf766d2f1ef5dc9c8679b2678ab67b3f5ff503f5b4",
      "skos:note": "Disclosure of information to public health entities under certain conditions."
    },
    {
