    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-78",
      "@type": "cml:Concept",
      "skos:prefLabel": "78 Review of operation of Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-78"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.71",
      "values:originalText": "(1) The Minister must cause a review to be undertaken of:\n(a) the operation of this Act during the 5 year period beginning\nat the commencement of the Act; and\n(b) the operation of this Act during each subsequent 5 year\nperiod.\n(2) The persons conducting the review must not be employed by the\nCentre.\nTiming of review\n(3) The persons conducting the review must commence the review as\nsoon as practicable after the end of the 5 year period to which the\nreport relates.\nMinister to be given report of review\n(4) The persons conducting the review must give the Minister a written\nreport of the review as soon as possible after the review is\ncompleted.\nMinister to table copy of report of review\n(5) The Minister must cause a copy of the report of the review to be\ntabled in each House of the Parliament within 15 sitting days of\nthat House after the Minister receives the report.",
      "skos:definition": "(1) The Minister must cause a review to be undertaken of:\n(a) the operation of this Act during the 5 year period beginning\nat the commencement of the Act; and\n(b) the operation of this Act during each subsequent 5 year\nperiod.\n(2) The persons conducting the review must not be employed by the\nCentre.\nTiming of review\n(3) The persons conducting the review must commence the review as\nsoon as practicable after the end of the 5 year period to which the\nreport relates.\nMinister to be given report of review\n(4) The persons conducting the review must give the Minister a written\nreport of the review as soon as possible after the review is\ncompleted.\nMinister to table copy of report of review\n(5) The Minister must cause a copy of the report of the review to be\ntabled in each House of the Parliament within 15 sitting days of\nthat House after the Minister receives the report.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-78-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-78-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-78-ss-3"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-78-ss-4"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-78-ss-5"
        }
      ],
      "cml:integrityHash": "c033efe5986b2360b9032ccbbd781d36d681b558087f1cd74c9ddeb536cca2d1"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-78",
      "@type": "cof:Section",
      "cof:title": "78 Review of operation of Act",
      "values:kind": "section",
      "cof:pageNumber": 71,
      "values:originalText": "(1) The Minister must cause a review to be undertaken of:\n(a) the operation of this Act during the 5 year period beginning\nat the commencement of the Act; and\n(b) the operation of this Act during each subsequent 5 year\nperiod.\n(2) The persons conducting the review must not be employed by the\nCentre.\nTiming of review\n(3) The persons conducting the review must commence the review as\nsoon as practicable after the end of the 5 year period to which the\nreport relates.\nMinister to be given report of review\n(4) The persons conducting the review must give the Minister a written\nreport of the review as soon as possible after the review is\ncompleted.\nMinister to table copy of report of review\n(5) The Minister must cause a copy of the report of the review to be\ntabled in each House of the Parliament within 15 sitting days of\nthat House after the Minister receives the report."
    },
