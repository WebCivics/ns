      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(A person does not contravene medical standards, or any other relevant professional standards) and (The collection, use, and disclosure of information under this Act is recognized as a relevant professional standard).",
      "cml:conclusionText": "(A person collecting, using or disclosing information in accordance with this Act) does not contravene medical standards, or any other relevant professional standards."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-77a",
      "@type": "cml:Concept",
      "skos:prefLabel": "77A Annual pandemic preparedness and climate reporting",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-77a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.70",
      "values:originalText": "The annual report prepared by the Director-General and given to\nthe Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude an assessment of the following in relation to the period\n(including as compared to any previous such periods):\n(a) Australia’s pandemic preparedness;\n(b) the impacts of climate change on health for Australians.\n\n\nMiscellaneous  Part 6\n\nSection 78\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025",
      "skos:definition": "The annual report prepared by the Director-General and given to\nthe Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude an assessment of the following in relation to the period\n(including as compared to any previous such periods):\n(a) Australia’s pandemic preparedness;\n(b) the impacts of climate change on health for Australians.\n\n\nMiscellaneous  Part 6\n\nSection 78\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-77a-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-77a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5fd5e22729f297269b2da279f28a2228a4227c37e8466ec7f8157a802b9db156",
      "skos:note": "Annual pandemic preparedness and climate reporting assessment required",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-77a",
      "@type": "cof:Section",
      "cof:title": "77A Annual pandemic preparedness and climate reporting",
      "values:kind": "section",
      "cof:pageNumber": 70,
      "values:originalText": "The annual report prepared by the Director-General and given to\nthe Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude an assessment of the following in relation to the period\n(including as compared to any previous such periods):\n(a) Australia’s pandemic preparedness;\n(b) the impacts of climate change on health for Australians.\n\n\nMiscellaneous  Part 6\n\nSection 78\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025"
    },
