          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-30-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a53717afd832a984a44a71f131d972121f6547cd38e4914a2d4b730c846fe21e",
      "skos:note": "Ensure Aboriginal person or Torres Strait Islander expertise in health needs"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-30-ss-3",
      "@type": "cof:Section",
      "cof:title": "30(3) Appointment of Advisory Council members",
      "values:kind": "subsection",
      "cof:pageNumber": 35,
      "values:originalText": "(3) The Minister must ensure that at least one appointed member is an\nAboriginal person or a Torres Strait Islander (or both) who has\nexpertise, qualifications or experience in the health needs of\nAboriginal persons or Torres Strait Islanders (or both)."
    },
