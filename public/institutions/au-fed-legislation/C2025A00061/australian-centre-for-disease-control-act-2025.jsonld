      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) in accordance with any principles determined under subsection (6);",
      "cml:conclusionText": "...the use or disclosure is either: (a) all of the following;..."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-65-ss-4-logic-ltl-3",
