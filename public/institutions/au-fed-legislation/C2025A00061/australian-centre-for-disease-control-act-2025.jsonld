    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Civil penalty for failure to comply with direction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.48",
      "values:originalText": "A person is liable to a civil penalty if:\n(a) the person is given a direction under subsection 45(1) that\nrequires the person to give information, or information in a\nclass of information, to the Director-General; and\n(b) the person has the information; and\n(c) the person fails to comply with the direction.\nNote:\nThis section is a continuing civil penalty provision under section 93 of\nthe Regulatory Powers Act.\nCivil penalty:\n60 penalty units.",
      "skos:definition": "A person is liable to a civil penalty if:\n(a) the person is given a direction under subsection 45(1) that\nrequires the person to give information, or information in a\nclass of information, to the Director-General; and\n(b) the person has the information; and\n(c) the person fails to comply with the direction.\nNote:\nThis section is a continuing civil penalty provision under section 93 of\nthe Regulatory Powers Act.\nCivil penalty:\n60 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-48-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-48-logic-deontic-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-48-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-48-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "870deba1dc0c349920f815e09c7c36d4021c921b287b172f3611b3ee43997a16",
      "skos:note": "Failure to comply with direction results in civil penalty."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Civil penalty for failure to comply with direction",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "A person is liable to a civil penalty if:\n(a) the person is given a direction under subsection 45(1) that\nrequires the person to give information, or information in a\nclass of information, to the Director-General; and\n(b) the person has the information; and\n(c) the person fails to comply with the direction.\nNote:\nThis section is a continuing civil penalty provision under section 93 of\nthe Regulatory Powers Act.\nCivil penalty:\n60 penalty units."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-48-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
