    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 Authorisation—threats to safety, health or wellbeing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.56",
      "values:originalText": "A person may use or disclose relevant information if the person\nreasonably believes that the use or disclosure is necessary for the\npurpose of preventing or lessening a serious threat to the safety,\nhealth or wellbeing of:\n(a) the public; or\n(b) one or more individuals.",
      "skos:definition": "A person may use or disclose relevant information if the person\nreasonably believes that the use or disclosure is necessary for the\npurpose of preventing or lessening a serious threat to the safety,\nhealth or wellbeing of:\n(a) the public; or\n(b) one or more individuals.",
      "cml:asserts": [
