    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Authorisation—disclosure to Australian Bureau of Statistics and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-55"
      },
      "cml:curationStatus": {
