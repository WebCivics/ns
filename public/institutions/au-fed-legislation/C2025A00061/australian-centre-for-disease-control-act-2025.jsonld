    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-36"
      },
