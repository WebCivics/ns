      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.58",
      "values:originalText": "(5) A data sharing declaration may specify a matter mentioned in\nsubsection (2) subject to conditions.\nDeclaration is a legislative instrument",
      "skos:definition": "(5) A data sharing declaration may specify a matter mentioned in\nsubsection (2) subject to conditions.\nDeclaration is a legislative instrument",
      "values:partOf": {
