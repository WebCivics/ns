      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.38",
      "values:originalText": "(1) An appointed member may resign the member’s appointment by\ngiving the Minister a written resignation.\n(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day.",
      "skos:definition": "(1) An appointed member may resign the member’s appointment by\ngiving the Minister a written resignation.\n(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-36-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-36-ss-2"
        }
      ],
      "cml:integrityHash": "4ad6748b76d1eab406b52d6cf3d0ecae908593182a00b3cfafa6bf1003970335"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Resignation",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "(1) An appointed member may resign the member’s appointment by\ngiving the Minister a written resignation.\n(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day."
    },
