          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-74-ss-3"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-74-ss-4"
        }
      ],
      "cml:integrityHash": "5b5866c591cd2d21513a28a95064e59fccda11e6968c214092736842393f6a7d"
