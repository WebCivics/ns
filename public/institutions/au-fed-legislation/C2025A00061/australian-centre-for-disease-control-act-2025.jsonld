      "cml:integrityHash": "59b73e035fdb5de46b4fb7ece3384827a9ddd276e05efe4b8b27b3afbbebe467",
      "skos:note": "Data sharing declaration may provide differently for different kinds of information, entities or classes of entities, and permitted purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-67-ss-4",
