    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Functions of the Director-General",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.21",
      "values:originalText": "The Director-General has the following functions:\n(a) providing advice on public health matters to the Minister at\nthe request of the Minister or on the Director-General’s own\ninitiative;\n(b) providing advice on public health matters to another\nMinister:\n(i) at the request of the Minister, or the other Minister; or\n(ii) on the Director-General’s own initiative;\n(c) providing advice to, and consulting with, Commonwealth\nentities on public health matters;\n(d) providing advice to, and consulting with, State or Territory\ngovernment entities on public health matters;",
      "skos:definition": "The Director-General has the following functions:\n(a) providing advice on public health matters to the Minister at\nthe request of the Minister or on the Director-General’s own\ninitiative;\n(b) providing advice on public health matters to another\nMinister:\n(i) at the request of the Minister, or the other Minister; or\n(ii) on the Director-General’s own initiative;\n(c) providing advice to, and consulting with, Commonwealth\nentities on public health matters;\n(d) providing advice to, and consulting with, State or Territory\ngovernment entities on public health matters;",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-11-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ead7890013309d8582f85c09505d40cc6611f6578c6fb48978e8fc099299345a",
      "skos:note": "The Director-General must provide advice on public health matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Functions of the Director-General",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The Director-General has the following functions:\n(a) providing advice on public health matters to the Minister at\nthe request of the Minister or on the Director-General’s own\ninitiative;\n(b) providing advice on public health matters to another\nMinister:\n(i) at the request of the Minister, or the other Minister; or\n(ii) on the Director-General’s own initiative;\n(c) providing advice to, and consulting with, Commonwealth\nentities on public health matters;\n(d) providing advice to, and consulting with, State or Territory\ngovernment entities on public health matters;"
    },
