      }
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Advice to which this Division applies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.29",
      "values:originalText": "This Division applies to advice (however described):\n(a) that consists of or contains recommendations (however\ndescribed); and\n(b) that is given by the Director-General, in the performance of\nthe Director-General’s functions or duties under this Act or\nany other law of the Commonwealth, to any of the following:\n(i) a Minister;\n(ii) a Commonwealth entity, or an official of the\nCommonwealth;\n(iii) a State or Territory or a State or Territory government\nentity; and\n(c) that relates to public health matters; and\n(d) that is given in writing; and\n(e) that was not prepared for the purpose of being published\notherwise than under this Division; and\n(f) that the Director-General approves as the Director-General’s\nfinal and settled advice.",
      "skos:definition": "This Division applies to advice (however described):\n(a) that consists of or contains recommendations (however\ndescribed); and\n(b) that is given by the Director-General, in the performance of\nthe Director-General’s functions or duties under this Act or\nany other law of the Commonwealth, to any of the following:\n(i) a Minister;\n(ii) a Commonwealth entity, or an official of the\nCommonwealth;\n(iii) a State or Territory or a State or Territory government\nentity; and\n(c) that relates to public health matters; and\n(d) that is given in writing; and\n(e) that was not prepared for the purpose of being published\notherwise than under this Division; and\n(f) that the Director-General approves as the Director-General’s\nfinal and settled advice.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-20-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f64404236f22e47e91840fcf47256b2593eea9f66382f18bb0fb92a0d1193915",
      "skos:note": "Advice given by Director-General to certain individuals on public health matters"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Advice to which this Division applies",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "This Division applies to advice (however described):\n(a) that consists of or contains recommendations (however\ndescribed); and\n(b) that is given by the Director-General, in the performance of\nthe Director-General’s functions or duties under this Act or\nany other law of the Commonwealth, to any of the following:\n(i) a Minister;\n(ii) a Commonwealth entity, or an official of the\nCommonwealth;\n(iii) a State or Territory or a State or Territory government\nentity; and\n(c) that relates to public health matters; and\n(d) that is given in writing; and\n(e) that was not prepared for the purpose of being published\notherwise than under this Division; and\n(f) that the Director-General approves as the Director-General’s\nfinal and settled advice."
    },
