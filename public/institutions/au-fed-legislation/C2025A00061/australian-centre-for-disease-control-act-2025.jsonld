        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-20-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to provide advice on public health matters",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Director-General has a duty to provide advice",
      "cml:conclusionText": "Minister, Commonwealth entity, State or Territory government entity must receive advice"
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Publication of public health advice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
