    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Disclosure of interests to the Director-General—members other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.37",
      "values:originalText": "than Director-General\n(1) A member of the Advisory Council (other than the\nDirector-General) must give written notice to the Director-General\nof all interests, pecuniary or otherwise, that the member has or\nacquires and that conflict or could conflict with the proper\nperformance of the member’s duties.\n(2) The disclosure must be made as soon as possible after the relevant\nfacts have come to the member’s knowledge.",
      "skos:definition": "than Director-General\n(1) A member of the Advisory Council (other than the\nDirector-General) must give written notice to the Director-General\nof all interests, pecuniary or otherwise, that the member has or\nacquires and that conflict or could conflict with the proper\nperformance of the member’s duties.\n(2) The disclosure must be made as soon as possible after the relevant\nfacts have come to the member’s knowledge.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-34-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-34-ss-2"
        }
      ],
      "cml:integrityHash": "fda644e0d37c9074fa3977a2276880f1aaefad9d88db45ac9e2cee7fee10c69c"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Disclosure of interests to the Director-General—members other",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "than Director-General\n(1) A member of the Advisory Council (other than the\nDirector-General) must give written notice to the Director-General\nof all interests, pecuniary or otherwise, that the member has or\nacquires and that conflict or could conflict with the proper\nperformance of the member’s duties.\n(2) The disclosure must be made as soon as possible after the relevant\nfacts have come to the member’s knowledge."
    },
