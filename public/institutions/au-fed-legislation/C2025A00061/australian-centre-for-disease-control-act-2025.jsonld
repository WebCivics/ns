    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-67-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "67(5) Director-General may make data sharing declaration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-67-ss-5"
      },
      "cml:curationStatus": {
