    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-73",
      "@type": "cml:Concept",
      "skos:prefLabel": "73 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-73"
      },
      "cml:curationStatus": {
