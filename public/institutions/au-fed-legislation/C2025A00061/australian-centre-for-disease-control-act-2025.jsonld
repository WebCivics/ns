    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.37",
      "values:originalText": "The Director-General may grant leave of absence to any appointed\nmember on the terms and conditions that the Director-General\ndetermines.",
      "skos:definition": "The Director-General may grant leave of absence to any appointed\nmember on the terms and conditions that the Director-General\ndetermines.",
