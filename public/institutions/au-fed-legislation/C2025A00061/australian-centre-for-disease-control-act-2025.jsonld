    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Authorisation—obtaining legal advice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.55",
      "values:originalText": "A person may disclose relevant information for the purpose of\nobtaining legal advice.\n58  Authorisation—disclosure to court, tribunal etc.\n(1) A person may disclose relevant information to a court exercising\nfederal jurisdiction.\n(2) A person may disclose relevant information to:\n(a) a court; or\n(b) a tribunal, authority or person that has the power to require\nthe answering of questions or the production of documents;\nfor the purposes of the enforcement of a law of the Commonwealth\nor to assist the court, tribunal, authority or person to make or\nreview an administrative decision that is required or authorised to\nbe made under a law of the Commonwealth.",
      "skos:definition": "A person may disclose relevant information for the purpose of\nobtaining legal advice.\n58  Authorisation—disclosure to court, tribunal etc.\n(1) A person may disclose relevant information to a court exercising\nfederal jurisdiction.\n(2) A person may disclose relevant information to:\n(a) a court; or\n(b) a tribunal, authority or person that has the power to require\nthe answering of questions or the production of documents;\nfor the purposes of the enforcement of a law of the Commonwealth\nor to assist the court, tribunal, authority or person to make or\nreview an administrative decision that is required or authorised to\nbe made under a law of the Commonwealth.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-57-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-57-ss-2"
        }
      ],
      "cml:integrityHash": "c7a20ed5991dfe078e3f363843021295e459f29578aa0dcff2a0ed321f7cb287"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Authorisation—obtaining legal advice",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "A person may disclose relevant information for the purpose of\nobtaining legal advice.\n58  Authorisation—disclosure to court, tribunal etc.\n(1) A person may disclose relevant information to a court exercising\nfederal jurisdiction.\n(2) A person may disclose relevant information to:\n(a) a court; or\n(b) a tribunal, authority or person that has the power to require\nthe answering of questions or the production of documents;\nfor the purposes of the enforcement of a law of the Commonwealth\nor to assist the court, tribunal, authority or person to make or\nreview an administrative decision that is required or authorised to\nbe made under a law of the Commonwealth."
    },
