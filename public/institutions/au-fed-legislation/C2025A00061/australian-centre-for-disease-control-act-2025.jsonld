    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Prescribed public health entities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.43",
      "values:originalText": "(1) The Director-General may, by legislative instrument, specify\nentities that are prescribed public health entities for the purposes\nof this Act.\n(2) The Director-General may specify an entity under subsection (1)\nonly if the Director-General is satisfied that:\n(a) the entity:\n(i) has functions, duties or powers, under a law of the\nCommonwealth or a State or Territory, relating to\nprescribed public health activities; or\n(ii) carries out prescribed public health activities on behalf\nof the Commonwealth or a State or Territory; and",
      "skos:definition": "(1) The Director-General may, by legislative instrument, specify\nentities that are prescribed public health entities for the purposes\nof this Act.\n(2) The Director-General may specify an entity under subsection (1)\nonly if the Director-General is satisfied that:\n(a) the entity:\n(i) has functions, duties or powers, under a law of the\nCommonwealth or a State or Territory, relating to\nprescribed public health activities; or\n(ii) carries out prescribed public health activities on behalf\nof the Commonwealth or a State or Territory; and",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-41-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-41-ss-2"
        }
      ],
      "cml:integrityHash": "b06db5714d8e9b6e4b2494df29fbf5b85ed783e5d54eac84b9ff865539ba89be"
    },
