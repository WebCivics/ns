      "@type": "cml:Concept",
      "skos:prefLabel": "49(3) Register of directions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-49-ss-3"
      },
