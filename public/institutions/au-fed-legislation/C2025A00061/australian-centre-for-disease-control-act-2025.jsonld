      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the person has obtained or generated information as a result of a use or disclosure of information authorised by this Act;",
      "cml:conclusionText": "Authorized use is within a specific temporal interval."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-71-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
