        }
      ],
      "cml:integrityHash": "4149e03f76bfefe518c1fa0550db191f7d3b6b238549c607199b469dcfeac4dc",
      "skos:note": "Grant leave of absence on terms and conditions determined by the Director-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-33",
