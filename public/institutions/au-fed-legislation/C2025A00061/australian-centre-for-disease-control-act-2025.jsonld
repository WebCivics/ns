    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Acting appointments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.25",
      "values:originalText": "The Minister may, by written instrument, appoint a person to act as\nthe Director-General:\n(a) during a vacancy in the office of the Director-General\n(whether or not an appointment has previously been made to\nthe office); or\n(b) during any period, or during all periods, when the\nDirector-General:\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see sections 33AB and\n33A of the Acts Interpretation Act 1901.",
      "skos:definition": "The Minister may, by written instrument, appoint a person to act as\nthe Director-General:\n(a) during a vacancy in the office of the Director-General\n(whether or not an appointment has previously been made to\nthe office); or\n(b) during any period, or during all periods, when the\nDirector-General:\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see sections 33AB and\n33A of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-14-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "38a2e96b4b2827be9eb66bab46f383c4b6ea231706399db3f19689c205f1af13",
      "skos:note": "The Minister may appoint a person to act as Director-General under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Acting appointments",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "The Minister may, by written instrument, appoint a person to act as\nthe Director-General:\n(a) during a vacancy in the office of the Director-General\n(whether or not an appointment has previously been made to\nthe office); or\n(b) during any period, or during all periods, when the\nDirector-General:\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see sections 33AB and\n33A of the Acts Interpretation Act 1901."
    },
    {
