        }
      ],
      "cml:integrityHash": "32b64e18cb8fe6133c19b1f7db30c6f84c6590fc485f5afc525dd42c4903ddea"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Authorisation—disclosure to Australian Bureau of Statistics and",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Australian Institute of Health and Welfare\n(1) The Director-General may disclose relevant information to the\nAustralian Bureau of Statistics if the Director-General is satisfied\nthat the information is relevant to the Bureau’s functions.\n(2) The Director-General may disclose relevant information to the\nAustralian Institute of Health and Welfare if the Director-General\nis satisfied that the information is relevant to the Institute’s\nfunctions."
    },
