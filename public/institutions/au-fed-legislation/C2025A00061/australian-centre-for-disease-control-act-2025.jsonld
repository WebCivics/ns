        }
      ],
      "cml:integrityHash": "73b7c2456bc9c954a89681984b591f93d49b865ee45fa1f16c3962fe6fb46f1b",
      "skos:note": "Rules may make provision about publication of public health advice under section 21."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-23-ss-1",
      "@type": "cof:Section",
      "cof:title": "23(1) Rules may make provision about publication of public health",
      "values:kind": "subsection",
      "cof:pageNumber": 31,
      "values:originalText": "(1) The rules may make provision in relation to the publication of\nadvice under section 21."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-23-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
