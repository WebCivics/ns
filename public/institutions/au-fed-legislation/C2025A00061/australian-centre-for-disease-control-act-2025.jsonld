      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The Commonwealth Chief Medical Officer and the appointed\nmembers are not officials of the Centre for the purposes of the\nPublic Governance, Performance and Accountability Act 2013.",
      "cml:conclusionText": "The exemption applies during the period specified in the Public Governance, Performance and Accountability Act 2013."
    },
