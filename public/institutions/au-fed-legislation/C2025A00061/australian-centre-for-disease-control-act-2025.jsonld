      "skos:note": "Director-General must make data sharing declaration for permitted purposes directly related to preventing or reducing public health threat."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-67-ss-3",
      "@type": "cof:Section",
      "cof:title": "67(3) Director-General may make data sharing declaration",
      "values:kind": "subsection",
