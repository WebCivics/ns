      "skos:note": "Establishment of the Advisory Council of the Australian Centre for Disease Control"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Establishment of the Advisory Council of the Australian Centre",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "for Disease Control\nThe Advisory Council of the Australian Centre for Disease Control\nis established by this section."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-26-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
