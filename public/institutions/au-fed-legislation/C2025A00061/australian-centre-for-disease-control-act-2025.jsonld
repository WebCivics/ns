    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-65-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:logicSummary": "The prescribed public health entity must use or disclose the relevant information within a specified time frame.",
