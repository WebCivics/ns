        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iii) reasonably necessary to carry out a prescribed public health activity specified in the undertaking;",
      "cml:conclusionText": "...the use or disclosure is either: (a) all of the following;..."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-65-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "permission",
      "cml:logicSummary": "The prescribed public health entity has permission to use or disclose the relevant information in accordance with the undertaking.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) otherwise authorised by this Part.",
      "cml:conclusionText": "...the use or disclosure is either: (a) all of the following;..."
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-65-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "65(5) Authorisation—disclosure to prescribed public health entities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-65-ss-5"
      },
