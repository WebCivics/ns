    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Consultants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-disease-control-act-2025.pdf"
      },
      "dc:source": "australian-centre-for-disease-control-act-2025.pdf, p.28",
      "values:originalText": "The Director-General may, on behalf of the Commonwealth,\nengage consultants to assist in the performance of the functions or\nduties, or the exercise of the powers, of one or more of the\nfollowing:\n(a) the Centre;\n(b) the Director-General;\n(c) the Advisory Council.\n\n\nThe Australian Centre for Disease Control  Part 2\nPublication of public health advice  Division 5\nSection 20\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025",
      "skos:definition": "The Director-General may, on behalf of the Commonwealth,\nengage consultants to assist in the performance of the functions or\nduties, or the exercise of the powers, of one or more of the\nfollowing:\n(a) the Centre;\n(b) the Director-General;\n(c) the Advisory Council.\n\n\nThe Australian Centre for Disease Control  Part 2\nPublication of public health advice  Division 5\nSection 20\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-19-norm"
        },
        {
          "@id": "concept:australian-centre-for-disease-control-act-2025-sec-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "33980bd40511eb68caac73e930e86eef7da9cdb22a4c21dd7144157777848219",
      "skos:note": "Engage consultants on behalf of the Commonwealth."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-disease-control-act-2025#sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Consultants",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "The Director-General may, on behalf of the Commonwealth,\nengage consultants to assist in the performance of the functions or\nduties, or the exercise of the powers, of one or more of the\nfollowing:\n(a) the Centre;\n(b) the Director-General;\n(c) the Advisory Council.\n\n\nThe Australian Centre for Disease Control  Part 2\nPublication of public health advice  Division 5\nSection 20\nNo. 61, 2025\nAustralian Centre for Disease Control Act 2025"
    },
    {
      "@id": "concept:australian-centre-for-disease-control-act-2025-sec-19-norm",
