      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Defines a recurring trace for authorized use of protected information.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) the information is protected information;",
      "cml:conclusionText": "Authorized use creates a recurring trace."
    },
