concept:c2025a00062-sch-1-sec-544a-ss-3 a cml:Concept ;
    skos:prefLabel "544A(3) Delegation of Director’s functions or powers"@en ;
    cml:realizedBy doc:sch-1-sec-544a-ss-3 ;
    values:originalText "(3) However, the Director of Human Biosecurity must not delegate the Director’s functions or powers under any of the following provisions: (a) section 113 (human health response zones); (b) section 570 (issuing identity cards); (c) section 618 (declared movements)." ;
    skos:definition "(3) However, the Director of Human Biosecurity must not delegate the Director’s functions or powers under any of the following provisions: (a) section 113 (human health response zones); (b) section 570 (issuing identity cards); (c) section 618 (declared movements)."@en ;
    cml:integrityHash "c4057cfaed744629ebb7fb8bc043be130180966f015d1b66fecc31fc7238d04e" ;
    values:partOf concept:c2025a00062-sch-1-sec-544a ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Delegation of Director's functions or powers under certain provisions is prohibited." ;
