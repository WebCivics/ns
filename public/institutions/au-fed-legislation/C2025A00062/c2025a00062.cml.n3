concept:c2025a00062-sch-2-sec-13 a cml:Concept ;
    skos:prefLabel "13 Legal proceedings involving the Health Secretary"@en ;
    cml:realizedBy doc:sch-2-sec-13 ;
    values:originalText "If, immediately before the transition time, the Health Secretary was a party to proceedings relating to the old NHS Act that were pending in any court or tribunal, the Director-General of the CDC is substituted for the Secretary as a party to the proceedings at and after that time." ;
    skos:definition "If, immediately before the transition time, the Health Secretary was a party to proceedings relating to the old NHS Act that were pending in any court or tribunal, the Director-General of the CDC is substituted for the Secretary as a party to the proceedings at and after that time."@en ;
    cml:integrityHash "54e6a96a6e2af71704df2d840b1e0ac673efcf7c6696294c91bd7487964b6df9" ;
    cof:pageNumber "39"^^xsd:integer ;
    skos:note "Substitution of Director-General for Secretary in pending proceedings" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2025a00062.pdf> ;
    dc:source "c2025a00062.pdf, p.39" ;
