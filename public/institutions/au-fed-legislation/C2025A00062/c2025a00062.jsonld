        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2025a00062-sec-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies the provision as a title or heading",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text describes the provision as 'Short title'",
      "cml:conclusionText": "The provision is classified as a title or heading"
    },
    {
      "@id": "concept:c2025a00062-sec-1-logic-n3logic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:N3Logic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Identifies the key as a unique identifier",
      "cml:executionSurface": "modalities::logic::n3_compiler",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The key is assigned a unique number and letter combination",
      "cml:conclusionText": "The key identifies a unique provision in the Act"
    },
    {
      "@id": "concept:c2025a00062-sec-1-logic-shacl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Validates the structure of the key",
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The key follows a standard format with a specific number and letter combination",
      "cml:conclusionText": "The key is valid according to SHACL standards"
    },
    {
      "@id": "concept:c2025a00062-sec-1-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Analyzes the key for cognitive biases",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The key does not contain any obvious cognitive biases or heuristics",
      "cml:conclusionText": "The key is free from cognitive biases according to CogAI analysis"
    },
    {
      "@id": "concept:c2025a00062-sec-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Identifies the key as a diffusion point in the Act",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The key is assigned to a specific section of the Act",
      "cml:conclusionText": "The key identifies a diffusion point in the Act according to Diffusion analysis"
    },
