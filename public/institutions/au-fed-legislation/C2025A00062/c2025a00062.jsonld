    },
    {
      "@id": "concept:c2025a00062-sec-1-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2025a00062-sec-1"
      },
