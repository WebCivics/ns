      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval of continued delegation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
