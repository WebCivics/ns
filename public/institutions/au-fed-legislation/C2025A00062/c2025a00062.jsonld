        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2025a00062-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Saving of listed human disease determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2025a00062#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2025a00062.pdf"
      },
      "dc:source": "c2025a00062.pdf, p.37",
      "values:originalText": "(1)\nThis item applies if a determination made under subsection 42(1) of the\nold Biosecurity Act is in force immediately before the transition time.\n(2)\nThe determination has effect, at and after the transition time, as if it had\nbeen made by the Director-General of the CDC in accordance with\nsection 42 of the new Biosecurity Act.",
      "skos:definition": "(1)\nThis item applies if a determination made under subsection 42(1) of the\nold Biosecurity Act is in force immediately before the transition time.\n(2)\nThe determination has effect, at and after the transition time, as if it had\nbeen made by the Director-General of the CDC in accordance with\nsection 42 of the new Biosecurity Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2025a00062-sch-2-sec-8-norm"
        },
        {
          "@id": "concept:c2025a00062-sch-2-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9e2d3c8c2deeedbcfcbaf9d8c05bfb793db2643abf32eaa35a0d88b807fd9f34",
      "skos:note": "Preserves listed human disease determinations made under the old Biosecurity Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2025a00062#sch-2-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Saving of listed human disease determinations",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "(1)\nThis item applies if a determination made under subsection 42(1) of the\nold Biosecurity Act is in force immediately before the transition time.\n(2)\nThe determination has effect, at and after the transition time, as if it had\nbeen made by the Director-General of the CDC in accordance with\nsection 42 of the new Biosecurity Act."
    },
    {
      "@id": "concept:c2025a00062-sch-2-sec-8-norm",
