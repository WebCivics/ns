        },
        {
          "@id": "concept:c2025a00062-sch-1-sec-544a-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0b24d6ae5a14407bdc7c9e3ea8edbe05f5566da2b4b69f5332ea68df15aa1819",
      "skos:note": "Delegation of Director's functions or powers must comply with directions of the Director of Human Biosecurity."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2025a00062#sch-1-sec-544a-ss-6",
      "@type": "cof:Section",
      "cof:title": "544A(6) Delegation of Director’s functions or powers",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(6) In performing any functions or exercising any powers under a\ndelegation made under subsection (1), the delegate must comply\nwith any directions of the Director of Human Biosecurity."
    },
