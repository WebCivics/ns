      },
      "dc:source": "c2025a00062.pdf, p.8",
      "values:originalText": "(6) In performing any functions or exercising any powers under a\ndelegation made under subsection (1), the delegate must comply\nwith any directions of the Director of Human Biosecurity.",
      "skos:definition": "(6) In performing any functions or exercising any powers under a\ndelegation made under subsection (1), the delegate must comply\nwith any directions of the Director of Human Biosecurity.",
      "values:partOf": {
        "@id": "concept:c2025a00062-sch-1-sec-544a"
      },
      "cml:asserts": [
