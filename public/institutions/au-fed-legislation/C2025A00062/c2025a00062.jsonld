      }
    },
    {
      "@id": "concept:c2025a00062-sch-2-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Saving of delegations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2025a00062#sch-2-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2025a00062.pdf"
      },
      "dc:source": "c2025a00062.pdf, p.37",
      "values:originalText": "Despite the repeal and substitution of section 544A of the Biosecurity\nAct 2015 a delegation under that section that was in force immediately\nbefore the transition time continues in force after that time as if it were\nmade under section 544A of the new Biosecurity Act.\n\nSchedule 2  Application, saving and transitional provisions",
      "skos:definition": "Despite the repeal and substitution of section 544A of the Biosecurity\nAct 2015 a delegation under that section that was in force immediately\nbefore the transition time continues in force after that time as if it were\nmade under section 544A of the new Biosecurity Act.\n\nSchedule 2  Application, saving and transitional provisions",
      "cml:asserts": [
        {
          "@id": "concept:c2025a00062-sch-2-sec-10-norm"
        },
        {
          "@id": "concept:c2025a00062-sch-2-sec-10-logic-deontic-1"
        },
        {
          "@id": "concept:c2025a00062-sch-2-sec-10-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "41f05268f9533c5e4827e82893f23cdd9534373689aa351741ccd44406247513",
      "skos:note": "Delegations under section 544A of the Biosecurity Act continue in force after transition time."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2025a00062#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Saving of delegations",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "Despite the repeal and substitution of section 544A of the Biosecurity\nAct 2015 a delegation under that section that was in force immediately\nbefore the transition time continues in force after that time as if it were\nmade under section 544A of the new Biosecurity Act.\n\nSchedule 2  Application, saving and transitional provisions"
    },
    {
