      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Things done by, or in relation to, the Commonwealth Chief.",
      "cml:conclusionText": "Things have effect as if done by, or in relation to, the Director-General of the CDC."
    },
    {
