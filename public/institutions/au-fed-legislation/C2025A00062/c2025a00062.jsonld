    {
      "@id": "concept:c2025a00062-sch-1-sec-544a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "544A(6) Delegation of Director’s functions or powers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2025a00062#sch-1-sec-544a-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
