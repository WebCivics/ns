      "dc:source": "c2025a00062.pdf, p.25",
      "values:originalText": "Insert:\nAustralian Centre for Disease Control means the Australian\nCentre for Disease Control established by section 7 of the\nAustralian Centre for Disease Control Act 2025.\nDirector-General of the CDC means the Director-General of the\nAustralian Centre for Disease Control appointed under section 10\nof the Australian Centre for Disease Control Act 2025.",
      "skos:definition": "Insert:\nAustralian Centre for Disease Control means the Australian\nCentre for Disease Control established by section 7 of the\nAustralian Centre for Disease Control Act 2025.\nDirector-General of the CDC means the Director-General of the\nAustralian Centre for Disease Control appointed under section 10\nof the Australian Centre for Disease Control Act 2025.",
      "cml:asserts": [
        {
          "@id": "concept:c2025a00062-sch-1-sec-31-norm"
        }
      ],
      "cml:integrityHash": "bb92022b57e4828f236ed6c987876b76991273391d1e556627d13e98a599578f",
      "skos:note": "Definitions for Australian Centre for Disease Control and Director-General"
    },
