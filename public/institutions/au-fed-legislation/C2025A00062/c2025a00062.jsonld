      "@type": "cof:Section",
      "cof:title": "31 Section 8",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Insert:\nAustralian Centre for Disease Control means the Australian\nCentre for Disease Control established by section 7 of the\nAustralian Centre for Disease Control Act 2025.\nDirector-General of the CDC means the Director-General of the\nAustralian Centre for Disease Control appointed under section 10\nof the Australian Centre for Disease Control Act 2025."
    },
