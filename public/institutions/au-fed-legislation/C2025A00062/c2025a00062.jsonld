    {
      "@id": "concept:c2025a00062-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2025a00062#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2025a00062.pdf"
      },
      "dc:source": "c2025a00062.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nAmendment of the Biosecurity Act 2015  Part 1\nNo. 62, 2025\nAustralian Centre for Disease Control (Consequential Amendments\nand Transitional Provisions) Act 2025",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nAmendment of the Biosecurity Act 2015  Part 1\nNo. 62, 2025\nAustralian Centre for Disease Control (Consequential Amendments\nand Transitional Provisions) Act 2025",
      "cml:asserts": [
        {
          "@id": "concept:c2025a00062-sec-3-norm"
        }
      ],
      "cml:integrityHash": "44c571c7cb383e85ac38813a31f56b87b22a2cad63bd50bb6c17995bb35af2ae",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2025a00062#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nAmendment of the Biosecurity Act 2015  Part 1\nNo. 62, 2025\nAustralian Centre for Disease Control (Consequential Amendments\nand Transitional Provisions) Act 2025"
    },
    {
      "@id": "concept:c2025a00062-sec-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
