    {
      "@id": "concept:c2025a00062-sch-1-sec-24a",
      "@type": "cml:Concept",
      "skos:prefLabel": "24A Defence for use of information authorised under the Australian",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2025a00062#sch-1-sec-24a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2025a00062.pdf"
      },
      "dc:source": "c2025a00062.pdf, p.11",
      "values:originalText": "Centre for Disease Control Act 2025\nSection 21 does not apply if:\n(a) a person obtains protected information; and\n(b) the person makes a record of, or discloses or otherwise uses,\nthe information; and\n(c) the record, disclosure or use is authorised under the\nAustralian Centre for Disease Control Act 2025.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection: see subsection 13.3(3) of the Criminal Code.",
      "skos:definition": "Centre for Disease Control Act 2025\nSection 21 does not apply if:\n(a) a person obtains protected information; and\n(b) the person makes a record of, or discloses or otherwise uses,\nthe information; and\n(c) the record, disclosure or use is authorised under the\nAustralian Centre for Disease Control Act 2025.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection: see subsection 13.3(3) of the Criminal Code.",
      "cml:asserts": [
        {
          "@id": "concept:c2025a00062-sch-1-sec-24a-norm"
        },
        {
          "@id": "concept:c2025a00062-sch-1-sec-24a-logic-deontic-1"
        },
        {
          "@id": "concept:c2025a00062-sch-1-sec-24a-logic-deontic-2"
        },
        {
          "@id": "concept:c2025a00062-sch-1-sec-24a-logic-alleninterval-3"
        },
        {
          "@id": "concept:c2025a00062-sch-1-sec-24a-logic-ltl-4"
        }
      ],
      "cml:integrityHash": "27c93295f368160b2a537157582ab4c1b52991d8f2bad94c0dd406b9f5b5f7ae",
      "skos:note": "Defendant bears evidential burden in relation to protected information."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2025a00062#sch-1-sec-24a",
      "@type": "cof:Section",
      "cof:title": "24A Defence for use of information authorised under the Australian",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Centre for Disease Control Act 2025\nSection 21 does not apply if:\n(a) a person obtains protected information; and\n(b) the person makes a record of, or discloses or otherwise uses,\nthe information; and\n(c) the record, disclosure or use is authorised under the\nAustralian Centre for Disease Control Act 2025.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection: see subsection 13.3(3) of the Criminal Code."
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-24a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2025a00062-sch-1-sec-24a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-24a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Defendant bears evidential burden.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 21 does not apply if...",
      "cml:conclusionText": "...the record, disclosure or use is authorised under the Australian Centre for Disease Control Act 2025."
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-24a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Defendant bears evidential burden in relation to protected information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "...a defendant bears an evidential burden in relation to the matter in this section:",
      "cml:conclusionText": "...see subsection 13.3(3) of the Criminal Code."
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-24a-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Record, disclosure or use must occur after obtaining protected information.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "...and the person makes a record of, or discloses or otherwise uses...",
      "cml:conclusionText": "...the record, disclosure or use is authorised under the Australian Centre for Disease Control Act 2025."
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-24a-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
