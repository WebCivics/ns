        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-544a-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of delegation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) However, the Director of Human Biosecurity must not delegate...",
      "cml:conclusionText": "...the Director’s functions or powers under any of the following provisions:"
    },
    {
      "@id": "concept:c2025a00062-sch-1-sec-544a-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
