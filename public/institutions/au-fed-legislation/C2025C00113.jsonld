    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-14-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval for the strict liability offence starts at the time of contravention.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval for the strict liability offence",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(4) An offence for a contravention of subsection (3) is an offence of strict liability."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-14-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The knowledge representation states that the contravention is a strict liability offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Represents the knowledge that the contravention is a strict liability offence",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge Representation",
      "cml:premiseText": "(4) An offence for a contravention of subsection (3) is an offence of strict liability."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-14-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An offence for contravention of subsection (3) is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits contravention of subsection (3)",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(4) An offence for a contravention of subsection (3) is an offence of strict liability."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-14-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "All agents are prohibited from contravening subsection (3).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffuses the prohibition to all agents",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusion",
      "cml:premiseText": "(4) An offence for a contravention of subsection (3) is an offence of strict liability."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-14-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The strict liability offence recurs with each contravention.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines the recurring trace for the strict liability offence",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "(4) An offence for a contravention of subsection (3) is an offence of strict liability."
    },
