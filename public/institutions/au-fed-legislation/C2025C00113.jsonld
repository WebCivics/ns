      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "41d77d1d056242a3d925c33fc5e8262942348fff31eb1a3468864c0e7f0e08db",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:financial-sector-collection-of-data-act-2001#sec-11-ss-3",
