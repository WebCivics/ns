    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-11-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Consider assets, liabilities, borrowing methods, and finance over time.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTINUOUSLY",
      "cml:premiseText": "(a) the assets and liabilities of the corporation; and (b) the principal methods by which the corporation ordinarily borrows moneys; and (c) the principal kinds of finance ordinarily provided by the corporation;"
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-11-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consider assets, liabilities, borrowing methods, and finance when categorizing corporations.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(3) In determining the category in which a corporation is to be included or in determining whether a corporation should be transferred from one category to another category, APRA must have regard to:"
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-11-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must try to ensure that corporations carrying on the same or similar kinds of business are included in the same category.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST TRY TO ENSURE",
      "cml:premiseText": "must try to ensure that, as far as practicable, corporations carrying on the same or similar kinds of business are included in the same category."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-11-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Consider assets, liabilities, borrowing methods, and finance in a recurring manner.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RECURRING",
      "cml:premiseText": "(a) the assets and liabilities of the corporation; and (b) the principal methods by which the corporation ordinarily borrows moneys; and (c) the principal kinds of finance ordinarily provided by the corporation;"
    },
