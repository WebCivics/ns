      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(i) 50%; (ii) if a greater or lesser percentage is prescribed by the regulations—the percentage so prescribed;"
    },
