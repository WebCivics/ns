    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-11-ss-3",
      "@type": "cml:Concept",
      "dc:source": "financial-sector-collection-of-data-act-2001.pdf, p.18",
      "skos:note": "Must consider assets, liabilities, borrowing methods, and finance when categorizing corporations.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "11(3) List of names and categories of registered entities"
      },
      "wasDerivedFrom": "financial-sector-collection-of-data-act-2001.pdf",
      "asserts": [
        "concept:financial-sector-collection-of-data-act-2001-sec-11-ss-3-norm",
