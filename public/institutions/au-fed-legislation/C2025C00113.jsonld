      "@type": "cml:Concept",
      "dc:source": "financial-sector-collection-of-data-act-2001.pdf, p.39",
      "skos:note": "Payment of penalty before end of period constitutes obligation to comply with infringement notice.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "22(1) What happens if penalty is paid"
      },
      "wasDerivedFrom": "financial-sector-collection-of-data-act-2001.pdf",
      "asserts": [
        "concept:financial-sector-collection-of-data-act-2001-sec-22-ss-1-norm",
