      "cml:operator": "No Causal Relationship",
      "cml:premiseText": "(4) Any failure to comply with the requirements of subsection (3) in relation to a decision does not affect the validity of the decision."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-25c-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision remains valid even if requirements are not met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exemptions from requirements do not affect decision validity.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exemption",
      "cml:premiseText": "(4) Any failure to comply with the requirements of subsection (3) in relation to a decision does not affect the validity of the decision."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-25c-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compliance event has no diffusion effect on the decision validity event.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Compliance with requirements has no effect on decision validity.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "No Diffusion",
      "cml:premiseText": "(4) Any failure to comply with the requirements of subsection (3) in relation to a decision does not affect the validity of the decision."
    },
    {
      "@id": "concept:financial-sector-collection-of-data-act-2001-sec-25c-ss-4-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision's validity is not affected by non-compliance.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Decision validity and compliance are independent.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Conjunction",
      "cml:premiseText": "(4) Any failure to comply with the requirements of subsection (3) in relation to a decision does not affect the validity of the decision."
    },
