    values:partOf concept:financial-sector-collection-of-data-act-2001-sec-17b ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Auditor must notify APRA of circumstances that amount to interference with auditor's functions or duties. Auditor must perform functions and duties set out in reporting standards." ;
    dc:description "true" ;
