    cml:realizedBy doc:sec-30 ;
    values:originalText "The Governor-General may make regulations prescribing all matters: (a) required or permitted by this Act to be prescribed; or (b) necessary or convenient to be prescribed for carrying out or giving effect to this Act.   Interpretation  Part 5  Section 31 Financial Sector (Collection of Data) Act 2001 Compilation date: 21/02/2025" ;
    skos:definition "The Governor-General may make regulations prescribing all matters: (a) required or permitted by this Act to be prescribed; or (b) necessary or convenient to be prescribed for carrying out or giving effect to this Act.   Interpretation  Part 5  Section 31 Financial Sector (Collection of Data) Act 2001 Compilation date: 21/02/2025"@en ;
    cml:integrityHash "4dee00e5cfb456413380aeda82f5b1b83ec1589ef51013d4b89208c8289a42d3" ;
    cof:pageNumber "46"^^xsd:integer ;
