doc:sec-8-ss-2 a cof:Section ;
    cof:title "8(2) Register of entities" ;
    values:kind "subsection" ;
    values:originalText "(2) APRA must ensure that the Register of Entities is available for inspection by any member of the public at an office of APRA during normal business hours." ;
    cof:pageNumber "14"^^xsd:integer .

concept:financial-sector-collection-of-data-act-2001-sec-8-ss-3 a cml:Concept ;
    skos:prefLabel "8(3) Register of entities"@en ;
    cml:realizedBy doc:sec-8-ss-3 ;
    values:originalText "(3) A person may: (a) inspect the Register of Entities; or (b) take an extract from, or make a copy of, that Register; if the person pays the fee (if any) prescribed by the regulations." ;
    skos:definition "(3) A person may: (a) inspect the Register of Entities; or (b) take an extract from, or make a copy of, that Register; if the person pays the fee (if any) prescribed by the regulations."@en ;
