concept:financial-sector-collection-of-data-act-2001-sec-29 a cml:Concept ;
    skos:prefLabel "29 Corporation not to hold out that it is a registered entity"@en ;
    cml:realizedBy doc:sec-29 ;
    values:originalText "A corporation must not, in the course of carrying on any business, advertise or hold out, by the use of the words “registered under the Financial Sector (Collection of Data) Act 2001”, the words “registered with APRA” or words having a similar meaning, that the corporation is a registered entity or has any special status under or because of this Act, whether or not the corporation is a registered entity. Penalty: 50 penalty units." ;
    skos:definition "A corporation must not, in the course of carrying on any business, advertise or hold out, by the use of the words “registered under the Financial Sector (Collection of Data) Act 2001”, the words “registered with APRA” or words having a similar meaning, that the corporation is a registered entity or has any special status under or because of this Act, whether or not the corporation is a registered entity. Penalty: 50 penalty units."@en ;
    cml:integrityHash "90268cd01ab7fb382d3177ca0e516d09ec313ccb5fdd61ef748591f2292c036e" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Cannot hold out that it is a registered entity" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
