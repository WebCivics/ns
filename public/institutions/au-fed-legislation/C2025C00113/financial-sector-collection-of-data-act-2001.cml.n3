concept:financial-sector-collection-of-data-act-2001-sec-26 a cml:Concept ;
    skos:prefLabel "26 Saving of other laws"@en ;
    cml:realizedBy doc:sec-26 ;
    values:originalText "This Act is not intended to exclude or limit the operation of any other laws of the Commonwealth, or the operation of any laws of a State or Territory, in so far as those laws are capable of operating concurrently with this Act." ;
    skos:definition "This Act is not intended to exclude or limit the operation of any other laws of the Commonwealth, or the operation of any laws of a State or Territory, in so far as those laws are capable of operating concurrently with this Act."@en ;
    cml:integrityHash "abbf5d9f7ac777b988c68f8f475e9aaa06e2af0b6877c1b7108aeb7b9eba7b9d" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "No exclusion of other laws" ;
    cml:curationStatus cml:Proposed ;
