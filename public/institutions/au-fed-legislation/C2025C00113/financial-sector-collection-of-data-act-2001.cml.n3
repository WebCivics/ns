concept:financial-sector-collection-of-data-act-2001-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "(1) Parts 1 and 5 commence on the day on which this Act receives the Royal Assent. (2) Parts 2, 3 and 4 commence on a day to be fixed by Proclamation. (3) If Parts 2, 3 and 4 do not commence under subsection (2) within the period of 12 months beginning on the day on which this Act receives the Royal Assent, those Parts commence on the first day after the end of that period." ;
    skos:definition "(1) Parts 1 and 5 commence on the day on which this Act receives the Royal Assent. (2) Parts 2, 3 and 4 commence on a day to be fixed by Proclamation. (3) If Parts 2, 3 and 4 do not commence under subsection (2) within the period of 12 months beginning on the day on which this Act receives the Royal Assent, those Parts commence on the first day after the end of that period."@en ;
    cml:integrityHash "25fed1bf57e7b0f958ccb9b6fbc1d3d9f99e499892bae60f350102236b076846" ;
    cof:pageNumber "7"^^xsd:integer ;
