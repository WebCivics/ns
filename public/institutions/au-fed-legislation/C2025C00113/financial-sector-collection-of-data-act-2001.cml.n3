concept:financial-sector-collection-of-data-act-2001-sec-17-ss-10 a cml:Concept ;
    skos:prefLabel "17(10) APRA may require the variation of a reporting document or the"@en ;
    cml:realizedBy doc:sec-17-ss-10 ;
    values:originalText "(10) An offence for a contravention of subsection (8) is an offence of strict liability." ;
