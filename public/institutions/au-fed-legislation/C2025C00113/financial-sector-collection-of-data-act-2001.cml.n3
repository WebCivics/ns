    cof:title "14(1) Principal executive officer of financial sector entity (other than a" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if a financial sector entity (other than a superannuation entity) that is required by or under a reporting standard to give a reporting document to APRA before a particular time or within a particular period fails to comply with the requirement." ;
    cof:pageNumber "30"^^xsd:integer .

concept:financial-sector-collection-of-data-act-2001-sec-14-ss-2 a cml:Concept ;
    skos:prefLabel "14(2) Principal executive officer of financial sector entity (other than a"@en ;
    cml:realizedBy doc:sec-14-ss-2 ;
    values:originalText "(2) It is the duty of the principal executive officer of the entity, as soon as practicable after that time or the end of that period, as the case may be, to notify the governing body of the entity in writing that the failure has occurred." ;
    skos:definition "(2) It is the duty of the principal executive officer of the entity, as soon as practicable after that time or the end of that period, as the case may be, to notify the governing body of the entity in writing that the failure has occurred."@en ;
    cml:integrityHash "0e989b9be48f7e46bbc930d806783a1f93c89bc4020bde2ca9af0db50803d08c" ;
    values:partOf concept:financial-sector-collection-of-data-act-2001-sec-14 ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Duty to notify governing body of failure APRA may make declarations for the purposes of subsection (1)" ;
