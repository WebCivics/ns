concept:financial-sector-collection-of-data-act-2001-sec-28 a cml:Concept ;
    skos:prefLabel "28 Validity of acts and transactions of financial sector entities"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "The validity of an act or transaction of a financial sector entity is not affected merely because a provision of this Act or of the regulations, a reporting standard or a direction has not been complied with." ;
    skos:definition "The validity of an act or transaction of a financial sector entity is not affected merely because a provision of this Act or of the regulations, a reporting standard or a direction has not been complied with."@en ;
    cml:integrityHash "b9af70ff9bf38c4b31b39f9654c4b478f4838b1f990d3392576c627c03d1c187" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "No compliance with regulations affects validity of financial sector acts and transactions." ;
    cml:curationStatus cml:Proposed ;
