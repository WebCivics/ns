concept:financial-sector-collection-of-data-act-2001-sec-29a a cml:Concept ;
    skos:prefLabel "29A Delegation by Minister"@en ;
    cml:realizedBy doc:sec-29a ;
    values:originalText "The Minister may, in writing, delegate all or any of his or her functions or powers under this Act to: (a) the Secretary of the Department; or (b) an SES employee, or acting SES employee, in the Department." ;
    skos:definition "The Minister may, in writing, delegate all or any of his or her functions or powers under this Act to: (a) the Secretary of the Department; or (b) an SES employee, or acting SES employee, in the Department."@en ;
