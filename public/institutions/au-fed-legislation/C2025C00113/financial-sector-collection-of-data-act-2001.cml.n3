concept:financial-sector-collection-of-data-act-2001-sec-27 a cml:Concept ;
    skos:prefLabel "27 Entities may be directed to comply with Act"@en ;
    cml:realizedBy doc:sec-27 ;
    values:originalText "If a financial sector entity is convicted of an offence against this Act as a result of the entity having failed to comply with a provision of this Act or of the regulations, or with a reporting standard made or direction given by APRA, the Federal Court of Australia may direct the entity to comply, within a period specified by the Court, with the provision, reporting standard or direction, as the case may be." ;
    skos:definition "If a financial sector entity is convicted of an offence against this Act as a result of the entity having failed to comply with a provision of this Act or of the regulations, or with a reporting standard made or direction given by APRA, the Federal Court of Australia may direct the entity to comply, within a period specified by the Court, with the provision, reporting standard or direction, as the case may be."@en ;
    cml:integrityHash "c1ae9c5dedf24190040f2a87f01998f58f86377d8901f2518c344992c41024b0" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Entity must comply with provision or reporting standard" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
