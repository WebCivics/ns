      "dc:source": "digital-id-act-2024.pdf, p.153",
      "skos:note": "A decision by the Digital ID Regulator is a reviewable decision.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "137 Reviewable decisions"
      },
