    {
      "@id": "concept:digital-id-act-2024-sec-10-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
