      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(ii) an authority or agency of the Commonwealth, a State or a Territory; or"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-11-ss-1-norm",
