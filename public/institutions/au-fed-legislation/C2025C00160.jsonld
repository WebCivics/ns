      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the creation time of a digital ID.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(g) if the individual has a digital ID—the time and date the digital ID was created;"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-10-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Includes specific attributes in the definition.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(2) Without limiting subsection (1), an attribute of an individual includes..."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-10-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines a subclass for restricted attributes.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "subclassOf",
      "cml:premiseText": "(i) information or an opinion about the individual’s: (i) racial or ethnic origin; or (ii) political opinions; or (iii) membership of a political association; or (iv) religious beliefs or affiliations; or (v) philosophical beliefs; or (vi) sexual orientation or practices."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-10-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
