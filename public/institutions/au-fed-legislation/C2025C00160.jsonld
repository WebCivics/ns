      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) An action or other proceeding, whether civil or criminal, for or in relation to the provision or non-provision of an accredited service."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-84-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1A) or (1B) applies.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If an action is brought by another entity, then the first entity is not liable.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(a) The action or other proceeding is brought by the other entity or the participating relying party."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-84-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The action or other proceeding is brought by the other entity or the participating relying party.",
