      "cml:logicSummary": "Defines a term with a specific meaning",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "defined",
      "cml:premiseText": "(1) A restricted attribute of an individual means:"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-11-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
