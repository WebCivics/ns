      },
      "cml:operator": "includes",
      "cml:premiseText": "(i) the Commonwealth, a State or a Territory; or"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-11-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
