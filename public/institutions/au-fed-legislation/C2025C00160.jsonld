        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Includes biometric information in the definition.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(h) biometric information of the individual;"
    },
