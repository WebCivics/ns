      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is an accredited entity",
      "cml:premiseText": "(a) unless the entity is a relying party—the entity must be an accredited entity;"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-64-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
