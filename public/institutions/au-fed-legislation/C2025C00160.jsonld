    {
      "@id": "concept:digital-id-act-2024-sec-72-ss-1",
      "@type": "cml:Concept",
      "dc:source": "digital-id-act-2024.pdf, p.93",
      "skos:note": "Revocation of approval to participate in the Australian Digital ID system",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "72(1) Revocation of approval to participate in the Australian"
      },
      "wasDerivedFrom": "digital-id-act-2024.pdf",
      "asserts": [
        "concept:digital-id-act-2024-sec-72-ss-1-norm",
        "concept:digital-id-act-2024-sec-72-ss-1-logic-deontic-1",
