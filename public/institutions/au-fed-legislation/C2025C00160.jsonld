        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Entity must provide specific services in the system.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "participate only as the kind of accredited entity it is accredited as and approved to participate as",
      "cml:premiseText": "(b) if the entity is an accredited entity: (i) the entity must participate in the Australian Government Digital ID System only as the kind of accredited entity it is accredited as and approved to participate as;"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-64-ss-1-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Entity must start participating at a specific time.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "begin on the entity’s participation start day",
      "cml:premiseText": "(c) the entity must begin to participate in the Australian Government Digital ID System on the entity’s participation start day;"
    },
