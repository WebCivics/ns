      "cml:logicSummary": "Defines a class hierarchy for restricted attributes",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "definedClass",
      "cml:premiseText": "(a) health information (within the meaning of the Privacy Act 1988) about the individual; or"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-11-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines a class hierarchy for restricted attributes",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "definedClass",
      "cml:premiseText": "(b) an identifier of the individual that has been issued or assigned by or on behalf of:"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-11-ss-1-logic-diffusion-6",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
