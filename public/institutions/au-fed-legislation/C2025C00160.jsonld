    },
    {
      "@id": "concept:digital-id-act-2024-sec-137-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision must occur during the accreditation process.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The decision must occur during the accreditation process.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The accreditation process begins when an entity applies for accreditation."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-137-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the Digital ID Regulator refuses to accredit an entity, then the entity is not accredited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If the Digital ID Regulator refuses to accredit an entity, then the entity is not accredited.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The Digital ID Regulator has the power to refuse accreditation."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-137-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision is a type of artificial intelligence decision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The decision is a type of artificial intelligence decision.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is-a",
      "cml:premiseText": "The Digital ID Regulator uses artificial intelligence to make decisions."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-137-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision is a reviewable decision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The decision is an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The Digital ID Regulator has the power to make decisions."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-137-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision can only be made if the entity has applied for accreditation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The decision can only be made if the entity has applied for accreditation.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if-and-only-if",
      "cml:premiseText": "The entity must apply for accreditation before the Digital ID Regulator can make a decision."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-137-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
