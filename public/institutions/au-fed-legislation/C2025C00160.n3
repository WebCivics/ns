    cml:modality cml:Deontic ;
    cml:operator "Consistency" ;
    cml:logicSummary "Digital ID Data Standards must be consistent with Accreditation Rules." ;
    cml:premiseText "(3) Digital ID Data Standards that are inconsistent with the Accreditation Rules have no effect to the extent of the inconsistency." ;
    cml:conclusionText "Digital ID Data Standards are taken to be consistent with the Accreditation Rules to the extent that Digital ID Data Standards are capable of operating concurrently with the Accreditation Rules." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

