    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Temporal relation between entity's actions and penalties" ;
    cml:premiseText "Entity is liable to civil penalty if the entity uses digital ID trustmark without authorization." ;
    cml:conclusionText "Penalty applies when entity uses unauthorized trustmark." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

