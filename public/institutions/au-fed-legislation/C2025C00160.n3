    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of unauthorized use" ;
    cml:premiseText "Entity uses digital ID trustmark without authorization." ;
    cml:conclusionText "Entity is liable to civil penalty." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

