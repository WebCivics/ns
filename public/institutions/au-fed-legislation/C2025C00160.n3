concept:digital-id-act-2024-sec-156-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Accountable persons have an obligation to comply." ;
    cml:premiseText "(3) A provision of this Act (including a civil penalty provision) that is purportedly contravened by an entity that is not a legal person..." ;
    cml:conclusionText "...is instead contravened by each accountable person for the entity..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

