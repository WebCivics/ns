concept:digital-id-act-2024-sec-147-ss-1 cml:asserts concept:digital-id-act-2024-sec-147-ss-1-logic-deontic-1 .
concept:digital-id-act-2024-sec-147-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If a fee is payable under this Act, then the Commonwealth is liable to pay it." ;
    cml:premiseText "(1) The Commonwealth is not liable to pay a fee that is payable under this Act to a part of the Commonwealth that is not a separate legal entity." ;
    cml:conclusionText "However, it is the Parliament’s intention that the Commonwealth should be notionally liable to pay such a fee." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

