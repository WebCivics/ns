    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "The liability of accountable persons repeats with each occurrence." ;
    cml:premiseText "(3) A provision of this Act (including a civil penalty provision)..." ;
    cml:conclusionText "...is instead contravened by each accountable person for the entity who:..." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

