    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The liability of accountable persons overlaps with that of the entity." ;
    cml:premiseText "(c) was in any way knowingly concerned in, or party to, the relevant act or omission." ;
    cml:conclusionText "...or (c) was in any way knowingly concerned in, or party to, the relevant act or omission." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

