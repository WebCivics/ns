    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits failure to comply with Digital ID Rules." ;
    cml:premiseText "(a) the entity is subject to a requirement under the Digital ID Rules made for the purposes of subsection (1); and (b) the entity fails to comply with the requirement." ;
