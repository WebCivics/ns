concept:digital-id-act-2024-sec-155a-ss-1 a cml:Concept ;
    skos:prefLabel "155A(1) Annual reports by law enforcement agencies etc. on disclosure"@en ;
    cml:realizedBy doc:sec-155a-ss-1 ;
    cml:integrityHash "6852ef4b587e3716a88a180682bee31cd5cdd5d5c8dc952c5374674447cdd0d3" ;
    values:partOf concept:digital-id-act-2024-sec-155a ;
    skos:note "Law enforcement agencies and enforcement bodies must request or require accredited entities to disclose biometric information or personal information." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <digital-id-act-2024.pdf> ;
    dc:source "digital-id-act-2024.pdf, p.170" ;
    cml:asserts concept:digital-id-act-2024-sec-155a-ss-1-norm .
concept:digital-id-act-2024-sec-155a-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:digital-id-act-2024-sec-155a-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:digital-id-act-2024-sec-155a-ss-1 cml:asserts concept:digital-id-act-2024-sec-155a-ss-1-logic-deontic-1 .
concept:digital-id-act-2024-sec-155a-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide" ;
    cml:premiseText "The law enforcement agency or enforcement body must request or require the accredited entity to disclose biometric information or personal information." ;
    cml:conclusionText "The accredited entity MUST provide biometric information or personal information." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:digital-id-act-2024-sec-155a-ss-1 cml:asserts concept:digital-id-act-2024-sec-155a-ss-1-logic-deontic-2 .
concept:digital-id-act-2024-sec-155a-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must use or disclose" ;
    cml:premiseText "The enforcement body must request or require the accredited entity to use or disclose personal information of an individual for enforcement-related activities." ;
    cml:conclusionText "The accredited entity MUST use or disclose personal information of an individual for enforcement-related activities." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:digital-id-act-2024-sec-155a-ss-1 cml:asserts concept:digital-id-act-2024-sec-155a-ss-1-logic-alleninterval-3 .
concept:digital-id-act-2024-sec-155a-ss-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Disclosure must occur during a financial year." ;
    cml:premiseText "The law enforcement agency or enforcement body MUST request or require the accredited entity to disclose biometric information or personal information DURING a financial year." ;
    cml:conclusionText "The disclosure of biometric information or personal information OCCURS BETWEEN the start and end of a financial year." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:digital-id-act-2024-sec-155a-ss-1 cml:asserts concept:digital-id-act-2024-sec-155a-ss-1-logic-ltl-4 .
concept:digital-id-act-2024-sec-155a-ss-1-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "RECURSIVE" ;
    cml:logicSummary "Disclosure must be recurring for enforcement-related activities." ;
    cml:premiseText "The enforcement body MUST request or require the accredited entity to use or disclose personal information of an individual FOR ENFORCEMENT-RELATED ACTIVITIES CONDUCTED BY, OR ON BEHALF OF, THE ENFORCEMENT BODY." ;
    cml:conclusionText "The disclosure of personal information of an individual is RECURSIVE for enforcement-related activities." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


