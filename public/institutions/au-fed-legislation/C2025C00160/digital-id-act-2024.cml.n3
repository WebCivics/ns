    skos:prefLabel "33 Chapter applies to accredited entities only to extent entity is"@en ;
    cml:realizedBy doc:sec-33 ;
    values:originalText "providing accredited services This Chapter applies to an accredited entity only to the extent the entity is providing its accredited services." ;
    skos:definition "providing accredited services This Chapter applies to an accredited entity only to the extent the entity is providing its accredited services."@en ;
    cml:integrityHash "f9935c33c2179e23c38890af1f6401a4b35b77f63a5b17443c7133248214025e" ;
    cof:pageNumber "50"^^xsd:integer ;
