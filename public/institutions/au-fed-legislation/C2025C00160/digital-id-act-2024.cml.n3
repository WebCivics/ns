doc:sec-84-ss-1 a cof:Section ;
    cof:title "84(1) Accredited entities participating in the Australian Government" ;
    values:kind "subsection" ;
    values:originalText "(1) An accredited entity (the first entity) is not liable to an action or other proceeding, whether civil or criminal, for or in relation to the provision or non-provision of an accredited service of the entity to another accredited entity (the other entity) participating in the Australian Government Digital ID System, or to a participating relying party, if: (a) the action or other proceeding is brought by the other entity or the participating relying party; and (b) subsection (1A) or (1B) applies." ;
    cof:pageNumber "106"^^xsd:integer .

concept:digital-id-act-2024-sec-84-ss-1a a cml:Concept ;
    skos:prefLabel "84(1A) Accredited entities participating in the Australian Government"@en ;
    cml:realizedBy doc:sec-84-ss-1a ;
    values:originalText "(1A) This subsection applies if the first entity provides or does not provide the accredited service, in good faith, in compliance with this Act (other than the service levels determined under section 80)." ;
    skos:definition "(1A) This subsection applies if the first entity provides or does not provide the accredited service, in good faith, in compliance with this Act (other than the service levels determined under section 80)."@en ;
    cml:integrityHash "1e6852a2ba9999c1a9e21b5764913ae07b8926a0030d35ecc3e11d9a26c90bfb" ;
    values:partOf concept:digital-id-act-2024-sec-84 ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Must provide accredited service in good faith and compliance with the Act." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
