    cml:hasPart concept:digital-id-act-2024-sec-120-ss-6 ;
    cml:hasPart concept:digital-id-act-2024-sec-120-ss-7 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
