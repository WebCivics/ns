    values:partOf concept:digital-id-act-2024-sec-15 ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Entity cannot be accredited without providing required services." ;
    dc:description "some or all of the services described in the definition of attribute service provider, identity exchange provider, or identity service provider" ;
