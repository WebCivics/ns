doc:sec-134-ss-4 a cof:Section ;
    cof:title "134(4) System Administrator’s power to require information or" ;
    values:kind "subsection" ;
    values:originalText "(4) A notice under subsection (2) must contain a statement to the effect that an entity may be liable to a civil penalty if the entity fails to comply with the notice." ;
    cof:pageNumber "150"^^xsd:integer .

