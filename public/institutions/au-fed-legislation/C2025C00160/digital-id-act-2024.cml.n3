doc:sec-60-ss-3 a cof:Section ;
    cof:title "60(3) Phasing-in of participation in the Australian Government Digital" ;
    values:kind "subsection" ;
    values:originalText "(3) The Minister: (a) must not revoke the determination; and (b) may vary the determination only to: (i) specify additional kinds of entities that may apply; or (ii) correct an error, defect or irregularity in the determination." ;
    cof:pageNumber "79"^^xsd:integer .

concept:digital-id-act-2024-sec-61 a cml:Concept ;
    skos:prefLabel "61 Applying for approval to participate in the Australian"@en ;
    cml:realizedBy doc:sec-61 ;
    values:originalText "Government Digital ID System An entity may apply to the Digital ID Regulator for approval to participate in the Australian Government Digital ID System if: (a) the entity is an accredited entity that is a non-corporate Commonwealth entity, within the meaning of the Public Governance, Performance and Accountability Act 2013; or  Chapter 4  Australian Government Digital ID System" ;
    skos:definition "Government Digital ID System An entity may apply to the Digital ID Regulator for approval to participate in the Australian Government Digital ID System if: (a) the entity is an accredited entity that is a non-corporate Commonwealth entity, within the meaning of the Public Governance, Performance and Accountability Act 2013; or  Chapter 4  Australian Government Digital ID System"@en ;
    cml:integrityHash "e2879cc26e66fd7b61536e5c73eb127ce41f8e169ce76114d5e3b0e391fa3869" ;
    cof:pageNumber "79"^^xsd:integer ;
