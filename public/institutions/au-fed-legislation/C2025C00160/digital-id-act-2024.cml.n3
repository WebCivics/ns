doc:sec-35a-ss-1 a cof:Section ;
    cof:title "35A(1) Small business operator that is an accredited entity" ;
    values:kind "subsection" ;
    values:originalText "(1) If a small business operator is an accredited entity, the Privacy Act 1988 applies, with the prescribed modifications (if any), in relation to the small business operator as if it were an organisation." ;
    cof:pageNumber "52"^^xsd:integer .

