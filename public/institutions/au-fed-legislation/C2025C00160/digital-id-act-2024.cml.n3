    cml:modality cml:Diffusion ;
    cml:operator "if-and-only-if" ;
    cml:logicSummary "The decision can only be made if the entity has applied for accreditation." ;
    cml:premiseText "The entity must apply for accreditation before the Digital ID Regulator can make a decision." ;
    cml:conclusionText "The decision can only be made if the entity has applied for accreditation." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

