concept:digital-id-act-2024-sec-49-ss-1 cml:asserts concept:digital-id-act-2024-sec-49-ss-1-logic-ltl-4 .
concept:digital-id-act-2024-sec-49-ss-1-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Biometric information collection and use are valid until accreditation conditions expire." ;
    cml:premiseText "(b) the biometric information of the individual is collected, used or disclosed for the purposes of the accredited entity doing neither or both of the following:" ;
    cml:conclusionText "The biometric information collection and use are valid until accreditation conditions expire." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

