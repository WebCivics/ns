concept:digital-id-act-2024-sec-89 a cml:Concept ;
    skos:prefLabel "89 Simplified outline of this Chapter"@en ;
    cml:realizedBy doc:sec-89 ;
    values:originalText "The Digital ID Regulator is the Australian Competition and Consumer Commission. The Digital ID Regulator has certain functions, including to promote compliance with this Act and to advise the Information Commissioner on privacy matters that relate to this Act.  Digital ID Regulator  Chapter 5 Digital ID Regulator  Part 2  Section 90 Digital ID Act 2024 Compilation date: 21/02/2025" ;
    skos:definition "The Digital ID Regulator is the Australian Competition and Consumer Commission. The Digital ID Regulator has certain functions, including to promote compliance with this Act and to advise the Information Commissioner on privacy matters that relate to this Act.  Digital ID Regulator  Chapter 5 Digital ID Regulator  Part 2  Section 90 Digital ID Act 2024 Compilation date: 21/02/2025"@en ;
    cml:integrityHash "7f1d01b97d5ab82e1c624238e70b3824f9b40a848d4367bdd349bb725229fd1e" ;
