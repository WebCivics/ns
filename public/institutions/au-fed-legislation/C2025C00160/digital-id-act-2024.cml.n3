concept:digital-id-act-2024-sec-24 a cml:Concept ;
    skos:prefLabel "24 Varying accreditation"@en ;
    cml:realizedBy doc:sec-24 ;
    values:originalText "The Digital ID Regulator may vary the accreditation of an accredited entity to take account of a change in the accredited entity’s name. Note: The Digital ID Regulator can also vary conditions on accreditation (see section 20)." ;
    skos:definition "The Digital ID Regulator may vary the accreditation of an accredited entity to take account of a change in the accredited entity’s name. Note: The Digital ID Regulator can also vary conditions on accreditation (see section 20)."@en ;
