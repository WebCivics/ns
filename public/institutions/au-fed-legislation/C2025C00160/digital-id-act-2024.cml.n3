concept:digital-id-act-2024-sec-155 a cml:Concept ;
    skos:prefLabel "155 Annual report by Information Commissioner"@en ;
    cml:realizedBy doc:sec-155 ;
    values:originalText "The annual report prepared by the Information Commissioner and given to the Minister under section 46 of the Public Governance, Performance and Accountability Act 2013 for a period must include information about the performance of the Information Commissioner’s functions, and the exercise of the Information Commissioner’s powers, under or in relation to Part 2 of Chapter 3 of this Act during the period." ;
    skos:definition "The annual report prepared by the Information Commissioner and given to the Minister under section 46 of the Public Governance, Performance and Accountability Act 2013 for a period must include information about the performance of the Information Commissioner’s functions, and the exercise of the Information Commissioner’s powers, under or in relation to Part 2 of Chapter 3 of this Act during the period."@en ;
    cml:integrityHash "fd512c1c3540ba855a6f14b65b8782a90ce9dbef785d1a05c95f021b649ad466" ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Annual report must include performance information" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
