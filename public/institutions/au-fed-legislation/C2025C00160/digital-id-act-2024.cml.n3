    skos:prefLabel "90 Digital ID Regulator"@en ;
    cml:realizedBy doc:sec-90 ;
    values:originalText "The Digital ID Regulator is the Australian Competition and Consumer Commission. Note: The Australian Competition and Consumer Commission is established by Part II of the Competition and Consumer Act 2010." ;
