concept:digital-id-act-2024-sec-93 a cml:Concept ;
    skos:prefLabel "93 Simplified outline of this Chapter"@en ;
    cml:realizedBy doc:sec-93 ;
    values:originalText "There is a System Administrator whose functions include providing assistance to entities participating in the Australian Government Digital ID System and managing the availability of the Australian Government Digital ID System. The Minister may give general directions to the System Administrator about the performance of the System Administrator’s functions or the exercise of the System Administrator’s powers.  Chapter 6  System Administrator" ;
    skos:definition "There is a System Administrator whose functions include providing assistance to entities participating in the Australian Government Digital ID System and managing the availability of the Australian Government Digital ID System. The Minister may give general directions to the System Administrator about the performance of the System Administrator’s functions or the exercise of the System Administrator’s powers.  Chapter 6  System Administrator"@en ;
    cml:integrityHash "7fb0f6a199d32293d7415c0b97c3c8c04637325bdf6e2c21da00066377134985" ;
    cof:pageNumber "115"^^xsd:integer ;
    skos:note "The Minister may give general directions to the System Administrator." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
