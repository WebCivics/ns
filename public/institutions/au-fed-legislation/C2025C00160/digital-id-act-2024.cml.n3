doc:sec-167-ss-1 a cof:Section ;
    cof:title "167(1) Instruments may incorporate etc. material as in force or existing" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies to the following instruments (each of which is a core instrument): (a) the Accreditation Rules; (b) the Digital ID Data Standards; (c) the Digital ID Rules." ;
    cof:pageNumber "181"^^xsd:integer .

concept:digital-id-act-2024-sec-167-ss-2 a cml:Concept ;
    skos:prefLabel "167(2) Instruments may incorporate etc. material as in force or existing"@en ;
    cml:realizedBy doc:sec-167-ss-2 ;
    values:originalText "(2) A core instrument may make provision in relation to a matter by applying, adopting or incorporating, with or without modification, any matter contained in any other instrument or other writing (an incorporated instrument) as in force or existing from time to time." ;
    skos:definition "(2) A core instrument may make provision in relation to a matter by applying, adopting or incorporating, with or without modification, any matter contained in any other instrument or other writing (an incorporated instrument) as in force or existing from time to time."@en ;
