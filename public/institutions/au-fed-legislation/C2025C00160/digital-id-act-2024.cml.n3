concept:digital-id-act-2024-sec-137-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "is" ;
    cml:logicSummary "The decision is an obligation." ;
    cml:premiseText "The Digital ID Regulator has the power to make decisions." ;
    cml:conclusionText "The decision is a reviewable decision." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:digital-id-act-2024-sec-137 cml:asserts concept:digital-id-act-2024-sec-137-logic-alleninterval-2 .
concept:digital-id-act-2024-sec-137-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "The decision must occur during the accreditation process." ;
    cml:premiseText "The accreditation process begins when an entity applies for accreditation." ;
    cml:conclusionText "The decision must occur during the accreditation process." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
