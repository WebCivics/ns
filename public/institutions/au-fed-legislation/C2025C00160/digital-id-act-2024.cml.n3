concept:digital-id-act-2024-sec-31 a cml:Concept ;
    skos:prefLabel "31 Prohibition on holding out that an entity is accredited"@en ;
    cml:realizedBy doc:sec-31 ;
    values:originalText "An entity must not hold out that the entity is an accredited entity if that is not the case. Civil penalty: 1,000 penalty units.  Chapter 3  Privacy" ;
    skos:definition "An entity must not hold out that the entity is an accredited entity if that is not the case. Civil penalty: 1,000 penalty units.  Chapter 3  Privacy"@en ;
