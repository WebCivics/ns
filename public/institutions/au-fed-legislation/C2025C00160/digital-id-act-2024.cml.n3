concept:digital-id-act-2024-sec-87 a cml:Concept ;
    skos:prefLabel "87 Dispute resolution procedures"@en ;
    cml:realizedBy doc:sec-87 ;
    values:originalText "The Digital ID Rules may make provision for and in relation to dispute resolution procedures that must be complied with before an entity can apply for an order under subsection 85(3).  Chapter 4  Australian Government Digital ID System" ;
