concept:digital-id-act-2024-sec-158 a cml:Concept ;
    skos:prefLabel "158 Bodies corporate and due diligence"@en ;
    cml:realizedBy doc:sec-158 ;
    values:originalText "For the purposes of section 97 of the Regulatory Powers Act (about attributing contraventions of employees etc. to a body corporate), a body corporate does not contravene a civil penalty provision of this  Other matters  Chapter 10 Other matters  Part 4  Section 159 Digital ID Act 2024 Compilation date: 21/02/2025 Act because of conduct of a person that the body corporate is taken to have engaged in, if it is established that the body corporate took reasonable precautions and exercised due diligence to avoid the conduct." ;
    skos:definition "For the purposes of section 97 of the Regulatory Powers Act (about attributing contraventions of employees etc. to a body corporate), a body corporate does not contravene a civil penalty provision of this  Other matters  Chapter 10 Other matters  Part 4  Section 159 Digital ID Act 2024 Compilation date: 21/02/2025 Act because of conduct of a person that the body corporate is taken to have engaged in, if it is established that the body corporate took reasonable precautions and exercised due diligence to avoid the conduct."@en ;
    cml:integrityHash "fa71aabfccb9e6261056611573b3a63390a6c71c660df22b6708310ff9bcf66b" ;
    cof:pageNumber "174"^^xsd:integer ;
    skos:note "Due diligence obligation for bodies corporate" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <digital-id-act-2024.pdf> ;
    dc:source "digital-id-act-2024.pdf, p.174" ;
