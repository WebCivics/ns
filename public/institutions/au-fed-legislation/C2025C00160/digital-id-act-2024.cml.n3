concept:digital-id-act-2024-sec-128-ss-1 a cml:Concept ;
    skos:prefLabel "128(1) Digital ID Regulator’s power to give directions to protect the"@en ;
    cml:realizedBy doc:sec-128-ss-1 ;
    values:originalText "(1) This section applies if the Digital ID Regulator reasonably believes that an accredited entity, or an entity whose accreditation is suspended, has contravened, or is contravening, a provision of this Act." ;
    skos:definition "(1) This section applies if the Digital ID Regulator reasonably believes that an accredited entity, or an entity whose accreditation is suspended, has contravened, or is contravening, a provision of this Act."@en ;
