doc:sec-117-ss-2 a cof:Section ;
    cof:title "117(2) Digital ID trustmarks" ;
    values:kind "subsection" ;
    values:originalText "(2) An entity must not use a digital ID trustmark if the entity is not authorised under subsection (1) to use the trustmark. Civil penalty: 1,000 penalty units." ;
    cof:pageNumber "130"^^xsd:integer .

concept:digital-id-act-2024-sec-117-ss-3 a cml:Concept ;
    skos:prefLabel "117(3) Digital ID trustmarks"@en ;
    cml:realizedBy doc:sec-117-ss-3 ;
    values:originalText "(3) An entity must not do any of the following in relation to a mark, symbol, logo or design so closely resembling a digital ID trustmark as to be likely to lead a reasonable person to believe that the entity is an accredited entity or a participating relying party: (a) use it in relation to a business, trade, profession or occupation;  Trustmarks and registers  Chapter 8 Digital ID trustmarks  Part 2  Section 119 Digital ID Act 2024 Compilation date: 21/02/2025 (b) apply (as a trade mark or otherwise) it to goods imported, manufactured, produced, sold, offered for sale or let on hire; (c) use it in relation to: (i) goods or services; or (ii) the promotion (by any means) of the supply or use of goods or services. Civil penalty: 1,000 penalty units." ;
    skos:definition "(3) An entity must not do any of the following in relation to a mark, symbol, logo or design so closely resembling a digital ID trustmark as to be likely to lead a reasonable person to believe that the entity is an accredited entity or a participating relying party: (a) use it in relation to a business, trade, profession or occupation;  Trustmarks and registers  Chapter 8 Digital ID trustmarks  Part 2  Section 119 Digital ID Act 2024 Compilation date: 21/02/2025 (b) apply (as a trade mark or otherwise) it to goods imported, manufactured, produced, sold, offered for sale or let on hire; (c) use it in relation to: (i) goods or services; or (ii) the promotion (by any means) of the supply or use of goods or services. Civil penalty: 1,000 penalty units."@en ;
    cml:integrityHash "f919cf79172354abbde77708116e1eb2fec6205ccff2391cb17edf7ea860d9d6" ;
    values:partOf concept:digital-id-act-2024-sec-117 ;
    cof:pageNumber "130"^^xsd:integer ;
    skos:note "Entity must not use digital ID trustmark in certain ways." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <digital-id-act-2024.pdf> ;
    dc:source "digital-id-act-2024.pdf, p.130" ;
    cml:asserts concept:digital-id-act-2024-sec-117-ss-3-norm .
