doc:sec-49a-ss-1 a cof:Section ;
    cof:title "49A(1) Biometric information, testing and continuous improvement" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if an accredited entity is authorised to retain, use or disclose biometric information of individuals under subsection 49(6) (about testing)." ;
    cof:pageNumber "65"^^xsd:integer .

concept:digital-id-act-2024-sec-49a-ss-2 a cml:Concept ;
    skos:prefLabel "49A(2) Biometric information, testing and continuous improvement"@en ;
    cml:realizedBy doc:sec-49a-ss-2 ;
    values:originalText "(2) The accredited entity must take reasonable steps to continuously improve its biometric systems to ensure such systems do not selectively disadvantage or discriminate against any group." ;
    skos:definition "(2) The accredited entity must take reasonable steps to continuously improve its biometric systems to ensure such systems do not selectively disadvantage or discriminate against any group."@en ;
    cml:integrityHash "c34caa096dc59d31633e39f66a0d28eac83eae241dd307985554f508df839eb4" ;
    values:partOf concept:digital-id-act-2024-sec-49a ;
    cof:pageNumber "65"^^xsd:integer ;
    skos:note "Accredited entity must continuously improve biometric systems to prevent discrimination." ;
    cml:curationStatus cml:Proposed ;
