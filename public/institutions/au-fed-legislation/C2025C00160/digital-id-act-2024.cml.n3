doc:sec-143-ss-4 a cof:Section ;
    cof:title "143(4) Decisions not required to be made in certain circumstances" ;
    values:kind "subsection" ;
    values:originalText "(4) If the Digital ID Regulator requires a compliance assessment to be conducted for the purposes of making a decision under this Act, the Digital ID Regulator is not required to make the decision until the assessment is conducted." ;
    cof:pageNumber "159"^^xsd:integer .

concept:digital-id-act-2024-sec-143-ss-5 a cml:Concept ;
    skos:prefLabel "143(5) Decisions not required to be made in certain circumstances"@en ;
    cml:realizedBy doc:sec-143-ss-5 ;
    values:originalText "(5) If Digital ID Rules made for the purposes of section 144 specify a fee that must accompany an application and payment of the fee has not been waived, the person to whom the application is made is not required to make a decision on the application until the fee is paid.  Chapter 9  Administration" ;
    skos:definition "(5) If Digital ID Rules made for the purposes of section 144 specify a fee that must accompany an application and payment of the fee has not been waived, the person to whom the application is made is not required to make a decision on the application until the fee is paid.  Chapter 9  Administration"@en ;
