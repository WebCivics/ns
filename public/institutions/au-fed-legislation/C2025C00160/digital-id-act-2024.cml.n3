doc:sec-24 a cof:Section ;
    cof:title "24 Varying accreditation" ;
    values:kind "section" ;
    values:originalText "The Digital ID Regulator may vary the accreditation of an accredited entity to take account of a change in the accredited entity’s name. Note: The Digital ID Regulator can also vary conditions on accreditation (see section 20)." ;
