    cml:curationStatus cml:Proposed .
concept:digital-id-act-2024-sec-53-ss-3 cml:asserts concept:digital-id-act-2024-sec-53-ss-3-logic-deontic-1 .
concept:digital-id-act-2024-sec-53-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits data profiling for broader business purposes." ;
