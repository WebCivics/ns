concept:digital-id-act-2024-sec-8 a cml:Concept ;
    skos:prefLabel "8 Concurrent operation of State and Territory laws"@en ;
    cml:realizedBy doc:sec-8 ;
    values:originalText "This Act is not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with this Act.  Chapter 1  Introduction" ;
