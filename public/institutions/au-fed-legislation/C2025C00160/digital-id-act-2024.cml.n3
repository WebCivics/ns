concept:digital-id-act-2024-sec-83 a cml:Concept ;
    skos:prefLabel "83 Prohibition on holding out that an entity holds an approval"@en ;
    cml:realizedBy doc:sec-83 ;
    values:originalText "An entity must not hold out that the entity holds an approval to participate in the Australian Government Digital ID System if that is not the case. Civil penalty: 1,000 penalty units.  Chapter 4  Australian Government Digital ID System" ;
    skos:definition "An entity must not hold out that the entity holds an approval to participate in the Australian Government Digital ID System if that is not the case. Civil penalty: 1,000 penalty units.  Chapter 4  Australian Government Digital ID System"@en ;
