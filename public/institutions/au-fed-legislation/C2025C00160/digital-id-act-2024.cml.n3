    cof:pageNumber "90"^^xsd:integer ;
    skos:note "May vary approval given to an entity under section 62 to take account of a change in the entity’s name." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <digital-id-act-2024.pdf> ;
