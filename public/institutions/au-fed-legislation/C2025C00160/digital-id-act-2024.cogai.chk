  type: LogicApplication;
  provision: sec-54;
  logic: LTL;
  operator: Until;
  summary: The use or disclosure of personal information must be until the start of proceedings against a person.;
  executionSurface: modalities::temporal_ltl;
  curationStatus: Proposed;
  @condition: At the time the information is used or disclosed, the accredited entity is satisfied that the enforcement body has started proceedings...;
  @action: Against a person in relation to a breach of a law imposing a penalty or sanction.;
}

