  executionSurface: modalities::diffusion;
  curationStatus: Proposed;
  @condition: At the time the information is used or disclosed, the accredited entity is satisfied that the enforcement body has started proceedings...;
  @action: Against a person for an offence against a law of the Commonwealth, a State or a Territory.;
}

