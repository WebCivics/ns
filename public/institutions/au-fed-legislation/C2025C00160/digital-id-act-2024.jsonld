      "skos:note": "Resignation takes effect on specified day"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-112-ss-2",
      "@type": "cof:Section",
      "cof:title": "112(2) Resignation of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 126,
      "values:originalText": "(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day."
