      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "The Digital ID Regulator has certain functions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Digital ID Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.113",
      "values:originalText": "The Digital ID Regulator is the Australian Competition and\nConsumer Commission.\nNote:\nThe Australian Competition and Consumer Commission is established\nby Part II of the Competition and Consumer Act 2010.",
      "skos:definition": "The Digital ID Regulator is the Australian Competition and\nConsumer Commission.\nNote:\nThe Australian Competition and Consumer Commission is established\nby Part II of the Competition and Consumer Act 2010.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-90-norm"
        }
      ],
      "cml:integrityHash": "486e01d31a9aaf56e838a7c1609f204718243335c5c14571d498868377f736e4",
      "skos:note": "Establishes the Digital ID Regulator as the Australian Competition and Consumer Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-90",
      "@type": "cof:Section",
      "cof:title": "90 Digital ID Regulator",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "The Digital ID Regulator is the Australian Competition and\nConsumer Commission.\nNote:\nThe Australian Competition and Consumer Commission is established\nby Part II of the Competition and Consumer Act 2010."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-90-norm",
