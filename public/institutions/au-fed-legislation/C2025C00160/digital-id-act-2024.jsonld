      "cml:integrityHash": "0ab8de78ed67761d1084ec2b956bf8cf588ff3f42e5c7822cffe0ebbd740e6e3",
      "skos:note": "This Act has effect in relation to acts, omissions, matters and things outside Australia subject to certain obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-7-ss-2",
      "@type": "cof:Section",
