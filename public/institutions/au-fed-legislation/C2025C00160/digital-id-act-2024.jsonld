    {
      "@id": "concept:digital-id-act-2024-sec-83",
      "@type": "cml:Concept",
      "skos:prefLabel": "83 Prohibition on holding out that an entity holds an approval",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-83"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.105",
      "values:originalText": "An entity must not hold out that the entity holds an approval to\nparticipate in the Australian Government Digital ID System if that\nis not the case.\nCivil penalty:\n1,000 penalty units.\n\nChapter 4  Australian Government Digital ID System",
      "skos:definition": "An entity must not hold out that the entity holds an approval to\nparticipate in the Australian Government Digital ID System if that\nis not the case.\nCivil penalty:\n1,000 penalty units.\n\nChapter 4  Australian Government Digital ID System",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-83-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-83-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db98c5141dfdb5ed2b339622c3441fc2b6a53f09200485a1e8243ef6ef332c5a",
      "skos:note": "Prohibition on holding out that an entity holds an approval"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-83",
      "@type": "cof:Section",
      "cof:title": "83 Prohibition on holding out that an entity holds an approval",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "An entity must not hold out that the entity holds an approval to\nparticipate in the Australian Government Digital ID System if that\nis not the case.\nCivil penalty:\n1,000 penalty units.\n\nChapter 4  Australian Government Digital ID System"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-83-norm",
      "@type": "values:Prohibition",
