    {
      "@id": "concept:digital-id-act-2024-sec-155",
      "@type": "cml:Concept",
      "skos:prefLabel": "155 Annual report by Information Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-155"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.170",
      "values:originalText": "The annual report prepared by the Information Commissioner and\ngiven to the Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude information about the performance of the Information\nCommissioner’s functions, and the exercise of the Information\nCommissioner’s powers, under or in relation to Part 2 of Chapter 3\nof this Act during the period.",
      "skos:definition": "The annual report prepared by the Information Commissioner and\ngiven to the Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude information about the performance of the Information\nCommissioner’s functions, and the exercise of the Information\nCommissioner’s powers, under or in relation to Part 2 of Chapter 3\nof this Act during the period.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-155-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-155-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fd512c1c3540ba855a6f14b65b8782a90ce9dbef785d1a05c95f021b649ad466",
      "skos:note": "Annual report must include performance information",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-155",
      "@type": "cof:Section",
      "cof:title": "155 Annual report by Information Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 170,
      "values:originalText": "The annual report prepared by the Information Commissioner and\ngiven to the Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude information about the performance of the Information\nCommissioner’s functions, and the exercise of the Information\nCommissioner’s powers, under or in relation to Part 2 of Chapter 3\nof this Act during the period."
    },
