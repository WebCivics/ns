    {
      "@id": "concept:digital-id-act-2024-sec-136",
      "@type": "cml:Concept",
      "skos:prefLabel": "136 Destruction or de-identification of certain information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-136"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.151",
      "values:originalText": "(1) This section applies to:\n(a) accredited entities that hold an approval to participate in the\nAustralian Government Digital ID System; and\n(b) accredited entities whose approval to participate in the\nAustralian Government Digital ID System is suspended; and\n\nChapter 9  Administration",
      "skos:definition": "(1) This section applies to:\n(a) accredited entities that hold an approval to participate in the\nAustralian Government Digital ID System; and\n(b) accredited entities whose approval to participate in the\nAustralian Government Digital ID System is suspended; and\n\nChapter 9  Administration",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-136-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-136-logic-deontic-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-136-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "8819a92fed229a15c5dc0532b76862a8d40181f69faf2b0d95c27be7ce162c59",
      "skos:note": "Destruction or de-identification of certain information is required for accredited entities."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-136",
      "@type": "cof:Section",
      "cof:title": "136 Destruction or de-identification of certain information",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "(1) This section applies to:\n(a) accredited entities that hold an approval to participate in the\nAustralian Government Digital ID System; and\n(b) accredited entities whose approval to participate in the\nAustralian Government Digital ID System is suspended; and\n\nChapter 9  Administration"
    },
