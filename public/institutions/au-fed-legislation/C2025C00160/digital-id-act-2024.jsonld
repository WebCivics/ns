    {
      "@id": "concept:digital-id-act-2024-sec-123-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "123(2) Civil penalty provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-123-ss-2"
      },
