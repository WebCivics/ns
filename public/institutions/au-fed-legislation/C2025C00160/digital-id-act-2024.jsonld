    },
    {
      "@id": "concept:digital-id-act-2024-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Individuals must expressly consent to disclosure of certain",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.59",
      "values:originalText": "attributes of individuals to relying parties\nWhen verifying the identity of an individual or authenticating a\ndigital ID of, or information about, an individual to a relying party,\nan accredited entity must not disclose any of the following\nattributes of the individual to the relying party without the express\nconsent of the individual:\n(a) the individual’s current name or former name;\n(b) the individual’s address;\n(c) the individual’s date of birth;\n(d) the individual’s phone number;\n(e) the individual’s email address;\n(f) an attribute of a kind prescribed by the Accreditation Rules.\nCivil penalty:\n1,500 penalty units.",
      "skos:definition": "attributes of individuals to relying parties\nWhen verifying the identity of an individual or authenticating a\ndigital ID of, or information about, an individual to a relying party,\nan accredited entity must not disclose any of the following\nattributes of the individual to the relying party without the express\nconsent of the individual:\n(a) the individual’s current name or former name;\n(b) the individual’s address;\n(c) the individual’s date of birth;\n(d) the individual’s phone number;\n(e) the individual’s email address;\n(f) an attribute of a kind prescribed by the Accreditation Rules.\nCivil penalty:\n1,500 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-45-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-45-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa3c2f8e88f5c7a96034e0c14e096e940255175d6a40d6a1db1c92233a28d4a9",
      "skos:note": "Must provide explicit consent for disclosure of certain attributes.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Individuals must expressly consent to disclosure of certain",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "attributes of individuals to relying parties\nWhen verifying the identity of an individual or authenticating a\ndigital ID of, or information about, an individual to a relying party,\nan accredited entity must not disclose any of the following\nattributes of the individual to the relying party without the express\nconsent of the individual:\n(a) the individual’s current name or former name;\n(b) the individual’s address;\n(c) the individual’s date of birth;\n(d) the individual’s phone number;\n(e) the individual’s email address;\n(f) an attribute of a kind prescribed by the Accreditation Rules.\nCivil penalty:\n1,500 penalty units."
    },
    {
