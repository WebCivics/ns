    {
      "@id": "concept:digital-id-act-2024-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Extraterritorial operation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.17",
      "values:originalText": "(1) This Act extends to acts, omissions, matters and things outside\nAustralia.\nNote:\nGeographical jurisdiction for civil penalty provisions is dealt with in\nsection 160.\n(2) This Act has effect in relation to acts, omissions, matters and\nthings outside Australia subject to:\n(a) the obligations of Australia under international law, including\nobligations under any international agreement binding on\nAustralia; and\n(b) any law of the Commonwealth giving effect to such an\nagreement.",
      "skos:definition": "(1) This Act extends to acts, omissions, matters and things outside\nAustralia.\nNote:\nGeographical jurisdiction for civil penalty provisions is dealt with in\nsection 160.\n(2) This Act has effect in relation to acts, omissions, matters and\nthings outside Australia subject to:\n(a) the obligations of Australia under international law, including\nobligations under any international agreement binding on\nAustralia; and\n(b) any law of the Commonwealth giving effect to such an\nagreement.",
      "cml:hasPart": [
