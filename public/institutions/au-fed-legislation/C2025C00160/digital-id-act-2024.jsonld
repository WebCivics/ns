      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-91",
      "@type": "cml:Concept",
      "skos:prefLabel": "91 Functions of the Digital ID Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-91"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.113",
      "values:originalText": "The Digital ID Regulator has the following functions:\n(a) to promote compliance with this Act;\n(b) to make available general information for guidance in\nrelation to the carrying out of the functions, or the exercise of\nthe powers, of the Digital ID Regulator under this Act;\n(c) to consult with the following as required in relation to\nperforming functions and exercising powers of the Digital ID\nRegulator under this Act:\n(i) the System Administrator;\n(ii) the Information Commissioner;\n(iii) the Australian Securities and Investments Commission;\n(iv) the Australian Prudential Regulation Authority;\n(v) the Australian Financial Complaints Authority;\n(vi) the part of the Australian Signals Directorate known as\nthe Australian Cyber Security Centre;\n(vii) any other body the Digital ID Regulator considers\nappropriate;\n(d) to advise the following, either on its own initiative or on\nrequest, on matters relating to this Act:\n(i) the Minister;\n(ii) the System Administrator;\n(iii) the Digital ID Data Standards Chair;\n\nChapter 5  Digital ID Regulator",
      "skos:definition": "The Digital ID Regulator has the following functions:\n(a) to promote compliance with this Act;\n(b) to make available general information for guidance in\nrelation to the carrying out of the functions, or the exercise of\nthe powers, of the Digital ID Regulator under this Act;\n(c) to consult with the following as required in relation to\nperforming functions and exercising powers of the Digital ID\nRegulator under this Act:\n(i) the System Administrator;\n(ii) the Information Commissioner;\n(iii) the Australian Securities and Investments Commission;\n(iv) the Australian Prudential Regulation Authority;\n(v) the Australian Financial Complaints Authority;\n(vi) the part of the Australian Signals Directorate known as\nthe Australian Cyber Security Centre;\n(vii) any other body the Digital ID Regulator considers\nappropriate;\n(d) to advise the following, either on its own initiative or on\nrequest, on matters relating to this Act:\n(i) the Minister;\n(ii) the System Administrator;\n(iii) the Digital ID Data Standards Chair;\n\nChapter 5  Digital ID Regulator",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-91-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-91-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bb704c90e443d499d5505fb8cd5589e2a39c492cff8bb95c5dcc0ed6c8b82b28",
      "skos:note": "Functions of the Digital ID Regulator"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-91",
      "@type": "cof:Section",
      "cof:title": "91 Functions of the Digital ID Regulator",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "The Digital ID Regulator has the following functions:\n(a) to promote compliance with this Act;\n(b) to make available general information for guidance in\nrelation to the carrying out of the functions, or the exercise of\nthe powers, of the Digital ID Regulator under this Act;\n(c) to consult with the following as required in relation to\nperforming functions and exercising powers of the Digital ID\nRegulator under this Act:\n(i) the System Administrator;\n(ii) the Information Commissioner;\n(iii) the Australian Securities and Investments Commission;\n(iv) the Australian Prudential Regulation Authority;\n(v) the Australian Financial Complaints Authority;\n(vi) the part of the Australian Signals Directorate known as\nthe Australian Cyber Security Centre;\n(vii) any other body the Digital ID Regulator considers\nappropriate;\n(d) to advise the following, either on its own initiative or on\nrequest, on matters relating to this Act:\n(i) the Minister;\n(ii) the System Administrator;\n(iii) the Digital ID Data Standards Chair;\n\nChapter 5  Digital ID Regulator"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-91-norm",
      "@type": "values:Obligation",
