      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The decision was made after the previous notice was given under subsection 15(7).",
      "cml:conclusionText": "There is a temporal overlap between this provision and the previous notice."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-23-ss-2-logic-ltl-3",
