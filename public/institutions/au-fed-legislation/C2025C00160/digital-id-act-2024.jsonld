      ],
      "cml:integrityHash": "a0e07c70fa4926174b0bd0514de647e4036a32f593df425e87557bcfb97fadf0",
      "skos:note": "May vary accreditation of an accredited entity to account for a change in the entity's name."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Varying accreditation",
