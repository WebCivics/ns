    {
      "@id": "concept:digital-id-act-2024-sec-160",
      "@type": "cml:Concept",
      "skos:prefLabel": "160 Geographical jurisdiction of civil penalty provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-160"
      },
      "cml:curationStatus": {
