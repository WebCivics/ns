      "skos:note": "Accredited identity exchange providers must not retain certain attributes of individuals"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Accredited identity exchange providers must not retain certain",
      "values:kind": "section",
