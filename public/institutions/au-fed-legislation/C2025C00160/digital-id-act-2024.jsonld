      "cml:operator": "Applicable",
      "cml:logicSummary": "Describes temporal intervals",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
