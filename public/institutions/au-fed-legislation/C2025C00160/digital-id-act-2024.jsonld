    {
      "@id": "concept:digital-id-act-2024-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Other rules relating to biometric information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.68",
      "values:originalText": "(1) The Accreditation Rules may provide for and in relation to the\ncollection, use, disclosure, storage or destruction of biometric\ninformation of individuals by accredited entities.\n(2) Without limiting subsection (1), the Accreditation Rules may\nprovide for requirements relating to quality, security or fraud.",
      "skos:definition": "(1) The Accreditation Rules may provide for and in relation to the\ncollection, use, disclosure, storage or destruction of biometric\ninformation of individuals by accredited entities.\n(2) Without limiting subsection (1), the Accreditation Rules may\nprovide for requirements relating to quality, security or fraud.",
      "cml:hasPart": [
        {
          "@id": "concept:digital-id-act-2024-sec-52-ss-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-52-ss-2"
        }
      ],
      "cml:integrityHash": "9ef076380dc11a754c8e1c792a28486dc6468162b0d53964a959d417a898e007"
    },
    {
