      "values:kind": "subsection",
      "cof:pageNumber": 60,
      "values:originalText": "(1) This section applies if:\n(a) an accredited entity (the assigning entity) assigns a unique\nidentifier to an individual within a digital ID system; and\n(b) the assigning entity discloses the unique identifier to another\naccredited entity or to a relying party."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-47-ss-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
