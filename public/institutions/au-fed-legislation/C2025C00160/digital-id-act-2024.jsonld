    {
      "@id": "concept:digital-id-act-2024-sec-107",
      "@type": "cml:Concept",
      "skos:prefLabel": "107 Acting appointments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-107"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.123",
      "values:originalText": "The Minister may, by written instrument, appoint a person to act as\nthe Digital ID Data Standards Chair:\n(a) during a vacancy in the office of Digital ID Data Standards\nChair (whether or not an appointment has previously been\nmade to the office); or\n(b) during any period, or during all periods, when the Digital ID\nData Standards Chair:\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see sections 33AB and\n33A of the Acts Interpretation Act 1901.\n\nChapter 7  Digital ID Data Standards",
      "skos:definition": "The Minister may, by written instrument, appoint a person to act as\nthe Digital ID Data Standards Chair:\n(a) during a vacancy in the office of Digital ID Data Standards\nChair (whether or not an appointment has previously been\nmade to the office); or\n(b) during any period, or during all periods, when the Digital ID\nData Standards Chair:\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see sections 33AB and\n33A of the Acts Interpretation Act 1901.\n\nChapter 7  Digital ID Data Standards",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-107-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-107-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a667235b30d73f0f42e55c7becc470f97c32e0b5cbdeb862e01d2c74b1cfc5dd",
      "skos:note": "The Minister may appoint a person to act as Digital ID Data Standards Chair."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-107",
      "@type": "cof:Section",
      "cof:title": "107 Acting appointments",
      "values:kind": "section",
      "cof:pageNumber": 123,
      "values:originalText": "The Minister may, by written instrument, appoint a person to act as\nthe Digital ID Data Standards Chair:\n(a) during a vacancy in the office of Digital ID Data Standards\nChair (whether or not an appointment has previously been\nmade to the office); or\n(b) during any period, or during all periods, when the Digital ID\nData Standards Chair:\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see sections 33AB and\n33A of the Acts Interpretation Act 1901.\n\nChapter 7  Digital ID Data Standards"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-107-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
