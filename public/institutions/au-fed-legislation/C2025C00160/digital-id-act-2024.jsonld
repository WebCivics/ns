        }
      ],
      "cml:integrityHash": "dbeb6e52d8d0c09568e021958ad9c3eafbfdc5b54aee7ed5b0d06e270ddff1f3",
      "skos:note": "Entities may apply for accreditation as accredited attribute service providers, identity exchange providers, identity service providers, or entities providing a prescribed service."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-14-ss-1",
      "@type": "cof:Section",
      "cof:title": "14(1) Application for accreditation",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(1) An entity covered by subsection (2) may apply to the Digital ID\nRegulator for accreditation as one or more of the following kinds\nof accredited entities:\n(a) an accredited attribute service provider;\n(b) an accredited identity exchange provider;\n(c) an accredited identity service provider;\n(d) an entity that provides, or proposes to provide, a service of a\nkind prescribed by the Accreditation Rules."
    },
    {
