    {
      "@id": "concept:digital-id-act-2024-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.17",
      "values:originalText": "This Act is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Act.\n\nChapter 1  Introduction",
      "skos:definition": "This Act is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Act.\n\nChapter 1  Introduction",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-8-norm"
        }
      ],
      "cml:integrityHash": "9eafbf9e185ab9aaad0f6de023415f34ba99ca3442d3e3b4a5585e71a1ca6f6b",
      "skos:note": "No exclusion of State or Territory laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Concurrent operation of State and Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "This Act is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Act.\n\nChapter 1  Introduction"
    },
