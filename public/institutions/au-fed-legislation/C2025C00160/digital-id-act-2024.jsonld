      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-161",
      "@type": "cml:Concept",
      "skos:prefLabel": "161 Interaction with tax file number offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-161"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.178",
      "values:originalText": "To avoid doubt, nothing in this Act affects or limits the operation\nof:\n(a) sections 8WA and 8WB of the Taxation Administration Act\n1953; or\n(b) rules made under section 17 of the Privacy Act 1988.\nNote 1:\nSections 8WA and 8WB of the Taxation Administration Act 1953\ncontain offences for unauthorised use etc. of tax file numbers.\nNote 2:\nSection 17 of the Privacy Act 1988 requires the Information\nCommissioner to issue rules concerning the collection, storage, use\nand security of tax file numbers.\n\nOther matters  Chapter 10\nOther matters  Part 4\n\nSection 162\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "skos:definition": "To avoid doubt, nothing in this Act affects or limits the operation\nof:\n(a) sections 8WA and 8WB of the Taxation Administration Act\n1953; or\n(b) rules made under section 17 of the Privacy Act 1988.\nNote 1:\nSections 8WA and 8WB of the Taxation Administration Act 1953\ncontain offences for unauthorised use etc. of tax file numbers.\nNote 2:\nSection 17 of the Privacy Act 1988 requires the Information\nCommissioner to issue rules concerning the collection, storage, use\nand security of tax file numbers.\n\nOther matters  Chapter 10\nOther matters  Part 4\n\nSection 162\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-161-norm"
        }
      ],
      "cml:integrityHash": "445cd8a92842a981bed23e7e006765daa51fc673bdda58f0231c111f970b23d7",
      "skos:note": "Nothing in this Act affects or limits the operation of certain tax file number offences."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-161",
      "@type": "cof:Section",
      "cof:title": "161 Interaction with tax file number offences",
      "values:kind": "section",
      "cof:pageNumber": 178,
      "values:originalText": "To avoid doubt, nothing in this Act affects or limits the operation\nof:\n(a) sections 8WA and 8WB of the Taxation Administration Act\n1953; or\n(b) rules made under section 17 of the Privacy Act 1988.\nNote 1:\nSections 8WA and 8WB of the Taxation Administration Act 1953\ncontain offences for unauthorised use etc. of tax file numbers.\nNote 2:\nSection 17 of the Privacy Act 1988 requires the Information\nCommissioner to issue rules concerning the collection, storage, use\nand security of tax file numbers.\n\nOther matters  Chapter 10\nOther matters  Part 4\n\nSection 162\nDigital ID Act 2024\nCompilation date: 21/02/2025"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-161-norm",
      "@type": "values:Obligation",
      "cml:modality": {
