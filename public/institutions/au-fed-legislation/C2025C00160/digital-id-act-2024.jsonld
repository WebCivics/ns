      },
      "cml:premiseText": "such other functions as are conferred on the Chair by this Act;",
      "cml:conclusionText": "temporal interval is described"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-103",
      "@type": "cml:Concept",
      "skos:prefLabel": "103 Powers of the Digital ID Data Standards Chair",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-103"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.121",
      "values:originalText": "The Digital ID Data Standards Chair has the following powers:\n(a) the power to establish committees, advisory panels and\nconsultative groups;\n(b) the power to do all other things necessary or convenient to be\ndone for or in connection with the performance of the Chair’s\nfunctions.",
      "skos:definition": "The Digital ID Data Standards Chair has the following powers:\n(a) the power to establish committees, advisory panels and\nconsultative groups;\n(b) the power to do all other things necessary or convenient to be\ndone for or in connection with the performance of the Chair’s\nfunctions.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-103-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-103-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3b3ad5367f9278958ae24db803f8b79b7deac7adc5ee51248ab76f9527f4fbcf",
      "skos:note": "Establishment of committees, advisory panels and consultative groups."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-103",
      "@type": "cof:Section",
      "cof:title": "103 Powers of the Digital ID Data Standards Chair",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "The Digital ID Data Standards Chair has the following powers:\n(a) the power to establish committees, advisory panels and\nconsultative groups;\n(b) the power to do all other things necessary or convenient to be\ndone for or in connection with the performance of the Chair’s\nfunctions."
    },
