      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.175",
      "values:originalText": "Geographical jurisdiction of civil penalty provisions\n(1) An entity does not contravene a civil penalty provision of this Act\nunless:\n\nChapter 10  Other matters",
      "skos:definition": "Geographical jurisdiction of civil penalty provisions\n(1) An entity does not contravene a civil penalty provision of this Act\nunless:\n\nChapter 10  Other matters",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-160-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-160-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f286de0884f940b242abcf93ac9bd13b962359dc80451524a31dd4413bd70e7a",
      "skos:note": "Entity must comply with civil penalty provisions within geographical jurisdiction."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-160",
      "@type": "cof:Section",
      "cof:title": "160 Geographical jurisdiction of civil penalty provisions",
      "values:kind": "section",
      "cof:pageNumber": 175,
      "values:originalText": "Geographical jurisdiction of civil penalty provisions\n(1) An entity does not contravene a civil penalty provision of this Act\nunless:\n\nChapter 10  Other matters"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-160-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
