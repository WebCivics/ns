    {
      "@id": "concept:digital-id-act-2024-sec-145",
      "@type": "cml:Concept",
      "skos:prefLabel": "145 Review of fees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-145"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.161",
      "values:originalText": "(1) The Minister must cause periodic reviews of rules made for the\npurposes of subsection 144(1) to be undertaken.\n(2) The first review must:\n(a) start no later than 2 years after rules made for the purposes of\nsubsection 144(1) commence; and\n(b) be completed within 12 months.\n(3) Subsequent reviews must:\n(a) start no later than every 2 years after the completion of the\nprevious review; and\n(b) be completed within 12 months.\n(4) The Minister must cause a written report about each review:\n(a) to be prepared; and\n(b) to be tabled in each House of the Parliament within 15 sitting\ndays of that House after the Minister receives the report.",
      "skos:definition": "(1) The Minister must cause periodic reviews of rules made for the\npurposes of subsection 144(1) to be undertaken.\n(2) The first review must:\n(a) start no later than 2 years after rules made for the purposes of\nsubsection 144(1) commence; and\n(b) be completed within 12 months.\n(3) Subsequent reviews must:\n(a) start no later than every 2 years after the completion of the\nprevious review; and\n(b) be completed within 12 months.\n(4) The Minister must cause a written report about each review:\n(a) to be prepared; and\n(b) to be tabled in each House of the Parliament within 15 sitting\ndays of that House after the Minister receives the report.",
      "cml:hasPart": [
        {
          "@id": "concept:digital-id-act-2024-sec-145-ss-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-145-ss-2"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-145-ss-3"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-145-ss-4"
        }
      ],
      "cml:integrityHash": "f69ad1470f467314cdaf7f323bb1aef2411bed1a490dd57ea59efbaae4923d01"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-145",
      "@type": "cof:Section",
      "cof:title": "145 Review of fees",
      "values:kind": "section",
      "cof:pageNumber": 161,
      "values:originalText": "(1) The Minister must cause periodic reviews of rules made for the\npurposes of subsection 144(1) to be undertaken.\n(2) The first review must:\n(a) start no later than 2 years after rules made for the purposes of\nsubsection 144(1) commence; and\n(b) be completed within 12 months.\n(3) Subsequent reviews must:\n(a) start no later than every 2 years after the completion of the\nprevious review; and\n(b) be completed within 12 months.\n(4) The Minister must cause a written report about each review:\n(a) to be prepared; and\n(b) to be tabled in each House of the Parliament within 15 sitting\ndays of that House after the Minister receives the report."
    },
