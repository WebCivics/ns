    {
      "@id": "concept:digital-id-act-2024-sec-109-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "109(5) Remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-109-ss-5"
      },
      "cml:curationStatus": {
