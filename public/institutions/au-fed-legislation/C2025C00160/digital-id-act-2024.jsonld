      },
      "cml:premiseText": "The Digital ID Regulator is not required to give an entity notice.",
      "cml:conclusionText": "This provision diffuses the requirement to provide notice."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-23-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
