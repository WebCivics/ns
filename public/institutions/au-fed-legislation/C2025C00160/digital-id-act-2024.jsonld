      },
      "cml:premiseText": "(2) The entity is covered by subsection (2)",
      "cml:conclusionText": "The entity is an artificial agent or natural person"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-34-ss-1-logic-shacl-5",
