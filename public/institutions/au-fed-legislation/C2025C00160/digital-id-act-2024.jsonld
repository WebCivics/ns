    {
      "@id": "concept:digital-id-act-2024-sec-112",
      "@type": "cml:Concept",
      "skos:prefLabel": "112 Resignation of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-112"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.126",
      "values:originalText": "(1) The Digital ID Data Standards Chair may resign the Digital ID\nData Standards Chair’s appointment by giving the Minister a\nwritten resignation.\n(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day.",
      "skos:definition": "(1) The Digital ID Data Standards Chair may resign the Digital ID\nData Standards Chair’s appointment by giving the Minister a\nwritten resignation.\n(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day.",
      "cml:hasPart": [
        {
          "@id": "concept:digital-id-act-2024-sec-112-ss-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-112-ss-2"
        }
      ],
      "cml:integrityHash": "05403fd03724594f360a6e526e0d073334e07fd215e9f5af13c6e6e15a9b0973"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-112",
      "@type": "cof:Section",
      "cof:title": "112 Resignation of appointment",
      "values:kind": "section",
      "cof:pageNumber": 126,
      "values:originalText": "(1) The Digital ID Data Standards Chair may resign the Digital ID\nData Standards Chair’s appointment by giving the Minister a\nwritten resignation.\n(2) The resignation takes effect on the day it is received by the\nMinister or, if a later day is specified in the resignation, on that\nlater day."
    },
