    {
      "@id": "concept:digital-id-act-2024-sec-102",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Functions of the Digital ID Data Standards Chair",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-102"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.121",
      "values:originalText": "The functions of the Digital ID Data Standards Chair are:\n(a) to make Digital ID Data Standards; and\n(b) to review those standards regularly; and\n(c) such other functions as are conferred on the Chair by this\nAct; and\n(d) to do anything incidental or conducive to the performance of\nany of the above functions.",
      "skos:definition": "The functions of the Digital ID Data Standards Chair are:\n(a) to make Digital ID Data Standards; and\n(b) to review those standards regularly; and\n(c) such other functions as are conferred on the Chair by this\nAct; and\n(d) to do anything incidental or conducive to the performance of\nany of the above functions.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-102-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-102-logic-deontic-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-102-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "5b0419ac7f41cb098277fd103cc190934dfefee0a51cbc14f7115cd2b050beb4",
      "skos:note": "Functions of the Digital ID Data Standards Chair"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-102",
      "@type": "cof:Section",
      "cof:title": "102 Functions of the Digital ID Data Standards Chair",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "The functions of the Digital ID Data Standards Chair are:\n(a) to make Digital ID Data Standards; and\n(b) to review those standards regularly; and\n(c) such other functions as are conferred on the Chair by this\nAct; and\n(d) to do anything incidental or conducive to the performance of\nany of the above functions."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-102-norm",
