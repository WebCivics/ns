    {
      "@id": "concept:digital-id-act-2024-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Extension to external Territories",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
