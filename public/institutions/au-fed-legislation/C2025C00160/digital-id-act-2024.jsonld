      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This Act purports to impose an obligation or duty",
      "cml:conclusionText": "on each person who is an accountable person for the entity at the time the obligation or duty arises or is in operation"
    },
    {
