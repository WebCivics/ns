    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-10-ss-1",
      "@type": "cof:Section",
      "cof:title": "10(1) Meaning of attribute of an individual",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(1) An attribute of an individual means information that is associated\nwith the individual, and includes information that is derived from\nanother attribute."
    },
