        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The entity seeking authorisation to collect or disclose the restricted attribute must provide:"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-18-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "18(3) Conditions relating to restricted attributes of individuals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-18-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.34",
      "values:originalText": "(3) If the Digital ID Regulator imposes the condition authorising the\nentity to collect or disclose a restricted attribute of an individual,\nthe Digital ID Regulator must publish on the Digital ID\nRegulator’s website a statement of reasons for giving the\nauthorisation.\n\nChapter 2  Accreditation",
      "skos:definition": "(3) If the Digital ID Regulator imposes the condition authorising the\nentity to collect or disclose a restricted attribute of an individual,\nthe Digital ID Regulator must publish on the Digital ID\nRegulator’s website a statement of reasons for giving the\nauthorisation.\n\nChapter 2  Accreditation",
      "values:partOf": {
        "@id": "concept:digital-id-act-2024-sec-18"
      },
      "cml:asserts": [
