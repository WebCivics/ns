    {
      "@id": "concept:digital-id-act-2024-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Prohibition on holding out that an entity is accredited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.49",
      "values:originalText": "An entity must not hold out that the entity is an accredited entity if\nthat is not the case.\nCivil penalty:\n1,000 penalty units.\n\nChapter 3  Privacy",
      "skos:definition": "An entity must not hold out that the entity is an accredited entity if\nthat is not the case.\nCivil penalty:\n1,000 penalty units.\n\nChapter 3  Privacy",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-31-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-31-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6b974c9f7821b17ace7547c97cb8046c095ccc4244cc146a3422650a373922d0",
      "skos:note": "Prohibition on holding out that an entity is accredited"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Prohibition on holding out that an entity is accredited",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "An entity must not hold out that the entity is an accredited entity if\nthat is not the case.\nCivil penalty:\n1,000 penalty units.\n\nChapter 3  Privacy"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-31-norm",
