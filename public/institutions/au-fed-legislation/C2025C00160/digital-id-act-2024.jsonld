      "dc:source": "digital-id-act-2024.pdf, p.109",
      "values:originalText": "The Digital ID Rules may make provision for and in relation to\ndispute resolution procedures that must be complied with before an\nentity can apply for an order under subsection 85(3).\n\nChapter 4  Australian Government Digital ID System",
      "skos:definition": "The Digital ID Rules may make provision for and in relation to\ndispute resolution procedures that must be complied with before an\nentity can apply for an order under subsection 85(3).\n\nChapter 4  Australian Government Digital ID System",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-87-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-87-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "44af769ecb9cf3bd1c6552b7a04dde446f5dc0b4e7540302dba05d3610902fad",
      "skos:note": "Entities must comply with dispute resolution procedures before applying for an order."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-87",
