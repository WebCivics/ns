    {
      "@id": "concept:digital-id-act-2024-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Additional function of the Information Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.57",
      "values:originalText": "In addition to the Information Commissioner’s functions under the\nPrivacy Act 1988, the Information Commissioner has the function\nof providing advice, on request by the Digital ID Regulator, on\nmatters relating to the operation of this Act.",
      "skos:definition": "In addition to the Information Commissioner’s functions under the\nPrivacy Act 1988, the Information Commissioner has the function\nof providing advice, on request by the Digital ID Regulator, on\nmatters relating to the operation of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-42-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-42-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e358cedf157e17d0521ee382338f28a1c87a77c1d12ddb1a2d88db1ab9a40d5e",
      "skos:note": "The Information Commissioner must provide advice on matters relating to the operation of this Act upon request by the Digital ID Regulator."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Additional function of the Information Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "In addition to the Information Commissioner’s functions under the\nPrivacy Act 1988, the Information Commissioner has the function\nof providing advice, on request by the Digital ID Regulator, on\nmatters relating to the operation of this Act."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-42-norm",
