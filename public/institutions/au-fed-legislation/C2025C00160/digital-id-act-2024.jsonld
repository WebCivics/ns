      ],
      "cml:integrityHash": "5e239980900c0e019338c9cf588997ee4b956d3d0c02fa424b108cf580c637a3",
      "skos:note": "A direction given under this section is not a legislative instrument."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-73-ss-5",
      "@type": "cof:Section",
      "cof:title": "73(5) Minister’s directions regarding participation",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(5) A direction given under this section is not a legislative instrument.\n\nAustralian Government Digital ID System  Chapter 4\nAustralian Government Digital ID System  Part 2\nOther matters relating to the Australian Government Digital ID System  Division 5\nSection 74\nDigital ID Act 2024\nCompilation date: 21/02/2025"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-73-ss-5-norm",
