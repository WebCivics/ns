    },
    {
      "@id": "concept:digital-id-act-2024-sec-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "96 Powers of the System Administrator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
