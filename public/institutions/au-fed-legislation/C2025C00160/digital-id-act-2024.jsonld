    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-7-ss-1",
      "@type": "cof:Section",
      "cof:title": "7(1) Extraterritorial operation",
      "values:kind": "subsection",
      "cof:pageNumber": 17,
      "values:originalText": "(1) This Act extends to acts, omissions, matters and things outside\nAustralia.\nNote:\nGeographical jurisdiction for civil penalty provisions is dealt with in\nsection 160."
    },
