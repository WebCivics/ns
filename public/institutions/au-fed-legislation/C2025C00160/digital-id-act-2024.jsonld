    {
      "@id": "concept:digital-id-act-2024-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Accredited identity exchange providers must not retain certain",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-56"
      },
      "cml:curationStatus": {
