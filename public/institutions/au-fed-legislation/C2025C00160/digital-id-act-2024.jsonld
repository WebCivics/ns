    {
      "@id": "concept:digital-id-act-2024-sec-59",
      "@type": "cml:Concept",
      "skos:prefLabel": "59 Circumstances in which entities may provide or receive services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-59"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.75",
      "values:originalText": "within the Australian Government Digital ID System\n(1) An entity mentioned in column 1 of an item in the following table\nmay provide or receive services within the Australian Government\nDigital ID System if the entity satisfies the requirements set out in\ncolumn 2 of that item.\nServices provided or received within the Australian Government Digital ID\nSystem\nItem\nColumn 1\nEntity\nColumn 2\nRequirements\nAttribute service provider\n(a) the attribute service provider:\n(i) must be an accredited attribute\nservice provider; and\n(ii) must hold an approval under\nsection 62 to participate in the\nsystem; and\n(b) the participation start day for the\nattribute service provider must have\narrived or passed\n\nChapter 4  Australian Government Digital ID System",
      "skos:definition": "within the Australian Government Digital ID System\n(1) An entity mentioned in column 1 of an item in the following table\nmay provide or receive services within the Australian Government\nDigital ID System if the entity satisfies the requirements set out in\ncolumn 2 of that item.\nServices provided or received within the Australian Government Digital ID\nSystem\nItem\nColumn 1\nEntity\nColumn 2\nRequirements\nAttribute service provider\n(a) the attribute service provider:\n(i) must be an accredited attribute\nservice provider; and\n(ii) must hold an approval under\nsection 62 to participate in the\nsystem; and\n(b) the participation start day for the\nattribute service provider must have\narrived or passed\n\nChapter 4  Australian Government Digital ID System",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-59-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-59-logic-alleninterval-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-59-logic-deontic-2"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-59-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "e4a1020e3d212279a2ba021af14970ccf883670f9c9016af71519b5868398075",
      "skos:note": "Entities may provide or receive services within the Australian Government Digital ID System if they satisfy certain requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-59",
      "@type": "cof:Section",
      "cof:title": "59 Circumstances in which entities may provide or receive services",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "within the Australian Government Digital ID System\n(1) An entity mentioned in column 1 of an item in the following table\nmay provide or receive services within the Australian Government\nDigital ID System if the entity satisfies the requirements set out in\ncolumn 2 of that item.\nServices provided or received within the Australian Government Digital ID\nSystem\nItem\nColumn 1\nEntity\nColumn 2\nRequirements\nAttribute service provider\n(a) the attribute service provider:\n(i) must be an accredited attribute\nservice provider; and\n(ii) must hold an approval under\nsection 62 to participate in the\nsystem; and\n(b) the participation start day for the\nattribute service provider must have\narrived or passed\n\nChapter 4  Australian Government Digital ID System"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-59-norm",
