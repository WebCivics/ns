    },
    {
      "@id": "concept:digital-id-act-2024-sec-47-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Restrictive Diffusion",
      "cml:logicSummary": "Restriction on diffusion of information",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The accredited entity to whom the unique identifier is disclosed must not disclose the unique identifier to any other entity.",
      "cml:conclusionText": "The restriction prevents the spread of information about the unique identifier."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-47-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
