      },
      "cml:premiseText": "Entity must not use digital ID trustmark in relation to a business, trade, profession or occupation.",
      "cml:conclusionText": "Entity must not use digital ID trustmark in certain ways."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-117-ss-3-logic-descriptionlogic-2",
