    {
      "@id": "concept:digital-id-act-2024-sec-114",
      "@type": "cml:Concept",
      "skos:prefLabel": "114 Other terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-114"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.127",
      "values:originalText": "(1) The Digital ID Data Standards Chair holds office on the terms and\nconditions (if any) in relation to matters not covered by this\nDivision that are determined by the Minister.\n(2) Subsection (1) does not apply while the Digital ID Data Standards\nChair is the Minister.\n\nChapter 7  Digital ID Data Standards",
      "skos:definition": "(1) The Digital ID Data Standards Chair holds office on the terms and\nconditions (if any) in relation to matters not covered by this\nDivision that are determined by the Minister.\n(2) Subsection (1) does not apply while the Digital ID Data Standards\nChair is the Minister.\n\nChapter 7  Digital ID Data Standards",
      "cml:hasPart": [
        {
          "@id": "concept:digital-id-act-2024-sec-114-ss-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-114-ss-2"
        }
      ],
      "cml:integrityHash": "9d49ca1c5646da9c319917835443a784e95217e80b0d0e8349ee1cb50e0ace61"
    },
