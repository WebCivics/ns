      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MustNot",
      "cml:logicSummary": "Digital ID Regulator must not approve entity",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
