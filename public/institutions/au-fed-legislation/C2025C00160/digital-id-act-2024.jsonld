      "cml:integrityHash": "c0ab249bd6cc23750ef615cfaf44752c88e3ac58b6f2f1f6b5643d8a9a3a1c8b",
      "skos:note": "Accredited entities are not liable for provision of services to other accredited entities or relying parties."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-84-ss-1",
      "@type": "cof:Section",
