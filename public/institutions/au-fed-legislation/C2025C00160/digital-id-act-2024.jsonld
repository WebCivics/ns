    },
    {
      "@id": "concept:digital-id-act-2024-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Information Commissioner may share information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.57",
      "values:originalText": "Sections 33A and 33B of the Privacy Act 1988 apply as if a\nreference in those sections to that Act included a reference to this\nAct.\nNote:\nSections 33A and 33B of the Privacy Act 1988 allow the Information\nCommissioner to share information acquired in the course of\nexercising powers, or performing functions or duties, under that Act in\ncertain circumstances.\n\nChapter 3  Privacy",
      "skos:definition": "Sections 33A and 33B of the Privacy Act 1988 apply as if a\nreference in those sections to that Act included a reference to this\nAct.\nNote:\nSections 33A and 33B of the Privacy Act 1988 allow the Information\nCommissioner to share information acquired in the course of\nexercising powers, or performing functions or duties, under that Act in\ncertain circumstances.\n\nChapter 3  Privacy",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-43-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-43-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7234c1d0b40696ac7008e2bf398e3fe8a52f5e57c324c8f5a029bb491c2cc7d6",
      "skos:note": "Sharing of information by Information Commissioner"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-43",
      "@type": "cof:Section",
      "cof:title": "43 Information Commissioner may share information",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Sections 33A and 33B of the Privacy Act 1988 apply as if a\nreference in those sections to that Act included a reference to this\nAct.\nNote:\nSections 33A and 33B of the Privacy Act 1988 allow the Information\nCommissioner to share information acquired in the course of\nexercising powers, or performing functions or duties, under that Act in\ncertain circumstances.\n\nChapter 3  Privacy"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-43-norm",
