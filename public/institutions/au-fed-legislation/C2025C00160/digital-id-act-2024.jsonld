      "cml:integrityHash": "5c6a584b680eab3f2d7d71823822b227ea501befb1495c442d5427bfa813d6b6",
      "skos:note": "Prescribes requirements for the security, reliability and stability of the Australian Government Digital ID System."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-62-ss-3",
      "@type": "cof:Section",
      "cof:title": "62(3) Approval to participate in the Australian Government Digital ID",
      "values:kind": "subsection",
      "cof:pageNumber": 80,
      "values:originalText": "(3) Without limiting paragraph (1)(f), the Digital ID Rules may\nprescribe requirements relating to the security, reliability and\nstability of the Australian Government Digital ID System."
    },
