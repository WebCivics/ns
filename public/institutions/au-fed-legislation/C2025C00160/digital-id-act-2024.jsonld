      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Classification of entities that can use digital ID trustmark.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An entity must not do any of the following in relation to a mark, symbol, logo or design so closely resembling a digital ID trustmark as to be likely to lead a reasonable person to believe that the entity is an accredited entity or a participating relying party:",
      "cml:conclusionText": "Entities that can use digital ID trustmark are those that do not resemble it."
    },
    {
