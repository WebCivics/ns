        }
      ],
      "cml:integrityHash": "4111f1dc5835aecca42676db95bc7e8e8b3bb9d082600520467f378c116ad3d2",
      "skos:note": "Entity must provide notification of data breaches to another entity."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-41-ss-1",
      "@type": "cof:Section",
      "cof:title": "41(1) Notification of corresponding data breaches—accredited State or",
      "values:kind": "subsection",
      "cof:pageNumber": 56,
      "values:originalText": "(1) This section applies to an accredited entity if:\n\nPrivacy  Chapter 3\nPrivacy  Part 2\nInteraction with the Privacy Act 1988  Division 1\nSection 42\nDigital ID Act 2024\nCompilation date: 21/02/2025\n(a) the entity is not an APP entity; and\n(b) the entity is a department or authority of a State or Territory;\nand\n(c) the entity is required under a law of the State or Territory to\ngive a statement (however described) that corresponds to\nsection 26WK of the Privacy Act 1988 to another entity (the\nnotified entity); and\n(d) the statement relates to the accredited services of the entity."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-41-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
