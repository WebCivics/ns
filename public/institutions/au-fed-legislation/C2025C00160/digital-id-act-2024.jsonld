    },
    {
      "@id": "concept:digital-id-act-2024-sec-106",
      "@type": "cml:Concept",
      "skos:prefLabel": "106 Term of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-106"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.123",
      "values:originalText": "The Digital ID Data Standards Chair holds office for the period\nspecified in the instrument of appointment. The period must not\nexceed 3 years.\nNote:\nThe Digital ID Data Standards Chair may be reappointed: see\nsection 33AA of the Acts Interpretation Act 1901.",
      "skos:definition": "The Digital ID Data Standards Chair holds office for the period\nspecified in the instrument of appointment. The period must not\nexceed 3 years.\nNote:\nThe Digital ID Data Standards Chair may be reappointed: see\nsection 33AA of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-106-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-106-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "37e02d095262033eecbfb8bfe4866136e0ee7ef56f721e48a13f7c4bb816a8cf",
      "skos:note": "Term of appointment must not exceed 3 years.",
      "dc:references": [
        "sec-33AA"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-106",
      "@type": "cof:Section",
      "cof:title": "106 Term of appointment",
      "values:kind": "section",
      "cof:pageNumber": 123,
      "values:originalText": "The Digital ID Data Standards Chair holds office for the period\nspecified in the instrument of appointment. The period must not\nexceed 3 years.\nNote:\nThe Digital ID Data Standards Chair may be reappointed: see\nsection 33AA of the Acts Interpretation Act 1901."
    },
    {
