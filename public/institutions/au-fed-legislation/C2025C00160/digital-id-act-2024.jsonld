        }
      ],
      "cml:integrityHash": "5f5b6b0e6450a35aa93a3b7413e8eec290f0994c38f8ea80b0981b229f4590af",
      "skos:note": "Conditions on accreditation"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-17-ss-4",
      "@type": "cof:Section",
      "cof:title": "17(4) Conditions on accreditation",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(4) Without limiting paragraph (2)(a), the Digital ID Regulator may\nimpose conditions relating to the following:\n(a) any limitations, exclusions or restrictions in relation to the\naccredited services of the entity;\n(b) the circumstances or manner in which the accredited services\nof the entity must be provided;\n\nChapter 2  Accreditation"
    },
