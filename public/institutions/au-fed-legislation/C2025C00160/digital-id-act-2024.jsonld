    {
      "@id": "concept:digital-id-act-2024-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Restriction on collection of restricted attributes of individuals by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-75"
