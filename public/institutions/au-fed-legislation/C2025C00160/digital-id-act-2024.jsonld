      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-93",
      "@type": "cml:Concept",
      "skos:prefLabel": "93 Simplified outline of this Chapter",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-93"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.115",
      "values:originalText": "There is a System Administrator whose functions include\nproviding assistance to entities participating in the Australian\nGovernment Digital ID System and managing the availability of\nthe Australian Government Digital ID System.\nThe Minister may give general directions to the System\nAdministrator about the performance of the System\nAdministrator’s functions or the exercise of the System\nAdministrator’s powers.\n\nChapter 6  System Administrator",
      "skos:definition": "There is a System Administrator whose functions include\nproviding assistance to entities participating in the Australian\nGovernment Digital ID System and managing the availability of\nthe Australian Government Digital ID System.\nThe Minister may give general directions to the System\nAdministrator about the performance of the System\nAdministrator’s functions or the exercise of the System\nAdministrator’s powers.\n\nChapter 6  System Administrator",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-93-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-93-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7fb0f6a199d32293d7415c0b97c3c8c04637325bdf6e2c21da00066377134985",
      "skos:note": "The Minister may give general directions to the System Administrator."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-93",
      "@type": "cof:Section",
      "cof:title": "93 Simplified outline of this Chapter",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "There is a System Administrator whose functions include\nproviding assistance to entities participating in the Australian\nGovernment Digital ID System and managing the availability of\nthe Australian Government Digital ID System.\nThe Minister may give general directions to the System\nAdministrator about the performance of the System\nAdministrator’s functions or the exercise of the System\nAdministrator’s powers.\n\nChapter 6  System Administrator"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-93-norm",
