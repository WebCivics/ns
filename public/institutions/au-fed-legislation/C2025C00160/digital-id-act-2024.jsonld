      "cml:integrityHash": "c7e7fe62bc0b26d0265d864218df9a3c91733df64d88f7daf0322c919eeee989"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-162",
      "@type": "cof:Section",
      "cof:title": "162 Review of operation of Act",
      "values:kind": "section",
      "cof:pageNumber": 179,
      "values:originalText": "(1) The Minister must cause a review of the operation of this Act to be\nundertaken.\n(2) The review must be undertaken no later than 2 years after the\ncommencement of this Act.\n(3) The persons who undertake the review must give the Minister a\nwritten report of the review.\n(4) The Minister must cause a copy of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives the report."
    },
