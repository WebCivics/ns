    {
      "@id": "concept:digital-id-act-2024-sec-73-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "73(5) Minister’s directions regarding participation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-73-ss-5"
      },
      "cml:curationStatus": {
