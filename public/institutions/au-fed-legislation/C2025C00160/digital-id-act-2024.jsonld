        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-162",
      "@type": "cml:Concept",
      "skos:prefLabel": "162 Review of operation of Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-162"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.179",
      "values:originalText": "(1) The Minister must cause a review of the operation of this Act to be\nundertaken.\n(2) The review must be undertaken no later than 2 years after the\ncommencement of this Act.\n(3) The persons who undertake the review must give the Minister a\nwritten report of the review.\n(4) The Minister must cause a copy of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives the report.",
      "skos:definition": "(1) The Minister must cause a review of the operation of this Act to be\nundertaken.\n(2) The review must be undertaken no later than 2 years after the\ncommencement of this Act.\n(3) The persons who undertake the review must give the Minister a\nwritten report of the review.\n(4) The Minister must cause a copy of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives the report.",
      "cml:hasPart": [
        {
