    {
      "@id": "concept:digital-id-act-2024-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Simplified outline of this Chapter",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-98"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.118",
      "values:originalText": "The Digital ID Data Standards Chair may make Digital ID Data\nStandards about various matters, including technical integration\nrequirements for entities to participate in the Australian\nGovernment Digital ID System and, if required to do so by the\nAccreditation Rules or the Digital ID Rules, technical, data or\ndesign standards relating to accreditation.\nBefore making, amending or revoking Digital ID Data Standards,\nthe Digital ID Data Standards Chair must consult the Minister and\nothers and invite public comments.\nThe Minister may give general directions to the Digital ID Data\nStandards Chair about the performance of the Chair’s functions or\nthe exercise of the Chair’s powers.\n\nDigital ID Data Standards  Chapter 7\nDigital ID Data Standards  Part 2\n\nSection 99\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "skos:definition": "The Digital ID Data Standards Chair may make Digital ID Data\nStandards about various matters, including technical integration\nrequirements for entities to participate in the Australian\nGovernment Digital ID System and, if required to do so by the\nAccreditation Rules or the Digital ID Rules, technical, data or\ndesign standards relating to accreditation.\nBefore making, amending or revoking Digital ID Data Standards,\nthe Digital ID Data Standards Chair must consult the Minister and\nothers and invite public comments.\nThe Minister may give general directions to the Digital ID Data\nStandards Chair about the performance of the Chair’s functions or\nthe exercise of the Chair’s powers.\n\nDigital ID Data Standards  Chapter 7\nDigital ID Data Standards  Part 2\n\nSection 99\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-98-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-98-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "220f023b7e5702fba9d2460856d91fec3ff4642ce9e9c3b61b6fed9d4859c0ce",
      "skos:note": "Must consult Minister and invite public comments before making, amending or revoking Digital ID Data Standards."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-98",
      "@type": "cof:Section",
      "cof:title": "98 Simplified outline of this Chapter",
      "values:kind": "section",
      "cof:pageNumber": 118,
      "values:originalText": "The Digital ID Data Standards Chair may make Digital ID Data\nStandards about various matters, including technical integration\nrequirements for entities to participate in the Australian\nGovernment Digital ID System and, if required to do so by the\nAccreditation Rules or the Digital ID Rules, technical, data or\ndesign standards relating to accreditation.\nBefore making, amending or revoking Digital ID Data Standards,\nthe Digital ID Data Standards Chair must consult the Minister and\nothers and invite public comments.\nThe Minister may give general directions to the Digital ID Data\nStandards Chair about the performance of the Chair’s functions or\nthe exercise of the Chair’s powers.\n\nDigital ID Data Standards  Chapter 7\nDigital ID Data Standards  Part 2\n\nSection 99\nDigital ID Act 2024\nCompilation date: 21/02/2025"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-98-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:digital-id-act-2024-sec-98"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
