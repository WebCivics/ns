      "skos:note": "Chapter applies only to accredited entities providing accredited services."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Chapter applies to accredited entities only to extent entity is",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "providing accredited services\nThis Chapter applies to an accredited entity only to the extent the\nentity is providing its accredited services."
    },
