      },
      "dc:source": "digital-id-act-2024.pdf, p.16",
      "values:originalText": "This Act extends to every external Territory.\n\nIntroduction  Chapter 1\nPreliminary  Part 1\n\nSection 7\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "skos:definition": "This Act extends to every external Territory.\n\nIntroduction  Chapter 1\nPreliminary  Part 1\n\nSection 7\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "cml:asserts": [
