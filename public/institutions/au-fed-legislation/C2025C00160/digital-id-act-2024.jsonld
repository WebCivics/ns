    {
      "@id": "concept:digital-id-act-2024-sec-70",
      "@type": "cml:Concept",
      "skos:prefLabel": "70 Varying approval to participate in the Australian Government",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-70"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.90",
      "values:originalText": "Digital ID System\nThe Digital ID Regulator may vary an approval given to an entity\nunder section 62 to take account of a change in the entity’s name.\nNote:\nThe Digital ID Regulator can also vary conditions on an approval to\nparticipate (see section 66).",
      "skos:definition": "Digital ID System\nThe Digital ID Regulator may vary an approval given to an entity\nunder section 62 to take account of a change in the entity’s name.\nNote:\nThe Digital ID Regulator can also vary conditions on an approval to\nparticipate (see section 66).",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-70-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-70-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3107fd044e05a716d9fc31d00ef2739a613767aa6b662486d44c5e0f2ee26dbf",
      "skos:note": "May vary approval given to an entity under section 62 to take account of a change in the entity’s name."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Varying approval to participate in the Australian Government",
      "values:kind": "section",
      "cof:pageNumber": 90,
      "values:originalText": "Digital ID System\nThe Digital ID Regulator may vary an approval given to an entity\nunder section 62 to take account of a change in the entity’s name.\nNote:\nThe Digital ID Regulator can also vary conditions on an approval to\nparticipate (see section 66)."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-70-norm",
