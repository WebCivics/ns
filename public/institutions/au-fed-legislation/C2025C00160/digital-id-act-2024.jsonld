      "skos:note": "Accreditation Rules may provide for requirements relating to quality, security or fraud."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-52-ss-2",
      "@type": "cof:Section",
      "cof:title": "52(2) Other rules relating to biometric information",
      "values:kind": "subsection",
