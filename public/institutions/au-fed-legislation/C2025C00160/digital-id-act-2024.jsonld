    {
      "@id": "concept:digital-id-act-2024-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Applying for approval to participate in the Australian",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
