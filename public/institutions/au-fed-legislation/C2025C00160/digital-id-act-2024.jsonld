      },
      "dc:source": "digital-id-act-2024.pdf, p.112",
      "values:originalText": "The Digital ID Regulator is the Australian Competition and\nConsumer Commission.\nThe Digital ID Regulator has certain functions, including to\npromote compliance with this Act and to advise the Information\nCommissioner on privacy matters that relate to this Act.\n\nDigital ID Regulator  Chapter 5\nDigital ID Regulator  Part 2\n\nSection 90\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "skos:definition": "The Digital ID Regulator is the Australian Competition and\nConsumer Commission.\nThe Digital ID Regulator has certain functions, including to\npromote compliance with this Act and to advise the Information\nCommissioner on privacy matters that relate to this Act.\n\nDigital ID Regulator  Chapter 5\nDigital ID Regulator  Part 2\n\nSection 90\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-89-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-89-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f1d01b97d5ab82e1c624238e70b3824f9b40a848d4367bdd349bb725229fd1e",
      "skos:note": "The Digital ID Regulator has certain functions, including to promote compliance with this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-89",
      "@type": "cof:Section",
      "cof:title": "89 Simplified outline of this Chapter",
      "values:kind": "section",
      "cof:pageNumber": 112,
      "values:originalText": "The Digital ID Regulator is the Australian Competition and\nConsumer Commission.\nThe Digital ID Regulator has certain functions, including to\npromote compliance with this Act and to advise the Information\nCommissioner on privacy matters that relate to this Act.\n\nDigital ID Regulator  Chapter 5\nDigital ID Regulator  Part 2\n\nSection 90\nDigital ID Act 2024\nCompilation date: 21/02/2025"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-89-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
