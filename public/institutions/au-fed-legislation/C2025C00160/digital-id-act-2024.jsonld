        }
      ],
      "cml:integrityHash": "43accfe9638c4c046d75b5c05e88fe46e1b7eb7fda92d3dca6fd74d6b0566b6a",
      "skos:note": "Pay fee before making a decision on an application."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-143-ss-5",
      "@type": "cof:Section",
      "cof:title": "143(5) Decisions not required to be made in certain circumstances",
      "values:kind": "subsection",
      "cof:pageNumber": 159,
      "values:originalText": "(5) If Digital ID Rules made for the purposes of section 144 specify a\nfee that must accompany an application and payment of the fee has\nnot been waived, the person to whom the application is made is not\nrequired to make a decision on the application until the fee is paid.\n\nChapter 9  Administration"
    },
