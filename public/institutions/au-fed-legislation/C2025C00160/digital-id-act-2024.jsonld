    {
      "@id": "concept:digital-id-act-2024-sec-92",
      "@type": "cml:Concept",
      "skos:prefLabel": "92 Powers of the Digital ID Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-92"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.114",
      "values:originalText": "The Digital ID Regulator has power to do all things necessary or\nconvenient to be done for or in connection with the performance of\nthe Regulator’s functions under this Act.\n\nSystem Administrator  Chapter 6\nIntroduction  Part 1\n\nSection 93\nDigital ID Act 2024\nCompilation date: 21/02/2025\nChapter 6—System Administrator",
      "skos:definition": "The Digital ID Regulator has power to do all things necessary or\nconvenient to be done for or in connection with the performance of\nthe Regulator’s functions under this Act.\n\nSystem Administrator  Chapter 6\nIntroduction  Part 1\n\nSection 93\nDigital ID Act 2024\nCompilation date: 21/02/2025\nChapter 6—System Administrator",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-92-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-92-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6722d853da272f3b3d6b0fd6d2cc010b7ea6cbf29d555f93ca6c7d2a43997734",
      "skos:note": "Power to perform functions under this Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-92",
      "@type": "cof:Section",
      "cof:title": "92 Powers of the Digital ID Regulator",
      "values:kind": "section",
      "cof:pageNumber": 114,
      "values:originalText": "The Digital ID Regulator has power to do all things necessary or\nconvenient to be done for or in connection with the performance of\nthe Regulator’s functions under this Act.\n\nSystem Administrator  Chapter 6\nIntroduction  Part 1\n\nSection 93\nDigital ID Act 2024\nCompilation date: 21/02/2025\nChapter 6—System Administrator"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-92-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
