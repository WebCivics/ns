        }
      ],
      "cml:integrityHash": "d151e5940d76eb3be055de29f996b70e537a4f9d67efb6d5d0244fd766f409b2",
      "skos:note": "Annual reports must be given to the AFP Minister by a certain date.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-155a-ss-3",
      "@type": "cof:Section",
      "cof:title": "155A(3) Annual reports by law enforcement agencies etc. on disclosure",
