        }
      ],
      "cml:integrityHash": "d573be335e14ffeb2c7dd82eb8da45baa8c79d74a7bc067b2e6a75af5275cf1a",
      "skos:note": "Accredited entities must notify the Information Commissioner of eligible data breaches."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-39-ss-1",
      "@type": "cof:Section",
      "cof:title": "39(1) Notification of eligible data breaches—accredited entities that are",
