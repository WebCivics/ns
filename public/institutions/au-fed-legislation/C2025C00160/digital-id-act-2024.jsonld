        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Entity's risk assessment plan and privacy impact assessment are relevant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
