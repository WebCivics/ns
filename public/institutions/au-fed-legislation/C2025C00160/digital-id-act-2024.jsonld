      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate",
      "cml:logicSummary": "Definition of accountable person for an entity",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-157",
      "@type": "cml:Concept",
      "skos:prefLabel": "157 Attributing conduct to the Commonwealth, States and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-157"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.173",
      "values:originalText": "Territories etc.\n(1) In determining whether the Commonwealth, a State or a Territory\n(each of which is a government body) has contravened this Act\n(including a civil penalty provision):\n\nChapter 10  Other matters",
      "skos:definition": "Territories etc.\n(1) In determining whether the Commonwealth, a State or a Territory\n(each of which is a government body) has contravened this Act\n(including a civil penalty provision):\n\nChapter 10  Other matters",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-157-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-157-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a72579f543c8e6e7be32bcb24be2ef0c4904e0c43c6fac43a262bfef3b1792d1",
      "skos:note": "Determine whether Commonwealth, State or Territory has contravened the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-157",
      "@type": "cof:Section",
      "cof:title": "157 Attributing conduct to the Commonwealth, States and",
      "values:kind": "section",
      "cof:pageNumber": 173,
      "values:originalText": "Territories etc.\n(1) In determining whether the Commonwealth, a State or a Territory\n(each of which is a government body) has contravened this Act\n(including a civil penalty provision):\n\nChapter 10  Other matters"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-157-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:digital-id-act-2024-sec-157"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
