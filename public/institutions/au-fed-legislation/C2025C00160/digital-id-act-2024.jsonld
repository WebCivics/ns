        }
      ],
      "cml:integrityHash": "c828945774da822f36aeaf1a6f5558d67ccfceb12a6ce42a6a824b477b721886",
      "skos:note": "Entity must provide a reasonable excuse if required information is not provided.",
      "dc:description": "Information or documentation"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-133-ss-6",
      "@type": "cof:Section",
