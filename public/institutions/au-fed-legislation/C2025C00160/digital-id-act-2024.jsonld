    {
      "@id": "concept:digital-id-act-2024-sec-146",
      "@type": "cml:Concept",
      "skos:prefLabel": "146 Recovery of fees charged by the Digital ID Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-146"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.161",
      "values:originalText": "A fee charged by the Digital ID Regulator that is due and payable\nto the Commonwealth under this Act may be recovered as a debt\ndue to the Commonwealth by action in a court of competent\njurisdiction.\n\nChapter 9  Administration",
      "skos:definition": "A fee charged by the Digital ID Regulator that is due and payable\nto the Commonwealth under this Act may be recovered as a debt\ndue to the Commonwealth by action in a court of competent\njurisdiction.\n\nChapter 9  Administration",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-146-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-146-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c6ee341deaceeda7c2b58fb7f8867e2bce5a1a12f8333d302010f2ae09da8abb",
      "skos:note": "Recovery of fees charged by the Digital ID Regulator"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-146",
      "@type": "cof:Section",
      "cof:title": "146 Recovery of fees charged by the Digital ID Regulator",
      "values:kind": "section",
      "cof:pageNumber": 161,
      "values:originalText": "A fee charged by the Digital ID Regulator that is due and payable\nto the Commonwealth under this Act may be recovered as a debt\ndue to the Commonwealth by action in a court of competent\njurisdiction.\n\nChapter 9  Administration"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-146-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:digital-id-act-2024-sec-146"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-146-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Can recover fees",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-147",
      "@type": "cml:Concept",
      "skos:prefLabel": "147 Commonwealth not liable to pay fees charged by entities that",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-147"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.162",
      "values:originalText": "are part of the Commonwealth\n(1) The Commonwealth is not liable to pay a fee that is payable under\nthis Act to a part of the Commonwealth that is not a separate legal\nentity. However, it is the Parliament’s intention that the\nCommonwealth should be notionally liable to pay such a fee.\n(2) The Finance Minister may give such written directions as are\nnecessary or convenient for carrying out or giving effect to\nsubsection (1) and, in particular, may give directions in relation to\nthe transfer of money within an account, or between accounts,\noperated by the Commonwealth.\n(3) Directions under subsection (2) have effect, and must be complied\nwith, despite any other law of the Commonwealth.\n(4) Directions under subsection (2) are not legislative instruments.\n(5) In this subsection:\nCommonwealth includes a Commonwealth entity (within the\nmeaning of the Public Governance, Performance and\nAccountability Act 2013) that cannot be made liable to taxation by\na law of the Commonwealth.\n\nAdministration  Chapter 9\nFees  Part 6\nFees charged by accredited entities  Division 2\nSection 148\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "skos:definition": "are part of the Commonwealth\n(1) The Commonwealth is not liable to pay a fee that is payable under\nthis Act to a part of the Commonwealth that is not a separate legal\nentity. However, it is the Parliament’s intention that the\nCommonwealth should be notionally liable to pay such a fee.\n(2) The Finance Minister may give such written directions as are\nnecessary or convenient for carrying out or giving effect to\nsubsection (1) and, in particular, may give directions in relation to\nthe transfer of money within an account, or between accounts,\noperated by the Commonwealth.\n(3) Directions under subsection (2) have effect, and must be complied\nwith, despite any other law of the Commonwealth.\n(4) Directions under subsection (2) are not legislative instruments.\n(5) In this subsection:\nCommonwealth includes a Commonwealth entity (within the\nmeaning of the Public Governance, Performance and\nAccountability Act 2013) that cannot be made liable to taxation by\na law of the Commonwealth.\n\nAdministration  Chapter 9\nFees  Part 6\nFees charged by accredited entities  Division 2\nSection 148\nDigital ID Act 2024\nCompilation date: 21/02/2025",
      "cml:hasPart": [
        {
          "@id": "concept:digital-id-act-2024-sec-147-ss-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-147-ss-2"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-147-ss-3"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-147-ss-4"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-147-ss-5"
        }
      ],
      "cml:integrityHash": "2670ff8dbae49cc862b2669cdbb3a21148fdb02d058e8ab2c149897c5f89604b"
    },
