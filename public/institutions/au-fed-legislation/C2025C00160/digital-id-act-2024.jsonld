    {
      "@id": "concept:digital-id-act-2024-sec-165",
      "@type": "cml:Concept",
      "skos:prefLabel": "165 Delegation—System Administrator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-165"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.180",
      "values:originalText": "The System Administrator must not delegate any of the System\nAdministrator’s functions or powers under this Act to a person who\nhas functions or duties that relate to the operation or management\nof an information technology system through which an accredited\nentity provides its accredited services.\nNote:\nFor delegation by the System Administrator, see section 12 of the\nHuman Services (Centrelink) Act 1997.",
      "skos:definition": "The System Administrator must not delegate any of the System\nAdministrator’s functions or powers under this Act to a person who\nhas functions or duties that relate to the operation or management\nof an information technology system through which an accredited\nentity provides its accredited services.\nNote:\nFor delegation by the System Administrator, see section 12 of the\nHuman Services (Centrelink) Act 1997.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-165-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-165-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eb86b0f2077f5df600dee073db6494db3ee1be30f71b5515f2ee0e6554a16e6b",
      "skos:note": "Delegation of System Administrator's functions is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-165",
      "@type": "cof:Section",
      "cof:title": "165 Delegation—System Administrator",
      "values:kind": "section",
      "cof:pageNumber": 180,
      "values:originalText": "The System Administrator must not delegate any of the System\nAdministrator’s functions or powers under this Act to a person who\nhas functions or duties that relate to the operation or management\nof an information technology system through which an accredited\nentity provides its accredited services.\nNote:\nFor delegation by the System Administrator, see section 12 of the\nHuman Services (Centrelink) Act 1997."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-165-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:digital-id-act-2024-sec-165"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
