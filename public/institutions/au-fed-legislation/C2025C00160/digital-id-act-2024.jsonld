    {
      "@id": "concept:digital-id-act-2024-sec-97",
      "@type": "cml:Concept",
      "skos:prefLabel": "97 Directions to the System Administrator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-97"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
