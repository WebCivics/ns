      },
      "dc:source": "digital-id-act-2024.pdf, p.68",
      "values:originalText": "(2) Without limiting subsection (1), the Accreditation Rules may\nprovide for requirements relating to quality, security or fraud.",
      "skos:definition": "(2) Without limiting subsection (1), the Accreditation Rules may\nprovide for requirements relating to quality, security or fraud.",
      "values:partOf": {
