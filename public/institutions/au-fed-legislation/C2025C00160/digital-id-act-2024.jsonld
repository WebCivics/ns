    {
      "@id": "concept:digital-id-act-2024-sec-89",
      "@type": "cml:Concept",
      "skos:prefLabel": "89 Simplified outline of this Chapter",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-89"
