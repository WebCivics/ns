    },
    {
      "@id": "concept:digital-id-act-2024-sec-47-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Restriction",
      "cml:logicSummary": "Restriction on disclosure timing",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The accredited entity to whom the unique identifier is disclosed must not disclose the unique identifier to any other entity.",
      "cml:conclusionText": "The restriction applies only during the accreditation period."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-47-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Temporal Restriction",
      "cml:logicSummary": "Restriction on disclosure timing",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
