    {
      "@id": "concept:digital-id-act-2024-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Simplified outline of this Chapter",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.50",
      "values:originalText": "When providing accredited services, accredited entities must\ncomply with certain privacy safeguards. These safeguards are in\naddition to, and build on, the safeguards contained in the Privacy\nAct 1988.\nAn accredited entity may be liable to a civil penalty if certain\nprivacy safeguards are breached, such as collecting certain\nattributes of individuals such as their political opinions or racial\norigin. There are restrictions on collecting, using or disclosing\nbiometric information of individuals and on data profiling to track\nonline behaviour is prohibited.",
      "skos:definition": "When providing accredited services, accredited entities must\ncomply with certain privacy safeguards. These safeguards are in\naddition to, and build on, the safeguards contained in the Privacy\nAct 1988.\nAn accredited entity may be liable to a civil penalty if certain\nprivacy safeguards are breached, such as collecting certain\nattributes of individuals such as their political opinions or racial\norigin. There are restrictions on collecting, using or disclosing\nbiometric information of individuals and on data profiling to track\nonline behaviour is prohibited.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-32-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5c9cf7095e91088fba69a8bdea28f4c238b701be61164eaa8918164e1f474964",
      "skos:note": "Data profiling of online behavior is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Simplified outline of this Chapter",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "When providing accredited services, accredited entities must\ncomply with certain privacy safeguards. These safeguards are in\naddition to, and build on, the safeguards contained in the Privacy\nAct 1988.\nAn accredited entity may be liable to a civil penalty if certain\nprivacy safeguards are breached, such as collecting certain\nattributes of individuals such as their political opinions or racial\norigin. There are restrictions on collecting, using or disclosing\nbiometric information of individuals and on data profiling to track\nonline behaviour is prohibited."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-32-norm",
