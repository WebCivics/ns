      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Defines duties",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "to make Digital ID Data Standards; and to review those standards regularly;",
      "cml:conclusionText": "duties are defined"
    },
    {
      "@id": "concept:digital-id-act-2024-sec-102-logic-alleninterval-2",
