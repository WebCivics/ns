      "cml:conclusionText": "Digital ID Regulator may suspend entity's approval."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-57-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Entity must meet specified criteria",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.9,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Only certain kinds of accredited entities and relying parties can apply to the Digital ID Regulator to participate, and specified criteria must be met before the Digital ID Regulator gives an approval.",
      "cml:conclusionText": "Entity must hold approval from Digital ID Regulator."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-57-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Digital ID Regulator may give directions to Minister regarding entity's approval",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
