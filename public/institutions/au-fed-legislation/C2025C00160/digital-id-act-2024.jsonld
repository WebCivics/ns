    {
      "@id": "concept:digital-id-act-2024-sec-135-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "135(4) Record keeping by participating entities and former",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-135-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.151",
      "values:originalText": "(4) Digital ID Rules made for the purposes of subsection (3):\n(a) must not prescribe records of a kind that do not relate to\ninformation obtained by entities through the Australian\nGovernment Digital ID System; and\n(b) may only prescribe a period of retention of more than 7 years\nif specified circumstances apply in relation to the record.\nNote:\nFor the purposes of paragraph (b), specified circumstances may\ninclude legal proceedings involving the entity and the records.",
      "skos:definition": "(4) Digital ID Rules made for the purposes of subsection (3):\n(a) must not prescribe records of a kind that do not relate to\ninformation obtained by entities through the Australian\nGovernment Digital ID System; and\n(b) may only prescribe a period of retention of more than 7 years\nif specified circumstances apply in relation to the record.\nNote:\nFor the purposes of paragraph (b), specified circumstances may\ninclude legal proceedings involving the entity and the records.",
      "values:partOf": {
        "@id": "concept:digital-id-act-2024-sec-135"
      },
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-135-ss-4-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-135-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-135-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-135-ss-4-logic-ltl-3"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-135-ss-4-logic-diffusion-4"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-135-ss-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "67ce47631c8b95357044cf1710f3313ff7fc6a8119fd07076a8f97e19107ea1b",
      "skos:note": "Records of a kind not related to information obtained through the Australian Government Digital ID System are prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-135-ss-4",
      "@type": "cof:Section",
      "cof:title": "135(4) Record keeping by participating entities and former",
      "values:kind": "subsection",
      "cof:pageNumber": 151,
      "values:originalText": "(4) Digital ID Rules made for the purposes of subsection (3):\n(a) must not prescribe records of a kind that do not relate to\ninformation obtained by entities through the Australian\nGovernment Digital ID System; and\n(b) may only prescribe a period of retention of more than 7 years\nif specified circumstances apply in relation to the record.\nNote:\nFor the purposes of paragraph (b), specified circumstances may\ninclude legal proceedings involving the entity and the records."
    },
