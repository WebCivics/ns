      },
      "dc:source": "digital-id-act-2024.pdf, p.54",
      "values:originalText": "(4) In this section:\nagency has the same meaning as in the Privacy Act 1988.\norganisation has the same meaning as in the Privacy Act 1988.",
      "skos:definition": "(4) In this section:\nagency has the same meaning as in the Privacy Act 1988.\norganisation has the same meaning as in the Privacy Act 1988.",
      "values:partOf": {
