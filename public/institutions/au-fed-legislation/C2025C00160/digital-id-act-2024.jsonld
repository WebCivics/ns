      },
      "cml:premiseText": "The Minister may give directions to the Digital ID Regulator regarding the approval of an entity to participate in the Australian Government Digital ID System if, for reasons of security.",
      "cml:conclusionText": "Minister may direct Digital ID Regulator on entity's approval."
    },
    {
      "@id": "concept:digital-id-act-2024-sec-58",
