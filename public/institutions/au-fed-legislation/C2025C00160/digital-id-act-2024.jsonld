      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.79",
      "values:originalText": "Government Digital ID System\nAn entity may apply to the Digital ID Regulator for approval to\nparticipate in the Australian Government Digital ID System if:\n(a) the entity is an accredited entity that is a non-corporate\nCommonwealth entity, within the meaning of the Public\nGovernance, Performance and Accountability Act 2013; or\n\nChapter 4  Australian Government Digital ID System",
      "skos:definition": "Government Digital ID System\nAn entity may apply to the Digital ID Regulator for approval to\nparticipate in the Australian Government Digital ID System if:\n(a) the entity is an accredited entity that is a non-corporate\nCommonwealth entity, within the meaning of the Public\nGovernance, Performance and Accountability Act 2013; or\n\nChapter 4  Australian Government Digital ID System",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-61-norm"
        }
      ],
      "cml:integrityHash": "e2879cc26e66fd7b61536e5c73eb127ce41f8e169ce76114d5e3b0e391fa3869",
      "skos:note": "Approval required for participation in Australian Government Digital ID System"
    },
    {
