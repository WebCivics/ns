        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.99",
      "values:originalText": "participating relying parties\nA participating relying party must not, while participating in the\nAustralian Government Digital ID System, collect a restricted\nattribute of an individual if the relying party’s approval to\nparticipate in the system does not include a condition that\nauthorises the relying party to collect the restricted attribute.",
      "skos:definition": "participating relying parties\nA participating relying party must not, while participating in the\nAustralian Government Digital ID System, collect a restricted\nattribute of an individual if the relying party’s approval to\nparticipate in the system does not include a condition that\nauthorises the relying party to collect the restricted attribute.",
      "cml:asserts": [
        {
          "@id": "concept:digital-id-act-2024-sec-75-norm"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-75-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c8776c7c4ec2bf91279150d42415e6bca0305703d0bc49b202db43b117acd367",
      "skos:note": "Cannot collect restricted attributes without approval"
    },
    {
