    {
      "@id": "concept:digital-id-act-2024-sec-169-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "169(4) Rules—requirement to consult",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-169-ss-4"
