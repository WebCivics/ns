      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-92-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Ability to do things necessary or convenient",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
