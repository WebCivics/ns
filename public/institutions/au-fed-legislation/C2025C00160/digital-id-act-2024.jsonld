    {
      "@id": "concept:digital-id-act-2024-sec-71-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "71(3) Suspension of approval to participate in the Australian",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-71-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
