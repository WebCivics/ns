    {
      "@id": "concept:digital-id-act-2024-sec-140",
      "@type": "cml:Concept",
      "skos:prefLabel": "140 Review by the Administrative Review Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-140"
      },
      "cml:curationStatus": {
