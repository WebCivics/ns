      "skos:note": "Publish statement of reasons for authorizing collection or disclosure of restricted attribute.",
      "dc:description": "Statement of reasons"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-18-ss-3",
      "@type": "cof:Section",
