    {
      "@id": "concept:digital-id-act-2024-sec-143-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "143(5) Decisions not required to be made in certain circumstances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-143-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
