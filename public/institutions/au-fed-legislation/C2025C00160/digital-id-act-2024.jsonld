        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-107-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Obligation to appoint",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:digital-id-act-2024-sec-109",
      "@type": "cml:Concept",
      "skos:prefLabel": "109 Remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-109"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "digital-id-act-2024.pdf"
      },
      "dc:source": "digital-id-act-2024.pdf, p.125",
      "values:originalText": "(1) The Digital ID Data Standards Chair is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe Digital ID Data Standards Chair is to be paid the remuneration\nthat is prescribed by legislative instrument under subsection (3).\n(2) The Digital ID Data Standards Chair is to be paid the allowances\nthat are prescribed by legislative instrument under subsection (3).\n(3) The Minister may, by legislative instrument, prescribe:\n(a) remuneration for the purposes of subsection (1); and\n(b) allowances for the purposes of subsection (2).\n(4) Subsections (1) and (2) do not apply while the Digital ID Data\nStandards Chair is the Minister.\n(5) Subsections 7(9) and (13) of the Remuneration Tribunal Act 1973\ndo not apply in relation to the office of the Digital ID Data\nStandards Chair.\nNote:\nThe effect of this subsection is that remuneration or allowances of the\nDigital ID Data Standards Chair will be paid out of money\nappropriated by an Act other than the Remuneration Tribunal Act\n1973.\n(6) This section has effect subject to the Remuneration Tribunal Act\n1973 (except as provided by subsection (5) of this section).",
      "skos:definition": "(1) The Digital ID Data Standards Chair is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe Digital ID Data Standards Chair is to be paid the remuneration\nthat is prescribed by legislative instrument under subsection (3).\n(2) The Digital ID Data Standards Chair is to be paid the allowances\nthat are prescribed by legislative instrument under subsection (3).\n(3) The Minister may, by legislative instrument, prescribe:\n(a) remuneration for the purposes of subsection (1); and\n(b) allowances for the purposes of subsection (2).\n(4) Subsections (1) and (2) do not apply while the Digital ID Data\nStandards Chair is the Minister.\n(5) Subsections 7(9) and (13) of the Remuneration Tribunal Act 1973\ndo not apply in relation to the office of the Digital ID Data\nStandards Chair.\nNote:\nThe effect of this subsection is that remuneration or allowances of the\nDigital ID Data Standards Chair will be paid out of money\nappropriated by an Act other than the Remuneration Tribunal Act\n1973.\n(6) This section has effect subject to the Remuneration Tribunal Act\n1973 (except as provided by subsection (5) of this section).",
      "cml:hasPart": [
        {
          "@id": "concept:digital-id-act-2024-sec-109-ss-1"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-109-ss-2"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-109-ss-3"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-109-ss-4"
        },
