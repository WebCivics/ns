        }
      ],
      "cml:integrityHash": "838ae83a2ce01591f3bc4ce8700a930aa1aa5541babc0ad4f9e4928467d345bd",
      "skos:note": "Entity must respond to complaint under Privacy Act 1988"
    },
    {
      "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-38-ss-2",
      "@type": "cof:Section",
      "cof:title": "38(2) Contraventions of Division 2 and section 136 are interferences",
      "values:kind": "subsection",
      "cof:pageNumber": 54,
      "values:originalText": "(2) The respondent to a complaint under the Privacy Act 1988 about\nthe act or practice, other than an act or practice of an agency or\norganisation, is the entity that engaged in the act or practice."
    },
    {
