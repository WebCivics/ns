          "@id": "concept:digital-id-act-2024-sec-26-ss-3"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-26-ss-4"
        },
        {
          "@id": "concept:digital-id-act-2024-sec-26-ss-5"
        },
