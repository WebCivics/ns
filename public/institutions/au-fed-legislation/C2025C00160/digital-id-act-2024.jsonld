      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The decision was made under the same conditions as the previous notice.",
      "cml:conclusionText": "This provision repeats the condition of the previous notice."
    },
