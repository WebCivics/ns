    {
      "@id": "concept:digital-id-act-2024-sec-72-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "72(2) Revocation of approval to participate in the Australian",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/digital-id-act-2024#sec-72-ss-2"
