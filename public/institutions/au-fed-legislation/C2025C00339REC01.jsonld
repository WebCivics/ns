    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-powers-and-offences-act-2012.pdf, p.39",
      "skos:note": "Return a returnable item to the person from whom it was seized or produced if not required for judicial review proceedings.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "24AB(1) When returnable items must be returned"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-powers-and-offences-act-2012.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-1-norm",
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "eb420f4eb5415197bc994cd4c3e4c08fabe85895867cbd7a497f3d7cdc12f74b",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-powers-and-offences-act-2012#sch-3-sec-24ab-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person from whom the item was seized or produced is entitled to possess it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to return an item",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The CEO must take reasonable steps to return the item."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-1-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-1"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-powers-and-offences-act-2012.pdf, p.39",
      "skos:note": "No obligation to take steps if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "24AB(2) When returnable items must be returned"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-powers-and-offences-act-2012.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-norm",
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-1",
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-2",
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-3",
        "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "a4b6cdf2bae08b4619c493ffe802a33e6d092ce76826bc8c091e4de5d6bebb2c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-powers-and-offences-act-2012#sch-3-sec-24ab-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the CEO does not have to take those steps if the conditions are met",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No obligation if conditions are met",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "EXCEPT",
      "cml:premiseText": "if the returnable item may be retained because of an order under subsection 24AC(2), or any other order under that subsection has been made in relation to the item, then the CEO does not have to take those steps"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the CEO does not have to take those steps if the application is pending",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No obligation if application is pending",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "EXCEPT",
      "cml:premiseText": "if the CEO has applied for such an order and the application has not been determined, then the CEO does not have to take those steps"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the CEO does not have to take those steps if the returnable item is subject to such a law or order",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No obligation under law or court order",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "EXCEPT",
      "cml:premiseText": "if the returnable item may otherwise be retained, destroyed or disposed of under a law, or an order of a court or tribunal, of the Commonwealth or of a State or a Territory, then the CEO does not have to take those steps"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the CEO does not have to take those steps if there is a dispute over ownership",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No obligation due to dispute over ownership",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "EXCEPT",
      "cml:premiseText": "if the returnable item is forfeited or forfeitable to the Commonwealth or is the subject of a dispute as to ownership, then the CEO does not have to take those steps"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
