    {
      "@id": "concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96b-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the court to which the application was made finds that the person was in contempt of ACLEI, the court may deal with the person as if the acts or omissions involved constituted a contempt of that court.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with temporal intervals related to contempt proceedings.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(6) If, after considering the matters specified in the certificate; and hearing or receiving any evidence or statements by or in support of ACLEI; and hearing or receiving any evidence or statements by or in support of the person;"
