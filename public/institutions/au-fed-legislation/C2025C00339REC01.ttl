    <https://ns.webcivics.net/cml/operator> "Prohibit";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits the person from attempting to evade service of summons.";
    <https://ns.webcivics.net/cml/premiseText> "The person is to be served with a summons under section 83.";
    <https://ns.webcivics.net/cml/conclusionText> "The authorized officer may apply for a warrant to arrest the person if they have not complied with the order or are likely to leave Australia to avoid giving evidence.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
