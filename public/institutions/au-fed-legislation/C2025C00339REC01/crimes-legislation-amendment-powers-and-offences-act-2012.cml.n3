doc:sch-3-sec-24aa-ss-2 a cof:Section ;
    cof:title "24AA(2) Use of and sharing returnable items" ;
    values:kind "subsection" ;
    values:originalText "(2) A constable or Commonwealth officer, who is not a member of the staff of the ACC, may use a returnable item for all or any of the purposes referred to in subsection (1) if it is necessary to do so for that purpose. Use of returnable items by members of the staff of the ACC" ;
    cof:pageNumber "36"^^xsd:integer .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24aa-ss-3 a cml:Concept ;
