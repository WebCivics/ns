concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24aa-ss-2 cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24aa-ss-2-logic-deontic-2 .
concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24aa-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "EXCEPT" ;
    cml:logicSummary "No obligation if conditions are met" ;
    cml:premiseText "if the returnable item may be retained because of an order under subsection 24AC(2), or any other order under that subsection has been made in relation to the item, then the CEO does not have to take those steps" ;
    cml:conclusionText "the CEO does not have to take those steps" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
