doc:sch-4-sec-77a-ss-5 a cof:Section ;
    cof:title "77A(5) Disclosure of notice may be prohibited" ;
    values:kind "subsection" ;
    values:originalText "(5) The Integrity Commissioner must not include a notation in the notice in any other case. Written statement to accompany notation" ;
