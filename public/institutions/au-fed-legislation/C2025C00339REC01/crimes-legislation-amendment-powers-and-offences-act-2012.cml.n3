    cml:modality cml:Deontic ;
    cml:operator "EXCEPT" ;
    cml:logicSummary "No obligation if law or court order allows it" ;
    cml:premiseText "if the returnable item may otherwise be retained, destroyed or disposed of under a law, or an order of a court or tribunal, of the Commonwealth or of a State or a Territory, then the CEO does not have to take those steps" ;
    cml:conclusionText "the CEO does not have to take those steps" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24aa-ss-2 cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24aa-ss-2-logic-deontic-5 .
