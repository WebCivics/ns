    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96d-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-and-offences-act-2012.pdf> ;
    dc:source "crimes-legislation-amendment-powers-and-offences-act-2012.pdf, p.56" .
