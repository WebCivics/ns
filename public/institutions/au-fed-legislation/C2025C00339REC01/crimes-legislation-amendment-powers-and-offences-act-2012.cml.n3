concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-51 a cml:Concept ;
    skos:prefLabel "51 Paragraph 23XWR(2)(b)"@en ;
    cml:realizedBy doc:sch-1-sec-51 ;
    values:originalText "Repeal the paragraph, substitute: (b) that the information will be stored on the volunteers (limited purposes) index of that system unless the volunteer (or, in the case of a volunteer who is a child or an incapable person, the parent or guardian of the volunteer) chooses for the information to be stored on the volunteers (unlimited purposes) index of that system; and  Forensic procedures  Schedule 1 Amendments commencing on day after Royal Assent  Part 1 Crimes Legislation Amendment (Powers and Offences) Act 2012 Compilation date: 05/04/2012" ;
    skos:definition "Repeal the paragraph, substitute: (b) that the information will be stored on the volunteers (limited purposes) index of that system unless the volunteer (or, in the case of a volunteer who is a child or an incapable person, the parent or guardian of the volunteer) chooses for the information to be stored on the volunteers (unlimited purposes) index of that system; and  Forensic procedures  Schedule 1 Amendments commencing on day after Royal Assent  Part 1 Crimes Legislation Amendment (Powers and Offences) Act 2012 Compilation date: 05/04/2012"@en ;
    cml:integrityHash "51a06e888b94d7b0f7578d3f8fef70d67d005c8722d3e8739f22091e5ccfb27b" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Volunteer chooses storage of information" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
