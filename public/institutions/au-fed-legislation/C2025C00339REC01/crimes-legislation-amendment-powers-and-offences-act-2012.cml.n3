concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-72 a cml:Concept ;
    skos:prefLabel "72 After subsection 23YUC(1)"@en ;
    cml:realizedBy doc:sch-1-sec-72 ;
    values:originalText "Insert: (1A) A person is authorised to carry out a non-intimate forensic procedure authorised by an order under this Part that is registered in accordance with an arrangement referred to in subsection 23YUB(1) anywhere in the Commonwealth. The person is authorised to carry out the procedure in accordance with Division 6 or a corresponding law of a participating jurisdiction, and not otherwise." ;
    skos:definition "Insert: (1A) A person is authorised to carry out a non-intimate forensic procedure authorised by an order under this Part that is registered in accordance with an arrangement referred to in subsection 23YUB(1) anywhere in the Commonwealth. The person is authorised to carry out the procedure in accordance with Division 6 or a corresponding law of a participating jurisdiction, and not otherwise."@en ;
    cml:integrityHash "27cb893dbf80cb12899d5efba3688378a631b628c8d734e2d792b438873d7ac7" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Authorises carrying out of non-intimate forensic procedure in participating jurisdictions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
