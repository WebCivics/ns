doc:sch-3-sec-24ac-ss-6 a cof:Section ;
    cof:title "24AC(6) Issuing officer may permit a returnable item to be retained," ;
    values:kind "subsection" ;
    values:originalText "(6) The issuing officer must allow a person who has an interest in the returnable item to appear and be heard in determining the application. Function conferred in personal capacity" ;
    cof:pageNumber "39"^^xsd:integer .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ac-ss-7 a cml:Concept ;
    skos:prefLabel "24AC(7) Issuing officer may permit a returnable item to be retained,"@en ;
    cml:realizedBy doc:sch-3-sec-24ac-ss-7 ;
    values:originalText "(7) A function of making an order under this section is conferred on an issuing officer in a personal capacity and not as a court or a member of a court." ;
