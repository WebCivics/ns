concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-8-sec-4 a cml:Concept ;
    skos:prefLabel "4 Before subsection 15A(1AD)"@en ;
    cml:realizedBy doc:sch-8-sec-4 ;
    values:originalText "Insert: (1ACB) To avoid doubt, if a court makes an order imposing a penalty for failure to pay a fine, whether or not the penalty is described in subsection (1AB), a person or authority other than a court may take action to enforce the penalty without making an application under paragraph (1AA)(a), even if the penalty is imposed as an alternative penalty." ;
    skos:definition "Insert: (1ACB) To avoid doubt, if a court makes an order imposing a penalty for failure to pay a fine, whether or not the penalty is described in subsection (1AB), a person or authority other than a court may take action to enforce the penalty without making an application under paragraph (1AA)(a), even if the penalty is imposed as an alternative penalty."@en ;
    cml:integrityHash "e59ac858d56fb3338c5102301e49feddaf4a2de5ab7ab93605c96c532ffe7ada" ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Enforcement of penalty without court application" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
