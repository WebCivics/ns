concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-63 a cml:Concept ;
    skos:prefLabel "63 Paragraph 23YDA(2)(c)"@en ;
    cml:realizedBy doc:sch-1-sec-63 ;
    values:originalText "After “(Division 5)”, insert “, applying to a judge or magistrate for an order for the carrying out of a forensic procedure on an offender (Division 6A) or applying to a magistrate for an order under section 23XWU for the carrying out of a forensic procedure on a child or incapable person”." ;
    skos:definition "After “(Division 5)”, insert “, applying to a judge or magistrate for an order for the carrying out of a forensic procedure on an offender (Division 6A) or applying to a magistrate for an order under section 23XWU for the carrying out of a forensic procedure on a child or incapable person”."@en ;
    cml:integrityHash "68eb67187741bddd54bddeb93d079fb89cf4d3a0a7b7e7b286a86c6dc333c342" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Insertion of new clause for applying to judges and magistrates for forensic procedures" ;
    cml:curationStatus cml:Proposed ;
