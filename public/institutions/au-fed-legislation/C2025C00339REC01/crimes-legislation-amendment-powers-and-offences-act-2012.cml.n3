concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-39 a cml:Concept ;
    skos:prefLabel "39 Subsection 23XWE(1)"@en ;
    cml:realizedBy doc:sch-1-sec-39 ;
    values:originalText "Repeal the subsection, substitute: (1) Division 6 applies in relation to the carrying out under this Division of a forensic procedure on an offender. For this purpose: (a) references in Division 6 to the suspect are taken to be references to the offender; and (b) references in Subdivision F of Division 6 to the investigating constable are taken to be references to the Commissioner. Note: By applying Division 6, sections 23XJ (about use of force in carrying out forensic procedures) and 23XK (about forensic procedures not  Forensic procedures  Schedule 1 Amendments commencing on day after Royal Assent  Part 1 Crimes Legislation Amendment (Powers and Offences) Act 2012 Compilation date: 05/04/2012 being carried out in a cruel, inhuman or degrading manner) apply to the carrying out of a forensic procedure under this Division." ;
    skos:definition "Repeal the subsection, substitute: (1) Division 6 applies in relation to the carrying out under this Division of a forensic procedure on an offender. For this purpose: (a) references in Division 6 to the suspect are taken to be references to the offender; and (b) references in Subdivision F of Division 6 to the investigating constable are taken to be references to the Commissioner. Note: By applying Division 6, sections 23XJ (about use of force in carrying out forensic procedures) and 23XK (about forensic procedures not  Forensic procedures  Schedule 1 Amendments commencing on day after Royal Assent  Part 1 Crimes Legislation Amendment (Powers and Offences) Act 2012 Compilation date: 05/04/2012 being carried out in a cruel, inhuman or degrading manner) apply to the carrying out of a forensic procedure under this Division."@en ;
    cml:integrityHash "a6c15c543e4bde4fe926563efe004c45998e61471ecd2f484cc176e77251e808" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Repeal subsection, substitute Division 6 for carrying out forensic procedures on offenders." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-and-offences-act-2012.pdf> ;
    dc:source "crimes-legislation-amendment-powers-and-offences-act-2012.pdf, p.14" ;
