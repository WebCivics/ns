concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-2-sec-59ad a cml:Concept ;
    skos:prefLabel "59AD Publication of reports in relation to offences"@en ;
    cml:realizedBy doc:sch-2-sec-59ad ;
    values:originalText "A report under this Act that: (a) sets out a finding that an offence has been committed; or (b) makes a recommendation to institute a prosecution in respect of an offence; must not be made available to the public unless the finding or recommendation is expressed to be based on evidence that would be admissible in the prosecution of a person for that offence." ;
    skos:definition "A report under this Act that: (a) sets out a finding that an offence has been committed; or (b) makes a recommendation to institute a prosecution in respect of an offence; must not be made available to the public unless the finding or recommendation is expressed to be based on evidence that would be admissible in the prosecution of a person for that offence."@en ;
    cml:integrityHash "604b515459f97e03f831fd6c47a7adc648c75bc4bf54491f20144f3a3f49745a" ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Publication of reports in relation to offences must be based on admissible evidence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-and-offences-act-2012.pdf> ;
