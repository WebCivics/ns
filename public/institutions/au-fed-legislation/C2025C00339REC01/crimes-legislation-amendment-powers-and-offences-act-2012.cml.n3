doc:sch-4-sec-96d-ss-2 a cof:Section ;
    cof:title "96D(2) Person in contempt may be detained" ;
    values:kind "subsection" ;
    values:originalText "(2) If the person is so detained: (a) the Integrity Commissioner must apply to the court as soon as practicable under subsection 96B(1) in respect of the person; and (b) the person must, subject to subsection (3) of this section, be brought before the court as soon as practicable." ;
    cof:pageNumber "56"^^xsd:integer .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96d-ss-3 a cml:Concept ;
    skos:prefLabel "96D(3) Person in contempt may be detained"@en ;
    cml:realizedBy doc:sch-4-sec-96d-ss-3 ;
    values:originalText "(3) The court may: (a) direct that the person be released from detention on condition that he or she will appear before the court in relation to the application; or (b) order that the person continue to be detained until the application is determined." ;
    skos:definition "(3) The court may: (a) direct that the person be released from detention on condition that he or she will appear before the court in relation to the application; or (b) order that the person continue to be detained until the application is determined."@en ;
