concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96e a cml:Concept ;
    skos:prefLabel "96E Integrity Commissioner may withdraw contempt application"@en ;
    cml:realizedBy doc:sch-4-sec-96e ;
    values:originalText "(1) The Integrity Commissioner may, at any time, withdraw an application under subsection 96B(1). (2) If: (a) the Integrity Commissioner does so; and (b) the person to whom the application relates is in detention under section 96D; the person must be released from detention immediately." ;
    skos:definition "(1) The Integrity Commissioner may, at any time, withdraw an application under subsection 96B(1). (2) If: (a) the Integrity Commissioner does so; and (b) the person to whom the application relates is in detention under section 96D; the person must be released from detention immediately."@en ;
    cml:integrityHash "de371327ede6373e16f13bb8b2ae6d5596af1a188b1ddd23d64a85bf15193690" ;
    cof:pageNumber "57"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96e-ss-1 ;
    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96e-ss-2 ;
