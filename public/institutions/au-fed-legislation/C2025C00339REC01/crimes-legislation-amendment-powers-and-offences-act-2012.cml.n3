doc:sch-7-sec-19am-ss-2 a cof:Section ;
    cof:title "19AM(2) Release on parole—when is a person released" ;
    values:kind "subsection" ;
    values:originalText "(2) The person’s parole period starts at the earlier of the following times: (a) when the person is released from prison on parole; (b) if the person is serving a State or Territory sentence at the time the parole order is made—when the person certifies on the parole order (or a copy of the order) that he or she accepts the conditions to which the order is subject." ;
    cof:pageNumber "74"^^xsd:integer .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am-ss-3 a cml:Concept ;
    skos:prefLabel "19AM(3) Release on parole—when is a person released"@en ;
    cml:realizedBy doc:sch-7-sec-19am-ss-3 ;
    values:originalText "(3) The person’s parole period ends: (a) at the end of the last day of any federal sentence that is, on the day of the release, being served or to be served (after deducting any remission or reduction that is applicable); or (b) if the person has been given a federal life sentence—at the later of the following times: (i) 5 years after the person is released from prison on parole in accordance with section 19AM; (ii) the end of a later day (if any) specified in the parole order for the purposes of this subparagraph (not being a day earlier than 5 years after the person’s expected release from prison in accordance with the order)." ;
    skos:definition "(3) The person’s parole period ends: (a) at the end of the last day of any federal sentence that is, on the day of the release, being served or to be served (after deducting any remission or reduction that is applicable); or (b) if the person has been given a federal life sentence—at the later of the following times: (i) 5 years after the person is released from prison on parole in accordance with section 19AM; (ii) the end of a later day (if any) specified in the parole order for the purposes of this subparagraph (not being a day earlier than 5 years after the person’s expected release from prison in accordance with the order)."@en ;
    cml:integrityHash "e481ad5fca52b14f1e2080adba50db39e220a3973492df319b6c8376178aa4fa" ;
    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "A person must not be released from prison on parole unless they certify acceptance of the conditions. Release on parole—when is a person released" ;
    dc:description "Certification of acceptance of conditions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-and-offences-act-2012.pdf> ;
    dc:source "crimes-legislation-amendment-powers-and-offences-act-2012.pdf, p.74" ;
    cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am-ss-3-norm .
