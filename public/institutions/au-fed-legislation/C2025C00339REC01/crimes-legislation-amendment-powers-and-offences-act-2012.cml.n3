concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-2 a cml:Concept ;
    skos:prefLabel "2 Subsection 16(1) (definition of parole order)"@en ;
    cml:realizedBy doc:sch-7-sec-2 ;
    values:originalText "Repeal the definition, substitute: parole order means an order made under subsection 19AL(1) or (2) directing that a person be released from prison on parole." ;
    skos:definition "Repeal the definition, substitute: parole order means an order made under subsection 19AL(1) or (2) directing that a person be released from prison on parole."@en ;
