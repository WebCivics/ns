concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-23xu a cml:Concept ;
    skos:prefLabel "23XU Samples—sufficient material to share"@en ;
    cml:realizedBy doc:sch-1-sec-23xu ;
    values:originalText "(1) This section applies if: (a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared; and (c) there is sufficient material to be analysed both in the investigation of the offence and on behalf of the suspect. (2) The investigating constable must invite the suspect to nominate an accredited laboratory to which a part of the material sufficient for analysis will be provided on behalf of the suspect.  Schedule 1  Forensic procedures" ;
    skos:definition "(1) This section applies if: (a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared; and (c) there is sufficient material to be analysed both in the investigation of the offence and on behalf of the suspect. (2) The investigating constable must invite the suspect to nominate an accredited laboratory to which a part of the material sufficient for analysis will be provided on behalf of the suspect.  Schedule 1  Forensic procedures"@en ;
    cml:integrityHash "5c0423b13ff38d6e6f5269df45acb728bb08375ddc846a79a4b24c2832c21181" ;
    cof:pageNumber "11"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-23xu-ss-1 ;
    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-23xu-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
