doc:sch-1-sec-32-ss-6 a cof:Section ;
    cof:title "32(6) At the end of section 23XUA" ;
    values:kind "subsection" ;
    values:originalText "(6) If the analyst gives such a direction, the analyst must inform the attendee that a failure to comply with the direction is an offence against subsection (7). A failure to comply with this subsection does not affect the validity of the direction." ;
    cof:pageNumber "12"^^xsd:integer .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-32-ss-7 a cml:Concept ;
    skos:prefLabel "32(7) At the end of section 23XUA"@en ;
    cml:realizedBy doc:sch-1-sec-32-ss-7 ;
    values:originalText "(7) The attendee commits an offence if: (a) the attendee is given a direction under subsection (5); and (b) the attendee fails to comply with the direction. Penalty: 30 penalty units." ;
    skos:definition "(7) The attendee commits an offence if: (a) the attendee is given a direction under subsection (5); and (b) the attendee fails to comply with the direction. Penalty: 30 penalty units."@en ;
    cml:integrityHash "03a63f2425452272013b02c876c6c0e14d8b3c02805d287e1d06a013c34f37a9" ;
    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-32 ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Failure to comply with direction results in an offence." ;
