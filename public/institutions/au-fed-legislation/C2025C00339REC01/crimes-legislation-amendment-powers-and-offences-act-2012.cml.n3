    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-77a ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Prohibition on disclosure of notice after investigation concludes and proceedings commence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
