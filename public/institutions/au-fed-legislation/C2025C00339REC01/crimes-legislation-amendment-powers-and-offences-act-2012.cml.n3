    skos:prefLabel "8 Subsection 19AN(2)"@en ;
    cml:realizedBy doc:sch-7-sec-8 ;
    values:originalText "Omit all the words after “order by”, substitute: doing any or all of the following: (a) varying or revoking a condition of the parole order; (b) imposing additional conditions on the parole order; (c) changing the day on which the supervision period ends." ;
