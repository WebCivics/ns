    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96b-ss-5 ;
    cml:hasPart concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-96b-ss-6 ;
