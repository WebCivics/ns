doc:sch-7-sec-19am-ss-1 a cof:Section ;
    cof:title "19AM(1) Release on parole—when is a person released" ;
    values:kind "subsection" ;
    values:originalText "(1) For the purposes of this Part, the parole period for a person for whom a parole order has been made is the period starting in accordance with subsection (2) and ending in accordance with subsection (3). Note: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AN and 19AU)." ;
    cof:pageNumber "74"^^xsd:integer .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am-ss-2 a cml:Concept ;
    skos:prefLabel "19AM(2) Release on parole—when is a person released"@en ;
    cml:realizedBy doc:sch-7-sec-19am-ss-2 ;
    values:originalText "(2) The person’s parole period starts at the earlier of the following times: (a) when the person is released from prison on parole; (b) if the person is serving a State or Territory sentence at the time the parole order is made—when the person certifies on the parole order (or a copy of the order) that he or she accepts the conditions to which the order is subject." ;
    skos:definition "(2) The person’s parole period starts at the earlier of the following times: (a) when the person is released from prison on parole; (b) if the person is serving a State or Territory sentence at the time the parole order is made—when the person certifies on the parole order (or a copy of the order) that he or she accepts the conditions to which the order is subject."@en ;
    cml:integrityHash "b8b8c6bdde0d5229a489450e5a5a8e70397340d3d152e2b32f742989e6832955" ;
    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "A person must certify acceptance of parole conditions. A person must be released from prison on parole if they are eligible for release under subsection (1) but were imprisoned for a State or Territory offence on the day of eligibility." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
