concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-41 a cml:Concept ;
    skos:prefLabel "41 After section 23XWN"@en ;
    cml:realizedBy doc:sch-1-sec-41 ;
    values:originalText "Insert: 23XWNA  Circumstances in which judge or magistrate may order forensic procedure A judge or magistrate may, under section 23XWO, order the carrying out of a forensic procedure on an offender if: (a) the offender is not in custody and has not consented to the forensic procedure (whether or not consent has been sought); or (b) the offender is in custody and has not consented to the forensic procedure (whether or not consent has been sought); or (c) under section 23WE, the offender cannot consent to the forensic procedure." ;
    skos:definition "Insert: 23XWNA  Circumstances in which judge or magistrate may order forensic procedure A judge or magistrate may, under section 23XWO, order the carrying out of a forensic procedure on an offender if: (a) the offender is not in custody and has not consented to the forensic procedure (whether or not consent has been sought); or (b) the offender is in custody and has not consented to the forensic procedure (whether or not consent has been sought); or (c) under section 23WE, the offender cannot consent to the forensic procedure."@en ;
    cml:integrityHash "5a2d6fb69a862d177fb488eef20f8a40c015b5a30fbcd4e112f2cf65e05e0973" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Judge or magistrate may order forensic procedure on offender under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-and-offences-act-2012.pdf> ;
