concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-1-sec-73 a cml:Concept ;
    skos:prefLabel "73 At the end of Division 11 of Part ID"@en ;
    cml:realizedBy doc:sch-1-sec-73 ;
    values:originalText "Add: 23YUDA  Arrangements with prisons or other places of detention The Commissioner may, on behalf of the Commonwealth, enter into an arrangement with the head (however described) of a prison or other place of detention in a State or Territory in relation to the carrying out of forensic procedures under this Part on offenders who are serving sentences of imprisonment in that prison or other place of detention." ;
    skos:definition "Add: 23YUDA  Arrangements with prisons or other places of detention The Commissioner may, on behalf of the Commonwealth, enter into an arrangement with the head (however described) of a prison or other place of detention in a State or Territory in relation to the carrying out of forensic procedures under this Part on offenders who are serving sentences of imprisonment in that prison or other place of detention."@en ;
    cml:integrityHash "5b5ef2800bae0997ab78a49703ddc183278a87fc39de5b9fdc76e10566e93df3" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Commissioner may enter into arrangement with prison head regarding forensic procedures." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-and-offences-act-2012.pdf> ;
    dc:source "crimes-legislation-amendment-powers-and-offences-act-2012.pdf, p.22" ;
