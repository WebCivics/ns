      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The other appointed Board members must appoint a presider before the meeting concludes."
    },
    {
      "@id": "concept:creative-australia-act-2023-sec-31-ss-3-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The absence of a Chair or Deputy Chair necessitates a presider's appointment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Presider appointment implies meeting constitution",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "If the Chair and Deputy Chair are not present, then a presider must be appointed."
    },
    {
      "@id": "concept:creative-australia-act-2023-sec-31-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The presider's appointment requires a collective decision-making process among the Board members.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
