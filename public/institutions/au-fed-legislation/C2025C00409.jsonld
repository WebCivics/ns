      "cml:logicSummary": "Presider appointment as a cognitive event",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The other appointed Board members must cognitively process the need for a presider."
    },
    {
      "@id": "concept:creative-australia-act-2023-sec-31-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The other appointed Board members must appoint one of themselves to preside.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
