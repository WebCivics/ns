    {
      "@id": "concept:creative-australia-act-2023-sec-35a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to support Aboriginal and Torres Strait Islander arts practice at the time of the First Nations Board's establishment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal relationship between the First Nations Board's establishment and its support for Aboriginal and Torres Strait Islander arts practice.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "supports",
      "cml:premiseText": "The First Nations Board has a number of functions, including to support and invest in a diverse range of Aboriginal and Torres Strait Islander arts practice."
    },
    {
      "@id": "concept:creative-australia-act-2023-sec-35a-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Supporting Aboriginal and Torres Strait Islander arts practice is necessary for the effective functioning of the First Nations Board.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Justifies the need for the First Nations Board to support Aboriginal and Torres Strait Islander arts practice.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "supports",
      "cml:premiseText": "The First Nations Board has a number of functions, including to support and invest in a diverse range of Aboriginal and Torres Strait Islander arts practice."
    },
