    cml:operator "supports" ;
    cml:logicSummary "Defines the temporal relationship between the First Nations Board's establishment and its support for Aboriginal and Torres Strait Islander arts practice." ;
    cml:premiseText "The First Nations Board has a number of functions, including to support and invest in a diverse range of Aboriginal and Torres Strait Islander arts practice." ;
    cml:conclusionText "There is an obligation to support Aboriginal and Torres Strait Islander arts practice at the time of the First Nations Board's establishment." ;
    cml:executionSurface "modalities::interval_reasoning" ;
