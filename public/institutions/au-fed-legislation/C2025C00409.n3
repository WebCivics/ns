    cml:modality cml:Deontic ;
    cml:operator "establishes" ;
    cml:logicSummary "Creates an obligation to support Aboriginal and Torres Strait Islander arts practice." ;
    cml:premiseText "The First Nations Board has a number of functions, including to support and invest in a diverse range of Aboriginal and Torres Strait Islander arts practice." ;
    cml:conclusionText "There is an obligation to support Aboriginal and Torres Strait Islander arts practice." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

