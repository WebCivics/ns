concept:creative-australia-act-2023-sec-57 a cml:Concept ;
    skos:prefLabel "57 Termination"@en ;
    cml:realizedBy doc:sec-57 ;
    values:originalText "(1) The Minister may terminate the appointment of a Creative Workplaces Council member: (a) for misbehaviour; or" ;
