concept:creative-australia-act-2023-sec-13 a cml:Concept ;
    skos:prefLabel "13 Matters to be taken into account by Creative Australia"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "Creative Australia must, in the performance of its functions and the exercise of its powers, have regard to: (a) the policies of the Commonwealth Government in relation to the arts; and (b) any matters specified in directions given under subsection 14(1)." ;
    skos:definition "Creative Australia must, in the performance of its functions and the exercise of its powers, have regard to: (a) the policies of the Commonwealth Government in relation to the arts; and (b) any matters specified in directions given under subsection 14(1)."@en ;
    cml:integrityHash "98b12a8bfa03786f11857a657885e06df91a5306a55742b1169a999d49d7c4b7" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Must consider Commonwealth Government policies and directions on arts matters." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <creative-australia-act-2023.pdf> ;
    dc:source "creative-australia-act-2023.pdf, p.20" ;
