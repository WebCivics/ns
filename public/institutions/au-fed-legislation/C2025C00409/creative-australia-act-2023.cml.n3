concept:creative-australia-act-2023-sec-60 a cml:Concept ;
    skos:prefLabel "60 Simplified outline of this Part"@en ;
    cml:realizedBy doc:sec-60 ;
    values:originalText "This Part provides for the Board to establish committees to advise or assist in the performance of Creative Australia’s functions or the Board’s functions, in accordance with any determinations or directions by the Board." ;
    skos:definition "This Part provides for the Board to establish committees to advise or assist in the performance of Creative Australia’s functions or the Board’s functions, in accordance with any determinations or directions by the Board."@en ;
    cml:integrityHash "2f08f8b92b8333fe8967108c609baa6779e30e0055ada49452991a7ea843ba90" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Establishment of committees for advisory or assistive purposes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <creative-australia-act-2023.pdf> ;
