concept:creative-australia-act-2023-sec-35j a cml:Concept ;
    skos:prefLabel "35J Remuneration"@en ;
    cml:realizedBy doc:sec-35j ;
    values:originalText "(1) A First Nations Board member is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the member is to be paid the remuneration that is prescribed by the rules." ;
    skos:definition "(1) A First Nations Board member is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the member is to be paid the remuneration that is prescribed by the rules."@en ;
    cml:integrityHash "2f163c6e30de77cea8e9081213636e91514265330527cbdeb159fb5ab158ee53" ;
    cof:pageNumber "39"^^xsd:integer ;
    skos:note "A First Nations Board member must be paid remuneration determined by the Remuneration Tribunal or prescribed by rules." ;
    dc:description "Remuneration" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <creative-australia-act-2023.pdf> ;
    dc:source "creative-australia-act-2023.pdf, p.39" ;
