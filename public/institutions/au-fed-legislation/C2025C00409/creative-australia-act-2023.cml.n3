doc:sec-35l-ss-1 a cof:Section ;
    cof:title "35L(1) Resignation" ;
    values:kind "subsection" ;
    values:originalText "(1) A First Nations Board member may resign the member’s appointment by giving the Minister a written resignation." ;
    cof:pageNumber "40"^^xsd:integer .

concept:creative-australia-act-2023-sec-35l-ss-2 a cml:Concept ;
    skos:prefLabel "35L(2) Resignation"@en ;
    cml:realizedBy doc:sec-35l-ss-2 ;
    values:originalText "(2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day."@en ;
