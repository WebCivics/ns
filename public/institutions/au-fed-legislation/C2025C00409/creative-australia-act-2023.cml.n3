concept:creative-australia-act-2023-sec-47l a cml:Concept ;
    skos:prefLabel "47L Other terms and conditions"@en ;
    cml:realizedBy doc:sec-47l ;
    values:originalText "An appointed Writing Australia Council member holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Minister." ;
