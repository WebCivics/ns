doc:sec-52-ss-5 a cof:Section ;
    cof:title "52(5) Appointment" ;
    values:kind "subsection" ;
    values:originalText "(5) A Creative Workplaces Council member holds office on a part-time basis." ;
    cof:pageNumber "61"^^xsd:integer .

concept:creative-australia-act-2023-sec-52-ss-6 a cml:Concept ;
    skos:prefLabel "52(6) Appointment"@en ;
    cml:realizedBy doc:sec-52-ss-6 ;
    values:originalText "(6) A Creative Workplaces Council member holds office for the period specified in the instrument of appointment. The period must not exceed 4 years. Note: A Creative Workplaces Council member may be reappointed: see section 33AA of the Acts Interpretation Act 1901." ;
