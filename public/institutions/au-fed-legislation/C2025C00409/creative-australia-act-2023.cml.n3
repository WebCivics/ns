doc:sec-47h-ss-3 a cof:Section ;
    cof:title "47H(3) Leave" ;
    values:kind "subsection" ;
    values:originalText "(3) The Chair of the Writing Australia Council must notify the Minister if the Chair grants an appointed Writing Australia Council member leave of absence for a period that exceeds 6 months." ;
    cof:pageNumber "56"^^xsd:integer .

concept:creative-australia-act-2023-sec-47j a cml:Concept ;
    skos:prefLabel "47J Resignation"@en ;
    cml:realizedBy doc:sec-47j ;
    values:originalText "(1) An appointed Writing Australia Council member may resign the member’s appointment by giving the Minister a written resignation. (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) An appointed Writing Australia Council member may resign the member’s appointment by giving the Minister a written resignation. (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day."@en ;
