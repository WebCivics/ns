doc:sec-61-ss-2 a cof:Section ;
    cof:title "61(2) Committees" ;
    values:kind "subsection" ;
    values:originalText "(2) If the terms of reference of a committee include providing advice, or making recommendations, about policy, or the provision of financial assistance or guarantees, in relation to the arts (or any of the arts), the Board must ensure that the members of the committee include at least one person who has relevant experience in the arts." ;
    cof:pageNumber "66"^^xsd:integer .

concept:creative-australia-act-2023-sec-61-ss-3 a cml:Concept ;
    skos:prefLabel "61(3) Committees"@en ;
    cml:realizedBy doc:sec-61-ss-3 ;
    values:originalText "(3) A committee may be constituted: (a) wholly by Board members; or (b) wholly by persons who are not Board members; or (c) partly by Board members and partly by other persons." ;
    skos:definition "(3) A committee may be constituted: (a) wholly by Board members; or (b) wholly by persons who are not Board members; or (c) partly by Board members and partly by other persons."@en ;
    cml:integrityHash "ee7a874cedc1d76e44de615103791b054f5289bf5467af1d67b0061f147090fa" ;
    values:partOf concept:creative-australia-act-2023-sec-61 ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Committees may be constituted in certain ways" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
