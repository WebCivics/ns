concept:creative-australia-act-2023-sec-56 a cml:Concept ;
    skos:prefLabel "56 Resignation"@en ;
    cml:realizedBy doc:sec-56 ;
    values:originalText "(1) A Creative Workplaces Council member may resign the member’s appointment by giving the Minister a written resignation. (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) A Creative Workplaces Council member may resign the member’s appointment by giving the Minister a written resignation. (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day."@en ;
    cml:integrityHash "be4f04f47aab4ef971a97ea09b901259fe75adf7841209608243f8ce6dac0006" ;
    cof:pageNumber "63"^^xsd:integer ;
    cml:hasPart concept:creative-australia-act-2023-sec-56-ss-1 ;
    cml:hasPart concept:creative-australia-act-2023-sec-56-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <creative-australia-act-2023.pdf> ;
    dc:source "creative-australia-act-2023.pdf, p.63" .
