concept:creative-australia-act-2023-sec-35d a cml:Concept ;
    skos:prefLabel "35D First Nations Board budget"@en ;
    cml:realizedBy doc:sec-35d ;
    values:originalText "The Board must allocate, from money payable to Creative Australia under section 78, to the First Nations Board such money   First Nations Board  Part 3A Establishment etc. of First Nations Board  Division 2 Section 35E Creative Australia Act 2023 Compilation date: 01/07/2025 as the Board thinks appropriate for the purposes of the First Nations Board exercising the functions referred to in subsection 35C(1)." ;
    skos:definition "The Board must allocate, from money payable to Creative Australia under section 78, to the First Nations Board such money   First Nations Board  Part 3A Establishment etc. of First Nations Board  Division 2 Section 35E Creative Australia Act 2023 Compilation date: 01/07/2025 as the Board thinks appropriate for the purposes of the First Nations Board exercising the functions referred to in subsection 35C(1)."@en ;
    cml:integrityHash "003594f345b18edc3784b60aee5900c66ca215c5d0b69320eefb217aa0c72c3b" ;
    cof:pageNumber "36"^^xsd:integer ;
