doc:sec-81-ss-1 a cof:Section ;
    cof:title "81(1) Investment" ;
    values:kind "subsection" ;
    values:originalText "(1) Creative Australia may invest money, under paragraph 12(2)(g), in the course of the direct performance of its functions. Note: Paragraph 12(2)(g) gives Creative Australia power to make investments, but only as a means of providing financial assistance. It does not give Creative Australia a general power to make investments." ;
    cof:pageNumber "76"^^xsd:integer .

concept:creative-australia-act-2023-sec-81-ss-2 a cml:Concept ;
    skos:prefLabel "81(2) Investment"@en ;
    cml:realizedBy doc:sec-81-ss-2 ;
    values:originalText "(2) Subsection (1) applies in addition to investment, under section 59 of the PGPA Act, of money that is not immediately required for the purposes of Creative Australia." ;
    skos:definition "(2) Subsection (1) applies in addition to investment, under section 59 of the PGPA Act, of money that is not immediately required for the purposes of Creative Australia."@en ;
    cml:integrityHash "637cb09afb199fa68f59eab3993e269e1fd99d420689f8ec984ceb456af13b8b" ;
    values:partOf concept:creative-australia-act-2023-sec-81 ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Investment of money not immediately required for Creative Australia purposes is also subject to subsection (1) of section 81." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
