concept:creative-australia-act-2023-sec-44 a cml:Concept ;
    skos:prefLabel "44 Resignation"@en ;
    cml:realizedBy doc:sec-44 ;
    values:originalText "(1) An appointed Music Australia Council member may resign the member’s appointment by giving the Minister a written resignation. (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) An appointed Music Australia Council member may resign the member’s appointment by giving the Minister a written resignation. (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day."@en ;
    cml:integrityHash "4ded50e65bc6bc2082d716be3b77b4423cadce8da6151d2015f198551112ae87" ;
    cof:pageNumber "48"^^xsd:integer ;
