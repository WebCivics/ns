concept:creative-australia-act-2023-sec-40-ss-6 a cml:Concept ;
    skos:prefLabel "40(6) Appointment"@en ;
    cml:realizedBy doc:sec-40-ss-6 ;
    values:originalText "(6) A person must not be appointed as an appointed Music Australia Council member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as an appointed Music Australia Council member.   Music Australia Council  Part 4 Appointment etc. of appointed Music Australia Council members  Division 3 Section 41 Creative Australia Act 2023 Compilation date: 01/07/2025" ;
    skos:definition "(6) A person must not be appointed as an appointed Music Australia Council member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as an appointed Music Australia Council member.   Music Australia Council  Part 4 Appointment etc. of appointed Music Australia Council members  Division 3 Section 41 Creative Australia Act 2023 Compilation date: 01/07/2025"@en ;
    cml:integrityHash "18cdabc8c66a4424a939072d1bdaf5514eb5cfda8a5138611839edc70ee8ad69" ;
    values:partOf concept:creative-australia-act-2023-sec-40 ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "No appointment for more than 9 years is allowed." ;
