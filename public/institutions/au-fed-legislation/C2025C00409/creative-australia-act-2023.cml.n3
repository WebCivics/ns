doc:sec-66 a cof:Section ;
    cof:title "66 Appointment" ;
    values:kind "section" ;
    values:originalText "(1) The CEO is to be appointed by the Board with the written agreement of the Minister." ;
    cof:pageNumber "69"^^xsd:integer .

concept:creative-australia-act-2023-sec-67 a cml:Concept ;
    skos:prefLabel "67 Acting appointment"@en ;
    cml:realizedBy doc:sec-67 ;
    values:originalText "The Board may, with the written agreement of the Minister, appoint a person to act as the CEO: (a) during a vacancy in the office of the CEO (whether or not an appointment has previously been made to the office); or (b) during any period, or during all periods, when the CEO: (i) is absent from duty; or (ii) is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see sections 33AB and 33A of the Acts Interpretation Act 1901." ;
    skos:definition "The Board may, with the written agreement of the Minister, appoint a person to act as the CEO: (a) during a vacancy in the office of the CEO (whether or not an appointment has previously been made to the office); or (b) during any period, or during all periods, when the CEO: (i) is absent from duty; or (ii) is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see sections 33AB and 33A of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "61bb37ff858ef98eae6c3937d87464905c4e8426192a6c80bc6db691e3c073e8" ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "The Board may appoint a person to act as CEO under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
