doc:sec-35g-ss-5 a cof:Section ;
    cof:title "35G(5) Appointment" ;
    values:kind "subsection" ;
    values:originalText "(5) A First Nations Board member holds office for the period specified in the instrument of appointment. The period must not exceed 4 years. Note: A First Nations Board member may be reappointed: see section 33AA of the Acts Interpretation Act 1901." ;
    cof:pageNumber "38"^^xsd:integer .

concept:creative-australia-act-2023-sec-35g-ss-6 a cml:Concept ;
    skos:prefLabel "35G(6) Appointment"@en ;
    cml:realizedBy doc:sec-35g-ss-6 ;
    values:originalText "(6) A person must not be appointed as a First Nations Board member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as a First Nations Board member." ;
    skos:definition "(6) A person must not be appointed as a First Nations Board member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as a First Nations Board member."@en ;
