concept:creative-australia-act-2023-sec-22-ss-7 a cml:Concept ;
    skos:prefLabel "22(7) Appointment"@en ;
    cml:realizedBy doc:sec-22-ss-7 ;
    values:originalText "(7) A person must not be appointed as an appointed Board member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as an appointed Board member (within the meaning of this Act or the old Act)." ;
    skos:definition "(7) A person must not be appointed as an appointed Board member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as an appointed Board member (within the meaning of this Act or the old Act)."@en ;
    cml:integrityHash "14bdb4cc9bd6dac9dd490e1fe189023646774fb2a6d91da9b93cdd37683653de" ;
    values:partOf concept:creative-australia-act-2023-sec-22 ;
    cof:pageNumber "27"^^xsd:integer ;
