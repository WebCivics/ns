concept:creative-australia-act-2023-sec-52-ss-7 a cml:Concept ;
    skos:prefLabel "52(7) Appointment"@en ;
    cml:realizedBy doc:sec-52-ss-7 ;
    values:originalText "(7) A person must not be appointed as a Creative Workplaces Council member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as a Creative Workplaces Council member." ;
    skos:definition "(7) A person must not be appointed as a Creative Workplaces Council member for a period if the sum of the following exceeds 9 years: (a) that period; (b) any periods of previous appointment of the person as a Creative Workplaces Council member."@en ;
