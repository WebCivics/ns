    cml:modality cml:Diffusion ;
    cml:operator "IS_A" ;
    cml:logicSummary "Presider appointment as a diffusion event" ;
    cml:premiseText "The other appointed Board members must diffuse the responsibility of presiding." ;
    cml:conclusionText "The presider's appointment is a distributed decision among the Board members." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

