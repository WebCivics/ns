    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-31-ss-3 a cof:Section ;
    cof:title "31(3) Presiding at meetings" ;
    values:kind "subsection" ;
    values:originalText "(3) If neither the Chair nor the Deputy Chair is present at a meeting of the Board, the other appointed Board members present must appoint one of themselves to preside." ;
    cof:pageNumber "32"^^xsd:integer .

concept:creative-australia-act-2023-sec-32 a cml:Concept ;
    skos:prefLabel "32 Voting at meetings"@en ;
    cml:realizedBy doc:sec-32 ;
    values:originalText "(1) A question arising at a meeting of the Board is to be determined by a majority of the votes of the appointed Board members present and voting. (2) The person presiding at the meeting of the Board has a deliberative vote and, if the votes are equal, a casting vote." ;
    skos:definition "(1) A question arising at a meeting of the Board is to be determined by a majority of the votes of the appointed Board members present and voting. (2) The person presiding at the meeting of the Board has a deliberative vote and, if the votes are equal, a casting vote."@en ;
