concept:creative-australia-act-2023-sec-28 a cml:Concept ;
    skos:prefLabel "28 Other terms and conditions"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "An appointed Board member holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Minister." ;
