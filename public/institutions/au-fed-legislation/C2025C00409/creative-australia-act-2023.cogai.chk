  @action: Chair must preside;
}

creative-australia-act-2023-sec-31-ss-3-logic-125 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-31-ss-3;
  logic: Deontic;
  operator: MUST;
  summary: Duty to appoint a presider;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: Neither the Chair nor the Deputy Chair is present.;
  @action: The other appointed Board members must appoint one of themselves to preside.;
}

creative-australia-act-2023-sec-31-ss-3-logic-126 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-31-ss-3;
  logic: AllenInterval;
  operator: >=;
  summary: Temporal interval for presider appointment;
  executionSurface: modalities::interval_reasoning;
  curationStatus: Proposed;
  @condition: The other appointed Board members must appoint a presider before the meeting concludes.;
  @action: The presider's appointment is contingent on the meeting's duration.;
}

creative-australia-act-2023-sec-31-ss-3-logic-127 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-31-ss-3;
  logic: Argumentation;
  operator: IMPLIES;
  summary: Presider appointment implies meeting constitution;
  executionSurface: modalities::argumentation;
  curationStatus: Proposed;
  @condition: If the Chair and Deputy Chair are not present, then a presider must be appointed.;
  @action: The absence of a Chair or Deputy Chair necessitates a presider's appointment.;
}

creative-australia-act-2023-sec-31-ss-3-logic-128 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-31-ss-3;
  logic: Diffusion;
  operator: IS_A;
  summary: Presider appointment as a diffusion event;
  executionSurface: modalities::diffusion;
  curationStatus: Proposed;
  @condition: The other appointed Board members must diffuse the responsibility of presiding.;
  @action: The presider's appointment is a distributed decision among the Board members.;
}

creative-australia-act-2023-sec-31-ss-3-logic-129 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-31-ss-3;
  logic: CogAI;
  operator: IS_A;
  summary: Presider appointment as a cognitive event;
  executionSurface: sparql_library::parsers::chk_parser;
  curationStatus: Proposed;
  @condition: The other appointed Board members must cognitively process the need for a presider.;
  @action: The presider's appointment requires a collective decision-making process among the Board members.;
}

creative-australia-act-2023-sec-32-ss-1-logic-130 {
