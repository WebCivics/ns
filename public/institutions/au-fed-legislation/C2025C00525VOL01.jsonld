      "cml:operator": "MUST",
      "cml:premiseText": "State or Territory must issue search warrants."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-10",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Labeling requirements",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "label",
      "cml:premiseText": "label, in relation to therapeutic goods, means a display of printed information:"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-11",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "product information, in relation to therapeutic goods, means information relating to the safe and effective use of the goods",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for therapeutic goods",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "therapeutic goods are goods that are represented in any way to be, or that are, whether because of the way in which the goods are presented or for any other reason, likely to be taken to be..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-12",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "reportable medicine has the meaning given by section 30EH",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for reportable medical device",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "reportable medical device means a medical device of a kind prescribed by regulations made for the purposes of this definition"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-13",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "reportable medicine has the meaning given by section 30EH",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for reportable medicine",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "restricted medicine means: (a) a medicine specified in an instrument under subsection (2A); or (b) a medicine included in a class of medicine specified in an instrument under subsection (2B)"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-14",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "biologicals, medical devices and goods declared to be therapeutic goods under an order in force under section 7 but do not include...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for therapeutic goods",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "therapeutic goods means goods: (a) that are represented in any way to be, or that are, whether because of the way in which the goods are presented or for any other reason, likely to be taken to be..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Accessory is an obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies 'accessory'",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Accessory means a thing that the manufacturer of the thing specifically intended to be used together with the device."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Customs officer means an officer of Customs within the meaning of the Customs Act 1901.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The term 'customs officer' is defined as an officer of Customs within the meaning of the Customs Act 1901."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Data processing device means any article or material (for example, a disc) from which information is capable of being reproduced with or without the aid of any other article or device.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The term 'data processing device' is defined as any article or material from which information is capable of being reproduced with or without the aid of any other article or device."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Default standard means any of the following: (a) a standard referred to in paragraph (b) of the definition of standard in this subsection; (b) a standard referred to in paragraph (c) of that definition; (c) a standard referred to in paragraph (d) of that definition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The term 'default standard' is defined as any of the following: (a) a standard referred to in paragraph (b) of the definition of standard in this subsection; (b) a standard referred to in paragraph (c) of that definition; (c) a standard referred to in paragraph (d) of that definition."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Directions for use, in relation to therapeutic goods, includes information on: (a) appropriate doses of the goods; and (b) the method of administration or use of the goods; and (c) the frequency and duration of treatment for each indication of the goods; and (d) the use of the goods by persons of particular ages or by persons having particular medical conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The term 'directions for use' is defined as information on: (a) appropriate doses of the goods; and (b) the method of administration or use of the goods; and (c) the frequency and duration of treatment for each indication of the goods; and (d) the use of the goods by persons of particular ages or by persons having particular medical conditions."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-7",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Export only biological means a biological that is: (a) manufactured in Australia for export only; or (b) imported into Australia for export only.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The term 'export only biological' is defined as a biological that is: (a) manufactured in Australia for export only; or (b) imported into Australia for export only."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-8",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Export only medicine means a medicine that: (a) is manufactured in Australia for export only, or imported into Australia for export only; and (b) is listable goods only because it is so manufactured or imported (and not for any other reason).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The term 'export only medicine' is defined as a medicine that: (a) is manufactured in Australia for export only, or imported into Australia for export only; and (b) is listable goods only because it is so manufactured or imported (and not for any other reason)."
    },
