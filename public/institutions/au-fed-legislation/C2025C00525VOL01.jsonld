    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cn-ss-1",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.302",
      "skos:note": "Supplying a biological without proper authority is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "32CN(1) Criminal offences relating to the giving of an authority to a"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-norm",
        "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-deontic-1",
        "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-deontic-2",
        "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-linearlogic-3",
        "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "ac365f50da309abc6c9d0052f2f1357375363bb4b2c5abef4d4171bb640a41ca",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:therapeutic-goods-act-1989#sec-32cn-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:therapeutic-goods-act-1989-sec-32cn"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The supply is not in accordance with the authority.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits supplying a biological without proper authority.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the Secretary has authorised, under subsection 32CM(1), the person to supply a biological; and (b) the person supplies the biological;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The supply is not in accordance with the authority.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits supplying a biological that would result in harm or injury to any person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(d) either: (i) the use of the biological has resulted in, will result in, or is likely to result in, harm or injury to any person; or (ii) the use of the biological, if the biological were used, would result in, or would be likely to result in, harm or injury to any person;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The supply is not in accordance with the authority.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits supplying a biological that would not result in harm or injury to any person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(e) the harm or injury has resulted, will result, is likely to result, would result, or would be likely to result, because: (i) the supply is not in accordance with the authority; or (ii) the supply is not in accordance with regulations made for the purpose of subsection 32CM(6)."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cn-ss-1-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The supply is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "If supplying a biological without proper authority would result in harm or injury, then it is prohibited.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(d) either: (i) the use of the biological has resulted in, will result in, or is likely to result in, harm or injury to any person; or (ii) the use of the biological, if the biological were used, would result in, or would be likely to result in, harm or injury to any person;"
    },
