    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9f-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision applies during the existence of an entry on the Register related to goods that are not therapeutic goods.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the temporal relationship between the provision and its application",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(1) This section applies if: (a) there is an entry on the Register in relation to goods; and (b) the Secretary is satisfied that the goods are not therapeutic goods."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9f-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The removal of entries from the Register is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits removal of entries from Register",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:premiseText": "(1) This section applies if: (a) there is an entry on the Register in relation to goods; and (b) the Secretary is satisfied that the goods are not therapeutic goods."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9f-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision applies everywhere where there is an entry on the Register related to goods that are not therapeutic goods.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes the spatial relationship between the provision and its application",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "(a) there is an entry on the Register in relation to goods; and (b) the Secretary is satisfied that the goods are not therapeutic goods."
    },
