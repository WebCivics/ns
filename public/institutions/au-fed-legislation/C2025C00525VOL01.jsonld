      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Importation occurs during the period when therapeutic goods are exempt.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:premiseText": "(a) The person imports therapeutic goods into Australia; and (b) the goods are exempt under section 18A; and (c) the importation breaches a condition of the exemption."
    },
