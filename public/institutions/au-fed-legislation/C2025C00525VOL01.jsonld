    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.284",
      "skos:note": "Advertising a biological for an indication that is not accepted in relation to its inclusion in the Register is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "32BJ(2A) General criminal offences relating to this Part"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-norm",
        "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-logic-deontic-1",
        "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-logic-descriptionlogic-2"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "db99284500a8ae665df24129e2c0b062ce26441fc4dbd22fff1171fa4baf1489",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:therapeutic-goods-act-1989#sec-32bj-ss-2a",
      "cml:schemaVersion": "2",
      "partOf": "concept:therapeutic-goods-act-1989-sec-32bj"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: Imprisonment for 5 years or 4,000 penalty units, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of advertising a biological for an indication that is not accepted in relation to its inclusion in the Register.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(2A) A person commits an offence if: (a) the person, by any means, advertises a biological for an indication; and (b) the biological is included in the Register; and (c) the indication is not an indication accepted in relation to that inclusion; and"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(d) either: (i) the use of the biological for the advertised indication has resulted in, will result in, or is likely to result in, harm or injury to any person; or (ii) the use of the biological for the advertised indication, if the biological were so used, would result in, or would be likely to result in, harm or injury to any person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classification of the advertisement as a prohibited act.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "(2A) A person commits an offence if: (a) the person, by any means, advertises a biological for an indication; and (b) the biological is included in the Register; and (c) the indication is not an indication accepted in relation to that inclusion; and"
    },
    {
