    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15-ss-2",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.86",
      "skos:note": "A person commits an offence if they breach a condition of consent.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15(2) Criminal offences relating to breaching a condition of a consent"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-15-ss-2-norm",
        "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-deontic-1",
        "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-deontic-2",
        "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-alleninterval-3",
        "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-argumentation-4",
        "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-diffusion-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "edf552051b0fdf7d71aa89b27a6ac030d5ee1c44f9c450b3ba8a6bc5a94a384e",
      "cml:proposedBy": {
