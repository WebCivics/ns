    {
      "@id": "concept:therapeutic-goods-act-1989-sec-31e-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval for producing documents starts at (1)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for producing documents.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(1) A person commits an offence if: (a) the person produces a document to the Secretary; and (b) the person does so knowing that the document is false or misleading; and (c) the document is produced in compliance or purported compliance with a notice given under section 31A, 31AA, 31B or 31BA."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-31e-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The document is classified as true or false/misleading using AI.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
