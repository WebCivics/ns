    {
      "@id": "concept:therapeutic-goods-act-1989-sec-13-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(3) If: (a) a default standard applies to a class of therapeutic goods; and (b) another default standard applies to only some of the therapeutic goods within that class; and (c) those standards are inconsistent; then the standard referred to in paragraph (a) does not apply in relation to the goods referred to in paragraph (b).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If A implies B and C, then if A, B.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(a) a default standard applies to a class of therapeutic goods; (b) another default standard applies to only some of the therapeutic goods within that class; (c) those standards are inconsistent;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-13-ss-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the standard referred to in paragraph (a) does not apply in relation to the goods referred to in paragraph (b).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "The excerpt defines a subclass relationship between two default standards.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "subClassOf",
      "cml:premiseText": "(a) a default standard applies to a class of therapeutic goods; and (b) another default standard applies to only some of the therapeutic goods within that class;"
    },
