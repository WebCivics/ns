      "dc:source": "therapeutic-goods-act-1989.pdf, p.76",
      "skos:note": "If two default standards apply to different parts of a class of therapeutic goods, the more restrictive standard applies.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "13(3) Special provisions relating to Ministerial standards and default"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-13-ss-3-norm",
