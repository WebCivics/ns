      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.347",
      "skos:note": "Breach of condition results in harm or injury to any person.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "32EF(1) Criminal offences for breach of condition"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
