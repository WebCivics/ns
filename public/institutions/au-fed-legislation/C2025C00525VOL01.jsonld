    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ag-ss-2",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.409",
      "skos:note": "Self-incrimination protection for individuals in criminal proceedings. Regulations may make provision for and in relation to the making of an application, payment of a fee, assessment of an application, conditions of a licence upon transfer, and review of decisions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "41AG(2) Self-incrimination"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
