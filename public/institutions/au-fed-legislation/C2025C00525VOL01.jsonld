      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35b-ss-1",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.384",
      "skos:note": "A person commits an offence if they hold a licence and breach a condition of the licence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "35B(1) Criminal offences relating to breaching a condition of a licence"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-35b-ss-1-norm",
        "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-1",
        "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-2",
        "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-3",
        "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "a0866b55206427146969c1ca4cfaef2310b0ee1235e944b4a4b670e808d96406",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:therapeutic-goods-act-1989#sec-35b-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:therapeutic-goods-act-1989-sec-35b"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Licence is a necessary condition for committing an offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The person holds a licence."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Breach of the licence's condition is a necessary condition for committing an offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The act or omission has resulted in, will result in, or is likely to result in harm or injury to any person."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The penalty for committing an offence is imprisonment for 5 years or 4,000 penalty units.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imprisonment for 5 years or 4,000 penalty units is a possible consequence of committing an offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "A person commits an offence if: (a) the person holds a licence; and (b) the person does an act or omits to do an act; and (c) the act or omission breaches a condition of the licence; and (d) the act or omission has resulted in, will result in, or is likely to result in harm or injury to any person."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35b-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court has discretion to acquit or convict a person of an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "A jury may acquit a person of an offence against this subsection and may convict the person of an offence against subsection (4) instead.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "A jury may acquit a person of an offence against this subsection and may convict the person of an offence against subsection (4) instead: see section 53A."
    },
