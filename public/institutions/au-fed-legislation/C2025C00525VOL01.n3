concept:therapeutic-goods-act-1989-sec-26c-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-26c-ss-1-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-26c-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires certificate for patent infringement proceedings" ;
    cml:premiseText "(1) This section applies if: (a) a person gives a certificate required under subsection 26B(1) in relation to therapeutic goods; and (b) another person (the second person) intends to commence proceedings under the Patents Act 1990 against the person referred to in paragraph (1)(a) for infringement of a patent that has been granted in relation to the therapeutic goods (the proceedings)." ;
    cml:conclusionText "(1) This section applies if: (a) a person gives a certificate required under subsection 26B(1) in relation to therapeutic goods; and (b) another person (the second person) intends to commence proceedings under the Patents Act 1990 against the person referred to in paragraph (1)(a) for infringement of a patent that has been granted in relation to the therapeutic goods (the proceedings)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


