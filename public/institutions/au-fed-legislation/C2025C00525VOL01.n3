    cml:conclusionText "The use of the goods for the advertised indication has resulted in, will result in, or is likely to result in, harm or injury to any person;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

