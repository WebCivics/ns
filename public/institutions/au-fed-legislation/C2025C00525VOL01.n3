    cml:logicSummary "Accessory means a thing specifically intended to be used with the device." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-2 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies 'accessory'" ;
    cml:premiseText "Accessory means a thing that the manufacturer of the thing specifically intended to be used together with the device." ;
    cml:conclusionText "Accessory is an obligation." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-3 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-3 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "The term 'customs officer' is defined as an officer of Customs within the meaning of the Customs Act 1901." ;
    cml:conclusionText "Customs officer means an officer of Customs within the meaning of the Customs Act 1901." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-4 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-4 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "The term 'data processing device' is defined as any article or material from which information is capable of being reproduced with or without the aid of any other article or device." ;
    cml:conclusionText "Data processing device means any article or material (for example, a disc) from which information is capable of being reproduced with or without the aid of any other article or device." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-5 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-5 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "The term 'default standard' is defined as any of the following: (a) a standard referred to in paragraph (b) of the definition of standard in this subsection; (b) a standard referred to in paragraph (c) of that definition; (c) a standard referred to in paragraph (d) of that definition." ;
    cml:conclusionText "Default standard means any of the following: (a) a standard referred to in paragraph (b) of the definition of standard in this subsection; (b) a standard referred to in paragraph (c) of that definition; (c) a standard referred to in paragraph (d) of that definition." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-6 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-6 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "The term 'directions for use' is defined as information on: (a) appropriate doses of the goods; and (b) the method of administration or use of the goods; and (c) the frequency and duration of treatment for each indication of the goods; and (d) the use of the goods by persons of particular ages or by persons having particular medical conditions." ;
    cml:conclusionText "Directions for use, in relation to therapeutic goods, includes information on: (a) appropriate doses of the goods; and (b) the method of administration or use of the goods; and (c) the frequency and duration of treatment for each indication of the goods; and (d) the use of the goods by persons of particular ages or by persons having particular medical conditions." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-7 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-7 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "The term 'export only biological' is defined as a biological that is: (a) manufactured in Australia for export only; or (b) imported into Australia for export only." ;
    cml:conclusionText "Export only biological means a biological that is: (a) manufactured in Australia for export only; or (b) imported into Australia for export only." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-8 .
concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-descriptionlogic-8 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "The term 'export only medicine' is defined as a medicine that: (a) is manufactured in Australia for export only, or imported into Australia for export only; and (b) is listable goods only because it is so manufactured or imported (and not for any other reason)." ;
    cml:conclusionText "Export only medicine means a medicine that: (a) is manufactured in Australia for export only, or imported into Australia for export only; and (b) is listable goods only because it is so manufactured or imported (and not for any other reason)." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-3-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-3-ss-1-logic-deontic-9 .
