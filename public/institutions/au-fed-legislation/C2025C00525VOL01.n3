    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of supplying goods that do not conform to a standard or are not fit for their intended purposes." ;
    cml:premiseText "(a) therapeutic goods of a particular kind are exempt under section 18A; and (b) a person supplies a batch of goods of that kind; and (c) the Secretary is satisfied that the goods included in that batch: ..." ;
    cml:conclusionText "...is prohibited." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
