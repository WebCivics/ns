concept:therapeutic-goods-act-1989-sec-14-ss-4-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:therapeutic-goods-act-1989-sec-14-ss-4 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:therapeutic-goods-act-1989-sec-14-ss-4 cml:asserts concept:therapeutic-goods-act-1989-sec-14-ss-4-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-14-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits importing therapeutic goods without consent." ;
    cml:premiseText "(4) A person commits an offence if: (a) the person imports therapeutic goods into Australia; and (b) the goods are imported without the consent in writing of the Secretary; and (c) the goods do not conform with a standard applicable to the goods (other than by reason of a matter relating to labelling or packaging). Penalty: Imprisonment for 12 months or 1,000 penalty units, or both." ;
    cml:conclusionText "The person commits an offence if they import therapeutic goods without consent." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-14-ss-4 cml:asserts concept:therapeutic-goods-act-1989-sec-14-ss-4-logic-alleninterval-2 .
concept:therapeutic-goods-act-1989-sec-14-ss-4-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "During" ;
    cml:logicSummary "The prohibition applies during the time of importing therapeutic goods." ;
    cml:premiseText "(4) A person commits an offence if: (a) the person imports therapeutic goods into Australia; and (b) the goods are imported without the consent in writing of the Secretary; and (c) the goods do not conform with a standard applicable to the goods (other than by reason of a matter relating to labelling or packaging). Penalty: Imprisonment for 12 months or 1,000 penalty units, or both." ;
    cml:conclusionText "The person commits an offence if they import therapeutic goods during this time." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-14-ss-4 cml:asserts concept:therapeutic-goods-act-1989-sec-14-ss-4-logic-ltl-3 .
concept:therapeutic-goods-act-1989-sec-14-ss-4-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "The prohibition is recurring and applies to each instance of importing therapeutic goods." ;
    cml:premiseText "(4) A person commits an offence if: (a) the person imports therapeutic goods into Australia; and (b) the goods are imported without the consent in writing of the Secretary; and (c) the goods do not conform with a standard applicable to the goods (other than by reason of a matter relating to labelling or packaging). Penalty: Imprisonment for 12 months or 1,000 penalty units, or both." ;
    cml:conclusionText "The person commits an offence if they import therapeutic goods repeatedly without consent." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


