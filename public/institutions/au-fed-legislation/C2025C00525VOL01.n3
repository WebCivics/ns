    cml:modality cml:AllenInterval ;
    cml:operator "<" ;
    cml:logicSummary "Timeframe for record availability" ;
    cml:premiseText "if the person was requested under that paragraph to make the record in question available at or before a requested time—before the end of the period of 24 hours after that time;" ;
