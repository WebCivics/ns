    cml:asserts concept:therapeutic-goods-act-1989-sec-32ef-ss-1-norm .
concept:therapeutic-goods-act-1989-sec-32ef-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:therapeutic-goods-act-1989-sec-32ef-ss-1 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:therapeutic-goods-act-1989-sec-32ef-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-32ef-ss-1-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-32ef-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits breach of condition." ;
    cml:premiseText "(1) A person commits an offence if: (a) a biological is included in the Register in relation to the person; and (b) the person does an act or omits to do an act; and (c) the act or omission breaches a condition of the inclusion of the biological in the Register; and (d) the act or omission has resulted in, will result in, or is likely to result in, harm or injury to any person." ;
    cml:conclusionText "(Penalty: Imprisonment for 5 years or 4,000 penalty units, or both.)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


