    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to comply with notice requirement." ;
    cml:premiseText "(7) A person commits an offence if: (a) the Secretary gives a notice to the person under subsection (2); and (b) the notice specifies a particular requirement mentioned in subsection (3); and (c) the person fails to comply with that requirement." ;
    cml:conclusionText "Penalty: Imprisonment for 12 months or 1,000 penalty units, or both." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

