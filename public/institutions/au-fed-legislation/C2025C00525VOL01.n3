    cml:modality cml:Deontic ;
    cml:operator "has" ;
    cml:logicSummary "A jury may acquit a person of an offence against this subsection and may convict the person of an offence against subsection (4) instead." ;
    cml:premiseText "A jury may acquit a person of an offence against this subsection and may convict the person of an offence against subsection (4) instead: see section 53A." ;
    cml:conclusionText "The court has discretion to acquit or convict a person of an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


