concept:therapeutic-goods-act-1989-sec-32ef-ss-1 a cml:Concept ;
    skos:prefLabel "32EF(1) Criminal offences for breach of condition"@en ;
    cml:realizedBy doc:sec-32ef-ss-1 ;
    cml:integrityHash "df2dbde40d25ef264b7fa56ea092c432ad1a6c234511ddfb65ab4be89d644e25" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-32ef ;
    skos:note "Breach of condition results in harm or injury to any person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
