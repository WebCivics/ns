    cml:operator "has" ;
    cml:logicSummary "Licence is a necessary condition for committing an offence." ;
    cml:premiseText "The person holds a licence." ;
    cml:conclusionText "The person commits an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
