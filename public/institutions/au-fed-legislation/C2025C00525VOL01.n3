concept:therapeutic-goods-act-1989-sec-13-ss-3 a cml:Concept ;
    skos:prefLabel "13(3) Special provisions relating to Ministerial standards and default"@en ;
    cml:realizedBy doc:sec-13-ss-3 ;
    cml:integrityHash "8fd75bf8793b773bc7f8f17d29d5f63613e01cdae4ebd564216332a966d4c24e" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-13 ;
    skos:note "If two default standards apply to different parts of a class of therapeutic goods, the more restrictive standard applies." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.76" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-13-ss-3-norm .
concept:therapeutic-goods-act-1989-sec-13-ss-3-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:therapeutic-goods-act-1989-sec-13-ss-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:therapeutic-goods-act-1989-sec-13-ss-3 cml:asserts concept:therapeutic-goods-act-1989-sec-13-ss-3-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-13-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If A implies B and C, then if A, B." ;
    cml:premiseText "(a) a default standard applies to a class of therapeutic goods; (b) another default standard applies to only some of the therapeutic goods within that class; (c) those standards are inconsistent;" ;
    cml:conclusionText "(3) If: (a) a default standard applies to a class of therapeutic goods; and (b) another default standard applies to only some of the therapeutic goods within that class; and (c) those standards are inconsistent; then the standard referred to in paragraph (a) does not apply in relation to the goods referred to in paragraph (b)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-13-ss-3 cml:asserts concept:therapeutic-goods-act-1989-sec-13-ss-3-logic-descriptionlogic-2 .
