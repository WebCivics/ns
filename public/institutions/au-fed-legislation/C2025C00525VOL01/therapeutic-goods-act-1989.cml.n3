doc:sec-15-ss-6 a cof:Section ;
    cof:title "15(6) Criminal offences relating to breaching a condition of a consent" ;
    values:kind "subsection" ;
    values:originalText "(6) A person commits an offence if: (a) the person does an act or omits to do an act; and (b) the act or omission breaches a condition of a consent. Penalty: 100 penalty units." ;
    cof:pageNumber "86"^^xsd:integer .

