concept:therapeutic-goods-act-1989-sec-32b a cml:Concept ;
    skos:prefLabel "32B What this Division is about"@en ;
    cml:realizedBy doc:sec-32b ;
    values:originalText "This Division contains criminal offences and civil penalties relating to the import, export, manufacture, supply and use of biologicals." ;
