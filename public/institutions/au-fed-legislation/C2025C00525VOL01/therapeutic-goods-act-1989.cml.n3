concept:therapeutic-goods-act-1989-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "This Act commences on the day after the day on which a House of the Parliament approves regulations made under this Act in the same form as approved by the other House, provided that: (a) not more than 90 days have elapsed; and (b) the places of Senators have not become vacant under section 13 of the Constitution; and (c) a dissolution or expiration of the House of Representatives has not occurred; between the approval of one House and the approval of the other House." ;
    skos:definition "This Act commences on the day after the day on which a House of the Parliament approves regulations made under this Act in the same form as approved by the other House, provided that: (a) not more than 90 days have elapsed; and (b) the places of Senators have not become vacant under section 13 of the Constitution; and (c) a dissolution or expiration of the House of Representatives has not occurred; between the approval of one House and the approval of the other House."@en ;
    cml:integrityHash "16b31689a5796009e0114137dc64e2f5d5ac545196ee77f04ceb4306cc95c3b1" ;
    cof:pageNumber "17"^^xsd:integer ;
