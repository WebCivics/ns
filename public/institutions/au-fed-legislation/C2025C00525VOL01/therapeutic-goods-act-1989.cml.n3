concept:therapeutic-goods-act-1989-sec-21a cml:asserts concept:therapeutic-goods-act-1989-sec-21a-logic-deontic-4 .
concept:therapeutic-goods-act-1989-sec-21a-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "The use of the medicine has resulted in, will result in, or is likely to result in harm or injury." ;
