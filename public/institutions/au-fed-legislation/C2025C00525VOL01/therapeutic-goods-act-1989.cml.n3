concept:therapeutic-goods-act-1989-sec-29aa-ss-2 cml:asserts concept:therapeutic-goods-act-1989-sec-29aa-ss-2-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-29aa-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits failing to notify adverse effects of goods." ;
    cml:premiseText "The person under this Act must provide information about adverse effects." ;
    cml:conclusionText "Failing to do so is a civil penalty." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-29aa-ss-2 a cof:Section ;
    cof:title "29AA(2) Civil penalty for failing to notify adverse effects etc. of goods" ;
    values:kind "subsection" ;
    values:originalText "(2) The information with which subsection (1) is concerned is information of the following kinds: (a) information that contradicts information already given by the person under this Act; (b) information that indicates that the use of the goods in accordance with the recommendations for their use may have an unintended harmful effect; (c) information that indicates that the goods, when used in accordance with the recommendations for their use, may not be as effective as the application for registration or listing of the goods or information already given by the person under this Act suggests; (d) information that indicates that the quality, safety or efficacy of the goods is unacceptable." ;
    cof:pageNumber "207"^^xsd:integer .

