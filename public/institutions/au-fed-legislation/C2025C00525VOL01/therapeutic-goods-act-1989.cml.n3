doc:sec-32cj-ss-3 a cof:Section ;
    cof:title "32CJ(3) Criminal offences and civil penalty for biologicals not" ;
    values:kind "subsection" ;
    values:originalText "(3) The notice may specify one or more of the following requirements: (a) the steps to be taken to recall the biologicals; (b) the manner in which the steps are to be taken; (c) a reasonable period within which the steps are to be taken." ;
    cof:pageNumber "294"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-32cj-ss-4 a cml:Concept ;
    skos:prefLabel "32CJ(4) Criminal offences and civil penalty for biologicals not"@en ;
    cml:realizedBy doc:sec-32cj-ss-4 ;
    values:originalText "(4) The Secretary must, as soon as practicable after giving the notice, cause particulars of it to be published in the Gazette or on the Department’s website. Notice is not a legislative instrument" ;
    skos:definition "(4) The Secretary must, as soon as practicable after giving the notice, cause particulars of it to be published in the Gazette or on the Department’s website. Notice is not a legislative instrument"@en ;
