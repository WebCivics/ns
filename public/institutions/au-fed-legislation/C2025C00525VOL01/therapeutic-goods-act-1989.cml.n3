doc:sec-22e-ss-7 a cof:Section ;
    cof:title "22E(7) Period during which provisional determination is in force" ;
    values:kind "subsection" ;
    values:originalText "(7) As soon as practicable after making the decision, the Secretary must: (a) give the person written notice of the decision; and (b) if the Secretary refuses to extend the initial period—set out the reasons for the refusal in the notice." ;
    cof:pageNumber "134"^^xsd:integer .

