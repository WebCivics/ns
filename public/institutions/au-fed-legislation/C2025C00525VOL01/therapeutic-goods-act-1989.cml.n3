concept:therapeutic-goods-act-1989-sec-28 a cml:Concept ;
    skos:prefLabel "28 Conditions of registration or listing"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "(1) The registration or listing of therapeutic goods is subject to the conditions set out in a determination under subsection (2).  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
