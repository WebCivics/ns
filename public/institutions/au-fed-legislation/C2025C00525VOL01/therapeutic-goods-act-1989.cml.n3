doc:sec-26ad-ss-1 a cof:Section ;
    cof:title "26AD(1) Lapsing and deemed refusal of applications for listing of" ;
    values:kind "subsection" ;
    values:originalText "(1) An application for the listing of a medicine under section 26AE lapses if: (a) any part of the evaluation fee referred to in section 26AC remains unpaid at the end of 28 days after the day on which the amount became due and payable; or (b) the application contains information that is inaccurate or misleading in a material particular; or (c) information given to the Secretary by, or on behalf of, the applicant in connection with the application is inaccurate or misleading in a material particular. Deemed refusal of applications" ;
    cof:pageNumber "174"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-26ad-ss-2 a cml:Concept ;
    skos:prefLabel "26AD(2) Lapsing and deemed refusal of applications for listing of"@en ;
    cml:realizedBy doc:sec-26ad-ss-2 ;
    values:originalText "(2) If: (a) regulations made for the purposes of paragraph 63(2)(daaaa) prescribe a period within which evaluations under section 26AE in relation to the medicine must be completed; and (b) at the end of that period, the evaluation has not been completed; the applicant may give the Secretary written notice that the applicant wishes to treat the application as having been refused." ;
    skos:definition "(2) If: (a) regulations made for the purposes of paragraph 63(2)(daaaa) prescribe a period within which evaluations under section 26AE in relation to the medicine must be completed; and (b) at the end of that period, the evaluation has not been completed; the applicant may give the Secretary written notice that the applicant wishes to treat the application as having been refused."@en ;
    cml:integrityHash "1465f4763738f52663786d329b843c55880f4d2a367b5953af304d465390f57c" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-26ad ;
    cof:pageNumber "174"^^xsd:integer ;
    skos:note "Applicant may give notice to treat application as refused if evaluation not completed within prescribed period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
