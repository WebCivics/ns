concept:therapeutic-goods-act-1989-sec-9j a cml:Concept ;
    skos:prefLabel "9J Simplified outline of this Chapter"@en ;
    cml:realizedBy doc:sec-9j ;
    values:originalText "The regulations may prohibit imports into Australia, exports from Australia, the manufacture in Australia and supplies in Australia of therapeutic goods or vaping goods, or therapeutic goods or vaping goods containing a particular ingredient or component, to give effect to international agreements to which Australia is a party. There is an offence and a civil penalty for contravening such a prohibition." ;
    skos:definition "The regulations may prohibit imports into Australia, exports from Australia, the manufacture in Australia and supplies in Australia of therapeutic goods or vaping goods, or therapeutic goods or vaping goods containing a particular ingredient or component, to give effect to international agreements to which Australia is a party. There is an offence and a civil penalty for contravening such a prohibition."@en ;
    cml:integrityHash "f5d6023a0da9969ac44554361e9d3c51868f29fffc9f43a94565cfb7ecf7f812" ;
    cof:pageNumber "69"^^xsd:integer ;
    skos:note "Regulations may prohibit imports, exports, manufacture, and supplies of certain goods." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.69" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-9j-norm .
