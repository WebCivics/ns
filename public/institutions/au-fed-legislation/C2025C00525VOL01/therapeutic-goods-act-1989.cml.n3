    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Recurring trace of supplying goods that do not conform to a standard or are not fit for their intended purposes." ;
    cml:premiseText "(a) therapeutic goods of a particular kind are exempt under section 18A; and (b) a person supplies a batch of goods of that kind; and (c) the Secretary is satisfied that the goods included in that batch: ..." ;
    cml:conclusionText "...are recurring traces of supplying goods that do not conform to a standard or are not fit for their intended purposes." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-30f-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-30f-ss-1-logic-diffusion-4 .
concept:therapeutic-goods-act-1989-sec-30f-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuse" ;
    cml:logicSummary "Diffusion of the prohibition on supplying goods that do not conform to a standard or are not fit for their intended purposes." ;
    cml:premiseText "(a) therapeutic goods of a particular kind are exempt under section 18A; and (b) a person supplies a batch of goods of that kind; and (c) the Secretary is satisfied that the goods included in that batch: ..." ;
    cml:conclusionText "...diffuse to all persons." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-30f-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-30f-ss-1-logic-cogai-5 .
