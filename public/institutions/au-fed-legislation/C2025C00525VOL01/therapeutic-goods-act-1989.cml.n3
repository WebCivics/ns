doc:sec-4-ss-2 a cof:Section ;
    cof:title "4(2) Objects of Act" ;
    values:kind "subsection" ;
    values:originalText "(2) This Act is therefore not intended to apply to the exclusion of a law of a State, of the Australian Capital Territory or of the Northern Territory to the extent that the law is capable of operating concurrently with this Act." ;
    cof:pageNumber "43"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-5-2 a cml:Concept ;
    skos:prefLabel "5 Act to bind Crown"@en ;
    cml:realizedBy doc:sec-5-2 ;
    values:originalText "This Act binds the Crown in right of the Commonwealth, of each of the States, of the Australian Capital Territory and of the Northern Territory, but nothing in this Act renders the Crown  Preliminary  Chapter 1  Section 5A Therapeutic Goods Act 1989 Compilation date: 05/09/2025 liable to be prosecuted for an offence or to be subject to civil proceedings for a contravention of a civil penalty provision." ;
    skos:definition "This Act binds the Crown in right of the Commonwealth, of each of the States, of the Australian Capital Territory and of the Northern Territory, but nothing in this Act renders the Crown  Preliminary  Chapter 1  Section 5A Therapeutic Goods Act 1989 Compilation date: 05/09/2025 liable to be prosecuted for an offence or to be subject to civil proceedings for a contravention of a civil penalty provision."@en ;
    cml:integrityHash "8468cb9f88c3ac4e007082b53259900c7146fff27b7ba4143822c6f7b069a4a0" ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "The Crown is bound by this Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
