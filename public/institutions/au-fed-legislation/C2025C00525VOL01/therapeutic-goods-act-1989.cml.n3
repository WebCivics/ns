concept:therapeutic-goods-act-1989-sec-30c-ss-5 a cml:Concept ;
    skos:prefLabel "30C(5) Consultation with Gene Technology Regulator"@en ;
    cml:realizedBy doc:sec-30c-ss-5 ;
    values:originalText "(5) If an advice from the Gene Technology Regulator is in force under section 30D in relation to a class of therapeutic goods, the Secretary is not required to notify the Regulator under this section in relation to an application for listing or registration of a therapeutic good belonging to that class.  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "(5) If an advice from the Gene Technology Regulator is in force under section 30D in relation to a class of therapeutic goods, the Secretary is not required to notify the Regulator under this section in relation to an application for listing or registration of a therapeutic good belonging to that class.  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
    cml:integrityHash "5f40412a2d7255cdc752c18f3acd09164aeec6439f54ee3a019896d4338fb35a" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-30c ;
    cof:pageNumber "219"^^xsd:integer ;
    skos:note "No notification required for therapeutic goods belonging to a class with an active advice from the Gene Technology Regulator." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.219" ;
