concept:therapeutic-goods-act-1989-sec-32dg a cml:Concept ;
    skos:prefLabel "32DG Refusal to include biological in the Register"@en ;
    cml:realizedBy doc:sec-32dg ;
    values:originalText "If: (a) an application is made under section 32DD to include a biological in the Register; and (aa) the application has passed preliminary assessment; and (b) the Secretary refuses the application; the Secretary must, as soon as practicable after the refusal, give the person notice of the refusal and of the reasons for the refusal." ;
    skos:definition "If: (a) an application is made under section 32DD to include a biological in the Register; and (aa) the application has passed preliminary assessment; and (b) the Secretary refuses the application; the Secretary must, as soon as practicable after the refusal, give the person notice of the refusal and of the reasons for the refusal."@en ;
    cml:integrityHash "35d6590932023d91330c68b047f37499e2bf4593bab974bf4dbfaf5806d3373d" ;
    cof:pageNumber "328"^^xsd:integer ;
    skos:note "Secretary must provide notice after refusing application to include biological in the Register." ;
    dc:description "Notice of refusal and reasons for refusal" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
