concept:therapeutic-goods-act-1989-sec-32hf a cml:Concept ;
    skos:prefLabel "32HF Saving of other laws"@en ;
    cml:realizedBy doc:sec-32hf ;
    values:originalText "This Division is not intended to exclude or limit the operation of any other law of the Commonwealth or any law of a State or Territory.  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "This Division is not intended to exclude or limit the operation of any other law of the Commonwealth or any law of a State or Territory.  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
