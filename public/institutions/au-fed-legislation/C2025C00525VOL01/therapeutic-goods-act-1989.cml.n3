doc:sec-32cj-ss-9 a cof:Section ;
    cof:title "32CJ(9) Criminal offences and civil penalty for biologicals not" ;
    values:kind "subsection" ;
    values:originalText "(9) A person commits an offence if: (a) the Secretary gives a notice to the person under subsection (2); and (b) the notice specifies a particular requirement mentioned in subsection (3); and (c) the person fails to comply with that requirement. Penalty: 100 penalty units." ;
    cof:pageNumber "294"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-32cj-ss-10 a cml:Concept ;
    skos:prefLabel "32CJ(10) Criminal offences and civil penalty for biologicals not"@en ;
    cml:realizedBy doc:sec-32cj-ss-10 ;
    values:originalText "(10) An offence against subsection (9) is an offence of strict liability.  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
