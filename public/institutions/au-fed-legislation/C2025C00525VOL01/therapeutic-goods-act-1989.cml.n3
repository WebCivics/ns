concept:therapeutic-goods-act-1989-sec-32he a cml:Concept ;
    skos:prefLabel "32HE Powers of suspension and cancellation unaffected"@en ;
    cml:realizedBy doc:sec-32he ;
    values:originalText "Imposition of a requirement under section 32HA does not affect the Secretary’s power to suspend a biological, or cancel the entry of a biological, from the Register under this Part." ;
