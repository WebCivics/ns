    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-32dg a cof:Section ;
    cof:title "32DG Refusal to include biological in the Register" ;
    values:kind "section" ;
    values:originalText "If: (a) an application is made under section 32DD to include a biological in the Register; and (aa) the application has passed preliminary assessment; and (b) the Secretary refuses the application; the Secretary must, as soon as practicable after the refusal, give the person notice of the refusal and of the reasons for the refusal." ;
    cof:pageNumber "328"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-32dh a cml:Concept ;
    skos:prefLabel "32DH Lapsing of application"@en ;
    cml:realizedBy doc:sec-32dh ;
    values:originalText "(1) An application under section 32DD for inclusion of a biological in the Register lapses if: (a) any part of the evaluation fee payable in respect of the biological remains unpaid at the end of the period of 42 days after the day on which the part became due and payable; or (b) information given to the Secretary by, or on behalf of, the applicant in connection with the application, including information given for the purpose of a requirement under section 32JA, is false or misleading in a material particular; or (c) the applicant fails to comply with a requirement under section 32JA to give information consisting of patient data in relation to the biological. (2) In this section: patient data, in relation to a biological, means information, derived from clinical trials, relating to individuals before, during and after  Medicines and other therapeutic goods that are not medical devices  Chapter 3 Biologicals  Part 3-2A Including biologicals in the Register  Division 4 Section 32DI Therapeutic Goods Act 1989 Compilation date: 05/09/2025 the administration of the biological to those individuals, including, but not limited to, demographic, biochemical and haematological information." ;
    skos:definition "(1) An application under section 32DD for inclusion of a biological in the Register lapses if: (a) any part of the evaluation fee payable in respect of the biological remains unpaid at the end of the period of 42 days after the day on which the part became due and payable; or (b) information given to the Secretary by, or on behalf of, the applicant in connection with the application, including information given for the purpose of a requirement under section 32JA, is false or misleading in a material particular; or (c) the applicant fails to comply with a requirement under section 32JA to give information consisting of patient data in relation to the biological. (2) In this section: patient data, in relation to a biological, means information, derived from clinical trials, relating to individuals before, during and after  Medicines and other therapeutic goods that are not medical devices  Chapter 3 Biologicals  Part 3-2A Including biologicals in the Register  Division 4 Section 32DI Therapeutic Goods Act 1989 Compilation date: 05/09/2025 the administration of the biological to those individuals, including, but not limited to, demographic, biochemical and haematological information."@en ;
    cml:integrityHash "99246d20b94baafca32d8719d7c338d5fddb968bc8a1391224d3f1f695fd1142" ;
    cof:pageNumber "328"^^xsd:integer ;
    cml:hasPart concept:therapeutic-goods-act-1989-sec-32dh-ss-1 ;
    cml:hasPart concept:therapeutic-goods-act-1989-sec-32dh-ss-2 ;
