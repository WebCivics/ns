doc:sec-24b-ss-2 a cof:Section ;
    cof:title "24B(2) Payment of evaluation fee by instalments" ;
    values:kind "subsection" ;
    values:originalText "(2) Regulations made for the purposes of subsection (1) may provide that a person is not allowed to pay an evaluation fee under section 24 by instalments if any part of an instalment of: (a) that or any other evaluation fee under section 24 payable by the person; or (b) any assessment fee under section 41LA payable by the person; was unpaid immediately after the time when it became due for payment." ;
    cof:pageNumber "147"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-24b-ss-3 a cml:Concept ;
    skos:prefLabel "24B(3) Payment of evaluation fee by instalments"@en ;
    cml:realizedBy doc:sec-24b-ss-3 ;
    values:originalText "(3) Subsection (2) does not limit the generality of subsection (1)." ;
    skos:definition "(3) Subsection (2) does not limit the generality of subsection (1)."@en ;
    cml:integrityHash "839e5e1c70551a66043469b8456639715beffad0fa9e8be7a933dc8a9ed61c2b" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-24b ;
    cof:pageNumber "147"^^xsd:integer ;
    skos:note "Payment of evaluation fee by instalments is obligatory." ;
    cml:curationStatus cml:Proposed ;
