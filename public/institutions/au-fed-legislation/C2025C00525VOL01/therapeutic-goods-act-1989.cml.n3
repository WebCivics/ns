concept:therapeutic-goods-act-1989-sec-32c a cml:Concept ;
    skos:prefLabel "32C What this Division is about"@en ;
    cml:realizedBy doc:sec-32c ;
    values:originalText "There are 4 kinds of exemptions in relation to biologicals: (a) exemptions of biologicals under the regulations; and (b) exemptions of biologicals to deal with emergencies; and (c) exemptions of biologicals for special and experimental uses; and (d) exemptions of biologicals where substitutes are unavailable. Subdivision B—Exempting biologicals under the regulations" ;
    skos:definition "There are 4 kinds of exemptions in relation to biologicals: (a) exemptions of biologicals under the regulations; and (b) exemptions of biologicals to deal with emergencies; and (c) exemptions of biologicals for special and experimental uses; and (d) exemptions of biologicals where substitutes are unavailable. Subdivision B—Exempting biologicals under the regulations"@en ;
    cml:integrityHash "c38bc359a91a2207e4a55da9309d6818217b55e4c65f0ef58a706fed4adb366f" ;
    cof:pageNumber "288"^^xsd:integer ;
    skos:note "Exemptions of biologicals under regulations, emergencies, special and experimental uses, and substitutes unavailable." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.288" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-32c-norm .
