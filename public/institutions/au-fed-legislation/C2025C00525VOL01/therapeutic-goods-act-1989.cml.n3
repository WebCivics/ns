concept:therapeutic-goods-act-1989-sec-35a a cml:Concept ;
    skos:prefLabel "35A Civil penalties relating to manufacturing therapeutic goods"@en ;
    cml:realizedBy doc:sec-35a ;
    values:originalText "(1) A person contravenes this subsection if: (a) the person carries out a step in the manufacture of therapeutic goods at premises in Australia; and  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "(1) A person contravenes this subsection if: (a) the person carries out a step in the manufacture of therapeutic goods at premises in Australia; and  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
    cml:integrityHash "a6516c6e428c0e28849bb916246584c3e7cfe60c5adadb39a9dba91976623015" ;
    cof:pageNumber "383"^^xsd:integer ;
    skos:note "Carrying out steps in manufacturing therapeutic goods at Australian premises is prohibited." ;
