concept:therapeutic-goods-act-1989-sec-32g a cml:Concept ;
    skos:prefLabel "32G What this Division is about"@en ;
    cml:realizedBy doc:sec-32g ;
    values:originalText "The Secretary may cancel inclusions of biologicals in the Register in certain circumstances." ;
    skos:definition "The Secretary may cancel inclusions of biologicals in the Register in certain circumstances."@en ;
