doc:sec-32ds-ss-1 a cof:Section ;
    cof:title "32DS(1) Consultation with Gene Technology Regulator" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies to an application for inclusion of a biological in the Register if the biological is, or contains, a GM product or a genetically modified organism." ;
    cof:pageNumber "339"^^xsd:integer .

