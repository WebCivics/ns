concept:therapeutic-goods-act-1989-sec-15aa a cml:Concept ;
    skos:prefLabel "15AA Civil penalty relating to breaching a condition of a consent"@en ;
    cml:realizedBy doc:sec-15aa ;
    values:originalText "A person contravenes this section if: (a) the person does an act or omits to do an act; and (b) the act or omission breaches a condition of a consent imposed under section 15. Maximum civil penalty: (a) for an individual—3,000 penalty units; and (b) for a body corporate—30,000 penalty units." ;
    skos:definition "A person contravenes this section if: (a) the person does an act or omits to do an act; and (b) the act or omission breaches a condition of a consent imposed under section 15. Maximum civil penalty: (a) for an individual—3,000 penalty units; and (b) for a body corporate—30,000 penalty units."@en ;
    cml:integrityHash "403b5a583aea68df9f5daef94dd707ce3350b594a6a1d12ba820d54c616294d0" ;
    cof:pageNumber "87"^^xsd:integer ;
    skos:note "Breach of consent condition results in civil penalty" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.87" ;
