    values:partOf concept:therapeutic-goods-act-1989-sec-30ef ;
    cof:pageNumber "228"^^xsd:integer ;
    skos:note "Notification requirements for medicine shortages" ;
    dc:description "Specific period of shortage, approved form, and required information" ;
