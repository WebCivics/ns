concept:therapeutic-goods-act-1989-sec-14b a cml:Concept ;
    skos:prefLabel "14B Application of Customs Act 1901"@en ;
    cml:realizedBy doc:sec-14b ;
    values:originalText "Where: (a) the importation or exportation of goods is an offence under subsection 14(1), (4), (4A), (10), (13) or (13AA) or 41Q(1) or (2) or a contravention of subsection 14A(1) or (3) or 41Q(3); and (b) the Secretary notifies the Comptroller-General of Customs in writing that the Secretary wishes the Customs Act 1901 to apply to that importation or exportation; the Customs Act 1901 has effect as if the goods included in that importation or exportation were goods described as forfeited to the Crown under section 229 of that Act because they were:  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "Where: (a) the importation or exportation of goods is an offence under subsection 14(1), (4), (4A), (10), (13) or (13AA) or 41Q(1) or (2) or a contravention of subsection 14A(1) or (3) or 41Q(3); and (b) the Secretary notifies the Comptroller-General of Customs in writing that the Secretary wishes the Customs Act 1901 to apply to that importation or exportation; the Customs Act 1901 has effect as if the goods included in that importation or exportation were goods described as forfeited to the Crown under section 229 of that Act because they were:  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
    cml:integrityHash "a8105a855cdd93f0bc5d7aed54867cb9cf8f3dc37367fc417c90ed912dcb1544" ;
    cof:pageNumber "85"^^xsd:integer ;
    skos:note "Customs Act 1901 applies to importation or exportation of goods if notified by Secretary." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.85" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-14b-norm .
