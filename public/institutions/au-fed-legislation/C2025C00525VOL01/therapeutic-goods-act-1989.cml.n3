doc:sec-25aa-ss-1a a cof:Section ;
    cof:title "25AA(1A) Approved product information for medicine" ;
    values:kind "subsection" ;
    values:originalText "(1A) However, the Secretary must not approve product information in relation to therapeutic goods under subsection (1) unless the Secretary is satisfied that the product information reflects the basis on which the Secretary decided under subsection 25(3) to register the goods." ;
    cof:pageNumber "155"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-25aa-ss-1b a cml:Concept ;
    skos:prefLabel "25AA(1B) Approved product information for medicine"@en ;
    cml:realizedBy doc:sec-25aa-ss-1b ;
    values:originalText "(1B) If: (a) there is medicine included in the Register in relation to a person and there is no product information approved under this section in relation to the medicine; and (b) the medicine becomes restricted medicine; the Secretary may, by written notice given to the person, require the person to: (c) give the Secretary product information, in relation to the medicine, that is in the form approved under section 7D in relation to the medicine; and (d) give the Secretary that product information within the period specified in the notice (which must be at least 30 days after the notice is given)." ;
    skos:definition "(1B) If: (a) there is medicine included in the Register in relation to a person and there is no product information approved under this section in relation to the medicine; and (b) the medicine becomes restricted medicine; the Secretary may, by written notice given to the person, require the person to: (c) give the Secretary product information, in relation to the medicine, that is in the form approved under section 7D in relation to the medicine; and (d) give the Secretary that product information within the period specified in the notice (which must be at least 30 days after the notice is given)."@en ;
