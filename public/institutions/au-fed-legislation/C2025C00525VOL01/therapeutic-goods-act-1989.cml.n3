    cml:modality cml:AllenInterval ;
    cml:operator "Overlap" ;
    cml:logicSummary "Temporal overlap between the supply of goods and the Secretary's satisfaction that the goods included in that batch do not conform to a standard or are not fit for their intended purposes." ;
    cml:premiseText "(c) the Secretary is satisfied that the goods included in that batch: ..." ;
    cml:conclusionText "...overlap with the supply of goods." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

