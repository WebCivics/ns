concept:therapeutic-goods-act-1989-sec-32ds-ss-5 a cml:Concept ;
    skos:prefLabel "32DS(5) Consultation with Gene Technology Regulator"@en ;
    cml:realizedBy doc:sec-32ds-ss-5 ;
    values:originalText "(5) If an advice from the Gene Technology Regulator is in force under section 32DT in relation to a class of biologicals, the Secretary is not required to notify the Gene Technology Regulator under this section in relation to an application for inclusion in the Register of a biological belonging to that class." ;
    skos:definition "(5) If an advice from the Gene Technology Regulator is in force under section 32DT in relation to a class of biologicals, the Secretary is not required to notify the Gene Technology Regulator under this section in relation to an application for inclusion in the Register of a biological belonging to that class."@en ;
    cml:integrityHash "9ab5b6d3d6a1a80352b64b13ee57680a39735774676b084e0b3e9ee3cdde29a5" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-32ds ;
    cof:pageNumber "339"^^xsd:integer ;
    skos:note "No notification required for applications within a class of biologicals subject to Gene Technology Regulator advice." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
