concept:therapeutic-goods-act-1989-sec-24c a cml:Concept ;
    skos:prefLabel "24C Recovery of evaluation fee"@en ;
    cml:realizedBy doc:sec-24c ;
    values:originalText "An evaluation fee under section 24 may be recovered by the Commonwealth as a debt due to the Commonwealth.  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "An evaluation fee under section 24 may be recovered by the Commonwealth as a debt due to the Commonwealth.  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
    cml:integrityHash "fba16f99658a71db745e501a7b23381ce395fe98522fff70bf077e79f6030772" ;
    cof:pageNumber "147"^^xsd:integer ;
    skos:note "Recovery of evaluation fee is an obligation for the Commonwealth." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.147" ;
