    cof:pageNumber "359"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-32h a cml:Concept ;
    skos:prefLabel "32H What this Division is about"@en ;
    cml:realizedBy doc:sec-32h ;
    values:originalText "The Secretary may require a person to recall biologicals, or to inform the public about biologicals, that do not comply with requirements or cannot lawfully be supplied. There are criminal offences and a civil penalty for breaching such a requirement." ;
    skos:definition "The Secretary may require a person to recall biologicals, or to inform the public about biologicals, that do not comply with requirements or cannot lawfully be supplied. There are criminal offences and a civil penalty for breaching such a requirement."@en ;
    cml:integrityHash "0bc42af7187106f0ddfe272cc39ce589044d2d16a8819adcbbfad95bd7216088" ;
    cof:pageNumber "360"^^xsd:integer ;
    skos:note "The Secretary may require a person to recall biologicals or inform the public about non-compliant biologicals." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
