concept:therapeutic-goods-act-1989-sec-32je a cml:Concept ;
    skos:prefLabel "32JE Secretary may require information etc. about biologicals"@en ;
    cml:realizedBy doc:sec-32je ;
    values:originalText "exempt under the regulations (1) If a person is exempt under subsection 32CA(1) in relation to a biological, the Secretary may give the person a written notice requiring the person to give to the Secretary specified information,  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "exempt under the regulations (1) If a person is exempt under subsection 32CA(1) in relation to a biological, the Secretary may give the person a written notice requiring the person to give to the Secretary specified information,  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
    cml:integrityHash "9c4bcc3c6143357646c6d62fe8052ce1e7559b8b8f0e9e01db059e337b02690e" ;
    cof:pageNumber "371"^^xsd:integer ;
    skos:note "Secretary may require information about biologicals from exempt persons." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.371" ;
