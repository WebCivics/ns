doc:sec-32du a cof:Section ;
    cof:title "32DU Secretary to take advice into account" ;
    values:kind "section" ;
    values:originalText "If the Secretary receives advice from the Gene Technology Regulator: (a) in response to a notice under section 32DS within the period specified in the notice; or (b) under section 32DT; the Secretary must: (c) ensure that the advice is taken into account in making a decision on the application to which the notice relates, or on an application to which the advice under section 32DT relates, as the case requires; and (d) inform the Gene Technology Regulator of the decision on the application.  Medicines and other therapeutic goods that are not medical devices  Chapter 3 Biologicals  Part 3-2A Conditions  Division 5 Section 32E Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    cof:pageNumber "340"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-32e a cml:Concept ;
    skos:prefLabel "32E What this Division is about"@en ;
    cml:realizedBy doc:sec-32e ;
    values:originalText "Inclusions of biologicals in the Register are subject to certain automatic conditions. The Minister and the Secretary may impose further conditions." ;
    skos:definition "Inclusions of biologicals in the Register are subject to certain automatic conditions. The Minister and the Secretary may impose further conditions."@en ;
    cml:integrityHash "55c7893eefc5e4d3c641701e1c1f27f33d7a6e5f1d2c7bd23186a7663cda6f9f" ;
    cof:pageNumber "341"^^xsd:integer ;
    skos:note "Exemptions from automatic conditions for inclusions of biologicals in the Register" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
