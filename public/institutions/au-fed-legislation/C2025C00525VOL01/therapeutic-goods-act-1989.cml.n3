concept:therapeutic-goods-act-1989-sec-32jh-ss-2 a cml:Concept ;
    skos:prefLabel "32JH(2) Secretary may require information etc. about biologicals"@en ;
    cml:realizedBy doc:sec-32jh-ss-2 ;
    values:originalText "(2) A person commits an offence if: (a) the person is given a notice under section 32JE, 32JF, 32JG or 32JH; and (b) the person gives information or produces a document in compliance or purported compliance with the notice; and (c) the information or document is false or misleading in a material particular. Penalty: Imprisonment for 12 months or 1,000 penalty units, or both. Note: For the liability of an executive officer of a body corporate, see sections 54B and 54BA." ;
    skos:definition "(2) A person commits an offence if: (a) the person is given a notice under section 32JE, 32JF, 32JG or 32JH; and (b) the person gives information or produces a document in compliance or purported compliance with the notice; and (c) the information or document is false or misleading in a material particular. Penalty: Imprisonment for 12 months or 1,000 penalty units, or both. Note: For the liability of an executive officer of a body corporate, see sections 54B and 54BA."@en ;
    cml:integrityHash "a2c8711943ee9f6cacad211b7224d6047adaafeab3d1df75a58f105cb84af182" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-32jh ;
    cof:pageNumber "376"^^xsd:integer ;
    skos:note "Giving false information in response to a notice is an offence. Must provide information or documents within a specified period and in the form specified by the notice." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
