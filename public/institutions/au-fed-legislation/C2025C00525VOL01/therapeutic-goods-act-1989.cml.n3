concept:therapeutic-goods-act-1989-sec-14-ss-5a a cml:Concept ;
    skos:prefLabel "14(5A) Criminal offences for importing, supplying or exporting goods"@en ;
    cml:realizedBy doc:sec-14-ss-5a ;
    values:originalText "(5A) Subsection (1), (4) or (4A) does not apply if: (a) the therapeutic goods are a biological; and (b) the person imports the biological after the circumstances prescribed by the regulations for the purposes of this paragraph have occurred. Note: A defendant bears an evidential burden in relation to the matter in subsection (5A): see subsection 13.3(3) of the Criminal Code. Offences relating to supplying goods for use in Australia" ;
    skos:definition "(5A) Subsection (1), (4) or (4A) does not apply if: (a) the therapeutic goods are a biological; and (b) the person imports the biological after the circumstances prescribed by the regulations for the purposes of this paragraph have occurred. Note: A defendant bears an evidential burden in relation to the matter in subsection (5A): see subsection 13.3(3) of the Criminal Code. Offences relating to supplying goods for use in Australia"@en ;
    cml:integrityHash "e24535683a70abf1ec97027ecfd1e44016444a0353f5be48e6d9c48c107ba62d" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-14 ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Exemptions from subsection (1), (4) or (4A)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
