concept:therapeutic-goods-act-1989-sec-30b a cml:Concept ;
    skos:prefLabel "30B Publication of cancellation of registration or listing"@en ;
    cml:realizedBy doc:sec-30b ;
    values:originalText "If the Secretary cancels the registration or listing of therapeutic goods under section 30, the Secretary must, as soon as practicable after the cancellation, cause to be published in the Gazette, or on the Department’s website, a notice setting out particulars of the cancellation." ;
    skos:definition "If the Secretary cancels the registration or listing of therapeutic goods under section 30, the Secretary must, as soon as practicable after the cancellation, cause to be published in the Gazette, or on the Department’s website, a notice setting out particulars of the cancellation."@en ;
    cml:integrityHash "da3c41bf8618cf831752cc7369f69e9a7718aa59c156fc5d028d8208542e4530" ;
    cof:pageNumber "219"^^xsd:integer ;
    skos:note "Secretary must publish notice after cancellation of registration or listing." ;
    dc:description "Notice setting out particulars of the cancellation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.219" ;
