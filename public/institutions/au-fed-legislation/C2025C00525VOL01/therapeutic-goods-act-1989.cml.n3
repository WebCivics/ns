concept:therapeutic-goods-act-1989-sec-9e a cml:Concept ;
    skos:prefLabel "9E Publication of list of goods on Register"@en ;
    cml:realizedBy doc:sec-9e ;
    values:originalText "The Secretary must, at least once every 12 months, publish a list of the therapeutic goods included in the Register." ;
    skos:definition "The Secretary must, at least once every 12 months, publish a list of the therapeutic goods included in the Register."@en ;
