concept:therapeutic-goods-act-1989-sec-3-ss-8 a cml:Concept ;
    skos:prefLabel "3(8) Interpretation"@en ;
    cml:realizedBy doc:sec-3-ss-8 ;
    values:originalText "(8) To avoid doubt: (a) a reference in this Act to therapeutic goods that are registered includes a reference to a medicine that is provisionally registered; and (b) a reference in this Act to the registration of therapeutic goods includes a reference to the provisional registration of a medicine. Note: Subsection 29(2) deals with the provisional registration of a medicine." ;
    skos:definition "(8) To avoid doubt: (a) a reference in this Act to therapeutic goods that are registered includes a reference to a medicine that is provisionally registered; and (b) a reference in this Act to the registration of therapeutic goods includes a reference to the provisional registration of a medicine. Note: Subsection 29(2) deals with the provisional registration of a medicine."@en ;
    cml:integrityHash "98247abf26c246b884444c5b0e286260062ae4cc252a403f190c49d8b71a0650" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-3 ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Clarifies interpretation of registered therapeutic goods and provisional registration." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.17" ;
