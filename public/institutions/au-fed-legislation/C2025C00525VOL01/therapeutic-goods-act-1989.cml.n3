concept:therapeutic-goods-act-1989-sec-22b a cml:Concept ;
    skos:prefLabel "22B Civil penalty for false statements in applications for registration"@en ;
    cml:realizedBy doc:sec-22b ;
    values:originalText "A person contravenes this section if the person in or in connection with an application for registration of therapeutic goods, makes a statement that is false or misleading in a material particular. Maximum civil penalty: (a) for an individual—5,000 penalty units; and (b) for a body corporate—50,000 penalty units.  Medicines and other therapeutic goods that are not medical devices  Chapter 3 Registration and listing of therapeutic goods  Part 3-2 Provisional determinations for medicine  Division 1A Section 22C Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "A person contravenes this section if the person in or in connection with an application for registration of therapeutic goods, makes a statement that is false or misleading in a material particular. Maximum civil penalty: (a) for an individual—5,000 penalty units; and (b) for a body corporate—50,000 penalty units.  Medicines and other therapeutic goods that are not medical devices  Chapter 3 Registration and listing of therapeutic goods  Part 3-2 Provisional determinations for medicine  Division 1A Section 22C Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
    cml:integrityHash "1a762350399cc1c40c28a02315063a9ed2fe57a68b0824e2c1261159b1befd30" ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "False statements in applications for registration are prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
