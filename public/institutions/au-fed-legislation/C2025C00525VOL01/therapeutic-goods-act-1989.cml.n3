    cml:modality cml:Deontic ;
    cml:operator "right" ;
    cml:logicSummary "Right to receive notice from Secretary." ;
    cml:premiseText "(9) A person commits an offence if: (a) the Secretary gives a notice to the person under subsection (2); and (b) the notice specifies a particular requirement mentioned in subsection (3); and (c) the person fails to comply with that requirement." ;
    cml:conclusionText "The person has a right to receive notice from the Secretary." ;
