concept:therapeutic-goods-act-1989-sec-7-ss-2 a cml:Concept ;
    skos:prefLabel "7(2) Declaration that goods are/are not therapeutic goods"@en ;
    cml:realizedBy doc:sec-7-ss-2 ;
    values:originalText "(2) (excluded goods)): (a) are therapeutic goods; or (b) when used, advertised, or presented for supply in a particular way, are therapeutic goods." ;
    skos:definition "(2) (excluded goods)): (a) are therapeutic goods; or (b) when used, advertised, or presented for supply in a particular way, are therapeutic goods."@en ;
