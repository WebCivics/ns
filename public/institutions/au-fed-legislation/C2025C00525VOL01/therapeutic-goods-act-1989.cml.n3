concept:therapeutic-goods-act-1989-sec-32gf a cml:Concept ;
    skos:prefLabel "32GF Date of effect of cancellation of entries from Register"@en ;
    cml:realizedBy doc:sec-32gf ;
    values:originalText "If the Secretary cancels an entry of a biological from the Register, the cancellation has effect on the day on which the notice of cancellation is given to the person in relation to whom the biological was included in the Register.  Chapter 3  Medicines and other therapeutic goods that are not medical devices" ;
    skos:definition "If the Secretary cancels an entry of a biological from the Register, the cancellation has effect on the day on which the notice of cancellation is given to the person in relation to whom the biological was included in the Register.  Chapter 3  Medicines and other therapeutic goods that are not medical devices"@en ;
    cml:integrityHash "f3c1b824fa0e5215268d6e9df4c4ec3fcfb803aac1b834e88b7fc9d2d1c5134d" ;
    cof:pageNumber "359"^^xsd:integer ;
    skos:note "Date of effect of cancellation of entries from Register" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
