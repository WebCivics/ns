concept:therapeutic-goods-act-1989-sec-9m a cml:Concept ;
    skos:prefLabel "9M Application of Customs Act 1901"@en ;
    cml:realizedBy doc:sec-9m ;
    values:originalText "If: (a) the importation or exportation of goods is an offence under subsection 9L(1) or a contravention of subsection 9L(2); and (b) the Secretary notifies the Comptroller-General of Customs in writing that the Secretary wishes the Customs Act 1901 to apply to that importation or exportation; the Customs Act 1901 has effect as if the goods included in that importation or exportation were goods described as forfeited to the Crown under section 229 of that Act because they were: (c) prohibited imports within the meaning of that Act; or (d) prohibited exports within the meaning of that Act; as the case requires." ;
    skos:definition "If: (a) the importation or exportation of goods is an offence under subsection 9L(1) or a contravention of subsection 9L(2); and (b) the Secretary notifies the Comptroller-General of Customs in writing that the Secretary wishes the Customs Act 1901 to apply to that importation or exportation; the Customs Act 1901 has effect as if the goods included in that importation or exportation were goods described as forfeited to the Crown under section 229 of that Act because they were: (c) prohibited imports within the meaning of that Act; or (d) prohibited exports within the meaning of that Act; as the case requires."@en ;
    cml:integrityHash "973b96a65206bf65b02d38f9d6ac5cb0952713650c14bc704280eb1391e3b022" ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Customs Act 1901 applies to prohibited imports or exports if notified by Secretary." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.73" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-9m-norm .
