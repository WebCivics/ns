concept:therapeutic-goods-act-1989-sec-26bb-ss-2a a cml:Concept ;
    skos:prefLabel "26BB(2A) Permissible ingredients"@en ;
    cml:realizedBy doc:sec-26bb-ss-2a ;
    values:originalText "(2A) The requirements referred to in paragraph (1)(b) may relate to a particular ingredient being contained in particular medicine only in the circumstances specified in the determination in relation to the ingredient." ;
