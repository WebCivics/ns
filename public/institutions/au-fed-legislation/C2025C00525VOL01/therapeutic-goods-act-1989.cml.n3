doc:sec-24e-ss-1 a cof:Section ;
    cof:title "24E(1) Deemed refusal of application" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies in the case of an application under section 23 in relation to therapeutic goods for the evaluation of which a period is prescribed under paragraph 63(2)(da)." ;
    cof:pageNumber "148"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-24e-ss-2 a cml:Concept ;
    skos:prefLabel "24E(2) Deemed refusal of application"@en ;
    cml:realizedBy doc:sec-24e-ss-2 ;
    values:originalText "(2) If, at the end of the period referred to in subsection (1), the evaluation has not been completed, the applicant may give the Secretary written notice that the applicant wishes to treat the application as having been refused." ;
    skos:definition "(2) If, at the end of the period referred to in subsection (1), the evaluation has not been completed, the applicant may give the Secretary written notice that the applicant wishes to treat the application as having been refused."@en ;
