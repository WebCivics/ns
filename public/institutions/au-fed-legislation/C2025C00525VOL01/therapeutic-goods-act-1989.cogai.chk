therapeutic-goods-act-1989-sec-35b-ss-1-logic-1034 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-35b-ss-1;
  logic: Deontic;
  operator: has;
  summary: Breach of the licence's condition is a necessary condition for committing an offence.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: The act or omission has resulted in, will result in, or is likely to result in harm or injury to any person.;
  @action: The person commits an offence.;
}

therapeutic-goods-act-1989-sec-35b-ss-1-logic-1035 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-35b-ss-1;
  logic: Deontic;
  operator: has;
  summary: Imprisonment for 5 years or 4,000 penalty units is a possible consequence of committing an offence.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: A person commits an offence if: (a) the person holds a licence; and (b) the person does an act or omits to do an act; and (c) the act or omission breaches a condition of the licence; and (d) the act or omission has resulted in, will result in, or is likely to result in harm or injury to any person.;
  @action: The penalty for committing an offence is imprisonment for 5 years or 4,000 penalty units.;
}

therapeutic-goods-act-1989-sec-35b-ss-1-logic-1036 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-35b-ss-1;
  logic: Deontic;
  operator: has;
  summary: A jury may acquit a person of an offence against this subsection and may convict the person of an offence against subsection (4) instead.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: A jury may acquit a person of an offence against this subsection and may convict the person of an offence against subsection (4) instead: see section 53A.;
  @action: The court has discretion to acquit or convict a person of an offence.;
}

