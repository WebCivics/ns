    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9n",
      "@type": "cml:Concept",
      "skos:prefLabel": "9N Constitutional basis",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
