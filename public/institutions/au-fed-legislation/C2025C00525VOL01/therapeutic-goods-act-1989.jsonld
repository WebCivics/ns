      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of application lapse due to inaccurate or misleading information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(9) The Secretary may, by legislative instrument, determine a form of\ninformation for the purposes of subparagraph (3)(e)(ii).",
      "cml:conclusionText": "If an application made under subsection 26BD(1) has passed preliminary assessment, the application lapses if:\n(a) the application contains information that is inaccurate or misleading in a material particular; or\n(b) information given to the Secretary by, or on behalf of, the applicant in connection with the application is inaccurate or misleading in a material particular; or\n(c) the evaluation fee prescribed for the purposes of paragraph 26BE(3)(b) has not been paid before the end of the period worked out in accordance with the regulations."
    },
