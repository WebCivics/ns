      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.296",
      "values:originalText": "(2) Subsection (1) does not apply if the biological is included in the\nRegister, the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt under\nsubsection 32CA(2).\nApplication for approval",
      "skos:definition": "(2) Subsection (1) does not apply if the biological is included in the\nRegister, the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt under\nsubsection 32CA(2).\nApplication for approval",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32ck"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ck-ss-2-norm"
        }
      ],
      "cml:integrityHash": "ed431cd6aa277fa4e94694fa1abcffc211c5f1b94285e2ddf0bceafc4cf26552",
      "skos:note": "Exemption from subsection 32CA(1) for biologicals in the Register or under subsection 32CA(2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ck-ss-2",
      "@type": "cof:Section",
      "cof:title": "32CK(2) Approvals for importing, exporting or supplying a biological",
      "values:kind": "subsection",
      "cof:pageNumber": 296,
      "values:originalText": "(2) Subsection (1) does not apply if the biological is included in the\nRegister, the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt under\nsubsection 32CA(2).\nApplication for approval"
    },
