      "cml:integrityHash": "900dedc4f8227348093cd3474005c7e84ecee1256e67a428392d5e0d18a61db9",
      "skos:note": "Payment of evaluation fee by instalments is not allowed if any part of an instalment was unpaid immediately after it became due for payment."
