      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30c-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "exemption",
      "cml:logicSummary": "Exemption from notification",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Advice from the Gene Technology Regulator is in force",
      "cml:conclusionText": "No notification required"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30c-ss-5-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "subclassOf",
      "cml:logicSummary": "Therapeutic goods belonging to a class with an active advice",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Class of therapeutic goods",
      "cml:conclusionText": "Subclass of goods subject to exemption"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30d",
      "@type": "cml:Concept",
      "skos:prefLabel": "30D Secretary may seek advice about classes of GM products or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.220",
      "values:originalText": "genetically modified organisms\n(1) The Secretary may request advice from the Gene Technology\nRegulator in relation to:\n(a) therapeutic goods that consist of, or that contain, a GM\nproduct belonging to a class of GM products specified in the\nrequest; or\n(b) therapeutic goods that consist of, or that contain, a\ngenetically modified organism belonging to a class of\ngenetically modified organisms specified in the request.\n(2) A request for advice under subsection (1) must specify the matters\nto which the advice is to relate.\n(3) If the Secretary requests advice from the Gene Technology\nRegulator under subsection (1), the Gene Technology Regulator\nmay provide written advice in relation to the matters specified in\nthe request.\n(4) If the Gene Technology Regulator gives advice to the Secretary\nunder subsection (3), the advice remains in force until it is\nwithdrawn by the Gene Technology Regulator by written notice\ngiven to the Secretary.",
      "skos:definition": "genetically modified organisms\n(1) The Secretary may request advice from the Gene Technology\nRegulator in relation to:\n(a) therapeutic goods that consist of, or that contain, a GM\nproduct belonging to a class of GM products specified in the\nrequest; or\n(b) therapeutic goods that consist of, or that contain, a\ngenetically modified organism belonging to a class of\ngenetically modified organisms specified in the request.\n(2) A request for advice under subsection (1) must specify the matters\nto which the advice is to relate.\n(3) If the Secretary requests advice from the Gene Technology\nRegulator under subsection (1), the Gene Technology Regulator\nmay provide written advice in relation to the matters specified in\nthe request.\n(4) If the Gene Technology Regulator gives advice to the Secretary\nunder subsection (3), the advice remains in force until it is\nwithdrawn by the Gene Technology Regulator by written notice\ngiven to the Secretary.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30d-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30d-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30d-ss-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30d-ss-4"
        }
      ],
      "cml:integrityHash": "07160fce713519494f31c57c608d3f2ff3f06e3142cabdc1488cb0a3b72e5d52"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30d",
      "@type": "cof:Section",
      "cof:title": "30D Secretary may seek advice about classes of GM products or",
      "values:kind": "section",
      "cof:pageNumber": 220,
      "values:originalText": "genetically modified organisms\n(1) The Secretary may request advice from the Gene Technology\nRegulator in relation to:\n(a) therapeutic goods that consist of, or that contain, a GM\nproduct belonging to a class of GM products specified in the\nrequest; or\n(b) therapeutic goods that consist of, or that contain, a\ngenetically modified organism belonging to a class of\ngenetically modified organisms specified in the request.\n(2) A request for advice under subsection (1) must specify the matters\nto which the advice is to relate.\n(3) If the Secretary requests advice from the Gene Technology\nRegulator under subsection (1), the Gene Technology Regulator\nmay provide written advice in relation to the matters specified in\nthe request.\n(4) If the Gene Technology Regulator gives advice to the Secretary\nunder subsection (3), the advice remains in force until it is\nwithdrawn by the Gene Technology Regulator by written notice\ngiven to the Secretary."
    },
