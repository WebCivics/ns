    {
      "@id": "concept:therapeutic-goods-act-1989-sec-13-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "13(3) Special provisions relating to Ministerial standards and default",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-13-ss-3"
      },
      "cml:curationStatus": {
