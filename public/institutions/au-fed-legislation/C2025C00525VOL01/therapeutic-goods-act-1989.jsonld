      "skos:note": "Application must be made in accordance with a form approved by the Secretary and accompanied by a statement certifying matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32da-ss-2",
      "@type": "cof:Section",
