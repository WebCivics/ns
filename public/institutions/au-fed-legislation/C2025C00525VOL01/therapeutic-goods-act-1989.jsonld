    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "32DS(5) Consultation with Gene Technology Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ds-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
