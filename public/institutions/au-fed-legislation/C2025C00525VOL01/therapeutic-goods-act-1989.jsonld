    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "9D(6) Variation of entries in Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
