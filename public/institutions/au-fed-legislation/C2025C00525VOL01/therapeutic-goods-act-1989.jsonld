    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ds-ss-1",
      "@type": "cof:Section",
      "cof:title": "32DS(1) Consultation with Gene Technology Regulator",
      "values:kind": "subsection",
      "cof:pageNumber": 339,
      "values:originalText": "(1) This section applies to an application for inclusion of a biological\nin the Register if the biological is, or contains, a GM product or a\ngenetically modified organism."
    },
