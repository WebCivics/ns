      },
      "cml:operator": "During",
      "cml:logicSummary": "The assessment must occur during a specific time period.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
