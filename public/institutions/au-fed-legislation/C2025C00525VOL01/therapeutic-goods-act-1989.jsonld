    {
      "@id": "concept:therapeutic-goods-act-1989-sec-34-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "34(3) Exempt goods and exempt persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-34-ss-3"
      },
      "cml:curationStatus": {
