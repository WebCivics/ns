      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.339",
      "values:originalText": "(5) If an advice from the Gene Technology Regulator is in force under\nsection 32DT in relation to a class of biologicals, the Secretary is\nnot required to notify the Gene Technology Regulator under this\nsection in relation to an application for inclusion in the Register of\na biological belonging to that class.",
      "skos:definition": "(5) If an advice from the Gene Technology Regulator is in force under\nsection 32DT in relation to a class of biologicals, the Secretary is\nnot required to notify the Gene Technology Regulator under this\nsection in relation to an application for inclusion in the Register of\na biological belonging to that class.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32ds"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-logic-alleninterval-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-logic-ltl-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-logic-diffusion-5"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-5-logic-cogai-6"
        }
      ],
      "cml:integrityHash": "9ab5b6d3d6a1a80352b64b13ee57680a39735774676b084e0b3e9ee3cdde29a5",
      "skos:note": "No notification required for applications within a class of biologicals subject to Gene Technology Regulator advice."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ds-ss-5",
      "@type": "cof:Section",
      "cof:title": "32DS(5) Consultation with Gene Technology Regulator",
      "values:kind": "subsection",
      "cof:pageNumber": 339,
      "values:originalText": "(5) If an advice from the Gene Technology Regulator is in force under\nsection 32DT in relation to a class of biologicals, the Secretary is\nnot required to notify the Gene Technology Regulator under this\nsection in relation to an application for inclusion in the Register of\na biological belonging to that class."
    },
