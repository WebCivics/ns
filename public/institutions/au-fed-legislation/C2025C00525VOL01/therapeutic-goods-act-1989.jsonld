    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30a",
      "@type": "cml:Concept",
      "skos:prefLabel": "30A Revocation of cancellation of registration or listing upon",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.218",
      "values:originalText": "request\n(1) If:\n(a) the Secretary cancels the registration or listing of therapeutic\ngoods because of the request of a person made under\nparagraph 30(1)(c); and\n(b) before the end of the period of 90 days beginning on the day\nthe goods ceased to be registered or listed, the person\nrequests, in writing, the Secretary to revoke the cancellation;\nand\n(c) the request is accompanied by the prescribed application fee;\nthe Secretary may, by notice in writing given to the person, revoke\nthe cancellation.\n(2) If the cancellation is revoked, the cancellation is taken never to\nhave occurred.",
      "skos:definition": "request\n(1) If:\n(a) the Secretary cancels the registration or listing of therapeutic\ngoods because of the request of a person made under\nparagraph 30(1)(c); and\n(b) before the end of the period of 90 days beginning on the day\nthe goods ceased to be registered or listed, the person\nrequests, in writing, the Secretary to revoke the cancellation;\nand\n(c) the request is accompanied by the prescribed application fee;\nthe Secretary may, by notice in writing given to the person, revoke\nthe cancellation.\n(2) If the cancellation is revoked, the cancellation is taken never to\nhave occurred.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30a-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30a-ss-2"
        }
      ],
      "cml:integrityHash": "1f58b9145b24d108d7ac38887338b3ea3229833b9c1e418250343f907bfd1047"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30a",
      "@type": "cof:Section",
      "cof:title": "30A Revocation of cancellation of registration or listing upon",
      "values:kind": "section",
      "cof:pageNumber": 218,
      "values:originalText": "request\n(1) If:\n(a) the Secretary cancels the registration or listing of therapeutic\ngoods because of the request of a person made under\nparagraph 30(1)(c); and\n(b) before the end of the period of 90 days beginning on the day\nthe goods ceased to be registered or listed, the person\nrequests, in writing, the Secretary to revoke the cancellation;\nand\n(c) the request is accompanied by the prescribed application fee;\nthe Secretary may, by notice in writing given to the person, revoke\nthe cancellation.\n(2) If the cancellation is revoked, the cancellation is taken never to\nhave occurred."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30a-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "30A(1) Revocation of cancellation of registration or listing upon",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30a-ss-1"
