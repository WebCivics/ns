    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bg",
      "@type": "cml:Concept",
      "skos:prefLabel": "26BG Limitations on determination under section 26BF",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26bg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.187",
      "values:originalText": "(1) The Minister may, by legislative instrument, make a determination\nspecifying indications that must not be covered by a determination\nunder paragraph 26BF(1)(a).\n(2) The determination may specify an indication either generally or in\nrelation to specified circumstances.\n(3) The Minister may, by legislative instrument, vary or revoke a\ndetermination under subsection (1).",
      "skos:definition": "(1) The Minister may, by legislative instrument, make a determination\nspecifying indications that must not be covered by a determination\nunder paragraph 26BF(1)(a).\n(2) The determination may specify an indication either generally or in\nrelation to specified circumstances.\n(3) The Minister may, by legislative instrument, vary or revoke a\ndetermination under subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bg-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bg-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bg-ss-3"
        }
      ],
      "cml:integrityHash": "55bdd097e548ead956e2cbcdd96b2be1dc3d49a3cb3ee449f78902b31a950caa"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26bg",
      "@type": "cof:Section",
      "cof:title": "26BG Limitations on determination under section 26BF",
      "values:kind": "section",
      "cof:pageNumber": 187,
      "values:originalText": "(1) The Minister may, by legislative instrument, make a determination\nspecifying indications that must not be covered by a determination\nunder paragraph 26BF(1)(a).\n(2) The determination may specify an indication either generally or in\nrelation to specified circumstances.\n(3) The Minister may, by legislative instrument, vary or revoke a\ndetermination under subsection (1)."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bg-ss-1",
