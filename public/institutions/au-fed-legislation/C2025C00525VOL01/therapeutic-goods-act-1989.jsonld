    {
      "@id": "concept:therapeutic-goods-act-1989-sec-31e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "31E(2) False or misleading documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-31e-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
