      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person commits an offence if:\n(a) the person does an act or omits to do an act;\n(b) the act or omission breaches a condition of a consent;\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.",
      "cml:conclusionText": "A person commits an offence if they breach a condition of consent."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition on breaching a condition of consent.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person commits an offence if:\n(a) the person does an act or omits to do an act;\n(b) the act or omission breaches a condition of a consent;\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.",
      "cml:conclusionText": "Breaching a condition of consent is prohibited."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:logicSummary": "Temporal relationship between the act and the harm.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person commits an offence if:\n(a) the person does an act or omits to do an act;\n(b) the act or omission breaches a condition of a consent;\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.",
      "cml:conclusionText": "The act and the harm are temporally related."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
