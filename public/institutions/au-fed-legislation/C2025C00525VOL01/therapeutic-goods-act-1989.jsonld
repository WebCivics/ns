      "cof:pageNumber": 188,
      "values:originalText": "(3) A person cannot make an application under subsection (1) for a\nrecommendation the effect of which would be for the\ndetermination to cover any of the following:\n(a) an indication specified in a determination under\nsection 26BG;\n(b) an indication that is or contains a restricted representation\n(within the meaning of Part 5-1);\n(c) unless subsection (4) applies—an indication that is or\ncontains a prohibited representation (within the meaning of"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bj-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-26bj-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bj-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition on making an application for a recommendation that would affect certain types of indications.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person cannot make an application under subsection (1)",
      "cml:conclusionText": "for the effect of which would be for the determination to cover any of the following:"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26c",
      "@type": "cml:Concept",
      "skos:prefLabel": "26C Certificates required in relation to patent infringement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26c"
      },
      "cml:curationStatus": {
