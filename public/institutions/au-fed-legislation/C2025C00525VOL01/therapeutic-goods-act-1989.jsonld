    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bk-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "32BK(2) Civil penalty for making misrepresentations about biologicals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bk-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.286",
      "values:originalText": "(2) Subsection (1) applies to the following representations:\n(a) representations that a biological is included in the Register;\n(b) representations that a person is exempt under\nsubsection 32CA(1) in relation to a biological or that a\nbiological is exempt under subsection 32CA(2);\n(c) representations that a biological is exempt under\nsection 32CB;\n(d) representations that a biological is the subject of an approval\nunder subsection 32CK(1);\n(e) representations that a biological is the subject of an authority\nunder subsection 32CM(1) or (7A);\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nMain criminal offences and civil penalties  Division 2\nSection 32BL\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(f) representations that a biological is the subject of an approval\nunder subsection 32CO(1), (1A) or (2).",
      "skos:definition": "(2) Subsection (1) applies to the following representations:\n(a) representations that a biological is included in the Register;\n(b) representations that a person is exempt under\nsubsection 32CA(1) in relation to a biological or that a\nbiological is exempt under subsection 32CA(2);\n(c) representations that a biological is exempt under\nsection 32CB;\n(d) representations that a biological is the subject of an approval\nunder subsection 32CK(1);\n(e) representations that a biological is the subject of an authority\nunder subsection 32CM(1) or (7A);\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nMain criminal offences and civil penalties  Division 2\nSection 32BL\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(f) representations that a biological is the subject of an approval\nunder subsection 32CO(1), (1A) or (2).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32bk"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bk-ss-2-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bk-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "06cd48fdb1ff12f5e99fc5f9cb34bcc7125ea6329ee289bc64eb65a9cedf7dcc",
      "skos:note": "Making misrepresentations about biologicals is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bk-ss-2",
      "@type": "cof:Section",
      "cof:title": "32BK(2) Civil penalty for making misrepresentations about biologicals",
      "values:kind": "subsection",
      "cof:pageNumber": 286,
      "values:originalText": "(2) Subsection (1) applies to the following representations:\n(a) representations that a biological is included in the Register;\n(b) representations that a person is exempt under\nsubsection 32CA(1) in relation to a biological or that a\nbiological is exempt under subsection 32CA(2);\n(c) representations that a biological is exempt under\nsection 32CB;\n(d) representations that a biological is the subject of an approval\nunder subsection 32CK(1);\n(e) representations that a biological is the subject of an authority\nunder subsection 32CM(1) or (7A);\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nMain criminal offences and civil penalties  Division 2\nSection 32BL\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(f) representations that a biological is the subject of an approval\nunder subsection 32CO(1), (1A) or (2)."
    },
    {
