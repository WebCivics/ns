      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The Minister must not determine a medicine unless...",
      "cml:conclusionText": "The Minister MUST determine a medicine under certain conditions."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30eh-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEGINS_ON",
      "cml:logicSummary": "Definition of a medicine shortage",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "For the purposes of this Act, there is a shortage of a medicine in Australia at a particular time if...",
      "cml:conclusionText": "A medicine shortage BEGINS ON the day the supply of that medicine will not meet demand."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30eh-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty obligation for reporting shortages",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the notification to the Secretary of any shortage of the medicine, or of any decision to permanently discontinue the supply of the medicine, in Australia would be in the interests of public health.",
      "cml:conclusionText": "The Minister MUST report a medicine shortage under certain conditions."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30eh-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty obligation for determining medicines",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
