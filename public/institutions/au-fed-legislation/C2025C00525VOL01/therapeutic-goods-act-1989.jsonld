      },
      "cml:operator": "Propagation",
      "cml:logicSummary": "Propagating the effect of the breach.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
