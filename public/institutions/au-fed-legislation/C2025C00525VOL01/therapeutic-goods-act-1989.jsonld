    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9h",
      "@type": "cml:Concept",
      "skos:prefLabel": "9H Civil penalty for false statements in requests for variation of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.68",
      "values:originalText": "entries in Register\nA person contravenes this section if the person in or in connection\nwith a request under section 9D for the variation of an entry in the\nRegister in relation to therapeutic goods, makes a statement that is\nfalse or misleading in a material particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nProhibition on import, export, manufacture or supply of therapeutic goods or vaping\ngoods—international agreements  Chapter 2A\n\nSection 9J\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 2A—Prohibition on import, export,\nmanufacture or supply of therapeutic\ngoods or vaping goods—international\nagreements",
      "skos:definition": "entries in Register\nA person contravenes this section if the person in or in connection\nwith a request under section 9D for the variation of an entry in the\nRegister in relation to therapeutic goods, makes a statement that is\nfalse or misleading in a material particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nProhibition on import, export, manufacture or supply of therapeutic goods or vaping\ngoods—international agreements  Chapter 2A\n\nSection 9J\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 2A—Prohibition on import, export,\nmanufacture or supply of therapeutic\ngoods or vaping goods—international\nagreements",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9h-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9h-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "342a544e86298c11472ae3580dd65426662dc1027f0dadf461c1c468bda20af9",
      "skos:note": "False statements in requests for variation of entries in Register"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9h",
      "@type": "cof:Section",
      "cof:title": "9H Civil penalty for false statements in requests for variation of",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "entries in Register\nA person contravenes this section if the person in or in connection\nwith a request under section 9D for the variation of an entry in the\nRegister in relation to therapeutic goods, makes a statement that is\nfalse or misleading in a material particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nProhibition on import, export, manufacture or supply of therapeutic goods or vaping\ngoods—international agreements  Chapter 2A\n\nSection 9J\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 2A—Prohibition on import, export,\nmanufacture or supply of therapeutic\ngoods or vaping goods—international\nagreements"
    },
