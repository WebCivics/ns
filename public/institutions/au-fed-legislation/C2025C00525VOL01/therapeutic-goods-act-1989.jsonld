      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Implication of breach on offence commitment.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person commits an offence if:\n(a) the person does an act or omits to do an act;\n(b) the act or omission breaches a condition of a consent;\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.",
      "cml:conclusionText": "If the breach occurs, then the offence is committed."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
