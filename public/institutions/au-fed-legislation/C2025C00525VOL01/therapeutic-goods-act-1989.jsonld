    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9f-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "9F(6) Removal of entries from Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9f-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.65",
      "values:originalText": "(6) If the Secretary removes an entry of goods from the Register under\nthis section, the removal has effect on the day specified in the\nnotice under subsection (2) in relation to the goods, being a day not\nearlier than 20 working days after the day on which the notice is\ngiven to the person.",
      "skos:definition": "(6) If the Secretary removes an entry of goods from the Register under\nthis section, the removal has effect on the day specified in the\nnotice under subsection (2) in relation to the goods, being a day not\nearlier than 20 working days after the day on which the notice is\ngiven to the person.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-9f"
      },
      "cml:asserts": [
