    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30ef-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "30EF(7) Reporting medicine shortages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ef-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.228",
      "values:originalText": "(7) Subsection (6) does not apply if:\n(a) paragraph (1)(a) and subsection (3) apply in relation to the\nshortage but subsection (2) does not; and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(7) Subsection (6) does not apply if:\n(a) paragraph (1)(a) and subsection (3) apply in relation to the\nshortage but subsection (2) does not; and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-30ef"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30ef-ss-7-norm"
        }
      ],
      "cml:integrityHash": "84dca6a9dc05ab382ffc6ec10369fe89824c2a24b938d13d0c3a92edc35d59aa",
      "skos:note": "Exemption from reporting medicine shortages under certain conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ef-ss-7",
      "@type": "cof:Section",
      "cof:title": "30EF(7) Reporting medicine shortages",
      "values:kind": "subsection",
      "cof:pageNumber": 228,
      "values:originalText": "(7) Subsection (6) does not apply if:\n(a) paragraph (1)(a) and subsection (3) apply in relation to the\nshortage but subsection (2) does not; and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
