        }
      ],
      "cml:integrityHash": "a8b3f09d9518d7e2889f52f740f6174283ee915d8f98d2e82cb87b5358755563",
      "skos:note": "Secretary may approve forms and manners for requests under this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-6",
      "@type": "cof:Section",
      "cof:title": "9D(6) Variation of entries in Register",
      "values:kind": "subsection",
