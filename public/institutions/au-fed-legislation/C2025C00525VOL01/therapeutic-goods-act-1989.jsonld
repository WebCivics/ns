    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "3B Declaration—country covered by non-EC/EFTA MRA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-3b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.42",
      "values:originalText": "(1) The Minister may declare, in writing, that a country specified in\nthe declaration is covered by the non-EC/EFTA MRA specified in\nthe declaration.\n(2) A declaration under subsection (1) must be published in the\nGazette or on the Department’s website.\n\nPreliminary  Chapter 1\n\nSection 3C\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "(1) The Minister may declare, in writing, that a country specified in\nthe declaration is covered by the non-EC/EFTA MRA specified in\nthe declaration.\n(2) A declaration under subsection (1) must be published in the\nGazette or on the Department’s website.\n\nPreliminary  Chapter 1\n\nSection 3C\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
