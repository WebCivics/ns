      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9a-ss-2",
      "@type": "cof:Section",
      "cof:title": "9A(2) Australian Register of Therapeutic Goods",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(2) Subject to subsection (3), the Register is to be kept in such form as\nthe Secretary determines."
    },
    {
