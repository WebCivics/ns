      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.219",
      "values:originalText": "(2) Subject to subsection (5), the Secretary must give written notice to\nthe Gene Technology Regulator:\n(a) stating that the application has been made; and\n(b) requesting the Gene Technology Regulator to give advice\nabout the application.",
      "skos:definition": "(2) Subject to subsection (5), the Secretary must give written notice to\nthe Gene Technology Regulator:\n(a) stating that the application has been made; and\n(b) requesting the Gene Technology Regulator to give advice\nabout the application.",
