        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ck-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "22046edada565bfb92398c70e6dc34ea332e3586881e3dac883d7e20ab1d1a73",
      "skos:note": "Application for approval must be made to the Secretary and meet certain requirements.",
      "dc:description": "Information relating to the biological subject of the application, prescribed evaluation fee"
    },
    {
