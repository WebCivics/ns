        }
      ],
      "cml:integrityHash": "02785f0cbc8942d64ddff8b6912a6c073c758f4336d86bd1af9feacb7f29d8cc",
      "skos:note": "Defines what constitutes a number for the purposes of subsection (1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bj-ss-2",
      "@type": "cof:Section",
      "cof:title": "32BJ(2) General criminal offences relating to this Part",
      "values:kind": "subsection",
      "cof:pageNumber": 284,
      "values:originalText": "(2) For the purposes of subsection (1), number includes any\ncombination of one or more of the following:\n(a) numbers;\n(b) letters;\n(c) symbols.\nAdvertising biological for an indication"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2-norm",
