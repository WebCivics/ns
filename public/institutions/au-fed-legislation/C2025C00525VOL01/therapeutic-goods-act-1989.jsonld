      },
      "cml:premiseText": "(a) has carried out an assessment, under subsection (2), in relation to the application;",
      "cml:conclusionText": "is satisfied that the requirements set out in subsection (3) have been met in relation to the application."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
