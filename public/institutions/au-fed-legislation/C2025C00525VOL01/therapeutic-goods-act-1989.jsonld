      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.182",
      "values:originalText": "(4) An application passes preliminary assessment if the Secretary:\n(a) has carried out an assessment, under subsection (2), in\nrelation to the application; and\n(b) is satisfied that the requirements set out in subsection (3)\nhave been met in relation to the application.",
      "skos:definition": "(4) An application passes preliminary assessment if the Secretary:\n(a) has carried out an assessment, under subsection (2), in\nrelation to the application; and\n(b) is satisfied that the requirements set out in subsection (3)\nhave been met in relation to the application.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-26bd"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "dd9e85813a1135c98b20a4dd3133f1139f0213616a37164dda5d35ef4577567f",
      "skos:note": "The Secretary must be satisfied that the requirements have been met."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26bd-ss-4",
      "@type": "cof:Section",
      "cof:title": "26BD(4) Requirements relating to an application for variation of a",
      "values:kind": "subsection",
      "cof:pageNumber": 182,
      "values:originalText": "(4) An application passes preliminary assessment if the Secretary:\n(a) has carried out an assessment, under subsection (2), in\nrelation to the application; and\n(b) is satisfied that the requirements set out in subsection (3)\nhave been met in relation to the application."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4-norm",
