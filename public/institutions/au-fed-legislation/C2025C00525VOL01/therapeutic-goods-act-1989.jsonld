      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "5A Application of the Criminal Code—extended geographical",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-5a"
