    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32g",
      "@type": "cml:Concept",
      "skos:prefLabel": "32G What this Division is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.353",
      "values:originalText": "The Secretary may cancel inclusions of biologicals in the Register\nin certain circumstances.",
      "skos:definition": "The Secretary may cancel inclusions of biologicals in the Register\nin certain circumstances.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32g-norm"
        }
      ],
      "cml:integrityHash": "f249cc31560c19b037e8ffe51e95fc561d461a5d73ccbf715839d13240457a1f",
      "skos:note": "Secretary may cancel inclusions of biologicals in the Register under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32g",
      "@type": "cof:Section",
      "cof:title": "32G What this Division is about",
      "values:kind": "section",
      "cof:pageNumber": 353,
      "values:originalText": "The Secretary may cancel inclusions of biologicals in the Register\nin certain circumstances."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32g-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32g"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ga",
      "@type": "cml:Concept",
      "skos:prefLabel": "32GA Immediate cancellation of biological from the Register in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ga"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.353",
      "values:originalText": "various circumstances\n(1) The Secretary may, by written notice given to the person in relation\nto whom a biological is included in the Register, cancel the entry\nof the biological from the Register if:\n(a) the Secretary is satisfied that there would be an imminent risk\nof death, serious illness or serious injury if the biological\ncontinued to be included in the Register; or\n(b) the biological ceases to be a biological or the biological\nbecomes covered by an order under section 7 declaring goods\nnot to be therapeutic goods; or\n(c) the person is exempt under subsection 32CA(1) in relation to\nthe biological or the biological is exempt under\nsubsection 32CA(2); or\n(d) the person requests in writing the cancellation of the entry of\nthe biological from the Register; or\n(e) the biological contains substances that are prohibited imports\nfor the purposes of the Customs Act 1901; or\n(f) the Secretary is satisfied that a statement made in, or in\nconnection with, the application for including the biological\nin the Register was false or misleading in a material\nparticular; or\n(g) the annual charge payable under the Therapeutic Goods\n(Charges) Act 1989 in respect of the inclusion of the\nbiological in the Register is not paid within 28 days after it\nbecomes payable; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "various circumstances\n(1) The Secretary may, by written notice given to the person in relation\nto whom a biological is included in the Register, cancel the entry\nof the biological from the Register if:\n(a) the Secretary is satisfied that there would be an imminent risk\nof death, serious illness or serious injury if the biological\ncontinued to be included in the Register; or\n(b) the biological ceases to be a biological or the biological\nbecomes covered by an order under section 7 declaring goods\nnot to be therapeutic goods; or\n(c) the person is exempt under subsection 32CA(1) in relation to\nthe biological or the biological is exempt under\nsubsection 32CA(2); or\n(d) the person requests in writing the cancellation of the entry of\nthe biological from the Register; or\n(e) the biological contains substances that are prohibited imports\nfor the purposes of the Customs Act 1901; or\n(f) the Secretary is satisfied that a statement made in, or in\nconnection with, the application for including the biological\nin the Register was false or misleading in a material\nparticular; or\n(g) the annual charge payable under the Therapeutic Goods\n(Charges) Act 1989 in respect of the inclusion of the\nbiological in the Register is not paid within 28 days after it\nbecomes payable; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ga-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ga-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ga-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "746132fb58f62e028c03dfb237f56d3b7522c6cbb47312b62ea238b212de1be6",
      "skos:note": "Cancellation of biological entry from Register under specified circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ga",
      "@type": "cof:Section",
      "cof:title": "32GA Immediate cancellation of biological from the Register in",
      "values:kind": "section",
      "cof:pageNumber": 353,
      "values:originalText": "various circumstances\n(1) The Secretary may, by written notice given to the person in relation\nto whom a biological is included in the Register, cancel the entry\nof the biological from the Register if:\n(a) the Secretary is satisfied that there would be an imminent risk\nof death, serious illness or serious injury if the biological\ncontinued to be included in the Register; or\n(b) the biological ceases to be a biological or the biological\nbecomes covered by an order under section 7 declaring goods\nnot to be therapeutic goods; or\n(c) the person is exempt under subsection 32CA(1) in relation to\nthe biological or the biological is exempt under\nsubsection 32CA(2); or\n(d) the person requests in writing the cancellation of the entry of\nthe biological from the Register; or\n(e) the biological contains substances that are prohibited imports\nfor the purposes of the Customs Act 1901; or\n(f) the Secretary is satisfied that a statement made in, or in\nconnection with, the application for including the biological\nin the Register was false or misleading in a material\nparticular; or\n(g) the annual charge payable under the Therapeutic Goods\n(Charges) Act 1989 in respect of the inclusion of the\nbiological in the Register is not paid within 28 days after it\nbecomes payable; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ga-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32ga"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
