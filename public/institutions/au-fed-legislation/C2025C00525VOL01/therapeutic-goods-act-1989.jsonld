    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30fa",
      "@type": "cml:Concept",
      "skos:prefLabel": "30FA Civil penalty for goods exempt under section 18A not",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30fa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.240",
      "values:originalText": "conforming to standards etc.\nA person contravenes this section if:\n(a) the Secretary gives a notice to the person under\nsubsection 30F(2); and\n(b) the notice specifies a particular requirement mentioned in\nsubsection 30F(3); and\n(c) the person does not comply with the requirement.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "conforming to standards etc.\nA person contravenes this section if:\n(a) the Secretary gives a notice to the person under\nsubsection 30F(2); and\n(b) the notice specifies a particular requirement mentioned in\nsubsection 30F(3); and\n(c) the person does not comply with the requirement.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30fa-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30fa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "77b8fdca45d638bf5b177ade91d457a92ac3577489fc403845880bebdf100cd4",
      "skos:note": "Civil penalty for non-compliance with standards"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30fa",
      "@type": "cof:Section",
      "cof:title": "30FA Civil penalty for goods exempt under section 18A not",
      "values:kind": "section",
      "cof:pageNumber": 240,
      "values:originalText": "conforming to standards etc.\nA person contravenes this section if:\n(a) the Secretary gives a notice to the person under\nsubsection 30F(2); and\n(b) the notice specifies a particular requirement mentioned in\nsubsection 30F(3); and\n(c) the person does not comply with the requirement.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30fa-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-30fa"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30fa-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits non-compliance",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
