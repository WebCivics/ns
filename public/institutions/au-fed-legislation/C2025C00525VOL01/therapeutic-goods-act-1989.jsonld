          "@id": "concept:therapeutic-goods-act-1989-sec-20-ss-1b"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-20-ss-1c"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-20-ss-2a"
