    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32hd",
      "@type": "cml:Concept",
      "skos:prefLabel": "32HD Civil penalty for non-compliance with requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32hd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.365",
      "values:originalText": "A person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a requirement imposed on the\nperson under section 32HA.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "A person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a requirement imposed on the\nperson under section 32HA.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32hd-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32hd-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0afe274f1b9cb51789e56ca199fa8691156b60af901ec51c0d420ad1ece62701",
      "skos:note": "Civil penalty for non-compliance with requirements"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32hd",
      "@type": "cof:Section",
      "cof:title": "32HD Civil penalty for non-compliance with requirements",
      "values:kind": "section",
      "cof:pageNumber": 365,
      "values:originalText": "A person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a requirement imposed on the\nperson under section 32HA.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
