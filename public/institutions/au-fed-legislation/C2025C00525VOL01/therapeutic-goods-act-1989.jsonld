    {
      "@id": "concept:therapeutic-goods-act-1989-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Exempt goods and exempt persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.380",
      "values:originalText": "(1) The regulations may exempt therapeutic goods or a class of\ntherapeutic goods identified in the regulations from the operation\nof this Part.\n(2) The regulations may exempt a person identified in the regulations\nfrom the operation of this Part in relation to the manufacture or a\nstep in the manufacture of therapeutic goods or a class of\ntherapeutic goods identified in the regulations.\n(3) Where the regulations revoke an exemption, the revocation takes\neffect on the day, not being earlier than 28 days after the day on\nwhich the regulations are made, as is specified in the regulations.",
      "skos:definition": "(1) The regulations may exempt therapeutic goods or a class of\ntherapeutic goods identified in the regulations from the operation\nof this Part.\n(2) The regulations may exempt a person identified in the regulations\nfrom the operation of this Part in relation to the manufacture or a\nstep in the manufacture of therapeutic goods or a class of\ntherapeutic goods identified in the regulations.\n(3) Where the regulations revoke an exemption, the revocation takes\neffect on the day, not being earlier than 28 days after the day on\nwhich the regulations are made, as is specified in the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-34-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-34-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-34-ss-3"
        }
      ],
      "cml:integrityHash": "3e2a0e4b8bdad2cd8f86c1a4bc8ebc13049d39d4b0a095ecd7d79d3ed3a3e907"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Exempt goods and exempt persons",
      "values:kind": "section",
      "cof:pageNumber": 380,
      "values:originalText": "(1) The regulations may exempt therapeutic goods or a class of\ntherapeutic goods identified in the regulations from the operation\nof this Part.\n(2) The regulations may exempt a person identified in the regulations\nfrom the operation of this Part in relation to the manufacture or a\nstep in the manufacture of therapeutic goods or a class of\ntherapeutic goods identified in the regulations.\n(3) Where the regulations revoke an exemption, the revocation takes\neffect on the day, not being earlier than 28 days after the day on\nwhich the regulations are made, as is specified in the regulations."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-34-ss-1",
