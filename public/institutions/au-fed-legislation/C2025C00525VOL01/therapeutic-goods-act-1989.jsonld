      ],
      "cml:integrityHash": "a6516c6e428c0e28849bb916246584c3e7cfe60c5adadb39a9dba91976623015",
      "skos:note": "Carrying out steps in manufacturing therapeutic goods at Australian premises is prohibited."
    },
    {
