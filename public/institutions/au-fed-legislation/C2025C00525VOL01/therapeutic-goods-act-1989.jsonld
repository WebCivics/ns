      "skos:prefLabel": "29G Effect of suspension",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-29g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.212",
      "values:originalText": "(1) If the registration or listing of therapeutic goods is suspended under\nsection 29D, the goods are taken, for the purposes of this Act\n(other than sections 28, 29A, 29AA, 29E, 29F, 30 and 31), not to\nbe included in the Register while the suspension has effect.\nNote:\nDealing in therapeutic goods that are not included in the Register may\nbe an offence or may contravene a civil penalty provision: see",
      "skos:definition": "(1) If the registration or listing of therapeutic goods is suspended under\nsection 29D, the goods are taken, for the purposes of this Act\n(other than sections 28, 29A, 29AA, 29E, 29F, 30 and 31), not to\nbe included in the Register while the suspension has effect.\nNote:\nDealing in therapeutic goods that are not included in the Register may\nbe an offence or may contravene a civil penalty provision: see",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-29g-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-29g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "19687dbf3cf6f1062248d965b09d18c5d743e786c2bff4af60c96a3328943ff2",
      "skos:note": "Therapeutic goods not included in Register during suspension."
    },
    {
