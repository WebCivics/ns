      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.380",
      "values:originalText": "(3) Where the regulations revoke an exemption, the revocation takes\neffect on the day, not being earlier than 28 days after the day on\nwhich the regulations are made, as is specified in the regulations.",
      "skos:definition": "(3) Where the regulations revoke an exemption, the revocation takes\neffect on the day, not being earlier than 28 days after the day on\nwhich the regulations are made, as is specified in the regulations.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-34"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-34-ss-3-norm"
