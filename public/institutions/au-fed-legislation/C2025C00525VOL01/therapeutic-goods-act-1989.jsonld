      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.76",
      "values:originalText": "(3) If:\n(a) a default standard applies to a class of therapeutic goods; and\n(b) another default standard applies to only some of the\ntherapeutic goods within that class; and\n(c) those standards are inconsistent;\nthe standard referred to in paragraph (a) does not apply in relation\nto the goods referred to in paragraph (b).",
      "skos:definition": "(3) If:\n(a) a default standard applies to a class of therapeutic goods; and\n(b) another default standard applies to only some of the\ntherapeutic goods within that class; and\n(c) those standards are inconsistent;\nthe standard referred to in paragraph (a) does not apply in relation\nto the goods referred to in paragraph (b).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-13"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-13-ss-3-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-13-ss-3-logic-deontic-1"
        },
