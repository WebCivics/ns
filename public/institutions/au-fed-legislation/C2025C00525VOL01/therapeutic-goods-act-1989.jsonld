    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jc",
      "@type": "cml:Concept",
      "skos:prefLabel": "32JC Civil penalty for giving false or misleading information or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.370",
      "values:originalText": "document in compliance with a notice\nA person contravenes this section if:\n(a) the person is given a notice under section 32JA; and\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nObtaining information or documents  Division 9\nSection 32JD\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(b) the person gives information or produces a document in\ncompliance or purported compliance with the notice; and\n(c) the information or document is false or misleading in a\nmaterial particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "document in compliance with a notice\nA person contravenes this section if:\n(a) the person is given a notice under section 32JA; and\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nObtaining information or documents  Division 9\nSection 32JD\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(b) the person gives information or produces a document in\ncompliance or purported compliance with the notice; and\n(c) the information or document is false or misleading in a\nmaterial particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jc-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7fe630bd5d110b2510f427c893db8f5f8276c70b90d083460f0deb05a112cb65",
      "skos:note": "Giving false or misleading information in compliance with a notice is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jc",
      "@type": "cof:Section",
      "cof:title": "32JC Civil penalty for giving false or misleading information or",
      "values:kind": "section",
      "cof:pageNumber": 370,
      "values:originalText": "document in compliance with a notice\nA person contravenes this section if:\n(a) the person is given a notice under section 32JA; and\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nObtaining information or documents  Division 9\nSection 32JD\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(b) the person gives information or produces a document in\ncompliance or purported compliance with the notice; and\n(c) the information or document is false or misleading in a\nmaterial particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
    {
