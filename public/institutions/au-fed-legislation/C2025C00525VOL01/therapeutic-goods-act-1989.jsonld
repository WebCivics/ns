      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.256",
      "values:originalText": "(2) Subsection (1) or (1A) does not apply if the document is not false\nor misleading in a material particular.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2): see subsection 13.3(3) of the Criminal Code.",
      "skos:definition": "(2) Subsection (1) or (1A) does not apply if the document is not false\nor misleading in a material particular.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2): see subsection 13.3(3) of the Criminal Code.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-31e"
      },
      "cml:asserts": [
