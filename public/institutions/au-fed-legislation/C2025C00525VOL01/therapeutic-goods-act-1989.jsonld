    {
      "@id": "concept:therapeutic-goods-act-1989-sec-21-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits supplying therapeutic goods without proper authorization.",
      "cml:executionSurface": "modalities::logic::deontic",
