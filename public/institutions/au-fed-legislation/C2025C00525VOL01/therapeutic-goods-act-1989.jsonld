    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32b",
      "@type": "cml:Concept",
      "skos:prefLabel": "32B What this Division is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.262",
      "values:originalText": "This Division contains criminal offences and civil penalties\nrelating to the import, export, manufacture, supply and use of\nbiologicals.",
      "skos:definition": "This Division contains criminal offences and civil penalties\nrelating to the import, export, manufacture, supply and use of\nbiologicals.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32b-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "80b0d0676bfee26056dd3ed5682eb90172a72b0377a09f89fdc83fa37e80de5e",
      "skos:note": "Defines criminal offences and civil penalties relating to biologicals."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32b",
      "@type": "cof:Section",
      "cof:title": "32B What this Division is about",
      "values:kind": "section",
      "cof:pageNumber": 262,
      "values:originalText": "This Division contains criminal offences and civil penalties\nrelating to the import, export, manufacture, supply and use of\nbiologicals."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
