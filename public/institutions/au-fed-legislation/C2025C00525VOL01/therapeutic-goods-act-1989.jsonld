    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "9D(3A) Variation of entries in Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.59",
      "values:originalText": "(3A) If:\n(a) the person in relation to whom a biological is included in the\nRegister has requested the Secretary to vary information\nincluded in the entry in the Register that relates to the\nbiological; and\n\nAustralian Register of Therapeutic Goods  Chapter 2\n\nSection 9D\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(aa) subsection (3AA) does not apply to the request; and\n(ab) subsection (3AC) does not apply to the request; and\n(b) the Secretary is satisfied that the variation requested does not\nindicate any reduction in the quality, safety or efficacy of the\nbiological for the purposes for which it is to be used;\nthe Secretary may vary the entry in accordance with the request.",
      "skos:definition": "(3A) If:\n(a) the person in relation to whom a biological is included in the\nRegister has requested the Secretary to vary information\nincluded in the entry in the Register that relates to the\nbiological; and\n\nAustralian Register of Therapeutic Goods  Chapter 2\n\nSection 9D\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(aa) subsection (3AA) does not apply to the request; and\n(ab) subsection (3AC) does not apply to the request; and\n(b) the Secretary is satisfied that the variation requested does not\nindicate any reduction in the quality, safety or efficacy of the\nbiological for the purposes for which it is to be used;\nthe Secretary may vary the entry in accordance with the request.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-9d"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2ebc7b3de21f93c195cabfd58b42db0773a777e91c1534d4f59df0d2147cf6b6",
      "skos:note": "Secretary may vary entry in Register upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-3a",
      "@type": "cof:Section",
      "cof:title": "9D(3A) Variation of entries in Register",
      "values:kind": "subsection",
      "cof:pageNumber": 59,
      "values:originalText": "(3A) If:\n(a) the person in relation to whom a biological is included in the\nRegister has requested the Secretary to vary information\nincluded in the entry in the Register that relates to the\nbiological; and\n\nAustralian Register of Therapeutic Goods  Chapter 2\n\nSection 9D\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(aa) subsection (3AA) does not apply to the request; and\n(ab) subsection (3AC) does not apply to the request; and\n(b) the Secretary is satisfied that the variation requested does not\nindicate any reduction in the quality, safety or efficacy of the\nbiological for the purposes for which it is to be used;\nthe Secretary may vary the entry in accordance with the request."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3a-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3a"
      },
      "values:deonticStatus": {
