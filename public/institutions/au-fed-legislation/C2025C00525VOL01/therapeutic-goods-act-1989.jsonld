    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "41AA Spent convictions scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.404",
      "values:originalText": "Nothing in section 40 or 41 affects the operation of Part VIIC of\nthe Crimes Act 1914 (which includes provisions that, in certain\ncircumstances, relieve persons from the requirement to disclose\nspent convictions and require persons aware of such convictions to\ndisregard them).",
      "skos:definition": "Nothing in section 40 or 41 affects the operation of Part VIIC of\nthe Crimes Act 1914 (which includes provisions that, in certain\ncircumstances, relieve persons from the requirement to disclose\nspent convictions and require persons aware of such convictions to\ndisregard them).",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41aa-norm"
        }
      ],
      "cml:integrityHash": "26a042a4750a2b1bf06d170e8a3c7ea9fa8618b617f178ccd724915efff5183c",
      "skos:note": "Relieves persons from the requirement to disclose spent convictions and require persons aware of such convictions to disregard them."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41aa",
      "@type": "cof:Section",
      "cof:title": "41AA Spent convictions scheme",
      "values:kind": "section",
      "cof:pageNumber": 404,
      "values:originalText": "Nothing in section 40 or 41 affects the operation of Part VIIC of\nthe Crimes Act 1914 (which includes provisions that, in certain\ncircumstances, relieve persons from the requirement to disclose\nspent convictions and require persons aware of such convictions to\ndisregard them)."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41aa-norm",
