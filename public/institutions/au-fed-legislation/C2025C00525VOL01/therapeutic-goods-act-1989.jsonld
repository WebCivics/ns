    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32he",
      "@type": "cml:Concept",
      "skos:prefLabel": "32HE Powers of suspension and cancellation unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32he"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.365",
      "values:originalText": "Imposition of a requirement under section 32HA does not affect\nthe Secretary’s power to suspend a biological, or cancel the entry\nof a biological, from the Register under this Part.",
      "skos:definition": "Imposition of a requirement under section 32HA does not affect\nthe Secretary’s power to suspend a biological, or cancel the entry\nof a biological, from the Register under this Part.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32he-norm"
        }
      ],
      "cml:integrityHash": "670f28f015de613c6cb7f719e5306c6ddf7e39dd2dc0770ad3382f8acbcb0adf",
      "skos:note": "Powers of suspension and cancellation unaffected"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32he",
      "@type": "cof:Section",
      "cof:title": "32HE Powers of suspension and cancellation unaffected",
      "values:kind": "section",
      "cof:pageNumber": 365,
      "values:originalText": "Imposition of a requirement under section 32HA does not affect\nthe Secretary’s power to suspend a biological, or cancel the entry\nof a biological, from the Register under this Part."
    },
