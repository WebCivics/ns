      },
      "cml:operator": "=>",
      "cml:logicSummary": "Licence breach implies obligation to comply.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
