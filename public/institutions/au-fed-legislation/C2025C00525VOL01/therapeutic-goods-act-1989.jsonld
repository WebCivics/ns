    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30b",
      "@type": "cml:Concept",
      "skos:prefLabel": "30B Publication of cancellation of registration or listing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.219",
      "values:originalText": "If the Secretary cancels the registration or listing of therapeutic\ngoods under section 30, the Secretary must, as soon as practicable\nafter the cancellation, cause to be published in the Gazette, or on\nthe Department’s website, a notice setting out particulars of the\ncancellation.",
      "skos:definition": "If the Secretary cancels the registration or listing of therapeutic\ngoods under section 30, the Secretary must, as soon as practicable\nafter the cancellation, cause to be published in the Gazette, or on\nthe Department’s website, a notice setting out particulars of the\ncancellation.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30b-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "da3c41bf8618cf831752cc7369f69e9a7718aa59c156fc5d028d8208542e4530",
      "skos:note": "Secretary must publish notice after cancellation of registration or listing.",
      "dc:description": "Notice setting out particulars of the cancellation."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30b",
      "@type": "cof:Section",
      "cof:title": "30B Publication of cancellation of registration or listing",
      "values:kind": "section",
      "cof:pageNumber": 219,
      "values:originalText": "If the Secretary cancels the registration or listing of therapeutic\ngoods under section 30, the Secretary must, as soon as practicable\nafter the cancellation, cause to be published in the Gazette, or on\nthe Department’s website, a notice setting out particulars of the\ncancellation."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
