    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bh",
      "@type": "cml:Concept",
      "skos:prefLabel": "32BH Criminal offence relating to wholesale supply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.281",
      "values:originalText": "A person commits an offence if:\n(a) the person supplies a biological in Australia for use in\nhumans; and\n(b) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CK(1) that is held by the person, being an\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "A person commits an offence if:\n(a) the person supplies a biological in Australia for use in\nhumans; and\n(b) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CK(1) that is held by the person, being an\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bh-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "229ac0ee4086a71c767aa2db7da313557c305a292ced5d9370a1b3f5b9aff0a2",
      "skos:note": "Supplying biologicals for use in humans without proper exemption or approval is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bh",
      "@type": "cof:Section",
      "cof:title": "32BH Criminal offence relating to wholesale supply",
      "values:kind": "section",
      "cof:pageNumber": 281,
      "values:originalText": "A person commits an offence if:\n(a) the person supplies a biological in Australia for use in\nhumans; and\n(b) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CK(1) that is held by the person, being an\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bh-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32bh"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bh-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits supplying biologicals for use in humans without proper exemption or approval.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bi",
      "@type": "cml:Concept",
      "skos:prefLabel": "32BI Criminal offence for using a biological not included in the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.282",
      "values:originalText": "Register\n(1) A person commits an offence if:\n(a) the person uses a biological; and\n(b) the biological is used:\n(i) in the treatment of another person; or\n(ii) solely for experimental purposes in humans; and\n(c) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CO(1), (1A) or (2);\n(v) the person uses the biological in accordance with an\napproval under subsection 32CK(1);\n(vi) the person uses the biological in accordance with a\ncondition applicable under regulations made for the\npurposes of section 32CL;\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nMain criminal offences and civil penalties  Division 2\nSection 32BI\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(vii) the person uses the biological in accordance with an\nauthority under subsection 32CM(1) or (7A); and\n(d) either:\n(i) if the person used the biological in the treatment of that\nother person—the use of the biological has resulted in,\nwill result in, or is likely to result in, harm or injury to\nthat other person; or\n(ii) if the person used the biological solely for experimental\npurposes in humans—the use of the biological has\nresulted in, will result in, or is likely to result in, harm\nor injury to any of those humans.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.\nNote:\nA jury may acquit a person of an offence against this subsection and\nmay convict the person of an offence against subsection (4) instead:\nsee section 53A.\n(4) A person commits an offence if:\n(a) the person uses a biological; and\n(b) the biological is used:\n(i) in the treatment of another person; or\n(ii) solely for experimental purposes in humans; and\n(c) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CO(1), (1A) or (2);\n(v) the person uses the biological in accordance with an\napproval under subsection 32CK(1);\n(vi) the person uses the biological in accordance with a\ncondition applicable under regulations made for the\npurposes of section 32CL;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "Register\n(1) A person commits an offence if:\n(a) the person uses a biological; and\n(b) the biological is used:\n(i) in the treatment of another person; or\n(ii) solely for experimental purposes in humans; and\n(c) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CO(1), (1A) or (2);\n(v) the person uses the biological in accordance with an\napproval under subsection 32CK(1);\n(vi) the person uses the biological in accordance with a\ncondition applicable under regulations made for the\npurposes of section 32CL;\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nMain criminal offences and civil penalties  Division 2\nSection 32BI\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(vii) the person uses the biological in accordance with an\nauthority under subsection 32CM(1) or (7A); and\n(d) either:\n(i) if the person used the biological in the treatment of that\nother person—the use of the biological has resulted in,\nwill result in, or is likely to result in, harm or injury to\nthat other person; or\n(ii) if the person used the biological solely for experimental\npurposes in humans—the use of the biological has\nresulted in, will result in, or is likely to result in, harm\nor injury to any of those humans.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.\nNote:\nA jury may acquit a person of an offence against this subsection and\nmay convict the person of an offence against subsection (4) instead:\nsee section 53A.\n(4) A person commits an offence if:\n(a) the person uses a biological; and\n(b) the biological is used:\n(i) in the treatment of another person; or\n(ii) solely for experimental purposes in humans; and\n(c) none of th",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bi-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bi-ss-4"
        }
      ],
      "cml:integrityHash": "bb7234ec12451361e6f35bcbe76de58e4350657fe60d1b96ace0947f59194083"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bi",
      "@type": "cof:Section",
      "cof:title": "32BI Criminal offence for using a biological not included in the",
      "values:kind": "section",
      "cof:pageNumber": 282,
      "values:originalText": "Register\n(1) A person commits an offence if:\n(a) the person uses a biological; and\n(b) the biological is used:\n(i) in the treatment of another person; or\n(ii) solely for experimental purposes in humans; and\n(c) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CO(1), (1A) or (2);\n(v) the person uses the biological in accordance with an\napproval under subsection 32CK(1);\n(vi) the person uses the biological in accordance with a\ncondition applicable under regulations made for the\npurposes of section 32CL;\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nMain criminal offences and civil penalties  Division 2\nSection 32BI\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(vii) the person uses the biological in accordance with an\nauthority under subsection 32CM(1) or (7A); and\n(d) either:\n(i) if the person used the biological in the treatment of that\nother person—the use of the biological has resulted in,\nwill result in, or is likely to result in, harm or injury to\nthat other person; or\n(ii) if the person used the biological solely for experimental\npurposes in humans—the use of the biological has\nresulted in, will result in, or is likely to result in, harm\nor injury to any of those humans.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.\nNote:\nA jury may acquit a person of an offence against this subsection and\nmay convict the person of an offence against subsection (4) instead:\nsee section 53A.\n(4) A person commits an offence if:\n(a) the person uses a biological; and\n(b) the biological is used:\n(i) in the treatment of another person; or\n(ii) solely for experimental purposes in humans; and\n(c) none of the following subparagraphs applies:\n(i) the biological is included in the Register;\n(ii) the person is exempt under subsection 32CA(1) in\nrelation to the biological or the biological is exempt\nunder subsection 32CA(2);\n(iii) the biological is exempt under section 32CB;\n(iv) the biological is the subject of an approval under\nsubsection 32CO(1), (1A) or (2);\n(v) the person uses the biological in accordance with an\napproval under subsection 32CK(1);\n(vi) the person uses the biological in accordance with a\ncondition applicable under regulations made for the\npurposes of section 32CL;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
