    {
      "@id": "concept:therapeutic-goods-act-1989-sec-22aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "22AA Civil penalty for breaching conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-22aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.130",
      "values:originalText": "(1) A person contravenes this subsection if:\n(a) the person does an act or omits to do an act in relation to\ntherapeutic goods; and\n(b) the goods are exempt under section 18A; and\n(c) the act or omission breaches a condition of the exemption.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n(2) A person contravenes this subsection if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches:\n(i) a condition of an exemption applicable under\nregulations made for the purposes of subsection 18(1);\nor\n(ii) a condition of an approval or authority under section 19;\nor\n(iii) a condition applicable under regulations made for the\npurposes of subsection 19(4A); or\n(iv) a condition of an approval under section 19A.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nPreliminary  Division 1\nSection 22A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "(1) A person contravenes this subsection if:\n(a) the person does an act or omits to do an act in relation to\ntherapeutic goods; and\n(b) the goods are exempt under section 18A; and\n(c) the act or omission breaches a condition of the exemption.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n(2) A person contravenes this subsection if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches:\n(i) a condition of an exemption applicable under\nregulations made for the purposes of subsection 18(1);\nor\n(ii) a condition of an approval or authority under section 19;\nor\n(iii) a condition applicable under regulations made for the\npurposes of subsection 19(4A); or\n(iv) a condition of an approval under section 19A.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nPreliminary  Division 1\nSection 22A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22aa-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22aa-ss-2"
        }
      ],
      "cml:integrityHash": "181724e6e282dcefd3c3d53aa2bd76bb7d63f6efcd67852f3ee8383cb5a00d78"
    },
