    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32j",
      "@type": "cml:Concept",
      "skos:prefLabel": "32J What this Division is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.366",
      "values:originalText": "The Secretary may by written notice seek information or\ndocuments relating to:\n•\napplications for inclusion of biologicals in the Register; or\n•\nbiologicals included in the Register; or\n•\nthe supply of, and other matters relating to, biologicals\ncovered by exemptions under Division 3.\nThere are criminal offences for failing to comply with a notice and\nfor giving false or misleading information or documents and civil\npenalties for giving false or misleading information or documents.\nSubdivision B—Obtaining information or documents for\nbiologicals included or proposed to be included in the\nRegister",
      "skos:definition": "The Secretary may by written notice seek information or\ndocuments relating to:\n•\napplications for inclusion of biologicals in the Register; or\n•\nbiologicals included in the Register; or\n•\nthe supply of, and other matters relating to, biologicals\ncovered by exemptions under Division 3.\nThere are criminal offences for failing to comply with a notice and\nfor giving false or misleading information or documents and civil\npenalties for giving false or misleading information or documents.\nSubdivision B—Obtaining information or documents for\nbiologicals included or proposed to be included in the\nRegister",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32j-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32j-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32j-logic-epistemic-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32j-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32j-logic-argumentation-4"
        }
      ],
      "cml:integrityHash": "a4b8b329d56528433ed5a3b2f123d18a50c9b3e1c1762789996b5547bdb92100",
      "skos:note": "The Secretary may seek information or documents from applicants, biologicals included in the Register, and suppliers of exempted biologicals."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32j",
      "@type": "cof:Section",
      "cof:title": "32J What this Division is about",
      "values:kind": "section",
      "cof:pageNumber": 366,
      "values:originalText": "The Secretary may by written notice seek information or\ndocuments relating to:\n•\napplications for inclusion of biologicals in the Register; or\n•\nbiologicals included in the Register; or\n•\nthe supply of, and other matters relating to, biologicals\ncovered by exemptions under Division 3.\nThere are criminal offences for failing to comply with a notice and\nfor giving false or misleading information or documents and civil\npenalties for giving false or misleading information or documents.\nSubdivision B—Obtaining information or documents for\nbiologicals included or proposed to be included in the\nRegister"
    },
