        }
      ],
      "cml:integrityHash": "2c3d92b51b834d223d710dc2f8cb28326eb41d64fcde25fc0028c501ecee9d98",
      "skos:note": "Defendant bears evidential burden in relation to the matter."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-31e-ss-2",
