    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32f",
      "@type": "cml:Concept",
      "skos:prefLabel": "32F What this Division is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.349",
      "values:originalText": "The Secretary may suspend biologicals from the Register in certain\ncircumstances. A biological that is suspended is taken not to be\nincluded in the Register for most purposes.",
      "skos:definition": "The Secretary may suspend biologicals from the Register in certain\ncircumstances. A biological that is suspended is taken not to be\nincluded in the Register for most purposes.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32f-norm"
        }
      ],
      "cml:integrityHash": "ac0dda23769b7df38fc8a7abc292acafcf3a25565272f95283c498928b6c5df2",
      "skos:note": "The Secretary may suspend biologicals from the Register in certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32f",
      "@type": "cof:Section",
      "cof:title": "32F What this Division is about",
      "values:kind": "section",
      "cof:pageNumber": 349,
      "values:originalText": "The Secretary may suspend biologicals from the Register in certain\ncircumstances. A biological that is suspended is taken not to be\nincluded in the Register for most purposes."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32f-norm",
