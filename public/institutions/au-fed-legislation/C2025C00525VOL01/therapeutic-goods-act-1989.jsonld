    {
      "@id": "concept:therapeutic-goods-act-1989-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Offence relating to wholesale supply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.117",
      "values:originalText": "A person must not supply in Australia therapeutic goods for use in\nhumans, being goods of which the person is not a sponsor, to\nanother person who is not the ultimate consumer of the goods\nunless:\n(a) the goods are registered goods or listed goods; or\n(b) the goods are exempt goods; or\n(ba) the goods are exempt under section 18A; or\n(c) the goods are the subject of an approval or authority under\nsection 19; or\n(d) the goods are the subject of an approval under section 19A.\nPenalty: 120 penalty units.",
      "skos:definition": "A person must not supply in Australia therapeutic goods for use in\nhumans, being goods of which the person is not a sponsor, to\nanother person who is not the ultimate consumer of the goods\nunless:\n(a) the goods are registered goods or listed goods; or\n(b) the goods are exempt goods; or\n(ba) the goods are exempt under section 18A; or\n(c) the goods are the subject of an approval or authority under\nsection 19; or\n(d) the goods are the subject of an approval under section 19A.\nPenalty: 120 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-21-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "391f25ba88de1d2d063a88a388d620f5e82b39f41093ee3b129290f5b63c787a",
      "skos:note": "Supplying therapeutic goods without proper authorization is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Offence relating to wholesale supply",
      "values:kind": "section",
      "cof:pageNumber": 117,
      "values:originalText": "A person must not supply in Australia therapeutic goods for use in\nhumans, being goods of which the person is not a sponsor, to\nanother person who is not the ultimate consumer of the goods\nunless:\n(a) the goods are registered goods or listed goods; or\n(b) the goods are exempt goods; or\n(ba) the goods are exempt under section 18A; or\n(c) the goods are the subject of an approval or authority under\nsection 19; or\n(d) the goods are the subject of an approval under section 19A.\nPenalty: 120 penalty units."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-21-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
