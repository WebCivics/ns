    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15ab",
      "@type": "cml:Concept",
      "skos:prefLabel": "15AB Conditions relating to exceptional release of biologicals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-15ab"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.87",
      "values:originalText": "(1) Regulations made for the purposes of paragraphs 14(9A)(b) and\n14A(2A)(b) may also prescribe conditions that apply in relation to\nthe supply of a biological that occurs after the circumstances\nprescribed for the purposes of those paragraphs have occurred.\n(2) The conditions prescribed by those regulations must apply only to\nthe person supplying the biological.\n(3) A person commits an offence if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission results in the breach of any of the\nconditions referred to in subsection (1).\nPenalty for contravention of this subsection:60 penalty units.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) Regulations made for the purposes of paragraphs 14(9A)(b) and\n14A(2A)(b) may also prescribe conditions that apply in relation to\nthe supply of a biological that occurs after the circumstances\nprescribed for the purposes of those paragraphs have occurred.\n(2) The conditions prescribed by those regulations must apply only to\nthe person supplying the biological.\n(3) A person commits an offence if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission results in the breach of any of the\nconditions referred to in subsection (1).\nPenalty for contravention of this subsection:60 penalty units.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-15ab-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-15ab-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-15ab-ss-3"
        }
      ],
      "cml:integrityHash": "0ff8a6346bbed33d2e448eb85becb358edbb9353f487f1dff39717e7f0f61b11"
    },
