      "cml:logicSummary": "Payment of evaluation fee by instalments is not allowed if part of an instalment is unpaid.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Regulations made for the purposes of subsection (1) may provide that a person is not allowed to pay an evaluation fee under section 24 by instalments..."
    },
