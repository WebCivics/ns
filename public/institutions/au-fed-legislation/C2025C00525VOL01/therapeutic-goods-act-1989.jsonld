    {
      "@id": "concept:therapeutic-goods-act-1989-sec-22g-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "22G(5) Scientific advice about aspects of quality, safety or efficacy of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-22g-ss-5"
