    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-3ab-ss-2",
      "@type": "cof:Section",
      "cof:title": "3AB(2) Anthroposophic preparations and anthroposophic standards",
      "values:kind": "subsection",
      "cof:pageNumber": 41,
      "values:originalText": "(2) For the purposes of this Act, if:\n(a) there are therapeutic goods that are an anthroposophic\npreparation; and\n(b) the goods are the subject of one or more monographs (other\nthan a monograph exempt under subsection (4)) in the\nanthroposophic pharmacopoeia describing the manufacturing\nprocedure that the preparation was manufactured in\naccordance with;\nthen there is an anthroposophic standard, in relation to the goods,\nthat is constituted by the statements (other than statements exempt\nunder subsection (5)) in those monographs, as interpreted in\naccordance with any interpretation sections of that anthroposophic\npharmacopoeia.\nSpecifying publications"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3ab-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-3ab-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3ab-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "constitutes",
      "cml:logicSummary": "Anthroposophic standard is constituted by statements in monographs",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
