    {
      "@id": "concept:therapeutic-goods-act-1989-sec-15aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "15AA Civil penalty relating to breaching a condition of a consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-15aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.87",
      "values:originalText": "A person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a condition of a consent\nimposed under section 15.\nMaximum civil penalty:\n(a) for an individual—3,000 penalty units; and\n(b) for a body corporate—30,000 penalty units.",
      "skos:definition": "A person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a condition of a consent\nimposed under section 15.\nMaximum civil penalty:\n(a) for an individual—3,000 penalty units; and\n(b) for a body corporate—30,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-15aa-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-15aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "403b5a583aea68df9f5daef94dd707ce3350b594a6a1d12ba820d54c616294d0",
      "skos:note": "Breach of consent condition results in civil penalty"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-15aa",
      "@type": "cof:Section",
      "cof:title": "15AA Civil penalty relating to breaching a condition of a consent",
      "values:kind": "section",
      "cof:pageNumber": 87,
      "values:originalText": "A person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a condition of a consent\nimposed under section 15.\nMaximum civil penalty:\n(a) for an individual—3,000 penalty units; and\n(b) for a body corporate—30,000 penalty units."
    },
