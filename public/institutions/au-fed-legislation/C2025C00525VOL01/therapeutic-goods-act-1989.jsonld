    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32eg",
      "@type": "cml:Concept",
      "skos:prefLabel": "32EG Civil penalty for breach of condition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32eg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.348",
      "values:originalText": "A person contravenes this section if:\n(a) a biological is included in the Register in relation to the\nperson; and\n(b) the person does an act or omits to do an act; and\n(c) the act or omission breaches a condition of the inclusion of\nthe biological in the Register.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nSuspension from the Register  Division 6\nSection 32F\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "A person contravenes this section if:\n(a) a biological is included in the Register in relation to the\nperson; and\n(b) the person does an act or omits to do an act; and\n(c) the act or omission breaches a condition of the inclusion of\nthe biological in the Register.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nSuspension from the Register  Division 6\nSection 32F\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32eg-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32eg-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32eg-logic-deontic-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32eg-logic-linearlogic-3"
