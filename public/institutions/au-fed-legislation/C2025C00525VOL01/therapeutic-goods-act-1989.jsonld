    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30f-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Classification of goods as not conforming to a standard or being unfit for their intended purposes using artificial intelligence.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) do not conform to a standard applicable to goods of that kind; or (ii) are otherwise not fit to be used for their intended purposes.",
      "cml:conclusionText": "...are classified as not conforming to a standard or being unfit for their intended purposes."
    },
