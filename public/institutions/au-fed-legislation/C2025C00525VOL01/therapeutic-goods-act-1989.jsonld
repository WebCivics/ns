      },
      "cml:premiseText": "The person contravenes subsection 32DQ(1) or (2) in relation to the biological.",
      "cml:conclusionText": "The person must comply with regulatory requirements."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gc-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "32GC(2) Cancellation of biological from the Register after notice of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32gc-ss-2"
      },
      "cml:curationStatus": {
