    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "32DS(2) Consultation with Gene Technology Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ds-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
