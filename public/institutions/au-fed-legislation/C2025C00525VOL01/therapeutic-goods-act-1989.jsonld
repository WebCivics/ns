    {
      "@id": "concept:therapeutic-goods-act-1989-sec-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "3A Declaration—member of European Community",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-3a"
      },
      "cml:curationStatus": {
