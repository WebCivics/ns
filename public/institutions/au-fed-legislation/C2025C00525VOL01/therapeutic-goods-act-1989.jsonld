      "cml:integrityHash": "e9f53174d8ad57b088ad813529cbf7682e47916a6aa4cde79536c51b5b4a29a4",
      "skos:note": "Secretary's consent may be given unconditionally or subject to conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-15-ss-1",
      "@type": "cof:Section",
      "cof:title": "15(1) Criminal offences relating to breaching a condition of a consent",
      "values:kind": "subsection",
      "cof:pageNumber": 86,
      "values:originalText": "(1) The consent of the Secretary under section 14 or 14A may be\ngiven:\n(a) unconditionally or subject to conditions; or\n(b) in respect of particular goods or classes of goods."
    },
