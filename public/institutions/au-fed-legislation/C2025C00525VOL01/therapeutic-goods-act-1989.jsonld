    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.259",
      "values:originalText": "This Part regulates biologicals. It does this by providing a process\nfor including biologicals in the Register and providing for\nenforcement through criminal offences and civil penalties.\nThis Part provides for the following administrative processes:\n(a)\nexempting biologicals from the requirement to be\nincluded in the Register;\n(b)\nmaking the inclusion of biologicals in the Register\nsubject to conditions;\n(c)\nsuspending or cancelling entries of biologicals from the\nRegister;\n(d)\nrequiring public notification of problems with\nbiologicals, and recall of biologicals;\n(e)\nobtaining information or documents about biologicals.",
      "skos:definition": "This Part regulates biologicals. It does this by providing a process\nfor including biologicals in the Register and providing for\nenforcement through criminal offences and civil penalties.\nThis Part provides for the following administrative processes:\n(a)\nexempting biologicals from the requirement to be\nincluded in the Register;\n(b)\nmaking the inclusion of biologicals in the Register\nsubject to conditions;\n(c)\nsuspending or cancelling entries of biologicals from the\nRegister;\n(d)\nrequiring public notification of problems with\nbiologicals, and recall of biologicals;\n(e)\nobtaining information or documents about biologicals.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32-logic-linearlogic-2"
        }
      ],
      "cml:integrityHash": "d9a8a890a88c4335375c74126e592e00162f9ef87ec76e1c65f8a053958d2965",
      "skos:note": "Regulates biologicals by providing a process for inclusion in the Register and enforcement through criminal offences and civil penalties."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 259,
      "values:originalText": "This Part regulates biologicals. It does this by providing a process\nfor including biologicals in the Register and providing for\nenforcement through criminal offences and civil penalties.\nThis Part provides for the following administrative processes:\n(a)\nexempting biologicals from the requirement to be\nincluded in the Register;\n(b)\nmaking the inclusion of biologicals in the Register\nsubject to conditions;\n(c)\nsuspending or cancelling entries of biologicals from the\nRegister;\n(d)\nrequiring public notification of problems with\nbiologicals, and recall of biologicals;\n(e)\nobtaining information or documents about biologicals."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
