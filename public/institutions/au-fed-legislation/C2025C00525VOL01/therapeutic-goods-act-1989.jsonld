      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ee-ss-3a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal constraint",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The earlier day must not be earlier than the given day.",
      "cml:conclusionText": "The notice must be given on or after the given day."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ee-ss-3a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Temporal relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The earlier day is a temporal interval before the given day.",
      "cml:conclusionText": "The notice must be given on or after the day before the given day."
    },
