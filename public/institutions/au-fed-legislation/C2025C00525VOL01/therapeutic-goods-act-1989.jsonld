    {
      "@id": "concept:therapeutic-goods-act-1989-sec-22b",
      "@type": "cml:Concept",
      "skos:prefLabel": "22B Civil penalty for false statements in applications for registration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-22b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.132",
      "values:originalText": "A person contravenes this section if the person in or in connection\nwith an application for registration of therapeutic goods, makes a\nstatement that is false or misleading in a material particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nProvisional determinations for medicine  Division 1A\nSection 22C\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "A person contravenes this section if the person in or in connection\nwith an application for registration of therapeutic goods, makes a\nstatement that is false or misleading in a material particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nProvisional determinations for medicine  Division 1A\nSection 22C\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22b-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1a762350399cc1c40c28a02315063a9ed2fe57a68b0824e2c1261159b1befd30",
      "skos:note": "False statements in applications for registration are prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-22b",
      "@type": "cof:Section",
      "cof:title": "22B Civil penalty for false statements in applications for registration",
      "values:kind": "section",
      "cof:pageNumber": 132,
      "values:originalText": "A person contravenes this section if the person in or in connection\nwith an application for registration of therapeutic goods, makes a\nstatement that is false or misleading in a material particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nProvisional determinations for medicine  Division 1A\nSection 22C\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-22b-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-22b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-22b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of false statements",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-22c",
      "@type": "cml:Concept",
      "skos:prefLabel": "22C Applications for provisional determination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-22c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.133",
      "values:originalText": "(1) A person may make an application to the Secretary for a\nprovisional determination relating to a medicine of a kind\nprescribed by the regulations for the purposes of this subsection.\nNote:\nIf the Secretary makes the determination, the person applies under\nsection 23 for registration of the medicine and that application passes\npreliminary assessment, then a different kind of evaluation of the\nmedicine will occur under section 25.\n(2) An application under subsection (1) must:\n(a) be made in accordance with a form approved, in writing, by\nthe Secretary; and\n(b) be accompanied by the prescribed application fee; and\n(c) contain the information that the form requires, and any\nfurther information, statement or document the Secretary\nrequires, whether in the form or otherwise; and\n(d) satisfy any other requirement prescribed by the regulations\nfor the purposes of this paragraph.\n(3) An approval of a form may require or permit an application or\ninformation to be given in accordance with specified software\nrequirements:\n(a) on a specified kind of data processing device; or\n(b) by way of a specified kind of electronic transmission.",
      "skos:definition": "(1) A person may make an application to the Secretary for a\nprovisional determination relating to a medicine of a kind\nprescribed by the regulations for the purposes of this subsection.\nNote:\nIf the Secretary makes the determination, the person applies under\nsection 23 for registration of the medicine and that application passes\npreliminary assessment, then a different kind of evaluation of the\nmedicine will occur under section 25.\n(2) An application under subsection (1) must:\n(a) be made in accordance with a form approved, in writing, by\nthe Secretary; and\n(b) be accompanied by the prescribed application fee; and\n(c) contain the information that the form requires, and any\nfurther information, statement or document the Secretary\nrequires, whether in the form or otherwise; and\n(d) satisfy any other requirement prescribed by the regulations\nfor the purposes of this paragraph.\n(3) An approval of a form may require or permit an application or\ninformation to be given in accordance with specified software\nrequirements:\n(a) on a specified kind of data processing device; or\n(b) by way of a specified kind of electronic transmission.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22c-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22c-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-22c-ss-3"
        }
      ],
      "cml:integrityHash": "1eb53e3d147ce6f2941ae962e99c2b1e415078d8681d243dda66ed576757f91f"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-22c",
      "@type": "cof:Section",
      "cof:title": "22C Applications for provisional determination",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "(1) A person may make an application to the Secretary for a\nprovisional determination relating to a medicine of a kind\nprescribed by the regulations for the purposes of this subsection.\nNote:\nIf the Secretary makes the determination, the person applies under\nsection 23 for registration of the medicine and that application passes\npreliminary assessment, then a different kind of evaluation of the\nmedicine will occur under section 25.\n(2) An application under subsection (1) must:\n(a) be made in accordance with a form approved, in writing, by\nthe Secretary; and\n(b) be accompanied by the prescribed application fee; and\n(c) contain the information that the form requires, and any\nfurther information, statement or document the Secretary\nrequires, whether in the form or otherwise; and\n(d) satisfy any other requirement prescribed by the regulations\nfor the purposes of this paragraph.\n(3) An approval of a form may require or permit an application or\ninformation to be given in accordance with specified software\nrequirements:\n(a) on a specified kind of data processing device; or\n(b) by way of a specified kind of electronic transmission."
    },
