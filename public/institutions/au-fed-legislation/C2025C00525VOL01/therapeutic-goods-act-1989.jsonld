      ],
      "cml:integrityHash": "d97606b3646e0c55b11f306658674f3ce38bb019beaa2267212f86b749c46fc1",
      "skos:note": "Failure to comply with notice requirement is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cj-ss-7",
      "@type": "cof:Section",
      "cof:title": "32CJ(7) Criminal offences and civil penalty for biologicals not",
      "values:kind": "subsection",
