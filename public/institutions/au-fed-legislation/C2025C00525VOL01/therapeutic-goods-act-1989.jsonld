    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "26BA Approved form for notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26ba"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.180",
      "values:originalText": "An approval of a form for a notice for the purposes of\nsubsection 25AB(3), 26(1), 26A(1) or 26AE(5) may require or\npermit the notice to be given in accordance with specified software\nrequirements:\n(a) on a specified kind of data processing device; or\n(b) by way of a specified kind of electronic transmission.",
      "skos:definition": "An approval of a form for a notice for the purposes of\nsubsection 25AB(3), 26(1), 26A(1) or 26AE(5) may require or\npermit the notice to be given in accordance with specified software\nrequirements:\n(a) on a specified kind of data processing device; or\n(b) by way of a specified kind of electronic transmission.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26ba-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26ba-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-26ba-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "107fe1080d93d8dcb19b8cbd489e47095a2c992666a2796b36e35ec7004a1e6e",
      "skos:note": "Permits notice to be given in accordance with specified software requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26ba",
      "@type": "cof:Section",
      "cof:title": "26BA Approved form for notices",
      "values:kind": "section",
      "cof:pageNumber": 180,
      "values:originalText": "An approval of a form for a notice for the purposes of\nsubsection 25AB(3), 26(1), 26A(1) or 26AE(5) may require or\npermit the notice to be given in accordance with specified software\nrequirements:\n(a) on a specified kind of data processing device; or\n(b) by way of a specified kind of electronic transmission."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26ba-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-26ba"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26ba-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "hasClass",
      "cml:logicSummary": "Defines a class for notices",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
