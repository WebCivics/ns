    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30eb",
      "@type": "cml:Concept",
      "skos:prefLabel": "30EB Publication of requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30eb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.225",
      "values:originalText": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after imposing a\nrequirement under section 30EA, a notice setting out particulars of\nthe requirement.",
      "skos:definition": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after imposing a\nrequirement under section 30EA, a notice setting out particulars of\nthe requirement.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30eb-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30eb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6a70553c8ba374b646e76201e821ab7a6738d0f477c89994bc75deb29fdccf39",
      "skos:note": "Secretary must publish notice after imposing requirement.",
      "dc:description": "Notice setting out particulars of the requirement"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30eb",
      "@type": "cof:Section",
      "cof:title": "30EB Publication of requirements",
      "values:kind": "section",
      "cof:pageNumber": 225,
      "values:originalText": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after imposing a\nrequirement under section 30EA, a notice setting out particulars of\nthe requirement."
    },
