    {
      "@id": "concept:therapeutic-goods-act-1989-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Registration or listing number",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.195",
      "values:originalText": "(1) Where the Secretary includes therapeutic goods (other than\ngrouped therapeutic goods) in the Register, the Secretary is to\nassign a unique registration or listing number to the goods.\n(2) Where the Secretary includes grouped therapeutic goods in the\nRegister, the Secretary is to assign a single, unique registration or\nlisting number to the grouped therapeutic goods.",
      "skos:definition": "(1) Where the Secretary includes therapeutic goods (other than\ngrouped therapeutic goods) in the Register, the Secretary is to\nassign a unique registration or listing number to the goods.\n(2) Where the Secretary includes grouped therapeutic goods in the\nRegister, the Secretary is to assign a single, unique registration or\nlisting number to the grouped therapeutic goods.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-27-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-27-ss-2"
        }
      ],
      "cml:integrityHash": "84b3227dc5c9ac99cf6efb299866b04b30f103f73636f21d97dfd444e12a6c42"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Registration or listing number",
      "values:kind": "section",
      "cof:pageNumber": 195,
      "values:originalText": "(1) Where the Secretary includes therapeutic goods (other than\ngrouped therapeutic goods) in the Register, the Secretary is to\nassign a unique registration or listing number to the goods.\n(2) Where the Secretary includes grouped therapeutic goods in the\nRegister, the Secretary is to assign a single, unique registration or\nlisting number to the grouped therapeutic goods."
    },
