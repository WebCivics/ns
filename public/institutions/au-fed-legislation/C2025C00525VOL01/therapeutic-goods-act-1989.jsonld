    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32hf",
      "@type": "cml:Concept",
      "skos:prefLabel": "32HF Saving of other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32hf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.365",
      "values:originalText": "This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or any law of a State or\nTerritory.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or any law of a State or\nTerritory.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32hf-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32hf-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d60e452d40d4d8c4426e32e3f836a586f2a94e7ff1468a6edf7dd0a4fff87758",
      "skos:note": "No exclusion or limitation of other laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32hf",
      "@type": "cof:Section",
      "cof:title": "32HF Saving of other laws",
      "values:kind": "section",
      "cof:pageNumber": 365,
      "values:originalText": "This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or any law of a State or\nTerritory.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
