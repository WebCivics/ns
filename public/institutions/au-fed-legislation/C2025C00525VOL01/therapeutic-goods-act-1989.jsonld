          "@id": "concept:therapeutic-goods-act-1989-sec-32eg-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "7fa8daa875f693606dac1f66e80cc1c841475b7bfa27a433726c47ffd1113418",
      "skos:note": "Civil penalty for breach of condition"
    },
    {
