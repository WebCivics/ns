    {
      "@id": "concept:therapeutic-goods-act-1989-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Manufacturing principles",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.385",
      "values:originalText": "(1) The Minister may, from time to time, determine written principles\nto be observed in the manufacture of therapeutic goods for use in\nhumans.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) The Minister may, from time to time, determine written principles\nto be observed in the manufacture of therapeutic goods for use in\nhumans.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-36-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "72cf1a68212b3c8fd3686d80789139dee349192aa9ba572146cea7da9d7ff879",
      "skos:note": "The Minister may determine written principles for the manufacture of therapeutic goods."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Manufacturing principles",
      "values:kind": "section",
      "cof:pageNumber": 385,
      "values:originalText": "(1) The Minister may, from time to time, determine written principles\nto be observed in the manufacture of therapeutic goods for use in\nhumans.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
