    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32dp",
      "@type": "cml:Concept",
      "skos:prefLabel": "32DP Civil penalty for false statements in applications for including",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.335",
      "values:originalText": "biologicals in the Register\nA person contravenes this section if the person in, or in connection\nwith, an application for inclusion of a biological in the Register,\nmakes a statement that is false or misleading in a material\nparticular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "biologicals in the Register\nA person contravenes this section if the person in, or in connection\nwith, an application for inclusion of a biological in the Register,\nmakes a statement that is false or misleading in a material\nparticular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dp-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dp-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b48caf5e8f12bcfef45d2983b175ffba1bba31d96c654fa06b18c89ab8610697",
      "skos:note": "False statements in applications for inclusion of biologicals in the Register"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dp",
      "@type": "cof:Section",
      "cof:title": "32DP Civil penalty for false statements in applications for including",
      "values:kind": "section",
      "cof:pageNumber": 335,
      "values:originalText": "biologicals in the Register\nA person contravenes this section if the person in, or in connection\nwith, an application for inclusion of a biological in the Register,\nmakes a statement that is false or misleading in a material\nparticular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
