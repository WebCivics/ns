    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9m",
      "@type": "cml:Concept",
      "skos:prefLabel": "9M Application of Customs Act 1901",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.73",
      "values:originalText": "If:\n(a) the importation or exportation of goods is an offence under\nsubsection 9L(1) or a contravention of subsection 9L(2); and\n(b) the Secretary notifies the Comptroller-General of Customs in\nwriting that the Secretary wishes the Customs Act 1901 to\napply to that importation or exportation;\nthe Customs Act 1901 has effect as if the goods included in that\nimportation or exportation were goods described as forfeited to the\nCrown under section 229 of that Act because they were:\n(c) prohibited imports within the meaning of that Act; or\n(d) prohibited exports within the meaning of that Act;\nas the case requires.",
      "skos:definition": "If:\n(a) the importation or exportation of goods is an offence under\nsubsection 9L(1) or a contravention of subsection 9L(2); and\n(b) the Secretary notifies the Comptroller-General of Customs in\nwriting that the Secretary wishes the Customs Act 1901 to\napply to that importation or exportation;\nthe Customs Act 1901 has effect as if the goods included in that\nimportation or exportation were goods described as forfeited to the\nCrown under section 229 of that Act because they were:\n(c) prohibited imports within the meaning of that Act; or\n(d) prohibited exports within the meaning of that Act;\nas the case requires.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9m-norm"
        }
      ],
      "cml:integrityHash": "973b96a65206bf65b02d38f9d6ac5cb0952713650c14bc704280eb1391e3b022",
      "skos:note": "Customs Act 1901 applies to prohibited imports or exports if notified by Secretary."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9m",
      "@type": "cof:Section",
      "cof:title": "9M Application of Customs Act 1901",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "If:\n(a) the importation or exportation of goods is an offence under\nsubsection 9L(1) or a contravention of subsection 9L(2); and\n(b) the Secretary notifies the Comptroller-General of Customs in\nwriting that the Secretary wishes the Customs Act 1901 to\napply to that importation or exportation;\nthe Customs Act 1901 has effect as if the goods included in that\nimportation or exportation were goods described as forfeited to the\nCrown under section 229 of that Act because they were:\n(c) prohibited imports within the meaning of that Act; or\n(d) prohibited exports within the meaning of that Act;\nas the case requires."
    },
