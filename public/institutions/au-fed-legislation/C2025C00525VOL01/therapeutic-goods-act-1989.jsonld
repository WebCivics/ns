      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Secretary must evaluate therapeutic goods for registration.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
