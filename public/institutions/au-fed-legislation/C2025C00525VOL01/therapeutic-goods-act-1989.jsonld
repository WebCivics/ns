      "skos:definition": "(4) An offence under subsection (2) is an offence of strict liability.\nNote:\nFor strict liability, see section 6.1 of the Criminal Code.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-8"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-8-ss-4-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-8-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2f4c062b4d9fcbf735959fc2360ecd2f7f01ab3c9ccdd23ad5ec0dada4a827c6",
      "skos:note": "An offence under subsection (2) is an obligation."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-8-ss-4",
      "@type": "cof:Section",
      "cof:title": "8(4) Power to obtain information with respect to therapeutic goods",
      "values:kind": "subsection",
      "cof:pageNumber": 55,
      "values:originalText": "(4) An offence under subsection (2) is an offence of strict liability.\nNote:\nFor strict liability, see section 6.1 of the Criminal Code."
    },
