    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bc",
      "@type": "cml:Concept",
      "skos:prefLabel": "26BC Variation of determination under section 26BB—Minister’s",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26bc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.181",
      "values:originalText": "initiative\nThe Minister may, on his or her own initiative and by legislative\ninstrument, vary a determination under section 26BB.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "initiative\nThe Minister may, on his or her own initiative and by legislative\ninstrument, vary a determination under section 26BB.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
