        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-2c-logic-alleninterval-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-2c-logic-ltl-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-2c-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "57cad66c5a121bdd6d17126d128b102867b3fda0335e6482d08e76b62fb6089b",
      "skos:note": "Secretary must vary entry in Register upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-2c",
      "@type": "cof:Section",
      "cof:title": "9D(2C) Variation of entries in Register",
      "values:kind": "subsection",
      "cof:pageNumber": 59,
      "values:originalText": "(2C) If:\n(a) the person in relation to whom therapeutic goods are\nregistered or listed has requested the Secretary to vary the\nentry in the Register that relates to the goods; and\n(b) the variation is of a kind specified in the regulations; and\n(c) the conditions (if any) specified in the regulations are\nsatisfied;\nthe Secretary must vary the entry in accordance with the request."
    },
