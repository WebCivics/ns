    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cj-ss-5",
      "@type": "cof:Section",
      "cof:title": "32CJ(5) Criminal offences and civil penalty for biologicals not",
      "values:kind": "subsection",
      "cof:pageNumber": 294,
      "values:originalText": "(5) A notice given under subsection (2) is not a legislative instrument.\nOffences"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
