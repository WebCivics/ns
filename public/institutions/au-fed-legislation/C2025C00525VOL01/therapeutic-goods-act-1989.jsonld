    {
      "@id": "concept:therapeutic-goods-act-1989-sec-19d",
      "@type": "cml:Concept",
      "skos:prefLabel": "19D Civil penalties relating to registration or listing etc. of imported,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-19d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.111",
      "values:originalText": "exported, manufactured and supplied therapeutic goods\nCivil penalty relating to importing, exporting, manufacturing or\nsupplying goods for use in humans\n(1) A person contravenes this subsection if:\n(a) the person does any of the following:\n(i) imports into Australia therapeutic goods for use in\nhumans;\n(ii) exports from Australia therapeutic goods for use in\nhumans;\n(iii) manufactures in Australia therapeutic goods for use in\nhumans;\n(iv) supplies in Australia therapeutic goods for use in\nhumans; and\n(b) none of the following subparagraphs applies in relation to the\ngoods:\n(i) the goods are registered goods or listed goods in relation\nto the person;\n(ii) the goods are exempt goods;\n(iii) the goods are exempt under section 18A;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "exported, manufactured and supplied therapeutic goods\nCivil penalty relating to importing, exporting, manufacturing or\nsupplying goods for use in humans\n(1) A person contravenes this subsection if:\n(a) the person does any of the following:\n(i) imports into Australia therapeutic goods for use in\nhumans;\n(ii) exports from Australia therapeutic goods for use in\nhumans;\n(iii) manufactures in Australia therapeutic goods for use in\nhumans;\n(iv) supplies in Australia therapeutic goods for use in\nhumans; and\n(b) none of the following subparagraphs applies in relation to the\ngoods:\n(i) the goods are registered goods or listed goods in relation\nto the person;\n(ii) the goods are exempt goods;\n(iii) the goods are exempt under section 18A;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-19d-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-19d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "59dab709ccb4e7fa63b38d836473d44d9caed4b97b62abf5b77fbc560f14b7d9",
      "skos:note": "Importing, exporting, manufacturing or supplying therapeutic goods for use in humans is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-19d",
      "@type": "cof:Section",
      "cof:title": "19D Civil penalties relating to registration or listing etc. of imported,",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "exported, manufactured and supplied therapeutic goods\nCivil penalty relating to importing, exporting, manufacturing or\nsupplying goods for use in humans\n(1) A person contravenes this subsection if:\n(a) the person does any of the following:\n(i) imports into Australia therapeutic goods for use in\nhumans;\n(ii) exports from Australia therapeutic goods for use in\nhumans;\n(iii) manufactures in Australia therapeutic goods for use in\nhumans;\n(iv) supplies in Australia therapeutic goods for use in\nhumans; and\n(b) none of the following subparagraphs applies in relation to the\ngoods:\n(i) the goods are registered goods or listed goods in relation\nto the person;\n(ii) the goods are exempt goods;\n(iii) the goods are exempt under section 18A;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-19d-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-19d"
      },
