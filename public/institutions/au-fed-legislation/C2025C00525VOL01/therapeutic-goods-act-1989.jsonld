    {
      "@id": "concept:therapeutic-goods-act-1989-sec-38a",
      "@type": "cml:Concept",
      "skos:prefLabel": "38A Guidelines for multi-site licences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-38a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.391",
      "values:originalText": "The Secretary must, by legislative instrument, make guidelines\nsetting out the circumstances in which a licence may cover 2 or\nmore manufacturing sites.",
      "skos:definition": "The Secretary must, by legislative instrument, make guidelines\nsetting out the circumstances in which a licence may cover 2 or\nmore manufacturing sites.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-38a-norm"
        }
      ],
      "cml:integrityHash": "e400ba6304d4a70588635168adb1ab7598bffca80dbc120fe43d7f9fce1134f0",
      "skos:note": "The Secretary must make guidelines for multi-site licences."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-38a",
      "@type": "cof:Section",
      "cof:title": "38A Guidelines for multi-site licences",
      "values:kind": "section",
      "cof:pageNumber": 391,
      "values:originalText": "The Secretary must, by legislative instrument, make guidelines\nsetting out the circumstances in which a licence may cover 2 or\nmore manufacturing sites."
    },
