    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-2c",
      "@type": "cml:Concept",
      "skos:prefLabel": "9D(2C) Variation of entries in Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-2c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
