      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.236",
      "values:originalText": "(5) Unless sooner revoked, an instrument under subsection (1) remains\nin force for the period specified in the instrument.\nNote:\nFor variation, see subsection 33(3) of the Acts Interpretation Act 1901.",
      "skos:definition": "(5) Unless sooner revoked, an instrument under subsection (1) remains\nin force for the period specified in the instrument.\nNote:\nFor variation, see subsection 33(3) of the Acts Interpretation Act 1901.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-30ek"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30ek-ss-5-norm"
        }
      ],
      "cml:integrityHash": "03c7a4fbec5a96cb32536c7060d85a52b116d1ecd0ef680d99131211dc80f760",
      "skos:note": "Instrument remains in force for a specified period unless revoked."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ek-ss-5",
      "@type": "cof:Section",
      "cof:title": "30EK(5) Minister may declare a serious scarcity of medicine",
      "values:kind": "subsection",
