      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "9D(8) Variation of entries in Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.59",
      "values:originalText": "(8) The Secretary may, by legislative instrument, determine a kind of\ninformation for the purposes of subparagraph (7)(g)(i).\nNote:\nSee also subsection 33(3A) of the Acts Interpretation Act 1901.",
      "skos:definition": "(8) The Secretary may, by legislative instrument, determine a kind of\ninformation for the purposes of subparagraph (7)(g)(i).\nNote:\nSee also subsection 33(3A) of the Acts Interpretation Act 1901.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-9d"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-8-norm"
        }
      ],
      "cml:integrityHash": "c8acdfa9eebc15a9477630719dd06bd48300858ef11776cca53a6109aa38b695",
      "skos:note": "The Secretary may determine a kind of information for the purposes of subparagraph (7)(g)(i)."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-8",
      "@type": "cof:Section",
