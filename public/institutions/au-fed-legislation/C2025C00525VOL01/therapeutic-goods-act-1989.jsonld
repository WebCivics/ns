    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cm-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "32CM(4) Authorities for health practitioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cm-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.300",
      "values:originalText": "(4) An authority under subsection (1) may only be given to a medical\npractitioner:\n(a) who is included in a class of medical practitioners prescribed\nby the regulations for the purposes of this paragraph; and\n(b) who has the approval of an ethics committee to supply the\nspecified biological.\nParagraph (b) does not apply in the circumstances (if any)\nprescribed by the regulations for the purposes of this subsection.",
      "skos:definition": "(4) An authority under subsection (1) may only be given to a medical\npractitioner:\n(a) who is included in a class of medical practitioners prescribed\nby the regulations for the purposes of this paragraph; and\n(b) who has the approval of an ethics committee to supply the\nspecified biological.\nParagraph (b) does not apply in the circumstances (if any)\nprescribed by the regulations for the purposes of this subsection.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32cm"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32cm-ss-4-norm"
        },
