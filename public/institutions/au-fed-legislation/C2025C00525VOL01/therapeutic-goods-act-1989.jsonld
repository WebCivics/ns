          "@id": "concept:therapeutic-goods-act-1989-sec-19-ss-1a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-19-ss-1a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fdeda0cb1012356e741509244d21cb2c05e18bcaba6b6fa927f2c5efaa52455b",
      "skos:note": "Approval conditions are subject to additional regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-19-ss-1a",
      "@type": "cof:Section",
      "cof:title": "19(1A) Approvals or authorities for certain uses",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(1A) An approval mentioned in paragraph (1)(a) or (b) is subject to the\nconditions (if any) specified in the regulations for the purposes of\nthat paragraph. Those conditions (if any) are in addition to any\nconditions imposed on the approval under subsection (1)."
    },
