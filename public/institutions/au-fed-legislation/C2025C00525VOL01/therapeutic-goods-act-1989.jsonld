    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35c",
      "@type": "cml:Concept",
      "skos:prefLabel": "35C Civil penalty relating to breaching a condition of a licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-35c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.385",
      "values:originalText": "A person contravenes this section if:\n(a) the person holds a licence; and\n(b) the person does an act or omits to do an act; and\n(c) the act or omission breaches a condition of the licence.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "A person contravenes this section if:\n(a) the person holds a licence; and\n(b) the person does an act or omits to do an act; and\n(c) the act or omission breaches a condition of the licence.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-35c-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-35c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "671e5d890c39839dbd99093eb324ea5ebca9dae4d723ac6e4c9f63cc6d7c7bfb",
      "skos:note": "Breach of licence condition results in civil penalty"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-35c",
      "@type": "cof:Section",
      "cof:title": "35C Civil penalty relating to breaching a condition of a licence",
      "values:kind": "section",
      "cof:pageNumber": 385,
      "values:originalText": "A person contravenes this section if:\n(a) the person holds a licence; and\n(b) the person does an act or omits to do an act; and\n(c) the act or omission breaches a condition of the licence.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
