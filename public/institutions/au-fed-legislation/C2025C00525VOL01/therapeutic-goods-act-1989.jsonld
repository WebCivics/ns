      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.17",
      "values:originalText": "This Act may be cited as the Therapeutic Goods Act 1989.",
      "skos:definition": "This Act may be cited as the Therapeutic Goods Act 1989.",
      "cml:asserts": [
