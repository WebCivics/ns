    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gc-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary may cancel the entry of the biological from the Register.",
      "cml:conclusionText": "The person must not include the biological in the Register."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gc-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of advertising",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person contravenes subsection 32DQ(1) or (2) in relation to the biological.",
      "cml:conclusionText": "The person must not advertise the biological."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gc-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of advertising by related body corporate",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the person is a body corporate, a related body corporate contravenes a direction or condition given to the related body corporate under subsection 42DV(1) in relation to the advertising of the biological.",
      "cml:conclusionText": "The related body corporate must not advertise the biological."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gc-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of non-compliance with Therapeutic Goods Advertising Code",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Either of the following has not been complied with in relation to the biological: an applicable provision of the Therapeutic Goods Advertising Code; any other requirement relating to advertising applicable under Part 5-1 or under the regulations.",
      "cml:conclusionText": "The person must comply with the Therapeutic Goods Advertising Code."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gc-ss-1-logic-deontic-5",
