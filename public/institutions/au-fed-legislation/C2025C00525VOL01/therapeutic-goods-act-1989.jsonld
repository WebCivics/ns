      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to make exemptions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
