    {
      "@id": "concept:therapeutic-goods-act-1989-sec-23a",
      "@type": "cml:Concept",
      "skos:prefLabel": "23A Classes of therapeutic goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-23a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
