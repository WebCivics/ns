      ],
      "cml:integrityHash": "ebfadb98d821e301989e579a6841f062804b3dad877bf932b809869290444005",
      "skos:note": "Supplying a biological without authorization is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cn-ss-4a",
      "@type": "cof:Section",
      "cof:title": "32CN(4A) Criminal offences relating to the giving of an authority to a",
      "values:kind": "subsection",
      "cof:pageNumber": 302,
      "values:originalText": "(4A) A person commits an offence if:\n(a) the Secretary has authorised, under subsection 32CM(1), the\nperson to supply a biological; and\n(b) the person supplies the biological; and\n(c) either of the following applies:\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
