    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32dg",
      "@type": "cml:Concept",
      "skos:prefLabel": "32DG Refusal to include biological in the Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.328",
      "values:originalText": "If:\n(a) an application is made under section 32DD to include a\nbiological in the Register; and\n(aa) the application has passed preliminary assessment; and\n(b) the Secretary refuses the application;\nthe Secretary must, as soon as practicable after the refusal, give the\nperson notice of the refusal and of the reasons for the refusal.",
      "skos:definition": "If:\n(a) an application is made under section 32DD to include a\nbiological in the Register; and\n(aa) the application has passed preliminary assessment; and\n(b) the Secretary refuses the application;\nthe Secretary must, as soon as practicable after the refusal, give the\nperson notice of the refusal and of the reasons for the refusal.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dg-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dg-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35d6590932023d91330c68b047f37499e2bf4593bab974bf4dbfaf5806d3373d",
      "skos:note": "Secretary must provide notice after refusing application to include biological in the Register.",
      "dc:description": "Notice of refusal and reasons for refusal"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dg",
      "@type": "cof:Section",
      "cof:title": "32DG Refusal to include biological in the Register",
      "values:kind": "section",
      "cof:pageNumber": 328,
      "values:originalText": "If:\n(a) an application is made under section 32DD to include a\nbiological in the Register; and\n(aa) the application has passed preliminary assessment; and\n(b) the Secretary refuses the application;\nthe Secretary must, as soon as practicable after the refusal, give the\nperson notice of the refusal and of the reasons for the refusal."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32dg-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32dg"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32dg-logic-deontic-1",
