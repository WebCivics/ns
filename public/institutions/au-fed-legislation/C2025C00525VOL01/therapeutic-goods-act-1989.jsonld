    {
      "@id": "concept:therapeutic-goods-act-1989-sec-19-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "19(1A) Approvals or authorities for certain uses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-19-ss-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.96",
      "values:originalText": "(1A) An approval mentioned in paragraph (1)(a) or (b) is subject to the\nconditions (if any) specified in the regulations for the purposes of\nthat paragraph. Those conditions (if any) are in addition to any\nconditions imposed on the approval under subsection (1).",
      "skos:definition": "(1A) An approval mentioned in paragraph (1)(a) or (b) is subject to the\nconditions (if any) specified in the regulations for the purposes of\nthat paragraph. Those conditions (if any) are in addition to any\nconditions imposed on the approval under subsection (1).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-19"
      },
      "cml:asserts": [
