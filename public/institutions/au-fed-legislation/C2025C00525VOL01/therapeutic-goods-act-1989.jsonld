    {
      "@id": "concept:therapeutic-goods-act-1989-sec-24d",
      "@type": "cml:Concept",
      "skos:prefLabel": "24D Refund of evaluation fee where evaluation not completed within",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-24d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.148",
      "values:originalText": "prescribed period\n(1) This section applies to an application under section 23 in relation\nto therapeutic goods for the evaluation of which a period is\nprescribed under paragraph 63(2)(da).\n(2) If:\n(a) the applicant has paid the whole of the evaluation fee; and\n(b) the evaluation is completed, but not within the period\nreferred to in subsection (1);\nthen 25% of the evaluation fee must be refunded to the applicant.\n(3) For the purposes of subsection (2), the evaluation is taken to be\ncompleted when the applicant is notified of the Secretary’s\ndecision under subsection 25(3) in relation to the goods.",
      "skos:definition": "prescribed period\n(1) This section applies to an application under section 23 in relation\nto therapeutic goods for the evaluation of which a period is\nprescribed under paragraph 63(2)(da).\n(2) If:\n(a) the applicant has paid the whole of the evaluation fee; and\n(b) the evaluation is completed, but not within the period\nreferred to in subsection (1);\nthen 25% of the evaluation fee must be refunded to the applicant.\n(3) For the purposes of subsection (2), the evaluation is taken to be\ncompleted when the applicant is notified of the Secretary’s\ndecision under subsection 25(3) in relation to the goods.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-24d-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-24d-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-24d-ss-3"
        }
      ],
      "cml:integrityHash": "94b0ba2c6c13c6b14bde96e2e5e97185fabb752195134d21bd27ba5aa69e166a"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-24d",
      "@type": "cof:Section",
      "cof:title": "24D Refund of evaluation fee where evaluation not completed within",
      "values:kind": "section",
      "cof:pageNumber": 148,
      "values:originalText": "prescribed period\n(1) This section applies to an application under section 23 in relation\nto therapeutic goods for the evaluation of which a period is\nprescribed under paragraph 63(2)(da).\n(2) If:\n(a) the applicant has paid the whole of the evaluation fee; and\n(b) the evaluation is completed, but not within the period\nreferred to in subsection (1);\nthen 25% of the evaluation fee must be refunded to the applicant.\n(3) For the purposes of subsection (2), the evaluation is taken to be\ncompleted when the applicant is notified of the Secretary’s\ndecision under subsection 25(3) in relation to the goods."
    },
