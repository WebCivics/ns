    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gd",
      "@type": "cml:Concept",
      "skos:prefLabel": "32GD Revocation of cancellation of biological upon request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32gd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.357",
      "values:originalText": "(1) If:\n(a) the Secretary cancels the entry of a biological from the\nRegister because of the request of a person made under\nparagraph 32GA(1)(d); and\n(b) before the end of the period of 90 days beginning on the day\nthe biological ceased to be included in the Register, the\nperson requests, in writing, the Secretary to revoke the\ncancellation; and\n(c) the request is accompanied by the prescribed application fee;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) If:\n(a) the Secretary cancels the entry of a biological from the\nRegister because of the request of a person made under\nparagraph 32GA(1)(d); and\n(b) before the end of the period of 90 days beginning on the day\nthe biological ceased to be included in the Register, the\nperson requests, in writing, the Secretary to revoke the\ncancellation; and\n(c) the request is accompanied by the prescribed application fee;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32gd-norm"
        }
      ],
      "cml:integrityHash": "e7590ed4953ed0a9be12e0af8b07efd787cdc4b79c8b4f1e37e8c583ba32a5df",
      "skos:note": "Request for revocation of cancellation of biological upon request",
      "dc:description": "Application fee"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32gd",
      "@type": "cof:Section",
      "cof:title": "32GD Revocation of cancellation of biological upon request",
      "values:kind": "section",
      "cof:pageNumber": 357,
      "values:originalText": "(1) If:\n(a) the Secretary cancels the entry of a biological from the\nRegister because of the request of a person made under\nparagraph 32GA(1)(d); and\n(b) before the end of the period of 90 days beginning on the day\nthe biological ceased to be included in the Register, the\nperson requests, in writing, the Secretary to revoke the\ncancellation; and\n(c) the request is accompanied by the prescribed application fee;\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gd-norm",
