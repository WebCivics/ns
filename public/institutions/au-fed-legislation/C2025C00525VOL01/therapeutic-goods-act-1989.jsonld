      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32hb",
      "@type": "cml:Concept",
      "skos:prefLabel": "32HB Publication of requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32hb"
      },
      "cml:curationStatus": {
