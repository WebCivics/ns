    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ck-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "32CK(2) Approvals for importing, exporting or supplying a biological",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ck-ss-2"
      },
      "cml:curationStatus": {
