    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30ed",
      "@type": "cml:Concept",
      "skos:prefLabel": "30ED Powers of suspension and cancellation unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ed"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.226",
      "values:originalText": "Imposition of a requirement under section 30EA does not affect the\nSecretary’s power to suspend or cancel the registration or listing of\ntherapeutic goods under this Part.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nPublic notification, and recall, of therapeutic goods  Division 2A\nSection 30EE\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "Imposition of a requirement under section 30EA does not affect the\nSecretary’s power to suspend or cancel the registration or listing of\ntherapeutic goods under this Part.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nPublic notification, and recall, of therapeutic goods  Division 2A\nSection 30EE\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30ed-norm"
        }
      ],
      "cml:integrityHash": "ace2650e20504c390da801ccbb21fc5276a82d4d80ae1d3df7af9379452c8f36",
      "skos:note": "Imposition of requirement under section 30EA does not affect suspension or cancellation power."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ed",
      "@type": "cof:Section",
      "cof:title": "30ED Powers of suspension and cancellation unaffected",
      "values:kind": "section",
      "cof:pageNumber": 226,
      "values:originalText": "Imposition of a requirement under section 30EA does not affect the\nSecretary’s power to suspend or cancel the registration or listing of\ntherapeutic goods under this Part.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nPublic notification, and recall, of therapeutic goods  Division 2A\nSection 30EE\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
