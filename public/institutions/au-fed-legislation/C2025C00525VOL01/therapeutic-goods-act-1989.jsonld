    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bj",
      "@type": "cml:Concept",
      "skos:prefLabel": "26BJ Variation of determination under section 26BF—application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26bj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
