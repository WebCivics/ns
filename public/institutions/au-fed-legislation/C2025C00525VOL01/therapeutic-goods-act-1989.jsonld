    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9e",
      "@type": "cml:Concept",
      "skos:prefLabel": "9E Publication of list of goods on Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.65",
      "values:originalText": "The Secretary must, at least once every 12 months, publish a list of\nthe therapeutic goods included in the Register.",
      "skos:definition": "The Secretary must, at least once every 12 months, publish a list of\nthe therapeutic goods included in the Register.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9e-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f470528acde4bcf8c8e752d1f079acbe43971bd2702ad338c807440f7149bf8",
      "skos:note": "The Secretary must publish a list of therapeutic goods on the Register at least once every 12 months."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9e",
      "@type": "cof:Section",
      "cof:title": "9E Publication of list of goods on Register",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "The Secretary must, at least once every 12 months, publish a list of\nthe therapeutic goods included in the Register."
    },
