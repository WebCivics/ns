    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jg-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "32JG(3A) Secretary may require information etc. about biologicals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jg-ss-3a"
      },
      "cml:curationStatus": {
