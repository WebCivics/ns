    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gf",
      "@type": "cml:Concept",
      "skos:prefLabel": "32GF Date of effect of cancellation of entries from Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32gf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.359",
      "values:originalText": "If the Secretary cancels an entry of a biological from the Register,\nthe cancellation has effect on the day on which the notice of\ncancellation is given to the person in relation to whom the\nbiological was included in the Register.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "If the Secretary cancels an entry of a biological from the Register,\nthe cancellation has effect on the day on which the notice of\ncancellation is given to the person in relation to whom the\nbiological was included in the Register.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32gf-norm"
        }
      ],
      "cml:integrityHash": "f3c1b824fa0e5215268d6e9df4c4ec3fcfb803aac1b834e88b7fc9d2d1c5134d",
      "skos:note": "Date of effect of cancellation of entries from Register"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32gf",
      "@type": "cof:Section",
      "cof:title": "32GF Date of effect of cancellation of entries from Register",
      "values:kind": "section",
      "cof:pageNumber": 359,
      "values:originalText": "If the Secretary cancels an entry of a biological from the Register,\nthe cancellation has effect on the day on which the notice of\ncancellation is given to the person in relation to whom the\nbiological was included in the Register.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32gf-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32gf"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32h",
      "@type": "cml:Concept",
      "skos:prefLabel": "32H What this Division is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.360",
      "values:originalText": "The Secretary may require a person to recall biologicals, or to\ninform the public about biologicals, that do not comply with\nrequirements or cannot lawfully be supplied. There are criminal\noffences and a civil penalty for breaching such a requirement.",
      "skos:definition": "The Secretary may require a person to recall biologicals, or to\ninform the public about biologicals, that do not comply with\nrequirements or cannot lawfully be supplied. There are criminal\noffences and a civil penalty for breaching such a requirement.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32h-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32h-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0bc42af7187106f0ddfe272cc39ce589044d2d16a8819adcbbfad95bd7216088",
      "skos:note": "The Secretary may require a person to recall biologicals or inform the public about non-compliant biologicals."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32h",
      "@type": "cof:Section",
      "cof:title": "32H What this Division is about",
      "values:kind": "section",
      "cof:pageNumber": 360,
      "values:originalText": "The Secretary may require a person to recall biologicals, or to\ninform the public about biologicals, that do not comply with\nrequirements or cannot lawfully be supplied. There are criminal\noffences and a civil penalty for breaching such a requirement."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32h-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32h"
      },
      "values:deonticStatus": {
