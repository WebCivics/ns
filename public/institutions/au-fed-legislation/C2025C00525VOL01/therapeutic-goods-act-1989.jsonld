    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ec-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "32EC(2) Imposition of conditions by legislative instrument",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ec-ss-2"
      },
      "cml:curationStatus": {
