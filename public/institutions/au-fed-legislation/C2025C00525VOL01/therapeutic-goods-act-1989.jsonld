        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) the use of the medicine, if the medicine were used, would result in, or would be likely to result in, harm or injury to any person.",
      "cml:conclusionText": "...or (ii)"
    },
    {
