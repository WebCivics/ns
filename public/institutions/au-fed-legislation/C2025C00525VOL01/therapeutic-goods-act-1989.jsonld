    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cg",
      "@type": "cml:Concept",
      "skos:prefLabel": "32CG Disposal of unused biologicals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.293",
      "values:originalText": "(1) This section applies to a biological if:\n(a) an exemption under section 32CB in relation to that\nbiological ceases to have effect otherwise than because that\nbiological becomes included in the Register under",
      "skos:definition": "(1) This section applies to a biological if:\n(a) an exemption under section 32CB in relation to that\nbiological ceases to have effect otherwise than because that\nbiological becomes included in the Register under",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32cg-norm"
        }
      ],
      "cml:integrityHash": "eb2a5e9863ba36f144ee4e3841286108c8fb08381bee777ce9c72a03e14257a4",
      "skos:note": "This section applies to a biological if an exemption under section 32CB ceases to have effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cg",
      "@type": "cof:Section",
      "cof:title": "32CG Disposal of unused biologicals",
      "values:kind": "section",
      "cof:pageNumber": 293,
      "values:originalText": "(1) This section applies to a biological if:\n(a) an exemption under section 32CB in relation to that\nbiological ceases to have effect otherwise than because that\nbiological becomes included in the Register under"
    },
    {
