        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-1b-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "6ec60157496fbc8835c6aa5612657dcdac7f6830f9f52dcae0b61fb21bf28f48",
      "skos:note": "The Secretary may vary the entry in the Register on their own initiative."
    },
    {
