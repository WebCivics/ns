    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-1b",
      "@type": "cml:Concept",
      "skos:prefLabel": "9D(1B) Variation of entries in Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-1b"
