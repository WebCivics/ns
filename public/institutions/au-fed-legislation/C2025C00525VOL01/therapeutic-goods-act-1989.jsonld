    {
      "@id": "concept:therapeutic-goods-act-1989-sec-14-ss-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "14(5A) Criminal offences for importing, supplying or exporting goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-14-ss-5a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.78",
      "values:originalText": "(5A) Subsection (1), (4) or (4A) does not apply if:\n(a) the therapeutic goods are a biological; and\n(b) the person imports the biological after the circumstances\nprescribed by the regulations for the purposes of this\nparagraph have occurred.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (5A): see subsection 13.3(3) of the Criminal Code.\nOffences relating to supplying goods for use in Australia",
      "skos:definition": "(5A) Subsection (1), (4) or (4A) does not apply if:\n(a) the therapeutic goods are a biological; and\n(b) the person imports the biological after the circumstances\nprescribed by the regulations for the purposes of this\nparagraph have occurred.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (5A): see subsection 13.3(3) of the Criminal Code.\nOffences relating to supplying goods for use in Australia",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-14"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14-ss-5a-norm"
        }
      ],
      "cml:integrityHash": "e24535683a70abf1ec97027ecfd1e44016444a0353f5be48e6d9c48c107ba62d",
      "skos:note": "Exemptions from subsection (1), (4) or (4A)"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-14-ss-5a",
      "@type": "cof:Section",
      "cof:title": "14(5A) Criminal offences for importing, supplying or exporting goods",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(5A) Subsection (1), (4) or (4A) does not apply if:\n(a) the therapeutic goods are a biological; and\n(b) the person imports the biological after the circumstances\nprescribed by the regulations for the purposes of this\nparagraph have occurred.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (5A): see subsection 13.3(3) of the Criminal Code.\nOffences relating to supplying goods for use in Australia"
    },
