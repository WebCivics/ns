    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32dn",
      "@type": "cml:Concept",
      "skos:prefLabel": "32DN Transitional provisions for existing biologicals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.331",
      "values:originalText": "Biologicals currently included in the Register\n(1) If, immediately before the commencement of this section,\ntherapeutic goods that are a biological were included in relation to\na person:\n(a) in the part of the Register for goods known as registered\ngoods; or\n(b) in the part of the Register for goods known as listed goods; or\n(c) in the part of the Register for medical devices included in the\nRegister under Chapter 4;\nthen, as soon as practicable after the commencement of this\nsection, the Secretary must:\n(d) by writing, cancel the inclusion of the goods in that part; and\n(e) include the biological in the Register under this Part in\nrelation to the person; and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "Biologicals currently included in the Register\n(1) If, immediately before the commencement of this section,\ntherapeutic goods that are a biological were included in relation to\na person:\n(a) in the part of the Register for goods known as registered\ngoods; or\n(b) in the part of the Register for goods known as listed goods; or\n(c) in the part of the Register for medical devices included in the\nRegister under Chapter 4;\nthen, as soon as practicable after the commencement of this\nsection, the Secretary must:\n(d) by writing, cancel the inclusion of the goods in that part; and\n(e) include the biological in the Register under this Part in\nrelation to the person; and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dn-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dn-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "63bdba36929143db55d07872f5c19c018addd7c331ddd71bd69e4763933339a9",
      "skos:note": "Secretary must cancel inclusion of goods in part and include biological in Register under Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dn",
      "@type": "cof:Section",
      "cof:title": "32DN Transitional provisions for existing biologicals",
      "values:kind": "section",
      "cof:pageNumber": 331,
      "values:originalText": "Biologicals currently included in the Register\n(1) If, immediately before the commencement of this section,\ntherapeutic goods that are a biological were included in relation to\na person:\n(a) in the part of the Register for goods known as registered\ngoods; or\n(b) in the part of the Register for goods known as listed goods; or\n(c) in the part of the Register for medical devices included in the\nRegister under Chapter 4;\nthen, as soon as practicable after the commencement of this\nsection, the Secretary must:\n(d) by writing, cancel the inclusion of the goods in that part; and\n(e) include the biological in the Register under this Part in\nrelation to the person; and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32dn-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32dn"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
