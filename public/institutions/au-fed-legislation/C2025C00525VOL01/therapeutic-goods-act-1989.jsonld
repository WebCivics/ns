      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.324",
      "values:originalText": "(3) The regulations may make provision for and in relation to the\nfollowing matters:\n(a) applications for biologicals (priority applicant)\ndeterminations;\n(b) the approval by the Secretary of a form for such an\napplication;\n(c) information that must accompany such an application;\n(d) the application fee for such an application;\n(e) empowering the Secretary to give the applicant a written\nnotice requiring the applicant to give to the Secretary\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(3) The regulations may make provision for and in relation to the\nfollowing matters:\n(a) applications for biologicals (priority applicant)\ndeterminations;\n(b) the approval by the Secretary of a form for such an\napplication;\n(c) information that must accompany such an application;\n(d) the application fee for such an application;\n(e) empowering the Secretary to give the applicant a written\nnotice requiring the applicant to give to the Secretary\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32de"
      },
      "cml:asserts": [
