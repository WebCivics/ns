      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32da",
      "@type": "cml:Concept",
      "skos:prefLabel": "32DA Application for inclusion in the Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32da"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.313",
      "values:originalText": "(1) A person may make an application to the Secretary to include a\nClass 1 biological in the Register.\n(2) An application must:\n(a) be made in accordance with a form that is approved, in\nwriting, by the Secretary; and\n(b) be accompanied by a statement certifying the matters\nmentioned in subsection (3); and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) A person may make an application to the Secretary to include a\nClass 1 biological in the Register.\n(2) An application must:\n(a) be made in accordance with a form that is approved, in\nwriting, by the Secretary; and\n(b) be accompanied by a statement certifying the matters\nmentioned in subsection (3); and\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32da-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32da-ss-2"
        }
      ],
      "cml:integrityHash": "a8bf35c622aa28a205adb9f5d3d60db72848d61beaf085cf98556b43a7803f26"
    },
