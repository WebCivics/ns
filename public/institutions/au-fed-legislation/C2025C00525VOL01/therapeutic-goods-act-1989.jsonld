    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jl",
      "@type": "cml:Concept",
      "skos:prefLabel": "32JL Secretary may inspect and copy documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.379",
      "values:originalText": "The Secretary may inspect a document produced under\nsection 32JA, 32JE, 32JF, 32JG or 32JH and may make and retain\ncopies of the whole or a part of the document.",
      "skos:definition": "The Secretary may inspect a document produced under\nsection 32JA, 32JE, 32JF, 32JG or 32JH and may make and retain\ncopies of the whole or a part of the document.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jl-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jl-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "725ea2ad7cb0c0c5c8009d8159826a6af422ecee8b5c94f3ce18dfdcdfed21a4",
      "skos:note": "Inspect and copy documents produced under certain sections."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jl",
      "@type": "cof:Section",
      "cof:title": "32JL Secretary may inspect and copy documents",
      "values:kind": "section",
      "cof:pageNumber": 379,
      "values:originalText": "The Secretary may inspect a document produced under\nsection 32JA, 32JE, 32JF, 32JG or 32JH and may make and retain\ncopies of the whole or a part of the document."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jl-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32jl"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jl-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Permits inspection and copying.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jm",
      "@type": "cml:Concept",
      "skos:prefLabel": "32JM Secretary may retain documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jm"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.379",
      "values:originalText": "(1) The Secretary may take possession of a document produced under\nsection 32JA, 32JE, 32JF, 32JG or 32JH, and retain it for as long\nas is reasonably necessary.\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the Secretary to be a true copy.\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n(4) Until a certified copy is supplied, the Secretary must provide the\nperson otherwise entitled to possession of the document, or a\nperson authorised by that person, reasonable access to the\ndocument for the purposes of inspecting and making copies of the\nwhole or a part of the document.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) The Secretary may take possession of a document produced under\nsection 32JA, 32JE, 32JF, 32JG or 32JH, and retain it for as long\nas is reasonably necessary.\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the Secretary to be a true copy.\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n(4) Until a certified copy is supplied, the Secretary must provide the\nperson otherwise entitled to possession of the document, or a\nperson authorised by that person, reasonable access to the\ndocument for the purposes of inspecting and making copies of the\nwhole or a part of the document.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jm-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jm-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jm-ss-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32jm-ss-4"
        }
      ],
      "cml:integrityHash": "c6570062bd2b82c1f4b01b7f3734b503415c1ea44e17f8baf9abacfee075f5cf"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32jm",
      "@type": "cof:Section",
      "cof:title": "32JM Secretary may retain documents",
      "values:kind": "section",
      "cof:pageNumber": 379,
      "values:originalText": "(1) The Secretary may take possession of a document produced under\nsection 32JA, 32JE, 32JF, 32JG or 32JH, and retain it for as long\nas is reasonably necessary.\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the Secretary to be a true copy.\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n(4) Until a certified copy is supplied, the Secretary must provide the\nperson otherwise entitled to possession of the document, or a\nperson authorised by that person, reasonable access to the\ndocument for the purposes of inspecting and making copies of the\nwhole or a part of the document.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32jm-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "32JM(1) Secretary may retain documents",
      "cml:realizedBy": {
