    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30c-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "30C(2) Consultation with Gene Technology Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30c-ss-2"
