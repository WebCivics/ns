    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3d",
      "@type": "cml:Concept",
      "skos:prefLabel": "9D(3D) Variation of entries in Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-3d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.59",
      "values:originalText": "(3D) If:\n(a) the person in relation to whom a kind of medical device is\nincluded in the Register has requested the Secretary to vary\ninformation included in the entry in the Register that relates\nto the kind of medical device; and\n(b) subsection (3C) does not apply to the request; and\n(ba) subsection (3CB) does not apply to the request; and\n(c) the Secretary is satisfied that the variation requested does not\nindicate any reduction in the quality, safety or performance\nof the kind of medical device for the purposes for which it is\nto be used;\nthe Secretary may vary the entry in accordance with the request.",
      "skos:definition": "(3D) If:\n(a) the person in relation to whom a kind of medical device is\nincluded in the Register has requested the Secretary to vary\ninformation included in the entry in the Register that relates\nto the kind of medical device; and\n(b) subsection (3C) does not apply to the request; and\n(ba) subsection (3CB) does not apply to the request; and\n(c) the Secretary is satisfied that the variation requested does not\nindicate any reduction in the quality, safety or performance\nof the kind of medical device for the purposes for which it is\nto be used;\nthe Secretary may vary the entry in accordance with the request.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-9d"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3d-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3d-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-3d-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "c7eda553a0b10dd8f9c80280822007e1c4e2addd1451c921c6265b5a81d68d95",
      "skos:note": "Secretary may vary entry in Register upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-9d-ss-3d",
      "@type": "cof:Section",
      "cof:title": "9D(3D) Variation of entries in Register",
      "values:kind": "subsection",
      "cof:pageNumber": 59,
      "values:originalText": "(3D) If:\n(a) the person in relation to whom a kind of medical device is\nincluded in the Register has requested the Secretary to vary\ninformation included in the entry in the Register that relates\nto the kind of medical device; and\n(b) subsection (3C) does not apply to the request; and\n(ba) subsection (3CB) does not apply to the request; and\n(c) the Secretary is satisfied that the variation requested does not\nindicate any reduction in the quality, safety or performance\nof the kind of medical device for the purposes for which it is\nto be used;\nthe Secretary may vary the entry in accordance with the request."
    },
