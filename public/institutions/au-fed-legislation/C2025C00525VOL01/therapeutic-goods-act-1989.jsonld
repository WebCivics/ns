      ],
      "cml:integrityHash": "cbef972a1e2aa68b325447ce3fdda8df3a2ea2ecff8ca74d2cdd4239c0175b67",
      "skos:note": "Regulations may make provision for the transfer of licences. No excuse for giving information or producing a document under a section 41AB notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ag-ss-1",
      "@type": "cof:Section",
      "cof:title": "41AG(1) Self-incrimination",
      "values:kind": "subsection",
      "cof:pageNumber": 409,
      "values:originalText": "(1) A person is not excused from giving information or a producing a\ndocument under a section 41AB notice on the ground that the\ngiving of the information or the production of the document would\ntend to incriminate the person or expose the person to a penalty."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ag-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
