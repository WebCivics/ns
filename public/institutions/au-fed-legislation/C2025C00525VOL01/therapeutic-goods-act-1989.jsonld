      "@type": "cml:Concept",
      "skos:prefLabel": "32DK Payment of evaluation fee by instalments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.329",
      "values:originalText": "(1) The regulations may provide for the payment of an evaluation fee\nto be made by such instalments and at such times as are ascertained\nin accordance with the regulations, and the evaluation fee is due\nand payable accordingly.\n(2) Regulations made for the purposes of subsection (1) may provide\nthat a person is not allowed to pay an evaluation fee by instalments if\nany part of an instalment of that or any other evaluation fee payable\nby the person was unpaid immediately after the time when it became\ndue for payment.\n(3) If:\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) The regulations may provide for the payment of an evaluation fee\nto be made by such instalments and at such times as are ascertained\nin accordance with the regulations, and the evaluation fee is due\nand payable accordingly.\n(2) Regulations made for the purposes of subsection (1) may provide\nthat a person is not allowed to pay an evaluation fee by instalments if\nany part of an instalment of that or any other evaluation fee payable\nby the person was unpaid immediately after the time when it became\ndue for payment.\n(3) If:\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dk-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dk-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32dk-ss-3"
        }
      ],
      "cml:integrityHash": "de386c490cb44eddbd38670dbc6e7bca416590f705d542d52a596574619e26ef"
    },
