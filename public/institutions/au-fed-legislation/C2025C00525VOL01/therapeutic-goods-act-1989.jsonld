      "cml:premiseText": "(1) This Act (other than Part 4-8A or Part 6-1A)"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-6-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "appliesTo",
      "cml:logicSummary": "Applicable to corporations and natural persons/corporations.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) things done by corporations; (b) things done by natural persons or corporations in so far as those things are done:"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-6-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
