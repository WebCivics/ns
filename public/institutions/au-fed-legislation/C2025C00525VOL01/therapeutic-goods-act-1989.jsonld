    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits manufacturing therapeutic goods without license",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the person, at premises in Australia, carries out a step in the manufacture of therapeutic goods...",
      "cml:conclusionText": "...and none of the following applies: (i) the goods are exempt goods;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits manufacturing therapeutic goods without proper license",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the goods are for supply for use in humans;",
      "cml:conclusionText": "...and none of the following applies: (i) the goods are exempt goods;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits manufacturing therapeutic goods without proper license",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) none of the following applies:",
      "cml:conclusionText": "...and none of the following applies: (i) the goods are exempt goods;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits manufacturing therapeutic goods without proper license",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iii) the person is the holder of a licence that is in force that authorises the carrying out of that step in relation to the goods at those premises.",
      "cml:conclusionText": "...and none of the following applies: (i) the goods are exempt goods;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-35a",
      "@type": "cml:Concept",
