    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32da-ss-1",
      "@type": "cof:Section",
      "cof:title": "32DA(1) Application for inclusion in the Register",
      "values:kind": "subsection",
      "cof:pageNumber": 313,
      "values:originalText": "(1) A person may make an application to the Secretary to include a\nClass 1 biological in the Register."
    },
