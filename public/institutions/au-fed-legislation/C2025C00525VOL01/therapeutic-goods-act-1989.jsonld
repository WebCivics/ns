      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "⊆",
      "cml:logicSummary": "Defines a temporal interval for the provisional registration period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3A) Subject to this section, the provisional registration period...",
      "cml:conclusionText": "The original period"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-29-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "29(4) Duration of registration or listing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-29-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.202",
      "values:originalText": "(4) The person in relation to whom the medicine is provisionally\nregistered may make an application to the Secretary to extend the\nprovisional registration period.",
      "skos:definition": "(4) The person in relation to whom the medicine is provisionally\nregistered may make an application to the Secretary to extend the\nprovisional registration period.",
      "values:partOf": {
