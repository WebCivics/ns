      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-40b-ss-7-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-40b-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5d7a365a6b97644a4d1c8c3e4c821040ec1216decebf484535a660d3dddf4a8c",
      "skos:note": "Application for variation of licence must be made in accordance with a form approved by the Secretary.",
      "dc:description": "Form, application fee"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-40b-ss-7",
      "@type": "cof:Section",
      "cof:title": "40B(7) Variation of licences—application by licence holder",
      "values:kind": "subsection",
      "cof:pageNumber": 398,
      "values:originalText": "(7) An application under subsection (6) must:\n(a) be made in accordance with a form approved by the\nSecretary; and\n(b) set out the variation sought; and\n(c) be delivered to an office of the Department specified in the\nform; and\n(d) be accompanied by the prescribed application fee."
    },
