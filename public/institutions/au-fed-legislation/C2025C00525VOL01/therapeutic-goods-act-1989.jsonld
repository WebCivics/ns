      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of non-compliance with notice requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person fails to comply with the specified requirement.",
      "cml:conclusionText": "Harm or injury results."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-6-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Notice requirement is a duty.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary gives a notice to the person under subsection (2).",
      "cml:conclusionText": "Compliance with notice requirement is required."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-6-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between notice and harm/injury.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The use of any of the biologicals has resulted in, will result in, or is likely to result in, harm or injury to any person.",
      "cml:conclusionText": "Notice requirement overlaps with potential harm/injury."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-6-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Non-compliance with notice requirement is prohibited.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person fails to comply with that requirement; and",
      "cml:conclusionText": "Harm or injury results from non-compliance."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-6-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Compliance with notice requirement is a duty.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the Secretary gives a notice to the person under subsection (2); and",
      "cml:conclusionText": "Compliance with notice requirement is required."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "32CJ(7) Criminal offences and civil penalty for biologicals not",
      "cml:realizedBy": {
