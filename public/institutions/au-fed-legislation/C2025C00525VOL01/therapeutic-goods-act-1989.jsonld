    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "32BJ(2A) General criminal offences relating to this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bj-ss-2a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.284",
      "values:originalText": "(2A) A person commits an offence if:\n(a) the person, by any means, advertises a biological for an\nindication; and\n(b) the biological is included in the Register; and\n(c) the indication is not an indication accepted in relation to that\ninclusion; and\n(d) either:\n(i) the use of the biological for the advertised indication\nhas resulted in, will result in, or is likely to result in,\nharm or injury to any person; or\n(ii) the use of the biological for the advertised indication, if\nthe biological were so used, would result in, or would be\nlikely to result in, harm or injury to any person.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.",
      "skos:definition": "(2A) A person commits an offence if:\n(a) the person, by any means, advertises a biological for an\nindication; and\n(b) the biological is included in the Register; and\n(c) the indication is not an indication accepted in relation to that\ninclusion; and\n(d) either:\n(i) the use of the biological for the advertised indication\nhas resulted in, will result in, or is likely to result in,\nharm or injury to any person; or\n(ii) the use of the biological for the advertised indication, if\nthe biological were so used, would result in, or would be\nlikely to result in, harm or injury to any person.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32bj"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32bj-ss-2a-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "db99284500a8ae665df24129e2c0b062ce26441fc4dbd22fff1171fa4baf1489",
      "skos:note": "Advertising a biological for an indication that is not accepted in relation to its inclusion in the Register is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32bj-ss-2a",
      "@type": "cof:Section",
      "cof:title": "32BJ(2A) General criminal offences relating to this Part",
      "values:kind": "subsection",
      "cof:pageNumber": 284,
      "values:originalText": "(2A) A person commits an offence if:\n(a) the person, by any means, advertises a biological for an\nindication; and\n(b) the biological is included in the Register; and\n(c) the indication is not an indication accepted in relation to that\ninclusion; and\n(d) either:\n(i) the use of the biological for the advertised indication\nhas resulted in, will result in, or is likely to result in,\nharm or injury to any person; or\n(ii) the use of the biological for the advertised indication, if\nthe biological were so used, would result in, or would be\nlikely to result in, harm or injury to any person.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both."
    },
