      "dc:source": "therapeutic-goods-act-1989.pdf, p.45",
      "values:originalText": "jurisdiction\nSection 15.2 of the Criminal Code (extended geographical\njurisdiction—category B) applies to offences against\nsubsections 21A(1), (4) and (4A), sections 22A, 32DO and 41FE,\nsubsections 42DZD(1) and (2) and sections 42DZG, 42DZL, 42E\nand 42T.",
      "skos:definition": "jurisdiction\nSection 15.2 of the Criminal Code (extended geographical\njurisdiction—category B) applies to offences against\nsubsections 21A(1), (4) and (4A), sections 22A, 32DO and 41FE,\nsubsections 42DZD(1) and (2) and sections 42DZG, 42DZL, 42E\nand 42T.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-5a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-5a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c04b54bc7dade6d16eea6a2d4ae8a04f4c86922cb5b9386d2f9674c96b96e24e",
      "skos:note": "Jurisdiction applies to specific offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-5a",
      "@type": "cof:Section",
      "cof:title": "5A Application of the Criminal Code—extended geographical",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "jurisdiction\nSection 15.2 of the Criminal Code (extended geographical\njurisdiction—category B) applies to offences against\nsubsections 21A(1), (4) and (4A), sections 22A, 32DO and 41FE,\nsubsections 42DZD(1) and (2) and sections 42DZG, 42DZL, 42E\nand 42T."
    },
