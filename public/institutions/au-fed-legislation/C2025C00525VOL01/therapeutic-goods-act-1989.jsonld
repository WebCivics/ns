    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ge",
      "@type": "cml:Concept",
      "skos:prefLabel": "32GE Publication of cancellation of entry from Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ge"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.358",
      "values:originalText": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after cancelling an\nentry of a biological from the Register, a notice setting out\nparticulars of the cancellation.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nCancellation from the Register  Division 7\nSection 32GF\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after cancelling an\nentry of a biological from the Register, a notice setting out\nparticulars of the cancellation.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nCancellation from the Register  Division 7\nSection 32GF\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ge-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ge-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bb3dee238e862e9591907502045fe8abe26e8332e4af67384d0018b09c2c591d",
      "skos:note": "Publish notice of cancellation from Register",
      "dc:description": "Notice with particulars of cancellation"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ge",
      "@type": "cof:Section",
      "cof:title": "32GE Publication of cancellation of entry from Register",
      "values:kind": "section",
      "cof:pageNumber": 358,
      "values:originalText": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after cancelling an\nentry of a biological from the Register, a notice setting out\nparticulars of the cancellation.\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nBiologicals  Part 3-2A\nCancellation from the Register  Division 7\nSection 32GF\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32ge-norm",
