    {
      "@id": "concept:therapeutic-goods-act-1989-sec-6c",
      "@type": "cml:Concept",
      "skos:prefLabel": "6C Fees payable to Commonwealth under State laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-6c"
