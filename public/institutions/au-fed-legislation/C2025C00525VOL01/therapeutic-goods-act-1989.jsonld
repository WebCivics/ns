      },
      "cml:premiseText": "(a) the person in relation to whom therapeutic goods are registered or listed has requested the Secretary to vary the entry in the Register that relates to the goods;",
      "cml:conclusionText": "the request was made at some point in time."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-9d-ss-2c-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
