    {
      "@id": "concept:therapeutic-goods-act-1989-sec-14b",
      "@type": "cml:Concept",
      "skos:prefLabel": "14B Application of Customs Act 1901",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-14b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.85",
      "values:originalText": "Where:\n(a) the importation or exportation of goods is an offence under\nsubsection 14(1), (4), (4A), (10), (13) or (13AA) or 41Q(1)\nor (2) or a contravention of subsection 14A(1) or (3) or\n41Q(3); and\n(b) the Secretary notifies the Comptroller-General of Customs in\nwriting that the Secretary wishes the Customs Act 1901 to\napply to that importation or exportation;\nthe Customs Act 1901 has effect as if the goods included in that\nimportation or exportation were goods described as forfeited to the\nCrown under section 229 of that Act because they were:\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "Where:\n(a) the importation or exportation of goods is an offence under\nsubsection 14(1), (4), (4A), (10), (13) or (13AA) or 41Q(1)\nor (2) or a contravention of subsection 14A(1) or (3) or\n41Q(3); and\n(b) the Secretary notifies the Comptroller-General of Customs in\nwriting that the Secretary wishes the Customs Act 1901 to\napply to that importation or exportation;\nthe Customs Act 1901 has effect as if the goods included in that\nimportation or exportation were goods described as forfeited to the\nCrown under section 229 of that Act because they were:\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14b-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14b-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14b-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14b-logic-argumentation-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14b-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-14b-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "a8105a855cdd93f0bc5d7aed54867cb9cf8f3dc37367fc417c90ed912dcb1544",
      "skos:note": "Customs Act 1901 applies to importation or exportation of goods if notified by Secretary."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-14b",
      "@type": "cof:Section",
      "cof:title": "14B Application of Customs Act 1901",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "Where:\n(a) the importation or exportation of goods is an offence under\nsubsection 14(1), (4), (4A), (10), (13) or (13AA) or 41Q(1)\nor (2) or a contravention of subsection 14A(1) or (3) or\n41Q(3); and\n(b) the Secretary notifies the Comptroller-General of Customs in\nwriting that the Secretary wishes the Customs Act 1901 to\napply to that importation or exportation;\nthe Customs Act 1901 has effect as if the goods included in that\nimportation or exportation were goods described as forfeited to the\nCrown under section 229 of that Act because they were:\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
