    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cq",
      "@type": "cml:Concept",
      "skos:prefLabel": "32CQ Civil penalty for breaching a condition of an exemption,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.311",
      "values:originalText": "approval or authority\nA person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches:\n(i) a condition of an exemption applicable under\nregulations made for the purposes of\nsubsection 32CA(3); or\n(ii) a condition of an exemption under section 32CB; or\n(iii) a condition of an approval under section 32CK; or\n(iv) a condition applicable under regulations made for the\npurposes of section 32CL; or\n(v) a condition of an authority under section 32CM; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "approval or authority\nA person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches:\n(i) a condition of an exemption applicable under\nregulations made for the purposes of\nsubsection 32CA(3); or\n(ii) a condition of an exemption under section 32CB; or\n(iii) a condition of an approval under section 32CK; or\n(iv) a condition applicable under regulations made for the\npurposes of section 32CL; or\n(v) a condition of an authority under section 32CM; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32cq-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32cq-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ea9efe8d6f0548fb8b1ca5664514395015c34dd9ce1b68313dbc4de1b98ebdca",
      "skos:note": "Civil penalty for breaching a condition of an exemption"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32cq",
      "@type": "cof:Section",
      "cof:title": "32CQ Civil penalty for breaching a condition of an exemption,",
      "values:kind": "section",
      "cof:pageNumber": 311,
      "values:originalText": "approval or authority\nA person contravenes this section if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches:\n(i) a condition of an exemption applicable under\nregulations made for the purposes of\nsubsection 32CA(3); or\n(ii) a condition of an exemption under section 32CB; or\n(iii) a condition of an approval under section 32CK; or\n(iv) a condition applicable under regulations made for the\npurposes of section 32CL; or\n(v) a condition of an authority under section 32CM; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
