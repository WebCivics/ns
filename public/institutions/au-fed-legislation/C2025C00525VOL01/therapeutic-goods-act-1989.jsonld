    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30ec",
      "@type": "cml:Concept",
      "skos:prefLabel": "30EC Criminal offences for non-compliance with requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ec"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.225",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a requirement imposed on the\nperson under section 30EA; and\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.\nNote 1:\nA jury may acquit a person of an offence against this subsection and\nmay convict the person of an offence against subsection (4) instead:\nsee section 53A.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a requirement imposed on the\nperson under section 30EA; and\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.\nNote 1:\nA jury may acquit a person of an offence against this subsection and\nmay convict the person of an offence against subsection (4) instead:\nsee section 53A.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30ec-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30ec-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa9e8da167b724dedc1ceb78d37a2628eb968d9e15a7b83639367e504584667f",
      "skos:note": "Non-compliance with requirements is a criminal offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ec",
      "@type": "cof:Section",
      "cof:title": "30EC Criminal offences for non-compliance with requirements",
      "values:kind": "section",
      "cof:pageNumber": 225,
      "values:originalText": "(1) A person commits an offence if:\n(a) the person does an act or omits to do an act; and\n(b) the act or omission breaches a requirement imposed on the\nperson under section 30EA; and\n(c) the act or omission has resulted in, will result in, or is likely\nto result in, harm or injury to any person.\nPenalty: Imprisonment for 5 years or 4,000 penalty units, or both.\nNote 1:\nA jury may acquit a person of an offence against this subsection and\nmay convict the person of an offence against subsection (4) instead:\nsee section 53A.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30ec-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
