    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32dm-ss-6",
      "@type": "cof:Section",
      "cof:title": "32DM(6) Reduction of evaluation fee where evaluation not completed",
      "values:kind": "subsection",
