    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30e",
      "@type": "cml:Concept",
      "skos:prefLabel": "30E Secretary to take advice into account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.220",
      "values:originalText": "If the Secretary receives advice from the Gene Technology\nRegulator:\n(a) in response to a notice under section 30C within the period\nspecified in the notice; or\n(b) under section 30D;\nthe Secretary must:\n(c) ensure that the advice is taken into account in making a\ndecision on the application to which the notice relates, or on\nan application to which the advice under section 30D relates,\nas the case requires; and\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nRegistration and listing  Division 2\nSection 30E\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(d) inform the Gene Technology Regulator of the decision on the\napplication.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "If the Secretary receives advice from the Gene Technology\nRegulator:\n(a) in response to a notice under section 30C within the period\nspecified in the notice; or\n(b) under section 30D;\nthe Secretary must:\n(c) ensure that the advice is taken into account in making a\ndecision on the application to which the notice relates, or on\nan application to which the advice under section 30D relates,\nas the case requires; and\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nRegistration and listing  Division 2\nSection 30E\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(d) inform the Gene Technology Regulator of the decision on the\napplication.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30e-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "67fbe04aaecb63a7368b814ab4868ec8f0e93a1c24186726976d9aa9da80a685",
      "skos:note": "Secretary must take advice from Gene Technology Regulator into account when making decisions on applications."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30e",
      "@type": "cof:Section",
      "cof:title": "30E Secretary to take advice into account",
      "values:kind": "section",
      "cof:pageNumber": 220,
      "values:originalText": "If the Secretary receives advice from the Gene Technology\nRegulator:\n(a) in response to a notice under section 30C within the period\nspecified in the notice; or\n(b) under section 30D;\nthe Secretary must:\n(c) ensure that the advice is taken into account in making a\ndecision on the application to which the notice relates, or on\nan application to which the advice under section 30D relates,\nas the case requires; and\n\nMedicines and other therapeutic goods that are not medical devices  Chapter 3\nRegistration and listing of therapeutic goods  Part 3-2\nRegistration and listing  Division 2\nSection 30E\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(d) inform the Gene Technology Regulator of the decision on the\napplication.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30e-norm",
      "@type": "values:Obligation",
      "cml:modality": {
