      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.398",
      "values:originalText": "(7) An application under subsection (6) must:\n(a) be made in accordance with a form approved by the\nSecretary; and\n(b) set out the variation sought; and\n(c) be delivered to an office of the Department specified in the\nform; and\n(d) be accompanied by the prescribed application fee.",
      "skos:definition": "(7) An application under subsection (6) must:\n(a) be made in accordance with a form approved by the\nSecretary; and\n(b) set out the variation sought; and\n(c) be delivered to an office of the Department specified in the\nform; and\n(d) be accompanied by the prescribed application fee.",
      "values:partOf": {
