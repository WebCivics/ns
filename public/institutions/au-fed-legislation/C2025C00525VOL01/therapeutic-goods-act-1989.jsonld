          "@id": "concept:therapeutic-goods-act-1989-sec-32jg-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "daf8784c70415796d96fcfc2d54c2d57c5432fd98b900485d64958cb10a91a79",
      "skos:note": "Secretary may require specified information or documents from a person authorized to supply a biological."
    },
