      "cml:logicSummary": "The Secretary must publish a list of therapeutic goods on the Register.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
