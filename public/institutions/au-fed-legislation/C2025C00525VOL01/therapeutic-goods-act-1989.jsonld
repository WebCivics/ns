        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-29-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fcff9bd55c8a4a785bc69f0bebfbcddf437b89af3bd3b41d85d9bba9c51fea23",
      "skos:note": "Application for extension of provisional registration period"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-29-ss-4",
      "@type": "cof:Section",
      "cof:title": "29(4) Duration of registration or listing",
      "values:kind": "subsection",
      "cof:pageNumber": 202,
      "values:originalText": "(4) The person in relation to whom the medicine is provisionally\nregistered may make an application to the Secretary to extend the\nprovisional registration period."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-29-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
