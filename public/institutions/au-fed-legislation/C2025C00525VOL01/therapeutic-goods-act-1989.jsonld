      "dc:source": "therapeutic-goods-act-1989.pdf, p.125",
      "values:originalText": "(3) A person contravenes this subsection if:\n(a) the person represents therapeutic goods that are not included\nin the Register as being so included; or\n(b) the person represents therapeutic goods that are not exempt\ngoods as being exempt goods; or\n(c) the person represents therapeutic goods that are not goods\nexempt under section 18A as being goods exempt under that\nsection; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "(3) A person contravenes this subsection if:\n(a) the person represents therapeutic goods that are not included\nin the Register as being so included; or\n(b) the person represents therapeutic goods that are not exempt\ngoods as being exempt goods; or\n(c) the person represents therapeutic goods that are not goods\nexempt under section 18A as being goods exempt under that\nsection; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-21b"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-21b-ss-3-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-21b-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5ae534a444e1562b7e341cf81cea721083655f755b11516b1b9c53643b0b7f91",
      "skos:note": "Representing false information about therapeutic goods is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-21b-ss-3",
      "@type": "cof:Section",
      "cof:title": "21B(3) General civil penalties relating to this Part",
      "values:kind": "subsection",
      "cof:pageNumber": 125,
      "values:originalText": "(3) A person contravenes this subsection if:\n(a) the person represents therapeutic goods that are not included\nin the Register as being so included; or\n(b) the person represents therapeutic goods that are not exempt\ngoods as being exempt goods; or\n(c) the person represents therapeutic goods that are not goods\nexempt under section 18A as being goods exempt under that\nsection; or\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-21b-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-21b-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-21b-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of representing false information about therapeutic goods.",
      "cml:executionSurface": "modalities::logic::deontic",
