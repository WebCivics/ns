    {
      "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(4) Declaration that goods are/are not therapeutic goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-7-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
