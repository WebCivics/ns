      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-3c-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
