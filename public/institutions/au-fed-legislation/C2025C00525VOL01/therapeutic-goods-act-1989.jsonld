      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32cj-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits notice given under subsection (2) from being a legislative instrument.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
