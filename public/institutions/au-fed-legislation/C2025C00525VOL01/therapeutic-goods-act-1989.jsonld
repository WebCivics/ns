      },
      "cml:premiseText": "Secretary notifies Comptroller-General of Customs.",
      "cml:conclusionText": "Customs Act 1901 has effect."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-14b-logic-diffusion-4",
