        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-30eg-ss-5-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "bae4623a085cbac5127c1e9c7709ff9582d0e50d4443beccaa7c29426095a2b5",
      "skos:note": "Specify software requirements for information transmission"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30eg-ss-5",
      "@type": "cof:Section",
      "cof:title": "30EG(5) Reporting discontinuation of supply of medicine",
      "values:kind": "subsection",
