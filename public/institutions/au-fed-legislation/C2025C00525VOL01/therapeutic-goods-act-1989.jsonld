      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.51",
      "values:originalText": "(4) If a declaration under this section:\n(a) is a declaration that classes of goods are not therapeutic\ngoods; and\n(b) applies wholly or partly to goods that, apart from this section,\nwould be medical devices;\n\nChapter 1  Preliminary\n\nSection 7AAA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nthe goods are not medical devices, or are not medical devices when\nused, advertised, or presented for supply in the way specified in the\ndeclaration.\n7AAA  Minister may determine that goods are therapeutic goods",
      "skos:definition": "(4) If a declaration under this section:\n(a) is a declaration that classes of goods are not therapeutic\ngoods; and\n(b) applies wholly or partly to goods that, apart from this section,\nwould be medical devices;\n\nChapter 1  Preliminary\n\nSection 7AAA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nthe goods are not medical devices, or are not medical devices when\nused, advertised, or presented for supply in the way specified in the\ndeclaration.\n7AAA  Minister may determine that goods are therapeutic goods",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-7"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-7-ss-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "7730eebf64333862e58a47abbe913dedb4d18fa268e00cd1de9fc5c47f70238b",
      "skos:note": "Goods are not therapeutic goods if declaration applies wholly or partly to goods that would be medical devices."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-7-ss-4",
      "@type": "cof:Section",
      "cof:title": "7(4) Declaration that goods are/are not therapeutic goods",
      "values:kind": "subsection",
      "cof:pageNumber": 51,
      "values:originalText": "(4) If a declaration under this section:\n(a) is a declaration that classes of goods are not therapeutic\ngoods; and\n(b) applies wholly or partly to goods that, apart from this section,\nwould be medical devices;\n\nChapter 1  Preliminary\n\nSection 7AAA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nthe goods are not medical devices, or are not medical devices when\nused, advertised, or presented for supply in the way specified in the\ndeclaration.\n7AAA  Minister may determine that goods are therapeutic goods"
    },
