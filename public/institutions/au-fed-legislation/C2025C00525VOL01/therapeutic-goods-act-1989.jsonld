    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32d",
      "@type": "cml:Concept",
      "skos:prefLabel": "32D Simplified outline of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.313",
      "values:originalText": "A Class 1 biological can be included in the Register if a proper\napplication is made and the applicant certifies various matters (see\nSubdivision B).\nAn export only biological can be included in the Register if a\nproper application is made, the applicant certifies various matters\nand, if steps in the manufacture of the biological have been carried\nout outside Australia, the Secretary has certified (where\nappropriate) that the manufacturing and quality control procedures\nused in those steps are acceptable (see Subdivision BA).\nA biological, other than a Class 1 biological or an export only\nbiological, can be included in the Register if a proper application is\nmade and the Secretary is satisfied the biological is suitable for\ninclusion following an evaluation of the biological (see\nSubdivision C).\nSubdivision B—Class 1 biologicals",
      "skos:definition": "A Class 1 biological can be included in the Register if a proper\napplication is made and the applicant certifies various matters (see\nSubdivision B).\nAn export only biological can be included in the Register if a\nproper application is made, the applicant certifies various matters\nand, if steps in the manufacture of the biological have been carried\nout outside Australia, the Secretary has certified (where\nappropriate) that the manufacturing and quality control procedures\nused in those steps are acceptable (see Subdivision BA).\nA biological, other than a Class 1 biological or an export only\nbiological, can be included in the Register if a proper application is\nmade and the Secretary is satisfied the biological is suitable for\ninclusion following an evaluation of the biological (see\nSubdivision C).\nSubdivision B—Class 1 biologicals",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32d-norm"
        }
      ],
      "cml:integrityHash": "d6a66d4dcf8daac16316f4b3f2d7dd481383e31e46cee7a83282f1f0036a2df9",
      "skos:note": "Application requirements for inclusion in the Register"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32d",
      "@type": "cof:Section",
      "cof:title": "32D Simplified outline of this Division",
      "values:kind": "section",
      "cof:pageNumber": 313,
      "values:originalText": "A Class 1 biological can be included in the Register if a proper\napplication is made and the applicant certifies various matters (see\nSubdivision B).\nAn export only biological can be included in the Register if a\nproper application is made, the applicant certifies various matters\nand, if steps in the manufacture of the biological have been carried\nout outside Australia, the Secretary has certified (where\nappropriate) that the manufacturing and quality control procedures\nused in those steps are acceptable (see Subdivision BA).\nA biological, other than a Class 1 biological or an export only\nbiological, can be included in the Register if a proper application is\nmade and the Secretary is satisfied the biological is suitable for\ninclusion following an evaluation of the biological (see\nSubdivision C).\nSubdivision B—Class 1 biologicals"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
