      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Secretary must take advice into account.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary receives advice from the Gene Technology Regulator.",
      "cml:conclusionText": "The Secretary must ensure that the advice is taken into account in making a decision on the application."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-32du-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Secretary informs the Gene Technology Regulator of the decision on the application.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
