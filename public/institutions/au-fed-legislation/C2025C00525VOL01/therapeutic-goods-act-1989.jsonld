    {
      "@id": "concept:therapeutic-goods-act-1989-sec-30ek-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "30EK(5) Minister may declare a serious scarcity of medicine",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-30ek-ss-5"
      },
      "cml:curationStatus": {
