    {
      "@id": "concept:therapeutic-goods-act-1989-sec-26bd-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "26BD(4) Requirements relating to an application for variation of a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-26bd-ss-4"
      },
      "cml:curationStatus": {
