    {
      "@id": "concept:therapeutic-goods-act-1989-sec-24c",
      "@type": "cml:Concept",
      "skos:prefLabel": "24C Recovery of evaluation fee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-24c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.147",
      "values:originalText": "An evaluation fee under section 24 may be recovered by the\nCommonwealth as a debt due to the Commonwealth.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "skos:definition": "An evaluation fee under section 24 may be recovered by the\nCommonwealth as a debt due to the Commonwealth.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-24c-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-24c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fba16f99658a71db745e501a7b23381ce395fe98522fff70bf077e79f6030772",
      "skos:note": "Recovery of evaluation fee is an obligation for the Commonwealth."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-24c",
      "@type": "cof:Section",
      "cof:title": "24C Recovery of evaluation fee",
      "values:kind": "section",
      "cof:pageNumber": 147,
      "values:originalText": "An evaluation fee under section 24 may be recovered by the\nCommonwealth as a debt due to the Commonwealth.\n\nChapter 3  Medicines and other therapeutic goods that are not medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-24c-norm",
