      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.339",
      "values:originalText": "(2) Subject to subsection (5), the Secretary must give written notice to\nthe Gene Technology Regulator:\n(a) stating that the application has been made; and\n(b) requesting the Gene Technology Regulator to give advice\nabout the application.",
      "skos:definition": "(2) Subject to subsection (5), the Secretary must give written notice to\nthe Gene Technology Regulator:\n(a) stating that the application has been made; and\n(b) requesting the Gene Technology Regulator to give advice\nabout the application.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-32ds"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-2-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-32ds-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "72f4b66640772a86767f0b5d10f6a70d034e87a7de72257b9ecf0218ca53659e",
      "skos:note": "The Secretary must give written notice to the Gene Technology Regulator.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-32ds-ss-2",
      "@type": "cof:Section",
      "cof:title": "32DS(2) Consultation with Gene Technology Regulator",
      "values:kind": "subsection",
      "cof:pageNumber": 339,
      "values:originalText": "(2) Subject to subsection (5), the Secretary must give written notice to\nthe Gene Technology Regulator:\n(a) stating that the application has been made; and\n(b) requesting the Gene Technology Regulator to give advice\nabout the application."
    },
