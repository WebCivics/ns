        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Description of conditions for inclusion in the Register",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "has",
      "cml:premiseText": "(i) has available sufficient information to substantiate compliance with the essential principles; or (ii) has procedures in place, including a written agreement with the manufacturer of the kind of device, to ensure that such information can be obtained from the manufacturer within 20 working days;"
    },
    {
