      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.26",
      "skos:note": "Manufacturer is responsible for design, production, packaging and labelling of the device.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "41BG(1) Manufacturers of medical devices"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-norm",
        "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-deontic-1",
        "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-alleninterval-2",
        "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-argumentation-3",
        "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-diffusion-4",
        "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "6e8267949d0196d60cc5c48a54a2122c33f8f338ef29d6a7be4523c6d39867b9",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:therapeutic-goods-act-1989#sec-41bg-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:therapeutic-goods-act-1989-sec-41bg"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The manufacturer's responsibility for design, production, packaging and labelling begins before the device is supplied.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Manufacturer's responsibility starts before device supply",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Design, production, packaging and labelling occur before the device is supplied under the person’s name."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The manufacturer's responsibility for design, production, packaging and labelling implies that the device must be supplied under their name.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Manufacturer's responsibility implies supply of device",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "If the manufacturer is responsible for design, production, packaging and labelling, then the device must be supplied under their name."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The manufacturer's responsibility for design, production, packaging and labelling is a cognitive action that implies the supply of the device.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Manufacturer's responsibility is a cognitive action",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The manufacturer's responsibility for design, production, packaging and labelling involves making decisions and taking actions."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The manufacturer is responsible for those operations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Manufacturer is responsible",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "Design, production, packaging and labelling are operations performed by the manufacturer."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The manufacturer's responsibility for design, production, packaging and labelling implies that the device must be supplied under their name or another person acting on their behalf.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Manufacturer's responsibility spreads to supply of device",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The manufacturer's responsibility for design, production, packaging and labelling is not limited to the person themselves but also extends to other persons acting on their behalf."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:therapeutic-goods-act-1989-sec-41bg-ss-1"
    },
