    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54c-ss-1",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.358",
      "skos:note": "Executive officer must take reasonable steps to prevent commission of offence.",
