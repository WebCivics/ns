    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46b-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorised person may enter the premises within a reasonable time frame to search for the item.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for exercising powers under this section.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(c) search the premises for the thing;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46b-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorised person may enter premises and seize items if there is a risk to public health.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Inference from the text that the authorised person may enter premises and seize items under certain circumstances.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "(a) there may be on any premises a particular thing in respect of which this Act or the regulations have not been complied (b) it is necessary in the interests of public health to exercise powers under this section in order to avoid an imminent risk of death, serious illness or serious injury;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46b-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorised person may not enter the premises.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition on entering premises.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) there may be on any premises a particular thing in respect of which this Act or the regulations have not been complied"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46b-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorised person has an obligation to exercise their powers if there is a risk to public health.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to exercise powers under this section in certain circumstances.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(b) it is necessary in the interests of public health to exercise powers under this section in order to avoid an imminent risk of death, serious illness or serious injury;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46b-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorised person may seize the item repeatedly within a reasonable time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of searches and seizures on public health grounds.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "(d) if the authorised person finds the thing on the premises—seize it;"
    },
