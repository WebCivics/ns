      },
      "cml:operator": "=",
      "cml:premiseText": "(a) the presentation of goods includes matters in relation to..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41p-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Goods cannot be presented in a way that is misleading or confusing.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
