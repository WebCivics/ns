    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mb-ss-1-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption is valid only if the medical device meets the specified standard.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval for which the exemption applies.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "<",
      "cml:premiseText": "(a) the medical device complies with one or more medical device standards that apply to it;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mb-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption is a permission for the medical device to comply with specific standards.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Classifies the type of duty or obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) the medical device complies with one or more medical device standards that apply to it;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mb-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption is a permission for the medical device to fail to comply with specific principles.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Classifies the type of duty or obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(b) the medical device fails to comply with the essential principles only in respect of a part or parts of the essential principles."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mb-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption is valid only if the non-compliance occurs within the specified interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Specifies the temporal relationship between the exemption and the non-compliance.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<",
      "cml:premiseText": "(b) the medical device fails to comply with the essential principles only in respect of a part or parts of the essential principles."
    },
