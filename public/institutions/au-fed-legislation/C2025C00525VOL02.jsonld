    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42vb-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Relief from liability is granted during a specific temporal interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval during which relief from liability applies",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The relief from liability applies if the proceedings are brought within a certain timeframe."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42vb-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person's actions are justified by their honesty and circumstances.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Justification for exemption from liability",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "justification",
      "cml:premiseText": "The person's honesty and circumstances of the case justify relief from liability."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42vb-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Court recognizes the person's exemption from liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognition of exemption from liability",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognition",
      "cml:premiseText": "The Court recognizes the person's honesty and circumstances as justification for relief from liability."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42vb-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Relief from liability is granted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exemptions from liability",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "exemption",
      "cml:premiseText": "The person has acted honestly and ought fairly to be excused for the contravention."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42vb-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption from liability propagates to the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Propagation of exemption from liability",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "propagation",
      "cml:premiseText": "Relief from liability is granted to the person if they have acted honestly."
    },
