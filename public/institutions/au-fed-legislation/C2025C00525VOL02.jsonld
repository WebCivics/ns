      "cml:premiseText": "Therapeutic goods have a specific purpose and are subject to regulation."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42u-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Tampering is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits tampering with therapeutic goods.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Therapeutic goods are protected by law."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42u-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Tampering is prohibited for these goods.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies therapeutic goods as subject to tampering prohibition.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "Therapeutic goods have a specific meaning in this context."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42u-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The risk of harm is diffused through tampering.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Tampering with therapeutic goods diffuses the risk of harm to others.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Through",
      "cml:premiseText": "Therapeutic goods can cause harm if tampered with."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42u-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Tampering occurs until this safety condition is met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Tampering is prohibited until the therapeutic goods reach a safe state.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "Therapeutic goods must be in a safe state before they can be used."
    },
