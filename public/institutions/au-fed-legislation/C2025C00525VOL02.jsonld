      "cml:operator": "=",
      "cml:premiseText": "substance means an ingredient, compound, material or preparation..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-52a-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the first Poisons Standard is the latest edition at the commencement of this Part of the document known as the Standard for...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines the first Poisons Standard as the latest edition at commencement.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "first Poisons Standard means the latest edition at the commencement of this Part of the document known as the Standard for..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-52a-ss-1-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the substance is an ingredient, compound, material or preparation that may cause death, illness or injury.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines substance as an ingredient, compound, material or preparation that may cause death, illness or injury.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "substance means: (a) an ingredient, compound, material or preparation which, or the use of which, may cause death, illness or injury to persons or animals;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-52a-ss-1-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the current Poisons Standard is the document last prepared under paragraph 52D(2)(b).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines the current Poisons Standard as the document last prepared under paragraph 52D(2)(b).",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(1) In this Part, unless the contrary intention appears: current Poisons Standard means: (a) if no document has been prepared under paragraph 52D(2)(b)—the first Poisons Standard; or (b) otherwise—the document last prepared under that paragraph..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-52a-ss-1-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "scheduling in relation to a substance means determining the schedule or schedules to the current Poisons Standard.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines scheduling as determining the schedule or schedules to the current Poisons Standard.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "scheduling, in relation to a substance, means determining the schedule or schedules to the current Poisons Standard in which the name or a description of the substance is to be included."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-52a-ss-1-logic-descriptionlogic-7",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the substance is an ingredient, compound, material or preparation specified under subsection (2).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines substance as an ingredient, compound, material or preparation specified under subsection (2).",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "substance means: (b) an ingredient, compound, material or preparation specified under subsection (2);"
    },
