    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.255",
      "skos:note": "Secretary may issue a public warning notice if person fails to comply with substantiation notice.",
