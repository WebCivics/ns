    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fn-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for obtaining information from the manufacturer",
