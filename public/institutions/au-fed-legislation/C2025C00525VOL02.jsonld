      "@id": "concept:therapeutic-goods-act-1989-sec-52a-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "scheduling in relation to a substance means determining the schedule or schedules...",
      "cml:confidence": {
        "@type": "xsd:decimal",
