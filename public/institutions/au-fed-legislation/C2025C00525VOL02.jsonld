    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gf-ss-1",
      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.97",
      "skos:note": "Suspension of medical device from Register upon suspension of Australian conformity assessment body certificate or overseas regulator conformity assessment document. Secretary may suspend medical device from Register if conformity assessment certificate is suspended.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "41GF(1) Suspension where conformity assessment certificate"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-norm",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-deontic-1",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-descriptionlogic-2",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-alleninterval-3",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-ltl-4",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-diffusion-5",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-cogai-6",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-deontic-7",
        "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-descriptionlogic-8"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": [
        "c378395cb8ce234cf0c21cc6a787fdaeb6547f9860ec036e1fd771817211483b",
        "f31e237bc8d88a315fe3a61d1a9046c6b81da7071df38fe383a22e54ae81904e"
      ],
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:therapeutic-goods-act-1989#sec-41gf-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:therapeutic-goods-act-1989-sec-41gf"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gf-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) The Secretary may, by written notice given to the person in relation to whom a kind of medical device is included in the Register, suspend the kind of device from the Register if: (a) an Australian conformity assessment body certificate that applies to the kind of device is suspended by the Australian conformity assessment body; or (b) an overseas regulator conformity assessment document that applies to the kind of device is suspended by the overseas regulator.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
