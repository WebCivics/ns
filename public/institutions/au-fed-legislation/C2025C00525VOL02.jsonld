      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Warrant implies specified conditions for entry.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Imply",
      "cml:premiseText": "(4) The warrant must: (a) authorise one or more authorised persons..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-49-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and exercise the powers set out in subsection 48(1)...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits warrant from authorising entry without specified conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(4) The warrant must: (a) authorise one or more authorised persons..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-49-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...with such assistance and by such force as is necessary and reasonable...;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Warrant authorises entry and exercise of powers under specified conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Authorise",
      "cml:premiseText": "(4) The warrant must: (a) authorise one or more authorised persons..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-49-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...on which the warrant ceases to have effect;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Warrant's authority is limited to a specified time period.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(4) The warrant must: (c) specify the day (not more than 6 months after the issue of the warrant) on which the warrant ceases to have effect..."
