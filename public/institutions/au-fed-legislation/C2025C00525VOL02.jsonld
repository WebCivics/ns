    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ad-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if the information or document is false or misleading in a material particular.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of giving false or misleading information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The person is given a notice under section 45AB."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ad-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision prohibits imprisonment for 12 months or 1,000 penalty units.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of imprisonment for 12 months or 1,000 penalty units.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Penalty: Imprisonment for 12 months or 1,000 penalty units, or both."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ad-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision prohibits liability for an executive officer of a body corporate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
