      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Compilation date: 05/09/2025 Penalty: 500 penalty units. Strict liability offence"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ac-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the person fails to comply, they commit an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Failing to comply with notice implies committing an offence.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(1) A person commits an offence if: (a) the person is given a notice under section 45AB; and (b) the person fails to comply with the notice."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ac-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the person fails, they are subject to a strict liability offence.",
