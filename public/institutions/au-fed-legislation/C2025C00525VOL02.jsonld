      "cml:logicSummary": "Obligation to provide sufficient information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fn-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to provide sufficient information for conformity assessment procedures",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "(i) has available sufficient information to substantiate that the conformity assessment procedures have been applied to the kind of medical device or that requirements, comparable to those procedures, have been applied to the kind of medical device to the satisfaction of an overseas regulator; or (ii) has procedures in place, including a written agreement with the manufacturer of the kind of device, to ensure that such information can be obtained from the manufacturer within 20 working days;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fn-ss-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
