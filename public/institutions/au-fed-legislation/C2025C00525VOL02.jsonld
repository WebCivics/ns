      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Giving false or misleading information is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person gives information to the Secretary; and (b) the person knows that the information: (i) is false or misleading; or (ii) omits any matter or thing without which the information is misleading;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jh-ss-1-logic-deontic-3",
