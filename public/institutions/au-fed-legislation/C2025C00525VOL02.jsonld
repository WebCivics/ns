      "cml:logicSummary": "Prohibition of liability for an executive officer of a body corporate.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Note: For the liability of an executive officer of a body corporate, see sections 54B and 54BA."
    },
    {
