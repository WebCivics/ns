      "cml:logicSummary": "Prohibition of advertising therapeutic goods without compliance with the Therapeutic Goods Advertising Code.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) either: (i) the use of the goods in reliance on the advertisement has resulted in, will result in, or is likely to result in, harm or injury to any person; or"
    },
