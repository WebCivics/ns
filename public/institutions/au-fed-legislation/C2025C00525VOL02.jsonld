    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the warning notice is issued during the period of non-compliance",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Warning notice issued during period of non-compliance.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:premiseText": "(c) the Secretary is satisfied that it is in the public interest to issue a notice under this subsection;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the warning notice implies that the person has failed to comply",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Warning notice implies that person has failed to comply.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Imply",
      "cml:premiseText": "(2) If: (a) the Secretary gives a person a notice (the substantiation notice) under subsection 42DR(1) or (2); and (b) the person fails to comply with the substantiation notice;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the Secretary may issue to the public a written notice containing a warning that the person has failed to comply with the substantiation notice, and specifying the matter to which the substantiation notice related.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits person from failing to comply with substantiation notice.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the Secretary gives a person a notice (the substantiation notice) under subsection 42DR(1) or (2); and (b) the person fails to comply with the substantiation notice;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the warning notice spreads to the public",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Warning notice spreads to public.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:premiseText": "(2) If: (a) the Secretary gives a person a notice (the substantiation notice) under subsection 42DR(1) or (2); and (b) the person fails to comply with the substantiation notice;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the warning notice remains in effect until the person complies",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Warning notice remains in effect until person complies.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(c) the Secretary is satisfied that it is in the public interest to issue a notice under this subsection;"
    },
