      "@type": "cml:Concept",
      "dc:source": "therapeutic-goods-act-1989.pdf, p.59",
      "skos:note": "Suspension takes effect on specified day after notice is given.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "41EO(1) Duration of suspension"
