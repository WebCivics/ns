        "@language": "en",
        "@value": "45AD(1) Offences and civil penalty for giving false or misleading"
      },
      "wasDerivedFrom": "therapeutic-goods-act-1989.pdf",
      "asserts": [
        "concept:therapeutic-goods-act-1989-sec-45ad-ss-1-norm",
