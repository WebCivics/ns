    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ge-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister's decision had been made on the day on which notice was given to the Secretary.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The text describes a temporal interval where the notice being given overlaps with the day on which the Minister's decision was made.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Notice has been given."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ge-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Act has no effect as if the Secretary had decided not to revoke the suspension.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If a notice has been given, then the Act has no effect as if the Secretary had decided not to revoke the suspension.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Notice has been given."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ge-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister's decision had been made on the day on which notice was given to the Secretary.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If a notice has been given, then the Minister's decision is confirmed by the Secretary.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Notice has been given."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ge-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Act has no effect as if the Secretary had decided not to revoke the suspension.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The text describes a repeating pattern where the notice being given repeats indefinitely.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "Notice has been given."
    },
