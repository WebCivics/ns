    {
      "@id": "concept:therapeutic-goods-act-1989-sec-47-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Overlaps with time intervals for entering premises.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with time intervals for entering premises.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(1) Subject to subsections (2) and (3), if an authorised person has reasonable grounds for suspecting that there may be evidential material in respect of an offence against this Act, in respect of a contravention of a civil penalty provision or in respect of both on any premises"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-47-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Authorized person implies they have authority to enter premises.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implies that authorized person has authority to enter premises.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Imply",
      "cml:premiseText": "(a) enter the premises; and (b) exercise the powers set out in subsection (4), subsection 48(1) and section 48C;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-47-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "May not enter premises without reasonable grounds.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits entering premises without reasonable grounds.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) enter the premises;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-47-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Diffuses information about reasonable grounds to others.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffuses information about reasonable grounds to others.",
      "cml:modality": {
