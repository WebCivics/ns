      "cml:logicSummary": "Prohibits supplying a medical device without proper authority.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person has been granted an authority under subsection 41HC(1) relating to a specified kind of medical device; and (b) the person supplies a medical device of that kind: ..."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mo-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the supply is not in accordance with the authority; or the supply is not in accordance with the conditions to which the authority is subject; or the supply is not in accordance with regulations made for the purpose of subsection 41HC(5).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits using a medical device without proper authority.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) either: (i) the use of the device has resulted in, will result in, or is likely to result in, harm or injury to any person; or (ii) the use of the device, if the device were used, would result in, or would be likely to result in, harm or injury to any person."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mo-ss-1-logic-deontic-5",
