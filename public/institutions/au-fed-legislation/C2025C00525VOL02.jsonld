      "cml:integrityHash": "fc412e1cb101ad8fb7127c207ffa64e5e4a2f78036e41e833d7d62c65d3dd14b",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:therapeutic-goods-act-1989#sec-46b-ss-1",
