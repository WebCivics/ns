    <http://www.w3.org/2004/02/skos/core#note> "Suspension of medical device from Register upon suspension of Australian conformity assessment body certificate or overseas regulator conformity assessment document. Secretary may suspend medical device from Register if conformity assessment certificate is suspended.";
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>;
    <https://ns.webcivics.net/cml/schemaVersion> "2";
