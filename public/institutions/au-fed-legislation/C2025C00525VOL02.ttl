    <https://ns.webcivics.net/cml/operator> "Temporal Interval";
    <https://ns.webcivics.net/cml/logicSummary> "Temporal interval for exercising powers under this section.";
    <https://ns.webcivics.net/cml/premiseText> "(c) search the premises for the thing;";
