concept:therapeutic-goods-act-1989-sec-42yd a cml:Concept ;
    skos:prefLabel "42YD Recovery of a pecuniary penalty"@en ;
    cml:realizedBy doc:sec-42yd ;
    values:originalText "If the Federal Court orders a person to pay a pecuniary penalty: (a) the penalty is payable to the Commonwealth; and (b) the Commonwealth may enforce the order as if it were a judgment of the Court." ;
    skos:definition "If the Federal Court orders a person to pay a pecuniary penalty: (a) the penalty is payable to the Commonwealth; and (b) the Commonwealth may enforce the order as if it were a judgment of the Court."@en ;
    cml:integrityHash "fc3e3971d83224ceca41d33aa68686d555dba3464a86be0416577e3b1f3dcb78" ;
    cof:pageNumber "283"^^xsd:integer ;
    skos:note "The Commonwealth may enforce a pecuniary penalty order as if it were a judgment of the Court." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.283" ;
