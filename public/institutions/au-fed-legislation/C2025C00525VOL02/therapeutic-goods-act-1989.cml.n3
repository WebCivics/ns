doc:sec-41le-ss-2 a cof:Section ;
    cof:title "41LE(2) Reduction of conformity assessment fee where decision not" ;
    values:kind "subsection" ;
    values:originalText "(2) If the decision is not made within that period, the conformity assessment fee is 3/4 of the fee that, apart from this subsection, would have been the conformity assessment fee." ;
    cof:pageNumber "153"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41le-ss-3 a cml:Concept ;
    skos:prefLabel "41LE(3) Reduction of conformity assessment fee where decision not"@en ;
    cml:realizedBy doc:sec-41le-ss-3 ;
    values:originalText "(3) If: (a) the decision is made within that period; and (b) part of the conformity assessment fee under section 41LA is, because of subsection (1) of this section, unpaid when the decision is made; that part becomes due and payable on the making of the decision." ;
