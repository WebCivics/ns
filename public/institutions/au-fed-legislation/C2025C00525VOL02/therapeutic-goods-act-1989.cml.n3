doc:sec-41gf-ss-1 a cof:Section ;
    cof:title "41GF(1) Suspension where conformity assessment certificate" ;
    values:kind "subsection" ;
    values:originalText "(1) The Secretary may, by written notice given to the person in relation to whom a kind of medical device is included in the Register, suspend the kind of device from the Register if the conformity assessment certificate applying to that kind of device is suspended under Division 3 of Part 4-4." ;
    cof:pageNumber "97"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41gf-ss-2 a cml:Concept ;
    skos:prefLabel "41GF(2) Suspension where conformity assessment certificate"@en ;
    cml:realizedBy doc:sec-41gf-ss-2 ;
    values:originalText "(2) If the suspension under Division 3 of Part 4-4 is limited to some medical devices of that kind, the suspension under this section is taken to be limited to the same extent." ;
    skos:definition "(2) If the suspension under Division 3 of Part 4-4 is limited to some medical devices of that kind, the suspension under this section is taken to be limited to the same extent."@en ;
    cml:integrityHash "bbf02e053fa4c0c75216c7097e5c20fbcca633faa9a36186a30bdf657c616203" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41gf ;
    cof:pageNumber "97"^^xsd:integer ;
    skos:note "Suspension under this section is limited to the same extent as suspension under Division 3 of Part 4-4. Secretary must take action before suspending a device from the Register" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
