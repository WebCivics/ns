    values:partOf concept:therapeutic-goods-act-1989-sec-52e ;
    cof:pageNumber "344"^^xsd:integer ;
    skos:note "Must consider recommendations or advice from Advisory Committees Secretary must require person to provide further information within a reasonable time." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
