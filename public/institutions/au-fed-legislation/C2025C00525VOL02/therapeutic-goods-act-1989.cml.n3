concept:therapeutic-goods-act-1989-sec-55-ss-7 a cml:Concept ;
    skos:prefLabel "55(7) Conduct by directors, employees and agents"@en ;
    cml:realizedBy doc:sec-55-ss-7 ;
    values:originalText "(7) A reference in this section to a director of a body corporate includes a reference to a constituent member of a body corporate incorporated for a public purpose by a law of the Commonwealth, of a State or of a Territory." ;
    skos:definition "(7) A reference in this section to a director of a body corporate includes a reference to a constituent member of a body corporate incorporated for a public purpose by a law of the Commonwealth, of a State or of a Territory."@en ;
    cml:integrityHash "5ea19562c2955142a5b4c15c86cfb32f83097eca13fc4c41962cf730c53f4910" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-55 ;
    cof:pageNumber "358"^^xsd:integer ;
    skos:note "Directors, employees and agents of a body corporate are subject to this section." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
