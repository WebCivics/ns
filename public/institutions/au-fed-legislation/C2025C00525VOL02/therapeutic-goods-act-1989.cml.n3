concept:therapeutic-goods-act-1989-sec-41ed a cml:Concept ;
    skos:prefLabel "41ED Time for making decisions on applications"@en ;
    cml:realizedBy doc:sec-41ed ;
    values:originalText "If the application relates to the issuing of a conformity assessment certificate in relation to which a period has been prescribed under paragraph 63(2)(dc), a decision on the application must be made within that period, unless the application lapses under section 41EG." ;
    skos:definition "If the application relates to the issuing of a conformity assessment certificate in relation to which a period has been prescribed under paragraph 63(2)(dc), a decision on the application must be made within that period, unless the application lapses under section 41EG."@en ;
    cml:integrityHash "f780d6beb45a45183421d233eaedb0e1dca61a4e6216564bee9edc5c9513b56c" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "Decision on application must be made within a prescribed period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.49" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41ed-norm .
