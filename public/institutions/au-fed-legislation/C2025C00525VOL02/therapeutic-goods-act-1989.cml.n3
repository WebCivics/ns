doc:sec-41cd-ss-1 a cof:Section ;
    cof:title "41CD(1) Inconsistencies between medical device standards" ;
    values:kind "subsection" ;
    values:originalText "(1) A medical device standard that: (a) applies to a kind of medical device; and (b) is inconsistent with another medical device standard that applies only to some of the devices of that kind; is, to the extent of the inconsistency, of no effect in relation to the devices referred to in paragraph (b)." ;
    cof:pageNumber "35"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41cd-ss-2 a cml:Concept ;
    skos:prefLabel "41CD(2) Inconsistencies between medical device standards"@en ;
    cml:realizedBy doc:sec-41cd-ss-2 ;
    values:originalText "(2) A medical device standard that applies to a kind of medical device that consists of a combination of component parts takes precedence over any medical device standard that applies to the component parts.  Chapter 4  Medical devices" ;
    skos:definition "(2) A medical device standard that applies to a kind of medical device that consists of a combination of component parts takes precedence over any medical device standard that applies to the component parts.  Chapter 4  Medical devices"@en ;
    cml:integrityHash "51437262c401bbe0350840dc034168ee555a94219c9cc9653a5713bcd018caec" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41cd ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "A medical device standard for a combination of component parts takes precedence over standards for individual parts." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.35" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41cd-ss-2-norm .
