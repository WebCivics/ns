doc:sec-52d-ss-4a a cof:Section ;
    cof:title "52D(4A) Poisons Standard" ;
    values:kind "subsection" ;
    values:originalText "(4A) An instrument made under paragraph (2)(a) or (b) after the commencement of this subsection is a legislative instrument, but section 42 (disallowance) of the Legislation Act 2003 does not apply to the instrument." ;
    cof:pageNumber "343"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-52d-ss-4b a cml:Concept ;
    skos:prefLabel "52D(4B) Poisons Standard"@en ;
    cml:realizedBy doc:sec-52d-ss-4b ;
    values:originalText "(4B) Despite subsection 14(2) of the Legislation Act 2003, an instrument made under paragraph (2)(a) or (b) of this section may make provision in relation to a matter by applying, adopting or incorporating any matter contained in an instrument or other writing as in force or existing from time to time." ;
    skos:definition "(4B) Despite subsection 14(2) of the Legislation Act 2003, an instrument made under paragraph (2)(a) or (b) of this section may make provision in relation to a matter by applying, adopting or incorporating any matter contained in an instrument or other writing as in force or existing from time to time."@en ;
    cml:integrityHash "8cfcb722de9b3356b537cfc747c70a2466e075f1d0ea855654590583ade337e1" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-52d ;
    cof:pageNumber "343"^^xsd:integer ;
    skos:note "Allows for incorporation of existing provisions from other instruments or writings." ;
    cml:curationStatus cml:Proposed ;
