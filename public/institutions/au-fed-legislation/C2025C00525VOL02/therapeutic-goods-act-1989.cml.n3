concept:therapeutic-goods-act-1989-sec-41gp a cml:Concept ;
    skos:prefLabel "41GP Publication of cancellation of entry from Register"@en ;
    cml:realizedBy doc:sec-41gp ;
    values:originalText "The Secretary must cause to be published in the Gazette or on the Department’s website, as soon as practicable after cancelling an entry from the Register of a kind of medical device, or of some devices of a particular kind, a notice setting out particulars of the cancellation.  Medical devices  Chapter 4 Suspension and cancellation from the Register  Part 4-6 Cancellation of entries from the Register  Division 2 Section 41GQ Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "The Secretary must cause to be published in the Gazette or on the Department’s website, as soon as practicable after cancelling an entry from the Register of a kind of medical device, or of some devices of a particular kind, a notice setting out particulars of the cancellation.  Medical devices  Chapter 4 Suspension and cancellation from the Register  Part 4-6 Cancellation of entries from the Register  Division 2 Section 41GQ Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
    cml:integrityHash "e584f3c5b9d0f68cb805945dc2ff98262902c3a1f2551dfcb2483000f06ee7cd" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Publish notice of cancellation from Register after cancelling medical device entry." ;
    dc:description "Notice setting out particulars of cancellation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.106" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41gp-norm .
