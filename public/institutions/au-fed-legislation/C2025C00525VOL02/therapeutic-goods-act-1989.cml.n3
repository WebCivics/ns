concept:therapeutic-goods-act-1989-sec-67 a cml:Concept ;
    skos:prefLabel "67 Transitional provision for therapeutic goods for export only"@en ;
    cml:realizedBy doc:sec-67 ;
    values:originalText "Section 20 does not apply, during the period of 6 months after the commencement of this Act, to therapeutic goods manufactured in Australia solely for export from Australia." ;
    skos:definition "Section 20 does not apply, during the period of 6 months after the commencement of this Act, to therapeutic goods manufactured in Australia solely for export from Australia."@en ;
    cml:integrityHash "2e3de76f5908db2170ad3e585ad6d5eb47b79a8afdb9a8405458cd8ad7277a88" ;
    cof:pageNumber "392"^^xsd:integer ;
    skos:note "Therapeutic goods manufactured in Australia solely for export from Australia are exempt from Section 20 during the first 6 months after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.392" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-67-norm .
