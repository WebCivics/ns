doc:sec-42yg-ss-2 a cof:Section ;
    cof:title "42YG(2) Criminal proceedings during civil proceedings" ;
    values:kind "subsection" ;
    values:originalText "(2) The proceedings for the order may be resumed if the person is not convicted of the offence. Otherwise, the proceedings for the order are dismissed." ;
    cof:pageNumber "285"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-42yh a cml:Concept ;
    skos:prefLabel "42YH Criminal proceedings after civil proceedings"@en ;
    cml:realizedBy doc:sec-42yh ;
    values:originalText "Criminal proceedings may not be started against a person for conduct that is substantially the same as conduct constituting a contravention of a civil penalty provision if a pecuniary penalty order has been made against the person in respect of that conduct." ;
    skos:definition "Criminal proceedings may not be started against a person for conduct that is substantially the same as conduct constituting a contravention of a civil penalty provision if a pecuniary penalty order has been made against the person in respect of that conduct."@en ;
    cml:integrityHash "74189f65ca31bb32041099f1e1ccf2239aa77da7b9533bfdb3ba236eb7651070" ;
    cof:pageNumber "285"^^xsd:integer ;
    skos:note "Criminal proceedings cannot be started against a person for conduct substantially the same as a civil penalty provision if a pecuniary penalty order has been made." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
