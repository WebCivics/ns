concept:therapeutic-goods-act-1989-sec-66-ss-6 a cml:Concept ;
    skos:prefLabel "66(6) Transitional arrangements for goods required to be registered or"@en ;
    cml:realizedBy doc:sec-66-ss-6 ;
    values:originalText "(6) Where a person suffers any kind of loss, damage or injury caused by, or arising out of, the use by the person of therapeutic goods to which this section applies, no liability in respect of that loss, damage or injury attaches to the Commonwealth, the Secretary or any delegate of the Secretary." ;
    skos:definition "(6) Where a person suffers any kind of loss, damage or injury caused by, or arising out of, the use by the person of therapeutic goods to which this section applies, no liability in respect of that loss, damage or injury attaches to the Commonwealth, the Secretary or any delegate of the Secretary."@en ;
    cml:integrityHash "dfe2cef4144e62d12e2390015d8f9196825bbfad17e5ec8411815f65b0b475bb" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-66 ;
    cof:pageNumber "390"^^xsd:integer ;
    skos:note "No liability attaches to Commonwealth, Secretary, or delegate for losses caused by therapeutic goods." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
