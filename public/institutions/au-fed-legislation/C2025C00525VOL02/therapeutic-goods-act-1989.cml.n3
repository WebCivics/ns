concept:therapeutic-goods-act-1989-sec-54a a cml:Concept ;
    skos:prefLabel "54A Time for bringing prosecutions"@en ;
    cml:realizedBy doc:sec-54a ;
    values:originalText "A prosecution for an offence against this Act may be commenced at any time within 3 years after the commission of the offence.  Chapter 7  Miscellaneous  Section 54B Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "A prosecution for an offence against this Act may be commenced at any time within 3 years after the commission of the offence.  Chapter 7  Miscellaneous  Section 54B Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
