concept:therapeutic-goods-act-1989-sec-41jk a cml:Concept ;
    skos:prefLabel "41JK Simplified outline of this Part"@en ;
    cml:realizedBy doc:sec-41jk ;
    values:originalText "The chief executive officer (however described) of a healthcare facility is required to give a report to the Secretary about an adverse event involving a reportable medical device in certain circumstances. Civil penalties apply to the chief executive officer of a healthcare facility for failing to give such a report to the Secretary." ;
    skos:definition "The chief executive officer (however described) of a healthcare facility is required to give a report to the Secretary about an adverse event involving a reportable medical device in certain circumstances. Civil penalties apply to the chief executive officer of a healthcare facility for failing to give such a report to the Secretary."@en ;
    cml:integrityHash "b260062f8ba6fd8e1d7bf6c6a84d4c53f36aaf5816b7f6851e379b57b31c5939" ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Chief executive officer of a healthcare facility must report adverse events involving reportable medical devices." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.142" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41jk-norm .
