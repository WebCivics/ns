doc:sec-41ef-ss-2 a cof:Section ;
    cof:title "41EF(2) Duration of certificate" ;
    values:kind "subsection" ;
    values:originalText "(2) A conformity assessment certificate has effect at all times: (a) unless the certificate is suspended under Division 3; or (b) until the end of the period specified in the certificate, or if the Secretary extends that period, until the end of that extended period; or (c) until the certificate is revoked under Division 4. Extensions" ;
    cof:pageNumber "50"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41ef-ss-3 a cml:Concept ;
    skos:prefLabel "41EF(3) Duration of certificate"@en ;
    cml:realizedBy doc:sec-41ef-ss-3 ;
    values:originalText "(3) The Secretary may, in writing and on his or her own initiative, extend the period for which a conformity assessment certificate is in force." ;
    skos:definition "(3) The Secretary may, in writing and on his or her own initiative, extend the period for which a conformity assessment certificate is in force."@en ;
