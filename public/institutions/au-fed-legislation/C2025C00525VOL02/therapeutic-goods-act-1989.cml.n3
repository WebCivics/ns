concept:therapeutic-goods-act-1989-sec-42dn a cml:Concept ;
    skos:prefLabel "42DN Application of Division"@en ;
    cml:realizedBy doc:sec-42dn ;
    values:originalText "This Division applies to generic information about goods that: (a) may be used as an ingredient or component in the manufacture of therapeutic goods; and (b) although not presented for supply as therapeutic goods, come within the meaning of therapeutic goods because they are represented to be: (i) for therapeutic use; or (ii) for use as an ingredient or component in the manufacture of other therapeutic goods." ;
    skos:definition "This Division applies to generic information about goods that: (a) may be used as an ingredient or component in the manufacture of therapeutic goods; and (b) although not presented for supply as therapeutic goods, come within the meaning of therapeutic goods because they are represented to be: (i) for therapeutic use; or (ii) for use as an ingredient or component in the manufacture of other therapeutic goods."@en ;
    cml:integrityHash "80f849149a80a1a3d429d8961c644afb8d08fc2b8e95d0df447435d9194af0b2" ;
    cof:pageNumber "246"^^xsd:integer ;
    skos:note "Division applies to generic information about goods used in therapeutic goods manufacture or representation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
