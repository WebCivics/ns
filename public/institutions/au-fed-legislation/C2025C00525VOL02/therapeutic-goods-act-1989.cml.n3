concept:therapeutic-goods-act-1989-sec-41qb-ss-6 a cml:Concept ;
    skos:prefLabel "41QB(6) Offences and civil penalty provision—supplying vaping goods"@en ;
    cml:realizedBy doc:sec-41qb-ss-6 ;
    values:originalText "(6) This subsection applies in relation to the supply of the vaping goods by the person if: (a) the vaping goods are therapeutic goods that are entered on the Register; or (b) both of the following apply: (i) the vaping goods are therapeutic goods that are exempt goods under regulations made for the purposes of subsection 18(1) or an exempt device under regulations made for the purposes of subsection 41HA(1), and the sponsor has given the Secretary a notice in compliance with the exemption;  Chapter 4A  Vaping goods" ;
    skos:definition "(6) This subsection applies in relation to the supply of the vaping goods by the person if: (a) the vaping goods are therapeutic goods that are entered on the Register; or (b) both of the following apply: (i) the vaping goods are therapeutic goods that are exempt goods under regulations made for the purposes of subsection 18(1) or an exempt device under regulations made for the purposes of subsection 41HA(1), and the sponsor has given the Secretary a notice in compliance with the exemption;  Chapter 4A  Vaping goods"@en ;
    cml:integrityHash "2a82d74807b10840745e3337be654403282da2a52825e80fba16588578860f4a" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41qb ;
    cof:pageNumber "206"^^xsd:integer ;
    skos:note "Supply of vaping goods without proper exemption is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.206" ;
