concept:therapeutic-goods-act-1989-sec-44b a cml:Concept ;
    skos:prefLabel "44B Recovery of unpaid charges"@en ;
    cml:realizedBy doc:sec-44b ;
    values:originalText "An amount of an annual registration charge, an annual listing charge, an annual charge for inclusion in the Register, an annual licensing charge or an annual conformity assessment body determination charge that remains unpaid at the end of the period of 28 days after the day on which the charge becomes payable may be recovered by the Commonwealth as a debt due to the Commonwealth. Note: Section 44 sets out the day on which a charge becomes payable.  Administration  Chapter 6 Payment of charges  Part 6-1  Section 45 Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "An amount of an annual registration charge, an annual listing charge, an annual charge for inclusion in the Register, an annual licensing charge or an annual conformity assessment body determination charge that remains unpaid at the end of the period of 28 days after the day on which the charge becomes payable may be recovered by the Commonwealth as a debt due to the Commonwealth. Note: Section 44 sets out the day on which a charge becomes payable.  Administration  Chapter 6 Payment of charges  Part 6-1  Section 45 Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
    cml:integrityHash "31ba6f81b31f77db1c377a455200e1a54ae84bcc24c97f128af4bac6e07bf0c9" ;
    cof:pageNumber "304"^^xsd:integer ;
    skos:note "Recovery of unpaid charges after 28 days" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.304" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-44b-norm .
