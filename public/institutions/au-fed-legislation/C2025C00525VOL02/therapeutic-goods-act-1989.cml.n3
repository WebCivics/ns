concept:therapeutic-goods-act-1989-sec-52aa a cml:Concept ;
    skos:prefLabel "52AA Overview"@en ;
    cml:realizedBy doc:sec-52aa ;
    values:originalText "This Part provides the basis for a uniform system in Australia of access controls for goods containing scheduled substances. The scheduling of substances allows restrictions to be placed on their supply to the public, in the interests of public health and safety. This is aimed at minimising the risks of poisoning from, and the misuse and abuse of, scheduled substances." ;
    skos:definition "This Part provides the basis for a uniform system in Australia of access controls for goods containing scheduled substances. The scheduling of substances allows restrictions to be placed on their supply to the public, in the interests of public health and safety. This is aimed at minimising the risks of poisoning from, and the misuse and abuse of, scheduled substances."@en ;
    cml:integrityHash "c9a15ab67ef9d6e197068006d1a55acffe6e3b242e8aa8af0053598495ca16aa" ;
    cof:pageNumber "340"^^xsd:integer ;
    skos:note "Restrictions on supply of scheduled substances for public health and safety" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.340" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-52aa-norm .
