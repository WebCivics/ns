doc:sec-42w-ss-2 a cof:Section ;
    cof:title "42W(2) Supply etc. of therapeutic goods that are subject to recall" ;
    values:kind "subsection" ;
    values:originalText "(2) A person commits an offence if: (a) the person exports therapeutic goods from Australia; and (b) either: (i) the person knows that the therapeutic goods are of a kind, or are included in a batch, in respect of which requirements have been imposed under section 42V, on  Chapter 5  Advertising, counterfeit therapeutic goods and product tampering" ;
    cof:pageNumber "279"^^xsd:integer .

