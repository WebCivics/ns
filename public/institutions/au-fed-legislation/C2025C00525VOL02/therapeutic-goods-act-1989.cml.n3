doc:sec-66-ss-4b a cof:Section ;
    cof:title "66(4B) Transitional arrangements for goods required to be registered or" ;
    values:kind "subsection" ;
    values:originalText "(4B) If, on an application under subsection (3), goods have been listed without consideration of the matters mentioned in paragraphs 26(1)(c) to (m), the Secretary may, if he or she thinks it appropriate, give the person in relation to whom the goods are listed written notice that the Secretary intends to determine whether the goods should continue to be listed." ;
    cof:pageNumber "390"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-66-ss-4c a cml:Concept ;
    skos:prefLabel "66(4C) Transitional arrangements for goods required to be registered or"@en ;
    cml:realizedBy doc:sec-66-ss-4c ;
    values:originalText "(4C) If notice is given under subsection (4B), section 26 applies as if the person in relation to whom the goods are listed were an applicant for the listing of the goods." ;
    skos:definition "(4C) If notice is given under subsection (4B), section 26 applies as if the person in relation to whom the goods are listed were an applicant for the listing of the goods."@en ;
