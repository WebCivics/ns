concept:therapeutic-goods-act-1989-sec-41bf a cml:Concept ;
    skos:prefLabel "41BF System or procedure packs"@en ;
    cml:realizedBy doc:sec-41bf ;
    values:originalText "Two or more goods (including at least one medical device) are a system or procedure pack if: (a) all of the goods are to be interconnected or combined for use in a medical or surgical procedure; or (b) all of the goods are packaged together for use in a medical or surgical procedure." ;
    skos:definition "Two or more goods (including at least one medical device) are a system or procedure pack if: (a) all of the goods are to be interconnected or combined for use in a medical or surgical procedure; or (b) all of the goods are packaged together for use in a medical or surgical procedure."@en ;
    cml:integrityHash "b657e94d26791d98c791bec283cfd331c76b343a6df57548bb80ea0dc9dad9b3" ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Goods are a system or procedure pack if they are interconnected or combined for use in a medical or surgical procedure." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.26" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41bf-norm .
