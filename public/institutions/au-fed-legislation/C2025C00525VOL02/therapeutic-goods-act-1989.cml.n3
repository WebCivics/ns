concept:therapeutic-goods-act-1989-sec-42da a cml:Concept ;
    skos:prefLabel "42DA Simplified outline of this Division"@en ;
    cml:realizedBy doc:sec-42da ;
    values:originalText "Representations in advertisements about therapeutic goods may be restricted representations, required representations or prohibited representations. The offences and civil penalties in Division 3A refer to these 3 kinds of representations." ;
    skos:definition "Representations in advertisements about therapeutic goods may be restricted representations, required representations or prohibited representations. The offences and civil penalties in Division 3A refer to these 3 kinds of representations."@en ;
    cml:integrityHash "a01522bf8aee7f051c46fc990da56ce63c1321667697e60aebe3ca0009211fd0" ;
    cof:pageNumber "230"^^xsd:integer ;
    skos:note "Representations in advertisements about therapeutic goods may be restricted, required or prohibited." ;
    cml:curationStatus cml:Proposed ;
