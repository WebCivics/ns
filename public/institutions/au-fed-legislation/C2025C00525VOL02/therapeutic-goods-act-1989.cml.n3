doc:sec-42vb-ss-1 a cof:Section ;
    cof:title "42VB(1) Relief from liability for contraventions relating to the recall of" ;
    values:kind "subsection" ;
    values:originalText "(1) If: (a) proceedings for the contravention of section 42VA (a civil penalty provision) are brought against a person; and (b) in the proceedings it appears to the Court that the person has, or may have, contravened that section but that: (i) the person has acted honestly; and (ii) having regard to all the circumstances of the case, the person ought fairly to be excused for the contravention; the Court may relieve the person either wholly or partly from a liability to which the person would otherwise be subject, or that might otherwise be imposed on the person, because of the contravention." ;
    cof:pageNumber "278"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-42vb-ss-2 a cml:Concept ;
    skos:prefLabel "42VB(2) Relief from liability for contraventions relating to the recall of"@en ;
    cml:realizedBy doc:sec-42vb-ss-2 ;
    values:originalText "(2) If a person thinks that proceedings for the contravention of section 42VA will or may be begun against them, they may apply to the Court for relief." ;
    skos:definition "(2) If a person thinks that proceedings for the contravention of section 42VA will or may be begun against them, they may apply to the Court for relief."@en ;
    cml:integrityHash "2e5c7a137962c02aab1ed8ce30f76605eb1a06905804468510701037b1c7cd5a" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-42vb ;
    cof:pageNumber "278"^^xsd:integer ;
    skos:note "Right to apply for relief from liability" ;
    cml:curationStatus cml:Proposed ;
