concept:therapeutic-goods-act-1989-sec-41bg-ss-4 a cml:Concept ;
    skos:prefLabel "41BG(4) Manufacturers of medical devices"@en ;
    cml:realizedBy doc:sec-41bg-ss-4 ;
    values:originalText "(4) A person is not the manufacturer of a medical device if the person is included in a class of persons prescribed by the regulations for the purposes of this subsection. Note: This section applies in relation to vaping goods that are a medical device." ;
    skos:definition "(4) A person is not the manufacturer of a medical device if the person is included in a class of persons prescribed by the regulations for the purposes of this subsection. Note: This section applies in relation to vaping goods that are a medical device."@en ;
    cml:integrityHash "5b48feb6132b6d5ff4ab89dd9b73daa69e1e3f97b2f74e69552708f27701d63d" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41bg ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Exempts individuals from being considered manufacturers of medical devices if they are part of a prescribed class." ;
    cml:curationStatus cml:Proposed ;
