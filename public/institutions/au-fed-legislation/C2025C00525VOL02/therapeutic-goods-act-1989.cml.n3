concept:therapeutic-goods-act-1989-sec-41g a cml:Concept ;
    skos:prefLabel "41G What this Part is about"@en ;
    cml:realizedBy doc:sec-41g ;
    values:originalText "Inclusions in the Register may be suspended in certain circumstances, such as when a conformity assessment document is suspended. A kind of medical device that is suspended is taken not to be included in the Register for most purposes. Inclusions in the Register may also be cancelled in certain circumstances." ;
    skos:definition "Inclusions in the Register may be suspended in certain circumstances, such as when a conformity assessment document is suspended. A kind of medical device that is suspended is taken not to be included in the Register for most purposes. Inclusions in the Register may also be cancelled in certain circumstances."@en ;
    cml:integrityHash "a68f537923f96e3c1cd0a9b5629a612d08e1630ded0f256b8bfc902f33fab6f9" ;
    cof:pageNumber "93"^^xsd:integer ;
    skos:note "Inclusions in the Register may be suspended or cancelled under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.93" ;
