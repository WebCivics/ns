doc:sec-41hc-ss-6a a cof:Section ;
    cof:title "41HC(6A) Authorities for health practitioners" ;
    values:kind "subsection" ;
    values:originalText "(6A) In making rules under subsection (6), the Minister must comply with: (a) such requirements (if any) as are prescribed by the regulations; and (b) such restrictions (if any) as are prescribed by the regulations; and (c) such limitations (if any) as are prescribed by the regulations." ;
    cof:pageNumber "118"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41hc-ss-6b a cml:Concept ;
    skos:prefLabel "41HC(6B) Authorities for health practitioners"@en ;
    cml:realizedBy doc:sec-41hc-ss-6b ;
    values:originalText "(6B) If: (a) a person is authorised, by subsection (6) rules, to supply a specified kind of medical device; and (b) the person supplies a medical device of that kind in accordance with those rules; the person must: (c) notify the supply to the Secretary; and (d) do so within 28 days after the supply." ;
    skos:definition "(6B) If: (a) a person is authorised, by subsection (6) rules, to supply a specified kind of medical device; and (b) the person supplies a medical device of that kind in accordance with those rules; the person must: (c) notify the supply to the Secretary; and (d) do so within 28 days after the supply."@en ;
    cml:integrityHash "f8aff130f6ec9d4a93d62f804116cd2a51103c75b6df027e0083bcdc55c87cb3" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41hc ;
    cof:pageNumber "118"^^xsd:integer ;
    skos:note "Notify supply within 28 days after supplying medical device." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
