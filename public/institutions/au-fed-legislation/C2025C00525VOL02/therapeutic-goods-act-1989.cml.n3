concept:therapeutic-goods-act-1989-sec-41bi-ss-1 a cml:Concept ;
    skos:prefLabel "41BI(1) Meaning of non-application of conformity assessment"@en ;
    cml:realizedBy doc:sec-41bi-ss-1 ;
    values:originalText "(1) An overseas regulator is a body determined in an instrument under subsection (2)." ;
    skos:definition "(1) An overseas regulator is a body determined in an instrument under subsection (2)."@en ;
    cml:integrityHash "2e12d7771e202b463a9831a6c8e2c33841f04ddc73e2d8167f056399ac727b32" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41bi ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Defines overseas regulator A conformity assessment procedure is not applied if there has been a contravention of the procedures. A requirement that is comparable to a conformity assessment procedure is not applied if there has been a contravention of the requirement." ;
