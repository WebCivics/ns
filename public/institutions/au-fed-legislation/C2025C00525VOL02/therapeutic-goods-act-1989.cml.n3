doc:sec-41bi-ss-1 a cof:Section ;
    cof:title "41BI(1) Meaning of non-application of conformity assessment" ;
    values:kind "subsection" ;
    values:originalText "(1) An overseas regulator is a body determined in an instrument under subsection (2)." ;
    cof:pageNumber "28"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41bi-ss-2 a cml:Concept ;
    skos:prefLabel "41BI(2) Meaning of non-application of conformity assessment"@en ;
    cml:realizedBy doc:sec-41bi-ss-2 ;
    values:originalText "(2) The Secretary may, by notifiable instrument, determine a body for the purposes of subsection (1). The Secretary must be satisfied that the body: (a) is established outside Australia; and (b) is empowered to issue certificates or other documents to the effect that the body is satisfied that requirements, comparable to the conformity assessment procedures, have been applied to medical devices by the manufacturers of the devices." ;
    skos:definition "(2) The Secretary may, by notifiable instrument, determine a body for the purposes of subsection (1). The Secretary must be satisfied that the body: (a) is established outside Australia; and (b) is empowered to issue certificates or other documents to the effect that the body is satisfied that requirements, comparable to the conformity assessment procedures, have been applied to medical devices by the manufacturers of the devices."@en ;
    cml:integrityHash "d2ed811c0d8c04d387fe3897330a16172068874086513aaa37c6a8e7b74af708" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41bi ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "The Secretary may determine a body for the purposes of subsection (1). Exemptions from conformity assessment requirements" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.28" ;
