doc:sec-41ff-ss-1a a cof:Section ;
    cof:title "41FF(1A) Obligation to include kinds of medical devices in the Register" ;
    values:kind "subsection" ;
    values:originalText "(1A) However, the Secretary must not include the kind of device in the Register in relation to the person if the Secretary is satisfied that the kind of device is to be used exclusively for one or more of the purposes specified under section 41BEA.  Medical devices  Chapter 4 Including medical devices in the Register  Part 4-5 Including medical devices in the Register  Division 1 Section 41FG Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    cof:pageNumber "80"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41ff-ss-2 a cml:Concept ;
    skos:prefLabel "41FF(2) Obligation to include kinds of medical devices in the Register"@en ;
    cml:realizedBy doc:sec-41ff-ss-2 ;
    values:originalText "(2) As soon as practicable after the kind of device has been included in the Register, the Secretary must make available to the applicant a certificate of the inclusion of the kind of device in the Register." ;
    skos:definition "(2) As soon as practicable after the kind of device has been included in the Register, the Secretary must make available to the applicant a certificate of the inclusion of the kind of device in the Register."@en ;
    cml:integrityHash "f1127fa868a80c7fbe5b619e79897cf27de75fa634c89743b98a801c610b6eb7" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41ff ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "The Secretary must provide a certificate of inclusion to the applicant." ;
    dc:description "Yes" ;
