concept:therapeutic-goods-act-1989-sec-55-ss-5 cml:asserts concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "No imprisonment implies obligation to refrain from punishment" ;
    cml:premiseText "(5) Where: ... the person is not liable to be punished by imprisonment for that offence." ;
    cml:conclusionText "If a person would not have been convicted of the offence if subsections (3) and (4) had not been enacted, then they are not liable to be punished by imprisonment for that offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-55-ss-5 cml:asserts concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-deontic-2 .
concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permits" ;
    cml:logicSummary "Imprisonment permits other forms of punishment" ;
    cml:premiseText "(5) Where: ... the person is not liable to be punished by imprisonment for that offence." ;
    cml:conclusionText "If a person would not have been convicted of the offence if subsections (3) and (4) had not been enacted, then they are permitted to receive other forms of punishment" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-55-ss-5 cml:asserts concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-linearlogic-3 .
concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-linearlogic-3 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "And" ;
    cml:logicSummary "No imprisonment implies obligation to refrain from punishment and permits other forms of punishment" ;
    cml:premiseText "(5) Where: ... the person is not liable to be punished by imprisonment for that offence." ;
    cml:conclusionText "If a person would not have been convicted of the offence if subsections (3) and (4) had not been enacted, then they are permitted to receive other forms of punishment" ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-55-ss-5 cml:asserts concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-deontic-4 .
concept:therapeutic-goods-act-1989-sec-55-ss-5-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Justifies" ;
    cml:logicSummary "Obligation to refrain from punishment justifies no imprisonment" ;
    cml:premiseText "(5) Where: ... the person is not liable to be punished by imprisonment for that offence." ;
    cml:conclusionText "If a person would not have been convicted of the offence if subsections (3) and (4) had not been enacted, then they are justified in refraining from punishment" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-55-ss-5 a cof:Section ;
    cof:title "55(5) Conduct by directors, employees and agents" ;
    values:kind "subsection" ;
    values:originalText "(5) Where: (a) a person other than a body corporate is convicted of an offence; and (b) the person would not have been convicted of the offence if subsections (3) and (4) had not been enacted; the person is not liable to be punished by imprisonment for that offence." ;
    cof:pageNumber "358"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-55-ss-6 a cml:Concept ;
    skos:prefLabel "55(6) Conduct by directors, employees and agents"@en ;
    cml:realizedBy doc:sec-55-ss-6 ;
    values:originalText "(6) A reference in subsection (1) or (3) to the state of mind of a person includes a reference to: (a) the knowledge, intention, opinion, belief or purpose of the person; and (b) the person’s reasons for the intention, opinion, belief or purpose.  Chapter 7  Miscellaneous  Section 56 Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "(6) A reference in subsection (1) or (3) to the state of mind of a person includes a reference to: (a) the knowledge, intention, opinion, belief or purpose of the person; and (b) the person’s reasons for the intention, opinion, belief or purpose.  Chapter 7  Miscellaneous  Section 56 Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
    cml:integrityHash "1315e6721d4b51124c656bce1be24f8086c4f37b4a4a0b06d6ed6f97a99d13e4" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-55 ;
    cof:pageNumber "358"^^xsd:integer ;
    skos:note "Directors, employees and agents must have certain knowledge or reasons for their intentions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.358" ;
