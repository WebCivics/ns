concept:therapeutic-goods-act-1989-sec-41k a cml:Concept ;
    skos:prefLabel "41K What this Part is about"@en ;
    cml:realizedBy doc:sec-41k ;
    values:originalText "The Secretary can require action to recall medical devices, or to inform the public about medical devices, that do not comply with requirements or cannot lawfully be supplied." ;
    skos:definition "The Secretary can require action to recall medical devices, or to inform the public about medical devices, that do not comply with requirements or cannot lawfully be supplied."@en ;
    cml:integrityHash "afa864ca91e980ec4d85c8858dac087e6c1de7ccc1c4598f671d86c80d545a1c" ;
    cof:pageNumber "145"^^xsd:integer ;
    skos:note "The Secretary can require action to recall medical devices, or to inform the public about medical devices that do not comply with requirements or cannot lawfully be supplied." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.145" ;
