concept:therapeutic-goods-act-1989-sec-41jl a cml:Concept ;
    skos:prefLabel "41JL Purposes of this Part"@en ;
    cml:realizedBy doc:sec-41jl ;
    values:originalText "The purposes of this Part are to facilitate the following: (a) monitoring and enforcing compliance with the requirements of this Chapter; (b) monitoring the safety and performance of medical devices; (c) any activities that are incidental to the above purposes.  Medical devices  Chapter 4 Mandatory reporting of adverse events by healthcare facilities  Part 4-8A Mandatory reporting of adverse events  Division 2 Section 41JM Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "The purposes of this Part are to facilitate the following: (a) monitoring and enforcing compliance with the requirements of this Chapter; (b) monitoring the safety and performance of medical devices; (c) any activities that are incidental to the above purposes.  Medical devices  Chapter 4 Mandatory reporting of adverse events by healthcare facilities  Part 4-8A Mandatory reporting of adverse events  Division 2 Section 41JM Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
    cml:integrityHash "cc223507a91967353f45d94c790d78d919a2be2fdc863f0392de62c19ae87030" ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Facilitate monitoring and enforcing compliance with Chapter requirements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
