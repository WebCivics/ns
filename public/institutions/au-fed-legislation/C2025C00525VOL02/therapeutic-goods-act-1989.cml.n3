    cof:pageNumber "65"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41f a cml:Concept ;
    skos:prefLabel "41F What this Part is about"@en ;
    cml:realizedBy doc:sec-41f ;
    values:originalText "Kinds of medical devices can be included in the Register if they comply with the essential principles, and conformity assessment procedures have been applied to the kinds of devices or requirements, comparable to those procedures, have been applied to the kinds of devices (and certain other requirements are complied with). Inclusions in the Register are subject to certain automatic conditions and the Secretary may impose further conditions.  Medical devices  Chapter 4 Including medical devices in the Register  Part 4-5 Including medical devices in the Register  Division 1 Section 41FA Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    skos:definition "Kinds of medical devices can be included in the Register if they comply with the essential principles, and conformity assessment procedures have been applied to the kinds of devices or requirements, comparable to those procedures, have been applied to the kinds of devices (and certain other requirements are complied with). Inclusions in the Register are subject to certain automatic conditions and the Secretary may impose further conditions.  Medical devices  Chapter 4 Including medical devices in the Register  Part 4-5 Including medical devices in the Register  Division 1 Section 41FA Therapeutic Goods Act 1989 Compilation date: 05/09/2025"@en ;
    cml:integrityHash "31cfed3971b7703e206891fb100d673a48d9b4cb7fc4c66b937209bf54730f61" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Medical devices must comply with certain principles and requirements to be included in the Register." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.72" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41f-norm .
