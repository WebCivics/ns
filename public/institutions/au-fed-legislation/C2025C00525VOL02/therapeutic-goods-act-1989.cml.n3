concept:therapeutic-goods-act-1989-sec-66-ss-5 a cml:Concept ;
    skos:prefLabel "66(5) Transitional arrangements for goods required to be registered or"@en ;
    cml:realizedBy doc:sec-66-ss-5 ;
    values:originalText "(5) Section 21 does not apply, during the period of 15 months after the commencement of this Act or during such longer period as the Secretary specifies by notice published in the Gazette before the end of that first-mentioned period, to any goods." ;
    skos:definition "(5) Section 21 does not apply, during the period of 15 months after the commencement of this Act or during such longer period as the Secretary specifies by notice published in the Gazette before the end of that first-mentioned period, to any goods."@en ;
    cml:integrityHash "a61163ad065da808b32700788acc0390d6decf6c0d3e01edf699b4b2a956e15f" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-66 ;
    cof:pageNumber "390"^^xsd:integer ;
    skos:note "Exemption from Section 21 for goods during transitional period" ;
    cml:curationStatus cml:Proposed ;
