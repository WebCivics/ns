concept:therapeutic-goods-act-1989-sec-42dl a cml:Concept ;
    skos:prefLabel "42DL Advertising offences—general"@en ;
    cml:realizedBy doc:sec-42dl ;
    values:originalText "(1) A person commits an offence if: (a) the person: (i) advertises, by any means, therapeutic goods; or (ii) causes the advertising, by any means, of therapeutic goods; and (b) subsection (5), (6), (7), (8), (9), (10), (11) or (12) applies to the advertisement; and (c) either:  Chapter 5  Advertising, counterfeit therapeutic goods and product tampering" ;
    skos:definition "(1) A person commits an offence if: (a) the person: (i) advertises, by any means, therapeutic goods; or (ii) causes the advertising, by any means, of therapeutic goods; and (b) subsection (5), (6), (7), (8), (9), (10), (11) or (12) applies to the advertisement; and (c) either:  Chapter 5  Advertising, counterfeit therapeutic goods and product tampering"@en ;
    cml:integrityHash "67d75f88f57d810867bd4e6480d6442b91cf7557412db022110facdc6443d793" ;
    cof:pageNumber "235"^^xsd:integer ;
    skos:note "Advertising therapeutic goods without permission is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.235" ;
