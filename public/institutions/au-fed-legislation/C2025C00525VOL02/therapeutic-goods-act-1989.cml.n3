doc:sec-41fk-ss-1 a cof:Section ;
    cof:title "41FK(1) Lapsing of applications" ;
    values:kind "subsection" ;
    values:originalText "(1) The regulations may make provision for and in relation to empowering the Secretary to make medical devices (priority applicant) determinations." ;
    cof:pageNumber "84"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41fk-ss-2 a cml:Concept ;
    skos:prefLabel "41FK(2) Lapsing of applications"@en ;
    cml:realizedBy doc:sec-41fk-ss-2 ;
    values:originalText "(2) A medical devices (priority applicant) determination is a determination that, for the purposes of this Act, a specified person is a priority applicant in relation to any section 41FC application that may be made by the person for the inclusion in the Register of a medical device of a kind specified in the determination." ;
    skos:definition "(2) A medical devices (priority applicant) determination is a determination that, for the purposes of this Act, a specified person is a priority applicant in relation to any section 41FC application that may be made by the person for the inclusion in the Register of a medical device of a kind specified in the determination."@en ;
    cml:integrityHash "c2937f5ac7b008aadb8e1b078719d36302be931ab42d7afb99ae4893fcda0586" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41fk ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "A medical devices (priority applicant) determination is a specified person's priority applicant in relation to any section 41FC application." ;
