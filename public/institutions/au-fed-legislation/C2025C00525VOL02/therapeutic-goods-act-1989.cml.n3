concept:therapeutic-goods-act-1989-sec-41l a cml:Concept ;
    skos:prefLabel "41L What this Part is about"@en ;
    cml:realizedBy doc:sec-41l ;
    values:originalText "Conformity assessment fees must be paid for consideration of applications for conformity assessment certificates. Application audit assessment fees must be paid for auditing applications that are required to be selected for auditing under paragraph 41FH(1)(a)." ;
    skos:definition "Conformity assessment fees must be paid for consideration of applications for conformity assessment certificates. Application audit assessment fees must be paid for auditing applications that are required to be selected for auditing under paragraph 41FH(1)(a)."@en ;
    cml:integrityHash "f64f606ebfdf8fd391ef598deb8e2d27162da36286810e7e5e179d4733f29218" ;
    cof:pageNumber "151"^^xsd:integer ;
    skos:note "Fees must be paid for consideration of applications and auditing." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
