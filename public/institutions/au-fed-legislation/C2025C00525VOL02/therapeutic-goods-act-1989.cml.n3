doc:sec-41fh-ss-1 a cof:Section ;
    cof:title "41FH(1) Selecting applications for auditing" ;
    values:kind "subsection" ;
    values:originalText "(1) The Secretary: (a) must select for auditing any application for a kind of medical device to be included in the Register that is an application of the kind prescribed by the regulations; and (b) may select for auditing any other application for a kind of medical device to be included in the Register. Note: An application audit assessment fee is payable in respect of any application that the Secretary must select for auditing: see Part 4-10." ;
    cof:pageNumber "81"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41fh-ss-2 a cml:Concept ;
    skos:prefLabel "41FH(2) Selecting applications for auditing"@en ;
    cml:realizedBy doc:sec-41fh-ss-2 ;
    values:originalText "(2) If an application is selected for auditing: (a) the Secretary must give the applicant a written notice (the selection notice) that: (i) informs the applicant of the selection; and  Chapter 4  Medical devices" ;
    skos:definition "(2) If an application is selected for auditing: (a) the Secretary must give the applicant a written notice (the selection notice) that: (i) informs the applicant of the selection; and  Chapter 4  Medical devices"@en ;
    cml:integrityHash "8536d4d4f5fd77c61a573183c8f4ceda10c77683da40aa2e5111c094cbded674" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41fh ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Secretary must give applicant a written notice upon selection for auditing." ;
    dc:description "written notice" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
