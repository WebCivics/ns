doc:sec-54-ss-4 a cof:Section ;
    cof:title "54(4) Offences and forfeiture" ;
    values:kind "subsection" ;
    values:originalText "(4) Where goods are so forfeited, the Secretary may cause notice of the forfeiture to be published in the Gazette or on the Department’s website.  Chapter 7  Miscellaneous  Section 54AA Therapeutic Goods Act 1989 Compilation date: 05/09/2025" ;
    cof:pageNumber "351"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-54-ss-5 a cml:Concept ;
    skos:prefLabel "54(5) Offences and forfeiture"@en ;
    cml:realizedBy doc:sec-54-ss-5 ;
    values:originalText "(5) Goods forfeited under an order referred to in subsection (3) are to be disposed of in such manner as the Secretary directs. Note: See also Part 6-2A, which provides for forfeiture of things seized in certain circumstances." ;
    skos:definition "(5) Goods forfeited under an order referred to in subsection (3) are to be disposed of in such manner as the Secretary directs. Note: See also Part 6-2A, which provides for forfeiture of things seized in certain circumstances."@en ;
    cml:integrityHash "1ef1fdfd689ec48b7d8c5d6f19dae8d04b2c93115dff01974ac2209120b2ecdd" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-54 ;
    cof:pageNumber "351"^^xsd:integer ;
    skos:note "Goods forfeited under an order must be disposed of in a manner specified by the Secretary." ;
