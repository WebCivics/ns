doc:sec-42dw-ss-3 a cof:Section ;
    cof:title "42DW(3) Offences—contravening direction under section 42DV" ;
    values:kind "subsection" ;
    values:originalText "(3) A person commits an offence if: (a) the Secretary has given a direction to the person under subsection 42DV(1) or (2); and (b) the person does an act or omits to do an act; and (c) the act or omission contravenes the direction or a condition of the direction. Penalty: 100 penalty units." ;
    cof:pageNumber "252"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-42dw-ss-4 a cml:Concept ;
    skos:prefLabel "42DW(4) Offences—contravening direction under section 42DV"@en ;
    cml:realizedBy doc:sec-42dw-ss-4 ;
    values:originalText "(4) An offence against subsection (3) is an offence of strict liability." ;
