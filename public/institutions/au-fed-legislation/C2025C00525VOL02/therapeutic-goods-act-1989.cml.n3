concept:therapeutic-goods-act-1989-sec-41bk a cml:Concept ;
    skos:prefLabel "41BK Application of the Criminal Code"@en ;
    cml:realizedBy doc:sec-41bk ;
    values:originalText "Chapter 2 of the Criminal Code applies to all offences against this Chapter. Note: Chapter 2 of the Criminal Code sets out the general principles of criminal responsibility.  Chapter 4  Medical devices" ;
