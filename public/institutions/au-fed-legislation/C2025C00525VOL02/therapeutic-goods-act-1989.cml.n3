concept:therapeutic-goods-act-1989-sec-42do a cml:Concept ;
    skos:prefLabel "42DO Compliance with the Code"@en ;
    cml:realizedBy doc:sec-42do ;
    values:originalText "Generic information to which this Division applies must comply with the provisions of the Therapeutic Goods Advertising Code that are prescribed by the regulations for the purposes of this section as if those provisions applied to generic information in the same way as they apply to advertisements." ;
    skos:definition "Generic information to which this Division applies must comply with the provisions of the Therapeutic Goods Advertising Code that are prescribed by the regulations for the purposes of this section as if those provisions applied to generic information in the same way as they apply to advertisements."@en ;
