concept:therapeutic-goods-act-1989-sec-41fj a cml:Concept ;
    skos:prefLabel "41FJ Procedure following audits"@en ;
    cml:realizedBy doc:sec-41fj ;
    values:originalText "After auditing the application, the Secretary must: (a) notify the applicant in writing of his or her decision within 20 working days after the decision is made; and (b) if the decision is not to include the kind of device to which the application relates in the Register—state in the notice the reasons for the decision; and  Chapter 4  Medical devices" ;
    skos:definition "After auditing the application, the Secretary must: (a) notify the applicant in writing of his or her decision within 20 working days after the decision is made; and (b) if the decision is not to include the kind of device to which the application relates in the Register—state in the notice the reasons for the decision; and  Chapter 4  Medical devices"@en ;
    cml:integrityHash "0c578b05f1c711a460af00234e745f7a6d3188f0537353bbba26d6a39b8c3889" ;
    cof:pageNumber "83"^^xsd:integer ;
    skos:note "Notify applicant of decision within 20 working days and state reasons for non-inclusion in Register if applicable." ;
    dc:description "Decision notice with reasons" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.83" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-41fj-norm .
