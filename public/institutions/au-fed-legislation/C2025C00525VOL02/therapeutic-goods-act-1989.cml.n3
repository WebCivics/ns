concept:therapeutic-goods-act-1989-sec-41er a cml:Concept ;
    skos:prefLabel "41ER Automatic revocation of conformity assessment certificates"@en ;
    cml:realizedBy doc:sec-41er ;
    values:originalText "The Secretary must, by written notice given to the person in relation to whom a conformity assessment certificate is issued, revoke the certificate if: (a) the certificate has been suspended under section 41EM; and (b) the period applying to the suspension under subsection 41EM(3) or 41EO(3) (as the case requires) expires before the suspension is revoked under section 41EP." ;
    skos:definition "The Secretary must, by written notice given to the person in relation to whom a conformity assessment certificate is issued, revoke the certificate if: (a) the certificate has been suspended under section 41EM; and (b) the period applying to the suspension under subsection 41EM(3) or 41EO(3) (as the case requires) expires before the suspension is revoked under section 41EP."@en ;
    cml:integrityHash "d388086aaf85dd8df60999f1ea4b03200759d1416fb35dbb2a831d90eec7878d" ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "Revocation of conformity assessment certificates upon expiration of suspension period" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.61" ;
