concept:therapeutic-goods-act-1989-sec-42yl-ss-4 a cml:Concept ;
    skos:prefLabel "42YL(4) Enforcement of undertakings"@en ;
    cml:realizedBy doc:sec-42yl-ss-4 ;
    values:originalText "(4) If the Secretary considers that the person who gave the undertaking has breached any of its terms, the Secretary may apply to the Federal Court for an order under subsection (5)." ;
    skos:definition "(4) If the Secretary considers that the person who gave the undertaking has breached any of its terms, the Secretary may apply to the Federal Court for an order under subsection (5)."@en ;
    cml:integrityHash "ea84486e1dfe4a062cd7cd6e19f3659f8a05716264011671bc83e28b434bdedd" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-42yl ;
    cof:pageNumber "295"^^xsd:integer ;
    skos:note "Secretary may apply for order if undertaking is breached" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
