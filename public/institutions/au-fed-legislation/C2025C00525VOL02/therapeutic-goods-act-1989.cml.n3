doc:sec-42yf a cof:Section ;
    cof:title "42YF Civil proceedings after criminal proceedings" ;
    values:kind "section" ;
    values:originalText "The Federal Court must not make a pecuniary penalty order against a person for a contravention of a civil penalty provision if the person has been convicted of an offence constituted by conduct that is substantially the same as the conduct constituting the contravention." ;
    cof:pageNumber "285"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-42yg a cml:Concept ;
    skos:prefLabel "42YG Criminal proceedings during civil proceedings"@en ;
    cml:realizedBy doc:sec-42yg ;
    values:originalText "(1) Proceedings for a pecuniary penalty order against a person for a contravention of a civil penalty provision are stayed if: (a) criminal proceedings are started or have already been started against the person for an offence; and (b) the offence is constituted by conduct that is substantially the same as the conduct alleged to constitute the contravention. (2) The proceedings for the order may be resumed if the person is not convicted of the offence. Otherwise, the proceedings for the order are dismissed." ;
    skos:definition "(1) Proceedings for a pecuniary penalty order against a person for a contravention of a civil penalty provision are stayed if: (a) criminal proceedings are started or have already been started against the person for an offence; and (b) the offence is constituted by conduct that is substantially the same as the conduct alleged to constitute the contravention. (2) The proceedings for the order may be resumed if the person is not convicted of the offence. Otherwise, the proceedings for the order are dismissed."@en ;
    cml:integrityHash "69f5a8b9b469f6d40ef06e508fb4c5ebb0ff5eb10e35713a018e24113e39e58f" ;
    cof:pageNumber "285"^^xsd:integer ;
    cml:hasPart concept:therapeutic-goods-act-1989-sec-42yg-ss-1 ;
    cml:hasPart concept:therapeutic-goods-act-1989-sec-42yg-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.285" .
