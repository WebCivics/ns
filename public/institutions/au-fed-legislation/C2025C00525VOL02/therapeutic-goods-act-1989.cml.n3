concept:therapeutic-goods-act-1989-sec-41ef-ss-6 a cml:Concept ;
    skos:prefLabel "41EF(6) Duration of certificate"@en ;
    cml:realizedBy doc:sec-41ef-ss-6 ;
    values:originalText "(6) The Secretary: (a) must give notice of an extension to the manufacturer in relation to whom the certificate was issued; and (b) may give notice of an extension to the applicant for the certificate (if the applicant is not the manufacturer)." ;
    skos:definition "(6) The Secretary: (a) must give notice of an extension to the manufacturer in relation to whom the certificate was issued; and (b) may give notice of an extension to the applicant for the certificate (if the applicant is not the manufacturer)."@en ;
