doc:sec-46a-ss-3 a cof:Section ;
    cof:title "46A(3) Searches of certain premises to monitor compliance with Act" ;
    values:kind "subsection" ;
    values:originalText "(3) An authorised person is not entitled to exercise any powers under subsection (1) in relation to premises if: (a) the occupier of the premises has required the authorised person to produce his or her identity card for inspection by the occupier; and (b) the authorised person fails to comply with the requirement." ;
    cof:pageNumber "314"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-46a-ss-4 a cml:Concept ;
    skos:prefLabel "46A(4) Searches of certain premises to monitor compliance with Act"@en ;
    cml:realizedBy doc:sec-46a-ss-4 ;
    values:originalText "(4) This section applies to: (a) premises of a person: (iaa) who is required to comply with a condition of an exemption of vaping goods under section 18 or 41HA; or (ia) who is required to comply with a condition of an exemption of therapeutic goods under section 18A; or (i) who has been granted an approval or authority under subsection 19(1) or (5); or (ii) who has been granted an approval under section 19A; or (iiaaa) who is required to comply with a condition of an exemption of biologicals under section 32CB; or (iiaab) who has been granted an approval under subsection 32CK(1) or an authority under subsection 32CM(1); or (iiaac) who has been granted an approval under subsection 32CO(1), (1A) or (2); or  Chapter 6  Administration" ;
    skos:definition "(4) This section applies to: (a) premises of a person: (iaa) who is required to comply with a condition of an exemption of vaping goods under section 18 or 41HA; or (ia) who is required to comply with a condition of an exemption of therapeutic goods under section 18A; or (i) who has been granted an approval or authority under subsection 19(1) or (5); or (ii) who has been granted an approval under section 19A; or (iiaaa) who is required to comply with a condition of an exemption of biologicals under section 32CB; or (iiaab) who has been granted an approval under subsection 32CK(1) or an authority under subsection 32CM(1); or (iiaac) who has been granted an approval under subsection 32CO(1), (1A) or (2); or  Chapter 6  Administration"@en ;
    cml:integrityHash "fb428561fb7ebcb09220ec54b9d5b2c78e5079f375229ab36b243b43ebe762cd" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-46a ;
    cof:pageNumber "314"^^xsd:integer ;
    skos:note "Searches of certain premises to monitor compliance with Act" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <therapeutic-goods-act-1989.pdf> ;
    dc:source "therapeutic-goods-act-1989.pdf, p.314" ;
    cml:asserts concept:therapeutic-goods-act-1989-sec-46a-ss-4-norm .
