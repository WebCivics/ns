    cml:premiseText "(2B) The Minister may, by legislative instrument..." ;
    cml:conclusionText "The decision-making principles apply to decisions made within the interval of the Minister's power." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

