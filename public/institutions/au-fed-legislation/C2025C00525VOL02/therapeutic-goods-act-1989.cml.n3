doc:sec-41rd-ss-3 a cof:Section ;
    cof:title "41RD(3) Offences and civil penalty provision—breaching condition of" ;
    values:kind "subsection" ;
    values:originalText "(3) A person commits an offence of strict liability if: (a) the person does an act or omits to do an act; and (b) the act or omission breaches a condition of a consent imposed under subsection 41RC(2). Penalty: 100 penalty units. Civil penalty provision" ;
    cof:pageNumber "224"^^xsd:integer .

concept:therapeutic-goods-act-1989-sec-41rd-ss-4 a cml:Concept ;
    skos:prefLabel "41RD(4) Offences and civil penalty provision—breaching condition of"@en ;
    cml:realizedBy doc:sec-41rd-ss-4 ;
    values:originalText "(4) A person contravenes this subsection if:  Vaping goods  Chapter 4A Other provisions  Part 4A-3 Consent of Secretary  Division 2 Section 41RD Therapeutic Goods Act 1989 Compilation date: 05/09/2025 (a) the person does an act or omits to do an act; and (b) the act or omission breaches a condition of a consent imposed under subsection 41RC(2). Maximum civil penalty: (a) for an individual—3,000 penalty units; and (b) for a body corporate—30,000 penalty units.  Chapter 5  Advertising, counterfeit therapeutic goods and product tampering" ;
    skos:definition "(4) A person contravenes this subsection if:  Vaping goods  Chapter 4A Other provisions  Part 4A-3 Consent of Secretary  Division 2 Section 41RD Therapeutic Goods Act 1989 Compilation date: 05/09/2025 (a) the person does an act or omits to do an act; and (b) the act or omission breaches a condition of a consent imposed under subsection 41RC(2). Maximum civil penalty: (a) for an individual—3,000 penalty units; and (b) for a body corporate—30,000 penalty units.  Chapter 5  Advertising, counterfeit therapeutic goods and product tampering"@en ;
    cml:integrityHash "3d874aeddcc19e2953921de69126b5d2374509620507f2cd4fb1e32bdd7b83bd" ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41rd ;
    cof:pageNumber "224"^^xsd:integer ;
    skos:note "Breaching a condition of consent imposed under subsection 41RC(2) is prohibited." ;
    cml:curationStatus cml:Proposed ;
