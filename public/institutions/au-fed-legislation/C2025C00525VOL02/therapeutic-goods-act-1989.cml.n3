    skos:prefLabel "57(12) Delegation"@en ;
    cml:realizedBy doc:sec-57-ss-12 ;
    values:originalText "(12) In performing any functions or exercising any powers under a delegation under this section, the delegate must comply with any directions of the person who delegated the function or power." ;
