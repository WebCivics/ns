concept:therapeutic-goods-act-1989-sec-41et-ss-1a cml:asserts concept:therapeutic-goods-act-1989-sec-41et-ss-1a-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-41et-ss-1a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "includes" ;
    cml:logicSummary "The text implies a duty on authorities to refer to persons with outstanding orders." ;
    cml:premiseText "Section 19B of the Crimes Act 1914 empowers courts to take action without proceeding to record a conviction." ;
    cml:conclusionText "A reference to a person convicted of an offence includes a reference to a person in respect of whom an order has been made relating to the offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

