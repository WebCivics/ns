  provision: sec-41eo-ss-1;
  logic: Deontic;
  operator: takesEffect;
  summary: Suspension takes effect on specified day after notice is given.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) The suspension takes effect: (a) if the notice under section 41EM states that the suspension is necessary to prevent imminent risk of death, serious illness or serious injury—on the day on which the notice is given to the person; or (b) in any other case—on the day specified for the purpose in the notice, being a day not earlier than 20 working days after the notice is given to the person.;
  @action: (1) The suspension takes effect: (a) if the notice under section 41EM states that the suspension is necessary to prevent imminent risk of death, serious illness or serious injury—on the day on which the notice is given to the person; or (b) in any other case—on the day specified for the purpose in the notice, being a day not earlier than 20 working days after the notice is given to the person.;
}

