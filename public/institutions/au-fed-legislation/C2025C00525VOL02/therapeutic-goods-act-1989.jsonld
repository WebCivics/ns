        }
      ],
      "cml:integrityHash": "17095f6330023e3523619fa12132f202153702263ea4d17f0e377eda4fc235e1",
      "skos:note": "Chapter 2 of the Criminal Code applies to all offences against this Chapter."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bk",
      "@type": "cof:Section",
      "cof:title": "41BK Application of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Chapter 2 of the Criminal Code applies to all offences against this\nChapter.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nChapter 4  Medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bk-norm",
      "@type": "values:Obligation",
