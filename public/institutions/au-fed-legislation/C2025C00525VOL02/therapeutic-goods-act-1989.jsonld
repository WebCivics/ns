    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jc",
      "@type": "cml:Concept",
      "skos:prefLabel": "41JC Self-incrimination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.132",
      "values:originalText": "(1) A person is not excused from giving information or a document\nunder section 41JB on the ground that to do so would tend to\nincriminate the person or expose the person to a penalty.\n(2) However, in the case of an individual:\n(a) the information given; or\n(b) the giving of the document; or\n(c) any information, document or thing obtained as a direct or\nindirect consequence of giving the information or document;\nis not admissible in evidence in:\n(d) criminal proceedings against the individual, except\nproceedings under, or arising out of, subsection 41JB(4), (7)\nor (8); or\n(e) proceedings for a pecuniary penalty order against the\nindividual for a contravention of a civil penalty provision,\nexcept civil proceedings under, or arising out of,\nsection 41JBA.\n\nMedical devices  Chapter 4\nObtaining information  Part 4-8\nInformation relating to medical devices covered by exemptions  Division 2\nSection 41JCA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "(1) A person is not excused from giving information or a document\nunder section 41JB on the ground that to do so would tend to\nincriminate the person or expose the person to a penalty.\n(2) However, in the case of an individual:\n(a) the information given; or\n(b) the giving of the document; or\n(c) any information, document or thing obtained as a direct or\nindirect consequence of giving the information or document;\nis not admissible in evidence in:\n(d) criminal proceedings against the individual, except\nproceedings under, or arising out of, subsection 41JB(4), (7)\nor (8); or\n(e) proceedings for a pecuniary penalty order against the\nindividual for a contravention of a civil penalty provision,\nexcept civil proceedings under, or arising out of,\nsection 41JBA.\n\nMedical devices  Chapter 4\nObtaining information  Part 4-8\nInformation relating to medical devices covered by exemptions  Division 2\nSection 41JCA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41jc-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41jc-ss-2"
        }
      ],
      "cml:integrityHash": "f54ee3b06f74ae4d40a844db4f822476b0e95bd11c507f42610a10afa9da1b2f"
    },
