    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yc-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YC(1) Persons involved in contravening civil penalty provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yc-ss-1"
