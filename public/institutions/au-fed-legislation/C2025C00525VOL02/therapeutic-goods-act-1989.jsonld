    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ji",
      "@type": "cml:Concept",
      "skos:prefLabel": "41JI False or misleading documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ji"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.139",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person produces a document to the Secretary; and\n(b) the person knows that the document is false or misleading;\nand\n(c) the document is produced in compliance or purported\ncompliance with a notice given under section 41JCA, 41JD,\n41JE, 41JF or 41JFA.\nPenalty: Imprisonment for 12 months or 1,000 penalty units, or\nboth.\n\nChapter 4  Medical devices",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person produces a document to the Secretary; and\n(b) the person knows that the document is false or misleading;\nand\n(c) the document is produced in compliance or purported\ncompliance with a notice given under section 41JCA, 41JD,\n41JE, 41JF or 41JFA.\nPenalty: Imprisonment for 12 months or 1,000 penalty units, or\nboth.\n\nChapter 4  Medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ji-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ji-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "492bf253db67f4083fe753e28b19f49bdfb623b7419d72e09b8b5ac972c3ce04",
      "skos:note": "Producing false or misleading documents is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ji",
      "@type": "cof:Section",
      "cof:title": "41JI False or misleading documents",
      "values:kind": "section",
      "cof:pageNumber": 139,
      "values:originalText": "(1) A person commits an offence if:\n(a) the person produces a document to the Secretary; and\n(b) the person knows that the document is false or misleading;\nand\n(c) the document is produced in compliance or purported\ncompliance with a notice given under section 41JCA, 41JD,\n41JE, 41JF or 41JFA.\nPenalty: Imprisonment for 12 months or 1,000 penalty units, or\nboth.\n\nChapter 4  Medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ji-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
