      },
      "cml:operator": "onlyIf",
      "cml:logicSummary": "Authority is conditional on meeting specific requirements.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) and (b)",
      "cml:conclusionText": "(c)"
    },
    {
