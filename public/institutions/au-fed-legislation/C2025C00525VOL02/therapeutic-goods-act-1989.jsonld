    {
      "@id": "concept:therapeutic-goods-act-1989-sec-49-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "49(4) Monitoring warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-49-ss-4"
      },
      "cml:curationStatus": {
