    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ek",
      "@type": "cml:Concept",
      "skos:prefLabel": "41EK Conditions imposed when conformity assessment certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ek"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.56",
      "values:originalText": "are issued\nIf the Secretary issues a conformity assessment certificate in\nrespect of a manufacturer, the Secretary may, in writing, impose\nconditions on the certificate in respect of:\n(a) one or more kinds of medical devices covered by the\ncertificate; or\n(b) the manufacturer’s quality management system.",
      "skos:definition": "are issued\nIf the Secretary issues a conformity assessment certificate in\nrespect of a manufacturer, the Secretary may, in writing, impose\nconditions on the certificate in respect of:\n(a) one or more kinds of medical devices covered by the\ncertificate; or\n(b) the manufacturer’s quality management system.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ek-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ek-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eebd33e829a035b275eda36ccdeb2e59e2ebc7e277bbe4f7dd098c95d2684e50",
      "skos:note": "Conditions imposed on conformity assessment certificates"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ek",
      "@type": "cof:Section",
      "cof:title": "41EK Conditions imposed when conformity assessment certificates",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "are issued\nIf the Secretary issues a conformity assessment certificate in\nrespect of a manufacturer, the Secretary may, in writing, impose\nconditions on the certificate in respect of:\n(a) one or more kinds of medical devices covered by the\ncertificate; or\n(b) the manufacturer’s quality management system."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ek-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41ek"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ek-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "imposes",
      "cml:logicSummary": "States a duty",
      "cml:executionSurface": "modalities::logic::deontic",
