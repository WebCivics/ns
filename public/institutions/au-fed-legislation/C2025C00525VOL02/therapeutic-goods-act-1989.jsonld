        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-46-ss-3-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "c6ed3c03f94ad096da34632b0ba7395dea3ec2bef71aacd3224baac3ce70db3f",
      "skos:note": "Authorized person cannot exercise powers under subsection (1) if occupier requests identity card inspection."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-46-ss-3",
      "@type": "cof:Section",
      "cof:title": "46(3) Searches to monitor compliance with Act or regulations",
      "values:kind": "subsection",
      "cof:pageNumber": 314,
      "values:originalText": "(3) An authorised person is not entitled to exercise any powers under\nsubsection (1) in relation to premises if:\n(a) the occupier of the premises has required the authorised\nperson to produce his or her identity card for inspection by\nthe occupier; and\n(b) the authorised person fails to comply with the requirement."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46-ss-3-norm",
