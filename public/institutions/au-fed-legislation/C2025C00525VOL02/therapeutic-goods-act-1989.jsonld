      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the application of inconsistent standards.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
