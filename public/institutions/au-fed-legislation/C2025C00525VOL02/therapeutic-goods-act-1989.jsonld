    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fm",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FM Duration of inclusion in the Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fm"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.87",
      "values:originalText": "(1) The inclusion of a kind of medical device in the Register\ncommences on the day specified for the purpose in the certificate\nunder section 41FF or 41FJ.\n(2) The inclusion of a kind of medical device in the Register has effect\nat all times:\n(a) unless the kind of device is suspended from the Register\nunder Division 1 of Part 4-6; or\n(b) until entry of the kind of device is cancelled from the\nRegister under Division 2 of Part 4-6.\n\nChapter 4  Medical devices",
      "skos:definition": "(1) The inclusion of a kind of medical device in the Register\ncommences on the day specified for the purpose in the certificate\nunder section 41FF or 41FJ.\n(2) The inclusion of a kind of medical device in the Register has effect\nat all times:\n(a) unless the kind of device is suspended from the Register\nunder Division 1 of Part 4-6; or\n(b) until entry of the kind of device is cancelled from the\nRegister under Division 2 of Part 4-6.\n\nChapter 4  Medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fm-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fm-ss-2"
        }
      ],
      "cml:integrityHash": "7e1a24b2e548875fa9287ae4c5b7fd82ee9f69f68eb149e65a4b89161d46642d"
    },
