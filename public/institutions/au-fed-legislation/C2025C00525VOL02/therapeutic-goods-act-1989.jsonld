        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-7-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "5ea19562c2955142a5b4c15c86cfb32f83097eca13fc4c41962cf730c53f4910",
      "skos:note": "Directors, employees and agents of a body corporate are subject to this section."
    },
    {
