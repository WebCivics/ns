      "cml:logicSummary": "Requirement relation for obligations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(x) requires (y) if and only if x is an obligation that necessitates y.",
      "cml:conclusionText": "(3) A reference in subsection (1) to anything omitted to be done includes a reference to a failure to make a decision."
    },
    {
