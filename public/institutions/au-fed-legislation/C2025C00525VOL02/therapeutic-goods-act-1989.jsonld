      "@type": "cml:Concept",
      "skos:prefLabel": "41HC(3) Authorities for health practitioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41hc-ss-3"
      },
      "cml:curationStatus": {
