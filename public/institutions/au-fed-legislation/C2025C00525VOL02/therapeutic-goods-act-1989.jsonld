    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gs-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "41GS(5) Minister may make exemptions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gs-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.108",
      "values:originalText": "(5) An exemption under subsection (1) ceases to have effect in relation\nto a particular kind of medical device when that kind of medical\ndevice becomes included in the Register under Part 4-5.\n\nChapter 4  Medical devices",
      "skos:definition": "(5) An exemption under subsection (1) ceases to have effect in relation\nto a particular kind of medical device when that kind of medical\ndevice becomes included in the Register under Part 4-5.\n\nChapter 4  Medical devices",
