      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.201",
      "values:originalText": "An offence provision or civil penalty provision in this Chapter does\nnot limit the generality of an offence provision or civil penalty\nprovision in any other Chapter, and those provisions in other\nChapters do not limit the generality of offence provisions or civil\npenalty provisions in this Chapter.\n\nChapter 4A  Vaping goods",
      "skos:definition": "An offence provision or civil penalty provision in this Chapter does\nnot limit the generality of an offence provision or civil penalty\nprovision in any other Chapter, and those provisions in other\nChapters do not limit the generality of offence provisions or civil\npenalty provisions in this Chapter.\n\nChapter 4A  Vaping goods",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41na-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41na-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "12f314df9f33d98e71c5b2c23998be823a2826643e5eb2154661ce861216e250",
      "skos:note": "No limitation on generality of offence provisions or civil penalty provisions between Chapters."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41na",
      "@type": "cof:Section",
      "cof:title": "41NA Relationship with other Chapters of this Act",
      "values:kind": "section",
      "cof:pageNumber": 201,
      "values:originalText": "An offence provision or civil penalty provision in this Chapter does\nnot limit the generality of an offence provision or civil penalty\nprovision in any other Chapter, and those provisions in other\nChapters do not limit the generality of offence provisions or civil\npenalty provisions in this Chapter.\n\nChapter 4A  Vaping goods"
    },
    {
