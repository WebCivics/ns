    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41k",
      "@type": "cml:Concept",
      "skos:prefLabel": "41K What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.145",
      "values:originalText": "The Secretary can require action to recall medical devices, or to\ninform the public about medical devices, that do not comply with\nrequirements or cannot lawfully be supplied.",
      "skos:definition": "The Secretary can require action to recall medical devices, or to\ninform the public about medical devices, that do not comply with\nrequirements or cannot lawfully be supplied.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41k-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "afa864ca91e980ec4d85c8858dac087e6c1de7ccc1c4598f671d86c80d545a1c",
      "skos:note": "The Secretary can require action to recall medical devices, or to inform the public about medical devices that do not comply with requirements or cannot lawfully be supplied."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41k",
      "@type": "cof:Section",
      "cof:title": "41K What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 145,
      "values:originalText": "The Secretary can require action to recall medical devices, or to\ninform the public about medical devices, that do not comply with\nrequirements or cannot lawfully be supplied."
    },
