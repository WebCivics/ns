    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54c-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Executive officer has an obligation to take reasonable steps.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The executive officer is responsible for preventing the commission of the offence.",
      "cml:conclusionText": "The officer must take all reasonable steps to prevent the commission of the offence."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54c-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The officer's awareness of the body's commission of an offence is relevant to determining their obligations.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The officer became aware that the body was committing an offence against this Act or the regulations.",
      "cml:conclusionText": "The officer's awareness of the body's commission of an offence overlaps with their obligation to prevent the commission of the offence."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54c-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The officer has an obligation to take action when they become aware that the body is committing an offence.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "When the officer became aware that the body was committing an offence against this Act or the regulations, they had an obligation to take action.",
      "cml:conclusionText": "The officer must take action when they become aware that the body is committing an offence."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54c-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The officer has an obligation to ensure that employees, agents, and contractors have a reasonable knowledge and understanding of the requirements.",
      "cml:executionSurface": "modalities::logic::deontic",
