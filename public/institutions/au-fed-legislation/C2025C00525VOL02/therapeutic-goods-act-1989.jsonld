          "@id": "concept:therapeutic-goods-act-1989-sec-42dr-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "585509ff84961b491f51844c5f9d88e353b425505de68827dd9cf85377c9bef4",
      "skos:note": "Giving false information or documents in response to a notice under section 42DR is prohibited. Specify software requirements for information or documents"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dr-ss-4",
