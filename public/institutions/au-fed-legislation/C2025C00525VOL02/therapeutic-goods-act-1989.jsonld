    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41g",
      "@type": "cml:Concept",
      "skos:prefLabel": "41G What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.93",
      "values:originalText": "Inclusions in the Register may be suspended in certain\ncircumstances, such as when a conformity assessment document is\nsuspended. A kind of medical device that is suspended is taken not\nto be included in the Register for most purposes.\nInclusions in the Register may also be cancelled in certain\ncircumstances.",
      "skos:definition": "Inclusions in the Register may be suspended in certain\ncircumstances, such as when a conformity assessment document is\nsuspended. A kind of medical device that is suspended is taken not\nto be included in the Register for most purposes.\nInclusions in the Register may also be cancelled in certain\ncircumstances.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41g-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41g-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41g-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a68f537923f96e3c1cd0a9b5629a612d08e1630ded0f256b8bfc902f33fab6f9",
      "skos:note": "Inclusions in the Register may be suspended or cancelled under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41g",
      "@type": "cof:Section",
      "cof:title": "41G What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "Inclusions in the Register may be suspended in certain\ncircumstances, such as when a conformity assessment document is\nsuspended. A kind of medical device that is suspended is taken not\nto be included in the Register for most purposes.\nInclusions in the Register may also be cancelled in certain\ncircumstances."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41g-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
