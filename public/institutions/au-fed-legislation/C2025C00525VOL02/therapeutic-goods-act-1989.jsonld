    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YF Civil proceedings after criminal proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.285",
      "values:originalText": "The Federal Court must not make a pecuniary penalty order against\na person for a contravention of a civil penalty provision if the\nperson has been convicted of an offence constituted by conduct\nthat is substantially the same as the conduct constituting the\ncontravention.",
      "skos:definition": "The Federal Court must not make a pecuniary penalty order against\na person for a contravention of a civil penalty provision if the\nperson has been convicted of an offence constituted by conduct\nthat is substantially the same as the conduct constituting the\ncontravention.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yf-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-diffusion-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-cogai-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-n3logic-5"
        }
      ],
      "cml:integrityHash": "1f1163bb26ddf3f3893280cfe76484b828fbc699e9001100ec94501fa4dadb10",
      "skos:note": "Federal Court cannot impose pecuniary penalty order on a person convicted of an offence substantially similar to the contravention."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yf",
      "@type": "cof:Section",
      "cof:title": "42YF Civil proceedings after criminal proceedings",
      "values:kind": "section",
      "cof:pageNumber": 285,
      "values:originalText": "The Federal Court must not make a pecuniary penalty order against\na person for a contravention of a civil penalty provision if the\nperson has been convicted of an offence constituted by conduct\nthat is substantially the same as the conduct constituting the\ncontravention."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42yf"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Cannot",
      "cml:logicSummary": "Prohibition of pecuniary penalty order",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Federal Court must not make a pecuniary penalty order",
      "cml:conclusionText": "against a person convicted of an offence substantially similar to the contravention"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal overlap",
      "cml:logicSummary": "Temporal relationship between conviction and contravention",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has been convicted of an offence constituted by conduct substantially the same as the conduct constituting the contravention",
      "cml:conclusionText": "within a certain timeframe"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-diffusion-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation of prohibition",
      "cml:logicSummary": "Prohibition applies to all persons subject to the Federal Court's jurisdiction",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Federal Court must not make a pecuniary penalty order against a person for a contravention of a civil penalty provision",
      "cml:conclusionText": "regardless of their individual circumstances"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge representation",
      "cml:logicSummary": "Semantic representation of the prohibition",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Federal Court must not make a pecuniary penalty order against a person for a contravention of a civil penalty provision",
      "cml:conclusionText": "in terms of its application to all persons subject to the Federal Court's jurisdiction"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yf-logic-n3logic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:N3Logic"
      },
      "cml:operator": "Ontological commitment",
      "cml:logicSummary": "Commitment to the prohibition in the legal framework",
      "cml:executionSurface": "modalities::logic::n3_compiler",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Federal Court must not make a pecuniary penalty order against a person for a contravention of a civil penalty provision",
      "cml:conclusionText": "as part of its jurisdictional authority"
    },
