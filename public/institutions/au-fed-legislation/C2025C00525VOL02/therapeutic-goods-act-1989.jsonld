      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fa-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Kind of medical device is included in the Register if application passes preliminary assessment.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fc",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FC Making an application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.73",
      "values:originalText": "(1) A person may make an application to the Secretary for a kind of\nmedical device to be included in the Register.\n(2) An application must not contain information that is false or\nmisleading in a material particular.\nNote:\nA person might also commit an offence, or contravene a civil penalty\nprovision, if the person makes a statement in an application that is\nfalse or misleading in a material particular: see sections 41FE and\n41FEA.",
      "skos:definition": "(1) A person may make an application to the Secretary for a kind of\nmedical device to be included in the Register.\n(2) An application must not contain information that is false or\nmisleading in a material particular.\nNote:\nA person might also commit an offence, or contravene a civil penalty\nprovision, if the person makes a statement in an application that is\nfalse or misleading in a material particular: see sections 41FE and\n41FEA.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fc-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fc-ss-2"
        }
      ],
      "cml:integrityHash": "7cdc278815c35adc28978bced1cc75b1adb5c1609b33418aed7065b7b230f65c"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fc",
      "@type": "cof:Section",
      "cof:title": "41FC Making an application",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "(1) A person may make an application to the Secretary for a kind of\nmedical device to be included in the Register.\n(2) An application must not contain information that is false or\nmisleading in a material particular.\nNote:\nA person might also commit an offence, or contravene a civil penalty\nprovision, if the person makes a statement in an application that is\nfalse or misleading in a material particular: see sections 41FE and\n41FEA."
    },
    {
