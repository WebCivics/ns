    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bi-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "41BI(3) Meaning of non-application of conformity assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bi-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
