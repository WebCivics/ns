    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54ac",
      "@type": "cml:Concept",
      "skos:prefLabel": "54AC Civil penalty for damaging etc. documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54ac"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.353",
      "values:originalText": "A person contravenes this section if:\n(a) the person damages, destroys, alters, conceals or falsifies a\ndocument; and\n(b) the document is created, retained or issued for the purposes\nof this Act, or for purposes that include the purposes of this\nAct; and\n(c) the damage, destruction, alteration, concealment or\nfalsification is likely to interfere with the proper\nadministration of this Act or the regulations.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "A person contravenes this section if:\n(a) the person damages, destroys, alters, conceals or falsifies a\ndocument; and\n(b) the document is created, retained or issued for the purposes\nof this Act, or for purposes that include the purposes of this\nAct; and\n(c) the damage, destruction, alteration, concealment or\nfalsification is likely to interfere with the proper\nadministration of this Act or the regulations.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54ac-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54ac-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54ac-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54ac-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "bb10afc0ad7127b9095a9eefec4f94004850847515cca73cbe5fb076f9c352c4",
      "skos:note": "Damaging, destroying, altering, concealing or falsifying documents for purposes of the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54ac",
      "@type": "cof:Section",
      "cof:title": "54AC Civil penalty for damaging etc. documents",
      "values:kind": "section",
      "cof:pageNumber": 353,
      "values:originalText": "A person contravenes this section if:\n(a) the person damages, destroys, alters, conceals or falsifies a\ndocument; and\n(b) the document is created, retained or issued for the purposes\nof this Act, or for purposes that include the purposes of this\nAct; and\n(c) the damage, destruction, alteration, concealment or\nfalsification is likely to interfere with the proper\nadministration of this Act or the regulations.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
