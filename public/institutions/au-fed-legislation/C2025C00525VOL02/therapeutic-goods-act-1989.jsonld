        }
      ],
      "cml:integrityHash": "c862e06fc4f632cb6d930160b555a6456a373141c9b3b74c75e407f10a742923",
      "skos:note": "Exemption ceases to have effect when device is included in the Register."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gs-ss-5",
      "@type": "cof:Section",
      "cof:title": "41GS(5) Minister may make exemptions",
      "values:kind": "subsection",
      "cof:pageNumber": 108,
      "values:originalText": "(5) An exemption under subsection (1) ceases to have effect in relation\nto a particular kind of medical device when that kind of medical\ndevice becomes included in the Register under Part 4-5.\n\nChapter 4  Medical devices"
    },
