    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dn",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DN Application of Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.246",
      "values:originalText": "This Division applies to generic information about goods that:\n(a) may be used as an ingredient or component in the\nmanufacture of therapeutic goods; and\n(b) although not presented for supply as therapeutic goods, come\nwithin the meaning of therapeutic goods because they are\nrepresented to be:\n(i) for therapeutic use; or\n(ii) for use as an ingredient or component in the\nmanufacture of other therapeutic goods.",
      "skos:definition": "This Division applies to generic information about goods that:\n(a) may be used as an ingredient or component in the\nmanufacture of therapeutic goods; and\n(b) although not presented for supply as therapeutic goods, come\nwithin the meaning of therapeutic goods because they are\nrepresented to be:\n(i) for therapeutic use; or\n(ii) for use as an ingredient or component in the\nmanufacture of other therapeutic goods.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dn-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dn-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "80f849149a80a1a3d429d8961c644afb8d08fc2b8e95d0df447435d9194af0b2",
      "skos:note": "Division applies to generic information about goods used in therapeutic goods manufacture or representation."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dn",
      "@type": "cof:Section",
      "cof:title": "42DN Application of Division",
      "values:kind": "section",
      "cof:pageNumber": 246,
      "values:originalText": "This Division applies to generic information about goods that:\n(a) may be used as an ingredient or component in the\nmanufacture of therapeutic goods; and\n(b) although not presented for supply as therapeutic goods, come\nwithin the meaning of therapeutic goods because they are\nrepresented to be:\n(i) for therapeutic use; or\n(ii) for use as an ingredient or component in the\nmanufacture of other therapeutic goods."
    },
