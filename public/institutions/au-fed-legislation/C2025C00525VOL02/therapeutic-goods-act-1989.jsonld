        }
      ],
      "cml:integrityHash": "b1fd9329aea0e6374457a5520a72dd1a9e57b5a716d29cd2291fce89ba31d15d",
      "skos:note": "Must return seized thing if reason for seizure no longer exists or period ends"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48h-ss-1",
      "@type": "cof:Section",
