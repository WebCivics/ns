        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41en-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "70f309aba95269f94fdc43a1c85a950aa3ffb2d532fee12bd1219478f93d838d",
      "skos:note": "Secretary must inform person of proposed suspension and give reasonable opportunity to make submissions.",
      "dc:description": "Notice, reasons for suspension"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41en-ss-1",
      "@type": "cof:Section",
      "cof:title": "41EN(1) Notice of proposed suspension",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(1) However, before suspending a conformity assessment certificate,\nthe Secretary must:\n(a) inform the person in writing that the Secretary proposes the\nsuspension and set out the reasons for it; and\n(b) give the person a reasonable opportunity to make\nsubmissions to the Secretary in relation to the proposed\nsuspension."
    },
