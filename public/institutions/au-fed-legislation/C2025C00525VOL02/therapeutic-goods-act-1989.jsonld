    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dj",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DJ Prohibited and required representations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.233",
      "values:originalText": "(1) For the purposes of this Part, representations of a kind specified in\nregulations made for the purposes of this subsection are prohibited\nrepresentations about therapeutic goods of a kind specified in those\nregulations.\n(2) For the purposes of this Part, representations of a kind specified in\nregulations made for the purposes of this subsection are required\nrepresentations about the therapeutic goods of a kind specified in\nthose regulations.\n\nChapter 5  Advertising, counterfeit therapeutic goods and product tampering",
      "skos:definition": "(1) For the purposes of this Part, representations of a kind specified in\nregulations made for the purposes of this subsection are prohibited\nrepresentations about therapeutic goods of a kind specified in those\nregulations.\n(2) For the purposes of this Part, representations of a kind specified in\nregulations made for the purposes of this subsection are required\nrepresentations about the therapeutic goods of a kind specified in\nthose regulations.\n\nChapter 5  Advertising, counterfeit therapeutic goods and product tampering",
