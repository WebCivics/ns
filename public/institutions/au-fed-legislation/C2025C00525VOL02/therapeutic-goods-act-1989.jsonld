    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gq",
      "@type": "cml:Concept",
      "skos:prefLabel": "41GQ Date of effect of cancellation of entries from Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.107",
      "values:originalText": "If the Secretary cancels an entry of a kind of medical device, or\nsome devices of a particular kind, from the Register, the\ncancellation has effect:\n(a) if the cancellation is under section 41GK or 41GL—on the\nday on which the notice of cancellation is given to the person\nin relation to whom the kind of device was included in the\nRegister; or\n(b) in any other case—on such later day as is specified in the\nnotice, being a day not earlier than 20 working days after the\nnotice is given to the person.\n\nChapter 4  Medical devices",
      "skos:definition": "If the Secretary cancels an entry of a kind of medical device, or\nsome devices of a particular kind, from the Register, the\ncancellation has effect:\n(a) if the cancellation is under section 41GK or 41GL—on the\nday on which the notice of cancellation is given to the person\nin relation to whom the kind of device was included in the\nRegister; or\n(b) in any other case—on such later day as is specified in the\nnotice, being a day not earlier than 20 working days after the\nnotice is given to the person.\n\nChapter 4  Medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gq-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gq-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gq-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "3a64e9cca769ce053f9f99555c5b2e4a105c1de497a1c40cde6d7ca52703a571",
      "skos:note": "Cancellation of medical device entries has a specified effective date."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gq",
      "@type": "cof:Section",
      "cof:title": "41GQ Date of effect of cancellation of entries from Register",
      "values:kind": "section",
      "cof:pageNumber": 107,
      "values:originalText": "If the Secretary cancels an entry of a kind of medical device, or\nsome devices of a particular kind, from the Register, the\ncancellation has effect:\n(a) if the cancellation is under section 41GK or 41GL—on the\nday on which the notice of cancellation is given to the person\nin relation to whom the kind of device was included in the\nRegister; or\n(b) in any other case—on such later day as is specified in the\nnotice, being a day not earlier than 20 working days after the\nnotice is given to the person.\n\nChapter 4  Medical devices"
    },
    {
