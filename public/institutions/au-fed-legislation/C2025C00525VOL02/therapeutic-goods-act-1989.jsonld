        }
      ],
      "cml:integrityHash": "96646670dc10834f5fe688472ec79a1a3635e9a6955c6cbde41d8d033939442c",
      "skos:note": "Fee for exemption applications must not amount to taxation."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-44a-ss-2",
      "@type": "cof:Section",
      "cof:title": "44A(2) Exemptions from liability to pay charges",
      "values:kind": "subsection",
      "cof:pageNumber": 302,
      "values:originalText": "(2) The regulations may require applications for exemptions to be\naccompanied by a specified fee. A fee must not be such as to\namount to taxation.\nStatements prepared by approved persons"
