    {
      "@id": "concept:therapeutic-goods-act-1989-sec-61a-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusion relation for obligations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(x) includes (y) if and only if x is an obligation that requires y.",
      "cml:conclusionText": "(3) A reference in subsection (1) to anything omitted to be done includes a reference to a failure to make a decision."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-61a-ss-3-logic-descriptionlogic-2",
