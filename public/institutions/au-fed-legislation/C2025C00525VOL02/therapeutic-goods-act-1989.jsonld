      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41kb",
      "@type": "cml:Concept",
      "skos:prefLabel": "41KB Publication of requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41kb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.149",
      "values:originalText": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after imposing a\nrequirement under section 41KA, a notice setting out particulars of\nthe requirement.",
      "skos:definition": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after imposing a\nrequirement under section 41KA, a notice setting out particulars of\nthe requirement.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41kb-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41kb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6df2a63923ff9adf131b6e01cdb3862bd01dc69bc08d013a2627275389a29305",
      "skos:note": "Secretary must publish notice after imposing requirement.",
      "dc:description": "Notice setting out particulars of the requirement"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41kb",
      "@type": "cof:Section",
      "cof:title": "41KB Publication of requirements",
      "values:kind": "section",
      "cof:pageNumber": 149,
      "values:originalText": "The Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after imposing a\nrequirement under section 41KA, a notice setting out particulars of\nthe requirement."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41kb-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
