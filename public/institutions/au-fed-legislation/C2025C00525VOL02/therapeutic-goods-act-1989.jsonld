    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fn-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FN(2) Conditions applying automatically",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fn-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
