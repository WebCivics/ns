          "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ea84486e1dfe4a062cd7cd6e19f3659f8a05716264011671bc83e28b434bdedd",
      "skos:note": "Secretary may apply for order if undertaking is breached"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yl-ss-4",
      "@type": "cof:Section",
      "cof:title": "42YL(4) Enforcement of undertakings",
      "values:kind": "subsection",
      "cof:pageNumber": 295,
      "values:originalText": "(4) If the Secretary considers that the person who gave the undertaking\nhas breached any of its terms, the Secretary may apply to the\nFederal Court for an order under subsection (5)."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
