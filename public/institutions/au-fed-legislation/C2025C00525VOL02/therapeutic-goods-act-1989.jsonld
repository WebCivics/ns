        }
      ],
      "cml:integrityHash": "ae5718ef2fad1929dd66627f4740cb19826791ca95d6e9b1daffe9867f10d868",
      "skos:note": "Must provide a reasonable excuse to avoid liability.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jb-ss-3a",
      "@type": "cof:Section",
      "cof:title": "41JB(3A) Complying with the Secretary’s requirements",
      "values:kind": "subsection",
