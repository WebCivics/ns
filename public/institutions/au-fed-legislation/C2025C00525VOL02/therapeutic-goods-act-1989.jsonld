      "cml:integrityHash": "a3511e83e6f6f76b97a4f2b8c0b8ca71c4dd81659120e596b79eee2c003e2108",
      "skos:note": "Dissemination of generic information about therapeutic goods is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dp-ss-2",
      "@type": "cof:Section",
      "cof:title": "42DP(2) Offences—dissemination of generic information",
      "values:kind": "subsection",
      "cof:pageNumber": 246,
      "values:originalText": "(2) A person commits an offence if:\n(a) the person disseminates, by any means, generic information\nabout therapeutic goods to the public or a section of the\npublic; and\n(b) the dissemination of that generic information does not\ncomply with the provisions of the Therapeutic Goods\nAdvertising Code that are prescribed by regulations for the\npurposes of section 42DO.\nPenalty: 100 penalty units."
    },
    {
