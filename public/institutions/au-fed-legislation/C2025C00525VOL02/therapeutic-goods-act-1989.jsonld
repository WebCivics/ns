      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits harm or injury resulting from false advertising.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) either: (i) the use of the medical device for the advertised purpose has resulted in, will result in, or is likely to result in, harm or injury to any person;",
      "cml:conclusionText": "The use of the medical device for the advertised purpose must not result in harm or injury."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ml-ss-1-logic-linearlogic-4",
