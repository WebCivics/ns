    {
      "@id": "concept:therapeutic-goods-act-1989-sec-63-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "63(5) Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-63-ss-5"
      },
      "cml:curationStatus": {
