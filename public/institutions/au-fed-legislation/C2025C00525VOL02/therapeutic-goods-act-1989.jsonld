    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "46(3) Searches to monitor compliance with Act or regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-46-ss-3"
      },
