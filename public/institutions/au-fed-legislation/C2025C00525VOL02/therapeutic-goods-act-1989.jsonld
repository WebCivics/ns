      },
      "cml:operator": "Recognize",
      "cml:logicSummary": "Recognition of occupier's written consent",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the occupier of the premises\nconsents in writing."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "48AA(3) Completing execution of warrant under section 50 after",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48aa-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.321",
      "values:originalText": "(3) An authorised person, or a person assisting the authorised person,\nmay apply to an issuing officer for an extension of the 12-hour\nperiod mentioned in subparagraph (2)(b)(ii) if:\n(a) there is an emergency situation; and\n(b) the authorised person or person assisting the authorised\nperson believes on reasonable grounds that the authorised\nperson or person assisting the authorised person will not be\nable to return to the premises within that period.\n\nChapter 6  Administration",
      "skos:definition": "(3) An authorised person, or a person assisting the authorised person,\nmay apply to an issuing officer for an extension of the 12-hour\nperiod mentioned in subparagraph (2)(b)(ii) if:\n(a) there is an emergency situation; and\n(b) the authorised person or person assisting the authorised\nperson believes on reasonable grounds that the authorised\nperson or person assisting the authorised person will not be\nable to return to the premises within that period.\n\nChapter 6  Administration",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-48aa"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "d4bdadadd0d514cd7e36943f6e5f401086bf421b24ce941a52c2476caf62b287",
      "skos:note": "Authorized person may apply for extension of warrant execution period under emergency situation."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48aa-ss-3",
      "@type": "cof:Section",
      "cof:title": "48AA(3) Completing execution of warrant under section 50 after",
      "values:kind": "subsection",
      "cof:pageNumber": 321,
      "values:originalText": "(3) An authorised person, or a person assisting the authorised person,\nmay apply to an issuing officer for an extension of the 12-hour\nperiod mentioned in subparagraph (2)(b)(ii) if:\n(a) there is an emergency situation; and\n(b) the authorised person or person assisting the authorised\nperson believes on reasonable grounds that the authorised\nperson or person assisting the authorised person will not be\nable to return to the premises within that period.\n\nChapter 6  Administration"
    },
