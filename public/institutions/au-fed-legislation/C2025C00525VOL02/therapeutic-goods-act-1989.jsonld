    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yr",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YR Other powers of court unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yr"
      },
      "cml:curationStatus": {
