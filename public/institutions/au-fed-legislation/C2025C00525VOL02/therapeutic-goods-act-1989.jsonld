        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) If a court orders that the goods be forfeited in relation to any therapeutic goods or vaping goods",
      "cml:conclusionText": "The goods overlap with therapeutic or vaping products"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Goods must be forfeited repeatedly",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
