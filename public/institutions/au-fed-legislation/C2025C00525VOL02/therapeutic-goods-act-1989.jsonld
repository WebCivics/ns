      },
      "cml:premiseText": "(c) the person supplies a medical device of a kind specified in...",
      "cml:conclusionText": "...the supply is not in accordance with those rules;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mo-ss-4a-logic-argumentation-4",
