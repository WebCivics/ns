        }
      ],
      "cml:integrityHash": "61643e4f92fa28fe0d9ca9fc0b47d6e3f0c1693430c46e53e4517047cbd7a885",
      "skos:note": "Grant of injunctions for refusal or failure to comply with the Act."
    },
    {
