      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41hc-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
