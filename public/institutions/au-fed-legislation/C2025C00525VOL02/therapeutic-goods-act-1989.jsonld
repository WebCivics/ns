    {
      "@id": "concept:therapeutic-goods-act-1989-sec-63-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "63(3A) Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-63-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.386",
      "values:originalText": "(3A) The regulations may provide for:\n(a) the granting of a licence or permission to import or export\ntherapeutic goods; and\n(b) licences or permissions to import or export therapeutic goods\nto be subject to conditions or requirements; and\n(c) the assignment of a licence or permission to import or export\ntherapeutic goods; and\n(d) the surrender of a licence or permission to import or export\ntherapeutic goods; and\n(e) the revocation of a licence or permission to import or export\ntherapeutic goods.",
      "skos:definition": "(3A) The regulations may provide for:\n(a) the granting of a licence or permission to import or export\ntherapeutic goods; and\n(b) licences or permissions to import or export therapeutic goods\nto be subject to conditions or requirements; and\n(c) the assignment of a licence or permission to import or export\ntherapeutic goods; and\n(d) the surrender of a licence or permission to import or export\ntherapeutic goods; and\n(e) the revocation of a licence or permission to import or export\ntherapeutic goods.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-63"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-63-ss-3a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-63-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "10e652f390d6bc4398075e331f8cf992415a125de573c023f23903a87f64e35f",
      "skos:note": "Licence or permission to import/export therapeutic goods may be granted."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-63-ss-3a",
      "@type": "cof:Section",
      "cof:title": "63(3A) Regulations",
      "values:kind": "subsection",
      "cof:pageNumber": 386,
      "values:originalText": "(3A) The regulations may provide for:\n(a) the granting of a licence or permission to import or export\ntherapeutic goods; and\n(b) licences or permissions to import or export therapeutic goods\nto be subject to conditions or requirements; and\n(c) the assignment of a licence or permission to import or export\ntherapeutic goods; and\n(d) the surrender of a licence or permission to import or export\ntherapeutic goods; and\n(e) the revocation of a licence or permission to import or export\ntherapeutic goods."
    },
