    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yi",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YI Evidence given in proceedings for civil penalty not admissible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.285",
      "values:originalText": "in criminal proceedings\nEvidence of information given or evidence of production of\ndocuments by an individual is not admissible in criminal\nproceedings against the individual if:\n\nChapter 5A  Enforcement",
      "skos:definition": "in criminal proceedings\nEvidence of information given or evidence of production of\ndocuments by an individual is not admissible in criminal\nproceedings against the individual if:\n\nChapter 5A  Enforcement",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yi-norm"
        }
      ],
      "cml:integrityHash": "a73ec733acf5bacc42d56d003d9c918a685e31202526fe20eeaa4e96ac0e1ca2",
      "skos:note": "Evidence of information given or production of documents by an individual is not admissible in criminal proceedings against the individual."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yi",
      "@type": "cof:Section",
      "cof:title": "42YI Evidence given in proceedings for civil penalty not admissible",
      "values:kind": "section",
      "cof:pageNumber": 285,
      "values:originalText": "in criminal proceedings\nEvidence of information given or evidence of production of\ndocuments by an individual is not admissible in criminal\nproceedings against the individual if:\n\nChapter 5A  Enforcement"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yi-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42yi"
      },
