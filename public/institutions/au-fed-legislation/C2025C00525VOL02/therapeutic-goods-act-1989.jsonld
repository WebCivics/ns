    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41eg",
      "@type": "cml:Concept",
      "skos:prefLabel": "41EG Lapsing of applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41eg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.50",
      "values:originalText": "An application for a conformity assessment certificate lapses if:\n(a) the applicant does not deliver to the office to which the\napplication was made such information (in a form approved\nin writing by the Secretary) as will allow the certificate to be\nissued; or\n(b) the applicant does not comply with a requirement by the\nSecretary under subsection 41EC(6) to deliver to the office to\n\nMedical devices  Chapter 4\nConformity assessment certificates  Part 4-4\nIssuing conformity assessment certificates  Division 1\nSection 41EH\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nwhich the application was made a reasonable number of\nsamples of the kind of medical device to which the\napplication relates; or\n(c) the applicant fails to comply with a notice under\nsection 41JA to give to the Secretary information within a\nfurther 10 working days from the day specified in the notice;\nor\n(d) information given to the Secretary by, or on behalf of, the\napplicant in connection with the application, including\ninformation given for the purpose of a notice under\nsection 41JA, is false or misleading in a material particular;\nor\n(e) the applicant fails to allow an authorised person to carry out\nany inspection as required under subsection 41EB(4); or\n(f) for the whole or a part of the conformity assessment fee for\nthe application that is due and payable in accordance with\nregulations made for the purposes of Part 4-10—the applicant\nfails to pay that whole or part in accordance with those\nregulations.",
      "skos:definition": "An application for a conformity assessment certificate lapses if:\n(a) the applicant does not deliver to the office to which the\napplication was made such information (in a form approved\nin writing by the Secretary) as will allow the certificate to be\nissued; or\n(b) the applicant does not comply with a requirement by the\nSecretary under subsection 41EC(6) to deliver to the office to\n\nMedical devices  Chapter 4\nConformity assessment certificates  Part 4-4\nIssuing conformity assessment certificates  Division 1\nSection 41EH\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nwhich the application was made a reasonable number of\nsamples of the kind of medical device to which the\napplication relates; or\n(c) the applicant fails to comply with a notice under\nsection 41JA to give to the Secretary information within a\nfurther 10 working days from the day specified in the notice;\nor\n(d) information given to the Secretary by, or on behalf of, the\napplicant in connection with the application, including\ninformation given for the purpose of a notice under\nsection 41JA, is false or misleading in a material particular;\nor\n(e) the applicant fails to allow an authorised person to carry out\nany inspection as required under subsection 41EB(4); or\n(f) for the whole or a part of the conformity assessment fee for\nthe application that is due and payable in accordance with\nregulations made for the purposes of Part 4-10—the applicant\nfails to pay that whole or part in accordance with those\nregulations.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41eg-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41eg-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41eg-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "4d0afb11c901b7cfd66016ece4ab190936c8ea886a6d5377f57392a1373057f3",
      "skos:note": "Failure to comply with certain requirements results in lapse of application."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41eg",
      "@type": "cof:Section",
      "cof:title": "41EG Lapsing of applications",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "An application for a conformity assessment certificate lapses if:\n(a) the applicant does not deliver to the office to which the\napplication was made such information (in a form approved\nin writing by the Secretary) as will allow the certificate to be\nissued; or\n(b) the applicant does not comply with a requirement by the\nSecretary under subsection 41EC(6) to deliver to the office to\n\nMedical devices  Chapter 4\nConformity assessment certificates  Part 4-4\nIssuing conformity assessment certificates  Division 1\nSection 41EH\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nwhich the application was made a reasonable number of\nsamples of the kind of medical device to which the\napplication relates; or\n(c) the applicant fails to comply with a notice under\nsection 41JA to give to the Secretary information within a\nfurther 10 working days from the day specified in the notice;\nor\n(d) information given to the Secretary by, or on behalf of, the\napplicant in connection with the application, including\ninformation given for the purpose of a notice under\nsection 41JA, is false or misleading in a material particular;\nor\n(e) the applicant fails to allow an authorised person to carry out\nany inspection as required under subsection 41EB(4); or\n(f) for the whole or a part of the conformity assessment fee for\nthe application that is due and payable in accordance with\nregulations made for the purposes of Part 4-10—the applicant\nfails to pay that whole or part in accordance with those\nregulations."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41eg-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41eg"
      },
      "values:deonticStatus": {
