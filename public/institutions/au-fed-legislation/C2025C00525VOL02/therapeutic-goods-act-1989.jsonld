    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ys",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YS Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42ys"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.299",
      "values:originalText": "If the Secretary believes, on reasonable grounds, that:\n(a)\na person is not complying with this Act or an instrument\nmade under this Act in relation to particular goods; and\n(b)\nit is in the interests of public health or safety to give the\nperson directions under this Part;\nthe Secretary may, by written notice, give directions to the person\nrequiring the person to do specified things in relation to the goods\nwithin the period specified in the notice and at the person’s own\ncost.\nThe person may commit an offence or be liable to a civil penalty if\nthe person fails to comply with the notice.",
      "skos:definition": "If the Secretary believes, on reasonable grounds, that:\n(a)\na person is not complying with this Act or an instrument\nmade under this Act in relation to particular goods; and\n(b)\nit is in the interests of public health or safety to give the\nperson directions under this Part;\nthe Secretary may, by written notice, give directions to the person\nrequiring the person to do specified things in relation to the goods\nwithin the period specified in the notice and at the person’s own\ncost.\nThe person may commit an offence or be liable to a civil penalty if\nthe person fails to comply with the notice.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42ys-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42ys-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa146065c90516b0b16c6d4daee20e892ccbcc10bac51a372741edf2ce1704fb",
      "skos:note": "Secretary may give directions requiring person to take specified actions."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42ys",
      "@type": "cof:Section",
      "cof:title": "42YS Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 299,
      "values:originalText": "If the Secretary believes, on reasonable grounds, that:\n(a)\na person is not complying with this Act or an instrument\nmade under this Act in relation to particular goods; and\n(b)\nit is in the interests of public health or safety to give the\nperson directions under this Part;\nthe Secretary may, by written notice, give directions to the person\nrequiring the person to do specified things in relation to the goods\nwithin the period specified in the notice and at the person’s own\ncost.\nThe person may commit an offence or be liable to a civil penalty if\nthe person fails to comply with the notice."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ys-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
