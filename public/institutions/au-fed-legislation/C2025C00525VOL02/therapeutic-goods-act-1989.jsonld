    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yp",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YP Discharging or varying injunctions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yp"
      },
      "cml:curationStatus": {
