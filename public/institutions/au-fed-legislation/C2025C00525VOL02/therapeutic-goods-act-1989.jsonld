    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41b",
      "@type": "cml:Concept",
      "skos:prefLabel": "41B General",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.21",
      "values:originalText": "The purpose of this Chapter is to ensure the safety and satisfactory\nperformance of medical devices. It does this by:\n(a) setting out particular requirements for medical devices; and\n(b) establishing administrative processes principally aimed at\nensuring those requirements are met; and\n(c) providing for enforcement through a series of offences and\ncivil penalty provisions.",
      "skos:definition": "The purpose of this Chapter is to ensure the safety and satisfactory\nperformance of medical devices. It does this by:\n(a) setting out particular requirements for medical devices; and\n(b) establishing administrative processes principally aimed at\nensuring those requirements are met; and\n(c) providing for enforcement through a series of offences and\ncivil penalty provisions.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41b-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6fb1546d5b2f221fc45e075216e418648b0a562af2889e9e691805ba419f3d6c",
      "skos:note": "Ensures safety and satisfactory performance of medical devices"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41b",
      "@type": "cof:Section",
      "cof:title": "41B General",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The purpose of this Chapter is to ensure the safety and satisfactory\nperformance of medical devices. It does this by:\n(a) setting out particular requirements for medical devices; and\n(b) establishing administrative processes principally aimed at\nensuring those requirements are met; and\n(c) providing for enforcement through a series of offences and\ncivil penalty provisions."
    },
    {
