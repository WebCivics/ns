      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ys-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Obligation to comply with directions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Secretary gives notice.",
      "cml:conclusionText": "Person must comply."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yt",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YT Secretary may give directions if this Act or an instrument is",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yt"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.299",
      "values:originalText": "not being complied with\n(1) This section applies if the Secretary believes, on reasonable\ngrounds, that:\n(a) a person is not complying with this Act or an instrument\nmade under this Act in relation to particular goods; and\n(b) it is in the interests of public health or safety to give the\nperson directions under this section.\n(2) The Secretary may, by written notice, give directions to the person\nrequiring the person to do any of the following, within the period\nspecified in the notice and at the person’s own cost:\n(a) relabel, or label, the goods;\n(b) repackage the goods;\n(c) destroy or otherwise dispose of the goods;\n\nChapter 5A  Enforcement",
      "skos:definition": "not being complied with\n(1) This section applies if the Secretary believes, on reasonable\ngrounds, that:\n(a) a person is not complying with this Act or an instrument\nmade under this Act in relation to particular goods; and\n(b) it is in the interests of public health or safety to give the\nperson directions under this section.\n(2) The Secretary may, by written notice, give directions to the person\nrequiring the person to do any of the following, within the period\nspecified in the notice and at the person’s own cost:\n(a) relabel, or label, the goods;\n(b) repackage the goods;\n(c) destroy or otherwise dispose of the goods;\n\nChapter 5A  Enforcement",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yt-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yt-ss-2"
        }
      ],
      "cml:integrityHash": "431453420261e6be76470816198413991bfc3f0510f141c6f917be6292954ca3"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yt",
      "@type": "cof:Section",
      "cof:title": "42YT Secretary may give directions if this Act or an instrument is",
      "values:kind": "section",
      "cof:pageNumber": 299,
      "values:originalText": "not being complied with\n(1) This section applies if the Secretary believes, on reasonable\ngrounds, that:\n(a) a person is not complying with this Act or an instrument\nmade under this Act in relation to particular goods; and\n(b) it is in the interests of public health or safety to give the\nperson directions under this section.\n(2) The Secretary may, by written notice, give directions to the person\nrequiring the person to do any of the following, within the period\nspecified in the notice and at the person’s own cost:\n(a) relabel, or label, the goods;\n(b) repackage the goods;\n(c) destroy or otherwise dispose of the goods;\n\nChapter 5A  Enforcement"
    },
