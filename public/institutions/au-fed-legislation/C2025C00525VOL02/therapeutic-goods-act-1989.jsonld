    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42v-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If therapeutic goods have been administered, they cannot be recalled.",
