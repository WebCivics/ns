    {
      "@id": "concept:therapeutic-goods-act-1989-sec-46a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "46A(4) Searches of certain premises to monitor compliance with Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-46a-ss-4"
