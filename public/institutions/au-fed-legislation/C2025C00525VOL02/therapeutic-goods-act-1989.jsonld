      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ym",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YM Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42ym"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.296",
      "values:originalText": "The Secretary can seek injunctions from the Federal Court or\nFederal Circuit and Family Court of Australia (Division 2) to\nrestrain a person from contravening this Act or the regulations, or\nto compel compliance with this Act or the regulations.\nInterim injunctions are also available.",
      "skos:definition": "The Secretary can seek injunctions from the Federal Court or\nFederal Circuit and Family Court of Australia (Division 2) to\nrestrain a person from contravening this Act or the regulations, or\nto compel compliance with this Act or the regulations.\nInterim injunctions are also available.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42ym-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42ym-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "677142dce40942b1d3619e607b3e7b778bba3426c1b3e578a6db652877ed9f3f",
      "skos:note": "Secretary can seek injunctions from Federal Court or Family Court to restrain contravention of Act or regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42ym",
      "@type": "cof:Section",
      "cof:title": "42YM Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 296,
      "values:originalText": "The Secretary can seek injunctions from the Federal Court or\nFederal Circuit and Family Court of Australia (Division 2) to\nrestrain a person from contravening this Act or the regulations, or\nto compel compliance with this Act or the regulations.\nInterim injunctions are also available."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ym-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42ym"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ym-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Possibility of obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yn",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YN Grant of injunctions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.296",
      "values:originalText": "Restraining injunctions\n(1) If a person has engaged, is engaging or is proposing to engage, in\nconduct in contravention of this Act or the regulations, the Federal\nCourt or Federal Circuit and Family Court of Australia (Division 2)\nmay, on application by the Secretary, grant an injunction:\n(a) restraining the person from engaging in the conduct; and\n(b) if, in the court’s opinion, it is desirable to do so—requiring\nthe person to do a thing.\nPerformance injunctions\n(2) If:\n(a) a person has refused or failed, or is refusing or failing, or is\nproposing to refuse or fail, to do a thing; and\n(b) the refusal or failure was, is or would be a contravention of\nthis Act or the regulations;\nthe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may, on application by the Secretary, grant an\ninjunction requiring the person to do that thing.\n\nEnforcement  Chapter 5A\nInjunctions  Part 5A-4\n\nSection 42YO\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "Restraining injunctions\n(1) If a person has engaged, is engaging or is proposing to engage, in\nconduct in contravention of this Act or the regulations, the Federal\nCourt or Federal Circuit and Family Court of Australia (Division 2)\nmay, on application by the Secretary, grant an injunction:\n(a) restraining the person from engaging in the conduct; and\n(b) if, in the court’s opinion, it is desirable to do so—requiring\nthe person to do a thing.\nPerformance injunctions\n(2) If:\n(a) a person has refused or failed, or is refusing or failing, or is\nproposing to refuse or fail, to do a thing; and\n(b) the refusal or failure was, is or would be a contravention of\nthis Act or the regulations;\nthe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may, on application by the Secretary, grant an\ninjunction requiring the person to do that thing.\n\nEnforcement  Chapter 5A\nInjunctions  Part 5A-4\n\nSection 42YO\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yn-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yn-ss-2"
        }
      ],
      "cml:integrityHash": "2d2c65f99dde74f1ab7c119c57cb3de705b9b8ab95606cbf75f223056d2ecaa7"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yn",
      "@type": "cof:Section",
      "cof:title": "42YN Grant of injunctions",
      "values:kind": "section",
      "cof:pageNumber": 296,
      "values:originalText": "Restraining injunctions\n(1) If a person has engaged, is engaging or is proposing to engage, in\nconduct in contravention of this Act or the regulations, the Federal\nCourt or Federal Circuit and Family Court of Australia (Division 2)\nmay, on application by the Secretary, grant an injunction:\n(a) restraining the person from engaging in the conduct; and\n(b) if, in the court’s opinion, it is desirable to do so—requiring\nthe person to do a thing.\nPerformance injunctions\n(2) If:\n(a) a person has refused or failed, or is refusing or failing, or is\nproposing to refuse or fail, to do a thing; and\n(b) the refusal or failure was, is or would be a contravention of\nthis Act or the regulations;\nthe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may, on application by the Secretary, grant an\ninjunction requiring the person to do that thing.\n\nEnforcement  Chapter 5A\nInjunctions  Part 5A-4\n\nSection 42YO\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
