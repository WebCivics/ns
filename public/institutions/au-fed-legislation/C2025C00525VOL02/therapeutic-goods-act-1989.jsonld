      },
      "cml:operator": "Temporal overlap",
      "cml:logicSummary": "Requires temporal overlap between advertising and medical device registration.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
