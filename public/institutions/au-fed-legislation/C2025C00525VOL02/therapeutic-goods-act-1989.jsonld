    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ff-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FF(1A) Obligation to include kinds of medical devices in the Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ff-ss-1a"
