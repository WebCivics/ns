    {
      "@id": "concept:therapeutic-goods-act-1989-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Judicial notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.360",
      "values:originalText": "All courts (except in proceedings under Chapter 4) are to take\njudicial notice of the British Pharmacopoeia, the European\nPharmacopoeia, the United States Pharmacopeia-National\nFormulary, a homoeopathic pharmacopoeia and an anthroposophic\npharmacopoeia.",
      "skos:definition": "All courts (except in proceedings under Chapter 4) are to take\njudicial notice of the British Pharmacopoeia, the European\nPharmacopoeia, the United States Pharmacopeia-National\nFormulary, a homoeopathic pharmacopoeia and an anthroposophic\npharmacopoeia.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-56-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c4800eab611dc70219fe20473c0fa652d4850a2b3d70bb15eac29d26a6cfa013",
      "skos:note": "Courts must take judicial notice of certain pharmacopeias."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Judicial notice",
      "values:kind": "section",
      "cof:pageNumber": 360,
      "values:originalText": "All courts (except in proceedings under Chapter 4) are to take\njudicial notice of the British Pharmacopoeia, the European\nPharmacopoeia, the United States Pharmacopeia-National\nFormulary, a homoeopathic pharmacopoeia and an anthroposophic\npharmacopoeia."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-56-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-56"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-56-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Court obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Courts are required to take judicial notice.",
      "cml:conclusionText": "Courts must take judicial notice."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-56a",
      "@type": "cml:Concept",
      "skos:prefLabel": "56A Certificates to provide evidence of certain matters",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-56a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.360",
      "values:originalText": "(1) The Secretary or a person authorised in writing by him or her to\ngive certificates under this section may certify in writing that, at a\nspecified time, or at all times during a specified period:\n(a) there was no exemption in effect under section 18 or 18A in\nrelation to particular therapeutic goods; or\n(aaaa) a person was not exempt under subsection 32CA(1) in\nrelation to a particular biological or there was no exemption\nunder subsection 32CA(2) in relation to a particular\nbiological; or\n(aaab) there was no exemption in effect under section 32CB in\nrelation to a particular biological; or\n(aaa) there was no exemption in force under section 41GS in\nrelation to a particular kind of medical device; or\n(aa) particular medical devices were not exempt devices;\n(b) there was no approval under subsection 19(1) or authority\nunder subsection 19(5) granted to a particular person in\nrelation to particular therapeutic goods; or\n\nMiscellaneous  Chapter 7\n\nSection 56A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(baa) there was no approval under subsection 32CK(1) or authority\nunder subsection 32CM(1) granted to a particular person in\nrelation to a particular biological; or\n(ba) there was no approval or authority in effect under\nsection 41HB or subsection 41HC(1) granted to a particular\nperson in relation to particular medical devices;\n(bb) there was no approval under subsection 41HD(1), (1A) or (2)\ngranted to a particular person in relation to particular medical\ndevices; or\n(c) there was no approval under section 19A granted to a\nparticular person in relation to particular therapeutic goods;\nor\n(ca) there was no approval under subsection 32CO(1), (1A) or (2)\ngranted to a particular person in relation to a particular\nbiological; or\n(d) particular therapeutic goods were or were not included in the\nRegister as registered goods; or\n(da) particular therapeutic goods were or were not included in the\nRegister as provisionally registered goods; or\n(e) particular therapeutic goods were or were not included in the\nRegister as listed goods; or\n(eaa) a particular biological was or was not included in the\nRegister; or\n(ea) particular medical devices were or were not medical devices\nof a kind included in the Register; or\n(eb) particular medical devices were suspended from the Register;\nor\n(f) particular therapeutic goods were included in the Register\nsubject to conditions including those specified in the\ncertificate; or\n(g) the registration, listing or inclusion in the Register of the\nparticular therapeutic goods had been suspended or\ncancelled; or\n(h) there was no declaration under section 7 which applied to\nparticular therapeutic goods; or\n\nChapter 7  Miscellaneous\n\nSection 56A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(ha) there was no determination under section 7AA which applied\nto particular goods; or\n(i) a person was or was not the holder of a licence in force under",
      "skos:definition": "(1) The Secretary or a person authorised in writing by him or her to\ngive certificates under this section may certify in writing that, at a\nspecified time, or at all times during a specified period:\n(a) there was no exemption in effect under section 18 or 18A in\nrelation to particular therapeutic goods; or\n(aaaa) a person was not exempt under subsection 32CA(1) in\nrelation to a particular biological or there was no exemption\nunder subsection 32CA(2) in relation to a particular\nbiological; or\n(aaab) there was no exemption in effect under section 32CB in\nrelation to a particular biological; or\n(aaa) there was no exemption in force under section 41GS in\nrelation to a particular kind of medical device; or\n(aa) particular medical devices were not exempt devices;\n(b) there was no approval under subsection 19(1) or authority\nunder subsection 19(5) granted to a particular person in\nrelation to particular therapeutic goods; or\n\nMiscellaneous  Chapter 7\n\nSection 56A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(baa) there was no approval under subsection 32CK(1) or authority\nunder subsection 32CM(1) granted to a particular person in\nrelation to a particular biological; or\n(ba) there was no approval or authority in effect under\nsection 41HB or subsection 41HC(1) granted to a particular\nperson in relation to particular medical devices;\n(bb) there was no approval under subsection 41HD(1), (1A) or (2)\ngranted to a particular person in relation to particular medical\ndevices; or\n(c) there was no approval under section 19A granted to a\nparticular person in relation to particular therapeutic goods;\nor\n(ca) there was no approval under subsection 32CO(1), (1A) or (2)\ngranted to a particular person in relation to a particular\nbiological; or\n(d) particular therapeutic goods were or were not included in the\nRegister as registered goods; or\n(da) particular therapeutic goods were or were not included in the\nRegister as provisionally registered goods; or\n(e) particular therapeutic",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-56a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-56a-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-56a-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "de793b2b3a4b2ad5c7790fb02c97319f4311bef0579c71c7ad1f3eb59e2ed91e",
      "skos:note": "The Secretary or authorized person must certify certain matters in writing.",
      "dc:description": "Certificates to provide evidence of certain matters"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-56a",
      "@type": "cof:Section",
      "cof:title": "56A Certificates to provide evidence of certain matters",
      "values:kind": "section",
      "cof:pageNumber": 360,
      "values:originalText": "(1) The Secretary or a person authorised in writing by him or her to\ngive certificates under this section may certify in writing that, at a\nspecified time, or at all times during a specified period:\n(a) there was no exemption in effect under section 18 or 18A in\nrelation to particular therapeutic goods; or\n(aaaa) a person was not exempt under subsection 32CA(1) in\nrelation to a particular biological or there was no exemption\nunder subsection 32CA(2) in relation to a particular\nbiological; or\n(aaab) there was no exemption in effect under section 32CB in\nrelation to a particular biological; or\n(aaa) there was no exemption in force under section 41GS in\nrelation to a particular kind of medical device; or\n(aa) particular medical devices were not exempt devices;\n(b) there was no approval under subsection 19(1) or authority\nunder subsection 19(5) granted to a particular person in\nrelation to particular therapeutic goods; or\n\nMiscellaneous  Chapter 7\n\nSection 56A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(baa) there was no approval under subsection 32CK(1) or authority\nunder subsection 32CM(1) granted to a particular person in\nrelation to a particular biological; or\n(ba) there was no approval or authority in effect under\nsection 41HB or subsection 41HC(1) granted to a particular\nperson in relation to particular medical devices;\n(bb) there was no approval under subsection 41HD(1), (1A) or (2)\ngranted to a particular person in relation to particular medical\ndevices; or\n(c) there was no approval under section 19A granted to a\nparticular person in relation to particular therapeutic goods;\nor\n(ca) there was no approval under subsection 32CO(1), (1A) or (2)\ngranted to a particular person in relation to a particular\nbiological; or\n(d) particular therapeutic goods were or were not included in the\nRegister as registered goods; or\n(da) particular therapeutic goods were or were not included in the\nRegister as provisionally registered goods; or\n(e) particular therapeutic goods were or were not included in the\nRegister as listed goods; or\n(eaa) a particular biological was or was not included in the\nRegister; or\n(ea) particular medical devices were or were not medical devices\nof a kind included in the Register; or\n(eb) particular medical devices were suspended from the Register;\nor\n(f) particular therapeutic goods were included in the Register\nsubject to conditions including those specified in the\ncertificate; or\n(g) the registration, listing or inclusion in the Register of the\nparticular therapeutic goods had been suspended or\ncancelled; or\n(h) there was no declaration under section 7 which applied to\nparticular therapeutic goods; or\n\nChapter 7  Miscellaneous\n\nSection 56A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\n(ha) there was no determination under section 7AA which applied\nto particular goods; or\n(i) a person was or was not the holder of a licence in force under"
    },
