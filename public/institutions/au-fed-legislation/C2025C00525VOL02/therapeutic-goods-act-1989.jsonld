      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "ifThen",
      "cml:logicSummary": "Suspension takes effect if notice states suspension is necessary.",
      "cml:executionSurface": "modalities::logic::deontic",
