      "cml:integrityHash": "384eb7dc9e03419850e904e1685ca6c8b7d529bca68834327f242ddabd3dc9c7",
      "skos:note": "No unauthorized entry into residential premises without consent or commercial use."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-46a-ss-2",
      "@type": "cof:Section",
      "cof:title": "46A(2) Searches of certain premises to monitor compliance with Act",
      "values:kind": "subsection",
      "cof:pageNumber": 314,
      "values:originalText": "(2) An authorised person must not, under subsection (1), enter\npremises that are a residence unless:\n(a) the occupier of the premises has consented to the entry; or\n(b) the premises are used for commercial purposes in relation to\ntherapeutic goods or vaping goods, in addition to residential\npurposes."
    },
