      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the device is of a kind included in the Register;",
      "cml:conclusionText": "The device must be classified as being for a purpose accepted in relation to its inclusion in the Register."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ml-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
