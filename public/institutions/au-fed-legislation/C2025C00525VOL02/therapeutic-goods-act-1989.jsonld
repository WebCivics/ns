    {
      "@id": "concept:therapeutic-goods-act-1989-sec-52b",
      "@type": "cml:Concept",
      "skos:prefLabel": "52B Advisory Committee on Medicines Scheduling",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-52b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.341",
      "values:originalText": "(1) The Advisory Committee on Medicines Scheduling is established\nby this section.\n(2) Subject to subsection (3), the Committee is to be constituted, and\nto hold meetings, in accordance with the regulations.\n(3) The Commonwealth, each State, the Australian Capital Territory\nand the Northern Territory are each entitled to nominate a member\nof the Committee in accordance with the regulations.\n(4) The functions of the Committee are as follows:\n(a) subject to subsection (5), to make recommendations to the\nSecretary in relation to the classification and scheduling of\nsubstances that are, or are included in, therapeutic goods;\n(b) to make recommendations to the Secretary in relation to\nother changes to the current Poisons Standard (other than the\nschedules);\n(c) to reconsider a recommendation made under paragraph (a) or\n(b) at the request of the Secretary;\n(d) subject to subsection (5), to provide advice to the Secretary\nin relation to the restrictions (including restrictions as to\naccessibility and availability) to be imposed in respect of\nparticular substances that are, or are included in, therapeutic\ngoods;\n\nChapter 6  Administration",
      "skos:definition": "(1) The Advisory Committee on Medicines Scheduling is established\nby this section.\n(2) Subject to subsection (3), the Committee is to be constituted, and\nto hold meetings, in accordance with the regulations.\n(3) The Commonwealth, each State, the Australian Capital Territory\nand the Northern Territory are each entitled to nominate a member\nof the Committee in accordance with the regulations.\n(4) The functions of the Committee are as follows:\n(a) subject to subsection (5), to make recommendations to the\nSecretary in relation to the classification and scheduling of\nsubstances that are, or are included in, therapeutic goods;\n(b) to make recommendations to the Secretary in relation to\nother changes to the current Poisons Standard (other than the\nschedules);\n(c) to reconsider a recommendation made under paragraph (a) or\n(b) at the request of the Secretary;\n(d) subject to subsection (5), to provide advice to the Secretary\nin relation to the restrictions (including restrictions as to\naccessibility and availability) to be imposed in respect of\nparticular substances that are, or are included in, therapeutic\ngoods;\n\nChapter 6  Administration",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-52b-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-52b-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-52b-ss-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-52b-ss-4"
        }
      ],
      "cml:integrityHash": "72d67e8bdd880d4543121db77586b29b030f6d86f1b40e30203891a09bbf51bd"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-52b",
      "@type": "cof:Section",
      "cof:title": "52B Advisory Committee on Medicines Scheduling",
      "values:kind": "section",
      "cof:pageNumber": 341,
      "values:originalText": "(1) The Advisory Committee on Medicines Scheduling is established\nby this section.\n(2) Subject to subsection (3), the Committee is to be constituted, and\nto hold meetings, in accordance with the regulations.\n(3) The Commonwealth, each State, the Australian Capital Territory\nand the Northern Territory are each entitled to nominate a member\nof the Committee in accordance with the regulations.\n(4) The functions of the Committee are as follows:\n(a) subject to subsection (5), to make recommendations to the\nSecretary in relation to the classification and scheduling of\nsubstances that are, or are included in, therapeutic goods;\n(b) to make recommendations to the Secretary in relation to\nother changes to the current Poisons Standard (other than the\nschedules);\n(c) to reconsider a recommendation made under paragraph (a) or\n(b) at the request of the Secretary;\n(d) subject to subsection (5), to provide advice to the Secretary\nin relation to the restrictions (including restrictions as to\naccessibility and availability) to be imposed in respect of\nparticular substances that are, or are included in, therapeutic\ngoods;\n\nChapter 6  Administration"
    },
