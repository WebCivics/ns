      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits dealing with counterfeit therapeutic goods",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The matters are as follows:"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "42E(5) Offence of dealing with counterfeit therapeutic goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42e-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.270",
      "values:originalText": "(5) To avoid doubt, a term that is defined in subsection 3(1) in relation\nto therapeutic goods and used in this section in relation to goods\nhas in this section the meaning given by subsection 3(1).",
      "skos:definition": "(5) To avoid doubt, a term that is defined in subsection 3(1) in relation\nto therapeutic goods and used in this section in relation to goods\nhas in this section the meaning given by subsection 3(1).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42e"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-5-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5012e232e8f9c87f1385ed1a8cd68bcf450beb4a0c6d1d70bcccfab03ebc7001",
      "skos:note": "Definition of term for therapeutic goods"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42e-ss-5",
      "@type": "cof:Section",
      "cof:title": "42E(5) Offence of dealing with counterfeit therapeutic goods",
      "values:kind": "subsection",
      "cof:pageNumber": 270,
      "values:originalText": "(5) To avoid doubt, a term that is defined in subsection 3(1) in relation\nto therapeutic goods and used in this section in relation to goods\nhas in this section the meaning given by subsection 3(1)."
    },
