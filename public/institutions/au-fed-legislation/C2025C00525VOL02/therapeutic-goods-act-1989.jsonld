    {
      "@id": "concept:therapeutic-goods-act-1989-sec-66-ss-4c",
      "@type": "cml:Concept",
      "skos:prefLabel": "66(4C) Transitional arrangements for goods required to be registered or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-66-ss-4c"
