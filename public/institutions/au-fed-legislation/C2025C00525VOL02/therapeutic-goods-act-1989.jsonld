      ],
      "cml:integrityHash": "bc819fc539fad70f1eeda1b80c2a5eb085d48704842a841483cd508ba91b7793",
      "skos:note": "Secretary may amend or prepare a new Poisons Standard."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-52d-ss-2",
