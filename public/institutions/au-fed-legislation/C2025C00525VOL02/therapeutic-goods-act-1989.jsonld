    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-48h-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "48H(3) Retention of seized things",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48h-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.328",
      "values:originalText": "(3) The thing may be returned under subsection (2) either\nunconditionally or on such terms and conditions as the Secretary\nsees fit.\nNote:\nThis section does not apply in relation to the thing if section 52AAB\napplies in relation to the thing: see subsection 52AAB(2).",
      "skos:definition": "(3) The thing may be returned under subsection (2) either\nunconditionally or on such terms and conditions as the Secretary\nsees fit.\nNote:\nThis section does not apply in relation to the thing if section 52AAB\napplies in relation to the thing: see subsection 52AAB(2).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-48h"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-48h-ss-3-norm"
        }
      ],
      "cml:integrityHash": "4f203aa9caea4ec17dcc3578d88b45836575bee78a430eedf53e75a5838e7eea",
      "skos:note": "The thing may be returned under subsection (2) either unconditionally or on such terms and conditions as the Secretary sees fit."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48h-ss-3",
      "@type": "cof:Section",
      "cof:title": "48H(3) Retention of seized things",
      "values:kind": "subsection",
      "cof:pageNumber": 328,
      "values:originalText": "(3) The thing may be returned under subsection (2) either\nunconditionally or on such terms and conditions as the Secretary\nsees fit.\nNote:\nThis section does not apply in relation to the thing if section 52AAB\napplies in relation to the thing: see subsection 52AAB(2)."
    },
