      },
      "cml:premiseText": "(1) If: (a) a person holds a licence or a permission to import or export therapeutic goods; and (b) the person engages in conduct;",
      "cml:conclusionText": "the conduct occurs during the period of the licence or permission."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54aa-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Describes temporal relationship between licence/permission and conduct",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) If: (a) a person holds a licence or a permission to import or export therapeutic goods; and (b) the person engages in conduct;",
      "cml:conclusionText": "the conduct ends before the period of the licence or permission."
    },
