    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "41QB(5) Offences and civil penalty provision—supplying vaping goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qb-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.206",
      "values:originalText": "(5) Subsections (1) to (4) do not apply if:\n(a) subsections (6), (7) and (8) apply in relation to the supply of\nthe vaping goods by the person; or\n(b) subsections (9), (10) and (11) apply in relation to the supply\nof the vaping goods by the person.\nNote:\nThe person bears an evidential burden in relation to the matters in\nsubsections (6), (7) and (8) or subsections (9), (10) and (11): see\nsubsection 13.3(3) of the Criminal Code and section 41QE of this Act.\nExceptions—wholesale supply chain",
      "skos:definition": "(5) Subsections (1) to (4) do not apply if:\n(a) subsections (6), (7) and (8) apply in relation to the supply of\nthe vaping goods by the person; or\n(b) subsections (9), (10) and (11) apply in relation to the supply\nof the vaping goods by the person.\nNote:\nThe person bears an evidential burden in relation to the matters in\nsubsections (6), (7) and (8) or subsections (9), (10) and (11): see\nsubsection 13.3(3) of the Criminal Code and section 41QE of this Act.\nExceptions—wholesale supply chain",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41qb"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-5-norm"
        }
      ],
      "cml:integrityHash": "e3d9db33033aa560475f4253fc1f2f427c00814af597579a826c1743b776c001",
      "skos:note": "Exemptions from subsections (1) to (4)"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qb-ss-5",
      "@type": "cof:Section",
      "cof:title": "41QB(5) Offences and civil penalty provision—supplying vaping goods",
      "values:kind": "subsection",
      "cof:pageNumber": 206,
      "values:originalText": "(5) Subsections (1) to (4) do not apply if:\n(a) subsections (6), (7) and (8) apply in relation to the supply of\nthe vaping goods by the person; or\n(b) subsections (9), (10) and (11) apply in relation to the supply\nof the vaping goods by the person.\nNote:\nThe person bears an evidential burden in relation to the matters in\nsubsections (6), (7) and (8) or subsections (9), (10) and (11): see\nsubsection 13.3(3) of the Criminal Code and section 41QE of this Act.\nExceptions—wholesale supply chain"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-5-norm",
