      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.298",
      "values:originalText": "The powers conferred on the Federal Court or Federal Circuit and\nFamily Court of Australia (Division 2) under this Part are in\naddition to, and not instead of, any other powers of the court,\nwhether conferred by this Act or otherwise.\n\nEnforcement  Chapter 5A\nEnforceable directions  Part 5A-5\n\nSection 42YS\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "The powers conferred on the Federal Court or Federal Circuit and\nFamily Court of Australia (Division 2) under this Part are in\naddition to, and not instead of, any other powers of the court,\nwhether conferred by this Act or otherwise.\n\nEnforcement  Chapter 5A\nEnforceable directions  Part 5A-5\n\nSection 42YS\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yr-norm"
        }
      ],
