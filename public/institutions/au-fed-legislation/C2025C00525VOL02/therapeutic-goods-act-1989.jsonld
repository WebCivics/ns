      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Temporal relation between supply and rule",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
