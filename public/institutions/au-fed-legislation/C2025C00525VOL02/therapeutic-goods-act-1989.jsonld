      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasKnowledge",
      "cml:logicSummary": "Directors, employees and agents must have certain knowledge.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has a certain state of mind.",
      "cml:conclusionText": "The person must have that knowledge."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-6-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasReasons",
      "cml:logicSummary": "Directors, employees and agents must have certain reasons for their intentions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has a certain intention or purpose.",
      "cml:conclusionText": "The person must have those reasons."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-6-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "hasProperty",
      "cml:logicSummary": "Directors, employees and agents must have certain knowledge or reasons.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has a certain state of mind.",
      "cml:conclusionText": "The person has that knowledge or reason."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-6-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Directors, employees and agents must have certain knowledge or reasons during their actions.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person performs an action.",
      "cml:conclusionText": "The person has that knowledge or reason during the action."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-6-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "mustJustify",
      "cml:logicSummary": "Directors, employees and agents must justify their intentions with certain reasons.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has an intention.",
      "cml:conclusionText": "The person must justify that intention with those reasons."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-6-logic-diffusion-6",
