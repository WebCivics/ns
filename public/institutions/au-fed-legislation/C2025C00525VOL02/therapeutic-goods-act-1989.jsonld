    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42v-ss-6e",
      "@type": "cml:Concept",
      "skos:prefLabel": "42V(6E) Recall of therapeutic goods because of actual or potential",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42v-ss-6e"
      },
      "cml:curationStatus": {
