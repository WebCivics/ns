      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "canDelegate",
      "cml:logicSummary": "Authorization for delegation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The powers of the Secretary under subsection 32CM(1) or 41HC(1)",
      "cml:conclusionText": "may be delegated to a registered medical practitioner"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal restriction on delegation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The powers of the Secretary under subsection 32CM(1) or 41HC(1)",
      "cml:conclusionText": "may only be delegated during the registration period"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-6-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:logicSummary": "Universal applicability of delegation restriction",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The powers of the Secretary under subsection 32CM(1) or 41HC(1)",
      "cml:conclusionText": "are restricted to registered medical practitioners everywhere"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-6-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "isAuthorizedTo",
      "cml:logicSummary": "Authorization for delegation by AI system",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person referred to in paragraph (1)(a) or (c)",
      "cml:conclusionText": "is authorized to delegate powers as a registered medical practitioner"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-6-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "hasShape",
      "cml:logicSummary": "Validation of delegation restriction",
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person referred to in paragraph (1)(a) or (c)",
      "cml:conclusionText": "must be validated as a registered medical practitioner"
    },
