    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54aa-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "54AA(2) Offences for contravening conditions or requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54aa-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.352",
      "values:originalText": "(2) If:\n(a) the condition or requirement relates to the possession,\ncustody, transport, use or disposal of the goods; or\n(b) the regulation providing for the condition or requirement\nstates that the purpose of the condition or requirement is to\nprotect the safety of the public;\nthe number of penalty units for the contravention is 240 penalty\nunits.",
      "skos:definition": "(2) If:\n(a) the condition or requirement relates to the possession,\ncustody, transport, use or disposal of the goods; or\n(b) the regulation providing for the condition or requirement\nstates that the purpose of the condition or requirement is to\nprotect the safety of the public;\nthe number of penalty units for the contravention is 240 penalty\nunits.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-54aa"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54aa-ss-2-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54aa-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e4e91572021a7e8259ff26b0bfe226bfff93bbb5cebd17a55ff2ade3a90d6f00",
      "skos:note": "Increased penalty for contravention of certain conditions or requirements"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54aa-ss-2",
      "@type": "cof:Section",
      "cof:title": "54AA(2) Offences for contravening conditions or requirements",
      "values:kind": "subsection",
      "cof:pageNumber": 352,
      "values:originalText": "(2) If:\n(a) the condition or requirement relates to the possession,\ncustody, transport, use or disposal of the goods; or\n(b) the regulation providing for the condition or requirement\nstates that the purpose of the condition or requirement is to\nprotect the safety of the public;\nthe number of penalty units for the contravention is 240 penalty\nunits."
    },
