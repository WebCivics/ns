    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dq",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DQ Civil penalty for dissemination of generic information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.247",
      "values:originalText": "A person contravenes this section if:\n(a) the person disseminates, by any means, generic information\nabout therapeutic goods to the public or a section of the\npublic; and\n(b) the dissemination of that generic information does not\ncomply with the provisions of the Therapeutic Goods\nAdvertising Code that are prescribed by regulations for the\npurposes of section 42DO.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nChapter 5  Advertising, counterfeit therapeutic goods and product tampering",
      "skos:definition": "A person contravenes this section if:\n(a) the person disseminates, by any means, generic information\nabout therapeutic goods to the public or a section of the\npublic; and\n(b) the dissemination of that generic information does not\ncomply with the provisions of the Therapeutic Goods\nAdvertising Code that are prescribed by regulations for the\npurposes of section 42DO.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.\n\nChapter 5  Advertising, counterfeit therapeutic goods and product tampering",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dq-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dq-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dq-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "170b1c2011f34e3ca469aa8b6ecae9378aeb43957c254049e797e0642bfbc4a1",
      "skos:note": "Dissemination of generic information about therapeutic goods is prohibited."
    },
    {
