      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41g-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies inclusions in the Register",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inclusions in the Register may be suspended or cancelled.",
      "cml:conclusionText": "Classification of inclusions is possible"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41g-logic-alleninterval-2",
