    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qa-ss-3",
      "@type": "cof:Section",
      "cof:title": "41QA(3) Offences and civil penalty provision—manufacturing vaping",
      "values:kind": "subsection",
      "cof:pageNumber": 205,
      "values:originalText": "(3) A person contravenes this subsection if the person manufactures, or\ncarries out a step in the manufacture of, vaping goods in Australia.\nMaximum civil penalty:\n(a) for an individual—7,000 penalty units; and\n(b) for a body corporate—70,000 penalty units."
    },
