    {
      "@id": "concept:therapeutic-goods-act-1989-sec-66-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "66(5) Transitional arrangements for goods required to be registered or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-66-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.390",
      "values:originalText": "(5) Section 21 does not apply, during the period of 15 months after the\ncommencement of this Act or during such longer period as the\nSecretary specifies by notice published in the Gazette before the\nend of that first-mentioned period, to any goods.",
      "skos:definition": "(5) Section 21 does not apply, during the period of 15 months after the\ncommencement of this Act or during such longer period as the\nSecretary specifies by notice published in the Gazette before the\nend of that first-mentioned period, to any goods.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-66"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-66-ss-5-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-66-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a61163ad065da808b32700788acc0390d6decf6c0d3e01edf699b4b2a956e15f",
      "skos:note": "Exemption from Section 21 for goods during transitional period"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-66-ss-5",
      "@type": "cof:Section",
      "cof:title": "66(5) Transitional arrangements for goods required to be registered or",
      "values:kind": "subsection",
      "cof:pageNumber": 390,
      "values:originalText": "(5) Section 21 does not apply, during the period of 15 months after the\ncommencement of this Act or during such longer period as the\nSecretary specifies by notice published in the Gazette before the\nend of that first-mentioned period, to any goods."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-66-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
