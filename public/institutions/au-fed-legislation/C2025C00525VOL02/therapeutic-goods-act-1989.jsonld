    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jl",
      "@type": "cml:Concept",
      "skos:prefLabel": "41JL Purposes of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.142",
      "values:originalText": "The purposes of this Part are to facilitate the following:\n(a) monitoring and enforcing compliance with the requirements\nof this Chapter;\n(b) monitoring the safety and performance of medical devices;\n(c) any activities that are incidental to the above purposes.\n\nMedical devices  Chapter 4\nMandatory reporting of adverse events by healthcare facilities  Part 4-8A\nMandatory reporting of adverse events  Division 2\nSection 41JM\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "The purposes of this Part are to facilitate the following:\n(a) monitoring and enforcing compliance with the requirements\nof this Chapter;\n(b) monitoring the safety and performance of medical devices;\n(c) any activities that are incidental to the above purposes.\n\nMedical devices  Chapter 4\nMandatory reporting of adverse events by healthcare facilities  Part 4-8A\nMandatory reporting of adverse events  Division 2\nSection 41JM\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41jl-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41jl-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cc223507a91967353f45d94c790d78d919a2be2fdc863f0392de62c19ae87030",
      "skos:note": "Facilitate monitoring and enforcing compliance with Chapter requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jl",
      "@type": "cof:Section",
      "cof:title": "41JL Purposes of this Part",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "The purposes of this Part are to facilitate the following:\n(a) monitoring and enforcing compliance with the requirements\nof this Chapter;\n(b) monitoring the safety and performance of medical devices;\n(c) any activities that are incidental to the above purposes.\n\nMedical devices  Chapter 4\nMandatory reporting of adverse events by healthcare facilities  Part 4-8A\nMandatory reporting of adverse events  Division 2\nSection 41JM\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jl-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41jl"
      },
      "values:deonticStatus": {
