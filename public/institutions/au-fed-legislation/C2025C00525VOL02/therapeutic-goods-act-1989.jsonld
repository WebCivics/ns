    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41hb-ss-2",
      "@type": "cof:Section",
      "cof:title": "41HB(2) Approvals for special and experimental uses",
      "values:kind": "subsection",
      "cof:pageNumber": 115,
      "values:originalText": "(2) The approval may be given subject to conditions specified in the\napproval, including a condition relating to charging for medical\ndevices of the kinds in question.\nNote:\nBreach of the conditions may be an offence: see\nsubsections 41MN(9), (9A) and (9B)."
    },
