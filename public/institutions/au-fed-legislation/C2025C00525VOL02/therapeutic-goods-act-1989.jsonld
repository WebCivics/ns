      "dc:source": "therapeutic-goods-act-1989.pdf, p.64",
      "values:originalText": "(2) If the revocation of the certificate is so limited, the Secretary must\nvary the certificate so that it no longer applies to the medical\ndevices referred to in subsection (1).",
      "skos:definition": "(2) If the revocation of the certificate is so limited, the Secretary must\nvary the certificate so that it no longer applies to the medical\ndevices referred to in subsection (1).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41eu"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41eu-ss-2-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41eu-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cf5a21f9c5fe797d2f3a672c731032c674e6bbe7fca8d2316fd2f4e1d3123cd8",
      "skos:note": "Secretary must vary certificate to remove medical devices from scope"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41eu-ss-2",
      "@type": "cof:Section",
      "cof:title": "41EU(2) Limiting revocation of conformity assessment certificates to",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(2) If the revocation of the certificate is so limited, the Secretary must\nvary the certificate so that it no longer applies to the medical\ndevices referred to in subsection (1)."
    },
