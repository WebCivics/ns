      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits dealing with counterfeit therapeutic goods.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person intentionally manufactures, supplies, imports, or exports goods.",
      "cml:conclusionText": "An offence is committed if the goods are counterfeit and the person knows that fact or is reckless as to whether that fact exists."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Defines a temporal interval for the manufacture, supply, importation, or exportation of goods.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person intentionally manufactures, supplies, imports, or exports goods.",
      "cml:conclusionText": "A temporal interval is defined for the manufacture, supply, importation, or exportation of goods."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the liability of an executive officer of a body corporate.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "For the liability of an executive officer of a body corporate, see sections 54B and 54BA.",
      "cml:conclusionText": "An offence is committed if the goods are counterfeit and the person knows that fact or is reckless as to whether that fact exists."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "42E(2) Offence of dealing with counterfeit therapeutic goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42e-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
