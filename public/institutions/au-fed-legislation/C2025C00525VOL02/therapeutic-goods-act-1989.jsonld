    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42da",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DA Simplified outline of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42da"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.230",
      "values:originalText": "Representations in advertisements about therapeutic goods may be\nrestricted representations, required representations or prohibited\nrepresentations. The offences and civil penalties in Division 3A\nrefer to these 3 kinds of representations.",
      "skos:definition": "Representations in advertisements about therapeutic goods may be\nrestricted representations, required representations or prohibited\nrepresentations. The offences and civil penalties in Division 3A\nrefer to these 3 kinds of representations.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42da-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42da-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a01522bf8aee7f051c46fc990da56ce63c1321667697e60aebe3ca0009211fd0",
      "skos:note": "Representations in advertisements about therapeutic goods may be restricted, required or prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42da",
      "@type": "cof:Section",
      "cof:title": "42DA Simplified outline of this Division",
      "values:kind": "section",
      "cof:pageNumber": 230,
      "values:originalText": "Representations in advertisements about therapeutic goods may be\nrestricted representations, required representations or prohibited\nrepresentations. The offences and civil penalties in Division 3A\nrefer to these 3 kinds of representations."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42da-norm",
