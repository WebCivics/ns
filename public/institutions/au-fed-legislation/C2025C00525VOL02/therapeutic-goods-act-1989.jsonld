    {
      "@id": "concept:therapeutic-goods-act-1989-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 By whom charges payable",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.301",
      "values:originalText": "(1) An annual registration charge, annual listing charge or annual\ncharge for inclusion in the Register is payable by the person in\nrelation to whom the therapeutic goods concerned are registered,\nlisted or included in the Register.\n(2) An annual licensing charge is payable by the holder of the licence\nto which the charge relates.\n(3) An annual conformity assessment body determination charge is\npayable by the Australian corporation that is the subject of the\nconformity assessment body determination to which the charge\nrelates.",
      "skos:definition": "(1) An annual registration charge, annual listing charge or annual\ncharge for inclusion in the Register is payable by the person in\nrelation to whom the therapeutic goods concerned are registered,\nlisted or included in the Register.\n(2) An annual licensing charge is payable by the holder of the licence\nto which the charge relates.\n(3) An annual conformity assessment body determination charge is\npayable by the Australian corporation that is the subject of the\nconformity assessment body determination to which the charge\nrelates.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-43-ss-1"
        },
