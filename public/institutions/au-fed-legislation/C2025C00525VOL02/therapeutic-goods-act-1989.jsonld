        }
      ],
      "cml:integrityHash": "f03f82dd55045f406092838667b6592943dc47d17ab449ce392d54b1b6e1febd",
      "skos:note": "Continuation of obligation despite expired period or passed time Aiding, abetting, or inducing a contravention of a civil penalty provision is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yc-ss-1",
      "@type": "cof:Section",
      "cof:title": "42YC(1) Persons involved in contravening civil penalty provision",
      "values:kind": "subsection",
      "cof:pageNumber": 282,
      "values:originalText": "(1) A person must not:\n(a) aid, abet, counsel or procure a contravention of a civil\npenalty provision; or\n(b) induce (by threats, promises or otherwise) a contravention of\na civil penalty provision; or\n(c) conspire to contravene a civil penalty provision."
    },
