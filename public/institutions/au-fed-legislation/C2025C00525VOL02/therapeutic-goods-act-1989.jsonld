        }
      ],
      "cml:integrityHash": "3a4a7e0f2fbe1541e7043d3fdf3bfbe58222be482d79c8d80943706a3bfa8287",
      "skos:note": "Manufacturing, exporting, or using a medical device without conformity assessment is prohibited."
    },
    {
