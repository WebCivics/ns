    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-60a-ss-6-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "The provision implies that the Minister or Tribunal has discretion to remit the matter.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) If...",
      "cml:conclusionText": "the Minister or Tribunal has discretion to remit the matter."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-60a-ss-6-logic-dialectical-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Dialectical"
      },
      "cml:operator": "NOT",
      "cml:logicSummary": "The provision is not a prohibition on making a new application for registration.",
      "cml:executionSurface": "modalities::dialectical",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) If...",
      "cml:conclusionText": "the provision does not prohibit making a new application for registration."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-60a-ss-6-logic-linearlogic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "The provision requires the authorised delegate to make a decision under section 25 and include the biological in the Register.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
