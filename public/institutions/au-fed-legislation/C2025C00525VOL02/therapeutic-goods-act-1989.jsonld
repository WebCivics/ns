      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.60",
      "values:originalText": "(1) This Division does not affect the Secretary’s powers to revoke a\nconformity assessment certificate under Division 4.",
