    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41c",
      "@type": "cml:Concept",
      "skos:prefLabel": "41C What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.32",
      "values:originalText": "The essential principles set out the requirements relating to the\nsafety and performance characteristics of medical devices.\nCompliance with applicable medical device standards is not\nrequired, but it is one way to establish compliance with essential\nprinciples. The regulations may make provision for and in relation\nto the Secretary causing a database of unique device identifiers of\nmedical devices to be established and maintained.\nNote:\nDealing in medical devices that do not comply with the essential\nprinciples may be an offence or may contravene a civil penalty\nprovision: see Division 1 of Part 4-11.\n\nMedical devices  Chapter 4\nEssential principles and medical device standards  Part 4-2\nEssential principles  Division 1\nSection 41CA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "The essential principles set out the requirements relating to the\nsafety and performance characteristics of medical devices.\nCompliance with applicable medical device standards is not\nrequired, but it is one way to establish compliance with essential\nprinciples. The regulations may make provision for and in relation\nto the Secretary causing a database of unique device identifiers of\nmedical devices to be established and maintained.\nNote:\nDealing in medical devices that do not comply with the essential\nprinciples may be an offence or may contravene a civil penalty\nprovision: see Division 1 of Part 4-11.\n\nMedical devices  Chapter 4\nEssential principles and medical device standards  Part 4-2\nEssential principles  Division 1\nSection 41CA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41c-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-diffusion-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-cogai-4"
        }
      ],
      "cml:integrityHash": "e5d8fe802392df4faa97549b886f3a4204147be47326c32d26fdb3ae9f1f183f",
      "skos:note": "Compliance with medical device standards is not required but can be used to establish compliance with essential principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41c",
      "@type": "cof:Section",
      "cof:title": "41C What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "The essential principles set out the requirements relating to the\nsafety and performance characteristics of medical devices.\nCompliance with applicable medical device standards is not\nrequired, but it is one way to establish compliance with essential\nprinciples. The regulations may make provision for and in relation\nto the Secretary causing a database of unique device identifiers of\nmedical devices to be established and maintained.\nNote:\nDealing in medical devices that do not comply with the essential\nprinciples may be an offence or may contravene a civil penalty\nprovision: see Division 1 of Part 4-11.\n\nMedical devices  Chapter 4\nEssential principles and medical device standards  Part 4-2\nEssential principles  Division 1\nSection 41CA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41c-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41c"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must comply with medical device standards.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Compliance is not required.",
      "cml:conclusionText": "Compliance can be used to establish compliance."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "The regulations may make provision for and in relation to the Secretary causing a database of unique device identifiers of medical devices to be established and maintained.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The regulations are applicable.",
      "cml:conclusionText": "The database must be established and maintained."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-diffusion-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Dealing in medical devices that do not comply with the essential principles may be an offence or contravenes a civil penalty provision.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The regulations are applicable.",
      "cml:conclusionText": "Dealing in non-compliant medical devices is prohibited."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41c-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "The therapeutic goods act regulates dealing in medical devices.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The regulations are applicable.",
      "cml:conclusionText": "Dealing in medical devices is regulated by the act."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ca",
      "@type": "cml:Concept",
      "skos:prefLabel": "41CA Essential principles",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ca"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.33",
      "values:originalText": "(1) The regulations may set out requirements for medical devices.\n(2) These requirements are to be known as the essential principles.\n(3) Regulations made for the purposes of subsection (1) may include\nrequirements in relation to the inclusion in the database referred to\nin section 41CE of the following:\n(a) unique device identifiers of medical devices;\n(b) information relating to those unique device identifiers, those\nmedical devices or the import, export, manufacture or supply\nof those medical devices.\n(4) Subsection (3) has effect subject to subsection 41CE(2).\n(5) Subsection (3) does not limit subsection (1).\n\nChapter 4  Medical devices",
      "skos:definition": "(1) The regulations may set out requirements for medical devices.\n(2) These requirements are to be known as the essential principles.\n(3) Regulations made for the purposes of subsection (1) may include\nrequirements in relation to the inclusion in the database referred to\nin section 41CE of the following:\n(a) unique device identifiers of medical devices;\n(b) information relating to those unique device identifiers, those\nmedical devices or the import, export, manufacture or supply\nof those medical devices.\n(4) Subsection (3) has effect subject to subsection 41CE(2).\n(5) Subsection (3) does not limit subsection (1).\n\nChapter 4  Medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ca-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ca-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ca-ss-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ca-ss-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ca-ss-5"
        }
      ],
      "cml:integrityHash": "e42f63c89a525c468e08109f7664e32c721ab5bfcea3099b87db83ed545130e5"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ca",
