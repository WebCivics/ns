    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bh",
      "@type": "cml:Concept",
      "skos:prefLabel": "41BH Meaning of compliance with essential principles",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.27",
      "values:originalText": "(1) A medical device complies, for the purposes of this Chapter\n(including Part 4-11), with the essential principles if and only if it\ndoes not contravene any of the essential principles.\n(2) However, a medical device is also taken, for the purposes of this\nChapter (other than Part 4-11), to comply with the essential\nprinciples if:\n(a) the medical device complies with one or more medical device\nstandards that apply to it; and\n(b) the medical device contravenes the essential principles only\nin respect of a part or parts of the essential principles to\nwhich that medical device standard, or one or more of those\nmedical device standards, relate.\n\nChapter 4  Medical devices",
      "skos:definition": "(1) A medical device complies, for the purposes of this Chapter\n(including Part 4-11), with the essential principles if and only if it\ndoes not contravene any of the essential principles.\n(2) However, a medical device is also taken, for the purposes of this\nChapter (other than Part 4-11), to comply with the essential\nprinciples if:\n(a) the medical device complies with one or more medical device\nstandards that apply to it; and\n(b) the medical device contravenes the essential principles only\nin respect of a part or parts of the essential principles to\nwhich that medical device standard, or one or more of those\nmedical device standards, relate.\n\nChapter 4  Medical devices",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41bh-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41bh-ss-2"
        }
      ],
      "cml:integrityHash": "0171298716f5bdc5e9b2307f0e07b794dba72a411869e5bf26fa87ba2a8b9704"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bh",
      "@type": "cof:Section",
      "cof:title": "41BH Meaning of compliance with essential principles",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "(1) A medical device complies, for the purposes of this Chapter\n(including Part 4-11), with the essential principles if and only if it\ndoes not contravene any of the essential principles.\n(2) However, a medical device is also taken, for the purposes of this\nChapter (other than Part 4-11), to comply with the essential\nprinciples if:\n(a) the medical device complies with one or more medical device\nstandards that apply to it; and\n(b) the medical device contravenes the essential principles only\nin respect of a part or parts of the essential principles to\nwhich that medical device standard, or one or more of those\nmedical device standards, relate.\n\nChapter 4  Medical devices"
    },
