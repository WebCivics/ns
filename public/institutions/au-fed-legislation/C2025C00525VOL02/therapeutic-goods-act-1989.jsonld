      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.307",
      "values:originalText": "The Secretary can gather information or documents that are\nrelevant to a contravention or possible contravention of this Act or\nthe regulations.\n\nChapter 6  Administration",
      "skos:definition": "The Secretary can gather information or documents that are\nrelevant to a contravention or possible contravention of this Act or\nthe regulations.\n\nChapter 6  Administration",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-45aa-norm"
        }
      ],
      "cml:integrityHash": "81dd8541e3defa2111815a5bc04ef9964adb8fd14f571701872a73de04e224af",
      "skos:note": "The Secretary can gather information or documents relevant to a contravention or possible contravention of this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45aa",
      "@type": "cof:Section",
      "cof:title": "45AA Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 307,
      "values:originalText": "The Secretary can gather information or documents that are\nrelevant to a contravention or possible contravention of this Act or\nthe regulations.\n\nChapter 6  Administration"
    },
