        }
      ],
      "cml:integrityHash": "6fb6ab7bf3223678571d89c02117f70fbf97955f583c78bf877b3885d7d721f4",
      "skos:note": "Secretary must require information within a specified period. Secretary must specify a reasonable period for compliance with notice.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jf-ss-2",
      "@type": "cof:Section",
      "cof:title": "41JF(2) Secretary may require information relating to health",
      "values:kind": "subsection",
      "cof:pageNumber": 136,
      "values:originalText": "(2) The notice must specify a reasonable period within which the\nperson must comply. The period must be at least 10 working days\nstarting on the day on which the notice is given."
    },
