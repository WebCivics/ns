      },
      "cml:premiseText": "(3) If a court orders that the goods be forfeited in relation to any therapeutic goods or vaping goods",
      "cml:conclusionText": "The forfeiture diffuses to all goods"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54-ss-3-logic-cogai-5",
