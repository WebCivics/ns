    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42db",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DB Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42db"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.230",
      "values:originalText": "In this Division:\napplicant means an applicant for approval of the use of a restricted\nrepresentation in an advertisement about therapeutic goods.\napproval holder, in relation to a restricted representation, means\nthe person to whom notice of approval of the use of the restricted\nrepresentation was given.",
      "skos:definition": "In this Division:\napplicant means an applicant for approval of the use of a restricted\nrepresentation in an advertisement about therapeutic goods.\napproval holder, in relation to a restricted representation, means\nthe person to whom notice of approval of the use of the restricted\nrepresentation was given.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42db-norm"
        }
      ],
      "cml:integrityHash": "65e60b1740f4733eb0d638cfbb0a0f0dc6387c781315e0a47680ffe403f8d419",
      "skos:note": "Definition of applicant and approval holder."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42db",
      "@type": "cof:Section",
      "cof:title": "42DB Definitions",
      "values:kind": "section",
      "cof:pageNumber": 230,
      "values:originalText": "In this Division:\napplicant means an applicant for approval of the use of a restricted\nrepresentation in an advertisement about therapeutic goods.\napproval holder, in relation to a restricted representation, means\nthe person to whom notice of approval of the use of the restricted\nrepresentation was given."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42db-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42db"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dd",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DD Restricted representations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.230",
      "values:originalText": "For the purposes of this Part, a representation in an advertisement\nabout therapeutic goods that refers to a form of a disease,\ncondition, ailment or defect identified in a part of the Therapeutic\nGoods Advertising Code as a serious form of a disease, condition,\nailment or defect is a restricted representation.\nNote:\nSee sections 42DL and 42DLB for offences and a civil penalty for\nadvertising therapeutic goods, where the advertisement contains a\nrestricted representation.\n\nAdvertising, counterfeit therapeutic goods and product tampering  Chapter 5\nAdvertising and generic information  Part 5-1\nGeneral provisions about advertising therapeutic goods  Division 3\nSection 42DE\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "For the purposes of this Part, a representation in an advertisement\nabout therapeutic goods that refers to a form of a disease,\ncondition, ailment or defect identified in a part of the Therapeutic\nGoods Advertising Code as a serious form of a disease, condition,\nailment or defect is a restricted representation.\nNote:\nSee sections 42DL and 42DLB for offences and a civil penalty for\nadvertising therapeutic goods, where the advertisement contains a\nrestricted representation.\n\nAdvertising, counterfeit therapeutic goods and product tampering  Chapter 5\nAdvertising and generic information  Part 5-1\nGeneral provisions about advertising therapeutic goods  Division 3\nSection 42DE\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dd-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dd-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dd-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dd-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dd-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dd-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "efadae9ec3a396b744284df92ebfa3215c36885f1556b5ddc2a9acfcc497e8a7",
      "skos:note": "Restricted representations in advertisements about therapeutic goods"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dd",
      "@type": "cof:Section",
      "cof:title": "42DD Restricted representations",
      "values:kind": "section",
      "cof:pageNumber": 230,
      "values:originalText": "For the purposes of this Part, a representation in an advertisement\nabout therapeutic goods that refers to a form of a disease,\ncondition, ailment or defect identified in a part of the Therapeutic\nGoods Advertising Code as a serious form of a disease, condition,\nailment or defect is a restricted representation.\nNote:\nSee sections 42DL and 42DLB for offences and a civil penalty for\nadvertising therapeutic goods, where the advertisement contains a\nrestricted representation.\n\nAdvertising, counterfeit therapeutic goods and product tampering  Chapter 5\nAdvertising and generic information  Part 5-1\nGeneral provisions about advertising therapeutic goods  Division 3\nSection 42DE\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
