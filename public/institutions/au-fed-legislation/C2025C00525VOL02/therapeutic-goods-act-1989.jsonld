      },
      "cml:operator": "Rebuttal",
      "cml:logicSummary": "Requires rebuttal of false advertising claims.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
