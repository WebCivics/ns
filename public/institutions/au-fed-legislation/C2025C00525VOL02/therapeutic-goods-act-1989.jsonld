      "cml:premiseText": "(2) If the cancellation of the entry of a kind of medical device from the\nRegister is limited to some medical devices of that kind...",
      "cml:conclusionText": "...the Secretary:\n(a) must vary the entry in the Register accordingly;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41go-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Varying entry in Register occurs within cancellation of medical device",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If the cancellation of the entry of a kind of medical device from the\nRegister is limited to some medical devices of that kind...",
      "cml:conclusionText": "...the Secretary:\n(a) must vary the entry in the Register accordingly;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41go-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
