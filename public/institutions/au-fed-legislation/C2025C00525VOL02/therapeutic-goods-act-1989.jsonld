    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qe",
      "@type": "cml:Concept",
      "skos:prefLabel": "41QE Exceptions etc. to civil penalty provisions—burden of proof",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qe"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.220",
      "values:originalText": "If, in proceedings for a pecuniary penalty order against a person for\na contravention of a civil penalty provision in this Chapter, the\nperson wishes to rely on any exception, exemption, excuse,\nqualification or justification that applies in relation to the civil\npenalty provision, then the person bears an evidential burden in\nrelation to that matter.\n\nVaping goods  Chapter 4A\nOther provisions  Part 4A-3\nDeterminations by Minister  Division 1\nSection 41R\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "If, in proceedings for a pecuniary penalty order against a person for\na contravention of a civil penalty provision in this Chapter, the\nperson wishes to rely on any exception, exemption, excuse,\nqualification or justification that applies in relation to the civil\npenalty provision, then the person bears an evidential burden in\nrelation to that matter.\n\nVaping goods  Chapter 4A\nOther provisions  Part 4A-3\nDeterminations by Minister  Division 1\nSection 41R\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qe-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qe-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6c2edca3a526d18e3350cd08aa5cba2e821724d0709ab33f0c2a2f38cfa81fdd",
      "skos:note": "Burden of proof for exceptions to civil penalty provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qe",
      "@type": "cof:Section",
      "cof:title": "41QE Exceptions etc. to civil penalty provisions—burden of proof",
      "values:kind": "section",
      "cof:pageNumber": 220,
      "values:originalText": "If, in proceedings for a pecuniary penalty order against a person for\na contravention of a civil penalty provision in this Chapter, the\nperson wishes to rely on any exception, exemption, excuse,\nqualification or justification that applies in relation to the civil\npenalty provision, then the person bears an evidential burden in\nrelation to that matter.\n\nVaping goods  Chapter 4A\nOther provisions  Part 4A-3\nDeterminations by Minister  Division 1\nSection 41R\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qe-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
