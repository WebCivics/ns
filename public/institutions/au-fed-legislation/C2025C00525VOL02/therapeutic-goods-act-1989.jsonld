      "cml:integrityHash": "8908984e2ff446167cb9a201367dc27e58c16af35de8872cffdae92437609f51",
      "skos:note": "Secretary may give sponsor permission to exclude from Division 3 of Part 4-11"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jd",
      "@type": "cof:Section",
      "cof:title": "41JD Secretary may require information etc. about devices",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "exempted under section 41HA from inclusion in the\nRegister\n(1) The Secretary may give the sponsor of kinds of medical devices\nexempted under subsection 41HA(1) from Division 3 of Part 4-11,\n\nChapter 4  Medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jd-norm",
