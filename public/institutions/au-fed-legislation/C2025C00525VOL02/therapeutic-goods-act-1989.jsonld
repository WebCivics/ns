        }
      ],
      "cml:integrityHash": "e4466d7c0dd1f6bee0077287617c56f72111970f969c7f1dd7afe19705eb3264",
      "skos:note": "The Secretary may inspect and copy documents produced under section 45AB."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45af",
      "@type": "cof:Section",
      "cof:title": "45AF Secretary may inspect and copy documents",
      "values:kind": "section",
      "cof:pageNumber": 312,
      "values:originalText": "The Secretary may inspect a document produced under\nsection 45AB and make and retain copies of the whole or a part of\nthe document."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45af-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
