    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gu-ss-1",
      "@type": "cof:Section",
      "cof:title": "41GU(1) Variation or revocation of exemption",
      "values:kind": "subsection",
      "cof:pageNumber": 111,
      "values:originalText": "(1) The Minister may, by writing, vary an exemption made under\nsection 41GS by removing specified kinds of medical devices from\nthe exemption.\nRevocation of exemption"
    },
