    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fj",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FJ Procedure following audits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.83",
      "values:originalText": "After auditing the application, the Secretary must:\n(a) notify the applicant in writing of his or her decision within 20\nworking days after the decision is made; and\n(b) if the decision is not to include the kind of device to which\nthe application relates in the Register—state in the notice the\nreasons for the decision; and\n\nChapter 4  Medical devices",
      "skos:definition": "After auditing the application, the Secretary must:\n(a) notify the applicant in writing of his or her decision within 20\nworking days after the decision is made; and\n(b) if the decision is not to include the kind of device to which\nthe application relates in the Register—state in the notice the\nreasons for the decision; and\n\nChapter 4  Medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fj-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fj-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fj-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "0c578b05f1c711a460af00234e745f7a6d3188f0537353bbba26d6a39b8c3889",
      "skos:note": "Notify applicant of decision within 20 working days and state reasons for non-inclusion in Register if applicable.",
      "dc:description": "Decision notice with reasons"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fj",
      "@type": "cof:Section",
      "cof:title": "41FJ Procedure following audits",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "After auditing the application, the Secretary must:\n(a) notify the applicant in writing of his or her decision within 20\nworking days after the decision is made; and\n(b) if the decision is not to include the kind of device to which\nthe application relates in the Register—state in the notice the\nreasons for the decision; and\n\nChapter 4  Medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fj-norm",
