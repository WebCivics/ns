      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42eb",
      "@type": "cml:Concept",
      "skos:prefLabel": "42EB Relief from liability for certain contraventions relating to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42eb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.271",
      "values:originalText": "dealing with counterfeit therapeutic goods\n(1) If:\n(a) proceedings for the contravention of section 42EA (a civil\npenalty provision) are brought against a person; and\n(b) in the proceedings it appears to the Court that the person has,\nor may have, contravened that section but that:\n(i) the person has a reasonable excuse; and\n(ii) having regard to all the circumstances of the case, the\nperson ought fairly to be excused for the contravention;\n\nChapter 5  Advertising, counterfeit therapeutic goods and product tampering",
      "skos:definition": "dealing with counterfeit therapeutic goods\n(1) If:\n(a) proceedings for the contravention of section 42EA (a civil\npenalty provision) are brought against a person; and\n(b) in the proceedings it appears to the Court that the person has,\nor may have, contravened that section but that:\n(i) the person has a reasonable excuse; and\n(ii) having regard to all the circumstances of the case, the\nperson ought fairly to be excused for the contravention;\n\nChapter 5  Advertising, counterfeit therapeutic goods and product tampering",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42eb-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42eb-logic-deontic-1"
