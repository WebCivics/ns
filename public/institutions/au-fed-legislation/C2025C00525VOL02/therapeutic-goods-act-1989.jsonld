    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "41BA Requirements for medical devices (Parts 4-2 and 4-3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ba"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.21",
      "values:originalText": "The requirements for medical devices are:\n(a) essential principles (that are about the safety and\nperformance characteristics of medical devices); and\n(b) conformity assessment procedures (that are mainly about the\napplication of quality management systems) or requirements\ncomparable to conformity assessment procedures.\nNote:\nMedical device standards may be made under Division 2 of Part 4-2,\nand conformity assessment standards may be made under Division 2\nof Part 4-3, but they are not requirements.",
      "skos:definition": "The requirements for medical devices are:\n(a) essential principles (that are about the safety and\nperformance characteristics of medical devices); and\n(b) conformity assessment procedures (that are mainly about the\napplication of quality management systems) or requirements\ncomparable to conformity assessment procedures.\nNote:\nMedical device standards may be made under Division 2 of Part 4-2,\nand conformity assessment standards may be made under Division 2\nof Part 4-3, but they are not requirements.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ba-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ba-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dc57dd8a7d31b38ecb3d708078ea5248c704701d7c5b61eea5c2062f92908633",
      "skos:note": "Requirements for medical devices must conform to safety and performance standards."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ba",
      "@type": "cof:Section",
      "cof:title": "41BA Requirements for medical devices (Parts 4-2 and 4-3)",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The requirements for medical devices are:\n(a) essential principles (that are about the safety and\nperformance characteristics of medical devices); and\n(b) conformity assessment procedures (that are mainly about the\napplication of quality management systems) or requirements\ncomparable to conformity assessment procedures.\nNote:\nMedical device standards may be made under Division 2 of Part 4-2,\nand conformity assessment standards may be made under Division 2\nof Part 4-3, but they are not requirements."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ba-norm",
      "@type": "values:Obligation",
