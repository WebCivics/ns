    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YL(4) Enforcement of undertakings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yl-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.295",
      "values:originalText": "(4) If the Secretary considers that the person who gave the undertaking\nhas breached any of its terms, the Secretary may apply to the\nFederal Court for an order under subsection (5).",
      "skos:definition": "(4) If the Secretary considers that the person who gave the undertaking\nhas breached any of its terms, the Secretary may apply to the\nFederal Court for an order under subsection (5).",
      "values:partOf": {
