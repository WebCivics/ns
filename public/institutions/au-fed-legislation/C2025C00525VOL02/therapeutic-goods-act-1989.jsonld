    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41db",
      "@type": "cml:Concept",
      "skos:prefLabel": "41DB Medical device classifications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41db"
      },
      "cml:curationStatus": {
