      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bb",
      "@type": "cml:Concept",
      "skos:prefLabel": "41BB Administrative processes (Parts 4-4 to 4-10)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.21",
      "values:originalText": "The administrative processes under this Chapter are:\n(a) issuing conformity assessment certificates for some\nmanufacturers of medical devices; and\n(aa) making conformity assessment body determinations; and\n(b) including medical devices in the Register; and\n\nChapter 4  Medical devices",
      "skos:definition": "The administrative processes under this Chapter are:\n(a) issuing conformity assessment certificates for some\nmanufacturers of medical devices; and\n(aa) making conformity assessment body determinations; and\n(b) including medical devices in the Register; and\n\nChapter 4  Medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41bb-norm"
        }
      ],
      "cml:integrityHash": "2817c4d28002c2863fbaa392bbef138701d0517d231fc6688466f8011ac40095",
      "skos:note": "List of administrative processes under this Chapter"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bb",
      "@type": "cof:Section",
      "cof:title": "41BB Administrative processes (Parts 4-4 to 4-10)",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The administrative processes under this Chapter are:\n(a) issuing conformity assessment certificates for some\nmanufacturers of medical devices; and\n(aa) making conformity assessment body determinations; and\n(b) including medical devices in the Register; and\n\nChapter 4  Medical devices"
    },
