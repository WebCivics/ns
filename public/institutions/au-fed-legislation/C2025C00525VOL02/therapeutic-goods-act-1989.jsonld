        }
      ],
      "cml:integrityHash": "3935e84d41bf78398a7efd4329381b98a439414904e400ae0d51680f5cd5d628",
      "skos:note": "Secretary must include kind of medical device in Register if application has passed preliminary assessment and not selected for audit."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ff-ss-1",
      "@type": "cof:Section",
      "cof:title": "41FF(1) Obligation to include kinds of medical devices in the Register",
      "values:kind": "subsection",
      "cof:pageNumber": 80,
      "values:originalText": "(1) If:\n(a) an application for a kind of medical device to be included in\nthe Register in relation to a person has passed preliminary\nassessment; and\n(b) the application has not been selected for audit under\nsection 41FH;\nthe Secretary must include the kind of device in the Register in\nrelation to the person."
    },
