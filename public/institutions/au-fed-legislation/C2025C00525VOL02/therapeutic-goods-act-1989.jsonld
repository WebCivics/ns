        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Court has discretion to grant relief from liability.",
      "cml:conclusionText": "Relief from liability is permitted by the Court."
    },
    {
