      },
      "cml:operator": "during",
      "cml:logicSummary": "Restrictions apply during therapeutic goods advertising",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "For the purposes of this Part, a representation in an advertisement about therapeutic goods that refers to a form of a disease, condition, ailment or defect identified in a part of the Therapeutic Goods Advertising Code as a serious form of a disease, condition, ailment or defect is a restricted representation.",
      "cml:conclusionText": "Restrictions apply during therapeutic goods advertising"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42de",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DE Applications for approval of use of restricted representation",
      "cml:realizedBy": {
