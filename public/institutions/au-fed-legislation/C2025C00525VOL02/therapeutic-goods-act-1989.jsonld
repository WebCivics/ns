        }
      ],
      "cml:integrityHash": "148351955c551ac69066da5c39bbc1f85a6a0aa8fb7b60b0dea2e5e4332a105f",
      "skos:note": "May discharge or vary an injunction granted by that court under this Part."
    },
    {
