    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ag-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "45AG(4) Secretary may retain documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45ag-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
