        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The exemption from liability takes precedence over other obligations.",
      "cml:conclusionText": "The exemption from liability is ordered by the temporal interval during which it applies."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42vb-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
