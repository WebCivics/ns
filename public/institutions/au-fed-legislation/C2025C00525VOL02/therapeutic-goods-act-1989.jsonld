    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jk",
      "@type": "cml:Concept",
      "skos:prefLabel": "41JK Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.142",
      "values:originalText": "The chief executive officer (however described) of a healthcare\nfacility is required to give a report to the Secretary about an\nadverse event involving a reportable medical device in certain\ncircumstances.\nCivil penalties apply to the chief executive officer of a healthcare\nfacility for failing to give such a report to the Secretary.",
      "skos:definition": "The chief executive officer (however described) of a healthcare\nfacility is required to give a report to the Secretary about an\nadverse event involving a reportable medical device in certain\ncircumstances.\nCivil penalties apply to the chief executive officer of a healthcare\nfacility for failing to give such a report to the Secretary.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41jk-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41jk-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b260062f8ba6fd8e1d7bf6c6a84d4c53f36aaf5816b7f6851e379b57b31c5939",
      "skos:note": "Chief executive officer of a healthcare facility must report adverse events involving reportable medical devices."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jk",
      "@type": "cof:Section",
      "cof:title": "41JK Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "The chief executive officer (however described) of a healthcare\nfacility is required to give a report to the Secretary about an\nadverse event involving a reportable medical device in certain\ncircumstances.\nCivil penalties apply to the chief executive officer of a healthcare\nfacility for failing to give such a report to the Secretary."
    },
    {
