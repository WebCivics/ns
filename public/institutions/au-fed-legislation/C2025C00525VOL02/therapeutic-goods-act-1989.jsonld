    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gi",
      "@type": "cml:Concept",
      "skos:prefLabel": "41GI Effect of suspension",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.99",
      "values:originalText": "If all or some medical devices of a particular kind are suspended,\nthey are taken, for the purposes of this Act (other than Division 2\nof Part 4-5, this Division and Part 4-8), not to be included in the\nRegister while the suspension has effect.\nNote:\nDealing in medical devices that are not included in the Register may\nbe an offence or may contravene a civil penalty provision: see\nDivision 3 of Part 4-11.",
      "skos:definition": "If all or some medical devices of a particular kind are suspended,\nthey are taken, for the purposes of this Act (other than Division 2\nof Part 4-5, this Division and Part 4-8), not to be included in the\nRegister while the suspension has effect.\nNote:\nDealing in medical devices that are not included in the Register may\nbe an offence or may contravene a civil penalty provision: see\nDivision 3 of Part 4-11.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gi-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gi-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3889513ab0f22b32bcd075bf226ff0fb3a3b8c43c4acc57a2b56f0be5883f96b",
      "skos:note": "Medical devices of a particular kind are not included in the Register while suspension has effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gi",
      "@type": "cof:Section",
      "cof:title": "41GI Effect of suspension",
      "values:kind": "section",
      "cof:pageNumber": 99,
      "values:originalText": "If all or some medical devices of a particular kind are suspended,\nthey are taken, for the purposes of this Act (other than Division 2\nof Part 4-5, this Division and Part 4-8), not to be included in the\nRegister while the suspension has effect.\nNote:\nDealing in medical devices that are not included in the Register may\nbe an offence or may contravene a civil penalty provision: see\nDivision 3 of Part 4-11."
    },
