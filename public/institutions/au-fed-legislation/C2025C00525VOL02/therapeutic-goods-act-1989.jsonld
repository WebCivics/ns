    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mr",
      "@type": "cml:Concept",
      "skos:prefLabel": "41MR Civil penalties for failing to notify adverse effects etc. where",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41mr"
