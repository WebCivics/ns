      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "classOf",
      "cml:logicSummary": "Authority applies to classes of medical practitioners.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) and (c)"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41hc-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "41HC(5) Authorities for health practitioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41hc-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.118",
      "values:originalText": "(5) The regulations may prescribe circumstances in which medical\ndevices may be supplied under an authority under subsection (1).",
      "skos:definition": "(5) The regulations may prescribe circumstances in which medical\ndevices may be supplied under an authority under subsection (1).",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41hc"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41hc-ss-5-norm"
        }
      ],
      "cml:integrityHash": "4127a130e53b5ae4701e57a453a09fba170f6af4c7e0bfc7bf1e43c2240f7b6b",
      "skos:note": "Authority to prescribe circumstances for medical device supply"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41hc-ss-5",
      "@type": "cof:Section",
      "cof:title": "41HC(5) Authorities for health practitioners",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(5) The regulations may prescribe circumstances in which medical\ndevices may be supplied under an authority under subsection (1)."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41hc-ss-5-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
