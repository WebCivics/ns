      ],
      "cml:integrityHash": "287d5c644caa158347161cc54c5ddc9d4f8bcbab674ae3628462fb2a796a7762",
      "skos:note": "Fee for certification application and inspection"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-58-ss-3",
      "@type": "cof:Section",
      "cof:title": "58(3) Export certifications",
      "values:kind": "subsection",
      "cof:pageNumber": 367,
      "values:originalText": "(3) Such fee as is prescribed is payable in respect of:\n(a) an application for a certification under this section; and\n(b) where an inspection of a manufacturing site is necessary for\nthe purposes of the issue of a certification under this\nsection—the inspection of that site."
    },
