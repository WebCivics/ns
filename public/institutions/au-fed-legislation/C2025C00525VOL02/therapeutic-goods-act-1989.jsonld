      "@type": "cml:Concept",
      "skos:prefLabel": "41HB(3) Approvals for special and experimental uses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41hb-ss-3"
