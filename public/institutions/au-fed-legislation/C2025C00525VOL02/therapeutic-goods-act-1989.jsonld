        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41cd-ss-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "51437262c401bbe0350840dc034168ee555a94219c9cc9653a5713bcd018caec",
      "skos:note": "A medical device standard for a combination of component parts takes precedence over standards for individual parts."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41cd-ss-2",
