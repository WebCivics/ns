      },
      "cml:premiseText": "The officer is responsible for ensuring that employees, agents, and contractors have a reasonable knowledge and understanding of the requirements.",
      "cml:conclusionText": "The officer must ensure that employees, agents, and contractors have a reasonable knowledge and understanding of the requirements."
    },
