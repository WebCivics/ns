    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gb-ss-2",
      "@type": "cof:Section",
      "cof:title": "41GB(2) Notice of proposed suspension must be given in certain cases",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(2) The Secretary is not to make a decision relating to the proposed\nsuspension until the Secretary has had regard to any submissions\nthe person makes under paragraph (1)(b)."
    },
