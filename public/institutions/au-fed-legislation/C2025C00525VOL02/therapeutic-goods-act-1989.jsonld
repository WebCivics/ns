    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ke",
      "@type": "cml:Concept",
      "skos:prefLabel": "41KE Saving of other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ke"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.150",
      "values:originalText": "This Part is not intended to exclude or limit the operation of any\nother law of the Commonwealth or any law of a State or Territory.\n\nMedical devices  Chapter 4\nAssessment fees  Part 4-10\n\nSection 41L\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "This Part is not intended to exclude or limit the operation of any\nother law of the Commonwealth or any law of a State or Territory.\n\nMedical devices  Chapter 4\nAssessment fees  Part 4-10\n\nSection 41L\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
