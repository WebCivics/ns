      "skos:note": "Order to pay pecuniary penalty for contravention of civil penalty provision",
      "dc:description": "pecuniary penalty amount"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42y-ss-2",
      "@type": "cof:Section",
      "cof:title": "42Y(2) Federal Court may order person to pay pecuniary penalty for",
