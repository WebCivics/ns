        }
      ],
      "cml:integrityHash": "ca37534fd9aab92d9d7245822a9163988111ec834f03631f2bdb4bd7b52b88c3",
      "skos:note": "Defines overseas regulator A conformity assessment procedure is not applied if there has been a contravention of the procedures. A requirement that is comparable to a conformity assessment procedure is not applied if there has been a contravention of the requirement."
    },
