    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41es-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "41ES(3) Immediate revocation of conformity assessment certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41es-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.61",
      "values:originalText": "(3) If the revocation is withdrawn, the revocation is taken never to\nhave occurred.\n\nChapter 4  Medical devices",
      "skos:definition": "(3) If the revocation is withdrawn, the revocation is taken never to\nhave occurred.\n\nChapter 4  Medical devices",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41es"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41es-ss-3-norm"
        }
      ],
      "cml:integrityHash": "75b3ce082b95874acbba1a6c78f547392f635a2a2497ddcc5de2379b2aa26606",
      "skos:note": "Revocation of conformity assessment certificates is taken never to have occurred if withdrawn."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41es-ss-3",
      "@type": "cof:Section",
      "cof:title": "41ES(3) Immediate revocation of conformity assessment certificates",
      "values:kind": "subsection",
      "cof:pageNumber": 61,
      "values:originalText": "(3) If the revocation is withdrawn, the revocation is taken never to\nhave occurred.\n\nChapter 4  Medical devices"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41es-ss-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41es-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
