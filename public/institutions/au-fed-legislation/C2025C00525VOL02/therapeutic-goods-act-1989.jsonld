    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yn-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YN(2) Grant of injunctions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yn-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.296",
      "values:originalText": "(2) If:\n(a) a person has refused or failed, or is refusing or failing, or is\nproposing to refuse or fail, to do a thing; and\n(b) the refusal or failure was, is or would be a contravention of\nthis Act or the regulations;\nthe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may, on application by the Secretary, grant an\ninjunction requiring the person to do that thing.\n\nEnforcement  Chapter 5A\nInjunctions  Part 5A-4\n\nSection 42YO\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "(2) If:\n(a) a person has refused or failed, or is refusing or failing, or is\nproposing to refuse or fail, to do a thing; and\n(b) the refusal or failure was, is or would be a contravention of\nthis Act or the regulations;\nthe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may, on application by the Secretary, grant an\ninjunction requiring the person to do that thing.\n\nEnforcement  Chapter 5A\nInjunctions  Part 5A-4\n\nSection 42YO\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42yn"
      },
