    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dt",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DT Civil penalty for giving false or misleading information or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dt"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.250",
      "values:originalText": "document in compliance with a notice\nA person contravenes this section if:\n(a) the person is given a notice under section 42DR; and\n(b) the person gives information or produces a document in\ncompliance or purported compliance with the notice; and\n(c) the information or document is false or misleading in a\nmaterial particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "document in compliance with a notice\nA person contravenes this section if:\n(a) the person is given a notice under section 42DR; and\n(b) the person gives information or produces a document in\ncompliance or purported compliance with the notice; and\n(c) the information or document is false or misleading in a\nmaterial particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dt-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dt-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dt-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dt-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dt-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42dt-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "b7224a74a206be0194c5f2e0d92047b2a641d9331e02d371ba0ea189956fba97",
      "skos:note": "Giving false or misleading information in compliance with a notice is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dt",
      "@type": "cof:Section",
      "cof:title": "42DT Civil penalty for giving false or misleading information or",
      "values:kind": "section",
      "cof:pageNumber": 250,
      "values:originalText": "document in compliance with a notice\nA person contravenes this section if:\n(a) the person is given a notice under section 42DR; and\n(b) the person gives information or produces a document in\ncompliance or purported compliance with the notice; and\n(c) the information or document is false or misleading in a\nmaterial particular.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
