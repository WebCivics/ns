      ],
      "cml:integrityHash": "9cab5da41854e8c96f1e9590ffb592653533e648a04c78f26c58b9e34085519a",
      "skos:note": "Defendant bears evidential burden in relation to reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48-ss-3a",
      "@type": "cof:Section",
      "cof:title": "48(3A) General powers of authorised persons in relation to premises",
      "values:kind": "subsection",
      "cof:pageNumber": 318,
      "values:originalText": "(3A) Subsection (3) does not apply if the person has a reasonable\nexcuse.\nNote:\nThe defendant bears an evidential burden in relation to the matter in\nsubsection (3A). See subsection 13.3(3) of the Criminal Code."
    },
