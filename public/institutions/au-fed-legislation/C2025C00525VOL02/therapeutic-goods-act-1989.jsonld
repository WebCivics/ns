    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dr-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DR(4) Secretary may require information or documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dr-ss-4"
      },
