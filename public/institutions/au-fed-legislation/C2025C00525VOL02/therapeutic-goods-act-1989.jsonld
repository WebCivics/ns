          "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-10-logic-alleninterval-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-10-logic-ltl-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-10-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "5e8c848fb79601b4574db4e64db39976664e9c7abf38011017dcd493fca99211",
