        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-2-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-2-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "2d830f257ef74e04b9a89e868138ae3a80acd29b6f2ebb1cbf92e3a633cfff90",
      "skos:note": "Dealing with counterfeit therapeutic goods is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42e-ss-2",
      "@type": "cof:Section",
      "cof:title": "42E(2) Offence of dealing with counterfeit therapeutic goods",
      "values:kind": "subsection",
      "cof:pageNumber": 270,
      "values:originalText": "(2) Goods are counterfeit if any of the following contain a false\nrepresentation of a matter listed in subsection (3):\n(a) the label or presentation of the goods;\n(b) any document or record relating to the goods or their\nmanufacture;\n(c) any advertisement for the goods."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42e-ss-2-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
