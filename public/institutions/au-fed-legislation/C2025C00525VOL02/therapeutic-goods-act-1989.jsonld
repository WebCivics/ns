      "cml:premiseText": "(c) the Secretary is satisfied that it is in the public interest to\nissue a notice under this subsection;",
      "cml:conclusionText": "the warning notice remains in effect until the person complies"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Warning notice spreads to public.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If:\n(a) the Secretary gives a person a notice (the substantiation\nnotice) under subsection 42DR(1) or (2); and\n(b) the person fails to comply with the substantiation notice;",
      "cml:conclusionText": "the warning notice spreads to the public"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
