    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41cd-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41CD(2) Inconsistencies between medical device standards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41cd-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.35",
      "values:originalText": "(2) A medical device standard that applies to a kind of medical device\nthat consists of a combination of component parts takes precedence\nover any medical device standard that applies to the component\nparts.\n\nChapter 4  Medical devices",
      "skos:definition": "(2) A medical device standard that applies to a kind of medical device\nthat consists of a combination of component parts takes precedence\nover any medical device standard that applies to the component\nparts.\n\nChapter 4  Medical devices",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41cd"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41cd-ss-2-norm"
        },
