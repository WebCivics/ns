        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2-logic-diffusion-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "b4fb0c2213322630ec9b0317e081720465600618086a4d9fdf61b4324ec763d8",
      "skos:note": "Payment of assessment fee by instalments is not allowed if any part of an instalment is unpaid immediately after it became due."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41lc-ss-2",
      "@type": "cof:Section",
      "cof:title": "41LC(2) Payment of assessment fee by instalments",
      "values:kind": "subsection",
      "cof:pageNumber": 152,
      "values:originalText": "(2) Regulations made for the purposes of subsection (1) may provide\nthat a person is not allowed to pay an assessment fee by instalments\nif any part of an instalment of:\n(a) that or any other assessment fee payable by the person; or\n(b) any evaluation fee under section 24 payable by the person;\nwas unpaid immediately after the time when it became due for\npayment."
    },
