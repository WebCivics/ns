    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dl",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DL Advertising offences—general",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42dl"
