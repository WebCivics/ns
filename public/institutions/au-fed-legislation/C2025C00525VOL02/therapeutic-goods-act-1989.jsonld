    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41d",
      "@type": "cml:Concept",
      "skos:prefLabel": "41D What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.38",
      "values:originalText": "The conformity assessment procedures set out the requirements\nrelating to the application of quality management systems for\nmedical devices, and other requirements imposed on\nmanufacturers.\nCompliance with applicable conformity assessment standards is\nnot required, but it is one way to establish that one or more parts of\nthe conformity assessment procedures have been applied to\nmedical devices.\nNote 1:\nDealing in medical devices that have not had the conformity\nassessment procedures applied may be an offence or may contravene a\ncivil penalty provision: see Division 2 of Part 4-11.\nNote 2:\nSee section 41BI on applying the conformity assessment procedures.\n\nMedical devices  Chapter 4\nConformity assessment procedures  Part 4-3\nConformity assessment procedures  Division 1\nSection 41DA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "The conformity assessment procedures set out the requirements\nrelating to the application of quality management systems for\nmedical devices, and other requirements imposed on\nmanufacturers.\nCompliance with applicable conformity assessment standards is\nnot required, but it is one way to establish that one or more parts of\nthe conformity assessment procedures have been applied to\nmedical devices.\nNote 1:\nDealing in medical devices that have not had the conformity\nassessment procedures applied may be an offence or may contravene a\ncivil penalty provision: see Division 2 of Part 4-11.\nNote 2:\nSee section 41BI on applying the conformity assessment procedures.\n\nMedical devices  Chapter 4\nConformity assessment procedures  Part 4-3\nConformity assessment procedures  Division 1\nSection 41DA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41d-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f2d950a4a205a25ba2345c7ec89d5e533df4c8d0b95edeaa02de9fbe8ef6566f",
      "skos:note": "Compliance with applicable conformity assessment standards is not required, but it is one way to establish that one or more parts of the conformity assessment procedures have been applied."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41d",
      "@type": "cof:Section",
      "cof:title": "41D What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "The conformity assessment procedures set out the requirements\nrelating to the application of quality management systems for\nmedical devices, and other requirements imposed on\nmanufacturers.\nCompliance with applicable conformity assessment standards is\nnot required, but it is one way to establish that one or more parts of\nthe conformity assessment procedures have been applied to\nmedical devices.\nNote 1:\nDealing in medical devices that have not had the conformity\nassessment procedures applied may be an offence or may contravene a\ncivil penalty provision: see Division 2 of Part 4-11.\nNote 2:\nSee section 41BI on applying the conformity assessment procedures.\n\nMedical devices  Chapter 4\nConformity assessment procedures  Part 4-3\nConformity assessment procedures  Division 1\nSection 41DA\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
