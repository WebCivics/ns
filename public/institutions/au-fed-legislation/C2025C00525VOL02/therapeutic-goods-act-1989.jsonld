      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "mustInform",
      "cml:logicSummary": "Directors, employees and agents must inform others of their knowledge or reasons.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has certain knowledge or reasons.",
      "cml:conclusionText": "The person must inform others of that knowledge or reason."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "55(7) Conduct by directors, employees and agents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-55-ss-7"
      },
      "cml:curationStatus": {
