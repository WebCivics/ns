      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the possession of goods",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) If a court orders that the goods be forfeited",
      "cml:conclusionText": "The goods must be forfeited to the Commonwealth"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54-ss-3-logic-alleninterval-2",
