    {
      "@id": "concept:therapeutic-goods-act-1989-sec-48g",
      "@type": "cml:Concept",
      "skos:prefLabel": "48G Receipts for things seized under warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-48g"
      },
      "cml:curationStatus": {
