      "cml:logicSummary": "Inclusion in the reference list",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A director of a body corporate is included in this section.",
      "cml:conclusionText": "The reference to a director includes a reference to a constituent member of a body corporate."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-55-ss-7-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "subclassOf",
      "cml:logicSummary": "Classification of the constituent member",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A constituent member is a type of body corporate.",
      "cml:conclusionText": "The constituent member is classified as a body corporate."
    },
    {
