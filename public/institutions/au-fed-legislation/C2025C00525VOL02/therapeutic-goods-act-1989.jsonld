    {
      "@id": "concept:therapeutic-goods-act-1989-sec-51",
      "@type": "cml:Concept",
      "skos:prefLabel": "51 Offence and civil penalty provision related warrants by telephone",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-51"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.331",
      "values:originalText": "(1) If, in an urgent case, an authorised person considers it necessary to\ndo so, the person may apply to an issuing officer by telephone for a\nwarrant under section 50 in relation to premises.\n\nChapter 6  Administration",
      "skos:definition": "(1) If, in an urgent case, an authorised person considers it necessary to\ndo so, the person may apply to an issuing officer by telephone for a\nwarrant under section 50 in relation to premises.\n\nChapter 6  Administration",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-51-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-51-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "28e632296013d70d98788a8b93408094234dff4791336ad558f6e6ea077a1c5b",
      "skos:note": "Authorized person may apply for warrant by telephone in urgent cases."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-51",
