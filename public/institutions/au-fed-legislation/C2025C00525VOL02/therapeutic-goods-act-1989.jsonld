        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the making of an application for an exemption and requiring\npayment of that charge for the current year if the application\nis refused;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-44a-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
