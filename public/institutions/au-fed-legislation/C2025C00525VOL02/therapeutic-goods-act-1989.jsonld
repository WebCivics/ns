          "@id": "concept:therapeutic-goods-act-1989-sec-41fc-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3882e507e97ed7e00d03e5f6bc2ba40196dfafc6000ab75eecedd608bcfcfc75",
      "skos:note": "Application must not contain false or misleading information."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fc-ss-2",
      "@type": "cof:Section",
      "cof:title": "41FC(2) Making an application",
      "values:kind": "subsection",
      "cof:pageNumber": 73,
      "values:originalText": "(2) An application must not contain information that is false or\nmisleading in a material particular.\nNote:\nA person might also commit an offence, or contravene a civil penalty\nprovision, if the person makes a statement in an application that is\nfalse or misleading in a material particular: see sections 41FE and\n41FEA."
    },
