      },
      "cml:premiseText": "(b) the person is included in a class of health practitioners...",
      "cml:conclusionText": "...specified in subsection 41HC(6) rules;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mo-ss-4a-logic-alleninterval-3",
