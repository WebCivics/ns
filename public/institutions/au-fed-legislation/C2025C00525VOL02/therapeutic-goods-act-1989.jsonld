    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42x",
      "@type": "cml:Concept",
      "skos:prefLabel": "42X Saving of other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.280",
      "values:originalText": "This Part is not intended to exclude or limit the operation of any\nother law of the Commonwealth or any law of a State or Territory.\n\nEnforcement  Chapter 5A\nCivil penalties  Part 5A-1\nObtaining an order for a civil penalty  Division 1\nSection 42Y\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 5A—Enforcement",
      "skos:definition": "This Part is not intended to exclude or limit the operation of any\nother law of the Commonwealth or any law of a State or Territory.\n\nEnforcement  Chapter 5A\nCivil penalties  Part 5A-1\nObtaining an order for a civil penalty  Division 1\nSection 42Y\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 5A—Enforcement",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42x-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42x-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e447459c61041b466c76aa19bda75607567f8a205b926bcacfb43dd140f1cde6",
      "skos:note": "No exclusion or limitation of other laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42x",
      "@type": "cof:Section",
      "cof:title": "42X Saving of other laws",
      "values:kind": "section",
      "cof:pageNumber": 280,
      "values:originalText": "This Part is not intended to exclude or limit the operation of any\nother law of the Commonwealth or any law of a State or Territory.\n\nEnforcement  Chapter 5A\nCivil penalties  Part 5A-1\nObtaining an order for a civil penalty  Division 1\nSection 42Y\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 5A—Enforcement"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42x-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42x"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42x-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "excludes",
      "cml:logicSummary": "Exclusion of other laws",
      "cml:executionSurface": "modalities::logic::deontic",
