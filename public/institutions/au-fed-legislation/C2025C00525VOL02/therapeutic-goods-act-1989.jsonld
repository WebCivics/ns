    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41l",
      "@type": "cml:Concept",
      "skos:prefLabel": "41L What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.151",
      "values:originalText": "Conformity assessment fees must be paid for consideration of\napplications for conformity assessment certificates. Application\naudit assessment fees must be paid for auditing applications that\nare required to be selected for auditing under\nparagraph 41FH(1)(a).",
      "skos:definition": "Conformity assessment fees must be paid for consideration of\napplications for conformity assessment certificates. Application\naudit assessment fees must be paid for auditing applications that\nare required to be selected for auditing under\nparagraph 41FH(1)(a).",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41l-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f64f606ebfdf8fd391ef598deb8e2d27162da36286810e7e5e179d4733f29218",
      "skos:note": "Fees must be paid for consideration of applications and auditing."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41l",
      "@type": "cof:Section",
      "cof:title": "41L What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "Conformity assessment fees must be paid for consideration of\napplications for conformity assessment certificates. Application\naudit assessment fees must be paid for auditing applications that\nare required to be selected for auditing under\nparagraph 41FH(1)(a)."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41l-norm",
