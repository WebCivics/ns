    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yd",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YD Recovery of a pecuniary penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.283",
      "values:originalText": "If the Federal Court orders a person to pay a pecuniary penalty:\n(a) the penalty is payable to the Commonwealth; and\n(b) the Commonwealth may enforce the order as if it were a\njudgment of the Court.",
      "skos:definition": "If the Federal Court orders a person to pay a pecuniary penalty:\n(a) the penalty is payable to the Commonwealth; and\n(b) the Commonwealth may enforce the order as if it were a\njudgment of the Court.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yd-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yd-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yd-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "fc3e3971d83224ceca41d33aa68686d555dba3464a86be0416577e3b1f3dcb78",
      "skos:note": "The Commonwealth may enforce a pecuniary penalty order as if it were a judgment of the Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yd",
