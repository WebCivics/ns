    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FI(1) Auditing of applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fi-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.82",
      "values:originalText": "(1) If:\n(a) a section 41FC application is made for a kind of medical\ndevice to be included in the Register; and\n(b) the application has been selected for audit; and\n(c) a person has obtained a certificate issued by an Australian\nconformity assessment body to the effect that the body is\nsatisfied that an appropriate conformity assessment procedure\nhas been applied to devices of that kind; and\n(d) the certificate has been given to the Secretary; and\n(e) if the conformity assessment body determination that relates\nto the body is limited as mentioned in\nparagraph 41EWA(4)(b)—the Secretary is satisfied that the\ncertificate has been issued consistently with the\ndetermination;\nthe Secretary may have regard to the certificate in auditing the\napplication.",
      "skos:definition": "(1) If:\n(a) a section 41FC application is made for a kind of medical\ndevice to be included in the Register; and\n(b) the application has been selected for audit; and\n(c) a person has obtained a certificate issued by an Australian\nconformity assessment body to the effect that the body is\nsatisfied that an appropriate conformity assessment procedure\nhas been applied to devices of that kind; and\n(d) the certificate has been given to the Secretary; and\n(e) if the conformity assessment body determination that relates\nto the body is limited as mentioned in\nparagraph 41EWA(4)(b)—the Secretary is satisfied that the\ncertificate has been issued consistently with the\ndetermination;\nthe Secretary may have regard to the certificate in auditing the\napplication.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41fi"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-deontic-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-descriptionlogic-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-alleninterval-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-ltl-5"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-deontic-6"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-descriptionlogic-7"
        }
      ],
      "cml:integrityHash": "b8692134e7105bca16acf901c7cc6e0ca1fb92fe35ed6d08b3e5fe4f6a32b86e",
      "skos:note": "The Secretary may consider certain aspects of an application during auditing. Secretary may have regard to certificate in auditing application"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fi-ss-1",
      "@type": "cof:Section",
      "cof:title": "41FI(1) Auditing of applications",
      "values:kind": "subsection",
      "cof:pageNumber": 82,
      "values:originalText": "(1) If:\n(a) a section 41FC application is made for a kind of medical\ndevice to be included in the Register; and\n(b) the application has been selected for audit; and\n(c) a person has obtained a certificate issued by an Australian\nconformity assessment body to the effect that the body is\nsatisfied that an appropriate conformity assessment procedure\nhas been applied to devices of that kind; and\n(d) the certificate has been given to the Secretary; and\n(e) if the conformity assessment body determination that relates\nto the body is limited as mentioned in\nparagraph 41EWA(4)(b)—the Secretary is satisfied that the\ncertificate has been issued consistently with the\ndetermination;\nthe Secretary may have regard to the certificate in auditing the\napplication."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "May consider certain aspects",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permits Secretary to consider certificate",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a section 41FC application is made for a kind of medical device...",
      "cml:conclusionText": "The Secretary may have regard to the certificate in auditing the application."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Has been issued consistently with",
      "cml:logicSummary": "Certificate must be consistent with conformity assessment body determination",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) if the conformity assessment body determination that relates to the body is limited as mentioned in paragraph 41EWA(4)(b)—the Secretary is satisfied that the certificate has been issued...",
      "cml:conclusionText": "The Secretary is satisfied that the certificate has been issued consistently with the determination."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within a specified time frame",
      "cml:logicSummary": "Certificate must be given to Secretary within a specified timeframe",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the certificate has been given to the Secretary;",
      "cml:conclusionText": "The certificate was issued within a specified timeframe."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Certificate must be audited as part of recurring audit process",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the application has been selected for audit;",
      "cml:conclusionText": "The certificate is part of a recurring audit process."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must consider",
      "cml:logicSummary": "Secretary must consider certificate in auditing application",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) If...",
      "cml:conclusionText": "The Secretary must consider the certificate in auditing the application."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-1-logic-descriptionlogic-7",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Is a requirement for audit",
      "cml:logicSummary": "Certificate is a requirement for audit of section 41FC application",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) If...",
      "cml:conclusionText": "The certificate is a requirement for the audit."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41FI(2) Auditing of applications",
      "cml:realizedBy": {
