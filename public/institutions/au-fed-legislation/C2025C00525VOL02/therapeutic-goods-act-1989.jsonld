      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "if the person’s turnover of the therapeutic goods concerned for the financial year specified in the regulations is of low value;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-44a-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "exemption",
      "cml:logicSummary": "Exempts a person from liability to pay annual listing charge or annual charge for inclusion in the Register",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
