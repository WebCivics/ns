      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Requires recurring traces of false advertising and medical device registration.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
