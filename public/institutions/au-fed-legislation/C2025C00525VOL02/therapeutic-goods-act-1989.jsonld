      "cml:operator": "cancellation",
      "cml:logicSummary": "Cancels exemption and requires payment of charge for current year",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) cancelling an exemption and requiring payment of that\ncharge for the current year."
    },
    {
