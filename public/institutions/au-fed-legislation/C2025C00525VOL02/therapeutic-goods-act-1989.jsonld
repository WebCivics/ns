        }
      ],
      "cml:integrityHash": "3490d0dc93e2c48d53032dc271a279b521e00bb7d200cbbaf702e27043306e8f",
      "skos:note": "Regulations may be made before commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-63-ss-5",
      "@type": "cof:Section",
      "cof:title": "63(5) Regulations",
      "values:kind": "subsection",
      "cof:pageNumber": 386,
      "values:originalText": "(5) For the purposes of section 2, regulations may be made before the\ncommencement of this Act as if this Act were in force, but do not\ncome into effect on a day earlier than the day on which this Act\ncommences.\n\nChapter 8  Repeal and transitional provisions\n\nSection 66\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025\nChapter 8—Repeal and transitional\nprovisions"
