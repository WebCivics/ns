      },
      "cml:premiseText": "Subsection (3) sets conditions for supply.",
      "cml:conclusionText": "No supply is allowed."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4-logic-alleninterval-2",
