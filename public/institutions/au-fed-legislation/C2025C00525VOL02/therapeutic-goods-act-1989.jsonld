        }
      ],
      "cml:integrityHash": "d43d85122f7c6e83529e35a36f18583018e171a0fb3922a5cecfb8e87dd20883",
      "skos:note": "A medical device standard that is inconsistent with another standard has no effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41cd-ss-1",
