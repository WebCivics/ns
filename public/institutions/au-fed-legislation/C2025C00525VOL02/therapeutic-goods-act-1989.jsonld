      "skos:note": "Court's other powers unaffected"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yr",
      "@type": "cof:Section",
      "cof:title": "42YR Other powers of court unaffected",
      "values:kind": "section",
      "cof:pageNumber": 298,
