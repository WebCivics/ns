    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45ag-ss-3",
      "@type": "cof:Section",
      "cof:title": "45AG(3) Secretary may retain documents",
      "values:kind": "subsection",
      "cof:pageNumber": 312,
      "values:originalText": "(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original."
    },
