    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42do",
      "@type": "cml:Concept",
      "skos:prefLabel": "42DO Compliance with the Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42do"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.246",
      "values:originalText": "Generic information to which this Division applies must comply\nwith the provisions of the Therapeutic Goods Advertising Code\nthat are prescribed by the regulations for the purposes of this\nsection as if those provisions applied to generic information in the\nsame way as they apply to advertisements.",
      "skos:definition": "Generic information to which this Division applies must comply\nwith the provisions of the Therapeutic Goods Advertising Code\nthat are prescribed by the regulations for the purposes of this\nsection as if those provisions applied to generic information in the\nsame way as they apply to advertisements.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42do-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42do-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "665671b05902ea6b526dd29be6e99c9c30d7935b49be65ae5479bf0051c015ea",
      "skos:note": "Generic information must comply with the Therapeutic Goods Advertising Code."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42do",
      "@type": "cof:Section",
      "cof:title": "42DO Compliance with the Code",
      "values:kind": "section",
      "cof:pageNumber": 246,
      "values:originalText": "Generic information to which this Division applies must comply\nwith the provisions of the Therapeutic Goods Advertising Code\nthat are prescribed by the regulations for the purposes of this\nsection as if those provisions applied to generic information in the\nsame way as they apply to advertisements."
    },
    {
