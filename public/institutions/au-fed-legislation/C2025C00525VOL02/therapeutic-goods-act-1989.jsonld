    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mo-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "41MO(4) Criminal offences for misusing medical devices exempted for",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41mo-ss-4"
