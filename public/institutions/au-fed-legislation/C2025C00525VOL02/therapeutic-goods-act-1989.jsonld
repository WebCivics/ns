    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yh",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YH Criminal proceedings after civil proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.285",
      "values:originalText": "Criminal proceedings may not be started against a person for\nconduct that is substantially the same as conduct constituting a\ncontravention of a civil penalty provision if a pecuniary penalty\norder has been made against the person in respect of that conduct.",
      "skos:definition": "Criminal proceedings may not be started against a person for\nconduct that is substantially the same as conduct constituting a\ncontravention of a civil penalty provision if a pecuniary penalty\norder has been made against the person in respect of that conduct.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yh-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "74189f65ca31bb32041099f1e1ccf2239aa77da7b9533bfdb3ba236eb7651070",
      "skos:note": "Criminal proceedings cannot be started against a person for conduct substantially the same as a civil penalty provision if a pecuniary penalty order has been made."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yh",
