    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "41QB(4) Offences and civil penalty provision—supplying vaping goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qb-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.206",
      "values:originalText": "(4) A person who contravenes subsection (3) commits a separate\ncontravention of that subsection in respect of each unit of vaping\ngoods supplied by the person in Australia.\nNote:\nFor unit of vaping goods, see subsection 3(1).\nExceptions—general",
      "skos:definition": "(4) A person who contravenes subsection (3) commits a separate\ncontravention of that subsection in respect of each unit of vaping\ngoods supplied by the person in Australia.\nNote:\nFor unit of vaping goods, see subsection 3(1).\nExceptions—general",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41qb"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "e0817cb2cc040c33c63bbbc79fb79c9c2b5a18cdbea237a7eebbe813c522f6a7",
      "skos:note": "Supplying vaping goods without compliance with subsection (3) is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qb-ss-4",
      "@type": "cof:Section",
      "cof:title": "41QB(4) Offences and civil penalty provision—supplying vaping goods",
      "values:kind": "subsection",
      "cof:pageNumber": 206,
      "values:originalText": "(4) A person who contravenes subsection (3) commits a separate\ncontravention of that subsection in respect of each unit of vaping\ngoods supplied by the person in Australia.\nNote:\nFor unit of vaping goods, see subsection 3(1).\nExceptions—general"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4-norm",
      "@type": "values:Prohibition",
