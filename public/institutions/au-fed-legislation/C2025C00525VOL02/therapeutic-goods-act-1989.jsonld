    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41LC(2) Payment of assessment fee by instalments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41lc-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.152",
      "values:originalText": "(2) Regulations made for the purposes of subsection (1) may provide\nthat a person is not allowed to pay an assessment fee by instalments\nif any part of an instalment of:\n(a) that or any other assessment fee payable by the person; or\n(b) any evaluation fee under section 24 payable by the person;\nwas unpaid immediately after the time when it became due for\npayment.",
      "skos:definition": "(2) Regulations made for the purposes of subsection (1) may provide\nthat a person is not allowed to pay an assessment fee by instalments\nif any part of an instalment of:\n(a) that or any other assessment fee payable by the person; or\n(b) any evaluation fee under section 24 payable by the person;\nwas unpaid immediately after the time when it became due for\npayment.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41lc"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41lc-ss-2-logic-ltl-3"
