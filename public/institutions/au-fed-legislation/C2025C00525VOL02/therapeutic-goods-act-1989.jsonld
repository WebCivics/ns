    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of supplying vaping goods without compliance.",
      "cml:executionSurface": "modalities::logic::deontic",
