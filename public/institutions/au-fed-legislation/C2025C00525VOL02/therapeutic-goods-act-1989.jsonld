      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Recurring requirement to return seized things",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Proceedings in respect of which thing may afford evidence were instituted before end of 120 days",
      "cml:conclusionText": "Thing must be returned unless proceedings are ongoing or authorized by law."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-48h-ss-2-logic-diffusion-4",
