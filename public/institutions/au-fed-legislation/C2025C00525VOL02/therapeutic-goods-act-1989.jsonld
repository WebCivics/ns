    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41jf-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41JF(2) Secretary may require information relating to health",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41jf-ss-2"
      },
      "cml:curationStatus": {
