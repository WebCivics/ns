    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41rc-ss-2b-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Decision-making principles apply to decisions made within this interval",
