    {
      "@id": "concept:therapeutic-goods-act-1989-sec-45ag",
      "@type": "cml:Concept",
      "skos:prefLabel": "45AG Secretary may retain documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45ag"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.312",
      "values:originalText": "Retention of documents\n(1) The Secretary may take possession of a document produced under\nsection 45AB and retain it for as long as is reasonably necessary.\nCertified copy of documents\n(2) The person otherwise entitled to possession of a document\nproduced under section 45AB is entitled to be supplied, as soon as\npracticable, with a copy certified by the Secretary to be a true copy.\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n(4) Until a certified copy is supplied, the Secretary must provide the\nperson otherwise entitled to possession of the document, or a\nperson authorised by that person, reasonable access to the\ndocument for the purposes of inspecting and making copies of the\nwhole or a part of the document.\n\nAdministration  Chapter 6\nEntry, searches and warrants  Part 6-2\n\nSection 45A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "Retention of documents\n(1) The Secretary may take possession of a document produced under\nsection 45AB and retain it for as long as is reasonably necessary.\nCertified copy of documents\n(2) The person otherwise entitled to possession of a document\nproduced under section 45AB is entitled to be supplied, as soon as\npracticable, with a copy certified by the Secretary to be a true copy.\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n(4) Until a certified copy is supplied, the Secretary must provide the\nperson otherwise entitled to possession of the document, or a\nperson authorised by that person, reasonable access to the\ndocument for the purposes of inspecting and making copies of the\nwhole or a part of the document.\n\nAdministration  Chapter 6\nEntry, searches and warrants  Part 6-2\n\nSection 45A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-45ag-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-45ag-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-45ag-ss-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-45ag-ss-4"
        }
      ],
      "cml:integrityHash": "1cd6a0b735d94b749c9e1aa6e1d422157fb5abf4e47c4b176ff569bd7a97c99e"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45ag",
      "@type": "cof:Section",
      "cof:title": "45AG Secretary may retain documents",
      "values:kind": "section",
      "cof:pageNumber": 312,
      "values:originalText": "Retention of documents\n(1) The Secretary may take possession of a document produced under\nsection 45AB and retain it for as long as is reasonably necessary.\nCertified copy of documents\n(2) The person otherwise entitled to possession of a document\nproduced under section 45AB is entitled to be supplied, as soon as\npracticable, with a copy certified by the Secretary to be a true copy.\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n(4) Until a certified copy is supplied, the Secretary must provide the\nperson otherwise entitled to possession of the document, or a\nperson authorised by that person, reasonable access to the\ndocument for the purposes of inspecting and making copies of the\nwhole or a part of the document.\n\nAdministration  Chapter 6\nEntry, searches and warrants  Part 6-2\n\nSection 45A\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
