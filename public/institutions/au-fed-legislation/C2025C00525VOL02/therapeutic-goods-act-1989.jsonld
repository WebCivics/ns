    {
      "@id": "concept:therapeutic-goods-act-1989-sec-57-ss-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "57(10) Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-57-ss-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
