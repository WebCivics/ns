      "cml:premiseText": "(ii) if there is an emergency situation, for not more than 12 hours or such longer period as allowed by an issuing officer under subsection (5);"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffusion of authorized persons' absence to emergency situation",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iii) for a longer period if the occupier of the premises consents in writing."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-48aa-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
