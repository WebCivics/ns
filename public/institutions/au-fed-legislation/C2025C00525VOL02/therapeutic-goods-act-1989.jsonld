    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42yl",
      "@type": "cml:Concept",
      "skos:prefLabel": "42YL Enforcement of undertakings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.295",
      "values:originalText": "(1) The Secretary may accept a written undertaking given by a person\nin connection with a matter in relation to which the Secretary has a\npower or function under this Act or the regulations.\n(2) The person may withdraw or vary the undertaking at any time, but\nonly with the consent of the Secretary.\n(3) The Secretary must publish details of the undertaking, as in force\nfrom time to time, on the internet.\n(4) If the Secretary considers that the person who gave the undertaking\nhas breached any of its terms, the Secretary may apply to the\nFederal Court for an order under subsection (5).\n(5) If the Court is satisfied that the person has breached a term of the\nundertaking, the Court may make all or any of the following\norders:\n(a) an order directing the person to comply with that term of the\nundertaking;\n(b) an order directing the person to pay to the Commonwealth an\namount up to the amount of any financial benefit that the\nperson has obtained directly or indirectly and that is\nreasonably attributable to the breach;\n(c) any order that the Court considers appropriate directing the\nperson to compensate any other person who has suffered loss\nor damage as a result of the breach;\n(d) any other order that the Court considers appropriate.\n\nChapter 5A  Enforcement",
      "skos:definition": "(1) The Secretary may accept a written undertaking given by a person\nin connection with a matter in relation to which the Secretary has a\npower or function under this Act or the regulations.\n(2) The person may withdraw or vary the undertaking at any time, but\nonly with the consent of the Secretary.\n(3) The Secretary must publish details of the undertaking, as in force\nfrom time to time, on the internet.\n(4) If the Secretary considers that the person who gave the undertaking\nhas breached any of its terms, the Secretary may apply to the\nFederal Court for an order under subsection (5).\n(5) If the Court is satisfied that the person has breached a term of the\nundertaking, the Court may make all or any of the following\norders:\n(a) an order directing the person to comply with that term of the\nundertaking;\n(b) an order directing the person to pay to the Commonwealth an\namount up to the amount of any financial benefit that the\nperson has obtained directly or indirectly and that is\nreasonably attributable to the breach;\n(c) any order that the Court considers appropriate directing the\nperson to compensate any other person who has suffered loss\nor damage as a result of the breach;\n(d) any other order that the Court considers appropriate.\n\nChapter 5A  Enforcement",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42yl-ss-5"
        }
      ],
      "cml:integrityHash": "7000b747dde56039d295db09a99dd176f97ed46a15c03b7eb56fb1185cc7190d"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42yl",
      "@type": "cof:Section",
      "cof:title": "42YL Enforcement of undertakings",
      "values:kind": "section",
      "cof:pageNumber": 295,
      "values:originalText": "(1) The Secretary may accept a written undertaking given by a person\nin connection with a matter in relation to which the Secretary has a\npower or function under this Act or the regulations.\n(2) The person may withdraw or vary the undertaking at any time, but\nonly with the consent of the Secretary.\n(3) The Secretary must publish details of the undertaking, as in force\nfrom time to time, on the internet.\n(4) If the Secretary considers that the person who gave the undertaking\nhas breached any of its terms, the Secretary may apply to the\nFederal Court for an order under subsection (5).\n(5) If the Court is satisfied that the person has breached a term of the\nundertaking, the Court may make all or any of the following\norders:\n(a) an order directing the person to comply with that term of the\nundertaking;\n(b) an order directing the person to pay to the Commonwealth an\namount up to the amount of any financial benefit that the\nperson has obtained directly or indirectly and that is\nreasonably attributable to the breach;\n(c) any order that the Court considers appropriate directing the\nperson to compensate any other person who has suffered loss\nor damage as a result of the breach;\n(d) any other order that the Court considers appropriate.\n\nChapter 5A  Enforcement"
    },
