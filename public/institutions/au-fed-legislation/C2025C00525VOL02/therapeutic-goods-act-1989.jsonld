      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.358",
      "values:originalText": "(7) A reference in this section to a director of a body corporate\nincludes a reference to a constituent member of a body corporate\nincorporated for a public purpose by a law of the Commonwealth,\nof a State or of a Territory.",
      "skos:definition": "(7) A reference in this section to a director of a body corporate\nincludes a reference to a constituent member of a body corporate\nincorporated for a public purpose by a law of the Commonwealth,\nof a State or of a Territory.",
      "values:partOf": {
