    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41me-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "41ME(5) Criminal offences for failing to apply conformity assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41me-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.164",
      "values:originalText": "(5) A person commits an offence if:\n(a) the person manufactures a medical device; and\n(b) the person exports the device from Australia; and\n(c) the conformity assessment procedures have not been applied\nto the device; and\n(ca) the device is not of a kind covered by an exemption in force\nunder section 41GS; and\n(d) either:\n(i) the use of the device has resulted in, will result in, or is\nlikely to result in, harm or injury to any person; or\n(ii) the use of the device, if the device were used, would\nresult in, or would be likely to result in, harm or injury\nto any person; and\n(e) the harm or injury has resulted, will result, is likely to result,\nwould result, or would be likely to result, because the\n\nChapter 4  Medical devices",
      "skos:definition": "(5) A person commits an offence if:\n(a) the person manufactures a medical device; and\n(b) the person exports the device from Australia; and\n(c) the conformity assessment procedures have not been applied\nto the device; and\n(ca) the device is not of a kind covered by an exemption in force\nunder section 41GS; and\n(d) either:\n(i) the use of the device has resulted in, will result in, or is\nlikely to result in, harm or injury to any person; or\n(ii) the use of the device, if the device were used, would\nresult in, or would be likely to result in, harm or injury\nto any person; and\n(e) the harm or injury has resulted, will result, is likely to result,\nwould result, or would be likely to result, because the\n\nChapter 4  Medical devices",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41me"
      },
      "cml:asserts": [
