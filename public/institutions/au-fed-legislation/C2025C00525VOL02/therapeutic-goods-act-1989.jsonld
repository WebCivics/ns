    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54ab",
      "@type": "cml:Concept",
      "skos:prefLabel": "54AB Criminal offence for damaging etc. documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54ab"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.353",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person damages, destroys, alters, conceals or falsifies a\ndocument; and\n(b) the document is created, retained or issued for the purposes\nof this Act, or for purposes that include the purposes of this\nAct.\nPenalty: 7 years imprisonment or 2,000 penalty units, or both.\nNote:\nFor the liability of an executive officer of a body corporate, see\nsections 54B and 54BA.\n(2) Strict liability applies to paragraph (1)(b).\nNote:\nFor strict liability, see section 6.1 of the Criminal Code.",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person damages, destroys, alters, conceals or falsifies a\ndocument; and\n(b) the document is created, retained or issued for the purposes\nof this Act, or for purposes that include the purposes of this\nAct.\nPenalty: 7 years imprisonment or 2,000 penalty units, or both.\nNote:\nFor the liability of an executive officer of a body corporate, see\nsections 54B and 54BA.\n(2) Strict liability applies to paragraph (1)(b).\nNote:\nFor strict liability, see section 6.1 of the Criminal Code.",
      "cml:hasPart": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54ab-ss-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54ab-ss-2"
        }
      ],
      "cml:integrityHash": "6654ce5329902a04c0a1eb4047ea4fbb0e9294ac0b9f25a7ee39d520470c3f98"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54ab",
      "@type": "cof:Section",
      "cof:title": "54AB Criminal offence for damaging etc. documents",
      "values:kind": "section",
      "cof:pageNumber": 353,
      "values:originalText": "(1) A person commits an offence if:\n(a) the person damages, destroys, alters, conceals or falsifies a\ndocument; and\n(b) the document is created, retained or issued for the purposes\nof this Act, or for purposes that include the purposes of this\nAct.\nPenalty: 7 years imprisonment or 2,000 penalty units, or both.\nNote:\nFor the liability of an executive officer of a body corporate, see\nsections 54B and 54BA.\n(2) Strict liability applies to paragraph (1)(b).\nNote:\nFor strict liability, see section 6.1 of the Criminal Code."
    },
