    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bg-ss-4",
      "@type": "cof:Section",
      "cof:title": "41BG(4) Manufacturers of medical devices",
      "values:kind": "subsection",
