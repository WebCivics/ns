    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ev",
      "@type": "cml:Concept",
      "skos:prefLabel": "41EV Publication of revocation etc. of conformity assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ev"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.64",
      "values:originalText": "certificates\nThe Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after revoking a\nconformity assessment certificate, or varying a conformity\nassessment certificate under subsection 41EU(2), a notice setting\nout particulars of the revocation or variation.\n\nMedical devices  Chapter 4\nConformity assessment certificates  Part 4-4\nRevocation of conformity assessment certificates  Division 4\nSection 41EW\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "certificates\nThe Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after revoking a\nconformity assessment certificate, or varying a conformity\nassessment certificate under subsection 41EU(2), a notice setting\nout particulars of the revocation or variation.\n\nMedical devices  Chapter 4\nConformity assessment certificates  Part 4-4\nRevocation of conformity assessment certificates  Division 4\nSection 41EW\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ev-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ev-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a9e85fa95e8e0d4c8a85e0d8d9c06c1303004da65061cfec80492023c9083d24",
      "skos:note": "Publish notice of revocation or variation of conformity assessment certificate.",
      "dc:description": "Notice setting out particulars of the revocation or variation."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ev",
      "@type": "cof:Section",
      "cof:title": "41EV Publication of revocation etc. of conformity assessment",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "certificates\nThe Secretary must cause to be published in the Gazette or on the\nDepartment’s website, as soon as practicable after revoking a\nconformity assessment certificate, or varying a conformity\nassessment certificate under subsection 41EU(2), a notice setting\nout particulars of the revocation or variation.\n\nMedical devices  Chapter 4\nConformity assessment certificates  Part 4-4\nRevocation of conformity assessment certificates  Division 4\nSection 41EW\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ev-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
