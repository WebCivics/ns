    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41eq",
      "@type": "cml:Concept",
      "skos:prefLabel": "41EQ Powers of revocation of conformity assessment certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41eq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
