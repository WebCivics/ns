    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41er",
      "@type": "cml:Concept",
      "skos:prefLabel": "41ER Automatic revocation of conformity assessment certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41er"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.61",
      "values:originalText": "The Secretary must, by written notice given to the person in\nrelation to whom a conformity assessment certificate is issued,\nrevoke the certificate if:\n(a) the certificate has been suspended under section 41EM; and\n(b) the period applying to the suspension under\nsubsection 41EM(3) or 41EO(3) (as the case requires)\nexpires before the suspension is revoked under section 41EP.",
      "skos:definition": "The Secretary must, by written notice given to the person in\nrelation to whom a conformity assessment certificate is issued,\nrevoke the certificate if:\n(a) the certificate has been suspended under section 41EM; and\n(b) the period applying to the suspension under\nsubsection 41EM(3) or 41EO(3) (as the case requires)\nexpires before the suspension is revoked under section 41EP.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41er-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41er-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d388086aaf85dd8df60999f1ea4b03200759d1416fb35dbb2a831d90eec7878d",
      "skos:note": "Revocation of conformity assessment certificates upon expiration of suspension period"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41er",
      "@type": "cof:Section",
      "cof:title": "41ER Automatic revocation of conformity assessment certificates",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "The Secretary must, by written notice given to the person in\nrelation to whom a conformity assessment certificate is issued,\nrevoke the certificate if:\n(a) the certificate has been suspended under section 41EM; and\n(b) the period applying to the suspension under\nsubsection 41EM(3) or 41EO(3) (as the case requires)\nexpires before the suspension is revoked under section 41EP."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41er-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41er"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41er-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits revocation without notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
