    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bi-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "41BI(1) Meaning of non-application of conformity assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bi-ss-1"
      },
      "cml:curationStatus": {
