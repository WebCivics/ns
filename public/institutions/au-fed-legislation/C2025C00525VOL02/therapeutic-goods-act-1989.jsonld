    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gr",
      "@type": "cml:Concept",
      "skos:prefLabel": "41GR What this Part is about",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.108",
      "values:originalText": "The Minister may exempt certain medical devices from various\nprovisions of this Chapter so that the devices may be stockpiled to\ndeal with possible future emergencies or made available urgently\nto deal with actual emergencies.\nNote 1:\nThere are offences and civil penalty provisions related to the making\nof exemptions under this Part: see Division 3A of Part 4-11.\nNote 2:\nSome of the other provisions of this Act about medical devices\nexempt under this Part are:\n(a)\nsection 41JCA (providing information to the Secretary); and\n(b)\nsection 41KA (public notification and recall of medical devices);\nand\n(c)\nsection 46A (search of premises).",
      "skos:definition": "The Minister may exempt certain medical devices from various\nprovisions of this Chapter so that the devices may be stockpiled to\ndeal with possible future emergencies or made available urgently\nto deal with actual emergencies.\nNote 1:\nThere are offences and civil penalty provisions related to the making\nof exemptions under this Part: see Division 3A of Part 4-11.\nNote 2:\nSome of the other provisions of this Act about medical devices\nexempt under this Part are:\n(a)\nsection 41JCA (providing information to the Secretary); and\n(b)\nsection 41KA (public notification and recall of medical devices);\nand\n(c)\nsection 46A (search of premises).",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gr-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gr-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gr-logic-alleninterval-2"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gr-logic-ltl-3"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gr-logic-deontic-4"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41gr-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "eea092c90008fb9a07610d549021ba93cc906c12803cefde1bc9505ef67ad928",
      "skos:note": "Exemption of medical devices from certain provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41gr",
      "@type": "cof:Section",
      "cof:title": "41GR What this Part is about",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "The Minister may exempt certain medical devices from various\nprovisions of this Chapter so that the devices may be stockpiled to\ndeal with possible future emergencies or made available urgently\nto deal with actual emergencies.\nNote 1:\nThere are offences and civil penalty provisions related to the making\nof exemptions under this Part: see Division 3A of Part 4-11.\nNote 2:\nSome of the other provisions of this Act about medical devices\nexempt under this Part are:\n(a)\nsection 41JCA (providing information to the Secretary); and\n(b)\nsection 41KA (public notification and recall of medical devices);\nand\n(c)\nsection 46A (search of premises)."
    },
    {
