    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41rb-ss-3",
      "@type": "cof:Section",
      "cof:title": "41RB(3) Application to Secretary for consent to manufacture, supply",
      "values:kind": "subsection",
      "cof:pageNumber": 222,
      "values:originalText": "(3) The Secretary may, by notice in writing given to the applicant,\nrequire the applicant to give to the Secretary, within such\nreasonable time as is specified in the notice, such further\ninformation concerning the application as is specified in the notice.\nApplications or information may be given electronically"
    },
