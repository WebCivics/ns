      "cml:premiseText": "(a) exempting a person from liability to pay annual registration\ncharge, annual listing charge or annual charge for inclusion\nin the Register for a financial year (the current year) if the\nperson’s turnover of the therapeutic goods concerned for the\nfinancial year specified in the regulations is of low value;"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-44a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "44A(2) Exemptions from liability to pay charges",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-44a-ss-2"
      },
