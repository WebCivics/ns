      "skos:note": "A person may make an application to the Secretary for a kind of medical device to be included in the Register."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fc-ss-1",
      "@type": "cof:Section",
      "cof:title": "41FC(1) Making an application",
      "values:kind": "subsection",
      "cof:pageNumber": 73,
      "values:originalText": "(1) A person may make an application to the Secretary for a kind of\nmedical device to be included in the Register."
    },
