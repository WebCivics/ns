      "cml:premiseText": "(c) the Secretary is satisfied that it is in the public interest to\nissue a notice under this subsection;",
      "cml:conclusionText": "the warning notice is issued during the period of non-compliance"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42dy-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
