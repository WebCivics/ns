      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.82",
      "values:originalText": "(2) This section does not, by implication, limit the matters to which the\nSecretary may have regard.",
      "skos:definition": "(2) This section does not, by implication, limit the matters to which the\nSecretary may have regard.",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41fi"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-2-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41fi-ss-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "8c8370c270ac917b9dbd6f61141f779e9ccbcc4a19b7257710f2e4a31e7e1533",
      "skos:note": "The Secretary must decide to include a device in the Register. The Secretary may have regard for matters beyond the scope of this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41fi-ss-2",
      "@type": "cof:Section",
