        }
      ],
      "cml:integrityHash": "91af642bbede534f44c2a43c053e7c36a71f59dd70c91f53a91c25b266290c61",
      "skos:note": "Must provide access to document for inspection and copying.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-45ag-ss-4",
      "@type": "cof:Section",
      "cof:title": "45AG(4) Secretary may retain documents",
      "values:kind": "subsection",
