    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41et-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41ET(2) Revocation of conformity assessment certificates after notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41et-ss-2"
      },
      "cml:curationStatus": {
