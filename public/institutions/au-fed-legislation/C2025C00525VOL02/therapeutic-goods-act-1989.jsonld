    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ea",
      "@type": "cml:Concept",
      "skos:prefLabel": "42EA Civil penalty relating to dealing with counterfeit therapeutic",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42ea"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.271",
      "values:originalText": "goods\nA person contravenes this section if:\n(a) the person does any of the following:\n(i) manufactures goods in Australia;\n(ii) supplies goods in Australia;\n(iii) imports goods into Australia;\n(iv) exports goods from Australia; and\n(b) the goods are therapeutic goods; and\n(c) the goods are counterfeit.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "skos:definition": "goods\nA person contravenes this section if:\n(a) the person does any of the following:\n(i) manufactures goods in Australia;\n(ii) supplies goods in Australia;\n(iii) imports goods into Australia;\n(iv) exports goods from Australia; and\n(b) the goods are therapeutic goods; and\n(c) the goods are counterfeit.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42ea-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-42ea-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "42a2297340de55f789ad2a3290d7c955bf4f90b5fd9fef4e81f135832377a6fe",
      "skos:note": "Dealing with counterfeit therapeutic goods is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42ea",
      "@type": "cof:Section",
      "cof:title": "42EA Civil penalty relating to dealing with counterfeit therapeutic",
      "values:kind": "section",
      "cof:pageNumber": 271,
      "values:originalText": "goods\nA person contravenes this section if:\n(a) the person does any of the following:\n(i) manufactures goods in Australia;\n(ii) supplies goods in Australia;\n(iii) imports goods into Australia;\n(iv) exports goods from Australia; and\n(b) the goods are therapeutic goods; and\n(c) the goods are counterfeit.\nMaximum civil penalty:\n(a) for an individual—5,000 penalty units; and\n(b) for a body corporate—50,000 penalty units."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42ea-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-42ea"
      },
      "values:deonticStatus": {
