      ],
      "cml:integrityHash": "7f98bca1fec2c45eb979dafe67f6e595443e88d4d98c681e128437814c703285",
      "skos:note": "The Secretary may require information or documents from a person related to medical devices.",
      "dc:description": "Yes"
