    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54a",
      "@type": "cml:Concept",
      "skos:prefLabel": "54A Time for bringing prosecutions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.353",
      "values:originalText": "A prosecution for an offence against this Act may be commenced\nat any time within 3 years after the commission of the offence.\n\nChapter 7  Miscellaneous\n\nSection 54B\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "skos:definition": "A prosecution for an offence against this Act may be commenced\nat any time within 3 years after the commission of the offence.\n\nChapter 7  Miscellaneous\n\nSection 54B\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54a-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-54a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5b54f99cfc86c1753e0a2f1a5848c870012ddc8e33b4437722c0edacecf05f30",
      "skos:note": "Prosecution can be commenced within 3 years after commission of the offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-54a",
      "@type": "cof:Section",
      "cof:title": "54A Time for bringing prosecutions",
      "values:kind": "section",
      "cof:pageNumber": 353,
      "values:originalText": "A prosecution for an offence against this Act may be commenced\nat any time within 3 years after the commission of the offence.\n\nChapter 7  Miscellaneous\n\nSection 54B\nTherapeutic Goods Act 1989\nCompilation date: 05/09/2025"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-54a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
