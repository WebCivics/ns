    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41ka",
      "@type": "cml:Concept",
      "skos:prefLabel": "41KA Public notification, and recall, of medical devices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ka"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.145",
      "values:originalText": "(1) The Secretary may, in writing, impose requirements, relating to a\nkind of medical device, on a person if:\n(a) any of the circumstances referred to in the second column of\nan item in the following table occur in relation to the kind of\ndevice; and\n(b) the person is referred to in the third column of that item of\nthe table.\nCircumstances in which requirements may be imposed\nItem\nCircumstance relating to a kind of medical\ndevice\nPerson subject to\nrequirements\n1.\nIt is supplied while it is included in the\nRegister, but the Secretary is satisfied that\nmedical devices of that kind do not comply\nwith the essential principles\nThe person in relation to\nwhom it is included in the\nRegister\n2.\nIt is supplied while it is included in the\nRegister, but the Secretary is satisfied that the\nconformity assessment procedures have not\nbeen applied to medical devices of that kind\nand that requirements, comparable to those\nprocedures, have not been applied to medical\ndevices of that kind\nThe person in relation to\nwhom it is included in the\nRegister\n\nChapter 4  Medical devices",
      "skos:definition": "(1) The Secretary may, in writing, impose requirements, relating to a\nkind of medical device, on a person if:\n(a) any of the circumstances referred to in the second column of\nan item in the following table occur in relation to the kind of\ndevice; and\n(b) the person is referred to in the third column of that item of\nthe table.\nCircumstances in which requirements may be imposed\nItem\nCircumstance relating to a kind of medical\ndevice\nPerson subject to\nrequirements\n1.\nIt is supplied while it is included in the\nRegister, but the Secretary is satisfied that\nmedical devices of that kind do not comply\nwith the essential principles\nThe person in relation to\nwhom it is included in the\nRegister\n2.\nIt is supplied while it is included in the\nRegister, but the Secretary is satisfied that the\nconformity assessment procedures have not\nbeen applied to medical devices of that kind\nand that requirements, comparable to those\nprocedures, have not been applied to medical\ndevices of that kind\nThe person in relation to\nwhom it is included in the\nRegister\n\nChapter 4  Medical devices",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ka-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ka-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41ka-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "7edb539aa22c79cd007af0f1ec97151eb1e92adb339f5369a50aee9eca6848fb",
      "skos:note": "The Secretary may impose requirements on a person if certain circumstances occur."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ka",
      "@type": "cof:Section",
      "cof:title": "41KA Public notification, and recall, of medical devices",
      "values:kind": "section",
      "cof:pageNumber": 145,
      "values:originalText": "(1) The Secretary may, in writing, impose requirements, relating to a\nkind of medical device, on a person if:\n(a) any of the circumstances referred to in the second column of\nan item in the following table occur in relation to the kind of\ndevice; and\n(b) the person is referred to in the third column of that item of\nthe table.\nCircumstances in which requirements may be imposed\nItem\nCircumstance relating to a kind of medical\ndevice\nPerson subject to\nrequirements\n1.\nIt is supplied while it is included in the\nRegister, but the Secretary is satisfied that\nmedical devices of that kind do not comply\nwith the essential principles\nThe person in relation to\nwhom it is included in the\nRegister\n2.\nIt is supplied while it is included in the\nRegister, but the Secretary is satisfied that the\nconformity assessment procedures have not\nbeen applied to medical devices of that kind\nand that requirements, comparable to those\nprocedures, have not been applied to medical\ndevices of that kind\nThe person in relation to\nwhom it is included in the\nRegister\n\nChapter 4  Medical devices"
    },
    {
