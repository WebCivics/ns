    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41bk",
      "@type": "cml:Concept",
      "skos:prefLabel": "41BK Application of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41bk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.31",
      "values:originalText": "Chapter 2 of the Criminal Code applies to all offences against this\nChapter.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nChapter 4  Medical devices",
      "skos:definition": "Chapter 2 of the Criminal Code applies to all offences against this\nChapter.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nChapter 4  Medical devices",
      "cml:asserts": [
