      "cml:integrityHash": "bc5ca877ed0a635bb16c069a9d0a27f9280d05bee921c8eb4ee5ba37aabc4c54",
      "skos:note": "The Secretary must ensure that each authorised person is issued with an identity card."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-52-ss-1",
      "@type": "cof:Section",
      "cof:title": "52(1) Identity cards",
      "values:kind": "subsection",
      "cof:pageNumber": 335,
      "values:originalText": "(1) The Secretary is to ensure that each authorised person is issued\nwith an identity card that incorporates a recent photograph of the\nperson."
    },
