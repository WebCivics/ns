      }
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41mb-ss-2-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Burden of Proof",
      "cml:logicSummary": "Defendant must prove matters in section.",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
