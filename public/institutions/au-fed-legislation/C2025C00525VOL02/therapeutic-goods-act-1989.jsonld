      "cml:premiseText": "There are one or more absolute prohibitions in force for the purposes of subsection 9K(1) or (3).",
      "cml:conclusionText": "Imports, exports, manufacture, and supplies would contravene one or more of those prohibitions."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41gk-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
