          "@id": "concept:therapeutic-goods-act-1989-sec-41hc-ss-6b-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "f8aff130f6ec9d4a93d62f804116cd2a51103c75b6df027e0083bcdc55c87cb3",
      "skos:note": "Notify supply within 28 days after supplying medical device.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41hc-ss-6b",
      "@type": "cof:Section",
      "cof:title": "41HC(6B) Authorities for health practitioners",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(6B) If:\n(a) a person is authorised, by subsection (6) rules, to supply a\nspecified kind of medical device; and\n(b) the person supplies a medical device of that kind in\naccordance with those rules;\nthe person must:\n(c) notify the supply to the Secretary; and\n(d) do so within 28 days after the supply."
