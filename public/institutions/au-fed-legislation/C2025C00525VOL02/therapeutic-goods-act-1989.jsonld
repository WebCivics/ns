    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "41QB(6) Offences and civil penalty provision—supplying vaping goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qb-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.206",
      "values:originalText": "(6) This subsection applies in relation to the supply of the vaping\ngoods by the person if:\n(a) the vaping goods are therapeutic goods that are entered on\nthe Register; or\n(b) both of the following apply:\n(i) the vaping goods are therapeutic goods that are exempt\ngoods under regulations made for the purposes of\nsubsection 18(1) or an exempt device under regulations\nmade for the purposes of subsection 41HA(1), and the\nsponsor has given the Secretary a notice in compliance\nwith the exemption;\n\nChapter 4A  Vaping goods",
      "skos:definition": "(6) This subsection applies in relation to the supply of the vaping\ngoods by the person if:\n(a) the vaping goods are therapeutic goods that are entered on\nthe Register; or\n(b) both of the following apply:\n(i) the vaping goods are therapeutic goods that are exempt\ngoods under regulations made for the purposes of\nsubsection 18(1) or an exempt device under regulations\nmade for the purposes of subsection 41HA(1), and the\nsponsor has given the Secretary a notice in compliance\nwith the exemption;\n\nChapter 4A  Vaping goods",
      "values:partOf": {
        "@id": "concept:therapeutic-goods-act-1989-sec-41qb"
      },
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-6-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2a82d74807b10840745e3337be654403282da2a52825e80fba16588578860f4a",
      "skos:note": "Supply of vaping goods without proper exemption is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41qb-ss-6",
      "@type": "cof:Section",
      "cof:title": "41QB(6) Offences and civil penalty provision—supplying vaping goods",
      "values:kind": "subsection",
      "cof:pageNumber": 206,
      "values:originalText": "(6) This subsection applies in relation to the supply of the vaping\ngoods by the person if:\n(a) the vaping goods are therapeutic goods that are entered on\nthe Register; or\n(b) both of the following apply:\n(i) the vaping goods are therapeutic goods that are exempt\ngoods under regulations made for the purposes of\nsubsection 18(1) or an exempt device under regulations\nmade for the purposes of subsection 41HA(1), and the\nsponsor has given the Secretary a notice in compliance\nwith the exemption;\n\nChapter 4A  Vaping goods"
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-41qb-ss-6-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
