    {
      "@id": "concept:therapeutic-goods-act-1989-sec-53",
      "@type": "cml:Concept",
      "skos:prefLabel": "53 Retention of material on withdrawal of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-53"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "therapeutic-goods-act-1989.pdf"
      },
      "dc:source": "therapeutic-goods-act-1989.pdf, p.348",
      "values:originalText": "Where a person withdraws an application for:\n(a) registration; or\n(b) listing; or\n(baa) a recommendation by the Secretary that the Minister vary a\nsection 26BB determination; or\n(bab) a recommendation by the Secretary that the Minister vary a\ndetermination under section 26BF; or\n(ba) inclusion of a biological in the Register; or\n(c) a conformity assessment certificate; or\n(d) inclusion of a kind of medical device in the Register; or\n(e) a licence;\nthe Department may retain the application and any material\nsubmitted in connection with the application.",
      "skos:definition": "Where a person withdraws an application for:\n(a) registration; or\n(b) listing; or\n(baa) a recommendation by the Secretary that the Minister vary a\nsection 26BB determination; or\n(bab) a recommendation by the Secretary that the Minister vary a\ndetermination under section 26BF; or\n(ba) inclusion of a biological in the Register; or\n(c) a conformity assessment certificate; or\n(d) inclusion of a kind of medical device in the Register; or\n(e) a licence;\nthe Department may retain the application and any material\nsubmitted in connection with the application.",
      "cml:asserts": [
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-53-norm"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-53-logic-deontic-1"
        },
        {
          "@id": "concept:therapeutic-goods-act-1989-sec-53-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "f3883da62b564cb998ecafe6e27cced3096316e96001ac17fd401e9443b7dcde",
      "skos:note": "Department may retain application and material upon withdrawal."
    },
    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-53",
      "@type": "cof:Section",
      "cof:title": "53 Retention of material on withdrawal of application",
      "values:kind": "section",
      "cof:pageNumber": 348,
      "values:originalText": "Where a person withdraws an application for:\n(a) registration; or\n(b) listing; or\n(baa) a recommendation by the Secretary that the Minister vary a\nsection 26BB determination; or\n(bab) a recommendation by the Secretary that the Minister vary a\ndetermination under section 26BF; or\n(ba) inclusion of a biological in the Register; or\n(c) a conformity assessment certificate; or\n(d) inclusion of a kind of medical device in the Register; or\n(e) a licence;\nthe Department may retain the application and any material\nsubmitted in connection with the application."
    },
    {
      "@id": "concept:therapeutic-goods-act-1989-sec-53-norm",
      "@type": "values:Prohibition",
