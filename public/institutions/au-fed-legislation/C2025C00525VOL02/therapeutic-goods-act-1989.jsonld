    {
      "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-41ep-ss-1",
      "@type": "cof:Section",
      "cof:title": "41EP(1) Revocation of suspension",
      "values:kind": "subsection",
