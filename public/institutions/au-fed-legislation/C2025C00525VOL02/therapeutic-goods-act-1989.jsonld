    {
      "@id": "concept:therapeutic-goods-act-1989-sec-42v-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "42V(4) Recall of therapeutic goods because of actual or potential",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/therapeutic-goods-act-1989#sec-42v-ss-4"
      },
