      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "The Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.8000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has permission to apply for superannuation order",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasPermission",
      "cml:premiseText": "The Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, everywhere that the offence is a corruption offence, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Everywhere that the offence is a corruption offence",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "The provision applies when the Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence."
    },
