    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An AFP appointee commits an offence if the AFP appointee: (a) refuses or fails to comply with a direction given under subsection 40VE(1) or 40VG(2);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of refusal to comply with direction.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) refuses or fails to comply with a direction given under subsection 40VE(1) or 40VG(2);"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An AFP appointee commits an offence if the AFP appointee: (b) refuses or fails to be sworn or make an affirmation, when required to do so under subsection 40VG(2);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of refusal to be sworn/affirmed.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(b) refuses or fails to be sworn or make an affirmation, when required to do so under subsection 40VG(2);"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An AFP appointee commits an offence if the AFP appointee: (c) gives information or makes a statement to the investigator knowing that it is false or misleading in a material particular.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of giving false information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(c) gives information or makes a statement to the investigator knowing that it is false or misleading in a material particular."
    },
