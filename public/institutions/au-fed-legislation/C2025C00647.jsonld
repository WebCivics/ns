    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-federal-police-act-1979.pdf, p.137",
      "skos:note": "Refusal to comply with direction or be sworn/affirmed is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "40VH(1) Offences"
      },
      "wasDerivedFrom": "australian-federal-police-act-1979.pdf",
      "asserts": [
        "concept:australian-federal-police-act-1979-sec-40vh-ss-1-norm",
        "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-1",
        "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-2",
