    {
      "@id": "concept:australian-federal-police-act-1979-sec-14a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval of the arrest is within the commission of the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval of the arrest within the commission of the offence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "the person has just committed, or is committing, the offence;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14a-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use of artificial intelligence is with the arrest process.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Use of artificial intelligence in the arrest process.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "With",
      "cml:premiseText": "the protective service officer may, without warrant, arrest a person..."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to arrest under certain conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to arrest under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:premiseText": "The protective service officer may, without warrant, arrest a person..."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14a-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The diffusion of information about the arrest is through the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of information about the arrest through the person.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Through",
      "cml:premiseText": "the arrest of the person is necessary for the purpose of ensuring the appearance of the person before a court of competent jurisdiction for the offence;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval of the prevention of further offences is until the commission of the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval of the prevention of further offences.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "the arrest of the person is necessary for the purpose of preventing the continuation of, or a repetition of, the offence;"
    },
