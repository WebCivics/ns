      },
      "cml:integrityHash": "878b2ddedf10f663d25885673ca83769f91ef6223b85b472272aa328427e9639",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-federal-police-act-1979#sec-40vh-ss-1",
