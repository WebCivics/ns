concept:australian-federal-police-act-1979-sec-47-ss-3 cml:asserts concept:australian-federal-police-act-1979-sec-47-ss-3-logic-deontic-1 .
concept:australian-federal-police-act-1979-sec-47-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "hasObligation" ;
    cml:logicSummary "Entails an obligation to provide payment upon cessation of membership" ;
    cml:premiseText "(1) applies to a person" ;
    cml:conclusionText "the person is entitled, on the day on which he or she ceases to be a member of the scheme, to payment of an amount worked out using the formula" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-act-1979-sec-47-ss-3 cml:asserts concept:australian-federal-police-act-1979-sec-47-ss-3-logic-alleninterval-2 .
concept:australian-federal-police-act-1979-sec-47-ss-3-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "The entitlement occurs during the period of membership" ;
    cml:premiseText "(a) who: (i) was an AFP employee at the time the relevant corruption offence was committed but was not such an employee when charged with that offence; or (ii) was an old law member or staff member at the time the relevant corruption offence was committed but was not such a member or an AFP employee when charged with that offence" ;
    cml:conclusionText "(b) who would, but for that subsection, have been entitled to payment of benefits under the relevant superannuation scheme on or after the day on which the superannuation order takes effect" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

