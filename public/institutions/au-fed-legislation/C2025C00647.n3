    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must ensure action is taken" ;
    cml:premiseText "(1) This section applies if: (a) a person gives information under section 40SA that raises an AFP practices issue; or (b) an AFP practices issue is: (i) brought, under section 40TK, to the attention of an AFP appointee; or (ii) identified, under section 40TW, in a report prepared under section 40TU; as a result of an AFP conduct issue being dealt with under this Part." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
