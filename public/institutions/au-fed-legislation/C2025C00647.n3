concept:australian-federal-police-act-1979-sec-47-ss-3-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "until" ;
    cml:logicSummary "The entitlement ends upon cessation of membership" ;
    cml:premiseText "(b) who would, but for that subsection, have been entitled to payment of benefits under the relevant superannuation scheme on or after the day on which the superannuation order takes effect" ;
    cml:conclusionText "the person is entitled, on the day on which he or she ceases to be a member of the scheme, to payment of an amount worked out using the formula" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-act-1979-sec-47-ss-3 cml:asserts concept:australian-federal-police-act-1979-sec-47-ss-3-logic-diffusion-4 .
concept:australian-federal-police-act-1979-sec-47-ss-3-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "if-then" ;
    cml:logicSummary "The entitlement is conditional upon meeting certain conditions" ;
    cml:premiseText "(a) who: (i) was an AFP employee at the time the relevant corruption offence was committed but was not such an employee when charged with that offence; or (ii) was an old law member or staff member at the time the relevant corruption offence was committed but was not such a member or an AFP employee when charged with that offence" ;
    cml:conclusionText "(b) who would, but for that subsection, have been entitled to payment of benefits under the relevant superannuation scheme on or after the day on which the superannuation order takes effect" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-act-1979-sec-47-ss-3 cml:asserts concept:australian-federal-police-act-1979-sec-47-ss-3-logic-cogai-5 .
