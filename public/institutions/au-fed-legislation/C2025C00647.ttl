<https://ns.webcivics.net/concept/australian-federal-police-act-1979-sec-4aa-ss-1-logic-linearlogic-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/LinearLogic>;
    <https://ns.webcivics.net/cml/operator> "and";
    <https://ns.webcivics.net/cml/logicSummary> "States that both conditions must be met for a State offence to have a federal aspect.";
    <https://ns.webcivics.net/cml/premiseText> "(a) and (b)";
    <https://ns.webcivics.net/cml/conclusionText> "...both conditions must be met for a State offence to have a federal aspect.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::linear";
