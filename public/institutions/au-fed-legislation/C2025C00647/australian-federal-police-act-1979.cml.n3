concept:australian-federal-police-act-1979-sec-42c a cml:Concept ;
    skos:prefLabel "42C Conviction and quashing of conviction"@en ;
    cml:realizedBy doc:sec-42c ;
    values:originalText "(1) For the purposes of this Part, a person is to be taken to be convicted of an offence if: (a) the person is convicted of the offence, whether summarily or on indictment; or (b) the person absconds in connection with the offence." ;
    skos:definition "(1) For the purposes of this Part, a person is to be taken to be convicted of an offence if: (a) the person is convicted of the offence, whether summarily or on indictment; or (b) the person absconds in connection with the offence."@en ;
    cml:integrityHash "e4b81082dfeed72c1a530a258090aad5bb2dc716b3e3f6ab16332032db6356b9" ;
    cof:pageNumber "151"^^xsd:integer ;
    skos:note "A person is taken to be convicted of an offence if they are convicted or abscond in connection with the offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.151" ;
