doc:sec-40rf-ss-1 a cof:Section ;
    cof:title "40RF(1) Assignment of members, and special members, to unit" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commissioner may, in writing, assign a member, or special member, of the Australian Federal Police to the unit constituted under section 40RD." ;
    cof:pageNumber "98"^^xsd:integer .

