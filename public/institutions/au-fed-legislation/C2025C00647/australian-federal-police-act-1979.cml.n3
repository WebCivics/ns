concept:australian-federal-police-act-1979-sec-40rf-ss-7 a cml:Concept ;
    skos:prefLabel "40RF(7) Assignment of members, and special members, to unit"@en ;
    cml:realizedBy doc:sec-40rf-ss-7 ;
    values:originalText "(7) If: (a) a member, or special member, of the Australian Federal Police is assigned to the unit constituted under section 40RD; and (b) the member, or special member, ceases to serve in the unit; and (c) the period of 12 months from the time when the member, or special member, ceased to serve in the unit ends; the member, or special member, may again be assigned to the unit." ;
    skos:definition "(7) If: (a) a member, or special member, of the Australian Federal Police is assigned to the unit constituted under section 40RD; and (b) the member, or special member, ceases to serve in the unit; and (c) the period of 12 months from the time when the member, or special member, ceased to serve in the unit ends; the member, or special member, may again be assigned to the unit."@en ;
    cml:integrityHash "6af78ca5d97da166b2cc3486c98cbaeb71323bd646c0d70d58c27235f3f41bba" ;
    values:partOf concept:australian-federal-police-act-1979-sec-40rf ;
    cof:pageNumber "98"^^xsd:integer ;
    skos:note "Reassignment of members to unit after cessation of service" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
