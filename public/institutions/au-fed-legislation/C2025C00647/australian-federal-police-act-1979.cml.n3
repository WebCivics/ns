concept:australian-federal-police-act-1979-sec-51-ss-1 a cml:Concept ;
    skos:prefLabel "51(1) Person ceases to be an AFP employee: persons charged with"@en ;
    cml:realizedBy doc:sec-51-ss-1 ;
    values:originalText "(1) Where an appropriate court makes a recovery order against a person, it may, on application by the DPP, if it thinks that particular property is subject to the effective control of the person, make an order declaring that the whole, or a specified part, of that property is available to satisfy the recovery order." ;
    skos:definition "(1) Where an appropriate court makes a recovery order against a person, it may, on application by the DPP, if it thinks that particular property is subject to the effective control of the person, make an order declaring that the whole, or a specified part, of that property is available to satisfy the recovery order."@en ;
    cml:integrityHash "fc7351de02edd16fcfbb6a78be93b991470d7e2a7752679d34d170dd74fbfc08" ;
    values:partOf concept:australian-federal-police-act-1979-sec-51 ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Property subject to effective control of a person may be declared available for recovery order satisfaction. Suspension of superannuation rights upon charging with corruption offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.178" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-51-ss-1-norm .
