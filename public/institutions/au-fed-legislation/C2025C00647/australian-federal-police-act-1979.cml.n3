doc:sec-40ra a cof:Section ;
    cof:title "40RA Object of this Part" ;
    values:kind "section" ;
    values:originalText "The object of this Part is to establish the procedures by which: (a) AFP conduct issues and AFP practices issues; and (b) other issues related to the Australian Federal Police; may be raised and dealt with." ;
    cof:pageNumber "95"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-40rb a cml:Concept ;
    skos:prefLabel "40RB Simplified outline of this Part"@en ;
    cml:realizedBy doc:sec-40rb ;
    values:originalText "(1) This Part deals with the handling of: (a) AFP conduct issues and AFP practices issues; and (b) other issues related to the Australian Federal Police. (2) These issues may be: (a) issues that are raised by information given to the Australian Federal Police (see section 40SA); or (b) issues that the Commissioner decides, on his or her own initiative, are to be dealt with under this Part (see section 40SD); or (c) issues that are referred to the Australian Federal Police by the National Anti-Corruption Commissioner under the National Anti-Corruption Commission Act 2022 or by the Ombudsman under the Ombudsman Act 1976; or (d) issues that the Minister directs are to be inquired into under" ;
    skos:definition "(1) This Part deals with the handling of: (a) AFP conduct issues and AFP practices issues; and (b) other issues related to the Australian Federal Police. (2) These issues may be: (a) issues that are raised by information given to the Australian Federal Police (see section 40SA); or (b) issues that the Commissioner decides, on his or her own initiative, are to be dealt with under this Part (see section 40SD); or (c) issues that are referred to the Australian Federal Police by the National Anti-Corruption Commissioner under the National Anti-Corruption Commission Act 2022 or by the Ombudsman under the Ombudsman Act 1976; or (d) issues that the Minister directs are to be inquired into under"@en ;
    cml:integrityHash "babf12e6601bc9bf2e3b6ce2b405dfe086aebbf2727939a76b11ff93e18ec4d9" ;
    cof:pageNumber "95"^^xsd:integer ;
