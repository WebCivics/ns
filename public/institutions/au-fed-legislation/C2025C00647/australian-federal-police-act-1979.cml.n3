concept:australian-federal-police-act-1979-sec-40eb a cml:Concept ;
    skos:prefLabel "40EB Determination of competency or qualification requirements"@en ;
    cml:realizedBy doc:sec-40eb ;
    values:originalText "The Commissioner may, by written determination, specify either or both of the following for the purposes of section 40EA: (a) competency requirements; (b) qualification requirements." ;
    skos:definition "The Commissioner may, by written determination, specify either or both of the following for the purposes of section 40EA: (a) competency requirements; (b) qualification requirements."@en ;
