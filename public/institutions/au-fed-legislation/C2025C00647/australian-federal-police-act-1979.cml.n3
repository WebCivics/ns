    cml:conclusionText "The definition is updated." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-act-1979-sec-5-ss-1 cml:asserts concept:australian-federal-police-act-1979-sec-5-ss-1-logic-deontic-5 .
