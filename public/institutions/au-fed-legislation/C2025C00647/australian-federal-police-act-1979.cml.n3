concept:australian-federal-police-act-1979-sec-4aa-ss-3 a cml:Concept ;
    skos:prefLabel "4AA(3) State offences that have a federal aspect"@en ;
    cml:realizedBy doc:sec-4aa-ss-3 ;
    values:originalText "(3) A State offence is taken to be covered by paragraph (1)(c) if the conduct constituting the State offence: (a) affects the interests of: (i) the Commonwealth; or" ;
    skos:definition "(3) A State offence is taken to be covered by paragraph (1)(c) if the conduct constituting the State offence: (a) affects the interests of: (i) the Commonwealth; or"@en ;
