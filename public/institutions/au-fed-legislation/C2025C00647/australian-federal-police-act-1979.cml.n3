    skos:prefLabel "24(5) Engagement of AFP employees"@en ;
    cml:realizedBy doc:sec-24-ss-5 ;
    values:originalText "(5) This section does not apply to the engagement of persons overseas to perform duties overseas as employees. Note: Section 69A deals with the engagement of such persons." ;
