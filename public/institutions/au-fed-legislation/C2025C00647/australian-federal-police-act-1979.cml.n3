doc:sec-40tk-ss-1 a cof:Section ;
    cof:title "40TK(1) AFP practices issue identified in course of dealing with AFP" ;
    values:kind "subsection" ;
    values:originalText "(1) This Subdivision applies if: (a) information that is given under section 40SA raises an AFP conduct issue in relation to an AFP appointee; and (b) the issue is a category 3 conduct issue or a corruption issue." ;
    cof:pageNumber "119"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-40tk-ss-2 a cml:Concept ;
    skos:prefLabel "40TK(2) AFP practices issue identified in course of dealing with AFP"@en ;
    cml:realizedBy doc:sec-40tk-ss-2 ;
    values:originalText "(2) This Subdivision also applies if: (a) the Commissioner decides under section 40SD that an AFP conduct issue in relation to an AFP appointee is to be dealt with under this Part; and (b) the issue is a category 3 conduct issue or a corruption issue." ;
    skos:definition "(2) This Subdivision also applies if: (a) the Commissioner decides under section 40SD that an AFP conduct issue in relation to an AFP appointee is to be dealt with under this Part; and (b) the issue is a category 3 conduct issue or a corruption issue."@en ;
    cml:integrityHash "32a18ce9bebc08522dd7b7dde65b367f1b68f700175a0b042d889e6012979f98" ;
    values:partOf concept:australian-federal-police-act-1979-sec-40tk ;
    cof:pageNumber "119"^^xsd:integer ;
    skos:note "Dealing with AFP conduct issue under this Part if Commissioner decides so. Manager must inform AFP appointee of identified issue." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.119" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-40tk-ss-2-norm .
