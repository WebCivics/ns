doc:sec-40tw-ss-1 a cof:Section ;
    cof:title "40TW(1) AFP practices issue identified in course of dealing with AFP" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if: (a) the investigator is satisfied that the information: (i) given under section 40SA in relation to the issue; or (ii) obtained in the course of dealing with the issue; raises an AFP practices issue; and (b) the investigator prepares a report under section 40TU in relation to the investigation." ;
    cof:pageNumber "124"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-40tw-ss-2 a cml:Concept ;
    skos:prefLabel "40TW(2) AFP practices issue identified in course of dealing with AFP"@en ;
    cml:realizedBy doc:sec-40tw-ss-2 ;
    values:originalText "(2) The investigator:   Professional standards and AFP conduct and practices issues  Part V Dealing with AFP conduct or practices issues  Division 3 Section 40TX Australian Federal Police Act 1979 Compilation date: 08/11/2025 (a) must identify the AFP practices issue in the report; and (b) may include in the report such recommendations as the investigator considers appropriate to address the AFP practices issue. Subdivision E—Dealing with AFP practices issues" ;
    skos:definition "(2) The investigator:   Professional standards and AFP conduct and practices issues  Part V Dealing with AFP conduct or practices issues  Division 3 Section 40TX Australian Federal Police Act 1979 Compilation date: 08/11/2025 (a) must identify the AFP practices issue in the report; and (b) may include in the report such recommendations as the investigator considers appropriate to address the AFP practices issue. Subdivision E—Dealing with AFP practices issues"@en ;
    cml:integrityHash "24ae8f2856f74e77d0649a8e72260d2dc2d4041a603a7dbc4e817932542a9c44" ;
    values:partOf concept:australian-federal-police-act-1979-sec-40tw ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Must identify AFP practices issue in report." ;
