doc:sec-49b-ss-4 a cof:Section ;
    cof:title "49B(4) Making of restraining orders" ;
    values:kind "subsection" ;
    values:originalText "(4) A court may make a restraining order against property whether or not there is any risk of the property being disposed of, or otherwise dealt with, in a manner that would defeat the operation of this Part." ;
    cof:pageNumber "166"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-49b-ss-5 a cml:Concept ;
    skos:prefLabel "49B(5) Making of restraining orders"@en ;
    cml:realizedBy doc:sec-49b-ss-5 ;
    values:originalText "(5) Where the application is made in reliance on the proposed charging of the defendant with the offence concerned, the court must not make a restraining order unless satisfied that the defendant will be charged with the offence, or with a related corruption offence, within 48 hours." ;
    skos:definition "(5) Where the application is made in reliance on the proposed charging of the defendant with the offence concerned, the court must not make a restraining order unless satisfied that the defendant will be charged with the offence, or with a related corruption offence, within 48 hours."@en ;
    cml:integrityHash "2c509d229e6bfaa4330bb095fb73227001d935f706861ce3f932993bc5f44a7d" ;
    values:partOf concept:australian-federal-police-act-1979-sec-49b ;
    cof:pageNumber "166"^^xsd:integer ;
    skos:note "Court must not make restraining order unless defendant will be charged within 48 hours." ;
    cml:curationStatus cml:Proposed ;
