concept:australian-federal-police-act-1979-sec-64 a cml:Concept ;
    skos:prefLabel "64 Assault etc."@en ;
    cml:realizedBy doc:sec-64 ;
    values:originalText "The court convicting a person of an offence against section 147.1 or 149.1 of the Criminal Code that relates to a member, special member, protective service officer or special protective service officer may, order the offender to pay such compensation as the court thinks fit for any damage or injury caused by the offender to the uniform, clothing or accoutrements of the member, special member, protective service officer or special protective service officer concerned or for any medical or other expenses incurred in consequence of personal injury sustained by him or her by reason of the offence." ;
    skos:definition "The court convicting a person of an offence against section 147.1 or 149.1 of the Criminal Code that relates to a member, special member, protective service officer or special protective service officer may, order the offender to pay such compensation as the court thinks fit for any damage or injury caused by the offender to the uniform, clothing or accoutrements of the member, special member, protective service officer or special protective service officer concerned or for any medical or other expenses incurred in consequence of personal injury sustained by him or her by reason of the offence."@en ;
    cml:integrityHash "ad62ddebdfc3559246207e54fef7574d699b441c3735d5aa9df393546f58e347" ;
    cof:pageNumber "187"^^xsd:integer ;
    skos:note "Offender must pay compensation for damage to uniform or accoutrements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.187" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-64-norm .
