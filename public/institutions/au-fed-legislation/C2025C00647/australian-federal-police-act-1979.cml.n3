concept:australian-federal-police-act-1979-sec-51-ss-5 a cml:Concept ;
    skos:prefLabel "51(5) Person ceases to be an AFP employee: persons charged with"@en ;
    cml:realizedBy doc:sec-51-ss-5 ;
    values:originalText "(5) To avoid doubt, for the purposes of paragraph (1)(b), a person does not cease to be an AFP employee in circumstances where the person completes a period of engagement under section 24 (the initial period) and is re-engaged under that section for a further period starting immediately after the end of the initial period. 53A  Court may lift corporate veil etc." ;
    skos:definition "(5) To avoid doubt, for the purposes of paragraph (1)(b), a person does not cease to be an AFP employee in circumstances where the person completes a period of engagement under section 24 (the initial period) and is re-engaged under that section for a further period starting immediately after the end of the initial period. 53A  Court may lift corporate veil etc."@en ;
    cml:integrityHash "4c05eb7811827056f074fac80dd72a2f9bf46a68f27cf9dac9aba0f9158a4dd6" ;
    values:partOf concept:australian-federal-police-act-1979-sec-51 ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "A person does not cease to be an AFP employee under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
