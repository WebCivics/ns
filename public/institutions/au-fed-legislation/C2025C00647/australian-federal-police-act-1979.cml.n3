doc:sec-49r-ss-1 a cof:Section ;
    cof:title "49R(1) Notice of applications" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who applies under section 49J for an ancillary order in relation to a restraining order must give written notice of the application to each other person who is entitled under subsection 49J(2) to make an application under section 49J in relation to the restraining order." ;
    cof:pageNumber "177"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-49r-ss-2 a cml:Concept ;
    skos:prefLabel "49R(2) Notice of applications"@en ;
    cml:realizedBy doc:sec-49r-ss-2 ;
    values:originalText "(2) A person who applies under section 49N for revocation of a restraining order must give written notice of the application to the DPP." ;
    skos:definition "(2) A person who applies under section 49N for revocation of a restraining order must give written notice of the application to the DPP."@en ;
    cml:integrityHash "5125d5269d41cdb71a881f902ee23f682da63ddc364dfcd66900947f8e02fb75" ;
