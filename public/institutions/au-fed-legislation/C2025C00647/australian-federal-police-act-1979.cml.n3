concept:australian-federal-police-act-1979-sec-40rf-ss-6 a cml:Concept ;
    skos:prefLabel "40RF(6) Assignment of members, and special members, to unit"@en ;
    cml:realizedBy doc:sec-40rf-ss-6 ;
    values:originalText "(6) As soon as practicable after the member, or special member, has served in the unit for the period specified in the assignment, the Commissioner must arrange for the member, or special member, to cease serving in the unit." ;
    skos:definition "(6) As soon as practicable after the member, or special member, has served in the unit for the period specified in the assignment, the Commissioner must arrange for the member, or special member, to cease serving in the unit."@en ;
