concept:australian-federal-police-act-1979-sec-14j a cml:Concept ;
    skos:prefLabel "14J Stopping and searching"@en ;
    cml:realizedBy doc:sec-14j ;
    values:originalText "When this section applies (1) This section applies if a designated person suspects on reasonable grounds that: (a) a person (the suspect): (i) has a thing under the suspect’s immediate control; or (ii) is occupying a thing; or (iii) has a thing in a vehicle operated or occupied by the suspect; or" ;
    skos:definition "When this section applies (1) This section applies if a designated person suspects on reasonable grounds that: (a) a person (the suspect): (i) has a thing under the suspect’s immediate control; or (ii) is occupying a thing; or (iii) has a thing in a vehicle operated or occupied by the suspect; or"@en ;
    cml:integrityHash "0e87f17a029f7154a4177f38af9980a30b2054958f04164c1c543df9d6aafad1" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Designated person has obligation to suspect reasonable grounds for stopping and searching." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
