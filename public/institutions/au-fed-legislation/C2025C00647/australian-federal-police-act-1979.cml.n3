concept:australian-federal-police-act-1979-sec-12 a cml:Concept ;
    skos:prefLabel "12 Immunities from certain State and Territory laws"@en ;
    cml:realizedBy doc:sec-12 ;
    values:originalText "The Commissioner, a Deputy Commissioner or an AFP employee is not required under, or by reason of, a law of a State or Territory: (a) to obtain or have a licence or permission for doing any act or thing in the exercise of his or her powers or the performance of his or her duties as the Commissioner, a Deputy Commissioner or an AFP employee; or (b) to register any vehicle, vessel, animal or article belonging to the Commonwealth." ;
    skos:definition "The Commissioner, a Deputy Commissioner or an AFP employee is not required under, or by reason of, a law of a State or Territory: (a) to obtain or have a licence or permission for doing any act or thing in the exercise of his or her powers or the performance of his or her duties as the Commissioner, a Deputy Commissioner or an AFP employee; or (b) to register any vehicle, vessel, animal or article belonging to the Commonwealth."@en ;
    cml:integrityHash "a5853dfb6472b318f66190960a412d748029555e15c73199dc88045828223900" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Exemptions from obtaining licenses or registering vehicles" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.36" ;
