concept:australian-federal-police-act-1979-sec-56 a cml:Concept ;
    skos:prefLabel "56 Constitution of appropriate courts"@en ;
    cml:realizedBy doc:sec-56 ;
    values:originalText "Where an application for a superannuation order or restraining order is made to a court before which a person was convicted of a corruption offence: (a) the application may be dealt with by the court; and (b) any power in relation to the superannuation order or restraining order may be exercised by the court; whether or not it is constituted in the same way in which it was constituted when the person was convicted of the offence.   Miscellaneous  Part VI  Section 60A Australian Federal Police Act 1979 Compilation date: 08/11/2025" ;
    skos:definition "Where an application for a superannuation order or restraining order is made to a court before which a person was convicted of a corruption offence: (a) the application may be dealt with by the court; and (b) any power in relation to the superannuation order or restraining order may be exercised by the court; whether or not it is constituted in the same way in which it was constituted when the person was convicted of the offence.   Miscellaneous  Part VI  Section 60A Australian Federal Police Act 1979 Compilation date: 08/11/2025"@en ;
    cml:integrityHash "60625e7a4b4730a95893da27f822e00458c06fb05d42114e894b1f24f9694242" ;
    cof:pageNumber "182"^^xsd:integer ;
    skos:note "Court may deal with application for superannuation order or restraining order made by a person convicted of corruption offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.182" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-56-norm .
