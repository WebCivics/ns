concept:australian-federal-police-act-1979-sec-12a-ss-4 a cml:Concept ;
    skos:prefLabel "12A(4) Immunity from State and Territory laws in relation to entry"@en ;
    cml:realizedBy doc:sec-12a-ss-4 ;
    values:originalText "(4) In any proceeding, a certificate in writing signed by the Commissioner certifying that: (a) a specified member or specified protective service officer is, or was at a specified time, an AFP dog handler within the meaning of this section; or (b) a specified dog is, or was at a specified time, an AFP dog within the meaning of this section; is prima facie evidence of the fact or facts certified." ;
    skos:definition "(4) In any proceeding, a certificate in writing signed by the Commissioner certifying that: (a) a specified member or specified protective service officer is, or was at a specified time, an AFP dog handler within the meaning of this section; or (b) a specified dog is, or was at a specified time, an AFP dog within the meaning of this section; is prima facie evidence of the fact or facts certified."@en ;
    cml:integrityHash "55e21d141fb730aca258efea756ef745754767a1298da2277f9eb817ba468d73" ;
    values:partOf concept:australian-federal-police-act-1979-sec-12a ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Certificate as prima facie evidence of AFP dog handler status" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
