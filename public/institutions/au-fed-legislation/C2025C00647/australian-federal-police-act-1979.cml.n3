concept:australian-federal-police-act-1979-sec-61 a cml:Concept ;
    skos:prefLabel "61 Awards for bravery etc."@en ;
    cml:realizedBy doc:sec-61 ;
    values:originalText "(1) Where an AFP appointee has, by his or her bravery or other conspicuous conduct or by his or her diligent service, merited a prescribed award, the Commissioner may confer the award on that person. (1A) If the Commissioner is satisfied that a person (other than an AFP appointee) has, by his or her bravery, or other conspicuous conduct, in assisting the Australian Federal Police, merited a prescribed award, the Commissioner may confer the award on that person. (2) An award shall be conferred on the basis of such criteria as are prescribed." ;
    skos:definition "(1) Where an AFP appointee has, by his or her bravery or other conspicuous conduct or by his or her diligent service, merited a prescribed award, the Commissioner may confer the award on that person. (1A) If the Commissioner is satisfied that a person (other than an AFP appointee) has, by his or her bravery, or other conspicuous conduct, in assisting the Australian Federal Police, merited a prescribed award, the Commissioner may confer the award on that person. (2) An award shall be conferred on the basis of such criteria as are prescribed."@en ;
    cml:integrityHash "9daca4290d7ee0110b4c06799e130500a64ca1050b087e7a160b1083c8d1955e" ;
    cof:pageNumber "185"^^xsd:integer ;
    cml:hasPart concept:australian-federal-police-act-1979-sec-61-ss-1 ;
    cml:hasPart concept:australian-federal-police-act-1979-sec-61-ss-1a ;
    cml:hasPart concept:australian-federal-police-act-1979-sec-61-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.185" .
