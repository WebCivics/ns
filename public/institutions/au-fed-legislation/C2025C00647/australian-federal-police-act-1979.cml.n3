concept:australian-federal-police-act-1979-sec-40rq a cml:Concept ;
    skos:prefLabel "40RQ Managers for particular categories of AFP conduct issues"@en ;
    cml:realizedBy doc:sec-40rq ;
    values:originalText "The Commissioner may issue Commissioner’s orders under section 38: (a) authorising particular kinds of AFP appointees to act as managers for category 1 conduct issues; or (b) authorising particular kinds of AFP appointees to act as managers for category 2 conduct issues." ;
    skos:definition "The Commissioner may issue Commissioner’s orders under section 38: (a) authorising particular kinds of AFP appointees to act as managers for category 1 conduct issues; or (b) authorising particular kinds of AFP appointees to act as managers for category 2 conduct issues."@en ;
    cml:integrityHash "481a5aa24cbfef5559b99df41d73390dd3eb74e7ccafd9f650968c7f2b3f5b92" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "Commissioner may issue orders authorizing AFP appointees to act as managers for specific conduct issues." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.105" ;
