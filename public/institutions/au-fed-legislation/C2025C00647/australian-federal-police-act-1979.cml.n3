    cml:premiseText "Protective service officer must not cause death or grievous bodily harm unless necessary to protect life or prevent serious injury." ;
    cml:conclusionText "The recurring trace is from one arrest to the next, with exceptions for necessary actions to protect life or prevent serious injury." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-act-1979-sec-14a-ss-2 cml:asserts concept:australian-federal-police-act-1979-sec-14a-ss-2-logic-deontic-4 .
