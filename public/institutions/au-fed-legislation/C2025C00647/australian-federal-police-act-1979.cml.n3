doc:sec-49b-ss-5 a cof:Section ;
    cof:title "49B(5) Making of restraining orders" ;
    values:kind "subsection" ;
    values:originalText "(5) Where the application is made in reliance on the proposed charging of the defendant with the offence concerned, the court must not make a restraining order unless satisfied that the defendant will be charged with the offence, or with a related corruption offence, within 48 hours." ;
    cof:pageNumber "166"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-49b-ss-6 a cml:Concept ;
    skos:prefLabel "49B(6) Making of restraining orders"@en ;
    cml:realizedBy doc:sec-49b-ss-6 ;
    values:originalText "(6) A court may refuse to make a restraining order if the Commonwealth refuses or fails to give the court such undertakings as the court considers appropriate with respect to the payment of damages or costs, or both, in relation to the making and operation of the order." ;
    skos:definition "(6) A court may refuse to make a restraining order if the Commonwealth refuses or fails to give the court such undertakings as the court considers appropriate with respect to the payment of damages or costs, or both, in relation to the making and operation of the order."@en ;
    cml:integrityHash "ee017d19c0e6a8e8eb33b1423553c36b0571e20b1148f2dd866174ad00c7254a" ;
    values:partOf concept:australian-federal-police-act-1979-sec-49b ;
    cof:pageNumber "166"^^xsd:integer ;
    skos:note "Court refusal to make restraining order based on Commonwealth's undertakings" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
