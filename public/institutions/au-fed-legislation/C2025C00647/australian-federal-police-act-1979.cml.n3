concept:australian-federal-police-act-1979-sec-42g a cml:Concept ;
    skos:prefLabel "42G Sufficient consideration"@en ;
    cml:realizedBy doc:sec-42g ;
    values:originalText "A reference in this Part to transferring or acquiring property, or an interest in property, for sufficient consideration is a reference to transferring or acquiring the property or interest for a consideration that is sufficient and, having regard solely to commercial considerations, reflects the value of the property or the interest." ;
    skos:definition "A reference in this Part to transferring or acquiring property, or an interest in property, for sufficient consideration is a reference to transferring or acquiring the property or interest for a consideration that is sufficient and, having regard solely to commercial considerations, reflects the value of the property or the interest."@en ;
    cml:integrityHash "45970a96db66507b918dd6a96d8338d82202465615cbe3d8d2c53fb7becd6e03" ;
    cof:pageNumber "155"^^xsd:integer ;
    skos:note "A consideration sufficient for transferring or acquiring property is one that reflects its value." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.155" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-42g-norm .
