concept:australian-federal-police-act-1979-sec-69 a cml:Concept ;
    skos:prefLabel "69 Prohibition of patronage and favouritism"@en ;
    cml:realizedBy doc:sec-69 ;
    values:originalText "The Commissioner, or a delegate of the Commissioner, in exercising powers under this Act: (a) in relation to the engagement of AFP employees; or (b) otherwise in relation to AFP employees; must do so without patronage or favouritism." ;
    skos:definition "The Commissioner, or a delegate of the Commissioner, in exercising powers under this Act: (a) in relation to the engagement of AFP employees; or (b) otherwise in relation to AFP employees; must do so without patronage or favouritism."@en ;
    cml:integrityHash "509e95a82e9f02e9409335e551758caa2b2e83c76bed06ba4311fd2d5a5aa6fe" ;
    cof:pageNumber "196"^^xsd:integer ;
    skos:note "The Commissioner must exercise powers without patronage or favouritism." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
