concept:australian-federal-police-act-1979-sec-69c a cml:Concept ;
    skos:prefLabel "69C Delegation"@en ;
    cml:realizedBy doc:sec-69c ;
    values:originalText "(1) The Commissioner may, in writing, delegate to a Deputy Commissioner, an AFP employee or a special member, all or any of the Commissioner’s powers, functions or duties under this Act (other than the Commissioner’s power under section 35A (payments in special circumstances)). (2) The Commissioner may, in writing, delegate to a senior executive AFP employee the Commissioner’s power under section 35A (payments in special circumstances)." ;
    skos:definition "(1) The Commissioner may, in writing, delegate to a Deputy Commissioner, an AFP employee or a special member, all or any of the Commissioner’s powers, functions or duties under this Act (other than the Commissioner’s power under section 35A (payments in special circumstances)). (2) The Commissioner may, in writing, delegate to a senior executive AFP employee the Commissioner’s power under section 35A (payments in special circumstances)."@en ;
    cml:integrityHash "cec4a8f2d02b7a2b121935bbd24a20af90c4974a94ffa6105e6e375595568fab" ;
    cof:pageNumber "197"^^xsd:integer ;
