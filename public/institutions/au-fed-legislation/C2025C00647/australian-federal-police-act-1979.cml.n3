concept:australian-federal-police-act-1979-sec-14f a cml:Concept ;
    skos:prefLabel "14F Release of arrested person"@en ;
    cml:realizedBy doc:sec-14f ;
    values:originalText "Where: (a) a person has been arrested by a protective service officer for an offence; and (b) the person is in the custody of the protective service officer or another protective service officer; and (c) the protective service officer who has the custody of the person:" ;
    skos:definition "Where: (a) a person has been arrested by a protective service officer for an offence; and (b) the person is in the custody of the protective service officer or another protective service officer; and (c) the protective service officer who has the custody of the person:"@en ;
