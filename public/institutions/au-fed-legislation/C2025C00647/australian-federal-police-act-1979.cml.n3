concept:australian-federal-police-act-1979-sec-49g a cml:Concept ;
    skos:prefLabel "49G Witnesses not required to answer questions etc. in certain cases"@en ;
    cml:realizedBy doc:sec-49g ;
    values:originalText "On the hearing of an application for a restraining order, a witness is not required to answer a question or to produce a document if the court is satisfied that the answering of the question or the production of the document may prejudice the investigation of, or the prosecution of a person for, an offence." ;
    skos:definition "On the hearing of an application for a restraining order, a witness is not required to answer a question or to produce a document if the court is satisfied that the answering of the question or the production of the document may prejudice the investigation of, or the prosecution of a person for, an offence."@en ;
    cml:integrityHash "3eef6a3cc5c4a788f7aa54da474d5038e66e21079d059eb14d4800c2ea7c7c1e" ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Witnesses are not required to answer questions or produce documents if it may prejudice an investigation or prosecution." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.170" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-49g-norm .
