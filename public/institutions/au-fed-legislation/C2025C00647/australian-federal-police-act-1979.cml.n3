doc:sec-14m-ss-1 a cof:Section ;
    cof:title "14M(1) Application to magistrate" ;
    values:kind "subsection" ;
    values:originalText "(1) If subsection 14L(7) applies, the police officer may apply to a magistrate for an order in relation to the thing to which that subsection applies." ;
    cof:pageNumber "52"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-14m-ss-2 a cml:Concept ;
    skos:prefLabel "14M(2) Application to magistrate"@en ;
    cml:realizedBy doc:sec-14m-ss-2 ;
    values:originalText "(2) The magistrate must, in determining an application by a police officer under subsection (1), allow the owner of the thing to appear and be heard." ;
    skos:definition "(2) The magistrate must, in determining an application by a police officer under subsection (1), allow the owner of the thing to appear and be heard."@en ;
