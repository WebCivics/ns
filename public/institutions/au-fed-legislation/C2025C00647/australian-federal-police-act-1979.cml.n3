doc:sec-40ti a cof:Section ;
    cof:title "40TI Action that may be taken in relation to category 1 conduct" ;
    values:kind "section" ;
    values:originalText "If the manager is satisfied, on reasonable grounds, that the AFP appointee has engaged in category 1 conduct, the manager may take training and development action in relation to the AFP appointee. Note: For training and development action, see section 40TC." ;
    cof:pageNumber "118"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-40tj a cml:Concept ;
    skos:prefLabel "40TJ Action that may be taken in relation to category 2 conduct"@en ;
    cml:realizedBy doc:sec-40tj ;
    values:originalText "If the manager is satisfied, on reasonable grounds, that the AFP appointee has engaged in category 2 conduct, the manager may do either or both of the following: (a) take remedial action in relation to the AFP appointee;   Professional standards and AFP conduct and practices issues  Part V Dealing with AFP conduct or practices issues  Division 3 Section 40TK Australian Federal Police Act 1979 Compilation date: 08/11/2025 (b) take training and development action in relation to the AFP appointee. Note 1: For remedial action, see section 40TD. Note 2: For training and development action, see section 40TC." ;
    skos:definition "If the manager is satisfied, on reasonable grounds, that the AFP appointee has engaged in category 2 conduct, the manager may do either or both of the following: (a) take remedial action in relation to the AFP appointee;   Professional standards and AFP conduct and practices issues  Part V Dealing with AFP conduct or practices issues  Division 3 Section 40TK Australian Federal Police Act 1979 Compilation date: 08/11/2025 (b) take training and development action in relation to the AFP appointee. Note 1: For remedial action, see section 40TD. Note 2: For training and development action, see section 40TC."@en ;
    cml:integrityHash "34c08ea9f3ebf3f3c571c3f39dd25b659ebb4d88f4c901cc52f5923a1b91d1e7" ;
    cof:pageNumber "118"^^xsd:integer ;
    skos:note "Action that may be taken in relation to category 2 conduct" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.118" ;
