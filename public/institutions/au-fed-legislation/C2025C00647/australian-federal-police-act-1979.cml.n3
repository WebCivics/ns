concept:australian-federal-police-act-1979-sec-40 a cml:Concept ;
    skos:prefLabel "40 Compliance with specific directions, instructions or orders"@en ;
    cml:realizedBy doc:sec-40 ;
    values:originalText "An AFP appointee must not: (a) disobey; or (b) fail to carry out; a lawful direction, instruction or order, whether written or oral, given to him or her by: (c) the Commissioner; or (d) the AFP appointee under whose control, direction or supervision he or she performs his or her duties.   Commissioner’s command powers etc.  Part IV Administration and control etc.  Division 1 Section 40A Australian Federal Police Act 1979 Compilation date: 08/11/2025" ;
    skos:definition "An AFP appointee must not: (a) disobey; or (b) fail to carry out; a lawful direction, instruction or order, whether written or oral, given to him or her by: (c) the Commissioner; or (d) the AFP appointee under whose control, direction or supervision he or she performs his or her duties.   Commissioner’s command powers etc.  Part IV Administration and control etc.  Division 1 Section 40A Australian Federal Police Act 1979 Compilation date: 08/11/2025"@en ;
    cml:integrityHash "5ee25e3be8eafceaabb2f6f89be6e0e76fe971678a79d5e267db0a676f70e4e0" ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Disobeying or failing to carry out lawful directions is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.74" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-40-norm .
