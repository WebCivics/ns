concept:australian-federal-police-act-1979-sec-77 a cml:Concept ;
    skos:prefLabel "77 Accrued leave"@en ;
    cml:realizedBy doc:sec-77 ;
    values:originalText "A person appointed in pursuance of section 72 of this Act, as in force on the commencing date, retains the rights, if any, in respect of: (a) recreation leave; and   Transitional  Part VII  Section 80 Australian Federal Police Act 1979 Compilation date: 08/11/2025 (b) leave on the ground of illness; that had accrued to him or her as a member of an existing Police Force or as a member of the Australian Public Service immediately before the commencing date." ;
    skos:definition "A person appointed in pursuance of section 72 of this Act, as in force on the commencing date, retains the rights, if any, in respect of: (a) recreation leave; and   Transitional  Part VII  Section 80 Australian Federal Police Act 1979 Compilation date: 08/11/2025 (b) leave on the ground of illness; that had accrued to him or her as a member of an existing Police Force or as a member of the Australian Public Service immediately before the commencing date."@en ;
    cml:integrityHash "fd4f071927c88cb13d4de27f0743e2af95a58aeab3f9872937d15f0236682ade" ;
    cof:pageNumber "202"^^xsd:integer ;
    skos:note "Retains accrued leave rights" ;
    cml:curationStatus cml:Proposed ;
