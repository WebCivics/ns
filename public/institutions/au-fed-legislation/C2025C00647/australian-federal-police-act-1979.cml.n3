doc:sec-51-ss-4 a cof:Section ;
    cof:title "51(4) Person ceases to be an AFP employee: persons charged with" ;
    values:kind "subsection" ;
    values:originalText "(4) Where anything mentioned in paragraph (3)(b) happens, the Commissioner shall, as soon as practicable, notify the relevant superannuation authority accordingly." ;
