    cml:logicSummary "Recurring trace for bankruptcy" ;
    cml:premiseText "(c) becomes bankrupt or applies to take the benefit of any law for the relief of bankrupt or insolvent debtors;" ;
    cml:conclusionText "or (d) compounds with his or her creditors or makes an assignment of his or her remuneration for their benefit;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-act-1979-sec-22-ss-2 cml:asserts concept:australian-federal-police-act-1979-sec-22-ss-2-logic-deontic-4 .
