concept:australian-federal-police-act-1979-sec-40tp a cml:Concept ;
    skos:prefLabel "40TP Persons eligible to have category 3 conduct issue or corruption"@en ;
    cml:realizedBy doc:sec-40tp ;
    values:originalText "issue allocated to them The issue may be allocated to a person under section 40TN or 40TO only if the person has appropriate qualifications or experience to conduct the investigation of the issue." ;
    skos:definition "issue allocated to them The issue may be allocated to a person under section 40TN or 40TO only if the person has appropriate qualifications or experience to conduct the investigation of the issue."@en ;
