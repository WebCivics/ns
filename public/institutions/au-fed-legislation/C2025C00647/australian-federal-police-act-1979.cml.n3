doc:sec-41a a cof:Section ;
    cof:title "41A Old law members or staff members" ;
    values:kind "section" ;
    values:originalText "For the purposes of this Part, if at a particular time before the changeover day a person was a member or staff member (within the meaning of this Act as in force at that time), the person was an old law member or staff member at that time." ;
    cof:pageNumber "150"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-42 a cml:Concept ;
    skos:prefLabel "42 Related offences"@en ;
    cml:realizedBy doc:sec-42 ;
    values:originalText "For the purposes of this Act, 2 offences are related to each other if the physical elements of the 2 offences are: (a) substantially the same acts or omissions; or (b) acts or omissions in a single series." ;
    skos:definition "For the purposes of this Act, 2 offences are related to each other if the physical elements of the 2 offences are: (a) substantially the same acts or omissions; or (b) acts or omissions in a single series."@en ;
    cml:integrityHash "38c41686ad2c27a9b4be221219febb3c48f338122aba513524fb85130aaef6e5" ;
    cof:pageNumber "150"^^xsd:integer ;
    skos:note "Offences are related if they share physical elements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.150" ;
