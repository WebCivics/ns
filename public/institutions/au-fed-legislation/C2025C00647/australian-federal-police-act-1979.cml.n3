doc:sec-42 a cof:Section ;
    cof:title "42 Related offences" ;
    values:kind "section" ;
    values:originalText "For the purposes of this Act, 2 offences are related to each other if the physical elements of the 2 offences are: (a) substantially the same acts or omissions; or (b) acts or omissions in a single series." ;
    cof:pageNumber "150"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-42a a cml:Concept ;
    skos:prefLabel "42A Abscond"@en ;
    cml:realizedBy doc:sec-42a ;
    values:originalText "For the purposes of this Part, other than subsection 46(2), a person is to be taken to abscond in connection with an offence if and only if: (a) the person is charged with the offence; and   Loss of certain superannuation rights and benefits  Part VA Introductory  Division 1 Section 42B Australian Federal Police Act 1979 Compilation date: 08/11/2025 (b) a warrant for the arrest of the person is issued in relation to that information; and (c) one of the following happens: (i) at the end of the period of 6 months starting on the day on which the warrant is issued: (A) the person cannot be found; or (B) the person is, for any other reason, not amenable to justice and, if the person is outside Australia, extradition proceedings are not on foot; (ii) at the end of the period of 6 months starting on the day on which the warrant is issued: (A) the person is not amenable to justice because he or she is outside Australia; and (B) extradition proceedings are on foot; and those proceedings later end without an order for the person’s extradition." ;
    skos:definition "For the purposes of this Part, other than subsection 46(2), a person is to be taken to abscond in connection with an offence if and only if: (a) the person is charged with the offence; and   Loss of certain superannuation rights and benefits  Part VA Introductory  Division 1 Section 42B Australian Federal Police Act 1979 Compilation date: 08/11/2025 (b) a warrant for the arrest of the person is issued in relation to that information; and (c) one of the following happens: (i) at the end of the period of 6 months starting on the day on which the warrant is issued: (A) the person cannot be found; or (B) the person is, for any other reason, not amenable to justice and, if the person is outside Australia, extradition proceedings are not on foot; (ii) at the end of the period of 6 months starting on the day on which the warrant is issued: (A) the person is not amenable to justice because he or she is outside Australia; and (B) extradition proceedings are on foot; and those proceedings later end without an order for the person’s extradition."@en ;
    cml:integrityHash "4baeff19b57287a292c78227349b892ff3c4002da68fbd1293910d58c8dca3e4" ;
    cof:pageNumber "150"^^xsd:integer ;
    skos:note "Absconding in connection with an offence is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.150" ;
