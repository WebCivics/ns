doc:sec-43-ss-1 a cof:Section ;
    cof:title "43(1) Notice of charge etc." ;
    values:kind "subsection" ;
    values:originalText "(1) Where: (a) either: (i) a person who is or was an AFP employee is charged with an offence; or (ii) a person who was an old law member or staff member at any time is charged with an offence; and (b) the Commissioner considers that the offence is, or may be, a corruption offence; the Commissioner shall notify the Minister administering the Crimes (Superannuation Benefits) Act 1989 in writing of the charge." ;
    cof:pageNumber "156"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-43-ss-2 a cml:Concept ;
    skos:prefLabel "43(2) Notice of charge etc."@en ;
    cml:realizedBy doc:sec-43-ss-2 ;
    values:originalText "(2) A notice shall contain particulars of the charge and set out the reasons why the Commissioner considers that the offence is, or may be, a corruption offence." ;
    skos:definition "(2) A notice shall contain particulars of the charge and set out the reasons why the Commissioner considers that the offence is, or may be, a corruption offence."@en ;
    cml:integrityHash "a335cc4973194ddc9879c6f997f9d5d2383934d44b8907c193e81510bf0d4966" ;
    values:partOf concept:australian-federal-police-act-1979-sec-43 ;
