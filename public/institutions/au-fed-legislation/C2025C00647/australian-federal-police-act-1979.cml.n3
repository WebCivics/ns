concept:australian-federal-police-act-1979-sec-70 a cml:Concept ;
    skos:prefLabel "70 Regulations"@en ;
    cml:realizedBy doc:sec-70 ;
    values:originalText "The Governor-General may make regulations, not inconsistent with this Act, prescribing all matters required or permitted by this Act to be prescribed, or necessary or convenient to be prescribed, for securing the discipline and good government of the Australian Federal Police, or for otherwise carrying out or giving effect to this Act, and, in particular, making provision for and in relation to: (a) the return to the Commissioner by a person who has ceased to be an AFP employee, a special member or a special protective service officer of property (including accoutrements and clothing) supplied to him or her for the purposes of his or her service as an AFP employee, a special member or a special protective service officer or in his or her" ;
    skos:definition "The Governor-General may make regulations, not inconsistent with this Act, prescribing all matters required or permitted by this Act to be prescribed, or necessary or convenient to be prescribed, for securing the discipline and good government of the Australian Federal Police, or for otherwise carrying out or giving effect to this Act, and, in particular, making provision for and in relation to: (a) the return to the Commissioner by a person who has ceased to be an AFP employee, a special member or a special protective service officer of property (including accoutrements and clothing) supplied to him or her for the purposes of his or her service as an AFP employee, a special member or a special protective service officer or in his or her"@en ;
    cml:integrityHash "79bd1cf1ba8ce6adea83735d82cdccefcc3a4b795b1098ac0b4b0756f6bc8087" ;
    cof:pageNumber "199"^^xsd:integer ;
    skos:note "The Governor-General may make regulations for securing discipline and good government of the Australian Federal Police." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.199" ;
