    skos:definition "(1) If an AFP employee has consented to being retired under subsection 32(1), the employee’s retirement takes effect on the day specified in the notice under that subsection. The day specified must not be before the day on which the notice is given to the employee. AFP employee does not consent to retirement"@en ;
    cml:integrityHash "5e6a9476cfaf53aef634883e1d4ec1690918de02ad8403625e087044b05a0e7e" ;
    values:partOf concept:australian-federal-police-act-1979-sec-33 ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Retirement on invalidity grounds takes effect on the specified day after notice is given to the employee." ;
    cml:curationStatus cml:Proposed ;
