    values:partOf concept:australian-federal-police-act-1979-sec-40sc ;
    cof:pageNumber "109"^^xsd:integer ;
    skos:note "Recipient must provide explanation or take action within a reasonable period if issue is appropriate for informal resolution." ;
    dc:description "Yes" ;
