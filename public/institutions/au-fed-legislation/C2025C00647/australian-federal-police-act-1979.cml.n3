concept:australian-federal-police-act-1979-sec-42h a cml:Concept ;
    skos:prefLabel "42H Application of Part to convictions and offences"@en ;
    cml:realizedBy doc:sec-42h ;
    values:originalText "(1) This Part does not apply to a person’s conviction of an offence if the conviction happened before the commencing day. (2) This Part applies to an offence committed, or believed to have been committed, at any time, whether before, on or after the commencing day." ;
    skos:definition "(1) This Part does not apply to a person’s conviction of an offence if the conviction happened before the commencing day. (2) This Part applies to an offence committed, or believed to have been committed, at any time, whether before, on or after the commencing day."@en ;
    cml:integrityHash "106c1584b3af607b67fa18995aab9fd8c65c64154fdffd8845c768c977b75f42" ;
    cof:pageNumber "155"^^xsd:integer ;
