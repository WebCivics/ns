doc:sec-42d-ss-4 a cof:Section ;
    cof:title "42D(4) Property of a person" ;
    values:kind "subsection" ;
    values:originalText "(4) Property that is to be taken to be property of a person under subsection (2) is available to satisfy a recovery order made against the person if, and only if, a restraining order has been made against the property." ;
    cof:pageNumber "152"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-42e a cml:Concept ;
    skos:prefLabel "42E Dealing with property"@en ;
    cml:realizedBy doc:sec-42e ;
    values:originalText "For the purposes of this Part, dealing with property of a person includes: (a) if a debt owing by the person is secured by an encumbrance on the property—incurring any further liability or increasing the amount of the debt by any means; and (b) removing the property from Australia; and VP – VC VP" ;
    skos:definition "For the purposes of this Part, dealing with property of a person includes: (a) if a debt owing by the person is secured by an encumbrance on the property—incurring any further liability or increasing the amount of the debt by any means; and (b) removing the property from Australia; and VP – VC VP"@en ;
    cml:integrityHash "e094613ac7ae0df3cd6642dd18afd9cb9a7aa828f9eb0f60a4c418b8e79d3fad" ;
    cof:pageNumber "153"^^xsd:integer ;
    skos:note "Dealing with property includes incurring further liability or increasing debt." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.153" ;
