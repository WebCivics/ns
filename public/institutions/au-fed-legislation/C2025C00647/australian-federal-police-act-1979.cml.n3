    skos:prefLabel "40L(3) Financial statements"@en ;
    cml:realizedBy doc:sec-40l-ss-3 ;
    values:originalText "(3) The person must give the statement to the Commissioner within 2 months after the end of the period to which the statement relates. Extension of time" ;
