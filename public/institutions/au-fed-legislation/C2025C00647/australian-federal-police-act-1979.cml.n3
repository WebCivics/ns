concept:australian-federal-police-act-1979-sec-55 a cml:Concept ;
    skos:prefLabel "55 Possible superannuation order not to be taken into account in"@en ;
    cml:realizedBy doc:sec-55 ;
    values:originalText "sentencing A court shall not, in sentencing a person convicted of an offence punishable by imprisonment for life or for a term longer than 12" ;
    skos:definition "sentencing A court shall not, in sentencing a person convicted of an offence punishable by imprisonment for life or for a term longer than 12"@en ;
    cml:integrityHash "04bb905b127dc952093dd0b00c5dd35ab43001f2fed8e7f14fa37e57eb99c9ef" ;
    cof:pageNumber "181"^^xsd:integer ;
    skos:note "Court cannot punish with imprisonment for life or longer than 12 years in sentencing." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.181" ;
