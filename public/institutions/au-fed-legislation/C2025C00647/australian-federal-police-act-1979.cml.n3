doc:sec-61-ss-1a a cof:Section ;
    cof:title "61(1A) Awards for bravery etc." ;
    values:kind "subsection" ;
    values:originalText "(1A) If the Commissioner is satisfied that a person (other than an AFP appointee) has, by his or her bravery, or other conspicuous conduct, in assisting the Australian Federal Police, merited a prescribed award, the Commissioner may confer the award on that person." ;
    cof:pageNumber "185"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-61-ss-2 a cml:Concept ;
    skos:prefLabel "61(2) Awards for bravery etc."@en ;
    cml:realizedBy doc:sec-61-ss-2 ;
    values:originalText "(2) An award shall be conferred on the basis of such criteria as are prescribed." ;
    skos:definition "(2) An award shall be conferred on the basis of such criteria as are prescribed."@en ;
    cml:integrityHash "fc4c4209c95f681999407721939973534c5cc2fafcb33f8228b6ab4a2021a1a8" ;
    values:partOf concept:australian-federal-police-act-1979-sec-61 ;
