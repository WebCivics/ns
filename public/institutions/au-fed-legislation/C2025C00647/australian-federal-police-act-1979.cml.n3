doc:sec-17-ss-2 a cof:Section ;
    cof:title "17(2) Commissioner and Deputy Commissioners" ;
    values:kind "subsection" ;
    values:originalText "(2) Subject to this Part, the Commissioner holds office for such period, not exceeding 7 years, as is specified in his or her instrument of appointment, but is eligible for re-appointment." ;
    cof:pageNumber "54"^^xsd:integer .

