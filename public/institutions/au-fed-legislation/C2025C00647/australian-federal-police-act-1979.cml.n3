    cml:operator "Validation" ;
    cml:logicSummary "Validation of superannuation scheme suspension." ;
    cml:premiseText "(b) the person ceases, for any reason, to be an AFP employee on or after the day on which the person is charged;" ;
    cml:conclusionText "...the Commissioner shall notify the person’s superannuation authority in writing..." ;
    cml:executionSurface "modalities::logic::shacl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-51-ss-1 a cof:Section ;
    cof:title "51(1) Person ceases to be an AFP employee: persons charged with" ;
    values:kind "subsection" ;
    values:originalText "(1) Where an appropriate court makes a recovery order against a person, it may, on application by the DPP, if it thinks that particular property is subject to the effective control of the person, make an order declaring that the whole, or a specified part, of that property is available to satisfy the recovery order." ;
    cof:pageNumber "178"^^xsd:integer .

concept:australian-federal-police-act-1979-sec-51-ss-2 a cml:Concept ;
    skos:prefLabel "51(2) Person ceases to be an AFP employee: persons charged with"@en ;
    cml:realizedBy doc:sec-51-ss-2 ;
    values:originalText "(2) Where a court declares that property is available to satisfy a recovery order: (a) the recovery order may be enforced against the property as if the property were property of the person against whom the order is made; and (b) a restraining order may be made in respect of the property as if the property were property of the person against whom the restructuring order is made." ;
    skos:definition "(2) Where a court declares that property is available to satisfy a recovery order: (a) the recovery order may be enforced against the property as if the property were property of the person against whom the order is made; and (b) a restraining order may be made in respect of the property as if the property were property of the person against whom the restructuring order is made."@en ;
    cml:integrityHash "41f80208589be91c608e8f29246508decc65f72acf19de882bee26bb8818e1bb" ;
    values:partOf concept:australian-federal-police-act-1979-sec-51 ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Restraining order may be made in respect of the property. The Commissioner must give a copy of a notice to the person concerned." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-act-1979.pdf> ;
    dc:source "australian-federal-police-act-1979.pdf, p.178" ;
    cml:asserts concept:australian-federal-police-act-1979-sec-51-ss-2-norm .
