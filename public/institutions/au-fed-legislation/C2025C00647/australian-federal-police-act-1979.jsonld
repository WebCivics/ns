      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.119",
      "values:originalText": "(1) This section applies if the manager is satisfied that the information:\n(a) given under section 40SA in relation to the AFP conduct\nissue; or\n(b) obtained in the course of dealing with the AFP conduct issue;\nraises an AFP practices issue.",
      "skos:definition": "(1) This section applies if the manager is satisfied that the information:\n(a) given under section 40SA in relation to the AFP conduct\nissue; or\n(b) obtained in the course of dealing with the AFP conduct issue;\nraises an AFP practices issue.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-40tk"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-1-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-1-logic-alleninterval-2"
