      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "No authorisation can be made under this section if it would involve a total amount of more than $100,000.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-35a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "35A(5) Payments in special circumstances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-35a-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.70",
      "values:originalText": "(5) Conditions may be attached to payments under this section. If a\ncondition is breached, the payment may be recovered by the\nCommonwealth as a debt in a court of competent jurisdiction.\nNote:\nPayments under this section must be made from money appropriated\nby the Parliament. Generally, a payment can be debited against the\nAustralian Federal Police’s annual appropriation, providing that it\nrelates to some matter that has arisen in the course of its\nadministration.\n\n\nCommissioner, Deputy Commissioners and AFP employees etc.  Part III\nUndertakings and oaths or affirmations  Division 4\nSection 36\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "skos:definition": "(5) Conditions may be attached to payments under this section. If a\ncondition is breached, the payment may be recovered by the\nCommonwealth as a debt in a court of competent jurisdiction.\nNote:\nPayments under this section must be made from money appropriated\nby the Parliament. Generally, a payment can be debited against the\nAustralian Federal Police’s annual appropriation, providing that it\nrelates to some matter that has arisen in the course of its\nadministration.\n\n\nCommissioner, Deputy Commissioners and AFP employees etc.  Part III\nUndertakings and oaths or affirmations  Division 4\nSection 36\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-35a"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-35a-ss-5-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-35a-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "25eaa213ebfba22fde269cffc2621c53bc78bfcae3d37f168bd78236245b835b",
      "skos:note": "Payment recovery upon breach of conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-35a-ss-5",
      "@type": "cof:Section",
      "cof:title": "35A(5) Payments in special circumstances",
      "values:kind": "subsection",
      "cof:pageNumber": 70,
      "values:originalText": "(5) Conditions may be attached to payments under this section. If a\ncondition is breached, the payment may be recovered by the\nCommonwealth as a debt in a court of competent jurisdiction.\nNote:\nPayments under this section must be made from money appropriated\nby the Parliament. Generally, a payment can be debited against the\nAustralian Federal Police’s annual appropriation, providing that it\nrelates to some matter that has arisen in the course of its\nadministration.\n\n\nCommissioner, Deputy Commissioners and AFP employees etc.  Part III\nUndertakings and oaths or affirmations  Division 4\nSection 36\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-35a-ss-5-norm",
