      },
      "cml:premiseText": "(1) The functions of the Australian Federal Police are:"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-8-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
