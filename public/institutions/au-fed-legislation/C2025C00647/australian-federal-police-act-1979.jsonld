          "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-ltl-3"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "af1c084707f3536c5351d458b1c0dd8bef6a4161f56bad557b844e2a290db579",
      "skos:note": "Consultation with Ombudsman required before taking action under subsection (2) or (3)"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40uc-ss-4",
      "@type": "cof:Section",
      "cof:title": "40UC(4) Division 3 investigation may be suspended pending outcome",
      "values:kind": "subsection",
      "cof:pageNumber": 127,
      "values:originalText": "(4) If the conduct or matter is being dealt with under Division 3 jointly\nby the Ombudsman and the Australian Federal Police, the\nCommissioner may take action under subsection (2) or (3) only\nafter consulting the Ombudsman."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4"
