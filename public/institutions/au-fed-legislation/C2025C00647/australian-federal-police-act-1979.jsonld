      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-6-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "6(2) Constitution of the Australian Federal Police",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-6-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.30",
      "values:originalText": "(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Australian Federal Police is a listed entity; and\n(b) the Commissioner of Police is the accountable authority of\nthe Australian Federal Police; and\n(c) the persons referred to in subsection (1) are officials of the\nAustralian Federal Police; and\n(d) the purposes of the Australian Federal Police include the\nfunctions of the Australian Federal Police referred to in\nsection 8.",
      "skos:definition": "(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Australian Federal Police is a listed entity; and\n(b) the Commissioner of Police is the accountable authority of\nthe Australian Federal Police; and\n(c) the persons referred to in subsection (1) are officials of the\nAustralian Federal Police; and\n(d) the purposes of the Australian Federal Police include the\nfunctions of the Australian Federal Police referred to in\nsection 8.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-6"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-2-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-2-logic-deontic-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-2-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "f301533c7e15c50dba772369a57b8c344f06080178e0e72c8bb02ab1c2357331",
      "skos:note": "The Australian Federal Police is a listed entity."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-6-ss-2",
      "@type": "cof:Section",
      "cof:title": "6(2) Constitution of the Australian Federal Police",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Australian Federal Police is a listed entity; and\n(b) the Commissioner of Police is the accountable authority of\nthe Australian Federal Police; and\n(c) the persons referred to in subsection (1) are officials of the\nAustralian Federal Police; and\n(d) the purposes of the Australian Federal Police include the\nfunctions of the Australian Federal Police referred to in\nsection 8."
    },
