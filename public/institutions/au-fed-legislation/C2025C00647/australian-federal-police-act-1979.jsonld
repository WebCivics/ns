    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rq",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RQ Managers for particular categories of AFP conduct issues",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.105",
      "values:originalText": "The Commissioner may issue Commissioner’s orders under\nsection 38:\n(a) authorising particular kinds of AFP appointees to act as\nmanagers for category 1 conduct issues; or\n(b) authorising particular kinds of AFP appointees to act as\nmanagers for category 2 conduct issues.",
      "skos:definition": "The Commissioner may issue Commissioner’s orders under\nsection 38:\n(a) authorising particular kinds of AFP appointees to act as\nmanagers for category 1 conduct issues; or\n(b) authorising particular kinds of AFP appointees to act as\nmanagers for category 2 conduct issues.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rq-norm"
        }
      ],
      "cml:integrityHash": "481a5aa24cbfef5559b99df41d73390dd3eb74e7ccafd9f650968c7f2b3f5b92",
      "skos:note": "Commissioner may issue orders authorizing AFP appointees to act as managers for specific conduct issues."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rq",
      "@type": "cof:Section",
      "cof:title": "40RQ Managers for particular categories of AFP conduct issues",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "The Commissioner may issue Commissioner’s orders under\nsection 38:\n(a) authorising particular kinds of AFP appointees to act as\nmanagers for category 1 conduct issues; or\n(b) authorising particular kinds of AFP appointees to act as\nmanagers for category 2 conduct issues."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rq-norm",
