    {
      "@id": "concept:australian-federal-police-act-1979-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Constitution of the Australian Federal Police",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.30",
      "values:originalText": "(1) The Australian Federal Police consists of:\n(a) the Commissioner of Police; and\n(b) any Deputy Commissioner of Police; and\n(c) AFP employees; and\n(d) special members; and\n(e) special protective service officers.\n(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Australian Federal Police is a listed entity; and\n(b) the Commissioner of Police is the accountable authority of\nthe Australian Federal Police; and\n(c) the persons referred to in subsection (1) are officials of the\nAustralian Federal Police; and\n(d) the purposes of the Australian Federal Police include the\nfunctions of the Australian Federal Police referred to in\nsection 8.",
      "skos:definition": "(1) The Australian Federal Police consists of:\n(a) the Commissioner of Police; and\n(b) any Deputy Commissioner of Police; and\n(c) AFP employees; and\n(d) special members; and\n(e) special protective service officers.\n(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Australian Federal Police is a listed entity; and\n(b) the Commissioner of Police is the accountable authority of\nthe Australian Federal Police; and\n(c) the persons referred to in subsection (1) are officials of the\nAustralian Federal Police; and\n(d) the purposes of the Australian Federal Police include the\nfunctions of the Australian Federal Police referred to in\nsection 8.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-2"
        }
      ],
      "cml:integrityHash": "197750bf79bb11d0279942a44cc2ab617affff77667ea8fb263159834e6b9e9c"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Constitution of the Australian Federal Police",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "(1) The Australian Federal Police consists of:\n(a) the Commissioner of Police; and\n(b) any Deputy Commissioner of Police; and\n(c) AFP employees; and\n(d) special members; and\n(e) special protective service officers.\n(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the Australian Federal Police is a listed entity; and\n(b) the Commissioner of Police is the accountable authority of\nthe Australian Federal Police; and\n(c) the persons referred to in subsection (1) are officials of the\nAustralian Federal Police; and\n(d) the purposes of the Australian Federal Police include the\nfunctions of the Australian Federal Police referred to in\nsection 8."
    },
