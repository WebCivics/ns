      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.33",
      "values:originalText": "functions\nThe Minister may, by notice published in the Gazette, direct that\ncertain protective and custodial functions of the Australian Federal\nPolice are protective service functions.",
      "skos:definition": "functions\nThe Minister may, by notice published in the Gazette, direct that\ncertain protective and custodial functions of the Australian Federal\nPolice are protective service functions.",
      "cml:asserts": [
        {
