        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) engages in paid employment outside the duties of his or her office without the approval of the Minister;",
      "cml:conclusionText": "or (b) is absent from duty, except on leave of absence under section 21, for 14 consecutive days, or for 28 days in any 12 months;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-22-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition on certain actions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) becomes bankrupt or applies to take the benefit of any law for the relief of bankrupt or insolvent debtors, compounds with his or her creditors or makes an assignment of his or her remuneration for their benefit;",
      "cml:conclusionText": "the Governor-General shall terminate his or her appointment."
    },
