        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commissioner has the authority to certify special member appointment details",
      "cml:conclusionText": "The certificate must specify the special member's appointment details"
    },
