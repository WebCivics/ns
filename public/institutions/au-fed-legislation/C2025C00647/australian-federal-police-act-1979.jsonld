    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rd",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RD Unit to be constituted",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.97",
      "values:originalText": "(1) The Commissioner must constitute, within the Australian Federal\nPolice, a unit to undertake investigations of:\n(a) AFP conduct issues that are category 3 conduct issues; and\n(b) corruption issues that relate to conduct engaged in by AFP\nappointees.\n(2) The Commissioner may determine, from time to time, the name by\nwhich the unit is to be known.\n(3) The establishment of the unit is to be such as the Commissioner\ndetermines from time to time.",
      "skos:definition": "(1) The Commissioner must constitute, within the Australian Federal\nPolice, a unit to undertake investigations of:\n(a) AFP conduct issues that are category 3 conduct issues; and\n(b) corruption issues that relate to conduct engaged in by AFP\nappointees.\n(2) The Commissioner may determine, from time to time, the name by\nwhich the unit is to be known.\n(3) The establishment of the unit is to be such as the Commissioner\ndetermines from time to time.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rd-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rd-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rd-ss-3"
        }
      ],
      "cml:integrityHash": "d2ed035a4880b4e195d545c59b65d425223d5d4193ddac0224ffc91b138d2ce2"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rd",
      "@type": "cof:Section",
      "cof:title": "40RD Unit to be constituted",
      "values:kind": "section",
      "cof:pageNumber": 97,
      "values:originalText": "(1) The Commissioner must constitute, within the Australian Federal\nPolice, a unit to undertake investigations of:\n(a) AFP conduct issues that are category 3 conduct issues; and\n(b) corruption issues that relate to conduct engaged in by AFP\nappointees.\n(2) The Commissioner may determine, from time to time, the name by\nwhich the unit is to be known.\n(3) The establishment of the unit is to be such as the Commissioner\ndetermines from time to time."
    },
