    {
      "@id": "concept:australian-federal-police-act-1979-sec-40pa",
      "@type": "cml:Concept",
      "skos:prefLabel": "40PA Managers who may require alcohol screening tests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40pa"
      },
      "cml:curationStatus": {
