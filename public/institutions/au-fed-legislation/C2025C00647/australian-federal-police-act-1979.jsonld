    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-24-ss-2",
      "@type": "cof:Section",
      "cof:title": "24(2) Engagement of AFP employees",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(2) The engagement of an AFP employee may be made subject to\nconditions notified to the employee, including conditions dealing\nwith any of the following matters:\n(a) probation;\n(b) citizenship;\n(c) formal qualifications;\n(d) security and character clearances;\n(e) health clearances;\n(f) secrecy requirements."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-24-ss-2-norm",
