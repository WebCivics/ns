    {
      "@id": "concept:australian-federal-police-act-1979-sec-62",
      "@type": "cml:Concept",
      "skos:prefLabel": "62 Dishonestly representing conferral of police awards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-62"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
