    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ub",
      "@type": "cml:Concept",
      "skos:prefLabel": "40UB Minister to inform certain persons and bodies of inquiry",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ub"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
