      ],
      "cml:integrityHash": "723694d4c714512d8674aaaec89b6a715dabce9933a3073102c270f7ef69e2c1",
      "skos:note": "Subsection (1) applies even if certain conduct or matters are being dealt with under other provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ua-ss-2",
      "@type": "cof:Section",
      "cof:title": "40UA(2) Minister may arrange special inquiries",
      "values:kind": "subsection",
      "cof:pageNumber": 126,
      "values:originalText": "(2) Subsection (1) applies even if:\n(a) the conduct referred to in paragraph (1)(a) is:\n(i) being dealt with under Division 3; or\n(ii) the subject of a complaint made to the Ombudsman; or\n(b) the matter referred to in paragraph (1)(b) is:\n(i) a practice or procedure that is being dealt with under"
    },
