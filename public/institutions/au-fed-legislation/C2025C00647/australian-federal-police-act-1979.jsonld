      "cml:integrityHash": "eb49fa5f961aa3d52f5c6a59f4d184c98736b8f200e39cc8bed267c92281aeb4",
      "skos:note": "AFP appointee must comply with category 3 conduct issue or corruption issue Manager must be satisfied that information raises an AFP practices issue."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tk-ss-1",
      "@type": "cof:Section",
      "cof:title": "40TK(1) AFP practices issue identified in course of dealing with AFP",
      "values:kind": "subsection",
      "cof:pageNumber": 119,
      "values:originalText": "(1) This section applies if the manager is satisfied that the information:\n(a) given under section 40SA in relation to the AFP conduct\nissue; or\n(b) obtained in the course of dealing with the AFP conduct issue;\nraises an AFP practices issue."
    },
    {
