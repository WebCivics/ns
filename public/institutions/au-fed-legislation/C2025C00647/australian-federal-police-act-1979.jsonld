    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rg",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RG Member or special member in unit may be directed to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.99",
      "values:originalText": "perform other duties\nThe Commissioner may direct a member, or special member, of the\nAustralian Federal Police serving in the unit constituted under\nsection 40RD to perform duties that are not related to the unit’s\nfunctions but only if those duties do not unduly interfere with the\nperformance by the unit of its functions.\nSubdivision D—AFP conduct issues and AFP practices issues",
      "skos:definition": "perform other duties\nThe Commissioner may direct a member, or special member, of the\nAustralian Federal Police serving in the unit constituted under\nsection 40RD to perform duties that are not related to the unit’s\nfunctions but only if those duties do not unduly interfere with the\nperformance by the unit of its functions.\nSubdivision D—AFP conduct issues and AFP practices issues",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rg-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rg-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "221ebbf5a2071a80f3c419e9797f05836f73b7a1a232ed2c95821cd08c50380d",
      "skos:note": "Commissioner may direct member or special member to perform duties not related to unit's functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rg",
      "@type": "cof:Section",
      "cof:title": "40RG Member or special member in unit may be directed to",
      "values:kind": "section",
      "cof:pageNumber": 99,
      "values:originalText": "perform other duties\nThe Commissioner may direct a member, or special member, of the\nAustralian Federal Police serving in the unit constituted under\nsection 40RD to perform duties that are not related to the unit’s\nfunctions but only if those duties do not unduly interfere with the\nperformance by the unit of its functions.\nSubdivision D—AFP conduct issues and AFP practices issues"
    },
