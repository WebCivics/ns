    {
      "@id": "concept:australian-federal-police-act-1979-sec-40xc",
      "@type": "cml:Concept",
      "skos:prefLabel": "40XC Commissioner to provide information and access to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40xc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.140",
      "values:originalText": "documents\nFor the purposes of a review conducted under section 40XA or\n40XB, the Ombudsman may require the Commissioner to give the\nOmbudsman the information, and the access to documents, that the\nOmbudsman requests.",
      "skos:definition": "documents\nFor the purposes of a review conducted under section 40XA or\n40XB, the Ombudsman may require the Commissioner to give the\nOmbudsman the information, and the access to documents, that the\nOmbudsman requests.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40xc-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40xc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4acb837030d1713e035f7efdcd4384eb1e9ecec0f4e8ef8e5cc0a4e2018775be",
      "skos:note": "The Commissioner must provide information and access to documents upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40xc",
      "@type": "cof:Section",
      "cof:title": "40XC Commissioner to provide information and access to",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "documents\nFor the purposes of a review conducted under section 40XA or\n40XB, the Ombudsman may require the Commissioner to give the\nOmbudsman the information, and the access to documents, that the\nOmbudsman requests."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40xc-norm",
      "@type": "values:Obligation",
