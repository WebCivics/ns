        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14g-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "inclusion",
      "cml:logicSummary": "Inclusion of powers and duties from other laws.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Other laws confer powers or duties on protective service officers.",
      "cml:conclusionText": "This Division does not exclude these powers or duties."
    },
