        "@id": "concept:australian-federal-police-act-1979-sec-69"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-69-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of patronage and favouritism",
      "cml:executionSurface": "modalities::logic::deontic",
