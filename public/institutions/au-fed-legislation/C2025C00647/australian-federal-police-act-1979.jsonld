      "skos:note": "Exemption from record keeping for certain conduct issues"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40wa-ss-3",
      "@type": "cof:Section",
      "cof:title": "40WA(3) Record keeping",
      "values:kind": "subsection",
      "cof:pageNumber": 138,
      "values:originalText": "(3) Subsection (2) does not apply if subsection 40SC(2) (which deals\nwith category 1 conduct issues that are resolved without being\nrecorded) applies to the information."
    },
