      "skos:note": "AFP employee must be a member of the superannuation scheme established by the Superannuation Act 1990."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-32-ss-5",
      "@type": "cof:Section",
