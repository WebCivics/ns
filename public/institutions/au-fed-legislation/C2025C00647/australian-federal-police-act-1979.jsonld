    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Related offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.150",
      "values:originalText": "For the purposes of this Act, 2 offences are related to each other if\nthe physical elements of the 2 offences are:\n(a) substantially the same acts or omissions; or\n(b) acts or omissions in a single series.",
      "skos:definition": "For the purposes of this Act, 2 offences are related to each other if\nthe physical elements of the 2 offences are:\n(a) substantially the same acts or omissions; or\n(b) acts or omissions in a single series.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42-norm"
        }
      ],
      "cml:integrityHash": "38c41686ad2c27a9b4be221219febb3c48f338122aba513524fb85130aaef6e5",
      "skos:note": "Offences are related if they share physical elements."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Related offences",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "For the purposes of this Act, 2 offences are related to each other if\nthe physical elements of the 2 offences are:\n(a) substantially the same acts or omissions; or\n(b) acts or omissions in a single series."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42-norm",
