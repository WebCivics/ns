    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tx",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TX Commissioner to ensure that appropriate action is taken in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tx"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.125",
      "values:originalText": "relation to AFP practices issue\n(1) This section applies if:\n(a) a person gives information under section 40SA that raises an\nAFP practices issue; or\n(b) an AFP practices issue is:\n(i) brought, under section 40TK, to the attention of an AFP\nappointee; or\n(ii) identified, under section 40TW, in a report prepared\nunder section 40TU;\nas a result of an AFP conduct issue being dealt with under\nthis Part.\n(2) The Commissioner must ensure that appropriate action is taken to\nhave the issue dealt with.",
      "skos:definition": "relation to AFP practices issue\n(1) This section applies if:\n(a) a person gives information under section 40SA that raises an\nAFP practices issue; or\n(b) an AFP practices issue is:\n(i) brought, under section 40TK, to the attention of an AFP\nappointee; or\n(ii) identified, under section 40TW, in a report prepared\nunder section 40TU;\nas a result of an AFP conduct issue being dealt with under\nthis Part.\n(2) The Commissioner must ensure that appropriate action is taken to\nhave the issue dealt with.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tx-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tx-ss-2"
        }
      ],
      "cml:integrityHash": "b2a44ed0bdd10a302b82efc12d2c9d527f17be19cfa7f2028cf8731d7f09947c"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tx",
      "@type": "cof:Section",
      "cof:title": "40TX Commissioner to ensure that appropriate action is taken in",
      "values:kind": "section",
      "cof:pageNumber": 125,
      "values:originalText": "relation to AFP practices issue\n(1) This section applies if:\n(a) a person gives information under section 40SA that raises an\nAFP practices issue; or\n(b) an AFP practices issue is:\n(i) brought, under section 40TK, to the attention of an AFP\nappointee; or\n(ii) identified, under section 40TW, in a report prepared\nunder section 40TU;\nas a result of an AFP conduct issue being dealt with under\nthis Part.\n(2) The Commissioner must ensure that appropriate action is taken to\nhave the issue dealt with."
    },
