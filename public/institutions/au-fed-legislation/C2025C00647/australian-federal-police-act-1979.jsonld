    {
      "@id": "concept:australian-federal-police-act-1979-sec-49a",
      "@type": "cml:Concept",
      "skos:prefLabel": "49A Application for restraining order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.166",
      "values:originalText": "(1) Where a person (in this Division called the defendant):\n(a) has been convicted of an offence; or\n(b) has been, or is about to be, charged with an offence;\nthe DPP may apply to the appropriate court for a restraining order\nagainst specified property of the defendant or of another person, or\nboth.\n(2) For the purposes of an application, the DPP may, on behalf of the\nCommonwealth, give the court such undertakings with respect to\nthe payment of damages or costs, or both, as the court requires.",
      "skos:definition": "(1) Where a person (in this Division called the defendant):\n(a) has been convicted of an offence; or\n(b) has been, or is about to be, charged with an offence;\nthe DPP may apply to the appropriate court for a restraining order\nagainst specified property of the defendant or of another person, or\nboth.\n(2) For the purposes of an application, the DPP may, on behalf of the\nCommonwealth, give the court such undertakings with respect to\nthe payment of damages or costs, or both, as the court requires.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49a-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49a-ss-2"
        }
      ],
      "cml:integrityHash": "2a4e9c673c4fcde2f654d7d50c7e5e36294e48a80d3bb7d76dc1b0f1ac5a029e"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49a",
      "@type": "cof:Section",
      "cof:title": "49A Application for restraining order",
      "values:kind": "section",
      "cof:pageNumber": 166,
      "values:originalText": "(1) Where a person (in this Division called the defendant):\n(a) has been convicted of an offence; or\n(b) has been, or is about to be, charged with an offence;\nthe DPP may apply to the appropriate court for a restraining order\nagainst specified property of the defendant or of another person, or\nboth.\n(2) For the purposes of an application, the DPP may, on behalf of the\nCommonwealth, give the court such undertakings with respect to\nthe payment of damages or costs, or both, as the court requires."
    },
