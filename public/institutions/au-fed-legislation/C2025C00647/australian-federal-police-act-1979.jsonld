          "@id": "concept:australian-federal-police-act-1979-sec-47-ss-1a"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-47-ss-1b"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-47-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-47-ss-3"
        }
