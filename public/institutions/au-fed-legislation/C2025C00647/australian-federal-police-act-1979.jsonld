      ],
      "cml:integrityHash": "b123a19eb3015e28887a783e8259f1574a7b70be2b93c9215a6102620f9782ad",
      "skos:note": "Member or special member must cease serving in the unit after specified period."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rf-ss-6",
      "@type": "cof:Section",
      "cof:title": "40RF(6) Assignment of members, and special members, to unit",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(6) As soon as practicable after the member, or special member, has\nserved in the unit for the period specified in the assignment, the\nCommissioner must arrange for the member, or special member, to\ncease serving in the unit."
