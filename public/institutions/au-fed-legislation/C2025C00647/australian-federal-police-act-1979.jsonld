    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-51-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "51(2) Person ceases to be an AFP employee: persons charged with",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-51-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.178",
      "values:originalText": "(2) Where a court declares that property is available to satisfy a\nrecovery order:\n(a) the recovery order may be enforced against the property as if\nthe property were property of the person against whom the\norder is made; and\n(b) a restraining order may be made in respect of the property as\nif the property were property of the person against whom the\nrestructuring order is made.",
      "skos:definition": "(2) Where a court declares that property is available to satisfy a\nrecovery order:\n(a) the recovery order may be enforced against the property as if\nthe property were property of the person against whom the\norder is made; and\n(b) a restraining order may be made in respect of the property as\nif the property were property of the person against whom the\nrestructuring order is made.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-51"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-51-ss-2-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-51-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-51-ss-2-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "41f80208589be91c608e8f29246508decc65f72acf19de882bee26bb8818e1bb",
      "skos:note": "Restraining order may be made in respect of the property. The Commissioner must give a copy of a notice to the person concerned."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-51-ss-2",
      "@type": "cof:Section",
      "cof:title": "51(2) Person ceases to be an AFP employee: persons charged with",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(2) Where a court declares that property is available to satisfy a\nrecovery order:\n(a) the recovery order may be enforced against the property as if\nthe property were property of the person against whom the\norder is made; and\n(b) a restraining order may be made in respect of the property as\nif the property were property of the person against whom the\nrestructuring order is made."
    },
