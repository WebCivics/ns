      },
      "cml:premiseText": "(b) an appropriate court makes a restraining order against property in reliance on the conviction, charging or proposed charging;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-49j-ss-3-logic-cogai-5",
