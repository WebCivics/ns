      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.137",
      "values:originalText": "(2) Subsection (1) does not apply if the AFP appointee has a\nreasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "(2) Subsection (1) does not apply if the AFP appointee has a\nreasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-40vh"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-2-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-2-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "5d18b293b85f6ff5c208f5f5e8daff71d243bcc7e3bd55d80133031ed4b122b6",
      "skos:note": "Defendant bears evidential burden for reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40vh-ss-2",
      "@type": "cof:Section",
      "cof:title": "40VH(2) Offences",
      "values:kind": "subsection",
      "cof:pageNumber": 137,
      "values:originalText": "(2) Subsection (1) does not apply if the AFP appointee has a\nreasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code)."
    },
