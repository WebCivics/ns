      "cml:integrityHash": "c23921899c34dad75309e690e2f8cc46e0bbacd51f7f185b7c1460fc71dccc9d",
      "skos:note": "Defines AFP practices issue for purposes of the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ri-ss-1",
      "@type": "cof:Section",
      "cof:title": "40RI(1) AFP practices issues",
      "values:kind": "subsection",
      "cof:pageNumber": 100,
      "values:originalText": "(1) For the purposes of this Act, an AFP practices issue is an issue\nabout the practices or procedures of the Australian Federal Police\n(whether those practices or procedures are carried out within, or\noutside, Australia)."
    },
