      },
      "cml:premiseText": "(b) the AFP dog handler is performing the AFP dog handler’s duties...",
      "cml:conclusionText": "The handler must perform duties as member or protective service officer."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-12a-ss-3-logic-deontic-4",
