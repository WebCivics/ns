        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42a",
      "@type": "cml:Concept",
      "skos:prefLabel": "42A Abscond",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.150",
      "values:originalText": "For the purposes of this Part, other than subsection 46(2), a person\nis to be taken to abscond in connection with an offence if and only\nif:\n(a) the person is charged with the offence; and\n\n\nLoss of certain superannuation rights and benefits  Part VA\nIntroductory  Division 1\nSection 42B\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) a warrant for the arrest of the person is issued in relation to\nthat information; and\n(c) one of the following happens:\n(i) at the end of the period of 6 months starting on the day\non which the warrant is issued:\n(A) the person cannot be found; or\n(B) the person is, for any other reason, not\namenable to justice and, if the person is outside\nAustralia, extradition proceedings are not on\nfoot;\n(ii) at the end of the period of 6 months starting on the day\non which the warrant is issued:\n(A) the person is not amenable to justice because he\nor she is outside Australia; and\n(B) extradition proceedings are on foot;\nand those proceedings later end without an order for the\nperson’s extradition.",
      "skos:definition": "For the purposes of this Part, other than subsection 46(2), a person\nis to be taken to abscond in connection with an offence if and only\nif:\n(a) the person is charged with the offence; and\n\n\nLoss of certain superannuation rights and benefits  Part VA\nIntroductory  Division 1\nSection 42B\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) a warrant for the arrest of the person is issued in relation to\nthat information; and\n(c) one of the following happens:\n(i) at the end of the period of 6 months starting on the day\non which the warrant is issued:\n(A) the person cannot be found; or\n(B) the person is, for any other reason, not\namenable to justice and, if the person is outside\nAustralia, extradition proceedings are not on\nfoot;\n(ii) at the end of the period of 6 months starting on the day\non which the warrant is issued:\n(A) the person is not amenable to justice because he\nor she is outside Australia; and\n(B) extradition proceedings are on foot;\nand those proceedings later end without an order for the\nperson’s extradition.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42a-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4baeff19b57287a292c78227349b892ff3c4002da68fbd1293910d58c8dca3e4",
      "skos:note": "Absconding in connection with an offence is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42a",
      "@type": "cof:Section",
      "cof:title": "42A Abscond",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "For the purposes of this Part, other than subsection 46(2), a person\nis to be taken to abscond in connection with an offence if and only\nif:\n(a) the person is charged with the offence; and\n\n\nLoss of certain superannuation rights and benefits  Part VA\nIntroductory  Division 1\nSection 42B\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) a warrant for the arrest of the person is issued in relation to\nthat information; and\n(c) one of the following happens:\n(i) at the end of the period of 6 months starting on the day\non which the warrant is issued:\n(A) the person cannot be found; or\n(B) the person is, for any other reason, not\namenable to justice and, if the person is outside\nAustralia, extradition proceedings are not on\nfoot;\n(ii) at the end of the period of 6 months starting on the day\non which the warrant is issued:\n(A) the person is not amenable to justice because he\nor she is outside Australia; and\n(B) extradition proceedings are on foot;\nand those proceedings later end without an order for the\nperson’s extradition."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42a-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-42a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
