      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tk",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TK AFP practices issue identified in course of dealing with AFP",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.119",
      "values:originalText": "conduct issue\n(1) This section applies if the manager is satisfied that the information:\n(a) given under section 40SA in relation to the AFP conduct\nissue; or\n(b) obtained in the course of dealing with the AFP conduct issue;\nraises an AFP practices issue.\n(2) The manager must bring the AFP practices issue to the attention of\nan appropriate AFP appointee.\n(3) The manager may make such recommendations as the manager\nconsiders appropriate to address the AFP practices issue.\nSubdivision D—Dealing with category 3 conduct issues and\ncorruption issues\n40TL  When Subdivision applies\n(1) This Subdivision applies if:\n(a) information that is given under section 40SA raises an AFP\nconduct issue in relation to an AFP appointee; and\n(b) the issue is a category 3 conduct issue or a corruption issue.\n(2) This Subdivision also applies if:\n(a) the Commissioner decides under section 40SD that an AFP\nconduct issue in relation to an AFP appointee is to be dealt\nwith under this Part; and\n(b) the issue is a category 3 conduct issue or a corruption issue.",
      "skos:definition": "conduct issue\n(1) This section applies if the manager is satisfied that the information:\n(a) given under section 40SA in relation to the AFP conduct\nissue; or\n(b) obtained in the course of dealing with the AFP conduct issue;\nraises an AFP practices issue.\n(2) The manager must bring the AFP practices issue to the attention of\nan appropriate AFP appointee.\n(3) The manager may make such recommendations as the manager\nconsiders appropriate to address the AFP practices issue.\nSubdivision D—Dealing with category 3 conduct issues and\ncorruption issues\n40TL  When Subdivision applies\n(1) This Subdivision applies if:\n(a) information that is given under section 40SA raises an AFP\nconduct issue in relation to an AFP appointee; and\n(b) the issue is a category 3 conduct issue or a corruption issue.\n(2) This Subdivision also applies if:\n(a) the Commissioner decides under section 40SD that an AFP\nconduct issue in relation to an AFP appointee is to be dealt\nwith under this Part; and\n(b) the issue is a category 3 conduct issue or a corruption issue.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-3"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-2"
        }
      ],
      "cml:integrityHash": "84f5c45316789c13ac36c5fae8ef876296bd1e8cefcfb1c7d234e3742e0beaeb"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tk",
      "@type": "cof:Section",
      "cof:title": "40TK AFP practices issue identified in course of dealing with AFP",
      "values:kind": "section",
      "cof:pageNumber": 119,
      "values:originalText": "conduct issue\n(1) This section applies if the manager is satisfied that the information:\n(a) given under section 40SA in relation to the AFP conduct\nissue; or\n(b) obtained in the course of dealing with the AFP conduct issue;\nraises an AFP practices issue.\n(2) The manager must bring the AFP practices issue to the attention of\nan appropriate AFP appointee.\n(3) The manager may make such recommendations as the manager\nconsiders appropriate to address the AFP practices issue.\nSubdivision D—Dealing with category 3 conduct issues and\ncorruption issues\n40TL  When Subdivision applies\n(1) This Subdivision applies if:\n(a) information that is given under section 40SA raises an AFP\nconduct issue in relation to an AFP appointee; and\n(b) the issue is a category 3 conduct issue or a corruption issue.\n(2) This Subdivision also applies if:\n(a) the Commissioner decides under section 40SD that an AFP\nconduct issue in relation to an AFP appointee is to be dealt\nwith under this Part; and\n(b) the issue is a category 3 conduct issue or a corruption issue."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tk-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TK(1) AFP practices issue identified in course of dealing with AFP",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tk-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
