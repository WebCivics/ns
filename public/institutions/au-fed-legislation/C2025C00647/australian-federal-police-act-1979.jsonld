    {
      "@id": "concept:australian-federal-police-act-1979-sec-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "3A Overview of Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.13",
      "values:originalText": "Constitution of the Australian Federal Police\n(1) Division 1 of Part II of this Act provides that the Australian\nFederal Police consists of a Commissioner of Police, one or more\nDeputy Commissioners of Police, AFP employees, special\nmembers and special protective service officers.\nCommissioner and Deputy Commissioners\n(2) The Commissioner and Deputy Commissioners are appointed by\nthe Governor-General. Division 1 of Part III sets out matters\ndealing with such appointments.",
      "skos:definition": "Constitution of the Australian Federal Police\n(1) Division 1 of Part II of this Act provides that the Australian\nFederal Police consists of a Commissioner of Police, one or more\nDeputy Commissioners of Police, AFP employees, special\nmembers and special protective service officers.\nCommissioner and Deputy Commissioners\n(2) The Commissioner and Deputy Commissioners are appointed by\nthe Governor-General. Division 1 of Part III sets out matters\ndealing with such appointments.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-3a-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-3a-ss-2"
        }
      ],
      "cml:integrityHash": "83df721eebfe61146126f387af402b21040d01a219c29e817eb7d0fcb3c72f24"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-3a",
      "@type": "cof:Section",
      "cof:title": "3A Overview of Act",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Constitution of the Australian Federal Police\n(1) Division 1 of Part II of this Act provides that the Australian\nFederal Police consists of a Commissioner of Police, one or more\nDeputy Commissioners of Police, AFP employees, special\nmembers and special protective service officers.\nCommissioner and Deputy Commissioners\n(2) The Commissioner and Deputy Commissioners are appointed by\nthe Governor-General. Division 1 of Part III sets out matters\ndealing with such appointments."
    },
