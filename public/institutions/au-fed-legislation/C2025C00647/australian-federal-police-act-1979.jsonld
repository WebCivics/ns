        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40sa-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d13626db1f87511238db544d1bbbdccfb55936a04ce8fb7df1e877d4e0acf83f",
      "skos:note": "The AFP appointee may require the person giving information to reduce it to writing."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40sa-ss-4",
      "@type": "cof:Section",
      "cof:title": "40SA(4) Giving information that raises an AFP conduct or practices",
      "values:kind": "subsection",
      "cof:pageNumber": 106,
      "values:originalText": "(4) If the person gives the information orally, the Commissioner, the\nAFP appointee to whom the information is given or the AFP\nappointee or other person to whom the issue is allocated:\n(a) may reduce the information to writing; and\n(b) may, at any time, require the person giving the information to\nreduce the information to writing; and\n(c) may, if he or she makes a requirement under paragraph (b),\ndecline to take any further action in relation to the\ninformation until the person giving the information reduces\nthe information to writing."
    },
