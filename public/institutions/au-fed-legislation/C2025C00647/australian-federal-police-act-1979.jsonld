    {
      "@id": "concept:australian-federal-police-act-1979-sec-68a",
      "@type": "cml:Concept",
      "skos:prefLabel": "68A Certificates in relation to transferred PSOs",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-68a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.195",
      "values:originalText": "(1) This section applies in relation to a person who is a transferred\nPSO, instead of subsection 68(4A).\n(2) The Commissioner may, by writing signed by the Commissioner,\ncertify that a specified person is a transferred PSO.\n(3) The Commissioner may also certify either or both of the following\nin relation to the person:\n(a) that the person made and subscribed an oath or affirmation\nunder section 10 of the Australian Protective Service Act\n1987;\n(b) that the person is, on the date on which the certificate is\nsigned, a protective service officer and has been such a\nprotective service officer continuously since being appointed\nunder section 9 of the Australian Protective Service Act\n1987.",
      "skos:definition": "(1) This section applies in relation to a person who is a transferred\nPSO, instead of subsection 68(4A).\n(2) The Commissioner may, by writing signed by the Commissioner,\ncertify that a specified person is a transferred PSO.\n(3) The Commissioner may also certify either or both of the following\nin relation to the person:\n(a) that the person made and subscribed an oath or affirmation\nunder section 10 of the Australian Protective Service Act\n1987;\n(b) that the person is, on the date on which the certificate is\nsigned, a protective service officer and has been such a\nprotective service officer continuously since being appointed\nunder section 9 of the Australian Protective Service Act\n1987.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-68a-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-68a-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-68a-ss-3"
        }
      ],
      "cml:integrityHash": "4cc3874c0735a797aa4599fe4aeec7a1012cd5ef349d5dacf8ddc2704a1f5a79"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-68a",
      "@type": "cof:Section",
      "cof:title": "68A Certificates in relation to transferred PSOs",
      "values:kind": "section",
      "cof:pageNumber": 195,
      "values:originalText": "(1) This section applies in relation to a person who is a transferred\nPSO, instead of subsection 68(4A).\n(2) The Commissioner may, by writing signed by the Commissioner,\ncertify that a specified person is a transferred PSO.\n(3) The Commissioner may also certify either or both of the following\nin relation to the person:\n(a) that the person made and subscribed an oath or affirmation\nunder section 10 of the Australian Protective Service Act\n1987;\n(b) that the person is, on the date on which the certificate is\nsigned, a protective service officer and has been such a\nprotective service officer continuously since being appointed\nunder section 9 of the Australian Protective Service Act\n1987."
    },
