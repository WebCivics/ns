      "cml:integrityHash": "9ccbcb8295506b2231821376283a60cca60f457e7defe603c1d484f7add906ca",
      "skos:note": "An AFP practices issue includes an issue of whether a practice or procedure is contrary to law, unreasonable, unjust, oppressive, discriminatory, inadequate, or otherwise wrong or inappropriate."
    },
