      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of refusal to comply with direction.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) refuses or fails to comply with a direction given under subsection 40VE(1) or 40VG(2);",
      "cml:conclusionText": "An AFP appointee commits an offence if the AFP appointee:\n(a) refuses or fails to comply with a direction given under subsection 40VE(1) or 40VG(2);"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of refusal to be sworn/affirmed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) refuses or fails to be sworn or make an affirmation, when\nrequired to do so under subsection 40VG(2);",
      "cml:conclusionText": "An AFP appointee commits an offence if the AFP appointee:\n(b) refuses or fails to be sworn or make an affirmation, when\nrequired to do so under subsection 40VG(2);"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of giving false information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) gives information or makes a statement to the investigator\nknowing that it is false or misleading in a material particular.",
      "cml:conclusionText": "An AFP appointee commits an offence if the AFP appointee:\n(c) gives information or makes a statement to the investigator\nknowing that it is false or misleading in a material particular."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "40VH(2) Offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40vh-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
