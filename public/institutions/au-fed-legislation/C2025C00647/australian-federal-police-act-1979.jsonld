      "cml:integrityHash": "abd21ccfd7f8f140c3253b0a14d8f0953d389f5e32e011ba6ad123d9b961e2a7",
      "skos:note": "Document purporting to be signed or sealed by superannuation authority is taken as authentic unless proven otherwise."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-45a-ss-6",
      "@type": "cof:Section",
      "cof:title": "45A(6) Application for superannuation order: evidence",
      "values:kind": "subsection",
