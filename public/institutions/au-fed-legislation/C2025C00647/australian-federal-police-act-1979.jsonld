    {
      "@id": "concept:australian-federal-police-act-1979-sec-70",
      "@type": "cml:Concept",
      "skos:prefLabel": "70 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-70"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.199",
      "values:originalText": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing all matters required or permitted by this Act to\nbe prescribed, or necessary or convenient to be prescribed, for\nsecuring the discipline and good government of the Australian\nFederal Police, or for otherwise carrying out or giving effect to this\nAct, and, in particular, making provision for and in relation to:\n(a) the return to the Commissioner by a person who has ceased\nto be an AFP employee, a special member or a special\nprotective service officer of property (including\naccoutrements and clothing) supplied to him or her for the\npurposes of his or her service as an AFP employee, a special\nmember or a special protective service officer or in his or her",
      "skos:definition": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing all matters required or permitted by this Act to\nbe prescribed, or necessary or convenient to be prescribed, for\nsecuring the discipline and good government of the Australian\nFederal Police, or for otherwise carrying out or giving effect to this\nAct, and, in particular, making provision for and in relation to:\n(a) the return to the Commissioner by a person who has ceased\nto be an AFP employee, a special member or a special\nprotective service officer of property (including\naccoutrements and clothing) supplied to him or her for the\npurposes of his or her service as an AFP employee, a special\nmember or a special protective service officer or in his or her",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-70-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-70-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "79bd1cf1ba8ce6adea83735d82cdccefcc3a4b795b1098ac0b4b0756f6bc8087",
      "skos:note": "The Governor-General may make regulations for securing discipline and good government of the Australian Federal Police."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Regulations",
      "values:kind": "section",
      "cof:pageNumber": 199,
      "values:originalText": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing all matters required or permitted by this Act to\nbe prescribed, or necessary or convenient to be prescribed, for\nsecuring the discipline and good government of the Australian\nFederal Police, or for otherwise carrying out or giving effect to this\nAct, and, in particular, making provision for and in relation to:\n(a) the return to the Commissioner by a person who has ceased\nto be an AFP employee, a special member or a special\nprotective service officer of property (including\naccoutrements and clothing) supplied to him or her for the\npurposes of his or her service as an AFP employee, a special\nmember or a special protective service officer or in his or her"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-70-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-70"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-70-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Implies obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
