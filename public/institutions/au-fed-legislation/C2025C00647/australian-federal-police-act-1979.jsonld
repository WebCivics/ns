      "cml:integrityHash": "f408873eb3dad4e09ae3b7bc6efdf0f0470346c71b129faf010ff2477bab3f64",
      "skos:note": "Prevents payment of another amount under certain subsections."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-54a-ss-1",
      "@type": "cof:Section",
      "cof:title": "54A(1) Multiple payments in respect of same employee contributions",
      "values:kind": "subsection",
