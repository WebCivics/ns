    {
      "@id": "concept:australian-federal-police-act-1979-sec-63b",
      "@type": "cml:Concept",
      "skos:prefLabel": "63B Possession of documents etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-63b"
      },
      "cml:curationStatus": {
