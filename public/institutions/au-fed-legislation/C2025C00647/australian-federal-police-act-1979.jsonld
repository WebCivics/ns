        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49b-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ccf5d529fbb3f476f435d32cb8c05954d304d5c0c3d4ed903da2d050d91f556f",
      "skos:note": "Court can make restraining order against property with value more than payable by defendant under recovery order."
    },
    {
