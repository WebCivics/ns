        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A restraining order ceases to have effect if any of the following things happen:",
      "cml:conclusionText": "...the defendant is acquitted of the offence, or the charge is withdrawn or otherwise disposed of without conviction and the defendant has not been charged with a related corruption offence before the acquittal, withdrawal or disposal."
    },
    {
