      },
      "cml:operator": "during",
      "cml:logicSummary": "During certain periods",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) property of the Commonwealth (including Commonwealth places) and property of authorities of the Commonwealth;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-8-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implication of provision of services",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the provision of police services in relation to:"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-8-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:logicSummary": "Has obligation to perform functions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(be) to perform such protective and custodial functions as the Minister directs by notice in writing in the Gazette;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-8-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:logicSummary": "Has obligation to assist or cooperate with international organisations",
      "cml:executionSurface": "modalities::logic::deontic",
