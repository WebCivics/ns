    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vc",
      "@type": "cml:Concept",
      "skos:prefLabel": "40VC Obtaining information and making inquiries",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40vc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.130",
      "values:originalText": "(1) For the purposes of the investigation or inquiry, the investigator\nmay obtain information from such persons, and make such\ninquiries, as he or she thinks fit.\n(2) Subsection (1) has effect subject to this Division.",
      "skos:definition": "(1) For the purposes of the investigation or inquiry, the investigator\nmay obtain information from such persons, and make such\ninquiries, as he or she thinks fit.\n(2) Subsection (1) has effect subject to this Division.",
