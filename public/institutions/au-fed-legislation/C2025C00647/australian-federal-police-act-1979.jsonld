    {
      "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "40VH(3) Offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40vh-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.137",
      "values:originalText": "(3) In any proceedings for an offence against subsection (1), the\nprosecution bears the onus of proving that:\n(a) the investigator complied with subsection 40VE(2) in\nrelation to a direction under subsection 40VE(1); or\n(b) the investigator complied with subsection 40VG(3) in\nrelation to a direction under subsection 40VG(2).",
      "skos:definition": "(3) In any proceedings for an offence against subsection (1), the\nprosecution bears the onus of proving that:\n(a) the investigator complied with subsection 40VE(2) in\nrelation to a direction under subsection 40VE(1); or\n(b) the investigator complied with subsection 40VG(3) in\nrelation to a direction under subsection 40VG(2).",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-40vh"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-3-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-3-logic-deontic-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40vh-ss-3-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "8a1ddc56ea14413b7b7d8ae75d963c0cf34aac0a73578dca822177e045fd9239",
      "skos:note": "Prosecution must prove investigator compliance with certain directions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40vh-ss-3",
      "@type": "cof:Section",
      "cof:title": "40VH(3) Offences",
      "values:kind": "subsection",
      "cof:pageNumber": 137,
      "values:originalText": "(3) In any proceedings for an offence against subsection (1), the\nprosecution bears the onus of proving that:\n(a) the investigator complied with subsection 40VE(2) in\nrelation to a direction under subsection 40VE(1); or\n(b) the investigator complied with subsection 40VG(3) in\nrelation to a direction under subsection 40VG(2)."
    },
