      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.103",
      "values:originalText": "(1) A category 1 conduct issue is an issue of whether an AFP\nappointee has engaged in category 1 conduct.\n(2) A category 2 conduct issue is an issue of whether an AFP\nappointee has engaged in category 2 conduct.\n(3) A category 3 conduct issue is an issue of whether an AFP\nappointee has engaged in category 3 conduct.",
      "skos:definition": "(1) A category 1 conduct issue is an issue of whether an AFP\nappointee has engaged in category 1 conduct.\n(2) A category 2 conduct issue is an issue of whether an AFP\nappointee has engaged in category 2 conduct.\n(3) A category 3 conduct issue is an issue of whether an AFP\nappointee has engaged in category 3 conduct.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rl-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rl-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rl-ss-3"
        }
      ],
      "cml:integrityHash": "5b2f6bd2dd7c34f1d70393553d00978ed8faa5c3814263b0a55607819a79cbc9"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rl",
      "@type": "cof:Section",
      "cof:title": "40RL Categories of AFP conduct issues",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "(1) A category 1 conduct issue is an issue of whether an AFP\nappointee has engaged in category 1 conduct.\n(2) A category 2 conduct issue is an issue of whether an AFP\nappointee has engaged in category 2 conduct.\n(3) A category 3 conduct issue is an issue of whether an AFP\nappointee has engaged in category 3 conduct."
    },
