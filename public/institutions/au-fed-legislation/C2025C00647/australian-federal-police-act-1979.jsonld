    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ra",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RA Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ra"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.95",
      "values:originalText": "The object of this Part is to establish the procedures by which:\n(a) AFP conduct issues and AFP practices issues; and\n(b) other issues related to the Australian Federal Police;\nmay be raised and dealt with.",
      "skos:definition": "The object of this Part is to establish the procedures by which:\n(a) AFP conduct issues and AFP practices issues; and\n(b) other issues related to the Australian Federal Police;\nmay be raised and dealt with.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40ra-norm"
        }
      ],
      "cml:integrityHash": "1830c7261206ca51709f6e6922702f4b821464e2efd7949e9cbdaf5b35058f33",
      "skos:note": "Establishes procedures for AFP conduct and practices issues"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ra",
      "@type": "cof:Section",
      "cof:title": "40RA Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "The object of this Part is to establish the procedures by which:\n(a) AFP conduct issues and AFP practices issues; and\n(b) other issues related to the Australian Federal Police;\nmay be raised and dealt with."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ra-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
