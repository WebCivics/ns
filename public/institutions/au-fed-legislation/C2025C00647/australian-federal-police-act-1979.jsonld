    {
      "@id": "concept:australian-federal-police-act-1979-sec-40n",
      "@type": "cml:Concept",
      "skos:prefLabel": "40N Alcohol screening tests, alcohol breath tests and prohibited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.89",
      "values:originalText": "drug tests after certain incidents\nPerson killed or seriously injured in an incident involving a motor\nvehicle or vessel or while in police custody\n(1) If:\n(a) a person is killed or seriously injured as a result of an\nincident involving a motor vehicle or vessel; or",
      "skos:definition": "drug tests after certain incidents\nPerson killed or seriously injured in an incident involving a motor\nvehicle or vessel or while in police custody\n(1) If:\n(a) a person is killed or seriously injured as a result of an\nincident involving a motor vehicle or vessel; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40n-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "67712e64afcb213e2b5606a6cfec31c90a23beaf8b1a688892f3596bf6164cd7",
      "skos:note": "Drug tests after certain incidents"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40n",
      "@type": "cof:Section",
      "cof:title": "40N Alcohol screening tests, alcohol breath tests and prohibited",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "drug tests after certain incidents\nPerson killed or seriously injured in an incident involving a motor\nvehicle or vessel or while in police custody\n(1) If:\n(a) a person is killed or seriously injured as a result of an\nincident involving a motor vehicle or vessel; or"
    },
