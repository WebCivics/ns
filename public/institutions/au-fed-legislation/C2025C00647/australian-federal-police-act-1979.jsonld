    {
      "@id": "concept:australian-federal-police-act-1979-sec-42h",
      "@type": "cml:Concept",
      "skos:prefLabel": "42H Application of Part to convictions and offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.155",
      "values:originalText": "(1) This Part does not apply to a person’s conviction of an offence if\nthe conviction happened before the commencing day.\n(2) This Part applies to an offence committed, or believed to have been\ncommitted, at any time, whether before, on or after the\ncommencing day.",
      "skos:definition": "(1) This Part does not apply to a person’s conviction of an offence if\nthe conviction happened before the commencing day.\n(2) This Part applies to an offence committed, or believed to have been\ncommitted, at any time, whether before, on or after the\ncommencing day.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42h-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42h-ss-2"
        }
      ],
      "cml:integrityHash": "106c1584b3af607b67fa18995aab9fd8c65c64154fdffd8845c768c977b75f42"
    },
    {
