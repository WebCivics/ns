          "@id": "concept:australian-federal-police-act-1979-sec-40va-ss-1-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "6afd7d47fde3db2f79b466f4426773770ee17e708cce36316554c165b3eecc1b",
      "skos:note": "This Division applies if a person (the investigator) is investigating a category 3 conduct issue or a corruption issue under Division 3."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40va-ss-1",
      "@type": "cof:Section",
      "cof:title": "40VA(1) Application of Division",
      "values:kind": "subsection",
      "cof:pageNumber": 129,
      "values:originalText": "(1) This Division applies if a person (the investigator):\n(a) is investigating a category 3 conduct issue or a corruption\nissue under Division 3; or\n(b) is conducting an inquiry under Division 4."
    },
