      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.41",
      "values:originalText": "Where:\n(a) a person has been arrested by a protective service officer for\nan offence; and\n(b) the person is in the custody of the protective service officer\nor another protective service officer; and\n(c) the protective service officer who has the custody of the\nperson:",
      "skos:definition": "Where:\n(a) a person has been arrested by a protective service officer for\nan offence; and\n(b) the person is in the custody of the protective service officer\nor another protective service officer; and\n(c) the protective service officer who has the custody of the\nperson:",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14f-norm"
        }
      ],
      "cml:integrityHash": "173994aed163cb2d1e83467129703eb662f898a7175e2a381bd0db0bb27ee72f",
      "skos:note": "Conditions for release of arrested person"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14f",
      "@type": "cof:Section",
      "cof:title": "14F Release of arrested person",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Where:\n(a) a person has been arrested by a protective service officer for\nan offence; and\n(b) the person is in the custody of the protective service officer\nor another protective service officer; and\n(c) the protective service officer who has the custody of the\nperson:"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14f-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
