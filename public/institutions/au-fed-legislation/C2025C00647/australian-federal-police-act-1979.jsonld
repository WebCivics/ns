    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tn-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TN(3) Head of unit constituted under section 40RD generally",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tn-ss-3"
      },
      "cml:curationStatus": {
