      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tc",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TC Training and development action",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.112",
      "values:originalText": "(1) For the purposes of this Act, training and development action in\nrelation to an AFP appointee is action taken to improve the\nappointee’s performance through training and development.\n(2) Without limiting subsection (1), training and development action\nin relation to the AFP appointee may take one or more of the\nfollowing forms:\n(a) coaching the AFP appointee or making arrangements for the\nAFP appointee to be coached;\n(b) mentoring the AFP appointee or making arrangements for the\nAFP appointee to be mentored;\n(c) making arrangements for the AFP appointee to undertake\ntraining activities;\n(d) making arrangements for the AFP appointee to undertake\ndevelopment activities;\n(e) increasing, or making arrangements for increasing, the level\nof supervision of the AFP appointee’s work.",
      "skos:definition": "(1) For the purposes of this Act, training and development action in\nrelation to an AFP appointee is action taken to improve the\nappointee’s performance through training and development.\n(2) Without limiting subsection (1), training and development action\nin relation to the AFP appointee may take one or more of the\nfollowing forms:\n(a) coaching the AFP appointee or making arrangements for the\nAFP appointee to be coached;\n(b) mentoring the AFP appointee or making arrangements for the\nAFP appointee to be mentored;\n(c) making arrangements for the AFP appointee to undertake\ntraining activities;\n(d) making arrangements for the AFP appointee to undertake\ndevelopment activities;\n(e) increasing, or making arrangements for increasing, the level\nof supervision of the AFP appointee’s work.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tc-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tc-ss-2"
        }
      ],
      "cml:integrityHash": "e95e66f20bc1537cbc4ca584ccb6f938cb3cd10ee678b8688e11eb5e4df92f67"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tc",
      "@type": "cof:Section",
      "cof:title": "40TC Training and development action",
      "values:kind": "section",
      "cof:pageNumber": 112,
      "values:originalText": "(1) For the purposes of this Act, training and development action in\nrelation to an AFP appointee is action taken to improve the\nappointee’s performance through training and development.\n(2) Without limiting subsection (1), training and development action\nin relation to the AFP appointee may take one or more of the\nfollowing forms:\n(a) coaching the AFP appointee or making arrangements for the\nAFP appointee to be coached;\n(b) mentoring the AFP appointee or making arrangements for the\nAFP appointee to be mentored;\n(c) making arrangements for the AFP appointee to undertake\ntraining activities;\n(d) making arrangements for the AFP appointee to undertake\ndevelopment activities;\n(e) increasing, or making arrangements for increasing, the level\nof supervision of the AFP appointee’s work."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tc-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TC(1) Training and development action",
      "cml:realizedBy": {
