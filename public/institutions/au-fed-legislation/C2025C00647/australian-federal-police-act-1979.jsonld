    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Appointment of members to other Police Forces",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.35",
      "values:originalText": "Nothing in this Act is intended to prevent a member or special\nmember from being appointed (including at a particular rank) as:\n(a) a member, however described, of the police force of a State\nor Territory; or\n(b) a special constable, however described, of the police force of\na State or Territory; or\n(c) a member, however described, of a police force or other law\nenforcement agency of a foreign country.",
      "skos:definition": "Nothing in this Act is intended to prevent a member or special\nmember from being appointed (including at a particular rank) as:\n(a) a member, however described, of the police force of a State\nor Territory; or\n(b) a special constable, however described, of the police force of\na State or Territory; or\n(c) a member, however described, of a police force or other law\nenforcement agency of a foreign country.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-10-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2482f357c16a495b785b30270ec0466c16a1420c4514611964829b63b8426544",
      "skos:note": "Allowing members to be appointed in other police forces or agencies."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Appointment of members to other Police Forces",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Nothing in this Act is intended to prevent a member or special\nmember from being appointed (including at a particular rank) as:\n(a) a member, however described, of the police force of a State\nor Territory; or\n(b) a special constable, however described, of the police force of\na State or Territory; or\n(c) a member, however described, of a police force or other law\nenforcement agency of a foreign country."
    },
    {
