      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.158",
      "values:originalText": "(6) A document purporting to be signed or sealed by a person’s\nsuperannuation authority is to be taken to have been signed or duly\nsealed by that superannuation authority unless the contrary is\nproved.",
      "skos:definition": "(6) A document purporting to be signed or sealed by a person’s\nsuperannuation authority is to be taken to have been signed or duly\nsealed by that superannuation authority unless the contrary is\nproved.",
