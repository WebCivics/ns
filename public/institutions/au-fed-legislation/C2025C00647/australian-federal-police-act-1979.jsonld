        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-67-ss-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "3c8f007d075da5c674a9fb64506143b0a6e407e42a88dbef3747c6af26ebbd72",
