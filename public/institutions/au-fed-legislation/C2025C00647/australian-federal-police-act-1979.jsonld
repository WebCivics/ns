    {
      "@id": "concept:australian-federal-police-act-1979-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Recognition of previous service for certain purposes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.202",
      "values:originalText": "For the purposes of this Act, the Superannuation Act 1976, the\nMaternity Leave (Commonwealth Employees) Act 1973 and the\nLong Service Leave (Commonwealth Employees) Act 1976, service\nof a person as a member of the Australian Federal Police shall be\ndeemed to include service of that person as a member of an\nexisting Police Force.",
      "skos:definition": "For the purposes of this Act, the Superannuation Act 1976, the\nMaternity Leave (Commonwealth Employees) Act 1973 and the\nLong Service Leave (Commonwealth Employees) Act 1976, service\nof a person as a member of the Australian Federal Police shall be\ndeemed to include service of that person as a member of an\nexisting Police Force.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-75-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-75-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-75-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "57812327d877770a4a5bbced916abaa4774be33728f28455ba5c46a9968ffb9e",
      "skos:note": "Deems service of AFP member as existing Police Force member for certain purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Recognition of previous service for certain purposes",
      "values:kind": "section",
      "cof:pageNumber": 202,
      "values:originalText": "For the purposes of this Act, the Superannuation Act 1976, the\nMaternity Leave (Commonwealth Employees) Act 1973 and the\nLong Service Leave (Commonwealth Employees) Act 1976, service\nof a person as a member of the Australian Federal Police shall be\ndeemed to include service of that person as a member of an\nexisting Police Force."
    },
