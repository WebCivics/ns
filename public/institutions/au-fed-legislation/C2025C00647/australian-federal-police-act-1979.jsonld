      "cml:integrityHash": "b10543dfcffa7a351b00c85494ecc3161c91b26d90b20dfbc424c0cb3f99160d",
      "skos:note": "The Minister must receive a recommendation from the Commissioner before declaring a member a commissioned police officer."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40d-ss-2",
      "@type": "cof:Section",
      "cof:title": "40D(2) Commissioned police officers",
      "values:kind": "subsection",
      "cof:pageNumber": 76,
      "values:originalText": "(2) Before the Governor-General makes a declaration under\nsubsection (1), the Minister must have received a recommendation\nfrom the Commissioner that the member be declared to be a\ncommissioned police officer."
    },
