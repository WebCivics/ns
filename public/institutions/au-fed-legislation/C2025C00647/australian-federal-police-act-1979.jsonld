      },
      "cml:premiseText": "(2) A person appointed under subsection (1)",
      "cml:conclusionText": "has any powers and duties that are expressly conferred or imposed on special members"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ea",
      "@type": "cml:Concept",
      "skos:prefLabel": "40EA AFP employees who are protective service officers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ea"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.79",
      "values:originalText": "The Commissioner may, by writing, declare an AFP employee\n(other than a member) to be a protective service officer of the\nAustralian Federal Police if the Commissioner is satisfied that the\nemployee meets the requirements specified in a determination\nunder section 40EB.\nNote 1:\nA person who is currently a member may be declared to be a\nprotective service officer if the person ceases to be a member.\nNote 2:\nThis section does not prevent a member from being appointed as a\nspecial protective service officer.",
      "skos:definition": "The Commissioner may, by writing, declare an AFP employee\n(other than a member) to be a protective service officer of the\nAustralian Federal Police if the Commissioner is satisfied that the\nemployee meets the requirements specified in a determination\nunder section 40EB.\nNote 1:\nA person who is currently a member may be declared to be a\nprotective service officer if the person ceases to be a member.\nNote 2:\nThis section does not prevent a member from being appointed as a\nspecial protective service officer.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40ea-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40ea-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "214402423a8ae4688ab66d6f6cd2445672c9ed3d9ee743d3fb8939d91495c418",
      "skos:note": "Commissioner may declare AFP employee a protective service officer if they meet requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ea",
      "@type": "cof:Section",
      "cof:title": "40EA AFP employees who are protective service officers",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "The Commissioner may, by writing, declare an AFP employee\n(other than a member) to be a protective service officer of the\nAustralian Federal Police if the Commissioner is satisfied that the\nemployee meets the requirements specified in a determination\nunder section 40EB.\nNote 1:\nA person who is currently a member may be declared to be a\nprotective service officer if the person ceases to be a member.\nNote 2:\nThis section does not prevent a member from being appointed as a\nspecial protective service officer."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ea-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-40ea"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ea-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Declaration is an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40eb",
      "@type": "cml:Concept",
      "skos:prefLabel": "40EB Determination of competency or qualification requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40eb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.79",
      "values:originalText": "The Commissioner may, by written determination, specify either or\nboth of the following for the purposes of section 40EA:\n(a) competency requirements;\n(b) qualification requirements.",
      "skos:definition": "The Commissioner may, by written determination, specify either or\nboth of the following for the purposes of section 40EA:\n(a) competency requirements;\n(b) qualification requirements.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40eb-norm"
        }
      ],
      "cml:integrityHash": "13f86a63cf3133d6184dbc06860eb5c27383b552d3e3e21b75c96f2444e1a170",
      "skos:note": "Commissioner may specify competency and qualification requirements by written determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40eb",
      "@type": "cof:Section",
      "cof:title": "40EB Determination of competency or qualification requirements",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "The Commissioner may, by written determination, specify either or\nboth of the following for the purposes of section 40EA:\n(a) competency requirements;\n(b) qualification requirements."
    },
