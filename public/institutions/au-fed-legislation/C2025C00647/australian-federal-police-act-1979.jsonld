      "cml:logicSummary": "Regulations must provide written reasons for decisions and a copy of those reasons to the AFP employee concerned.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
