    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-12a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "12A(4) Immunity from State and Territory laws in relation to entry",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-12a-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.36",
      "values:originalText": "(4) In any proceeding, a certificate in writing signed by the\nCommissioner certifying that:\n(a) a specified member or specified protective service officer is,\nor was at a specified time, an AFP dog handler within the\nmeaning of this section; or\n(b) a specified dog is, or was at a specified time, an AFP dog\nwithin the meaning of this section;\nis prima facie evidence of the fact or facts certified.",
      "skos:definition": "(4) In any proceeding, a certificate in writing signed by the\nCommissioner certifying that:\n(a) a specified member or specified protective service officer is,\nor was at a specified time, an AFP dog handler within the\nmeaning of this section; or\n(b) a specified dog is, or was at a specified time, an AFP dog\nwithin the meaning of this section;\nis prima facie evidence of the fact or facts certified.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-12a"
      },
      "cml:asserts": [
