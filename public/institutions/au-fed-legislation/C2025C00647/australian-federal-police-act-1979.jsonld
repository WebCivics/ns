      },
      "cml:premiseText": "The Commissioner is authorized to sign certificates",
      "cml:conclusionText": "The Commissioner must certify special member appointment details"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-67-ss-3-logic-alleninterval-2",
