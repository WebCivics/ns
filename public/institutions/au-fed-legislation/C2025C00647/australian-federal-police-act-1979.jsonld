    {
      "@id": "concept:australian-federal-police-act-1979-sec-14n",
      "@type": "cml:Concept",
      "skos:prefLabel": "14N Relationship of Division to other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.53",
      "values:originalText": "The powers conferred, and duties imposed, by this Division on\nprotective service officers, members and special members are in\naddition to, and not in derogation of, any other powers conferred,\nor duties imposed, by any other law of the Commonwealth or the\nlaw of a State or Territory, and this Division is not intended to\nexclude or limit the operation of any other law of the\nCommonwealth or the law of a State or Territory in so far as it is\ncapable of operating concurrently with this Division.",
      "skos:definition": "The powers conferred, and duties imposed, by this Division on\nprotective service officers, members and special members are in\naddition to, and not in derogation of, any other powers conferred,\nor duties imposed, by any other law of the Commonwealth or the\nlaw of a State or Territory, and this Division is not intended to\nexclude or limit the operation of any other law of the\nCommonwealth or the law of a State or Territory in so far as it is\ncapable of operating concurrently with this Division.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14n-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "93c50057199178bfb1710bc0dcb3c7ef58a46cef9dae5ffd3fcf8fc0867c70eb",
      "skos:note": "No other laws can limit or exclude this Division's powers and duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14n",
      "@type": "cof:Section",
      "cof:title": "14N Relationship of Division to other laws",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "The powers conferred, and duties imposed, by this Division on\nprotective service officers, members and special members are in\naddition to, and not in derogation of, any other powers conferred,\nor duties imposed, by any other law of the Commonwealth or the\nlaw of a State or Territory, and this Division is not intended to\nexclude or limit the operation of any other law of the\nCommonwealth or the law of a State or Territory in so far as it is\ncapable of operating concurrently with this Division."
    },
    {
