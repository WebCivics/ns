    {
      "@id": "concept:australian-federal-police-act-1979-sec-14d",
      "@type": "cml:Concept",
      "skos:prefLabel": "14D Search of arrested person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.39",
      "values:originalText": "(1) A protective service officer may, upon lawfully arresting a person\nfor an offence:\n(a) conduct an ordinary search or a frisk search of the person;\nand\n(b) search the clothing that the person is wearing and any vessel,\nvehicle or other property under the person’s immediate\ncontrol if the officer believes on reasonable grounds that it is\nnecessary to do so;",
      "skos:definition": "(1) A protective service officer may, upon lawfully arresting a person\nfor an offence:\n(a) conduct an ordinary search or a frisk search of the person;\nand\n(b) search the clothing that the person is wearing and any vessel,\nvehicle or other property under the person’s immediate\ncontrol if the officer believes on reasonable grounds that it is\nnecessary to do so;",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14d-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "448c522935f20a2c1243cdaf81721686cd400285f1cbb06bab4080760876b696",
      "skos:note": "Lawful arrest allows for search of person and property."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14d",
      "@type": "cof:Section",
      "cof:title": "14D Search of arrested person",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "(1) A protective service officer may, upon lawfully arresting a person\nfor an offence:\n(a) conduct an ordinary search or a frisk search of the person;\nand\n(b) search the clothing that the person is wearing and any vessel,\nvehicle or other property under the person’s immediate\ncontrol if the officer believes on reasonable grounds that it is\nnecessary to do so;"
    },
