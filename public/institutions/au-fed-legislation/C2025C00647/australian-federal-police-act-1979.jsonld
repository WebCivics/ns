    {
      "@id": "concept:australian-federal-police-act-1979-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Commissioner’s Orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.74",
      "values:originalText": "In the exercise of his or her powers under section 37, the\nCommissioner may, by writing, issue orders with respect to the\ngeneral administration of, and the control of the operations of, the\nAustralian Federal Police.",
      "skos:definition": "In the exercise of his or her powers under section 37, the\nCommissioner may, by writing, issue orders with respect to the\ngeneral administration of, and the control of the operations of, the\nAustralian Federal Police.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-38-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-38-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cffa21a6bb0fb4c29511f5f07ce75d3723ce5a4731ab8a5ee4397f94f097eacd",
      "skos:note": "The Commissioner may issue orders with respect to the general administration and control of the Australian Federal Police."
    },
    {
