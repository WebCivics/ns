        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A charge on property of a person ceases to have effect:\n(a) if the relevant recovery order ceases to have effect;"
    },
