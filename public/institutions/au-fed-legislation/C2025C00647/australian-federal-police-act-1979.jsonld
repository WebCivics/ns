    {
      "@id": "concept:australian-federal-police-act-1979-sec-47b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "47B(2) Superannuation orders: revocation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-47b-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.164",
      "values:originalText": "(2) Where a superannuation order is taken to have been revoked, the\nDPP must give written notice of the fact to:\n(a) the person in respect of whom the order was made; and\n(b) the person’s superannuation authority.",
      "skos:definition": "(2) Where a superannuation order is taken to have been revoked, the\nDPP must give written notice of the fact to:\n(a) the person in respect of whom the order was made; and\n(b) the person’s superannuation authority.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-47b"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-47b-ss-2-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-47b-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a281918430f66669419e463aace0d23b807c49ed7c1a673499e5f9942c6ba0e4",
      "skos:note": "Written notice must be given to the person in respect of whom the order was made and their superannuation authority.",
      "dc:description": "written notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-47b-ss-2",
      "@type": "cof:Section",
      "cof:title": "47B(2) Superannuation orders: revocation",
      "values:kind": "subsection",
      "cof:pageNumber": 164,
      "values:originalText": "(2) Where a superannuation order is taken to have been revoked, the\nDPP must give written notice of the fact to:\n(a) the person in respect of whom the order was made; and\n(b) the person’s superannuation authority."
    },
