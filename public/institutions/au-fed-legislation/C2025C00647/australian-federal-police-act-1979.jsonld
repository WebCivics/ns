    {
      "@id": "concept:australian-federal-police-act-1979-sec-14j",
      "@type": "cml:Concept",
      "skos:prefLabel": "14J Stopping and searching",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.45",
      "values:originalText": "When this section applies\n(1) This section applies if a designated person suspects on reasonable\ngrounds that:\n(a) a person (the suspect):\n(i) has a thing under the suspect’s immediate control; or\n(ii) is occupying a thing; or\n(iii) has a thing in a vehicle operated or occupied by the\nsuspect; or",
      "skos:definition": "When this section applies\n(1) This section applies if a designated person suspects on reasonable\ngrounds that:\n(a) a person (the suspect):\n(i) has a thing under the suspect’s immediate control; or\n(ii) is occupying a thing; or\n(iii) has a thing in a vehicle operated or occupied by the\nsuspect; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14j-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14j-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0e87f17a029f7154a4177f38af9980a30b2054958f04164c1c543df9d6aafad1",
      "skos:note": "Designated person has obligation to suspect reasonable grounds for stopping and searching."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14j",
      "@type": "cof:Section",
      "cof:title": "14J Stopping and searching",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "When this section applies\n(1) This section applies if a designated person suspects on reasonable\ngrounds that:\n(a) a person (the suspect):\n(i) has a thing under the suspect’s immediate control; or\n(ii) is occupying a thing; or\n(iii) has a thing in a vehicle operated or occupied by the\nsuspect; or"
    },
    {
