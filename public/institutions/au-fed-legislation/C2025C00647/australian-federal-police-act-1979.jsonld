    {
      "@id": "concept:australian-federal-police-act-1979-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.56",
      "values:originalText": "(1) The Commissioner shall be paid such remuneration as is\ndetermined by the Remuneration Tribunal, but if no determination\nof that remuneration is in operation, he or she shall be paid such\nremuneration as is prescribed.\n(2) The Commissioner shall be paid such allowances as are prescribed.\n(2A) A Deputy Commissioner is to be paid such remuneration and\nallowances as the Commissioner determines in writing.\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to Deputy Commissioners.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "skos:definition": "(1) The Commissioner shall be paid such remuneration as is\ndetermined by the Remuneration Tribunal, but if no determination\nof that remuneration is in operation, he or she shall be paid such\nremuneration as is prescribed.\n(2) The Commissioner shall be paid such allowances as are prescribed.\n(2A) A Deputy Commissioner is to be paid such remuneration and\nallowances as the Commissioner determines in writing.\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to Deputy Commissioners.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-20-ss-1"
        },
