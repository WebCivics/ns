    {
      "@id": "concept:australian-federal-police-act-1979-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Senior executive AFP employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.59",
      "values:originalText": "The Commissioner may, by writing, declare an AFP employee to\nbe a senior executive AFP employee.",
      "skos:definition": "The Commissioner may, by writing, declare an AFP employee to\nbe a senior executive AFP employee.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-25-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2d491cdbfa599a9f95758ea581df051a7608928f2ce0d649fc7a03a35b43a44d",
      "skos:note": "The Commissioner may declare an AFP employee a senior executive AFP employee."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Senior executive AFP employees",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "The Commissioner may, by writing, declare an AFP employee to\nbe a senior executive AFP employee."
    },
    {
