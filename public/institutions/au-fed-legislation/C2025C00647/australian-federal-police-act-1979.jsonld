    {
      "@id": "concept:australian-federal-police-act-1979-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Continuous employment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.59",
      "values:originalText": "For the purposes of the Long Service Leave (Commonwealth\nEmployees) Act 1976 and any other law of the Commonwealth, if:\n(a) a person is engaged as an AFP employee under section 24 for\na period; and\n(b) the person completes that period of engagement (the initial\nperiod); and\n(c) the person is re-engaged under that section for a further\nperiod starting immediately after the end of the initial period;\nthe person’s employment is taken to be continuous from the\nbeginning of the initial period until the end of the re-engagement.\nSubdivision B—Remuneration and other terms and conditions",
      "skos:definition": "For the purposes of the Long Service Leave (Commonwealth\nEmployees) Act 1976 and any other law of the Commonwealth, if:\n(a) a person is engaged as an AFP employee under section 24 for\na period; and\n(b) the person completes that period of engagement (the initial\nperiod); and\n(c) the person is re-engaged under that section for a further\nperiod starting immediately after the end of the initial period;\nthe person’s employment is taken to be continuous from the\nbeginning of the initial period until the end of the re-engagement.\nSubdivision B—Remuneration and other terms and conditions",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-26-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5ebf2940b4c25c5eb9ed60293bed410ff7d5bd0daec39c6f59e5359bf069ef89",
      "skos:note": "Employment is taken to be continuous if engaged under section 24 for a period and re-engaged immediately after the end of that period."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Continuous employment",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "For the purposes of the Long Service Leave (Commonwealth\nEmployees) Act 1976 and any other law of the Commonwealth, if:\n(a) a person is engaged as an AFP employee under section 24 for\na period; and\n(b) the person completes that period of engagement (the initial\nperiod); and\n(c) the person is re-engaged under that section for a further\nperiod starting immediately after the end of the initial period;\nthe person’s employment is taken to be continuous from the\nbeginning of the initial period until the end of the re-engagement.\nSubdivision B—Remuneration and other terms and conditions"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-26-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-26"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-26-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuity",
      "cml:logicSummary": "Employment continuity is an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
