        {
          "@id": "concept:australian-federal-police-act-1979-sec-47a-ss-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "4361c5be7819716b02f5259218d4d9fac7eae8234cf234aea9e95e4a75656f3c",
      "skos:note": "Defines prescribed period for superannuation order variation"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-47a-ss-3",
      "@type": "cof:Section",
      "cof:title": "47A(3) Superannuation orders: variation",
      "values:kind": "subsection",
      "cof:pageNumber": 164,
      "values:originalText": "(3) In this section:\nprescribed period means the period starting on the day on which\nthe superannuation order is made and ending on the day on which\nthe variation is made."
    },
