    {
      "@id": "concept:australian-federal-police-act-1979-sec-14m-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "14M(3) Application to magistrate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14m-ss-3"
      },
