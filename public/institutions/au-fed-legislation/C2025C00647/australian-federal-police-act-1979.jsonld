    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69a-ss-3",
      "@type": "cof:Section",
      "cof:title": "69A(3) Persons engaged overseas as employees",
      "values:kind": "subsection",
      "cof:pageNumber": 196,
      "values:originalText": "(3) This section does not, by implication, limit any other power of the\nCommissioner to engage persons to work overseas."
    },
