      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "40E(2) Special members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40e-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.78",
      "values:originalText": "(2) A person appointed under subsection (1) has, during the\ncontinuance of his or her appointment:\n(a) any powers and duties that are expressly conferred or\nimposed on special members under a provision of this Act or\nof any other Act; and\n(b) such of the powers and duties conferred or imposed on\nmembers as are specified in his or her instrument of\nappointment.\n\n\nCommissioner’s command powers etc.  Part IV\nConferral of status of protective service officer  Division 3A\nSection 40EA\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "skos:definition": "(2) A person appointed under subsection (1) has, during the\ncontinuance of his or her appointment:\n(a) any powers and duties that are expressly conferred or\nimposed on special members under a provision of this Act or\nof any other Act; and\n(b) such of the powers and duties conferred or imposed on\nmembers as are specified in his or her instrument of\nappointment.\n\n\nCommissioner’s command powers etc.  Part IV\nConferral of status of protective service officer  Division 3A\nSection 40EA\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "values:partOf": {
