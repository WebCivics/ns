      "skos:note": "Must identify AFP practices issue in report."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tw-ss-2",
      "@type": "cof:Section",
      "cof:title": "40TW(2) AFP practices issue identified in course of dealing with AFP",
      "values:kind": "subsection",
