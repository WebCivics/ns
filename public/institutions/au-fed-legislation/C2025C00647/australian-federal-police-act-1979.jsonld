    {
      "@id": "concept:australian-federal-police-act-1979-sec-44",
      "@type": "cml:Concept",
      "skos:prefLabel": "44 Authority to apply for superannuation order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-44"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.156",
      "values:originalText": "Where:\n(a) either:\n(i) a person who is or was an AFP employee is convicted\nof an offence; or\n(ii) a person who was an old law member or staff member\nat any time is convicted of an offence; and\n\n\nLoss of certain superannuation rights and benefits  Part VA\nLoss of superannuation: corruption offences  Division 2\nSection 45\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) the Minister administering the Crimes (Superannuation\nBenefits) Act 1989 is of the opinion that the offence is a\ncorruption offence;\nthat Minister shall, by notice in writing, authorise the DPP to apply\nto the appropriate court for a superannuation order in respect of the\nperson.",
      "skos:definition": "Where:\n(a) either:\n(i) a person who is or was an AFP employee is convicted\nof an offence; or\n(ii) a person who was an old law member or staff member\nat any time is convicted of an offence; and\n\n\nLoss of certain superannuation rights and benefits  Part VA\nLoss of superannuation: corruption offences  Division 2\nSection 45\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) the Minister administering the Crimes (Superannuation\nBenefits) Act 1989 is of the opinion that the offence is a\ncorruption offence;\nthat Minister shall, by notice in writing, authorise the DPP to apply\nto the appropriate court for a superannuation order in respect of the\nperson.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-44-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-44-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-44-logic-alleninterval-2"
