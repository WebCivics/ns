    {
      "@id": "concept:australian-federal-police-act-1979-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Constitution of appropriate courts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.182",
      "values:originalText": "Where an application for a superannuation order or restraining\norder is made to a court before which a person was convicted of a\ncorruption offence:\n(a) the application may be dealt with by the court; and\n(b) any power in relation to the superannuation order or\nrestraining order may be exercised by the court;\nwhether or not it is constituted in the same way in which it was\nconstituted when the person was convicted of the offence.\n\n\nMiscellaneous  Part VI\n\nSection 60A\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "skos:definition": "Where an application for a superannuation order or restraining\norder is made to a court before which a person was convicted of a\ncorruption offence:\n(a) the application may be dealt with by the court; and\n(b) any power in relation to the superannuation order or\nrestraining order may be exercised by the court;\nwhether or not it is constituted in the same way in which it was\nconstituted when the person was convicted of the offence.\n\n\nMiscellaneous  Part VI\n\nSection 60A\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-56-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "60625e7a4b4730a95893da27f822e00458c06fb05d42114e894b1f24f9694242",
      "skos:note": "Court may deal with application for superannuation order or restraining order made by a person convicted of corruption offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Constitution of appropriate courts",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "Where an application for a superannuation order or restraining\norder is made to a court before which a person was convicted of a\ncorruption offence:\n(a) the application may be dealt with by the court; and\n(b) any power in relation to the superannuation order or\nrestraining order may be exercised by the court;\nwhether or not it is constituted in the same way in which it was\nconstituted when the person was convicted of the offence.\n\n\nMiscellaneous  Part VI\n\nSection 60A\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-56-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-56"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-56-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Court may deal with application",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-60a",
      "@type": "cml:Concept",
      "skos:prefLabel": "60A Secrecy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-60a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.183",
      "values:originalText": "(1) This section applies to a person who is, or was at any time:\n(a) the Commissioner; or\n(b) a Deputy Commissioner; or\n(c) an AFP employee; or\n(d) a special member; or\n(da) a special protective service officer; or\n(e) a person engaged under section 35; or\n(f) a person performing functions under an agreement under\nsection 69D.\n(2) A person to whom this section applies must not, directly or\nindirectly:\n(a) make a record of any prescribed information; or\n(b) divulge or communicate any prescribed information to any\nother person;\nexcept for:\n(c) the purposes of this Act or the regulations; or\n(d) the purposes of the National Anti-Corruption Commission\nAct 2022 or regulations under that Act; or\n(e) the purposes of the Witness Protection Act 1994 or\nregulations under that Act; or\n(ea) the purposes of the Parliamentary Joint Committee on Law\nEnforcement Act 2010 or regulations under that Act; or\n(f) the carrying out, performance or exercise of any of the\nperson’s duties, functions or powers under Acts or\nregulations mentioned in paragraphs (c), (d), (e) and (ea); or\n(g) the purposes of an IGIS official carrying out, performing or\nexercising any of the IGIS official’s duties, functions or\npowers as an IGIS official.",
      "skos:definition": "(1) This section applies to a person who is, or was at any time:\n(a) the Commissioner; or\n(b) a Deputy Commissioner; or\n(c) an AFP employee; or\n(d) a special member; or\n(da) a special protective service officer; or\n(e) a person engaged under section 35; or\n(f) a person performing functions under an agreement under\nsection 69D.\n(2) A person to whom this section applies must not, directly or\nindirectly:\n(a) make a record of any prescribed information; or\n(b) divulge or communicate any prescribed information to any\nother person;\nexcept for:\n(c) the purposes of this Act or the regulations; or\n(d) the purposes of the National Anti-Corruption Commission\nAct 2022 or regulations under that Act; or\n(e) the purposes of the Witness Protection Act 1994 or\nregulations under that Act; or\n(ea) the purposes of the Parliamentary Joint Committee on Law\nEnforcement Act 2010 or regulations under that Act; or\n(f) the carrying out, performance or exercise of any of the\nperson’s duties, functions or powers under Acts or\nregulations mentioned in paragraphs (c), (d), (e) and (ea); or\n(g) the purposes of an IGIS official carrying out, performing or\nexercising any of the IGIS official’s duties, functions or\npowers as an IGIS official.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-60a-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-60a-ss-2"
        }
      ],
      "cml:integrityHash": "53228f608d0045c39fb36b348c9c6547e6fe97d94cd72e950fd778fe26eec15d"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-60a",
      "@type": "cof:Section",
      "cof:title": "60A Secrecy",
      "values:kind": "section",
      "cof:pageNumber": 183,
      "values:originalText": "(1) This section applies to a person who is, or was at any time:\n(a) the Commissioner; or\n(b) a Deputy Commissioner; or\n(c) an AFP employee; or\n(d) a special member; or\n(da) a special protective service officer; or\n(e) a person engaged under section 35; or\n(f) a person performing functions under an agreement under\nsection 69D.\n(2) A person to whom this section applies must not, directly or\nindirectly:\n(a) make a record of any prescribed information; or\n(b) divulge or communicate any prescribed information to any\nother person;\nexcept for:\n(c) the purposes of this Act or the regulations; or\n(d) the purposes of the National Anti-Corruption Commission\nAct 2022 or regulations under that Act; or\n(e) the purposes of the Witness Protection Act 1994 or\nregulations under that Act; or\n(ea) the purposes of the Parliamentary Joint Committee on Law\nEnforcement Act 2010 or regulations under that Act; or\n(f) the carrying out, performance or exercise of any of the\nperson’s duties, functions or powers under Acts or\nregulations mentioned in paragraphs (c), (d), (e) and (ea); or\n(g) the purposes of an IGIS official carrying out, performing or\nexercising any of the IGIS official’s duties, functions or\npowers as an IGIS official."
    },
