      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Request is a form of diffusion of information from the suspect to the designated person",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Designated person requests personal information from suspect",
      "cml:conclusionText": "Suspect provides requested information as part of the diffusion of information"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14h-ss-1-logic-cogai-5",
