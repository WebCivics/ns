    {
      "@id": "concept:australian-federal-police-act-1979-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Possible superannuation order not to be taken into account in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.181",
      "values:originalText": "sentencing\nA court shall not, in sentencing a person convicted of an offence\npunishable by imprisonment for life or for a term longer than 12",
      "skos:definition": "sentencing\nA court shall not, in sentencing a person convicted of an offence\npunishable by imprisonment for life or for a term longer than 12",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-55-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-55-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "04bb905b127dc952093dd0b00c5dd35ab43001f2fed8e7f14fa37e57eb99c9ef",
      "skos:note": "Court cannot punish with imprisonment for life or longer than 12 years in sentencing."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Possible superannuation order not to be taken into account in",
      "values:kind": "section",
      "cof:pageNumber": 181,
      "values:originalText": "sentencing\nA court shall not, in sentencing a person convicted of an offence\npunishable by imprisonment for life or for a term longer than 12"
    },
    {
