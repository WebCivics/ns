    {
      "@id": "concept:australian-federal-police-act-1979-sec-49b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "49B(5) Making of restraining orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49b-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.166",
      "values:originalText": "(5) Where the application is made in reliance on the proposed charging\nof the defendant with the offence concerned, the court must not\nmake a restraining order unless satisfied that the defendant will be\ncharged with the offence, or with a related corruption offence,\nwithin 48 hours.",
      "skos:definition": "(5) Where the application is made in reliance on the proposed charging\nof the defendant with the offence concerned, the court must not\nmake a restraining order unless satisfied that the defendant will be\ncharged with the offence, or with a related corruption offence,\nwithin 48 hours.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-49b"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49b-ss-5-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49b-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2c509d229e6bfaa4330bb095fb73227001d935f706861ce3f932993bc5f44a7d",
      "skos:note": "Court must not make restraining order unless defendant will be charged within 48 hours."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49b-ss-5",
      "@type": "cof:Section",
      "cof:title": "49B(5) Making of restraining orders",
      "values:kind": "subsection",
      "cof:pageNumber": 166,
      "values:originalText": "(5) Where the application is made in reliance on the proposed charging\nof the defendant with the offence concerned, the court must not\nmake a restraining order unless satisfied that the defendant will be\ncharged with the offence, or with a related corruption offence,\nwithin 48 hours."
    },
