      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-64a-ss-2",
      "@type": "cof:Section",
      "cof:title": "64A(2) Members in uniform to wear identification numbers",
      "values:kind": "subsection",
      "cof:pageNumber": 188,
      "values:originalText": "(2) Subsection (1) is an offence of strict liability.\nNote:\nFor strict liability, see section 6.1 of the Criminal Code."
    },
