    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tm",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TM Head of unit constituted under section 40RD to notify",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tm"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.120",
      "values:originalText": "Ombudsman of category 3 conduct issues\n(1) The head of the unit constituted under section 40RD must notify\nthe Ombudsman of the issue if the issue is a category 3 conduct\nissue.\n(2) Subsection (1) does not apply if this Subdivision applies to the\nissue because of subsection 40TL(4) (Ombudsman arranging for\nissue to be dealt with jointly by Ombudsman and Australian\nFederal Police).",
      "skos:definition": "Ombudsman of category 3 conduct issues\n(1) The head of the unit constituted under section 40RD must notify\nthe Ombudsman of the issue if the issue is a category 3 conduct\nissue.\n(2) Subsection (1) does not apply if this Subdivision applies to the\nissue because of subsection 40TL(4) (Ombudsman arranging for\nissue to be dealt with jointly by Ombudsman and Australian\nFederal Police).",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tm-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tm-ss-2"
        }
      ],
      "cml:integrityHash": "8a5f2e33c7ec7ada237bd89d79469d49743f87eb608acdf4596aa7cca007a0e4"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tm",
      "@type": "cof:Section",
      "cof:title": "40TM Head of unit constituted under section 40RD to notify",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "Ombudsman of category 3 conduct issues\n(1) The head of the unit constituted under section 40RD must notify\nthe Ombudsman of the issue if the issue is a category 3 conduct\nissue.\n(2) Subsection (1) does not apply if this Subdivision applies to the\nissue because of subsection 40TL(4) (Ombudsman arranging for\nissue to be dealt with jointly by Ombudsman and Australian\nFederal Police)."
    },
