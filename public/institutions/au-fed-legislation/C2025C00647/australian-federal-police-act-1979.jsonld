    {
      "@id": "concept:australian-federal-police-act-1979-sec-14h-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Request for personal information is an argument for the designated person to take action",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Designated person requests suspect's name, residential address, and reason for being in the place",
      "cml:conclusionText": "Suspect must provide requested information as part of the designated person's argument"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14h-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
