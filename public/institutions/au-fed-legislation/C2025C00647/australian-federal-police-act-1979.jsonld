      "cml:integrityHash": "a74a0dc4f1a42c14ac2de066ad586ec7b58d004b3da336f509efa11f1a22ac7c",
      "skos:note": "No remuneration or allowances for less than one week"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-19-ss-1c",
      "@type": "cof:Section",
      "cof:title": "19(1C) Absence etc. of Commissioner or Deputy Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 55,
      "values:originalText": "(1C) A person is not entitled to be paid remuneration or allowances\nunder this section for exercising the powers, and performing the\nfunctions and duties, of the Commissioner or a Deputy\nCommissioner for less than one week."
    },
