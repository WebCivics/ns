      "cml:logicSummary": "Authorize an individual as a member of Australian Federal Police",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40c",
      "@type": "cml:Concept",
      "skos:prefLabel": "40C Determination of competency or qualification requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.76",
      "values:originalText": "The Commissioner may, by written determination, specify either or\nboth of the following for the purposes of section 40B:\n(a) competency requirements;\n(b) qualification requirements.",
      "skos:definition": "The Commissioner may, by written determination, specify either or\nboth of the following for the purposes of section 40B:\n(a) competency requirements;\n(b) qualification requirements.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40c-norm"
        }
      ],
      "cml:integrityHash": "96cbd62805fdb09d3738c827b6e53f02154365a788527a0e37c0f0ad071ce809",
      "skos:note": "Commissioner may specify competency and qualification requirements by written determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40c",
      "@type": "cof:Section",
      "cof:title": "40C Determination of competency or qualification requirements",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "The Commissioner may, by written determination, specify either or\nboth of the following for the purposes of section 40B:\n(a) competency requirements;\n(b) qualification requirements."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40c-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
