        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to consult Ombudsman",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the conduct or matter is being dealt with under Division 3 jointly by the Ombudsman and the Australian Federal Police...",
      "cml:conclusionText": "The Commissioner MUST consult the Ombudsman before taking action under subsection (2) or (3)"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "MEETS",
      "cml:logicSummary": "Temporal interval for consultation with Ombudsman",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the conduct or matter is being dealt with under Division 3 jointly by the Ombudsman and the Australian Federal Police...",
      "cml:conclusionText": "The consultation with Ombudsman MUST MEET within a certain temporal interval"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "MEETS",
      "cml:logicSummary": "Temporal interval for action under subsection (2) or (3)",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the conduct or matter is being dealt with under Division 3 jointly by the Ombudsman and the Australian Federal Police...",
      "cml:conclusionText": "The action under subsection (2) or (3) MUST MEET within a certain temporal interval"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to inform Ombudsman of action taken",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the conduct or matter is being dealt with under Division 3 jointly by the Ombudsman and the Australian Federal Police...",
      "cml:conclusionText": "The Commissioner MUST inform the Ombudsman of any action taken under subsection (2) or (3)"
    },
    {
