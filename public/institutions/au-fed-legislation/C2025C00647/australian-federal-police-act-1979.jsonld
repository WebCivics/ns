    {
      "@id": "concept:australian-federal-police-act-1979-sec-42e",
      "@type": "cml:Concept",
      "skos:prefLabel": "42E Dealing with property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.153",
      "values:originalText": "For the purposes of this Part, dealing with property of a person\nincludes:\n(a) if a debt owing by the person is secured by an encumbrance\non the property—incurring any further liability or increasing\nthe amount of the debt by any means; and\n(b) removing the property from Australia; and\nVP – VC\nVP",
      "skos:definition": "For the purposes of this Part, dealing with property of a person\nincludes:\n(a) if a debt owing by the person is secured by an encumbrance\non the property—incurring any further liability or increasing\nthe amount of the debt by any means; and\n(b) removing the property from Australia; and\nVP – VC\nVP",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42e-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42e-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42e-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "e094613ac7ae0df3cd6642dd18afd9cb9a7aa828f9eb0f60a4c418b8e79d3fad",
      "skos:note": "Dealing with property includes incurring further liability or increasing debt."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42e",
      "@type": "cof:Section",
      "cof:title": "42E Dealing with property",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "For the purposes of this Part, dealing with property of a person\nincludes:\n(a) if a debt owing by the person is secured by an encumbrance\non the property—incurring any further liability or increasing\nthe amount of the debt by any means; and\n(b) removing the property from Australia; and\nVP – VC\nVP"
    },
    {
