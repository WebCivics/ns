        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40xb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aff1727ce68ad4208a43c9004a4155edd26ab9e63ae4ebf6151aa544c032a5d7",
      "skos:note": "The Ombudsman may inspect records for review purposes."
    },
    {
