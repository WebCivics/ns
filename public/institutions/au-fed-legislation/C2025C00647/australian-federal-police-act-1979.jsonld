    {
      "@id": "concept:australian-federal-police-act-1979-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Commissioner may engage consultants or independent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.69",
      "values:originalText": "contractors\n(1) The Commissioner may, under written agreements, engage persons\nas consultants, or independent contractors, to perform services.\n(2) The Commissioner may determine, in writing, that a consultant, or\nindependent contractor, specified in the determination is to be an\nAFP appointee for the purposes of paragraph (f) of the definition of\nAFP appointee in subsection 4(1).\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to consultants and independent contractors who are\ndetermined to be AFP appointees.\n(3) A determination under subsection (2) is not a legislative\ninstrument.",
      "skos:definition": "contractors\n(1) The Commissioner may, under written agreements, engage persons\nas consultants, or independent contractors, to perform services.\n(2) The Commissioner may determine, in writing, that a consultant, or\nindependent contractor, specified in the determination is to be an\nAFP appointee for the purposes of paragraph (f) of the definition of\nAFP appointee in subsection 4(1).\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to consultants and independent contractors who are\ndetermined to be AFP appointees.\n(3) A determination under subsection (2) is not a legislative\ninstrument.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-35-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-35-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-35-ss-3"
        }
      ],
      "cml:integrityHash": "f04ee782287cc0c7ced73b507481fcaf8215d72d5e75e1609b42dd8a405e3e9b"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Commissioner may engage consultants or independent",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "contractors\n(1) The Commissioner may, under written agreements, engage persons\nas consultants, or independent contractors, to perform services.\n(2) The Commissioner may determine, in writing, that a consultant, or\nindependent contractor, specified in the determination is to be an\nAFP appointee for the purposes of paragraph (f) of the definition of\nAFP appointee in subsection 4(1).\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to consultants and independent contractors who are\ndetermined to be AFP appointees.\n(3) A determination under subsection (2) is not a legislative\ninstrument."
    },
