      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-69e",
      "@type": "cml:Concept",
      "skos:prefLabel": "69E Commissioner may charge for certain protective services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.199",
      "values:originalText": "(1) If services are provided by a protective service officer or a special\nprotective service officer at the request of a person other than:\n(a) a person holding office under the Commonwealth; or\n(b) a Commonwealth authority;\nthe Commissioner may charge for the services.\n(2) A charge made under subsection (1) must be an amount reasonably\nrelated to the cost of providing the services.\n(3) In this section:\nCommonwealth authority means:\n(a) a body, whether incorporated or unincorporated, established\nfor a public purpose:\n(i) by or under a law of the Commonwealth or a law of a\nTerritory other than the Australian Capital Territory or\nthe Northern Territory; or\n(ii) by the Governor-General or a Minister; or\n(b) an incorporated company in which the Commonwealth or a\nbody described in paragraph (a) has a controlling interest; or\n(c) any other agency or instrumentality of the Commonwealth.",
      "skos:definition": "(1) If services are provided by a protective service officer or a special\nprotective service officer at the request of a person other than:\n(a) a person holding office under the Commonwealth; or\n(b) a Commonwealth authority;\nthe Commissioner may charge for the services.\n(2) A charge made under subsection (1) must be an amount reasonably\nrelated to the cost of providing the services.\n(3) In this section:\nCommonwealth authority means:\n(a) a body, whether incorporated or unincorporated, established\nfor a public purpose:\n(i) by or under a law of the Commonwealth or a law of a\nTerritory other than the Australian Capital Territory or\nthe Northern Territory; or\n(ii) by the Governor-General or a Minister; or\n(b) an incorporated company in which the Commonwealth or a\nbody described in paragraph (a) has a controlling interest; or\n(c) any other agency or instrumentality of the Commonwealth.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69e-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69e-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69e-ss-3"
        }
      ],
      "cml:integrityHash": "f76a4e912a1ad9892eccf7b9ea6a9d60637025373b2ff4a1911e5ee232604619"
