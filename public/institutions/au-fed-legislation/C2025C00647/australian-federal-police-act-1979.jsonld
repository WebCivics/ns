    {
      "@id": "concept:australian-federal-police-act-1979-sec-49b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "49B(4) Making of restraining orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
