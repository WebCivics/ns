      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits absconding in connection with an offence.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b",
      "@type": "cml:Concept",
      "skos:prefLabel": "42B Charge with offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.151",
      "values:originalText": "A reference in this Part to a person being charged with an offence\nis a reference to an information being laid against the person for\nthe offence, whether or not:\n(a) a summons has been issued requiring the attendance of the\nperson to answer the information; or\n(b) a warrant for the arrest of the person has been issued.",
      "skos:definition": "A reference in this Part to a person being charged with an offence\nis a reference to an information being laid against the person for\nthe offence, whether or not:\n(a) a summons has been issued requiring the attendance of the\nperson to answer the information; or\n(b) a warrant for the arrest of the person has been issued.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42b-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-ltl-3"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-deontic-4"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "a0aea77a470b1f356bafa68c0ff36c7fe77eb7174747c282a82e7be362b194c0",
      "skos:note": "A person must be charged with an offence if a summons or warrant is issued."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42b",
      "@type": "cof:Section",
      "cof:title": "42B Charge with offence",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "A reference in this Part to a person being charged with an offence\nis a reference to an information being laid against the person for\nthe offence, whether or not:\n(a) a summons has been issued requiring the attendance of the\nperson to answer the information; or\n(b) a warrant for the arrest of the person has been issued."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-42b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must be charged with an offence",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A summons or warrant is issued",
      "cml:conclusionText": "The person must be charged with the offence"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "The charge must occur after the issuance of a summons or warrant",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A summons has been issued requiring the attendance of the person to answer the information",
      "cml:conclusionText": "The charge with offence occurs after the summons is issued"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "The trace of charges must include the current charge",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A warrant for the arrest of the person has been issued",
      "cml:conclusionText": "The current charge is part of the trace of charges"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The state must ensure that a person is charged with an offence if a summons or warrant is issued",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A summons or warrant is issued",
      "cml:conclusionText": "The state must ensure the charge with offence occurs"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42b-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The person must be charged with an offence if a summons or warrant is issued",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
