    {
      "@id": "concept:australian-federal-police-act-1979-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Termination of employment by Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.61",
      "values:originalText": "The Commissioner may at any time, by notice in writing, terminate\nthe employment of an AFP employee.\nNote:\nThe Fair Work Act 2009 has rules that apply to termination of\nemployment.\nSubdivision D—Resignation and retirement",
      "skos:definition": "The Commissioner may at any time, by notice in writing, terminate\nthe employment of an AFP employee.\nNote:\nThe Fair Work Act 2009 has rules that apply to termination of\nemployment.\nSubdivision D—Resignation and retirement",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-28-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-28-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9783b9b499889b89bbe5769c6440570b3e44d0910237b64dbdf7b7d18511b513",
      "skos:note": "The Commissioner may terminate employment by notice in writing."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Termination of employment by Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "The Commissioner may at any time, by notice in writing, terminate\nthe employment of an AFP employee.\nNote:\nThe Fair Work Act 2009 has rules that apply to termination of\nemployment.\nSubdivision D—Resignation and retirement"
    },
