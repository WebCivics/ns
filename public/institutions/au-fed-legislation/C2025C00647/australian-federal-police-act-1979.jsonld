      ],
      "cml:integrityHash": "40d914d2fad154338dc9bbb4e776b7ea25cc3c9596791a0bfac0ca587e59ea67",
      "skos:note": "Remedial action may take one or more of the following forms: changing shifts, restricting duties, reassigning duties, or transferring to another part."
    },
