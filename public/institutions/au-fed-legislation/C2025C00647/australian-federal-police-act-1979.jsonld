    {
      "@id": "concept:australian-federal-police-act-1979-sec-41a",
      "@type": "cml:Concept",
      "skos:prefLabel": "41A Old law members or staff members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-41a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.150",
      "values:originalText": "For the purposes of this Part, if at a particular time before the\nchangeover day a person was a member or staff member (within\nthe meaning of this Act as in force at that time), the person was an\nold law member or staff member at that time.",
      "skos:definition": "For the purposes of this Part, if at a particular time before the\nchangeover day a person was a member or staff member (within\nthe meaning of this Act as in force at that time), the person was an\nold law member or staff member at that time.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-41a-norm"
        }
      ],
      "cml:integrityHash": "a85ae138e6356ebffd1f14612ba1dd71ae4f1a42640e8e3886f4bd15a6a99304",
      "skos:note": "Definition of old law member or staff member"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-41a",
      "@type": "cof:Section",
      "cof:title": "41A Old law members or staff members",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "For the purposes of this Part, if at a particular time before the\nchangeover day a person was a member or staff member (within\nthe meaning of this Act as in force at that time), the person was an\nold law member or staff member at that time."
    },
