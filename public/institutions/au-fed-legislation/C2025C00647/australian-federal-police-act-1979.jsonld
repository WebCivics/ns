    {
      "@id": "concept:australian-federal-police-act-1979-sec-42g",
      "@type": "cml:Concept",
      "skos:prefLabel": "42G Sufficient consideration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.155",
      "values:originalText": "A reference in this Part to transferring or acquiring property, or an\ninterest in property, for sufficient consideration is a reference to\ntransferring or acquiring the property or interest for a consideration\nthat is sufficient and, having regard solely to commercial\nconsiderations, reflects the value of the property or the interest.",
      "skos:definition": "A reference in this Part to transferring or acquiring property, or an\ninterest in property, for sufficient consideration is a reference to\ntransferring or acquiring the property or interest for a consideration\nthat is sufficient and, having regard solely to commercial\nconsiderations, reflects the value of the property or the interest.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42g-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45970a96db66507b918dd6a96d8338d82202465615cbe3d8d2c53fb7becd6e03",
      "skos:note": "A consideration sufficient for transferring or acquiring property is one that reflects its value."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42g",
      "@type": "cof:Section",
      "cof:title": "42G Sufficient consideration",
      "values:kind": "section",
      "cof:pageNumber": 155,
      "values:originalText": "A reference in this Part to transferring or acquiring property, or an\ninterest in property, for sufficient consideration is a reference to\ntransferring or acquiring the property or interest for a consideration\nthat is sufficient and, having regard solely to commercial\nconsiderations, reflects the value of the property or the interest."
    },
    {
