    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-69a",
      "@type": "cml:Concept",
      "skos:prefLabel": "69A Persons engaged overseas as employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.196",
      "values:originalText": "(1) The Commissioner, on behalf of the Commonwealth, may engage\npersons overseas to perform duties overseas as employees.\n(2) The Commissioner, on behalf of the Commonwealth, has all the\nrights, duties and powers of an employer in respect of persons\nengaged under this section.\n\n\nMiscellaneous  Part VI\n\nSection 69B\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to persons engaged under this section.\n(3) This section does not, by implication, limit any other power of the\nCommissioner to engage persons to work overseas.",
      "skos:definition": "(1) The Commissioner, on behalf of the Commonwealth, may engage\npersons overseas to perform duties overseas as employees.\n(2) The Commissioner, on behalf of the Commonwealth, has all the\nrights, duties and powers of an employer in respect of persons\nengaged under this section.\n\n\nMiscellaneous  Part VI\n\nSection 69B\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to persons engaged under this section.\n(3) This section does not, by implication, limit any other power of the\nCommissioner to engage persons to work overseas.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69a-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69a-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69a-ss-3"
        }
      ],
      "cml:integrityHash": "bc48ee7360d3eb31f8e19c92338b5763cf19226f84f04eb4022a9229ebe67256"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69a",
      "@type": "cof:Section",
      "cof:title": "69A Persons engaged overseas as employees",
      "values:kind": "section",
      "cof:pageNumber": 196,
      "values:originalText": "(1) The Commissioner, on behalf of the Commonwealth, may engage\npersons overseas to perform duties overseas as employees.\n(2) The Commissioner, on behalf of the Commonwealth, has all the\nrights, duties and powers of an employer in respect of persons\nengaged under this section.\n\n\nMiscellaneous  Part VI\n\nSection 69B\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\nNote:\nThe Commissioner may, under section 35A, authorise special\npayments to persons engaged under this section.\n(3) This section does not, by implication, limit any other power of the\nCommissioner to engage persons to work overseas."
    },
