      "cml:premiseText": "(a) a defendant has been convicted of, or has been charged or is about to be charged with, an offence;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-49j-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
