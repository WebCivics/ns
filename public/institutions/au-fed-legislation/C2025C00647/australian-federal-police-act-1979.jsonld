      "@type": "cml:Concept",
      "skos:prefLabel": "49B(3) Making of restraining orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49b-ss-3"
      },
      "cml:curationStatus": {
