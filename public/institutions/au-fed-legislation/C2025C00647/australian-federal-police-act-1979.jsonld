    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tv",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TV Taking action on report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tv"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.124",
      "values:originalText": "The Commissioner must ensure that:\n(a) any recommendations made in the report under section 40TU\nare fully considered; and\n(b) appropriate action is taken in relation to the issue to which\nthe report relates.",
      "skos:definition": "The Commissioner must ensure that:\n(a) any recommendations made in the report under section 40TU\nare fully considered; and\n(b) appropriate action is taken in relation to the issue to which\nthe report relates.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tv-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tv-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f46551225912b08da7f9b9ff3d158270c4c574b1b0cf67482ad64fcd319beab9",
      "skos:note": "Ensure recommendations are fully considered and appropriate action is taken."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tv",
      "@type": "cof:Section",
      "cof:title": "40TV Taking action on report",
      "values:kind": "section",
      "cof:pageNumber": 124,
      "values:originalText": "The Commissioner must ensure that:\n(a) any recommendations made in the report under section 40TU\nare fully considered; and\n(b) appropriate action is taken in relation to the issue to which\nthe report relates."
    },
