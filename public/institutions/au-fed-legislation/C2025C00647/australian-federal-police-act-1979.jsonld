    {
      "@id": "concept:australian-federal-police-act-1979-sec-77",
      "@type": "cml:Concept",
      "skos:prefLabel": "77 Accrued leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-77"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.202",
      "values:originalText": "A person appointed in pursuance of section 72 of this Act, as in\nforce on the commencing date, retains the rights, if any, in respect\nof:\n(a) recreation leave; and\n\n\nTransitional  Part VII\n\nSection 80\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) leave on the ground of illness;\nthat had accrued to him or her as a member of an existing Police\nForce or as a member of the Australian Public Service immediately\nbefore the commencing date.",
      "skos:definition": "A person appointed in pursuance of section 72 of this Act, as in\nforce on the commencing date, retains the rights, if any, in respect\nof:\n(a) recreation leave; and\n\n\nTransitional  Part VII\n\nSection 80\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) leave on the ground of illness;\nthat had accrued to him or her as a member of an existing Police\nForce or as a member of the Australian Public Service immediately\nbefore the commencing date.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-77-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-77-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-77-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "fd4f071927c88cb13d4de27f0743e2af95a58aeab3f9872937d15f0236682ade",
      "skos:note": "Retains accrued leave rights"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-77",
      "@type": "cof:Section",
      "cof:title": "77 Accrued leave",
      "values:kind": "section",
      "cof:pageNumber": 202,
      "values:originalText": "A person appointed in pursuance of section 72 of this Act, as in\nforce on the commencing date, retains the rights, if any, in respect\nof:\n(a) recreation leave; and\n\n\nTransitional  Part VII\n\nSection 80\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025\n(b) leave on the ground of illness;\nthat had accrued to him or her as a member of an existing Police\nForce or as a member of the Australian Public Service immediately\nbefore the commencing date."
    },
