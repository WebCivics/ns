    {
      "@id": "concept:australian-federal-police-act-1979-sec-69",
      "@type": "cml:Concept",
      "skos:prefLabel": "69 Prohibition of patronage and favouritism",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.196",
      "values:originalText": "The Commissioner, or a delegate of the Commissioner, in\nexercising powers under this Act:\n(a) in relation to the engagement of AFP employees; or\n(b) otherwise in relation to AFP employees;\nmust do so without patronage or favouritism.",
      "skos:definition": "The Commissioner, or a delegate of the Commissioner, in\nexercising powers under this Act:\n(a) in relation to the engagement of AFP employees; or\n(b) otherwise in relation to AFP employees;\nmust do so without patronage or favouritism.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "509e95a82e9f02e9409335e551758caa2b2e83c76bed06ba4311fd2d5a5aa6fe",
      "skos:note": "The Commissioner must exercise powers without patronage or favouritism."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69",
      "@type": "cof:Section",
      "cof:title": "69 Prohibition of patronage and favouritism",
      "values:kind": "section",
      "cof:pageNumber": 196,
      "values:originalText": "The Commissioner, or a delegate of the Commissioner, in\nexercising powers under this Act:\n(a) in relation to the engagement of AFP employees; or\n(b) otherwise in relation to AFP employees;\nmust do so without patronage or favouritism."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-69-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
