      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-5-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a provision refers to an Australian Federal Police member holding a particular rank.",
      "cml:conclusionText": "Then the provision must be read as referring to that member."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-5-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between declarations and provisions",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A declaration is in force under subsection (3) that a member is of that rank for the purposes of this paragraph.",
      "cml:conclusionText": "Then the provision must be read as referring to the member to whom the declaration applies during its duration."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-5-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between declarations and provisions (LTL)",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A declaration is in force under subsection (3) that a member is of that rank for the purposes of this paragraph.",
      "cml:conclusionText": "Then the provision must be read as referring to the member to whom the declaration applies during its duration."
    },
