      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Permission to execute Commonwealth writs and warrants",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State or Territory member may execute Commonwealth writ",
      "cml:conclusionText": "Writ may be executed by State or Territory member"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap of execution authority",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State or Territory member executes Commonwealth writ at some point in time",
      "cml:conclusionText": "Temporal overlap: State or Territory member and Commonwealth writ overlap"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Conditional execution authority",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State or Territory member executes Commonwealth writ until certain conditions are met",
      "cml:conclusionText": "Execution authority conditional on certain conditions"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-11-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of execution authority",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State or Territory member diffuses execution authority to Commonwealth writ",
      "cml:conclusionText": "Authority diffusion: State or Territory member and Commonwealth writ diffuse authority"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-11-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "Recognition of execution authority by CogAI",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "CogAI recognizes State or Territory member as authorized to execute Commonwealth writs and warrants",
      "cml:conclusionText": "CogAI recognition: State or Territory member recognized as authorized"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Immunities from certain State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.36",
      "values:originalText": "The Commissioner, a Deputy Commissioner or an AFP employee\nis not required under, or by reason of, a law of a State or Territory:\n(a) to obtain or have a licence or permission for doing any act or\nthing in the exercise of his or her powers or the performance\nof his or her duties as the Commissioner, a Deputy\nCommissioner or an AFP employee; or\n(b) to register any vehicle, vessel, animal or article belonging to\nthe Commonwealth.",
      "skos:definition": "The Commissioner, a Deputy Commissioner or an AFP employee\nis not required under, or by reason of, a law of a State or Territory:\n(a) to obtain or have a licence or permission for doing any act or\nthing in the exercise of his or her powers or the performance\nof his or her duties as the Commissioner, a Deputy\nCommissioner or an AFP employee; or\n(b) to register any vehicle, vessel, animal or article belonging to\nthe Commonwealth.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-12-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a5853dfb6472b318f66190960a412d748029555e15c73199dc88045828223900",
      "skos:note": "Exemptions from obtaining licenses or registering vehicles"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Immunities from certain State and Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "The Commissioner, a Deputy Commissioner or an AFP employee\nis not required under, or by reason of, a law of a State or Territory:\n(a) to obtain or have a licence or permission for doing any act or\nthing in the exercise of his or her powers or the performance\nof his or her duties as the Commissioner, a Deputy\nCommissioner or an AFP employee; or\n(b) to register any vehicle, vessel, animal or article belonging to\nthe Commonwealth."
    },
