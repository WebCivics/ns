      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-35a-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Payment recovery upon breach of conditions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Condition is breached",
      "cml:conclusionText": "Payment may be recovered"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Undertakings and oaths or affirmations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.71",
      "values:originalText": "Commissioner\n(1) A person appointed as the Commissioner must, before\ncommencing to perform his or her duties, make and subscribe,\nbefore a person authorised by the Minister, such oath or\naffirmation as is prescribed by the regulations.\nDeputy Commissioner\n(2) A Deputy Commissioner appointed under section 17 must,\nimmediately after his or her appointment:\n(a) enter into an undertaking, in accordance with the form\nprescribed by the regulations, relating to the performance of\nhis or her duties; and\n(b) make and subscribe, before the Commissioner, such oath or\naffirmation as is prescribed by the regulations.\nMembers\n(3) A person declared to be a member under section 40B must,\nimmediately after the declaration:\n(a) enter into an undertaking, in accordance with the form\nprescribed by the regulations, relating to the performance of\nhis or her duties; and\n(b) make and subscribe, before the Commissioner or a person\nauthorised by the Commissioner, such oath or affirmation as\nis prescribed by the regulations.\nSpecial members\n(4) A person appointed under section 40E to assist in the performance\nof the functions of the Australian Federal Police must, immediately\nafter his or her appointment:",
      "skos:definition": "Commissioner\n(1) A person appointed as the Commissioner must, before\ncommencing to perform his or her duties, make and subscribe,\nbefore a person authorised by the Minister, such oath or\naffirmation as is prescribed by the regulations.\nDeputy Commissioner\n(2) A Deputy Commissioner appointed under section 17 must,\nimmediately after his or her appointment:\n(a) enter into an undertaking, in accordance with the form\nprescribed by the regulations, relating to the performance of\nhis or her duties; and\n(b) make and subscribe, before the Commissioner, such oath or\naffirmation as is prescribed by the regulations.\nMembers\n(3) A person declared to be a member under section 40B must,\nimmediately after the declaration:\n(a) enter into an undertaking, in accordance with the form\nprescribed by the regulations, relating to the performance of\nhis or her duties; and\n(b) make and subscribe, before the Commissioner or a person\nauthorised by the Commissioner, such oath or affirmation as\nis prescribed by the regulations.\nSpecial members\n(4) A person appointed under section 40E to assist in the performance\nof the functions of the Australian Federal Police must, immediately\nafter his or her appointment:",
