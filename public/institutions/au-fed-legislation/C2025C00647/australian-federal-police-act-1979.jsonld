        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the AFP dog handler is entitled to enter...",
      "cml:conclusionText": "The handler must enter premises without penalty, liability or forfeiture."
    },
    {
