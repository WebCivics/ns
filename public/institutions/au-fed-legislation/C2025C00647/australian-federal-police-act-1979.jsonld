    {
      "@id": "concept:australian-federal-police-act-1979-sec-40q",
      "@type": "cml:Concept",
      "skos:prefLabel": "40Q Admissibility of test results etc. in legal proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.93",
      "values:originalText": "The following:\n(a) a certificate or other document recording the results of a test\nconducted under section 40M or 40N in relation to an AFP\nappointee;\n(b) a certificate or other document recording the results of an\nalcohol screening test conducted under section 40LA in\nrelation to an AFP appointee;\n(c) any other information, answer to a question or document\nrelevant to conducting such a test (including any information\nor answer given or document produced in compliance with\nsection 40);\nis not admissible in evidence against the AFP appointee in any\nproceedings other than the following:\n(d) proceedings in relation to a decision of the Commissioner to\nterminate the employment or appointment of the AFP\nappointee;\n(e) proceedings under the Safety, Rehabilitation and\nCompensation Act 1988;\n(f) proceedings in tort against the Commonwealth that are\ninstituted by the AFP appointee.",
      "skos:definition": "The following:\n(a) a certificate or other document recording the results of a test\nconducted under section 40M or 40N in relation to an AFP\nappointee;\n(b) a certificate or other document recording the results of an\nalcohol screening test conducted under section 40LA in\nrelation to an AFP appointee;\n(c) any other information, answer to a question or document\nrelevant to conducting such a test (including any information\nor answer given or document produced in compliance with\nsection 40);\nis not admissible in evidence against the AFP appointee in any\nproceedings other than the following:\n(d) proceedings in relation to a decision of the Commissioner to\nterminate the employment or appointment of the AFP\nappointee;\n(e) proceedings under the Safety, Rehabilitation and\nCompensation Act 1988;\n(f) proceedings in tort against the Commonwealth that are\ninstituted by the AFP appointee.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40q-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40q-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5294b6b2153c049751d1e9c9f5054ac2f58285ae1aaf31d716b4ca0e2653e61",
      "skos:note": "Exclusion of certain test results from admissibility in proceedings against AFP appointees."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40q",
      "@type": "cof:Section",
      "cof:title": "40Q Admissibility of test results etc. in legal proceedings",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "The following:\n(a) a certificate or other document recording the results of a test\nconducted under section 40M or 40N in relation to an AFP\nappointee;\n(b) a certificate or other document recording the results of an\nalcohol screening test conducted under section 40LA in\nrelation to an AFP appointee;\n(c) any other information, answer to a question or document\nrelevant to conducting such a test (including any information\nor answer given or document produced in compliance with\nsection 40);\nis not admissible in evidence against the AFP appointee in any\nproceedings other than the following:\n(d) proceedings in relation to a decision of the Commissioner to\nterminate the employment or appointment of the AFP\nappointee;\n(e) proceedings under the Safety, Rehabilitation and\nCompensation Act 1988;\n(f) proceedings in tort against the Commonwealth that are\ninstituted by the AFP appointee."
    },
    {
