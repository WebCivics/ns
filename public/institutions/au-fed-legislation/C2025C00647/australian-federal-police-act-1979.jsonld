    {
      "@id": "concept:australian-federal-police-act-1979-sec-60a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "60A(2) Secrecy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-60a-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.183",
      "values:originalText": "(2) A person to whom this section applies must not, directly or\nindirectly:\n(a) make a record of any prescribed information; or\n(b) divulge or communicate any prescribed information to any\nother person;\nexcept for:\n(c) the purposes of this Act or the regulations; or\n(d) the purposes of the National Anti-Corruption Commission\nAct 2022 or regulations under that Act; or\n(e) the purposes of the Witness Protection Act 1994 or\nregulations under that Act; or\n(ea) the purposes of the Parliamentary Joint Committee on Law\nEnforcement Act 2010 or regulations under that Act; or\n(f) the carrying out, performance or exercise of any of the\nperson’s duties, functions or powers under Acts or\nregulations mentioned in paragraphs (c), (d), (e) and (ea); or\n(g) the purposes of an IGIS official carrying out, performing or\nexercising any of the IGIS official’s duties, functions or\npowers as an IGIS official.",
      "skos:definition": "(2) A person to whom this section applies must not, directly or\nindirectly:\n(a) make a record of any prescribed information; or\n(b) divulge or communicate any prescribed information to any\nother person;\nexcept for:\n(c) the purposes of this Act or the regulations; or\n(d) the purposes of the National Anti-Corruption Commission\nAct 2022 or regulations under that Act; or\n(e) the purposes of the Witness Protection Act 1994 or\nregulations under that Act; or\n(ea) the purposes of the Parliamentary Joint Committee on Law\nEnforcement Act 2010 or regulations under that Act; or\n(f) the carrying out, performance or exercise of any of the\nperson’s duties, functions or powers under Acts or\nregulations mentioned in paragraphs (c), (d), (e) and (ea); or\n(g) the purposes of an IGIS official carrying out, performing or\nexercising any of the IGIS official’s duties, functions or\npowers as an IGIS official.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-60a"
      },
