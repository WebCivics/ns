    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-49h-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "49H(2) Notice of restraining orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49h-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.170",
      "values:originalText": "(2) Where:\n(a) a court makes a restraining order; and\n(b) the court is satisfied that it would be in the public interest to\ndelay giving notice of the order to a person;\nthe court may include in the restraining order an order that giving\nthe person notice of the restraining order be delayed for the\nspecified period and the DPP must give the person notice of the\nrestraining order as soon as practicable after the end of the\nspecified period.\n\n\nLoss of certain superannuation rights and benefits  Part VA\nRestraining orders  Division 3A\nSection 49J\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "skos:definition": "(2) Where:\n(a) a court makes a restraining order; and\n(b) the court is satisfied that it would be in the public interest to\ndelay giving notice of the order to a person;\nthe court may include in the restraining order an order that giving\nthe person notice of the restraining order be delayed for the\nspecified period and the DPP must give the person notice of the\nrestraining order as soon as practicable after the end of the\nspecified period.\n\n\nLoss of certain superannuation rights and benefits  Part VA\nRestraining orders  Division 3A\nSection 49J\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-49h"
      },
