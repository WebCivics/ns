    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rl",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RL Categories of AFP conduct issues",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rl"
      },
      "cml:curationStatus": {
