      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-6-ss-1-norm"
        }
      ],
      "cml:integrityHash": "a50f9359ce81540423ab7d65787397ac62d2edfc4ec6f8c119a5d2215e415fde",
      "skos:note": "Defines the composition of the Australian Federal Police."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-6-ss-1",
      "@type": "cof:Section",
      "cof:title": "6(1) Constitution of the Australian Federal Police",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(1) The Australian Federal Police consists of:\n(a) the Commissioner of Police; and\n(b) any Deputy Commissioner of Police; and\n(c) AFP employees; and\n(d) special members; and\n(e) special protective service officers."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-6-ss-1-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
