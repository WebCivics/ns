        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40xd-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b060dbba4be2ba25892d74628a5affe9d0912834301153a41c55cb260dfcb134",
      "skos:note": "Annual reports by Ombudsman must be prepared and presented to the Senate and House of Representatives."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40xd-ss-1",
