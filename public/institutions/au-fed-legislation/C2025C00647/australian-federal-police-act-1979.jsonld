    {
      "@id": "concept:australian-federal-police-act-1979-sec-69c",
      "@type": "cml:Concept",
      "skos:prefLabel": "69C Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-69c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.197",
      "values:originalText": "(1) The Commissioner may, in writing, delegate to a Deputy\nCommissioner, an AFP employee or a special member, all or any\nof the Commissioner’s powers, functions or duties under this Act\n(other than the Commissioner’s power under section 35A\n(payments in special circumstances)).\n(2) The Commissioner may, in writing, delegate to a senior executive\nAFP employee the Commissioner’s power under section 35A\n(payments in special circumstances).",
      "skos:definition": "(1) The Commissioner may, in writing, delegate to a Deputy\nCommissioner, an AFP employee or a special member, all or any\nof the Commissioner’s powers, functions or duties under this Act\n(other than the Commissioner’s power under section 35A\n(payments in special circumstances)).\n(2) The Commissioner may, in writing, delegate to a senior executive\nAFP employee the Commissioner’s power under section 35A\n(payments in special circumstances).",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-69c-ss-1"
