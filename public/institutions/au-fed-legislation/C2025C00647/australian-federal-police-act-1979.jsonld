    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rn",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RN Category 1 conduct",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.103",
      "values:originalText": "The Commissioner and the Ombudsman may determine under\nsubsection 40RM(1) that conduct of a particular kind is to be\ncategory 1 conduct for the purposes of this Act only if they are\nsatisfied that:\n(a) conduct of that kind is inappropriate conduct that:\n(i) relates to minor management matters or customer\nservice matters; or",
      "skos:definition": "The Commissioner and the Ombudsman may determine under\nsubsection 40RM(1) that conduct of a particular kind is to be\ncategory 1 conduct for the purposes of this Act only if they are\nsatisfied that:\n(a) conduct of that kind is inappropriate conduct that:\n(i) relates to minor management matters or customer\nservice matters; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rn-norm"
        }
      ],
      "cml:integrityHash": "1af9423959eb24b8fee059c192468d699e89ade05c836e67fdea9feea131efe1",
      "skos:note": "Determination of category 1 conduct"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rn",
      "@type": "cof:Section",
      "cof:title": "40RN Category 1 conduct",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "The Commissioner and the Ombudsman may determine under\nsubsection 40RM(1) that conduct of a particular kind is to be\ncategory 1 conduct for the purposes of this Act only if they are\nsatisfied that:\n(a) conduct of that kind is inappropriate conduct that:\n(i) relates to minor management matters or customer\nservice matters; or"
    },
