        }
      ],
      "cml:integrityHash": "47376b476e27cbdc09d04051b5a3c7dbc357ce120a4216149d0915426befcab8",
      "skos:note": "Document purporting to be sealed with court seal is taken as lawfully sealed unless proven otherwise."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-45a-ss-5",
      "@type": "cof:Section",
      "cof:title": "45A(5) Application for superannuation order: evidence",
      "values:kind": "subsection",
      "cof:pageNumber": 158,
      "values:originalText": "(5) A document purporting to be sealed with the seal of a court is to be\ntaken to have been lawfully sealed with the seal of that court unless\nthe contrary is proved."
    },
