    {
      "@id": "concept:australian-federal-police-act-1979-sec-14-2-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires a relation between identifiable temporal intervals for conditional commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Conditional commencement is specified as 1 July 2013 (s 2(1) item 2)",
      "cml:conclusionText": "Temporal interval required"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14-2-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires an ordered or recurring trace for conditional commencement",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Conditional commencement is specified as 1 July 2013 (s 2(1) item 2)",
      "cml:conclusionText": "Ordered trace required"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies the legal effect as Undertaking",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No explicit duty, ban conduct, grant permission, or create a right",
      "cml:conclusionText": "Undertaking"
    },
