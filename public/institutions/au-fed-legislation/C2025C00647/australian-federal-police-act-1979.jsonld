      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.93",
      "values:originalText": "The Commissioner may issue Commissioner’s orders under\nsection 38 authorising particular kinds of AFP appointees to act as\nmanagers for the purpose of section 40LA.",
      "skos:definition": "The Commissioner may issue Commissioner’s orders under\nsection 38 authorising particular kinds of AFP appointees to act as\nmanagers for the purpose of section 40LA.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40pa-norm"
        }
      ],
      "cml:integrityHash": "2ffc8174a4cd21a8730d75c04bf3ebcaaaca5bba2953f750d9bd830874ce35de",
      "skos:note": "Commissioner may issue orders authorizing AFP appointees to act as managers."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40pa",
      "@type": "cof:Section",
      "cof:title": "40PA Managers who may require alcohol screening tests",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "The Commissioner may issue Commissioner’s orders under\nsection 38 authorising particular kinds of AFP appointees to act as\nmanagers for the purpose of section 40LA."
    },
