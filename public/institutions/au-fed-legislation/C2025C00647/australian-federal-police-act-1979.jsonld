    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-42c",
      "@type": "cml:Concept",
      "skos:prefLabel": "42C Conviction and quashing of conviction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.151",
      "values:originalText": "(1) For the purposes of this Part, a person is to be taken to be\nconvicted of an offence if:\n(a) the person is convicted of the offence, whether summarily or\non indictment; or\n(b) the person absconds in connection with the offence.",
      "skos:definition": "(1) For the purposes of this Part, a person is to be taken to be\nconvicted of an offence if:\n(a) the person is convicted of the offence, whether summarily or\non indictment; or\n(b) the person absconds in connection with the offence.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42c-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-42c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e4b81082dfeed72c1a530a258090aad5bb2dc716b3e3f6ab16332032db6356b9",
      "skos:note": "A person is taken to be convicted of an offence if they are convicted or abscond in connection with the offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-42c",
      "@type": "cof:Section",
      "cof:title": "42C Conviction and quashing of conviction",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "(1) For the purposes of this Part, a person is to be taken to be\nconvicted of an offence if:\n(a) the person is convicted of the offence, whether summarily or\non indictment; or\n(b) the person absconds in connection with the offence."
