    {
      "@id": "concept:australian-federal-police-act-1979-sec-45a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "45A(5) Application for superannuation order: evidence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-45a-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
