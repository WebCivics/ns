        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-20-ss-3"
        }
      ],
      "cml:integrityHash": "c30057c7a19602f8d34df2d3e4ae9b4ed316192c25b9a97421462a7113674ced"
    },
    {
