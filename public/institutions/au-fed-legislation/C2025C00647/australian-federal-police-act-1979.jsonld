    {
      "@id": "concept:australian-federal-police-act-1979-sec-14h-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "14H(3) Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14h-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.44",
      "values:originalText": "(3) Subsection (2) does not apply if the suspect has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (3) (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "(3) Subsection (2) does not apply if the suspect has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (3) (see subsection 13.3(3) of the Criminal Code).",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-14h"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-14h-ss-3-norm"
        },
