        }
      ],
      "cml:integrityHash": "08ae7bde1a80474e05c3123b14bdd2fd746d8b986846418dae41dcfc23344b87",
      "skos:note": "Minister may direct certain functions as protective service."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-8a",
      "@type": "cof:Section",
      "cof:title": "8A Minister may direct which functions are protective service",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "functions\nThe Minister may, by notice published in the Gazette, direct that\ncertain protective and custodial functions of the Australian Federal\nPolice are protective service functions."
    },
    {
