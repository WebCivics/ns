    {
      "@id": "concept:australian-federal-police-act-1979-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 State and Territory writs and warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.35",
      "values:originalText": "Where a writ or warrant is issued under the law of a State or\nTerritory in relation to an offence or other matter under a law of\nthe Commonwealth or of a Territory, the writ or warrant may be\nexecuted by a member, notwithstanding that it is not addressed to a\nmember and notwithstanding any requirement of the law of the\nState or Territory as to the person by whom it may be executed.",
      "skos:definition": "Where a writ or warrant is issued under the law of a State or\nTerritory in relation to an offence or other matter under a law of\nthe Commonwealth or of a Territory, the writ or warrant may be\nexecuted by a member, notwithstanding that it is not addressed to a\nmember and notwithstanding any requirement of the law of the\nState or Territory as to the person by whom it may be executed.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-11-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-11-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-11-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-11-logic-ltl-3"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-11-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-11-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "19b032a7e321d33f082e85ef6fed4afe814ebb855b3d2c88416781899b508902",
      "skos:note": "Execution of Commonwealth or Territory writs and warrants by State or Territory members"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 State and Territory writs and warrants",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Where a writ or warrant is issued under the law of a State or\nTerritory in relation to an offence or other matter under a law of\nthe Commonwealth or of a Territory, the writ or warrant may be\nexecuted by a member, notwithstanding that it is not addressed to a\nmember and notwithstanding any requirement of the law of the\nState or Territory as to the person by whom it may be executed."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-11-norm",
