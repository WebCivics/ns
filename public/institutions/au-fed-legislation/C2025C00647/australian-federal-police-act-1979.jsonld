    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tb",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TB Dealing with related AFP conduct issues that have different",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.112",
      "values:originalText": "categories\nIf:\n(a) a number of AFP conduct issues relate to the same AFP\nappointee; and\n(b) those AFP conduct issues belong to different categories;\nthose AFP conduct issues may be dealt with together as if they all\nbelonged to the higher or highest of those categories.",
      "skos:definition": "categories\nIf:\n(a) a number of AFP conduct issues relate to the same AFP\nappointee; and\n(b) those AFP conduct issues belong to different categories;\nthose AFP conduct issues may be dealt with together as if they all\nbelonged to the higher or highest of those categories.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40tb-norm"
        }
      ],
      "cml:integrityHash": "4658e0d1ba6aefbb37af3adb941e9d5dabc4b9a5416f52722ef1c9f0b9f26440",
      "skos:note": "Dealing with related AFP conduct issues that have different categories may be dealt with together as if they all belong to the higher or highest of those categories."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tb",
      "@type": "cof:Section",
      "cof:title": "40TB Dealing with related AFP conduct issues that have different",
      "values:kind": "section",
      "cof:pageNumber": 112,
      "values:originalText": "categories\nIf:\n(a) a number of AFP conduct issues relate to the same AFP\nappointee; and\n(b) those AFP conduct issues belong to different categories;\nthose AFP conduct issues may be dealt with together as if they all\nbelonged to the higher or highest of those categories."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tb-norm",
      "@type": "values:Obligation",
      "cml:modality": {
