    {
      "@id": "concept:australian-federal-police-act-1979-sec-67-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Commissioner has the power to certify",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
