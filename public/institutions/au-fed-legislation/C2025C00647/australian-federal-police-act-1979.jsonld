    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rh",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RH AFP conduct issues",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rh"
