        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40rb",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RB Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40rb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.95",
      "values:originalText": "(1) This Part deals with the handling of:\n(a) AFP conduct issues and AFP practices issues; and\n(b) other issues related to the Australian Federal Police.\n(2) These issues may be:\n(a) issues that are raised by information given to the Australian\nFederal Police (see section 40SA); or\n(b) issues that the Commissioner decides, on his or her own\ninitiative, are to be dealt with under this Part (see\nsection 40SD); or\n(c) issues that are referred to the Australian Federal Police by the\nNational Anti-Corruption Commissioner under the National\nAnti-Corruption Commission Act 2022 or by the Ombudsman\nunder the Ombudsman Act 1976; or\n(d) issues that the Minister directs are to be inquired into under",
      "skos:definition": "(1) This Part deals with the handling of:\n(a) AFP conduct issues and AFP practices issues; and\n(b) other issues related to the Australian Federal Police.\n(2) These issues may be:\n(a) issues that are raised by information given to the Australian\nFederal Police (see section 40SA); or\n(b) issues that the Commissioner decides, on his or her own\ninitiative, are to be dealt with under this Part (see\nsection 40SD); or\n(c) issues that are referred to the Australian Federal Police by the\nNational Anti-Corruption Commissioner under the National\nAnti-Corruption Commission Act 2022 or by the Ombudsman\nunder the Ombudsman Act 1976; or\n(d) issues that the Minister directs are to be inquired into under",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rb-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40rb-ss-2"
        }
      ],
      "cml:integrityHash": "babf12e6601bc9bf2e3b6ce2b405dfe086aebbf2727939a76b11ff93e18ec4d9"
    },
    {
