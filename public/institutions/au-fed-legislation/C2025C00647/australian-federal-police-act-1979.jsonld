    {
      "@id": "concept:australian-federal-police-act-1979-sec-49r",
      "@type": "cml:Concept",
      "skos:prefLabel": "49R Notice of applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49r"
