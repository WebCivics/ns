    {
      "@id": "concept:australian-federal-police-act-1979-sec-49g",
      "@type": "cml:Concept",
      "skos:prefLabel": "49G Witnesses not required to answer questions etc. in certain cases",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.170",
      "values:originalText": "On the hearing of an application for a restraining order, a witness is\nnot required to answer a question or to produce a document if the\ncourt is satisfied that the answering of the question or the\nproduction of the document may prejudice the investigation of, or\nthe prosecution of a person for, an offence.",
      "skos:definition": "On the hearing of an application for a restraining order, a witness is\nnot required to answer a question or to produce a document if the\ncourt is satisfied that the answering of the question or the\nproduction of the document may prejudice the investigation of, or\nthe prosecution of a person for, an offence.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49g-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3eef6a3cc5c4a788f7aa54da474d5038e66e21079d059eb14d4800c2ea7c7c1e",
      "skos:note": "Witnesses are not required to answer questions or produce documents if it may prejudice an investigation or prosecution."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49g",
      "@type": "cof:Section",
      "cof:title": "49G Witnesses not required to answer questions etc. in certain cases",
      "values:kind": "section",
      "cof:pageNumber": 170,
      "values:originalText": "On the hearing of an application for a restraining order, a witness is\nnot required to answer a question or to produce a document if the\ncourt is satisfied that the answering of the question or the\nproduction of the document may prejudice the investigation of, or\nthe prosecution of a person for, an offence."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-49g-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-49g"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-49g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Witnesses are not required to answer questions or produce documents.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-49h",
      "@type": "cml:Concept",
      "skos:prefLabel": "49H Notice of restraining orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.170",
      "values:originalText": "(1) Subject to subsection (2), where a restraining order is made against\na person’s property, the DPP must give the person written notice of\nthe order.\n(2) Where:\n(a) a court makes a restraining order; and\n(b) the court is satisfied that it would be in the public interest to\ndelay giving notice of the order to a person;\nthe court may include in the restraining order an order that giving\nthe person notice of the restraining order be delayed for the\nspecified period and the DPP must give the person notice of the\nrestraining order as soon as practicable after the end of the\nspecified period.\n\n\nLoss of certain superannuation rights and benefits  Part VA\nRestraining orders  Division 3A\nSection 49J\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "skos:definition": "(1) Subject to subsection (2), where a restraining order is made against\na person’s property, the DPP must give the person written notice of\nthe order.\n(2) Where:\n(a) a court makes a restraining order; and\n(b) the court is satisfied that it would be in the public interest to\ndelay giving notice of the order to a person;\nthe court may include in the restraining order an order that giving\nthe person notice of the restraining order be delayed for the\nspecified period and the DPP must give the person notice of the\nrestraining order as soon as practicable after the end of the\nspecified period.\n\n\nLoss of certain superannuation rights and benefits  Part VA\nRestraining orders  Division 3A\nSection 49J\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49h-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-49h-ss-2"
        }
      ],
      "cml:integrityHash": "2aafc096ea6d6eb1155fabb19d08516d9ca6e981e3512386c2962636dfb5e3cd"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-49h",
      "@type": "cof:Section",
      "cof:title": "49H Notice of restraining orders",
      "values:kind": "section",
      "cof:pageNumber": 170,
      "values:originalText": "(1) Subject to subsection (2), where a restraining order is made against\na person’s property, the DPP must give the person written notice of\nthe order.\n(2) Where:\n(a) a court makes a restraining order; and\n(b) the court is satisfied that it would be in the public interest to\ndelay giving notice of the order to a person;\nthe court may include in the restraining order an order that giving\nthe person notice of the restraining order be delayed for the\nspecified period and the DPP must give the person notice of the\nrestraining order as soon as practicable after the end of the\nspecified period.\n\n\nLoss of certain superannuation rights and benefits  Part VA\nRestraining orders  Division 3A\nSection 49J\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025"
    },
