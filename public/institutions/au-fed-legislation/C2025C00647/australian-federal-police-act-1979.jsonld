      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:logicSummary": "Has obligation to apply for superannuation order",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.8,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence.",
      "cml:conclusionText": "Therefore, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "During which time the offence is a corruption offence",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.6,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence.",
      "cml:conclusionText": "Therefore, during this time, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:logicSummary": "Everywhere that the offence is a corruption offence",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The provision applies when the Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence.",
      "cml:conclusionText": "Therefore, everywhere that the offence is a corruption offence, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasPermission",
      "cml:logicSummary": "Has permission to apply for superannuation order",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.8,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence.",
      "cml:conclusionText": "Therefore, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-44-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implies that the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.7,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister administering the Crimes (Superannuation Benefits) Act 1989 is of the opinion that the offence is a corruption offence.",
      "cml:conclusionText": "Therefore, the DPP shall authorise the appropriate court to apply for a superannuation order in respect of the person."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Application for superannuation order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.157",
      "values:originalText": "(1) If the DPP is authorised to apply for a superannuation order in\nrespect of a person who is taken to have been convicted of an\noffence because of paragraph 42C(1)(b), the DPP must make that\napplication to the appropriate court.\n(1A) If:\n(a) the DPP is authorised to apply for a superannuation order in\nrespect of a person who is convicted of 1 or more offences;\nand\n(b) the person is sentenced to imprisonment for life in respect of\nthe offence, or any of the offences, or:\n(i) if there is only 1 offence—to imprisonment for a term\nlonger than 12 months; or\n(ii) if there are 2 or more offences—to imprisonment for a\nsingle term longer than 12 months, or to cumulative\nterms that together add up to longer than 12 months, in\nrespect of all or any of them;\nthe DPP must make that application to the appropriate court.\n(2) The DPP must not make an application for a superannuation order\notherwise than under this section.\n(3) The DPP must take reasonable steps to give written notice of an\napplication to the person in respect of whom the superannuation\norder is sought.",
      "skos:definition": "(1) If the DPP is authorised to apply for a superannuation order in\nrespect of a person who is taken to have been convicted of an\noffence because of paragraph 42C(1)(b), the DPP must make that\napplication to the appropriate court.\n(1A) If:\n(a) the DPP is authorised to apply for a superannuation order in\nrespect of a person who is convicted of 1 or more offences;\nand\n(b) the person is sentenced to imprisonment for life in respect of\nthe offence, or any of the offences, or:\n(i) if there is only 1 offence—to imprisonment for a term\nlonger than 12 months; or\n(ii) if there are 2 or more offences—to imprisonment for a\nsingle term longer than 12 months, or to cumulative\nterms that together add up to longer than 12 months, in\nrespect of all or any of them;\nthe DPP must make that application to the appropriate court.\n(2) The DPP must not make an application for a superannuation order\notherwise than under this section.\n(3) The DPP must take reasonable steps to give written notice of an\napplication to the person in respect of whom the superannuation\norder is sought.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-45-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-45-ss-1a"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-45-ss-2"
        },
