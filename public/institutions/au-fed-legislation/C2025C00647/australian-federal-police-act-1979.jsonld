    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tw-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "40TW(2) AFP practices issue identified in course of dealing with AFP",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tw-ss-2"
      },
      "cml:curationStatus": {
