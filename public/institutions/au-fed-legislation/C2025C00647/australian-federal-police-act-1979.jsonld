      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(bg) the provision of police services and police support services in relation to establishing, developing and monitoring peace, stability and security in foreign countries;"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-8a",
      "@type": "cml:Concept",
      "skos:prefLabel": "8A Minister may direct which functions are protective service",
      "cml:realizedBy": {
