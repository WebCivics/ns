    {
      "@id": "concept:australian-federal-police-act-1979-sec-40ed",
      "@type": "cml:Concept",
      "skos:prefLabel": "40ED Powers and duties of special protective service officers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40ed"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.80",
      "values:originalText": "A special protective service officer has:\n(a) any powers and duties that are expressly conferred or\nimposed on special protective service officers under a\nprovision of this Act or any other Act; and\n(b) such of the powers and duties conferred or imposed on\nprotective service officers as are specified in his or her\ninstrument of appointment.\n\n\nCommissioner’s command powers etc.  Part IV\nSecondment  Division 4\nSection 40F\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "skos:definition": "A special protective service officer has:\n(a) any powers and duties that are expressly conferred or\nimposed on special protective service officers under a\nprovision of this Act or any other Act; and\n(b) such of the powers and duties conferred or imposed on\nprotective service officers as are specified in his or her\ninstrument of appointment.\n\n\nCommissioner’s command powers etc.  Part IV\nSecondment  Division 4\nSection 40F\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40ed-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40ed-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "040869f5054466b59198409178151f20bb3e62a85984b2229f8c5ed3b6b05df0",
      "skos:note": "Special protective service officers have powers and duties expressly conferred or imposed under this Act."
    },
    {
