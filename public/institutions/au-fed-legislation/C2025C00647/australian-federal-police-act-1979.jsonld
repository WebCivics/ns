      },
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-49ea-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
