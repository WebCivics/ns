      }
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Commissioner and Deputy Commissioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.54",
      "values:originalText": "(1) The Commissioner of Police and one or more Deputy\nCommissioners of Police shall be appointed by the\nGovernor-General by Commission.\n(2) Subject to this Part, the Commissioner holds office for such period,\nnot exceeding 7 years, as is specified in his or her instrument of\nappointment, but is eligible for re-appointment.\n(3) Subject to this Part, a Deputy Commissioner holds office for the\nperiod, not exceeding 5 years, specified in the instrument of\nappointment, but is eligible for re-appointment.\n(3A) Where a person is re-appointed under this section for a term\nbeginning immediately after the end of the person’s last\nappointment, the person’s service is to be taken to be continuous.\n(4) The Commissioner holds office on such terms and conditions (if\nany) in respect of matters not provided for by this Act as are\ndetermined by the Governor-General.\n(4A) A Deputy Commissioner holds office on such terms and conditions\n(if any) in respect of matters not provided for by this Act as are\ndetermined by the Commissioner.",
      "skos:definition": "(1) The Commissioner of Police and one or more Deputy\nCommissioners of Police shall be appointed by the\nGovernor-General by Commission.\n(2) Subject to this Part, the Commissioner holds office for such period,\nnot exceeding 7 years, as is specified in his or her instrument of\nappointment, but is eligible for re-appointment.\n(3) Subject to this Part, a Deputy Commissioner holds office for the\nperiod, not exceeding 5 years, specified in the instrument of\nappointment, but is eligible for re-appointment.\n(3A) Where a person is re-appointed under this section for a term\nbeginning immediately after the end of the person’s last\nappointment, the person’s service is to be taken to be continuous.\n(4) The Commissioner holds office on such terms and conditions (if\nany) in respect of matters not provided for by this Act as are\ndetermined by the Governor-General.\n(4A) A Deputy Commissioner holds office on such terms and conditions\n(if any) in respect of matters not provided for by this Act as are\ndetermined by the Commissioner.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-17-ss-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-17-ss-2"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-17-ss-3"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-17-ss-3a"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-17-ss-4"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-17-ss-4a"
        }
      ],
      "cml:integrityHash": "630c3ab9db84dc6239cc7de3d5b645b75a4bfd54e1569cb1bfe689106e557d6d"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Commissioner and Deputy Commissioners",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "(1) The Commissioner of Police and one or more Deputy\nCommissioners of Police shall be appointed by the\nGovernor-General by Commission.\n(2) Subject to this Part, the Commissioner holds office for such period,\nnot exceeding 7 years, as is specified in his or her instrument of\nappointment, but is eligible for re-appointment.\n(3) Subject to this Part, a Deputy Commissioner holds office for the\nperiod, not exceeding 5 years, specified in the instrument of\nappointment, but is eligible for re-appointment.\n(3A) Where a person is re-appointed under this section for a term\nbeginning immediately after the end of the person’s last\nappointment, the person’s service is to be taken to be continuous.\n(4) The Commissioner holds office on such terms and conditions (if\nany) in respect of matters not provided for by this Act as are\ndetermined by the Governor-General.\n(4A) A Deputy Commissioner holds office on such terms and conditions\n(if any) in respect of matters not provided for by this Act as are\ndetermined by the Commissioner."
    },
