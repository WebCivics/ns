        }
      ],
      "cml:integrityHash": "e9e745ca4c453d3ba9f759fd134eb346032256357beb5cfb72a003fff4740812",
      "skos:note": "Allocation of issue to person outside unit requires Commissioner's agreement."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40tn-ss-3",
      "@type": "cof:Section",
      "cof:title": "40TN(3) Head of unit constituted under section 40RD generally",
      "values:kind": "subsection",
      "cof:pageNumber": 120,
      "values:originalText": "(3) The head of the unit may allocate the issue to a person who is not a\nmember of the unit only with the Commissioner’s agreement.\n\n\nProfessional standards and AFP conduct and practices issues  Part V\nDealing with AFP conduct or practices issues  Division 3\nSection 40TO\nAustralian Federal Police Act 1979\nCompilation date: 08/11/2025"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-40tn-ss-3-norm",
