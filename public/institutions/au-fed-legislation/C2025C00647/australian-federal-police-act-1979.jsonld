        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a member or special member; or (b) a member, however described, of a police force of a State or Territory; or (c) a member, however described, of a police force of a foreign country.",
      "cml:conclusionText": "foreign country"
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-14f",
      "@type": "cml:Concept",
      "skos:prefLabel": "14F Release of arrested person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-14f"
      },
      "cml:curationStatus": {
