    {
      "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "40UC(4) Division 3 investigation may be suspended pending outcome",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40uc-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.127",
      "values:originalText": "(4) If the conduct or matter is being dealt with under Division 3 jointly\nby the Ombudsman and the Australian Federal Police, the\nCommissioner may take action under subsection (2) or (3) only\nafter consulting the Ombudsman.",
      "skos:definition": "(4) If the conduct or matter is being dealt with under Division 3 jointly\nby the Ombudsman and the Australian Federal Police, the\nCommissioner may take action under subsection (2) or (3) only\nafter consulting the Ombudsman.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-40uc"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40uc-ss-4-norm"
        },
