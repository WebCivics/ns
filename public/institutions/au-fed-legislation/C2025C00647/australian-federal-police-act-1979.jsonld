    {
      "@id": "concept:australian-federal-police-act-1979-sec-40b",
      "@type": "cml:Concept",
      "skos:prefLabel": "40B AFP employees who are members of the Australian Federal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.76",
      "values:originalText": "Police\nThe Commissioner may, by writing, declare an AFP employee\n(other than a protective service officer) to be a member of the\nAustralian Federal Police if the Commissioner is satisfied that the\nemployee meets the requirements specified in a determination\nunder section 40C.\nNote 1:\nA person who is currently a protective service officer may be declared\nto be a member if the person ceases to be a protective service officer.\nNote 2:\nThis section does not prevent a protective service officer from being\nappointed as a special member.",
      "skos:definition": "Police\nThe Commissioner may, by writing, declare an AFP employee\n(other than a protective service officer) to be a member of the\nAustralian Federal Police if the Commissioner is satisfied that the\nemployee meets the requirements specified in a determination\nunder section 40C.\nNote 1:\nA person who is currently a protective service officer may be declared\nto be a member if the person ceases to be a protective service officer.\nNote 2:\nThis section does not prevent a protective service officer from being\nappointed as a special member.",
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40b-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40b-logic-deontic-1"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-40b-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "eeb966f5f31fade976b72b3c8e667a9b019827df9789ade5846eaaae84dd4929",
      "skos:note": "Declare AFP employee a member of Australian Federal Police"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40b",
      "@type": "cof:Section",
      "cof:title": "40B AFP employees who are members of the Australian Federal",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "Police\nThe Commissioner may, by writing, declare an AFP employee\n(other than a protective service officer) to be a member of the\nAustralian Federal Police if the Commissioner is satisfied that the\nemployee meets the requirements specified in a determination\nunder section 40C.\nNote 1:\nA person who is currently a protective service officer may be declared\nto be a member if the person ceases to be a protective service officer.\nNote 2:\nThis section does not prevent a protective service officer from being\nappointed as a special member."
    },
