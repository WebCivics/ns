    {
      "@id": "concept:australian-federal-police-act-1979-sec-40re",
      "@type": "cml:Concept",
      "skos:prefLabel": "40RE Head of unit",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40re"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.98",
      "values:originalText": "(1) The Commissioner may appoint an AFP appointee, in writing, to\nbe the head of the unit constituted under section 40RD.\n(2) The head of the unit is responsible for the performance by the unit\nof its functions.\n(3) The head of the unit is responsible under subsection (2) directly to:\n(a) the Commissioner; or\n(b) if the Commissioner so directs—the Deputy Commissioner,\nor senior executive AFP employee who is at a level\nequivalent to that of a Deputy Commissioner, specified in the\ndirection.",
      "skos:definition": "(1) The Commissioner may appoint an AFP appointee, in writing, to\nbe the head of the unit constituted under section 40RD.\n(2) The head of the unit is responsible for the performance by the unit\nof its functions.\n(3) The head of the unit is responsible under subsection (2) directly to:\n(a) the Commissioner; or\n(b) if the Commissioner so directs—the Deputy Commissioner,\nor senior executive AFP employee who is at a level\nequivalent to that of a Deputy Commissioner, specified in the\ndirection.",
