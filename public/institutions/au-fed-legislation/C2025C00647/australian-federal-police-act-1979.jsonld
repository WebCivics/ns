    {
      "@id": "concept:australian-federal-police-act-1979-sec-66-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "66(3) Protection of persons in respect of work reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-66-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.191",
      "values:originalText": "(3) Subsection (1) does not apply unless:\n(a) the person who made the report believed on reasonable\ngrounds that it was the function or duty of the person to\nwhom the report was made to receive it; and\n(b) if the report contained matter that was false or misleading in\na material respect—the person who made the report did not\nknow, and could not with reasonable diligence have\ndiscovered, that the report contained such matter.",
      "skos:definition": "(3) Subsection (1) does not apply unless:\n(a) the person who made the report believed on reasonable\ngrounds that it was the function or duty of the person to\nwhom the report was made to receive it; and\n(b) if the report contained matter that was false or misleading in\na material respect—the person who made the report did not\nknow, and could not with reasonable diligence have\ndiscovered, that the report contained such matter.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-66"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-66-ss-3-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-66-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af0b176cac18836c4948a822f3de8b2bb427400b102a15e08151acd9591776e8",
      "skos:note": "Exemption from subsection (1) under certain conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-66-ss-3",
      "@type": "cof:Section",
      "cof:title": "66(3) Protection of persons in respect of work reports",
      "values:kind": "subsection",
      "cof:pageNumber": 191,
      "values:originalText": "(3) Subsection (1) does not apply unless:\n(a) the person who made the report believed on reasonable\ngrounds that it was the function or duty of the person to\nwhom the report was made to receive it; and\n(b) if the report contained matter that was false or misleading in\na material respect—the person who made the report did not\nknow, and could not with reasonable diligence have\ndiscovered, that the report contained such matter."
    },
