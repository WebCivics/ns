    {
      "@id": "concept:australian-federal-police-act-1979-sec-66-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "66(2) Protection of persons in respect of work reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-66-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.191",
      "values:originalText": "(2) A report is to be taken to have been made in good faith if the\nperson who made it was not actuated by ill will to the\nCommissioner, Deputy Commissioner, AFP employee, special\nmember or special protective service officer, as the case may be, or\nby any other improper motive.",
      "skos:definition": "(2) A report is to be taken to have been made in good faith if the\nperson who made it was not actuated by ill will to the\nCommissioner, Deputy Commissioner, AFP employee, special\nmember or special protective service officer, as the case may be, or\nby any other improper motive.",
      "values:partOf": {
        "@id": "concept:australian-federal-police-act-1979-sec-66"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-federal-police-act-1979-sec-66-ss-2-norm"
        },
        {
          "@id": "concept:australian-federal-police-act-1979-sec-66-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "885eb5ced23e398b7539de60400e133ddf6194dc72fbab507552a13450009eb3",
      "skos:note": "Good faith report requirement"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-66-ss-2",
      "@type": "cof:Section",
      "cof:title": "66(2) Protection of persons in respect of work reports",
      "values:kind": "subsection",
      "cof:pageNumber": 191,
      "values:originalText": "(2) A report is to be taken to have been made in good faith if the\nperson who made it was not actuated by ill will to the\nCommissioner, Deputy Commissioner, AFP employee, special\nmember or special protective service officer, as the case may be, or\nby any other improper motive."
    },
    {
      "@id": "concept:australian-federal-police-act-1979-sec-66-ss-2-norm",
