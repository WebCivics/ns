    {
      "@id": "concept:australian-federal-police-act-1979-sec-40xb",
      "@type": "cml:Concept",
      "skos:prefLabel": "40XB Ad hoc reviews by Ombudsman",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-federal-police-act-1979#sec-40xb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-federal-police-act-1979.pdf"
      },
      "dc:source": "australian-federal-police-act-1979.pdf, p.140",
      "values:originalText": "The Ombudsman may, at any time, inspect the records of AFP\nconduct issues and AFP practices issues dealt with under\nDivisions 3 and 4 for the purposes of reviewing the administration\nof this Part.",
      "skos:definition": "The Ombudsman may, at any time, inspect the records of AFP\nconduct issues and AFP practices issues dealt with under\nDivisions 3 and 4 for the purposes of reviewing the administration\nof this Part.",
