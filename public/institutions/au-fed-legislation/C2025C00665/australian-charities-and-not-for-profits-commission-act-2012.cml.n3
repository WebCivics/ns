concept:australian-charities-and-not-for-profits-commission-act-2012-sec-2 a cml:Concept ;
    skos:prefLabel "2 Sections 5-15"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "to 300-5 The later of: (a) 1 October 2012; and (b) the day the Australian Charities and Not-for-profits Commission (Consequential and Transitional) Act 2012 receives the Royal Assent. However, the provision(s) do not commence at all if the event mentioned in paragraph (b) does not occur." ;
    skos:definition "to 300-5 The later of: (a) 1 October 2012; and (b) the day the Australian Charities and Not-for-profits Commission (Consequential and Transitional) Act 2012 receives the Royal Assent. However, the provision(s) do not commence at all if the event mentioned in paragraph (b) does not occur."@en ;
    cml:integrityHash "62aa9c4a073a1d29d6a0629d3cbeb8296c4bbdbab77e87d37ecf7e5aaa81dc50" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Commencement of provision depends on Royal Assent and event in paragraph (b)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
