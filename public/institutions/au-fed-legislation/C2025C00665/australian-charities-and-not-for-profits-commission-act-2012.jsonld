    {
      "@id": "concept:australian-charities-and-not-for-profits-commission-act-2012-sec-31-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "31(1) December were a reference to the last day of the 6-month",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-charities-and-not-for-profits-commission-act-2012#sec-31-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
