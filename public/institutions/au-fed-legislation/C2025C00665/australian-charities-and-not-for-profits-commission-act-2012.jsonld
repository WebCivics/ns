        },
        {
          "@id": "concept:australian-charities-and-not-for-profits-commission-act-2012-sec-31-ss-1-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "018ddb50860c606374645e96d6ef787275984e69dd6abb400cac079039c4c132",
      "skos:note": "Commissioner may impose conditions on a decision to allow adoption of an accounting period. Commissioner allows registered entities to prepare and lodge a single information statement or financial report."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-charities-and-not-for-profits-commission-act-2012#sec-31-ss-1",
