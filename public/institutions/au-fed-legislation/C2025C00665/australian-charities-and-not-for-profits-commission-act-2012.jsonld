      "cml:integrityHash": "e629953c25cdb9c08c0e38825d313ee6b13ae9774eec5e5e745e8cfd086e3801",
      "skos:note": "Entities must apply for decision on forming a reporting group. The Commissioner may revoke a decision if conditions are not complied with. Entity must apply for approval to adopt accounting period",
      "dc:description": "Application form"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-charities-and-not-for-profits-commission-act-2012#sec-31-ss-3",
      "@type": "cof:Section",
      "cof:title": "31(3) December were a reference to the last day of the 6-month",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(3) Registered entities seeking to form a reporting group may apply, in\nthe approved form, to the Commissioner for the Commissioner to\nmake a decision under subsection (1) or (2).\nCommissioner must consider certain issues"
    },
