      },
      "prov:wasDerivedFrom": {
        "@id": "australian-charities-and-not-for-profits-commission-act-2012.pdf"
      },
      "dc:source": "australian-charities-and-not-for-profits-commission-act-2012.pdf, p.62",
      "values:originalText": "(3) Registered entities seeking to form a reporting group may apply, in\nthe approved form, to the Commissioner for the Commissioner to\nmake a decision under subsection (1) or (2).\nCommissioner must consider certain issues",
      "skos:definition": "(3) Registered entities seeking to form a reporting group may apply, in\nthe approved form, to the Commissioner for the Commissioner to\nmake a decision under subsection (1) or (2).\nCommissioner must consider certain issues",
      "values:partOf": {
        "@id": "concept:australian-charities-and-not-for-profits-commission-act-2012-sec-31"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-charities-and-not-for-profits-commission-act-2012-sec-31-ss-3-norm"
        },
