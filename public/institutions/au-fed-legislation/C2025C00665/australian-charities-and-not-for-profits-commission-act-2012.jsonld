      },
      "prov:wasDerivedFrom": {
        "@id": "australian-charities-and-not-for-profits-commission-act-2012.pdf"
      },
      "dc:source": "australian-charities-and-not-for-profits-commission-act-2012.pdf, p.62",
      "values:originalText": "(1) The Commissioner may allow 2 or more registered entities\n(reporting group) to prepare and lodge a single information\nstatement, or a single information statement and a single financial\nreport, in relation to the reporting group for a financial year.\nCollective reporting",
      "skos:definition": "(1) The Commissioner may allow 2 or more registered entities\n(reporting group) to prepare and lodge a single information\nstatement, or a single information statement and a single financial\nreport, in relation to the reporting group for a financial year.\nCollective reporting",
      "values:partOf": {
        "@id": "concept:australian-charities-and-not-for-profits-commission-act-2012-sec-31"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-charities-and-not-for-profits-commission-act-2012-sec-31-ss-1-norm"
        },
        {
