      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A decision is taken to have been made at a meeting of the ACMA",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "ACMA has an obligation to inform all members of the proposed decision",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "(a) without meeting, a majority of the members indicate agreement with the proposed decision in accordance with the method determined by the ACMA under subsection (2); and (b) all the members were informed of the proposed decision, or reasonable efforts were made to inform all the members of the proposed decision."
    },
