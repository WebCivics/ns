      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Outside employment is prohibited without Chair's approval",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
