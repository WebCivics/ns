      "@type": "cml:Concept",
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.42",
      "skos:note": "Delegations of power by a Division",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "52(1A) Delegations by a Division"
      },
      "wasDerivedFrom": "australian-communications-and-media-authority-act-2005.pdf",
      "asserts": [
        "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-norm",
        "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-deontic-1",
