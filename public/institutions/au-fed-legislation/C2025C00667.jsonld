      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-46-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "ACMA must determine the kinds of matters the Division can deal with and ensure such a determination is in force at all times.",
      "cml:confidence": {
