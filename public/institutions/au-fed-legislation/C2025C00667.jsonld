    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-46-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.37",
      "skos:note": "Establishment of Divisions is mandatory if ACMA establishes one.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "46(1) Divisions"
      },
      "wasDerivedFrom": "australian-communications-and-media-authority-act-2005.pdf",
      "asserts": [
        "concept:australian-communications-and-media-authority-act-2005-sec-46-ss-1-norm",
