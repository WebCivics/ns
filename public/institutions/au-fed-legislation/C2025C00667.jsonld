      "cml:logicSummary": "Prohibits outside employment",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(2) The other full-time members and the full-time associate members must not engage in paid employment outside the duties of their offices without the Chair’s approval."
    },
