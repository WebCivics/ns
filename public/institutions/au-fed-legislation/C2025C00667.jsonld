      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Division exists from its establishment until its dissolution.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Division must exist at all times while it continues to exist.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:premiseText": "ACMA establishes a Division."
    },
