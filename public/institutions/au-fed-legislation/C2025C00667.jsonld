      "cml:schemaVersion": "2",
      "partOf": "concept:australian-communications-and-media-authority-act-2005-sec-52"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...to a person under this section if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Delegation power is effective within specified temporal bounds.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "the delegation is only for the purposes of one or both of the following:"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the Division is satisfied that it is appropriate for a delegate to exercise the power;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Division justifies delegation by considering policy and decision requirements.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Justification",
      "cml:premiseText": "if the delegation is for the purposes of giving effect to a policy or a decision of the Division—having regard to what would be required, necessary or convenient to give effect to the policy or decision,"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "to a person under this section if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Division has the obligation to delegate power only under specified conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Division may only delegate a power..."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...if the delegation is for the purposes of giving effect to a policy or decision of the Division—",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Person eligible for delegation must meet specified conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "the person is: (i) a member; (ii) an SES employee or an acting SES employee; (iii) a person holding, or performing the duties of, an office or position that is at a level equivalent to that of an SES employee."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
