      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "615d9fe22e8002fef913595364bb77f00b279b0e7689803c476f0c307bb05cb4",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
