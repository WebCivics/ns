concept:australian-communications-and-media-authority-act-2005-sec-15 a cml:Concept ;
    skos:prefLabel "15 ACMA not otherwise subject to direction"@en ;
    cml:realizedBy doc:sec-15 ;
    values:originalText "Except as otherwise provided by or under this or any other Act, the ACMA is not subject to direction by or on behalf of the Commonwealth." ;
