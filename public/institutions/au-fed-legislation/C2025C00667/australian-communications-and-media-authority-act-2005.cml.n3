doc:sec-20-ss-4 a cof:Section ;
    cof:title "20(4) Appointment of members" ;
    values:kind "subsection" ;
    values:originalText "(4) A part-time member may be assigned by the Minister, acting on the ACMA’s advice, on a full-time basis to an inquiry, investigation or hearing. Such an assignment must be in writing." ;
    cof:pageNumber "23"^^xsd:integer .

concept:australian-communications-and-media-authority-act-2005-sec-20-ss-5 a cml:Concept ;
    skos:prefLabel "20(5) Appointment of members"@en ;
    cml:realizedBy doc:sec-20-ss-5 ;
    values:originalText "(5) For the purposes of this Act (except for subsection 31(2) and paragraph 34(5)(b)), a part-time member so assigned is taken to be a full-time member while the assignment is in force." ;
