doc:sec-61 a cof:Section ;
    cof:title "61 Charges are payable to the Commonwealth" ;
    values:kind "section" ;
    values:originalText "If section 60, or a provision of another Act, authorises the ACMA to fix a charge (however described), that charge is payable to the Commonwealth." ;
