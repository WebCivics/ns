concept:australian-communications-and-media-authority-act-2005-sec-49 a cml:Concept ;
    skos:prefLabel "49 Minutes etc."@en ;
    cml:realizedBy doc:sec-49 ;
    values:originalText "A Division must: (a) keep minutes of its meetings; and (b) keep a record of decisions made in accordance with section 48.   Decision-making and delegation by ACMA  Part 4 Delegations  Division 4 Section 50 Australian Communications and Media Authority Act 2005 Compilation date: 05/12/2025" ;
    skos:definition "A Division must: (a) keep minutes of its meetings; and (b) keep a record of decisions made in accordance with section 48.   Decision-making and delegation by ACMA  Part 4 Delegations  Division 4 Section 50 Australian Communications and Media Authority Act 2005 Compilation date: 05/12/2025"@en ;
    cml:integrityHash "7426667bc10fd2afa38fb2b6f724de7a0717401534055d1c08065cdac01bece2" ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Keep minutes and decisions" ;
