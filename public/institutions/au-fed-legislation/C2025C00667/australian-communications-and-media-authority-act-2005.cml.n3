concept:australian-communications-and-media-authority-act-2005-sec-61 a cml:Concept ;
    skos:prefLabel "61 Charges are payable to the Commonwealth"@en ;
    cml:realizedBy doc:sec-61 ;
    values:originalText "If section 60, or a provision of another Act, authorises the ACMA to fix a charge (however described), that charge is payable to the Commonwealth." ;
