concept:australian-communications-and-media-authority-act-2005-sec-35 a cml:Concept ;
    skos:prefLabel "35 Other terms and conditions"@en ;
    cml:realizedBy doc:sec-35 ;
    values:originalText "A member or associate member holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the appointer.   Decision-making and delegation by ACMA  Part 4 Meetings  Division 1 Section 36 Australian Communications and Media Authority Act 2005 Compilation date: 05/12/2025" ;
    skos:definition "A member or associate member holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the appointer.   Decision-making and delegation by ACMA  Part 4 Meetings  Division 1 Section 36 Australian Communications and Media Authority Act 2005 Compilation date: 05/12/2025"@en ;
    cml:integrityHash "8ed8cc93d2e37b9293b8fb2730bcd57f5068f3c68e804e48cba4983f8c5cf865" ;
    cof:pageNumber "32"^^xsd:integer ;
