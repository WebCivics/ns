concept:australian-communications-and-media-authority-act-2005-sec-62 a cml:Concept ;
    skos:prefLabel "62 ACMA’s expenses include related Commonwealth expenses"@en ;
    cml:realizedBy doc:sec-62 ;
    values:originalText "A reference in section 60, or a provision of another Act, to an expense (however described) incurred by the ACMA in relation to a thing, includes a reference to an expense incurred by the Commonwealth in relation to the thing." ;
    skos:definition "A reference in section 60, or a provision of another Act, to an expense (however described) incurred by the ACMA in relation to a thing, includes a reference to an expense incurred by the Commonwealth in relation to the thing."@en ;
    cml:integrityHash "c4117d0085b344528047fa666016eaa009e961d9f96a93599f1c55b248878ed6" ;
    cof:pageNumber "62"^^xsd:integer ;
