concept:australian-communications-and-media-authority-act-2005-sec-38 a cml:Concept ;
    skos:prefLabel "38 Presiding at meetings"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "(1) The Chair presides at all meetings at which he or she is present. (2) If the Chair is not present at a meeting, the Deputy Chair presides." ;
