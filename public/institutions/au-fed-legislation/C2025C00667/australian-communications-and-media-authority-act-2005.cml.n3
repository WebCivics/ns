concept:australian-communications-and-media-authority-act-2005-sec-21 a cml:Concept ;
    skos:prefLabel "21 Period of appointment for members"@en ;
    cml:realizedBy doc:sec-21 ;
    values:originalText "Period of current appointment (1) A member holds office for the period specified in his or her instrument of appointment. The period must not exceed 5 years." ;
    skos:definition "Period of current appointment (1) A member holds office for the period specified in his or her instrument of appointment. The period must not exceed 5 years."@en ;
