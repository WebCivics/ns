doc:sec-25-ss-1 a cof:Section ;
    cof:title "25(1) Period of appointment for associate members" ;
    values:kind "subsection" ;
    values:originalText "(1) An associate member holds office for the period specified in his or her instrument of appointment. The period must not exceed 5 years. Total periods of appointment must not exceed 10 years" ;
    cof:pageNumber "26"^^xsd:integer .

concept:australian-communications-and-media-authority-act-2005-sec-25-ss-2 a cml:Concept ;
    skos:prefLabel "25(2) Period of appointment for associate members"@en ;
    cml:realizedBy doc:sec-25-ss-2 ;
    values:originalText "(2) A person can be appointed as an associate member more than once. However, a later appointment must not result in the sum of the person’s periods of appointment exceeding 10 years. Reduction if specified inquiry, investigation or hearing ends earlier" ;
    skos:definition "(2) A person can be appointed as an associate member more than once. However, a later appointment must not result in the sum of the person’s periods of appointment exceeding 10 years. Reduction if specified inquiry, investigation or hearing ends earlier"@en ;
    cml:integrityHash "a596997cac7aee2ad50fc6a0dd1e55aef1161a0e611401dcf6b863f22efb6a36" ;
    values:partOf concept:australian-communications-and-media-authority-act-2005-sec-25 ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Limitation on number of appointments for associate members" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
