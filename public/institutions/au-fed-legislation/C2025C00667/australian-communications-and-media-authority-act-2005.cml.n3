doc:sec-50-ss-2 a cof:Section ;
    cof:title "50(2) Delegations by ACMA to a Division" ;
    values:kind "subsection" ;
    values:originalText "(2) A certificate: (a) stating any matter with respect to the performance of a delegated function or exercise of a delegated power; and (b) signed by: (i) a member in the Division; or (ii) an associate member who participated, or could have participated, in the making of the Division’s decision to perform the delegated function or exercise the delegated power; is prima facie evidence of the matter." ;
    cof:pageNumber "41"^^xsd:integer .

concept:australian-communications-and-media-authority-act-2005-sec-50-ss-3 a cml:Concept ;
    skos:prefLabel "50(3) Delegations by ACMA to a Division"@en ;
    cml:realizedBy doc:sec-50-ss-3 ;
    values:originalText "(3) A document purporting to be a certificate mentioned in subsection (2) is taken to be such a certificate and to have been duly given unless the contrary is established." ;
    skos:definition "(3) A document purporting to be a certificate mentioned in subsection (2) is taken to be such a certificate and to have been duly given unless the contrary is established."@en ;
