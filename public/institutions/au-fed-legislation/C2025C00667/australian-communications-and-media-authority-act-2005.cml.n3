concept:australian-communications-and-media-authority-act-2005-sec-16 a cml:Concept ;
    skos:prefLabel "16 Consistency with CER Trade in Services Protocol"@en ;
    cml:realizedBy doc:sec-16 ;
    values:originalText "The ACMA must perform its broadcasting, content and datacasting functions, and exercise its powers relating to those functions, in a manner consistent with Australia’s obligations under the CER Trade in Services Protocol (as defined in the Broadcasting Services Act 1992)." ;
    skos:definition "The ACMA must perform its broadcasting, content and datacasting functions, and exercise its powers relating to those functions, in a manner consistent with Australia’s obligations under the CER Trade in Services Protocol (as defined in the Broadcasting Services Act 1992)."@en ;
    cml:integrityHash "0d9bd04a949a8b3bfdc974f1eea18e4628f17d4cebbb2cd68469feb27f7dc82e" ;
    cof:pageNumber "21"^^xsd:integer ;
    skos:note "Must perform broadcasting functions consistently with CER Trade in Services Protocol obligations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
