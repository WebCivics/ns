      }
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-67a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "No liability implies no obligation to provide",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No liability for damages",
      "cml:conclusionText": "No obligation to provide"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-67a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Excludes",
      "cml:logicSummary": "Good faith exercise of power excludes liability",
      "cml:executionSurface": "modalities::logic::deontic",
