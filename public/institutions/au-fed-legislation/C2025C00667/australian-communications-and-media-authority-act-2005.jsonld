    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Participation etc. by associate members at meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.34",
      "values:originalText": "(1) An associate member is entitled to attend, and participate in\ndiscussions at, a meeting of the ACMA while the meeting is\nconsidering a matter connected with an inquiry, investigation,\nhearing or other matter specified in the associate member’s\ninstrument of appointment.\n(2) Subsection (1) has effect subject to rules made for the purposes of\nsection 29 of the Public Governance, Performance and\nAccountability Act 2013.",
