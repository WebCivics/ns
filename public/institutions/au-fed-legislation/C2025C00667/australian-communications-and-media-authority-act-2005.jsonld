    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Appointment of associate members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.26",
      "values:originalText": "(1) The Minister may appoint as many associate members of the\nACMA as he or she thinks fit.\n(2) Each associate member is to be appointed by the Minister by\nwritten instrument.\n(3) An associate member may be appointed as a full-time associate\nmember or as a part-time associate member.\n(4) An associate member’s instrument of appointment must contain a\nstatement to the effect that the associate member’s appointment\nrelates to 1 or more specified matters, being:\n(a) an inquiry, investigation or hearing; or\n(b) any other matter that relates to the performance of the\nACMA’s functions or the exercise of the ACMA’s powers.",
      "skos:definition": "(1) The Minister may appoint as many associate members of the\nACMA as he or she thinks fit.\n(2) Each associate member is to be appointed by the Minister by\nwritten instrument.\n(3) An associate member may be appointed as a full-time associate\nmember or as a part-time associate member.\n(4) An associate member’s instrument of appointment must contain a\nstatement to the effect that the associate member’s appointment\nrelates to 1 or more specified matters, being:\n(a) an inquiry, investigation or hearing; or\n(b) any other matter that relates to the performance of the\nACMA’s functions or the exercise of the ACMA’s powers.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-4"
        }
      ],
      "cml:integrityHash": "0ce69fa7e1d89cba78c65575e3605bf54c120ca2ffbf2549c7853f75d765d6e0"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Appointment of associate members",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "(1) The Minister may appoint as many associate members of the\nACMA as he or she thinks fit.\n(2) Each associate member is to be appointed by the Minister by\nwritten instrument.\n(3) An associate member may be appointed as a full-time associate\nmember or as a part-time associate member.\n(4) An associate member’s instrument of appointment must contain a\nstatement to the effect that the associate member’s appointment\nrelates to 1 or more specified matters, being:\n(a) an inquiry, investigation or hearing; or\n(b) any other matter that relates to the performance of the\nACMA’s functions or the exercise of the ACMA’s powers."
    },
