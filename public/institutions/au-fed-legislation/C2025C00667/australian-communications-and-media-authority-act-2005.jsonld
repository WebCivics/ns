      ],
      "cml:integrityHash": "b3b617e56fff9e03126393a15b8f2c93bef59657a0d8b3f5f4dcdfc1787d66c3",
      "skos:note": "ACMA membership requirements"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Membership",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "The ACMA consists of the following members:\n(a) a Chair;\n(b) a Deputy Chair;\n(c) at least 1, and not more than 7, other members."
    },
