    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.29",
      "values:originalText": "(1) A member or associate member is to be paid the remuneration that\nis determined by the Remuneration Tribunal. If no determination of\nthat remuneration by the Tribunal is in operation, the member or\nassociate member is to be paid the remuneration that is prescribed\nin the regulations.\n(2) A member or associate member is to be paid the allowances that\nare prescribed in the regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "skos:definition": "(1) A member or associate member is to be paid the remuneration that\nis determined by the Remuneration Tribunal. If no determination of\nthat remuneration by the Tribunal is in operation, the member or\nassociate member is to be paid the remuneration that is prescribed\nin the regulations.\n(2) A member or associate member is to be paid the allowances that\nare prescribed in the regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-28-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-28-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-28-ss-3"
        }
      ],
      "cml:integrityHash": "af020379d10c36a4f871edc34d925d45780799459b13887eadad9d2fbce019da"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Remuneration",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "(1) A member or associate member is to be paid the remuneration that\nis determined by the Remuneration Tribunal. If no determination of\nthat remuneration by the Tribunal is in operation, the member or\nassociate member is to be paid the remuneration that is prescribed\nin the regulations.\n(2) A member or associate member is to be paid the allowances that\nare prescribed in the regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973."
    },
