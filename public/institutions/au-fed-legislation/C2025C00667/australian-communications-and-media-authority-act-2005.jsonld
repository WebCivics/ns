    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Record of decisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.36",
      "values:originalText": "The ACMA must keep a record of decisions made in accordance\nwith section 44.\n\n\nDecision-making and delegation by ACMA  Part 4\nDivisions  Division 3\nSection 46\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
