          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-4"
        }
      ],
