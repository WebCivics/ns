    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 ACMA not otherwise subject to direction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.21",
      "values:originalText": "Except as otherwise provided by or under this or any other Act, the\nACMA is not subject to direction by or on behalf of the\nCommonwealth.",
      "skos:definition": "Except as otherwise provided by or under this or any other Act, the\nACMA is not subject to direction by or on behalf of the\nCommonwealth.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-15-norm"
        }
      ],
      "cml:integrityHash": "3d0fdb4a1a46bc240c9d6b3911dd2acef0fbc56326192417bab467d95e6e935d",
      "skos:note": "ACMA is not subject to direction by or on behalf of the Commonwealth."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-15",
      "@type": "cof:Section",
      "cof:title": "15 ACMA not otherwise subject to direction",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "Except as otherwise provided by or under this or any other Act, the\nACMA is not subject to direction by or on behalf of the\nCommonwealth."
    },
