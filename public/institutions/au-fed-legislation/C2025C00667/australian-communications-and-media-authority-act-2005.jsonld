      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.62",
      "values:originalText": "If section 60, or a provision of another Act, authorises the ACMA\nto fix a charge (however described), that charge is payable to the\nCommonwealth.",
      "skos:definition": "If section 60, or a provision of another Act, authorises the ACMA\nto fix a charge (however described), that charge is payable to the\nCommonwealth.",
