      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59e",
      "@type": "cml:Concept",
      "skos:prefLabel": "59E Disclosure with consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.58",
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nthat relates to the affairs of a person if:\n(a) the person has consented to the disclosure; and\n(b) the disclosure is in accordance with that consent.\n(2) For the purposes of this section, an ACMA official is taken to\ndisclose information if the information is published by the ACMA:\n(a) on the ACMA’s website; or\n(b) in any other way.\n(3) Subsection (2) is enacted for the avoidance of doubt.",
      "skos:definition": "(1) An ACMA official may disclose authorised disclosure information\nthat relates to the affairs of a person if:\n(a) the person has consented to the disclosure; and\n(b) the disclosure is in accordance with that consent.\n(2) For the purposes of this section, an ACMA official is taken to\ndisclose information if the information is published by the ACMA:\n(a) on the ACMA’s website; or\n(b) in any other way.\n(3) Subsection (2) is enacted for the avoidance of doubt.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59e-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59e-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59e-ss-3"
        }
      ],
      "cml:integrityHash": "0dd2233a7a198bdf3b74f71ed31d0ecae2c09d202efb58fd10473440fb914e5e"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59e",
      "@type": "cof:Section",
      "cof:title": "59E Disclosure with consent",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nthat relates to the affairs of a person if:\n(a) the person has consented to the disclosure; and\n(b) the disclosure is in accordance with that consent.\n(2) For the purposes of this section, an ACMA official is taken to\ndisclose information if the information is published by the ACMA:\n(a) on the ACMA’s website; or\n(b) in any other way.\n(3) Subsection (2) is enacted for the avoidance of doubt."
    },
