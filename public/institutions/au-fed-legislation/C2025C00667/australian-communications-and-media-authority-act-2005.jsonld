    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59a",
      "@type": "cof:Section",
      "cof:title": "59A Disclosure to Ministers",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nto the Minister.\n(2) An ACMA official may disclose to a Minister authorised\ndisclosure information that relates to a matter arising under a\nprovision of an Act that is administered by that Minister.\n(3) Subsection (2) does not limit subsection (1)."
    },
