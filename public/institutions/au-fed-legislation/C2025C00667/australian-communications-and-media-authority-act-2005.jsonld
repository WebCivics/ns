          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-42-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-42-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d38c00f259190fc0049e9e2fb12a8a6d75cc4f7cddc791efaf3104e86ca42cee",
      "skos:note": "Regulate proceedings at meetings as considered appropriate."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Conduct of meetings",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "The ACMA may, subject to this Division, regulate proceedings at\nits meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc."
    },
