    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Times and places of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.33",
      "values:originalText": "(1) The ACMA is to hold such meetings as are necessary for the\nefficient performance of its functions.\n(2) Meetings are to be held at such times and places as the ACMA\ndecides. This subsection has effect subject to subsections (3) and\n(4).\n(3) The Chair may call a meeting at any time.\n(4) The Chair must call a meeting if requested to do so in writing by:\n(a) the Minister; or\n(b) at least 2 other members.",
      "skos:definition": "(1) The ACMA is to hold such meetings as are necessary for the\nefficient performance of its functions.\n(2) Meetings are to be held at such times and places as the ACMA\ndecides. This subsection has effect subject to subsections (3) and\n(4).\n(3) The Chair may call a meeting at any time.\n(4) The Chair must call a meeting if requested to do so in writing by:\n(a) the Minister; or\n(b) at least 2 other members.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-36-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-36-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-36-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-36-ss-4"
        }
      ],
      "cml:integrityHash": "68b450c151ecf714882ef3f473945a0a8ea80c327aa83907cef9990d16ac0289"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Times and places of meetings",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "(1) The ACMA is to hold such meetings as are necessary for the\nefficient performance of its functions.\n(2) Meetings are to be held at such times and places as the ACMA\ndecides. This subsection has effect subject to subsections (3) and\n(4).\n(3) The Chair may call a meeting at any time.\n(4) The Chair must call a meeting if requested to do so in writing by:\n(a) the Minister; or\n(b) at least 2 other members."
    },
