      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exempt",
      "cml:logicSummary": "Exempts from duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The other full-time members and the full-time associate members must not engage in paid employment outside the duties of their offices without the Chair’s approval.",
      "cml:conclusionText": "This obligation is exempted for Chair's approval"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.30",
      "values:originalText": "(1) A full-time member or full-time associate member has the\nrecreation leave entitlements that are determined by the\nRemuneration Tribunal.\n(2) The Minister may grant the Chair leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.\n(3) The Chair may grant another full-time member or a full-time\nassociate member leave of absence, other than recreation leave, on\nthe terms and conditions as to remuneration or otherwise that the\nChair determines.\n(4) The Chair may grant leave of absence to any part-time member, or\npart-time associate member, on the terms and conditions that the\nChair determines.",
      "skos:definition": "(1) A full-time member or full-time associate member has the\nrecreation leave entitlements that are determined by the\nRemuneration Tribunal.\n(2) The Minister may grant the Chair leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.\n(3) The Chair may grant another full-time member or a full-time\nassociate member leave of absence, other than recreation leave, on\nthe terms and conditions as to remuneration or otherwise that the\nChair determines.\n(4) The Chair may grant leave of absence to any part-time member, or\npart-time associate member, on the terms and conditions that the\nChair determines.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-32-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-32-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-32-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-32-ss-4"
        }
      ],
      "cml:integrityHash": "111d656a9a32597f54c1639161622f3259a877b7e6856a381930799eba2c3383"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Leave of absence",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "(1) A full-time member or full-time associate member has the\nrecreation leave entitlements that are determined by the\nRemuneration Tribunal.\n(2) The Minister may grant the Chair leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.\n(3) The Chair may grant another full-time member or a full-time\nassociate member leave of absence, other than recreation leave, on\nthe terms and conditions as to remuneration or otherwise that the\nChair determines.\n(4) The Chair may grant leave of absence to any part-time member, or\npart-time associate member, on the terms and conditions that the\nChair determines."
    },
