    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Charges are payable to the Commonwealth",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-61"
      },
      "cml:curationStatus": {
