    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Period of appointment for members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.23",
      "values:originalText": "Period of current appointment\n(1) A member holds office for the period specified in his or her\ninstrument of appointment. The period must not exceed 5 years.",
      "skos:definition": "Period of current appointment\n(1) A member holds office for the period specified in his or her\ninstrument of appointment. The period must not exceed 5 years.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-21-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b0aa1f658c66932aadce747606d43ce2fbc5935b8245934c61bed912a7533562",
      "skos:note": "Member must hold office for a specified period not exceeding 5 years."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Period of appointment for members",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Period of current appointment\n(1) A member holds office for the period specified in his or her\ninstrument of appointment. The period must not exceed 5 years."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-21-norm",
