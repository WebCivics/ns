          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-35-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-35-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8ed8cc93d2e37b9293b8fb2730bcd57f5068f3c68e804e48cba4983f8c5cf865",
      "skos:note": "Member or associate member holds office on terms and conditions determined by the appointer."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-35",
