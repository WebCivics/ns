    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "59B(2) Disclosure to public servants for advising their Ministers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59b-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
