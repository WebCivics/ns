    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "not",
      "cml:logicSummary": "Negative obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Appointment to advisory committee is a public office.",
      "cml:conclusionText": "Appointment to advisory committee is not a public office."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval: Appointment to advisory committee -> [1973-01-01, 1973-12-31]",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Appointment to advisory committee is an appointment made in 1973.",
      "cml:conclusionText": "Appointment to advisory committee is not a public office during this period."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-5-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "If appointment to advisory committee is a public office, then it is not an appointment to advisory committee.",
