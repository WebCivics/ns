    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-67a",
      "@type": "cml:Concept",
      "skos:prefLabel": "67A Liability for damages—public warning notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-67a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.67",
      "values:originalText": "None of the following:\n(a) the Commonwealth;\n(b) the ACMA;\n(c) an ACMA official;\nis liable to an action or other proceeding for damages for, or in\nrelation to, an act or matter done in good faith in the exercise, or\npurported exercise, of the ACMA’s power under section 284N of\nthe Radiocommunications Act 1992.",
      "skos:definition": "None of the following:\n(a) the Commonwealth;\n(b) the ACMA;\n(c) an ACMA official;\nis liable to an action or other proceeding for damages for, or in\nrelation to, an act or matter done in good faith in the exercise, or\npurported exercise, of the ACMA’s power under section 284N of\nthe Radiocommunications Act 1992.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-67a-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-67a-logic-deontic-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-67a-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "847ade9a1f3d2fb58f7359f5edde0250db4efb994568b6dcdc560e41cac5f61e",
      "skos:note": "No liability for damages for acts done in good faith under section 284N"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-67a",
      "@type": "cof:Section",
      "cof:title": "67A Liability for damages—public warning notices",
      "values:kind": "section",
      "cof:pageNumber": 67,
      "values:originalText": "None of the following:\n(a) the Commonwealth;\n(b) the ACMA;\n(c) an ACMA official;\nis liable to an action or other proceeding for damages for, or in\nrelation to, an act or matter done in good faith in the exercise, or\npurported exercise, of the ACMA’s power under section 284N of\nthe Radiocommunications Act 1992."
    },
