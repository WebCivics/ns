    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.30",
      "values:originalText": "A member or associate member may resign his or her appointment\nby giving the appointer a written resignation.",
      "skos:definition": "A member or associate member may resign his or her appointment\nby giving the appointer a written resignation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-33-norm"
        }
      ],
      "cml:integrityHash": "3d19655cc7bdc319d9884efb98295e2cfbc44343fd3d6f62470a33b968b9b292",
      "skos:note": "A member or associate member may resign their appointment by giving the appointer a written resignation."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Resignation",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "A member or associate member may resign his or her appointment\nby giving the appointer a written resignation."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-33-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
