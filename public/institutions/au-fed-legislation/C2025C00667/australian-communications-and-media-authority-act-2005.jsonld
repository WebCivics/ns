    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 ACMA’s spectrum management functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.15",
      "values:originalText": "The ACMA’s spectrum management functions are as follows:\n(a) to manage the radiofrequency spectrum in accordance with\nthe Radiocommunications Act 1992;\n(b) to advise and assist the radiocommunications community;\n(c) to report to and advise the Minister in relation to the\nradiocommunications community;\n(d) to manage Australia’s input into the setting of international\nstandards for radiocommunications (except so far as\nStandards Australia is responsible for managing that input);\n(e) to make available to the public information about matters\nrelating to the radiocommunications community;",
      "skos:definition": "The ACMA’s spectrum management functions are as follows:\n(a) to manage the radiofrequency spectrum in accordance with\nthe Radiocommunications Act 1992;\n(b) to advise and assist the radiocommunications community;\n(c) to report to and advise the Minister in relation to the\nradiocommunications community;\n(d) to manage Australia’s input into the setting of international\nstandards for radiocommunications (except so far as\nStandards Australia is responsible for managing that input);\n(e) to make available to the public information about matters\nrelating to the radiocommunications community;",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-9-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b43addfd41258b85c948ba5a28d5aebac5253e017ac04a5a669c261164fb72ca",
      "skos:note": "ACMA's spectrum management functions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 ACMA’s spectrum management functions",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "The ACMA’s spectrum management functions are as follows:\n(a) to manage the radiofrequency spectrum in accordance with\nthe Radiocommunications Act 1992;\n(b) to advise and assist the radiocommunications community;\n(c) to report to and advise the Minister in relation to the\nradiocommunications community;\n(d) to manage Australia’s input into the setting of international\nstandards for radiocommunications (except so far as\nStandards Australia is responsible for managing that input);\n(e) to make available to the public information about matters\nrelating to the radiocommunications community;"
    },
