      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the delegation is only for the purposes of one or both of the following:",
      "cml:conclusionText": "...to a person under this section if..."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Justification",
      "cml:logicSummary": "Division justifies delegation by considering policy and decision requirements.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "if the delegation is for the purposes of giving effect to a\npolicy or a decision of the Division—having regard to what\nwould be required, necessary or convenient to give effect to\nthe policy or decision,",
      "cml:conclusionText": "...the Division is satisfied that it is\nappropriate for a delegate to exercise the power;"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-1a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Person eligible for delegation must meet specified conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the person is:\n(i) a member;\n(ii) an SES employee or an acting SES employee;\n(iii) a person holding, or performing the duties of, an office\nor position that is at a level equivalent to that of an SES\nemployee.",
      "cml:conclusionText": "...if the delegation is for the purposes of giving effect to a policy or decision of the Division—"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-52-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "52(2) Delegations by a Division",
