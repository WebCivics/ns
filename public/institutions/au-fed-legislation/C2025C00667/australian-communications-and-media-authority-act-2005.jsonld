    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59g",
      "@type": "cml:Concept",
      "skos:prefLabel": "59G Disclosure of summaries and statistics",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.59",
      "values:originalText": "(1) An ACMA official may disclose:\n(a) summaries of authorised disclosure information that are not\nlikely to enable the identification of a person; and\n(b) statistics derived from authorised disclosure information that\nare not likely to enable the identification of a person.\n(2) For the purposes of this section, an ACMA official is taken to\ndisclose summaries or statistics if the summaries or statistics are\npublished by the ACMA:\n(a) on the ACMA’s website; or\n(b) in any other way.\n(3) Subsection (2) is enacted for the avoidance of doubt.",
      "skos:definition": "(1) An ACMA official may disclose:\n(a) summaries of authorised disclosure information that are not\nlikely to enable the identification of a person; and\n(b) statistics derived from authorised disclosure information that\nare not likely to enable the identification of a person.\n(2) For the purposes of this section, an ACMA official is taken to\ndisclose summaries or statistics if the summaries or statistics are\npublished by the ACMA:\n(a) on the ACMA’s website; or\n(b) in any other way.\n(3) Subsection (2) is enacted for the avoidance of doubt.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59g-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59g-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59g-ss-3"
        }
      ],
      "cml:integrityHash": "a21f918fa1aad90810050e2d43c56e846773f91b02c44d0dbb14fc70a2937e39"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59g",
      "@type": "cof:Section",
      "cof:title": "59G Disclosure of summaries and statistics",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "(1) An ACMA official may disclose:\n(a) summaries of authorised disclosure information that are not\nlikely to enable the identification of a person; and\n(b) statistics derived from authorised disclosure information that\nare not likely to enable the identification of a person.\n(2) For the purposes of this section, an ACMA official is taken to\ndisclose summaries or statistics if the summaries or statistics are\npublished by the ACMA:\n(a) on the ACMA’s website; or\n(b) in any other way.\n(3) Subsection (2) is enacted for the avoidance of doubt."
    },
