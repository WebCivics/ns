    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Establishment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.13",
      "values:originalText": "(1) The Australian Communications and Media Authority is\nestablished by this section.\nNote:\nThe ACMA does not have a legal identity separate from the\nCommonwealth.\n(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the ACMA is a listed entity; and\n(b) the Chair is the accountable authority of the ACMA; and\n(c) the ACMA officials are officials of the ACMA; and\n(d) the purposes of the ACMA include the functions of the\nACMA referred to in Division 2 of Part 2.",
      "skos:definition": "(1) The Australian Communications and Media Authority is\nestablished by this section.\nNote:\nThe ACMA does not have a legal identity separate from the\nCommonwealth.\n(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the ACMA is a listed entity; and\n(b) the Chair is the accountable authority of the ACMA; and\n(c) the ACMA officials are officials of the ACMA; and\n(d) the purposes of the ACMA include the functions of the\nACMA referred to in Division 2 of Part 2.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-6-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-6-ss-2"
        }
      ],
      "cml:integrityHash": "1761466482cd8d43b486ccd1fd476bf5e935554f73fadb85da11df7cd28e70ec"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Establishment",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) The Australian Communications and Media Authority is\nestablished by this section.\nNote:\nThe ACMA does not have a legal identity separate from the\nCommonwealth.\n(2) For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the ACMA is a listed entity; and\n(b) the Chair is the accountable authority of the ACMA; and\n(c) the ACMA officials are officials of the ACMA; and\n(d) the purposes of the ACMA include the functions of the\nACMA referred to in Division 2 of Part 2."
    },
