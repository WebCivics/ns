          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-62a-ss-1-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "89e67eb7c06402585514e1752dfccbe25a7fbf3464ba2cb2570e6ac5a6539910",
      "skos:note": "ACMA can make decisions relating to the Commonwealth and its authorities. Proceedings may be brought in the name of ACMA."
    },
