    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Notice of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.33",
      "values:originalText": "Reasonable efforts must be made to inform the following people\nabout proposed meetings of the ACMA:\n(a) the members;\n(b) if the agenda for the proposed meeting mentions a matter\nconnected with an inquiry, investigation, hearing or other\nmatter specified in 1 or more associate members’ instruments\nof appointment—that associate member, or each of those\nassociate members.",
      "skos:definition": "Reasonable efforts must be made to inform the following people\nabout proposed meetings of the ACMA:\n(a) the members;\n(b) if the agenda for the proposed meeting mentions a matter\nconnected with an inquiry, investigation, hearing or other\nmatter specified in 1 or more associate members’ instruments\nof appointment—that associate member, or each of those\nassociate members.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-37-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0c75b430e8a60cb6b3aff89ab50ab2e80ad37a0d3ddd693295c62b6e3e80990f",
      "skos:note": "Must inform specified people about proposed meetings."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-37",
      "@type": "cof:Section",
      "cof:title": "37 Notice of meetings",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "Reasonable efforts must be made to inform the following people\nabout proposed meetings of the ACMA:\n(a) the members;\n(b) if the agenda for the proposed meeting mentions a matter\nconnected with an inquiry, investigation, hearing or other\nmatter specified in 1 or more associate members’ instruments\nof appointment—that associate member, or each of those\nassociate members."
    },
    {
