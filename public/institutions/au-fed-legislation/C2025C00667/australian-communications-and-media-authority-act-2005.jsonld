    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 ACMA to consult ACCC in relation to management of electronic",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.22",
      "values:originalText": "addressing\nThe ACMA must consult the Australian Competition and\nConsumer Commission before carrying out an act:\n(a) for the purpose of performing its functions under\nparagraph 11(1)(a) or (b); and\n(b) that would, in the ACMA’s opinion, have a significant effect\non competition or consumer protection.\n\n\nACMA’s membership  Part 3\nMembership  Division 2\nSection 19\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "skos:definition": "addressing\nThe ACMA must consult the Australian Competition and\nConsumer Commission before carrying out an act:\n(a) for the purpose of performing its functions under\nparagraph 11(1)(a) or (b); and\n(b) that would, in the ACMA’s opinion, have a significant effect\non competition or consumer protection.\n\n\nACMA’s membership  Part 3\nMembership  Division 2\nSection 19\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-17-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1c4d26bf0ccc51c2df0916a62d646cee62f54bd3fa864f1f1b84c9358e44d204",
      "skos:note": "ACMA must consult ACCC before performing certain acts."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 ACMA to consult ACCC in relation to management of electronic",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "addressing\nThe ACMA must consult the Australian Competition and\nConsumer Commission before carrying out an act:\n(a) for the purpose of performing its functions under\nparagraph 11(1)(a) or (b); and\n(b) that would, in the ACMA’s opinion, have a significant effect\non competition or consumer protection.\n\n\nACMA’s membership  Part 3\nMembership  Division 2\nSection 19\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025"
    },
