    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Conduct of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.35",
      "values:originalText": "The ACMA may, subject to this Division, regulate proceedings at\nits meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.",
      "skos:definition": "The ACMA may, subject to this Division, regulate proceedings at\nits meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.",
