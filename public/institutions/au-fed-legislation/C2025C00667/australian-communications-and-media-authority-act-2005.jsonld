    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 Advisory committees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-58"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.50",
      "values:originalText": "(1) The ACMA may, by writing, establish advisory committees to\nassist it in performing any of its functions.\n(2) An advisory committee consists of such persons as the ACMA\nfrom time to time appoints to the committee.\n(3) The ACMA may revoke a person’s appointment to an advisory\ncommittee.\n(4) The ACMA may give an advisory committee written directions as\nto:\n(a) the way in which the committee is to carry out its functions;\nand\n(b) procedures to be followed in relation to meetings.\n(5) An appointment to an advisory committee is not a public office\nwithin the meaning of the Remuneration Tribunal Act 1973.",
      "skos:definition": "(1) The ACMA may, by writing, establish advisory committees to\nassist it in performing any of its functions.\n(2) An advisory committee consists of such persons as the ACMA\nfrom time to time appoints to the committee.\n(3) The ACMA may revoke a person’s appointment to an advisory\ncommittee.\n(4) The ACMA may give an advisory committee written directions as\nto:\n(a) the way in which the committee is to carry out its functions;\nand\n(b) procedures to be followed in relation to meetings.\n(5) An appointment to an advisory committee is not a public office\nwithin the meaning of the Remuneration Tribunal Act 1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-4"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-5"
        }
      ],
      "cml:integrityHash": "4e6914466290e88584fc982cc38650de2386cd89a451f707281c15e9307aa0b3"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-58",
      "@type": "cof:Section",
      "cof:title": "58 Advisory committees",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "(1) The ACMA may, by writing, establish advisory committees to\nassist it in performing any of its functions.\n(2) An advisory committee consists of such persons as the ACMA\nfrom time to time appoints to the committee.\n(3) The ACMA may revoke a person’s appointment to an advisory\ncommittee.\n(4) The ACMA may give an advisory committee written directions as\nto:\n(a) the way in which the committee is to carry out its functions;\nand\n(b) procedures to be followed in relation to meetings.\n(5) An appointment to an advisory committee is not a public office\nwithin the meaning of the Remuneration Tribunal Act 1973."
    },
