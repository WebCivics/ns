    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Consistency with CER Trade in Services Protocol",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.21",
      "values:originalText": "The ACMA must perform its broadcasting, content and datacasting\nfunctions, and exercise its powers relating to those functions, in a\nmanner consistent with Australia’s obligations under the CER\nTrade in Services Protocol (as defined in the Broadcasting Services\nAct 1992).",
      "skos:definition": "The ACMA must perform its broadcasting, content and datacasting\nfunctions, and exercise its powers relating to those functions, in a\nmanner consistent with Australia’s obligations under the CER\nTrade in Services Protocol (as defined in the Broadcasting Services\nAct 1992).",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-16-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0d9bd04a949a8b3bfdc974f1eea18e4628f17d4cebbb2cd68469feb27f7dc82e",
      "skos:note": "Must perform broadcasting functions consistently with CER Trade in Services Protocol obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Consistency with CER Trade in Services Protocol",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The ACMA must perform its broadcasting, content and datacasting\nfunctions, and exercise its powers relating to those functions, in a\nmanner consistent with Australia’s obligations under the CER\nTrade in Services Protocol (as defined in the Broadcasting Services\nAct 1992)."
    },
