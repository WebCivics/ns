    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Minutes etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.40",
      "values:originalText": "A Division must:\n(a) keep minutes of its meetings; and\n(b) keep a record of decisions made in accordance with\nsection 48.\n\n\nDecision-making and delegation by ACMA  Part 4\nDelegations  Division 4\nSection 50\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "skos:definition": "A Division must:\n(a) keep minutes of its meetings; and\n(b) keep a record of decisions made in accordance with\nsection 48.\n\n\nDecision-making and delegation by ACMA  Part 4\nDelegations  Division 4\nSection 50\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-49-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7426667bc10fd2afa38fb2b6f724de7a0717401534055d1c08065cdac01bece2",
      "skos:note": "Keep minutes and decisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Minutes etc.",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "A Division must:\n(a) keep minutes of its meetings; and\n(b) keep a record of decisions made in accordance with\nsection 48.\n\n\nDecision-making and delegation by ACMA  Part 4\nDelegations  Division 4\nSection 50\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025"
    },
