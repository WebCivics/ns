      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A Division cannot:"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Division can make decisions without meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.39",
      "values:originalText": "(1) A decision is taken to have been made at a meeting of a Division\nif:\n(a) without meeting, a majority of the members in the Division\nindicate agreement with the proposed decision in accordance\nwith the method determined by the Division under\nsubsection (2); and\n(b) all the members in the Division were informed of the\nproposed decision, or reasonable efforts were made to inform\nall those members of the proposed decision.\n(2) Subsection (1) applies only if the Division:\n(a) has determined that it applies; and",
      "skos:definition": "(1) A decision is taken to have been made at a meeting of a Division\nif:\n(a) without meeting, a majority of the members in the Division\nindicate agreement with the proposed decision in accordance\nwith the method determined by the Division under\nsubsection (2); and\n(b) all the members in the Division were informed of the\nproposed decision, or reasonable efforts were made to inform\nall those members of the proposed decision.\n(2) Subsection (1) applies only if the Division:\n(a) has determined that it applies; and",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-48-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-48-ss-2"
        }
      ],
      "cml:integrityHash": "e46cbb39dcb2026616214925d4f2e90f359a189e4c42906ecc4295b0c65b9c74"
    },
    {
