      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.14",
      "values:originalText": "The ACMA has the functions described in this Division.",
      "skos:definition": "The ACMA has the functions described in this Division.",
      "cml:asserts": [
