    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Annual reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.47",
      "values:originalText": "The annual report prepared by the Chair and given to the Minister\nunder section 46 of the Public Governance, Performance and\nAccountability Act 2013 for a period must include:\n(a) a copy of each direction given to the ACMA under section 14\nduring the period; and\n(aa) a report on the following matters:\n(i) remuneration, and other employment-related costs and\nexpenses, in respect of APS employees whose duties\nrelate to the performance of the eSafety Commissioner’s\nfunctions or the exercise of the eSafety Commissioner’s\npowers;\n(ii) any other costs, expenses and other obligations incurred\nby the Commonwealth in connection with the\nperformance of the eSafety Commissioner’s functions\nor the exercise of the eSafety Commissioner’s powers;\nand\n(b) if:",
      "skos:definition": "The annual report prepared by the Chair and given to the Minister\nunder section 46 of the Public Governance, Performance and\nAccountability Act 2013 for a period must include:\n(a) a copy of each direction given to the ACMA under section 14\nduring the period; and\n(aa) a report on the following matters:\n(i) remuneration, and other employment-related costs and\nexpenses, in respect of APS employees whose duties\nrelate to the performance of the eSafety Commissioner’s\nfunctions or the exercise of the eSafety Commissioner’s\npowers;\n(ii) any other costs, expenses and other obligations incurred\nby the Commonwealth in connection with the\nperformance of the eSafety Commissioner’s functions\nor the exercise of the eSafety Commissioner’s powers;\nand\n(b) if:",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-57-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-57-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d810f082767db2614ddb46914aad96fe8bb0db12c0a76ab0d864ea45f8c4713c",
      "skos:note": "Annual report must include certain information.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Annual reports",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "The annual report prepared by the Chair and given to the Minister\nunder section 46 of the Public Governance, Performance and\nAccountability Act 2013 for a period must include:\n(a) a copy of each direction given to the ACMA under section 14\nduring the period; and\n(aa) a report on the following matters:\n(i) remuneration, and other employment-related costs and\nexpenses, in respect of APS employees whose duties\nrelate to the performance of the eSafety Commissioner’s\nfunctions or the exercise of the eSafety Commissioner’s\npowers;\n(ii) any other costs, expenses and other obligations incurred\nby the Commonwealth in connection with the\nperformance of the eSafety Commissioner’s functions\nor the exercise of the eSafety Commissioner’s powers;\nand\n(b) if:"
    },
