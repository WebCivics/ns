    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59c",
      "@type": "cml:Concept",
      "skos:prefLabel": "59C Disclosure to Royal Commissions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.53",
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nto a Royal Commission (within the meaning of the Royal\nCommissions Act 1902).\n(2) The Chair may, by writing, impose conditions to be complied with\nin relation to authorised disclosure information disclosed under\nsubsection (1).\n(3) An instrument made under subsection (2) that imposes conditions\nrelating to one particular disclosure identified in the instrument is\nnot a legislative instrument.\n(4) Otherwise, an instrument made under subsection (2) is a legislative\ninstrument.",
      "skos:definition": "(1) An ACMA official may disclose authorised disclosure information\nto a Royal Commission (within the meaning of the Royal\nCommissions Act 1902).\n(2) The Chair may, by writing, impose conditions to be complied with\nin relation to authorised disclosure information disclosed under\nsubsection (1).\n(3) An instrument made under subsection (2) that imposes conditions\nrelating to one particular disclosure identified in the instrument is\nnot a legislative instrument.\n(4) Otherwise, an instrument made under subsection (2) is a legislative\ninstrument.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59c-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59c-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59c-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59c-ss-4"
        }
      ],
      "cml:integrityHash": "396e765d52dc2df5669c2d6d2016eec5e224bf76aec2dcf3abe2eb95de2c8102"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59c",
      "@type": "cof:Section",
      "cof:title": "59C Disclosure to Royal Commissions",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nto a Royal Commission (within the meaning of the Royal\nCommissions Act 1902).\n(2) The Chair may, by writing, impose conditions to be complied with\nin relation to authorised disclosure information disclosed under\nsubsection (1).\n(3) An instrument made under subsection (2) that imposes conditions\nrelating to one particular disclosure identified in the instrument is\nnot a legislative instrument.\n(4) Otherwise, an instrument made under subsection (2) is a legislative\ninstrument."
    },
    {
