    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Acting appointments—associate members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.28",
      "values:originalText": "The Minister may appoint a person to act as an associate member\nduring any period, or during all periods, when an associate\nmember:\n(a) is acting as a member; or\n(b) is absent from duty or from Australia; or\n(c) is, for any reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "skos:definition": "The Minister may appoint a person to act as an associate member\nduring any period, or during all periods, when an associate\nmember:\n(a) is acting as a member; or\n(b) is absent from duty or from Australia; or\n(c) is, for any reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-26-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "95951fc35920a1ef25fc84ded9842084295361014cf6032e5bf326ce88d225d9",
      "skos:note": "The Minister may appoint a person to act as an associate member."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Acting appointments—associate members",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "The Minister may appoint a person to act as an associate member\nduring any period, or during all periods, when an associate\nmember:\n(a) is acting as a member; or\n(b) is absent from duty or from Australia; or\n(c) is, for any reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-26-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-communications-and-media-authority-act-2005-sec-26"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-26-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "The Minister has the power to appoint.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Associate members to be treated as members for certain purposes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.28",
      "values:originalText": "in other Acts\n(1) For the purposes of a reference in an Act other than this Act to a\nmember of the ACMA, an associate member is taken to be a\nmember for all purposes in connection with any inquiry,\ninvestigation, hearing or other matter specified in his or her\ninstrument of appointment.\n(2) Subsection (1) is subject to a contrary intention in the other Act.\n\n\nACMA’s membership  Part 3\nTerms and conditions for members and associate members  Division 3\nSection 28\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "skos:definition": "in other Acts\n(1) For the purposes of a reference in an Act other than this Act to a\nmember of the ACMA, an associate member is taken to be a\nmember for all purposes in connection with any inquiry,\ninvestigation, hearing or other matter specified in his or her\ninstrument of appointment.\n(2) Subsection (1) is subject to a contrary intention in the other Act.\n\n\nACMA’s membership  Part 3\nTerms and conditions for members and associate members  Division 3\nSection 28\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-27-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-27-ss-2"
        }
      ],
      "cml:integrityHash": "6cdfea3c4d36c4daccb6bba2d2ff49b9aa50dddc328c2b68b83ae7774217564d"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Associate members to be treated as members for certain purposes",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "in other Acts\n(1) For the purposes of a reference in an Act other than this Act to a\nmember of the ACMA, an associate member is taken to be a\nmember for all purposes in connection with any inquiry,\ninvestigation, hearing or other matter specified in his or her\ninstrument of appointment.\n(2) Subsection (1) is subject to a contrary intention in the other Act.\n\n\nACMA’s membership  Part 3\nTerms and conditions for members and associate members  Division 3\nSection 28\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025"
    },
