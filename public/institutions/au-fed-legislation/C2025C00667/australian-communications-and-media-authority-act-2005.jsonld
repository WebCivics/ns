          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-61-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e30af2671f86cd5c884f6578ec7aba6cbb725401ff3f78adb038e4de9c65d5f5",
      "skos:note": "Charge payable to Commonwealth"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-61",
      "@type": "cof:Section",
      "cof:title": "61 Charges are payable to the Commonwealth",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "If section 60, or a provision of another Act, authorises the ACMA\nto fix a charge (however described), that charge is payable to the\nCommonwealth."
    },
