    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Acting Chair",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.24",
      "values:originalText": "The Deputy Chair is to act as the Chair:\n(a) during a vacancy in the office of Chair (whether or not an\nappointment has previously been made to the office); or\n(b) during any period, or during all periods, when the Chair:\n\n\nACMA’s membership  Part 3\nMembership  Division 2\nSection 23\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to persons acting as the Chair, see section 33A of\nthe Acts Interpretation Act 1901.",
      "skos:definition": "The Deputy Chair is to act as the Chair:\n(a) during a vacancy in the office of Chair (whether or not an\nappointment has previously been made to the office); or\n(b) during any period, or during all periods, when the Chair:\n\n\nACMA’s membership  Part 3\nMembership  Division 2\nSection 23\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to persons acting as the Chair, see section 33A of\nthe Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-22-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "467ed4b73e589e788c63215ebfe67e8672243cc40026a913891106b10458cc8c",
      "skos:note": "The Deputy Chair must act as the Chair during a vacancy in the office of Chair or when the Chair is absent from duty or unable to perform duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Acting Chair",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "The Deputy Chair is to act as the Chair:\n(a) during a vacancy in the office of Chair (whether or not an\nappointment has previously been made to the office); or\n(b) during any period, or during all periods, when the Chair:\n\n\nACMA’s membership  Part 3\nMembership  Division 2\nSection 23\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025\n(i) is absent from duty or from Australia; or\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to persons acting as the Chair, see section 33A of\nthe Acts Interpretation Act 1901."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-22-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-communications-and-media-authority-act-2005-sec-22"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-22-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Deputy Chair must act as the Chair.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
