    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59a",
      "@type": "cml:Concept",
      "skos:prefLabel": "59A Disclosure to Ministers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59a"
      },
      "cml:curationStatus": {
