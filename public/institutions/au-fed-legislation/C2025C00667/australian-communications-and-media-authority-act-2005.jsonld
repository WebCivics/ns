    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Appointment of members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.23",
      "values:originalText": "(1) Each member is to be appointed by the Governor-General by\nwritten instrument.\n(2) The Chair and the Deputy Chair must be appointed as full-time\nmembers.\n(3) A member, other than the Chair or the Deputy Chair, may be\nappointed as a full-time member or as a part-time member.\n(4) A part-time member may be assigned by the Minister, acting on the\nACMA’s advice, on a full-time basis to an inquiry, investigation or\nhearing. Such an assignment must be in writing.\n(5) For the purposes of this Act (except for subsection 31(2) and\nparagraph 34(5)(b)), a part-time member so assigned is taken to be\na full-time member while the assignment is in force.",
      "skos:definition": "(1) Each member is to be appointed by the Governor-General by\nwritten instrument.\n(2) The Chair and the Deputy Chair must be appointed as full-time\nmembers.\n(3) A member, other than the Chair or the Deputy Chair, may be\nappointed as a full-time member or as a part-time member.\n(4) A part-time member may be assigned by the Minister, acting on the\nACMA’s advice, on a full-time basis to an inquiry, investigation or\nhearing. Such an assignment must be in writing.\n(5) For the purposes of this Act (except for subsection 31(2) and\nparagraph 34(5)(b)), a part-time member so assigned is taken to be\na full-time member while the assignment is in force.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-20-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-20-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-20-ss-3"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-20-ss-4"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-20-ss-5"
        }
      ],
      "cml:integrityHash": "fa626f3e1e15bfb8a74efca72885396121c5615fcc74b6c41747684bc36fd2bb"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Appointment of members",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "(1) Each member is to be appointed by the Governor-General by\nwritten instrument.\n(2) The Chair and the Deputy Chair must be appointed as full-time\nmembers.\n(3) A member, other than the Chair or the Deputy Chair, may be\nappointed as a full-time member or as a part-time member.\n(4) A part-time member may be assigned by the Minister, acting on the\nACMA’s advice, on a full-time basis to an inquiry, investigation or\nhearing. Such an assignment must be in writing.\n(5) For the purposes of this Act (except for subsection 31(2) and\nparagraph 34(5)(b)), a part-time member so assigned is taken to be\na full-time member while the assignment is in force."
    },
    {
