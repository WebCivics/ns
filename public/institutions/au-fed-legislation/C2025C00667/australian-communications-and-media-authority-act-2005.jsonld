    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k",
      "@type": "cml:Concept",
      "skos:prefLabel": "59K Relationship with Part 13 of the Telecommunications Act 1997",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.60",
      "values:originalText": "This Part does not authorise a disclosure of information that is\nprohibited by Part 13 of the Telecommunications Act 1997.\nNote:\nSubsection 299(1) (in Part 13) of the Telecommunications Act 1997\nprohibits an ACMA official who has received information as\ndescribed in that subsection from disclosing the information, except in\ncertain circumstances.",
      "skos:definition": "This Part does not authorise a disclosure of information that is\nprohibited by Part 13 of the Telecommunications Act 1997.\nNote:\nSubsection 299(1) (in Part 13) of the Telecommunications Act 1997\nprohibits an ACMA official who has received information as\ndescribed in that subsection from disclosing the information, except in\ncertain circumstances.",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k-logic-deontic-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "61ab527c15c2d68d7c1fb2b23195d79398d20e7059a0501563c5a715bdff6183",
      "skos:note": "Disclosure of information prohibited by Part 13 of the Telecommunications Act 1997"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59k",
      "@type": "cof:Section",
      "cof:title": "59K Relationship with Part 13 of the Telecommunications Act 1997",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "This Part does not authorise a disclosure of information that is\nprohibited by Part 13 of the Telecommunications Act 1997.\nNote:\nSubsection 299(1) (in Part 13) of the Telecommunications Act 1997\nprohibits an ACMA official who has received information as\ndescribed in that subsection from disclosing the information, except in\ncertain circumstances."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of disclosure",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part 13 of the Telecommunications Act 1997",
      "cml:conclusionText": "ACMA official must not disclose information"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59k-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal interval",
      "cml:logicSummary": "Temporal interval for prohibition",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part 13 of the Telecommunications Act 1997",
      "cml:conclusionText": "Prohibition applies within a specific temporal interval"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59ka",
      "@type": "cml:Concept",
      "skos:prefLabel": "59KA Relationship with Part 7B of the Interactive Gambling Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59ka"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.60",
      "values:originalText": "This Part does not authorise a disclosure of information that is\nprohibited by Part 7B of the Interactive Gambling Act 2001.",
      "skos:definition": "This Part does not authorise a disclosure of information that is\nprohibited by Part 7B of the Interactive Gambling Act 2001.",
      "cml:asserts": [
        {
