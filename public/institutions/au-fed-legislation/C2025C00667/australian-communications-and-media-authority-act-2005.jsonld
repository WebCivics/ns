    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Voting at meetings etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
