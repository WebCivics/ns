    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Definitions determination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.63",
      "values:originalText": "(1) The ACMA may make a written determination defining 1 or more\nexpressions used in specified instruments, being instruments that\nare made by the ACMA under 1 or more specified laws of the\nCommonwealth.\n(2) If the Minister is authorised to make an instrument under a law\nspecified in a determination under subsection (1), the instrument\nmay make provision for or in relation to a matter by applying,\nadopting or incorporating, with or without modification, the\nprovisions of a determination under subsection (1) as in force from\ntime to time.",
      "skos:definition": "(1) The ACMA may make a written determination defining 1 or more\nexpressions used in specified instruments, being instruments that\nare made by the ACMA under 1 or more specified laws of the\nCommonwealth.\n(2) If the Minister is authorised to make an instrument under a law\nspecified in a determination under subsection (1), the instrument\nmay make provision for or in relation to a matter by applying,\nadopting or incorporating, with or without modification, the\nprovisions of a determination under subsection (1) as in force from\ntime to time.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-64-ss-1"
        },
