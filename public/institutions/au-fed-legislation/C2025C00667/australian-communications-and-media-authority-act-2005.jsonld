    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "24(4) Appointment of associate members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-24-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.26",
      "values:originalText": "(4) An associate member’s instrument of appointment must contain a\nstatement to the effect that the associate member’s appointment\nrelates to 1 or more specified matters, being:\n(a) an inquiry, investigation or hearing; or\n(b) any other matter that relates to the performance of the\nACMA’s functions or the exercise of the ACMA’s powers.",
      "skos:definition": "(4) An associate member’s instrument of appointment must contain a\nstatement to the effect that the associate member’s appointment\nrelates to 1 or more specified matters, being:\n(a) an inquiry, investigation or hearing; or\n(b) any other matter that relates to the performance of the\nACMA’s functions or the exercise of the ACMA’s powers.",
      "values:partOf": {
        "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-4-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "40118213e4f6d4132e969eac0bb87b5075f0656c1a3298d3e51a9474651b4b12",
      "skos:note": "Associate member's appointment must contain a statement specifying the matters related to their appointment."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-24-ss-4",
      "@type": "cof:Section",
      "cof:title": "24(4) Appointment of associate members",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(4) An associate member’s instrument of appointment must contain a\nstatement to the effect that the associate member’s appointment\nrelates to 1 or more specified matters, being:\n(a) an inquiry, investigation or hearing; or\n(b) any other matter that relates to the performance of the\nACMA’s functions or the exercise of the ACMA’s powers."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-communications-and-media-authority-act-2005-sec-24-ss-4"
