        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59-ss-6"
        }
      ],
      "cml:integrityHash": "94ef123b5b22c6d00374b65d9a9aabb0676325465c7f50cf18d6f8aea2990a74"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59",
