    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Acting appointments—members other than the Chair",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
