      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.44",
      "values:originalText": "(3) Subsection (2) does not limit the generality of subsection 51(2) or\n52(1A).\nNote:\nSubsections 51(2) and 52(1A) are additional limitations on the\ndelegation of powers in relation to instruments.",
      "skos:definition": "(3) Subsection (2) does not limit the generality of subsection 51(2) or\n52(1A).\nNote:\nSubsections 51(2) and 52(1A) are additional limitations on the\ndelegation of powers in relation to instruments.",
      "values:partOf": {
        "@id": "concept:australian-communications-and-media-authority-act-2005-sec-53"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-53-ss-3-norm"
        }
      ],
      "cml:integrityHash": "ebe5946b66b3b32209df587f4ecfb47cb7724a43b62f12305b412b504df9014f",
      "skos:note": "Limitation on powers delegable to persons other than Divisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-53-ss-3",
      "@type": "cof:Section",
      "cof:title": "53(3) Limit on powers delegable to persons other than Divisions",
      "values:kind": "subsection",
      "cof:pageNumber": 44,
      "values:originalText": "(3) Subsection (2) does not limit the generality of subsection 51(2) or\n52(1A).\nNote:\nSubsections 51(2) and 52(1A) are additional limitations on the\ndelegation of powers in relation to instruments."
    },
