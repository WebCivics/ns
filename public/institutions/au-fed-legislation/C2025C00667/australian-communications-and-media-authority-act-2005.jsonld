    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 ACMA’s powers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.20",
      "values:originalText": "The ACMA has power to do all things necessary or convenient to\nbe done for or in connection with the performance of its functions.\nNote:\nThe Chair may enter into contracts and other arrangements on behalf\nof the Commonwealth. See section 23 of the Public Governance,\nPerformance and Accountability Act 2013.\n\n\nACMA’s establishment, functions, powers and liabilities  Part 2\nRequirements relating to these functions and powers  Division 4\nSection 14\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "skos:definition": "The ACMA has power to do all things necessary or convenient to\nbe done for or in connection with the performance of its functions.\nNote:\nThe Chair may enter into contracts and other arrangements on behalf\nof the Commonwealth. See section 23 of the Public Governance,\nPerformance and Accountability Act 2013.\n\n\nACMA’s establishment, functions, powers and liabilities  Part 2\nRequirements relating to these functions and powers  Division 4\nSection 14\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-12-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4252726c44b31f0fea15b75bca1038df6f05e92937fd2eea83487b2f39450f84",
      "skos:note": "Power to perform functions and tasks necessary or convenient for its performance"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-12",
      "@type": "cof:Section",
      "cof:title": "12 ACMA’s powers",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "The ACMA has power to do all things necessary or convenient to\nbe done for or in connection with the performance of its functions.\nNote:\nThe Chair may enter into contracts and other arrangements on behalf\nof the Commonwealth. See section 23 of the Public Governance,\nPerformance and Accountability Act 2013.\n\n\nACMA’s establishment, functions, powers and liabilities  Part 2\nRequirements relating to these functions and powers  Division 4\nSection 14\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025"
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-12-norm",
      "@type": "values:Obligation",
