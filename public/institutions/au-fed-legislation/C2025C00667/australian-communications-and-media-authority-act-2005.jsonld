      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Appointment to advisory committee is a public office.",
      "cml:conclusionText": "Appointment to advisory committee is not an appointment to advisory committee."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-5-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "iff",
      "cml:logicSummary": "Appointment to advisory committee -> Not a public office iff Appointment to advisory committee is not an appointment to advisory committee.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Appointment to advisory committee is an appointment.",
      "cml:conclusionText": "Appointment to advisory committee is not a public office."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-58-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is-a",
      "cml:logicSummary": "Class hierarchy: Appointment -> AdvisoryCommittee -> PublicOffice",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Appointment to advisory committee is an appointment.",
      "cml:conclusionText": "Appointment to advisory committee is not a public office."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59",
      "@type": "cml:Concept",
      "skos:prefLabel": "59 Consumer Consultative Forum",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.50",
      "values:originalText": "(1) The Consumer Consultative Forum established under the\nAustralian Communications Authority Act 1997 continues in\nexistence after the commencement of section 6 of this Act as if it\nwere established by the ACMA, by writing, at that commencement.\n(2) The Forum’s function is to assist the ACMA to perform the\nACMA’s functions in relation to matters affecting consumers.\n(3) The persons on the Forum are those the ACMA from time to time\nappoints to the Forum. The persons on the Forum immediately\nbefore the commencement of section 6 of this Act are taken to be\nappointed under this section at that commencement.\n\n\nAdvisory committees and the Consumer Consultative Forum  Part 7\n\nSection 59\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025\n(4) The ACMA may revoke a person’s appointment to the Forum.\n(5) The ACMA may give the Forum written directions as to:\n(a) the way in which the Forum is to carry out its function; and\n(b) procedures to be followed in relation to meetings.\n(6) An appointment to the Forum is not a public office within the\nmeaning of the Remuneration Tribunal Act 1973.",
      "skos:definition": "(1) The Consumer Consultative Forum established under the\nAustralian Communications Authority Act 1997 continues in\nexistence after the commencement of section 6 of this Act as if it\nwere established by the ACMA, by writing, at that commencement.\n(2) The Forum’s function is to assist the ACMA to perform the\nACMA’s functions in relation to matters affecting consumers.\n(3) The persons on the Forum are those the ACMA from time to time\nappoints to the Forum. The persons on the Forum immediately\nbefore the commencement of section 6 of this Act are taken to be\nappointed under this section at that commencement.\n\n\nAdvisory committees and the Consumer Consultative Forum  Part 7\n\nSection 59\nAustralian Communications and Media Authority Act 2005\nCompilation date: 05/12/2025\n(4) The ACMA may revoke a person’s appointment to the Forum.\n(5) The ACMA may give the Forum written directions as to:\n(a) the way in which the Forum is to carry out its function; and\n(b) procedures to be followed in relation to meetings.\n(6) An appointment to the Forum is not a public office within the\nmeaning of the Remuneration Tribunal Act 1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59-ss-1"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59-ss-2"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59-ss-3"
        },
