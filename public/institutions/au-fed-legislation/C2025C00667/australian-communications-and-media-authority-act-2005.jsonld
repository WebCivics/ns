    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59db",
      "@type": "cml:Concept",
      "skos:prefLabel": "59DB Disclosure of information that relates to the Scams Prevention",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59db"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-communications-and-media-authority-act-2005.pdf"
      },
      "dc:source": "australian-communications-and-media-authority-act-2005.pdf, p.58",
      "values:originalText": "Framework\nAn ACMA official authorised by the Chair, in writing, for the\npurposes of this section may disclose authorised disclosure\ninformation if the disclosure:\n(a) is to:\n(i) an SPF regulator (within the meaning of the\nCompetition and Consumer Act 2010); or\n(ii) the operator of an SPF EDR scheme (within the\nmeaning of that Act); and\n(b) is for the purposes of the operation (including enforcement)\nof the SPF provisions (within the meaning of that Act).",
      "skos:definition": "Framework\nAn ACMA official authorised by the Chair, in writing, for the\npurposes of this section may disclose authorised disclosure\ninformation if the disclosure:\n(a) is to:\n(i) an SPF regulator (within the meaning of the\nCompetition and Consumer Act 2010); or\n(ii) the operator of an SPF EDR scheme (within the\nmeaning of that Act); and\n(b) is for the purposes of the operation (including enforcement)\nof the SPF provisions (within the meaning of that Act).",
      "cml:asserts": [
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59db-norm"
        },
        {
          "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59db-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "713e7ddbe5acf7256d7f20b7d6c7ba5aeaf109759f326ea54e16c64c1b186d55",
      "skos:note": "Disclosure of information for SPF regulators and EDR scheme operators"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-communications-and-media-authority-act-2005#sec-59db",
      "@type": "cof:Section",
      "cof:title": "59DB Disclosure of information that relates to the Scams Prevention",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "Framework\nAn ACMA official authorised by the Chair, in writing, for the\npurposes of this section may disclose authorised disclosure\ninformation if the disclosure:\n(a) is to:\n(i) an SPF regulator (within the meaning of the\nCompetition and Consumer Act 2010); or\n(ii) the operator of an SPF EDR scheme (within the\nmeaning of that Act); and\n(b) is for the purposes of the operation (including enforcement)\nof the SPF provisions (within the meaning of that Act)."
    },
    {
      "@id": "concept:australian-communications-and-media-authority-act-2005-sec-59db-norm",
      "@type": "values:Permission",
      "cml:modality": {
