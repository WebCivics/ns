concept:competition-and-consumer-amendment-responding-to-exceptional-circumstances-act-2026-sch-1-sec-92b-ss-5 a cml:Concept ;
    skos:prefLabel "92B(5) Commission may grant authorisations in exceptional"@en ;
    cml:realizedBy doc:sch-1-sec-92b-ss-5 ;
