concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-311 a cml:Concept ;
    skos:prefLabel "311 Application—unfair trading practices"@en ;
    cml:realizedBy doc:sch-1-sec-311 ;
    values:originalText "Section 28B, inserted by the Competition and Consumer Amendment (Unfair Trading Practices) Act 2026, applies in relation to conduct that occurs on or after commencement of Part 1 of Schedule 1 to that Act, whether in connection with a supply or an offer to supply made before, on or after that commencement." ;
    skos:definition "Section 28B, inserted by the Competition and Consumer Amendment (Unfair Trading Practices) Act 2026, applies in relation to conduct that occurs on or after commencement of Part 1 of Schedule 1 to that Act, whether in connection with a supply or an offer to supply made before, on or after that commencement."@en ;
    cml:integrityHash "f7c2de1819f6a5ae8ff3386e4ee18d4f1d3ed43fed64582c2d65cda980d9b891" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Section applies in relation to conduct occurring on or after commencement of Part 1 of Schedule 1." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf> ;
