concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-2 a cml:Concept ;
    skos:prefLabel "2 After subsection 6(3A)"@en ;
    cml:realizedBy doc:sch-1-sec-2 ;
    values:originalText "Insert:  (3B) In addition to the effect that this Act, other than Parts IIIA, VIIA and X, has as provided by another subsection of this section, the provisions of Part 2-4 of the Australian Consumer Law have, by force of this subsection, the effect they would have if:  (a) those provisions were, by express provision, confined in their operation to the supply of, or an offer to supply, postal, telegraphic, telephonic or other like services; and  (b) a reference in the provisions of Part XI to a corporation included a reference to a person not being a corporation." ;
    skos:definition "Insert:  (3B) In addition to the effect that this Act, other than Parts IIIA, VIIA and X, has as provided by another subsection of this section, the provisions of Part 2-4 of the Australian Consumer Law have, by force of this subsection, the effect they would have if:  (a) those provisions were, by express provision, confined in their operation to the supply of, or an offer to supply, postal, telegraphic, telephonic or other like services; and  (b) a reference in the provisions of Part XI to a corporation included a reference to a person not being a corporation."@en ;
    cml:integrityHash "6a5160947b6880d8e86fe8261c51acfec9db9c827504aacd70fcd6561e3b8892" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Provisions of Part 2-4 of the Australian Consumer Law have an expanded effect." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf> ;
