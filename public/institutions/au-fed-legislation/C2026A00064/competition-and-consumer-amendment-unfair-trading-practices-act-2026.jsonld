    {
      "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 After subsection 6(3A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-unfair-trading-practices-act-2026#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf, p.7",
      "values:originalText": "Insert:\n\n(3B) In addition to the effect that this Act, other than Parts IIIA, VIIA\nand X, has as provided by another subsection of this section, the\nprovisions of Part 2-4 of the Australian Consumer Law have, by\nforce of this subsection, the effect they would have if:\n\n(a) those provisions were, by express provision, confined in their\noperation to the supply of, or an offer to supply, postal,\ntelegraphic, telephonic or other like services; and\n\n(b) a reference in the provisions of Part XI to a corporation\nincluded a reference to a person not being a corporation.",
      "skos:definition": "Insert:\n\n(3B) In addition to the effect that this Act, other than Parts IIIA, VIIA\nand X, has as provided by another subsection of this section, the\nprovisions of Part 2-4 of the Australian Consumer Law have, by\nforce of this subsection, the effect they would have if:\n\n(a) those provisions were, by express provision, confined in their\noperation to the supply of, or an offer to supply, postal,\ntelegraphic, telephonic or other like services; and\n\n(b) a reference in the provisions of Part XI to a corporation\nincluded a reference to a person not being a corporation.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6a5160947b6880d8e86fe8261c51acfec9db9c827504aacd70fcd6561e3b8892",
      "skos:note": "Provisions of Part 2-4 of the Australian Consumer Law have an expanded effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-unfair-trading-practices-act-2026#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 After subsection 6(3A)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\n(3B) In addition to the effect that this Act, other than Parts IIIA, VIIA\nand X, has as provided by another subsection of this section, the\nprovisions of Part 2-4 of the Australian Consumer Law have, by\nforce of this subsection, the effect they would have if:\n\n(a) those provisions were, by express provision, confined in their\noperation to the supply of, or an offer to supply, postal,\ntelegraphic, telephonic or other like services; and\n\n(b) a reference in the provisions of Part XI to a corporation\nincluded a reference to a person not being a corporation."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-2-norm",
