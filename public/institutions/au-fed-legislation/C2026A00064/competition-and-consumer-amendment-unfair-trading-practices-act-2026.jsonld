    {
      "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-311",
      "@type": "cml:Concept",
      "skos:prefLabel": "311 Application—unfair trading practices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-unfair-trading-practices-act-2026#sch-1-sec-311"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf, p.25",
      "values:originalText": "Section 28B, inserted by the Competition and Consumer Amendment\n(Unfair Trading Practices) Act 2026, applies in relation to conduct that\noccurs on or after commencement of Part 1 of Schedule 1 to that Act,\nwhether in connection with a supply or an offer to supply made before,\non or after that commencement.",
      "skos:definition": "Section 28B, inserted by the Competition and Consumer Amendment\n(Unfair Trading Practices) Act 2026, applies in relation to conduct that\noccurs on or after commencement of Part 1 of Schedule 1 to that Act,\nwhether in connection with a supply or an offer to supply made before,\non or after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-311-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-311-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f7c2de1819f6a5ae8ff3386e4ee18d4f1d3ed43fed64582c2d65cda980d9b891",
      "skos:note": "Section applies in relation to conduct occurring on or after commencement of Part 1 of Schedule 1."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-unfair-trading-practices-act-2026#sch-1-sec-311",
      "@type": "cof:Section",
      "cof:title": "311 Application—unfair trading practices",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Section 28B, inserted by the Competition and Consumer Amendment\n(Unfair Trading Practices) Act 2026, applies in relation to conduct that\noccurs on or after commencement of Part 1 of Schedule 1 to that Act,\nwhether in connection with a supply or an offer to supply made before,\non or after that commencement."
    },
    {
