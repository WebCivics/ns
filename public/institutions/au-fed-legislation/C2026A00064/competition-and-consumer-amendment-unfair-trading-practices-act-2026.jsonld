      "dc:source": "competition-and-consumer-amendment-unfair-trading-practices-act-2026.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nUnfair trading practices  Part 1\n\nNo. 64, 2026\nCompetition and Consumer Amendment (Unfair Trading Practices) Act",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nUnfair trading practices  Part 1\n\nNo. 64, 2026\nCompetition and Consumer Amendment (Unfair Trading Practices) Act",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sec-3-norm"
        }
      ],
      "cml:integrityHash": "db5dabe6197a88f3db7a757f76d3d8ea026abe50995dfa7266d8e8e7dfb34ec0",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-unfair-trading-practices-act-2026#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nUnfair trading practices  Part 1\n\nNo. 64, 2026\nCompetition and Consumer Amendment (Unfair Trading Practices) Act"
    },
