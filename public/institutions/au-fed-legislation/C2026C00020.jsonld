      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty for a contravention of this subsection: 6 months imprisonment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Conduct that breaches the oath or affirmation requirement is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "The person's conduct breaches that requirement."
    },
