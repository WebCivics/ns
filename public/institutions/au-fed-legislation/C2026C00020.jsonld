        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Parliament does not intend to limit or prevent the exercise of its power."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-3a-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This permits the exercise of the Parliament's power.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
