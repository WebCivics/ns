    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-45-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Disclosure must occur within a specific temporal interval",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
