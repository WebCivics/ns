      "@type": "cml:LogicApplication",
      "cml:conclusionText": "access in that form may be refused and access given in another form.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits access if it would interfere with agency operations or infringe copyright.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) would interfere unreasonably with the operations of the agency, or the performance by the Minister of his or her functions, as the case may be;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
