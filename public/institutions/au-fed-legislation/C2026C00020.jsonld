      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for disclosure",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "contains",
      "cml:premiseText": "(1) A document is an exempt document if its disclosure under this Act would found an action, by a person (other than an agency or the Commonwealth), for breach of confidence."
