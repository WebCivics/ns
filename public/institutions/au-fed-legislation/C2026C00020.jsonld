      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between the requirement and the breach.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(3) A person commits an offence if: (a) the person is required under this section to be examined on oath or affirmation; (b) the person engages in conduct; (c) the person’s conduct breaches that requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if the person engages in conduct that breaches that requirement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
