      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of documents that could have a substantial adverse effect on the economy.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A document is conditionally exempt if its disclosure under this Act would, or could be reasonably expected to, have a substantial adverse effect on Australia’s economy."
    },
