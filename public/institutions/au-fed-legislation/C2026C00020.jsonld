    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1",
      "@type": "cml:Concept",
      "dc:source": "freedom-of-information-act-1982.pdf, p.107",
      "skos:note": "Conditional exemptions for documents that could have a substantial adverse effect on the economy.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "47J(1) Public interest conditional exemptions—the economy"
      },
      "wasDerivedFrom": "freedom-of-information-act-1982.pdf",
      "asserts": [
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-norm",
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-deontic-1",
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-descriptionlogic-2",
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-alleninterval-3",
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-ltl-4",
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-diffusion-5",
        "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-argumentation-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "f3b75f6259a10fa14a7f6058318a3be5a3da6e0f5ea42a22dab3776e29b4e6d9",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:freedom-of-information-act-1982#sch-4-sec-47j-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:freedom-of-information-act-1982-sch-4-sec-47j"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines temporal intervals for conditional exemptions.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(1) A document is conditionally exempt if its disclosure under this Act would, or could be reasonably expected to, have a substantial adverse effect on Australia’s economy by: (a) influencing a decision or action of a person or entity; or (b) giving a person (or class of persons) an undue benefit or detriment, in relation to business carried on by the person (or class), by providing premature knowledge of proposed or possible action or inaction of a person or entity."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-argumentation-6",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
