<https://ns.webcivics.net/concept/freedom-of-information-act-1982-sch-4-sec-47j-ss-1-logic-descriptionlogic-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/DescriptionLogic>;
    <https://ns.webcivics.net/cml/operator> "Classify";
