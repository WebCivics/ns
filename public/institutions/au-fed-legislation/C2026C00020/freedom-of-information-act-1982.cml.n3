doc:sch-4-sec-24a-ss-1 a cof:Section ;
    cof:title "24A(1) Requests may be refused if documents cannot be found, do not" ;
    values:kind "subsection" ;
    values:originalText "(1) An agency or Minister may refuse a request for access to a document if: (a) all reasonable steps have been taken to find the document; and (b) the agency or Minister is satisfied that the document: (i) is in the agency’s or Minister’s possession but cannot be found; or (ii) does not exist. Document not received as required by contract" ;
    cof:pageNumber "74"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-24a-ss-2 a cml:Concept ;
    skos:prefLabel "24A(2) Requests may be refused if documents cannot be found, do not"@en ;
