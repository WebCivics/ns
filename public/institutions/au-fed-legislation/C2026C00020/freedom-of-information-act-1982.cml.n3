concept:freedom-of-information-act-1982-sch-4-sec-15ac a cml:Concept ;
    skos:prefLabel "15AC Decision not made on request within time—deemed refusal"@en ;
    cml:realizedBy doc:sch-4-sec-15ac ;
    values:originalText "Scope (1) This section applies if: (a) a request has been made to an agency or Minister; and (b) the period (the initial decision period) covered by subsection (2) has ended since the day the request was received by, or on behalf of, the agency or Minister; and (c) notice of a decision on the request has not been received by the applicant." ;
    skos:definition "Scope (1) This section applies if: (a) a request has been made to an agency or Minister; and (b) the period (the initial decision period) covered by subsection (2) has ended since the day the request was received by, or on behalf of, the agency or Minister; and (c) notice of a decision on the request has not been received by the applicant."@en ;
    cml:integrityHash "51da50406d0fc8f9b584f3642244e10dd4c64626cd59260c19d17f2ad867a442" ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "Agency must make decision on request within time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
