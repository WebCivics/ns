concept:freedom-of-information-act-1982-sch-4-sec-54r a cml:Concept ;
    skos:prefLabel "54R IC review applications—withdrawal"@en ;
    cml:realizedBy doc:sch-4-sec-54r ;
    values:originalText "(1) An IC review applicant may, in writing, withdraw the IC review application at any time before the Information Commissioner makes a decision under section 55K. (2) If the IC review application is withdrawn, it is taken never to have been made. Subdivision B—Time limits" ;
    skos:definition "(1) An IC review applicant may, in writing, withdraw the IC review application at any time before the Information Commissioner makes a decision under section 55K. (2) If the IC review application is withdrawn, it is taken never to have been made. Subdivision B—Time limits"@en ;
    cml:integrityHash "a36a7f2d80b39e299650a3a4d2c3dbca80fda4a26198774a130f6aaf1a53f838" ;
    cof:pageNumber "133"^^xsd:integer ;
    cml:hasPart concept:freedom-of-information-act-1982-sch-4-sec-54r-ss-1 ;
    cml:hasPart concept:freedom-of-information-act-1982-sch-4-sec-54r-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.133" .
doc:sch-4-sec-54r a cof:Section ;
    cof:title "54R IC review applications—withdrawal" ;
    values:kind "section" ;
    values:originalText "(1) An IC review applicant may, in writing, withdraw the IC review application at any time before the Information Commissioner makes a decision under section 55K. (2) If the IC review application is withdrawn, it is taken never to have been made. Subdivision B—Time limits" ;
    cof:pageNumber "133"^^xsd:integer .

