doc:sch-4-sec-83-ss-1 a cof:Section ;
    cof:title "83(1) Information Commissioner investigations—administration of" ;
    values:kind "subsection" ;
    values:originalText "(1) If, by a notice under subsection 82(1), the Information Commissioner requires a person to appear before him or her, the Information Commissioner may: (a) administer an oath or affirmation to the person; and (b) examine the person on oath or affirmation." ;
    cof:pageNumber "199"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-83-ss-2 a cml:Concept ;
    skos:prefLabel "83(2) Information Commissioner investigations—administration of"@en ;
    cml:realizedBy doc:sch-4-sec-83-ss-2 ;
    values:originalText "(2) The oath or affirmation to be taken or made by a person for the purposes of this section is an oath or affirmation that the answers the person will give will be true." ;
    skos:definition "(2) The oath or affirmation to be taken or made by a person for the purposes of this section is an oath or affirmation that the answers the person will give will be true."@en ;
