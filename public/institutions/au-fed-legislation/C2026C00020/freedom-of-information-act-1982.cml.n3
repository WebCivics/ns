concept:freedom-of-information-act-1982-sch-4-sec-11c-ss-5 a cml:Concept ;
    skos:prefLabel "11C(5) Publication of information in accessed documents"@en ;
    cml:realizedBy doc:sch-4-sec-11c-ss-5 ;
    values:originalText "(5) If there is a charge for accessing the information, the agency or Minister must publish details of the charge in the same way as the information is published under this section. Time limit for publication" ;
    skos:definition "(5) If there is a charge for accessing the information, the agency or Minister must publish details of the charge in the same way as the information is published under this section. Time limit for publication"@en ;
