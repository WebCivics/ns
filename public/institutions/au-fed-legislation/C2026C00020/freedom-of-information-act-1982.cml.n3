    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-24ab ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Provide reasonable opportunity to consult with contact person and assist applicant in revising request." ;
    dc:description "Yes" ;
