    cml:hasPart concept:freedom-of-information-act-1982-sch-4-sec-45a-ss-6 ;
    cml:hasPart concept:freedom-of-information-act-1982-sch-4-sec-45a-ss-7 ;
    cml:hasPart concept:freedom-of-information-act-1982-sch-4-sec-45a-ss-8 ;
