doc:sch-4-sec-45a-ss-5 a cof:Section ;
    cof:title "45A(5) Parliamentary Budget Office documents" ;
    values:kind "subsection" ;
    values:originalText "(5) Information in a document to which subsection (1), (2) or (3) applies is not exempt matter because of this section if the information has been made publicly available by the Parliamentary Budget Officer: (a) under section 64U of the Parliamentary Service Act 1999; or (b) in a statement made under subsection 64V(4) of that Act." ;
    cof:pageNumber "96"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-45a-ss-6 a cml:Concept ;
    skos:prefLabel "45A(6) Parliamentary Budget Office documents"@en ;
    cml:realizedBy doc:sch-4-sec-45a-ss-6 ;
    values:originalText "(6) Information in a document to which subsection (1), (2) or (3) applies is not exempt matter because of this section if the information has been made publicly available by the Senator or Member of the House of Representatives who made the confidential request to which the document relates." ;
    skos:definition "(6) Information in a document to which subsection (1), (2) or (3) applies is not exempt matter because of this section if the information has been made publicly available by the Senator or Member of the House of Representatives who made the confidential request to which the document relates."@en ;
    cml:integrityHash "8d6bb01eb8d74a3f10b0495b51933b6ebd721caade3a53d1a71fe297ab786605" ;
    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-45a ;
    cof:pageNumber "96"^^xsd:integer ;
    skos:note "Information made publicly available by Senator or MP is exempt from confidentiality request" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
