concept:freedom-of-information-act-1982-sch-4-sec-11c-ss-6 a cml:Concept ;
    skos:prefLabel "11C(6) Publication of information in accessed documents"@en ;
    cml:realizedBy doc:sch-4-sec-11c-ss-6 ;
    values:originalText "(6) The agency or Minister must comply with this section within 10 working days after the day the person is given access to the document." ;
