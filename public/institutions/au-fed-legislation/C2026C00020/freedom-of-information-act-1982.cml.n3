    cml:hasPart concept:freedom-of-information-act-1982-sch-4-sec-77-ss-6 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
