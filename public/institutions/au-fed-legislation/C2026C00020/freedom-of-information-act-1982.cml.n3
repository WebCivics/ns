doc:sch-4-sec-89a-ss-1 a cof:Section ;
    cof:title "89A(1) Information Commissioner investigations—failure to take" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if: (a) the Information Commissioner gives an implementation notice to a respondent agency; and (b) the Information Commissioner is satisfied that: (i) the agency has not responded to the implementation notice within the time specified in the notice; or (ii) the agency has not taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation. Report to responsible Minister" ;
    cof:pageNumber "203"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-2 a cml:Concept ;
    skos:prefLabel "89A(2) Information Commissioner investigations—failure to take"@en ;
    cml:realizedBy doc:sch-4-sec-89a-ss-2 ;
    values:originalText "(2) The Information Commissioner may give a written report to the responsible Minister that contains the matters set out in section 89B. Note: For responsible Minister, see subsection 4(1). Report to Minister" ;
    skos:definition "(2) The Information Commissioner may give a written report to the responsible Minister that contains the matters set out in section 89B. Note: For responsible Minister, see subsection 4(1). Report to Minister"@en ;
