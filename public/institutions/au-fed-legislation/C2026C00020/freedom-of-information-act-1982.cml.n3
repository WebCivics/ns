doc:sch-4-sec-55e-ss-2 a cof:Section ;
    cof:title "55E(2) Procedure in IC review—inadequate reasons from decision" ;
    values:kind "subsection" ;
    values:originalText "(2) The Information Commissioner may, by notice in writing, require the agency or Minister to provide an adequate statement of reasons as mentioned in subsection 26(1)." ;
    cof:pageNumber "143"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-55e-ss-3 a cml:Concept ;
    skos:prefLabel "55E(3) Procedure in IC review—inadequate reasons from decision"@en ;
    cml:realizedBy doc:sch-4-sec-55e-ss-3 ;
    values:originalText "(3) If the Information Commissioner gives notice under subsection (2), the agency or Minister must provide the adequate statement of reasons to the IC review applicant and the Information Commissioner within: (a) the period specified in the notice; or (b) if no period is specified in the notice—28 days after the day the notice was given to the agency or Minister." ;
    skos:definition "(3) If the Information Commissioner gives notice under subsection (2), the agency or Minister must provide the adequate statement of reasons to the IC review applicant and the Information Commissioner within: (a) the period specified in the notice; or (b) if no period is specified in the notice—28 days after the day the notice was given to the agency or Minister."@en ;
    cml:integrityHash "8df3830b00ba5dfc32bd1ae9aef606dd433744b6c9a0a814b2b928a2cc961c03" ;
    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-55e ;
    cof:pageNumber "143"^^xsd:integer ;
    skos:note "Provide adequate statement of reasons within specified period or 28 days." ;
    dc:description "true" ;
