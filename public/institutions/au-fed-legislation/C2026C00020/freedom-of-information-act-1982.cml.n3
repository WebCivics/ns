concept:freedom-of-information-act-1982-sch-4-sec-72 a cml:Concept ;
    skos:prefLabel "72 Information Commissioner investigations—preliminary inquiries"@en ;
    cml:realizedBy doc:sch-4-sec-72 ;
    values:originalText "The Information Commissioner may make inquiries of the respondent agency for the purpose of determining whether or not to investigate a complaint made (or purported to be made) under section 70." ;
    skos:definition "The Information Commissioner may make inquiries of the respondent agency for the purpose of determining whether or not to investigate a complaint made (or purported to be made) under section 70."@en ;
