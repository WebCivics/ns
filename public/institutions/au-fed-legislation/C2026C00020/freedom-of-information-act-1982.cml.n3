concept:freedom-of-information-act-1982-sch-4-sec-10a a cml:Concept ;
    skos:prefLabel "10A Who performs functions etc. given to agencies"@en ;
    cml:realizedBy doc:sch-4-sec-10a ;
    values:originalText "(1) A function or power given to an agency under this Part may be performed or exercised, on behalf of the agency, by: (a) the principal officer of the agency; or" ;
