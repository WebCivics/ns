concept:freedom-of-information-act-1982-sch-4-sec-51da a cml:Concept ;
    skos:prefLabel "51DA Decision not made on request for amendment or annotation"@en ;
    cml:realizedBy doc:sch-4-sec-51da ;
    values:originalText "within time—deemed refusal (1) This section applies if: (a) an application has been made to an agency or Minister under section 48; and (b) the period of 30 days mentioned in section 51D (the initial decision period) has ended since the day the application was received by, or on behalf of, the agency or Minister; and (c) notice of a decision on the application has not been received by the applicant." ;
    skos:definition "within time—deemed refusal (1) This section applies if: (a) an application has been made to an agency or Minister under section 48; and (b) the period of 30 days mentioned in section 51D (the initial decision period) has ended since the day the application was received by, or on behalf of, the agency or Minister; and (c) notice of a decision on the application has not been received by the applicant."@en ;
    cml:integrityHash "8502e66f40949b4b010bb2cd9f2ce3464858a7bdcdd79382ed66e57d6eff5894" ;
    cof:pageNumber "115"^^xsd:integer ;
    skos:note "Agency must make decision on application within 30 days." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.115" ;
