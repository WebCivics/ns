    cof:pageNumber "107"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-48 a cml:Concept ;
    skos:prefLabel "48 Application for amendment or annotation of personal records"@en ;
    cml:realizedBy doc:sch-4-sec-48 ;
    values:originalText "Where a person claims that a document of an agency or an official document of a Minister to which access has been lawfully provided to the person, whether under this Act or otherwise, contains personal information about that person: (a) that is incomplete, incorrect, out of date or misleading; and (b) that has been used, is being used or is available for use by the agency or Minister for an administrative purpose; the person may apply to the agency or Minister for: (c) an amendment; or (d) an annotation; of the record of that information kept by the agency or Minister." ;
    skos:definition "Where a person claims that a document of an agency or an official document of a Minister to which access has been lawfully provided to the person, whether under this Act or otherwise, contains personal information about that person: (a) that is incomplete, incorrect, out of date or misleading; and (b) that has been used, is being used or is available for use by the agency or Minister for an administrative purpose; the person may apply to the agency or Minister for: (c) an amendment; or (d) an annotation; of the record of that information kept by the agency or Minister."@en ;
    cml:integrityHash "f815d500c5924ae0f6230378fd5b72a3cf06c9fb9c03c2e3c992dc76033bc237" ;
    cof:pageNumber "109"^^xsd:integer ;
    skos:note "Request for amendment or annotation of personal records" ;
    cml:curationStatus cml:Proposed ;
