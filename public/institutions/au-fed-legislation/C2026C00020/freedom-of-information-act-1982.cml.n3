concept:freedom-of-information-act-1982-sch-4-sec-55da a cml:Concept ;
    skos:prefLabel "55DA Decision-maker must assist Information Commissioner"@en ;
    cml:realizedBy doc:sch-4-sec-55da ;
    values:originalText "In an IC review, the agency or Minister who made the IC reviewable decision must use the agency’s or the Minister’s best endeavours to assist the Information Commissioner to make his or her decision in relation to the IC review.   Review by Information Commissioner  Part VII Procedure in IC review  Division 6 Section 55E Freedom of Information Act 1982 Compilation date: 01/01/2026" ;
    skos:definition "In an IC review, the agency or Minister who made the IC reviewable decision must use the agency’s or the Minister’s best endeavours to assist the Information Commissioner to make his or her decision in relation to the IC review.   Review by Information Commissioner  Part VII Procedure in IC review  Division 6 Section 55E Freedom of Information Act 1982 Compilation date: 01/01/2026"@en ;
    cml:integrityHash "037270f431efb46dad920bba96cf93470e05f48c2950cd2e8a7fe9a05ddfbfe4" ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Agency or Minister must assist Information Commissioner in IC review." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.142" ;
    cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-55da-norm .
