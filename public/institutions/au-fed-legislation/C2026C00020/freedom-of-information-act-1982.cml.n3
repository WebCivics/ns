concept:freedom-of-information-act-1982-sch-4-sec-12 a cml:Concept ;
    skos:prefLabel "12 Part not to apply to certain documents"@en ;
    cml:realizedBy doc:sch-4-sec-12 ;
    values:originalText "(1) A person is not entitled to obtain access under this Part to: (a) a document, or a copy of a document, which is, under the Archives Act 1983, within the open access period within the meaning of that Act unless the document contains personal information (including personal information about a deceased person); or" ;
    skos:definition "(1) A person is not entitled to obtain access under this Part to: (a) a document, or a copy of a document, which is, under the Archives Act 1983, within the open access period within the meaning of that Act unless the document contains personal information (including personal information about a deceased person); or"@en ;
    cml:integrityHash "c61de27034c6c73ceb902eeea3b7eeafa6b7e04084f837571d6425dd61acf44c" ;
    cof:pageNumber "55"^^xsd:integer ;
    skos:note "Exemptions from access under Part 1" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
