    cml:premiseText "The respondent agency ought to implement the investigation recommendations." ;
    cml:conclusionText "The Information Commissioner believes that the respondent agency ought to implement the investigation recommendations." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

