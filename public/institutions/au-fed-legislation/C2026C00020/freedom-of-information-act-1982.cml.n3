    cof:pageNumber "190"^^xsd:integer ;
    skos:note "Interpretation of Subdivision application to part of a complaint" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
