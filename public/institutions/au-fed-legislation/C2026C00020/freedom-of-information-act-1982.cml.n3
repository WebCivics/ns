concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-4 a cml:Concept ;
    skos:prefLabel "89A(4) Information Commissioner investigations—failure to take"@en ;
    cml:realizedBy doc:sch-4-sec-89a-ss-4 ;
    values:originalText "(4) However, if the copy of the report would contain matters of the kind mentioned in subsection 89C(2), the Information Commissioner must prepare a copy of the report to give to the FOI Minister that excludes those matters." ;
    skos:definition "(4) However, if the copy of the report would contain matters of the kind mentioned in subsection 89C(2), the Information Commissioner must prepare a copy of the report to give to the FOI Minister that excludes those matters."@en ;
