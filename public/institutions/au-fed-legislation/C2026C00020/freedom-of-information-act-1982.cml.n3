    cof:pageNumber "190"^^xsd:integer ;
    skos:note "The Information Commissioner may make inquiries of the respondent agency." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
