concept:freedom-of-information-act-1982-sch-4-sec-16-ss-3a a cml:Concept ;
    skos:prefLabel "16(3A) Transfer of requests"@en ;
    cml:realizedBy doc:sch-4-sec-16-ss-3a ;
    values:originalText "(3A) Where: (a) a request is made to an agency for access to more than one document; and (b) one or more of those documents is a document to which subsection (1), (2) or (3) applies; this section applies to each of those documents as if separate requests for access had been made to the agency in respect of each of those documents." ;
    skos:definition "(3A) Where: (a) a request is made to an agency for access to more than one document; and (b) one or more of those documents is a document to which subsection (1), (2) or (3) applies; this section applies to each of those documents as if separate requests for access had been made to the agency in respect of each of those documents."@en ;
    cml:integrityHash "0cde0727756d4ab04e9e116c3bcec7f8a7b2e76ecac4b83f25e90f5c1d891d69" ;
    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-16 ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "Agency must provide access to documents subject to subsections (1), (2) or (3)" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
