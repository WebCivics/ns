concept:freedom-of-information-act-1982-sch-4-sec-89p a cml:Concept ;
    skos:prefLabel "89P Staff to hold appropriate security clearance"@en ;
    cml:realizedBy doc:sch-4-sec-89p ;
    values:originalText "The Information Commissioner must take all reasonable steps to ensure that a member of the staff of the Office of the Australian Information Commissioner who performs functions or exercises powers for the purposes of this Act is given a security clearance at an appropriate level. Note: Security clearances are given in accordance with the Australian Government Protective Security Manual." ;
    skos:definition "The Information Commissioner must take all reasonable steps to ensure that a member of the staff of the Office of the Australian Information Commissioner who performs functions or exercises powers for the purposes of this Act is given a security clearance at an appropriate level. Note: Security clearances are given in accordance with the Australian Government Protective Security Manual."@en ;
    cml:integrityHash "3c7030d2cc78bf49ed96b048e08590a1944fc849e5a2ab2c4af2f0a685881449" ;
    cof:pageNumber "212"^^xsd:integer ;
    skos:note "Staff must be given security clearance" ;
