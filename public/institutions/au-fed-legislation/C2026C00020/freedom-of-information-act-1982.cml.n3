    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-16 ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "Agency must inform person making request and send document to other agency if necessary." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
