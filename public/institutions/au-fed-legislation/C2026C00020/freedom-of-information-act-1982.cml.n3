concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-1 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-1-logic-ltl-3 .
concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Temporal constraint for response or action." ;
    cml:premiseText "(i) the agency has not responded to the implementation notice within the time specified in the notice; or (ii) the agency has not taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation." ;
    cml:conclusionText "The agency must respond or take action until the specified time expires." ;
    cml:executionSurface "modalities::temporal_ltl" ;
