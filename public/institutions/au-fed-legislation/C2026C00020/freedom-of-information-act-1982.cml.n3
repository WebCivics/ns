concept:freedom-of-information-act-1982-sch-4-sec-16a a cml:Concept ;
    skos:prefLabel "16A Requests transferred from the ACT"@en ;
    cml:realizedBy doc:sch-4-sec-16a ;
    values:originalText "Where a request under the Freedom of Information Act 1989 of the Australian Capital Territory is transferred to an agency in accordance with section 33 of that Act, it becomes a request under this Act at the time at which it is received by the agency." ;
    skos:definition "Where a request under the Freedom of Information Act 1989 of the Australian Capital Territory is transferred to an agency in accordance with section 33 of that Act, it becomes a request under this Act at the time at which it is received by the agency."@en ;
    cml:integrityHash "e21ac754b54e7d55847fcb506d666f704d1c25a60d8b3fa6db1ac7750ed7f56a" ;
    cof:pageNumber "65"^^xsd:integer ;
    skos:note "Request becomes a request under this Act upon receipt by agency." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.65" ;
    cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-16a-norm .
concept:freedom-of-information-act-1982-sch-4-sec-16a-norm a values:Obligation ;
