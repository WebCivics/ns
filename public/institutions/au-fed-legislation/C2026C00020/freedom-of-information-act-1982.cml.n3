concept:freedom-of-information-act-1982-sch-4-sec-54z a cml:Concept ;
    skos:prefLabel "54Z Procedure in IC review—general notice requirement"@en ;
    cml:realizedBy doc:sch-4-sec-54z ;
    values:originalText "Before undertaking an IC review, the Information Commissioner must inform: (a) the person, agency or Minister who made the decision; or (b) if the IC review application is made under section 54M (access grant decisions)—the person who made the request." ;
    skos:definition "Before undertaking an IC review, the Information Commissioner must inform: (a) the person, agency or Minister who made the decision; or (b) if the IC review application is made under section 54M (access grant decisions)—the person who made the request."@en ;
    cml:integrityHash "d6c4f6d7bf11ff690d11b78053affa7e908bbc72e2819004310f9e4e2e2cde40" ;
    cof:pageNumber "139"^^xsd:integer ;
    skos:note "Information Commissioner must inform person, agency or Minister who made the decision before undertaking IC review." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
