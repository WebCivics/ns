concept:freedom-of-information-act-1982-sch-4-sec-51a a cml:Concept ;
    skos:prefLabel "51A Requirements of an application for annotation"@en ;
    cml:realizedBy doc:sch-4-sec-51a ;
    values:originalText "An application for annotation must: (a) be in writing; and (b) as far as practicable, specify the document or official document containing the record of personal information that is claimed to require annotation; and (c) be accompanied by a statement by the applicant that specifies: (i) the information that is claimed to be incomplete, incorrect, out of date or misleading; and (ii) whether the information is claimed to be incomplete, incorrect, out of date or misleading; and" ;
    skos:definition "An application for annotation must: (a) be in writing; and (b) as far as practicable, specify the document or official document containing the record of personal information that is claimed to require annotation; and (c) be accompanied by a statement by the applicant that specifies: (i) the information that is claimed to be incomplete, incorrect, out of date or misleading; and (ii) whether the information is claimed to be incomplete, incorrect, out of date or misleading; and"@en ;
    cml:integrityHash "6a52c59a966053453ca02e41748ed804389cdcc45cd146c331965dee0a83c1b3" ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "Application for annotation must be in writing and specify document containing personal information." ;
    dc:description "Statement by applicant specifying incomplete, incorrect, out of date or misleading information." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
