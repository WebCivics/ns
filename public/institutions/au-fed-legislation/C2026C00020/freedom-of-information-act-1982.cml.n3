doc:sch-4-sec-6c-ss-1 a cof:Section ;
    cof:title "6C(1) Requirement for Commonwealth contracts" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies to an agency if a service is, or is to be, provided under a Commonwealth contract in connection with the performance of the functions or the exercise of the powers of the agency." ;
    cof:pageNumber "33"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-6c-ss-2 a cml:Concept ;
    skos:prefLabel "6C(2) Requirement for Commonwealth contracts"@en ;
    cml:realizedBy doc:sch-4-sec-6c-ss-2 ;
    values:originalText "(2) The agency must take contractual measures to ensure that the agency receives a document if: (a) the document is created by, or is in the possession of: (i) a contracted service provider for the Commonwealth contract; or (ii) a subcontractor for the Commonwealth contract; and (b) the document relates to the performance of the Commonwealth contract (and not to the entry into that contract); and (c) the agency receives a request for access to the document." ;
    skos:definition "(2) The agency must take contractual measures to ensure that the agency receives a document if: (a) the document is created by, or is in the possession of: (i) a contracted service provider for the Commonwealth contract; or (ii) a subcontractor for the Commonwealth contract; and (b) the document relates to the performance of the Commonwealth contract (and not to the entry into that contract); and (c) the agency receives a request for access to the document."@en ;
    cml:integrityHash "ce785eee39cc717ac3cb23a66c2da58955bccfbf49b18aba32c0c111da0edb77" ;
    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-6c ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Agency must take measures to ensure receipt of document from contracted service provider or subcontractor." ;
    cml:curationStatus cml:Proposed ;
