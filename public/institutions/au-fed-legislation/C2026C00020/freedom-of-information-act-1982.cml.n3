concept:freedom-of-information-act-1982-sch-4-sec-47h a cml:Concept ;
    skos:prefLabel "47H Public interest conditional exemptions—research"@en ;
    cml:realizedBy doc:sch-4-sec-47h ;
    values:originalText "A document is conditionally exempt if: (a) it contains information relating to research that is being, or is to be, undertaken by an officer of an agency specified in Schedule 4; and (b) disclosure of the information before the completion of the research would be likely unreasonably to expose the agency or officer to disadvantage.   Exempt documents  Part IV Public interest conditional exemptions  Division 3 Section 47J Freedom of Information Act 1982 Compilation date: 01/01/2026 Note: Access must generally be given to a conditionally exempt document unless it would be contrary to the public interest (see section 11A)." ;
    skos:definition "A document is conditionally exempt if: (a) it contains information relating to research that is being, or is to be, undertaken by an officer of an agency specified in Schedule 4; and (b) disclosure of the information before the completion of the research would be likely unreasonably to expose the agency or officer to disadvantage.   Exempt documents  Part IV Public interest conditional exemptions  Division 3 Section 47J Freedom of Information Act 1982 Compilation date: 01/01/2026 Note: Access must generally be given to a conditionally exempt document unless it would be contrary to the public interest (see section 11A)."@en ;
    cml:integrityHash "675dd7f11d6e3e23c6f1239f01f34840bf024bba36469882cecff402a531d56d" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Conditional exemptions for research documents" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.106" ;
    cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-47h-norm .
