concept:freedom-of-information-act-1982-sch-4-sec-89b a cml:Concept ;
    skos:prefLabel "89B Information Commissioner investigations—requirements for"@en ;
    cml:realizedBy doc:sch-4-sec-89b ;
    values:originalText "report A report under subsection 89A(2) must: (a) include a copy of the notice given to the respondent agency under subsection 86(2) (notice on completion) and the implementation notice; and (b) give details of the respondent agency’s response (if any) to the implementation notice; and (c) state that the Information Commissioner is not satisfied that the agency has taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation; and (d) state the action that the Information Commissioner believes, if taken by the agency, would be adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation." ;
    skos:definition "report A report under subsection 89A(2) must: (a) include a copy of the notice given to the respondent agency under subsection 86(2) (notice on completion) and the implementation notice; and (b) give details of the respondent agency’s response (if any) to the implementation notice; and (c) state that the Information Commissioner is not satisfied that the agency has taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation; and (d) state the action that the Information Commissioner believes, if taken by the agency, would be adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation."@en ;
    cml:integrityHash "759b877ede2cc7d8a60014ac9d1218e70a4c829a82b57057afead967964924f5" ;
    cof:pageNumber "204"^^xsd:integer ;
    skos:note "Agency must provide report with details of response to implementation notice and proposed action." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.204" ;
