concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-1 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-1-logic-alleninterval-2 .
concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Within" ;
    cml:logicSummary "Time constraint for response or action." ;
    cml:premiseText "(i) the agency has not responded to the implementation notice within the time specified in the notice; or (ii) the agency has not taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation." ;
    cml:conclusionText "The agency must respond or take action within the specified time." ;
