concept:freedom-of-information-act-1982-sch-4-sec-15aa a cml:Concept ;
    skos:prefLabel "15AA Extension of time with agreement"@en ;
    cml:realizedBy doc:sch-4-sec-15aa ;
    values:originalText "An agency or Minister may extend the period referred to in paragraph 15(5)(b) for dealing with a request, or that period as extended under subsection 15(6) or (8) (consultation), by a further period of no more than 30 days if: (a) the applicant agrees in writing to the extension; and   Access to documents  Part III  Section 15AB Freedom of Information Act 1982 Compilation date: 01/01/2026 (b) the agency or Minister gives written notice of the extension to the Information Commissioner as soon as practicable after the agreement is made." ;
    skos:definition "An agency or Minister may extend the period referred to in paragraph 15(5)(b) for dealing with a request, or that period as extended under subsection 15(6) or (8) (consultation), by a further period of no more than 30 days if: (a) the applicant agrees in writing to the extension; and   Access to documents  Part III  Section 15AB Freedom of Information Act 1982 Compilation date: 01/01/2026 (b) the agency or Minister gives written notice of the extension to the Information Commissioner as soon as practicable after the agreement is made."@en ;
    cml:integrityHash "83d765c7fc0b17c0a2137a2a2caa8dbff6d5d3236525ad37b2894efcdbf10a9e" ;
    cof:pageNumber "60"^^xsd:integer ;
    skos:note "Extension of time with agreement for dealing with a request" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
