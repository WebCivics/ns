doc:sch-4-sec-55h-ss-1 a cof:Section ;
    cof:title "55H(1) Procedure in IC review—reference of questions of law to" ;
    values:kind "subsection" ;
    values:originalText "(1) The Information Commissioner may, at any time during an IC review, refer a question of law arising in an IC review to the Federal Court of Australia for decision." ;
    cof:pageNumber "145"^^xsd:integer .

