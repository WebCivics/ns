concept:freedom-of-information-act-1982-sch-4-sec-89l a cml:Concept ;
    skos:prefLabel "89L Vexatious applicants—grounds for declaration"@en ;
    cml:realizedBy doc:sch-4-sec-89l ;
    values:originalText "(1) The Information Commissioner may make a vexatious applicant declaration in relation to a person only if the Information Commissioner is satisfied of any of the following: (a) that: (i) the person has repeatedly engaged in access actions; and (ii) the repeated engagement involves an abuse of the process for the access action;" ;
    skos:definition "(1) The Information Commissioner may make a vexatious applicant declaration in relation to a person only if the Information Commissioner is satisfied of any of the following: (a) that: (i) the person has repeatedly engaged in access actions; and (ii) the repeated engagement involves an abuse of the process for the access action;"@en ;
    cml:integrityHash "557814e7e254421b9c2c3ae4e7d55fc5c1bf55e52d50c5be8477e1e4fcd2c258" ;
    cof:pageNumber "209"^^xsd:integer ;
    skos:note "The Information Commissioner may make a declaration if the person has repeatedly engaged in access actions and abuses the process." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.209" ;
    cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-89l-norm .
