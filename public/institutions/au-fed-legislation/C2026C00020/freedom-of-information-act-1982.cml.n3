doc:sch-4-sec-24ab-ss-5 a cof:Section ;
    cof:title "24AB(5) What is a request consultation process?" ;
    values:kind "subsection" ;
    values:originalText "(5) The contact person may, with the applicant’s agreement, extend the consultation period by written notice to the applicant. Outcome of request consultation process" ;
    cof:pageNumber "72"^^xsd:integer .

concept:freedom-of-information-act-1982-sch-4-sec-24ab-ss-6 a cml:Concept ;
    skos:prefLabel "24AB(6) What is a request consultation process?"@en ;
    cml:realizedBy doc:sch-4-sec-24ab-ss-6 ;
    values:originalText "(6) The applicant must, before the end of the consultation period, do one of the following, by written notice to the agency or Minister: (a) withdraw the request; (b) make a revised request; (c) indicate that the applicant does not wish to revise the request." ;
    skos:definition "(6) The applicant must, before the end of the consultation period, do one of the following, by written notice to the agency or Minister: (a) withdraw the request; (b) make a revised request; (c) indicate that the applicant does not wish to revise the request."@en ;
    cml:integrityHash "c5e1eb256a7662f8da82842f5230923704c856b600a722c257baaa8a358a3e16" ;
    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-24ab ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Must provide written notice to agency or Minister before end of consultation period." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
