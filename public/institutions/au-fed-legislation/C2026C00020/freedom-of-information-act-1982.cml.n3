concept:freedom-of-information-act-1982-sch-4-sec-34 a cml:Concept ;
    skos:prefLabel "34 Cabinet documents"@en ;
    cml:realizedBy doc:sch-4-sec-34 ;
    values:originalText "General rules (1) A document is an exempt document if: (a) both of the following are satisfied: (i) it has been submitted to the Cabinet for its consideration, or is or was proposed by a Minister to be so submitted; (ii) it was brought into existence for the dominant purpose of submission for consideration by the Cabinet; or (b) it is an official record of the Cabinet; or (c) it was brought into existence for the dominant purpose of briefing a Minister on a document to which paragraph (a) applies; or" ;
    skos:definition "General rules (1) A document is an exempt document if: (a) both of the following are satisfied: (i) it has been submitted to the Cabinet for its consideration, or is or was proposed by a Minister to be so submitted; (ii) it was brought into existence for the dominant purpose of submission for consideration by the Cabinet; or (b) it is an official record of the Cabinet; or (c) it was brought into existence for the dominant purpose of briefing a Minister on a document to which paragraph (a) applies; or"@en ;
    cml:integrityHash "21b43b56baa49fe6081d71fbca943f3c742bede2e8db0bd58ffdd62cdfa83c4d" ;
    cof:pageNumber "91"^^xsd:integer ;
    skos:note "A document is exempt if it was submitted to the Cabinet for consideration or proposed by a Minister to be so." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
