    cml:logicSummary "Prohibits access to personnel records unless request is made through established procedures." ;
    cml:premiseText "(2) Where:..." ;
    cml:conclusionText "the person must not apply under section 15 for access to such records unless the person:" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

