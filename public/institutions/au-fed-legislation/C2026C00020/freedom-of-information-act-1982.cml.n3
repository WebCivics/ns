concept:freedom-of-information-act-1982-sch-4-sec-54k a cml:Concept ;
    skos:prefLabel "54K Key concepts—what is an IC reviewable decision?"@en ;
    cml:realizedBy doc:sch-4-sec-54k ;
    values:originalText "An IC reviewable decision is: (a) a decision covered by subsection 54L(2) (access refusal decisions); or (b) a decision covered by subsection 54M(2) (access grant decisions). Note: IC reviewable decision is short for Information Commissioner reviewable decision.   Review by Information Commissioner  Part VII IC reviewable decisions  Division 3 Section 54L Freedom of Information Act 1982 Compilation date: 01/01/2026" ;
    skos:definition "An IC reviewable decision is: (a) a decision covered by subsection 54L(2) (access refusal decisions); or (b) a decision covered by subsection 54M(2) (access grant decisions). Note: IC reviewable decision is short for Information Commissioner reviewable decision.   Review by Information Commissioner  Part VII IC reviewable decisions  Division 3 Section 54L Freedom of Information Act 1982 Compilation date: 01/01/2026"@en ;
    cml:integrityHash "645673e55d7ab6b1a05075c39f38a15f778f085ff04cb57f562e8f67282150b8" ;
    cof:pageNumber "128"^^xsd:integer ;
    skos:note "Defines IC reviewable decision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-act-1982.pdf> ;
    dc:source "freedom-of-information-act-1982.pdf, p.128" ;
