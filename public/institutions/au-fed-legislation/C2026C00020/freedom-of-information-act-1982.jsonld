    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-56-ss-1",
      "@type": "cof:Section",
      "cof:title": "56(1) Appeals—appeals to Federal Court of Australia on questions of",
      "values:kind": "subsection",
      "cof:pageNumber": 162,
      "values:originalText": "(1) A review party may appeal to the Federal Court of Australia, on a\nquestion of law, from a decision of the Information Commissioner\non an IC review."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-56-ss-1-norm",
