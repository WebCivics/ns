      },
      "cml:premiseText": "Review party may appeal",
      "cml:conclusionText": "Information Commissioner's decision is subject to review"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-56-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "56(2) Appeals—appeals to Federal Court of Australia on questions of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-56-ss-2"
