    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "89A(4) Information Commissioner investigations—failure to take",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89a-ss-4"
