    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-27a-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval for consideration of personal information.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The agency must consider the personal information within a reasonable time frame.",
      "cml:conclusionText": "The agency considers the personal information between the time the person concerned was associated with the matters dealt with in the information and the present time."
