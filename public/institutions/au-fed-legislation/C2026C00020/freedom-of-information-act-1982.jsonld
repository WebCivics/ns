    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-4a",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A Certain legislation relating to Australian Capital Territory not to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-4a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
