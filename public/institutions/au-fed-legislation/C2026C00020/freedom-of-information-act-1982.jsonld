    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "54D(5) Internal review—deemed affirmation of original decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.124",
      "values:originalText": "(5) If the Information Commissioner allows further time the\nInformation Commissioner may impose any condition that he or\nshe considers appropriate.\n\n\nInternal review of decisions  Part VI\n\nSection 54E\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "(5) If the Information Commissioner allows further time the\nInformation Commissioner may impose any condition that he or\nshe considers appropriate.\n\n\nInternal review of decisions  Part VI\n\nSection 54E\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-5-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0fe5f47ec83895b56f9ea9e22a21feed24149ede7f1f8adc44f5ebd60b448a03",
      "skos:note": "Imposing conditions on further time allowed for internal review"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-5",
      "@type": "cof:Section",
      "cof:title": "54D(5) Internal review—deemed affirmation of original decision",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(5) If the Information Commissioner allows further time the\nInformation Commissioner may impose any condition that he or\nshe considers appropriate.\n\n\nInternal review of decisions  Part VI\n\nSection 54E\nFreedom of Information Act 1982\nCompilation date: 01/01/2026"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "impose",
      "cml:logicSummary": "Obligation to impose conditions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Information Commissioner may impose any condition",
      "cml:conclusionText": "Any condition imposed by the Information Commissioner is obligatory"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "54D(6) Internal review—deemed affirmation of original decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.124",
      "values:originalText": "(6) Subsection (2) (deemed affirmation) does not apply, and is taken\nnever to have applied, if the agency:\n(a) makes a decision on the application within the further time\nallowed; and\n(b) complies with any condition imposed under subsection (5).",
      "skos:definition": "(6) Subsection (2) (deemed affirmation) does not apply, and is taken\nnever to have applied, if the agency:\n(a) makes a decision on the application within the further time\nallowed; and\n(b) complies with any condition imposed under subsection (5).",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-6-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-6-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a4a8b5a86953b3954c1ca2ff89c59f0d2662777cfdc326910dc2947084ec7fa5",
      "skos:note": "Agency must comply with conditions imposed under subsection (5) within the further time allowed."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-6",
      "@type": "cof:Section",
      "cof:title": "54D(6) Internal review—deemed affirmation of original decision",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(6) Subsection (2) (deemed affirmation) does not apply, and is taken\nnever to have applied, if the agency:\n(a) makes a decision on the application within the further time\nallowed; and\n(b) complies with any condition imposed under subsection (5)."
    },
