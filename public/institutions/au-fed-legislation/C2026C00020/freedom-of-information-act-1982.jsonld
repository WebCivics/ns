        }
      ],
      "cml:integrityHash": "9f822746ac5147187aa47ad67b18160dba7a8645fbcf577ddf68c0137924db6d",
      "skos:note": "Allow further time for agency to deal with application"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-4",
      "@type": "cof:Section",
      "cof:title": "54D(4) Internal review—deemed affirmation of original decision",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(4) The Information Commissioner may allow further time considered\nappropriate by the Information Commissioner for the agency to\ndeal with the application."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
