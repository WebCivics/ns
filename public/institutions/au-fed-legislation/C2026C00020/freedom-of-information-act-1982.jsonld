    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55zb-ss-3",
      "@type": "cof:Section",
      "cof:title": "55ZB(3) Evidence by Inspector-General of Intelligence and Security—",
