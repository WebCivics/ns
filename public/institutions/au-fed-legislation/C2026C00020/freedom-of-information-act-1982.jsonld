        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) any part of a Roll referred to in paragraph (a).",
      "cml:conclusionText": "electoral roll means:\n(b) any part of a Roll referred to in paragraph (a)."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47a-ss-1-logic-alleninterval-4",
