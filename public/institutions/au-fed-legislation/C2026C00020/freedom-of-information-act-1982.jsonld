      },
      "cml:premiseText": "(b) would be detrimental to the preservation of the document or,\nhaving regard to the physical nature of the document, would\nnot be appropriate;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3-logic-deontic-4",
