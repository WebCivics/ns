      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-24ab-ss-6-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-24ab-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c5e1eb256a7662f8da82842f5230923704c856b600a722c257baaa8a358a3e16",
      "skos:note": "Must provide written notice to agency or Minister before end of consultation period.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-24ab-ss-6",
      "@type": "cof:Section",
      "cof:title": "24AB(6) What is a request consultation process?",
      "values:kind": "subsection",
      "cof:pageNumber": 72,
      "values:originalText": "(6) The applicant must, before the end of the consultation period, do\none of the following, by written notice to the agency or Minister:\n(a) withdraw the request;\n(b) make a revised request;\n(c) indicate that the applicant does not wish to revise the request."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-24ab-ss-6-norm",
