      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document is conditionally exempt if its disclosure under this Act would, or could reasonably be expected to, do any of the following:"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
