    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-31b",
      "@type": "cml:Concept",
      "skos:prefLabel": "31B Exempt documents for the purposes of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-31b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.89",
      "values:originalText": "A document is exempt for the purposes of this Part if:\n(a) it is an exempt document under Division 2; or\n(b) it is conditionally exempt under Division 3, and access to the\ndocument would, on balance, be contrary to the public\ninterest for the purposes of subsection 11A(5).\nNote 1:\nA document is an exempt document for the purposes of this Act (see\nsubsection 4(1)) if:\n(a)\nit is exempt under this section; or\n(b)\nit is exempt because of section 7 (exemption of certain persons\nand bodies); or\n(c)\nit is an official document of a Minister that contains matters not\nrelating to the affairs of an agency or a Department of State.\nNote 2:\nAccess must generally be given to a conditionally exempt document\nunless it would be contrary to the public interest (see section 11A).",
      "skos:definition": "A document is exempt for the purposes of this Part if:\n(a) it is an exempt document under Division 2; or\n(b) it is conditionally exempt under Division 3, and access to the\ndocument would, on balance, be contrary to the public\ninterest for the purposes of subsection 11A(5).\nNote 1:\nA document is an exempt document for the purposes of this Act (see\nsubsection 4(1)) if:\n(a)\nit is exempt under this section; or\n(b)\nit is exempt because of section 7 (exemption of certain persons\nand bodies); or\n(c)\nit is an official document of a Minister that contains matters not\nrelating to the affairs of an agency or a Department of State.\nNote 2:\nAccess must generally be given to a conditionally exempt document\nunless it would be contrary to the public interest (see section 11A).",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-31b-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-31b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a0a2cec8ddac91db43e0821a5c743edc3f1a64348c0c0895952d232a9915d31b",
      "skos:note": "A document is exempt if it meets certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-31b",
      "@type": "cof:Section",
      "cof:title": "31B Exempt documents for the purposes of this Part",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "A document is exempt for the purposes of this Part if:\n(a) it is an exempt document under Division 2; or\n(b) it is conditionally exempt under Division 3, and access to the\ndocument would, on balance, be contrary to the public\ninterest for the purposes of subsection 11A(5).\nNote 1:\nA document is an exempt document for the purposes of this Act (see\nsubsection 4(1)) if:\n(a)\nit is exempt under this section; or\n(b)\nit is exempt because of section 7 (exemption of certain persons\nand bodies); or\n(c)\nit is an official document of a Minister that contains matters not\nrelating to the affairs of an agency or a Department of State.\nNote 2:\nAccess must generally be given to a conditionally exempt document\nunless it would be contrary to the public interest (see section 11A)."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-31b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-31b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-31b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
