    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-27-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "27(3) Consultation—business documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-27-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
