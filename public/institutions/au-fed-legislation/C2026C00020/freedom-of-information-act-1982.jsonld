      "cml:premiseText": "The Information Commissioner may decide not to investigate...",
      "cml:conclusionText": "The action is taken by an agency in the performance of its functions or exercise of its powers."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-73-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Permission for the Information Commissioner to decide not to investigate a complaint under section 70",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.8,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Information Commissioner may decide not to investigate...",
      "cml:conclusionText": "None"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-73-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between the decision to investigate and the action taken by an agency",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.6,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Information Commissioner may decide not to investigate...",
      "cml:conclusionText": "The decision to investigate overlaps with the action taken by an agency."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-73-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal relationship between the decision to investigate and the complainant's exercise of their right",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Information Commissioner may decide not to investigate...",
      "cml:conclusionText": "The decision to investigate is until the complainant exercises their right."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-73-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation for the complainant to exercise their right to review the action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The complainant has not exercised...",
      "cml:conclusionText": "It would be reasonable for the complainant to have exercised the right."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74",
      "@type": "cml:Concept",
      "skos:prefLabel": "74 Information Commissioner investigations—transfer to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-74"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.191",
      "values:originalText": "Ombudsman\nScope\n(1) This section applies if the Information Commissioner is satisfied\nthat a complaint about an action could be more effectively or\nappropriately dealt with:\n(a) by the Ombudsman under the Ombudsman Act 1976; or\n(b) by the Ombudsman under a particular Norfolk Island law.\nExample 1:A complaint about the way in which the Information Commissioner\nhas dealt with an IC review.\nExample 2:A complaint relates to an action under this Act, but is part of a\ncomplaint that relates to other matters that can be more appropriately\ndealt with by the Ombudsman.",
      "skos:definition": "Ombudsman\nScope\n(1) This section applies if the Information Commissioner is satisfied\nthat a complaint about an action could be more effectively or\nappropriately dealt with:\n(a) by the Ombudsman under the Ombudsman Act 1976; or\n(b) by the Ombudsman under a particular Norfolk Island law.\nExample 1:A complaint about the way in which the Information Commissioner\nhas dealt with an IC review.\nExample 2:A complaint relates to an action under this Act, but is part of a\ncomplaint that relates to other matters that can be more appropriately\ndealt with by the Ombudsman.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-alleninterval-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-argumentation-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-diffusion-4"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "c44b40fbd744a4244895e8f9f70ecd028a0af7cb27375c76b32213a2120a5b5e",
      "skos:note": "Transfer of investigations to Ombudsman"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-74",
      "@type": "cof:Section",
      "cof:title": "74 Information Commissioner investigations—transfer to",
      "values:kind": "section",
      "cof:pageNumber": 191,
      "values:originalText": "Ombudsman\nScope\n(1) This section applies if the Information Commissioner is satisfied\nthat a complaint about an action could be more effectively or\nappropriately dealt with:\n(a) by the Ombudsman under the Ombudsman Act 1976; or\n(b) by the Ombudsman under a particular Norfolk Island law.\nExample 1:A complaint about the way in which the Information Commissioner\nhas dealt with an IC review.\nExample 2:A complaint relates to an action under this Act, but is part of a\ncomplaint that relates to other matters that can be more appropriately\ndealt with by the Ombudsman."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "should",
      "cml:logicSummary": "Obligation to transfer investigations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Information Commissioner is satisfied that a complaint could be more effectively dealt with by the Ombudsman.",
      "cml:conclusionText": "There is an obligation to transfer investigations"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Investigations can be transferred during the satisfaction of the Information Commissioner",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Information Commissioner is satisfied that a complaint could be more effectively dealt with.",
      "cml:conclusionText": "Investigations can be transferred during the satisfaction of the Information Commissioner"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Transfer of investigations implies that the Ombudsman has jurisdiction over complaints",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The complaint could be more effectively dealt with by the Ombudsman.",
      "cml:conclusionText": "The Ombudsman has jurisdiction over complaints"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "and",
      "cml:logicSummary": "Transfer of investigations and satisfaction of the Information Commissioner are related conditions",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Information Commissioner is satisfied that a complaint could be more effectively dealt with.",
      "cml:conclusionText": "The transfer of investigations and the satisfaction of the Information Commissioner are related conditions"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-74-logic-cogai-5",
      "@type": "cml:LogicApplication",
