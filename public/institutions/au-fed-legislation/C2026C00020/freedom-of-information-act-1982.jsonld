    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15-ss-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "15(5A) Requests for access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-15-ss-5a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.58",
      "values:originalText": "(5A) In making a decision on a request, the agency or Minister must\nhave regard to any guidelines issued by the Information\nCommissioner for the purposes of section 93A.",
      "skos:definition": "(5A) In making a decision on a request, the agency or Minister must\nhave regard to any guidelines issued by the Information\nCommissioner for the purposes of section 93A.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15"
      },
