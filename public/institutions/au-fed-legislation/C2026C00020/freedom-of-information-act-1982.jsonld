    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Information Commissioner investigations—notice requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.193",
      "values:originalText": "Notice to respondent agency before commencing investigation\n(1) Before beginning an investigation, the Information Commissioner\nmust notify the respondent agency in writing.\nNotice of decision not to investigate, or not to continue to\ninvestigate\n(2) Subsection (3) applies if the Information Commissioner decides:\n(a) not to investigate, or not to continue to investigate, a\ncomplaint made under section 70; or\n(b) not to continue an investigation commenced at the\nInformation Commissioner’s initiative.\n(3) The Information Commissioner must, as soon as practicable, notify\nthe complainant (if any) and the respondent agency of the decision\nin writing.\n(4) A notice under subsection (3) must state the reasons for the\nInformation Commissioner’s decision.\nSubdivision D—Investigation procedure",
      "skos:definition": "Notice to respondent agency before commencing investigation\n(1) Before beginning an investigation, the Information Commissioner\nmust notify the respondent agency in writing.\nNotice of decision not to investigate, or not to continue to\ninvestigate\n(2) Subsection (3) applies if the Information Commissioner decides:\n(a) not to investigate, or not to continue to investigate, a\ncomplaint made under section 70; or\n(b) not to continue an investigation commenced at the\nInformation Commissioner’s initiative.\n(3) The Information Commissioner must, as soon as practicable, notify\nthe complainant (if any) and the respondent agency of the decision\nin writing.\n(4) A notice under subsection (3) must state the reasons for the\nInformation Commissioner’s decision.\nSubdivision D—Investigation procedure",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-75-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-75-ss-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-75-ss-3"
        },
