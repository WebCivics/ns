      "dc:source": "freedom-of-information-act-1982.pdf, p.205",
      "values:originalText": "civil action\n(1) Civil proceedings do not lie against a person in respect of loss,\ndamage or injury of any kind suffered by another person because",
      "skos:definition": "civil action\n(1) Civil proceedings do not lie against a person in respect of loss,\ndamage or injury of any kind suffered by another person because",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89e-norm"
