      "skos:prefLabel": "21(2) Deferment of access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-21-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.68",
      "values:originalText": "(2) Where the provision of access to a document is deferred in\naccordance with subsection (1), the agency or Minister shall, in\ninforming the applicant of the reasons for the decision, indicate, as\nfar as practicable, the period for which the deferment will operate.",
      "skos:definition": "(2) Where the provision of access to a document is deferred in\naccordance with subsection (1), the agency or Minister shall, in\ninforming the applicant of the reasons for the decision, indicate, as\nfar as practicable, the period for which the deferment will operate.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-21"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-21-ss-2-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-21-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ec55067511fc9a1e10ae952097a54633aefb06c15cc4f11fd7bb174e85dab7fe",
      "skos:note": "Agency must inform applicant of reasons and period for deferment.",
      "dc:description": "Reasons and period for deferment"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-21-ss-2",
      "@type": "cof:Section",
      "cof:title": "21(2) Deferment of access",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(2) Where the provision of access to a document is deferred in\naccordance with subsection (1), the agency or Minister shall, in\ninforming the applicant of the reasons for the decision, indicate, as\nfar as practicable, the period for which the deferment will operate."
    },
