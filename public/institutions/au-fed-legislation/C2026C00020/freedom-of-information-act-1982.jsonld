      },
      "cml:operator": "exemption",
      "cml:logicSummary": "Exemptions from access",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Division 2 and Division 3 exemptions"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.89",
      "values:originalText": "A provision of this Part by virtue of which documents referred to in\nthe provision are exempt documents, or are conditionally exempt:\n(a) shall not be construed as limited in its scope or operation in\nany way by any other provision of this Part by virtue of",
      "skos:definition": "A provision of this Part by virtue of which documents referred to in\nthe provision are exempt documents, or are conditionally exempt:\n(a) shall not be construed as limited in its scope or operation in\nany way by any other provision of this Part by virtue of",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-32-norm"
        }
      ],
      "cml:integrityHash": "8b05409fa9b7431b6af586ea734bb89123fc9d54ede6243f151577193d1f09bf",
      "skos:note": "Interpretation of exempt documents provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "A provision of this Part by virtue of which documents referred to in\nthe provision are exempt documents, or are conditionally exempt:\n(a) shall not be construed as limited in its scope or operation in\nany way by any other provision of this Part by virtue of"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-32-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
