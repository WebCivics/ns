      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-7a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Agency must publish information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
