    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "82(2) Information Commissioner investigations—obliging persons to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-82-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.198",
      "values:originalText": "(2) The notice must:\n(a) be in writing; and\n(b) state that the person must comply with the notice at a\nspecified time that is not less than 14 days after the time at\nwhich the person is given the notice; and\n(c) specify the place at which the person must comply with the\nnotice.\nOffence for failure to comply",
      "skos:definition": "(2) The notice must:\n(a) be in writing; and\n(b) state that the person must comply with the notice at a\nspecified time that is not less than 14 days after the time at\nwhich the person is given the notice; and\n(c) specify the place at which the person must comply with the\nnotice.\nOffence for failure to comply",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82"
      },
