    {
      "@id": "concept:freedom-of-information-act-1982-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 January 2026",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
