    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55g-ss-2",
      "@type": "cof:Section",
      "cof:title": "55G(2) Procedure in IC review—revocation or variation of access",
      "values:kind": "subsection",
