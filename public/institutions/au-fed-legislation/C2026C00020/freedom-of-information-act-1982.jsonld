      "dc:source": "freedom-of-information-act-1982.pdf, p.65",
      "values:originalText": "Where a request under the Freedom of Information Act 1989 of the\nAustralian Capital Territory is transferred to an agency in\naccordance with section 33 of that Act, it becomes a request under\nthis Act at the time at which it is received by the agency.",
      "skos:definition": "Where a request under the Freedom of Information Act 1989 of the\nAustralian Capital Territory is transferred to an agency in\naccordance with section 33 of that Act, it becomes a request under\nthis Act at the time at which it is received by the agency.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16a-norm"
        },
