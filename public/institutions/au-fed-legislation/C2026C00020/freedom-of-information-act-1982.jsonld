      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-53a",
      "@type": "cml:Concept",
      "skos:prefLabel": "53A What is an access refusal decision?",
