          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-79-ss-5"
        }
      ],
      "cml:integrityHash": "8a88d66108bfc6db2b7c08f6ab0f57367e34a15e8826ee167ac6edcc72ce4f96"
