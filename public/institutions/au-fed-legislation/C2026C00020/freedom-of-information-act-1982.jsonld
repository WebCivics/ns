    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47j-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "47J(2) Public interest conditional exemptions—the economy",
      "cml:realizedBy": {
