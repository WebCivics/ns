    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-68",
      "@type": "cml:Concept",
      "skos:prefLabel": "68 Investigations and complaints—guide",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-68"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.187",
      "values:originalText": "This Part is about investigations by the Information Commissioner\nand by the Ombudsman.\nDivision 2 sets up a system for investigations by the Information\nCommissioner.\nThe Information Commissioner may investigate an action taken by\nan agency in the performance of functions or the exercise of\npowers under this Act on a complaint from a person, or on the\nInformation Commissioner’s initiative.\nIf a person disputes the merits of an access refusal decision or an\naccess grant decision, this Act provides elsewhere for the review of\nthat decision (see Parts VI, VII and VIIA).\nHowever, this does not prevent a person from making a complaint\nto the Information Commissioner about the way in which the\nagency has handled the decision.\nThe Information Commissioner has powers to obtain documents, to\nquestion persons and to enter premises (see Subdivision D of",
      "skos:definition": "This Part is about investigations by the Information Commissioner\nand by the Ombudsman.\nDivision 2 sets up a system for investigations by the Information\nCommissioner.\nThe Information Commissioner may investigate an action taken by\nan agency in the performance of functions or the exercise of\npowers under this Act on a complaint from a person, or on the\nInformation Commissioner’s initiative.\nIf a person disputes the merits of an access refusal decision or an\naccess grant decision, this Act provides elsewhere for the review of\nthat decision (see Parts VI, VII and VIIA).\nHowever, this does not prevent a person from making a complaint\nto the Information Commissioner about the way in which the\nagency has handled the decision.\nThe Information Commissioner has powers to obtain documents, to\nquestion persons and to enter premises (see Subdivision D of",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-68-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-68-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "abc5f3739c8fbbb83b67b45517eeb2ac8e339bb83d778dcf6564960a830fd2b6",
      "skos:note": "The Information Commissioner may investigate an action taken by an agency."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Investigations and complaints—guide",
      "values:kind": "section",
      "cof:pageNumber": 187,
      "values:originalText": "This Part is about investigations by the Information Commissioner\nand by the Ombudsman.\nDivision 2 sets up a system for investigations by the Information\nCommissioner.\nThe Information Commissioner may investigate an action taken by\nan agency in the performance of functions or the exercise of\npowers under this Act on a complaint from a person, or on the\nInformation Commissioner’s initiative.\nIf a person disputes the merits of an access refusal decision or an\naccess grant decision, this Act provides elsewhere for the review of\nthat decision (see Parts VI, VII and VIIA).\nHowever, this does not prevent a person from making a complaint\nto the Information Commissioner about the way in which the\nagency has handled the decision.\nThe Information Commissioner has powers to obtain documents, to\nquestion persons and to enter premises (see Subdivision D of"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-68-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-68"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-68-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to investigate",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-69",
      "@type": "cml:Concept",
      "skos:prefLabel": "69 Information Commissioner investigations—power to investigate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-69"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.189",
      "values:originalText": "Obligation to investigate\n(1) The Information Commissioner must, subject to this Division,\ninvestigate a complaint made under section 70.\nDiscretion to investigate\n(2) The Information Commissioner may, at the Information\nCommissioner’s initiative, investigate an action taken by an agency\n(the respondent agency) in the performance of functions, or the\nexercise of powers, under this Act.\nSubdivision B—Making complaints",
      "skos:definition": "Obligation to investigate\n(1) The Information Commissioner must, subject to this Division,\ninvestigate a complaint made under section 70.\nDiscretion to investigate\n(2) The Information Commissioner may, at the Information\nCommissioner’s initiative, investigate an action taken by an agency\n(the respondent agency) in the performance of functions, or the\nexercise of powers, under this Act.\nSubdivision B—Making complaints",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-69-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-69-ss-2"
        }
      ],
