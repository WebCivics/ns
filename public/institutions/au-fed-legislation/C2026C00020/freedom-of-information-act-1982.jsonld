      "values:originalText": "(2) The agency must, as soon as practicable, arrange for a person\n(other than the person who made the original decision) to review\nthe decision."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54c-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
