    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89e",
      "@type": "cml:Concept",
      "skos:prefLabel": "89E Information Commissioner investigations—protection from",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
