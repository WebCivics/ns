        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-9a-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "d18d23240a1434eabb203c768ba88f69a5df479d9416a7e4649b916997d9b102",
      "skos:note": "Must consider objects of the Act and guidelines issued by the Information Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-9a",
      "@type": "cof:Section",
