      },
      "cml:premiseText": "(c) promote effective oversight of public expenditure;",
      "cml:conclusionText": "(d) allow a person to access his or her own personal information."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-11b-ss-3-logic-diffusion-4",
