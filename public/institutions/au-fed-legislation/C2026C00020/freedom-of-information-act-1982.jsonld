    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55p-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "55P(4) Decision on IC review—enforcement of decision against agency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55p-ss-4"
      },
      "cml:curationStatus": {
