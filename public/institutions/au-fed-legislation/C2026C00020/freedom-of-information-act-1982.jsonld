    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Application for amendment or annotation of personal records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.109",
      "values:originalText": "Where a person claims that a document of an agency or an official\ndocument of a Minister to which access has been lawfully provided\nto the person, whether under this Act or otherwise, contains\npersonal information about that person:\n(a) that is incomplete, incorrect, out of date or misleading; and\n(b) that has been used, is being used or is available for use by the\nagency or Minister for an administrative purpose;\nthe person may apply to the agency or Minister for:\n(c) an amendment; or\n(d) an annotation;\nof the record of that information kept by the agency or Minister.",
      "skos:definition": "Where a person claims that a document of an agency or an official\ndocument of a Minister to which access has been lawfully provided\nto the person, whether under this Act or otherwise, contains\npersonal information about that person:\n(a) that is incomplete, incorrect, out of date or misleading; and\n(b) that has been used, is being used or is available for use by the\nagency or Minister for an administrative purpose;\nthe person may apply to the agency or Minister for:\n(c) an amendment; or\n(d) an annotation;\nof the record of that information kept by the agency or Minister.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-48-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-48-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-48-logic-deontic-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-48-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "f815d500c5924ae0f6230378fd5b72a3cf06c9fb9c03c2e3c992dc76033bc237",
      "skos:note": "Request for amendment or annotation of personal records"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Application for amendment or annotation of personal records",
      "values:kind": "section",
      "cof:pageNumber": 109,
      "values:originalText": "Where a person claims that a document of an agency or an official\ndocument of a Minister to which access has been lawfully provided\nto the person, whether under this Act or otherwise, contains\npersonal information about that person:\n(a) that is incomplete, incorrect, out of date or misleading; and\n(b) that has been used, is being used or is available for use by the\nagency or Minister for an administrative purpose;\nthe person may apply to the agency or Minister for:\n(c) an amendment; or\n(d) an annotation;\nof the record of that information kept by the agency or Minister."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-48-norm",
      "@type": "values:Right",
      "cml:modality": {
