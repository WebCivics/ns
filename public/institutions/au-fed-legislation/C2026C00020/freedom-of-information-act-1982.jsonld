    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-70",
      "@type": "cml:Concept",
      "skos:prefLabel": "70 Information Commissioner investigations—making complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-70"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.189",
      "values:originalText": "(1) A person (the complainant) may complain to the Information\nCommissioner about an action taken by an agency in the\nperformance of functions, or the exercise of powers, under this\nAct.\n(2) A complaint must:\n(a) be in writing; and\n(b) identify the agency (also the respondent agency) in respect\nof which the complaint is made.\n(3) The Office of the Australian Information Commissioner must\nprovide appropriate assistance to a person who:\n(a) wishes to make a complaint; and\n(b) requires assistance to formulate the complaint.",
      "skos:definition": "(1) A person (the complainant) may complain to the Information\nCommissioner about an action taken by an agency in the\nperformance of functions, or the exercise of powers, under this\nAct.\n(2) A complaint must:\n(a) be in writing; and\n(b) identify the agency (also the respondent agency) in respect\nof which the complaint is made.\n(3) The Office of the Australian Information Commissioner must\nprovide appropriate assistance to a person who:\n(a) wishes to make a complaint; and\n(b) requires assistance to formulate the complaint.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-70-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-70-ss-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-70-ss-3"
        }
      ],
      "cml:integrityHash": "767ddb7702c288fafa1c791e0346b73c6ff5cba0e9ccf4cbd47eac66bc904524"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Information Commissioner investigations—making complaints",
      "values:kind": "section",
      "cof:pageNumber": 189,
      "values:originalText": "(1) A person (the complainant) may complain to the Information\nCommissioner about an action taken by an agency in the\nperformance of functions, or the exercise of powers, under this\nAct.\n(2) A complaint must:\n(a) be in writing; and\n(b) identify the agency (also the respondent agency) in respect\nof which the complaint is made.\n(3) The Office of the Australian Information Commissioner must\nprovide appropriate assistance to a person who:\n(a) wishes to make a complaint; and\n(b) requires assistance to formulate the complaint."
    },
