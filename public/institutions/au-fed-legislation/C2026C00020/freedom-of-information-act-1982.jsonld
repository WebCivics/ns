      "values:kind": "subsection",
      "cof:pageNumber": 209,
      "values:originalText": "(4) The Information Commissioner must, as soon as practicable, give\nwritten notice to the person in relation to whom the vexatious\napplicant declaration is made."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89k-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89k-ss-4"
      },
