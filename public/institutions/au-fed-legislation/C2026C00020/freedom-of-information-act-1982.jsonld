      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c",
      "@type": "cml:Concept",
      "skos:prefLabel": "89C Information Commissioner investigations—ensuring",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.204",
      "values:originalText": "non-disclosure of certain matters\n(1) This section applies to the following documents:\n(a) a notice to a complainant under section 86 (notice on\ncompletion);\n(b) a report to the FOI Minister under subsection 89A(3) (failure\nto take action).\n(2) The Information Commissioner must not include in the document:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89D\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "non-disclosure of certain matters\n(1) This section applies to the following documents:\n(a) a notice to a complainant under section 86 (notice on\ncompletion);\n(b) a report to the FOI Minister under subsection 89A(3) (failure\nto take action).\n(2) The Information Commissioner must not include in the document:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89D\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c-ss-2"
        }
      ],
      "cml:integrityHash": "e2edaeaac723959df7eb3dff6872014f4de4afbb454554cbac29857463e53980"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89c",
      "@type": "cof:Section",
      "cof:title": "89C Information Commissioner investigations—ensuring",
      "values:kind": "section",
      "cof:pageNumber": 204,
      "values:originalText": "non-disclosure of certain matters\n(1) This section applies to the following documents:\n(a) a notice to a complainant under section 86 (notice on\ncompletion);\n(b) a report to the FOI Minister under subsection 89A(3) (failure\nto take action).\n(2) The Information Commissioner must not include in the document:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89D\nFreedom of Information Act 1982\nCompilation date: 01/01/2026"
    },
