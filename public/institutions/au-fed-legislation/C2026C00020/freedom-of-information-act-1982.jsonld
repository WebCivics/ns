        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "The person has repeatedly engaged in access actions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) the person has repeatedly engaged in access actions;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "abuses",
      "cml:logicSummary": "The repeated engagement involves an abuse of the process for the access action.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) the repeated engagement involves an abuse of the process for the access action;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89m",
      "@type": "cml:Concept",
      "skos:prefLabel": "89M Vexatious applicants—effect of declaration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.210",
      "values:originalText": "(1) A vexatious applicant declaration has effect in accordance with the\nterms and conditions stated in the declaration.\n(2) Without limiting subsection (1), a vexatious applicant declaration\nin relation to a person may provide that:\n(a) an agency or Minister may refuse to consider any of the\nfollowing if made by the person without the written\npermission of the Information Commissioner:\n\n\nMiscellaneous  Part VIII\nVexatious applicants  Division 1\nSection 89N\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(i) a request;\n(ii) an application under section 48 (amendment of records);\n(iii) an application for internal review; and\n(b) the Information Commissioner may refuse to consider an IC\nreview application made by the person.\n(3) If a decision is made as mentioned in subsection (2), the agency,\nMinister or the Information Commissioner (as the case requires)\nmust, as soon as practicable, notify the vexatious applicant of the\ndecision.",
      "skos:definition": "(1) A vexatious applicant declaration has effect in accordance with the\nterms and conditions stated in the declaration.\n(2) Without limiting subsection (1), a vexatious applicant declaration\nin relation to a person may provide that:\n(a) an agency or Minister may refuse to consider any of the\nfollowing if made by the person without the written\npermission of the Information Commissioner:\n\n\nMiscellaneous  Part VIII\nVexatious applicants  Division 1\nSection 89N\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(i) a request;\n(ii) an application under section 48 (amendment of records);\n(iii) an application for internal review; and\n(b) the Information Commissioner may refuse to consider an IC\nreview application made by the person.\n(3) If a decision is made as mentioned in subsection (2), the agency,\nMinister or the Information Commissioner (as the case requires)\nmust, as soon as practicable, notify the vexatious applicant of the\ndecision.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89m-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89m-ss-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89m-ss-3"
        }
      ],
      "cml:integrityHash": "e82d11ac9d41eb67a05f2b0bddede015eb80c9ae166bc85b242a321076c6f4eb"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89m",
      "@type": "cof:Section",
      "cof:title": "89M Vexatious applicants—effect of declaration",
      "values:kind": "section",
      "cof:pageNumber": 210,
      "values:originalText": "(1) A vexatious applicant declaration has effect in accordance with the\nterms and conditions stated in the declaration.\n(2) Without limiting subsection (1), a vexatious applicant declaration\nin relation to a person may provide that:\n(a) an agency or Minister may refuse to consider any of the\nfollowing if made by the person without the written\npermission of the Information Commissioner:\n\n\nMiscellaneous  Part VIII\nVexatious applicants  Division 1\nSection 89N\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(i) a request;\n(ii) an application under section 48 (amendment of records);\n(iii) an application for internal review; and\n(b) the Information Commissioner may refuse to consider an IC\nreview application made by the person.\n(3) If a decision is made as mentioned in subsection (2), the agency,\nMinister or the Information Commissioner (as the case requires)\nmust, as soon as practicable, notify the vexatious applicant of the\ndecision."
    },
