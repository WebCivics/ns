        }
      ],
      "cml:integrityHash": "4cbddbd625c550c424eeaea400c73e75325bd1c693a0c4e4d823c6cb539ceef2",
      "skos:note": "Agency must publish information on a website.",
      "dc:description": "Information"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-8d-ss-3",
      "@type": "cof:Section",
      "cof:title": "8D(3) Information to be published—how (and to whom) information is",
      "values:kind": "subsection",
      "cof:pageNumber": 45,
      "values:originalText": "(3) The agency must publish the information on a website by:\n(a) making the information available for downloading from the\nwebsite; or\n(b) publishing on the website a link to another website, from\nwhich the information can be downloaded; or\n(c) publishing on the website other details of how the\ninformation may be obtained.\nCharges"
    },
