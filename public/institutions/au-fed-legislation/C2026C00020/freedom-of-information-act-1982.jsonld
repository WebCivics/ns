      "cml:logicSummary": "Agency or Minister must consider public interest before granting access to document",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) access to the document would, on balance, be contrary to the public interest for the purposes of subsection 11A(5)",
      "cml:conclusionText": "Agency or Minister must consider public interest before granting access"
    },
