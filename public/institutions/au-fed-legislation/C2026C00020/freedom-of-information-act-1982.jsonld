        }
      ],
      "cml:integrityHash": "49ead0495d03db3ddd177ec8328fb2d681ff6f4d0d8a757231dc9888d662ab8e",
      "skos:note": "Agency/Minister must give written notice to State and Applicant after consultation.",
      "dc:description": "Written notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-26a-ss-3",
      "@type": "cof:Section",
      "cof:title": "26A(3) Consultation—documents affecting Commonwealth-State",
      "values:kind": "subsection",
      "cof:pageNumber": 76,
