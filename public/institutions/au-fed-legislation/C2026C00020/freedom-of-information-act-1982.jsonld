    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "3A Objects—information or documents otherwise accessible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.14",
      "values:originalText": "Scope\n(1) This section applies if a Minister, or an officer of an agency, has\nthe power to publish, or give access to, information or a document\n(including an exempt document) apart from under this Act.\nPublication and access powers not limited\n(2) The Parliament does not intend, by this Act, to limit that power, or\nto prevent or discourage the exercise of that power:\n(a) in the case of the power to publish the information or\ndocument—despite any restriction on the publication of the\ninformation or document under this Act; and\n(b) in the case of the power to give access to the information or\ndocument—whether or not access to the information or\ndocument has been requested under section 15.",
      "skos:definition": "Scope\n(1) This section applies if a Minister, or an officer of an agency, has\nthe power to publish, or give access to, information or a document\n(including an exempt document) apart from under this Act.\nPublication and access powers not limited\n(2) The Parliament does not intend, by this Act, to limit that power, or\nto prevent or discourage the exercise of that power:\n(a) in the case of the power to publish the information or\ndocument—despite any restriction on the publication of the\ninformation or document under this Act; and\n(b) in the case of the power to give access to the information or\ndocument—whether or not access to the information or\ndocument has been requested under section 15.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-3a-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-3a-ss-2"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-3a",
      "@type": "cof:Section",
      "cof:title": "3A Objects—information or documents otherwise accessible",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Scope\n(1) This section applies if a Minister, or an officer of an agency, has\nthe power to publish, or give access to, information or a document\n(including an exempt document) apart from under this Act.\nPublication and access powers not limited\n(2) The Parliament does not intend, by this Act, to limit that power, or\nto prevent or discourage the exercise of that power:\n(a) in the case of the power to publish the information or\ndocument—despite any restriction on the publication of the\ninformation or document under this Act; and\n(b) in the case of the power to give access to the information or\ndocument—whether or not access to the information or\ndocument has been requested under section 15."
    },
