    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Information Commissioner investigations—conduct of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.193",
      "values:originalText": "investigation\n(1) An investigation must be conducted in private and in a way the\nInformation Commissioner thinks fit.\n(2) For the purposes of an investigation, the Information\nCommissioner may obtain information from any officer of an\nagency, and make any inquiry, that he or she thinks is relevant to\nthe investigation.",
      "skos:definition": "investigation\n(1) An investigation must be conducted in private and in a way the\nInformation Commissioner thinks fit.\n(2) For the purposes of an investigation, the Information\nCommissioner may obtain information from any officer of an\nagency, and make any inquiry, that he or she thinks is relevant to\nthe investigation.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-76-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-76-ss-2"
        }
      ],
      "cml:integrityHash": "57794bdeddd908748d80f827d22b534019ac4de886dde656caef927cbb839537"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Information Commissioner investigations—conduct of",
      "values:kind": "section",
      "cof:pageNumber": 193,
      "values:originalText": "investigation\n(1) An investigation must be conducted in private and in a way the\nInformation Commissioner thinks fit.\n(2) For the purposes of an investigation, the Information\nCommissioner may obtain information from any officer of an\nagency, and make any inquiry, that he or she thinks is relevant to\nthe investigation."
    },
