    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Agency's decisions are binding.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A decision given by a person on behalf of an agency is taken to have been given by the agency.",
      "cml:conclusionText": "The decision is binding."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Agency's representatives can make decisions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A decision given by a person on behalf of an agency is taken to have been given by the agency.",
      "cml:conclusionText": "The representative has permission to make a decision."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:logicSummary": "Agency's representatives have rights.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A decision given by a person on behalf of an agency is taken to have been given by the agency.",
      "cml:conclusionText": "The representative has a right."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Undertaking",
      "cml:logicSummary": "Agency's decisions are part of its authority.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A decision given by a person on behalf of an agency is taken to have been given by the agency."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Agency's representatives are obligated to follow decisions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A decision given by a person on behalf of an agency is taken to have been given by the agency.",
      "cml:conclusionText": "The representative is obligated to follow the decision."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "60(3) Procedure in Tribunal—parties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-60-ss-3"
      },
      "cml:curationStatus": {
