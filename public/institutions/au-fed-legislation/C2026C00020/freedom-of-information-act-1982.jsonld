    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54u",
      "@type": "cml:Concept",
      "skos:prefLabel": "54U Decision to review—interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.136",
      "values:originalText": "This Division applies to a part of an IC review application as if a\nreference to an IC review application were a reference to the part\nof the IC review application.",
      "skos:definition": "This Division applies to a part of an IC review application as if a\nreference to an IC review application were a reference to the part\nof the IC review application.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54u-norm"
        }
      ],
      "cml:integrityHash": "250f3ebfcd809b45970266ac199ddc20f3a9c4b58e942e111bb234560961f01a",
      "skos:note": "Applies to a part of an IC review application"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54u",
      "@type": "cof:Section",
      "cof:title": "54U Decision to review—interpretation",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "This Division applies to a part of an IC review application as if a\nreference to an IC review application were a reference to the part\nof the IC review application."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54u-norm",
