        }
      ],
      "cml:integrityHash": "560e7453771ffb6ef954b7510a70c94398791a5fb0061fedeeda40f51591d880",
      "skos:note": "Minister must receive report from Information Commissioner",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89a-ss-3",
      "@type": "cof:Section",
      "cof:title": "89A(3) Information Commissioner investigations—failure to take",
      "values:kind": "subsection",
      "cof:pageNumber": 203,
      "values:originalText": "(3) If the Information Commissioner gives a report to the responsible\nMinister under subsection (2), the Information Commissioner must\ngive a copy (or a copy prepared in accordance with subsection (4))\nof the report to the Minister (the FOI Minister) responsible for the\nadministration of this Act."
    },
