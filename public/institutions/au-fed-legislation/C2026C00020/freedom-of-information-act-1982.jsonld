      "cml:integrityHash": "6830194aef8d8841b0499942646314a8d6f72febb273c55cee514f9d398b028b",
      "skos:note": "Failure to respond to implementation notice within specified time or inadequate action must be taken."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89a-ss-1",
      "@type": "cof:Section",
