      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-61a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The provision imposes an obligation on the agency or Minister to make decisions in accordance with the specified provisions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-61a-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "The provision classifies the decision-maker as a party to be notified of application.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-62",
      "@type": "cml:Concept",
      "skos:prefLabel": "62 Application of section 268 of Administrative Review Tribunal Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-62"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.178",
      "values:originalText": "etc.\n(1) Where, in relation to a decision in respect of a request, the\napplicant has been given a notice in writing under section 26,\nsection 268 of the Administrative Review Tribunal Act 2024 does\nnot apply to that decision.\n(2) If the Tribunal, upon application for a declaration under this\nsubsection made to it by a person to whom a notice has been\nfurnished in pursuance of subsection 26(1), considers that the\nnotice does not contain adequate particulars of findings on material\nquestions of fact, an adequate reference to the evidence or other\nmaterial on which those findings were based or adequate\nparticulars of the reasons for the decision, the Tribunal may make a\ndeclaration accordingly, and, where the Tribunal makes such a\ndeclaration, the person responsible for furnishing the notice shall,\nas soon as practicable but in any case within 28 days after the\nTribunal makes the declaration, furnish to the applicant an\n\n\nReview by the Tribunal  Part VIIA\nProcedure in Tribunal  Division 4\nSection 62\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\nadditional notice or additional notices containing further and better\nparticulars in relation to matters specified in the declaration with\nrespect to those findings, that evidence or other material or those\nreasons.",
      "skos:definition": "etc.\n(1) Where, in relation to a decision in respect of a request, the\napplicant has been given a notice in writing under section 26,\nsection 268 of the Administrative Review Tribunal Act 2024 does\nnot apply to that decision.\n(2) If the Tribunal, upon application for a declaration under this\nsubsection made to it by a person to whom a notice has been\nfurnished in pursuance of subsection 26(1), considers that the\nnotice does not contain adequate particulars of findings on material\nquestions of fact, an adequate reference to the evidence or other\nmaterial on which those findings were based or adequate\nparticulars of the reasons for the decision, the Tribunal may make a\ndeclaration accordingly, and, where the Tribunal makes such a\ndeclaration, the person responsible for furnishing the notice shall,\nas soon as practicable but in any case within 28 days after the\nTribunal makes the declaration, furnish to the applicant an\n\n\nReview by the Tribunal  Part VIIA\nProcedure in Tribunal  Division 4\nSection 62\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\nadditional notice or additional notices containing further and better\nparticulars in relation to matters specified in the declaration with\nrespect to those findings, that evidence or other material or those\nreasons.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-62-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-62-ss-2"
        }
      ],
      "cml:integrityHash": "41b387a9617d9ffde9dc713bb94531bfc48d834db2fdc78d61c2040332d7bd35"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-62",
      "@type": "cof:Section",
      "cof:title": "62 Application of section 268 of Administrative Review Tribunal Act",
      "values:kind": "section",
      "cof:pageNumber": 178,
      "values:originalText": "etc.\n(1) Where, in relation to a decision in respect of a request, the\napplicant has been given a notice in writing under section 26,\nsection 268 of the Administrative Review Tribunal Act 2024 does\nnot apply to that decision.\n(2) If the Tribunal, upon application for a declaration under this\nsubsection made to it by a person to whom a notice has been\nfurnished in pursuance of subsection 26(1), considers that the\nnotice does not contain adequate particulars of findings on material\nquestions of fact, an adequate reference to the evidence or other\nmaterial on which those findings were based or adequate\nparticulars of the reasons for the decision, the Tribunal may make a\ndeclaration accordingly, and, where the Tribunal makes such a\ndeclaration, the person responsible for furnishing the notice shall,\nas soon as practicable but in any case within 28 days after the\nTribunal makes the declaration, furnish to the applicant an\n\n\nReview by the Tribunal  Part VIIA\nProcedure in Tribunal  Division 4\nSection 62\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\nadditional notice or additional notices containing further and better\nparticulars in relation to matters specified in the declaration with\nrespect to those findings, that evidence or other material or those\nreasons."
    },
