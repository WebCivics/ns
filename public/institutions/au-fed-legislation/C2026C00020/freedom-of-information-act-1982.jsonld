    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to comply with a notice requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is subject to a requirement specified in a notice.",
      "cml:conclusionText": "The person commits an offence if the person engages in conduct that breaches the requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "permission",
      "cml:logicSummary": "Permission to engage in conduct that breaches a notice requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person engages in conduct; and",
      "cml:conclusionText": "The person commits an offence if the person's conduct breaches the requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "prohibition",
      "cml:logicSummary": "Prohibition on engaging in conduct that breaches a notice requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person commits an offence if:",
      "cml:conclusionText": "The person's conduct must not breach the requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "right",
      "cml:logicSummary": "Right to be free from unreasonable requirements.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is subject to a requirement specified in a notice under subsection (1); and",
      "cml:conclusionText": "The person's conduct must not breach the requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-3-logic-deontic-5",
