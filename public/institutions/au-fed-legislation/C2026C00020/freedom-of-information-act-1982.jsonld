    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51da",
      "@type": "cml:Concept",
      "skos:prefLabel": "51DA Decision not made on request for amendment or annotation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51da"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.115",
      "values:originalText": "within time—deemed refusal\n(1) This section applies if:\n(a) an application has been made to an agency or Minister under\nsection 48; and\n(b) the period of 30 days mentioned in section 51D (the initial\ndecision period) has ended since the day the application was\nreceived by, or on behalf of, the agency or Minister; and\n(c) notice of a decision on the application has not been received\nby the applicant.",
      "skos:definition": "within time—deemed refusal\n(1) This section applies if:\n(a) an application has been made to an agency or Minister under\nsection 48; and\n(b) the period of 30 days mentioned in section 51D (the initial\ndecision period) has ended since the day the application was\nreceived by, or on behalf of, the agency or Minister; and\n(c) notice of a decision on the application has not been received\nby the applicant.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51da-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51da-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8502e66f40949b4b010bb2cd9f2ce3464858a7bdcdd79382ed66e57d6eff5894",
      "skos:note": "Agency must make decision on application within 30 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51da",
      "@type": "cof:Section",
      "cof:title": "51DA Decision not made on request for amendment or annotation",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "within time—deemed refusal\n(1) This section applies if:\n(a) an application has been made to an agency or Minister under\nsection 48; and\n(b) the period of 30 days mentioned in section 51D (the initial\ndecision period) has ended since the day the application was\nreceived by, or on behalf of, the agency or Minister; and\n(c) notice of a decision on the application has not been received\nby the applicant."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51da-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
