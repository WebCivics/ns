    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-92-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "92(2) Protection against criminal liability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-92-ss-2"
