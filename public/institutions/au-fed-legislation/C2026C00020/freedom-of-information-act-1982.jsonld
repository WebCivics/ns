    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55p-ss-1",
      "@type": "cof:Section",
      "cof:title": "55P(1) Decision on IC review—enforcement of decision against agency",
      "values:kind": "subsection",
      "cof:pageNumber": 149,
      "values:originalText": "(1) If the principal officer of an agency or a Minister fails to comply\nwith section 55N, an application may be made to the Federal Court\nof Australia for an order directing the principal officer or Minister\nto comply."
    },
    {
