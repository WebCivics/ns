    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47d-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes duty on State to consider public interest when disclosing documents.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e",
      "@type": "cml:Concept",
      "skos:prefLabel": "47E Public interest conditional exemptions—certain operations of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-47e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.103",
      "values:originalText": "agencies\nA document is conditionally exempt if its disclosure under this Act\nwould, or could reasonably be expected to, do any of the\nfollowing:\n(a) prejudice the effectiveness of procedures or methods for the\nconduct of tests, examinations or audits by an agency;\n(b) prejudice the attainment of the objects of particular tests,\nexaminations or audits conducted or to be conducted by an\nagency;\n(c) have a substantial adverse effect on the management or\nassessment of personnel by the Commonwealth or by an\nagency;\n(d) have a substantial adverse effect on the proper and efficient\nconduct of the operations of an agency.\nNote:\nAccess must generally be given to a conditionally exempt document\nunless it would be contrary to the public interest (see section 11A).",
      "skos:definition": "agencies\nA document is conditionally exempt if its disclosure under this Act\nwould, or could reasonably be expected to, do any of the\nfollowing:\n(a) prejudice the effectiveness of procedures or methods for the\nconduct of tests, examinations or audits by an agency;\n(b) prejudice the attainment of the objects of particular tests,\nexaminations or audits conducted or to be conducted by an\nagency;\n(c) have a substantial adverse effect on the management or\nassessment of personnel by the Commonwealth or by an\nagency;\n(d) have a substantial adverse effect on the proper and efficient\nconduct of the operations of an agency.\nNote:\nAccess must generally be given to a conditionally exempt document\nunless it would be contrary to the public interest (see section 11A).",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-alleninterval-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-ltl-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-deontic-4"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "d99fd961cd90c24fbe6c58c870603462a8d3778639b34ded825ac1a10fc3f35f",
      "skos:note": "Conditional exemptions for certain documents"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-47e",
      "@type": "cof:Section",
      "cof:title": "47E Public interest conditional exemptions—certain operations of",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "agencies\nA document is conditionally exempt if its disclosure under this Act\nwould, or could reasonably be expected to, do any of the\nfollowing:\n(a) prejudice the effectiveness of procedures or methods for the\nconduct of tests, examinations or audits by an agency;\n(b) prejudice the attainment of the objects of particular tests,\nexaminations or audits conducted or to be conducted by an\nagency;\n(c) have a substantial adverse effect on the management or\nassessment of personnel by the Commonwealth or by an\nagency;\n(d) have a substantial adverse effect on the proper and efficient\nconduct of the operations of an agency.\nNote:\nAccess must generally be given to a conditionally exempt document\nunless it would be contrary to the public interest (see section 11A)."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-norm",
