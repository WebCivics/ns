      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) This section applies if..."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "54D(2) Internal review—deemed affirmation of original decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.124",
      "values:originalText": "(2) Subject to this section:\n(a) the principal officer of the agency is taken to have made a\ndecision personally affirming the original decision on the last\nday of the initial decision period; and\n(b) notice of the decision is taken to have been given under\nsection 26 to the internal review applicant on the same day.\nAgency may apply for further time",
      "skos:definition": "(2) Subject to this section:\n(a) the principal officer of the agency is taken to have made a\ndecision personally affirming the original decision on the last\nday of the initial decision period; and\n(b) notice of the decision is taken to have been given under\nsection 26 to the internal review applicant on the same day.\nAgency may apply for further time",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-ltl-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-diffusion-4"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-argumentation-5"
        }
      ],
      "cml:integrityHash": "987747f8f21999b6ee1741d99ad9a94ec23cef913659bc4ea3fcdc0b6091054f",
      "skos:note": "Agency must affirm original decision and notify applicant"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54d-ss-2",
      "@type": "cof:Section",
      "cof:title": "54D(2) Internal review—deemed affirmation of original decision",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(2) Subject to this section:\n(a) the principal officer of the agency is taken to have made a\ndecision personally affirming the original decision on the last\nday of the initial decision period; and\n(b) notice of the decision is taken to have been given under\nsection 26 to the internal review applicant on the same day.\nAgency may apply for further time"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
