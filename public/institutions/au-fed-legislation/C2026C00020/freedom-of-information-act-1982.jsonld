    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g",
      "@type": "cml:Concept",
      "skos:prefLabel": "89G Complaints to Ombudsman—report must not contain certain",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.207",
      "values:originalText": "information\nA report under subsection 12(3) or section 15 or 17 of the\nOmbudsman Act 1976 in relation to an action taken under this Act\nmust not include:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.",
      "skos:definition": "information\nA report under subsection 12(3) or section 15 or 17 of the\nOmbudsman Act 1976 in relation to an action taken under this Act\nmust not include:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-alleninterval-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-ltl-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-diffusion-4"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "1e5ccca8873f38d01d9fab1a82f1890b3fe2ff99fb80d84eb4c0acad417354d0",
      "skos:note": "Report must not include certain information"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89g",
      "@type": "cof:Section",
      "cof:title": "89G Complaints to Ombudsman—report must not contain certain",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "information\nA report under subsection 12(3) or section 15 or 17 of the\nOmbudsman Act 1976 in relation to an action taken under this Act\nmust not include:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-norm",
