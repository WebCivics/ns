    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55c",
      "@type": "cml:Concept",
      "skos:prefLabel": "55C Procedure in IC review—representation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
