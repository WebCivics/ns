      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-3a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Agency must provide access",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(4) Transfer of requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-16-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.64",
      "values:originalText": "(4) Where a request is transferred to an agency in accordance with this\nsection, the agency making the transfer shall inform the person\nmaking the request accordingly and, if it is necessary to do so in\norder to enable the other agency to deal with the request, send the\ndocument to the other agency.",
      "skos:definition": "(4) Where a request is transferred to an agency in accordance with this\nsection, the agency making the transfer shall inform the person\nmaking the request accordingly and, if it is necessary to do so in\norder to enable the other agency to deal with the request, send the\ndocument to the other agency.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-4-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa6df3f019de22bb6e11d78e29ecc63b2345e0163cc9faaaa6cdf0b8bbd01454",
      "skos:note": "Agency must inform person making request and send document to other agency if necessary."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-16-ss-4",
      "@type": "cof:Section",
      "cof:title": "16(4) Transfer of requests",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(4) Where a request is transferred to an agency in accordance with this\nsection, the agency making the transfer shall inform the person\nmaking the request accordingly and, if it is necessary to do so in\norder to enable the other agency to deal with the request, send the\ndocument to the other agency."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
