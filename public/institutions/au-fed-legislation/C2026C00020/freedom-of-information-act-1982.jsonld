      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Conditional exemptions repeat across agency operations",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document is conditionally exempt if its disclosure under this Act would, or could reasonably be expected to, do any of the following:"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "State prohibition on disclosing certain documents without public interest justification",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Access must generally be given to a conditionally exempt document unless it would be contrary to the public interest"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State obligation to provide access to documents that do not prejudice agency operations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document is conditionally exempt if its disclosure under this Act would, or could reasonably be expected to, do any of the following:"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47f",
      "@type": "cml:Concept",
      "skos:prefLabel": "47F Public interest conditional exemptions—personal privacy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-47f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.103",
      "values:originalText": "General rule\n(1) A document is conditionally exempt if its disclosure under this Act\nwould involve the unreasonable disclosure of personal information\nabout any person (including a deceased person).\n(2) In determining whether the disclosure of the document would\ninvolve the unreasonable disclosure of personal information, an\nagency or Minister must have regard to the following matters:\n(a) the extent to which the information is well known;\n(b) whether the person to whom the information relates is known\nto be (or to have been) associated with the matters dealt with\nin the document;\n(c) the availability of the information from publicly accessible\nsources;",
      "skos:definition": "General rule\n(1) A document is conditionally exempt if its disclosure under this Act\nwould involve the unreasonable disclosure of personal information\nabout any person (including a deceased person).\n(2) In determining whether the disclosure of the document would\ninvolve the unreasonable disclosure of personal information, an\nagency or Minister must have regard to the following matters:\n(a) the extent to which the information is well known;\n(b) whether the person to whom the information relates is known\nto be (or to have been) associated with the matters dealt with\nin the document;\n(c) the availability of the information from publicly accessible\nsources;",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2"
        }
      ],
      "cml:integrityHash": "48352168b5d297ea082d1f1ace5c17c0ffa85fb95702d14f7b0c7a135660bfd7"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-47f",
      "@type": "cof:Section",
      "cof:title": "47F Public interest conditional exemptions—personal privacy",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "General rule\n(1) A document is conditionally exempt if its disclosure under this Act\nwould involve the unreasonable disclosure of personal information\nabout any person (including a deceased person).\n(2) In determining whether the disclosure of the document would\ninvolve the unreasonable disclosure of personal information, an\nagency or Minister must have regard to the following matters:\n(a) the extent to which the information is well known;\n(b) whether the person to whom the information relates is known\nto be (or to have been) associated with the matters dealt with\nin the document;\n(c) the availability of the information from publicly accessible\nsources;"
    },
