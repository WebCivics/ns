      },
      "cml:premiseText": "(a) promote the objects of this Act (including all the matters set out in sections 3 and 3A);",
      "cml:conclusionText": "(b) inform debate on a matter of public importance;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-11b-ss-3-logic-cogai-5",
