      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Internal review of decisions—guide",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.118",
      "values:originalText": "This Part provides for internal review of decisions by agencies,\nother than decisions made personally by the principal officer of an\nagency or the responsible Minister. Agencies are required to\ncomplete internal reviews within 30 days. However, this period\nmay be extended.\nSections 53A, 53B and 53C define the terms access refusal\ndecision, access grant decision and affected third party. These\nterms are used in this Part and in Parts VII and VIIA.",
      "skos:definition": "This Part provides for internal review of decisions by agencies,\nother than decisions made personally by the principal officer of an\nagency or the responsible Minister. Agencies are required to\ncomplete internal reviews within 30 days. However, this period\nmay be extended.\nSections 53A, 53B and 53C define the terms access refusal\ndecision, access grant decision and affected third party. These\nterms are used in this Part and in Parts VII and VIIA.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-52-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-52-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "782f773f062458d0094778190b24cf283019a927f86bd4b00c60d68cf6d0ec92",
      "skos:note": "Agencies must complete internal reviews within 30 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Internal review of decisions—guide",
      "values:kind": "section",
      "cof:pageNumber": 118,
      "values:originalText": "This Part provides for internal review of decisions by agencies,\nother than decisions made personally by the principal officer of an\nagency or the responsible Minister. Agencies are required to\ncomplete internal reviews within 30 days. However, this period\nmay be extended.\nSections 53A, 53B and 53C define the terms access refusal\ndecision, access grant decision and affected third party. These\nterms are used in this Part and in Parts VII and VIIA."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-52-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-52"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-52-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Agency obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Agencies must complete internal reviews.",
      "cml:conclusionText": "within 30 days"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-53",
      "@type": "cml:Concept",
      "skos:prefLabel": "53 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-53"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.118",
      "values:originalText": "For the purposes of this Act, unless the contrary intention appears,\na claim that a document would, if it exists, be an exempt document\nunder section 33 or 34 is to be deemed to be a claim that the\ndocument is an exempt document under that section despite the\nfact that the existence or non-existence of the document is not\nacknowledged.",
      "skos:definition": "For the purposes of this Act, unless the contrary intention appears,\na claim that a document would, if it exists, be an exempt document\nunder section 33 or 34 is to be deemed to be a claim that the\ndocument is an exempt document under that section despite the\nfact that the existence or non-existence of the document is not\nacknowledged.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-53-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-53-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eff6f24672bef61d59ff45b114ed93f438d750cc346b8c70422fbf35c0003348",
      "skos:note": "Deems a claim that a document is exempt under section 33 or 34 as an obligation to acknowledge the existence of the document if it exists."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-53",
      "@type": "cof:Section",
      "cof:title": "53 Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 118,
      "values:originalText": "For the purposes of this Act, unless the contrary intention appears,\na claim that a document would, if it exists, be an exempt document\nunder section 33 or 34 is to be deemed to be a claim that the\ndocument is an exempt document under that section despite the\nfact that the existence or non-existence of the document is not\nacknowledged."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-53-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
