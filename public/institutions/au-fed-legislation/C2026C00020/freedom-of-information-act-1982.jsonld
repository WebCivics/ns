        }
      ],
      "cml:integrityHash": "ef0382150cbeb55ff61ff36d70472810acca5e45125aa2490d6c65ffe3bf5113",
      "skos:note": "The Information Commissioner must give a written report to the responsible Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89a-ss-2",
      "@type": "cof:Section",
      "cof:title": "89A(2) Information Commissioner investigations—failure to take",
      "values:kind": "subsection",
      "cof:pageNumber": 203,
      "values:originalText": "(2) The Information Commissioner may give a written report to the\nresponsible Minister that contains the matters set out in\nsection 89B.\nNote:\nFor responsible Minister, see subsection 4(1).\nReport to Minister"
    },
