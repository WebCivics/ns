        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-63-ss-2-logic-deontic-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-63-ss-2-logic-linearlogic-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-63-ss-2-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "f06f3f87f4d028d8d97b39c69e99299727b8763ab39b7c34d489702422c7a8a9",
      "skos:note": "Tribunal cannot include certain matters in its decision or reasons."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-63-ss-2",
      "@type": "cof:Section",
      "cof:title": "63(2) Tribunal to ensure non-disclosure of certain matters",
      "values:kind": "subsection",
      "cof:pageNumber": 180,
      "values:originalText": "(2) Notwithstanding anything contained in the Administrative Review\nTribunal Act 2024:\n(a) the Tribunal shall not, in its decision, or reasons for a\ndecision, in a matter arising under this Act, include any\nmatter or information of a kind referred to in paragraph (1)(a)\nor (b); and\n(b) the Tribunal may receive evidence, or hear argument, in the\nabsence of the applicant or his or her representative where it\nis necessary to do so in order to prevent the disclosure to the\napplicant of matter or information of a kind referred to in\nparagraph (1)(a) or (b)."
    },
