      "cml:integrityHash": "374d3d12b6dc0a19ff3431544e022b61e7ef318952f8d384bbae5de8918e62ca",
      "skos:note": "Protection from civil action for loss suffered by another person"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89e",
      "@type": "cof:Section",
      "cof:title": "89E Information Commissioner investigations—protection from",
      "values:kind": "section",
      "cof:pageNumber": 205,
      "values:originalText": "civil action\n(1) Civil proceedings do not lie against a person in respect of loss,\ndamage or injury of any kind suffered by another person because"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89e-norm",
      "@type": "values:Prohibition",
