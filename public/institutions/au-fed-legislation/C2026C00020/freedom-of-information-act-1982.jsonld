        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Despite any restriction on the publication of the information or document under this Act.",
      "cml:conclusionText": "This allows publication of information or documents."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-3a-ss-2-logic-deontic-5",
