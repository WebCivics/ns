      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89h-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "held by: NaturalPerson"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89h-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRightTo",
      "cml:logicSummary": "Has right to seek reasons for decision not to give access to exempt document",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The certificate does not affect the Ombudsman’s right to:",
      "cml:conclusionText": "(a) seek from any person the reasons for a decision made under this Act not to give access to an exempt document"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89h-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRightTo",
      "cml:logicSummary": "Has right to require information or answer questions concerning decision",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The certificate does not affect the Ombudsman’s right to:",
      "cml:conclusionText": "(b) require any person to give any information or to answer any questions concerning the decision"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89j",
      "@type": "cml:Concept",
      "skos:prefLabel": "89J Complaints to Ombudsman—limitation on amending records in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.208",
      "values:originalText": "reports under the Ombudsman Act 1976\n(1) The Ombudsman may, in a report under section 15 of the\nOmbudsman Act 1976, recommend that an amendment be made to\na record that relates to a record of an opinion only if he or she is\nsatisfied of either (or both) of the following:\n(a) the opinion was based on a mistake of fact;\n(b) the author of the opinion was biased, unqualified to form the\nopinion or acted improperly in conducting the factual\ninquiries that led to the formation of the opinion.\n(2) The Ombudsman must not, in a report under section 15 of the\nOmbudsman Act 1976, recommend that an amendment be made to\na record if he or she is satisfied of either of the following:\n(a) the record is a record of a decision, under an enactment or a\nNorfolk Island law, by a court, tribunal, authority or person;\n(b) the decision whether to amend the record involves\ndetermination of a question that the person seeking\namendment of the record is, or has been, entitled to have\ndetermined by the agency (on internal review), the\nInformation Commissioner, a court or tribunal.\n\n\nMiscellaneous  Part VIII\nVexatious applicants  Division 1\nSection 89K\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "reports under the Ombudsman Act 1976\n(1) The Ombudsman may, in a report under section 15 of the\nOmbudsman Act 1976, recommend that an amendment be made to\na record that relates to a record of an opinion only if he or she is\nsatisfied of either (or both) of the following:\n(a) the opinion was based on a mistake of fact;\n(b) the author of the opinion was biased, unqualified to form the\nopinion or acted improperly in conducting the factual\ninquiries that led to the formation of the opinion.\n(2) The Ombudsman must not, in a report under section 15 of the\nOmbudsman Act 1976, recommend that an amendment be made to\na record if he or she is satisfied of either of the following:\n(a) the record is a record of a decision, under an enactment or a\nNorfolk Island law, by a court, tribunal, authority or person;\n(b) the decision whether to amend the record involves\ndetermination of a question that the person seeking\namendment of the record is, or has been, entitled to have\ndetermined by the agency (on internal review), the\nInformation Commissioner, a court or tribunal.\n\n\nMiscellaneous  Part VIII\nVexatious applicants  Division 1\nSection 89K\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89j-ss-1"
        },
