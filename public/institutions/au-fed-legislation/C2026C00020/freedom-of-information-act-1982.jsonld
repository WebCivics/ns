    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-78",
      "@type": "cml:Concept",
      "skos:prefLabel": "78 Information Commissioner investigations—places for which",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-78"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.195",
      "values:originalText": "approval required before entry\nSpecific places and areas\n(1) Subsection (2) applies if an authorised person proposes to enter, or\ncarry on an investigation, at any of the following:\n(b) a place that is a prohibited area for the purposes of the\nDefence (Special Undertakings) Act 1952 because of\nsection 7 of that Act;\n(c) an area of land or water or an area of land and water that is\ndeclared under section 14 of the Defence (Special\nUndertakings) Act 1952 to be a restricted area for the\npurposes of that Act.\n(2) If this subsection applies, the authorised person must not enter, or\ncarry on an investigation, unless:\n(a) the Minister administering that Act, or another Minister\nacting for and on behalf of the Minister, has, in writing,\napproved the entry or carrying on of the investigation; and\n(b) the authorised person complies with any conditions specified\nin the approval.",
      "skos:definition": "approval required before entry\nSpecific places and areas\n(1) Subsection (2) applies if an authorised person proposes to enter, or\ncarry on an investigation, at any of the following:\n(b) a place that is a prohibited area for the purposes of the\nDefence (Special Undertakings) Act 1952 because of\nsection 7 of that Act;\n(c) an area of land or water or an area of land and water that is\ndeclared under section 14 of the Defence (Special\nUndertakings) Act 1952 to be a restricted area for the\npurposes of that Act.\n(2) If this subsection applies, the authorised person must not enter, or\ncarry on an investigation, unless:\n(a) the Minister administering that Act, or another Minister\nacting for and on behalf of the Minister, has, in writing,\napproved the entry or carrying on of the investigation; and\n(b) the authorised person complies with any conditions specified\nin the approval.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-78-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-78-ss-2"
        }
      ],
      "cml:integrityHash": "ab2eff4fe7bb4d1091338384f4314829f07c105028f0185d5d6fc26193a40268"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-78",
      "@type": "cof:Section",
      "cof:title": "78 Information Commissioner investigations—places for which",
      "values:kind": "section",
      "cof:pageNumber": 195,
      "values:originalText": "approval required before entry\nSpecific places and areas\n(1) Subsection (2) applies if an authorised person proposes to enter, or\ncarry on an investigation, at any of the following:\n(b) a place that is a prohibited area for the purposes of the\nDefence (Special Undertakings) Act 1952 because of\nsection 7 of that Act;\n(c) an area of land or water or an area of land and water that is\ndeclared under section 14 of the Defence (Special\nUndertakings) Act 1952 to be a restricted area for the\npurposes of that Act.\n(2) If this subsection applies, the authorised person must not enter, or\ncarry on an investigation, unless:\n(a) the Minister administering that Act, or another Minister\nacting for and on behalf of the Minister, has, in writing,\napproved the entry or carrying on of the investigation; and\n(b) the authorised person complies with any conditions specified\nin the approval."
    },
