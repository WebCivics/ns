      "cml:premiseText": "The Tribunal's decision requires an amendment.",
      "cml:conclusionText": "The amendment must be made during the factual inquiries."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-58aa-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "58AA(2) Powers of Tribunal—limitation on amending records",
      "cml:realizedBy": {
