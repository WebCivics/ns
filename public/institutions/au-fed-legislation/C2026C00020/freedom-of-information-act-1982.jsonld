      "cml:integrityHash": "5e68105ccdd8185fb5a6f7860b2870f50ee11d5b367da8487df9cd1a1ef4a8e6",
      "skos:note": "Definition of personnel records"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-15a-ss-1",
