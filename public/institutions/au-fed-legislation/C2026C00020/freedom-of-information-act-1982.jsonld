      },
      "cml:premiseText": "The Freedom of Information Act 1982 has effect during the period commencing on the day after the day on which this Act receives Royal Assent.",
      "cml:conclusionText": "The Freedom of Information Act 1982 has effect from 22 October 1990 to an unspecified end date."
    },
