      ],
      "cml:integrityHash": "93395261c5de85350b9fb67c62e42219df510196549ed0523876ec32b5e41fcf",
      "skos:note": "Application under subsection (1) may not be made before the end of the time."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55p-ss-4",
