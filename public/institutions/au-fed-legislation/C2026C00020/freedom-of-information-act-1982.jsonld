    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-23-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(2) Decisions to be made by authorised persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-23-ss-2"
      },
      "cml:curationStatus": {
