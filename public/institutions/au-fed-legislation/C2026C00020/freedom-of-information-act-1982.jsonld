    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54j",
      "@type": "cml:Concept",
      "skos:prefLabel": "54J Key concepts—who is an IC review applicant?",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.128",
      "values:originalText": "An IC review applicant is a person who applies for an IC review\nunder section 54L or 54M.\nNote:\nIC review applicant is short for Information Commissioner review\napplicant.",
      "skos:definition": "An IC review applicant is a person who applies for an IC review\nunder section 54L or 54M.\nNote:\nIC review applicant is short for Information Commissioner review\napplicant.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54j-norm"
        }
      ],
      "cml:integrityHash": "2246f28c43298f831e10f53fd8a86227db40b17b181d5eee1f0db437e2c395a0",
      "skos:note": "Defines who is an IC review applicant."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54j",
      "@type": "cof:Section",
      "cof:title": "54J Key concepts—who is an IC review applicant?",
      "values:kind": "section",
      "cof:pageNumber": 128,
      "values:originalText": "An IC review applicant is a person who applies for an IC review\nunder section 54L or 54M.\nNote:\nIC review applicant is short for Information Commissioner review\napplicant."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54j-norm",
      "@type": "values:Obligation",
      "cml:modality": {
