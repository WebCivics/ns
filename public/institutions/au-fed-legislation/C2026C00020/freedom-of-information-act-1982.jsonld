    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-60-ss-2",
      "@type": "cof:Section",
      "cof:title": "60(2) Procedure in Tribunal—parties",
      "values:kind": "subsection",
      "cof:pageNumber": 171,
      "values:originalText": "(2) A decision given by a person on behalf of an agency is taken to\nhave been given by the agency."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-60-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
