      "cml:premiseText": "(2) The persons, bodies and Departments specified in Part II of Schedule 2 are exempt...",
      "cml:conclusionText": "The exemption is applicable during the period specified in Part II of Schedule 2."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-7-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Specifies the temporal interval during which the exemption applies.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
