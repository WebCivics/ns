      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54v",
      "@type": "cml:Concept",
      "skos:prefLabel": "54V Decision to review—preliminary inquiries",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.136",
      "values:originalText": "The Information Commissioner may make inquiries of the review\nparties for the purpose of determining whether or not to undertake\nan IC review.",
      "skos:definition": "The Information Commissioner may make inquiries of the review\nparties for the purpose of determining whether or not to undertake\nan IC review.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54v-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54v-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1a4fba79e707769bac664e7a74a805b7d83197a5239768e97400c96dcbc914c9",
      "skos:note": "Inquiries for IC review determination"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54v",
      "@type": "cof:Section",
      "cof:title": "54V Decision to review—preliminary inquiries",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "The Information Commissioner may make inquiries of the review\nparties for the purpose of determining whether or not to undertake\nan IC review."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54v-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54v"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54v-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Obligation to inquire",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Information Commissioner may make inquiries",
      "cml:conclusionText": "Duty to determine IC review"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54w",
      "@type": "cml:Concept",
      "skos:prefLabel": "54W Decision to review—discretion not to review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.136",
      "values:originalText": "The Information Commissioner may decide not to undertake an IC\nreview, or not to continue to undertake an IC review, if:\n(a) the Information Commissioner is satisfied of any of the\nfollowing:\n(i) the IC review application is frivolous, vexatious,\nmisconceived, lacking in substance or not made in good\nfaith;\n(ii) the IC review applicant has failed to cooperate in\nprogressing the IC review application, or the IC review,\nwithout reasonable excuse;\n(iii) the Information Commissioner cannot contact the IC\nreview applicant after making reasonable attempts; or\n(b) the Information Commissioner is satisfied that the interests of\nthe administration of this Act make it desirable that the IC\nreviewable decision be considered by the Tribunal; or\n(c) the IC review applicant fails to comply with a direction of the\nInformation Commissioner.\nNote 1:\nThe Information Commissioner may make a decision under this\nsection to review only part of an IC reviewable decision (see\nsection 54U).\n\n\nReview by Information Commissioner  Part VII\nDecision to review  Division 5\nSection 54X\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\nNote 2:\nIf the Information Commissioner makes a decision under\nparagraph (b), an application for review may be made to the Tribunal\nfor review of the IC reviewable decision (see section 57A).\nNote 3:\nDivision 1 of Part VIII sets out the circumstances in which a vexatious\napplicant declaration may be made in relation to a person. A\ndeclaration may permit the Information Commissioner to refuse to\nconsider an IC review application if the person makes the IC review\napplication under this section without the written permission of the\nInformation Commissioner.",
      "skos:definition": "The Information Commissioner may decide not to undertake an IC\nreview, or not to continue to undertake an IC review, if:\n(a) the Information Commissioner is satisfied of any of the\nfollowing:\n(i) the IC review application is frivolous, vexatious,\nmisconceived, lacking in substance or not made in good\nfaith;\n(ii) the IC review applicant has failed to cooperate in\nprogressing the IC review application, or the IC review,\nwithout reasonable excuse;\n(iii) the Information Commissioner cannot contact the IC\nreview applicant after making reasonable attempts; or\n(b) the Information Commissioner is satisfied that the interests of\nthe administration of this Act make it desirable that the IC\nreviewable decision be considered by the Tribunal; or\n(c) the IC review applicant fails to comply with a direction of the\nInformation Commissioner.\nNote 1:\nThe Information Commissioner may make a decision under this\nsection to review only part of an IC reviewable decision (see\nsection 54U).\n\n\nReview by Information Commissioner  Part VII\nDecision to review  Division 5\nSection 54X\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\nNote 2:\nIf the Information Commissioner makes a decision under\nparagraph (b), an application for review may be made to the Tribunal\nfor review of the IC reviewable decision (see section 57A).\nNote 3:\nDivision 1 of Part VIII sets out the circumstances in which a vexatious\napplicant declaration may be made in relation to a person. A\ndeclaration may permit the Information Commissioner to refuse to\nconsider an IC review application if the person makes the IC review\napplication under this section without the written permission of the\nInformation Commissioner.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54w-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54w-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54w-logic-deontic-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54w-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "8bb2bd64f7c4b9d9446172ef5e4c1b7fabd955a1aa8302f6adb63d9351055013",
      "skos:note": "Decision not to review IC review application under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54w",
      "@type": "cof:Section",
      "cof:title": "54W Decision to review—discretion not to review",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "The Information Commissioner may decide not to undertake an IC\nreview, or not to continue to undertake an IC review, if:\n(a) the Information Commissioner is satisfied of any of the\nfollowing:\n(i) the IC review application is frivolous, vexatious,\nmisconceived, lacking in substance or not made in good\nfaith;\n(ii) the IC review applicant has failed to cooperate in\nprogressing the IC review application, or the IC review,\nwithout reasonable excuse;\n(iii) the Information Commissioner cannot contact the IC\nreview applicant after making reasonable attempts; or\n(b) the Information Commissioner is satisfied that the interests of\nthe administration of this Act make it desirable that the IC\nreviewable decision be considered by the Tribunal; or\n(c) the IC review applicant fails to comply with a direction of the\nInformation Commissioner.\nNote 1:\nThe Information Commissioner may make a decision under this\nsection to review only part of an IC reviewable decision (see\nsection 54U).\n\n\nReview by Information Commissioner  Part VII\nDecision to review  Division 5\nSection 54X\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\nNote 2:\nIf the Information Commissioner makes a decision under\nparagraph (b), an application for review may be made to the Tribunal\nfor review of the IC reviewable decision (see section 57A).\nNote 3:\nDivision 1 of Part VIII sets out the circumstances in which a vexatious\napplicant declaration may be made in relation to a person. A\ndeclaration may permit the Information Commissioner to refuse to\nconsider an IC review application if the person makes the IC review\napplication under this section without the written permission of the\nInformation Commissioner."
    },
    {
