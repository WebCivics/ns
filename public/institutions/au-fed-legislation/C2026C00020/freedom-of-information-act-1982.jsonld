    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-77-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "77(6) Information Commissioner investigations—general power to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-77-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.194",
      "values:originalText": "(6) An authorised person is:\n(a) an information officer (within the meaning of the Australian\nInformation Commissioner Act 2010); or\n(b) an APS employee who:\n(i) is performing the duties of an Executive Level 2, or\nequivalent, position (or a higher position) in the Office\nof the Australian Information Commissioner; and\n(ii) is authorised by the Information Commissioner for the\npurposes of this section.",
      "skos:definition": "(6) An authorised person is:\n(a) an information officer (within the meaning of the Australian\nInformation Commissioner Act 2010); or\n(b) an APS employee who:\n(i) is performing the duties of an Executive Level 2, or\nequivalent, position (or a higher position) in the Office\nof the Australian Information Commissioner; and\n(ii) is authorised by the Information Commissioner for the\npurposes of this section.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-77"
      },
