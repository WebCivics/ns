      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-11c-ss-7-norm"
        }
      ],
      "cml:integrityHash": "7a43a72e75fa053551569a19a5202694b36a14468841cf35fa94b3b0f2a22490",
      "skos:note": "Definition of working day"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-11c-ss-7",
      "@type": "cof:Section",
      "cof:title": "11C(7) Publication of information in accessed documents",
      "values:kind": "subsection",
      "cof:pageNumber": 54,
      "values:originalText": "(7) In this section:\nworking day means a day that is not:\n(a) a Saturday; or\n(b) a Sunday; or\n(c) a public holiday in the place where the function of publishing\nthe information under this section is to be performed."
    },
