        }
      ],
      "cml:integrityHash": "bc10342738b0c38ad54d04e477205bd519f215ba865f94730e1f569fbb8a6203",
      "skos:note": "Respondent agency must comply with implementation notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89-ss-3",
      "@type": "cof:Section",
      "cof:title": "89(3) Information Commissioner investigations—failure to implement",
      "values:kind": "subsection",
      "cof:pageNumber": 202,
      "values:originalText": "(3) The respondent agency must comply with the implementation\nnotice.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89A\nFreedom of Information Act 1982\nCompilation date: 01/01/2026"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must comply",
      "cml:executionSurface": "modalities::logic::deontic",
