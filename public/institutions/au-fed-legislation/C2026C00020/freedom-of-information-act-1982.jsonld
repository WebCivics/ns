    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "89C(2) Information Commissioner investigations—ensuring",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89c-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.204",
      "values:originalText": "(2) The Information Commissioner must not include in the document:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89D\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "(2) The Information Commissioner must not include in the document:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89D\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c-ss-2-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d5821822a54ca5740dc9bf18512e6bd918fede7c7d243444cef0bcdb49b32af4",
      "skos:note": "Exempt matter and certain information types cannot be included in a document."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89c-ss-2",
      "@type": "cof:Section",
      "cof:title": "89C(2) Information Commissioner investigations—ensuring",
      "values:kind": "subsection",
      "cof:pageNumber": 204,
      "values:originalText": "(2) The Information Commissioner must not include in the document:\n(a) exempt matter; or\n(b) information of the kind referred to in subsection 25(1).\nNote:\nSubsection 25(1) deals with information about the existence or\notherwise of certain documents.\n\n\nInvestigations and complaints  Part VIIB\nInformation Commissioner investigations  Division 2\nSection 89D\nFreedom of Information Act 1982\nCompilation date: 01/01/2026"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89c-ss-2-norm",
      "@type": "values:Prohibition",
