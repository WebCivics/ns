        }
      ],
      "cml:integrityHash": "4394ce50ea873ace61778c16234efaeebb2cdd21e905dd01e82c39f93338b0b8",
      "skos:note": "Agency or Minister must have regard to guidelines issued by the Information Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-15-ss-5a",
      "@type": "cof:Section",
      "cof:title": "15(5A) Requests for access",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(5A) In making a decision on a request, the agency or Minister must\nhave regard to any guidelines issued by the Information\nCommissioner for the purposes of section 93A."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15-ss-5a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15-ss-5a"
      },
