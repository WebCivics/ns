      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "begins",
      "cml:logicSummary": "Commences on the specified date",
      "cml:executionSurface": "modalities::logic::deontic",
