      },
      "skos:scopeNote": "borne by: LegalPerson"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-49-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Application for amendment must be in writing.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
