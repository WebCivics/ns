        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "77842fae55d641f08932228b5484c33248e9d43834ed589aeadc8e1ea38f09fb",
      "skos:note": "Information Commissioner must prepare a copy of the report to give to the FOI Minister that excludes certain matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89a-ss-4",
      "@type": "cof:Section",
      "cof:title": "89A(4) Information Commissioner investigations—failure to take",
      "values:kind": "subsection",
      "cof:pageNumber": 203,
      "values:originalText": "(4) However, if the copy of the report would contain matters of the\nkind mentioned in subsection 89C(2), the Information\nCommissioner must prepare a copy of the report to give to the FOI\nMinister that excludes those matters."
    },
