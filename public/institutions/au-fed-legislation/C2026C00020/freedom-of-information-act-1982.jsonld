    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-8d-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "8D(5) Information to be published—how (and to whom) information is",
      "cml:realizedBy": {
