      "cml:integrityHash": "a79b077fe15db5efe8f904f3dbd65d107ecd92ea39ebb58488a5bc1a5aa30e11",
      "skos:note": "Information made publicly available by the Parliamentary Budget Officer is exempt from this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-45a-ss-5",
      "@type": "cof:Section",
      "cof:title": "45A(5) Parliamentary Budget Office documents",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(5) Information in a document to which subsection (1), (2) or (3)\napplies is not exempt matter because of this section if the\ninformation has been made publicly available by the Parliamentary\nBudget Officer:\n(a) under section 64U of the Parliamentary Service Act 1999; or\n(b) in a statement made under subsection 64V(4) of that Act."
    },
