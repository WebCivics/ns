        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(3A) Transfer of requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-16-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.64",
      "values:originalText": "(3A) Where:\n(a) a request is made to an agency for access to more than one\ndocument; and\n(b) one or more of those documents is a document to which\nsubsection (1), (2) or (3) applies;\nthis section applies to each of those documents as if separate\nrequests for access had been made to the agency in respect of each\nof those documents.",
      "skos:definition": "(3A) Where:\n(a) a request is made to an agency for access to more than one\ndocument; and\n(b) one or more of those documents is a document to which\nsubsection (1), (2) or (3) applies;\nthis section applies to each of those documents as if separate\nrequests for access had been made to the agency in respect of each\nof those documents.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-3a-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0cde0727756d4ab04e9e116c3bcec7f8a7b2e76ecac4b83f25e90f5c1d891d69",
      "skos:note": "Agency must provide access to documents subject to subsections (1), (2) or (3)",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-16-ss-3a",
      "@type": "cof:Section",
      "cof:title": "16(3A) Transfer of requests",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(3A) Where:\n(a) a request is made to an agency for access to more than one\ndocument; and\n(b) one or more of those documents is a document to which\nsubsection (1), (2) or (3) applies;\nthis section applies to each of those documents as if separate\nrequests for access had been made to the agency in respect of each\nof those documents."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-3a-norm",
      "@type": "values:Obligation",
