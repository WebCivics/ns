    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "89A(3) Information Commissioner investigations—failure to take",
      "cml:realizedBy": {
