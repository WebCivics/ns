        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-88-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "11d272468d4ae7493908c6fde1b493aada83f204bc2af4105c95bbef0170368b",
      "skos:note": "Investigation recommendations are formal recommendations to the respondent agency."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Information Commissioner investigations—what are the",
      "values:kind": "section",
      "cof:pageNumber": 202,
      "values:originalText": "investigation recommendations?\nThe investigation recommendations, in relation to the\ninvestigation, are the formal recommendations to the respondent\nagency that the Information Commissioner believes that the\nrespondent agency ought to implement."
    },
    {
