        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-82-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4a89af3718a3b806544be8ebb2116f49f0ea98911b956bf127ba19e3ccf54ffa",
      "skos:note": "Notice requirements for compliance with investigation",
      "dc:description": "Notice in writing, specifying time and place of compliance"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-82-ss-2",
      "@type": "cof:Section",
      "cof:title": "82(2) Information Commissioner investigations—obliging persons to",
      "values:kind": "subsection",
      "cof:pageNumber": 198,
      "values:originalText": "(2) The notice must:\n(a) be in writing; and\n(b) state that the person must comply with the notice at a\nspecified time that is not less than 14 days after the time at\nwhich the person is given the notice; and\n(c) specify the place at which the person must comply with the\nnotice.\nOffence for failure to comply"
    },
