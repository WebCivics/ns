      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Access must generally be given to a conditionally exempt document unless it would be contrary to the public interest"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47e-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
