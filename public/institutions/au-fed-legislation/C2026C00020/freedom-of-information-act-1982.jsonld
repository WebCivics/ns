    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "15AA Extension of time with agreement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-15aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.60",
      "values:originalText": "An agency or Minister may extend the period referred to in\nparagraph 15(5)(b) for dealing with a request, or that period as\nextended under subsection 15(6) or (8) (consultation), by a further\nperiod of no more than 30 days if:\n(a) the applicant agrees in writing to the extension; and\n\n\nAccess to documents  Part III\n\nSection 15AB\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(b) the agency or Minister gives written notice of the extension\nto the Information Commissioner as soon as practicable after\nthe agreement is made.",
      "skos:definition": "An agency or Minister may extend the period referred to in\nparagraph 15(5)(b) for dealing with a request, or that period as\nextended under subsection 15(6) or (8) (consultation), by a further\nperiod of no more than 30 days if:\n(a) the applicant agrees in writing to the extension; and\n\n\nAccess to documents  Part III\n\nSection 15AB\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(b) the agency or Minister gives written notice of the extension\nto the Information Commissioner as soon as practicable after\nthe agreement is made.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15aa-norm"
        }
      ],
      "cml:integrityHash": "83d765c7fc0b17c0a2137a2a2caa8dbff6d5d3236525ad37b2894efcdbf10a9e",
      "skos:note": "Extension of time with agreement for dealing with a request"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-15aa",
      "@type": "cof:Section",
      "cof:title": "15AA Extension of time with agreement",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "An agency or Minister may extend the period referred to in\nparagraph 15(5)(b) for dealing with a request, or that period as\nextended under subsection 15(6) or (8) (consultation), by a further\nperiod of no more than 30 days if:\n(a) the applicant agrees in writing to the extension; and\n\n\nAccess to documents  Part III\n\nSection 15AB\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(b) the agency or Minister gives written notice of the extension\nto the Information Commissioner as soon as practicable after\nthe agreement is made."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15aa-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
