    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Information Commissioner investigations—what are the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-88"
      },
      "cml:curationStatus": {
