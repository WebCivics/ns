      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Describes the temporal relationship between the request and the corresponding department.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) to the Department corresponding to the Department of State administered by the Minister who administers the enactment by or under which the body or person is established, continued in existence or appointed;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Describes the temporal relationship between the request and the corresponding department.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) if the request relates to a document that originated with, or has been received from, a part of the Department of Defence specified in Division 2 of Part I of Schedule 2—to that Department;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Grants permission to transfer the request.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Where a request is made to an agency for access to a document that: (a) originated with, or has been received from, a body which, or person who, is specified in Part I of Schedule 2; and (b) is more closely connected with the functions of that body or person than with those of the agency to which the request is made;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Describes the implication of transferring the request.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
