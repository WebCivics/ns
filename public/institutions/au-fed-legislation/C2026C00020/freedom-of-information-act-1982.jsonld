    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55h-ss-1",
      "@type": "cof:Section",
      "cof:title": "55H(1) Procedure in IC review—reference of questions of law to",
      "values:kind": "subsection",
      "cof:pageNumber": 145,
      "values:originalText": "(1) The Information Commissioner may, at any time during an IC\nreview, refer a question of law arising in an IC review to the\nFederal Court of Australia for decision."
    },
