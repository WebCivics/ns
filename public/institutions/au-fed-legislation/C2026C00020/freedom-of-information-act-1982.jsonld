      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prevents action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No further time can be allowed",
      "cml:conclusionText": "Action is prohibited"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54e",
      "@type": "cml:Concept",
      "skos:prefLabel": "54E Internal review—decisions to which this Part does not apply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.125",
      "values:originalText": "This Part does not apply in relation to:\n(a) a decision on internal review; or\n(b) a decision in relation to the provision of access to a document\nupon a request that is taken to have been made under\nsection 15AC or 51DA.",
      "skos:definition": "This Part does not apply in relation to:\n(a) a decision on internal review; or\n(b) a decision in relation to the provision of access to a document\nupon a request that is taken to have been made under\nsection 15AC or 51DA.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54e-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bd19c9c002b29fcf339ccefbb6ec568717fa0b67c37451c4f94920cbbd950be8",
      "skos:note": "Exemptions from internal review"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54e",
      "@type": "cof:Section",
      "cof:title": "54E Internal review—decisions to which this Part does not apply",
      "values:kind": "section",
      "cof:pageNumber": 125,
      "values:originalText": "This Part does not apply in relation to:\n(a) a decision on internal review; or\n(b) a decision in relation to the provision of access to a document\nupon a request that is taken to have been made under\nsection 15AC or 51DA."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54e-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54e"
