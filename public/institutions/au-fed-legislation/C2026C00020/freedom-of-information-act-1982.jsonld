    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54p-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
