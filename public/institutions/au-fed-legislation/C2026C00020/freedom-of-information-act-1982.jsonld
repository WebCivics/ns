    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51d-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "51D(3) Notification etc. of a decision under this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51d-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.115",
      "values:originalText": "(3) Section 26 applies in relation to a decision made under this\nPart refusing to amend or annotate a record as if that decision were\na decision made under Part III refusing to grant access to a\ndocument in accordance with a request made under\nsubsection 15(1).",
      "skos:definition": "(3) Section 26 applies in relation to a decision made under this\nPart refusing to amend or annotate a record as if that decision were\na decision made under Part III refusing to grant access to a\ndocument in accordance with a request made under\nsubsection 15(1).",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51d"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51d-ss-3-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51d-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7501deab7729d02d3f3352fc6f69c3ff0e77a11b0bccbe77d57b4333afefb1c1",
      "skos:note": "Notification of a decision under this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51d-ss-3",
      "@type": "cof:Section",
      "cof:title": "51D(3) Notification etc. of a decision under this Part",
      "values:kind": "subsection",
      "cof:pageNumber": 115,
      "values:originalText": "(3) Section 26 applies in relation to a decision made under this\nPart refusing to amend or annotate a record as if that decision were\na decision made under Part III refusing to grant access to a\ndocument in accordance with a request made under\nsubsection 15(1)."
    },
    {
