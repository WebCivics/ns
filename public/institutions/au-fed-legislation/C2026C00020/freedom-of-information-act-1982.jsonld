      },
      "cml:premiseText": "The person taking the oath or affirmation",
      "cml:conclusionText": "Must provide true answers"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Oath or affirmation is a temporal interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The statement must be made by the person taking the oath or affirmation",
      "cml:conclusionText": "Is within the interval of true statements"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Oath or affirmation implies truth-telling",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person taking the oath or affirmation",
      "cml:conclusionText": "Must provide true answers"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "83(3) Information Commissioner investigations—administration of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-83-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.199",
      "values:originalText": "(3) A person commits an offence if:\n(a) the person is required under this section to be examined on\noath or affirmation; and\n(b) the person engages in conduct; and\n(c) the person’s conduct breaches that requirement.\nPenalty for a contravention of this subsection:\n6 months\nimprisonment.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.",
      "skos:definition": "(3) A person commits an offence if:\n(a) the person is required under this section to be examined on\noath or affirmation; and\n(b) the person engages in conduct; and\n(c) the person’s conduct breaches that requirement.\nPenalty for a contravention of this subsection:\n6 months\nimprisonment.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-alleninterval-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-ltl-4"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "77c9fe721eba3251c0f94d3558b76093ac075140074b4b118ec135c4f06f7612",
      "skos:note": "Failure to comply with oath or affirmation requirement is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-83-ss-3",
      "@type": "cof:Section",
      "cof:title": "83(3) Information Commissioner investigations—administration of",
      "values:kind": "subsection",
      "cof:pageNumber": 199,
      "values:originalText": "(3) A person commits an offence if:\n(a) the person is required under this section to be examined on\noath or affirmation; and\n(b) the person engages in conduct; and\n(c) the person’s conduct breaches that requirement.\nPenalty for a contravention of this subsection:\n6 months\nimprisonment.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to comply with oath or affirmation requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is required under this section to be examined on oath or affirmation.",
      "cml:conclusionText": "The person commits an offence if the person engages in conduct that breaches that requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Conduct that breaches the oath or affirmation requirement is prohibited.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person's conduct breaches that requirement.",
      "cml:conclusionText": "Penalty for a contravention of this subsection: 6 months imprisonment."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Temporal relation between the requirement and the breach.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person commits an offence if:\n(a) the person is required under this section to be examined on oath or affirmation;\n(b) the person engages in conduct;\n(c) the person’s conduct breaches that requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Recurring trace of the offence.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person commits an offence if:\n(a) the person is required under this section to be examined on oath or affirmation;\n(b) the person engages in conduct;\n(c) the person’s conduct breaches that requirement."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-83-ss-3-logic-deontic-5",
