    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55n",
      "@type": "cml:Concept",
      "skos:prefLabel": "55N Decision on IC review—obligation to comply with decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55n"
      },
      "cml:curationStatus": {
