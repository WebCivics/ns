    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55zd-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "55ZD(5) Evidence by Inspector-General of Intelligence and Security—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55zd-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.160",
      "values:originalText": "(5) After the period that is reasonably necessary for the purposes of\ngiving evidence to the Information Commissioner, the\nInspector-General must:\n(a) return the original of any document to the Information\nCommissioner or to the agency or Minister; and\n(b) destroy any copies of or extracts taken from any document.",
      "skos:definition": "(5) After the period that is reasonably necessary for the purposes of\ngiving evidence to the Information Commissioner, the\nInspector-General must:\n(a) return the original of any document to the Information\nCommissioner or to the agency or Minister; and\n(b) destroy any copies of or extracts taken from any document.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55zd"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55zd-ss-5-norm"
        },
        {
