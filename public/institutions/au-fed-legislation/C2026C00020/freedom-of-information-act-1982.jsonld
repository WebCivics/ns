    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-8f",
      "@type": "cml:Concept",
      "skos:prefLabel": "8F Review of scheme—Information Commissioner functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-8f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.47",
      "values:originalText": "The Information Commissioner has the following functions (as\nconferred by this Act and the Australian Information\nCommissioner Act 2010, but without limiting any provision of\neither Act):\n(a) reviewing the operation in each agency of the information\npublication scheme established by this Part, in conjunction\nwith the agency;\n(b) investigating an agency’s compliance with this Part under\nDivision 2 of Part VIIB (Information Commissioner\ninvestigations);\n(c) otherwise monitoring, investigating and reporting on the\noperation of the scheme.",
      "skos:definition": "The Information Commissioner has the following functions (as\nconferred by this Act and the Australian Information\nCommissioner Act 2010, but without limiting any provision of\neither Act):\n(a) reviewing the operation in each agency of the information\npublication scheme established by this Part, in conjunction\nwith the agency;\n(b) investigating an agency’s compliance with this Part under\nDivision 2 of Part VIIB (Information Commissioner\ninvestigations);\n(c) otherwise monitoring, investigating and reporting on the\noperation of the scheme.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-8f-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-8f-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eef5cc07cdf11dfbfe75a40d5b76c086748f2a7953fe49b02ba39ca13317dd61",
      "skos:note": "The Information Commissioner has functions to review and monitor the operation of the information publication scheme."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-8f",
      "@type": "cof:Section",
      "cof:title": "8F Review of scheme—Information Commissioner functions",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "The Information Commissioner has the following functions (as\nconferred by this Act and the Australian Information\nCommissioner Act 2010, but without limiting any provision of\neither Act):\n(a) reviewing the operation in each agency of the information\npublication scheme established by this Part, in conjunction\nwith the agency;\n(b) investigating an agency’s compliance with this Part under\nDivision 2 of Part VIIB (Information Commissioner\ninvestigations);\n(c) otherwise monitoring, investigating and reporting on the\noperation of the scheme."
    },
