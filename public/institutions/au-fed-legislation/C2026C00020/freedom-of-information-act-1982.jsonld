      },
      "cml:premiseText": "Electoral Act means the Commonwealth Electoral Act 1918.",
      "cml:conclusionText": "electoral roll means:\n(a) a Roll of the electors of:\n(i) a State or Territory; or\n(ii) a Division (within the meaning of the Electoral Act); or\n(iii) a Subdivision (within the meaning of the Electoral Act);\nprepared under the Electoral Act;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47a-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy",
      "cml:executionSurface": "modalities::dl",
