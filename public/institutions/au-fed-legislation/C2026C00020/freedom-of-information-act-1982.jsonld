    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-9a",
      "@type": "cml:Concept",
      "skos:prefLabel": "9A Functions and powers under this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-9a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.48",
      "values:originalText": "In performing a function, or exercising a power, under this Part, an\nagency must have regard to:\n(a) the objects of this Act (including all the matters set out in\nsections 3 and 3A); and\n(b) guidelines issued by the Information Commissioner for the\npurposes of this paragraph under section 93A.\n\n\nInformation publication scheme  Part II\nMiscellaneous  Division 5\nSection 10\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "In performing a function, or exercising a power, under this Part, an\nagency must have regard to:\n(a) the objects of this Act (including all the matters set out in\nsections 3 and 3A); and\n(b) guidelines issued by the Information Commissioner for the\npurposes of this paragraph under section 93A.\n\n\nInformation publication scheme  Part II\nMiscellaneous  Division 5\nSection 10\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "cml:asserts": [
        {
