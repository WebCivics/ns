      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-71",
      "@type": "cml:Concept",
      "skos:prefLabel": "71 Information Commissioner investigations—interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-71"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.190",
      "values:originalText": "This Subdivision applies to a part of a complaint as if:\n(a) a reference to a complaint were a reference to the part of the\ncomplaint; and\n(b) a reference to an action were a reference to an action to\nwhich the part of the complaint relates.",
      "skos:definition": "This Subdivision applies to a part of a complaint as if:\n(a) a reference to a complaint were a reference to the part of the\ncomplaint; and\n(b) a reference to an action were a reference to an action to\nwhich the part of the complaint relates.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-71-norm"
        }
      ],
      "cml:integrityHash": "f0b0492050369f54f8d8c441e56bdacd18c652307587e9cd5e8478b5fd265ce7",
      "skos:note": "Interpretation of Subdivision application to part of a complaint"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-71",
      "@type": "cof:Section",
      "cof:title": "71 Information Commissioner investigations—interpretation",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "This Subdivision applies to a part of a complaint as if:\n(a) a reference to a complaint were a reference to the part of the\ncomplaint; and\n(b) a reference to an action were a reference to an action to\nwhich the part of the complaint relates."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-71-norm",
