    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89b",
      "@type": "cml:Concept",
      "skos:prefLabel": "89B Information Commissioner investigations—requirements for",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.204",
      "values:originalText": "report\nA report under subsection 89A(2) must:\n(a) include a copy of the notice given to the respondent agency\nunder subsection 86(2) (notice on completion) and the\nimplementation notice; and\n(b) give details of the respondent agency’s response (if any) to\nthe implementation notice; and\n(c) state that the Information Commissioner is not satisfied that\nthe agency has taken action that is adequate and appropriate\nin the circumstances to implement the investigation\nrecommendations for the investigation; and\n(d) state the action that the Information Commissioner believes,\nif taken by the agency, would be adequate and appropriate in\nthe circumstances to implement the investigation\nrecommendations for the investigation.",
      "skos:definition": "report\nA report under subsection 89A(2) must:\n(a) include a copy of the notice given to the respondent agency\nunder subsection 86(2) (notice on completion) and the\nimplementation notice; and\n(b) give details of the respondent agency’s response (if any) to\nthe implementation notice; and\n(c) state that the Information Commissioner is not satisfied that\nthe agency has taken action that is adequate and appropriate\nin the circumstances to implement the investigation\nrecommendations for the investigation; and\n(d) state the action that the Information Commissioner believes,\nif taken by the agency, would be adequate and appropriate in\nthe circumstances to implement the investigation\nrecommendations for the investigation.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89b-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "759b877ede2cc7d8a60014ac9d1218e70a4c829a82b57057afead967964924f5",
      "skos:note": "Agency must provide report with details of response to implementation notice and proposed action.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89b",
      "@type": "cof:Section",
      "cof:title": "89B Information Commissioner investigations—requirements for",
      "values:kind": "section",
      "cof:pageNumber": 204,
      "values:originalText": "report\nA report under subsection 89A(2) must:\n(a) include a copy of the notice given to the respondent agency\nunder subsection 86(2) (notice on completion) and the\nimplementation notice; and\n(b) give details of the respondent agency’s response (if any) to\nthe implementation notice; and\n(c) state that the Information Commissioner is not satisfied that\nthe agency has taken action that is adequate and appropriate\nin the circumstances to implement the investigation\nrecommendations for the investigation; and\n(d) state the action that the Information Commissioner believes,\nif taken by the agency, would be adequate and appropriate in\nthe circumstances to implement the investigation\nrecommendations for the investigation."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89b-logic-deontic-1",
