    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-23-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to process documents within reasonable resource limits.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Request for document processing must satisfy certain conditions.",
      "cml:conclusionText": "Diversion of resources is prohibited."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-23-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Processing request may overlap with other agency operations.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The work involved in processing the request would substantially and unreasonably divert the resources of the agency from its other operations.",
      "cml:conclusionText": "Request processing must not conflict with other agency activities."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-23-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "Request for document processing is a recurring activity.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The request does not satisfy the requirement in paragraph 15(2)(b) (identification of documents).",
      "cml:conclusionText": "Request must be processed regularly to meet specified criteria."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-23-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Minister's functions may be interfered with by request processing.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The work involved in processing the request would substantially and unreasonably interfere with the performance of the Minister’s functions.",
      "cml:conclusionText": "Request processing must not conflict with Minister's duties."
    },
    {
