    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Part not to apply to certain documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-12"
