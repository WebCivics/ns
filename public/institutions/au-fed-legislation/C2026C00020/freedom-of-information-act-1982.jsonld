      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.49",
      "values:originalText": "(1) This section applies if:\n(a) part (or all) of an agency’s operational information (the\nunpublished information), in relation to a function or power\nof the agency, is not published by the agency in accordance\nwith this Part; and\n(b) a person engages in conduct relevant to the performance of\nthe function or the exercise of the power; and\n(c) at the time of engaging in that conduct:\n(i) the person was not aware of the unpublished\ninformation; and\n(ii) the agency had been in existence for more than 12\nmonths.\nNote:\nAn agency’s operational information is required to be published by the\nagency (see sections 8 and 8A).\nNo prejudice from lack of awareness of unpublished information",
      "skos:definition": "(1) This section applies if:\n(a) part (or all) of an agency’s operational information (the\nunpublished information), in relation to a function or power\nof the agency, is not published by the agency in accordance\nwith this Part; and\n(b) a person engages in conduct relevant to the performance of\nthe function or the exercise of the power; and\n(c) at the time of engaging in that conduct:\n(i) the person was not aware of the unpublished\ninformation; and\n(ii) the agency had been in existence for more than 12\nmonths.\nNote:\nAn agency’s operational information is required to be published by the\nagency (see sections 8 and 8A).\nNo prejudice from lack of awareness of unpublished information",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10-ss-1-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b1ae2f95f92a5ed0b22878f9384b3761a53392f14cedf0b665e15e6e6861e740",
      "skos:note": "Agency must publish operational information if it has existed for more than 12 months."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-10-ss-1",
      "@type": "cof:Section",
      "cof:title": "10(1) Unpublished operational information",
      "values:kind": "subsection",
      "cof:pageNumber": 49,
      "values:originalText": "(1) This section applies if:\n(a) part (or all) of an agency’s operational information (the\nunpublished information), in relation to a function or power\nof the agency, is not published by the agency in accordance\nwith this Part; and\n(b) a person engages in conduct relevant to the performance of\nthe function or the exercise of the power; and\n(c) at the time of engaging in that conduct:\n(i) the person was not aware of the unpublished\ninformation; and\n(ii) the agency had been in existence for more than 12\nmonths.\nNote:\nAn agency’s operational information is required to be published by the\nagency (see sections 8 and 8A).\nNo prejudice from lack of awareness of unpublished information"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10-ss-1-logic-deontic-1",
