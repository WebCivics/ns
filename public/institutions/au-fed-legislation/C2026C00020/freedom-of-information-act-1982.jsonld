      "cml:operator": "hasPossession",
      "cml:logicSummary": "Agency has possession of document",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
