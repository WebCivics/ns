      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51da-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Agency has a duty to make a decision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Application received within 30 days.",
      "cml:conclusionText": "Decision made on application."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51e",
      "@type": "cml:Concept",
      "skos:prefLabel": "51E Comments on annotations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.117",
      "values:originalText": "Nothing in this Part prevents an agency or Minister adding the\nagency’s or Minister’s comments to an annotation made to a record\nof information under section 51 or 51B.",
      "skos:definition": "Nothing in this Part prevents an agency or Minister adding the\nagency’s or Minister’s comments to an annotation made to a record\nof information under section 51 or 51B.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51e-norm"
        }
      ],
      "cml:integrityHash": "f1b4cb6f150e105f563bf27cc80c9e3e71dc3db4d896b02a040d68916e61ab76",
      "skos:note": "Agency or Minister may add comments to annotations."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51e",
      "@type": "cof:Section",
      "cof:title": "51E Comments on annotations",
      "values:kind": "section",
      "cof:pageNumber": 117,
      "values:originalText": "Nothing in this Part prevents an agency or Minister adding the\nagency’s or Minister’s comments to an annotation made to a record\nof information under section 51 or 51B."
    },
