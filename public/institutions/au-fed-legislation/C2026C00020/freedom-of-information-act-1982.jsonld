    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-16a",
      "@type": "cml:Concept",
      "skos:prefLabel": "16A Requests transferred from the ACT",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-16a"
      },
      "cml:curationStatus": {
