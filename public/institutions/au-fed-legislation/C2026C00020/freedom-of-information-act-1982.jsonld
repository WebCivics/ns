    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54t-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "54T(5) IC review applications—extension of time",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54t-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.134",
      "values:originalText": "(5) A person to whom notice is given under subsection (4) may notify\nthe Information Commissioner in writing that he or she opposes the\napplication under subsection (1). The person must do so within the\ntime required by the Information Commissioner.\nReasonable opportunity to be heard",
      "skos:definition": "(5) A person to whom notice is given under subsection (4) may notify\nthe Information Commissioner in writing that he or she opposes the\napplication under subsection (1). The person must do so within the\ntime required by the Information Commissioner.\nReasonable opportunity to be heard",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54t"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54t-ss-5-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54t-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d10a9c7d5ff80bbf93a304204bfcd17984e14ed405b060bc02a1d78a207a62cc",
      "skos:note": "Must notify the Information Commissioner within a time limit",
      "dc:description": "Reasonable opportunity to be heard"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54t-ss-5",
      "@type": "cof:Section",
      "cof:title": "54T(5) IC review applications—extension of time",
      "values:kind": "subsection",
      "cof:pageNumber": 134,
      "values:originalText": "(5) A person to whom notice is given under subsection (4) may notify\nthe Information Commissioner in writing that he or she opposes the\napplication under subsection (1). The person must do so within the\ntime required by the Information Commissioner.\nReasonable opportunity to be heard"
    },
