    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-8-ss-5",
      "@type": "cof:Section",
      "cof:title": "8(5) Information to be published—what information?",
      "values:kind": "subsection",
