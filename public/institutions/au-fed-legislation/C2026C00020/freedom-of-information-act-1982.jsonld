        }
      ],
      "cml:integrityHash": "34ac9789482b89d515ca99dde50c9a601017dfcf867d7b00c78eaf07c1a44386",
      "skos:note": "May appear in person or be represented by another person"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55c",
      "@type": "cof:Section",
      "cof:title": "55C Procedure in IC review—representation",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "At the hearing of a proceeding before the Information\nCommissioner, a review party may:\n(a) appear in person; or\n(b) be represented by another person."
    },
