      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89k-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide written notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l",
      "@type": "cml:Concept",
      "skos:prefLabel": "89L Vexatious applicants—grounds for declaration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.209",
      "values:originalText": "(1) The Information Commissioner may make a vexatious applicant\ndeclaration in relation to a person only if the Information\nCommissioner is satisfied of any of the following:\n(a) that:\n(i) the person has repeatedly engaged in access actions; and\n(ii) the repeated engagement involves an abuse of the\nprocess for the access action;",
      "skos:definition": "(1) The Information Commissioner may make a vexatious applicant\ndeclaration in relation to a person only if the Information\nCommissioner is satisfied of any of the following:\n(a) that:\n(i) the person has repeatedly engaged in access actions; and\n(ii) the repeated engagement involves an abuse of the\nprocess for the access action;",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "557814e7e254421b9c2c3ae4e7d55fc5c1bf55e52d50c5be8477e1e4fcd2c258",
      "skos:note": "The Information Commissioner may make a declaration if the person has repeatedly engaged in access actions and abuses the process."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89l",
      "@type": "cof:Section",
      "cof:title": "89L Vexatious applicants—grounds for declaration",
      "values:kind": "section",
      "cof:pageNumber": 209,
      "values:originalText": "(1) The Information Commissioner may make a vexatious applicant\ndeclaration in relation to a person only if the Information\nCommissioner is satisfied of any of the following:\n(a) that:\n(i) the person has repeatedly engaged in access actions; and\n(ii) the repeated engagement involves an abuse of the\nprocess for the access action;"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89l-norm",
      "@type": "values:Obligation",
      "cml:modality": {
