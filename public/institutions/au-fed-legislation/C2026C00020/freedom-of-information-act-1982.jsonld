      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47a-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Lists specific examples of exempt documents",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document is an electoral roll; or a print, or a copy of a print, of an electoral roll; or...",
      "cml:conclusionText": "or any other document that meets these criteria"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-47a-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
