        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54g",
      "@type": "cml:Concept",
      "skos:prefLabel": "54G Key concepts—what is an IC review?",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.128",
      "values:originalText": "An IC review is a review of an IC reviewable decision undertaken\nby the Information Commissioner under this Part.\nNote:\nIC review is short for Information Commissioner review.",
      "skos:definition": "An IC review is a review of an IC reviewable decision undertaken\nby the Information Commissioner under this Part.\nNote:\nIC review is short for Information Commissioner review.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54g-norm"
        }
      ],
      "cml:integrityHash": "5f52ea4e574662f188c248c547981e03dc98dab911315f9899c6de7adb2afdc7",
      "skos:note": "Defines IC review and its meaning."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54g",
      "@type": "cof:Section",
      "cof:title": "54G Key concepts—what is an IC review?",
      "values:kind": "section",
      "cof:pageNumber": 128,
      "values:originalText": "An IC review is a review of an IC reviewable decision undertaken\nby the Information Commissioner under this Part.\nNote:\nIC review is short for Information Commissioner review."
    },
