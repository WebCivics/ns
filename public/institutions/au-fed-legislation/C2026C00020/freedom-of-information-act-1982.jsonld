    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Review by the Tribunal—guide",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.165",
      "values:originalText": "An application may be made to the Administrative Review\nTribunal for the review of certain decisions (see section 57A).\nDivision 3 sets out the powers of the Tribunal in a review.\nDivision 4 deals with the procedure to be followed in a review by\nthe Tribunal.\nDivision 5 deals with ensuring that exempt matter that comes\nbefore the Tribunal is protected from disclosure.\nDivision 6 deals with the circumstances in which the Tribunal may\nmake recommendations as to costs.\nDivision 7 deals with the stay of decisions pending appeal to the\nFederal Court of Australia.",
      "skos:definition": "An application may be made to the Administrative Review\nTribunal for the review of certain decisions (see section 57A).\nDivision 3 sets out the powers of the Tribunal in a review.\nDivision 4 deals with the procedure to be followed in a review by\nthe Tribunal.\nDivision 5 deals with ensuring that exempt matter that comes\nbefore the Tribunal is protected from disclosure.\nDivision 6 deals with the circumstances in which the Tribunal may\nmake recommendations as to costs.\nDivision 7 deals with the stay of decisions pending appeal to the\nFederal Court of Australia.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57-logic-deontic-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57-logic-alleninterval-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57-logic-ltl-3"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "88c617793762b495b216efc72dc9f9beced26378746534fef94dc07678c1b0be",
      "skos:note": "Application for review by the Administrative Review Tribunal"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Review by the Tribunal—guide",
      "values:kind": "section",
      "cof:pageNumber": 165,
      "values:originalText": "An application may be made to the Administrative Review\nTribunal for the review of certain decisions (see section 57A).\nDivision 3 sets out the powers of the Tribunal in a review.\nDivision 4 deals with the procedure to be followed in a review by\nthe Tribunal.\nDivision 5 deals with ensuring that exempt matter that comes\nbefore the Tribunal is protected from disclosure.\nDivision 6 deals with the circumstances in which the Tribunal may\nmake recommendations as to costs.\nDivision 7 deals with the stay of decisions pending appeal to the\nFederal Court of Australia."
    },
