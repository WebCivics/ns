        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act commences on the day after the day on which this Act receives Royal Assent.",
      "cml:conclusionText": "Freedom of Information Act 1982 commences on 22 October 1990."
    },
    {
