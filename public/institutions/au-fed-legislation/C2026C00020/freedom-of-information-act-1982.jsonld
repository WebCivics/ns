      "skos:note": "Must comply with decision on IC review"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55n",
      "@type": "cof:Section",
      "cof:title": "55N Decision on IC review—obligation to comply with decision",
      "values:kind": "section",
      "cof:pageNumber": 149,
      "values:originalText": "A principal officer of an agency or a Minister must comply with a\ndecision of the Information Commissioner under section 55K on an\nIC review."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55n-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
