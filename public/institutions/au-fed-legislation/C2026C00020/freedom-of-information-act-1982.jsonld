      ],
      "cml:integrityHash": "f9f3bfb66cc5a55498ad6aee7cd4b35d0ab632bc854451fe6e961504c43dae3f",
      "skos:note": "The Parliament does not intend to limit or prevent the exercise of its power."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-3a-ss-2",
      "@type": "cof:Section",
