    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55k-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "55K(5) Decision on IC review—decision of Information Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55k-ss-5"
