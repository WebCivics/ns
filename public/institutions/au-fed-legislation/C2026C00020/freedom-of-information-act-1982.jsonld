    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-8c-ss-3",
      "@type": "cof:Section",
      "cof:title": "8C(3) Information to be published—restrictions",
      "values:kind": "subsection",
