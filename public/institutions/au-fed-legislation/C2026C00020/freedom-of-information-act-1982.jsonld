      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection 25(1) deals with information about the existence or otherwise of certain documents.",
      "cml:conclusionText": "Report must not include exempt matter or information about certain documents"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Reports must not include exempt matter during a specific time period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection 25(1) deals with information about the existence or otherwise of certain documents.",
      "cml:conclusionText": "Exempt matter overlaps with reports during a specific time period"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Reports must not include exempt matter in recurring reports to the Ombudsman",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection 25(1) deals with information about the existence or otherwise of certain documents.",
      "cml:conclusionText": "Exempt matter is recurring in reports to the Ombudsman"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Infects",
      "cml:logicSummary": "Reports must not include exempt matter that infects other reports",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection 25(1) deals with information about the existence or otherwise of certain documents.",
      "cml:conclusionText": "Exempt matter infects other reports"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89g-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classifies",
      "cml:logicSummary": "Reports must not include exempt matter that is classified as such",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection 25(1) deals with information about the existence or otherwise of certain documents.",
      "cml:conclusionText": "Exempt matter is classified as such in reports"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89h",
      "@type": "cml:Concept",
      "skos:prefLabel": "89H Complaints to Ombudsman—certain rights not affected by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.207",
      "values:originalText": "certificates\n(1) This section applies if:\n(a) the Ombudsman has commenced an investigation of a\ndecision made under this Act not to grant a request for access\nto a document; and\n(b) the Attorney-General furnishes a certificate to the\nOmbudsman under paragraph 9(3)(a), (c) or (d) of the\nOmbudsman Act 1976 in relation to that investigation.\n(2) The certificate does not affect the Ombudsman’s right to:\n(a) seek from any person the reasons for a decision made under\nthis Act not to give access to an exempt document; or\n(b) require any person to give any information or to answer any\nquestions concerning the decision.",
      "skos:definition": "certificates\n(1) This section applies if:\n(a) the Ombudsman has commenced an investigation of a\ndecision made under this Act not to grant a request for access\nto a document; and\n(b) the Attorney-General furnishes a certificate to the\nOmbudsman under paragraph 9(3)(a), (c) or (d) of the\nOmbudsman Act 1976 in relation to that investigation.\n(2) The certificate does not affect the Ombudsman’s right to:\n(a) seek from any person the reasons for a decision made under\nthis Act not to give access to an exempt document; or\n(b) require any person to give any information or to answer any\nquestions concerning the decision.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89h-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89h-ss-2"
        }
      ],
      "cml:integrityHash": "f78c06aa55a0e2d18b5653884184079a5e77f231af10d7cbdc121b5cb40ef187"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89h",
      "@type": "cof:Section",
      "cof:title": "89H Complaints to Ombudsman—certain rights not affected by",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "certificates\n(1) This section applies if:\n(a) the Ombudsman has commenced an investigation of a\ndecision made under this Act not to grant a request for access\nto a document; and\n(b) the Attorney-General furnishes a certificate to the\nOmbudsman under paragraph 9(3)(a), (c) or (d) of the\nOmbudsman Act 1976 in relation to that investigation.\n(2) The certificate does not affect the Ombudsman’s right to:\n(a) seek from any person the reasons for a decision made under\nthis Act not to give access to an exempt document; or\n(b) require any person to give any information or to answer any\nquestions concerning the decision."
    },
