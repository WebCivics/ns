      "cml:premiseText": "The person is required under this section to be examined on oath or affirmation."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-84",
      "@type": "cml:Concept",
      "skos:prefLabel": "84 Information Commissioner investigations—no loss of legal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-84"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.200",
      "values:originalText": "professional privilege\nInformation or a document does not cease to be the subject of legal\nprofessional privilege merely because it is given, provided,\nproduced or referred to for the purposes of this Part.",
      "skos:definition": "professional privilege\nInformation or a document does not cease to be the subject of legal\nprofessional privilege merely because it is given, provided,\nproduced or referred to for the purposes of this Part.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-84-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-84-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6b74a24ab203d76b5a190d9ff87818a3769e097d82851ae2e967a144c281d8e7",
      "skos:note": "No loss of legal professional privilege"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-84",
      "@type": "cof:Section",
      "cof:title": "84 Information Commissioner investigations—no loss of legal",
      "values:kind": "section",
      "cof:pageNumber": 200,
      "values:originalText": "professional privilege\nInformation or a document does not cease to be the subject of legal\nprofessional privilege merely because it is given, provided,\nproduced or referred to for the purposes of this Part."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-84-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
