    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55v",
      "@type": "cml:Concept",
      "skos:prefLabel": "55V Information gathering powers—further searches for a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-55v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.155",
      "values:originalText": "document\n(1) This section applies to an IC review in relation to a request for\naccess to a document if:\n(a) access to the document is refused under section 24A\n(document cannot be found etc.); or\n(b) access is purportedly given to the document (amongst others\nto which the request relates), but is not actually given.\n(2) The Information Commissioner may require the agency or Minister\nconcerned to conduct further searches for the document.",
      "skos:definition": "document\n(1) This section applies to an IC review in relation to a request for\naccess to a document if:\n(a) access to the document is refused under section 24A\n(document cannot be found etc.); or\n(b) access is purportedly given to the document (amongst others\nto which the request relates), but is not actually given.\n(2) The Information Commissioner may require the agency or Minister\nconcerned to conduct further searches for the document.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55v-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-55v-ss-2"
        }
