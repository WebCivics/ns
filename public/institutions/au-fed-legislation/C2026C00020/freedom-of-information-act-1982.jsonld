    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "57A(3) Tribunal reviewable decisions—which decisions are",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-57a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.166",
      "values:originalText": "(3) Part 5 (guidance and appeals panel) of the Administrative Review\nTribunal Act 2024 does not apply in relation to:\n\n\nReview by the Tribunal  Part VIIA\nTribunal reviewable decisions  Division 2\nSection 57A\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(a) an application under subsection (1) for review of a decision;\nor\n(b) the decision of the Tribunal on the review.",
      "skos:definition": "(3) Part 5 (guidance and appeals panel) of the Administrative Review\nTribunal Act 2024 does not apply in relation to:\n\n\nReview by the Tribunal  Part VIIA\nTribunal reviewable decisions  Division 2\nSection 57A\nFreedom of Information Act 1982\nCompilation date: 01/01/2026\n(a) an application under subsection (1) for review of a decision;\nor\n(b) the decision of the Tribunal on the review.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-57a"
      },
      "cml:asserts": [
