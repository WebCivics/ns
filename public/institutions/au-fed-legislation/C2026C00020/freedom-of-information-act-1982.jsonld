      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Affirmation obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Subject to this section:",
      "cml:conclusionText": "Agency must affirm original decision and notify applicant"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between agency's action and review period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Subject to this section:\n(a) the principal officer of the agency is taken to have made a\ndecision personally affirming the original decision on the last\nday of the initial decision period;",
      "cml:conclusionText": "Agency's action overlaps with review period"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "Recurring trace of agency's actions and reviews",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Subject to this section:\n(a) the principal officer of the agency is taken to have made a\ndecision personally affirming the original decision on the last\nday of the initial decision period;",
      "cml:conclusionText": "Agency's actions and reviews form a recurring trace"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of agency's action to applicant",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) notice of the decision is taken to have been given under\nsection 26 to the internal review applicant on the same day.",
      "cml:conclusionText": "Agency's action diffuses to applicant"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implicates",
      "cml:logicSummary": "Implication of agency's action on applicant's rights",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) notice of the decision is taken to have been given under\nsection 26 to the internal review applicant on the same day.",
      "cml:conclusionText": "Agency's action implicates applicant's rights"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54d-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "54D(3) Internal review—deemed affirmation of original decision",
