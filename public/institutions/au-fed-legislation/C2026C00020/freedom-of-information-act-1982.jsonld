    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54c",
      "@type": "cml:Concept",
      "skos:prefLabel": "54C Internal review—decision on internal review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.123",
      "values:originalText": "Scope\n(1) This section applies if an application for internal review of an\naccess refusal decision or an access grant decision (the original\ndecision) is made in accordance with this Part.\nDecision\n(2) The agency must, as soon as practicable, arrange for a person\n(other than the person who made the original decision) to review\nthe decision.",
      "skos:definition": "Scope\n(1) This section applies if an application for internal review of an\naccess refusal decision or an access grant decision (the original\ndecision) is made in accordance with this Part.\nDecision\n(2) The agency must, as soon as practicable, arrange for a person\n(other than the person who made the original decision) to review\nthe decision.",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54c-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54c-ss-2"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54c",
      "@type": "cof:Section",
      "cof:title": "54C Internal review—decision on internal review",
      "values:kind": "section",
      "cof:pageNumber": 123,
      "values:originalText": "Scope\n(1) This section applies if an application for internal review of an\naccess refusal decision or an access grant decision (the original\ndecision) is made in accordance with this Part.\nDecision\n(2) The agency must, as soon as practicable, arrange for a person\n(other than the person who made the original decision) to review\nthe decision."
    },
