    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Requirements of an application for amendment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.109",
      "values:originalText": "An application for amendment must:\n(a) be in writing; and\n(b) as far as practicable, specify:\n(i) the document or official document containing the record\nof personal information that is claimed to require\namendment; and\n(ii) the information that is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(iii) whether the information is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(iv) the applicant’s reasons for so claiming; and\n(v) the amendment requested by the applicant; and\n(c) specify an address in Australia to which a notice under this\nPart may be sent to the applicant; and",
      "skos:definition": "An application for amendment must:\n(a) be in writing; and\n(b) as far as practicable, specify:\n(i) the document or official document containing the record\nof personal information that is claimed to require\namendment; and\n(ii) the information that is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(iii) whether the information is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(iv) the applicant’s reasons for so claiming; and\n(v) the amendment requested by the applicant; and\n(c) specify an address in Australia to which a notice under this\nPart may be sent to the applicant; and",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-49-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1fa4040d09d9a28128c07138539bab5113e13b603a49941f1ac3cb85fb4e3ea5",
      "skos:note": "Application for amendment must be in writing and specify certain information.",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Requirements of an application for amendment",
      "values:kind": "section",
      "cof:pageNumber": 109,
      "values:originalText": "An application for amendment must:\n(a) be in writing; and\n(b) as far as practicable, specify:\n(i) the document or official document containing the record\nof personal information that is claimed to require\namendment; and\n(ii) the information that is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(iii) whether the information is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(iv) the applicant’s reasons for so claiming; and\n(v) the amendment requested by the applicant; and\n(c) specify an address in Australia to which a notice under this\nPart may be sent to the applicant; and"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-49-norm",
      "@type": "values:Obligation",
      "cml:modality": {
