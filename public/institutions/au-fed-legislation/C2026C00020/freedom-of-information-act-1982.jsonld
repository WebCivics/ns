    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51a",
      "@type": "cml:Concept",
      "skos:prefLabel": "51A Requirements of an application for annotation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.111",
      "values:originalText": "An application for annotation must:\n(a) be in writing; and\n(b) as far as practicable, specify the document or official\ndocument containing the record of personal information that\nis claimed to require annotation; and\n(c) be accompanied by a statement by the applicant that\nspecifies:\n(i) the information that is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(ii) whether the information is claimed to be incomplete,\nincorrect, out of date or misleading; and",
      "skos:definition": "An application for annotation must:\n(a) be in writing; and\n(b) as far as practicable, specify the document or official\ndocument containing the record of personal information that\nis claimed to require annotation; and\n(c) be accompanied by a statement by the applicant that\nspecifies:\n(i) the information that is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(ii) whether the information is claimed to be incomplete,\nincorrect, out of date or misleading; and",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51a-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6a52c59a966053453ca02e41748ed804389cdcc45cd146c331965dee0a83c1b3",
      "skos:note": "Application for annotation must be in writing and specify document containing personal information.",
      "dc:description": "Statement by applicant specifying incomplete, incorrect, out of date or misleading information."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-51a",
      "@type": "cof:Section",
      "cof:title": "51A Requirements of an application for annotation",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "An application for annotation must:\n(a) be in writing; and\n(b) as far as practicable, specify the document or official\ndocument containing the record of personal information that\nis claimed to require annotation; and\n(c) be accompanied by a statement by the applicant that\nspecifies:\n(i) the information that is claimed to be incomplete,\nincorrect, out of date or misleading; and\n(ii) whether the information is claimed to be incomplete,\nincorrect, out of date or misleading; and"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-51a-norm",
      "@type": "values:Obligation",
