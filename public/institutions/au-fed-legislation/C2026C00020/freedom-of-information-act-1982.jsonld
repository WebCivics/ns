    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89n",
      "@type": "cml:Concept",
      "skos:prefLabel": "89N Vexatious applicants—review by Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.211",
      "values:originalText": "An application may be made to the Tribunal for a review of a\ndecision under section 89K of the Information Commissioner to\nmake a vexatious applicant declaration.\nNote 1:\nAn application for the review of a decision may be made by a person\nwhose interests are affected by the decision (see section 17 of the\nAdministrative Review Tribunal Act 2024).\nNote 2:\nSection 18 of the Administrative Review Tribunal Act 2024 deals with\nthe time within which the application for review must be made.\nNote 3:\nSection 22 of the Administrative Review Tribunal Act 2024 sets out\nwho the parties are to a proceeding before the Tribunal.",
      "skos:definition": "An application may be made to the Tribunal for a review of a\ndecision under section 89K of the Information Commissioner to\nmake a vexatious applicant declaration.\nNote 1:\nAn application for the review of a decision may be made by a person\nwhose interests are affected by the decision (see section 17 of the\nAdministrative Review Tribunal Act 2024).\nNote 2:\nSection 18 of the Administrative Review Tribunal Act 2024 deals with\nthe time within which the application for review must be made.\nNote 3:\nSection 22 of the Administrative Review Tribunal Act 2024 sets out\nwho the parties are to a proceeding before the Tribunal.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89n-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8efd9fc8788d9f4bceee4237e83d3a33fe9435d6e41846d0853c08009e59408d",
      "skos:note": "Application for review of a decision under section 89K"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89n",
      "@type": "cof:Section",
      "cof:title": "89N Vexatious applicants—review by Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 211,
      "values:originalText": "An application may be made to the Tribunal for a review of a\ndecision under section 89K of the Information Commissioner to\nmake a vexatious applicant declaration.\nNote 1:\nAn application for the review of a decision may be made by a person\nwhose interests are affected by the decision (see section 17 of the\nAdministrative Review Tribunal Act 2024).\nNote 2:\nSection 18 of the Administrative Review Tribunal Act 2024 deals with\nthe time within which the application for review must be made.\nNote 3:\nSection 22 of the Administrative Review Tribunal Act 2024 sets out\nwho the parties are to a proceeding before the Tribunal."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89n-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89n"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89n-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to apply for review",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89p",
      "@type": "cml:Concept",
      "skos:prefLabel": "89P Staff to hold appropriate security clearance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89p"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.212",
      "values:originalText": "The Information Commissioner must take all reasonable steps to\nensure that a member of the staff of the Office of the Australian\nInformation Commissioner who performs functions or exercises\npowers for the purposes of this Act is given a security clearance at\nan appropriate level.\nNote:\nSecurity clearances are given in accordance with the Australian\nGovernment Protective Security Manual.",
      "skos:definition": "The Information Commissioner must take all reasonable steps to\nensure that a member of the staff of the Office of the Australian\nInformation Commissioner who performs functions or exercises\npowers for the purposes of this Act is given a security clearance at\nan appropriate level.\nNote:\nSecurity clearances are given in accordance with the Australian\nGovernment Protective Security Manual.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89p-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89p-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3c7030d2cc78bf49ed96b048e08590a1944fc849e5a2ab2c4af2f0a685881449",
      "skos:note": "Staff must be given security clearance"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89p",
      "@type": "cof:Section",
      "cof:title": "89P Staff to hold appropriate security clearance",
      "values:kind": "section",
      "cof:pageNumber": 212,
      "values:originalText": "The Information Commissioner must take all reasonable steps to\nensure that a member of the staff of the Office of the Australian\nInformation Commissioner who performs functions or exercises\npowers for the purposes of this Act is given a security clearance at\nan appropriate level.\nNote:\nSecurity clearances are given in accordance with the Australian\nGovernment Protective Security Manual."
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-89p-norm",
      "@type": "values:Obligation",
