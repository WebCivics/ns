          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15ab-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15ab-ss-2"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-15ab-ss-3"
        }
      ],
      "cml:integrityHash": "15d1d0db484e774f02158c2eb5baf6a319e7ab844fa6d316965a4be00a4277dd"
