      "skos:note": "Agency must notify affected third party upon request for document access."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-60aa-ss-2",
      "@type": "cof:Section",
      "cof:title": "60AA(2) Procedure in Tribunal—requirement to notify affected third",
      "values:kind": "subsection",
      "cof:pageNumber": 171,
