    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54r",
      "@type": "cml:Concept",
      "skos:prefLabel": "54R IC review applications—withdrawal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54r"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.133",
      "values:originalText": "(1) An IC review applicant may, in writing, withdraw the IC review\napplication at any time before the Information Commissioner\nmakes a decision under section 55K.\n(2) If the IC review application is withdrawn, it is taken never to have\nbeen made.\nSubdivision B—Time limits",
      "skos:definition": "(1) An IC review applicant may, in writing, withdraw the IC review\napplication at any time before the Information Commissioner\nmakes a decision under section 55K.\n(2) If the IC review application is withdrawn, it is taken never to have\nbeen made.\nSubdivision B—Time limits",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54r-ss-1"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-54r-ss-2"
        }
      ],
      "cml:integrityHash": "a36a7f2d80b39e299650a3a4d2c3dbca80fda4a26198774a130f6aaf1a53f838"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-54r",
      "@type": "cof:Section",
      "cof:title": "54R IC review applications—withdrawal",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "(1) An IC review applicant may, in writing, withdraw the IC review\napplication at any time before the Information Commissioner\nmakes a decision under section 55K.\n(2) If the IC review application is withdrawn, it is taken never to have\nbeen made.\nSubdivision B—Time limits"
    },
    {
