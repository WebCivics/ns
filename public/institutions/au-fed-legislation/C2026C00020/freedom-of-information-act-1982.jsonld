    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-89-ss-1",
      "@type": "cof:Section",
      "cof:title": "89(1) Information Commissioner investigations—failure to implement",
      "values:kind": "subsection",
      "cof:pageNumber": 202,
      "values:originalText": "(1) This section applies if:\n(a) the Information Commissioner completes an investigation;\nand\n(b) the Information Commissioner gives an agency a notice\nunder section 86; and\n(c) the Information Commissioner is not satisfied that the agency\nhas taken action that is adequate and appropriate in the\ncircumstances to implement the investigation\nrecommendations for the investigation.\nGiving implementation notices"
    },
