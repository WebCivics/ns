    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10b",
      "@type": "cml:Concept",
      "skos:prefLabel": "10B Transitional—Norfolk Island authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-10b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.50",
      "values:originalText": "This Part does not apply to a Norfolk Island authority at any time\nduring the 2-year period beginning at the commencement of this\nsection.\n\n\nAccess to documents  Part III\n\nSection 11\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "This Part does not apply to a Norfolk Island authority at any time\nduring the 2-year period beginning at the commencement of this\nsection.\n\n\nAccess to documents  Part III\n\nSection 11\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10b-norm"
        },
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-10b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "22c286dcc8541bef85b19c83c1ad3cd49a6e78ae2b477e8500cc01e06329a2b3",
      "skos:note": "No application during a 2-year period"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-10b",
      "@type": "cof:Section",
      "cof:title": "10B Transitional—Norfolk Island authorities",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "This Part does not apply to a Norfolk Island authority at any time\nduring the 2-year period beginning at the commencement of this\nsection.\n\n\nAccess to documents  Part III\n\nSection 11\nFreedom of Information Act 1982\nCompilation date: 01/01/2026"
    },
    {
