    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusion of staff in the tribunal's prescribed authority",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "a registry or other office of or under the charge of a tribunal, authority or body so specified and the staff of such a registry or other office when acting in a capacity as members of that staff"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-6-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Exclusion of certain offices from being prescribed authorities",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the holder of an office pertaining to a tribunal, authority or body specified in Schedule 1, being an office established by the legislation establishing the tribunal, authority or body so specified in his or her capacity as the holder of that office"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-6-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Exclusion of certain offices from being prescribed authorities",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "being an office established by the legislation establishing the tribunal, authority or body so specified in his or her capacity as the holder of that office"
    },
    {
      "@id": "concept:freedom-of-information-act-1982-sch-4-sec-6a",
      "@type": "cml:Concept",
      "skos:prefLabel": "6A Official Secretary to the Governor-General",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-act-1982#sch-4-sec-6a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-act-1982.pdf"
      },
      "dc:source": "freedom-of-information-act-1982.pdf, p.32",
      "values:originalText": "(1) This Act does not apply to any request for access to a document of\nthe Official Secretary to the Governor-General unless the\ndocument relates to matters of an administrative nature.\n(2) For the purposes of this Act, a document in the possession of a\nperson employed under section 13 of the Governor-General\nAct 1974 that is in his or her possession by reason of his or her\nemployment under that section shall be taken to be in the\npossession of the Official Secretary to the Governor-General.\n\n\nPreliminary  Part I\n\nSection 6C\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "skos:definition": "(1) This Act does not apply to any request for access to a document of\nthe Official Secretary to the Governor-General unless the\ndocument relates to matters of an administrative nature.\n(2) For the purposes of this Act, a document in the possession of a\nperson employed under section 13 of the Governor-General\nAct 1974 that is in his or her possession by reason of his or her\nemployment under that section shall be taken to be in the\npossession of the Official Secretary to the Governor-General.\n\n\nPreliminary  Part I\n\nSection 6C\nFreedom of Information Act 1982\nCompilation date: 01/01/2026",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-act-1982-sch-4-sec-6a-ss-1"
        },
