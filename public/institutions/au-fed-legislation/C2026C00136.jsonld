      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The taking of the person before a magistrate occurs before the person is taken into custody.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
