      "cml:operator": "MUST",
      "cml:premiseText": "(a) written notice that specifies the Tribunal offence and describes the conduct alleged to constitute that offence; (b) bring before a magistrate in the State or Territory where the person is arrested"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-12-ss-1-logic-deontic-3",
