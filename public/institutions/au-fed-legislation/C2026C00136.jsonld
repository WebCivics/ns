      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The police officer has a duty to take the person before a magistrate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
