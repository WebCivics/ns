    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36",
      "@type": "cml:Concept",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.47",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "36 Prisoners giving evidence or assisting"
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2"
        }
      ],
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:international-war-crimes-tribunals-act-1995#sec-36",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1",
      "@type": "cml:Concept",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.47",
      "skos:note": "Prisoners must provide evidence or assistance in a foreign country if requested by the Attorney-General and meet certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "36(1) Prisoners giving evidence or assisting"
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
      "asserts": [
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-norm",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-1",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-alleninterval-2",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-3",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-4",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "8421bcae6a7a20a5c07d9d6569173af53ee0942ffd57da1e9fdc950cf49ae529",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:international-war-crimes-tribunals-act-1995#sec-36-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:international-war-crimes-tribunals-act-1995-sec-36"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The time of the request is before the time of the investigation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "There are reasonable grounds to believe that the prisoner can give evidence relevant to the proceeding or assist the investigation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "there are reasonable grounds to believe that the prisoner can give evidence relevant to the proceeding or assist the investigation;"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prisoner must attend.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prisoners must provide evidence or assistance in a foreign country.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Attorney-General requests the prisoner's attendance."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Attorney-General must provide adequate undertakings.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General must provide adequate undertakings in respect of the matters referred to in section 37.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "the Attorney-General is satisfied that the prisoner has consented to giving evidence or assisting in the foreign country;"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must give evidence relevant to the proceeding or assist the investigation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Tribunal must give evidence relevant to the proceeding or assist the investigation if requested by the Attorney-General.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "the Attorney-General is satisfied that the prisoner has consented to giving evidence or assisting in the foreign country;"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Attorney-General must be satisfied that the prisoner has consented.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General must be satisfied that the prisoner has consented to giving evidence or assisting in the foreign country.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "the Attorney-General is satisfied that the Tribunal has given, to the extent (if any) required by the Attorney-General, adequate undertakings in respect of the matters referred to in section 37."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
