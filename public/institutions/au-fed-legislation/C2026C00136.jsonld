      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(2) If the warrant states that it may be executed only during particular hours, it must not be executed outside those hours."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-49-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The artificial agent asserts that the execution is restricted to the specified hours.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
