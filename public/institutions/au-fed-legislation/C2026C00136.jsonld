      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Warrant execution completion occurs during warrant revocation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(a) the execution of a search warrant is stopped by an order of a court; and (b) the order is later revoked or reversed on appeal; and (c) the warrant is still in force;"
    },
