        "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-alleninterval-2",
        "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-ltl-3",
        "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-4",
        "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "060320240ed8e6f8fb003966e6b8baf261ca1f1d64dea80924da3967a2912424",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
