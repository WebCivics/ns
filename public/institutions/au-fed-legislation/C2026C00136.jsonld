      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) be brought before a magistrate in the State or Territory in which the person is arrested."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-12-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide written notice that specifies the Tribunal offence and describes the conduct alleged to constitute that offence",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
