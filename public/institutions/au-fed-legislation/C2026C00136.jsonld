    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-12-ss-1",
      "@type": "cml:Concept",
      "dc:description": "(a) written notice that specifies the Tribunal offence and describes the conduct alleged to constitute that offence; (b) bring before a magistrate in the State or Territory where the person is arrested",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.23",
      "skos:note": "A person arrested under a warrant must be given written notice and brought before a magistrate.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "12(1) Remand"
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
