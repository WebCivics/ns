      "cml:logicSummary": "Inference",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "If the police officer takes the person before a magistrate, then the person will be brought to justice."
    },
