      "cml:logicSummary": "The Attorney-General is permitted to authorise disclosure under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permits",
      "cml:premiseText": "(ii) the information or documents relate to the fact of a communication passing over a telecommunications system during a period specified in the Tribunal’s request."
    },
