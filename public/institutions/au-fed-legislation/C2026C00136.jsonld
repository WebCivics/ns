    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13",
      "@type": "cml:Concept",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.24",
      "skos:note": "The Attorney-General must direct a magistrate to release a person from custody or discharge recognisances.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "13 Release from remand on the Attorney-General’s direction"
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
      "asserts": [
        "concept:international-war-crimes-tribunals-act-1995-sec-13-norm",
        "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-deontic-1",
        "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-alleninterval-2",
        "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-ltl-3",
        "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-diffusion-4",
        "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "de216a338e7ce532bbc2c0729f165eb33ccc5965e0dee054874e6c22a593f876",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:international-war-crimes-tribunals-act-1995#sec-13",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The release occurs after the direction is given.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The provision specifies a temporal relationship between actions.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The Attorney-General's direction must occur before the release of a person from custody."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The direction is an instance of the cognitive action of directing a magistrate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The provision defines a specific class of cognitive action.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The Attorney-General's direction is a type of action that requires reasoning."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A magistrate must order the release of a person from custody.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General has a duty to direct a magistrate.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Attorney-General is required to take action."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The direction is an instance of the diffusion of obligation to direct a magistrate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The provision defines a specific class of diffusion.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The Attorney-General's direction is a type of action that affects others."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The direction is an instance of the obligation to direct a magistrate in relation to the release.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The provision specifies a temporal relationship between actions.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "The release of a person from custody must occur before the Attorney-General's next action."
    },
