    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2",
      "@type": "cml:Concept",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.47",
      "skos:note": "Release of prisoner for travel to give evidence or assist investigation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "36(2) Prisoners giving evidence or assisting"
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
      "asserts": [
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-norm",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-deontic-1",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-alleninterval-2",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-ltl-3",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-deontic-4",
        "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "dfcf460ee3fef9ce072a938f070fff402f4f78fe60572fafb4ad54b189dd6c4e",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:international-war-crimes-tribunals-act-1995#sec-36-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:international-war-crimes-tribunals-act-1995-sec-36"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "... that the prisoner be released from prison for the purpose of such travel...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between prisoner's custody and travel.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(b) if the prisoner is a federal prisoner and also a State prisoner-direct"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "... the Attorney-General may: ... direct that the prisoner be released...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Release of prisoner implies travel for evidence or investigation.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(2) Subject to subsection (4), if the prisoner is being held in custody"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the Attorney-General may: ... direct that the prisoner be released...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission granted by the State.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:premiseText": "(2) Subject to subsection (4), if the prisoner is being held in custody,"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "... the Attorney-General may: ... direct that the prisoner be released...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No prohibition on releasing prisoner.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) Subject to subsection (4), if the prisoner is being held in custody"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "... make arrangements for such travel in the custody of a police",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Conditional release until necessary directions or approvals are given.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(c) in any case-subject to the making or giving of any necessary directions or approvals relevant to release of the prisoner"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-36-ss-2-norm",
