    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5",
      "@type": "cml:Concept",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.96",
      "skos:note": "Return seized thing if reason for seizure no longer exists or thing is not needed in evidence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "77(5) Retention of things seized"
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
      "asserts": [
        "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-norm",
