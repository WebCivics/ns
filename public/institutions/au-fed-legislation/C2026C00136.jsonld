      "cml:integrityHash": "23d5cea168fd0aa91faa96d857bb0b5427c535de3b12cccb835bf35c3f605df1",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:international-war-crimes-tribunals-act-1995#sec-32b-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:international-war-crimes-tribunals-act-1995-sec-32b"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32b-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An authorisation is required.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorisation is required.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "authorise",
      "cml:premiseText": "The Attorney-General may authorise a constable to apply for an order."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32b-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Consent is required from the person before the authorisation can be granted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person must be given an opportunity to consent to the forensic procedure and has not consented to it.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustBeGiven",
      "cml:premiseText": "The Attorney-General may authorise a constable to apply for an order if the person has not consented to the forensic procedure."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32b-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Undertakings are required from the Tribunal before the authorisation can be granted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Tribunal must give appropriate undertakings about the retention, use and destruction of forensic material or information obtained from analysing that material.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustBeGiven",
      "cml:premiseText": "The Attorney-General may authorise a constable to apply for an order if the Tribunal has given appropriate undertakings."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32b-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Belief is required about the person's location before the authorisation can be granted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person must be believed to be in Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustBeGiven",
      "cml:premiseText": "The Attorney-General may authorise a constable to apply for an order if the person is believed to be in Australia."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32b-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Undertakings are required from the Tribunal before the authorisation can be granted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Tribunal must give undertakings that the Attorney-General considers necessary.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustBeGiven",
      "cml:premiseText": "The Attorney-General may authorise a constable to apply for an order if the Tribunal has given undertakings that the Attorney-General considers necessary."
    },
