    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the time period of the reason for seizure has passed, the thing must be returned",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Return seized thing if reason for seizure no longer exists or thing is not needed in evidence",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The Attorney-General must direct the Commissioner to return the thing"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Return the thing",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must return seized thing",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Reason for seizure no longer exists or thing is not needed in evidence."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The thing can be forfeited or forfeitable",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Thing can be forfeited or forfeitable if reason for seizure still exists",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "Unless the thing is forfeited or forfeitable to the Commonwealth or is the subject of a dispute as to ownership."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The thing must not be used in evidence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Thing must not be used in evidence by a Tribunal or in respect of criminal proceedings in Australia if reason for seizure no longer exists",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "It is decided that the thing is not to be used in evidence by a Tribunal or in respect of criminal proceedings in Australia."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the condition is met, the thing must be returned until it's no longer needed",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Return seized thing if reason for seizure no longer exists or thing is not needed in evidence",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "The Attorney-General must direct the Commissioner to return the thing"
    },
