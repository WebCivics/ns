      "cml:logicSummary": "Inference",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "SPREADS_TO",
      "cml:premiseText": "If the police officer takes the person before a magistrate, then the news of the arrest spreads to others."
