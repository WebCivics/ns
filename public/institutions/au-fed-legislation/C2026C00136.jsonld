      "cml:logicSummary": "Temporal relationship",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEFORE",
      "cml:premiseText": "The police officer must take the person before a magistrate as soon as practicable."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The police officer taking the person before a magistrate implies that the person will be brought to justice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
