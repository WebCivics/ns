      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is forbidden to execute the warrant outside the specified hours.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
