    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5",
      "@type": "cml:Concept",
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.79",
      "skos:note": "Court assumes exercise of power under warrant was not duly authorised unless proved otherwise.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "53(5) Formalities relating to warrants issued by telephone etc."
      },
      "wasDerivedFrom": "international-war-crimes-tribunals-act-1995.pdf",
      "asserts": [
        "concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5-norm",
        "concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "57338cc89382d4768d6e902c5d40fd07ae6380845b216fcd2809473166092bee",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:international-war-crimes-tribunals-act-1995#sec-53-ss-5",
      "cml:schemaVersion": "2",
      "partOf": "concept:international-war-crimes-tribunals-act-1995-sec-53"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(5) If: (a) it is material, in any proceedings, for a court to be satisfied that the exercise of a power under a warrant issued under section 52 was not duly authorised; and (b) the form of warrant signed by the magistrate is not produced in evidence; the court is to assume that the exercise of the power was not duly authorised.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits exercise of power under warrant unless duly authorised.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(5) If: (a) it is material, in any proceedings, for a court to be satisfied that the exercise of a power under a warrant issued under section 52 was duly authorised; and (b) the form of warrant signed by the magistrate is not produced in evidence; the court is to assume, unless the contrary is proved, that the exercise of the power was not duly authorised."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5-norm",
      "@type": "doc:Prohibition",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5"
    },
