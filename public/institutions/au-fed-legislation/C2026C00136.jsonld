        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General is permitted to authorise disclosure under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permits",
      "cml:premiseText": "(c) the Attorney-General is satisfied that: (i) a proceeding is before, or an investigation is being conducted by, the Tribunal;"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-34b-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
