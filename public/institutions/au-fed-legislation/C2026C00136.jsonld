    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Cancel the warrant after the person has not been arrested.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The cancellation must occur after the person has not been arrested.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The person has not been arrested under the warrant."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The warrant should be cancelled if no such request is received.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The cancellation is related to a request from a Tribunal.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Cancel the warrant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General must cancel a warrant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The person has not been arrested under the warrant."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Cancel the warrant if both conditions are met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The cancellation must be related to both conditions.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "AND",
      "cml:premiseText": "The person has not been arrested under the warrant and A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Cancel the warrant if no such request is received within a certain time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The cancellation must occur before a certain time.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9."
    },
