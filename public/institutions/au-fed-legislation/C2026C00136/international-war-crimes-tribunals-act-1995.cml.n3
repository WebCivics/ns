concept:international-war-crimes-tribunals-act-1995-sec-13 a cml:Concept ;
    skos:prefLabel "13 Release from remand on the Attorney-General’s direction"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "The Attorney-General must, by notice in writing in the statutory form, direct a magistrate to order the release from custody of a person remanded under this Division, or the discharge of the recognisances on which bail was granted to the person, as the case requires, if: (a) the Attorney-General is satisfied that a request from a Tribunal that would oblige the Attorney-General to issue a notice under section 9 in relation to the person will not be received; or (b) the Attorney-General considers for any other reason that the remand should cease." ;
    skos:definition "The Attorney-General must, by notice in writing in the statutory form, direct a magistrate to order the release from custody of a person remanded under this Division, or the discharge of the recognisances on which bail was granted to the person, as the case requires, if: (a) the Attorney-General is satisfied that a request from a Tribunal that would oblige the Attorney-General to issue a notice under section 9 in relation to the person will not be received; or (b) the Attorney-General considers for any other reason that the remand should cease."@en ;
    cml:integrityHash "de216a338e7ce532bbc2c0729f165eb33ccc5965e0dee054874e6c22a593f876" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "The Attorney-General must direct a magistrate to release a person from custody or discharge recognisances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
