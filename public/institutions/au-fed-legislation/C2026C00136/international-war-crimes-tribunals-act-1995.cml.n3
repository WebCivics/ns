doc:sec-78-ss-1 a cof:Section ;
    cof:title "78(1) Arrest of persons escaping from custody" ;
    values:kind "subsection" ;
    values:originalText "(1) A police officer may, without warrant, arrest a person, if the police officer has reasonable grounds to believe that the person has escaped from custody authorised by this Act." ;
    cof:pageNumber "98"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2 a cml:Concept ;
    skos:prefLabel "78(2) Arrest of persons escaping from custody"@en ;
    cml:realizedBy doc:sec-78-ss-2 ;
    values:originalText "(2) The police officer must, as soon as practicable, take the person before a magistrate." ;
