doc:sec-81-ss-1 a cof:Section ;
    cof:title "81(1) Legal assistance" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who: (a) has instituted, or proposes to institute, a proceeding before a magistrate or a court under this Act or in respect of detention under this Act; or (b) is, or will be, a party to such a proceeding; or (c) is, or will be, giving evidence or producing documents or other articles at such a proceeding; may apply to the Attorney-General for assistance under this section in respect of the proceeding." ;
    cof:pageNumber "99"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-81-ss-2 a cml:Concept ;
    skos:prefLabel "81(2) Legal assistance"@en ;
    cml:realizedBy doc:sec-81-ss-2 ;
    values:originalText "(2) If the Attorney-General is satisfied that: (a) it would involve hardship to the person to refuse the application; and (b) in all the circumstances, it is reasonable that the application be granted; the Attorney-General may authorise provision by the Commonwealth to the person of such legal or financial assistance in relation to the proceeding as the Attorney-General determines." ;
    skos:definition "(2) If the Attorney-General is satisfied that: (a) it would involve hardship to the person to refuse the application; and (b) in all the circumstances, it is reasonable that the application be granted; the Attorney-General may authorise provision by the Commonwealth to the person of such legal or financial assistance in relation to the proceeding as the Attorney-General determines."@en ;
    cml:integrityHash "5eff8dda822444c42a8e55fdc88c8bfc12684adb495610b7c4e66342db8f24b4" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-81 ;
    cof:pageNumber "99"^^xsd:integer ;
    skos:note "Authority for Attorney-General to grant legal or financial assistance" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
