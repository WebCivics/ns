doc:sec-51-ss-1 a cof:Section ;
    cof:title "51(1) Restrictions on personal searches" ;
    values:kind "subsection" ;
    values:originalText "(1) A police officer may apply to a magistrate for a warrant by telephone, telex, fax or other electronic means: (a) in an urgent case; or (b) if the delay that would occur if an application were made in person would frustrate the effective execution of the warrant." ;
    cof:pageNumber "78"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-51-ss-2 a cml:Concept ;
    skos:prefLabel "51(2) Restrictions on personal searches"@en ;
    cml:realizedBy doc:sec-51-ss-2 ;
    values:originalText "(2) The magistrate may require communication by voice to the extent that is practicable in the circumstances." ;
    skos:definition "(2) The magistrate may require communication by voice to the extent that is practicable in the circumstances."@en ;
    cml:integrityHash "b561c3f03693ef9d7af132ddc474f06458929516f29cbbadb046973042646c1f" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-51 ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Applicant must complete a form of warrant substantially corresponding to those given by the magistrate. Magistrate may require communication by voice." ;
    cml:curationStatus cml:Proposed ;
