concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-7 a cml:Concept ;
    skos:prefLabel "46A(7) Effect on third parties of registration of forfeiture orders"@en ;
    cml:realizedBy doc:sec-46a-ss-7 ;
    values:originalText "(7) The court may give leave to apply outside that period if the court is satisfied that the person’s failure to apply within that period was not due to any neglect on the person’s part." ;
    skos:definition "(7) The court may give leave to apply outside that period if the court is satisfied that the person’s failure to apply within that period was not due to any neglect on the person’s part."@en ;
    cml:integrityHash "9e07bd9f54eb8964231cef8af6472a8f960e1f057efdc1034b1c49910e38fb6c" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-46a ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "Court may give leave to apply outside the period if not due to neglect." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
