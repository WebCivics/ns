doc:sec-51-ss-1 a cof:Section ;
    cof:title "51(1) Restrictions on personal searches" ;
    values:kind "subsection" ;
    values:originalText "(1) If the magistrate decides to issue the warrant under section 52, the magistrate is to inform the applicant, by telephone, telex, fax or other electronic means, of the terms of the warrant and the day on which and the time at which it was signed." ;
    cof:pageNumber "78"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-51-ss-2 a cml:Concept ;
    skos:prefLabel "51(2) Restrictions on personal searches"@en ;
    cml:realizedBy doc:sec-51-ss-2 ;
    values:originalText "(2) The applicant must then complete a form of warrant in terms substantially corresponding to those given by the magistrate, stating on the form the name of the magistrate and the day on which and the time at which the warrant was signed." ;
    skos:definition "(2) The applicant must then complete a form of warrant in terms substantially corresponding to those given by the magistrate, stating on the form the name of the magistrate and the day on which and the time at which the warrant was signed."@en ;
    cml:integrityHash "446f4211beae700d5b1a2de3d8adae723fa324f5fe4f1c24534db55aa4b8de22" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-51 ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Applicant must complete a form of warrant substantially corresponding to those given by the magistrate. Magistrate may require communication by voice." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
