concept:international-war-crimes-tribunals-act-1995-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "(1) Sections 1 and 2 commence on the day on which this Act receives the Royal Assent. (2) Subject to subsection (3), the remaining provisions of this Act commence on a day or days to be fixed by Proclamation. (3) If a provision of this Act does not commence under subsection (2) within 6 months after the day on which this Act receives the Royal Assent, it commences on the first day after the end of that period." ;
    skos:definition "(1) Sections 1 and 2 commence on the day on which this Act receives the Royal Assent. (2) Subject to subsection (3), the remaining provisions of this Act commence on a day or days to be fixed by Proclamation. (3) If a provision of this Act does not commence under subsection (2) within 6 months after the day on which this Act receives the Royal Assent, it commences on the first day after the end of that period."@en ;
    cml:integrityHash "be251b290f11968fdbaf9d72fc4d4a66a242cd5d65ae2e7f0bf0296964762283" ;
    cof:pageNumber "9"^^xsd:integer ;
