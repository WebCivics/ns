concept:international-war-crimes-tribunals-act-1995-sec-66 a cml:Concept ;
    skos:prefLabel "66 Use of force in making arrest"@en ;
    cml:realizedBy doc:sec-66 ;
    values:originalText "(1) A person must not, in the course of arresting another person under this Act or pursuant to a warrant issued under this Act, use more force, or subject the other person to greater indignity, than is necessary and reasonable to make the arrest or to prevent the escape of the other person after the arrest." ;
    skos:definition "(1) A person must not, in the course of arresting another person under this Act or pursuant to a warrant issued under this Act, use more force, or subject the other person to greater indignity, than is necessary and reasonable to make the arrest or to prevent the escape of the other person after the arrest."@en ;
    cml:integrityHash "ea7a966727dc749d62b95544474786a51aa320fc3213a1ce05ffbf3bee92956e" ;
    cof:pageNumber "89"^^xsd:integer ;
    skos:note "Use of force in making arrest must be reasonable and necessary." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
    dc:source "international-war-crimes-tribunals-act-1995.pdf, p.89" ;
    cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-66-norm .
