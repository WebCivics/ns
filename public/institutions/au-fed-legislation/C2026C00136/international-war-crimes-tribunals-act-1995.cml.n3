doc:sec-45-ss-1a a cof:Section ;
    cof:title "45(1A) Registration of order" ;
    values:kind "subsection" ;
    values:originalText "(1A) The proceeds of crime authority must give notice of the application:   Forfeiture of proceeds of Tribunal offences  Part 6  Section 46 International War Crimes Tribunals Act 1995 Compilation date: 28/03/2026 (a) to specified persons the authority has reason to suspect may have an interest in the property; and (b) to such other persons as the court directs." ;
    cof:pageNumber "68"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-45-ss-1b a cml:Concept ;
    skos:prefLabel "45(1B) Registration of order"@en ;
    cml:realizedBy doc:sec-45-ss-1b ;
    values:originalText "(1B) However, the court may consider the application without notice having been given if the proceeds of crime authority requests the court to do so." ;
    skos:definition "(1B) However, the court may consider the application without notice having been given if the proceeds of crime authority requests the court to do so."@en ;
    cml:integrityHash "db26c2b155334ef13457c414e8f2a499a6f682117ad2722c24b7f2904722b45d" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-45 ;
    cof:pageNumber "68"^^xsd:integer ;
    skos:note "Court may consider application without notice if requested by proceeds of crime authority." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
