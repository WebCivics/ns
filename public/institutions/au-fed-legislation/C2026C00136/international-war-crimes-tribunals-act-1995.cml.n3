concept:international-war-crimes-tribunals-act-1995-sec-32c a cml:Concept ;
    skos:prefLabel "32C Providing forensic evidence to the Tribunal"@en ;
    cml:realizedBy doc:sec-32c ;
    values:originalText "(1) The Attorney-General may direct a constable about how forensic evidence is to be provided to a Tribunal if: (a) the Attorney-General gave an authorisation to the constable under subsection 32B(1); and (b) the forensic evidence resulted from the authorisation. (2) A direction under subsection (1) is not a legislative instrument." ;
    skos:definition "(1) The Attorney-General may direct a constable about how forensic evidence is to be provided to a Tribunal if: (a) the Attorney-General gave an authorisation to the constable under subsection 32B(1); and (b) the forensic evidence resulted from the authorisation. (2) A direction under subsection (1) is not a legislative instrument."@en ;
    cml:integrityHash "0c8a7ce7065c0ef04693289e40da398c3a3e91d978246adc4f303094ebacef3e" ;
    cof:pageNumber "41"^^xsd:integer ;
