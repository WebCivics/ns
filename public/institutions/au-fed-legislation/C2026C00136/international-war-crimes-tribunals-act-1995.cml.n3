concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3 a cml:Concept ;
    skos:prefLabel "78(3) Arrest of persons escaping from custody"@en ;
    cml:realizedBy doc:sec-78-ss-3 ;
    values:originalText "(3) If the magistrate is satisfied that the person has escaped from custody authorised by this Act, the magistrate may issue a warrant authorising any police officer to return the person to the custody referred to in subsection (1)." ;
    skos:definition "(3) If the magistrate is satisfied that the person has escaped from custody authorised by this Act, the magistrate may issue a warrant authorising any police officer to return the person to the custody referred to in subsection (1)."@en ;
    cml:integrityHash "9d10626e655acca790f26587b95f428d890677c0e9c6734a67bba0b4844246f6" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-78 ;
    cof:pageNumber "98"^^xsd:integer ;
    skos:note "Magistrate may issue warrant for police officer to return escaped person to custody." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
