doc:sec-46a-ss-7 a cof:Section ;
    cof:title "46A(7) Effect on third parties of registration of forfeiture orders" ;
    values:kind "subsection" ;
    values:originalText "(7) The court may give leave to apply outside that period if the court is satisfied that the person’s failure to apply within that period was not due to any neglect on the person’s part." ;
    cof:pageNumber "70"^^xsd:integer .

