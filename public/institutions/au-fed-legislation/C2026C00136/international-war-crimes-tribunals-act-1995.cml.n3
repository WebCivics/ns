doc:sec-20-ss-1 a cof:Section ;
    cof:title "20(1) Detention following surrender warrants" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Attorney-General issues the surrender warrant, the person must be brought as soon as practicable before a magistrate in the State or Territory in which the person is on remand.   Surrender of persons to a Tribunal  Part 3 Surrender of persons  Division 2 Section 21 International War Crimes Tribunals Act 1995 Compilation date: 28/03/2026" ;
    cof:pageNumber "28"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-20-ss-2 a cml:Concept ;
    skos:prefLabel "20(2) Detention following surrender warrants"@en ;
    cml:realizedBy doc:sec-20-ss-2 ;
    values:originalText "(2) A magistrate must remand the person in custody for such period or periods as may be necessary to enable the warrant to be executed." ;
    skos:definition "(2) A magistrate must remand the person in custody for such period or periods as may be necessary to enable the warrant to be executed."@en ;
    cml:integrityHash "5e37be315c295f6c08097e808092db5ee58be3a299d878b17932df06c11a7aab" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-20 ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Magistrate must remand person in custody for necessary period to execute warrant." ;
    cml:curationStatus cml:Proposed ;
