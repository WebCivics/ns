concept:international-war-crimes-tribunals-act-1995-sec-40ag a cml:Concept ;
    skos:prefLabel "40AG Retaining produced documents"@en ;
    cml:realizedBy doc:sec-40ag ;
    values:originalText "(1) An authorised officer who takes possession of a document under a production order made in respect of a Tribunal offence may retain the document pending a written direction from the Attorney-General as to how to deal with the document." ;
    skos:definition "(1) An authorised officer who takes possession of a document under a production order made in respect of a Tribunal offence may retain the document pending a written direction from the Attorney-General as to how to deal with the document."@en ;
    cml:integrityHash "5bab6f61355c56abed1e04cfcefba469e16c7ec6a50dd3aa6c87ff2aa67d3c34" ;
    cof:pageNumber "55"^^xsd:integer ;
    skos:note "An authorised officer must provide a written direction to the Attorney-General on how to deal with retained documents." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
