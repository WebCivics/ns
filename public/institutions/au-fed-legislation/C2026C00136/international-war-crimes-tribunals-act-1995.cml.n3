concept:international-war-crimes-tribunals-act-1995-sec-40at-ss-2 a cml:Concept ;
    skos:prefLabel "40AT(2) Dealing with certain seized property"@en ;
    cml:realizedBy doc:sec-40at-ss-2 ;
    values:originalText "(2) If, at the end of the period of 30 days after the day the property was seized: (a) a forfeiture order in relation to the property has not been registered in a court under Part 6; and (b) a restraining order has not been made as described in Subdivision B in respect of the property in relation to the Tribunal offence;" ;
    skos:definition "(2) If, at the end of the period of 30 days after the day the property was seized: (a) a forfeiture order in relation to the property has not been registered in a court under Part 6; and (b) a restraining order has not been made as described in Subdivision B in respect of the property in relation to the Tribunal offence;"@en ;
    cml:integrityHash "eb4a7fd4282cc880b4d72b6bd28bdb1ec83a168d5090daf6976409ff6ae1dcb1" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-40at ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Forfeiture order not registered within 30 days after seizure." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
    dc:source "international-war-crimes-tribunals-act-1995.pdf, p.63" ;
    cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-40at-ss-2-norm .
