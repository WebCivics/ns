doc:sec-58-ss-4 a cof:Section ;
    cof:title "58(4) Use of electronic equipment at premises" ;
    values:kind "subsection" ;
    values:originalText "(4) If the executing officer or an officer assisting believes on reasonable grounds that: (a) evidential material may be accessible by operating electronic equipment at the warrant premises; and (b) expert assistance is required to operate the equipment; and (c) if he or she does not take action under this subsection, the material may be destroyed, altered or otherwise interfered with; he or she may do whatever is necessary to secure the equipment, whether by locking it up, placing a guard or otherwise." ;
    cof:pageNumber "82"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-58-ss-5 a cml:Concept ;
    skos:prefLabel "58(5) Use of electronic equipment at premises"@en ;
    cml:realizedBy doc:sec-58-ss-5 ;
    values:originalText "(5) The executing officer or an officer assisting must give notice to the occupier of the premises of his or her intention to secure equipment and of the fact that the equipment may be secured for up to 24 hours." ;
    skos:definition "(5) The executing officer or an officer assisting must give notice to the occupier of the premises of his or her intention to secure equipment and of the fact that the equipment may be secured for up to 24 hours."@en ;
