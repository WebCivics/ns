concept:international-war-crimes-tribunals-act-1995-sec-11 a cml:Concept ;
    skos:prefLabel "11 Cancellation of warrants"@en ;
    cml:realizedBy doc:sec-11 ;
    values:originalText "The Attorney-General must, by written notice in the statutory form, direct a magistrate to cancel a warrant if the person has not been arrested under the warrant and: (a) the Attorney-General is satisfied that a request from a Tribunal that would oblige the Attorney-General to issue a notice under section 9 in relation to the person will not be received; or (b) the Attorney-General considers for any other reason that the warrant should be cancelled." ;
    skos:definition "The Attorney-General must, by written notice in the statutory form, direct a magistrate to cancel a warrant if the person has not been arrested under the warrant and: (a) the Attorney-General is satisfied that a request from a Tribunal that would oblige the Attorney-General to issue a notice under section 9 in relation to the person will not be received; or (b) the Attorney-General considers for any other reason that the warrant should be cancelled."@en ;
    cml:integrityHash "eeefa0a22823b4671095b146e5006b562da1fc204ec4c6e51dd6b72d27b43a4d" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "The Attorney-General must cancel a warrant if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
    dc:source "international-war-crimes-tribunals-act-1995.pdf, p.23" ;
    cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-11-norm .
