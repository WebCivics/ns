concept:international-war-crimes-tribunals-act-1995-sec-17 a cml:Concept ;
    skos:prefLabel "17 Release from remand on refusal to surrender the person"@en ;
    cml:realizedBy doc:sec-17 ;
    values:originalText "If the Attorney-General has determined not to surrender the person to the Tribunal, the Attorney-General must, by notice in writing in the statutory form, direct a magistrate to order: (a) the release of the person from custody; or (b) the discharge of the recognisances on which bail was granted to the person; as the case requires." ;
    skos:definition "If the Attorney-General has determined not to surrender the person to the Tribunal, the Attorney-General must, by notice in writing in the statutory form, direct a magistrate to order: (a) the release of the person from custody; or (b) the discharge of the recognisances on which bail was granted to the person; as the case requires."@en ;
    cml:integrityHash "98946baac1440d7420b17d0876a2f41b64e3af32253f1396f4f7d22a60a3c152" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Release from remand on refusal to surrender the person" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
    dc:source "international-war-crimes-tribunals-act-1995.pdf, p.27" ;
    cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-17-norm .
