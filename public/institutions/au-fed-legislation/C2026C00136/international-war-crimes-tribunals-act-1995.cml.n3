concept:international-war-crimes-tribunals-act-1995-sec-62 a cml:Concept ;
    skos:prefLabel "62 Receipts for things seized under warrant"@en ;
    cml:realizedBy doc:sec-62 ;
    values:originalText "(1) If a thing is seized under a warrant or moved under subsection 57(2), the executing officer or an officer assisting must provide a receipt for the thing." ;
