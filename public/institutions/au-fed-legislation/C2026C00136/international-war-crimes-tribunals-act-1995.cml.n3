doc:sec-39-ss-1 a cof:Section ;
    cof:title "39(1) Transit" ;
    values:kind "subsection" ;
    values:originalText "(1) If a person is to be transported in custody from a foreign country through Australia to another foreign country for the purpose of: (a) giving evidence in a proceeding before a Tribunal; or (b) giving assistance in relation to an investigation being conducted by a Tribunal; or (c) being surrendered to a Tribunal; the person may be transported through Australia in the custody of another person." ;
    cof:pageNumber "50"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-39-ss-2 a cml:Concept ;
    skos:prefLabel "39(2) Transit"@en ;
    cml:realizedBy doc:sec-39-ss-2 ;
    values:originalText "(2) If an aircraft or ship by which the person is being transported lands or calls at a place in Australia, the person must be kept in such custody as the Attorney-General directs in writing until his or her transportation is continued." ;
    skos:definition "(2) If an aircraft or ship by which the person is being transported lands or calls at a place in Australia, the person must be kept in such custody as the Attorney-General directs in writing until his or her transportation is continued."@en ;
    cml:integrityHash "f5fb8df6af866084216d382944770b3c1c50a9e99b269b3bb54d6fe2053a5dc9" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-39 ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Must be kept in custody until transportation is continued" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
