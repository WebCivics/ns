doc:sec-15-ss-1 a cof:Section ;
    cof:title "15(1) Application for search warrants" ;
    values:kind "subsection" ;
    values:originalText "(1) If: (a) a person is arrested under a warrant issued under section 10; and (b) a police officer has reasonable grounds for suspecting that evidential material relating to a Tribunal offence in respect of which the warrant was issued is, or within the applicable period referred to in subsection (3) of this section will be, at any premises; the police officer may, by an information on oath that sets out the grounds for that suspicion, apply for a search warrant in relation to the premises to search for that material." ;
    cof:pageNumber "25"^^xsd:integer .

concept:international-war-crimes-tribunals-act-1995-sec-15-ss-2 a cml:Concept ;
    skos:prefLabel "15(2) Application for search warrants"@en ;
    cml:realizedBy doc:sec-15-ss-2 ;
    values:originalText "(2) If: (a) a person is arrested under a warrant issued under section 10; and" ;
    skos:definition "(2) If: (a) a person is arrested under a warrant issued under section 10; and"@en ;
    cml:integrityHash "0c1d801fb4c9785ecf1f2fac078725dae8324b51dcb42aed800292451e15bb47" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-15 ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "If a person is arrested under a warrant issued under section 10, then the application for search warrants must be made." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
