concept:international-war-crimes-tribunals-act-1995-sec-82 a cml:Concept ;
    skos:prefLabel "82 Arrangements with States"@en ;
    cml:realizedBy doc:sec-82 ;
    values:originalText "(1) The Governor-General may make arrangements with the Governor of a State with respect to the administration of this Act, including arrangements for the performance of the functions of a magistrate under this Act by all or any of the persons who from time to time hold office as magistrates of that State. (2) The Governor-General may arrange with the Governor of a State with whom an arrangement is in force under subsection (1) for the variation or revocation of the arrangement." ;
    skos:definition "(1) The Governor-General may make arrangements with the Governor of a State with respect to the administration of this Act, including arrangements for the performance of the functions of a magistrate under this Act by all or any of the persons who from time to time hold office as magistrates of that State. (2) The Governor-General may arrange with the Governor of a State with whom an arrangement is in force under subsection (1) for the variation or revocation of the arrangement."@en ;
    cml:integrityHash "22eb2e5a71c63be6a048f728a0844c80e0337c54d9da92566773cae1252fc88a" ;
    cof:pageNumber "99"^^xsd:integer ;
