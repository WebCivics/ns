concept:international-war-crimes-tribunals-act-1995-sec-70 a cml:Concept ;
    skos:prefLabel "70 Power to conduct search of arrested person’s premises"@en ;
    cml:realizedBy doc:sec-70 ;
    values:originalText "A police officer who arrests a person at premises under this Act or pursuant to a warrant issued under this Act, or who is present at such an arrest, may seize things in plain view at those premises that the police officer believes on reasonable grounds to be: (a) evidential material relating to the Tribunal offence to which the person’s custody relates; or (b) seizable items." ;
    skos:definition "A police officer who arrests a person at premises under this Act or pursuant to a warrant issued under this Act, or who is present at such an arrest, may seize things in plain view at those premises that the police officer believes on reasonable grounds to be: (a) evidential material relating to the Tribunal offence to which the person’s custody relates; or (b) seizable items."@en ;
    cml:integrityHash "9cc1c226e56601a1351b2993ab54866525a0bf9c02f947ae6115bc9364605f2f" ;
    cof:pageNumber "91"^^xsd:integer ;
    skos:note "Police officer may not seize things in plain view at premises without reasonable grounds." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
