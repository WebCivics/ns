concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-6 a cml:Concept ;
    skos:prefLabel "46A(6) Effect on third parties of registration of forfeiture orders"@en ;
    cml:realizedBy doc:sec-46a-ss-6 ;
    values:originalText "(6) Unless the court gives leave, an application under subsection (1) is to be made before the end of 6 weeks beginning on the day when the forfeiture order is registered in the court." ;
    skos:definition "(6) Unless the court gives leave, an application under subsection (1) is to be made before the end of 6 weeks beginning on the day when the forfeiture order is registered in the court."@en ;
    cml:integrityHash "f89dded465949535e3f402b2f6a2363ca9775f45a00ee9fe9a44c3166edba0b9" ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-46a ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "Application must be made within 6 weeks of forfeiture order registration." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
