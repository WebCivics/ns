concept:international-war-crimes-tribunals-act-1995-sec-25 a cml:Concept ;
    skos:prefLabel "25 Expiry of Australian sentences while under Tribunal detention"@en ;
    cml:realizedBy doc:sec-25 ;
    values:originalText "If: (a) at the time a person was surrendered to a Tribunal under this Part, the person was serving a sentence of imprisonment in respect of an offence against an Australian law, or was otherwise subject to detention under an Australian law; and (b) each such sentence of imprisonment that the person was serving, or each such period of detention to which the person was subject, at that time expires while the person is being detained by, or on the order of, the Tribunal; the Attorney-General must without delay inform the Tribunal of the expiry and, if the Tribunal was required to give undertakings as referred to in section 19, that the undertakings are no longer required to be complied with." ;
    skos:definition "If: (a) at the time a person was surrendered to a Tribunal under this Part, the person was serving a sentence of imprisonment in respect of an offence against an Australian law, or was otherwise subject to detention under an Australian law; and (b) each such sentence of imprisonment that the person was serving, or each such period of detention to which the person was subject, at that time expires while the person is being detained by, or on the order of, the Tribunal; the Attorney-General must without delay inform the Tribunal of the expiry and, if the Tribunal was required to give undertakings as referred to in section 19, that the undertakings are no longer required to be complied with."@en ;
    cml:integrityHash "242a399659de587a530e4e89b36bee5585e9e8bdfe18f51bffe50e2b44e22108" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Notify Tribunal of sentence expiry" ;
    dc:description "Information about sentence expiry" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <international-war-crimes-tribunals-act-1995.pdf> ;
    dc:source "international-war-crimes-tribunals-act-1995.pdf, p.31" ;
    cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-25-norm .
