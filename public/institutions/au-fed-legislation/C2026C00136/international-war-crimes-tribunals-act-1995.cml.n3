concept:international-war-crimes-tribunals-act-1995-sec-83 a cml:Concept ;
    skos:prefLabel "83 Delegation"@en ;
    cml:realizedBy doc:sec-83 ;
    values:originalText "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act, other than: (a) his or her powers under Part 3; or (b) the power to decide under subsection 26(3), 33(2), 35(2), 36(4), 40(2) or 44(3) not to comply with a request by a Tribunal." ;
    skos:definition "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act, other than: (a) his or her powers under Part 3; or (b) the power to decide under subsection 26(3), 33(2), 35(2), 36(4), 40(2) or 44(3) not to comply with a request by a Tribunal."@en ;
    cml:integrityHash "36d20b4c059d0887aaaa35c0bd29ea93893d5995689125ac9845629551091e8c" ;
    cof:pageNumber "100"^^xsd:integer ;
    skos:note "Attorney-General may delegate powers under this Act to an officer." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
