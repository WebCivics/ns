concept:international-war-crimes-tribunals-act-1995-sec-40ak a cml:Concept ;
    skos:prefLabel "40AK Making false statements in applications"@en ;
    cml:realizedBy doc:sec-40ak ;
    values:originalText "A person commits an offence if: (a) the person makes a statement (whether orally, in a document or in any other way); and (b) the statement: (i) is false or misleading; or (ii) omits any matter or thing without which the statement is misleading; and (c) the statement is made in, or in connection with, a notice under section 40AH. Penalty: Imprisonment for 12 months or 60 penalty units, or both." ;
    skos:definition "A person commits an offence if: (a) the person makes a statement (whether orally, in a document or in any other way); and (b) the statement: (i) is false or misleading; or (ii) omits any matter or thing without which the statement is misleading; and (c) the statement is made in, or in connection with, a notice under section 40AH. Penalty: Imprisonment for 12 months or 60 penalty units, or both."@en ;
    cml:integrityHash "7d1546ba405724144dd54f1482d8d13fcd0a3a7fcee2e85a5e51ae149ebf9de3" ;
    cof:pageNumber "58"^^xsd:integer ;
    skos:note "Making false statements in applications is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
