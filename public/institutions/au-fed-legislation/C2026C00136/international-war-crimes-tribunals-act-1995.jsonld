    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "51(5) Restrictions on personal searches",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
