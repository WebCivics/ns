      "cml:premiseText": "Police officer must exercise powers.",
      "cml:conclusionText": "Subject to section 64."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The police officer's powers overlap with section 64.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 64 defines a specific set of circumstances under which the police officer may exercise their powers.",
      "cml:conclusionText": "The police officer must exercise powers within these circumstances."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Exercising powers without section 64 is implied to be prohibited.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 64 defines the limits of the police officer's powers.",
      "cml:conclusionText": "Without these limits, exercising powers would be unjustified."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "The police officer's powers are diffused by section 64.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 64 defines the scope of the police officer's authority.",
      "cml:conclusionText": "Without this definition, the police officer's powers would be unclear."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Enforces",
      "cml:logicSummary": "Section 64 enforces the police officer's powers.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The police officer must exercise their powers within these limits.",
      "cml:conclusionText": "This ensures that the police officer acts in accordance with the law."
    },
    {
