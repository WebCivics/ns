        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ap-ss-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a3bc5fbafe1d2d26332e8a0bfa1c19565c8ffe289c2e38926a97386a81f37949",
      "skos:note": "Applying Part as if certain references are to specific definitions or sections."
    },
    {
