          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b8067c02842c45b1610e550650fad32e7d71abbdfab6a72274eabcf0ed815fec",
      "skos:note": "Police officer must deliver seized thing to Commissioner of Australian Federal Police."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-77-ss-1",
      "@type": "cof:Section",
      "cof:title": "77(1) Retention of things seized",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(1) If a police officer seizes a thing under this Part, he or she must\ndeliver it into the custody and control of the Commissioner of\nPolice of the Australian Federal Police."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-1-norm",
      "@type": "values:Obligation",
