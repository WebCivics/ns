        }
      ],
      "cml:integrityHash": "4afe86d139e2a8c45b7b1cbbc43f2b87caac0b097132cc09f62a981186b1b32a",
      "skos:note": "The Commissioner must send a thing to a Tribunal upon direction."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-77-ss-4",
      "@type": "cof:Section",
      "cof:title": "77(4) Retention of things seized",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(4) Without limiting the directions that may be given, a direction may\nrequire the Commissioner to send the thing to a Tribunal."
    },
    {
