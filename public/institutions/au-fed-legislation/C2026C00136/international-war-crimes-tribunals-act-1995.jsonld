      "cml:integrityHash": "b5fce96f9de8c62fe3ca1db801bf04535361a34d7d635c4df6ce5d403299d37a",
      "skos:note": "Police officers can conduct warrantless searches in emergency situations under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-63-ss-1",
      "@type": "cof:Section",
      "cof:title": "63(1) Searches without warrant in emergency situations",
      "values:kind": "subsection",
      "cof:pageNumber": 87,
      "values:originalText": "(1) This section applies if a police officer suspects, on reasonable\ngrounds, that:\n(a) evidential material is in or on a conveyance; and\n(b) it is necessary to exercise a power under subsection (2) in\norder to prevent the material from being concealed, lost or\ndestroyed; and\n(c) it is necessary to exercise the power without the authority of\na search warrant because the circumstances are serious and\nurgent."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-1-norm",
      "@type": "values:Prohibition",
