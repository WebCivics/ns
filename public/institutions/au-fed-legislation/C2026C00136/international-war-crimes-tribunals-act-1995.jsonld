    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-34a",
      "@type": "cml:Concept",
      "skos:prefLabel": "34A Authorising application for a stored communications warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-34a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.44",
      "values:originalText": "The Attorney-General may authorise, in writing, the Australian\nFederal Police or the police force or police service of a State to\napply for a stored communications warrant under section 110 of\nthe Telecommunications (Interception and Access) Act 1979 if:\n(a) the Attorney-General is satisfied that:\n(i) a proceeding is before, or an investigation is being\nconducted by, a Tribunal; and\n(ii) there are reasonable grounds to believe that stored\ncommunications relevant to the proceeding or\ninvestigation are held by a carrier; and\n(b) the Tribunal has requested the Attorney-General to arrange\nfor access to the stored communications.\nNote:\nInformation obtained under the warrant may only be communicated to\nthe Tribunal on certain conditions: see subsection 142A(1) of the\nTelecommunications (Interception and Access) Act 1979.\n\n\nOther forms of assistance to a Tribunal  Part 4\nProspective telecommunications data  Division 2B\nSection 34B\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "skos:definition": "The Attorney-General may authorise, in writing, the Australian\nFederal Police or the police force or police service of a State to\napply for a stored communications warrant under section 110 of\nthe Telecommunications (Interception and Access) Act 1979 if:\n(a) the Attorney-General is satisfied that:\n(i) a proceeding is before, or an investigation is being\nconducted by, a Tribunal; and\n(ii) there are reasonable grounds to believe that stored\ncommunications relevant to the proceeding or\ninvestigation are held by a carrier; and\n(b) the Tribunal has requested the Attorney-General to arrange\nfor access to the stored communications.\nNote:\nInformation obtained under the warrant may only be communicated to\nthe Tribunal on certain conditions: see subsection 142A(1) of the\nTelecommunications (Interception and Access) Act 1979.\n\n\nOther forms of assistance to a Tribunal  Part 4\nProspective telecommunications data  Division 2B\nSection 34B\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-34a-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-34a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "68c903c7d8d8a7c4844b5aaa134f53613f63b73974b0b6195ff86723c4505aa6",
      "skos:note": "Authorisation for application of stored communications warrant"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-34a",
      "@type": "cof:Section",
      "cof:title": "34A Authorising application for a stored communications warrant",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "The Attorney-General may authorise, in writing, the Australian\nFederal Police or the police force or police service of a State to\napply for a stored communications warrant under section 110 of\nthe Telecommunications (Interception and Access) Act 1979 if:\n(a) the Attorney-General is satisfied that:\n(i) a proceeding is before, or an investigation is being\nconducted by, a Tribunal; and\n(ii) there are reasonable grounds to believe that stored\ncommunications relevant to the proceeding or\ninvestigation are held by a carrier; and\n(b) the Tribunal has requested the Attorney-General to arrange\nfor access to the stored communications.\nNote:\nInformation obtained under the warrant may only be communicated to\nthe Tribunal on certain conditions: see subsection 142A(1) of the\nTelecommunications (Interception and Access) Act 1979.\n\n\nOther forms of assistance to a Tribunal  Part 4\nProspective telecommunications data  Division 2B\nSection 34B\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-34a-norm",
      "@type": "values:Obligation",
