        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-logic-deontic-1",
