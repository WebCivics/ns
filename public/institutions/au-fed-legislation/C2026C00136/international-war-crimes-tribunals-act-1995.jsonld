          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-argumentation-4"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-alleninterval-5"
        }
      ],
      "cml:integrityHash": "6a14206565c52d0c4b82904621d215d4444bb5607c0c3c8449032465dee3eac0",
      "skos:note": "Seize material or thing if suspected to be relevant to an offence against an Australian law under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-63-ss-3",
      "@type": "cof:Section",
      "cof:title": "63(3) Searches without warrant in emergency situations",
      "values:kind": "subsection",
      "cof:pageNumber": 87,
      "values:originalText": "(3) If, in the course of searching for the material, the police officer\nfinds other evidential material or a thing relevant to an offence\nagainst an Australian law, the police officer may seize that material\nor thing if he or she suspects, on reasonable grounds, that:\n(a) it is necessary to seize it in order to prevent its concealment,\nloss or destruction; and\n(b) it is necessary to seize it without the authority of a search\nwarrant because the circumstances are serious and urgent."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Permission to seize material or thing under certain circumstances.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police Officer suspects on reasonable grounds that it is necessary to seize the material or thing.",
      "cml:conclusionText": "Seize the material or thing."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Believe",
      "cml:logicSummary": "Police Officer must believe on reasonable grounds that seizing the material or thing is necessary.",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police Officer suspects that it is necessary to seize the material or thing.",
      "cml:conclusionText": "Seize the material or thing."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Seizure of material or thing is allowed until circumstances change.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police Officer seizes the material or thing.",
      "cml:conclusionText": "Circumstances may change, and seizure must be lifted."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Imply",
      "cml:logicSummary": "Seizure of material or thing implies that it is necessary to prevent its concealment, loss, or destruction.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police Officer seizes the material or thing.",
      "cml:conclusionText": "Concealment, loss, or destruction must be prevented."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-3-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:logicSummary": "Seizure of material or thing occurs during emergency situation.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police Officer searches for material in emergency situation.",
      "cml:conclusionText": "Emergency situation ends, and seizure must be lifted."
    },
