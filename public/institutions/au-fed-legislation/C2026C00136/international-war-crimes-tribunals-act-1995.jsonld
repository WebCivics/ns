        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-1-logic-descriptionlogic-4"
        }
      ],
      "cml:integrityHash": "79d8d05ed585bcab51f7fe5dbe689afb01002e3c1d90dd3d59763a754cfc2850",
      "skos:note": "Magistrate must inform applicant of warrant terms and signing time. Police officer may apply for warrant by telephone, telex, fax or other electronic means in urgent cases or if delay would frustrate effective execution."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-1",
      "@type": "cof:Section",
      "cof:title": "51(1) Restrictions on personal searches",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(1) A police officer may apply to a magistrate for a warrant by\ntelephone, telex, fax or other electronic means:\n(a) in an urgent case; or\n(b) if the delay that would occur if an application were made in\nperson would frustrate the effective execution of the warrant."
    },
