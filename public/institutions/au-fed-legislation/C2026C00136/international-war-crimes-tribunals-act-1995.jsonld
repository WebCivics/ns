      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.96",
      "values:originalText": "(1) If a police officer seizes a thing under this Part, he or she must\ndeliver it into the custody and control of the Commissioner of\nPolice of the Australian Federal Police.",
      "skos:definition": "(1) If a police officer seizes a thing under this Part, he or she must\ndeliver it into the custody and control of the Commissioner of\nPolice of the Australian Federal Police.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77"
