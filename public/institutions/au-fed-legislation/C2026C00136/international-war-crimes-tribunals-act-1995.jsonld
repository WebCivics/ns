    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-60-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "60(2) Copies of seized things to be provided",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-60-ss-2"
      },
