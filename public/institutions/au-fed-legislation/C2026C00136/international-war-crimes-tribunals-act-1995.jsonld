      },
      "cml:operator": "CONTINUES",
      "cml:logicSummary": "Continues to serve sentence of imprisonment",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person is serving a sentence of imprisonment",
      "cml:conclusionText": "Person continues to serve that sentence of imprisonment"
    },
    {
