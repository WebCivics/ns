    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police officer must take person before magistrate.",
      "cml:conclusionText": "The police officer has a duty to take the person before a magistrate."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEFORE",
      "cml:logicSummary": "Temporal relationship",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The police officer must take the person before a magistrate as soon as practicable.",
      "cml:conclusionText": "The taking of the person before a magistrate occurs before the person is taken into custody."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Inference",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the police officer takes the person before a magistrate, then the person will be brought to justice.",
      "cml:conclusionText": "The police officer taking the person before a magistrate implies that the person will be brought to justice."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "SPREADS_TO",
      "cml:logicSummary": "Inference",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the police officer takes the person before a magistrate, then the news of the arrest spreads to others.",
      "cml:conclusionText": "The taking of the person before a magistrate spreads to other authorities and officials."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "REQUIRES",
      "cml:logicSummary": "Expertise",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The police officer must take the person before a magistrate because it requires expertise in law enforcement.",
      "cml:conclusionText": "The taking of the person before a magistrate requires expertise in law enforcement."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(3) Arrest of persons escaping from custody",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-78-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.98",
      "values:originalText": "(3) If the magistrate is satisfied that the person has escaped from\ncustody authorised by this Act, the magistrate may issue a warrant\nauthorising any police officer to return the person to the custody\nreferred to in subsection (1).",
      "skos:definition": "(3) If the magistrate is satisfied that the person has escaped from\ncustody authorised by this Act, the magistrate may issue a warrant\nauthorising any police officer to return the person to the custody\nreferred to in subsection (1).",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9d10626e655acca790f26587b95f428d890677c0e9c6734a67bba0b4844246f6",
      "skos:note": "Magistrate may issue warrant for police officer to return escaped person to custody."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-78-ss-3",
      "@type": "cof:Section",
      "cof:title": "78(3) Arrest of persons escaping from custody",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(3) If the magistrate is satisfied that the person has escaped from\ncustody authorised by this Act, the magistrate may issue a warrant\nauthorising any police officer to return the person to the custody\nreferred to in subsection (1)."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3"
      },
