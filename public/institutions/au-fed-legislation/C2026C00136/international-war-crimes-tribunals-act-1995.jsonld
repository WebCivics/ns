        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-56-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-56-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-56-ss-3"
        }
