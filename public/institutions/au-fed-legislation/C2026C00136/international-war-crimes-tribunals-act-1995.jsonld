      "cml:operator": "Overlaps",
      "cml:logicSummary": "Describes the temporal overlap between emergency situations and warrantless searches.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
