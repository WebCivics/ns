      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must Not",
      "cml:logicSummary": "Prohibition of compliance due to multiple reasons",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The Attorney-General must not comply with the request if...",
      "cml:conclusionText": "...there are special circumstances justifying non-compliance; and complying with the request would prejudice Australia’s sovereignty, security or national interest."
    },
    {
