    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32c",
      "@type": "cml:Concept",
      "skos:prefLabel": "32C Providing forensic evidence to the Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-32c"
      },
      "cml:curationStatus": {
