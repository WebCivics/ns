      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Prisoners must provide evidence or assistance in a foreign country.",
      "cml:executionSurface": "modalities::logic::deontic",
