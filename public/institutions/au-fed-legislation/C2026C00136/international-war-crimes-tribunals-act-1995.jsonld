        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "4ec5dce0fc78f934f7e1c3354269d0e4026d3ae97953d163080e456e73d24cfe",
      "skos:note": "Police officer may not enter premises without power to arrest."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-65-ss-1",
      "@type": "cof:Section",
      "cof:title": "65(1) Power to enter premises to arrest person",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
      "values:originalText": "(1) Subject to subsection (2), if:\n(a) a police officer has, under this Act or pursuant to a warrant\nissued under this Act, power to arrest a person; and\n(b) the police officer believes on reasonable grounds that the\nperson is on any premises; the police officer may enter the\npremises, using such force as is necessary and reasonable in\nthe circumstances, at any time of the day or night for the\npurpose of searching the premises for the person or arresting\nthe person."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
