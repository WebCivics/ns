    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 The objects of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.9",
      "values:originalText": "The objects of this Act are to enable the Commonwealth to\nco-operate with a Tribunal in the investigation and prosecution of\npersons accused of committing Tribunal offences, and, in\nparticular:\n(a) to enable the Tribunal to make requests for assistance (see",
      "skos:definition": "The objects of this Act are to enable the Commonwealth to\nco-operate with a Tribunal in the investigation and prosecution of\npersons accused of committing Tribunal offences, and, in\nparticular:\n(a) to enable the Tribunal to make requests for assistance (see",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-3-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4fb9668ca9512b068eaf8251e7fa2d473b2f79148b04019b6566a30fc025b6fd",
      "skos:note": "Enable cooperation with Tribunal in investigation and prosecution of persons accused of committing Tribunal offences."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 The objects of this Act",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The objects of this Act are to enable the Commonwealth to\nco-operate with a Tribunal in the investigation and prosecution of\npersons accused of committing Tribunal offences, and, in\nparticular:\n(a) to enable the Tribunal to make requests for assistance (see"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-3-norm",
