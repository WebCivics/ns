    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AA Application of Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.52",
      "values:originalText": "This Division applies if:\n(a) a Tribunal makes a request (a proceeds request) to the\nAttorney-General for the identification, tracing, and freezing\nor seizure, of the proceeds of a Tribunal offence; and\n(b) the Attorney-General is satisfied that a person (the\ndefendant):\n(i) has been, or is about to be, charged with the Tribunal\noffence before the Tribunal; or\n(ii) has been convicted by the Tribunal of the Tribunal\noffence.",
      "skos:definition": "This Division applies if:\n(a) a Tribunal makes a request (a proceeds request) to the\nAttorney-General for the identification, tracing, and freezing\nor seizure, of the proceeds of a Tribunal offence; and\n(b) the Attorney-General is satisfied that a person (the\ndefendant):\n(i) has been, or is about to be, charged with the Tribunal\noffence before the Tribunal; or\n(ii) has been convicted by the Tribunal of the Tribunal\noffence.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aa-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1802daf321391e16738c28c464ff63c816089c0c4d881e2d395154ae0952e605",
      "skos:note": "Request for Attorney-General's identification and tracing of proceeds of Tribunal offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40aa",
      "@type": "cof:Section",
      "cof:title": "40AA Application of Division",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "This Division applies if:\n(a) a Tribunal makes a request (a proceeds request) to the\nAttorney-General for the identification, tracing, and freezing\nor seizure, of the proceeds of a Tribunal offence; and\n(b) the Attorney-General is satisfied that a person (the\ndefendant):\n(i) has been, or is about to be, charged with the Tribunal\noffence before the Tribunal; or\n(ii) has been convicted by the Tribunal of the Tribunal\noffence."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aa-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aa"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aa-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires Attorney-General's satisfaction",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Attorney-General is satisfied",
      "cml:conclusionText": "Request made"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ab",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AB Authorising applications under the Proceeds of Crime Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ab"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.52",
      "values:originalText": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act 2002 as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n(a) relates to a proceeding before, or an investigation conducted\nby, the Tribunal; and\n(b) is for assistance that can be obtained from one or more\nproduction orders, monitoring orders or search warrants\nunder the Proceeds of Crime Act 2002.\nNote:\nSee Subdivision B for proceeds requests that involve the making of a\nrestraining order.\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences",
      "skos:definition": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act 2002 as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n(a) relates to a proceeding before, or an investigation conducted\nby, the Tribunal; and\n(b) is for assistance that can be obtained from one or more\nproduction orders, monitoring orders or search warrants\nunder the Proceeds of Crime Act 2002.\nNote:\nSee Subdivision B for proceeds requests that involve the making of a\nrestraining order.\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ab-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ab-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9011cafb6d48d80a452b536da04af1cfe74cf532ebb6a00cd52a0149362e9345",
      "skos:note": "The Attorney-General may authorise an officer to make applications under the Proceeds of Crime Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ab",
      "@type": "cof:Section",
      "cof:title": "40AB Authorising applications under the Proceeds of Crime Act",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act 2002 as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n(a) relates to a proceeding before, or an investigation conducted\nby, the Tribunal; and\n(b) is for assistance that can be obtained from one or more\nproduction orders, monitoring orders or search warrants\nunder the Proceeds of Crime Act 2002.\nNote:\nSee Subdivision B for proceeds requests that involve the making of a\nrestraining order.\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ab-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ab"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ab-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "The Attorney-General may authorise an officer.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ac",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AC Applying for and making restraining orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ac"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.53",
      "values:originalText": "(1) If the proceeds request involves the making of a restraining order,\nthe Attorney-General may authorise a proceeds of crime authority\nto apply for a restraining order against the property concerned.\n(2) If so authorised, a proceeds of crime authority may apply for such\na restraining order against that property in respect of the Tribunal\noffence.\n(3) Part 2-1 of the Proceeds of Crime Act 2002 applies to the\napplication, and to any restraining order made as a result.\n(4) That Part applies as if:\n(a) references in that Part to an indictable offence were\nreferences to the Tribunal offence that is the subject of the\nproceeds request; and\n(b) references in that Part to a person charged with an indictable\noffence were references to a person against whom a criminal\nproceeding in respect of a Tribunal offence has commenced\nin the Tribunal; and\n(c) references in that Part to it being proposed to charge a person\nwith an indictable offence were references to it being\nreasonably suspected that criminal proceedings are about to\ncommence against the person in the Tribunal in respect of a\nTribunal offence; and\n(d) paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and\nsections 18 to 20A, 29, 29A and 44 to 45A of that Act were\nomitted.",
      "skos:definition": "(1) If the proceeds request involves the making of a restraining order,\nthe Attorney-General may authorise a proceeds of crime authority\nto apply for a restraining order against the property concerned.\n(2) If so authorised, a proceeds of crime authority may apply for such\na restraining order against that property in respect of the Tribunal\noffence.\n(3) Part 2-1 of the Proceeds of Crime Act 2002 applies to the\napplication, and to any restraining order made as a result.\n(4) That Part applies as if:\n(a) references in that Part to an indictable offence were\nreferences to the Tribunal offence that is the subject of the\nproceeds request; and\n(b) references in that Part to a person charged with an indictable\noffence were references to a person against whom a criminal\nproceeding in respect of a Tribunal offence has commenced\nin the Tribunal; and\n(c) references in that Part to it being proposed to charge a person\nwith an indictable offence were references to it being\nreasonably suspected that criminal proceedings are about to\ncommence against the person in the Tribunal in respect of a\nTribunal offence; and\n(d) paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and\nsections 18 to 20A, 29, 29A and 44 to 45A of that Act were\nomitted.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4"
        }
      ],
      "cml:integrityHash": "8ce8c23463f73af8f59d478eda0f31bf770d709bee6eb9258b055336ed2be8c5"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ac",
      "@type": "cof:Section",
      "cof:title": "40AC Applying for and making restraining orders",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "(1) If the proceeds request involves the making of a restraining order,\nthe Attorney-General may authorise a proceeds of crime authority\nto apply for a restraining order against the property concerned.\n(2) If so authorised, a proceeds of crime authority may apply for such\na restraining order against that property in respect of the Tribunal\noffence.\n(3) Part 2-1 of the Proceeds of Crime Act 2002 applies to the\napplication, and to any restraining order made as a result.\n(4) That Part applies as if:\n(a) references in that Part to an indictable offence were\nreferences to the Tribunal offence that is the subject of the\nproceeds request; and\n(b) references in that Part to a person charged with an indictable\noffence were references to a person against whom a criminal\nproceeding in respect of a Tribunal offence has commenced\nin the Tribunal; and\n(c) references in that Part to it being proposed to charge a person\nwith an indictable offence were references to it being\nreasonably suspected that criminal proceedings are about to\ncommence against the person in the Tribunal in respect of a\nTribunal offence; and\n(d) paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and\nsections 18 to 20A, 29, 29A and 44 to 45A of that Act were\nomitted."
    },
