      ],
      "cml:integrityHash": "162357a7dbbf90f99eb3d024e1e8cde16cb0a460be30e17625eb68f93606a56a",
      "skos:note": "Person with interest in property may apply for order under subsection (2) if not convicted of related offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-46a-ss-1",
