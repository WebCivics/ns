    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aj",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AJ Protection from suits etc. for those complying with notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40aj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.57",
      "values:originalText": "(1) No action, suit or proceeding lies against:\n(a) a financial institution; or\n(b) an officer, employee or agent of the institution acting in the\ncourse of that person’s employment or agency;\nin relation to any action taken by the institution or person under a\nnotice under section 40AH or in the mistaken belief that action was\nrequired under the notice.",
      "skos:definition": "(1) No action, suit or proceeding lies against:\n(a) a financial institution; or\n(b) an officer, employee or agent of the institution acting in the\ncourse of that person’s employment or agency;\nin relation to any action taken by the institution or person under a\nnotice under section 40AH or in the mistaken belief that action was\nrequired under the notice.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aj-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ae45233b6a6a31e116aa2c3c03b60505db5ad16311e9f6b59d457df268fbfe0b",
      "skos:note": "No action against financial institution or its employees for actions taken under notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40aj",
      "@type": "cof:Section",
      "cof:title": "40AJ Protection from suits etc. for those complying with notices",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "(1) No action, suit or proceeding lies against:\n(a) a financial institution; or\n(b) an officer, employee or agent of the institution acting in the\ncourse of that person’s employment or agency;\nin relation to any action taken by the institution or person under a\nnotice under section 40AH or in the mistaken belief that action was\nrequired under the notice."
    },
