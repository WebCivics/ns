    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40af",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AF Applying for and making production orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40af"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.55",
      "values:originalText": "(1) An authorised officer may apply for a production order under the\nProceeds of Crime Act 2002 in respect of the Tribunal offence that\nis the subject of the proceeds request, if authorised to do so by the\nAttorney-General under section 40AB.\n(2) Part 3-2 of the Proceeds of Crime Act 2002 applies to the\napplication, and to any production order made as a result.\n(3) That Part applies as if:\n(a) references in that Part to an indictable offence or to a serious\noffence were references to the Tribunal offence that is the\nsubject of the proceeds request; and\n(b) subparagraphs 202(5)(a)(ii) and (c)(ii), paragraph 202(5)(e)\nand subsection 205(1) of that Act were omitted.",
      "skos:definition": "(1) An authorised officer may apply for a production order under the\nProceeds of Crime Act 2002 in respect of the Tribunal offence that\nis the subject of the proceeds request, if authorised to do so by the\nAttorney-General under section 40AB.\n(2) Part 3-2 of the Proceeds of Crime Act 2002 applies to the\napplication, and to any production order made as a result.\n(3) That Part applies as if:\n(a) references in that Part to an indictable offence or to a serious\noffence were references to the Tribunal offence that is the\nsubject of the proceeds request; and\n(b) subparagraphs 202(5)(a)(ii) and (c)(ii), paragraph 202(5)(e)\nand subsection 205(1) of that Act were omitted.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40af-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40af-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40af-ss-3"
        }
      ],
      "cml:integrityHash": "77f858cf3df17c5cc9d9d4e2c9da39d24e557f98519a89601f63cc90187c7b84"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40af",
      "@type": "cof:Section",
      "cof:title": "40AF Applying for and making production orders",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "(1) An authorised officer may apply for a production order under the\nProceeds of Crime Act 2002 in respect of the Tribunal offence that\nis the subject of the proceeds request, if authorised to do so by the\nAttorney-General under section 40AB.\n(2) Part 3-2 of the Proceeds of Crime Act 2002 applies to the\napplication, and to any production order made as a result.\n(3) That Part applies as if:\n(a) references in that Part to an indictable offence or to a serious\noffence were references to the Tribunal offence that is the\nsubject of the proceeds request; and\n(b) subparagraphs 202(5)(a)(ii) and (c)(ii), paragraph 202(5)(e)\nand subsection 205(1) of that Act were omitted."
    },
