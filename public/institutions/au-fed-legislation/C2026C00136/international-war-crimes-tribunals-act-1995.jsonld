    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Occupier entitled to be present during search",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.85",
      "values:originalText": "(1) If a warrant in relation to premises is being executed and the\noccupier of the premises or another person who apparently\nrepresents the occupier is present at the premises, the person is\nentitled to observe the search being conducted.\n(2) The right to observe the search being conducted ceases if the\nperson impedes the search.\n(3) This section does not prevent 2 or more areas of the premises being\nsearched at the same time.",
      "skos:definition": "(1) If a warrant in relation to premises is being executed and the\noccupier of the premises or another person who apparently\nrepresents the occupier is present at the premises, the person is\nentitled to observe the search being conducted.\n(2) The right to observe the search being conducted ceases if the\nperson impedes the search.\n(3) This section does not prevent 2 or more areas of the premises being\nsearched at the same time.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-61-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-61-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-61-ss-3"
        }
      ],
      "cml:integrityHash": "b693e272c5c0b6b0674793556b1d593a90519623da204990b6d1eb0277ce8964"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-61",
      "@type": "cof:Section",
      "cof:title": "61 Occupier entitled to be present during search",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "(1) If a warrant in relation to premises is being executed and the\noccupier of the premises or another person who apparently\nrepresents the occupier is present at the premises, the person is\nentitled to observe the search being conducted.\n(2) The right to observe the search being conducted ceases if the\nperson impedes the search.\n(3) This section does not prevent 2 or more areas of the premises being\nsearched at the same time."
    },
