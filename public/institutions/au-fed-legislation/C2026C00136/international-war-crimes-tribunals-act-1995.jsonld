      ],
      "cml:integrityHash": "cc3f5f002bce24025a29488911541efc471ee3277a6e7518e1ada01b2f43a6fc",
      "skos:note": "Provide completed warrant form and sworn information within a specified timeframe. Application must include required information to obtain a warrant.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-3",
      "@type": "cof:Section",
      "cof:title": "51(3) Restrictions on personal searches",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(3) An application under this section must include all information\nrequired to be provided in an ordinary application for a warrant,\nbut the application may, if necessary, be made before the\ninformation is sworn."
    },
