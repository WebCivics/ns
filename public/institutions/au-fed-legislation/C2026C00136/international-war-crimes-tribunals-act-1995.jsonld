    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AK Making false statements in applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ak"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.58",
      "values:originalText": "A person commits an offence if:\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n(b) the statement:\n(i) is false or misleading; or\n(ii) omits any matter or thing without which the statement is\nmisleading; and\n(c) the statement is made in, or in connection with, a notice\nunder section 40AH.\nPenalty: Imprisonment for 12 months or 60 penalty units, or both.",
      "skos:definition": "A person commits an offence if:\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n(b) the statement:\n(i) is false or misleading; or\n(ii) omits any matter or thing without which the statement is\nmisleading; and\n(c) the statement is made in, or in connection with, a notice\nunder section 40AH.\nPenalty: Imprisonment for 12 months or 60 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ak-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ak-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7d1546ba405724144dd54f1482d8d13fcd0a3a7fcee2e85a5e51ae149ebf9de3",
      "skos:note": "Making false statements in applications is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ak",
      "@type": "cof:Section",
      "cof:title": "40AK Making false statements in applications",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "A person commits an offence if:\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n(b) the statement:\n(i) is false or misleading; or\n(ii) omits any matter or thing without which the statement is\nmisleading; and\n(c) the statement is made in, or in connection with, a notice\nunder section 40AH.\nPenalty: Imprisonment for 12 months or 60 penalty units, or both."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ak-norm",
