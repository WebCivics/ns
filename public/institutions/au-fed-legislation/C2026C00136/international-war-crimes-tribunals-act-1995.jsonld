        }
      ],
      "cml:integrityHash": "1075239720abf63310f06d749f73e9d3ecf259a3cd8c55ddbaff90aaa7cc719f",
      "skos:note": "Police officer may arrest person released on bail if reasonable grounds exist."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-79-ss-1",
      "@type": "cof:Section",
      "cof:title": "79(1) Arrest of person released on bail",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(1) A police officer may, without warrant, arrest a person who has\nbeen released on bail under this Act if the police officer has\nreasonable grounds for believing that the person has contravened,\nor is about to contravene, a term or condition of a recognisance on\nwhich bail was granted to the person."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-79-ss-1-norm",
