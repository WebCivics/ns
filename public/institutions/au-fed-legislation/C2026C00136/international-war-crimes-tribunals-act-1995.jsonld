      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal interval during which person is in custody outside Australia",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person is in custody in connection with the request",
      "cml:conclusionText": "Temporal interval during which person is in custody outside Australia >= temporal interval during which person is serving sentence of imprisonment"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal interval during which person is released from prison pursuant to a request by a Tribunal",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person is released from a prison pursuant to a request by a Tribunal under section 36",
      "cml:conclusionText": "Temporal interval during which person is released from prison pursuant to a request by a Tribunal >= temporal interval during which person is serving sentence of imprisonment"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "Combination of conditions for continuation of imprisonment sentence",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person is in custody in connection with the request AND person is released from a prison pursuant to a request by a Tribunal under section 36",
      "cml:conclusionText": "Person continues to serve that sentence of imprisonment AND person is subject to detention under Commonwealth law"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
