    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aq",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AQ Contents of POCA search warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40aq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.61",
      "values:originalText": "A POCA search warrant in relation to a Tribunal offence must state\nthat the warrant authorises the seizure of property or a thing found\nby an authorised officer, or a person assisting in relation to the\nwarrant, in the course of the search if the authorised officer or\nperson assisting believes on reasonable grounds that:\n(a) the property or thing:\n(i) is proceeds of the Tribunal offence that are not of a kind\nspecified in the warrant; or\n(ii) is evidential material relating to the Tribunal offence\nthat is not of a kind specified in the warrant; or\n(iii) is proceeds of, or evidential material relating to, another\nTribunal offence in relation to which a POCA search\nwarrant is in force; or\n(iv) is relevant to a proceeding in the Tribunal in respect of\nthe Tribunal offence; or\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 40AP(3)(d), the POCA search warrant must also\nstate the matters set out in section 227 of the Proceeds of Crime Act\n2002.",
      "skos:definition": "A POCA search warrant in relation to a Tribunal offence must state\nthat the warrant authorises the seizure of property or a thing found\nby an authorised officer, or a person assisting in relation to the\nwarrant, in the course of the search if the authorised officer or\nperson assisting believes on reasonable grounds that:\n(a) the property or thing:\n(i) is proceeds of the Tribunal offence that are not of a kind\nspecified in the warrant; or\n(ii) is evidential material relating to the Tribunal offence\nthat is not of a kind specified in the warrant; or\n(iii) is proceeds of, or evidential material relating to, another\nTribunal offence in relation to which a POCA search\nwarrant is in force; or\n(iv) is relevant to a proceeding in the Tribunal in respect of\nthe Tribunal offence; or\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 40AP(3)(d), the POCA search warrant must also\nstate the matters set out in section 227 of the Proceeds of Crime Act\n2002.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aq-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aq-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9370e0e1854ceecbc5fa3a735fd171c866f4dd7112f7fbafed04e55a54d32cab",
      "skos:note": "POCA search warrant must state that seizure of property is necessary to prevent concealment, loss or destruction."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40aq",
      "@type": "cof:Section",
      "cof:title": "40AQ Contents of POCA search warrants",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "A POCA search warrant in relation to a Tribunal offence must state\nthat the warrant authorises the seizure of property or a thing found\nby an authorised officer, or a person assisting in relation to the\nwarrant, in the course of the search if the authorised officer or\nperson assisting believes on reasonable grounds that:\n(a) the property or thing:\n(i) is proceeds of the Tribunal offence that are not of a kind\nspecified in the warrant; or\n(ii) is evidential material relating to the Tribunal offence\nthat is not of a kind specified in the warrant; or\n(iii) is proceeds of, or evidential material relating to, another\nTribunal offence in relation to which a POCA search\nwarrant is in force; or\n(iv) is relevant to a proceeding in the Tribunal in respect of\nthe Tribunal offence; or\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 40AP(3)(d), the POCA search warrant must also\nstate the matters set out in section 227 of the Proceeds of Crime Act\n2002."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aq-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aq"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40aq-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "POCA search warrant imposes an obligation on the state to seize property if necessary.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ar",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AR Seizure of certain property or things found in the course of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ar"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.62",
      "values:originalText": "search\nA POCA search warrant in relation to a Tribunal offence authorises\nan authorised officer, or a person assisting in relation to the\nwarrant, to seize property or a thing found by the authorised officer\nor person assisting in the course of the search if the authorised\nofficer or person assisting believes on reasonable grounds that:\n(a) the property or thing:\n(i) is proceeds of the Tribunal offence that are not of a kind\nspecified in the warrant; or\n(ii) is evidential material relating to the Tribunal offence\nthat is not of a kind specified in the warrant; or\n(iii) is proceeds of, or evidential material relating to, another\nTribunal offence in relation to which a POCA search\nwarrant is in force; or\n(iv) is relevant to a proceeding in the Tribunal in respect of\nthe Tribunal offence; or\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 40AP(3)(d), the POCA search warrant also\nauthorises the things set out in section 228 of the Proceeds of Crime\nAct 2002.",
      "skos:definition": "search\nA POCA search warrant in relation to a Tribunal offence authorises\nan authorised officer, or a person assisting in relation to the\nwarrant, to seize property or a thing found by the authorised officer\nor person assisting in the course of the search if the authorised\nofficer or person assisting believes on reasonable grounds that:\n(a) the property or thing:\n(i) is proceeds of the Tribunal offence that are not of a kind\nspecified in the warrant; or\n(ii) is evidential material relating to the Tribunal offence\nthat is not of a kind specified in the warrant; or\n(iii) is proceeds of, or evidential material relating to, another\nTribunal offence in relation to which a POCA search\nwarrant is in force; or\n(iv) is relevant to a proceeding in the Tribunal in respect of\nthe Tribunal offence; or\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 40AP(3)(d), the POCA search warrant also\nauthorises the things set out in section 228 of the Proceeds of Crime\nAct 2002.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ar-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ar-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "93ebbd9422afa3016ac84dcec6611404c4d78154ef2ad148b597c05c4cb1f325",
      "skos:note": "Seizure of property or things found during a search warrant is prohibited unless certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ar",
      "@type": "cof:Section",
      "cof:title": "40AR Seizure of certain property or things found in the course of",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "search\nA POCA search warrant in relation to a Tribunal offence authorises\nan authorised officer, or a person assisting in relation to the\nwarrant, to seize property or a thing found by the authorised officer\nor person assisting in the course of the search if the authorised\nofficer or person assisting believes on reasonable grounds that:\n(a) the property or thing:\n(i) is proceeds of the Tribunal offence that are not of a kind\nspecified in the warrant; or\n(ii) is evidential material relating to the Tribunal offence\nthat is not of a kind specified in the warrant; or\n(iii) is proceeds of, or evidential material relating to, another\nTribunal offence in relation to which a POCA search\nwarrant is in force; or\n(iv) is relevant to a proceeding in the Tribunal in respect of\nthe Tribunal offence; or\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 40AP(3)(d), the POCA search warrant also\nauthorises the things set out in section 228 of the Proceeds of Crime\nAct 2002."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ar-norm",
