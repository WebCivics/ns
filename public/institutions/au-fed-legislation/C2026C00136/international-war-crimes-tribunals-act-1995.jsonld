      },
      "cml:premiseText": "the police officer may enter the premises, using such force as is necessary and reasonable in the circumstances;",
      "cml:conclusionText": "there is a temporal overlap between entering and searching."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Recurring trace of police officer's actions.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the police officer may enter the premises, using such force as is necessary and reasonable in the circumstances;",
      "cml:conclusionText": "there is a recurring trace of the police officer's actions."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
