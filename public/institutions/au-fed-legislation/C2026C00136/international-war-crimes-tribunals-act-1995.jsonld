      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to conduct frisk search",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Police officer has authority to arrest",
      "cml:conclusionText": "Police officer may conduct frisk search"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-69",
      "@type": "cml:Concept",
      "skos:prefLabel": "69 Power to conduct an ordinary search of an arrested person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-69"
      },
      "cml:curationStatus": {
