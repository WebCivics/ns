      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.82",
      "values:originalText": "(3) Equipment may be seized under paragraph (2)(a) only if:\n(a) it is not practicable to put the material in documentary form\nas mentioned in paragraph (2)(b) or to copy the material as\nmentioned in paragraph (2)(c); or\n(b) possession by the occupier of the equipment could constitute\nan offence against an Australian law.",
      "skos:definition": "(3) Equipment may be seized under paragraph (2)(a) only if:\n(a) it is not practicable to put the material in documentary form\nas mentioned in paragraph (2)(b) or to copy the material as\nmentioned in paragraph (2)(c); or\n(b) possession by the occupier of the equipment could constitute\nan offence against an Australian law.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-58"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-58-ss-3-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-58-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "63be44aeecf5d37d99abb64f802d54159401c67721dabffd7df7ca9ce8d25df4",
      "skos:note": "Equipment seizure under certain conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-58-ss-3",
      "@type": "cof:Section",
      "cof:title": "58(3) Use of electronic equipment at premises",
      "values:kind": "subsection",
      "cof:pageNumber": 82,
      "values:originalText": "(3) Equipment may be seized under paragraph (2)(a) only if:\n(a) it is not practicable to put the material in documentary form\nas mentioned in paragraph (2)(b) or to copy the material as\nmentioned in paragraph (2)(c); or\n(b) possession by the occupier of the equipment could constitute\nan offence against an Australian law."
    },
