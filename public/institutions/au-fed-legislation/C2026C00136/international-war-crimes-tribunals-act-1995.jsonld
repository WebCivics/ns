    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-19-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exemption",
      "cml:logicSummary": "Exempts persons released on parole or licence from serving a sentence of imprisonment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) For the purposes of this section, the person is not taken to be\nserving a sentence of imprisonment...",
      "cml:conclusionText": "...or has been otherwise conditionally released..."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-19-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Defines the temporal relationship between parole/release and imprisonment.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) For the purposes of this section, the person is not taken to be\nserving a sentence of imprisonment...",
      "cml:conclusionText": "...for the remainder of the\nsentence or period of detention."
    },
