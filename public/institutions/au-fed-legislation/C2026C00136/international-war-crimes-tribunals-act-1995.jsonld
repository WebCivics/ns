    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "51(3) Restrictions on personal searches",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.78",
      "values:originalText": "(3) An application under this section must include all information\nrequired to be provided in an ordinary application for a warrant,\nbut the application may, if necessary, be made before the\ninformation is sworn.",
      "skos:definition": "(3) An application under this section must include all information\nrequired to be provided in an ordinary application for a warrant,\nbut the application may, if necessary, be made before the\ninformation is sworn.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-3-norm"
        },
