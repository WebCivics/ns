        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-5-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "525900f68d50ec6772787ae9037d2670cff455554f0e296f5cabfe7d5ee286f1",
      "skos:note": "Grant leave to a person under certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-46a-ss-5",
