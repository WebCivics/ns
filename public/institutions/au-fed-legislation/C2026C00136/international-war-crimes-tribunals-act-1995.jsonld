    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-50-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of seizure unless on reasonable grounds.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
