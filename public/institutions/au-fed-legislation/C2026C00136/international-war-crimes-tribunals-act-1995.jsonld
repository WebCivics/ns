      },
      "cml:premiseText": "(2) If the warrant states that it may be executed only during particular hours, it must not be executed outside those hours.",
      "cml:conclusionText": "The execution is restricted until the specified hours."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-49-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "only-if",
      "cml:logicSummary": "Conditional restriction",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If the warrant states that it may be executed only during particular hours, it must not be executed outside those hours.",
      "cml:conclusionText": "The execution is only possible if the specified hours are met."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-49-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
