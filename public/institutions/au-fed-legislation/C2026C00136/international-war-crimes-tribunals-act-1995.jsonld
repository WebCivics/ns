    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "29(4) Legal representation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-29-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.34",
      "values:originalText": "(4) In this section:\nvideo link means a video and sound system that enables persons\nassembled in the Tribunal’s premises (or premises nominated by\nthe Tribunal) to see, hear and talk to persons assembled in a place\nin another country.",
      "skos:definition": "(4) In this section:\nvideo link means a video and sound system that enables persons\nassembled in the Tribunal’s premises (or premises nominated by\nthe Tribunal) to see, hear and talk to persons assembled in a place\nin another country.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-4-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-4-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "e15a2634a047339d7d60b502659294aaa2f34bd53166360d31ee591e10d09ac4",
      "skos:note": "Definition of video link"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-29-ss-4",
      "@type": "cof:Section",
      "cof:title": "29(4) Legal representation",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(4) In this section:\nvideo link means a video and sound system that enables persons\nassembled in the Tribunal’s premises (or premises nominated by\nthe Tribunal) to see, hear and talk to persons assembled in a place\nin another country."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-4-norm",
