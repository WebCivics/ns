      },
      "cml:premiseText": "(c) it is necessary to exercise the power without the authority of a search warrant because the circumstances are serious and urgent.",
      "cml:conclusionText": "Police officers have an obligation to act in emergencies."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
