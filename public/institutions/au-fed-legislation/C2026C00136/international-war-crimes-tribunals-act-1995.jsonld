    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-79-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "79(2) Arrest of person released on bail",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-79-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
