    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-73",
      "@type": "cml:Concept",
      "skos:prefLabel": "73 Conduct of ordinary searches and frisk searches",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-73"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
