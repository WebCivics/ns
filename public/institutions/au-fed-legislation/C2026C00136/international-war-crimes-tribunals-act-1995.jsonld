    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Some Territories to be regarded as States",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.18",
      "values:originalText": "For the purposes of this Act, the Australian Capital Territory and\nthe Northern Territory are to be regarded as States, and are not to\nbe regarded as Territories.",
      "skos:definition": "For the purposes of this Act, the Australian Capital Territory and\nthe Northern Territory are to be regarded as States, and are not to\nbe regarded as Territories.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-5-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6e9dd318ba74dbaa4eebee4a4000ab1b56a708c2e697597e6c207394cceee6c5",
      "skos:note": "Australian Capital Territory and Northern Territory are regarded as States."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Some Territories to be regarded as States",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "For the purposes of this Act, the Australian Capital Territory and\nthe Northern Territory are to be regarded as States, and are not to\nbe regarded as Territories."
    },
