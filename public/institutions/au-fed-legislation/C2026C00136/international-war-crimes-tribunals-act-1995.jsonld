    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-70",
      "@type": "cml:Concept",
      "skos:prefLabel": "70 Power to conduct search of arrested person’s premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-70"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.91",
      "values:originalText": "A police officer who arrests a person at premises under this Act or\npursuant to a warrant issued under this Act, or who is present at\nsuch an arrest, may seize things in plain view at those premises that\nthe police officer believes on reasonable grounds to be:\n(a) evidential material relating to the Tribunal offence to which\nthe person’s custody relates; or\n(b) seizable items.",
      "skos:definition": "A police officer who arrests a person at premises under this Act or\npursuant to a warrant issued under this Act, or who is present at\nsuch an arrest, may seize things in plain view at those premises that\nthe police officer believes on reasonable grounds to be:\n(a) evidential material relating to the Tribunal offence to which\nthe person’s custody relates; or\n(b) seizable items.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-70-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-70-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9cc1c226e56601a1351b2993ab54866525a0bf9c02f947ae6115bc9364605f2f",
      "skos:note": "Police officer may not seize things in plain view at premises without reasonable grounds."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Power to conduct search of arrested person’s premises",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "A police officer who arrests a person at premises under this Act or\npursuant to a warrant issued under this Act, or who is present at\nsuch an arrest, may seize things in plain view at those premises that\nthe police officer believes on reasonable grounds to be:\n(a) evidential material relating to the Tribunal offence to which\nthe person’s custody relates; or\n(b) seizable items."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-70-norm",
