        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If the warrant states that it may be executed only during particular hours, it must not be executed outside those hours.",
      "cml:conclusionText": "The execution is restricted to the specified hours."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-49-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal restriction",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
