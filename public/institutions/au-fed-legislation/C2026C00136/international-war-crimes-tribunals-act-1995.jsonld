      },
      "cml:premiseText": "Special circumstances justifying non-compliance",
      "cml:conclusionText": "Non-compliance is justified if special circumstances exist."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-44-ss-3-logic-ltl-3",
