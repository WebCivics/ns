      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.74",
      "values:originalText": "(2) Paragraph (1)(e) does not prevent the issue of successive warrants\nin relation to the same premises or person.",
      "skos:definition": "(2) Paragraph (1)(e) does not prevent the issue of successive warrants\nin relation to the same premises or person.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-48"
      },
      "cml:asserts": [
