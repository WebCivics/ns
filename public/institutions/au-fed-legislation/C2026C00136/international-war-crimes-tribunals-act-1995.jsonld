    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-62",
      "@type": "cof:Section",
      "cof:title": "62 Receipts for things seized under warrant",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "(1) If a thing is seized under a warrant or moved under\nsubsection 57(2), the executing officer or an officer assisting must\nprovide a receipt for the thing."
