        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
