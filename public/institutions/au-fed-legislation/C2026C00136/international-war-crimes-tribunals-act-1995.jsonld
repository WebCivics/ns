      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.23",
      "values:originalText": "The Attorney-General must, by written notice in the statutory form,\ndirect a magistrate to cancel a warrant if the person has not been\narrested under the warrant and:\n(a) the Attorney-General is satisfied that a request from a\nTribunal that would oblige the Attorney-General to issue a\nnotice under section 9 in relation to the person will not be\nreceived; or\n(b) the Attorney-General considers for any other reason that the\nwarrant should be cancelled.",
      "skos:definition": "The Attorney-General must, by written notice in the statutory form,\ndirect a magistrate to cancel a warrant if the person has not been\narrested under the warrant and:\n(a) the Attorney-General is satisfied that a request from a\nTribunal that would oblige the Attorney-General to issue a\nnotice under section 9 in relation to the person will not be\nreceived; or\n(b) the Attorney-General considers for any other reason that the\nwarrant should be cancelled.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-alleninterval-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-ltl-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-diffusion-4"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "eeefa0a22823b4671095b146e5006b562da1fc204ec4c6e51dd6b72d27b43a4d",
      "skos:note": "The Attorney-General must cancel a warrant if certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Cancellation of warrants",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "The Attorney-General must, by written notice in the statutory form,\ndirect a magistrate to cancel a warrant if the person has not been\narrested under the warrant and:\n(a) the Attorney-General is satisfied that a request from a\nTribunal that would oblige the Attorney-General to issue a\nnotice under section 9 in relation to the person will not be\nreceived; or\n(b) the Attorney-General considers for any other reason that the\nwarrant should be cancelled."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Attorney-General must cancel a warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has not been arrested under the warrant.",
      "cml:conclusionText": "Cancel the warrant."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "The cancellation must occur after the person has not been arrested.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has not been arrested under the warrant.",
      "cml:conclusionText": "Cancel the warrant after the person has not been arrested."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "The cancellation must occur before a certain time.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9.",
      "cml:conclusionText": "Cancel the warrant if no such request is received within a certain time."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "The cancellation must be related to both conditions.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has not been arrested under the warrant and A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9.",
      "cml:conclusionText": "Cancel the warrant if both conditions are met."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-11-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "The cancellation is related to a request from a Tribunal.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9.",
      "cml:conclusionText": "The warrant should be cancelled if no such request is received."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Remand",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.23",
      "values:originalText": "(1) A person who is arrested under a warrant must, as soon as\npracticable:\n(a) be given a written notice that:\n(i) specifies the Tribunal offence in respect of which the\nwarrant was issued; and\n(ii) describes the conduct that is alleged to constitute that\noffence; and\n(b) be brought before a magistrate in the State or Territory in\nwhich the person is arrested.\n(2) If a magistrate is satisfied that the person:\n(a) is the person specified in the warrant; and\n(b) is also the person specified in the arrest warrant that was\nissued by the Tribunal;\nthe magistrate must remand the person in custody or on bail for\nsuch period or periods as may be necessary to enable the",
      "skos:definition": "(1) A person who is arrested under a warrant must, as soon as\npracticable:\n(a) be given a written notice that:\n(i) specifies the Tribunal offence in respect of which the\nwarrant was issued; and\n(ii) describes the conduct that is alleged to constitute that\noffence; and\n(b) be brought before a magistrate in the State or Territory in\nwhich the person is arrested.\n(2) If a magistrate is satisfied that the person:\n(a) is the person specified in the warrant; and\n(b) is also the person specified in the arrest warrant that was\nissued by the Tribunal;\nthe magistrate must remand the person in custody or on bail for\nsuch period or periods as may be necessary to enable the",
