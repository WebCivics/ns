        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-5-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "57338cc89382d4768d6e902c5d40fd07ae6380845b216fcd2809473166092bee",
      "skos:note": "Court assumes exercise of power under warrant was not duly authorised unless proved otherwise."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-5",
      "@type": "cof:Section",
      "cof:title": "51(5) Restrictions on personal searches",
      "values:kind": "subsection",
