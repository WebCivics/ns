    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ag",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AG Retaining produced documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ag"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.55",
      "values:originalText": "(1) An authorised officer who takes possession of a document under a\nproduction order made in respect of a Tribunal offence may retain\nthe document pending a written direction from the\nAttorney-General as to how to deal with the document.",
      "skos:definition": "(1) An authorised officer who takes possession of a document under a\nproduction order made in respect of a Tribunal offence may retain\nthe document pending a written direction from the\nAttorney-General as to how to deal with the document.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ag-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ag-logic-deontic-1"
        }
      ],
