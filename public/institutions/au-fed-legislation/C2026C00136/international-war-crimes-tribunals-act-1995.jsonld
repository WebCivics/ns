    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40at",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AT Dealing with certain seized property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40at"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.63",
      "values:originalText": "(1) Property must be dealt with in accordance with this section if:\n(a) it has been seized under a POCA search warrant in relation to\na Tribunal offence; and\n(b) it is not:\n(i) evidential material; or\n(ii) property of a kind referred to in\nsubparagraph 40AR(a)(iv) or (v).\nGeneral rule—property to be returned after 30 days\n(2) If, at the end of the period of 30 days after the day the property was\nseized:\n(a) a forfeiture order in relation to the property has not been\nregistered in a court under Part 6; and\n(b) a restraining order has not been made as described in\nSubdivision B in respect of the property in relation to the\nTribunal offence;",
      "skos:definition": "(1) Property must be dealt with in accordance with this section if:\n(a) it has been seized under a POCA search warrant in relation to\na Tribunal offence; and\n(b) it is not:\n(i) evidential material; or\n(ii) property of a kind referred to in\nsubparagraph 40AR(a)(iv) or (v).\nGeneral rule—property to be returned after 30 days\n(2) If, at the end of the period of 30 days after the day the property was\nseized:\n(a) a forfeiture order in relation to the property has not been\nregistered in a court under Part 6; and\n(b) a restraining order has not been made as described in\nSubdivision B in respect of the property in relation to the\nTribunal offence;",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40at-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40at-ss-2"
        }
      ],
      "cml:integrityHash": "555a3e7f1ad8806975be976c6fc47345f85d91b82f6a923c483c4232e477a578"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40at",
      "@type": "cof:Section",
      "cof:title": "40AT Dealing with certain seized property",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "(1) Property must be dealt with in accordance with this section if:\n(a) it has been seized under a POCA search warrant in relation to\na Tribunal offence; and\n(b) it is not:\n(i) evidential material; or\n(ii) property of a kind referred to in\nsubparagraph 40AR(a)(iv) or (v).\nGeneral rule—property to be returned after 30 days\n(2) If, at the end of the period of 30 days after the day the property was\nseized:\n(a) a forfeiture order in relation to the property has not been\nregistered in a court under Part 6; and\n(b) a restraining order has not been made as described in\nSubdivision B in respect of the property in relation to the\nTribunal offence;"
    },
