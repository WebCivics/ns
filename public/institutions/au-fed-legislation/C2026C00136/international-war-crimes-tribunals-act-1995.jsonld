    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "82 Arrangements with States",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.99",
      "values:originalText": "(1) The Governor-General may make arrangements with the Governor\nof a State with respect to the administration of this Act, including\narrangements for the performance of the functions of a magistrate\nunder this Act by all or any of the persons who from time to time\nhold office as magistrates of that State.\n(2) The Governor-General may arrange with the Governor of a State\nwith whom an arrangement is in force under subsection (1) for the\nvariation or revocation of the arrangement.",
      "skos:definition": "(1) The Governor-General may make arrangements with the Governor\nof a State with respect to the administration of this Act, including\narrangements for the performance of the functions of a magistrate\nunder this Act by all or any of the persons who from time to time\nhold office as magistrates of that State.\n(2) The Governor-General may arrange with the Governor of a State\nwith whom an arrangement is in force under subsection (1) for the\nvariation or revocation of the arrangement.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-82-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-82-ss-2"
        }
      ],
      "cml:integrityHash": "22eb2e5a71c63be6a048f728a0844c80e0337c54d9da92566773cae1252fc88a"
    },
    {
