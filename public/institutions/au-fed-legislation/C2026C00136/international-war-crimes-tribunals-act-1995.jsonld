    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Offence for making false statements in warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.95",
      "values:originalText": "A person must not make, in an application for a warrant, a\nstatement that the person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 2 years.\nNote:\nUnder subsection 4D(1) of the Crimes Act 1914, this penalty is only a\nmaximum penalty for the offence. Subsection 4B(2) of that Act allows\na court to impose an appropriate fine instead of, or in addition to, a\nterm of imprisonment.",
      "skos:definition": "A person must not make, in an application for a warrant, a\nstatement that the person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 2 years.\nNote:\nUnder subsection 4D(1) of the Crimes Act 1914, this penalty is only a\nmaximum penalty for the offence. Subsection 4B(2) of that Act allows\na court to impose an appropriate fine instead of, or in addition to, a\nterm of imprisonment.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-75-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-75-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "866c0631abff46857f4f1ff32f463027dc0e3825adf7bdfd041e5f7eb2087ab7",
      "skos:note": "Making false statements in warrant applications is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Offence for making false statements in warrants",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "A person must not make, in an application for a warrant, a\nstatement that the person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 2 years.\nNote:\nUnder subsection 4D(1) of the Crimes Act 1914, this penalty is only a\nmaximum penalty for the offence. Subsection 4B(2) of that Act allows\na court to impose an appropriate fine instead of, or in addition to, a\nterm of imprisonment."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-75-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-75"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-75-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits making false statements in warrant applications.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Offences relating to telephone warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.96",
      "values:originalText": "A person must not:\n(a) state in a document that purports to be a form of warrant\nunder section 52 the name of a magistrate unless that\nmagistrate issued the warrant; or\n(b) state on a form of warrant under that section a matter that, to\nthe person’s knowledge, departs in a material particular from\nthe form authorised by the magistrate; or\n(c) purport to execute, or present to a person, a document that\npurports to be a form of warrant under that section that:\n(i) the person knows has not been approved by a magistrate\nunder that section; or\n(ii) the person knows to depart in a material particular from\nthe terms authorised by a magistrate under that section;\nor\n(d) send to a magistrate a form of warrant under that section that\nis not the form of warrant that the person purported to\nexecute.\nPenalty: Imprisonment for 2 years.\nNote:\nUnder subsection 4D(1) of the Crimes Act 1914, this penalty is only a\nmaximum penalty for the offence.  Subsection 4B(2) of that Act\nallows a court to impose an appropriate fine instead of, or in addition\nto, a term of imprisonment.",
      "skos:definition": "A person must not:\n(a) state in a document that purports to be a form of warrant\nunder section 52 the name of a magistrate unless that\nmagistrate issued the warrant; or\n(b) state on a form of warrant under that section a matter that, to\nthe person’s knowledge, departs in a material particular from\nthe form authorised by the magistrate; or\n(c) purport to execute, or present to a person, a document that\npurports to be a form of warrant under that section that:\n(i) the person knows has not been approved by a magistrate\nunder that section; or\n(ii) the person knows to depart in a material particular from\nthe terms authorised by a magistrate under that section;\nor\n(d) send to a magistrate a form of warrant under that section that\nis not the form of warrant that the person purported to\nexecute.\nPenalty: Imprisonment for 2 years.\nNote:\nUnder subsection 4D(1) of the Crimes Act 1914, this penalty is only a\nmaximum penalty for the offence.  Subsection 4B(2) of that Act\nallows a court to impose an appropriate fine instead of, or in addition\nto, a term of imprisonment.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-76-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-76-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "227779591c91fd4b0ec37fffa431f1962e1b33e1c16830ba667a7de677325225",
      "skos:note": "Prohibits certain actions related to telephone warrants."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Offences relating to telephone warrants",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "A person must not:\n(a) state in a document that purports to be a form of warrant\nunder section 52 the name of a magistrate unless that\nmagistrate issued the warrant; or\n(b) state on a form of warrant under that section a matter that, to\nthe person’s knowledge, departs in a material particular from\nthe form authorised by the magistrate; or\n(c) purport to execute, or present to a person, a document that\npurports to be a form of warrant under that section that:\n(i) the person knows has not been approved by a magistrate\nunder that section; or\n(ii) the person knows to depart in a material particular from\nthe terms authorised by a magistrate under that section;\nor\n(d) send to a magistrate a form of warrant under that section that\nis not the form of warrant that the person purported to\nexecute.\nPenalty: Imprisonment for 2 years.\nNote:\nUnder subsection 4D(1) of the Crimes Act 1914, this penalty is only a\nmaximum penalty for the offence.  Subsection 4B(2) of that Act\nallows a court to impose an appropriate fine instead of, or in addition\nto, a term of imprisonment."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-76-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-76"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-76-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits specific actions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
