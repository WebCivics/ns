    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-49-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
