    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Use of equipment to examine or process things",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.81",
      "values:originalText": "(1) The executing officer or an officer assisting may bring to the\nwarrant premises any equipment reasonably necessary for the\nexamination or processing of things found at the premises in order\nto determine whether the things may be seized under the warrant.\n(2) If:\n(a) it is not practicable to examine or process the things at the\nwarrant premises; or\n(b) the occupier of the premises consents in writing;",
      "skos:definition": "(1) The executing officer or an officer assisting may bring to the\nwarrant premises any equipment reasonably necessary for the\nexamination or processing of things found at the premises in order\nto determine whether the things may be seized under the warrant.\n(2) If:\n(a) it is not practicable to examine or process the things at the\nwarrant premises; or\n(b) the occupier of the premises consents in writing;",
      "cml:hasPart": [
