    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-58-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "58(3) Use of electronic equipment at premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-58-ss-3"
      },
      "cml:curationStatus": {
