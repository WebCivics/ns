    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-78-ss-2",
      "@type": "cof:Section",
      "cof:title": "78(2) Arrest of persons escaping from custody",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(2) The police officer must, as soon as practicable, take the person\nbefore a magistrate."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2-norm",
      "@type": "values:Obligation",
