      },
      "cml:premiseText": "(b) the police officer believes on reasonable grounds that the person is on any premises;",
      "cml:conclusionText": "the premises and persons are represented in knowledge."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "65(2) Power to enter premises to arrest person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-65-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.89",
      "values:originalText": "(2) A police officer must not enter a dwelling house under\nsubsection (1) at any time during the period commencing at 9 p.m.\non a day and ending at 6 a.m. on the following day unless the\npolice officer believes on reasonable grounds that:\n(a) it would not be practicable to arrest the person, either at the\ndwelling house or elsewhere, at another time; or\n(b) it is necessary to do so in order to prevent the concealment,\nloss or destruction of evidential material.",
      "skos:definition": "(2) A police officer must not enter a dwelling house under\nsubsection (1) at any time during the period commencing at 9 p.m.\non a day and ending at 6 a.m. on the following day unless the\npolice officer believes on reasonable grounds that:\n(a) it would not be practicable to arrest the person, either at the\ndwelling house or elsewhere, at another time; or\n(b) it is necessary to do so in order to prevent the concealment,\nloss or destruction of evidential material.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2-logic-ltl-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2-logic-deontic-4"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-2-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "a6b3f959135ee4c27d82f8f00cf37703db9cb879cee51d5a53deb5ad4a3e1cf9",
      "skos:note": "Police officer cannot enter dwelling house during certain hours without reasonable grounds."
    },
    {
