        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "delegate",
      "cml:logicSummary": "Attorney-General delegates power",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act.",
      "cml:conclusionText": "An officer is authorized to act on behalf of the Attorney-General."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval for delegation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act, other than:",
      "cml:conclusionText": "Delegation occurs during the Attorney-General's term."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal interval for delegation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act, other than:",
      "cml:conclusionText": "Delegation ends when the Attorney-General's term ends."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "through",
      "cml:logicSummary": "Delegation diffusion",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act, other than:",
      "cml:conclusionText": "Delegation is diffused through the Attorney-General's department."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "classify",
      "cml:logicSummary": "Delegation classification",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may delegate to an officer of the Attorney-General’s Department all or any of his or her powers under this Act, other than:",
      "cml:conclusionText": "Delegation is a cognitive process."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-84",
      "@type": "cml:Concept",
      "skos:prefLabel": "84 Act not to limit other provision of assistance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-84"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.100",
      "values:originalText": "This Act does not prevent provision of assistance to a Tribunal\notherwise than under this Act.\n\n\nMiscellaneous  Part 8\n\nSection 85\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "skos:definition": "This Act does not prevent provision of assistance to a Tribunal\notherwise than under this Act.\n\n\nMiscellaneous  Part 8\n\nSection 85\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-84-norm"
        }
      ],
      "cml:integrityHash": "044e1a5e1a099b125a949e493ebba319d089d66b0e7033d6f5cae90a0e2c6d9e",
      "skos:note": "Provision of assistance under other laws is allowed"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-84",
      "@type": "cof:Section",
      "cof:title": "84 Act not to limit other provision of assistance",
      "values:kind": "section",
      "cof:pageNumber": 100,
      "values:originalText": "This Act does not prevent provision of assistance to a Tribunal\notherwise than under this Act.\n\n\nMiscellaneous  Part 8\n\nSection 85\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-84-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-84"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-85",
      "@type": "cml:Concept",
      "skos:prefLabel": "85 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-85"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.101",
      "values:originalText": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing matters:\n(a) required or permitted by this Act to be prescribed; or\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\nEndnotes\nEndnote 1—About the endnotes\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\nEndnotes\nEndnote 1—About the endnotes\nThe endnotes provide information about this compilation and the compiled law.\nThe following endnotes are included in every compilation:\nEndnote 1—About the endnotes\nEndnote 2—Abbreviation key\nEndnote 3—Legislation history\nEndnote 4—Amendment history\nAbbreviation key—Endnote 2\nThe abbreviation key sets out abbreviations that may be used in the endnotes.\nLegislation history and amendment history—Endnotes 3 and 4\nAmending laws are annotated in the legislation history and amendment history.\nThe legislation history in endnote 3 provides information about each law that\nhas amended (or will amend) the compiled law. The information includes\ncommencement details for amending laws and details of any application, saving\nor transitional provisions that are not included in this compilation.\nThe amendment history in endnote 4 provides information about amendments at\nthe provision (generally section or equivalent) level. It also includes information\nabout any provision of the compiled law that has been repealed in accordance\nwith a provision of the law.\nEditorial changes\nThe Legislation Act 2003 authorises First Parliamentary Counsel to make\neditorial and presentational changes to a compiled law in preparing a\ncompilation of the law for registration. The changes must not change the effect\nof the law. Editorial changes take effect from the compilation registration date.\nIf the compilation includes editorial changes, the endnotes include a brief\noutline of the changes in general terms. Full details of any changes can be\nobtained from the Office of Parliamentary Counsel.\nMisdescribed amendments\nA misdescribed amendment is an amendment that does not accurately describe\nhow an amendment is to be made. If, despite the misdescription, the amendment\n\nEndnotes\nEndnote 1—About the endnotes\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\ncan be given effect as intended, then the misdescribed amendment can be\nincorporated through an editorial change made under section 15V of the\nLegislation Act 2003.\nIf a misdescribed amendment cannot be given effect as intended, the\namendment is not incorporated and “(md not incorp)” is added to the\namendment history.\n\nEndnotes\nEndnote 2—Abbreviation key\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\nEndnote 2—Abbreviation key\nad = added or inserted\norig = original\nam = amended\np = page(s)\namdt = amendment\npara = paragraph(s)/subparagraph(s)\n/sub-subparagraph(s)\nch = Chapter(s)\npres = present\ncl = clause(s)\nprev = previous\ncont. = continued\n(prev…) = previously\ndef = definition(s)\npt = Part(s)\nDict = Dictionary\nr = regulation(s)/Court rule(s)\ndisallowed = disallowed by Parliament\nreloc = relocated\ndiv = Division(s)\nrenum = renumbered\ned = editorial change\nrep = repealed\nexp = expires/expired or ceases/ceased to have\nrs = repealed and substituted\neffect\ns = section(s)/subsection(s)\ngaz = gazette\n/rule(s)/subrule(s)/order(s)/suborder(s)\nLA = Legislation Act 2003\nsch = Schedule(s)\nLIA = Legislative Instruments Act 2003\nSLI = Select Legislative Instrument\n(md) = misdescribed amendment can be given\nSR = Statutory Rules\neffect\nsub ch = Sub-Chapter(s)\n(md not incorp) = misdescribed amendment\nsub div = Subdivision(s)\ncannot be given effect\nsub pt = Subpart(s)\nmod = modified/modification\nunderlining = whole or part not\nNo. = Number(s)\ncommenced or to be commenced\nOrd = Ordinance\n\nEndnotes\nEndnote 3—Legislation history\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\nEndnote 3—Legislation history\nAct\n(Register ID)\nNumber\nand year\nAssent\nCommencement\nApplication,\nsaving and\ntransitional\nprovisions\nInternational War\nCrimes Tribunals Act\n1995 (C2004A04874)\n18, 1995",
      "skos:definition": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing matters:\n(a) required or permitted by this Act to be prescribed; or\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\nEndnotes\nEndnote 1—About the endnotes\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\nEndnotes\nEndnote 1—About the endnotes\nThe endnotes provide information about this compilation and the compiled law.\nThe following endnotes are included in every compilation:\nEndnote 1—About the endnotes\nEndnote 2—Abbreviation key\nEndnote 3—Legislation history\nEndnote 4—Amendment history\nAbbreviation key—Endnote 2\nThe abbreviation key sets out abbreviations that may be used in the endnotes.\nLegislation history and amendment history—Endnotes 3 and 4\nAmending laws are annotated in the legislation history and amendment history.\nThe legislation history in endnote 3 provides information about each law that\nhas amended (or will amend) the compiled law. The information includes\ncommencement details for amending laws and details of any application, saving\nor transitional provisions that are not included in this compilation.\nThe amendment history in endnote 4 provides information about amendments at\nthe provision (generally section or equivalent) level. It also includes information\nabout any provision of the compiled law that has been repealed in accordance\nwith a provision of the law.\nEditorial changes\nThe Legislation Act 2003 authorises First Parliamentary Counsel to make\neditorial and presentational changes to a compiled law in preparing a\ncompilation of the law for registration. The changes must not change the effect\nof the law. Editorial changes take effect from the compilation registration date.\nIf the compilation includes editorial changes, the endnotes include a brief\noutline of the changes in general terms. Full details of any changes can be\nobtained from the Office of Parliamentary Counsel.\nMisdescribed amendments",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-85-norm"
        },
