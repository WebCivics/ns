      },
      "cml:premiseText": "(c) it is necessary to exercise the power without the authority of a search warrant because the circumstances are serious and urgent.",
      "cml:conclusionText": "Emergency situations overlap with warrantless searches."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "Describes the recurring nature of emergency situations that justify warrantless searches.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) evidential material is in or on a conveyance; and (b) it is necessary to exercise a power under subsection (2) in order to prevent the material from being concealed, lost or destroyed;",
      "cml:conclusionText": "Emergency situations recur."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-63-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on police officers to exercise power under subsection (2) in emergency situations.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
