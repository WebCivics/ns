      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.85",
      "values:originalText": "(1) If a thing is seized under a warrant or moved under\nsubsection 57(2), the executing officer or an officer assisting must\nprovide a receipt for the thing.",
      "skos:definition": "(1) If a thing is seized under a warrant or moved under\nsubsection 57(2), the executing officer or an officer assisting must\nprovide a receipt for the thing.",
