    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "46A(6) Effect on third parties of registration of forfeiture orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-46a-ss-6"
      },
      "cml:curationStatus": {
