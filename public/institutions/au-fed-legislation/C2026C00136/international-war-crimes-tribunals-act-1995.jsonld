    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-827",
      "@type": "cml:Concept",
      "skos:prefLabel": "827 S/RES/827 (1993); and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-827"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.17",
      "values:originalText": "(ii) annexed to the United Nations Secretary-General’s\nreport S/25704 (1993) given pursuant to paragraph 2 of\nUnited Nations Security Council Resolution 808\nS/RES/808 (1993); and\n(b) for the Rwanda Tribunal—the Statute of the Tribunal\nannexed to (and adopted by) United Nations Security Council\nResolution 955 S/RES/955 (1994); and\n(c) for the International Residual Mechanism for Criminal\nTribunals—the Statute of the Mechanism in Annex 1 to (and\nadopted by) United Nations Security Council Resolution",
      "skos:definition": "(ii) annexed to the United Nations Secretary-General’s\nreport S/25704 (1993) given pursuant to paragraph 2 of\nUnited Nations Security Council Resolution 808\nS/RES/808 (1993); and\n(b) for the Rwanda Tribunal—the Statute of the Tribunal\nannexed to (and adopted by) United Nations Security Council\nResolution 955 S/RES/955 (1994); and\n(c) for the International Residual Mechanism for Criminal\nTribunals—the Statute of the Mechanism in Annex 1 to (and\nadopted by) United Nations Security Council Resolution",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-827-norm"
        }
      ],
      "cml:integrityHash": "6910bc7a3d66c63778a282242825f49e3ebe940e61da652b0246fa336f64bf42",
      "skos:note": "References annexed documents and resolutions."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-827",
      "@type": "cof:Section",
      "cof:title": "827 S/RES/827 (1993); and",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "(ii) annexed to the United Nations Secretary-General’s\nreport S/25704 (1993) given pursuant to paragraph 2 of\nUnited Nations Security Council Resolution 808\nS/RES/808 (1993); and\n(b) for the Rwanda Tribunal—the Statute of the Tribunal\nannexed to (and adopted by) United Nations Security Council\nResolution 955 S/RES/955 (1994); and\n(c) for the International Residual Mechanism for Criminal\nTribunals—the Statute of the Mechanism in Annex 1 to (and\nadopted by) United Nations Security Council Resolution"
    },
