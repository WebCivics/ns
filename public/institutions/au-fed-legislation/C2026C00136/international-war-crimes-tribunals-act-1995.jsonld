      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-35-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to travel",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may make arrangements...",
      "cml:conclusionText": "The person must be allowed to travel."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-35-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "35(2) Persons giving evidence or assisting (other than prisoners)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-35-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.46",
      "values:originalText": "(2) The Attorney-General must not comply with the request if, in his\nor her opinion:\n(a) complying with the request would prejudice Australia’s\nsovereignty, security or national interest; or\n(b) there are special circumstances justifying non-compliance.\n\n\nOther forms of assistance to a Tribunal  Part 4\nGiving evidence at hearings, or assisting in investigations, in foreign countries  Division\nSection 36\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "skos:definition": "(2) The Attorney-General must not comply with the request if, in his\nor her opinion:\n(a) complying with the request would prejudice Australia’s\nsovereignty, security or national interest; or\n(b) there are special circumstances justifying non-compliance.\n\n\nOther forms of assistance to a Tribunal  Part 4\nGiving evidence at hearings, or assisting in investigations, in foreign countries  Division\nSection 36\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-35"
      },
      "cml:asserts": [
