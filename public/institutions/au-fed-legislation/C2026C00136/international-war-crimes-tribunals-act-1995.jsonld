    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.9",
      "values:originalText": "(1) Sections 1 and 2 commence on the day on which this Act receives\nthe Royal Assent.\n(2) Subject to subsection (3), the remaining provisions of this Act\ncommence on a day or days to be fixed by Proclamation.\n(3) If a provision of this Act does not commence under subsection (2)\nwithin 6 months after the day on which this Act receives the Royal\nAssent, it commences on the first day after the end of that period.",
      "skos:definition": "(1) Sections 1 and 2 commence on the day on which this Act receives\nthe Royal Assent.\n(2) Subject to subsection (3), the remaining provisions of this Act\ncommence on a day or days to be fixed by Proclamation.\n(3) If a provision of this Act does not commence under subsection (2)\nwithin 6 months after the day on which this Act receives the Royal\nAssent, it commences on the first day after the end of that period.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-2-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-2-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-2-ss-3"
        }
      ],
      "cml:integrityHash": "be251b290f11968fdbaf9d72fc4d4a66a242cd5d65ae2e7f0bf0296964762283"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "(1) Sections 1 and 2 commence on the day on which this Act receives\nthe Royal Assent.\n(2) Subject to subsection (3), the remaining provisions of this Act\ncommence on a day or days to be fixed by Proclamation.\n(3) If a provision of this Act does not commence under subsection (2)\nwithin 6 months after the day on which this Act receives the Royal\nAssent, it commences on the first day after the end of that period."
    },
