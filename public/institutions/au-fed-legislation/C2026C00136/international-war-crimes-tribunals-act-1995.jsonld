      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Must return seized thing",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Reason for seizure no longer exists or thing is not needed in evidence.",
      "cml:conclusionText": "Return the thing"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Return seized thing if reason for seizure no longer exists or thing is not needed in evidence",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General must direct the Commissioner to return the thing",
      "cml:conclusionText": "If the time period of the reason for seizure has passed, the thing must be returned"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Return seized thing if reason for seizure no longer exists or thing is not needed in evidence",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General must direct the Commissioner to return the thing",
      "cml:conclusionText": "If the condition is met, the thing must be returned until it's no longer needed"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Thing can be forfeited or forfeitable if reason for seizure still exists",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Unless the thing is forfeited or forfeitable to the Commonwealth or is the subject of a dispute as to ownership.",
      "cml:conclusionText": "The thing can be forfeited or forfeitable"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-77-ss-5-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Thing must not be used in evidence by a Tribunal or in respect of criminal proceedings in Australia if reason for seizure no longer exists",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "It is decided that the thing is not to be used in evidence by a Tribunal or in respect of criminal proceedings in Australia.",
      "cml:conclusionText": "The thing must not be used in evidence"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78",
      "@type": "cml:Concept",
      "skos:prefLabel": "78 Arrest of persons escaping from custody",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-78"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.98",
      "values:originalText": "(1) A police officer may, without warrant, arrest a person, if the police\nofficer has reasonable grounds to believe that the person has\nescaped from custody authorised by this Act.\n(2) The police officer must, as soon as practicable, take the person\nbefore a magistrate.\n(3) If the magistrate is satisfied that the person has escaped from\ncustody authorised by this Act, the magistrate may issue a warrant\nauthorising any police officer to return the person to the custody\nreferred to in subsection (1).",
      "skos:definition": "(1) A police officer may, without warrant, arrest a person, if the police\nofficer has reasonable grounds to believe that the person has\nescaped from custody authorised by this Act.\n(2) The police officer must, as soon as practicable, take the person\nbefore a magistrate.\n(3) If the magistrate is satisfied that the person has escaped from\ncustody authorised by this Act, the magistrate may issue a warrant\nauthorising any police officer to return the person to the custody\nreferred to in subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-3"
        }
      ],
      "cml:integrityHash": "87085d680c06ba733a0932c5b39e332b3fd84136de3db0ba219be3b1afdb6cfe"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-78",
      "@type": "cof:Section",
      "cof:title": "78 Arrest of persons escaping from custody",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "(1) A police officer may, without warrant, arrest a person, if the police\nofficer has reasonable grounds to believe that the person has\nescaped from custody authorised by this Act.\n(2) The police officer must, as soon as practicable, take the person\nbefore a magistrate.\n(3) If the magistrate is satisfied that the person has escaped from\ncustody authorised by this Act, the magistrate may issue a warrant\nauthorising any police officer to return the person to the custody\nreferred to in subsection (1)."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-78-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(1) Arrest of persons escaping from custody",
      "cml:realizedBy": {
