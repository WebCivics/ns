    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Release from remand on the Attorney-General’s direction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.24",
      "values:originalText": "The Attorney-General must, by notice in writing in the statutory\nform, direct a magistrate to order the release from custody of a\nperson remanded under this Division, or the discharge of the\nrecognisances on which bail was granted to the person, as the case\nrequires, if:\n(a) the Attorney-General is satisfied that a request from a\nTribunal that would oblige the Attorney-General to issue a\nnotice under section 9 in relation to the person will not be\nreceived; or\n(b) the Attorney-General considers for any other reason that the\nremand should cease.",
      "skos:definition": "The Attorney-General must, by notice in writing in the statutory\nform, direct a magistrate to order the release from custody of a\nperson remanded under this Division, or the discharge of the\nrecognisances on which bail was granted to the person, as the case\nrequires, if:\n(a) the Attorney-General is satisfied that a request from a\nTribunal that would oblige the Attorney-General to issue a\nnotice under section 9 in relation to the person will not be\nreceived; or\n(b) the Attorney-General considers for any other reason that the\nremand should cease.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-alleninterval-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-ltl-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-diffusion-4"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "de216a338e7ce532bbc2c0729f165eb33ccc5965e0dee054874e6c22a593f876",
      "skos:note": "The Attorney-General must direct a magistrate to release a person from custody or discharge recognisances."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Release from remand on the Attorney-General’s direction",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "The Attorney-General must, by notice in writing in the statutory\nform, direct a magistrate to order the release from custody of a\nperson remanded under this Division, or the discharge of the\nrecognisances on which bail was granted to the person, as the case\nrequires, if:\n(a) the Attorney-General is satisfied that a request from a\nTribunal that would oblige the Attorney-General to issue a\nnotice under section 9 in relation to the person will not be\nreceived; or\n(b) the Attorney-General considers for any other reason that the\nremand should cease."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Attorney-General has a duty to direct a magistrate.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General is required to take action.",
      "cml:conclusionText": "A magistrate must order the release of a person from custody."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "The provision specifies a temporal relationship between actions.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General's direction must occur before the release of a person from custody.",
      "cml:conclusionText": "The release occurs after the direction is given."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "The provision specifies a temporal relationship between actions.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The release of a person from custody must occur before the Attorney-General's next action.",
      "cml:conclusionText": "The direction is an instance of the obligation to direct a magistrate in relation to the release."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "The provision defines a specific class of diffusion.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General's direction is a type of action that affects others.",
      "cml:conclusionText": "The direction is an instance of the diffusion of obligation to direct a magistrate."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-13-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "The provision defines a specific class of cognitive action.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General's direction is a type of action that requires reasoning.",
      "cml:conclusionText": "The direction is an instance of the cognitive action of directing a magistrate."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Release from remand after certain periods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.24",
      "values:originalText": "(1) A person must be brought before a magistrate if:\n(a) the person was arrested under a warrant issued under\nsubsection 10(2); and\n(b) the person is, under this Division, on remand 14 days after\nthe day on which the person was arrested; and\n(c) a notice has not been given under section 9 in relation to the\nperson.\n\n\nSurrender of persons to a Tribunal  Part 3\nArrest of persons  Division 1\nSection 15\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\n(2) Unless the magistrate is satisfied that such a notice is likely to be\ngiven within a particular period that is reasonable in all the\ncircumstances, the magistrate must:\n(a) order the release of the person from custody; or\n(b) order the discharge of the recognisances on which bail was\ngranted to the person; as the case requires.\n(3) If:\n(a) a magistrate was satisfied under subsection (2) that such a\nnotice was likely to be given in relation to the person within a\nparticular period; and\n(b) the notice is not given within the period;\nthe person must be brought before a magistrate.\n(4) The magistrate must:\n(a) order the release of the person from custody; or\n(b) order the discharge of the recognisances on which bail was\ngranted to the person;\nas the case requires.",
      "skos:definition": "(1) A person must be brought before a magistrate if:\n(a) the person was arrested under a warrant issued under\nsubsection 10(2); and\n(b) the person is, under this Division, on remand 14 days after\nthe day on which the person was arrested; and\n(c) a notice has not been given under section 9 in relation to the\nperson.\n\n\nSurrender of persons to a Tribunal  Part 3\nArrest of persons  Division 1\nSection 15\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\n(2) Unless the magistrate is satisfied that such a notice is likely to be\ngiven within a particular period that is reasonable in all the\ncircumstances, the magistrate must:\n(a) order the release of the person from custody; or\n(b) order the discharge of the recognisances on which bail was\ngranted to the person; as the case requires.\n(3) If:\n(a) a magistrate was satisfied under subsection (2) that such a\nnotice was likely to be given in relation to the person within a\nparticular period; and\n(b) the notice is not given within the period;\nthe person must be brought before a magistrate.\n(4) The magistrate must:\n(a) order the release of the person from custody; or\n(b) order the discharge of the recognisances on which bail was\ngranted to the person;\nas the case requires.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-14-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-14-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-14-ss-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-14-ss-4"
        }
      ],
      "cml:integrityHash": "c3e6bcf5d22ff2a517807e9dfb741c3cba5f8c77f31d9f3dcc6e9e990f411d67"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Release from remand after certain periods",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(1) A person must be brought before a magistrate if:\n(a) the person was arrested under a warrant issued under\nsubsection 10(2); and\n(b) the person is, under this Division, on remand 14 days after\nthe day on which the person was arrested; and\n(c) a notice has not been given under section 9 in relation to the\nperson.\n\n\nSurrender of persons to a Tribunal  Part 3\nArrest of persons  Division 1\nSection 15\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026\n(2) Unless the magistrate is satisfied that such a notice is likely to be\ngiven within a particular period that is reasonable in all the\ncircumstances, the magistrate must:\n(a) order the release of the person from custody; or\n(b) order the discharge of the recognisances on which bail was\ngranted to the person; as the case requires.\n(3) If:\n(a) a magistrate was satisfied under subsection (2) that such a\nnotice was likely to be given in relation to the person within a\nparticular period; and\n(b) the notice is not given within the period;\nthe person must be brought before a magistrate.\n(4) The magistrate must:\n(a) order the release of the person from custody; or\n(b) order the discharge of the recognisances on which bail was\ngranted to the person;\nas the case requires."
    },
