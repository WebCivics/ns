    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-27-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "27(2) Taking of evidence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-27-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.33",
      "values:originalText": "(2) A magistrate who takes any such evidence must:\n(a) cause the evidence to be put in writing; and\n(b) certify that the evidence was taken by the magistrate; and\n(c) cause the writing so certified to be sent to the\nAttorney-General.",
      "skos:definition": "(2) A magistrate who takes any such evidence must:\n(a) cause the evidence to be put in writing; and\n(b) certify that the evidence was taken by the magistrate; and\n(c) cause the writing so certified to be sent to the\nAttorney-General.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-27"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-27-ss-2-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-27-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c693460a27ef1331d4232990555dc8190ae1ec5f3e851bb1eded06bb61f4756c",
      "skos:note": "Magistrate must put evidence in writing and certify it.",
      "dc:description": "Evidence to be sent to Attorney-General"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-27-ss-2",
      "@type": "cof:Section",
      "cof:title": "27(2) Taking of evidence",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(2) A magistrate who takes any such evidence must:\n(a) cause the evidence to be put in writing; and\n(b) certify that the evidence was taken by the magistrate; and\n(c) cause the writing so certified to be sent to the\nAttorney-General."
    },
