        }
      ],
      "cml:integrityHash": "1a03b1d411bbe422236cb5ecaf9dbd5360b08533030a291987ae97b5a4443050",
      "skos:note": "The Attorney-General must provide notice to a magistrate upon receiving a request for surrender from a Tribunal.",
      "dc:description": "Notice in writing"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-9-ss-1",
      "@type": "cof:Section",
      "cof:title": "9(1) Notice by Attorney-General",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(1) If:\n(a) the Attorney-General receives from a Tribunal a request for\nsurrender of a person; and\n(b) the request is in accordance with subsection 8(1); and\n(c) the request is accompanied by an arrest warrant in relation to\nthe person that was issued by the Tribunal, or by a copy of\nthat warrant authenticated by the Tribunal;\nthe Attorney-General must, by notice in writing in the statutory\nform expressed to be directed to any magistrate, state that the\nrequest has been received."
    },
    {
