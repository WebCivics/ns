      "cml:integrityHash": "b41ecdddd932853bce72fe7a3825c1909be6329c821bfd25998c36e0eae7af18",
      "skos:note": "Conditions for granting legal assistance"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-81-ss-3",
      "@type": "cof:Section",
      "cof:title": "81(3) Legal assistance",
      "values:kind": "subsection",
      "cof:pageNumber": 99,
      "values:originalText": "(3) The assistance may be granted unconditionally or subject to such\nconditions as the Attorney-General determines."
    },
