    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "46A(7) Effect on third parties of registration of forfeiture orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-46a-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.70",
      "values:originalText": "(7) The court may give leave to apply outside that period if the court is\nsatisfied that the person’s failure to apply within that period was\nnot due to any neglect on the person’s part.",
      "skos:definition": "(7) The court may give leave to apply outside that period if the court is\nsatisfied that the person’s failure to apply within that period was\nnot due to any neglect on the person’s part.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-46a"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-7-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-46a-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9e07bd9f54eb8964231cef8af6472a8f960e1f057efdc1034b1c49910e38fb6c",
      "skos:note": "Court may give leave to apply outside the period if not due to neglect."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-46a-ss-7",
      "@type": "cof:Section",
      "cof:title": "46A(7) Effect on third parties of registration of forfeiture orders",
      "values:kind": "subsection",
      "cof:pageNumber": 70,
      "values:originalText": "(7) The court may give leave to apply outside that period if the court is\nsatisfied that the person’s failure to apply within that period was\nnot due to any neglect on the person’s part."
    },
