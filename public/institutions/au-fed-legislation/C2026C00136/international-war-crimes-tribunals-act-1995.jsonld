      "cml:integrityHash": "3cd86f19f5ec1200291d89b136073b026bc683be2fc4953c444e68532c19c251",
      "skos:note": "Time spent in custody for surrender warrant and Tribunal offence is counted towards sentence or period of detention."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-24-ss-1",
      "@type": "cof:Section",
