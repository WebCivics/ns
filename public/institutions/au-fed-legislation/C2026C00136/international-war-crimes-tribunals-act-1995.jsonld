      "cml:premiseText": "The term 'statutory form' is defined.",
      "cml:conclusionText": "It refers to the form of a warrant or notice as set out in the regulations."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-1966-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
