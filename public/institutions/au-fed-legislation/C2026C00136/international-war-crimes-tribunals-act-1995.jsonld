    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40am",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AM Failing to comply with a notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40am"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.58",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person is given a notice under section 40AH; and\n(b) the person fails to comply with the notice.\nPenalty: Imprisonment for 2 years or 100 penalty units, or both.\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person is given a notice under section 40AH; and\n(b) the person fails to comply with the notice.\nPenalty: Imprisonment for 2 years or 100 penalty units, or both.\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40am-norm"
        },
