      "cml:premiseText": "Order must be registered in a court by the registration of a copy of the appropriate order sealed by the Tribunal."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-45-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Registration is within the scope of the Tribunal's authority",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The registration must be done under the rules of the court, which are part of the Tribunal's jurisdiction."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-45-ss-2-logic-argumentation-3",
