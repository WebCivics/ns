    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40al",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AL Disclosing existence or nature of notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40al"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.58",
      "values:originalText": "A person commits an offence if:\n(a) the person is given a notice under section 40AH; and\n(b) the notice states that information about the notice must not be\ndisclosed; and\n(c) the person discloses the existence or nature of the notice.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "skos:definition": "A person commits an offence if:\n(a) the person is given a notice under section 40AH; and\n(b) the notice states that information about the notice must not be\ndisclosed; and\n(c) the person discloses the existence or nature of the notice.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40al-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40al-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6d923bf6f4870c24bf9c975c819fc96ed70a81ccb9f53087f6d71be728348d51",
      "skos:note": "Disclosing existence or nature of notice is prohibited after receiving a notice under section 40AH."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40al",
      "@type": "cof:Section",
      "cof:title": "40AL Disclosing existence or nature of notice",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "A person commits an offence if:\n(a) the person is given a notice under section 40AH; and\n(b) the notice states that information about the notice must not be\ndisclosed; and\n(c) the person discloses the existence or nature of the notice.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both."
    },
    {
