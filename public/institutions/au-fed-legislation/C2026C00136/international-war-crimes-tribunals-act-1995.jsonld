      "cml:integrityHash": "54204246ac7cb3003a81e95b6bb0d3b14cacaabf19e09eca9fd5fcb7f0ad7935",
      "skos:note": "Allows for successive warrants in relation to the same premises or person."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-48-ss-2",
      "@type": "cof:Section",
      "cof:title": "48(2) Content of warrants",
      "values:kind": "subsection",
      "cof:pageNumber": 74,
