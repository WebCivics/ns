    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "29(2) Legal representation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-29-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.34",
      "values:originalText": "(2) The magistrate conducting a proceeding under either section 27 or\n28, or both, may permit:\n(a) the person to whom the proceeding before, or investigation\nconducted by, the Tribunal relates; and\n(b) any other person giving evidence or producing documents or\nother articles at the proceeding before the magistrate; and\n(c) the Tribunal;\nto have legal representation at the proceeding before the\nmagistrate.",
      "skos:definition": "(2) The magistrate conducting a proceeding under either section 27 or\n28, or both, may permit:\n(a) the person to whom the proceeding before, or investigation\nconducted by, the Tribunal relates; and\n(b) any other person giving evidence or producing documents or\nother articles at the proceeding before the magistrate; and\n(c) the Tribunal;\nto have legal representation at the proceeding before the\nmagistrate.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-2-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9694f904518f70365c612a37507eb478e193bdae6eebe2b4c959b037211264b3",
      "skos:note": "Permit legal representation for specified persons and entities."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-29-ss-2",
      "@type": "cof:Section",
      "cof:title": "29(2) Legal representation",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(2) The magistrate conducting a proceeding under either section 27 or\n28, or both, may permit:\n(a) the person to whom the proceeding before, or investigation\nconducted by, the Tribunal relates; and\n(b) any other person giving evidence or producing documents or\nother articles at the proceeding before the magistrate; and\n(c) the Tribunal;\nto have legal representation at the proceeding before the\nmagistrate."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-29-ss-2-norm",
      "@type": "values:Permission",
      "cml:modality": {
