    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Notice by Attorney-General",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.22",
      "values:originalText": "(1) If:\n(a) the Attorney-General receives from a Tribunal a request for\nsurrender of a person; and\n(b) the request is in accordance with subsection 8(1); and\n(c) the request is accompanied by an arrest warrant in relation to\nthe person that was issued by the Tribunal, or by a copy of\nthat warrant authenticated by the Tribunal;\nthe Attorney-General must, by notice in writing in the statutory\nform expressed to be directed to any magistrate, state that the\nrequest has been received.\n(2) A copy of the arrest warrant that was issued by the Tribunal must\nbe attached to the notice.",
      "skos:definition": "(1) If:\n(a) the Attorney-General receives from a Tribunal a request for\nsurrender of a person; and\n(b) the request is in accordance with subsection 8(1); and\n(c) the request is accompanied by an arrest warrant in relation to\nthe person that was issued by the Tribunal, or by a copy of\nthat warrant authenticated by the Tribunal;\nthe Attorney-General must, by notice in writing in the statutory\nform expressed to be directed to any magistrate, state that the\nrequest has been received.\n(2) A copy of the arrest warrant that was issued by the Tribunal must\nbe attached to the notice.",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-9-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-9-ss-2"
        }
      ],
      "cml:integrityHash": "906fd40c6d61d34e82e7b3dd00ab74d39c50f18062ca6aed1234f695eadf9e89"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Notice by Attorney-General",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "(1) If:\n(a) the Attorney-General receives from a Tribunal a request for\nsurrender of a person; and\n(b) the request is in accordance with subsection 8(1); and\n(c) the request is accompanied by an arrest warrant in relation to\nthe person that was issued by the Tribunal, or by a copy of\nthat warrant authenticated by the Tribunal;\nthe Attorney-General must, by notice in writing in the statutory\nform expressed to be directed to any magistrate, state that the\nrequest has been received.\n(2) A copy of the arrest warrant that was issued by the Tribunal must\nbe attached to the notice."
    },
    {
