      "skos:note": "Police officer must announce before entering premises under warrant or to arrest person.",
      "dc:description": "Announcement and opportunity for entry"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-74-ss-1",
