      ],
      "cml:integrityHash": "eb4a7fd4282cc880b4d72b6bd28bdb1ec83a168d5090daf6976409ff6ae1dcb1",
      "skos:note": "Forfeiture order not registered within 30 days after seizure."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40at-ss-2",
      "@type": "cof:Section",
      "cof:title": "40AT(2) Dealing with certain seized property",
      "values:kind": "subsection",
      "cof:pageNumber": 63,
      "values:originalText": "(2) If, at the end of the period of 30 days after the day the property was\nseized:\n(a) a forfeiture order in relation to the property has not been\nregistered in a court under Part 6; and\n(b) a restraining order has not been made as described in\nSubdivision B in respect of the property in relation to the\nTribunal offence;"
    },
