    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-37-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "37(2) Undertakings relating to prisoners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-37-ss-2"
      },
