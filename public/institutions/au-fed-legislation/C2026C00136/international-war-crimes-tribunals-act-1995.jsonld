    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Use of force in making arrest",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
