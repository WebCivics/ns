      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.78",
      "values:originalText": "(5) If:\n(a) it is material, in any proceedings, for a court to be satisfied\nthat the exercise of a power under a warrant issued under\nsection 52 was duly authorised; and\n(b) the form of warrant signed by the magistrate is not produced\nin evidence;\nthe court is to assume, unless the contrary is proved, that the\nexercise of the power was not duly authorised.",
      "skos:definition": "(5) If:\n(a) it is material, in any proceedings, for a court to be satisfied\nthat the exercise of a power under a warrant issued under\nsection 52 was duly authorised; and\n(b) the form of warrant signed by the magistrate is not produced\nin evidence;\nthe court is to assume, unless the contrary is proved, that the\nexercise of the power was not duly authorised.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-5-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-5-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-5-logic-alleninterval-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-5-logic-ltl-3"
        },
