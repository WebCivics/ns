          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-21-ss-1-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-21-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9f2b51b46e8c3af98bc20fe684cabb0d740ea892bdfb9968842cd1ca3e5aaaae",
      "skos:note": "Police officer must transport and detain eligible person in custody for surrender."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-21-ss-1",
      "@type": "cof:Section",
