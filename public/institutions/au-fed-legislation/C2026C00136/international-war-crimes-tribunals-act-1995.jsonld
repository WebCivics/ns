    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-68",
      "@type": "cml:Concept",
      "skos:prefLabel": "68 Power to conduct a frisk search of an arrested person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-68"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.91",
      "values:originalText": "A police officer who arrests a person under this Act or pursuant to\na warrant issued under this Act, or who is present at such an arrest,\nmay, if the police officer suspects on reasonable grounds that it is\nprudent to do so in order to ascertain whether the person is carrying\nany seizable items:\n(a) conduct a frisk search of the person at or soon after the time\nof arrest; and\n(b) seize any seizable items found as a result of the search.",
      "skos:definition": "A police officer who arrests a person under this Act or pursuant to\na warrant issued under this Act, or who is present at such an arrest,\nmay, if the police officer suspects on reasonable grounds that it is\nprudent to do so in order to ascertain whether the person is carrying\nany seizable items:\n(a) conduct a frisk search of the person at or soon after the time\nof arrest; and\n(b) seize any seizable items found as a result of the search.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-68-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-68-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "90d804851ed09a52f900a5bfc19d5b41c776fcd08d65b1c5d23617baf86cb8e9",
      "skos:note": "Police officer may conduct frisk search of arrested person if reasonable grounds exist."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Power to conduct a frisk search of an arrested person",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "A police officer who arrests a person under this Act or pursuant to\na warrant issued under this Act, or who is present at such an arrest,\nmay, if the police officer suspects on reasonable grounds that it is\nprudent to do so in order to ascertain whether the person is carrying\nany seizable items:\n(a) conduct a frisk search of the person at or soon after the time\nof arrest; and\n(b) seize any seizable items found as a result of the search."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-68-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
