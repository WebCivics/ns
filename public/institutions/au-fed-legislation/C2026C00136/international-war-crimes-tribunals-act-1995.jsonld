    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-45-ss-3",
      "@type": "cof:Section",
      "cof:title": "45(3) Registration of order",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(3) Subject to subsection 46(2), if a copy of a sealed copy of an order\nis faxed, emailed or sent by other electronic means, it is taken for\nthe purposes of subsection (2) of this section to be the same as the\nsealed copy."
    },
