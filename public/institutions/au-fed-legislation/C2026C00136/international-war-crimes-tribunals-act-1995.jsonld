    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ap-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AP(3) Applying for and issuing search warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-40ap-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.60",
      "values:originalText": "(3) That Part applies as if:\n(a) a reference in that Part to tainted property were a reference to\nproceeds of the Tribunal offence that is the subject of the\nproceeds request; and\n(b) a reference in that Part to evidential material were a reference\nto evidential material as defined in section 4 of this Act for\nthe purposes of this Subdivision; and\n(c) the words “or section 40AS, 40AT or 40AU of the\nInternational War Crimes Tribunals Act 1995” were inserted\nafter “this Act” in paragraph 254(1)(a) of the Proceeds of\nCrime Act 2002; and\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences",
      "skos:definition": "(3) That Part applies as if:\n(a) a reference in that Part to tainted property were a reference to\nproceeds of the Tribunal offence that is the subject of the\nproceeds request; and\n(b) a reference in that Part to evidential material were a reference\nto evidential material as defined in section 4 of this Act for\nthe purposes of this Subdivision; and\n(c) the words “or section 40AS, 40AT or 40AU of the\nInternational War Crimes Tribunals Act 1995” were inserted\nafter “this Act” in paragraph 254(1)(a) of the Proceeds of\nCrime Act 2002; and\n\n\nOther forms of assistance to a Tribunal  Part 4\nIdentification, tracing, and freezing or seizure, of proceeds of Tribunal offences",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ap"
      },
