        "@id": "cml:Proposed"
      },
      "cml:premiseText": "That Part applies as if references in that Part to it being proposed to charge a person with an indictable offence were references to it being reasonably suspected that criminal proceedings are about to commence against the person in the Tribunal in respect of a Tribunal offence",
      "cml:conclusionText": "...it being reasonably suspected that criminal proceedings are about to commence against the person in the Tribunal in respect of a Tribunal offence"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Paragraphs omitted from Part",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "That Part applies as if paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and sections 18 to 20A, 29, 29A and 44 to 45A of that Act were omitted",
      "cml:conclusionText": "...paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and sections 18 to 20A, 29, 29A and 44 to 45A of that Act were omitted"
    },
    {
