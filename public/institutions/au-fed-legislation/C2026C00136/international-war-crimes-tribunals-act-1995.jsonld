    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Expiry of Australian sentences while under Tribunal detention",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.31",
      "values:originalText": "If:\n(a) at the time a person was surrendered to a Tribunal under this\nPart, the person was serving a sentence of imprisonment in\nrespect of an offence against an Australian law, or was\notherwise subject to detention under an Australian law; and\n(b) each such sentence of imprisonment that the person was\nserving, or each such period of detention to which the person\nwas subject, at that time expires while the person is being\ndetained by, or on the order of, the Tribunal;\nthe Attorney-General must without delay inform the Tribunal of\nthe expiry and, if the Tribunal was required to give undertakings as\nreferred to in section 19, that the undertakings are no longer\nrequired to be complied with.",
      "skos:definition": "If:\n(a) at the time a person was surrendered to a Tribunal under this\nPart, the person was serving a sentence of imprisonment in\nrespect of an offence against an Australian law, or was\notherwise subject to detention under an Australian law; and\n(b) each such sentence of imprisonment that the person was\nserving, or each such period of detention to which the person\nwas subject, at that time expires while the person is being\ndetained by, or on the order of, the Tribunal;\nthe Attorney-General must without delay inform the Tribunal of\nthe expiry and, if the Tribunal was required to give undertakings as\nreferred to in section 19, that the undertakings are no longer\nrequired to be complied with.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "242a399659de587a530e4e89b36bee5585e9e8bdfe18f51bffe50e2b44e22108",
      "skos:note": "Notify Tribunal of sentence expiry",
      "dc:description": "Information about sentence expiry"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Expiry of Australian sentences while under Tribunal detention",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "If:\n(a) at the time a person was surrendered to a Tribunal under this\nPart, the person was serving a sentence of imprisonment in\nrespect of an offence against an Australian law, or was\notherwise subject to detention under an Australian law; and\n(b) each such sentence of imprisonment that the person was\nserving, or each such period of detention to which the person\nwas subject, at that time expires while the person is being\ndetained by, or on the order of, the Tribunal;\nthe Attorney-General must without delay inform the Tribunal of\nthe expiry and, if the Tribunal was required to give undertakings as\nreferred to in section 19, that the undertakings are no longer\nrequired to be complied with."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Notification obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "The Attorney-General must inform the Tribunal."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25a",
      "@type": "cml:Concept",
      "skos:prefLabel": "25A Authorising provision of material obtained by law enforcement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-25a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.32",
      "values:originalText": "agencies\n(1) The Attorney-General may authorise, in writing, the provision of\nmaterial to a Tribunal if:\n(a) the Tribunal has requested the material; and\n(b) the Attorney-General is satisfied that:\n(i) the request relates to a proceeding before, or an\ninvestigation conducted by, the Tribunal; and\n(ii) the material was lawfully obtained in Australia by, and\nis lawfully in the possession of, a law enforcement\nagency.\n(2) The authorisation may:\n(a) specify the uses to which the material can be put by the\nTribunal; and\n(b) include a direction to a law enforcement officer of the law\nenforcement agency about how the material is to be provided\nto the Tribunal.\n(3) Material lawfully obtained in Australia includes:\n(a) material obtained from individuals or entities by consent; and\n(b) material obtained by warrant, or the exercise of a coercive\npower by a court, in Australia for the purposes of a domestic\ninvestigation or prosecution.\n\n\nOther forms of assistance to a Tribunal  Part 4\nTaking evidence etc.  Division 1\nSection 26\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "skos:definition": "agencies\n(1) The Attorney-General may authorise, in writing, the provision of\nmaterial to a Tribunal if:\n(a) the Tribunal has requested the material; and\n(b) the Attorney-General is satisfied that:\n(i) the request relates to a proceeding before, or an\ninvestigation conducted by, the Tribunal; and\n(ii) the material was lawfully obtained in Australia by, and\nis lawfully in the possession of, a law enforcement\nagency.\n(2) The authorisation may:\n(a) specify the uses to which the material can be put by the\nTribunal; and\n(b) include a direction to a law enforcement officer of the law\nenforcement agency about how the material is to be provided\nto the Tribunal.\n(3) Material lawfully obtained in Australia includes:\n(a) material obtained from individuals or entities by consent; and\n(b) material obtained by warrant, or the exercise of a coercive\npower by a court, in Australia for the purposes of a domestic\ninvestigation or prosecution.\n\n\nOther forms of assistance to a Tribunal  Part 4\nTaking evidence etc.  Division 1\nSection 26\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026",
      "cml:hasPart": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25a-ss-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25a-ss-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-25a-ss-3"
        }
      ],
      "cml:integrityHash": "1dfd1ef8d037f98e19e36a54b2d41d63fb1a7c0800194e73751421625c736562"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-25a",
      "@type": "cof:Section",
      "cof:title": "25A Authorising provision of material obtained by law enforcement",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "agencies\n(1) The Attorney-General may authorise, in writing, the provision of\nmaterial to a Tribunal if:\n(a) the Tribunal has requested the material; and\n(b) the Attorney-General is satisfied that:\n(i) the request relates to a proceeding before, or an\ninvestigation conducted by, the Tribunal; and\n(ii) the material was lawfully obtained in Australia by, and\nis lawfully in the possession of, a law enforcement\nagency.\n(2) The authorisation may:\n(a) specify the uses to which the material can be put by the\nTribunal; and\n(b) include a direction to a law enforcement officer of the law\nenforcement agency about how the material is to be provided\nto the Tribunal.\n(3) Material lawfully obtained in Australia includes:\n(a) material obtained from individuals or entities by consent; and\n(b) material obtained by warrant, or the exercise of a coercive\npower by a court, in Australia for the purposes of a domestic\ninvestigation or prosecution.\n\n\nOther forms of assistance to a Tribunal  Part 4\nTaking evidence etc.  Division 1\nSection 26\nInternational War Crimes Tribunals Act 1995\nCompilation date: 28/03/2026"
    },
