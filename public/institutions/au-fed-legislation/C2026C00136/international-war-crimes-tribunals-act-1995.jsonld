      "cml:premiseText": "(a) a police officer has, under this Act or pursuant to a warrant issued under this Act, power to arrest a person;",
      "cml:conclusionText": "the police officer may not enter the premises."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-logic-alleninterval-2",
