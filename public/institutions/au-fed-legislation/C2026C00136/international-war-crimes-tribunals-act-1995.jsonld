        }
      ],
      "cml:integrityHash": "1e05f52a8b3e001600b95229a1b7a74d9a6340a4080e5a9fe3f10a01b910b3ab",
      "skos:note": "Must be brought before court by which person was admitted to bail as soon as practicable after arrest."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-79-ss-2",
      "@type": "cof:Section",
