    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Effect of removal to foreign country on prisoners’ terms of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.49",
      "values:originalText": "imprisonment\nA person who is serving a sentence of imprisonment for an offence\nagainst a law of the Commonwealth or of a Territory, or is\notherwise subject to detention under a law of the Commonwealth\nor of a Territory, is taken to continue to serve that sentence of\nimprisonment, or to continue to be subject to that detention, at any\ntime during which the person:\n(a) is released from a prison pursuant to a request by a Tribunal\nunder section 36; and\n(b) is in custody in connection with the request (including\ncustody outside Australia).",
      "skos:definition": "imprisonment\nA person who is serving a sentence of imprisonment for an offence\nagainst a law of the Commonwealth or of a Territory, or is\notherwise subject to detention under a law of the Commonwealth\nor of a Territory, is taken to continue to serve that sentence of\nimprisonment, or to continue to be subject to that detention, at any\ntime during which the person:\n(a) is released from a prison pursuant to a request by a Tribunal\nunder section 36; and\n(b) is in custody in connection with the request (including\ncustody outside Australia).",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-alleninterval-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-ltl-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-diffusion-4"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "5958d6b69fe479ffc54f559f76781c1401eb29baf9fe9f2c8998cdc16e9f1114",
      "skos:note": "Continuation of imprisonment sentence while in custody outside Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Effect of removal to foreign country on prisoners’ terms of",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "imprisonment\nA person who is serving a sentence of imprisonment for an offence\nagainst a law of the Commonwealth or of a Territory, or is\notherwise subject to detention under a law of the Commonwealth\nor of a Territory, is taken to continue to serve that sentence of\nimprisonment, or to continue to be subject to that detention, at any\ntime during which the person:\n(a) is released from a prison pursuant to a request by a Tribunal\nunder section 36; and\n(b) is in custody in connection with the request (including\ncustody outside Australia)."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-38"
      },
