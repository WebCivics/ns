    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "51(3) Restrictions on personal searches",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.78",
      "values:originalText": "(3) The applicant must, not later than the day after the day of expiry of\nthe warrant or the day after the day on which the warrant was\nexecuted, whichever is the earlier, give or transmit to the\nmagistrate:\n(a) the form of warrant completed by the applicant; and\n(b) if the information referred to in subsection 52(3) was not\nsworn—that information duly sworn.",
      "skos:definition": "(3) The applicant must, not later than the day after the day of expiry of\nthe warrant or the day after the day on which the warrant was\nexecuted, whichever is the earlier, give or transmit to the\nmagistrate:\n(a) the form of warrant completed by the applicant; and\n(b) if the information referred to in subsection 52(3) was not\nsworn—that information duly sworn.",
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51"
      },
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-3-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-51-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c7f689c4c2bd81a79ac5f053f7536ca579fad810ebc41283252a590bcce57497",
      "skos:note": "Provide completed warrant form and sworn information within a specified timeframe. Application must include required information to obtain a warrant.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-51-ss-3",
      "@type": "cof:Section",
      "cof:title": "51(3) Restrictions on personal searches",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(3) The applicant must, not later than the day after the day of expiry of\nthe warrant or the day after the day on which the warrant was\nexecuted, whichever is the earlier, give or transmit to the\nmagistrate:\n(a) the form of warrant completed by the applicant; and\n(b) if the information referred to in subsection 52(3) was not\nsworn—that information duly sworn."
    },
