    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83",
      "@type": "cml:Concept",
      "skos:prefLabel": "83 Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-83"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.100",
      "values:originalText": "The Attorney-General may delegate to an officer of the\nAttorney-General’s Department all or any of his or her powers\nunder this Act, other than:\n(a) his or her powers under Part 3; or\n(b) the power to decide under subsection 26(3), 33(2), 35(2),\n36(4), 40(2) or 44(3) not to comply with a request by a\nTribunal.",
      "skos:definition": "The Attorney-General may delegate to an officer of the\nAttorney-General’s Department all or any of his or her powers\nunder this Act, other than:\n(a) his or her powers under Part 3; or\n(b) the power to decide under subsection 26(3), 33(2), 35(2),\n36(4), 40(2) or 44(3) not to comply with a request by a\nTribunal.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-alleninterval-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-ltl-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-diffusion-4"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "36d20b4c059d0887aaaa35c0bd29ea93893d5995689125ac9845629551091e8c",
      "skos:note": "Attorney-General may delegate powers under this Act to an officer."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-83",
      "@type": "cof:Section",
      "cof:title": "83 Delegation",
      "values:kind": "section",
      "cof:pageNumber": 100,
      "values:originalText": "The Attorney-General may delegate to an officer of the\nAttorney-General’s Department all or any of his or her powers\nunder this Act, other than:\n(a) his or her powers under Part 3; or\n(b) the power to decide under subsection 26(3), 33(2), 35(2),\n36(4), 40(2) or 44(3) not to comply with a request by a\nTribunal."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-83-norm",
