    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Release from remand on refusal to surrender the person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "international-war-crimes-tribunals-act-1995.pdf"
      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.27",
      "values:originalText": "If the Attorney-General has determined not to surrender the person\nto the Tribunal, the Attorney-General must, by notice in writing in\nthe statutory form, direct a magistrate to order:\n(a) the release of the person from custody; or\n(b) the discharge of the recognisances on which bail was granted\nto the person;\nas the case requires.",
      "skos:definition": "If the Attorney-General has determined not to surrender the person\nto the Tribunal, the Attorney-General must, by notice in writing in\nthe statutory form, direct a magistrate to order:\n(a) the release of the person from custody; or\n(b) the discharge of the recognisances on which bail was granted\nto the person;\nas the case requires.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-logic-deontic-1"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-logic-deontic-2"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-logic-alleninterval-3"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-logic-ltl-4"
        }
      ],
      "cml:integrityHash": "98946baac1440d7420b17d0876a2f41b64e3af32253f1396f4f7d22a60a3c152",
      "skos:note": "Release from remand on refusal to surrender the person"
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Release from remand on refusal to surrender the person",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "If the Attorney-General has determined not to surrender the person\nto the Tribunal, the Attorney-General must, by notice in writing in\nthe statutory form, direct a magistrate to order:\n(a) the release of the person from custody; or\n(b) the discharge of the recognisances on which bail was granted\nto the person;\nas the case requires."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-17-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide release from remand",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Attorney-General has determined not to surrender the person",
