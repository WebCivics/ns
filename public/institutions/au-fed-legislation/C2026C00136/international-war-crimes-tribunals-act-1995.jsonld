      "skos:note": "The Attorney-General may give the Commissioner a direction on how to deal with a thing."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-77-ss-3",
      "@type": "cof:Section",
