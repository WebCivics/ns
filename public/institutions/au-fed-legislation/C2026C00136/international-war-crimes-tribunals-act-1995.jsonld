      },
      "dc:source": "international-war-crimes-tribunals-act-1995.pdf, p.89",
      "values:originalText": "(1) A person must not, in the course of arresting another person under\nthis Act or pursuant to a warrant issued under this Act, use more\nforce, or subject the other person to greater indignity, than is\nnecessary and reasonable to make the arrest or to prevent the\nescape of the other person after the arrest.",
      "skos:definition": "(1) A person must not, in the course of arresting another person under\nthis Act or pursuant to a warrant issued under this Act, use more\nforce, or subject the other person to greater indignity, than is\nnecessary and reasonable to make the arrest or to prevent the\nescape of the other person after the arrest.",
      "cml:asserts": [
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-66-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-66-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ea7a966727dc749d62b95544474786a51aa320fc3213a1ce05ffbf3bee92956e",
      "skos:note": "Use of force in making arrest must be reasonable and necessary."
    },
