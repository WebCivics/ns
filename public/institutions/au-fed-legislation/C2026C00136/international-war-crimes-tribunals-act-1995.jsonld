          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32a-ss-1-norm"
        },
        {
          "@id": "concept:international-war-crimes-tribunals-act-1995-sec-32a-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45dae0e99d1abbee6149a08c92aad9b8addf9c1486110c07fc8f31a741533f6e",
      "skos:note": "The Attorney-General must authorise an eligible law enforcement officer to apply for a surveillance device warrant."
    },
    {
      "@id": "https://ns.webcivics.net/values/international-war-crimes-tribunals-act-1995#sec-32a-ss-1",
      "@type": "cof:Section",
