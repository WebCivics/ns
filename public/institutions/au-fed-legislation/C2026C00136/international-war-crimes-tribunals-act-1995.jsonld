      },
      "cml:operator": "Diffusion",
      "cml:logicSummary": "Diffusion of information about premises.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a police officer has, under this Act or pursuant to a warrant issued under this Act, power to arrest a person;",
      "cml:conclusionText": "information about the premises is diffused through the police officer's actions."
    },
    {
      "@id": "concept:international-war-crimes-tribunals-act-1995-sec-65-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
