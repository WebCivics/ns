      "cml:logicSummary": "FWC must approve enterprise agreement within a certain timeframe",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "(2) The FWC must be satisfied that approving the agreement would not be inconsistent with or undermine good faith bargaining by one or more bargaining representatives for a proposed enterprise agreement, or an enterprise agreement, in relation to which a scope order is in operation."
    },
