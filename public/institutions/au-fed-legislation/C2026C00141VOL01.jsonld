      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Paid annual leave accrues progressively during a year of service.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The employee's ordinary hours of work, and accumulates from year to year."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-87-ss-2-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Fair Work Act 2009 has defined the entitlement to paid annual leave.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
