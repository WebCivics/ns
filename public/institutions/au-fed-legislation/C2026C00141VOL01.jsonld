    {
      "@id": "concept:fair-work-act-2009-sec-51",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.177",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "51 The significance of an enterprise agreement applying to a person"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sec-51-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sec-51-ss-2"
        }
      ],
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-51",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.177",
      "skos:note": "An enterprise agreement does not impose obligations on a person unless the agreement applies to the person.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "51(1) The significance of an enterprise agreement applying to a person"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-51-ss-1-norm",
        "concept:fair-work-act-2009-sec-51-ss-1-logic-deontic-1",
        "concept:fair-work-act-2009-sec-51-ss-1-logic-deontic-2",
        "concept:fair-work-act-2009-sec-51-ss-1-logic-linearlogic-3",
        "concept:fair-work-act-2009-sec-51-ss-1-logic-alleninterval-4",
        "concept:fair-work-act-2009-sec-51-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "2a5b867b112f82c3fa80af2a932bf754478ba9f1dc91865b593c34ee285ea7dc",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-51-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:fair-work-act-2009-sec-51"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The obligation imposed by an enterprise agreement commences when the agreement applies to a person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal inclusion of obligation commencement",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "⊆",
      "cml:premiseText": "An enterprise agreement commences when it applies to a person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is not obligated by an enterprise agreement unless the agreement applies to the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Negation of obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "¬",
      "cml:premiseText": "An enterprise agreement does not impose obligations on a person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is obligated by an enterprise agreement if and only if the agreement applies to the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Equivalence of obligation and applicability",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "An enterprise agreement does not impose obligations on a person unless the agreement applies to the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is not obligated by an enterprise agreement if and only if the agreement does not apply to the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Negation of obligation applicability",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "~",
      "cml:premiseText": "An enterprise agreement does not apply to a person unless the agreement imposes obligations on the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If an enterprise agreement does not impose obligations on a person, then the agreement does not apply to the person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implication of obligation and applicability",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "⇒",
      "cml:premiseText": "An enterprise agreement does not impose obligations on a person unless the agreement applies to the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-51-ss-1-norm",
      "@type": "doc:Obligation",
