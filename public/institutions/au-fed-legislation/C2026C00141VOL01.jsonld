    {
      "@id": "concept:fair-work-act-2009-sec-214-ss-1",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.425",
      "skos:note": "FWC may refuse to approve a variation of an enterprise agreement if it may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "214(1) When the FWC may refuse to approve a variation of an"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-214-ss-1-norm",
        "concept:fair-work-act-2009-sec-214-ss-1-logic-deontic-1",
        "concept:fair-work-act-2009-sec-214-ss-1-logic-deontic-2",
        "concept:fair-work-act-2009-sec-214-ss-1-logic-alleninterval-3",
        "concept:fair-work-act-2009-sec-214-ss-1-logic-ltl-4",
        "concept:fair-work-act-2009-sec-214-ss-1-logic-diffusion-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "701ee8f3ca491074592dd492a7faebf366dee8fa5fb315591b5662697af23dab",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-214-ss-1",
