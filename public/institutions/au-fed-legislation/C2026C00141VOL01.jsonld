    },
    {
      "@id": "concept:fair-work-act-2009-sec-15a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.94",
      "skos:note": "An employee is a casual employee of an employer only if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15A(1) Meaning of casual employee"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-15a-ss-1-norm",
        "concept:fair-work-act-2009-sec-15a-ss-1-logic-alleninterval-1",
        "concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-2",
        "concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "ff8441f3fbb7c99531b8147dfc573657b314e41350b171e04d3c83102706d685",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-15a-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:fair-work-act-2009-sec-15a"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-15a-ss-1-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employment relationship lasts for at least...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the duration of employment as a casual employee",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "An employee who commences employment as a casual employee remains a casual employee until the occurrence of a specified event (see subsection (5));"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conditions are:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Classifies the conditions for an employee to be considered a casual employee",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) the employment relationship is characterised by an absence of a firm advance commitment to continuing and indefinite work; and (b) the employee would be entitled to a casual loading or a specific rate of pay for casual employees under the terms of a fair work instrument if the employee were a casual employee, or the employee is entitled to such a loading or rate of pay under the contract of employment."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee is entitled to a casual loading or specific rate of pay if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Classifies the entitlement to a casual loading or specific rate of pay for casual employees",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(b) the employee would be entitled to a casual loading or a specific rate of pay for casual employees under the terms of a fair work instrument if the employee were a casual employee, or the employee is entitled to such a loading or rate of pay under the contract of employment."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-15a-ss-1-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
