      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-216cd",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216cd-ss-1",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.438",
      "skos:note": "FWC may refuse to approve a variation of a cooperative workplace agreement if it may result in an offence against a law or a pecuniary penalty.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "216CD(1) When the FWC may refuse to approve a variation of a"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-216cd-ss-1-norm",
        "concept:fair-work-act-2009-sec-216cd-ss-1-logic-deontic-1",
        "concept:fair-work-act-2009-sec-216cd-ss-1-logic-alleninterval-2",
        "concept:fair-work-act-2009-sec-216cd-ss-1-logic-ltl-3",
        "concept:fair-work-act-2009-sec-216cd-ss-1-logic-diffusion-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "8b78819d99e64b77102f1e9d96e25d2b6b53b948914fa32de2c1351f721c13c7",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-216cd-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:fair-work-act-2009-sec-216cd"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216cd-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance with the terms of the agreement as proposed to be varied may result in an offence against a law or a pecuniary penalty during the period of variation",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Compliance with the terms of the agreement as proposed to be varied may result in an offence against a law or a pecuniary penalty during the period of variation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "compliance with the terms of the agreement as proposed to be varied may result in: (a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216cd-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "FWC may not approve the variation",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of approving the variation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "refuse",
      "cml:premiseText": "compliance with the terms of the agreement as proposed to be varied may result in an offence against a law or a pecuniary penalty."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216cd-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC considers that compliance with the terms of the agreement as proposed to be varied may result in an offence against a law or a pecuniary penalty if certain conditions are met",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The FWC considers that compliance with the terms of the agreement as proposed to be varied may result in an offence against a law or a pecuniary penalty if certain conditions are met",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if",
      "cml:premiseText": "compliance with the terms of the agreement as proposed to be varied may result in: (a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216cd-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance with the terms of the agreement as proposed to be varied may result in an offence against a law or a pecuniary penalty during the period of variation",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
