        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "Employee has completed at least 12 months of continuous service or is a regular casual employee with a reasonable expectation of continuing employment"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-65-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This condition applies to the request for flexible working arrangements",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
