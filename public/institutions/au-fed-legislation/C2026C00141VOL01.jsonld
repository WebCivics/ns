    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.468",
      "skos:note": "Bargaining representative must apply for bargaining order under certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "229(4) Applications for bargaining orders"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-229-ss-4-norm",
        "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-1",
