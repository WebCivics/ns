    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Applicability of A ⊆ Obligation",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The applicability of a modern award to a person overlaps with the obligation imposed by the award.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(A or B) and (not A or not B)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If A, then B.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(not A or B)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "A modern award may not impose obligations on a person unless the award applies to the person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "NotImplying",
      "cml:premiseText": "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(not A or B)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the applicability of a modern award to a person overlaps with the obligation imposed by the award, then the award imposes obligations on the person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Obligation ⊆ Until(A)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The obligation imposed by a modern award is until the applicability of the award to the person.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award."
    },
