      "partOf": "concept:fair-work-act-2009-sec-229"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide written notice to relevant bargaining representatives.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) has given a written notice setting out those concerns..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must respond to written notice within a reasonable time.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(c) has given the relevant bargaining representatives a reasonable time..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must meet good faith bargaining requirements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) has concerns that one or more of the bargaining representatives for the agreement have not met, or are not meeting, the good faith bargaining requirements..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must proceed with bargaining process fairly and efficiently.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) has concerns that the bargaining process is not proceeding efficiently or fairly because there are multiple bargaining representatives for the agreement..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...Non-compliance with notice requirements may be permitted",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must comply with notice requirements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(4) The bargaining representative may only apply for the bargaining order if..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (4) The bargaining representative may only apply for the bargaining order if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must not have concerns that are not addressed.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(d) considers that the relevant bargaining representatives have not responded appropriately to those concerns."
    },
