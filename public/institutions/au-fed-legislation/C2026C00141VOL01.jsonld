    },
    {
      "@id": "concept:fair-work-act-2009-sec-91-ss-1",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.246",
      "skos:note": "Employee is not entitled to payment for untaken annual leave if service with first employer counts as service with second employer.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "91(1) Transfer of employment situations that affect entitlement to"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-91-ss-1-norm",
        "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-1",
        "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-2",
        "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-3",
        "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-4",
        "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "8bbfd6faf880adf4d25d298a631f60ce52cea41c4253154a851de8a14d275442",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-91-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:fair-work-act-2009-sec-91"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employee is not entitled to payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the second employer decides not to recognize the employee's service, then the employee is not entitled to payment.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Second employer decides not to recognize employee's service."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employee's entitlement to payment is conditional on recognition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The employee's entitlement to payment depends on the second employer's recognition of their service.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Second employer's recognition of employee's service is necessary for payment."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employee is entitled to payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the second employer recognizes the employee's service, then the employee is entitled to payment.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Second employer recognizes employee's service."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It applies to non-associated entities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The provision applies to transfers of employment between non-associated entities.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "This provision applies to transfers of employment."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-91-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is a part of the Standards.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The provision is part of the National Employment Standards.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "This provision is in the National Employment Standards."
    },
