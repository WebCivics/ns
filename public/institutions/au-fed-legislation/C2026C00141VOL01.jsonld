      "cml:logicSummary": "Employee has a right.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRight",
      "cml:premiseText": "Entitlement is also affected by section 68 (which deals with the age etc. of the adopted child)."
    },
