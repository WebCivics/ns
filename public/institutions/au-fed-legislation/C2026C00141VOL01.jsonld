      },
      "cml:operator": "excludes",
      "cml:premiseText": "(2) If the period during which an employee takes paid annual leave includes a period of any other leave (other than unpaid parental leave) under this Part, or a period of absence from employment under Division 8..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-89-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(employee is not on paid annual leave for that period).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
