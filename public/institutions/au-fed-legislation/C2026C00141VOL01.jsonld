      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Award application is necessary for entitlement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:premiseText": "(2) A modern award does not give a person an entitlement unless the award applies to the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The award allows the person to have an entitlement if it applies",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Award application is permissive for entitlement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(2) A modern award does not give a person an entitlement unless the award applies to the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The award does not allow the person to have an entitlement if it does not apply",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Award application is prohibited for entitlement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) A modern award does not give a person an entitlement unless the award applies to the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The award gives the person a right to have an entitlement if it applies",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Award application is a right for entitlement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:premiseText": "(2) A modern award does not give a person an entitlement unless the award applies to the person."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-46-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The award undertakes to give the person an entitlement if it applies",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Award application is an undertaking for entitlement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Undertaking",
      "cml:premiseText": "(2) A modern award does not give a person an entitlement unless the award applies to the person."
    },
