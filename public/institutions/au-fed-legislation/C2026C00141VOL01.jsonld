    {
      "@id": "concept:fair-work-act-2009-sec-253-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A term of an enterprise agreement has no effect to the extent that it contravenes section 55.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Terms with no effect are those that occur during the commencement of the enterprise agreement.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Note 1: A term of an enterprise agreement has no effect to the extent that it contravenes section 55 (see section 56)."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-253-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A term of an enterprise agreement has no effect to the extent that: (a) it is not a term about a permitted matter; or (b) it is an unlawful term; or (c) it is a designated outworker term.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Invalidates a term if it is not about permitted matters, unlawful terms, or designated outworker terms.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "invalidates",
      "cml:premiseText": "(a) it is not a term about a permitted matter; (b) it is an unlawful term; (c) it is a designated outworker term."
    },
    {
