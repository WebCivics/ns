      "cml:premiseText": "Modern awards and enterprise agreements may include terms"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-93-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If a modern award or enterprise agreement includes terms, then it implies that the employer must diffuse the provision for cashing out paid annual leave to all employees.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
