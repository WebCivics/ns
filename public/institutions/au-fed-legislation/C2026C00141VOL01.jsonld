        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "Taking paid leave or performing work on a keeping in touch day."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-79b-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "These activities repeat within the unpaid parental leave period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
