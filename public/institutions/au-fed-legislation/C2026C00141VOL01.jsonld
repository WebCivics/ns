      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC must approve the agreement within a certain timeframe if it would undermine good faith bargaining.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
