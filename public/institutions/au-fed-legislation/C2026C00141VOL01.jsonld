      "cml:logicSummary": "FWC must not have regard to certain patterns of work.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT HAVE REGARD TO",
      "cml:premiseText": "(b) at the test time or a later time, one or more employees covered by subsection (4) or (5) engaged in other patterns or kinds of work..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-227a-ss-2-logic-descriptionlogic-2",
