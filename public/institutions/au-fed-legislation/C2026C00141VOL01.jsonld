    {
      "@id": "concept:fair-work-act-2009-sec-23b-ss-1-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or (ii) civil construction within the meaning of paragraph 4.3(b) of the Building and Construction General On-site Award 2020 as in force at the applicable time;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(i) general building and construction within the meaning of paragraph 4.3(a) of the Building and Construction General On-site Award 2020 as in force at the applicable time;"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-23b-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or (b) the work is not any of the following...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) the work is done onsite by an employee in the industry of:"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-23b-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or (vii) work in the black coal mining industry within the meaning of clause 4.2 of the Black Coal Mining Industry Award 2020 as in force at the applicable time;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(b) the work is not any of the following:"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-23b-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or (xiv) work, in that part of the industry of civil construction described in subparagraph 4.3(b)(i) of the Building and Construction General On-site Award 2020 as in force at the applicable time, that is the construction, repair, maintenance or demolition of power houses or other structures...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "(xiii) work in the asphalt industry within the meaning of clause 4.2 of the Asphalt Industry Award 2020 as in force at the applicable time;"
    },
