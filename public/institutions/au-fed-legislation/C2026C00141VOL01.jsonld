      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Base rate of pay under an enterprise agreement is between the employee's order rate and the national minimum wage.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:premiseText": "(3) If: ...; the base rate of pay payable to the employee under the enterprise agreement (the agreement rate) must not be less than the employee’s order rate."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-206-ss-3-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
