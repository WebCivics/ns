    {
      "@id": "concept:fair-work-act-2009-sec-211-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval for approval is between 0 and 4 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for approval of variation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The FWC must approve the variation within 4 years after its initial approval."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-211-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The approval of the variation implies that the FWC has fulfilled its obligations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of FWC's obligation to approve variation",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "If the conditions are met, the FWC must approve the variation."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-211-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The classification implies that it is a cogent AI requirement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Classification of FWC's obligation as a cogent AI requirement",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The FWC's obligation to approve the variation is a requirement for all relevant parties."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-211-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the conditions are met, the FWC must approve the variation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to approve variation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The FWC must approve the variation."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-211-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The diffusion of the obligation implies that it applies to all relevant parties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
