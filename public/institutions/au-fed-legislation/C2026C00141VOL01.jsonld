    {
      "@id": "concept:fair-work-act-2009-sec-91",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.246",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "91 Transfer of employment situations that affect entitlement to"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:hasPart": [
        {
