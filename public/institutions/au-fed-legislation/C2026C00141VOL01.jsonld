        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes the termination of a State's transition reference.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Termination",
      "cml:premiseText": "(c) the State’s transition reference terminates."
    },
