      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of using employee information for unauthorized purposes.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must Not",
      "cml:premiseText": "Employer must not use such information for a purpose other than satisfying itself in relation to the employee’s entitlement to leave under this Subdivision."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-106c-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An employer must not use such information to take adverse action against an employee.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
