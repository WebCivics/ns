    {
      "@id": "concept:fair-work-act-2009-sec-1-6-ss-2-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the State's referral law provides that...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the temporal interval for the referral law",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "<=",
      "cml:premiseText": "July 2009 but on or before 1 January 2010"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-1-6-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A State is a referring State even if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the relationship between the referral law and the Parliament of the Commonwealth",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "<=>",
      "cml:premiseText": "the State's referral law provides that particular matters, or all matters, relating to State public sector employees, or State public sector employers, of the State are not included in any or all of the matters covered by subsections (3), (4) and (5)"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-1-6-ss-2-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A State is a referring State even if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes the relationship between the referral law and the Parliament of the Commonwealth",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=>",
      "cml:premiseText": "the State's referral law provides that the reference to the Parliament of the Commonwealth of any or all of the matters covered by subsections (3), (4) and (5) is to terminate in particular circumstances"
    },
