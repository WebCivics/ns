      },
      "cml:operator": "IS A CLASS OF EMPLOYEES",
      "cml:premiseText": "(ii) if the agreement is a single-enterprise agreement that covers one or more employees to whom a supported bargaining agreement or a single interest employer agreement applies—those employees..."
    },
