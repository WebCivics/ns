    {
      "@id": "concept:fair-work-act-2009-sec-1-6-ss-2",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.148",
      "skos:note": "A State is a referring State even if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "1(2) July 2009 but on or before 1 January 2010, referred the matters"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-1-6-ss-2-norm",
        "concept:fair-work-act-2009-sec-1-6-ss-2-logic-alleninterval-1",
