      },
      "cml:operator": "and",
      "cml:premiseText": "(a) and (b) and (c)"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-47-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
