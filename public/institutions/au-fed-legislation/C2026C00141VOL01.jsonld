    {
      "@id": "concept:fair-work-act-2009-sec-93-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The cashing out of paid annual leave occurs during the period of employment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
