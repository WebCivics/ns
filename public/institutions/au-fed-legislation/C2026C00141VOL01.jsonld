      "partOf": "concept:fair-work-act-2009-sec-214"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-214-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC may refuse to approve the variation if it overlaps with potential legal consequences.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlap between the proposed variation and potential legal consequences.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-214-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC may refuse to approve the variation if it may result in a crime or penalty.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of approving the variation if it may result in a crime or penalty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-214-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC may refuse to approve the variation if it may result in a liability for a pecuniary penalty.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of approving the variation if it may result in a liability for a pecuniary penalty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-214-ss-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The diffusion of the prohibition from the FWC to the applicant is that they may refuse to approve the variation if it may result in a crime or penalty.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of the prohibition from the FWC to the applicant.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-214-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC may refuse to approve the variation if it repeats the condition that it may result in a crime or penalty.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Repetition of the condition that the FWC may refuse to approve the variation if it may result in a crime or penalty.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth."
    },
