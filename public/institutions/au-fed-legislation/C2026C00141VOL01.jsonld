    {
      "@id": "concept:fair-work-act-2009-sec-87-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The paid annual leave accrues during the year of service.",
      "cml:confidence": {
        "@type": "xsd:decimal",
