    {
      "@id": "concept:fair-work-act-2009-sec-192-ss-1",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.391",
      "skos:note": "FWC may refuse to approve an enterprise agreement if it considers that compliance with the terms of the agreement may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty.",
