      "cml:operator": "MUST",
      "cml:premiseText": "A majority of affected employees must approve the variation."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216c-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The diffusion of approval starts from the moment the majority of affected employees cast their votes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
