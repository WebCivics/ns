      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the termination of a State's initial, amendment, or transition references.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Termination",
      "cml:premiseText": "(b) the State’s amendment reference terminates, and neither of subsections (7) and (8) apply to the termination;"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-1-6-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
