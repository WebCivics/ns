      "cml:logicSummary": "The Fair Work Act 2009 defines the entitlement to paid annual leave.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "has",
      "cml:premiseText": "The National Employment Standards Chapter 2 The National Employment Standards Part 2-2 Annual leave Division 6 Section 88 Fair Work Act 2009"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-87-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee accrues paid annual leave up to when the employment ends.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Employee has an obligation to accrue paid annual leave.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The employee's employment ends during what would otherwise have been a year of service."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-87-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Every year, the paid annual leave accumulates.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Paid annual leave accumulates from year to year.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "every",
      "cml:premiseText": "The employee's ordinary hours of work, and accumulates from year to year."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-87-ss-2-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee's employment ending during a year of service affects their accrued paid annual leave.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:logicSummary": "The employee's employment ends during what would otherwise have been a year of service.",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "has",
      "cml:premiseText": "If an employee’s employment ends during what would otherwise have been a year of service, the employee accrues paid annual leave up to when the employment ends."
    },
