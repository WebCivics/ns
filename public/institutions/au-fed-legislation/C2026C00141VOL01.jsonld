        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The employee needs to do something to deal with the impact of family and domestic violence."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-106b-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employer must comply with the notice and evidence requirements of section 107.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Employer must comply with notice and evidence requirements of section 107.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "The notice and evidence requirements of section 107 must be complied with."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-106b-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employer must provide a safe work environment for the employee.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Employer must provide a safe work environment.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "Examples of actions, by an employee who is experiencing family and domestic violence, that could be covered by paragraph (b) include..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-106b-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee must take paid family and domestic violence leave every time they need to deal with family and domestic violence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Employee must take leave every time they need to deal with family and domestic violence.",
