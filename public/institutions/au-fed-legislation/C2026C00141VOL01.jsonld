      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.194",
      "skos:note": "Request for flexible working arrangements requires minimum service period or regular casual employment",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "65(2) Requests for flexible working arrangements"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
