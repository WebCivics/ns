      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with transfer of employment between non-associated entities",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(1) Subsection 22(5) does not apply (for the purpose of this Subdivision) to a transfer of employment between non-associated entities in relation to an employee if the second employer decides not to recognise the employee’s service with the first employer (for the purpose of this Subdivision)."
    },
