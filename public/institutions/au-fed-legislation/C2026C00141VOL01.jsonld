      "cml:logicSummary": "Temporal interval for approval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:premiseText": "The variation is made when a majority of the affected employees who cast a valid vote approve the variation."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216c-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An artificial intelligence system can be applied to facilitate the approval process.",
      "cml:confidence": {
