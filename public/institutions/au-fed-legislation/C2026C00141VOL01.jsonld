    {
      "@id": "concept:fair-work-act-2009-sec-68",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.213",
      "skos:note": "Eligibility for adoption-related leave based on child's age and residency.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "68 General rule for adoption-related leave—child must be under 16"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-68-norm",
        "concept:fair-work-act-2009-sec-68-logic-alleninterval-1",
        "concept:fair-work-act-2009-sec-68-logic-deontic-2",
        "concept:fair-work-act-2009-sec-68-logic-deontic-3",
        "concept:fair-work-act-2009-sec-68-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "f6e688bef865198ab4f91e8564a9d4f3c354e244b1ba0c6ec7475c1e9e3a9e7d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-68",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-68-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "6-month residency requirement",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "has not lived continuously with employee for a period of 6 months as at day of placement or expected day of placement"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-68-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Child must meet both conditions to be eligible",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "and",
      "cml:premiseText": "(a) is, or will be, under 16 as at the day of placement, or the expected day of placement, of the child; and (b) has not, or will not have, lived continuously with the employee for a period of 6 months or more as at the day of placement, or the expected day of placement, of the child;"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-68-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Child cannot be employee's child or spouse/partner",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "and",
      "cml:premiseText": "is not (otherwise than because of the adoption) a child of the employee or the employee’s spouse or de facto partner."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-68-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Employee's eligibility for leave is tied to these conditions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "An employee is not entitled to adoption-related leave unless the child that is, or is to be, placed with the employee for adoption: ..."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-68-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:fair-work-act-2009-sec-68"
    },
