      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If an enterprise agreement applies to an employee, then the base rate of pay under the agreement must not be less than the employee's order rate.",
