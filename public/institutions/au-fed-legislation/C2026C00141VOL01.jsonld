      "cml:logicSummary": "Cashing out paid annual leave during employment",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "A modern award or enterprise agreement may include terms providing for the cashing out of paid annual leave by an employee."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-93-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If a modern award or enterprise agreement includes terms, then it implies that the employer must take a cognitive action to provide terms for cashing out paid annual leave.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Employer obligation implies cognitive action of providing terms for cashing out paid annual leave",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "implies",
      "cml:premiseText": "A modern award or enterprise agreement may include terms providing for the cashing out of paid annual leave by an employee."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-93-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employer must provide terms for cashing out paid annual leave.",
      "cml:confidence": {
