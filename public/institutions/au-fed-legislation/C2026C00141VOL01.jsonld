    {
      "@id": "concept:fair-work-act-2009-sec-37-ss-2",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.161",
      "skos:note": "The Crown is not liable to prosecution for an offence, except as provided by subsection (3).",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "37(2) Act binds Crown"
      },
      "wasDerivedFrom": "fair-work-act-2009.pdf",
      "asserts": [
        "concept:fair-work-act-2009-sec-37-ss-2-norm",
        "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-1",
        "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-2",
        "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-3",
        "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-4",
        "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d645c8be021a8b5cd223689d9f42bed2740da23c20be8ce113ebf2c89f02d421",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:fair-work-act-2009#sec-37-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:fair-work-act-2009-sec-37"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Prosecution is not allowed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the Crown is not liable, then prosecution is not allowed.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "The Act does not make the Crown liable to be prosecuted."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There are exceptions to this rule.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The provision excludes certain cases where the Crown may be liable to prosecution.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Excludes",
      "cml:premiseText": "This Act does not make the Crown liable to be prosecuted, except as provided for by subsection (3)."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Prosecution may be allowed in that case.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If there is an exception, then prosecution may be allowed in that case.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "The Crown is not liable to prosecution for an offence, except as provided for by subsection (3)."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This provision applies to all such cases.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "This provision applies to all cases where the Crown is not liable to prosecution.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "ForAll",
      "cml:premiseText": "The Act does not make the Crown liable to be prosecuted, except as provided for by subsection (3)."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-37-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There may be such cases.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "There may be cases where the Crown is not liable to prosecution.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "ForSome",
      "cml:premiseText": "The Crown is not liable to prosecution for an offence, except as provided for by subsection (3)."
    },
