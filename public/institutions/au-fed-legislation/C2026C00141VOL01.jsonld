      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits a State from being a referring State under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(6) Despite anything to the contrary in a referral law of a State, a State ceases to be a referring State if any or all of the following occurs:"
    },
