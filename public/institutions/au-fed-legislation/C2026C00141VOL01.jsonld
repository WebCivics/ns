    {
      "@id": "concept:fair-work-act-2009-sec-153-ss-2",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.315",
      "skos:note": "No discrimination against employees based on inherent position requirements or religious susceptibilities.",
