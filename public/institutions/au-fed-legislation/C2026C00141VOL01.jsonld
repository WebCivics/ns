    {
      "@id": "concept:fair-work-act-2009-sec-85-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The leave can occur during certain times.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Leave can occur during certain times.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(1) An employee is entitled to up to 2 days of unpaid pre-adoption leave to attend any interviews or examinations required in order to obtain approval for the employee’s adoption of a child."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-85-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee has a right to unpaid pre-adoption leave.",
      "cml:confidence": {
