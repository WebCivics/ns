    {
      "@id": "concept:fair-work-act-2009-sec-65-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This condition applies to the request for flexible working arrangements",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Employee must have completed at least 12 months of continuous service or be employed on a regular casual basis during a period of at least 12 months",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Employee has completed at least 12 months of continuous service or is employed on a regular casual basis during a period of at least 12 months"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-65-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Request for flexible working arrangements is only allowed under these conditions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires employee to meet certain conditions before making a request",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "Employee must have completed at least 12 months of continuous service or be a regular casual employee with a reasonable expectation of continuing employment"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-65-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employer must not allow requests for flexible working arrangements unless employee meets these conditions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
