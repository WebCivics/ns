    {
      "@id": "concept:fair-work-act-2009-sec-216c-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval for approval starts when the majority of affected employees cast their votes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
