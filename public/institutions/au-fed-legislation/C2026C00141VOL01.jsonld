      "cml:operator": "CONTAINS",
      "cml:premiseText": "The variation is made when a majority of the affected employees who cast a valid vote approve the variation."
    },
    {
      "@id": "concept:fair-work-act-2009-sec-216c-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The variation is approved if a majority of affected employees approve it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
