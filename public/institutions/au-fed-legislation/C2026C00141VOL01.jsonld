    {
      "@id": "concept:fair-work-act-2009-sec-1-6-ss-7",
      "@type": "cml:Concept",
      "dc:source": "fair-work-act-2009.pdf, p.148",
      "skos:note": "A State does not cease to be a referring State under certain conditions.",
