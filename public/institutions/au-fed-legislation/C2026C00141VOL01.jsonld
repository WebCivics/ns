      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the employee is entitled to continue on that leave for the rest of that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Employee has a right to continue leave period.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) If there is a transfer of employment in relation to an employee; and the employee has already started a period of leave under this Division when the employee’s employment with the first employer ends;"
    },
    {
      "@id": "concept:fair-work-act-2009-sec-69-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the employee is entitled to continue on that leave for the rest of that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Leave period diffuses into new employment.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "(b) the employee has already started a period of leave under this Division when the employee’s employment with the first employer ends;"
