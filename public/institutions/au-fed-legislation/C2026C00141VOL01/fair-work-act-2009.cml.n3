concept:fair-work-act-2009-sec-15j a cml:Concept ;
    skos:prefLabel "15J Prospective regulated workers"@en ;
    cml:realizedBy doc:sec-15j ;
    values:originalText "A reference to a regulated worker, in relation to a services contract, includes a reference to a person who may become a regulated worker for a services contract." ;
    skos:definition "A reference to a regulated worker, in relation to a services contract, includes a reference to a person who may become a regulated worker for a services contract."@en ;
