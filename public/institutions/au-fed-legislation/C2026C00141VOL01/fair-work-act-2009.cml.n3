    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Employee's eligibility for leave is tied to these conditions" ;
    cml:premiseText "An employee is not entitled to adoption-related leave unless the child that is, or is to be, placed with the employee for adoption: ..." ;
