concept:fair-work-act-2009-sec-100 a cml:Concept ;
    skos:prefLabel "100 Paid personal/carer’s leave must not be cashed out except in"@en ;
    cml:realizedBy doc:sec-100 ;
    values:originalText "accordance with permitted cashing out terms Paid personal/carer’s leave must not be cashed out, except in accordance with cashing out terms included in a modern award or enterprise agreement under section 101." ;
    skos:definition "accordance with permitted cashing out terms Paid personal/carer’s leave must not be cashed out, except in accordance with cashing out terms included in a modern award or enterprise agreement under section 101."@en ;
