concept:fair-work-act-2009-sec-45 a cml:Concept ;
    skos:prefLabel "45 Contravening a modern award"@en ;
    cml:realizedBy doc:sec-45 ;
    values:originalText "A person must not contravene a term of a modern award. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a modern award unless the award applies to the person: see subsection 46(1)." ;
    skos:definition "A person must not contravene a term of a modern award. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a modern award unless the award applies to the person: see subsection 46(1)."@en ;
    cml:integrityHash "0b8f90d8978e8d8d5f8097e583605dfb3fe60e22afb5f121c6dd23f3111c91bf" ;
    cof:pageNumber "173"^^xsd:integer ;
    skos:note "Prohibition on contravening a modern award term" ;
    cml:curationStatus cml:Proposed ;
