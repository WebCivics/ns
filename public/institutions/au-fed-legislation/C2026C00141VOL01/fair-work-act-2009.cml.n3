doc:sec-23-ss-2 a cof:Section ;
    cof:title "23(2) Meaning of small business employer" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purpose of calculating the number of employees employed by the employer at a particular time: (a) subject to paragraph (b), all employees employed by the employer at that time are to be counted; and (b) a casual employee is not to be counted unless, at that time, the employee is a regular casual employee of the employer." ;
    cof:pageNumber "122"^^xsd:integer .

concept:fair-work-act-2009-sec-23-ss-3 a cml:Concept ;
    skos:prefLabel "23(3) Meaning of small business employer"@en ;
    cml:realizedBy doc:sec-23-ss-3 ;
    values:originalText "(3) For the purpose of calculating the number of employees employed by the employer at a particular time, associated entities are taken to be one entity.  Introduction  Chapter 1 Definitions  Part 1-2 Other definitions  Division 4 Section 23A Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "(3) For the purpose of calculating the number of employees employed by the employer at a particular time, associated entities are taken to be one entity.  Introduction  Chapter 1 Definitions  Part 1-2 Other definitions  Division 4 Section 23A Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "89645529d1b9d6b09accbe0662df7fe8c3533e9f1ae08083bef335bf0d64b279" ;
    values:partOf concept:fair-work-act-2009-sec-23 ;
    cof:pageNumber "122"^^xsd:integer ;
    skos:note "Associated entities are taken to be one entity for calculating the number of employees." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
