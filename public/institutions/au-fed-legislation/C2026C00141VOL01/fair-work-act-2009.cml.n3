concept:fair-work-act-2009-sec-156u a cml:Concept ;
    skos:prefLabel "156U Publishing documents under this Division"@en ;
    cml:realizedBy doc:sec-156u ;
    values:originalText "If the FWC is required by this Division to publish a document, the FWC must publish the document on its website or by any other means that the FWC considers appropriate.  Chapter 2  Terms and conditions of employment" ;
