doc:sec-106ba-ss-2 a cof:Section ;
    cof:title "106BA(2) Payment for paid family and domestic violence leave" ;
    values:kind "subsection" ;
    values:originalText "(2) Without limiting paragraph (1)(b), an employee is taken to have been rostered to work hours in a period if the employee has accepted an offer by the employer of work for those hours." ;
    cof:pageNumber "257"^^xsd:integer .

concept:fair-work-act-2009-sec-106ba-ss-3 a cml:Concept ;
    skos:prefLabel "106BA(3) Payment for paid family and domestic violence leave"@en ;
    cml:realizedBy doc:sec-106ba-ss-3 ;
    values:originalText "(3) Paragraph (1)(b) does not prevent a casual employee from taking a period of paid family and domestic violence leave that does not include hours for which the employee is rostered to work. However, the employer is not required to pay the employee in relation to such a period." ;
    skos:definition "(3) Paragraph (1)(b) does not prevent a casual employee from taking a period of paid family and domestic violence leave that does not include hours for which the employee is rostered to work. However, the employer is not required to pay the employee in relation to such a period."@en ;
    cml:integrityHash "a35005facd73466a88047244649a246b3ff300a85c9143764cfc2727a19617b5" ;
    values:partOf concept:fair-work-act-2009-sec-106ba ;
    cof:pageNumber "257"^^xsd:integer ;
    skos:note "Employer not required to pay employee for unpaid hours during paid family and domestic violence leave." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.257" ;
    cml:asserts concept:fair-work-act-2009-sec-106ba-ss-3-norm .
