concept:fair-work-act-2009-sec-66k a cml:Concept ;
    skos:prefLabel "66K Effect of change"@en ;
    cml:realizedBy doc:sec-66k ;
    values:originalText "To avoid doubt, an employee is taken, on and after the day specified in a notice for the purposes of  Chapter 2  Terms and conditions of employment" ;
    skos:definition "To avoid doubt, an employee is taken, on and after the day specified in a notice for the purposes of  Chapter 2  Terms and conditions of employment"@en ;
