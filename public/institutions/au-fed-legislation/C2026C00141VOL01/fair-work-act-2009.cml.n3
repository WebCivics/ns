doc:sec-226a-ss-1 a cof:Section ;
    cof:title "226A(1) Guarantee of termination entitlements" ;
    values:kind "subsection" ;
    values:originalText "(1) A guarantee of termination entitlements is an undertaking given by an employer covered by an enterprise agreement that: (a) is an undertaking that the employer will comply with subsection (3) if the agreement is terminated under section 226 and the employer terminates the employment of a protected employee for the termination of the agreement: (i) at the employer’s initiative because the employer no longer requires the job done by the employee to be done  Terms and conditions of employment  Chapter 2 Enterprise agreements  Part 2-4 Variation and termination of enterprise agreements  Division 7 Section 226A Fair Work Act 2009 Compilation date: 02/04/2026 by anyone, except where this is due to the ordinary and customary turnover of labour; or (ii) because of the insolvency or bankruptcy of the employer; and (b) is in writing; and (c) meets any requirements relating to the signing of undertakings that are prescribed by the regulations." ;
    cof:pageNumber "458"^^xsd:integer .

concept:fair-work-act-2009-sec-226a-ss-2 a cml:Concept ;
    skos:prefLabel "226A(2) Guarantee of termination entitlements"@en ;
    cml:realizedBy doc:sec-226a-ss-2 ;
    values:originalText "(2) A protected employee for a termination of an enterprise agreement under section 226 is an employee who would, but for the termination of the agreement, be covered by the agreement." ;
    skos:definition "(2) A protected employee for a termination of an enterprise agreement under section 226 is an employee who would, but for the termination of the agreement, be covered by the agreement."@en ;
    cml:integrityHash "8d393ad4e7f598c4b5de83df0ce718336b977318feb488f5e2c61c49bb46b429" ;
    values:partOf concept:fair-work-act-2009-sec-226a ;
    cof:pageNumber "458"^^xsd:integer ;
    skos:note "Employee must be covered by the agreement before termination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.458" ;
