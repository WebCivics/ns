concept:fair-work-act-2009-sec-83 a cml:Concept ;
    skos:prefLabel "83 Consultation with employee on unpaid parental leave"@en ;
    cml:realizedBy doc:sec-83 ;
    values:originalText "If: (a) an employee is taking a period of unpaid parental leave, other than flexible unpaid parental leave; and (b) the employee’s employer makes a decision that will have a significant effect on the status, pay or location of the employee’s pre-parental leave position; the employer must take all reasonable steps to give the employee information about, and an opportunity to discuss, the effect of the decision on that position." ;
    skos:definition "If: (a) an employee is taking a period of unpaid parental leave, other than flexible unpaid parental leave; and (b) the employee’s employer makes a decision that will have a significant effect on the status, pay or location of the employee’s pre-parental leave position; the employer must take all reasonable steps to give the employee information about, and an opportunity to discuss, the effect of the decision on that position."@en ;
    cml:integrityHash "24830094c9824ae4a2a10688e51b574dfdebc66d37ff6d584233d11e39bebf71" ;
    cof:pageNumber "241"^^xsd:integer ;
    skos:note "Employer must inform employee about significant effects on pre-parental leave position." ;
    dc:description "Information and opportunity to discuss" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.241" ;
    cml:asserts concept:fair-work-act-2009-sec-83-norm .
