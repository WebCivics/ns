concept:fair-work-act-2009-sec-72a-ss-5 a cml:Concept ;
    skos:prefLabel "72A(5) Flexible unpaid parental leave"@en ;
    cml:realizedBy doc:sec-72a-ss-5 ;
    values:originalText "(5) However, the employee may take flexible unpaid parental leave after taking one or more periods of unpaid parental leave under another provision of this Division only if the total of those periods (disregarding any extension under section 76A) is no longer than 12 months, less the employee’s notional flexible period. Meaning of notional flexible period" ;
    skos:definition "(5) However, the employee may take flexible unpaid parental leave after taking one or more periods of unpaid parental leave under another provision of this Division only if the total of those periods (disregarding any extension under section 76A) is no longer than 12 months, less the employee’s notional flexible period. Meaning of notional flexible period"@en ;
    cml:integrityHash "0ee1434b4a2a288dc95b046cded270d6c201b98cd4ff79d3e5503d75f60e0581" ;
    values:partOf concept:fair-work-act-2009-sec-72a ;
    cof:pageNumber "216"^^xsd:integer ;
    skos:note "Employee must take flexible unpaid parental leave after exceeding a certain period of unpaid parental leave." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.216" ;
    cml:asserts concept:fair-work-act-2009-sec-72a-ss-5-norm .
