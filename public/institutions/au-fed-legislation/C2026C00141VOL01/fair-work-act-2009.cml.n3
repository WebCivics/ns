    values:partOf concept:fair-work-act-2009-sec-74 ;
    cof:pageNumber "220"^^xsd:integer ;
    skos:note "Employee must specify total number of flexible unpaid parental leave days in notice." ;
    dc:description "Notice must specify total number of flexible unpaid parental leave days." ;
    cml:curationStatus cml:Proposed ;
