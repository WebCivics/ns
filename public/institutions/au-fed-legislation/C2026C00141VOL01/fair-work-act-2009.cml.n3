doc:sec-81a-ss-1 a cof:Section ;
    cof:title "81A(1) Paid no safe job leave" ;
    values:kind "subsection" ;
    values:originalText "(1) If: (a) section 81 applies to a pregnant employee but there is no appropriate safe job available; and (b) the employee is entitled to unpaid parental leave; and (c) the employee has complied with the notice and evidence requirements of section 74 for taking unpaid parental leave; then the employee is entitled to paid no safe job leave for the risk period." ;
    cof:pageNumber "239"^^xsd:integer .

concept:fair-work-act-2009-sec-81a-ss-2 a cml:Concept ;
    skos:prefLabel "81A(2) Paid no safe job leave"@en ;
    cml:realizedBy doc:sec-81a-ss-2 ;
    values:originalText "(2) If the employee takes paid no safe job leave for the risk period, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the risk period.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(2) If the employee takes paid no safe job leave for the risk period, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the risk period.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "c4acc23d1c44708b6de37ae78deb57d1b76067a3955c72c3a6fcddbf95199282" ;
    values:partOf concept:fair-work-act-2009-sec-81a ;
    cof:pageNumber "239"^^xsd:integer ;
    skos:note "Employer must pay employee at base rate for ordinary hours worked during risk period." ;
    dc:description "Payment" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.239" ;
