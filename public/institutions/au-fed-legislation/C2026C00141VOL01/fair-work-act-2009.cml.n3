    cml:operator "isRelatedTo" ;
    cml:logicSummary "Relationship between employee's paid annual leave and other leave or absence periods." ;
    cml:premiseText "(2) If the period during which an employee takes paid annual leave includes a period of any other leave (other than unpaid parental leave) under this Part, or a period of absence from employment under Division 8..." ;
    cml:conclusionText "(paid annual leave is related to that other leave or absence period)." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-89-ss-2 a cof:Section ;
    cof:title "89(2) Employee not taken to be on paid annual leave at certain times" ;
    values:kind "subsection" ;
    values:originalText "(2) If the period during which an employee takes paid annual leave includes a period of any other leave (other than unpaid parental leave) under this Part, or a period of absence from employment under Division 8 (which deals with community service leave), the employee is taken not to be on paid annual leave for the period of that other leave or absence." ;
    cof:pageNumber "246"^^xsd:integer .

concept:fair-work-act-2009-sec-90 a cml:Concept ;
    skos:prefLabel "90 Payment for annual leave"@en ;
    cml:realizedBy doc:sec-90 ;
    values:originalText "(1) If, in accordance with this Division, an employee takes a period of paid annual leave, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the period. (2) If, when the employment of an employee ends, the employee has a period of untaken paid annual leave, the employer must pay the employee the amount that would have been payable to the employee had the employee taken that period of leave." ;
    skos:definition "(1) If, in accordance with this Division, an employee takes a period of paid annual leave, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the period. (2) If, when the employment of an employee ends, the employee has a period of untaken paid annual leave, the employer must pay the employee the amount that would have been payable to the employee had the employee taken that period of leave."@en ;
    cml:integrityHash "2389274f07136d75d690b8b16e0daba10609fcbe0bf4d09644c93eb24d927d22" ;
    cof:pageNumber "246"^^xsd:integer ;
