doc:sec-72a-ss-5 a cof:Section ;
    cof:title "72A(5) Flexible unpaid parental leave" ;
    values:kind "subsection" ;
    values:originalText "(5) However, the employee may take flexible unpaid parental leave after taking one or more periods of unpaid parental leave under another provision of this Division only if the total of those periods (disregarding any extension under section 76A) is no longer than 12 months, less the employee’s notional flexible period. Meaning of notional flexible period" ;
    cof:pageNumber "216"^^xsd:integer .

concept:fair-work-act-2009-sec-72a-ss-6 a cml:Concept ;
    skos:prefLabel "72A(6) Flexible unpaid parental leave"@en ;
    cml:realizedBy doc:sec-72a-ss-6 ;
    values:originalText "(6) An employee’s notional flexible period is the period during which the employee would be on flexible unpaid parental leave if the employee took leave for all the employee’s flexible days in a single continuous period. For this purpose, the employee’s flexible days are the flexible days notified to the employer under subsection 74(3C) (subject to any agreement under subsection 74(3D)).  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(6) An employee’s notional flexible period is the period during which the employee would be on flexible unpaid parental leave if the employee took leave for all the employee’s flexible days in a single continuous period. For this purpose, the employee’s flexible days are the flexible days notified to the employer under subsection 74(3C) (subject to any agreement under subsection 74(3D)).  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "5ec26acdfd3b3659cb5bcec9b45f2f7badd01e42c9da972dc26cc7a2ca0587d6" ;
    values:partOf concept:fair-work-act-2009-sec-72a ;
    cof:pageNumber "216"^^xsd:integer ;
    skos:note "Employee's notional flexible period is the period during which the employee would be on flexible unpaid parental leave if the employee took leave for all the employee's flexible days in a single continuous period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.216" ;
    cml:asserts concept:fair-work-act-2009-sec-72a-ss-6-norm .
