concept:fair-work-act-2009-sec-41 a cml:Concept ;
    skos:prefLabel "41 Guide to this Part"@en ;
    cml:realizedBy doc:sec-41 ;
    values:originalText "This Part has the core provisions for this Chapter, which deals with terms and conditions of employment of national system employees. The main terms and conditions come from the National Employment Standards, modern awards, enterprise agreements and workplace determinations. The National Employment Standards (Part 2-2) are minimum terms and conditions that apply to all national system employees. A modern award (see Part 2-3), an enterprise agreement (see" ;
    skos:definition "This Part has the core provisions for this Chapter, which deals with terms and conditions of employment of national system employees. The main terms and conditions come from the National Employment Standards, modern awards, enterprise agreements and workplace determinations. The National Employment Standards (Part 2-2) are minimum terms and conditions that apply to all national system employees. A modern award (see Part 2-3), an enterprise agreement (see"@en ;
    cml:integrityHash "4432f796f2c80df56cd8d5bbb7fc02b03b8687e872720e94854533931cbf8862" ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Guide to this Part" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
