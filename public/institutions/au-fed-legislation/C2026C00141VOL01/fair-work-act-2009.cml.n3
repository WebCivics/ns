concept:fair-work-act-2009-sec-146 a cml:Concept ;
    skos:prefLabel "146 Terms about settling disputes"@en ;
    cml:realizedBy doc:sec-146 ;
    values:originalText "Without limiting paragraph 139(1)(j), a modern award must include a term that provides a procedure for settling disputes: (a) about any matters arising under the award; and (b) in relation to the National Employment Standards." ;
    skos:definition "Without limiting paragraph 139(1)(j), a modern award must include a term that provides a procedure for settling disputes: (a) about any matters arising under the award; and (b) in relation to the National Employment Standards."@en ;
