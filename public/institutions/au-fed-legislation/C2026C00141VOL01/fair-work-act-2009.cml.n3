concept:fair-work-act-2009-sec-3 a cml:Concept ;
    skos:prefLabel "3 Sections 41 to"@en ;
    cml:realizedBy doc:sec-3 ;
    values:originalText "A day or days to be fixed by Proclamation. A Proclamation must not specify a day that occurs before the day on which the Fair Work (Transitional Provisions and Consequential Amendments) Act 2009 receives the Royal Assent. However, if any of the provision(s) do not commence within the period of 12 months beginning on the day on which the Fair Work (Transitional Provisions and Consequential Amendments) Act 2009 receives the Royal Assent, they commence on the first day after the end of that period. Sections 41–43, 50–54, 58, 169– 281A, 300–327, 332, 333, 334– 572: 1 July 2009 (see F2009L02563) Sections 44–49, 55–57A, 59– 168, 282–299, 328–331, 333A:" ;
    skos:definition "A day or days to be fixed by Proclamation. A Proclamation must not specify a day that occurs before the day on which the Fair Work (Transitional Provisions and Consequential Amendments) Act 2009 receives the Royal Assent. However, if any of the provision(s) do not commence within the period of 12 months beginning on the day on which the Fair Work (Transitional Provisions and Consequential Amendments) Act 2009 receives the Royal Assent, they commence on the first day after the end of that period. Sections 41–43, 50–54, 58, 169– 281A, 300–327, 332, 333, 334– 572: 1 July 2009 (see F2009L02563) Sections 44–49, 55–57A, 59– 168, 282–299, 328–331, 333A:"@en ;
    cml:integrityHash "4279aa23aed6a690dcdba886fa252e2c6c4619689131df2766bda098263fb9a5" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "A Proclamation must not specify a day that occurs before the day on which the Fair Work (Transitional Provisions and Consequential Amendments) Act 2009 receives the Royal Assent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
