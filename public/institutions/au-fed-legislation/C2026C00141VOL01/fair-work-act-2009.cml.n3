doc:sec-66m-ss-5 a cof:Section ;
    cof:title "66M(5) Disputes about the operation of this Division" ;
    values:kind "subsection" ;
    values:originalText "(5) If discussions at the workplace level do not resolve the dispute, a party to the dispute may refer the dispute to the FWC." ;
    cof:pageNumber "207"^^xsd:integer .

concept:fair-work-act-2009-sec-66m-ss-6 a cml:Concept ;
    skos:prefLabel "66M(6) Disputes about the operation of this Division"@en ;
    cml:realizedBy doc:sec-66m-ss-6 ;
    values:originalText "(6) If a dispute is referred under subsection (5): (a) the FWC must first deal with the dispute by means other than arbitration, unless there are exceptional circumstances; and (b) the FWC may deal with the dispute by arbitration in accordance with section 66MA.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(6) If a dispute is referred under subsection (5): (a) the FWC must first deal with the dispute by means other than arbitration, unless there are exceptional circumstances; and (b) the FWC may deal with the dispute by arbitration in accordance with section 66MA.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "5a3562b32b1feb9c08b50683b91f2a319f3f7f4c23c94a07c77e26d5d82efb0f" ;
    values:partOf concept:fair-work-act-2009-sec-66m ;
    cof:pageNumber "207"^^xsd:integer ;
    skos:note "FWC must deal with dispute by means other than arbitration unless exceptional circumstances." ;
    cml:curationStatus cml:Proposed ;
