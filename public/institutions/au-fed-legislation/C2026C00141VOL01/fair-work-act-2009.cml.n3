doc:sec-220-ss-1 a cof:Section ;
    cof:title "220(1) Employers may request employees to approve a proposed" ;
    values:kind "subsection" ;
    values:originalText "(1) An employer covered by an enterprise agreement may request the employees covered by the agreement to approve a proposed termination of the agreement by voting for it." ;
    cof:pageNumber "454"^^xsd:integer .

concept:fair-work-act-2009-sec-220-ss-2 a cml:Concept ;
    skos:prefLabel "220(2) Employers may request employees to approve a proposed"@en ;
    cml:realizedBy doc:sec-220-ss-2 ;
    values:originalText "(2) Before making the request, the employer must: (a) take all reasonable steps to notify the employees of the following: (i) the time and place at which the vote will occur; (ii) the voting method that will be used; and (b) give the employees a reasonable opportunity to decide whether they want to approve the proposed termination." ;
    skos:definition "(2) Before making the request, the employer must: (a) take all reasonable steps to notify the employees of the following: (i) the time and place at which the vote will occur; (ii) the voting method that will be used; and (b) give the employees a reasonable opportunity to decide whether they want to approve the proposed termination."@en ;
    cml:integrityHash "c50c9be4cf7652a20b74307d64172274604de03885ed437097ab16cd20295657" ;
    values:partOf concept:fair-work-act-2009-sec-220 ;
    cof:pageNumber "454"^^xsd:integer ;
    skos:note "Employers must notify employees before requesting approval for a proposed termination. Employees must approve termination of multi-enterprise agreement" ;
    dc:description "Reasonable steps to notify employees and a reasonable opportunity to decide." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
