concept:fair-work-act-2009-sec-234-ss-1 a cml:Concept ;
    skos:prefLabel "234(1) Applications for intractable bargaining declarations"@en ;
    cml:realizedBy doc:sec-234-ss-1 ;
    values:originalText "(1) The FWC may make an intractable bargaining declaration in relation to a proposed enterprise agreement if: (a) an application for the declaration has been made; and (b) the FWC is satisfied of the matters set out in subsection (2); and (c) it is after the end of the minimum bargaining period (see subsection (5)). Matters of which the FWC must be satisfied before making an intractable bargaining declaration" ;
    skos:definition "(1) The FWC may make an intractable bargaining declaration in relation to a proposed enterprise agreement if: (a) an application for the declaration has been made; and (b) the FWC is satisfied of the matters set out in subsection (2); and (c) it is after the end of the minimum bargaining period (see subsection (5)). Matters of which the FWC must be satisfied before making an intractable bargaining declaration"@en ;
    cml:integrityHash "104c077520c77fd88a2f55778ec46020c62499590800bcc7546730e9a587ba39" ;
    values:partOf concept:fair-work-act-2009-sec-234 ;
    cof:pageNumber "473"^^xsd:integer ;
    skos:note "Application for intractable bargaining declaration FWC must be satisfied of matters before making an intractable bargaining declaration." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.473" ;
