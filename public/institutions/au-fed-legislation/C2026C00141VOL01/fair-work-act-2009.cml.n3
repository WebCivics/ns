concept:fair-work-act-2009-sec-191b-ss-3 a cml:Concept ;
    skos:prefLabel "191B(3) Effect of amendment specified by FWC"@en ;
    cml:realizedBy doc:sec-191b-ss-3 ;
    values:originalText "(3) If the FWC refuses to approve an enterprise agreement under this section, the FWC may refer the agreement to any person or body the FWC considers appropriate.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(3) If the FWC refuses to approve an enterprise agreement under this section, the FWC may refer the agreement to any person or body the FWC considers appropriate.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "ab779066463b0aae9ce078a1dfb2a08d9f095db46206f7db8a18918451134818" ;
    values:partOf concept:fair-work-act-2009-sec-191b ;
    cof:pageNumber "391"^^xsd:integer ;
    skos:note "FWC may refer agreement to any person or body" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
