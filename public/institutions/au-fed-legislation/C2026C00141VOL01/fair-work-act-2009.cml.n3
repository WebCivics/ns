    cml:modality cml:LTL ;
    cml:operator "CONTAINS" ;
    cml:logicSummary "Temporal trace for approval" ;
    cml:premiseText "The variation is made when a majority of the affected employees who cast a valid vote approve the variation." ;
    cml:conclusionText "There is a temporal trace from the moment the majority of affected employees cast their votes until the variation is approved." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

