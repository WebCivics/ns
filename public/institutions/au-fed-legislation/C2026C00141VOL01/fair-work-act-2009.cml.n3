doc:sec-232 a cof:Section ;
    cof:title "232 Operation of a bargaining order" ;
    values:kind "section" ;
    values:originalText "A bargaining order in relation to a proposed enterprise agreement: (a) comes into operation on the day on which it is made; and (b) ceases to be in operation at the earliest of the following: (i) if the order is revoked—the time specified in the instrument of revocation; (ii) when the agreement is approved by the FWC; (iii) when a workplace determination that covers the employees that would have been covered by the agreement comes into operation; (iv) when the bargaining representatives for the agreement agree that bargaining has ceased. Note: See also section 255A (limitations relating to greenfields agreements)." ;
    cof:pageNumber "472"^^xsd:integer .

concept:fair-work-act-2009-sec-233 a cml:Concept ;
    skos:prefLabel "233 Contravening a bargaining order"@en ;
    cml:realizedBy doc:sec-233 ;
    values:originalText "A person to whom a bargaining order applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1).  Terms and conditions of employment  Chapter 2 Enterprise agreements  Part 2-4 FWC’s general role in facilitating bargaining  Division 8 Section 234 Fair Work Act 2009 Compilation date: 02/04/2026 Subdivision B—Intractable bargaining declarations" ;
    skos:definition "A person to whom a bargaining order applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1).  Terms and conditions of employment  Chapter 2 Enterprise agreements  Part 2-4 FWC’s general role in facilitating bargaining  Division 8 Section 234 Fair Work Act 2009 Compilation date: 02/04/2026 Subdivision B—Intractable bargaining declarations"@en ;
    cml:integrityHash "c846f75bc2ed990c7b1907af0a22f6a900b976e646f0ea1c456ce86f14ec3d60" ;
    cof:pageNumber "472"^^xsd:integer ;
    skos:note "Prohibition on contravening a bargaining order term." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.472" ;
