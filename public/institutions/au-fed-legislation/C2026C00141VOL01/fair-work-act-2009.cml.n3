concept:fair-work-act-2009-sec-127 a cml:Concept ;
    skos:prefLabel "127 Regulations about what modern awards and enterprise"@en ;
    cml:realizedBy doc:sec-127 ;
    values:originalText "agreements can do The regulations may: (a) permit modern awards or enterprise agreements or both to include terms that would or might otherwise be contrary to this Part or section 55 (which deals with the interaction between the National Employment Standards and a modern award or enterprise agreement); or (b) prohibit modern awards or enterprise agreements or both from including terms that would or might otherwise be permitted by a provision of this Part or section 55.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "agreements can do The regulations may: (a) permit modern awards or enterprise agreements or both to include terms that would or might otherwise be contrary to this Part or section 55 (which deals with the interaction between the National Employment Standards and a modern award or enterprise agreement); or (b) prohibit modern awards or enterprise agreements or both from including terms that would or might otherwise be permitted by a provision of this Part or section 55.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "599df62bfb4f8aac421ee7e6edd3d582a7ed911a0a8f5ea99a328d0b8a3164a2" ;
    cof:pageNumber "289"^^xsd:integer ;
    skos:note "Permits modern awards or enterprise agreements to include terms contrary to this Part." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
