    cml:logicSummary "Conditions must apply before scope order application" ;
    cml:premiseText "(2) Despite subsection (1), a bargaining representative may not apply to the FWC for a scope order in relation to a proposed single-enterprise agreement if:" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-238-ss-2 cml:asserts concept:fair-work-act-2009-sec-238-ss-2-logic-diffusion-4 .
concept:fair-work-act-2009-sec-238-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "if" ;
    cml:logicSummary "Scope order application conditional on certain conditions" ;
    cml:premiseText "(2) Despite subsection (1), a bargaining representative may not apply to the FWC for a scope order in relation to a proposed single-enterprise agreement if:" ;
    cml:executionSurface "modalities::diffusion" ;
