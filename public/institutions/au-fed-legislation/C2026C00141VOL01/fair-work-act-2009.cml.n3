doc:sec-227c-ss-1 a cof:Section ;
    cof:title "227C(1) Effect of undertakings" ;
    values:kind "subsection" ;
    values:originalText "(1) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers a single employer; the undertaking is taken to be a term of the agreement, as the agreement applies to the employer." ;
    cof:pageNumber "465"^^xsd:integer .

concept:fair-work-act-2009-sec-227c-ss-2 a cml:Concept ;
    skos:prefLabel "227C(2) Effect of undertakings"@en ;
    cml:realizedBy doc:sec-227c-ss-2 ;
    values:originalText "(2) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers 2 or more employers; the undertaking is taken to be a term of the agreement, as the agreement applies to each employer that gave the undertaking." ;
    skos:definition "(2) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers 2 or more employers; the undertaking is taken to be a term of the agreement, as the agreement applies to each employer that gave the undertaking."@en ;
