concept:fair-work-act-2009-sec-106 a cml:Concept ;
    skos:prefLabel "106 Payment for compassionate leave (other than for casual"@en ;
    cml:realizedBy doc:sec-106 ;
    values:originalText "employees) If, in accordance with this Subdivision, an employee, other than a casual employee, takes a period of compassionate leave, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the period. Note: For casual employees, compassionate leave is unpaid leave. Subdivision CA—Paid family and domestic violence leave" ;
    skos:definition "employees) If, in accordance with this Subdivision, an employee, other than a casual employee, takes a period of compassionate leave, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the period. Note: For casual employees, compassionate leave is unpaid leave. Subdivision CA—Paid family and domestic violence leave"@en ;
    cml:integrityHash "58cbea477b9e315f4f14f7e3c272a81f427a76a64a33d2173a50d459e41201d4" ;
    cof:pageNumber "255"^^xsd:integer ;
    skos:note "Employer must pay employee at base rate for compassionate leave" ;
    dc:description "Payment" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
