doc:sec-226a-ss-3 a cof:Section ;
    cof:title "226A(3) Guarantee of termination entitlements" ;
    values:kind "subsection" ;
    values:originalText "(3) For the purposes of paragraph (1)(a), the employer complies with this subsection, in relation to the termination of the protected employee’s employment, if the employer complies with the terms of the enterprise agreement that, if the agreement were still in operation, would have provided the employee with entitlements that: (a) relate to a termination of the employee’s employment: (i) at the employer’s initiative because the employer no longer requires the job done by the employee to be done by anyone, except where this is due to the ordinary and customary turnover of labour; or (ii) because of the insolvency or bankruptcy of the employer; and (b) except if the employee was an award/agreement free employee immediately before the termination of the employee’s employment—are more beneficial than the entitlements under a modern award that covered the employee in relation to the employment at that time. When guarantee is in force" ;
    cof:pageNumber "458"^^xsd:integer .

concept:fair-work-act-2009-sec-226a-ss-4 a cml:Concept ;
    skos:prefLabel "226A(4) Guarantee of termination entitlements"@en ;
    cml:realizedBy doc:sec-226a-ss-4 ;
    values:originalText "(4) A guarantee of termination entitlements given in relation to the termination of an enterprise agreement: (a) comes into force on the day on which the termination of the agreement comes into operation under section 227; and  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(4) A guarantee of termination entitlements given in relation to the termination of an enterprise agreement: (a) comes into force on the day on which the termination of the agreement comes into operation under section 227; and  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "36c11d10f4da7522abb7a34672737a937949bea76839cad8f37a28024a9153cc" ;
    values:partOf concept:fair-work-act-2009-sec-226a ;
    cof:pageNumber "458"^^xsd:integer ;
    skos:note "Guarantee of termination entitlements comes into force on the day of agreement termination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.458" ;
    cml:asserts concept:fair-work-act-2009-sec-226a-ss-4-norm .
