concept:fair-work-act-2009-sec-106e a cml:Concept ;
    skos:prefLabel "106E Entitlement to days of leave"@en ;
    cml:realizedBy doc:sec-106e ;
    values:originalText "What constitutes a day of leave for the purposes of this Subdivision is taken to be the same as what constitutes a day of leave for the purposes of sections 72A and 85 and Subdivisions B and C.  Terms and conditions of employment  Chapter 2 The National Employment Standards  Part 2-2 Personal/carer’s leave, compassionate leave and paid family and domestic violence leave  Division 7 Section 107 Fair Work Act 2009 Compilation date: 02/04/2026 Subdivision D—Notice and evidence requirements" ;
    skos:definition "What constitutes a day of leave for the purposes of this Subdivision is taken to be the same as what constitutes a day of leave for the purposes of sections 72A and 85 and Subdivisions B and C.  Terms and conditions of employment  Chapter 2 The National Employment Standards  Part 2-2 Personal/carer’s leave, compassionate leave and paid family and domestic violence leave  Division 7 Section 107 Fair Work Act 2009 Compilation date: 02/04/2026 Subdivision D—Notice and evidence requirements"@en ;
    cml:integrityHash "c37a7a82566a7026bf29de4681b6c4fb936e3aa6f6856184c97785dd03da6a69" ;
    cof:pageNumber "258"^^xsd:integer ;
    skos:note "Defines what constitutes a day of leave for purposes of the Act." ;
