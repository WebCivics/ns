doc:sec-220-ss-1 a cof:Section ;
    cof:title "220(1) Employers may request employees to approve a proposed" ;
    values:kind "subsection" ;
    values:originalText "(1) If the employees of an employer, or each employer, covered by a single-enterprise agreement have been asked to approve a proposed termination of the agreement under subsection 220(1), the termination is agreed to when a majority of the employees who cast a valid vote approve the termination.  Terms and conditions of employment  Chapter 2 Enterprise agreements  Part 2-4 Variation and termination of enterprise agreements  Division 7 Section 222 Fair Work Act 2009 Compilation date: 02/04/2026 Multi-enterprise agreement" ;
    cof:pageNumber "454"^^xsd:integer .

concept:fair-work-act-2009-sec-220-ss-2 a cml:Concept ;
    skos:prefLabel "220(2) Employers may request employees to approve a proposed"@en ;
    cml:realizedBy doc:sec-220-ss-2 ;
    values:originalText "(2) If the employees of each employer covered by a multi-enterprise agreement have been asked to approve a proposed termination of the agreement under subsection 220(1), the termination is agreed to when a majority of the employees of each individual employer who cast a valid vote have approved the termination." ;
    skos:definition "(2) If the employees of each employer covered by a multi-enterprise agreement have been asked to approve a proposed termination of the agreement under subsection 220(1), the termination is agreed to when a majority of the employees of each individual employer who cast a valid vote have approved the termination."@en ;
    cml:integrityHash "c9a562db7968ed92bc7ea835a4d0f2d1edf1f9071e66d9bbd3f0e10bc7c61089" ;
    values:partOf concept:fair-work-act-2009-sec-220 ;
    cof:pageNumber "454"^^xsd:integer ;
    skos:note "Employers must notify employees before requesting approval for a proposed termination. Employees must approve termination of multi-enterprise agreement" ;
    dc:description "Reasonable steps to notify employees and a reasonable opportunity to decide." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
