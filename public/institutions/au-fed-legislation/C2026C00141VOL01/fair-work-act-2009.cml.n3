concept:fair-work-act-2009-sec-24 a cml:Concept ;
    skos:prefLabel "24 Guide to this Part"@en ;
    cml:realizedBy doc:sec-24 ;
    values:originalText "This Part deals with the extent of the application of this Act. Division 2 is about how this Act affects the operation of certain State or Territory laws. Divisions 2A and 2B are about the extended application of this Act in States that have referred to the Parliament of the Commonwealth matters relating to this Act. Division 3 is about the geographical application of this Act. Division 4 deals with other matters relating to the application of this Act." ;
    skos:definition "This Part deals with the extent of the application of this Act. Division 2 is about how this Act affects the operation of certain State or Territory laws. Divisions 2A and 2B are about the extended application of this Act in States that have referred to the Parliament of the Commonwealth matters relating to this Act. Division 3 is about the geographical application of this Act. Division 4 deals with other matters relating to the application of this Act."@en ;
    cml:integrityHash "de6cd21ea19732d0bfcb0782d5b5ef4a25bed1bfb1a90a80d2a97c9fea4a2d55" ;
    cof:pageNumber "126"^^xsd:integer ;
    skos:note "Guide to this Part" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.126" ;
    cml:asserts concept:fair-work-act-2009-sec-24-norm .
