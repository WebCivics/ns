    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Employer's ability to offer or not offer work may indicate presence of firm advance commitment" ;
    cml:premiseText "(i) whether there is an inability of the employer to elect to offer, or not offer, work or an inability of the employee to elect to accept or reject work (and whether this occurs in practice);" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-ltl-4 .
