concept:fair-work-act-2009-sec-114-ss-3 a cml:Concept ;
    skos:prefLabel "114(3) Entitlement to be absent from employment on public holiday"@en ;
    cml:realizedBy doc:sec-114-ss-3 ;
    values:originalText "(3) If an employer requests an employee to work on a public holiday, the employee may refuse the request if: (a) the request is not reasonable; or (b) the refusal is reasonable." ;
    skos:definition "(3) If an employer requests an employee to work on a public holiday, the employee may refuse the request if: (a) the request is not reasonable; or (b) the refusal is reasonable."@en ;
    cml:integrityHash "ce80be9086c5bda9cc4fe186c7fb340f11e0889e88dd01b5c60a6fe826f7ade7" ;
