concept:fair-work-act-2009-sec-72a-ss-5 cml:asserts concept:fair-work-act-2009-sec-72a-ss-5-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-72a-ss-5-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Time period for flexible unpaid parental leave" ;
    cml:premiseText "The total of those periods (disregarding any extension under section 76A) is no longer than 12 months, less the employee’s notional flexible period." ;
    cml:conclusionText "The time period for flexible unpaid parental leave is between 12 months and the employee’s notional flexible period." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

