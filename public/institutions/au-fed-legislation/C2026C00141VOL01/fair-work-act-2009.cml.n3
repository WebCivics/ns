    values:partOf concept:fair-work-act-2009-sec-51 ;
    cof:pageNumber "177"^^xsd:integer ;
    skos:note "Enterprise agreement applies to employee, employer or organisation if it is in operation and covers them. An enterprise agreement does not impose obligations on a person unless the agreement applies to the person." ;
