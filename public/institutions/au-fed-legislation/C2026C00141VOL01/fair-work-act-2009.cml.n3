doc:sec-168b-ss-3 a cof:Section ;
    cof:title "168B(3) The modern enterprise awards objective" ;
    values:kind "subsection" ;
    values:originalText "(3) A reference to the modern awards objective in this Act, other than section 134, is taken to include a reference to the modern enterprise awards objective." ;
    cof:pageNumber "343"^^xsd:integer .

concept:fair-work-act-2009-sec-168c a cml:Concept ;
    skos:prefLabel "168C Rules about making and revoking modern enterprise awards"@en ;
    cml:realizedBy doc:sec-168c ;
    values:originalText "Making modern enterprise awards (1) The FWC must not, under this Part: (a) make a modern enterprise award; or (b) make a determination varying a modern award so that it becomes a modern enterprise award.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "Making modern enterprise awards (1) The FWC must not, under this Part: (a) make a modern enterprise award; or (b) make a determination varying a modern award so that it becomes a modern enterprise award.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "0546be03dbef63b1390cf0971279eb7768a8be3811e69721ae392aef962fd794" ;
