    cml:operator "CONTAINS" ;
    cml:logicSummary "Temporal interval for approval" ;
    cml:premiseText "The variation is made when a majority of the affected employees who cast a valid vote approve the variation." ;
    cml:conclusionText "The temporal interval for approval starts when the majority of affected employees cast their votes." ;
    cml:executionSurface "modalities::interval_reasoning" ;
