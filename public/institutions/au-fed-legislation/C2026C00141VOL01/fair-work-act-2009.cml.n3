doc:sec-143b-ss-4 a cof:Section ;
    cof:title "143B(4) Coverage terms of State reference public sector modern" ;
    values:kind "subsection" ;
    values:originalText "(4) A State reference public sector modern award must not be expressed to cover outworker entities. How coverage etc. is expressed" ;
    cof:pageNumber "306"^^xsd:integer .

concept:fair-work-act-2009-sec-143b-ss-5 a cml:Concept ;
    skos:prefLabel "143B(5) Coverage terms of State reference public sector modern"@en ;
    cml:realizedBy doc:sec-143b-ss-5 ;
    values:originalText "(5) For the purposes of this section: (a) an employer or employers may be specified by name or by inclusion in a specified class or specified classes; and (b) employees must be specified by inclusion in a specified class or specified classes; and (c) organisations must be specified by name." ;
