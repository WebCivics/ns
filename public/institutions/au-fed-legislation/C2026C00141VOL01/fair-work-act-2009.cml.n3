doc:sec-185-ss-3 a cof:Section ;
    cof:title "185(3) Bargaining representative must apply for the FWC’s approval" ;
    values:kind "subsection" ;
    values:originalText "(3) If the agreement is not a greenfields agreement, the application must be made: (a) within 14 days after the agreement is made; or (b) if in all the circumstances the FWC considers it fair to extend that period—within such further period as the FWC allows." ;
    cof:pageNumber "379"^^xsd:integer .

