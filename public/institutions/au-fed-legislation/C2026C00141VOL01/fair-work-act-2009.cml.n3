doc:sec-75-ss-1 a cof:Section ;
    cof:title "75(1) Extending period of unpaid parental leave—extending to use" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if: (a) an employee has, in accordance with section 74, given notice of the taking of a period of unpaid parental leave (the original leave period) under section 71; and (b) the original leave period is less than the employee’s available parental leave period; and (c) the original leave period has started." ;
    cof:pageNumber "223"^^xsd:integer .

concept:fair-work-act-2009-sec-75-ss-2 a cml:Concept ;
    skos:prefLabel "75(2) Extending period of unpaid parental leave—extending to use"@en ;
    cml:realizedBy doc:sec-75-ss-2 ;
    values:originalText "(2) The employee’s available parental leave period is 12 months, less any periods of the following kinds: (b) a period of unpaid parental leave that the employee has been required to take under subsection 73(2) or 82(2); (d) if the employee has given notice in accordance with subsection 74(2) or (2A) of the taking of flexible unpaid  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(2) The employee’s available parental leave period is 12 months, less any periods of the following kinds: (b) a period of unpaid parental leave that the employee has been required to take under subsection 73(2) or 82(2); (d) if the employee has given notice in accordance with subsection 74(2) or (2A) of the taking of flexible unpaid  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "6785cecb342fa3a35b145a89d4259e456b8af9fbda460187966eb531f2bfa95c" ;
    values:partOf concept:fair-work-act-2009-sec-75 ;
    cof:pageNumber "223"^^xsd:integer ;
    skos:note "Employee's available parental leave period is 12 months, less certain periods." ;
