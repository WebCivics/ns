doc:sec-116d-ss-2 a cof:Section ;
    cof:title "116D(2) Preventing multiple actions" ;
    values:kind "subsection" ;
    values:originalText "(2) An application for such an order may not be made if: (a) the Commissioner of Taxation has commenced proceedings against the employer to recover an amount of superannuation guarantee charge; and (b) either: (i) the Commissioner has obtained an order for recovery of the charge; or (ii) if the proceedings have not been finally disposed of— the Commissioner has not discontinued the proceedings; and (c) the employer’s superannuation guarantee shortfall in respect of which the charge is imposed includes an individual superannuation guarantee shortfall for the employee." ;
    cof:pageNumber "275"^^xsd:integer .

concept:fair-work-act-2009-sec-116d-ss-3 a cml:Concept ;
    skos:prefLabel "116D(3) Preventing multiple actions"@en ;
    cml:realizedBy doc:sec-116d-ss-3 ;
    values:originalText "(3) Terms (apart from employee and employer) used in this section that are defined in the Superannuation Guarantee (Administration) Act 1992 have the same meaning in this section as they have in that Act.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(3) Terms (apart from employee and employer) used in this section that are defined in the Superannuation Guarantee (Administration) Act 1992 have the same meaning in this section as they have in that Act.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "798f0d45c82fb780bca634785dc7646c36284fc5b81ef5c2caf726d7c9e1f129" ;
    values:partOf concept:fair-work-act-2009-sec-116d ;
    cof:pageNumber "275"^^xsd:integer ;
    skos:note "Terms defined in another Act have the same meaning here." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
