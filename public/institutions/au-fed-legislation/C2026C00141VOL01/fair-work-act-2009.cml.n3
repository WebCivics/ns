concept:fair-work-act-2009-sec-229-ss-1 a cml:Concept ;
    skos:prefLabel "229(1) Applications for bargaining orders"@en ;
    cml:realizedBy doc:sec-229-ss-1 ;
    values:originalText "(1) The FWC may make a bargaining order under this section in relation to a proposed enterprise agreement if: (a) an application for the order has been made; and (b) the requirements of this section are met in relation to the agreement; and (c) the FWC is satisfied that it is reasonable in all the circumstances to make the order. Note: See also section 255A (limitations relating to greenfields agreements).  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(1) The FWC may make a bargaining order under this section in relation to a proposed enterprise agreement if: (a) an application for the order has been made; and (b) the requirements of this section are met in relation to the agreement; and (c) the FWC is satisfied that it is reasonable in all the circumstances to make the order. Note: See also section 255A (limitations relating to greenfields agreements).  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "504c0f9fac6cd49b0439eef5d86f804aca4aec34ff5b196d8f915eaf380a24fd" ;
    values:partOf concept:fair-work-act-2009-sec-229 ;
    cof:pageNumber "468"^^xsd:integer ;
    skos:note "Application for bargaining order must meet requirements and be reasonable in all circumstances. Application for bargaining order under section 230" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.468" ;
