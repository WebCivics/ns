concept:fair-work-act-2009-sec-116b a cml:Concept ;
    skos:prefLabel "116B Employer’s obligation to make superannuation contributions"@en ;
    cml:realizedBy doc:sec-116b ;
    values:originalText "An employer must make contributions to a superannuation fund for the benefit of an employee so as to avoid liability to pay superannuation guarantee charge under the Superannuation Guarantee Charge Act 1992 in relation to the employee." ;
    skos:definition "An employer must make contributions to a superannuation fund for the benefit of an employee so as to avoid liability to pay superannuation guarantee charge under the Superannuation Guarantee Charge Act 1992 in relation to the employee."@en ;
    cml:integrityHash "05d82b3ac59bfe8f5b732cf7962ba56fb2357e00b01133a1f8030ed000c8cd50" ;
    cof:pageNumber "274"^^xsd:integer ;
    skos:note "Employer must make superannuation contributions for employee's benefit." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.274" ;
    cml:asserts concept:fair-work-act-2009-sec-116b-norm .
