concept:fair-work-act-2009-sec-216a-ss-2 a cml:Concept ;
    skos:prefLabel "216A(2) Variation of supported bargaining agreement to add employer"@en ;
    cml:realizedBy doc:sec-216a-ss-2 ;
    values:originalText "(2) Without limiting paragraph (1)(b), the following are examples of the kinds of employees whose circumstances and needs are to be taken into account for the purposes of complying with that paragraph: (a) employees from culturally and linguistically diverse backgrounds; (b) young employees; (c) employees who did not have a representative for the variation." ;
    skos:definition "(2) Without limiting paragraph (1)(b), the following are examples of the kinds of employees whose circumstances and needs are to be taken into account for the purposes of complying with that paragraph: (a) employees from culturally and linguistically diverse backgrounds; (b) young employees; (c) employees who did not have a representative for the variation."@en ;
    cml:integrityHash "cf82c117a2ca4fd2f1c1fb4daf3104c7abeadbbc0669aa0828507aac7d2ffd93" ;
    values:partOf concept:fair-work-act-2009-sec-216a ;
    cof:pageNumber "426"^^xsd:integer ;
    skos:note "Consider employees from diverse backgrounds, young employees, and those without a representative when complying with the paragraph. Employer may request approval from affected employees for proposed variation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.426" ;
    cml:asserts concept:fair-work-act-2009-sec-216a-ss-2-norm .
