doc:sec-30b-ss-1 a cof:Section ;
    cof:title "30B(1) Meaning of referring State" ;
    values:kind "subsection" ;
    values:originalText "(1) A State is a referring State if the Parliament of the State has, before 1 July 2009, referred the matters covered by subsections (3)," ;
    cof:pageNumber "137"^^xsd:integer .

concept:fair-work-act-2009-sec-30b-ss-4 a cml:Concept ;
    skos:prefLabel "30B(4) Meaning of referring State"@en ;
    cml:realizedBy doc:sec-30b-ss-4 ;
    values:originalText "(4) and (5) in relation to the State to the Parliament of the Commonwealth for the purposes of paragraph 51(xxxvii) of the Constitution: (a) if and to the extent that the matters are not otherwise included in the legislative powers of the Parliament of the Commonwealth (otherwise than by a reference under paragraph 51(xxxvii) of the Constitution); and (b) if and to the extent that the matters are included in the legislative powers of the Parliament of the State. This subsection has effect subject to subsection (6)." ;
    skos:definition "(4) and (5) in relation to the State to the Parliament of the Commonwealth for the purposes of paragraph 51(xxxvii) of the Constitution: (a) if and to the extent that the matters are not otherwise included in the legislative powers of the Parliament of the Commonwealth (otherwise than by a reference under paragraph 51(xxxvii) of the Constitution); and (b) if and to the extent that the matters are included in the legislative powers of the Parliament of the State. This subsection has effect subject to subsection (6)."@en ;
    cml:integrityHash "a97d42dae774d9ecb45060651e848b8a94b81949a516a932ed03f263035e4b26" ;
    values:partOf concept:fair-work-act-2009-sec-30b ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "States legislative powers in relation to the Parliament of the Commonwealth" ;
    cml:curationStatus cml:Proposed ;
