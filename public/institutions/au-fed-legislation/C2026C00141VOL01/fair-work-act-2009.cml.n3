concept:fair-work-act-2009-sec-88 a cml:Concept ;
    skos:prefLabel "88 Taking paid annual leave"@en ;
    cml:realizedBy doc:sec-88 ;
    values:originalText "(1) Paid annual leave may be taken for a period agreed between an employee and his or her employer. (2) The employer must not unreasonably refuse to agree to a request by the employee to take paid annual leave.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(1) Paid annual leave may be taken for a period agreed between an employee and his or her employer. (2) The employer must not unreasonably refuse to agree to a request by the employee to take paid annual leave.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "17ebc83d8f076c766f106df14e899fdefb9c900255e42d617eed92eda3b27cde" ;
    cof:pageNumber "245"^^xsd:integer ;
    cml:hasPart concept:fair-work-act-2009-sec-88-ss-1 ;
    cml:hasPart concept:fair-work-act-2009-sec-88-ss-2 ;
    cml:curationStatus cml:Proposed ;
