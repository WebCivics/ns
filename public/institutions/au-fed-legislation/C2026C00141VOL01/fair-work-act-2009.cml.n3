concept:fair-work-act-2009-sec-46-ss-1 cml:asserts concept:fair-work-act-2009-sec-46-ss-1-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-46-ss-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The applicability of a modern award to a person overlaps with the obligation imposed by the award." ;
    cml:premiseText "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award." ;
    cml:conclusionText "Applicability of A ⊆ Obligation" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-46-ss-1 cml:asserts concept:fair-work-act-2009-sec-46-ss-1-logic-ltl-4 .
concept:fair-work-act-2009-sec-46-ss-1-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "The obligation imposed by a modern award is until the applicability of the award to the person." ;
    cml:premiseText "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award." ;
    cml:conclusionText "Obligation ⊆ Until(A)" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-46-ss-1 cml:asserts concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-5 .
concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If the applicability of a modern award to a person overlaps with the obligation imposed by the award, then the award imposes obligations on the person." ;
    cml:premiseText "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award." ;
    cml:conclusionText "(not A or B)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
