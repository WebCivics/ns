concept:fair-work-act-2009-sec-216e-ss-7 a cml:Concept ;
    skos:prefLabel "216E(7) Variation of multi-enterprise agreement to remove employer"@en ;
    cml:realizedBy doc:sec-216e-ss-7 ;
    values:originalText "(7) The variation is made when a majority of the affected employees who cast a valid vote approve the variation." ;
