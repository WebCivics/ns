doc:sec-161-ss-1 a cof:Section ;
    cof:title "161(1) Variation of modern award on referral by Australian Human" ;
    values:kind "subsection" ;
    values:originalText "(1) The FWC must review a modern award if the award is referred to it under section 46PW of the Australian Human Rights Commission Act 1986 (which deals with discriminatory industrial instruments)." ;
    cof:pageNumber "336"^^xsd:integer .

concept:fair-work-act-2009-sec-161-ss-2 a cml:Concept ;
    skos:prefLabel "161(2) Variation of modern award on referral by Australian Human"@en ;
    cml:realizedBy doc:sec-161-ss-2 ;
    values:originalText "(2) The following are entitled to make submissions to the FWC for consideration in the review: (a) if the referral relates to action that would be unlawful under Part 4 of the Age Discrimination Act 2004—the Age Discrimination Commissioner; (b) if the referral relates to action that would be unlawful under Part 2 of the Disability Discrimination Act 1992—the Disability Discrimination Commissioner; (c) if the referral relates to action that would be unlawful under Part II of the Sex Discrimination Act 1984—the Sex Discrimination Commissioner." ;
    skos:definition "(2) The following are entitled to make submissions to the FWC for consideration in the review: (a) if the referral relates to action that would be unlawful under Part 4 of the Age Discrimination Act 2004—the Age Discrimination Commissioner; (b) if the referral relates to action that would be unlawful under Part 2 of the Disability Discrimination Act 1992—the Disability Discrimination Commissioner; (c) if the referral relates to action that would be unlawful under Part II of the Sex Discrimination Act 1984—the Sex Discrimination Commissioner."@en ;
    cml:integrityHash "5923a2c8514f68af9e7c741bcd60a4afec8cc231bd349a707ebd8508f334e78d" ;
