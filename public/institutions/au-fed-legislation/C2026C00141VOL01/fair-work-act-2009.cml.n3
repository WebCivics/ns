concept:fair-work-act-2009-sec-39 a cml:Concept ;
    skos:prefLabel "39 Acquisition of property"@en ;
    cml:realizedBy doc:sec-39 ;
    values:originalText "This Act, or any instrument made under this Act, does not apply to the extent that the operation of this Act or the instrument would result in an acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) from a person otherwise than on just terms (within the meaning of that paragraph).  Introduction  Chapter 1 Application of this Act  Part 1-3 Miscellaneous  Division 4 Section 40 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "This Act, or any instrument made under this Act, does not apply to the extent that the operation of this Act or the instrument would result in an acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) from a person otherwise than on just terms (within the meaning of that paragraph).  Introduction  Chapter 1 Application of this Act  Part 1-3 Miscellaneous  Division 4 Section 40 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "e7b1ba00958ba863599e0194da54dfb1bdcb5b8e14b81ee0f6c40b1a27f05e49" ;
    cof:pageNumber "162"^^xsd:integer ;
    skos:note "Acquisition of property from a person not on just terms is excluded." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.162" ;
