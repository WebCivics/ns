    cof:pageNumber "94"^^xsd:integer .

concept:fair-work-act-2009-sec-15b a cml:Concept ;
    skos:prefLabel "15B Meaning of collective agreement"@en ;
    cml:realizedBy doc:sec-15b ;
    values:originalText "A collective agreement means the following: (a) an employee-like worker collective agreement (see subsection 536MK(4)); (b) a road transport collective agreement (see subsection 536MK(5))." ;
    skos:definition "A collective agreement means the following: (a) an employee-like worker collective agreement (see subsection 536MK(4)); (b) a road transport collective agreement (see subsection 536MK(5))."@en ;
