    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Employer's obligation to comply with subsection (3) if agreement is terminated." ;
    cml:premiseText "(a) is an undertaking that the employer will comply with subsection (3)" ;
    cml:conclusionText "if the agreement is terminated under section 226 and the employer terminates the employment of a protected employee" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

