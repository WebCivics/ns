doc:sec-188-ss-2a a cof:Section ;
    cof:title "188(2A) Determining whether an enterprise agreement has been" ;
    values:kind "subsection" ;
    values:originalText "(2A) The FWC cannot be satisfied that an enterprise agreement to which section 180A or 180B applies has been genuinely agreed to by the employees covered by the agreement unless the FWC is satisfied that the employer complied with section 180A or 180B (as the case requires) in relation to the agreement. Where notice of employee representational rights was required" ;
    cof:pageNumber "384"^^xsd:integer .

concept:fair-work-act-2009-sec-188-ss-3 a cml:Concept ;
    skos:prefLabel "188(3) Determining whether an enterprise agreement has been"@en ;
    cml:realizedBy doc:sec-188-ss-3 ;
    values:originalText "(3) Subsection (4) applies in relation to an enterprise agreement if an employer was required by subsection 173(1) (which deals with giving notice of employee representational rights) to take all reasonable steps to give notice in relation to the agreement." ;
    skos:definition "(3) Subsection (4) applies in relation to an enterprise agreement if an employer was required by subsection 173(1) (which deals with giving notice of employee representational rights) to take all reasonable steps to give notice in relation to the agreement."@en ;
    cml:integrityHash "a161ed2380afe96ccf8e02cc9204ae364fe5a13158a5bf4d3f115187e90b9280" ;
    values:partOf concept:fair-work-act-2009-sec-188 ;
    cof:pageNumber "384"^^xsd:integer ;
    skos:note "Employer must take reasonable steps to give notice in relation to an enterprise agreement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.384" ;
