concept:fair-work-act-2009-sec-149 a cml:Concept ;
    skos:prefLabel "149 Automatic variation of allowances"@en ;
    cml:realizedBy doc:sec-149 ;
    values:originalText "If a modern award includes allowances that the FWC considers are of a kind that should be varied when wage rates in the award are  Terms and conditions of employment  Chapter 2 Modern awards  Part 2-3 Terms of modern awards  Division 3 Section 149B Fair Work Act 2009 Compilation date: 02/04/2026 varied, the award must include terms providing for the automatic variation of those allowances when wage rates in the award are varied." ;
    skos:definition "If a modern award includes allowances that the FWC considers are of a kind that should be varied when wage rates in the award are  Terms and conditions of employment  Chapter 2 Modern awards  Part 2-3 Terms of modern awards  Division 3 Section 149B Fair Work Act 2009 Compilation date: 02/04/2026 varied, the award must include terms providing for the automatic variation of those allowances when wage rates in the award are varied."@en ;
    cml:integrityHash "34c0a57158d8e2af7a025c81bd05b28e6cce8cd4082c7b9df8cd140bdc4554e2" ;
    cof:pageNumber "310"^^xsd:integer ;
    skos:note "Automatic variation of allowances when wage rates in the award are varied." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
