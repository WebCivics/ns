    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The temporal interval of the provision's application overlaps with the temporal interval of the person or entity's connection to Australia." ;
    cml:premiseText "There is not a sufficient connection between the person or entity and Australia." ;
    cml:conclusionText "The provision should not apply to the person or entity in Australia." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
