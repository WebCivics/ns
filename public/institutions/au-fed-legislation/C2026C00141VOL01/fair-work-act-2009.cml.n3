concept:fair-work-act-2009-sec-99 a cml:Concept ;
    skos:prefLabel "99 Payment for paid personal/carer’s leave"@en ;
    cml:realizedBy doc:sec-99 ;
    values:originalText "If, in accordance with this Subdivision, an employee takes a period of paid personal/carer’s leave, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the period.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "If, in accordance with this Subdivision, an employee takes a period of paid personal/carer’s leave, the employer must pay the employee at the employee’s base rate of pay for the employee’s ordinary hours of work in the period.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "d7840fcbb599f49cdf83a1acd247ff92de69fdf02060d6cda0c84813f151696b" ;
    cof:pageNumber "251"^^xsd:integer ;
    skos:note "Employer must pay employee at base rate for paid personal/carer’s leave" ;
    dc:description "Payment" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.251" ;
