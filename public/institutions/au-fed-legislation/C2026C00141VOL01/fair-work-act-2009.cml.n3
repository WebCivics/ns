    cml:premiseText "The variation is made when a majority of the affected employees who cast a valid vote approve the variation." ;
    cml:conclusionText "The diffusion of approval starts from the moment the majority of affected employees cast their votes." ;
    cml:executionSurface "modalities::diffusion" ;
