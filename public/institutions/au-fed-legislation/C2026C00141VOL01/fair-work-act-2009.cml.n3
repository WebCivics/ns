doc:sec-234-ss-1 a cof:Section ;
    cof:title "234(1) Applications for intractable bargaining declarations" ;
    values:kind "subsection" ;
    values:originalText "(1) The FWC may make an intractable bargaining declaration in relation to a proposed enterprise agreement if: (a) an application for the declaration has been made; and (b) the FWC is satisfied of the matters set out in subsection (2); and (c) it is after the end of the minimum bargaining period (see subsection (5)). Matters of which the FWC must be satisfied before making an intractable bargaining declaration" ;
    cof:pageNumber "473"^^xsd:integer .

concept:fair-work-act-2009-sec-234-ss-2 a cml:Concept ;
    skos:prefLabel "234(2) Applications for intractable bargaining declarations"@en ;
    cml:realizedBy doc:sec-234-ss-2 ;
    values:originalText "(2) The FWC must be satisfied that: (a) the FWC has dealt with the dispute about the agreement under section 240 and the applicant participated in the FWC’s processes to deal with the dispute; and  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(2) The FWC must be satisfied that: (a) the FWC has dealt with the dispute about the agreement under section 240 and the applicant participated in the FWC’s processes to deal with the dispute; and  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "d5a64ac1d243c93bd37c4001dbb294ad57032c0f2205de35a54cfd4f6f07ae69" ;
    values:partOf concept:fair-work-act-2009-sec-234 ;
    cof:pageNumber "473"^^xsd:integer ;
    skos:note "FWC must be satisfied with applicant's participation in dispute resolution process. Application for intractable bargaining declaration must not be made without a supported bargaining authorisation or single interest employer authorisation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
