doc:sec-193a-ss-4 a cof:Section ;
    cof:title "193A(4) Applying the better off overall test" ;
    values:kind "subsection" ;
    values:originalText "(4) The FWC must give primary consideration to a common view (if any) relating to whether the agreement passes the better off overall test expressed by all of the following: (a) the bargaining representative or bargaining representatives of the employer or employers that are covered by the agreement; (b) the bargaining representative or bargaining representatives of award covered employees for the agreement (other than a bargaining representative that is not an employee organisation); (c) if the agreement is a single-enterprise agreement that covers one or more employees to whom a supported bargaining agreement or a single interest employer agreement applies— the bargaining representative or bargaining representatives of those employees (other than a bargaining representative that is not an employee organisation)." ;
    cof:pageNumber "394"^^xsd:integer .

concept:fair-work-act-2009-sec-193a-ss-5 a cml:Concept ;
    skos:prefLabel "193A(5) Applying the better off overall test"@en ;
    cml:realizedBy doc:sec-193a-ss-5 ;
    values:originalText "(5) Subsection (4) does not apply if the agreement is a greenfields agreement." ;
    skos:definition "(5) Subsection (4) does not apply if the agreement is a greenfields agreement."@en ;
    cml:integrityHash "d1588b12f7bcb4e97a949641ed555f91870585e2c1cee06ad4b727a85faf26d0" ;
    values:partOf concept:fair-work-act-2009-sec-193a ;
    cof:pageNumber "394"^^xsd:integer ;
