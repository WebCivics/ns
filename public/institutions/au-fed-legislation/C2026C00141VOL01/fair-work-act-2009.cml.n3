doc:sec-79a-ss-1 a cof:Section ;
    cof:title "79A(1) Keeping in touch days" ;
    values:kind "subsection" ;
    values:originalText "(1) This Subdivision does not prevent an employee from performing work for the employee’s employer on a keeping in touch day while the employee is taking unpaid parental leave. If the employee does so, the performance of that work does not break the continuity of the period of unpaid parental leave." ;
    cof:pageNumber "235"^^xsd:integer .

