concept:fair-work-act-2009-sec-76-ss-7 a cml:Concept ;
    skos:prefLabel "76(7) Extending period of unpaid parental leave—extending for up to"@en ;
    cml:realizedBy doc:sec-76-ss-7 ;
    values:originalText "(7) Despite any other provision of this Division, the employee is not entitled to extend the period of unpaid parental leave beyond 24 months after the date of birth or day of placement of the child." ;
    skos:definition "(7) Despite any other provision of this Division, the employee is not entitled to extend the period of unpaid parental leave beyond 24 months after the date of birth or day of placement of the child."@en ;
    cml:integrityHash "f9e2b1e619b6e64a39f33c0392b503de64dcf3afa70371bca8c71d146b04ec31" ;
    values:partOf concept:fair-work-act-2009-sec-76 ;
    cof:pageNumber "224"^^xsd:integer ;
    skos:note "Employee cannot extend unpaid parental leave beyond 24 months." ;
