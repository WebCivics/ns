doc:sec-65-ss-1a a cof:Section ;
    cof:title "65(1A) Requests for flexible working arrangements" ;
    values:kind "subsection" ;
    values:originalText "(1A) The following are the circumstances: (aa) the employee is pregnant; (a) the employee is the parent, or has responsibility for the care, of a child who is of school age or younger; (b) the employee is a carer (within the meaning of the Carer Recognition Act 2010); (c) the employee has a disability; (d) the employee is 55 or older; (e) the employee is experiencing family and domestic violence; (f) the employee provides care or support to a member of the employee’s immediate family, or a member of the employee’s household, who requires care or support because the member is experiencing family and domestic violence." ;
    cof:pageNumber "194"^^xsd:integer .

concept:fair-work-act-2009-sec-65-ss-1b a cml:Concept ;
    skos:prefLabel "65(1B) Requests for flexible working arrangements"@en ;
    cml:realizedBy doc:sec-65-ss-1b ;
    values:originalText "(1B) To avoid doubt, and without limiting subsection (1), an employee who: (a) is a parent, or has responsibility for the care, of a child; and (b) is returning to work after taking leave in relation to the birth or adoption of the child;  Terms and conditions of employment  Chapter 2 The National Employment Standards  Part 2-2 Requests for flexible working arrangements  Division 4 Section 65A Fair Work Act 2009 Compilation date: 02/04/2026 may request to work part-time to assist the employee to care for the child." ;
    skos:definition "(1B) To avoid doubt, and without limiting subsection (1), an employee who: (a) is a parent, or has responsibility for the care, of a child; and (b) is returning to work after taking leave in relation to the birth or adoption of the child;  Terms and conditions of employment  Chapter 2 The National Employment Standards  Part 2-2 Requests for flexible working arrangements  Division 4 Section 65A Fair Work Act 2009 Compilation date: 02/04/2026 may request to work part-time to assist the employee to care for the child."@en ;
    cml:integrityHash "e6aff228d1105b9716c223346aac00c8f5d28e797190232b882c7d77ad4a22e5" ;
    values:partOf concept:fair-work-act-2009-sec-65 ;
    cof:pageNumber "194"^^xsd:integer ;
    skos:note "Request for part-time work to care for a child" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
