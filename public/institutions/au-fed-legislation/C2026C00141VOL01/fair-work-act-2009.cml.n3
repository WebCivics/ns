doc:sec-114-ss-1 a cof:Section ;
    cof:title "114(1) Entitlement to be absent from employment on public holiday" ;
    values:kind "subsection" ;
    values:originalText "(1) An employee is entitled to be absent from his or her employment on a day or part-day that is a public holiday in the place where the employee is based for work purposes. Reasonable requests to work on public holidays" ;
    cof:pageNumber "271"^^xsd:integer .

