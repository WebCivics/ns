concept:fair-work-act-2009-sec-15a-ss-1 cml:asserts concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-2 .
concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
