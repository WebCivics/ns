doc:sec-156h-ss-3 a cof:Section ;
    cof:title "156H(3) Default fund term must specify certain superannuation funds" ;
    values:kind "subsection" ;
    values:originalText "(3) The default fund term may specify more than 15 superannuation funds in relation to standard MySuper products that satisfy the second stage test if, taking into account the range of occupations of employees covered by the modern award, the FWC is satisfied it is warranted.  Chapter 2  Terms and conditions of employment" ;
    cof:pageNumber "323"^^xsd:integer .

concept:fair-work-act-2009-sec-156j a cml:Concept ;
    skos:prefLabel "156J Variation to comply with section 149D"@en ;
    cml:realizedBy doc:sec-156j ;
    values:originalText "If, at the time of the 4 yearly review, the default fund term of a modern award does not comply with section 149D, the FWC must make a determination varying the term so that it does." ;
    skos:definition "If, at the time of the 4 yearly review, the default fund term of a modern award does not comply with section 149D, the FWC must make a determination varying the term so that it does."@en ;
