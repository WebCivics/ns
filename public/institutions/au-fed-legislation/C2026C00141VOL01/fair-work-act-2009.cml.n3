doc:sec-149f a cof:Section ;
    cof:title "149F Right to disconnect" ;
    values:kind "section" ;
    values:originalText "A modern award must include a right to disconnect term. Note: Right to disconnect term is defined in section 12. Subdivision D—Terms that must not be included in modern awards" ;
    cof:pageNumber "314"^^xsd:integer .

