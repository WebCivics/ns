    cml:premiseText "(a) section 81 applies to a pregnant employee but there is no appropriate safe job available; (b) the employee is entitled to unpaid parental leave; (c) the employee has complied with the notice and evidence requirements of section 74 for taking unpaid parental leave;" ;
    cml:conclusionText "The employee is entitled to paid no safe job leave." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

