    cml:integrityHash "763f8744d449736567ea829d0e31fdca490988317be86062ade4b3d97892b399" ;
    values:partOf concept:fair-work-act-2009-sec-216e ;
    cof:pageNumber "448"^^xsd:integer ;
    skos:note "Employees may vote by ballot or electronic method" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
