concept:fair-work-act-2009-sec-156q a cml:Concept ;
    skos:prefLabel "156Q The first stage test"@en ;
    cml:realizedBy doc:sec-156q ;
    values:originalText "An employer MySuper product satisfies the first stage test if the FWC is satisfied that including the product on the Schedule of Approved Employer MySuper Products would be in the best interests of default fund employees, or a particular class of those employees, taking into account: (a) the information provided in the application; and (b) the first stage criteria; and (c) any submissions that were made in relation to whether the product satisfies the first stage test." ;
    skos:definition "An employer MySuper product satisfies the first stage test if the FWC is satisfied that including the product on the Schedule of Approved Employer MySuper Products would be in the best interests of default fund employees, or a particular class of those employees, taking into account: (a) the information provided in the application; and (b) the first stage criteria; and (c) any submissions that were made in relation to whether the product satisfies the first stage test."@en ;
    cml:integrityHash "8eb8b6268fa130ced539f9b98d14e02363ba047cd22a60c62ad9328e8bc3a85e" ;
    cof:pageNumber "327"^^xsd:integer ;
