concept:fair-work-act-2009-sec-131 a cml:Concept ;
    skos:prefLabel "131 Relationship with other Commonwealth laws"@en ;
    cml:realizedBy doc:sec-131 ;
    values:originalText "This Part establishes minimum standards and so is intended to supplement, and not to override, entitlements under other laws of the Commonwealth.  Chapter 2  Terms and conditions of employment" ;
