    cof:pageNumber "451"^^xsd:integer ;
    skos:note "A multi-enterprise agreement remains unchanged despite variation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
