concept:fair-work-act-2009-sec-249a a cml:Concept ;
    skos:prefLabel "249A Restriction on making single interest employer authorisations"@en ;
    cml:realizedBy doc:sec-249a ;
    values:originalText "The FWC must not make a single interest employer authorisation in relation to a proposed enterprise agreement if the agreement would cover employees in relation to general building and construction work." ;
    skos:definition "The FWC must not make a single interest employer authorisation in relation to a proposed enterprise agreement if the agreement would cover employees in relation to general building and construction work."@en ;
    cml:integrityHash "e76bd49b3310fa6cd2995936637864674942acbe32d08afeaa16893855ede10a" ;
    cof:pageNumber "495"^^xsd:integer ;
    skos:note "FWC cannot make single interest employer authorisation for certain enterprise agreements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.495" ;
