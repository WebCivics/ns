    cof:pageNumber "424"^^xsd:integer .

concept:fair-work-act-2009-sec-213b-ss-3 a cml:Concept ;
    skos:prefLabel "213B(3) Effect of amendment specified by FWC"@en ;
    cml:realizedBy doc:sec-213b-ss-3 ;
    values:originalText "(3) If the FWC refuses to approve a variation of an enterprise agreement under this section, the FWC may refer the agreement as proposed to be varied to any person or body the FWC considers appropriate." ;
