concept:fair-work-act-2009-sec-227c a cml:Concept ;
    skos:prefLabel "227C Effect of undertakings"@en ;
    cml:realizedBy doc:sec-227c ;
    values:originalText "(1) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers a single employer; the undertaking is taken to be a term of the agreement, as the agreement applies to the employer. (2) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers 2 or more employers; the undertaking is taken to be a term of the agreement, as the agreement applies to each employer that gave the undertaking." ;
    skos:definition "(1) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers a single employer; the undertaking is taken to be a term of the agreement, as the agreement applies to the employer. (2) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers 2 or more employers; the undertaking is taken to be a term of the agreement, as the agreement applies to each employer that gave the undertaking."@en ;
    cml:integrityHash "621aac2643611e99952cce8000e68b95a78b5cce4a5424935c2b02cac0d928e5" ;
    cof:pageNumber "465"^^xsd:integer ;
    cml:hasPart concept:fair-work-act-2009-sec-227c-ss-1 ;
    cml:hasPart concept:fair-work-act-2009-sec-227c-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.465" .
doc:sec-227c a cof:Section ;
    cof:title "227C Effect of undertakings" ;
    values:kind "section" ;
    values:originalText "(1) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers a single employer; the undertaking is taken to be a term of the agreement, as the agreement applies to the employer. (2) If: (a) the FWC accepts an undertaking under paragraph 227B(3)(a) in relation to an enterprise agreement; and (b) the agreement covers 2 or more employers; the undertaking is taken to be a term of the agreement, as the agreement applies to each employer that gave the undertaking." ;
    cof:pageNumber "465"^^xsd:integer .

