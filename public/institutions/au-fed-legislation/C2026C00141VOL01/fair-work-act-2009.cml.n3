concept:fair-work-act-2009-sec-46-ss-1 cml:asserts concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If A, then B." ;
    cml:premiseText "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award." ;
    cml:conclusionText "(A or B) and (not A or not B)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-46-ss-1 cml:asserts concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-2 .
concept:fair-work-act-2009-sec-46-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "NotImplying" ;
    cml:logicSummary "A modern award may not impose obligations on a person unless the award applies to the person." ;
    cml:premiseText "(A) Modern award does not impose obligations on a person, and (B) Person does not contravene a term of a modern award." ;
    cml:conclusionText "(not A or B)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
