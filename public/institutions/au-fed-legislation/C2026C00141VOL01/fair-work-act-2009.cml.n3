concept:fair-work-act-2009-sec-40b a cml:Concept ;
    skos:prefLabel "40B Effect of the Migration Act 1958"@en ;
    cml:realizedBy doc:sec-40b ;
    values:originalText "For the purposes of this Act, any effect of the Migration Act 1958, or an instrument made under that Act, on the validity of a contract of employment, or the validity of a contract for services, is to be disregarded.  Introduction  Chapter 1 Road transport industry objective and advisory group  Part 1-4 Guide to this Part  Division 1 Section 40C Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "For the purposes of this Act, any effect of the Migration Act 1958, or an instrument made under that Act, on the validity of a contract of employment, or the validity of a contract for services, is to be disregarded.  Introduction  Chapter 1 Road transport industry objective and advisory group  Part 1-4 Guide to this Part  Division 1 Section 40C Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "95bf8005384d20de884b6dcc47abd716db2942df307a65a46e2ae1461a55b9ba" ;
    cof:pageNumber "164"^^xsd:integer ;
    skos:note "Disregard effect of Migration Act 1958 on contract validity" ;
    cml:curationStatus cml:Proposed ;
