concept:fair-work-act-2009-sec-65-ss-3 a cml:Concept ;
    skos:prefLabel "65(3) Requests for flexible working arrangements"@en ;
    cml:realizedBy doc:sec-65-ss-3 ;
    values:originalText "(3) The request must: (a) be in writing; and (b) set out details of the change sought and of the reasons for the change. Agreeing to the request" ;
    skos:definition "(3) The request must: (a) be in writing; and (b) set out details of the change sought and of the reasons for the change. Agreeing to the request"@en ;
    cml:integrityHash "c948852d280689edcee3be97deeea2889a3e7284f94bca950a15d3e4bcba161f" ;
