concept:fair-work-act-2009-sec-195-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "is" ;
    cml:logicSummary "Term is discriminatory if it discriminates against an employee." ;
    cml:premiseText "Discriminatory term (1)" ;
    cml:conclusionText "Term is discriminatory if it discriminates against an employee." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-195 cml:asserts concept:fair-work-act-2009-sec-195-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-195-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Term is discriminatory if it discriminates against an employee during the term of the agreement." ;
    cml:premiseText "Chapter 2 Terms and conditions of employment" ;
    cml:conclusionText "Term is discriminatory if it discriminates against an employee during the term of the agreement." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-195 cml:asserts concept:fair-work-act-2009-sec-195-logic-argumentation-3 .
concept:fair-work-act-2009-sec-195-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "implies" ;
    cml:logicSummary "If a term is discriminatory, then it implies that the employer is obligated to ensure equal treatment for employees." ;
    cml:premiseText "Discriminatory term (1)" ;
    cml:conclusionText "Employer is obligated to ensure equal treatment for employees." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-195 cml:asserts concept:fair-work-act-2009-sec-195-logic-diffusion-4 .
concept:fair-work-act-2009-sec-195-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "if-then" ;
    cml:logicSummary "If an employee is covered by the agreement, then the employer must comply with the non-discriminatory terms of the agreement." ;
    cml:premiseText "Chapter 2 Terms and conditions of employment" ;
    cml:conclusionText "Employer must comply with non-discriminatory terms of the agreement." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-195 cml:asserts concept:fair-work-act-2009-sec-195-logic-cogai-5 .
concept:fair-work-act-2009-sec-195-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "must" ;
    cml:logicSummary "The employer must ensure that all employees are treated equally regardless of their characteristics." ;
    cml:premiseText "Discriminatory term (1)" ;
    cml:conclusionText "Employer must ensure equal treatment for employees." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-195 a cof:Section ;
