doc:sec-74-ss-2a a cof:Section ;
    cof:title "74(2A) Notice and evidence requirements" ;
    values:kind "subsection" ;
    values:originalText "(2A) However, if the first or only period of leave covered by the notice is leave to be taken under section 72A, the notice may be given at any later time if the employer agrees." ;
    cof:pageNumber "220"^^xsd:integer .

