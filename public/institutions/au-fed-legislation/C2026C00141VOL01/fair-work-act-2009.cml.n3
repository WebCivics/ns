doc:sec-45 a cof:Section ;
    cof:title "45 Contravening a modern award" ;
    values:kind "section" ;
    values:originalText "A person must not contravene a term of a modern award. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a modern award unless the award applies to the person: see subsection 46(1)." ;
    cof:pageNumber "173"^^xsd:integer .

concept:fair-work-act-2009-sec-46 a cml:Concept ;
    skos:prefLabel "46 The significance of a modern award applying to a person"@en ;
    cml:realizedBy doc:sec-46 ;
    values:originalText "(1) A modern award does not impose obligations on a person, and a person does not contravene a term of a modern award, unless the award applies to the person. (2) A modern award does not give a person an entitlement unless the award applies to the person. Note: Subsection (2) does not affect the ability of outworker terms in a modern award to be enforced under Part 4-1 in relation to outworkers who are not employees.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(1) A modern award does not impose obligations on a person, and a person does not contravene a term of a modern award, unless the award applies to the person. (2) A modern award does not give a person an entitlement unless the award applies to the person. Note: Subsection (2) does not affect the ability of outworker terms in a modern award to be enforced under Part 4-1 in relation to outworkers who are not employees.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "31962d1cfce215b6afecfc07bd9bbd0c6c0a55454255c46a75997e78112aa0ea" ;
    cof:pageNumber "173"^^xsd:integer ;
    cml:hasPart concept:fair-work-act-2009-sec-46-ss-1 ;
