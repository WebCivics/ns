concept:fair-work-act-2009-sec-148 a cml:Concept ;
    skos:prefLabel "148 Base and full rates of pay for pieceworkers"@en ;
    cml:realizedBy doc:sec-148 ;
    values:originalText "If a modern award defines or describes employees covered by the award as pieceworkers, the award must include terms specifying, or providing for the determination of, base and full rates of pay for those employees for the purposes of the National Employment Standards. Note: An employee’s base and full rates of pay are significant in determining the employee’s entitlements under the National Employment Standards." ;
    skos:definition "If a modern award defines or describes employees covered by the award as pieceworkers, the award must include terms specifying, or providing for the determination of, base and full rates of pay for those employees for the purposes of the National Employment Standards. Note: An employee’s base and full rates of pay are significant in determining the employee’s entitlements under the National Employment Standards."@en ;
    cml:integrityHash "67a5a7419b96f5a58ca4a75685793ba78d709dd83a245bc93e0941ebf72c18b8" ;
    cof:pageNumber "310"^^xsd:integer ;
    skos:note "Award must specify base and full rates of pay for pieceworkers." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
