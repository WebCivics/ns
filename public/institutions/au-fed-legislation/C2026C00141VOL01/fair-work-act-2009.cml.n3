doc:sec-168a-ss-2 a cof:Section ;
    cof:title "168A(2) Modern enterprise awards" ;
    values:kind "subsection" ;
    values:originalText "(2) A modern enterprise award is a modern award that is expressed to relate to: (a) a single enterprise (or a part of a single enterprise) only; or (b) one or more enterprises, if the employers all carry on similar business activities under the same franchise and are: (i) franchisees of the same franchisor; or (ii) related bodies corporate of the same franchisor; or (iii) any combination of the above." ;
    cof:pageNumber "342"^^xsd:integer .

concept:fair-work-act-2009-sec-168a-ss-3 a cml:Concept ;
    skos:prefLabel "168A(3) Modern enterprise awards"@en ;
    cml:realizedBy doc:sec-168a-ss-3 ;
    values:originalText "(3) A single enterprise is: (a) a business, project or undertaking that is carried on by an employer; or (b) the activities carried on by: (i) the Commonwealth, a State or a Territory; or (ii) a body, association, office or other entity established for a public purpose by or under a law of the Commonwealth, a State or a Territory; or (iii) any other body in which the Commonwealth, a State or a Territory has a controlling interest." ;
    skos:definition "(3) A single enterprise is: (a) a business, project or undertaking that is carried on by an employer; or (b) the activities carried on by: (i) the Commonwealth, a State or a Territory; or (ii) a body, association, office or other entity established for a public purpose by or under a law of the Commonwealth, a State or a Territory; or (iii) any other body in which the Commonwealth, a State or a Territory has a controlling interest."@en ;
    cml:integrityHash "0f50d4f63ce7b1d2e94493e897f9926f0ff138038b8c117ee7195bd58740f9e1" ;
    values:partOf concept:fair-work-act-2009-sec-168a ;
    cof:pageNumber "342"^^xsd:integer ;
    skos:note "Definition of a single enterprise" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.342" ;
