doc:sec-83 a cof:Section ;
    cof:title "83 Consultation with employee on unpaid parental leave" ;
    values:kind "section" ;
    values:originalText "If: (a) an employee is taking a period of unpaid parental leave, other than flexible unpaid parental leave; and (b) the employee’s employer makes a decision that will have a significant effect on the status, pay or location of the employee’s pre-parental leave position; the employer must take all reasonable steps to give the employee information about, and an opportunity to discuss, the effect of the decision on that position." ;
    cof:pageNumber "241"^^xsd:integer .

concept:fair-work-act-2009-sec-84 a cml:Concept ;
    skos:prefLabel "84 Return to work guarantee"@en ;
    cml:realizedBy doc:sec-84 ;
    values:originalText "On ending a period of unpaid parental leave, an employee is entitled to return to: (a) the employee’s pre-parental leave position; or (b) if that position no longer exists—an available position for which the employee is qualified and suited nearest in status and pay to the pre-parental leave position." ;
    skos:definition "On ending a period of unpaid parental leave, an employee is entitled to return to: (a) the employee’s pre-parental leave position; or (b) if that position no longer exists—an available position for which the employee is qualified and suited nearest in status and pay to the pre-parental leave position."@en ;
    cml:integrityHash "4857fe301f57c03037469f8e61e907b2ddf8179499e080f040edca79e1616bff" ;
    cof:pageNumber "241"^^xsd:integer ;
    skos:note "Employee entitled to return to pre-parental leave position or nearest available qualified position." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.241" ;
