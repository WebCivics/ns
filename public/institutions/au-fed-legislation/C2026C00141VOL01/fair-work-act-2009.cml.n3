concept:fair-work-act-2009-sec-84a a cml:Concept ;
    skos:prefLabel "84A Replacement employees"@en ;
    cml:realizedBy doc:sec-84a ;
    values:originalText "(1) Before an employer engages an employee to perform the work of another employee who is going to take, or is taking, unpaid parental leave, the employer must notify the replacement employee: (a) that the engagement to perform that work is temporary; and  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(1) Before an employer engages an employee to perform the work of another employee who is going to take, or is taking, unpaid parental leave, the employer must notify the replacement employee: (a) that the engagement to perform that work is temporary; and  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "ab1f4c84c2f539b3a731858e84aa7f7d4dc10fa51933657c2f1a19160df78b51" ;
    cof:pageNumber "241"^^xsd:integer ;
    skos:note "Employer must notify replacement employee of temporary engagement." ;
    dc:description "Notification of temporary engagement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.241" ;
    cml:asserts concept:fair-work-act-2009-sec-84a-norm .
