doc:sec-37-ss-3 a cof:Section ;
    cof:title "37(3) Act binds Crown" ;
    values:kind "subsection" ;
    values:originalText "(3) The Crown in right of the Commonwealth is liable to be prosecuted for an offence against any of the following provisions: (a) subsection 327A(1); (b) a related offence provision, to the extent that the related offence provision relates to an offence against subsection 327A(1)." ;
    cof:pageNumber "161"^^xsd:integer .

concept:fair-work-act-2009-sec-37-ss-4 a cml:Concept ;
    skos:prefLabel "37(4) Act binds Crown"@en ;
    cml:realizedBy doc:sec-37-ss-4 ;
    values:originalText "(4) The Crown, in each of its capacities and to the extent the Commonwealth’s legislative power permits, is liable to be the subject of proceedings for a contravention of a civil remedy provision." ;
