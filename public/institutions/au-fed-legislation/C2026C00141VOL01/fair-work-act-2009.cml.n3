concept:fair-work-act-2009-sec-207-ss-4 a cml:Concept ;
    skos:prefLabel "207(4) Variation of an enterprise agreement may be made by"@en ;
    cml:realizedBy doc:sec-207-ss-4 ;
    values:originalText "(4) Subsection (1) applies to a greenfields agreement only if one or more of the persons who will be necessary for the normal conduct of the enterprise concerned and are covered by the agreement have been employed." ;
    skos:definition "(4) Subsection (1) applies to a greenfields agreement only if one or more of the persons who will be necessary for the normal conduct of the enterprise concerned and are covered by the agreement have been employed."@en ;
    cml:integrityHash "59284bda3be0a9d37d36a32ac218ab4cd05728b1567514a3eaec9c9b49132923" ;
    values:partOf concept:fair-work-act-2009-sec-207 ;
