    cof:pageNumber "340"^^xsd:integer .

concept:fair-work-act-2009-sec-168 a cml:Concept ;
    skos:prefLabel "168 Varied modern award must be published"@en ;
    cml:realizedBy doc:sec-168 ;
    values:originalText "(1) If the FWC makes a determination under this Part or Part 2-6 (which deals with minimum wages) varying a modern award, the FWC must publish the award as varied as soon as practicable. (2) The publication may be on the FWC’s website or by any other means that the FWC considers appropriate.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(1) If the FWC makes a determination under this Part or Part 2-6 (which deals with minimum wages) varying a modern award, the FWC must publish the award as varied as soon as practicable. (2) The publication may be on the FWC’s website or by any other means that the FWC considers appropriate.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "1e145b45a075fb4c0dda11e4ad3f70db689382a60564b71fd6a77b42f6258100" ;
    cof:pageNumber "341"^^xsd:integer ;
