doc:sec-87-ss-3 a cof:Section ;
    cof:title "87(3) Entitlement to annual leave" ;
    values:kind "subsection" ;
    values:originalText "(3) An award/agreement free employee qualifies for the shiftworker annual leave entitlement if: (a) the employee: (i) is employed in an enterprise in which shifts are continuously rostered 24 hours a day for 7 days a week; and (ii) is regularly rostered to work those shifts; and (iii) regularly works on Sundays and public holidays; or (b) the employee is in a class of employees prescribed by the regulations as shiftworkers for the purposes of the National Employment Standards." ;
    cof:pageNumber "244"^^xsd:integer .

concept:fair-work-act-2009-sec-87-ss-4 a cml:Concept ;
    skos:prefLabel "87(4) Entitlement to annual leave"@en ;
    cml:realizedBy doc:sec-87-ss-4 ;
    values:originalText "(4) However, an employee referred to in subsection (3) does not qualify for the shiftworker annual leave entitlement if the employee is in a class of employees prescribed by the regulations as not being qualified for that entitlement." ;
    skos:definition "(4) However, an employee referred to in subsection (3) does not qualify for the shiftworker annual leave entitlement if the employee is in a class of employees prescribed by the regulations as not being qualified for that entitlement."@en ;
    cml:integrityHash "a0d3617269a1a2b44eca69d4ed3e81fbd6dc5ef6322d014badc7f140a52872d4" ;
    values:partOf concept:fair-work-act-2009-sec-87 ;
    cof:pageNumber "244"^^xsd:integer ;
    skos:note "Employee does not qualify for shiftworker annual leave entitlement if in a prescribed class." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.244" ;
