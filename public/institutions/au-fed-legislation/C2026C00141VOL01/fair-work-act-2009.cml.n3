doc:sec-188a a cof:Section ;
    cof:title "188A Disclosure documents" ;
    values:kind "section" ;
    values:originalText "Failure by an organisation to comply with section 179 (disclosure by organisations), or by an employer to comply with section 179A or subsection 180(4A), (4B) or (4C) (disclosure by employers), in relation to an agreement: (a) does not mean that the agreement has not been genuinely agreed to by employees; and (b) is not otherwise relevant to approval by the FWC of the agreement." ;
    cof:pageNumber "387"^^xsd:integer .

