concept:fair-work-act-2009-sec-15h a cml:Concept ;
    skos:prefLabel "15H Meaning of services contract"@en ;
    cml:realizedBy doc:sec-15h ;
    values:originalText "General meaning (1) A services contract is a contract for services: (a) that relates to the performance of work under the contract by an individual; and (b) that has the requisite constitutional connection specified in subsection (2) or (3).  Chapter 1  Introduction" ;
    skos:definition "General meaning (1) A services contract is a contract for services: (a) that relates to the performance of work under the contract by an individual; and (b) that has the requisite constitutional connection specified in subsection (2) or (3).  Chapter 1  Introduction"@en ;
    cml:integrityHash "e64a46802d443cc617ff79c8cd80c9c6de2ad3e67ef6eba34a6ca695f6e18449" ;
    cof:pageNumber "99"^^xsd:integer ;
    skos:note "Defines services contract as a contract for individual work with constitutional connection." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.99" ;
