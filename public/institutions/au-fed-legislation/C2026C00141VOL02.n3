    cml:conclusionText "...unless the industrial action has involved or is likely to involve: (a) personal injury; or (b) wilful or reckless destruction of, or damage to, property; or (c) the unlawful taking, keeping or use of property." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

