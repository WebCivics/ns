    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Transferable instrument starts during employment" ;
    cml:premiseText "(b) after the transferable instrument starts to cover the new employer, the new employer employs a non-transferring employee; and (c) the non-transferring employee performs the transferring work;" ;
    cml:conclusionText "(1) If: ... then the transferable instrument covers the new employer and the non-transferring employee in relation to that work." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

