concept:fair-work-act-2009-sec-536lg-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-536lg ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-descriptionlogic-1 .
concept:fair-work-act-2009-sec-536lg-logic-descriptionlogic-1 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the person as deactivated based on conditions" ;
    cml:premiseText "The person performed digital platform work through or by means of the digital labour platform." ;
    cml:conclusionText "The person is no longer able to perform work under an existing or prospective services contract." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-descriptionlogic-2 .
concept:fair-work-act-2009-sec-536lg-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the digital labour platform operator as responsible for modifying, suspending, or terminating access" ;
    cml:premiseText "The digital labour platform operator modified, suspended, or terminated the person’s access to the digital labour platform." ;
    cml:conclusionText "The person is no longer able to perform work under an existing or prospective services contract." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-descriptionlogic-3 .
concept:fair-work-act-2009-sec-536lg-logic-descriptionlogic-3 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the person as unable to perform work due to significant alteration of ability" ;
    cml:premiseText "The person is no longer able to perform work under an existing or prospective services contract, or the ability of the person to do so is so significantly altered that in effect the person is no longer able to perform such work." ;
    cml:conclusionText "The person has been deactivated from a digital labour platform" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-alleninterval-4 .
concept:fair-work-act-2009-sec-536lg-logic-alleninterval-4 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "⊆" ;
    cml:logicSummary "Describes the temporal interval during which the person was deactivated" ;
    cml:premiseText "A person has been deactivated from a digital labour platform if: (a) the person performed digital platform work through or by means of the digital labour platform; and (b) the digital labour platform operator modified, suspended, or terminated the person’s access to the digital labour platform; and (c) the person is no longer able to perform work under an existing or prospective services contract, or the ability of the person to do so is so significantly altered that in effect the person is no longer able to perform such work." ;
    cml:conclusionText "The period during which the person was deactivated" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-ltl-5 .
concept:fair-work-act-2009-sec-536lg-logic-ltl-5 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "<" ;
    cml:logicSummary "Describes the temporal relationship between the conditions and the consequence of being deactivated" ;
    cml:premiseText "A person has been deactivated from a digital labour platform if: (a) the person performed digital platform work through or by means of the digital labour platform; and (b) the digital labour platform operator modified, suspended, or terminated the person’s access to the digital labour platform; and (c) the person is no longer able to perform work under an existing or prospective services contract, or the ability of the person to do so is so significantly altered that in effect the person is no longer able to perform such work." ;
    cml:conclusionText "The conditions imply that the person was deactivated" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-deontic-6 .
concept:fair-work-act-2009-sec-536lg-logic-deontic-6 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the obligation as a duty of the digital labour platform operator" ;
    cml:premiseText "A person has been deactivated from a digital labour platform if: (a) the person performed digital platform work through or by means of the digital labour platform; and (b) the digital labour platform operator modified, suspended, or terminated the person’s access to the digital labour platform; and (c) the person is no longer able to perform work under an existing or prospective services contract, or the ability of the person to do so is so significantly altered that in effect the person is no longer able to perform such work." ;
    cml:conclusionText "The digital labour platform operator has a duty to deactivate the person" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


