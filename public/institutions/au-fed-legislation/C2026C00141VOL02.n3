concept:fair-work-act-2009-sec-333f-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "excepts" ;
    cml:logicSummary "Exemptions from general rule" ;
    cml:premiseText "(1) Subsection 333E(1)" ;
    cml:conclusionText "Subsection 333E(1) does not apply" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333f cml:asserts concept:fair-work-act-2009-sec-333f-logic-descriptionlogic-2 .
concept:fair-work-act-2009-sec-333f-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "is a task involving specialised skills" ;
    cml:logicSummary "Distinct and identifiable task" ;
    cml:premiseText "(a) the employee is engaged under the contract to perform only a distinct and identifiable task" ;
    cml:conclusionText "The task is distinct and identifiable" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333f cml:asserts concept:fair-work-act-2009-sec-333f-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-333f-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during a peak demand period" ;
    cml:logicSummary "Peak demand period" ;
    cml:premiseText "(c) the employee is engaged under the contract to undertake essential work during a peak demand period" ;
    cml:conclusionText "The work is undertaken during a peak demand period" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333f cml:asserts concept:fair-work-act-2009-sec-333f-logic-deontic-4 .
concept:fair-work-act-2009-sec-333f-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "excepts" ;
    cml:logicSummary "Exemptions from general rule" ;
    cml:premiseText "(d) the employee is engaged under the contract to undertake work during emergency circumstances or during a temporary absence of another employee" ;
    cml:conclusionText "The work is undertaken during emergency circumstances or a temporary absence" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333f cml:asserts concept:fair-work-act-2009-sec-333f-logic-descriptionlogic-5 .
concept:fair-work-act-2009-sec-333f-logic-descriptionlogic-5 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "is funded in whole or in part by government funding" ;
    cml:logicSummary "Government funding" ;
    cml:premiseText "(f) the contract relates to a position for the performance of work that is funded in whole or in part by government funding" ;
    cml:conclusionText "The work is funded by government funding" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333f cml:asserts concept:fair-work-act-2009-sec-333f-logic-deontic-6 .
concept:fair-work-act-2009-sec-333f-logic-deontic-6 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "excepts" ;
    cml:logicSummary "Exemptions from general rule" ;
    cml:premiseText "(g) the contract relates to a governance position that has a time limit under the governing rules of a corporation or association of persons" ;
    cml:conclusionText "The contract is for a governance position with a time limit" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


