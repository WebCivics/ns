concept:fair-work-act-2009-sec-446-ss-2 a cml:Concept ;
    skos:prefLabel "446(2) Protected action ballot order may require 2 or more protected"@en ;
    cml:realizedBy doc:sec-446-ss-2 ;
    cml:integrityHash "58c8f589e968d4ecd8d7c32f970f51db405ce8422e4e849b6ccce4c267149a5c" ;
    values:partOf concept:fair-work-act-2009-sec-446 ;
    skos:note "The FWC may require protected action ballots to be held at the same time under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.246" ;
    cml:asserts concept:fair-work-act-2009-sec-446-ss-2-norm .
concept:fair-work-act-2009-sec-446-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-446-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-446-ss-2 cml:asserts concept:fair-work-act-2009-sec-446-ss-2-logic-deontic-1 .
concept:fair-work-act-2009-sec-446-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires protected action ballots to be held at the same time." ;
    cml:premiseText "(a) that the level of disruption of the employer’s enterprise, or at the workplace, could be reduced if the ballots were held at the same time;" ;
    cml:conclusionText "(b) that requiring the ballots to be held at the same time will not unreasonably delay either ballot." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-446-ss-2 cml:asserts concept:fair-work-act-2009-sec-446-ss-2-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-446-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "The protected action ballots are held during a specific time period." ;
    cml:premiseText "(2) The FWC may make, or vary, the protected action ballot orders so as to require the protected action ballots to be held at the same time;" ;
    cml:conclusionText "if the FWC is satisfied: (a) that the level of disruption of the employer’s enterprise, or at the workplace, could be reduced if the ballots were held at the same time; and (b) that requiring the ballots to be held at the same time will not unreasonably delay either ballot." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-446-ss-2 cml:asserts concept:fair-work-act-2009-sec-446-ss-2-logic-ltl-3 .
