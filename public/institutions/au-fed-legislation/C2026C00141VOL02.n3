concept:fair-work-act-2009-sec-536km-ss-1 a cml:Concept ;
    skos:prefLabel "536KM(1) Terms that must not be included in a minimum standards"@en ;
    cml:realizedBy doc:sec-536km-ss-1 ;
    cml:integrityHash "4d72d44d4c4d6fe84f6b38e22f58f9e6890cb7c310d61075c3a9317eb140f561" ;
    values:partOf concept:fair-work-act-2009-sec-536km ;
    skos:note "Terms that must not be included in a minimum standards order Terms about penalty rates, payment for time before or between engagements, and minimum engagement periods must not be included in an employee-like worker minimum standards order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
