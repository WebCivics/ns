concept:fair-work-act-2009-sec-361-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Presumption of action being taken for a particular reason or intent." ;
    cml:premiseText "(1) If: (a) in an application in relation to a contravention of this Part, it is alleged that a person took, or is taking, action for a particular reason or with a particular intent; and" ;
    cml:conclusionText "it is presumed that the action was, or is being, taken for that reason or with that intent, unless the person proves otherwise." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

