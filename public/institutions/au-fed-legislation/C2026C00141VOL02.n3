    cml:modality cml:Diffusion ;
    cml:operator "diffusion" ;
    cml:logicSummary "Excluded matters are diffused throughout the minimum standards order" ;
    cml:premiseText "(a) overtime rates; (b) rostering arrangements; (c) matters that are primarily of a commercial nature that do not affect the terms and conditions of engagement of regulated workers covered by the minimum standards order; (d) a term that would change the form of the engagement or the status of regulated workers covered by the minimum standards order including, but not limited to, a term that deems a regulated worker to be an employee; (e) a matter relating to work health and safety that is otherwise comprehensively dealt with by a law of the Commonwealth, a State or a Territory;" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536km-ss-1 cml:asserts concept:fair-work-act-2009-sec-536km-ss-1-logic-cogai-5 .
