    skos:prefLabel "536LG Meaning of deactivated"@en ;
    cml:realizedBy doc:sec-536lg ;
    cml:integrityHash "444fcea621dddd6d4589422005edcaf6aefe7752618d09d0f366d21c982b679a" ;
    skos:note "A person has been deactivated from a digital labour platform if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
