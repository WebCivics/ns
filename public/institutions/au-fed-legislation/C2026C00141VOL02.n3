    cml:conclusionText "if the FWC is satisfied: (a) that the level of disruption of the employer’s enterprise, or at the workplace, could be reduced if the ballots were held at the same time; and (b) that requiring the ballots to be held at the same time will not unreasonably delay either ballot." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

