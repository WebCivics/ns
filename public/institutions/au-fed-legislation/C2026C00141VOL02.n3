concept:fair-work-act-2009-sec-384-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Defines a term" ;
    cml:premiseText "(1) An employee’s period of employment with an employer at a particular time is the period of continuous service the employee has completed with the employer at that time as an employee." ;
    cml:conclusionText "An employee's period of employment is defined." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

