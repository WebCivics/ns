    cml:operator "temporal exclusion" ;
    cml:logicSummary "Temporal exclusion for certain matters" ;
    cml:premiseText "(f) a matter prescribed by the regulations, or belonging to a class of matter prescribed by the regulations for the purposes of this paragraph." ;
    cml:executionSurface "modalities::interval_reasoning" ;
