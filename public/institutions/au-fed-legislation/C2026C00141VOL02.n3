    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "Recognizes the need for a court hearing in cases where a dispute has not been resolved by the FWC." ;
    cml:premiseText "In most cases, a dispute about an alleged contravention of this Part will be dealt with by a court only if the dispute has not been resolved by the FWC." ;
    cml:conclusionText "A court hearing is recognized in cases where a dispute has not been resolved." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


