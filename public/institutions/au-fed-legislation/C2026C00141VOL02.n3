    cml:operator "<->" ;
    cml:logicSummary "Limitation on non-uniformity" ;
    cml:premiseText "The setting of different wages or loadings is limited just to the extent necessary." ;
    cml:conclusionText "The national minimum wage may not be uniform for all employees unless justified by exceptional circumstances and limited in scope." ;
    cml:executionSurface "modalities::logic::deontic" ;
