    cml:logicSummary "Justification for non-uniformity" ;
    cml:premiseText "There are exceptional circumstances justifying setting different wages or loadings." ;
    cml:conclusionText "The national minimum wage may not be uniform for all employees." ;
    cml:executionSurface "modalities::logic::deontic" ;
