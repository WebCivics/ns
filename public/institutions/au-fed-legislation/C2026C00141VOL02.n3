    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits enterprise agreement application" ;
    cml:premiseText "(a) an enterprise agreement applies to an employee in relation to particular employment; and (b) a workplace determination that covers the employee in relation to the same employment comes into operation;" ;
    cml:conclusionText "the enterprise agreement ceases to apply to the employee in relation to that employment, and can never so apply again." ;
    cml:executionSurface "modalities::logic::deontic" ;
