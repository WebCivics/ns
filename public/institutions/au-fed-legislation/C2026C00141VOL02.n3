concept:fair-work-act-2009-sec-386-ss-1 a cml:Concept ;
    skos:prefLabel "386(1) Meaning of dismissed"@en ;
    cml:realizedBy doc:sec-386-ss-1 ;
    cml:integrityHash "7f2f20deec50b8cc839e566cae676b03e3f71c00ec5d626e86c46d6c7b762dc3" ;
    values:partOf concept:fair-work-act-2009-sec-386 ;
    skos:note "A person has been dismissed if their employment was terminated or they resigned due to employer conduct." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.197" ;
    cml:asserts concept:fair-work-act-2009-sec-386-ss-1-norm .
concept:fair-work-act-2009-sec-386-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-386-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-386-ss-1 cml:asserts concept:fair-work-act-2009-sec-386-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-386-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "hasBeenDismissed" ;
    cml:logicSummary "Employment termination or resignation due to employer conduct." ;
    cml:premiseText "(1) A person has been dismissed if: (a) the person’s employment with his or her employer has been terminated on the employer’s initiative; or (b) the person has resigned from his or her employment, but was forced to do so because of conduct, or a course of conduct, engaged in by his or her employer." ;
    cml:conclusionText "(1) A person has been dismissed if: (a) the person’s employment with his or her employer has been terminated on the employer’s initiative; or (b) the person has resigned from his or her employment, but was forced to do so because of conduct, or a course of conduct, engaged in by his or her employer." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-386-ss-1 cml:asserts concept:fair-work-act-2009-sec-386-ss-1-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-386-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Employment termination occurs during the employment." ;
    cml:premiseText "(b) the person has resigned from his or her employment, but was forced to do so because of conduct, or a course of conduct, engaged in by his or her employer." ;
    cml:conclusionText "(b) the person has resigned from his or her employment, but was forced to do so because of conduct, or a course of conduct, engaged in by his or her employer." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-386-ss-1 cml:asserts concept:fair-work-act-2009-sec-386-ss-1-logic-ltl-3 .
concept:fair-work-act-2009-sec-386-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "during" ;
    cml:logicSummary "Employment termination occurs during the employment." ;
    cml:premiseText "(b) the person has resigned from his or her employment, but was forced to do so because of conduct, or a course of conduct, engaged in by his or her employer." ;
    cml:conclusionText "(b) the person has resigned from his or her employment, but was forced to do so because of conduct, or a course of conduct, engaged in by his or her employer." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


