concept:fair-work-act-2009-sec-536jk-ss-1 a cml:Concept ;
    skos:prefLabel "536JK(1) The significance of a collective agreement applying to a"@en ;
    cml:realizedBy doc:sec-536jk-ss-1 ;
    cml:integrityHash "7d8010fb98de93aae43b3079884932b35a9f47ca9e2e6ca91fda5cfaa4a5268e" ;
    values:partOf concept:fair-work-act-2009-sec-536jk ;
    skos:note "A collective agreement imposes obligations on a person unless the agreement applies to the person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.365" ;
    cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-norm .
concept:fair-work-act-2009-sec-536jk-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-536jk-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If A, then B." ;
    cml:premiseText "(A) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
    cml:conclusionText "(B) A collective agreement imposes obligations on a person unless the agreement applies to the person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "A and B overlap if there exists a time interval I such that A starts before I ends and I ends after B starts." ;
    cml:premiseText "(1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
    cml:conclusionText "(2) The agreement applies to the person if and only if the person is subject to the agreement during some time interval I." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-ltl-3 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "A holds until B if A starts before B ends." ;
    cml:premiseText "(1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
    cml:conclusionText "(2) The agreement imposes obligations on a person only during some time interval I." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-diffusion-4 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "A diffuses B if every instance of A is an instance of B." ;
    cml:premiseText "(1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
    cml:conclusionText "(2) The agreement applies to all persons if and only if every person is subject to the agreement." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-cogai-5 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "IsA" ;
    cml:logicSummary "A is a subclass of B if A is an instance of B." ;
    cml:premiseText "(1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
    cml:conclusionText "(2) The agreement is a rule that governs the behavior of persons if and only if every person is subject to the agreement." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


