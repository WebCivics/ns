concept:fair-work-act-2009-sec-314-ss-1 cml:asserts concept:fair-work-act-2009-sec-314-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-314-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "covers" ;
    cml:logicSummary "Transferable instrument obligation" ;
    cml:premiseText "(a) a transferable instrument covers the new employer because of paragraph 313(1)(a); and (b) after the transferable instrument starts to cover the new employer, the new employer employs a non-transferring employee; and (c) the non-transferring employee performs the transferring work; and (d) at the time the non-transferring employee is employed, no other enterprise agreement or modern award covers the new employer and the non-transferring employee in relation to that work;" ;
    cml:conclusionText "(1) If: ... then the transferable instrument covers the new employer and the non-transferring employee in relation to that work." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

