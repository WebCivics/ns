    cml:integrityHash "98a9c5cd793b1cf15bef514917e886660533843bebc809715bee24be08e77fcf" ;
    values:partOf concept:fair-work-act-2009-sec-314 ;
    skos:note "Transferable instrument covers new employer and non-transferring employee in relation to that work." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
