    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Harassment occurs during the same time period as the other person's employment." ;
    cml:premiseText "The harassment occurs in connection with the other person being a person of the relevant kind." ;
    cml:conclusionText "Harassment overlaps with the other person's employment." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

