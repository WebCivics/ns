    cml:logicSummary "Prohibits sexual harassment." ;
    cml:premiseText "The other person is a worker in a business or undertaking..." ;
    cml:conclusionText "Sexual harassment is prohibited." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
