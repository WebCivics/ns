concept:fair-work-act-2009-sec-298-ss-2 a cml:Concept ;
    skos:prefLabel "298(2) Special rule about retrospective variations of national minimum"@en ;
    cml:realizedBy doc:sec-298-ss-2 ;
    cml:integrityHash "c888ff9554bd0e248ba335905fe51f2c10a6ca81dfd06b4bed3b96205e1fd581" ;
    values:partOf concept:fair-work-act-2009-sec-298 ;
    skos:note "No pecuniary penalty for conduct before determination if retrospective effect would not have contravened a term of the national minimum wage order or enterprise agreement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.62" ;
    cml:asserts concept:fair-work-act-2009-sec-298-ss-2-norm .
concept:fair-work-act-2009-sec-298-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-298-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-298-ss-2 cml:asserts concept:fair-work-act-2009-sec-298-ss-2-logic-deontic-1 .
concept:fair-work-act-2009-sec-298-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Exemption" ;
    cml:logicSummary "Exempts conduct from pecuniary penalty if retrospective effect would not have contravened a term of the national minimum wage order or enterprise agreement." ;
    cml:premiseText "(2) If: (a) a person engaged in conduct before the determination was made; and (b) but for the retrospective effect of the determination, the conduct would not have contravened a term of the national minimum wage order or an enterprise agreement;" ;
    cml:conclusionText "A court must not order the person to pay a pecuniary penalty under Division 2 of Part 4-1 in relation to the conduct, on the grounds that the conduct contravened a term of the national minimum wage order or enterprise agreement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-298-ss-2 cml:asserts concept:fair-work-act-2009-sec-298-ss-2-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-298-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The retrospective effect of the determination overlaps with the conduct before determination." ;
    cml:premiseText "(2) If: (a) a person engaged in conduct before the determination was made; and (b) but for the retrospective effect of the determination, the conduct would not have contravened a term of the national minimum wage order or an enterprise agreement;" ;
    cml:conclusionText "The retrospective effect of the determination overlaps with the conduct before determination." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-298-ss-2 cml:asserts concept:fair-work-act-2009-sec-298-ss-2-logic-ltl-3 .
concept:fair-work-act-2009-sec-298-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "The conduct before determination repeats the conduct after determination in terms of its impact on the national minimum wage order or enterprise agreement." ;
    cml:premiseText "(2) If: (a) a person engaged in conduct before the determination was made; and (b) but for the retrospective effect of the determination, the conduct would not have contravened a term of the national minimum wage order or an enterprise agreement;" ;
    cml:conclusionText "The conduct before determination repeats the conduct after determination." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-298-ss-2 cml:asserts concept:fair-work-act-2009-sec-298-ss-2-logic-deontic-4 .
concept:fair-work-act-2009-sec-298-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permissive" ;
    cml:logicSummary "Permits conduct before determination if retrospective effect would not have contravened a term of the national minimum wage order or enterprise agreement." ;
    cml:premiseText "(2) If: (a) a person engaged in conduct before the determination was made; and (b) but for the retrospective effect of the determination, the conduct would not have contravened a term of the national minimum wage order or an enterprise agreement;" ;
    cml:conclusionText "The conduct is permitted if the retrospective effect would not have contravened a term of the national minimum wage order or enterprise agreement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


