    values:partOf concept:fair-work-act-2009-sec-333e-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-333e-ss-1 cml:asserts concept:fair-work-act-2009-sec-333e-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-333e-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits entering into a contract of employment with an employee that includes a term providing for termination at the end of an identifiable period." ;
    cml:premiseText "(a) the person enters into a contract of employment with an employee; and (b) the contract includes a term that provides the contract will terminate at the end of an identifiable period" ;
    cml:conclusionText "The person contravenes this subsection if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333e-ss-1 cml:asserts concept:fair-work-act-2009-sec-333e-ss-1-logic-descriptionlogic-2 .
concept:fair-work-act-2009-sec-333e-ss-1-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "Identifies" ;
    cml:logicSummary "Identifies the conditions under which a contract is prohibited." ;
    cml:premiseText "(c) the employee is not a casual employee of the employer for whom the period referred to in paragraph (b) is identified by reference to the completion of the shift of work to which the contract relates; and (d) subsection (2), (3) or (4) applies" ;
    cml:conclusionText "and (c) the employee is not a casual employee of the employer for whom the period referred to in paragraph (b) is identified by reference to the completion of the shift of work to which the contract relates; and (d) subsection (2), (3) or (4) applies" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


