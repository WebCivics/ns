    cml:modality cml:Deontic ;
    cml:operator "appliesTo" ;
    cml:logicSummary "The obligation applies to the transferring employee." ;
    cml:premiseText "(b) The transferring employee was a high income employee immediately before the termination of the transferring employee’s employment with the old employer; and" ;
    cml:conclusionText "(1) This section applies if: (b) The transferring employee was a high income employee immediately before the termination of the transferring employee’s employment with the old employer; and" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
