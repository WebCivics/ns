    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits protected industrial action for a proposed enterprise agreement." ;
    cml:premiseText "(a) the industrial action is being engaged in, or is threatened, impending or probable; and (b) the industrial action is threatening, or would threaten: ..." ;
    cml:conclusionText "...the Minister may make a declaration terminating protected industrial action..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

