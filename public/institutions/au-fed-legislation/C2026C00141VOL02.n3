concept:fair-work-act-2009-sec-415-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-415-ss-1 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-415-ss-1 cml:asserts concept:fair-work-act-2009-sec-415-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-415-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits industrial action unless it involves specified conditions." ;
    cml:premiseText "(1) No action lies under any law (whether written or unwritten) in relation to any industrial action that is protected industrial action..." ;
    cml:conclusionText "...unless the industrial action has involved or is likely to involve: (a) personal injury; or (b) wilful or reckless destruction of, or damage to, property; or (c) the unlawful taking, keeping or use of property." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

