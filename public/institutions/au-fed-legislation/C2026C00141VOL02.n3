    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the old employer gave a guarantee, then it must provide for the transferring employee." ;
    cml:premiseText "(a) The old employer had given a guarantee of annual earnings for a guaranteed period to a transferring employee; and" ;
    cml:conclusionText "(1) This section applies if: (a) the old employer had given a guarantee of annual earnings for a guaranteed period to a transferring employee; and" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

