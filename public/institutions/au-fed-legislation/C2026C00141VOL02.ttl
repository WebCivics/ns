    <https://ns.webcivics.net/cml/logicSummary> "Prohibits entering into a contract of employment with an employee that includes a term providing for termination at the end of an identifiable period.";
    <https://ns.webcivics.net/cml/premiseText> "(a) the person enters into a contract of employment with an employee; and (b) the contract includes a term that provides the contract will terminate at the end of an identifiable period";
    <https://ns.webcivics.net/cml/conclusionText> "The person contravenes this subsection if...";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
