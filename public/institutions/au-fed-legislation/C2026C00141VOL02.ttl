<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-diffusion-4> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Diffusion>;
    <https://ns.webcivics.net/cml/operator> "Diffuses";
    <https://ns.webcivics.net/cml/logicSummary> "Spread of authorization to employees";
    <https://ns.webcivics.net/cml/premiseText> "(a) the action was the subject of the ballot; and (b) at least 50% of the employees on the roll of voters for the ballot voted in the ballot.";
    <https://ns.webcivics.net/cml/conclusionText> "The authorization spreads to a significant portion of employees.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::diffusion";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-argumentation-5>.
<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-argumentation-5> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Argumentation>;
    <https://ns.webcivics.net/cml/operator> "Implication";
    <https://ns.webcivics.net/cml/logicSummary> "Relationship between action and ballot outcome";
    <https://ns.webcivics.net/cml/premiseText> "(c) more than 50% of the valid votes were votes approving the action; and (d) the action commences: (i) during the 30-day period starting on the date of the declaration of the results of the ballot; or (ii) if the FWC has extended that period under subsection (3)—during the extended period.";
    <https://ns.webcivics.net/cml/conclusionText> "The action is approved by a majority of votes if it occurs within the specified time frame.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::argumentation";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
