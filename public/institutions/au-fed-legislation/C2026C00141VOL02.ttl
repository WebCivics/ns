    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "Overlaps";
    <https://ns.webcivics.net/cml/logicSummary> "Temporal overlap with declaration period";
    <https://ns.webcivics.net/cml/premiseText> "(d) the action commences: (i) during the 30-day period starting on the date of the declaration of the results of the ballot; or (ii) if the FWC has extended that period under subsection (3)—during the extended period.";
    <https://ns.webcivics.net/cml/conclusionText> "The action must occur within a specified time frame.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-ltl-3>.
<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-ltl-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/LTL>;
    <https://ns.webcivics.net/cml/operator> "Until";
    <https://ns.webcivics.net/cml/logicSummary> "Temporal relationship with declaration period";
    <https://ns.webcivics.net/cml/premiseText> "(d) the action commences: (i) during the 30-day period starting on the date of the declaration of the results of the ballot; or (ii) if the FWC has extended that period under subsection (3)—during the extended period.";
    <https://ns.webcivics.net/cml/conclusionText> "The action occurs until a specified time frame.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
