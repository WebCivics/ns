<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-deontic-1>.
<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Authorization obligation";
    <https://ns.webcivics.net/cml/premiseText> "(a) the action was the subject of the ballot; and (b) at least 50% of the employees on the roll of voters for the ballot voted in the ballot.";
    <https://ns.webcivics.net/cml/conclusionText> "The action is authorized if the conditions are met.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/fair-work-act-2009-sec-459-ss-1-logic-alleninterval-2>.
