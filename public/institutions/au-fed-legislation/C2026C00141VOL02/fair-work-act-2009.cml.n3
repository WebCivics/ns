concept:fair-work-act-2009-sec-346 a cml:Concept ;
    skos:prefLabel "346 Protection"@en ;
    cml:realizedBy doc:sec-346 ;
    values:originalText "A person must not take adverse action against another person because the other person: (a) is or is not, or was or was not, an officer or member of an industrial association; or (b) engages, or has at any time engaged or proposed to engage, in industrial activity within the meaning of paragraph 347(a) or (b); or (c) does not engage, or has at any time not engaged or proposed to not engage, in industrial activity within the meaning of paragraphs 347(c) to (g). Note: This section is a civil remedy provision (see Part 4-1)." ;
    skos:definition "A person must not take adverse action against another person because the other person: (a) is or is not, or was or was not, an officer or member of an industrial association; or (b) engages, or has at any time engaged or proposed to engage, in industrial activity within the meaning of paragraph 347(a) or (b); or (c) does not engage, or has at any time not engaged or proposed to not engage, in industrial activity within the meaning of paragraphs 347(c) to (g). Note: This section is a civil remedy provision (see Part 4-1)."@en ;
    cml:integrityHash "d216e3a4a12e0a664dc31a9beb579d58a565e172f000aa698f945a209288098a" ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Taking adverse action against another person due to their industrial activity is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.170" ;
    cml:asserts concept:fair-work-act-2009-sec-346-norm .
