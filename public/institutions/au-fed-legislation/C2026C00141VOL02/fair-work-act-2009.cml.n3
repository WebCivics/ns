doc:sec-536aa-ss-2 a cof:Section ;
    cof:title "536AA(2) Employer obligations in relation to advertising rates of pay" ;
    values:kind "subsection" ;
    values:originalText "(2) If: (a) an employer advertises, or causes to be advertised, that the employer is offering employment as a pieceworker; and (b) the employee would be entitled to a periodic rate of pay, if the advertised employment occurred; the advertisement must: (c) specify that rate of pay (or a higher rate of pay); or (d) include a statement to the effect that a periodic rate of pay is payable in relation to the employment. Note: This subsection is a civil remedy provision (see Part 4-1). Reasonable excuse" ;
    cof:pageNumber "347"^^xsd:integer .

concept:fair-work-act-2009-sec-536aa-ss-3 a cml:Concept ;
    skos:prefLabel "536AA(3) Employer obligations in relation to advertising rates of pay"@en ;
    cml:realizedBy doc:sec-536aa-ss-3 ;
    values:originalText "(3) Subsections (1) and (2) do not apply if the employer has a reasonable excuse.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "(3) Subsections (1) and (2) do not apply if the employer has a reasonable excuse.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "6eb31579a9bc41304d22a8e760138165e5078eff5ab39afb2b65d30ed97ca54d" ;
