concept:fair-work-act-2009-sec-309 a cml:Concept ;
    skos:prefLabel "309 Object of this Part"@en ;
    cml:realizedBy doc:sec-309 ;
    values:originalText "The object of this Part is to provide a balance between: (a) the protection of employees’ terms and conditions of employment under enterprise agreements, certain modern awards and certain other instruments; and (b) the interests of employers in running their enterprises efficiently; if there is a transfer of business from one employer to another employer.  Terms and conditions of employment  Chapter 2 Transfer of business  Part 2-8 Transfer of instruments  Division 2 Section 310 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "The object of this Part is to provide a balance between: (a) the protection of employees’ terms and conditions of employment under enterprise agreements, certain modern awards and certain other instruments; and (b) the interests of employers in running their enterprises efficiently; if there is a transfer of business from one employer to another employer.  Terms and conditions of employment  Chapter 2 Transfer of business  Part 2-8 Transfer of instruments  Division 2 Section 310 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "e7bf6cc80d2dd0ed8b8b99414a5ab0884ca1315a591e31e7727ee3813b4105f5" ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Balancing protection of employees' terms and conditions with employers' interests in running enterprises efficiently." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.108" ;
