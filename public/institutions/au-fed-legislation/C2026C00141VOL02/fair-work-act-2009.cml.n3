concept:fair-work-act-2009-sec-484 a cml:Concept ;
    skos:prefLabel "484 Entry to hold discussions"@en ;
    cml:realizedBy doc:sec-484 ;
    values:originalText "A permit holder may enter premises for the purposes of holding discussions with one or more employees or TCF award workers: (a) who perform work on the premises; and (b) whose industrial interests the permit holder’s organisation is entitled to represent; and (c) who wish to participate in those discussions.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "A permit holder may enter premises for the purposes of holding discussions with one or more employees or TCF award workers: (a) who perform work on the premises; and (b) whose industrial interests the permit holder’s organisation is entitled to represent; and (c) who wish to participate in those discussions.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "6e6105985113ddd312ce5d0ddb754febb49e4f65e55d440bea9c2b602b8f6efe" ;
    cof:pageNumber "287"^^xsd:integer ;
    skos:note "Permit holder may enter premises for discussions with employees or TCF award workers" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
