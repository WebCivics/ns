    values:originalText "To avoid doubt, an order by the FWC under subsection 391(3) or 392(1) may permit the employer concerned to pay the amount required in instalments specified in the order.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "To avoid doubt, an order by the FWC under subsection 391(3) or 392(1) may permit the employer concerned to pay the amount required in instalments specified in the order.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "81e51a1b1a3f503770a84da60ff001f412a775a6533f8afe0c58454f507825a4" ;
    cof:pageNumber "203"^^xsd:integer ;
    skos:note "Employer may pay amount in instalments" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.203" ;
