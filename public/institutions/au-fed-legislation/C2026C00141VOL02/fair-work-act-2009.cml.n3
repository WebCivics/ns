concept:fair-work-act-2009-sec-536a a cml:Concept ;
    skos:prefLabel "536A Guide to this Part"@en ;
    cml:realizedBy doc:sec-536a ;
    values:originalText "This Part is about corrupting benefits provided to or in relation to organisations. Division 2 prohibits benefits intended to influence an officer or employee of an organisation. Division 3 prohibits national system employers providing cash or in kind payments to employee organisations and related persons, other than certain legitimate benefits specified in the Division." ;
    skos:definition "This Part is about corrupting benefits provided to or in relation to organisations. Division 2 prohibits benefits intended to influence an officer or employee of an organisation. Division 3 prohibits national system employers providing cash or in kind payments to employee organisations and related persons, other than certain legitimate benefits specified in the Division."@en ;
    cml:integrityHash "dbf9c68866f11f4c492ac5ceb3995c18def5e11e4583fb7a22d1efb7c78d4f5b" ;
    cof:pageNumber "348"^^xsd:integer ;
    skos:note "Corrupting benefits provided to or in relation to organisations are prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
