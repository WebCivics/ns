concept:fair-work-act-2009-sec-280 a cml:Concept ;
    skos:prefLabel "280 Contravening a workplace determination"@en ;
    cml:realizedBy doc:sec-280 ;
    values:originalText "A person must not contravene a term of a workplace determination. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a workplace determination unless the determination applies to the person: see subsections 51(1) and 279(1)." ;
    skos:definition "A person must not contravene a term of a workplace determination. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a workplace determination unless the determination applies to the person: see subsections 51(1) and 279(1)."@en ;
    cml:integrityHash "e6a4a264a177890bcc1dcaf664f818c8c25d27f576f2de9087da19c741ae8df9" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Prohibition on contravening a workplace determination" ;
    cml:curationStatus cml:Proposed ;
