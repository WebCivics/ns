concept:fair-work-act-2009-sec-527 a cml:Concept ;
    skos:prefLabel "527 Contravening an FWC order dealing with a dispute about the"@en ;
    cml:realizedBy doc:sec-527 ;
    values:originalText "operation of this Part A person must not contravene a term of an FWC order dealing with a dispute about the operation of this Part. Note: This section is a civil remedy provision (see Part 4-1).  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Prohibiting sexual harassment in connection with work  Part 3-5A Introduction  Division 1 Section 527A Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "operation of this Part A person must not contravene a term of an FWC order dealing with a dispute about the operation of this Part. Note: This section is a civil remedy provision (see Part 4-1).  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Prohibiting sexual harassment in connection with work  Part 3-5A Introduction  Division 1 Section 527A Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "5db03a15e2427abbd11bffbe58a071cd74e5c85e0f6e4ae11a6acdca2709cec6" ;
    cof:pageNumber "322"^^xsd:integer ;
    skos:note "Prohibits contravening an FWC order dealing with a dispute about the operation of this Part." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
