concept:fair-work-act-2009-sec-271 a cml:Concept ;
    skos:prefLabel "271 No other terms"@en ;
    cml:realizedBy doc:sec-271 ;
    values:originalText "An intractable bargaining workplace determination must not include any terms other than those required by subsection 270(1).  Terms and conditions of employment  Chapter 2 Workplace determinations  Part 2-5 Core terms, mandatory terms and agreed terms of workplace determinations etc." ;
    skos:definition "An intractable bargaining workplace determination must not include any terms other than those required by subsection 270(1).  Terms and conditions of employment  Chapter 2 Workplace determinations  Part 2-5 Core terms, mandatory terms and agreed terms of workplace determinations etc."@en ;
    cml:integrityHash "5fe4c2cd804edd4a6a20a964a85e713606a8c74d2ec21d9577d051392b5d1dbd" ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "No other terms can be included in an intractable bargaining workplace determination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
