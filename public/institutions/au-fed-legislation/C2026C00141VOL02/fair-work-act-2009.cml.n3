doc:sec-420-ss-3 a cof:Section ;
    cof:title "420(3) Interim orders etc." ;
    values:kind "subsection" ;
    values:originalText "(3) However, the FWC must not make the interim order if the FWC is satisfied that it would be contrary to the public interest to do so." ;
    cof:pageNumber "225"^^xsd:integer .

