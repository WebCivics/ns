concept:fair-work-act-2009-sec-536lw a cml:Concept ;
    skos:prefLabel "536LW Initial matters to be considered before merits"@en ;
    cml:realizedBy doc:sec-536lw ;
    values:originalText "The FWC must decide the following matters relating to an application for an order under Division 4 before considering the merits of the application: (a) whether the application was made within the period required in subsection 536LU(3); (b) whether the person was protected from unfair deactivation or unfair termination, as the case requires; (c) whether the deactivation or termination was consistent with the Digital Labour Platform Deactivation Code or the Road Transport Industry Termination Code, as the case requires." ;
    skos:definition "The FWC must decide the following matters relating to an application for an order under Division 4 before considering the merits of the application: (a) whether the application was made within the period required in subsection 536LU(3); (b) whether the person was protected from unfair deactivation or unfair termination, as the case requires; (c) whether the deactivation or termination was consistent with the Digital Labour Platform Deactivation Code or the Road Transport Industry Termination Code, as the case requires."@en ;
    cml:integrityHash "5126287bc3472ada740c592b377a713b8623ddc4bc31067bb3abd0fa41d9eb45" ;
    cof:pageNumber "440"^^xsd:integer ;
    skos:note "Consideration of specific matters before merits consideration" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
