concept:fair-work-act-2009-sec-333x-ss-3 a cml:Concept ;
    skos:prefLabel "333X(3) Employer-funded paid parental leave—preserved if child is"@en ;
    cml:realizedBy doc:sec-333x-ss-3 ;
    values:originalText "(3) Despite subsection (2), the employer may refuse or cancel that leave if, under the terms and conditions of the employee’s employment:  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(3) Despite subsection (2), the employer may refuse or cancel that leave if, under the terms and conditions of the employee’s employment:  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "bcf6661032cf8381b5358da26695167a1936279e8b9606d5f588595beefc3deb" ;
    values:partOf concept:fair-work-act-2009-sec-333x ;
