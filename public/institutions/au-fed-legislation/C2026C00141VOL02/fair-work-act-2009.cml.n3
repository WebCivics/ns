concept:fair-work-act-2009-sec-486 a cml:Concept ;
    skos:prefLabel "486 Permit holder must not contravene this Subdivision"@en ;
    cml:realizedBy doc:sec-486 ;
    values:originalText "Subdivisions A, AA and B do not authorise a permit holder to enter or remain on premises, or exercise any other right, if he or she contravenes this Subdivision, or regulations prescribed under section 521, in exercising that right." ;
    skos:definition "Subdivisions A, AA and B do not authorise a permit holder to enter or remain on premises, or exercise any other right, if he or she contravenes this Subdivision, or regulations prescribed under section 521, in exercising that right."@en ;
    cml:integrityHash "a84296841b6107df646206dc63344467f4d17fe184932e8a0397b6e525a27a18" ;
    cof:pageNumber "288"^^xsd:integer ;
    skos:note "Permit holder must not contravene this Subdivision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
