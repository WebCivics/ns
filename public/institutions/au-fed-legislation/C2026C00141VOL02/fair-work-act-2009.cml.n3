doc:sec-483e-ss-5 a cof:Section ;
    cof:title "483E(5) Later access to record or document—other premises" ;
    values:kind "subsection" ;
    values:originalText "(5) An occupier must not contravene a requirement under subsection (1). Note: This subsection is a civil remedy provision (see Part 4-1). Where record or document may be inspected or copied" ;
    cof:pageNumber "286"^^xsd:integer .

concept:fair-work-act-2009-sec-483e-ss-6 a cml:Concept ;
    skos:prefLabel "483E(6) Later access to record or document—other premises"@en ;
    cml:realizedBy doc:sec-483e-ss-6 ;
    values:originalText "(6) The permit holder may inspect, and make copies of, the record or document at: (a) the other premises; or (b) if another place is agreed upon by the permit holder and the occupier—that other place. Note 1: The use or disclosure of information or documents obtained under this section is strictly controlled (see section 504). Note 2: The use or disclosure of personal information obtained under this section is regulated under the Privacy Act 1988. Subdivision B—Entry to hold discussions" ;
    skos:definition "(6) The permit holder may inspect, and make copies of, the record or document at: (a) the other premises; or (b) if another place is agreed upon by the permit holder and the occupier—that other place. Note 1: The use or disclosure of information or documents obtained under this section is strictly controlled (see section 504). Note 2: The use or disclosure of personal information obtained under this section is regulated under the Privacy Act 1988. Subdivision B—Entry to hold discussions"@en ;
    cml:integrityHash "91acf36e648def553bbe505f95ba45d816cceec7487336930321c3e221ce991f" ;
    values:partOf concept:fair-work-act-2009-sec-483e ;
    cof:pageNumber "286"^^xsd:integer ;
