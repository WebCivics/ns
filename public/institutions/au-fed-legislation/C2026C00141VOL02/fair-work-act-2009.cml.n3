    cml:modality cml:Argumentation ;
    cml:operator "if-then" ;
    cml:logicSummary "Inference from premises to conclusion" ;
    cml:premiseText "The reasons for the action are included in the list of reasons." ;
    cml:conclusionText "A person takes action for a particular reason if the reasons include that reason." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

