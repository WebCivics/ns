concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If A, then B." ;
    cml:premiseText "(A) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
    cml:conclusionText "(B) A collective agreement imposes obligations on a person unless the agreement applies to the person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536jk-ss-1 cml:asserts concept:fair-work-act-2009-sec-536jk-ss-1-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-536jk-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "A and B overlap if there exists a time interval I such that A starts before I ends and I ends after B starts." ;
    cml:premiseText "(1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person." ;
