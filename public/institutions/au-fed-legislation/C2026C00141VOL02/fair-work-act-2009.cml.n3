doc:sec-536my a cof:Section ;
    cof:title "536MY Guide to this Part" ;
    values:kind "section" ;
    values:originalText "This Part is about unfair contract terms of services contracts. It provides a framework for dealing with unfair contract terms." ;
    cof:pageNumber "459"^^xsd:integer .

