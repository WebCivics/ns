doc:sec-536jy-ss-1 a cof:Section ;
    cof:title "536JY(1) Minimum standards orders" ;
    values:kind "subsection" ;
    values:originalText "(1) The FWC may make an order (a minimum standards order) that sets standards for: (a) employee-like workers; or (b) regulated road transport contractors." ;
    cof:pageNumber "379"^^xsd:integer .

