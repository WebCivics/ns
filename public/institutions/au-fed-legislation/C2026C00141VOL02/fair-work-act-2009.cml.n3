doc:sec-358 a cof:Section ;
    cof:title "358 Dismissing to engage as independent contractor" ;
    values:kind "section" ;
    values:originalText "An employer must not dismiss, or threaten to dismiss, an individual who: (a) is an employee of the employer; and (b) performs particular work for the employer; in order to engage the individual as an independent contractor to perform the same, or substantially the same, work under a contract for services. Note: This section is a civil remedy provision (see Part 4-1).  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 General protections  Part 3-1 Sham arrangements  Division 6 Section 359 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    cof:pageNumber "180"^^xsd:integer .

concept:fair-work-act-2009-sec-359 a cml:Concept ;
    skos:prefLabel "359 Misrepresentation to engage as independent contractor"@en ;
    cml:realizedBy doc:sec-359 ;
    values:originalText "A person (the employer) that employs, or has at any time employed, an individual to perform particular work must not make a statement that the employer knows is false in order to persuade or influence the individual to enter into a contract for services under which the individual will perform, as an independent contractor, the same, or substantially the same, work for the employer. Note: This section is a civil remedy provision (see Part 4-1). Subdivision B—Casual employment" ;
    skos:definition "A person (the employer) that employs, or has at any time employed, an individual to perform particular work must not make a statement that the employer knows is false in order to persuade or influence the individual to enter into a contract for services under which the individual will perform, as an independent contractor, the same, or substantially the same, work for the employer. Note: This section is a civil remedy provision (see Part 4-1). Subdivision B—Casual employment"@en ;
    cml:integrityHash "c907a6dbf3ba41d2fddc181caaaa3edcdfa33631273379855762cf39790db527" ;
    cof:pageNumber "181"^^xsd:integer ;
    skos:note "Employer must not make false statements to persuade an individual to enter into a contract as an independent contractor." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.181" ;
