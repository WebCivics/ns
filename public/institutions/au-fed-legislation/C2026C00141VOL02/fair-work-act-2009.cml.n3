concept:fair-work-act-2009-sec-515-ss-5 a cml:Concept ;
    skos:prefLabel "515(5) Conditions on entry permit"@en ;
    cml:realizedBy doc:sec-515-ss-5 ;
    values:originalText "(5) To avoid doubt, a permit holder does not contravene an FWC order merely because the permit holder contravenes a condition imposed on his or her permit by order (whether the condition is imposed at the time the entry permit is issued or at any later time)." ;
    skos:definition "(5) To avoid doubt, a permit holder does not contravene an FWC order merely because the permit holder contravenes a condition imposed on his or her permit by order (whether the condition is imposed at the time the entry permit is issued or at any later time)."@en ;
    cml:integrityHash "a98c3c7ceadfde64f0da356500d3e7c46c31d19d0d5c8d44322a227977e4d388" ;
    values:partOf concept:fair-work-act-2009-sec-515 ;
    cof:pageNumber "308"^^xsd:integer ;
    skos:note "Avoid contravening an FWC order due to permit conditions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
