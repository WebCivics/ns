concept:fair-work-act-2009-sec-459-ss-3 a cml:Concept ;
    skos:prefLabel "459(3) Circumstances in which industrial action is authorised by"@en ;
    cml:realizedBy doc:sec-459-ss-3 ;
    values:originalText "(3) The FWC may extend the 30-day period referred to in subparagraph (1)(d)(i) by up to 30 days if: (a) an applicant for the protected action ballot order applies to the FWC for the period to be extended; and (b) the period has not previously been extended." ;
    skos:definition "(3) The FWC may extend the 30-day period referred to in subparagraph (1)(d)(i) by up to 30 days if: (a) an applicant for the protected action ballot order applies to the FWC for the period to be extended; and (b) the period has not previously been extended."@en ;
    cml:integrityHash "cce248f98c9268f29eaeec201a40743df1fb054622074be01932dc51353e7c7b" ;
    values:partOf concept:fair-work-act-2009-sec-459 ;
    cof:pageNumber "256"^^xsd:integer ;
    skos:note "Extension of time limit for protected action ballot order application" ;
