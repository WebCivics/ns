concept:fair-work-act-2009-sec-533 a cml:Concept ;
    skos:prefLabel "533 Application for an FWC order"@en ;
    cml:realizedBy doc:sec-533 ;
    values:originalText "The FWC may make the order only on application by: (a) one of the employees; or (b) a registered employee association referred to in paragraph 531(2)(a) or (3)(a); or (c) any other registered employee association that is entitled to represent the industrial interests of one of the employees. Subdivision C—Limits on scope of this Division" ;
    skos:definition "The FWC may make the order only on application by: (a) one of the employees; or (b) a registered employee association referred to in paragraph 531(2)(a) or (3)(a); or (c) any other registered employee association that is entitled to represent the industrial interests of one of the employees. Subdivision C—Limits on scope of this Division"@en ;
    cml:integrityHash "87f8a9f178ddb2a58b632f425376fdb855c0d26faefb2aed39008de16cecdc2c" ;
    cof:pageNumber "343"^^xsd:integer ;
    skos:note "Application for an FWC order is required." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
