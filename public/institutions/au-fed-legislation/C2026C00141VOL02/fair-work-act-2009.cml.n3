    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Diffuses responsibility for sexual harassment to employees or agents." ;
    cml:premiseText "Persons may be liable for acts contravening this Part that are performed by their employees or agents." ;
    cml:conclusionText "Responsibility for sexual harassment is diffused to employees or agents." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-527a cml:asserts concept:fair-work-act-2009-sec-527a-logic-argumentation-4 .
