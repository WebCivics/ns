concept:fair-work-act-2009-sec-445 a cml:Concept ;
    skos:prefLabel "445 Notice of protected action ballot order"@en ;
    cml:realizedBy doc:sec-445 ;
    values:originalText "As soon as practicable after making a protected action ballot order, the FWC must give a copy of the order to: (a) each applicant for the order; and (b) the employer of the employees who are to be balloted; and (c) the protected action ballot agent for the protected action ballot." ;
    skos:definition "As soon as practicable after making a protected action ballot order, the FWC must give a copy of the order to: (a) each applicant for the order; and (b) the employer of the employees who are to be balloted; and (c) the protected action ballot agent for the protected action ballot."@en ;
    cml:integrityHash "5f6ed99170ec8bdce348117df6ce5848a48850a755dc0771cb392e2e66ddbb9a" ;
    cof:pageNumber "246"^^xsd:integer ;
    skos:note "Must provide notice of protected action ballot order to applicants, employer, and protected action ballot agent." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.246" ;
