doc:sec-306f-ss-2 a cof:Section ;
    cof:title "306F(2) Protected rate of pay payable to employees if a regulated" ;
    values:kind "subsection" ;
    values:originalText "(2) The employer must pay the regulated employee at no less than the protected rate of pay for the employee in connection with the work performed by the employee for the regulated host. Note: This subsection is a civil remedy provision (see Part 4-1). Exceptions" ;
    cof:pageNumber "83"^^xsd:integer .

concept:fair-work-act-2009-sec-306f-ss-3 a cml:Concept ;
    skos:prefLabel "306F(3) Protected rate of pay payable to employees if a regulated"@en ;
    cml:realizedBy doc:sec-306f-ss-3 ;
    values:originalText "(3) The employer does not contravene subsection (2) if the employer pays the regulated employee at less than the protected rate of pay because: (a) the regulated host provides information to the employer under section 306H (which deals with information about the protected rate of pay); and (b) the employer reasonably relies on the information for the purposes of working out the protected rate of pay for the regulated employee; and  Chapter 2  Terms and conditions of employment" ;
    skos:definition "(3) The employer does not contravene subsection (2) if the employer pays the regulated employee at less than the protected rate of pay because: (a) the regulated host provides information to the employer under section 306H (which deals with information about the protected rate of pay); and (b) the employer reasonably relies on the information for the purposes of working out the protected rate of pay for the regulated employee; and  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "08b60932bc10c480dabb2415b0f214cc057470ea676c7fcb721e9036c3cb31e9" ;
    values:partOf concept:fair-work-act-2009-sec-306f ;
    cof:pageNumber "83"^^xsd:integer ;
    skos:note "Employer must pay regulated employee at protected rate of pay if provided with accurate information." ;
    dc:description "Information about protected rate of pay" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
