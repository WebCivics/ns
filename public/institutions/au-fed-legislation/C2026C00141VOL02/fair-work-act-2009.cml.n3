doc:sec-536lm-ss-1 a cof:Section ;
    cof:title "536LM(1) Criteria for considering whether a termination was unfair" ;
    values:kind "subsection" ;
    values:originalText "(1) In considering whether it is satisfied that a termination was unfair, the FWC must take into account: (a) whether there was a valid reason for the termination related to the person’s capacity or conduct; and (b) whether any relevant processes specified in the Road Transport Industry Termination Code were followed; and (c) any other matters that the FWC considers relevant." ;
    cof:pageNumber "431"^^xsd:integer .

concept:fair-work-act-2009-sec-536lm-ss-2 a cml:Concept ;
    skos:prefLabel "536LM(2) Criteria for considering whether a termination was unfair"@en ;
    cml:realizedBy doc:sec-536lm-ss-2 ;
    values:originalText "(2) Despite subsection (1) and any other provision of this Part, a termination that occurs because of serious misconduct of the person who was deactivated is not unfair." ;
    skos:definition "(2) Despite subsection (1) and any other provision of this Part, a termination that occurs because of serious misconduct of the person who was deactivated is not unfair."@en ;
    cml:integrityHash "f1ba79d94db922f67ee13ece38010e3cc27de197357a7f5494a48b755f0a30a4" ;
    values:partOf concept:fair-work-act-2009-sec-536lm ;
    cof:pageNumber "431"^^xsd:integer ;
    skos:note "Termination due to serious misconduct is not considered unfair." ;
