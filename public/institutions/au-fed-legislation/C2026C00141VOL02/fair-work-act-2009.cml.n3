doc:sec-536lk a cof:Section ;
    cof:title "536LK What is an unfair termination" ;
    values:kind "section" ;
    values:originalText "A person has been unfairly terminated if: (a) the person was performing work in the road transport industry; and (b) the person has been terminated; and (c) the termination was unfair; and (d) the termination was not consistent with the Road Transport Industry Termination Code." ;
    cof:pageNumber "430"^^xsd:integer .

concept:fair-work-act-2009-sec-536ll a cml:Concept ;
    skos:prefLabel "536LL Meaning of terminated"@en ;
    cml:realizedBy doc:sec-536ll ;
    values:originalText "A person has been terminated if: (a) the person performed work as a regulated road transport contractor under a services contract; and (b) a road transport business received services under the services contract; and (c) the services contract was terminated by, or as a result of conduct of, the road transport business.  Minimum standards for regulated workers  Chapter 3A Unfair deactivation or unfair termination of regulated workers  Part 3A-3 What is an unfair deactivation or unfair termination  Division 3 Section 536LM Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "A person has been terminated if: (a) the person performed work as a regulated road transport contractor under a services contract; and (b) a road transport business received services under the services contract; and (c) the services contract was terminated by, or as a result of conduct of, the road transport business.  Minimum standards for regulated workers  Chapter 3A Unfair deactivation or unfair termination of regulated workers  Part 3A-3 What is an unfair deactivation or unfair termination  Division 3 Section 536LM Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "000967965a18c1ca265a1fd33b441a082bdd72c8d6110e5dd6a80f230afc425e" ;
    cof:pageNumber "430"^^xsd:integer ;
    skos:note "Terminated person performed work as a regulated road transport contractor under a services contract." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.430" ;
    cml:asserts concept:fair-work-act-2009-sec-536ll-norm .
