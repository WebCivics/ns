    cml:modality cml:Argumentation ;
    cml:operator "implies" ;
    cml:logicSummary "Implication of eligibility for dispute resolution" ;
    cml:premiseText "(a) a person alleges a contravention of this Part; and (b) the person is not entitled to apply to the FWC under section 365 for the FWC to deal with the dispute;" ;
    cml:conclusionText "If a person alleges a contravention of this Part and is not entitled to apply to the FWC under section 365, then the person may apply to the FWC under this section for the FWC to deal with the dispute." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "0.5000"^^xsd:decimal ;
