concept:fair-work-act-2009-sec-405 a cml:Concept ;
    skos:prefLabel "405 Contravening orders under this Part"@en ;
    cml:realizedBy doc:sec-405 ;
    values:originalText "A person to whom an order under this Part applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1).  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
