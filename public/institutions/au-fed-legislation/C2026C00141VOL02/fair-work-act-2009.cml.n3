concept:fair-work-act-2009-sec-268 a cml:Concept ;
    skos:prefLabel "268 No other terms"@en ;
    cml:realizedBy doc:sec-268 ;
    values:originalText "An industrial action related workplace determination must not include any terms other than those required by subsection 267(1).  Chapter 2  Terms and conditions of employment" ;
