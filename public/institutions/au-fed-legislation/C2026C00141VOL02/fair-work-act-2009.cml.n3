    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-536mq-ss-2 a cof:Section ;
    cof:title "536MQ(2) Negotiating entity may request that other negotiating entity" ;
    values:kind "subsection" ;
    values:originalText "(2) A request under subsection (1) must not be made earlier than 30 days after the last day on which a notice was given to an employee-like worker or a regulated road transport contractor, as the case requires, under subsection 536MN(1) in relation to the proposed collective agreement." ;
    cof:pageNumber "451"^^xsd:integer .

concept:fair-work-act-2009-sec-536mq-ss-3 a cml:Concept ;
    skos:prefLabel "536MQ(3) Negotiating entity may request that other negotiating entity"@en ;
    cml:realizedBy doc:sec-536mq-ss-3 ;
    values:originalText "(3) The collective agreement is made when both of the negotiating parties for the agreement sign the agreement.  Chapter 3A  Minimum standards for regulated workers" ;
    skos:definition "(3) The collective agreement is made when both of the negotiating parties for the agreement sign the agreement.  Chapter 3A  Minimum standards for regulated workers"@en ;
    cml:integrityHash "4eaa2db5d7eb24669e21c98fe2c3439223c2e19744a5f48260dc0b8212ce43cc" ;
    values:partOf concept:fair-work-act-2009-sec-536mq ;
    cof:pageNumber "451"^^xsd:integer ;
    skos:note "Both negotiating parties must sign the agreement for a collective agreement to be made." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
