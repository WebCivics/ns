concept:fair-work-act-2009-sec-365 a cml:Concept ;
    skos:prefLabel "365 Application for the FWC to deal with a dismissal dispute"@en ;
    cml:realizedBy doc:sec-365 ;
    values:originalText "If: (a) a person has been dismissed; and (b) the person, or an industrial association that is entitled to represent the industrial interests of the person, alleges that the person was dismissed in contravention of this Part; the person, or the industrial association, may apply to the FWC for the FWC to deal with the dispute." ;
    skos:definition "If: (a) a person has been dismissed; and (b) the person, or an industrial association that is entitled to represent the industrial interests of the person, alleges that the person was dismissed in contravention of this Part; the person, or the industrial association, may apply to the FWC for the FWC to deal with the dispute."@en ;
    cml:integrityHash "052eb2337d0a44bf2cc320b034c07232f38bfa5a6315048308f425fa31535674" ;
    cof:pageNumber "185"^^xsd:integer ;
    skos:note "Application for FWC to deal with dismissal dispute" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.185" ;
    cml:asserts concept:fair-work-act-2009-sec-365-norm .
