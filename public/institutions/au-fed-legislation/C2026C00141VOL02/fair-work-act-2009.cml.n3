concept:fair-work-act-2009-sec-333c a cml:Concept ;
    skos:prefLabel "333C Pay secrecy terms to have no effect"@en ;
    cml:realizedBy doc:sec-333c ;
    values:originalText "A term of a fair work instrument or a contract of employment has no effect to the extent that the term would be inconsistent with subsection 333B(1) or (2) (about employee rights relating to pay secrecy)." ;
    skos:definition "A term of a fair work instrument or a contract of employment has no effect to the extent that the term would be inconsistent with subsection 333B(1) or (2) (about employee rights relating to pay secrecy)."@en ;
    cml:integrityHash "69b828c2326e3ab159b7b3f4e49208d6fbca7a0256a95b12f7dfd9ca6b8f17d6" ;
    cof:pageNumber "140"^^xsd:integer ;
    skos:note "Term of employment contract has no effect if inconsistent with employee pay secrecy rights" ;
    cml:curationStatus cml:Proposed ;
