    cof:pageNumber "440"^^xsd:integer .

concept:fair-work-act-2009-sec-536lx a cml:Concept ;
    skos:prefLabel "536LX Matters involving contested facts"@en ;
    cml:realizedBy doc:sec-536lx ;
    values:originalText "The FWC must conduct a conference or hold a hearing in relation to a matter arising under this Part if, and to the extent that, the matter involves facts the existence of which is in dispute.  Minimum standards for regulated workers  Chapter 3A Unfair deactivation or unfair termination of regulated workers  Part 3A-3 Procedural matters  Division 5 Section 536LY Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "The FWC must conduct a conference or hold a hearing in relation to a matter arising under this Part if, and to the extent that, the matter involves facts the existence of which is in dispute.  Minimum standards for regulated workers  Chapter 3A Unfair deactivation or unfair termination of regulated workers  Part 3A-3 Procedural matters  Division 5 Section 536LY Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "c8fa499b94ebb2f22febaa3f3925ae4113e64d1ee3b12117dff9a9ae0eab8e0a" ;
    cof:pageNumber "440"^^xsd:integer ;
    skos:note "Must conduct a conference or hold a hearing if facts are in dispute." ;
