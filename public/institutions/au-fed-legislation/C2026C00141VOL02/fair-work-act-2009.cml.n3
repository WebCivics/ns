doc:sec-437-ss-1 a cof:Section ;
    cof:title "437(1) Application for a protected action ballot order" ;
    values:kind "subsection" ;
    values:originalText "(1) A bargaining representative of an employee who will be covered by a proposed enterprise agreement, or 2 or more such bargaining representatives (acting jointly), may apply to the FWC for an order (a protected action ballot order) requiring a protected action ballot to be conducted to determine whether employees wish to engage in particular protected industrial action for the agreement." ;
    cof:pageNumber "240"^^xsd:integer .

concept:fair-work-act-2009-sec-437-ss-2 a cml:Concept ;
    skos:prefLabel "437(2) Application for a protected action ballot order"@en ;
    cml:realizedBy doc:sec-437-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply if the proposed enterprise agreement is: (a) a greenfields agreement; or (b) a cooperative workplace agreement." ;
    skos:definition "(2) Subsection (1) does not apply if the proposed enterprise agreement is: (a) a greenfields agreement; or (b) a cooperative workplace agreement."@en ;
    cml:integrityHash "1cfd588ef723a5f2e38449627d4ed5e051849f6bb69ec93a74ccd971275699f4" ;
    values:partOf concept:fair-work-act-2009-sec-437 ;
    cof:pageNumber "240"^^xsd:integer ;
    skos:note "Exemption from subsection (1) for specific types of agreements" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
