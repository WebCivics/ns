concept:fair-work-act-2009-sec-536mj a cml:Concept ;
    skos:prefLabel "536MJ Object of this Part"@en ;
    cml:realizedBy doc:sec-536mj ;
    values:originalText "The object of this Part is to provide a simple, flexible and fair framework that enables collective agreements to be made by consent for: (a) employee-like workers; (b) regulated road transport contractors.  Minimum standards for regulated workers  Chapter 3A Collective agreements for regulated workers  Part 3A-4 Regulated workers and regulated businesses may make collective agreements  Division Section 536MK Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "The object of this Part is to provide a simple, flexible and fair framework that enables collective agreements to be made by consent for: (a) employee-like workers; (b) regulated road transport contractors.  Minimum standards for regulated workers  Chapter 3A Collective agreements for regulated workers  Part 3A-4 Regulated workers and regulated businesses may make collective agreements  Division Section 536MK Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "04fd1f4b69265f6a3a3ed8e3596ec43069cbab5d12be9f33571099d38b85db6d" ;
    cof:pageNumber "446"^^xsd:integer ;
    skos:note "Object of this Part is to provide a simple, flexible and fair framework that enables collective agreements to be made by consent for employee-like workers; regulated road transport contractors." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
