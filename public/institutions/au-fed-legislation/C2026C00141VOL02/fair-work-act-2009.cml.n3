concept:fair-work-act-2009-sec-355 a cml:Concept ;
    skos:prefLabel "355 Coercion—allocation of duties etc. to particular person"@en ;
    cml:realizedBy doc:sec-355 ;
    values:originalText "A person must not organise or take, or threaten to organise or take, any action against another person with intent to coerce the other person, or a third person, to: (a) employ, or not employ, a particular person; or (b) engage, or not engage, a particular independent contractor; or (c) allocate, or not allocate, particular duties or responsibilities to a particular employee or independent contractor; or (d) designate a particular employee or independent contractor as having, or not having, particular duties or responsibilities. Note: This section is a civil remedy provision (see Part 4-1)." ;
    skos:definition "A person must not organise or take, or threaten to organise or take, any action against another person with intent to coerce the other person, or a third person, to: (a) employ, or not employ, a particular person; or (b) engage, or not engage, a particular independent contractor; or (c) allocate, or not allocate, particular duties or responsibilities to a particular employee or independent contractor; or (d) designate a particular employee or independent contractor as having, or not having, particular duties or responsibilities. Note: This section is a civil remedy provision (see Part 4-1)."@en ;
    cml:integrityHash "3f5c9ee834cc5025851c642bf5d892faa8cf243f76264279a06a0bbf8b519cbb" ;
    cof:pageNumber "179"^^xsd:integer ;
    skos:note "Coercion is prohibited" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.179" ;
    cml:asserts concept:fair-work-act-2009-sec-355-norm .
