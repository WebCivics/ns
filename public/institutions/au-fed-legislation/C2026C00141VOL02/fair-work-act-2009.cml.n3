    cof:pageNumber "393"^^xsd:integer .

concept:fair-work-act-2009-sec-536kr a cml:Concept ;
    skos:prefLabel "536KR Minimum standards guidelines"@en ;
    cml:realizedBy doc:sec-536kr ;
    values:originalText "(1) The FWC may make minimum standards guidelines under this section that set standards for regulated workers performing work under a services contract. (2) Minimum standards guidelines for employee-like workers are employee-like worker guidelines. (3) Minimum standards guidelines for regulated road transport contractors are road transport guidelines. (4) The FWC may make minimum standards guidelines under this section: (a) on its own initiative; or (b) on application under section 536KS." ;
    skos:definition "(1) The FWC may make minimum standards guidelines under this section that set standards for regulated workers performing work under a services contract. (2) Minimum standards guidelines for employee-like workers are employee-like worker guidelines. (3) Minimum standards guidelines for regulated road transport contractors are road transport guidelines. (4) The FWC may make minimum standards guidelines under this section: (a) on its own initiative; or (b) on application under section 536KS."@en ;
    cml:integrityHash "48839ccec2b5da4f7bbf1869d051648cf8c6b4b8a5e9d4941d15edc0b1c02fe7" ;
    cof:pageNumber "419"^^xsd:integer ;
