    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the dismissal meets all conditions, it is unfair." ;
    cml:premiseText "The person has been dismissed." ;
    cml:conclusionText "The dismissal is unfair." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
