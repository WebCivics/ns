    cof:pageNumber "302"^^xsd:integer ;
    skos:note "Prohibition on contravening an order" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
