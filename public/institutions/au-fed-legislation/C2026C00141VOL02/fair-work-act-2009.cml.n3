concept:fair-work-act-2009-sec-383 a cml:Concept ;
    skos:prefLabel "383 Meaning of minimum employment period"@en ;
    cml:realizedBy doc:sec-383 ;
    values:originalText "The minimum employment period is: (a) if the employer is not a small business employer—6 months ending at the earlier of the following times: (i) the time when the person is given notice of the dismissal; (ii) immediately before the dismissal; or (b) if the employer is a small business employer—one year ending at that time." ;
    skos:definition "The minimum employment period is: (a) if the employer is not a small business employer—6 months ending at the earlier of the following times: (i) the time when the person is given notice of the dismissal; (ii) immediately before the dismissal; or (b) if the employer is a small business employer—one year ending at that time."@en ;
    cml:integrityHash "721ac0519c1a92309b09fcc6f5b3d0140f763ca2000c0d5a2d860611eef9ebfb" ;
    cof:pageNumber "195"^^xsd:integer ;
    skos:note "Minimum employment period for dismissal" ;
    cml:curationStatus cml:Proposed ;
