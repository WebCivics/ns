concept:fair-work-act-2009-sec-534 a cml:Concept ;
    skos:prefLabel "534 Limits on scope of this Division"@en ;
    cml:realizedBy doc:sec-534 ;
    values:originalText "(1) This Division does not apply in relation to any of the following employees: (a) an employee employed for a specified period of time, for a specified task, or for the duration of a specified season; (b) an employee who is dismissed because of serious misconduct; (c) a casual employee; (d) an employee (other than an apprentice) to whom a training arrangement applies and whose employment is for a specified period of time or is, for any reason, limited to the duration of the training arrangement; (e) a daily hire employee working in the building and construction industry (including working in connection with  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "(1) This Division does not apply in relation to any of the following employees: (a) an employee employed for a specified period of time, for a specified task, or for the duration of a specified season; (b) an employee who is dismissed because of serious misconduct; (c) a casual employee; (d) an employee (other than an apprentice) to whom a training arrangement applies and whose employment is for a specified period of time or is, for any reason, limited to the duration of the training arrangement; (e) a daily hire employee working in the building and construction industry (including working in connection with  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "ebad5d5017df3cba948e01749d8fdf952f72ea7d01b7b63cfe3eb7b091ea1e0a" ;
    cof:pageNumber "343"^^xsd:integer ;
    skos:note "Exemptions from application of Division 534" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
