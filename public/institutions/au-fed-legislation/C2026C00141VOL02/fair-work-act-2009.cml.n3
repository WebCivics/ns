concept:fair-work-act-2009-sec-536jb a cml:Concept ;
    skos:prefLabel "536JB Contravening a minimum standards order"@en ;
    cml:realizedBy doc:sec-536jb ;
    values:originalText "A person must not contravene a term of a minimum standards order. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a minimum standards order unless the order applies to the person: see subsection 536JC(1)." ;
    skos:definition "A person must not contravene a term of a minimum standards order. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a minimum standards order unless the order applies to the person: see subsection 536JC(1)."@en ;
    cml:integrityHash "cbcec254b30bdcef1817667f8a3fbd5633265f0e4436abe2d8f1a1ce6413efd8" ;
    cof:pageNumber "359"^^xsd:integer ;
