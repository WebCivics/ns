concept:fair-work-act-2009-sec-483e-ss-5 a cml:Concept ;
    skos:prefLabel "483E(5) Later access to record or document—other premises"@en ;
    cml:realizedBy doc:sec-483e-ss-5 ;
    values:originalText "(5) An occupier must not contravene a requirement under subsection (1). Note: This subsection is a civil remedy provision (see Part 4-1). Where record or document may be inspected or copied" ;
    skos:definition "(5) An occupier must not contravene a requirement under subsection (1). Note: This subsection is a civil remedy provision (see Part 4-1). Where record or document may be inspected or copied"@en ;
    cml:integrityHash "ff7d6a3d538e4d7fde7352d46bbe7e81db17ecc94bc85ad6248734fab089cfd3" ;
    values:partOf concept:fair-work-act-2009-sec-483e ;
    cof:pageNumber "286"^^xsd:integer ;
