concept:fair-work-act-2009-sec-385 a cml:Concept ;
    skos:prefLabel "385 What is an unfair dismissal"@en ;
    cml:realizedBy doc:sec-385 ;
    values:originalText "A person has been unfairly dismissed if the FWC is satisfied that: (a) the person has been dismissed; and (b) the dismissal was harsh, unjust or unreasonable; and (c) the dismissal was not consistent with the Small Business Fair Dismissal Code; and (d) the dismissal was not a case of genuine redundancy. Note: For the definition of consistent with the Small Business Fair Dismissal Code: see section 388." ;
    skos:definition "A person has been unfairly dismissed if the FWC is satisfied that: (a) the person has been dismissed; and (b) the dismissal was harsh, unjust or unreasonable; and (c) the dismissal was not consistent with the Small Business Fair Dismissal Code; and (d) the dismissal was not a case of genuine redundancy. Note: For the definition of consistent with the Small Business Fair Dismissal Code: see section 388."@en ;
    cml:integrityHash "90433e2545f5ddb408730737ddec54aaa19db7ee3fc9719e4096338960aa28de" ;
    cof:pageNumber "197"^^xsd:integer ;
    skos:note "A person has been unfairly dismissed if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.197" ;
    cml:asserts concept:fair-work-act-2009-sec-385-norm .
