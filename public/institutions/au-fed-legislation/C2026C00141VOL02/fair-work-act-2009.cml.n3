concept:fair-work-act-2009-sec-306 a cml:Concept ;
    skos:prefLabel "306 Inconsistency with modern awards, enterprise agreements and"@en ;
    cml:realizedBy doc:sec-306 ;
    values:originalText "orders of the FWC A term of a modern award, an enterprise agreement or an FWC order has no effect in relation to an employee to the extent that it is less beneficial to the employee than a term of an equal remuneration order that applies to the employee.  Chapter 2  Terms and conditions of employment" ;
    skos:definition "orders of the FWC A term of a modern award, an enterprise agreement or an FWC order has no effect in relation to an employee to the extent that it is less beneficial to the employee than a term of an equal remuneration order that applies to the employee.  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "093fc5eb2c97247f04c5b5248a336ffae54d82d841488e832384ab002fbfe892" ;
    cof:pageNumber "67"^^xsd:integer ;
    skos:note "Employee's remuneration is not affected by inconsistent terms from modern awards, enterprise agreements or FWC orders." ;
