doc:sec-515-ss-2 a cof:Section ;
    cof:title "515(2) Conditions on entry permit" ;
    values:kind "subsection" ;
    values:originalText "(2) In deciding whether to impose conditions under subsection (1), the FWC must take into account the permit qualification matters." ;
