concept:fair-work-act-2009-sec-306t a cml:Concept ;
    skos:prefLabel "306T Short-term arrangements—engaging other employees"@en ;
    cml:realizedBy doc:sec-306t ;
    values:originalText "An employer covered by a regulated labour hire arrangement order contravenes this section if: (a) the employer is not required to pay a regulated employee at a rate determined under or in accordance with this Part because of the operation of subsection 306G(2) (including as it applies because of subsection 306M(9) or 306Q(8)); and (b) the employer engages another person to perform the same, or substantially the same, work as that performed by the employee for the regulated host; and  Chapter 2  Terms and conditions of employment" ;
    skos:definition "An employer covered by a regulated labour hire arrangement order contravenes this section if: (a) the employer is not required to pay a regulated employee at a rate determined under or in accordance with this Part because of the operation of subsection 306G(2) (including as it applies because of subsection 306M(9) or 306Q(8)); and (b) the employer engages another person to perform the same, or substantially the same, work as that performed by the employee for the regulated host; and  Chapter 2  Terms and conditions of employment"@en ;
    cml:integrityHash "7456c852014fb7a1ac4bd1f35bbce8ebc8e17cc957f82a2582c9d64d537449d1" ;
    cof:pageNumber "103"^^xsd:integer ;
    skos:note "Employer must pay regulated employee at a rate determined under or in accordance with this Part." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.103" ;
    cml:asserts concept:fair-work-act-2009-sec-306t-norm .
