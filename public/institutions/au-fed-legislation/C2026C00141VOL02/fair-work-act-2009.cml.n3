concept:fair-work-act-2009-sec-333k a cml:Concept ;
    skos:prefLabel "333K Giving new employees the Fixed Term Contract Information"@en ;
    cml:realizedBy doc:sec-333k ;
    values:originalText "Statement If a person enters into a contract of employment that includes a term that provides the contract will terminate at the end of an identifiable period (whether or not the contract also includes other terms that provide for circumstances in which it may be terminated before the end of that period), the person must, before, or as soon as practicable after, the contract is entered into, give the employee the Fixed Term Contract Information Statement. Note: This subsection is a civil remedy provision (see Part 4-1)." ;
    skos:definition "Statement If a person enters into a contract of employment that includes a term that provides the contract will terminate at the end of an identifiable period (whether or not the contract also includes other terms that provide for circumstances in which it may be terminated before the end of that period), the person must, before, or as soon as practicable after, the contract is entered into, give the employee the Fixed Term Contract Information Statement. Note: This subsection is a civil remedy provision (see Part 4-1)."@en ;
    cml:integrityHash "33a44f249bf6e98fe5e1faaa050022cbf5f3786a277ef47b951e7432d631f877" ;
    cof:pageNumber "146"^^xsd:integer ;
    skos:note "Employee must provide Fixed Term Contract Information Statement before or as soon as the contract is entered into." ;
    dc:description "true" ;
