concept:fair-work-act-2009-sec-536nk a cml:Concept ;
    skos:prefLabel "536NK Contravening orders under this Part"@en ;
    cml:realizedBy doc:sec-536nk ;
    values:originalText "A person must not contravene an order under this Part. Note: This section is a civil remedy provision (see Part 4-1)." ;
