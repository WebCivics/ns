concept:fair-work-act-2009-sec-416 a cml:Concept ;
    skos:prefLabel "416 Employer response action—employer may refuse to make"@en ;
    cml:realizedBy doc:sec-416 ;
    values:originalText "payments to employees If an employer engages in employer response action against employees, the employer may refuse to make payments to the employees in relation to the period of the action. Note: If an employee engages in protected industrial action against his or her employer, the employer must not make a payment to an employee in relation to certain periods of action (see Subdivision A of Division 9 of this Part)." ;
    skos:definition "payments to employees If an employer engages in employer response action against employees, the employer may refuse to make payments to the employees in relation to the period of the action. Note: If an employee engages in protected industrial action against his or her employer, the employer must not make a payment to an employee in relation to certain periods of action (see Subdivision A of Division 9 of this Part)."@en ;
    cml:integrityHash "47cc9117eb23e02355993000eb4d48c80a99ea2634c0fe1f5bd46acef61ee455" ;
    cof:pageNumber "220"^^xsd:integer ;
    skos:note "Employer may refuse to make payments to employees in relation to the period of action." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
