    cml:logicSummary "Prohibits failure to pay certain amounts as required." ;
    cml:premiseText "(2) For the purposes of paragraph (1)(b), an amount is covered by this subsection if:" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
