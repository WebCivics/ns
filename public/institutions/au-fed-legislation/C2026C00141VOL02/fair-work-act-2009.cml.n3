concept:fair-work-act-2009-sec-333q a cml:Concept ;
    skos:prefLabel "333Q Contravening an order"@en ;
    cml:realizedBy doc:sec-333q ;
    values:originalText "A person to whom an order under section 333P applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1)." ;
    skos:definition "A person to whom an order under section 333P applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1)."@en ;
