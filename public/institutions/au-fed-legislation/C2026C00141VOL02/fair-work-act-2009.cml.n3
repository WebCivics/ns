concept:fair-work-act-2009-sec-375 a cml:Concept ;
    skos:prefLabel "375 Advice on general protections court application"@en ;
    cml:realizedBy doc:sec-375 ;
    values:originalText "If the FWC considers, taking into account all the materials before it, that a general protections court application in relation to the dispute would not have a reasonable prospect of success, it must advise the parties accordingly.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "If the FWC considers, taking into account all the materials before it, that a general protections court application in relation to the dispute would not have a reasonable prospect of success, it must advise the parties accordingly.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "5d72d981e78219a59019ff125d0b519f9db76f35f5801a730b278b593848a545" ;
    cof:pageNumber "189"^^xsd:integer ;
