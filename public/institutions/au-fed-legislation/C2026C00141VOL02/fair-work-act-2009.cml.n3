concept:fair-work-act-2009-sec-397 a cml:Concept ;
    skos:prefLabel "397 Matters involving contested facts"@en ;
    cml:realizedBy doc:sec-397 ;
    values:originalText "The FWC must conduct a conference or hold a hearing in relation to a matter arising under this Part if, and to the extent that, the matter involves facts the existence of which is in dispute." ;
    skos:definition "The FWC must conduct a conference or hold a hearing in relation to a matter arising under this Part if, and to the extent that, the matter involves facts the existence of which is in dispute."@en ;
    cml:integrityHash "829537ca162c114449a7dd76c2bd62a6e59866663b37763996d0c4f151da3751" ;
    cof:pageNumber "205"^^xsd:integer ;
    skos:note "Conduct conference or hold hearing on disputed facts" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
