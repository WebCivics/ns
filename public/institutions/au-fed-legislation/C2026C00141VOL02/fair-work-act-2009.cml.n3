concept:fair-work-act-2009-sec-453 a cml:Concept ;
    skos:prefLabel "453 Who is eligible to be included on the roll of voters"@en ;
    cml:realizedBy doc:sec-453 ;
    values:originalText "An employee is eligible to be included on the roll of voters for the protected action ballot only if: (a) the employee will be covered by the proposed enterprise agreement to which the ballot relates; and  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "An employee is eligible to be included on the roll of voters for the protected action ballot only if: (a) the employee will be covered by the proposed enterprise agreement to which the ballot relates; and  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "d82e9df26184b37e53e7cf0f3d04eabba468764d56cac746e7d8cb61674908e0" ;
    cof:pageNumber "251"^^xsd:integer ;
    skos:note "Eligibility for voter roll based on proposed enterprise agreement" ;
