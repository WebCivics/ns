concept:fair-work-act-2009-sec-521 a cml:Concept ;
    skos:prefLabel "521 Regulations dealing with instruments under this Part"@en ;
    cml:realizedBy doc:sec-521 ;
    values:originalText "The regulations may provide for, and in relation to, the following: (a) the form of entry permits, entry notices, exemption certificates and affected member certificates; (b) additional information to be included on, or given with, entry permits, entry notices, exemption certificates and affected member certificates; (c) the manner in which entry permits, entry notices, exemption certificates and affected member certificates are to be given; (d) any other matter in relation to entry permits, entry notices, exemption certificates and affected member certificates.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Right of entry  Part 3-4 Accommodation and transport arrangements in remote areas  Division 7 Section 521A Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "The regulations may provide for, and in relation to, the following: (a) the form of entry permits, entry notices, exemption certificates and affected member certificates; (b) additional information to be included on, or given with, entry permits, entry notices, exemption certificates and affected member certificates; (c) the manner in which entry permits, entry notices, exemption certificates and affected member certificates are to be given; (d) any other matter in relation to entry permits, entry notices, exemption certificates and affected member certificates.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Right of entry  Part 3-4 Accommodation and transport arrangements in remote areas  Division 7 Section 521A Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "5a0a219d05ffb2637a06ff892d47c991156689e1c74aa78349a7e5627daf3af5" ;
    cof:pageNumber "314"^^xsd:integer ;
