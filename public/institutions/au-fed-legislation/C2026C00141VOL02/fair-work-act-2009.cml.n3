    cml:modality cml:Argumentation ;
    cml:operator "Implicates" ;
    cml:logicSummary "Implicates the need for a stop order in cases of alleged contravention." ;
    cml:premiseText "Applications may be made to the FWC to deal with a dispute about an alleged contravention of this Part..." ;
    cml:conclusionText "A stop order is implied in cases of alleged contravention." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-527a cml:asserts concept:fair-work-act-2009-sec-527a-logic-cogai-5 .
concept:fair-work-act-2009-sec-527a-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "Recognizes the need for a court hearing in cases where a dispute has not been resolved by the FWC." ;
    cml:premiseText "In most cases, a dispute about an alleged contravention of this Part will be dealt with by a court only if the dispute has not been resolved by the FWC." ;
    cml:conclusionText "A court hearing is recognized in cases where a dispute has not been resolved." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-527a a cof:Section ;
    cof:title "527A Guide to this Part" ;
    values:kind "section" ;
    values:originalText "This Part makes it unlawful for a person to sexually harass another person, where: (a) the other person is a worker in a business or undertaking, seeking to become a worker in a particular business or undertaking, or conducting a business or undertaking; and (b) the harassment occurs in connection with the other person being a person of the relevant kind. Persons may be liable for acts contravening this Part that are performed by their employees or agents. Applications may be made to the FWC to deal with a dispute about an alleged contravention of this Part, including by making a stop sexual harassment order. In most cases, a dispute about an alleged contravention of this Part will be dealt with by a court only if the dispute has not been resolved by the FWC." ;
    cof:pageNumber "323"^^xsd:integer .

