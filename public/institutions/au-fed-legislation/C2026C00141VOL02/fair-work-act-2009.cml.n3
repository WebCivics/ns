concept:fair-work-act-2009-sec-317 a cml:Concept ;
    skos:prefLabel "317 FWC may make orders in relation to a transfer of business"@en ;
    cml:realizedBy doc:sec-317 ;
    values:originalText "This Division provides for the FWC to make certain orders if there is, or is likely to be, a transfer of business from an old employer to a new employer." ;
    skos:definition "This Division provides for the FWC to make certain orders if there is, or is likely to be, a transfer of business from an old employer to a new employer."@en ;
    cml:integrityHash "09ab06bf7a389942643fde40c4e7f29322cc77cee4a14af2cf69811fd4fad92a" ;
