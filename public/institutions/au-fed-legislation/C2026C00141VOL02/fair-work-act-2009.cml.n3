concept:fair-work-act-2009-sec-437-ss-2a a cml:Concept ;
    skos:prefLabel "437(2A) Application for a protected action ballot order"@en ;
    cml:realizedBy doc:sec-437-ss-2a ;
    values:originalText "(2A) Subsection (1) does not apply unless there has been a notification time in relation to the proposed enterprise agreement. Note: For notification time, see subsection 173(2). Protected industrial action cannot be taken until after bargaining has commenced (including where the scope of the proposed enterprise agreement is the only matter in dispute). Matters to be specified in application" ;
    skos:definition "(2A) Subsection (1) does not apply unless there has been a notification time in relation to the proposed enterprise agreement. Note: For notification time, see subsection 173(2). Protected industrial action cannot be taken until after bargaining has commenced (including where the scope of the proposed enterprise agreement is the only matter in dispute). Matters to be specified in application"@en ;
    cml:integrityHash "4ccf2fb646b8b38d633d652deb30d842b04ee7a173aa34d388ec465c31979ba8" ;
    values:partOf concept:fair-work-act-2009-sec-437 ;
    cof:pageNumber "240"^^xsd:integer ;
    skos:note "Notification time must be specified in application for protected industrial action." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
