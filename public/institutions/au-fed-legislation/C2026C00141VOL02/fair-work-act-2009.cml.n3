doc:sec-374-ss-1 a cof:Section ;
    cof:title "374(1) Conferences" ;
    values:kind "subsection" ;
    values:originalText "(1) If: (a) an application is made under section 372; and (b) the parties to the dispute agree to participate; the FWC must conduct a conference to deal with the dispute. Note 1: For conferences, see section 592. Note 2: The FWC may deal with a dispute by mediation or conciliation, or by making a recommendation or expressing an opinion (see subsection 595(2))." ;
    cof:pageNumber "189"^^xsd:integer .

concept:fair-work-act-2009-sec-374-ss-2 a cml:Concept ;
    skos:prefLabel "374(2) Conferences"@en ;
    cml:realizedBy doc:sec-374-ss-2 ;
    values:originalText "(2) Despite subsection 592(3), the FWC must conduct the conference in private." ;
    skos:definition "(2) Despite subsection 592(3), the FWC must conduct the conference in private."@en ;
    cml:integrityHash "f61b7004d94c97df9678a119feee09930a6845d2a7b6a030c6fa1f8c28a86ed6" ;
    values:partOf concept:fair-work-act-2009-sec-374 ;
