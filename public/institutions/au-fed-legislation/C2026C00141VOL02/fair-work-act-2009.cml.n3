    cof:pageNumber "182"^^xsd:integer .

concept:fair-work-act-2009-sec-361 a cml:Concept ;
    skos:prefLabel "361 Reason for action to be presumed unless proved otherwise"@en ;
    cml:realizedBy doc:sec-361 ;
    values:originalText "(1) If: (a) in an application in relation to a contravention of this Part, it is alleged that a person took, or is taking, action for a particular reason or with a particular intent; and (b) taking that action for that reason or with that intent would constitute a contravention of this Part; it is presumed that the action was, or is being, taken for that reason or with that intent, unless the person proves otherwise. (2) Subsection (1) does not apply in relation to orders for an interim injunction." ;
    skos:definition "(1) If: (a) in an application in relation to a contravention of this Part, it is alleged that a person took, or is taking, action for a particular reason or with a particular intent; and (b) taking that action for that reason or with that intent would constitute a contravention of this Part; it is presumed that the action was, or is being, taken for that reason or with that intent, unless the person proves otherwise. (2) Subsection (1) does not apply in relation to orders for an interim injunction."@en ;
    cml:integrityHash "1a54cba976c689698398e9452b8cd457f753bce2e859f98a3f9518ff29f6b280" ;
    cof:pageNumber "182"^^xsd:integer ;
    cml:hasPart concept:fair-work-act-2009-sec-361-ss-1 ;
    cml:hasPart concept:fair-work-act-2009-sec-361-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.182" .
doc:sec-361 a cof:Section ;
    cof:title "361 Reason for action to be presumed unless proved otherwise" ;
    values:kind "section" ;
    values:originalText "(1) If: (a) in an application in relation to a contravention of this Part, it is alleged that a person took, or is taking, action for a particular reason or with a particular intent; and (b) taking that action for that reason or with that intent would constitute a contravention of this Part; it is presumed that the action was, or is being, taken for that reason or with that intent, unless the person proves otherwise. (2) Subsection (1) does not apply in relation to orders for an interim injunction." ;
    cof:pageNumber "182"^^xsd:integer .

