    cml:logicSummary "Prohibits industrial action during a period when a bargaining representative is engaging in pattern bargaining." ;
    cml:premiseText "(2) The court is satisfied that..." ;
    cml:conclusionText "...a bargaining representative of an employee who will be covered by the agreement is engaging in pattern bargaining..." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-422-ss-2 cml:asserts concept:fair-work-act-2009-sec-422-ss-2-logic-diffusion-4 .
concept:fair-work-act-2009-sec-422-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits industrial action if a bargaining representative is engaging in pattern bargaining." ;
    cml:premiseText "(2) The court is satisfied that..." ;
