    cml:conclusionText "The amount of high income threshold worked out in that manner would be less than it was on the last occasion." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

