doc:sec-511 a cof:Section ;
    cof:title "511 General rules for suspending entry permits" ;
    values:kind "section" ;
    values:originalText "If the FWC suspends an entry permit, the suspension: (a) must be for a specified period; and (b) does not prevent the revocation of, or the imposition of conditions on, the entry permit during the suspension period; and (c) does not alter the time at which the entry permit would otherwise expire.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Right of entry  Part 3-4 Entry permits, entry notices and certificates  Division 6 Section 512 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    cof:pageNumber "306"^^xsd:integer .

concept:fair-work-act-2009-sec-512 a cml:Concept ;
    skos:prefLabel "512 FWC may issue entry permits"@en ;
    cml:realizedBy doc:sec-512 ;
    values:originalText "The FWC may, on application by an organisation, issue a permit (an entry permit) to an official of the organisation if the FWC is satisfied that the official is a fit and proper person to hold the entry permit." ;
    skos:definition "The FWC may, on application by an organisation, issue a permit (an entry permit) to an official of the organisation if the FWC is satisfied that the official is a fit and proper person to hold the entry permit."@en ;
    cml:integrityHash "d0110518e070e44cf699a91d908af53be071eb2329dc7d3abf3b3f5c26a72a96" ;
    cof:pageNumber "307"^^xsd:integer ;
    skos:note "FWC may issue entry permits to officials of organisations that meet certain criteria." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.307" ;
    cml:asserts concept:fair-work-act-2009-sec-512-norm .
