doc:sec-489 a cof:Section ;
    cof:title "489 Producing authority documents" ;
    values:kind "section" ;
    values:originalText "(1) If the permit holder has entered premises under Subdivision A or AA, the permit holder must produce his or her authority documents for inspection by the occupier of the premises, or an affected employer: (a) on request; and (b) before making a requirement under: (i) paragraph 482(1)(c) or 483B(1)(c), or subsection 483D(2); or (ii) subsection 483(1), 483C(1) or 483E(1). Note: Paragraphs 482(1)(c) and 483B(1)(c) and subsection 483D(2) deal with access to records and documents while the permit holder is on the premises. Subsections 483(1), 483C(1) and 483E(1) deal with access to records and documents at later times.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    cof:pageNumber "289"^^xsd:integer .

concept:fair-work-act-2009-sec-491 a cml:Concept ;
    skos:prefLabel "491 Occupational health and safety requirements"@en ;
    cml:realizedBy doc:sec-491 ;
    values:originalText "The permit holder must comply with any reasonable request by the occupier of the premises for the permit holder to comply with an occupational health and safety requirement that applies to the premises. Note: The FWC may deal with a dispute about whether the request is reasonable (see subsection 505(1))." ;
    skos:definition "The permit holder must comply with any reasonable request by the occupier of the premises for the permit holder to comply with an occupational health and safety requirement that applies to the premises. Note: The FWC may deal with a dispute about whether the request is reasonable (see subsection 505(1))."@en ;
    cml:integrityHash "2cd53f701e68f4ae121f00e38ad16f04af86a1564b8cc5501c801414f7e3364e" ;
    cof:pageNumber "290"^^xsd:integer ;
    skos:note "Comply with reasonable requests for occupational health and safety requirements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
