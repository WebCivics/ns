concept:fair-work-act-2009-sec-306p-ss-4 a cml:Concept ;
    skos:prefLabel "306P(4) Disputes about the operation of this Part"@en ;
    cml:realizedBy doc:sec-306p-ss-4 ;
    values:originalText "(4) If discussions at the workplace level do not resolve the dispute, a party to the dispute may apply to the FWC to resolve the dispute. How the FWC deals with dispute" ;
    skos:definition "(4) If discussions at the workplace level do not resolve the dispute, a party to the dispute may apply to the FWC to resolve the dispute. How the FWC deals with dispute"@en ;
    cml:integrityHash "a24545c2adc9049c19ef8231646d9a89f31817ec78b2e5c23685c0b7b9edd09a" ;
    values:partOf concept:fair-work-act-2009-sec-306p ;
    cof:pageNumber "98"^^xsd:integer ;
    skos:note "Party must apply to FWC for dispute resolution if discussions at workplace level fail." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
