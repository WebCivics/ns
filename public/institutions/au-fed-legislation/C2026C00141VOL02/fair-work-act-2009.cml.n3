doc:sec-407 a cof:Section ;
    cof:title "407 Meanings of employee and employer" ;
    values:kind "section" ;
    values:originalText "In this Part, employee means a national system employee, and employer means a national system employer. Note: See also Division 2 of Part 6-4A (TCF contract outworkers taken to be employees in certain circumstances).  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    cof:pageNumber "211"^^xsd:integer .

concept:fair-work-act-2009-sec-408 a cml:Concept ;
    skos:prefLabel "408 Protected industrial action"@en ;
    cml:realizedBy doc:sec-408 ;
    values:originalText "Industrial action is protected industrial action for a proposed enterprise agreement if it is one of the following: (a) employee claim action for the agreement (see section 409); (b) employee response action for the agreement (see section 410); (c) employer response action for the agreement (see section 411)." ;
    skos:definition "Industrial action is protected industrial action for a proposed enterprise agreement if it is one of the following: (a) employee claim action for the agreement (see section 409); (b) employee response action for the agreement (see section 410); (c) employer response action for the agreement (see section 411)."@en ;
    cml:integrityHash "9ae53ad8007ece3389d0998544b977591f0dbba7100303c08d6b0dbb72dac3bd" ;
    cof:pageNumber "212"^^xsd:integer ;
    skos:note "Industrial action is protected under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.212" ;
