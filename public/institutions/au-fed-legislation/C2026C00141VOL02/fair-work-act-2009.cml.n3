concept:fair-work-act-2009-sec-536nc a cml:Concept ;
    skos:prefLabel "536NC Remedy—order to set aside etc. contract"@en ;
    cml:realizedBy doc:sec-536nc ;
    values:originalText "The FWC may make an order under this section: (a) setting aside all or part of a services contract which, in an employment relationship, would relate to a workplace relations matter; or (b) amending or varying all or part of a services contract which, in an employment relationship, would relate to a workplace relations matter.  Minimum standards for regulated workers  Chapter 3A Unfair contract terms of services contracts  Part 3A-5 Procedural matters  Division 4 Section 536ND Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "The FWC may make an order under this section: (a) setting aside all or part of a services contract which, in an employment relationship, would relate to a workplace relations matter; or (b) amending or varying all or part of a services contract which, in an employment relationship, would relate to a workplace relations matter.  Minimum standards for regulated workers  Chapter 3A Unfair contract terms of services contracts  Part 3A-5 Procedural matters  Division 4 Section 536ND Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "b98e0c4a22cdd90537c2fac047499cd6a51f7d2243aa1b8243e0842552398e55" ;
    cof:pageNumber "462"^^xsd:integer ;
    skos:note "The FWC may make an order under this section setting aside or amending a services contract related to workplace relations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.462" ;
