concept:fair-work-act-2009-sec-527g a cml:Concept ;
    skos:prefLabel "527G Time for application"@en ;
    cml:realizedBy doc:sec-527g ;
    values:originalText "The FWC may dismiss an application that is made under section 527F more than 24 months after the contravention, or the  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "The FWC may dismiss an application that is made under section 527F more than 24 months after the contravention, or the  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
