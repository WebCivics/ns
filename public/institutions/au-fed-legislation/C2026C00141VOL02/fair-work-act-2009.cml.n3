concept:fair-work-act-2009-sec-331 a cml:Concept ;
    skos:prefLabel "331 Guaranteed period"@en ;
    cml:realizedBy doc:sec-331 ;
    values:originalText "The guaranteed period for a guarantee of annual earnings is the period that: (a) starts at the start of the period of the undertaking that is the guarantee of annual earnings; and (b) ends at the earliest of the following: (i) the end of that period; (ii) an enterprise agreement starting to apply to the employment of the employee; (iii) the employer revoking the guarantee of annual earnings with the employee’s agreement." ;
    skos:definition "The guaranteed period for a guarantee of annual earnings is the period that: (a) starts at the start of the period of the undertaking that is the guarantee of annual earnings; and (b) ends at the earliest of the following: (i) the end of that period; (ii) an enterprise agreement starting to apply to the employment of the employee; (iii) the employer revoking the guarantee of annual earnings with the employee’s agreement."@en ;
    cml:integrityHash "d85d80bd5f533cc5a92fc46eabe327856ecc41577dea5d49d0e1636fe69b7dfb" ;
    cof:pageNumber "136"^^xsd:integer ;
    skos:note "Defines the guaranteed period for a guarantee of annual earnings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.136" ;
