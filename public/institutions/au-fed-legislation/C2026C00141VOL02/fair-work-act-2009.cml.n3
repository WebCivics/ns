concept:fair-work-act-2009-sec-305 a cml:Concept ;
    skos:prefLabel "305 Contravening an equal remuneration order"@en ;
    cml:realizedBy doc:sec-305 ;
    values:originalText "An employer must not contravene a term of an equal remuneration order. Note: This section is a civil remedy provision (see Part 4-1)." ;
