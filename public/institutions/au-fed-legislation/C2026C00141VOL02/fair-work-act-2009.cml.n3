concept:fair-work-act-2009-sec-333p-ss-1 cml:asserts concept:fair-work-act-2009-sec-333p-ss-1-logic-deontic-3 .
concept:fair-work-act-2009-sec-333p-ss-1-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST_NOT" ;
    cml:logicSummary "Prohibition on disciplinary action or continued requirement" ;
    cml:premiseText "The employer cannot take disciplinary action or continue to require the employee to monitor contact if the employee has refused." ;
    cml:conclusionText "The employer must not take disciplinary action or continue to require the employee to monitor contact if the employee has refused." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-333p-ss-1 cml:asserts concept:fair-work-act-2009-sec-333p-ss-1-logic-linearlogic-4 .
concept:fair-work-act-2009-sec-333p-ss-1-logic-linearlogic-4 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "=>" ;
    cml:logicSummary "Conditional order based on risk of disciplinary action or continued requirement" ;
    cml:premiseText "The FWC may make an order if there is a risk that the employer will take disciplinary action or continue to require the employee to monitor contact." ;
    cml:conclusionText "If there is a risk that the employer will take disciplinary action or continue to require the employee to monitor contact, then the FWC must make an order." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

