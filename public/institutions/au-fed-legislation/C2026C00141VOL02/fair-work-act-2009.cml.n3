    cml:logicSummary "Employer is responsible for ensuring employees comply with terms and conditions of employment." ;
    cml:premiseText "employee means a national system employee, and employer means a national system employer." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-259 cml:asserts concept:fair-work-act-2009-sec-259-logic-alleninterval-3 .
