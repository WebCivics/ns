concept:fair-work-act-2009-sec-293 a cml:Concept ;
    skos:prefLabel "293 Contravening a national minimum wage order"@en ;
    cml:realizedBy doc:sec-293 ;
    values:originalText "An employer must not contravene a term of a national minimum wage order. Note: This section is a civil remedy provision (see Part 4-1)." ;
