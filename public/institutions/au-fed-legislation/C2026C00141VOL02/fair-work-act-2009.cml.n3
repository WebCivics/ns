concept:fair-work-act-2009-sec-335 a cml:Concept ;
    skos:prefLabel "335 Meanings of employee and employer"@en ;
    cml:realizedBy doc:sec-335 ;
    values:originalText "In this Part, employee and employer have their ordinary meanings. Note: See also Division 2 of Part 6-4A (TCF contract outworkers taken to be employees in certain circumstances)." ;
