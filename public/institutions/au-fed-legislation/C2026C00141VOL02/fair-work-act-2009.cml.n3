concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-alleninterval-4 .
concept:fair-work-act-2009-sec-536lg-logic-alleninterval-4 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "⊆" ;
    cml:logicSummary "Describes the temporal interval during which the person was deactivated" ;
    cml:premiseText "A person has been deactivated from a digital labour platform if: (a) the person performed digital platform work through or by means of the digital labour platform; and (b) the digital labour platform operator modified, suspended, or terminated the person’s access to the digital labour platform; and (c) the person is no longer able to perform work under an existing or prospective services contract, or the ability of the person to do so is so significantly altered that in effect the person is no longer able to perform such work." ;
    cml:conclusionText "The period during which the person was deactivated" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-ltl-5 .
concept:fair-work-act-2009-sec-536lg-logic-ltl-5 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "<" ;
    cml:logicSummary "Describes the temporal relationship between the conditions and the consequence of being deactivated" ;
    cml:premiseText "A person has been deactivated from a digital labour platform if: (a) the person performed digital platform work through or by means of the digital labour platform; and (b) the digital labour platform operator modified, suspended, or terminated the person’s access to the digital labour platform; and (c) the person is no longer able to perform work under an existing or prospective services contract, or the ability of the person to do so is so significantly altered that in effect the person is no longer able to perform such work." ;
    cml:conclusionText "The conditions imply that the person was deactivated" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-536lg cml:asserts concept:fair-work-act-2009-sec-536lg-logic-deontic-6 .
