doc:sec-368-ss-1 a cof:Section ;
    cof:title "368(1) Dealing with a dismissal dispute (other than by arbitration)" ;
    values:kind "subsection" ;
    values:originalText "(1) If an application is made under section 365, the FWC must deal with the dispute (other than by arbitration). Note: The FWC may deal with a dispute by mediation or conciliation, or by making a recommendation or expressing an opinion (see subsection 595(2)). One of the recommendations that the FWC might make is that an application be made under Part 3-2 (which deals with unfair dismissal) in relation to the dispute." ;
    cof:pageNumber "186"^^xsd:integer .

concept:fair-work-act-2009-sec-368-ss-2 a cml:Concept ;
    skos:prefLabel "368(2) Dealing with a dismissal dispute (other than by arbitration)"@en ;
    cml:realizedBy doc:sec-368-ss-2 ;
    values:originalText "(2) Any conference conducted for the purposes of dealing with the dispute (other than by arbitration) must be conducted in private, despite subsection 592(3). Note: For conferences, see section 592." ;
    skos:definition "(2) Any conference conducted for the purposes of dealing with the dispute (other than by arbitration) must be conducted in private, despite subsection 592(3). Note: For conferences, see section 592."@en ;
