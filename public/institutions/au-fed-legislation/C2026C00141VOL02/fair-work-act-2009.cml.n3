doc:sec-509-ss-2 a cof:Section ;
    cof:title "509(2) Contravening order made for misuse of rights" ;
    values:kind "subsection" ;
    values:originalText "(2) Despite subsection (1), the FWC is not required to suspend or revoke an entry permit under paragraph (1)(d) or (f) if the FWC is satisfied that the suspension or revocation would be harsh or unreasonable in the circumstances." ;
    cof:pageNumber "304"^^xsd:integer .

concept:fair-work-act-2009-sec-509-ss-3 a cml:Concept ;
    skos:prefLabel "509(3) Contravening order made for misuse of rights"@en ;
    cml:realizedBy doc:sec-509-ss-3 ;
    values:originalText "(3) Subsection (1) does not apply in relation to a circumstance referred to in a paragraph of that subsection if the FWC took the circumstance into account when taking action under that subsection on a previous occasion.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "(3) Subsection (1) does not apply in relation to a circumstance referred to in a paragraph of that subsection if the FWC took the circumstance into account when taking action under that subsection on a previous occasion.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "91ee7c5d26f83c50c7aba216a0316ffb5513234617d5d196d288e5f18e5b0589" ;
    values:partOf concept:fair-work-act-2009-sec-509 ;
    cof:pageNumber "304"^^xsd:integer ;
    skos:note "Exempts FWC from applying subsection (1) in certain circumstances if taken into account previously." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.304" ;
