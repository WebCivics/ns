concept:fair-work-act-2009-sec-536lk a cml:Concept ;
    skos:prefLabel "536LK What is an unfair termination"@en ;
    cml:realizedBy doc:sec-536lk ;
    values:originalText "A person has been unfairly terminated if: (a) the person was performing work in the road transport industry; and (b) the person has been terminated; and (c) the termination was unfair; and (d) the termination was not consistent with the Road Transport Industry Termination Code." ;
    skos:definition "A person has been unfairly terminated if: (a) the person was performing work in the road transport industry; and (b) the person has been terminated; and (c) the termination was unfair; and (d) the termination was not consistent with the Road Transport Industry Termination Code."@en ;
    cml:integrityHash "b283d71f781068ee288a32ffc66fa1ff56fb53d19278a56600b6b0320e69d2fa" ;
    cof:pageNumber "430"^^xsd:integer ;
    skos:note "Termination is unfair if it does not comply with the Road Transport Industry Termination Code." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.430" ;
    cml:asserts concept:fair-work-act-2009-sec-536lk-norm .
