concept:fair-work-act-2009-sec-511 a cml:Concept ;
    skos:prefLabel "511 General rules for suspending entry permits"@en ;
    cml:realizedBy doc:sec-511 ;
    values:originalText "If the FWC suspends an entry permit, the suspension: (a) must be for a specified period; and (b) does not prevent the revocation of, or the imposition of conditions on, the entry permit during the suspension period; and (c) does not alter the time at which the entry permit would otherwise expire.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Right of entry  Part 3-4 Entry permits, entry notices and certificates  Division 6 Section 512 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "If the FWC suspends an entry permit, the suspension: (a) must be for a specified period; and (b) does not prevent the revocation of, or the imposition of conditions on, the entry permit during the suspension period; and (c) does not alter the time at which the entry permit would otherwise expire.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Right of entry  Part 3-4 Entry permits, entry notices and certificates  Division 6 Section 512 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "f121a7db4eb191d8a5ad40008fc408d7ee196d6fef291b41ff5a0ad33c3ad15a" ;
    cof:pageNumber "306"^^xsd:integer ;
    skos:note "Suspension of entry permit must be for a specified period and does not prevent revocation or imposition of conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.306" ;
    cml:asserts concept:fair-work-act-2009-sec-511-norm .
