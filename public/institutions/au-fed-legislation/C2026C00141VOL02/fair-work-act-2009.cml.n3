concept:fair-work-act-2009-sec-522 a cml:Concept ;
    skos:prefLabel "522 Guide to this Part"@en ;
    cml:realizedBy doc:sec-522 ;
    values:originalText "This Part provides for a national system employer to stand down a national system employee without pay in certain circumstances. Division 2 sets out the circumstances in which an employer may stand down an employee without pay. Division 3 provides for the FWC to deal with disputes about the operation of this Part." ;
    skos:definition "This Part provides for a national system employer to stand down a national system employee without pay in certain circumstances. Division 2 sets out the circumstances in which an employer may stand down an employee without pay. Division 3 provides for the FWC to deal with disputes about the operation of this Part."@en ;
    cml:integrityHash "fa02df83a9e5b4f2ed86f9eeaeb121bbea01947e3bb94f02eb8043b6dedc848b" ;
    cof:pageNumber "319"^^xsd:integer ;
