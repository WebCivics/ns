    cof:pageNumber "433"^^xsd:integer .

concept:fair-work-act-2009-sec-536ls a cml:Concept ;
    skos:prefLabel "536LS Remedy—new contract, etc."@en ;
    cml:realizedBy doc:sec-536ls ;
    values:originalText "Reinstatement (1) An order for a new contract must be an order that the road transport business at the time of the termination enter into a new contract in the same terms as the services contract at the time of the termination or with such variations as the FWC considers appropriate. (2) If: (a) the road transport business at the time of the termination is no longer a road transport business; and (b) an associated entity of the road transport business is a road transport business;  Chapter 3A  Minimum standards for regulated workers" ;
    skos:definition "Reinstatement (1) An order for a new contract must be an order that the road transport business at the time of the termination enter into a new contract in the same terms as the services contract at the time of the termination or with such variations as the FWC considers appropriate. (2) If: (a) the road transport business at the time of the termination is no longer a road transport business; and (b) an associated entity of the road transport business is a road transport business;  Chapter 3A  Minimum standards for regulated workers"@en ;
    cml:integrityHash "de8e1f20edff0c507457d94ea6639df1ab3cf9bb5e91024934a7f8185fa35970" ;
    cof:pageNumber "435"^^xsd:integer ;
    cml:hasPart concept:fair-work-act-2009-sec-536ls-ss-1 ;
