concept:fair-work-act-2009-sec-416a a cml:Concept ;
    skos:prefLabel "416A Employer response action does not affect continuity of"@en ;
    cml:realizedBy doc:sec-416a ;
    values:originalText "employment Employer response action for a proposed enterprise agreement does not affect the continuity of employment of the employees who will be covered by the agreement, for such purposes as are prescribed by the regulations.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Industrial action  Part 3-3 No industrial action before nominal expiry date of enterprise agreement etc.  Division 3 Section 417 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "employment Employer response action for a proposed enterprise agreement does not affect the continuity of employment of the employees who will be covered by the agreement, for such purposes as are prescribed by the regulations.  Rights and responsibilities of employees, employers, organisations etc.  Chapter 3 Industrial action  Part 3-3 No industrial action before nominal expiry date of enterprise agreement etc.  Division 3 Section 417 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "a54e6890516d4678ab84bd80b91767ade238916d2e7254173a1aa645f579fd3d" ;
    cof:pageNumber "220"^^xsd:integer ;
