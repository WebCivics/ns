    cml:premiseText "Subsection (1) does not apply if..." ;
    cml:conclusionText "...the employer reasonably believed..." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-357-ss-2 a cof:Section ;
    cof:title "357(2) Misrepresenting employment as independent contracting" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply if the employer proves that, when the representation was made, the employer reasonably believed that the contract was a contract for services." ;
    cof:pageNumber "180"^^xsd:integer .

concept:fair-work-act-2009-sec-357-ss-3 a cml:Concept ;
    skos:prefLabel "357(3) Misrepresenting employment as independent contracting"@en ;
    cml:realizedBy doc:sec-357-ss-3 ;
    values:originalText "(3) In determining, for the purpose of subsection (2), whether the employer’s belief was reasonable: (a) regard must be had to the size and nature of the employer’s enterprise; and (b) regard may be had to any other relevant matters." ;
    skos:definition "(3) In determining, for the purpose of subsection (2), whether the employer’s belief was reasonable: (a) regard must be had to the size and nature of the employer’s enterprise; and (b) regard may be had to any other relevant matters."@en ;
