    cml:logicSummary "Imposes a duty on the affected employer" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-483-ss-1 a cof:Section ;
    cof:title "483(1) Later access to record or document" ;
    values:kind "subsection" ;
    values:originalText "(1) The permit holder may, by written notice, require an affected employer to produce, or provide access to, a record or document (other than a non-member record or document) that is directly relevant to the suspected contravention on a later day or days specified in the notice." ;
    cof:pageNumber "279"^^xsd:integer .

concept:fair-work-act-2009-sec-483-ss-1a a cml:Concept ;
    skos:prefLabel "483(1A) Later access to record or document"@en ;
    cml:realizedBy doc:sec-483-ss-1a ;
    values:originalText "(1A) However, an affected employer is not required under subsection (1) to produce, or provide access to, a record or document if to do so would contravene a law of the Commonwealth or a law of a State or Territory.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "(1A) However, an affected employer is not required under subsection (1) to produce, or provide access to, a record or document if to do so would contravene a law of the Commonwealth or a law of a State or Territory.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "c5bb8ead456b011d8a7748a5f5a0a7ffe49ed8299673b5158a2829ce668b408a" ;
    values:partOf concept:fair-work-act-2009-sec-483 ;
    cof:pageNumber "279"^^xsd:integer ;
    skos:note "Employer not required to produce or provide access to record or document if it would contravene a law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
