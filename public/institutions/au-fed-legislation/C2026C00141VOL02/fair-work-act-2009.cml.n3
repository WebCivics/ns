concept:fair-work-act-2009-sec-536lu a cml:Concept ;
    skos:prefLabel "536LU Application for unfair deactivation or unfair termination"@en ;
    cml:realizedBy doc:sec-536lu ;
    values:originalText "remedy (1) A person who has been deactivated or terminated may apply to the FWC for an order under Division 4 granting a remedy. Note 1: Division 4 sets out when the FWC may order a remedy for unfair deactivation or unfair termination. Note 2: For application fees, see section 536LV. Note 3:" ;
    skos:definition "remedy (1) A person who has been deactivated or terminated may apply to the FWC for an order under Division 4 granting a remedy. Note 1: Division 4 sets out when the FWC may order a remedy for unfair deactivation or unfair termination. Note 2: For application fees, see section 536LV. Note 3:"@en ;
    cml:integrityHash "6634a1af7c788b96e80605c314fff7a728abc4fae80515d7fe83d85581631aa9" ;
    cof:pageNumber "439"^^xsd:integer ;
    skos:note "Application for unfair deactivation or unfair termination" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.439" ;
