    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-525 cml:asserts concept:fair-work-act-2009-sec-525-logic-diffusion-4 .
concept:fair-work-act-2009-sec-525-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "The employee's absence diffuses to other employees who are also taking authorised leave." ;
    cml:premiseText "Employee is taking paid or unpaid leave that is authorised by the employer." ;
    cml:conclusionText "Other employees who are also taking authorised leave diffuse to the employee's absence." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

