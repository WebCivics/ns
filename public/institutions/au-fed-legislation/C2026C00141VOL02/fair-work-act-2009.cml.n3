concept:fair-work-act-2009-sec-536lf a cml:Concept ;
    skos:prefLabel "536LF What is an unfair deactivation"@en ;
    cml:realizedBy doc:sec-536lf ;
    values:originalText "A person has been unfairly deactivated if the FWC is satisfied that: (a) the person has been deactivated from a digital labour platform; and (b) the deactivation was unfair; and (c) the deactivation was not consistent with the Digital Labour Platform Deactivation Code." ;
    skos:definition "A person has been unfairly deactivated if the FWC is satisfied that: (a) the person has been deactivated from a digital labour platform; and (b) the deactivation was unfair; and (c) the deactivation was not consistent with the Digital Labour Platform Deactivation Code."@en ;
    cml:integrityHash "ecb8ae5298ffbdef6084800a64d7fee54ca1adb108b25e7273534da2c62729b0" ;
    cof:pageNumber "427"^^xsd:integer ;
    skos:note "A person has been unfairly deactivated if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
