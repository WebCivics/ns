concept:fair-work-act-2009-sec-483d a cml:Concept ;
    skos:prefLabel "483D Entry onto other premises to access records and documents"@en ;
    cml:realizedBy doc:sec-483d ;
    values:originalText "(1) A permit holder who may enter premises under paragraph 483A(1)(a) for the purpose of investigating a suspected contravention may enter other premises and exercise a right under subsection (2) or section 483E if the permit holder reasonably suspects that records or documents that are directly relevant to the suspected contravention: (a) are kept on the other premises; or (b) are accessible from a computer that is kept on the other premises.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc." ;
    skos:definition "(1) A permit holder who may enter premises under paragraph 483A(1)(a) for the purpose of investigating a suspected contravention may enter other premises and exercise a right under subsection (2) or section 483E if the permit holder reasonably suspects that records or documents that are directly relevant to the suspected contravention: (a) are kept on the other premises; or (b) are accessible from a computer that is kept on the other premises.  Chapter 3  Rights and responsibilities of employees, employers, organisations etc."@en ;
    cml:integrityHash "09087efedaa7b9cd119d6e8d616ac0b6a2867688db8ecbd228b04c6ba4a5721c" ;
    cof:pageNumber "285"^^xsd:integer ;
    skos:note "Permit holder has right to enter other premises for records and documents" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.285" ;
