  logic: Deontic;
  operator: Implies;
  summary: If A, then B.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (A) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person.;
  @action: (B) A collective agreement imposes obligations on a person unless the agreement applies to the person.;
}

fair-work-act-2009-sec-536jk-ss-1-logic-1301 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-536jk-ss-1;
  logic: AllenInterval;
  operator: Overlaps;
  summary: A and B overlap if there exists a time interval I such that A starts before I ends and I ends after B starts.;
  executionSurface: modalities::interval_reasoning;
  curationStatus: Proposed;
  @condition: (1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person.;
  @action: (2) The agreement applies to the person if and only if the person is subject to the agreement during some time interval I.;
}

fair-work-act-2009-sec-536jk-ss-1-logic-1302 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-536jk-ss-1;
  logic: LTL;
  operator: Until;
  summary: A holds until B if A starts before B ends.;
  executionSurface: modalities::temporal_ltl;
  curationStatus: Proposed;
  @condition: (1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person.;
  @action: (2) The agreement imposes obligations on a person only during some time interval I.;
}

fair-work-act-2009-sec-536jk-ss-1-logic-1303 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-536jk-ss-1;
  logic: Diffusion;
  operator: Diffuses;
  summary: A diffuses B if every instance of A is an instance of B.;
  executionSurface: modalities::diffusion;
  curationStatus: Proposed;
  @condition: (1) Collective agreement does not impose obligations on a person, and a person does not contravene a term of a collective agreement, unless the agreement applies to the person.;
  @action: (2) The agreement applies to all persons if and only if every person is subject to the agreement.;
}

