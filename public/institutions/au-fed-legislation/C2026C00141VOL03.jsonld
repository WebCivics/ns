        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9a437d5bcd8fd1901e0b8203eb6c27e5998106f761a73aef9040b3d3cf31260c",
      "cml:proposedBy": {
