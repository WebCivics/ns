    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the transfer of business occurs within 3 months after the termination",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Occurs during employment termination and new employment.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(a) the employment of a person who is a State public sector employee of the old State employer has terminated;"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "there is a transfer of business from a non-national system employer to a national system employer",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires specific conditions for transfer of business.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "(a) the employment of a person who is a State public sector employee of the old State employer has terminated;"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the transfer of business requires a connection between the old and new employers",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires connection between old and new employers.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "(d) there is a connection between the old State employer and the new employer as described in subsection (2), (3) or (4)."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the transfer of business occurs throughout the employment relationship",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Occurs everywhere in the employment relationship.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "(b) within 3 months after the termination, the person becomes employed by the new employer;"
    },
