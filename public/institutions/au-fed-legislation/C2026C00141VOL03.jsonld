      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if",
      "cml:premiseText": "(c) the work is to be performed indirectly: (i) for another person, being a Commonwealth outworker entity; and (ii) if that Commonwealth outworker entity is a constitutional corporation..."
    },
