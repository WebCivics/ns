      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The obligation to pay costs diffuses from the FWC to the first party.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
