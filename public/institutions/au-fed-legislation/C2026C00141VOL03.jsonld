    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-602a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the FWC does not have a duty to determine that the approval is as valid and effective, and is taken to have been as valid and effective, as it would have been if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The FWC has a duty to determine that the approval is as valid and effective, and is taken to have been as valid and effective, as it would have been if certain conditions were met.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": ">",
      "cml:premiseText": "the requirements set out in subsection 185(2) or section 185A had not been met in relation to the application"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-602a-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the FWC does not have a duty to determine that the approval is as valid and effective, and is taken to have been as valid and effective, as it would have been if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The FWC has a duty to determine that the approval is as valid and effective, and is taken to have been as valid and effective, as it would have been if certain conditions were met.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "<",
      "cml:premiseText": "the requirements set out in subsection 185(2) or section 185A had not been met in relation to the application"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-602a-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the FWC's determination is not valid after a certain period of time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The FWC's determination is only valid for a certain period of time.",
