    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-557a-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must take reasonable care to avoid recklessness.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to avoid reckless disregard",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "(a) the person is aware of a substantial risk that the contravention would occur; and (b) having regard to the circumstances known to the person, it is unjustifiable to take the risk."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-557a-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must exercise reasonable care to mitigate the risk.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to act with due diligence",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "(a) the person is aware of a substantial risk that the contravention would occur; and (b) having regard to the circumstances known to the person, it is unjustifiable to take the risk."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-557a-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must report their recklessness.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to report reckless disregard",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "(a) the person is aware of a substantial risk that the contravention would occur; and (b) having regard to the circumstances known to the person, it is unjustifiable to take the risk."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-557a-ss-2-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person knows they are taking an unjustifiable risk.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Knowledge of substantial risk implies reckless disregard",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "knowledge",
      "cml:premiseText": "(a) the person is aware of a substantial risk that the contravention would occur; and (b) having regard to the circumstances known to the person, it is unjustifiable to take the risk."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-557a-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "[Time interval during which recklessness applies]",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval of recklessness",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "interval",
      "cml:premiseText": "(a) the person is aware of a substantial risk that the contravention would occur; and (b) having regard to the circumstances known to the person, it is unjustifiable to take the risk."
