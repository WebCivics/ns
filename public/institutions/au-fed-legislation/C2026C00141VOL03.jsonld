      "cml:schemaVersion": "2",
      "partOf": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The responsible person is still liable for the unpaid amount.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section does not affect liability of responsible person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuation",
      "cml:premiseText": "This section does not affect the liability of the responsible person to pay the unpaid amount."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The section's effect on the indirectly responsible entity is limited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section's effect on indirectly responsible entity is limited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuation",
      "cml:premiseText": "Subject to subsection 789CE(1A), this section does not affect the liability of the responsible person to pay the unpaid amount."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The section cannot be used to exempt the indirectly responsible entity from liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section cannot be used to exempt indirectly responsible entities from liability.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "This section does not affect the liability of the responsible person to pay the unpaid amount."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The section allows for a limited exemption of the indirectly responsible entity from liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section allows for limited exemption of indirectly responsible entities from liability.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "Subject to subsection 789CE(1A), this section does not affect the liability of the responsible person to pay the unpaid amount."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The section creates a right in the responsible person to receive payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section creates a right in the responsible person to receive payment.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:premiseText": "This section does not affect the liability of the responsible person to pay the unpaid amount."
    },
