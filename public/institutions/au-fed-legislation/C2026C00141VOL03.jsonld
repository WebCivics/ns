      "cml:schemaVersion": "2",
      "partOf": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-794a"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-794a-ss-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct occurred during the time when the official had the established state of mind.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Establishes temporal relationship between conduct and state of mind",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(a) that the conduct was engaged in by an official of the government; and (b) that the official had that state of mind."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-794a-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Australian government is obligated to establish the state of mind of its officials in relation to particular conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Establishs obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "establishes",
      "cml:premiseText": "(a) that the conduct was engaged in by an official of the government; and (b) that the official had that state of mind."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-794a-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Australian government is obligated to determine penalty amounts based on its established state of mind.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Establishes obligation to determine penalty amounts",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "establishes",
      "cml:premiseText": "(4) If, for the purposes of this Act or the procedural rules, it is necessary to establish the state of mind of an Australian government in relation to particular conduct."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-794a-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Australian government is obligated to provide information on penalty amounts based on its established state of mind.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
