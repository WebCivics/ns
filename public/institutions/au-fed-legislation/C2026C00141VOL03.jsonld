    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1",
      "@type": "cml:Concept",
      "dc:source": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf, p.124",
      "skos:note": "Federal Court or Federal Circuit and Family Court of Australia may make orders if a person has contravened a civil remedy provision.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "545(1) Orders that can be made by particular courts"
      },
      "wasDerivedFrom": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf",
      "asserts": [
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1-norm",
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1-logic-deontic-1",
