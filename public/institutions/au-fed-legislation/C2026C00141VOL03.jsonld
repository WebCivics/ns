        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "76277f31d8f8f654c0475775af63497860ce6a73a7666190019024587eeb5be7",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009#sec-545-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If a person has contravened a civil remedy provision, the court may not make an order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits making orders if a person has contravened a civil remedy provision.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The court may make any order the court considers appropriate."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Injunctions are not granted in relation to industrial action under subsections 417(3) and 421(3).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits granting injunctions in relation to industrial action under subsections 417(3) and 421(3).",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The Federal Court and the Federal Circuit and Family Court of Australia (Division 2) may grant injunctions in relation to industrial action."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-545-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Orders are not allowed if a person has contravened subsection 463(1) or (2).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
