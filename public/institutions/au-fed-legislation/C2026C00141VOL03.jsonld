      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A party must pay costs incurred by the other party.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
