    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4",
      "@type": "cml:Concept",
      "dc:source": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf, p.406",
      "skos:note": "Responsible person still liable for unpaid amount despite section's effect on indirectly responsible entity.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "789CB(4) Liability of indirectly responsible entity for unpaid amount"
      },
      "wasDerivedFrom": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf",
      "asserts": [
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-norm",
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-789cb-ss-4-logic-deontic-1",
