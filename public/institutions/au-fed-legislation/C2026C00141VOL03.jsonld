      "skos:note": "Duty to complete matter before becoming unavailable",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "621(1) Reconstitution of the FWC when single FWC Member becomes"
      },
      "wasDerivedFrom": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf",
