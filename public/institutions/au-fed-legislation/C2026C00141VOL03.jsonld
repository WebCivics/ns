    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-557a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf, p.141",
      "skos:note": "A contravention of a civil remedy provision is a serious contravention if the person knowingly or recklessly contravened the provision.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "557A(1) Serious contravention of civil remedy provisions"
      },
      "wasDerivedFrom": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf",
