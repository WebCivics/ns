      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is subject to obligations if they arrange for TCF work to be performed by outworkers or of a kind often performed by them.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
