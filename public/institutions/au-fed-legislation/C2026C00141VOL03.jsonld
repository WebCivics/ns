      "dc:source": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf, p.332",
      "skos:note": "Transfer of business from non-national system employer to national system employer requires specific conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "768AD(1) When does a transfer of business occur?"
      },
      "wasDerivedFrom": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf",
