        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-norm",
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-768ad-ss-1-logic-deontic-1",
