      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Any conduct engaged in on behalf of the body corporate is taken to have been engaged in also by the body.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "The body corporate has a duty to ensure its officials act within their authority."
    },
