    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581",
      "@type": "cml:Concept",
      "dc:source": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf, p.166",
      "skos:note": "Ensure efficient and adequate performance of FWC functions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "581 Functions of the President"
      },
      "wasDerivedFrom": "prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009.pdf",
      "asserts": [
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-norm",
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-1",
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-2",
        "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "1c0e32ef5ac652a1739864dbbc0e7fa1fa6d0337a24cdbbbcf3e3c836f8be731",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009#sec-581",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The President MUST ensure efficiency and adequacy.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Ensure efficiency and adequacy",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The President is responsible for ensuring that the FWC performs its functions."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The President MUST ensure adequate service to employers, employees, and persons covered by Chapters 3A and 3B.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Ensure adequate service to employers, employees, and persons covered by Chapters 3A and 3B",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The President is responsible for ensuring that the FWC performs its functions and exercises its powers in a manner that: (a) is efficient; and (b) adequately serves the needs of employers and employees throughout Australia; and (c) adequately serves the needs of persons covered by Chapter 3A; and (d) adequately serves the needs of persons covered by Chapter 3B."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The President MUST facilitate cooperation with prescribed State industrial authorities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Facilitate cooperation with prescribed State industrial authorities",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The President must perform his or her own functions and exercise his or her own powers in a manner that facilitates cooperation with prescribed State industrial authorities."
    },
