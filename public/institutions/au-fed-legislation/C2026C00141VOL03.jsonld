    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-717e-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an overlap in time between the granting of consent and the withdrawal from a cooperation agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between consent and withdrawal",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The withdrawal must occur after obtaining consent."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-717e-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The withdrawal of a person from a cooperation agreement implies that they have obtained the required consent.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Withdrawal implies consent",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If a person withdraws from a cooperation agreement, then they have obtained consent."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-717e-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Based on the key 'sec-717e', it can be inferred that a person must obtain consent from the Fair Work Ombudsman to withdraw from a cooperation agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Automated inference of withdrawal requirements",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "The key 'sec-717e' provides sufficient information for automated inference of the withdrawal process."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-717e-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must obtain consent from the Fair Work Ombudsman to withdraw from a cooperation agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to obtain consent for withdrawal",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Fair Work Ombudsman has the power to grant or refuse consent."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-717e-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consent granted by the Fair Work Ombudsman propagates to all parties involved in the cooperation agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Consent propagates to all parties involved",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation",
      "cml:premiseText": "The Fair Work Ombudsman's consent is binding on all parties to the cooperation agreement."
    },
