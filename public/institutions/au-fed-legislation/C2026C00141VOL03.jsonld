    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-621-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC Member's availability overlaps with their unavailability",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between availability and unavailability",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(b) the FWC Member becomes unavailable to continue dealing with the matter before the matter is completely dealt with."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-621-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC Member must complete the matter before becoming unavailable",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory duty",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(a) an FWC Member is dealing with a matter (other than by forming part of a Full Bench or an Expert Panel in relation to a matter); and (b) the FWC Member becomes unavailable to continue dealing with the matter before the matter is completely dealt with."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-621-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC Member may choose to complete the matter if they are available",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Optional duty to complete matter",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(a) an FWC Member is dealing with a matter (other than by forming part of a Full Bench or an Expert Panel in relation to a matter); and"
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-621-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The FWC Member's unavailability occurs until the matter is completed",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal relationship between availability and completion of matter",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(b) the FWC Member becomes unavailable to continue dealing with the matter before the matter is completely dealt with."
    },
