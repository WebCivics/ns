      },
      "cml:operator": "=",
      "cml:premiseText": "(2) The penalty must not exceed one-fifth of the maximum penalty prescribed by the regulations for that offence."
    },
    {
      "@id": "concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-799-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval for calculating the maximum penalty is one-fifth of the maximum prescribed by regulations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval for maximum penalty calculation defined as one-fifth of the maximum prescribed by regulations.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "=",
      "cml:premiseText": "(2) The penalty must not exceed one-fifth of the maximum penalty prescribed by the regulations for that offence."
    },
