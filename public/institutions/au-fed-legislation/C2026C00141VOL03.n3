    cml:modality cml:Deontic ;
    cml:operator "obligation" ;
    cml:logicSummary "Duty to avoid reckless disregard" ;
    cml:premiseText "(a) the person is aware of a substantial risk that the contravention would occur; and (b) having regard to the circumstances known to the person, it is unjustifiable to take the risk." ;
    cml:conclusionText "The person must take reasonable care to avoid recklessness." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
