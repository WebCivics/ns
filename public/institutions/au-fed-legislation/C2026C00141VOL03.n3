    cml:modality cml:Deontic ;
    cml:operator "takes effect" ;
    cml:logicSummary "The copied State award comes into operation immediately after the termination time." ;
    cml:premiseText "(1) If, immediately before the termination time of a transferring employee:..." ;
    cml:conclusionText "...a copied State award for the transferring employee is taken to come into operation immediately after the termination time." ;
    cml:executionSurface "modalities::logic::deontic" ;
