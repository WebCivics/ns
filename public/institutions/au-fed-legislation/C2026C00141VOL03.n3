    cml:operator "MUST" ;
    cml:logicSummary "Ensure efficiency and adequacy" ;
    cml:premiseText "The President is responsible for ensuring that the FWC performs its functions." ;
    cml:conclusionText "The President MUST ensure efficiency and adequacy." ;
    cml:executionSurface "modalities::logic::deontic" ;
