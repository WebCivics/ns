    cml:operator "authorisation" ;
    cml:logicSummary "Express, tacit or implied authorisation required for liability" ;
    cml:premiseText "(1) For the purposes of subsection 557A(1), a body corporate knowingly contravenes a civil remedy provision if the body corporate expressly, tacitly or impliedly authorised the contravention." ;
    cml:conclusionText "Body corporate must authorise contravention for liability to apply" ;
    cml:executionSurface "modalities::logic::deontic" ;
