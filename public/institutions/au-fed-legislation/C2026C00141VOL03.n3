    cml:logicSummary "Artificial intelligence recognizes simultaneous appointments" ;
    cml:premiseText "(4) The same person must not hold, at the same time, an appointment as both: (a) an Expert Panel Member; and (b) the President, a Vice President, a Deputy President or a Commissioner." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


