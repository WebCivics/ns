concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581 cml:asserts concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-2 .
concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Ensure adequate service to employers, employees, and persons covered by Chapters 3A and 3B" ;
    cml:premiseText "The President is responsible for ensuring that the FWC performs its functions and exercises its powers in a manner that: (a) is efficient; and (b) adequately serves the needs of employers and employees throughout Australia; and (c) adequately serves the needs of persons covered by Chapter 3A; and (d) adequately serves the needs of persons covered by Chapter 3B." ;
    cml:conclusionText "The President MUST ensure adequate service to employers, employees, and persons covered by Chapters 3A and 3B." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581 cml:asserts concept:prepared-by-the-office-of-parliamentary-counsel-canberra-fair-work-act-2009-sec-581-logic-deontic-3 .
