    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of providing false or misleading information." ;
    cml:premiseText "The person knows, or is reckless as to whether, the information is false or misleading." ;
    cml:conclusionText "The person must not give information or produce a document." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
