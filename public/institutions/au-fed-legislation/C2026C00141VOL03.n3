    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Facilitate cooperation with prescribed State industrial authorities" ;
    cml:premiseText "The President must perform his or her own functions and exercise his or her own powers in a manner that facilitates cooperation with prescribed State industrial authorities." ;
    cml:conclusionText "The President MUST facilitate cooperation with prescribed State industrial authorities." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


