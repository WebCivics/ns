    <https://ns.webcivics.net/cml/premiseText> "The person refuses or fails to be sworn or to make an affirmation as required.";
    <https://ns.webcivics.net/cml/conclusionText> "The person commits an offence if they refuse or fail to be sworn or to make an affirmation as required.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
