    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "Overlaps";
    <https://ns.webcivics.net/cml/logicSummary> "Temporal overlap between availability and unavailability";
    <https://ns.webcivics.net/cml/premiseText> "(b) the FWC Member becomes unavailable to continue dealing with the matter before the matter is completely dealt with.";
    <https://ns.webcivics.net/cml/conclusionText> "The FWC Member's availability overlaps with their unavailability";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
