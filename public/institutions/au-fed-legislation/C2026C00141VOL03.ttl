    <https://ns.webcivics.net/cml/operator> "requires";
    <https://ns.webcivics.net/cml/logicSummary> "Requires connection between old and new employers.";
    <https://ns.webcivics.net/cml/premiseText> "(d) there is a connection between the old State employer and the new employer as described in subsection (2), (3) or (4).";
    <https://ns.webcivics.net/cml/conclusionText> "the transfer of business requires a connection between the old and new employers";
