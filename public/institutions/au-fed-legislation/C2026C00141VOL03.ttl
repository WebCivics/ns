    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Obligation to take oath or affirmation when required";
    <https://ns.webcivics.net/cml/premiseText> "The FWC requires the person to take an oath or make an affirmation; and the person refuses or fails to be sworn or to make an affirmation as required.";
    <https://ns.webcivics.net/cml/conclusionText> "The person has an obligation to take an oath or make an affirmation when required by the FWC.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
