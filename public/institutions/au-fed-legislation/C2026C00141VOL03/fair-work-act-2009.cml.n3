concept:fair-work-act-2009-sec-646 a cml:Concept ;
    skos:prefLabel "646 Other terms and conditions of FWC Members"@en ;
    cml:realizedBy doc:sec-646 ;
    values:originalText "An FWC Member holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Governor-General." ;
