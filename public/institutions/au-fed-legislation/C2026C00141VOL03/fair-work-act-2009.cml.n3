concept:fair-work-act-2009-sec-747 a cml:Concept ;
    skos:prefLabel "747 State and Territory laws that are not excluded"@en ;
    cml:realizedBy doc:sec-747 ;
    values:originalText "This Act is not intended to apply to the exclusion of laws of a State or Territory that provide employee entitlements in relation to the birth or adoption of children, to the extent that those laws: (a) apply to non-national system employees; and (b) provide entitlements for those employees that are more beneficial than the entitlements under the extended parental leave provisions. Subdivision B—Modifications of the extended parental leave provisions" ;
    skos:definition "This Act is not intended to apply to the exclusion of laws of a State or Territory that provide employee entitlements in relation to the birth or adoption of children, to the extent that those laws: (a) apply to non-national system employees; and (b) provide entitlements for those employees that are more beneficial than the entitlements under the extended parental leave provisions. Subdivision B—Modifications of the extended parental leave provisions"@en ;
    cml:integrityHash "bd216a6cea27235df1b3c0b8c8087dfca3538c5c3f94480fb399e71af28898fc" ;
    cof:pageNumber "317"^^xsd:integer ;
    skos:note "Exclusion of State laws on employee entitlements related to birth or adoption of children." ;
