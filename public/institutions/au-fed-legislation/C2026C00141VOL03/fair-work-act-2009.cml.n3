concept:fair-work-act-2009-sec-757g a cml:Concept ;
    skos:prefLabel "757G Modification of meaning of full rate of pay for pieceworkers"@en ;
    cml:realizedBy doc:sec-757g ;
    values:originalText "Section 18 has effect as if the following paragraph were added at the end of subsection 18(2): (d) the employee is a non-national system employee, and the regulations prescribe, or provide for the determination of, the employee’s full rate of pay for the purposes of the extended paid family and domestic violence leave provisions.  Miscellaneous  Chapter 6 Extension of National Employment Standards entitlements  Part 6-3 Extension of entitlement to paid family and domestic violence leave  Division 2A Section 757H Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "Section 18 has effect as if the following paragraph were added at the end of subsection 18(2): (d) the employee is a non-national system employee, and the regulations prescribe, or provide for the determination of, the employee’s full rate of pay for the purposes of the extended paid family and domestic violence leave provisions.  Miscellaneous  Chapter 6 Extension of National Employment Standards entitlements  Part 6-3 Extension of entitlement to paid family and domestic violence leave  Division 2A Section 757H Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "47ffef88132c1f03c875233570d999c6c1240d36e3ceafaf51ae60f26295963e" ;
    cof:pageNumber "324"^^xsd:integer ;
    skos:note "Employee's full rate of pay for extended paid family and domestic violence leave provisions must be determined by regulations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.324" ;
    cml:asserts concept:fair-work-act-2009-sec-757g-norm .
