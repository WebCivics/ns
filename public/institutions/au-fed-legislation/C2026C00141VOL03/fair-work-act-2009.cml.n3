doc:sec-712ad-ss-1 a cof:Section ;
    cof:title "712AD(1) Fair Work Ombudsman may give FWO notice to person in" ;
    values:kind "subsection" ;
    values:originalText "(1) If a nominated ART President or Deputy President issues an FWO notice, the Fair Work Ombudsman may give the notice to the person in relation to whom it is issued." ;
    cof:pageNumber "277"^^xsd:integer .

concept:fair-work-act-2009-sec-712ad-ss-2 a cml:Concept ;
    skos:prefLabel "712AD(2) Fair Work Ombudsman may give FWO notice to person in"@en ;
    cml:realizedBy doc:sec-712ad-ss-2 ;
    values:originalText "(2) If an FWO notice is not given to the person in relation to whom it is issued within 3 months after the day on which it was issued, the notice ceases to have effect at the end of that period. Variation of time for compliance with FWO notice" ;
    skos:definition "(2) If an FWO notice is not given to the person in relation to whom it is issued within 3 months after the day on which it was issued, the notice ceases to have effect at the end of that period. Variation of time for compliance with FWO notice"@en ;
    cml:integrityHash "4807d142046e7f6930b36f040bab59be1e99a4eaa053e2095e321827b152ba2e" ;
    values:partOf concept:fair-work-act-2009-sec-712ad ;
    cof:pageNumber "277"^^xsd:integer ;
    skos:note "Notice ceases to have effect after 3 months if not given within that time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
