    cml:hasPart concept:fair-work-act-2009-sec-789ce-ss-6 ;
    cml:hasPart concept:fair-work-act-2009-sec-789ce-ss-7 ;
    cml:hasPart concept:fair-work-act-2009-sec-789ce-ss-8 ;
    cml:curationStatus cml:Proposed ;
