doc:sec-597-ss-1 a cof:Section ;
    cof:title "597(1) Minister’s entitlement to make submissions" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister is entitled to make a submission for consideration in relation to a matter before the FWC if: (a) the matter is before a Full Bench and it is in the public interest for the Minister to make a submission; or (b) the matter involves public sector employment." ;
    cof:pageNumber "179"^^xsd:integer .

