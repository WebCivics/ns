concept:fair-work-act-2009-sec-741 a cml:Concept ;
    skos:prefLabel "741 Guide to this Part"@en ;
    cml:realizedBy doc:sec-741 ;
    values:originalText "This Part contains Divisions that extend some National Employment Standards entitlements to non-national system employees. Division 2 extends the entitlements to unpaid parental leave, and related entitlements. Division 2A extends the entitlements to paid family and domestic violence leave. Division 3 extends the entitlements to notice of termination or payment in lieu of notice." ;
    skos:definition "This Part contains Divisions that extend some National Employment Standards entitlements to non-national system employees. Division 2 extends the entitlements to unpaid parental leave, and related entitlements. Division 2A extends the entitlements to paid family and domestic violence leave. Division 3 extends the entitlements to notice of termination or payment in lieu of notice."@en ;
    cml:integrityHash "82a706598efcbb73342dcc671d3d7dde4645d99cda2bcf312ada81e60e78786f" ;
    cof:pageNumber "314"^^xsd:integer ;
