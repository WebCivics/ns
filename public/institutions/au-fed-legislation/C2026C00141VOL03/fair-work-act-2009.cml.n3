doc:sec-536pj-ss-4 a cof:Section ;
    cof:title "536PJ(4) Finalising draft order" ;
    values:kind "subsection" ;
    values:originalText "(4) However, the FWC may reduce that 12-month period to another period that the FWC considers is reasonable if: (a) the order is a time-sensitive road transport contractual chain order; or (b) the FWC is satisfied that the circumstances urgently require it, and the period is at least 6 months starting from the draft publication time." ;
    cof:pageNumber "48"^^xsd:integer .

concept:fair-work-act-2009-sec-536pk a cml:Concept ;
    skos:prefLabel "536PK Decision not to make order based on the draft"@en ;
    cml:realizedBy doc:sec-536pk ;
    values:originalText "The FWC may decide that no road transport contractual chain order is to be made based on the draft. If the FWC does so, the FWC must publish notice of the decision on its website and by any other means the FWC considers appropriate. Subdivision D—Decisions on road transport contractual chain orders and related matters" ;
    skos:definition "The FWC may decide that no road transport contractual chain order is to be made based on the draft. If the FWC does so, the FWC must publish notice of the decision on its website and by any other means the FWC considers appropriate. Subdivision D—Decisions on road transport contractual chain orders and related matters"@en ;
    cml:integrityHash "badb7be5909508d45c7607b44c064261a5da74428fa1cabd410daf625cd44f55" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "Publish notice of decision on website and other means." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
