concept:fair-work-act-2009-sec-789cf a cml:Concept ;
    skos:prefLabel "789CF Division does not limit other liabilities or rights"@en ;
    cml:realizedBy doc:sec-789cf ;
    values:originalText "Nothing in this Division limits any other liability or right in respect of the entitlement of the TCF outworker to the unpaid amount (or  Chapter 6  Miscellaneous" ;
