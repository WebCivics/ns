    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Temporal overlap between consent and withdrawal" ;
    cml:premiseText "The withdrawal must occur after obtaining consent." ;
    cml:conclusionText "There is an overlap in time between the granting of consent and the withdrawal from a cooperation agreement." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-717e cml:asserts concept:fair-work-act-2009-sec-717e-logic-argumentation-3 .
