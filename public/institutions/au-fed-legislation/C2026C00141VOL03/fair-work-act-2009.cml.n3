concept:fair-work-act-2009-sec-552 a cml:Concept ;
    skos:prefLabel "552 Civil proceedings after criminal proceedings"@en ;
    cml:realizedBy doc:sec-552 ;
    values:originalText "A court must not make a pecuniary penalty order against a person for a contravention of a civil remedy provision if the person has been convicted of an offence constituted by conduct that is substantially the same as the conduct constituting the contravention." ;
    skos:definition "A court must not make a pecuniary penalty order against a person for a contravention of a civil remedy provision if the person has been convicted of an offence constituted by conduct that is substantially the same as the conduct constituting the contravention."@en ;
    cml:integrityHash "2c4c1ef3e6c267263e2cf9c414ae7f45c07343762e5289ef9daacff98d1c1814" ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "Court cannot impose pecuniary penalty order on person convicted of related offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.137" ;
    cml:asserts concept:fair-work-act-2009-sec-552-norm .
