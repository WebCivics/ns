concept:fair-work-act-2009-sec-781 a cml:Concept ;
    skos:prefLabel "781 Applications for costs orders"@en ;
    cml:realizedBy doc:sec-781 ;
    values:originalText "An application for an order for costs in relation to an application under section 773 must be made within 14 days after the FWC finishes dealing with the dispute." ;
    skos:definition "An application for an order for costs in relation to an application under section 773 must be made within 14 days after the FWC finishes dealing with the dispute."@en ;
