doc:sec-587-ss-1 a cof:Section ;
    cof:title "587(1) Dismissing applications" ;
    values:kind "subsection" ;
    values:originalText "(1) Without limiting when the FWC may dismiss an application, the FWC may dismiss an application if: (a) the application is not made in accordance with this Act; or (b) the application is frivolous or vexatious; or (c) the application has no reasonable prospects of success. Note: For another power of the FWC to dismiss an application for a remedy for unfair dismissal made under Division 5 of Part 3-2, see section 399A." ;
    cof:pageNumber "173"^^xsd:integer .

concept:fair-work-act-2009-sec-587-ss-2 a cml:Concept ;
    skos:prefLabel "587(2) Dismissing applications"@en ;
    cml:realizedBy doc:sec-587-ss-2 ;
    values:originalText "(2) Despite paragraphs (1)(b) and (c), the FWC must not dismiss an application under section 365, 536LU or 773, or an application under section 527F that does not consist solely of an application  Chapter 5  Administration" ;
    skos:definition "(2) Despite paragraphs (1)(b) and (c), the FWC must not dismiss an application under section 365, 536LU or 773, or an application under section 527F that does not consist solely of an application  Chapter 5  Administration"@en ;
    cml:integrityHash "98b82cb43210952520dfd7430e1f044c361f0730602013aab7dfd5ca5b018a6a" ;
    values:partOf concept:fair-work-act-2009-sec-587 ;
    cof:pageNumber "173"^^xsd:integer ;
    skos:note "FWC cannot dismiss certain applications" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
