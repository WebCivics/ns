    cof:pageNumber "171"^^xsd:integer ;
    skos:note "The President may delegate certain functions or powers to a Vice President or Deputy President." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
