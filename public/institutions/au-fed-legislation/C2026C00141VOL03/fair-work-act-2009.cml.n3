concept:fair-work-act-2009-sec-599 a cml:Concept ;
    skos:prefLabel "599 FWC not required to decide an application in terms applied for"@en ;
    cml:realizedBy doc:sec-599 ;
    values:originalText "Except as provided by this Act, the FWC is not required to make a decision in relation to an application in the terms applied for.  Administration  Chapter 5 The Fair Work Commission  Part 5-1 Conduct of matters before the FWC  Division 3 Section 600 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "Except as provided by this Act, the FWC is not required to make a decision in relation to an application in the terms applied for.  Administration  Chapter 5 The Fair Work Commission  Part 5-1 Conduct of matters before the FWC  Division 3 Section 600 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "bcc1e85c023a526ecc04735902f7e6fe2cc9affe510c9fd424e5555bde35d609" ;
    cof:pageNumber "180"^^xsd:integer ;
    skos:note "FWC is not required to make a decision in relation to an application." ;
    cml:curationStatus cml:Proposed ;
