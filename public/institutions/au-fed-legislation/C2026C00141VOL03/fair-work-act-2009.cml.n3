concept:fair-work-act-2009-sec-624 a cml:Concept ;
    skos:prefLabel "624 FWC’s decisions not invalid when improperly constituted"@en ;
    cml:realizedBy doc:sec-624 ;
    values:originalText "A decision of the FWC is not invalid merely because it was made by a Full Bench, or an Expert Panel, constituted otherwise than as provided by this Division. Note: If the FWC makes a decision to make an instrument while constituted otherwise than as provided by this Division, the instrument is not invalid (see subsection 598(2)). Subdivision C—Delegation of the FWC’s functions and powers" ;
    skos:definition "A decision of the FWC is not invalid merely because it was made by a Full Bench, or an Expert Panel, constituted otherwise than as provided by this Division. Note: If the FWC makes a decision to make an instrument while constituted otherwise than as provided by this Division, the instrument is not invalid (see subsection 598(2)). Subdivision C—Delegation of the FWC’s functions and powers"@en ;
    cml:integrityHash "d00e2aef6e2e9e9853f9fb4752a62b30dbed0f7c13145a942cab8d694ff26134" ;
    cof:pageNumber "211"^^xsd:integer ;
    skos:note "FWC decisions are not invalid due to improper constitution." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.211" ;
