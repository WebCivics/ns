doc:sec-789cc-ss-3 a cof:Section ;
    cof:title "789CC(3) Demand for payment from an apparent indirectly" ;
    values:kind "subsection" ;
    values:originalText "(3) The demand must: (a) specify the amount, and identify the responsible person; and (b) include particulars of the TCF work to which the amount relates, and why the amount is payable by the entity to which the demand is given; and (c) state that if the specified amount is not paid by a specified time, proceedings may be commenced against the entity under section 789CD.  Miscellaneous  Chapter 6 Special provisions about TCF outworkers  Part 6-4A Recovery of unpaid amounts  Division 3 Section 789CD Fair Work Act 2009 Compilation date: 02/04/2026" ;
    cof:pageNumber "406"^^xsd:integer .

concept:fair-work-act-2009-sec-789cc-ss-4 a cml:Concept ;
    skos:prefLabel "789CC(4) Demand for payment from an apparent indirectly"@en ;
    cml:realizedBy doc:sec-789cc-ss-4 ;
    values:originalText "(4) The time specified for the purpose of paragraph (3)(c) must not be less than 14 days after the demand is given to the entity." ;
