concept:fair-work-act-2009-sec-536q a cml:Concept ;
    skos:prefLabel "536Q Consultation requirements"@en ;
    cml:realizedBy doc:sec-536q ;
    values:originalText "The Minister is not required to consult any person or body before making a deferral declaration or a suspension declaration.  Chapter 3B  Minimum standards for persons in a road transport contractual chain" ;
