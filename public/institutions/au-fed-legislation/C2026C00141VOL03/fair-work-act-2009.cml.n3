    cml:premiseText "(a) includes a reference to a regulation, rule or other instrument made pursuant to, or for the purposes of, a law of a State or Territory." ;
    cml:conclusionText "The regulation is included in the CogAI." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-536nw-ss-5 a cof:Section ;
    cof:title "536NW(5) Exclusion of certain State and Territory laws" ;
    values:kind "subsection" ;
    values:originalText "(5) Without limiting any other provision of this Act, a reference in this section to a law of a State or Territory: (a) includes a reference to a regulation, rule or other instrument (however described) made pursuant to, or for the purposes of, a law of a State or Territory; and (b) is a reference to a law of a State or Territory as in force from time to time." ;
    cof:pageNumber "38"^^xsd:integer .

