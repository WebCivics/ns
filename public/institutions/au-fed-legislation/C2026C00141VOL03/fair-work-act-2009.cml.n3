    cml:logicSummary "Absence condition prohibits appointment termination" ;
    cml:premiseText "(b) the Fair Work Ombudsman is absent..." ;
    cml:conclusionText "...for 14 consecutive days or for 28 days in any 12 months" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-693-ss-2 a cof:Section ;
    cof:title "693(2) Termination of appointment of the Fair Work Ombudsman" ;
    values:kind "subsection" ;
    values:originalText "(2) The Governor-General must terminate the appointment of the Fair Work Ombudsman if: (a) the Fair Work Ombudsman becomes bankrupt, applies to take the benefit of any law for the relief of bankrupt or insolvent debtors, compounds with his or her creditors, or makes an assignment of his or her remuneration for the benefit of his or her creditors; or (b) the Fair Work Ombudsman is absent, except on leave of absence, for 14 consecutive days or for 28 days in any 12 months; or  Chapter 5  Administration" ;
    cof:pageNumber "261"^^xsd:integer .

concept:fair-work-act-2009-sec-694 a cml:Concept ;
