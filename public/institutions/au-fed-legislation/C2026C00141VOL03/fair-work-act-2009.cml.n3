concept:fair-work-act-2009-sec-636 a cml:Concept ;
    skos:prefLabel "636 Application of Judges’ Pensions Act to the President"@en ;
    cml:realizedBy doc:sec-636 ;
    values:originalText "(1) The Judges’ Pensions Act 1968 does not apply to the President if: (a) immediately before being appointed as the President, he or she was one of the following (a public sector superannuation scheme member):  Chapter 5  Administration" ;
    skos:definition "(1) The Judges’ Pensions Act 1968 does not apply to the President if: (a) immediately before being appointed as the President, he or she was one of the following (a public sector superannuation scheme member):  Chapter 5  Administration"@en ;
    cml:integrityHash "4c5d7ea995bff0f89f70553368325f8c1103ad6217ca4eed184ad305b201b563" ;
    cof:pageNumber "219"^^xsd:integer ;
    skos:note "The Judges' Pensions Act does not apply to the President if he/she was a member of a public sector superannuation scheme immediately before being appointed." ;
    cml:curationStatus cml:Proposed ;
