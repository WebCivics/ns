doc:sec-598-ss-2 a cof:Section ;
    cof:title "598(2) Decisions of the FWC" ;
    values:kind "subsection" ;
    values:originalText "(2) If the FWC makes a decision that makes or varies an instrument, a reference in this Part to a decision of the FWC includes the FWC’s decision to make or vary the instrument in the particular terms decided." ;
    cof:pageNumber "180"^^xsd:integer .

