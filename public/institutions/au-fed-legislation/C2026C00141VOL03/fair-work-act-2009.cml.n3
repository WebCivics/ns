doc:sec-768bn-ss-3 a cof:Section ;
    cof:title "768BN(3) NES—working out accruing entitlements" ;
    values:kind "subsection" ;
    values:originalText "(3) However, if before or after the employee’s termination time, the old State employer paid the employee an amount in relation to some or all of the accrued leave, then for the purposes of subsection (2), the amount of accrued leave is reduced accordingly. Working out whether leave accrued" ;
    cof:pageNumber "368"^^xsd:integer .

concept:fair-work-act-2009-sec-768bn-ss-4 a cml:Concept ;
    skos:prefLabel "768BN(4) NES—working out accruing entitlements"@en ;
    cml:realizedBy doc:sec-768bn-ss-4 ;
    values:originalText "(4) For the purposes of subsection (1), it does not matter whether the entitlement to leave accrued under: (a) the original State award or original State agreement for the copied State instrument for the employee; or (b) a State industrial law of the State." ;
    skos:definition "(4) For the purposes of subsection (1), it does not matter whether the entitlement to leave accrued under: (a) the original State award or original State agreement for the copied State instrument for the employee; or (b) a State industrial law of the State."@en ;
    cml:integrityHash "291ccb8f3be6047594a054a7a284c4b93d3a62faf57e1b5964ee002ac67f641d" ;
    values:partOf concept:fair-work-act-2009-sec-768bn ;
    cof:pageNumber "368"^^xsd:integer ;
    skos:note "It does not matter whether entitlement accrued under original State award or agreement." ;
    cml:curationStatus cml:Proposed ;
