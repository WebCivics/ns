concept:fair-work-act-2009-sec-600 a cml:Concept ;
    skos:prefLabel "600 Determining matters in the absence of a person"@en ;
    cml:realizedBy doc:sec-600 ;
    values:originalText "The FWC may determine a matter before it in the absence of a person who has been required to attend before it." ;
    skos:definition "The FWC may determine a matter before it in the absence of a person who has been required to attend before it."@en ;
