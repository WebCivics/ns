concept:fair-work-act-2009-sec-768bq-ss-4 a cml:Concept ;
    skos:prefLabel "768BQ(4) Copied State instrument—working out accruing entitlements"@en ;
    cml:realizedBy doc:sec-768bq-ss-4 ;
    values:originalText "(4) For the purposes of subsection (2), it does not matter whether the leave accrued under: (a) the original State award or original State agreement for the copied State instrument; or (b) a State industrial law of the State.  Chapter 6  Miscellaneous" ;
    skos:definition "(4) For the purposes of subsection (2), it does not matter whether the leave accrued under: (a) the original State award or original State agreement for the copied State instrument; or (b) a State industrial law of the State.  Chapter 6  Miscellaneous"@en ;
    cml:integrityHash "7effabf10a336d26a0d642d62cb22e25777b21bb857090cf8dd15fa04c35a1df" ;
    values:partOf concept:fair-work-act-2009-sec-768bq ;
    cof:pageNumber "371"^^xsd:integer ;
    skos:note "It does not matter whether leave accrued under the original State award or original State agreement for the copied State instrument." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.371" ;
