concept:fair-work-act-2009-sec-21 a cml:Concept ;
    skos:prefLabel "21 June 2019; and"@en ;
    cml:realizedBy doc:sec-21 ;
    values:originalText "(b) the Violence and Harassment Recommendation, 2019 (Recommendation No. 206), which the General Conference of the ILO adopted on 21 June 2019; by providing employees with an entitlement to paid family and domestic violence leave that will help mitigate the impact of domestic violence in the world of work. Note: The Convention and the Recommendation could in 2022 be viewed on the ILO website (http://www.ilo.org)." ;
    skos:definition "(b) the Violence and Harassment Recommendation, 2019 (Recommendation No. 206), which the General Conference of the ILO adopted on 21 June 2019; by providing employees with an entitlement to paid family and domestic violence leave that will help mitigate the impact of domestic violence in the world of work. Note: The Convention and the Recommendation could in 2022 be viewed on the ILO website (http://www.ilo.org)."@en ;
    cml:integrityHash "4bc105e93211158ebed1dca35827f890b7a70af372de7a19bde5b8e117f84f5b" ;
    cof:pageNumber "321"^^xsd:integer ;
    skos:note "Employees have an entitlement to paid family and domestic violence leave." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.321" ;
