concept:fair-work-act-2009-sec-768al-ss-2 a cml:Concept ;
    skos:prefLabel "768AL(2) What is a State employment agreement?"@en ;
    cml:realizedBy doc:sec-768al-ss-2 ;
    values:originalText "(2) A copied State instrument for a transferring employee applies to an employer (whether the new employer or another employer) if: (a) the instrument covers the employer; and (b) the instrument is in operation; and (c) no other provision of this Act provides, or has the effect, that the instrument does not apply to the employer; and  Chapter 6  Miscellaneous" ;
    skos:definition "(2) A copied State instrument for a transferring employee applies to an employer (whether the new employer or another employer) if: (a) the instrument covers the employer; and (b) the instrument is in operation; and (c) no other provision of this Act provides, or has the effect, that the instrument does not apply to the employer; and  Chapter 6  Miscellaneous"@en ;
    cml:integrityHash "77e6657e2a9252e95c8c49e9ecf48b239fe91c3dbd66528ee6720001b744f642" ;
    values:partOf concept:fair-work-act-2009-sec-768al ;
    cof:pageNumber "338"^^xsd:integer ;
    skos:note "An instrument of a specified kind may be considered a State employment agreement. Employer must comply with State instrument if it covers and is in operation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
