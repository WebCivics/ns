concept:fair-work-act-2009-sec-730-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must be withdrawn or result in a certificate." ;
    cml:premiseText "(a) an unlawful termination FWC application has been made by, nor on behalf of, the person in relation to the dismissal;" ;
    cml:conclusionText "the application must be withdrawn or result in a certificate under paragraph 776(3)(a)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-730-ss-1 cml:asserts concept:fair-work-act-2009-sec-730-ss-1-logic-deontic-2 .
concept:fair-work-act-2009-sec-730-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must not fail for want of jurisdiction." ;
    cml:premiseText "(b) the application has not: (i) been withdrawn by the person who made the application;" ;
    cml:conclusionText "the application must not fail for want of jurisdiction." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-730-ss-1 cml:asserts concept:fair-work-act-2009-sec-730-ss-1-logic-deontic-3 .
concept:fair-work-act-2009-sec-730-ss-1-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must not result in the issue of a certificate under paragraph 776(3)(a)." ;
    cml:premiseText "(b) the application has not: (ii) failed for want of jurisdiction; or (iii) resulted in the issue of a certificate under paragraph 776(3)(a);" ;
    cml:conclusionText "the application must not result in the issue of a certificate under paragraph 776(3)(a)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-730-ss-1 cml:asserts concept:fair-work-act-2009-sec-730-ss-1-logic-alleninterval-4 .
