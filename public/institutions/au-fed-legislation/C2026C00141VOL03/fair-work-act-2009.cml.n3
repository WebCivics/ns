concept:fair-work-act-2009-sec-686 a cml:Concept ;
    skos:prefLabel "686 Annual report"@en ;
    cml:realizedBy doc:sec-686 ;
    values:originalText "To avoid doubt, the requirement on the Fair Work Ombudsman to give an annual report to the Minister under section 46 of the Public Governance, Performance and Accountability Act 2013 does not require or authorise the disclosure of information for the purposes of the Privacy Act 1988. Note: An annual report must not include information relating to an individual’s affairs (see section 714A).  Chapter 5  Administration" ;
    skos:definition "To avoid doubt, the requirement on the Fair Work Ombudsman to give an annual report to the Minister under section 46 of the Public Governance, Performance and Accountability Act 2013 does not require or authorise the disclosure of information for the purposes of the Privacy Act 1988. Note: An annual report must not include information relating to an individual’s affairs (see section 714A).  Chapter 5  Administration"@en ;
    cml:integrityHash "0bd99e330f9628a1da043b3835ad13653a8a801666f7cc3f8784af6636dae240" ;
    cof:pageNumber "259"^^xsd:integer ;
    skos:note "No disclosure of information for Privacy Act 1988 purposes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.259" ;
