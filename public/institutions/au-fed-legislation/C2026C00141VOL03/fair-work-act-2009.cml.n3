concept:fair-work-act-2009-sec-673a a cml:Concept ;
    skos:prefLabel "673A Application of the finance law"@en ;
    cml:realizedBy doc:sec-673a ;
    values:originalText "For the purposes of the finance law (within the meaning of the Public Governance, Performance and Accountability Act 2013): (a) the following group of persons is a listed entity: (i) the General Manager; (ii) the staff of the FWC referred to in section 670; (iii) persons whose services are made available to the FWC under section 672; (iv) consultants engaged under section 673; and  Chapter 5  Administration" ;
    skos:definition "For the purposes of the finance law (within the meaning of the Public Governance, Performance and Accountability Act 2013): (a) the following group of persons is a listed entity: (i) the General Manager; (ii) the staff of the FWC referred to in section 670; (iii) persons whose services are made available to the FWC under section 672; (iv) consultants engaged under section 673; and  Chapter 5  Administration"@en ;
    cml:integrityHash "b88f28ee3012c8870894c8599b3361fd953c1f41b8a60a5a735514148ad25e87" ;
    cof:pageNumber "247"^^xsd:integer ;
