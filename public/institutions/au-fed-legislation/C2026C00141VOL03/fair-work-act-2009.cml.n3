concept:fair-work-act-2009-sec-713aa a cml:Concept ;
    skos:prefLabel "713AA Legal professional privilege"@en ;
    cml:realizedBy doc:sec-713aa ;
    values:originalText "Nothing in this Part requires a person to produce a document that would disclose information that is the subject of legal professional privilege." ;
    skos:definition "Nothing in this Part requires a person to produce a document that would disclose information that is the subject of legal professional privilege."@en ;
