    cml:modality cml:LTL ;
    cml:operator "until" ;
    cml:logicSummary "The copied State award comes into effect until the employee becomes employed by the new employer." ;
    cml:premiseText "...it will not apply to the employee or new employer before the employee becomes employed by the new employer." ;
    cml:conclusionText "...then the State’s interaction rules that were in force immediately before the termination time apply for the purposes of working out the interaction between the copied State award and the copied State employment agreement." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
