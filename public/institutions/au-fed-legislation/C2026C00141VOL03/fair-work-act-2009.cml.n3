doc:sec-789ce-ss-6 a cof:Section ;
    cof:title "789CE(6) Effect of payment by entity (including entity’s right to" ;
    values:kind "subsection" ;
    values:originalText "(6) In making the order the court must, on application, include an amount of interest in the sum ordered, unless good cause is shown to the contrary." ;
    cof:pageNumber "408"^^xsd:integer .

concept:fair-work-act-2009-sec-789ce-ss-7 a cml:Concept ;
    skos:prefLabel "789CE(7) Effect of payment by entity (including entity’s right to"@en ;
    cml:realizedBy doc:sec-789ce-ss-7 ;
    values:originalText "(7) Without limiting subsection (6), in determining the amount of interest, the court must take into account the period between the day when the recoverable amount was paid by the entity and the day when the order is made." ;
    skos:definition "(7) Without limiting subsection (6), in determining the amount of interest, the court must take into account the period between the day when the recoverable amount was paid by the entity and the day when the order is made."@en ;
    cml:integrityHash "0eff3e1ba6987b9e6ad4e5ea7480b68e709cd75339ebd4b7bccfbc1e6c65f894" ;
    values:partOf concept:fair-work-act-2009-sec-789ce ;
    cof:pageNumber "408"^^xsd:integer ;
    skos:note "Court must consider period between payment and order date when determining interest amount." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
