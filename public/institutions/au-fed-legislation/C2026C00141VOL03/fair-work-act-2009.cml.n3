concept:fair-work-act-2009-sec-768ak-ss-4 cml:asserts concept:fair-work-act-2009-sec-768ak-ss-4-logic-deontic-1 .
concept:fair-work-act-2009-sec-768ak-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Imposes an obligation on the State to ensure the copied agreement meets the requirements of a collective employment agreement." ;
    cml:premiseText "The original agreement is a collective agreement." ;
    cml:conclusionText "Therefore, the copied agreement must also meet these requirements." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-768ak-ss-4 cml:asserts concept:fair-work-act-2009-sec-768ak-ss-4-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-768ak-ss-4-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "=" ;
    cml:logicSummary "Establishes a temporal relationship between the original and copied agreements." ;
    cml:premiseText "The original agreement was entered into on a specific date." ;
    cml:conclusionText "Therefore, the copied agreement must also be entered into on that same date." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-768ak-ss-4 cml:asserts concept:fair-work-act-2009-sec-768ak-ss-4-logic-ltl-3 .
concept:fair-work-act-2009-sec-768ak-ss-4-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "=" ;
    cml:logicSummary "Establishes a temporal relationship between the original and copied agreements." ;
    cml:premiseText "The original agreement was entered into before the copied agreement." ;
    cml:conclusionText "Therefore, the copied agreement must also be entered into after the original agreement." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-768ak-ss-4 cml:asserts concept:fair-work-act-2009-sec-768ak-ss-4-logic-cogai-4 .
