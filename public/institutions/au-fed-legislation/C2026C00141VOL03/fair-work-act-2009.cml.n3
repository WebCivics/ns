doc:sec-705-ss-1 a cof:Section ;
    cof:title "705(1) Particular directions by the Fair Work Ombudsman" ;
    values:kind "subsection" ;
    values:originalText "(1) The Fair Work Ombudsman may give a direction to an inspector relating to the performance of the inspector’s functions or the exercise of the inspector’s powers as an inspector." ;
    cof:pageNumber "267"^^xsd:integer .

