concept:fair-work-act-2009-sec-794a-ss-3 a cml:Concept ;
    skos:prefLabel "794A(3) Liability of Australian governments under civil remedy"@en ;
    cml:realizedBy doc:sec-794a-ss-3 ;
    values:originalText "(3) Any conduct engaged in on behalf of an Australian government by an officer, employee or agent (an official) of the government within the scope of the official’s actual or apparent authority is taken, for the purposes of this Act and the procedural rules, to have been engaged in also by the government. State of mind of Australian governments" ;
    skos:definition "(3) Any conduct engaged in on behalf of an Australian government by an officer, employee or agent (an official) of the government within the scope of the official’s actual or apparent authority is taken, for the purposes of this Act and the procedural rules, to have been engaged in also by the government. State of mind of Australian governments"@en ;
    cml:integrityHash "1bcecf36e3fc4bcbcfd7441a856352251ba4570a7d580bc5e327263c16189b8f" ;
    values:partOf concept:fair-work-act-2009-sec-794a ;
    cof:pageNumber "450"^^xsd:integer ;
    skos:note "Government liable for conduct of officials within apparent authority" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.450" ;
