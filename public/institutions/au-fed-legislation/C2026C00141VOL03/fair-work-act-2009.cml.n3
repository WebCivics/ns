concept:fair-work-act-2009-sec-733 a cml:Concept ;
    skos:prefLabel "733 Dismissal does not include failure to provide benefits"@en ;
    cml:realizedBy doc:sec-733 ;
    values:originalText "For the purposes of this Subdivision, a reference to an application or complaint made in relation to a dismissal does not include a reference to an application or complaint made only in relation to failure by the employer concerned to provide a benefit to which the dismissed person is entitled as a result of the dismissal. Subdivision C—General protections applications that do not relate to dismissal" ;
    skos:definition "For the purposes of this Subdivision, a reference to an application or complaint made in relation to a dismissal does not include a reference to an application or complaint made only in relation to failure by the employer concerned to provide a benefit to which the dismissed person is entitled as a result of the dismissal. Subdivision C—General protections applications that do not relate to dismissal"@en ;
    cml:integrityHash "90b5cf927b4d910084e94cbab872bf955b3630ae681efa2b7def219a4bdf0b89" ;
    cof:pageNumber "304"^^xsd:integer ;
    skos:note "Employer must provide benefits to dismissed person" ;
    dc:description "Benefits" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.304" ;
