concept:fair-work-act-2009-sec-768bt a cml:Concept ;
    skos:prefLabel "768BT Contravening a take-home pay order"@en ;
    cml:realizedBy doc:sec-768bt ;
    values:originalText "A person must not contravene a term of a take-home pay order that applies to the person. Note: This section is a civil remedy provision (see Part 4-1)." ;
    skos:definition "A person must not contravene a term of a take-home pay order that applies to the person. Note: This section is a civil remedy provision (see Part 4-1)."@en ;
