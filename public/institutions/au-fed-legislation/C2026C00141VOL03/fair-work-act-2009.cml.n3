concept:fair-work-act-2009-sec-544 a cml:Concept ;
    skos:prefLabel "544 Time limit on applications"@en ;
    cml:realizedBy doc:sec-544 ;
    values:originalText "A person may apply for an order under this Division in relation to a contravention of one of the following only if the application is made within 6 years after the day on which the contravention occurred: (a) a civil remedy provision; (b) a safety net contractual entitlement; (c) an entitlement arising under subsection 542(1). Note 1: This section does not apply in relation to general protections court applications, sexual harassment court applications or unlawful termination court applications (see subparagraphs 370(a)(ii), 527T(1)(a)(ii) and 778(a)(ii)). Note 2: For time limits on orders relating to underpayments, see subsection 545(5). Subdivision B—Orders" ;
    skos:definition "A person may apply for an order under this Division in relation to a contravention of one of the following only if the application is made within 6 years after the day on which the contravention occurred: (a) a civil remedy provision; (b) a safety net contractual entitlement; (c) an entitlement arising under subsection 542(1). Note 1: This section does not apply in relation to general protections court applications, sexual harassment court applications or unlawful termination court applications (see subparagraphs 370(a)(ii), 527T(1)(a)(ii) and 778(a)(ii)). Note 2: For time limits on orders relating to underpayments, see subsection 545(5). Subdivision B—Orders"@en ;
    cml:integrityHash "0ec69be5a626d832a56cb4bf9005c36ff288e1947de5abdeb00f4c8c98819078" ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Time limit for applications related to contraventions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.124" ;
