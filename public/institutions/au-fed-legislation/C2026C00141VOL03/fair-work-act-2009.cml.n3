concept:fair-work-act-2009-sec-718a-ss-1 cml:asserts concept:fair-work-act-2009-sec-718a-ss-1-logic-diffusion-5 .
concept:fair-work-act-2009-sec-718a-ss-1-logic-diffusion-5 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "None" ;
    cml:logicSummary "No diffusion of responsibility applies in this context." ;
    cml:premiseText "The person is the sole responsible party for providing accurate information." ;
    cml:conclusionText "The person must not give information or produce a document." ;
    cml:executionSurface "modalities::diffusion" ;
