doc:sec-789cd-ss-4 a cof:Section ;
    cof:title "789CD(4) Court order for entity to pay amount demanded" ;
    values:kind "subsection" ;
    values:originalText "(4) Subject only to subsections (5) and (6), the court may make an order requiring the entity to pay, to the outworker or to another person on the outworker’s behalf, the specified amount (or so much of that amount as the applicant alleges is still owing)." ;
    cof:pageNumber "407"^^xsd:integer .

concept:fair-work-act-2009-sec-789cd-ss-5 a cml:Concept ;
    skos:prefLabel "789CD(5) Court order for entity to pay amount demanded"@en ;
    cml:realizedBy doc:sec-789cd-ss-5 ;
    values:originalText "(5) The court must not make an order under subsection (4) if the entity satisfies the court that the entity is not liable under section 789CB to pay any of the specified amount.  Chapter 6  Miscellaneous" ;
    skos:definition "(5) The court must not make an order under subsection (4) if the entity satisfies the court that the entity is not liable under section 789CB to pay any of the specified amount.  Chapter 6  Miscellaneous"@en ;
    cml:integrityHash "bb8826f6705cd01f308a6fc13b6f54e6123783198b084ae26929c4d73a466c49" ;
    values:partOf concept:fair-work-act-2009-sec-789cd ;
    cof:pageNumber "407"^^xsd:integer ;
