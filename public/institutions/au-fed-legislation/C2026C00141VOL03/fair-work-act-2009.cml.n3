doc:sec-761 a cof:Section ;
    cof:title "761 References to the National Employment Standards include" ;
    values:kind "section" ;
    values:originalText "extended notice of termination provisions A reference in this Act, or another law of the Commonwealth, to the National Employment Standards includes a reference to the extended notice of termination provisions." ;
    cof:pageNumber "328"^^xsd:integer .

concept:fair-work-act-2009-sec-762 a cml:Concept ;
    skos:prefLabel "762 State and Territory laws that are not excluded"@en ;
    cml:realizedBy doc:sec-762 ;
    values:originalText "This Act is not intended to apply to the exclusion of laws of a State or Territory that provide employee entitlements relating to notice of termination of employment (or payment in lieu of notice), to the extent that those laws: (a) apply to non-national system employees; and (b) provide entitlements for those employees that are more beneficial than the entitlements under the extended notice of termination provisions. Subdivision B—Modifications of the extended notice of termination provisions" ;
    skos:definition "This Act is not intended to apply to the exclusion of laws of a State or Territory that provide employee entitlements relating to notice of termination of employment (or payment in lieu of notice), to the extent that those laws: (a) apply to non-national system employees; and (b) provide entitlements for those employees that are more beneficial than the entitlements under the extended notice of termination provisions. Subdivision B—Modifications of the extended notice of termination provisions"@en ;
