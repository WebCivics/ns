concept:fair-work-act-2009-sec-745 a cml:Concept ;
    skos:prefLabel "745 Contravening the extended parental leave provisions"@en ;
    cml:realizedBy doc:sec-745 ;
    values:originalText "A non-national system employer must not contravene the extended parental leave provisions. Note: This section is a civil remedy provision (see Part 4-1)." ;
