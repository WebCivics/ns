concept:fair-work-act-2009-sec-661 a cml:Concept ;
    skos:prefLabel "661 Remuneration of the General Manager"@en ;
    cml:realizedBy doc:sec-661 ;
    values:originalText "(1) The General Manager is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the General Manager is to be paid the remuneration that is prescribed by the regulations.  Chapter 5  Administration" ;
    skos:definition "(1) The General Manager is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the General Manager is to be paid the remuneration that is prescribed by the regulations.  Chapter 5  Administration"@en ;
    cml:integrityHash "b99dac2a54f1adb9e30e7d9bede0103e419a7552021d9c113914f4baf2abdc3f" ;
    cof:pageNumber "243"^^xsd:integer ;
    skos:note "General Manager must be paid remuneration determined by the Remuneration Tribunal or prescribed by regulations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
