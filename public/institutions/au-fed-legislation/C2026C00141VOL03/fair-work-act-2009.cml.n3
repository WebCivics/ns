    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-730-ss-1 a cof:Section ;
    cof:title "730(1) Unlawful termination FWC applications" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if: (a) an unlawful termination FWC application has been made by, or on behalf of, the person in relation to the dismissal; and (b) the application has not: (i) been withdrawn by the person who made the application; or (ii) failed for want of jurisdiction; or (iii) resulted in the issue of a certificate under paragraph 776(3)(a) (which provides for the FWC to issue a certificate if the FWC is satisfied that all reasonable attempts to resolve a dispute (other than by arbitration) have been, or are likely to be, unsuccessful)." ;
    cof:pageNumber "302"^^xsd:integer .

concept:fair-work-act-2009-sec-730-ss-1a a cml:Concept ;
    skos:prefLabel "730(1A) Unlawful termination FWC applications"@en ;
    cml:realizedBy doc:sec-730-ss-1a ;
    values:originalText "(1A) This section also applies if:  Miscellaneous  Chapter 6 Multiple actions  Part 6-1 Preventing multiple actions  Division 3 Section 731 Fair Work Act 2009 Compilation date: 02/04/2026 (a) an unlawful termination FWC application has been made by, or on behalf of, the person in relation to the dismissal; and (b) the application has not: (i) been withdrawn by the person who made the application; or (ii) failed for want of jurisdiction; and (c) a certificate in relation to the dispute has been issued by the FWC under paragraph 776(3)(a) (which provides for the FWC to issue a certificate if the FWC is satisfied that all reasonable attempts to resolve a dispute (other than by arbitration) have been, or are likely to be, unsuccessful); and (d) a notification of the parties’ agreement to the FWC arbitrating the dispute has been made as referred to in paragraphs 777(1)(b) and (c)." ;
    skos:definition "(1A) This section also applies if:  Miscellaneous  Chapter 6 Multiple actions  Part 6-1 Preventing multiple actions  Division 3 Section 731 Fair Work Act 2009 Compilation date: 02/04/2026 (a) an unlawful termination FWC application has been made by, or on behalf of, the person in relation to the dismissal; and (b) the application has not: (i) been withdrawn by the person who made the application; or (ii) failed for want of jurisdiction; and (c) a certificate in relation to the dispute has been issued by the FWC under paragraph 776(3)(a) (which provides for the FWC to issue a certificate if the FWC is satisfied that all reasonable attempts to resolve a dispute (other than by arbitration) have been, or are likely to be, unsuccessful); and (d) a notification of the parties’ agreement to the FWC arbitrating the dispute has been made as referred to in paragraphs 777(1)(b) and (c)."@en ;
    cml:integrityHash "ba8ec7833b13f34a43d9bcedf4f35ec17152adba0ae0c195f6d739b44c755dc0" ;
    values:partOf concept:fair-work-act-2009-sec-730 ;
    cof:pageNumber "302"^^xsd:integer ;
    skos:note "Unlawful termination FWC applications must be made by the person in relation to the dismissal and not withdrawn or failed for jurisdiction." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.302" ;
