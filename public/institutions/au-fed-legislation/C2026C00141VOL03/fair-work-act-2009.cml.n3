    cml:modality cml:Diffusion ;
    cml:operator "Propagation" ;
    cml:logicSummary "Consent propagates to all parties involved" ;
    cml:premiseText "The Fair Work Ombudsman's consent is binding on all parties to the cooperation agreement." ;
    cml:conclusionText "The consent granted by the Fair Work Ombudsman propagates to all parties involved in the cooperation agreement." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

