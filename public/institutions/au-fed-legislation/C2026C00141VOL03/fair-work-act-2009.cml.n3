concept:fair-work-act-2009-sec-712d a cml:Concept ;
    skos:prefLabel "712D Protection from liability relating to FWO notices"@en ;
    cml:realizedBy doc:sec-712d ;
    values:originalText "A person who, in good faith, gives information, produces a record or document, or answers a question, when required to do so under an FWO notice is not liable to: (a) any proceedings for contravening any other law because of that conduct; or (b) civil proceedings for loss, damage or injury of any kind suffered by another person because of that conduct." ;
    skos:definition "A person who, in good faith, gives information, produces a record or document, or answers a question, when required to do so under an FWO notice is not liable to: (a) any proceedings for contravening any other law because of that conduct; or (b) civil proceedings for loss, damage or injury of any kind suffered by another person because of that conduct."@en ;
    cml:integrityHash "0f909d3c4c1f0fa784f1b3e226fa82ae0674b6fac43ebfbf90e0b1b3f3f40f47" ;
    cof:pageNumber "279"^^xsd:integer ;
    skos:note "Protection from liability for providing information under FWO notices" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
