concept:fair-work-act-2009-sec-632 a cml:Concept ;
    skos:prefLabel "632 Dual federal and Territory appointments of Deputy Presidents"@en ;
    cml:realizedBy doc:sec-632 ;
    values:originalText "or Commissioners Nothing in this Act prevents a Deputy President or Commissioner from being appointed to, and holding at the same time, one of the following offices, with the President’s approval: (a) an office as a member of a Commonwealth or Territory tribunal prescribed by the regulations (other than a court); (b) an office under a Commonwealth or Territory law." ;
    skos:definition "or Commissioners Nothing in this Act prevents a Deputy President or Commissioner from being appointed to, and holding at the same time, one of the following offices, with the President’s approval: (a) an office as a member of a Commonwealth or Territory tribunal prescribed by the regulations (other than a court); (b) an office under a Commonwealth or Territory law."@en ;
    cml:integrityHash "98cb4b6ade251043ee7d674aea7e80124f1a31aab81755494cef258889ce5b07" ;
    cof:pageNumber "218"^^xsd:integer ;
    skos:note "Deputy President or Commissioner may hold additional offices with President's approval." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.218" ;
