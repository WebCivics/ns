concept:fair-work-act-2009-sec-757e a cml:Concept ;
    skos:prefLabel "757E State and Territory laws that are not excluded"@en ;
    cml:realizedBy doc:sec-757e ;
    values:originalText "This Act is not intended to apply to the exclusion of laws of a State or Territory that provide employee entitlements in relation to family and domestic violence, to the extent that those laws: (a) apply to non-national system employees; and (b) provide entitlements for those employees that are more beneficial than the entitlements under the extended paid family and domestic violence leave provisions. Subdivision B—Modifications of the extended paid family and domestic violence leave provisions" ;
    skos:definition "This Act is not intended to apply to the exclusion of laws of a State or Territory that provide employee entitlements in relation to family and domestic violence, to the extent that those laws: (a) apply to non-national system employees; and (b) provide entitlements for those employees that are more beneficial than the entitlements under the extended paid family and domestic violence leave provisions. Subdivision B—Modifications of the extended paid family and domestic violence leave provisions"@en ;
    cml:integrityHash "abc9351eec429cd625093f480f0eba9f33f0ecd97894e2845b05b8ddea59d99a" ;
    cof:pageNumber "324"^^xsd:integer ;
    skos:note "Exclusion of State laws on employee entitlements related to family and domestic violence." ;
    cml:curationStatus cml:Proposed ;
