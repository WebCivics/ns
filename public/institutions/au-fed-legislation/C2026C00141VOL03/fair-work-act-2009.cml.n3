doc:sec-536qn-ss-1 a cof:Section ;
    cof:title "536QN(1) Finalising draft order" ;
    values:kind "subsection" ;
    values:originalText "(1) The FWC may make any changes it thinks appropriate to a draft road transport contractual chain order as proposed to be varied." ;
    cof:pageNumber "78"^^xsd:integer .

concept:fair-work-act-2009-sec-536qn-ss-2 a cml:Concept ;
    skos:prefLabel "536QN(2) Finalising draft order"@en ;
    cml:realizedBy doc:sec-536qn-ss-2 ;
    values:originalText "(2) If changes proposed to be made under subsection (1) are significant, the FWC must: (a) decide not to vary the road transport contractual chain order based on the draft; and (b) publish a subsequent notice of intent under paragraph 536QL(1)(a) in relation to the revised draft road transport contractual chain order, and publish the revised draft; and (c) follow the process set out in section 536QM (as affected by subsection (3) or (4) of this section) in relation to the revised draft road transport contractual chain order." ;
    skos:definition "(2) If changes proposed to be made under subsection (1) are significant, the FWC must: (a) decide not to vary the road transport contractual chain order based on the draft; and (b) publish a subsequent notice of intent under paragraph 536QL(1)(a) in relation to the revised draft road transport contractual chain order, and publish the revised draft; and (c) follow the process set out in section 536QM (as affected by subsection (3) or (4) of this section) in relation to the revised draft road transport contractual chain order."@en ;
    cml:integrityHash "f8a37601c4b760fa1147aa78d489e6c117d314322dbcc8b49ed7b5b24790eb93" ;
    values:partOf concept:fair-work-act-2009-sec-536qn ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "FWC must decide not to vary the road transport contractual chain order based on a revised draft, publish a subsequent notice of intent, and follow a process." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
