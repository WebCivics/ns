concept:fair-work-act-2009-sec-768ah a cml:Concept ;
    skos:prefLabel "768AH What is a copied State instrument?"@en ;
    cml:realizedBy doc:sec-768ah ;
    values:originalText "A copied State instrument for a transferring employee is the following: (a) a copied State award for the employee; (b) a copied State employment agreement for the employee." ;
    skos:definition "A copied State instrument for a transferring employee is the following: (a) a copied State award for the employee; (b) a copied State employment agreement for the employee."@en ;
    cml:integrityHash "8da207b32451c527fc90717942174d52b5d0dacea89ae030edb12110c4329ead" ;
    cof:pageNumber "335"^^xsd:integer ;
    skos:note "A copied State instrument for a transferring employee is defined." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.335" ;
