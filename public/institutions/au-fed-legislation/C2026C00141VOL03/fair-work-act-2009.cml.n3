    cof:pageNumber "59"^^xsd:integer .

concept:fair-work-act-2009-sec-536px a cml:Concept ;
    skos:prefLabel "536PX Minister may make a declaration suspending a road"@en ;
    cml:realizedBy doc:sec-536px ;
    values:originalText "transport contractual chain order (1) If the Minister considers it is in the public interest to do so, the Minister may, by notifiable instrument, make a declaration (a suspension declaration): (a) suspending the operation of a road transport contractual chain order; or (b) suspending the application of:  Chapter 3B  Minimum standards for persons in a road transport contractual chain" ;
    skos:definition "transport contractual chain order (1) If the Minister considers it is in the public interest to do so, the Minister may, by notifiable instrument, make a declaration (a suspension declaration): (a) suspending the operation of a road transport contractual chain order; or (b) suspending the application of:  Chapter 3B  Minimum standards for persons in a road transport contractual chain"@en ;
    cml:integrityHash "f04e4969d2c162617598b30388f95666377722afa69a17ea1d495636d83d4efd" ;
    cof:pageNumber "59"^^xsd:integer ;
    skos:note "Minister may make a declaration suspending a road transport contractual chain order" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
