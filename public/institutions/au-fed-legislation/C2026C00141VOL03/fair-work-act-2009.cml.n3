doc:sec-768au-ss-2 a cof:Section ;
    cof:title "768AU(2) Enterprise agreements and copied State instruments" ;
    values:kind "subsection" ;
    values:originalText "(2) However, if after the re-employment time, another enterprise agreement starts to cover the employee and the new employer in relation to the transferring work, then the copied State instrument for the employee ceases to cover the employee and the new employer and can never cover them again." ;
    cof:pageNumber "348"^^xsd:integer .

