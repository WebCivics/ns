    skos:prefLabel "546(4) Pecuniary penalty orders"@en ;
    cml:realizedBy doc:sec-546-ss-4 ;
    values:originalText "(4) The pecuniary penalty may be recovered as a debt due to the person to whom the penalty is payable. No limitation on orders" ;
