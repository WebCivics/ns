concept:fair-work-act-2009-sec-536np a cml:Concept ;
    skos:prefLabel "536NP Contravening a road transport contractual chain order"@en ;
    cml:realizedBy doc:sec-536np ;
    values:originalText "A person must not contravene a term of a road transport contractual chain order. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a road transport contractual chain order unless the order applies to the person: see subsection 536NQ(1)." ;
    skos:definition "A person must not contravene a term of a road transport contractual chain order. Note 1: This section is a civil remedy provision (see Part 4-1). Note 2: A person does not contravene a term of a road transport contractual chain order unless the order applies to the person: see subsection 536NQ(1)."@en ;
    cml:integrityHash "39cc49540ccbb9d943a6c8cc656780220a3eba017b36905d21779b40b4cdeae5" ;
    cof:pageNumber "32"^^xsd:integer ;
