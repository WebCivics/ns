    cml:premiseText "The subsection includes non-time-sensitive road transport contractual chain orders." ;
    cml:conclusionText "Non-time-sensitive road transport contractual chain orders are included in the subsection." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-536pq-ss-2 a cof:Section ;
    cof:title "536PQ(2) Terms that may be included in a road transport contractual" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not limit the terms that may be included in a road transport contractual chain order that is not a time-sensitive road transport contractual chain order." ;
    cof:pageNumber "51"^^xsd:integer .

concept:fair-work-act-2009-sec-536pq-ss-3 a cml:Concept ;
    skos:prefLabel "536PQ(3) Terms that may be included in a road transport contractual"@en ;
    cml:realizedBy doc:sec-536pq-ss-3 ;
    values:originalText "(3) The FWC must remove a term covered by this section that is included in a road transport contractual chain order if: (a) the FWC decides to vary the order as a result of an application for a determination varying or revoking the order that is an emergency application; and  Chapter 3B  Minimum standards for persons in a road transport contractual chain" ;
    skos:definition "(3) The FWC must remove a term covered by this section that is included in a road transport contractual chain order if: (a) the FWC decides to vary the order as a result of an application for a determination varying or revoking the order that is an emergency application; and  Chapter 3B  Minimum standards for persons in a road transport contractual chain"@en ;
    cml:integrityHash "6cd825f7bb475f86292bbbf40f495c96e3611316e8f8d9339be98c96b1da8a9f" ;
    values:partOf concept:fair-work-act-2009-sec-536pq ;
