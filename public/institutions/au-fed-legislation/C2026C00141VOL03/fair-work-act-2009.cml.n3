concept:fair-work-act-2009-sec-545-ss-1 cml:asserts concept:fair-work-act-2009-sec-545-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-545-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits making orders if a person has contravened a civil remedy provision." ;
    cml:premiseText "The court may make any order the court considers appropriate." ;
    cml:conclusionText "If a person has contravened a civil remedy provision, the court may not make an order." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-545-ss-1 cml:asserts concept:fair-work-act-2009-sec-545-ss-1-logic-deontic-2 .
concept:fair-work-act-2009-sec-545-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits granting injunctions in relation to industrial action under subsections 417(3) and 421(3)." ;
    cml:premiseText "The Federal Court and the Federal Circuit and Family Court of Australia (Division 2) may grant injunctions in relation to industrial action." ;
    cml:conclusionText "Injunctions are not granted in relation to industrial action under subsections 417(3) and 421(3)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-545-ss-1 cml:asserts concept:fair-work-act-2009-sec-545-ss-1-logic-ltl-3 .
concept:fair-work-act-2009-sec-545-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Orders can be made if a person has contravened a civil remedy provision." ;
