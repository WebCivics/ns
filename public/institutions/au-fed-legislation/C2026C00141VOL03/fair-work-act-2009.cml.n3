doc:sec-651-ss-2 a cof:Section ;
    cof:title "651(2) Seals" ;
    values:kind "subsection" ;
    values:originalText "(2) There are to be such duplicates of the seal of the FWC as the President directs. Note: The President gives directions under section 582." ;
    cof:pageNumber "237"^^xsd:integer .

