concept:fair-work-act-2009-sec-712ad-ss-5 a cml:Concept ;
    skos:prefLabel "712AD(5) Fair Work Ombudsman may give FWO notice to person in"@en ;
    cml:realizedBy doc:sec-712ad-ss-5 ;
    values:originalText "(5) A later time notified under subsection (3) or (4) must be at least 14 days after the FWO notice is given to the person." ;
