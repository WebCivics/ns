    cml:modality cml:Deontic ;
    cml:operator "must be enforced" ;
    cml:logicSummary "The employee or another person must enforce the copied State award." ;
    cml:premiseText "...it will not be enforceable by the employee or another person (for example, the new employer) unless and until it applies to the employee or other person." ;
    cml:conclusionText "...then the State’s interaction rules that were in force immediately before the termination time apply for the purposes of working out the interaction between the copied State award and the copied State employment agreement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-768ai cml:asserts concept:fair-work-act-2009-sec-768ai-logic-deontic-5 .
