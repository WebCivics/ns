    cml:conclusionText "Orders are recurring if a person has contravened a civil remedy provision." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-545-ss-1 cml:asserts concept:fair-work-act-2009-sec-545-ss-1-logic-deontic-4 .
