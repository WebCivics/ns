concept:fair-work-act-2009-sec-736 a cml:Concept ;
    skos:prefLabel "736 Meanings of employee and employer"@en ;
    cml:realizedBy doc:sec-736 ;
    values:originalText "In this Part, employee means a national system employee, and employer means a national system employer. Note: See also Division 2 of Part 6-4A (TCF contract outworkers taken to be employees in certain circumstances).  Miscellaneous  Chapter 6 Dealing with disputes  Part 6-2 Dealing with disputes  Division 2 Section 737 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "In this Part, employee means a national system employee, and employer means a national system employer. Note: See also Division 2 of Part 6-4A (TCF contract outworkers taken to be employees in certain circumstances).  Miscellaneous  Chapter 6 Dealing with disputes  Part 6-2 Dealing with disputes  Division 2 Section 737 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "7f3fe204c49842a004669e1d86957c7637bf50860654c394b30100ad34127684" ;
    cof:pageNumber "310"^^xsd:integer ;
