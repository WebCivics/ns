    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-781a-ss-2 a cof:Section ;
    cof:title "781A(2) Schedule of costs" ;
    values:kind "subsection" ;
    values:originalText "(2) If a schedule of costs is prescribed for the purposes of subsection (1), then, in awarding costs under section 611, 779A or 780 in relation to an application under section 773, the FWC: (a) is not limited to the items of expenditure appearing in the schedule; but (b) if an item does appear in the schedule—must not award costs in relation to that item at a rate or of an amount that exceeds the rate or amount appearing in the schedule." ;
    cof:pageNumber "392"^^xsd:integer .

concept:fair-work-act-2009-sec-782 a cml:Concept ;
    skos:prefLabel "782 Contravening costs orders"@en ;
    cml:realizedBy doc:sec-782 ;
    values:originalText "A person to whom an order for costs made under section 779A or 780 applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1)." ;
    skos:definition "A person to whom an order for costs made under section 779A or 780 applies must not contravene a term of the order. Note: This section is a civil remedy provision (see Part 4-1)."@en ;
