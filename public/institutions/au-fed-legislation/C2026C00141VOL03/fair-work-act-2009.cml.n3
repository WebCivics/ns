    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-698 a cof:Section ;
    cof:title "698 Persons assisting the Fair Work Ombudsman" ;
    values:kind "section" ;
    values:originalText "The Fair Work Ombudsman may also be assisted: (a) by employees of Agencies (within the meaning of the Public Service Act 1999); or (b) by officers and employees of a State or Territory; or (c) by officers and employees of authorities of the Commonwealth, a State or a Territory; whose services are made available to the Fair Work Ombudsman in connection with the performance of any of his or her functions. Note: For example, State or Territory employees could be made available to assist the Fair Work Ombudsman in providing education in a particular region." ;
    cof:pageNumber "264"^^xsd:integer .

concept:fair-work-act-2009-sec-699 a cml:Concept ;
    skos:prefLabel "699 Consultants"@en ;
    cml:realizedBy doc:sec-699 ;
    values:originalText "The Fair Work Ombudsman may engage persons having suitable qualifications and experience as consultants to the Office of the Fair Work Ombudsman.  Administration  Chapter 5 Office of the Fair Work Ombudsman  Part 5-2 Office of the Fair Work Ombudsman  Division 3 Section 700 Fair Work Act 2009 Compilation date: 02/04/2026 Subdivision C—Appointment of Fair Work Inspectors" ;
    skos:definition "The Fair Work Ombudsman may engage persons having suitable qualifications and experience as consultants to the Office of the Fair Work Ombudsman.  Administration  Chapter 5 Office of the Fair Work Ombudsman  Part 5-2 Office of the Fair Work Ombudsman  Division 3 Section 700 Fair Work Act 2009 Compilation date: 02/04/2026 Subdivision C—Appointment of Fair Work Inspectors"@en ;
