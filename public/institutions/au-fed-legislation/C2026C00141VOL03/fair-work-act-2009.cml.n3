concept:fair-work-act-2009-sec-620 a cml:Concept ;
    skos:prefLabel "620 Constitution and decision-making of an Expert Panel"@en ;
    cml:realizedBy doc:sec-620 ;
    values:originalText "Constitution of an Expert Panel for annual wage reviews (1) An Expert Panel constituted under this subsection for the purpose of an annual wage review conducted under Part 2-6 consists of 7 FWC Members (except as provided by section 622), and must include: (a) the President; and (b) 3 Expert Panel Members who have knowledge of, or experience in, one or more of the following fields: (i) workplace relations; (ii) economics; (iii) social policy; (iv) business, industry or commerce.  Chapter 5  Administration" ;
    skos:definition "Constitution of an Expert Panel for annual wage reviews (1) An Expert Panel constituted under this subsection for the purpose of an annual wage review conducted under Part 2-6 consists of 7 FWC Members (except as provided by section 622), and must include: (a) the President; and (b) 3 Expert Panel Members who have knowledge of, or experience in, one or more of the following fields: (i) workplace relations; (ii) economics; (iii) social policy; (iv) business, industry or commerce.  Chapter 5  Administration"@en ;
    cml:integrityHash "865daf76a74f47aaf129f035a95601c455ab7a9007171d3636de0ba777b4b217" ;
    cof:pageNumber "205"^^xsd:integer ;
    skos:note "Expert Panel must consist of 7 FWC Members with specific knowledge and experience." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.205" ;
