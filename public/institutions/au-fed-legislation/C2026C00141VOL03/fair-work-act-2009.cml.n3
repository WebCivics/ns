    cml:premiseText "(2) Before the Governor-General appoints a person under subsection (1) or (1A), the Minister must be satisfied that the appointment is necessary to enable the FWC to perform its functions effectively." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

