doc:sec-536qm-ss-1a a cof:Section ;
    cof:title "536QM(1A) Affected entities to have a reasonable opportunity to make" ;
    values:kind "subsection" ;
    values:originalText "(1A) To avoid doubt, if the proposed variation or revocation is of a time-sensitive road transport contractual chain order, a short period to make written submissions may be a reasonable opportunity." ;
    cof:pageNumber "76"^^xsd:integer .

