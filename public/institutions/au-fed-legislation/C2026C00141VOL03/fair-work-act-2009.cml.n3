concept:fair-work-act-2009-sec-760 a cml:Concept ;
    skos:prefLabel "760 Contravening the extended notice of termination provisions"@en ;
    cml:realizedBy doc:sec-760 ;
    values:originalText "A non-national system employer must not contravene the extended notice of termination provisions.  Chapter 6  Miscellaneous" ;
