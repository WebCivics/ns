concept:fair-work-act-2009-sec-536pp a cml:Concept ;
    skos:prefLabel "536PP Term about settling disputes must be included in a road"@en ;
    cml:realizedBy doc:sec-536pp ;
    values:originalText "transport contractual chain order A road transport contractual chain order must include a term that provides a procedure for settling disputes about any matters arising under the order." ;
    skos:definition "transport contractual chain order A road transport contractual chain order must include a term that provides a procedure for settling disputes about any matters arising under the order."@en ;
