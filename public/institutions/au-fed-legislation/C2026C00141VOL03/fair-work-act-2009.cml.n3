concept:fair-work-act-2009-sec-768aw a cml:Concept ;
    skos:prefLabel "768AW Variation in limited circumstances"@en ;
    cml:realizedBy doc:sec-768aw ;
    values:originalText "A copied State instrument for a transferring employee cannot be varied except under: (a) section 768AX; or (b) item 20 of Schedule 3A to the Transitional Act (which deals with variation of discriminatory instruments) as that item has effect because of section 768BY; or (c) item 20 of Schedule 9 to the Transitional Act (which deals with variation of instruments in annual wage reviews) as that item has effect because of section 768BY; or (d) Division 4 of Part 3 of Schedule 11 to the Transitional Act (which deals with transfer of business) as that Division has effect because of section 768BY." ;
    skos:definition "A copied State instrument for a transferring employee cannot be varied except under: (a) section 768AX; or (b) item 20 of Schedule 3A to the Transitional Act (which deals with variation of discriminatory instruments) as that item has effect because of section 768BY; or (c) item 20 of Schedule 9 to the Transitional Act (which deals with variation of instruments in annual wage reviews) as that item has effect because of section 768BY; or (d) Division 4 of Part 3 of Schedule 11 to the Transitional Act (which deals with transfer of business) as that Division has effect because of section 768BY."@en ;
    cml:integrityHash "ed40f632ff8fbcbd58cfa73f43bfbb8bad2173ce7d1c3f6e3c57bbc2b79aa340" ;
    cof:pageNumber "349"^^xsd:integer ;
    skos:note "Variation of copied State instrument for transferring employee is restricted" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
