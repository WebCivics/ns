concept:fair-work-act-2009-sec-698 a cml:Concept ;
    skos:prefLabel "698 Persons assisting the Fair Work Ombudsman"@en ;
    cml:realizedBy doc:sec-698 ;
    values:originalText "The Fair Work Ombudsman may also be assisted: (a) by employees of Agencies (within the meaning of the Public Service Act 1999); or (b) by officers and employees of a State or Territory; or (c) by officers and employees of authorities of the Commonwealth, a State or a Territory; whose services are made available to the Fair Work Ombudsman in connection with the performance of any of his or her functions. Note: For example, State or Territory employees could be made available to assist the Fair Work Ombudsman in providing education in a particular region." ;
    skos:definition "The Fair Work Ombudsman may also be assisted: (a) by employees of Agencies (within the meaning of the Public Service Act 1999); or (b) by officers and employees of a State or Territory; or (c) by officers and employees of authorities of the Commonwealth, a State or a Territory; whose services are made available to the Fair Work Ombudsman in connection with the performance of any of his or her functions. Note: For example, State or Territory employees could be made available to assist the Fair Work Ombudsman in providing education in a particular region."@en ;
    cml:integrityHash "c17fe7430a7cc93e52773449f6295c100ef4586ed72a7f373edfec4e5bc836e9" ;
    cof:pageNumber "264"^^xsd:integer ;
    skos:note "The Fair Work Ombudsman may be assisted by employees of certain agencies and authorities." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
