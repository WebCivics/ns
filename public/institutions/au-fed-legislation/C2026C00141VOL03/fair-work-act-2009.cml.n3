concept:fair-work-act-2009-sec-717e a cml:Concept ;
    skos:prefLabel "717E Withdrawal from cooperation agreement"@en ;
    cml:realizedBy doc:sec-717e ;
    values:originalText "A person that is party to a cooperation agreement with the Fair Work Ombudsman may withdraw from the agreement, but only with the consent of the Fair Work Ombudsman." ;
    skos:definition "A person that is party to a cooperation agreement with the Fair Work Ombudsman may withdraw from the agreement, but only with the consent of the Fair Work Ombudsman."@en ;
    cml:integrityHash "4288d530cdc4ee94cca8ff0358bff152967552d6f58e54bf0fd3d9d53f51ca70" ;
    cof:pageNumber "292"^^xsd:integer ;
    skos:note "Consent required for withdrawal from cooperation agreement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.292" ;
    cml:asserts concept:fair-work-act-2009-sec-717e-norm .
