    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "FWC must make or vary a road transport contractual chain order after genuine engagement with parties and consultation with the Road Transport Advisory Group." ;
    cml:premiseText "(2) The FWC: (a) must not make or vary the road transport contractual chain order unless there has been genuine engagement with the parties to be covered;" ;
    cml:conclusionText "FWC must make or vary a road transport contractual chain order after genuine engagement with parties and consultation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

