concept:fair-work-act-2009-sec-768bx a cml:Concept ;
    skos:prefLabel "768BX Modification of this Act for copied State instruments"@en ;
    cml:realizedBy doc:sec-768bx ;
    values:originalText "This Act has effect in relation to a transferring employee on and after the employee’s re-employment time as if a reference in a provision referred to in column 1 to a term referred to in column 2 included a reference to the term referred to in column 3.  Miscellaneous  Chapter 6 Transfer of business from a State public sector employer  Part 6-3A Special rules for copied State instruments  Division 8 Section 768BX Fair Work Act 2009 Compilation date: 02/04/2026 Modification of this Act for copied State instruments Item Column 1 Provision of this Act Column 2 Current term Column 3 New term Division 2 of Part 2-9 (payment of wages) modern award copied State award for the transferring employee Division 2 of Part 2-9 (payment of wages) enterprise agreement copied State employment agreement for the transferring employee Division 3 of Part 2-9 (guarantee of annual earnings) modern award copied State award for the transferring employee Division 3 of Part 2-9 (guarantee of annual earnings) enterprise agreement copied State employment agreement for the transferring employee" ;
    skos:definition "This Act has effect in relation to a transferring employee on and after the employee’s re-employment time as if a reference in a provision referred to in column 1 to a term referred to in column 2 included a reference to the term referred to in column 3.  Miscellaneous  Chapter 6 Transfer of business from a State public sector employer  Part 6-3A Special rules for copied State instruments  Division 8 Section 768BX Fair Work Act 2009 Compilation date: 02/04/2026 Modification of this Act for copied State instruments Item Column 1 Provision of this Act Column 2 Current term Column 3 New term Division 2 of Part 2-9 (payment of wages) modern award copied State award for the transferring employee Division 2 of Part 2-9 (payment of wages) enterprise agreement copied State employment agreement for the transferring employee Division 3 of Part 2-9 (guarantee of annual earnings) modern award copied State award for the transferring employee Division 3 of Part 2-9 (guarantee of annual earnings) enterprise agreement copied State employment agreement for the transferring employee"@en ;
    cml:integrityHash "36c74a496b048dcac7ba447bbde5617e0de45004d57448488298ec83b5267358" ;
    cof:pageNumber "374"^^xsd:integer ;
    skos:note "Modifies the Act for copied State instruments" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
