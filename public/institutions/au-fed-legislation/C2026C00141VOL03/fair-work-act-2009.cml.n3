concept:fair-work-act-2009-sec-789ce-ss-8 a cml:Concept ;
    skos:prefLabel "789CE(8) Effect of payment by entity (including entity’s right to"@en ;
    cml:realizedBy doc:sec-789ce-ss-8 ;
    values:originalText "(8) Proceedings cannot be commenced under this section more than 6 years after the time when the entity paid the recoverable amount." ;
    skos:definition "(8) Proceedings cannot be commenced under this section more than 6 years after the time when the entity paid the recoverable amount."@en ;
    cml:integrityHash "1ce5294ea79e9d61a73162057382e31579b59f9e23a209331a0c6f95db02896d" ;
    values:partOf concept:fair-work-act-2009-sec-789ce ;
    cof:pageNumber "408"^^xsd:integer ;
    skos:note "No proceedings can be commenced more than 6 years after payment." ;
    cml:curationStatus cml:Proposed ;
