concept:fair-work-act-2009-sec-718a-ss-1 cml:asserts concept:fair-work-act-2009-sec-718a-ss-1-logic-deontic-2 .
concept:fair-work-act-2009-sec-718a-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Recklessness implies a duty to ensure accuracy." ;
    cml:premiseText "The person is reckless as to whether the information is false or misleading." ;
    cml:conclusionText "The person must not give information or produce a document." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-718a-ss-1 cml:asserts concept:fair-work-act-2009-sec-718a-ss-1-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-718a-ss-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal interval of recklessness implies a duty to ensure accuracy." ;
    cml:premiseText "The person is reckless as to whether the information is false or misleading for an unspecified period." ;
    cml:conclusionText "The person must not give information or produce a document." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
