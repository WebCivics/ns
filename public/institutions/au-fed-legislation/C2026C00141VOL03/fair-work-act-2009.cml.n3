concept:fair-work-act-2009-sec-774 a cml:Concept ;
    skos:prefLabel "774 Time for application"@en ;
    cml:realizedBy doc:sec-774 ;
    values:originalText "(1) An application under section 773 must be made: (a) within 21 days after the employment was terminated; or  Chapter 6  Miscellaneous" ;
    skos:definition "(1) An application under section 773 must be made: (a) within 21 days after the employment was terminated; or  Chapter 6  Miscellaneous"@en ;
