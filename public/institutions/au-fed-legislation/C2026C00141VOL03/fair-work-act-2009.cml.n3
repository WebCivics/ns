concept:fair-work-act-2009-sec-536qs a cml:Concept ;
    skos:prefLabel "536QS Road transport contractual chain guidelines not to be made"@en ;
    cml:realizedBy doc:sec-536qs ;
    values:originalText "if a road transport contractual chain order is in operation The FWC must not make road transport contractual chain guidelines that cover the same persons in a road transport contractual chain in relation to the same matters as a road transport contractual chain order that is in operation.  Minimum standards for persons in a road transport contractual chain  Chapter 3B Minimum standards for persons in a road transport contractual chain  Part 3B-2 Road transport contractual chain guidelines  Division 5 Section 536QT Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "if a road transport contractual chain order is in operation The FWC must not make road transport contractual chain guidelines that cover the same persons in a road transport contractual chain in relation to the same matters as a road transport contractual chain order that is in operation.  Minimum standards for persons in a road transport contractual chain  Chapter 3B Minimum standards for persons in a road transport contractual chain  Part 3B-2 Road transport contractual chain guidelines  Division 5 Section 536QT Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "478070c1b946a680b4c4cfd1f5c8fbb71a0f75878b34b131e45a33ac08bc0776" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "FWC must not make road transport contractual chain guidelines that cover the same persons in a road transport contractual chain in relation to the same matters as a road transport contractual chain order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
