doc:sec-789cd-ss-3 a cof:Section ;
    cof:title "789CD(3) Court order for entity to pay amount demanded" ;
    values:kind "subsection" ;
    values:originalText "(3) The proceedings may be commenced in: (a) the Federal Court; or (b) the Federal Circuit and Family Court of Australia (Division 2); or (c) an eligible State or Territory court." ;
    cof:pageNumber "407"^^xsd:integer .

concept:fair-work-act-2009-sec-789cd-ss-4 a cml:Concept ;
    skos:prefLabel "789CD(4) Court order for entity to pay amount demanded"@en ;
    cml:realizedBy doc:sec-789cd-ss-4 ;
    values:originalText "(4) Subject only to subsections (5) and (6), the court may make an order requiring the entity to pay, to the outworker or to another person on the outworker’s behalf, the specified amount (or so much of that amount as the applicant alleges is still owing)." ;
    skos:definition "(4) Subject only to subsections (5) and (6), the court may make an order requiring the entity to pay, to the outworker or to another person on the outworker’s behalf, the specified amount (or so much of that amount as the applicant alleges is still owing)."@en ;
