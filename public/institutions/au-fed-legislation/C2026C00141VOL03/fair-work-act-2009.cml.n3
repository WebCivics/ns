concept:fair-work-act-2009-sec-789ce-ss-6 a cml:Concept ;
    skos:prefLabel "789CE(6) Effect of payment by entity (including entity’s right to"@en ;
    cml:realizedBy doc:sec-789ce-ss-6 ;
    values:originalText "(6) In making the order the court must, on application, include an amount of interest in the sum ordered, unless good cause is shown to the contrary." ;
    skos:definition "(6) In making the order the court must, on application, include an amount of interest in the sum ordered, unless good cause is shown to the contrary."@en ;
    cml:integrityHash "91eb548710e22441f9e123c454fa737bd5da18b185a20fda36f6177202b1cb33" ;
    values:partOf concept:fair-work-act-2009-sec-789ce ;
    cof:pageNumber "408"^^xsd:integer ;
    skos:note "Court must include interest in sum ordered unless good cause is shown." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
