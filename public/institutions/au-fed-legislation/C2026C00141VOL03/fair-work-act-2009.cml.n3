concept:fair-work-act-2009-sec-768ap a cml:Concept ;
    skos:prefLabel "768AP What this Division is about"@en ;
    cml:realizedBy doc:sec-768ap ;
    values:originalText "This Division provides for how copied State instruments interact with the National Employment Standards, modern awards and enterprise agreements. Subdivision B—Interaction with the NES" ;
    skos:definition "This Division provides for how copied State instruments interact with the National Employment Standards, modern awards and enterprise agreements. Subdivision B—Interaction with the NES"@en ;
