doc:sec-789bb-ss-2 a cof:Section ;
    cof:title "789BB(2) TCF contract outworkers taken to be employees in certain" ;
    values:kind "subsection" ;
    values:originalText "(2) A TCF contract outworker is a TCF outworker who performs work other than as an employee." ;
