concept:fair-work-act-2009-sec-690 a cml:Concept ;
    skos:prefLabel "690 Outside work of the Fair Work Ombudsman"@en ;
    cml:realizedBy doc:sec-690 ;
    values:originalText "The Fair Work Ombudsman must not engage in paid work outside the duties of his or her office without the Minister’s approval." ;
    skos:definition "The Fair Work Ombudsman must not engage in paid work outside the duties of his or her office without the Minister’s approval."@en ;
