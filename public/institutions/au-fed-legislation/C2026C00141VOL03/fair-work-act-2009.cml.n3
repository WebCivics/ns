concept:fair-work-act-2009-sec-723 a cml:Concept ;
    skos:prefLabel "723 Unlawful termination applications"@en ;
    cml:realizedBy doc:sec-723 ;
    values:originalText "A person must not make an unlawful termination application in relation to conduct if the person is entitled to make a general protections court application in relation to the conduct.  Miscellaneous  Chapter 6 Multiple actions  Part 6-1 Preventing multiple actions  Division 3 Section 724 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "A person must not make an unlawful termination application in relation to conduct if the person is entitled to make a general protections court application in relation to the conduct.  Miscellaneous  Chapter 6 Multiple actions  Part 6-1 Preventing multiple actions  Division 3 Section 724 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "7319c05809a6bc33bac0ba6b12e715d31a1264102a32283f812bbaea0ceb5cd3" ;
    cof:pageNumber "298"^^xsd:integer ;
    skos:note "Making an unlawful termination application in relation to conduct is prohibited if the person can make a general protections court application." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
