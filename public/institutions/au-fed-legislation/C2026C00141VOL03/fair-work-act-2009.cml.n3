concept:fair-work-act-2009-sec-789gv-ss-5 a cml:Concept ;
    skos:prefLabel "789GV(5) FWC may deal with a dispute about the operation of this"@en ;
    cml:realizedBy doc:sec-789gv-ss-5 ;
    values:originalText "(5) The FWC must not make an order under paragraph (4)(a) or (c) on or after 29 March 2021." ;
