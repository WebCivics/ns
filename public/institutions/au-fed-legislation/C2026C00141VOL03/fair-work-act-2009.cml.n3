doc:sec-550-ss-2 a cof:Section ;
    cof:title "550(2) Involvement in contravention treated in same way as actual" ;
    values:kind "subsection" ;
    values:originalText "(2) A person is involved in a contravention of a civil remedy provision if, and only if, the person: (a) has aided, abetted, counselled or procured the contravention; or (b) has induced the contravention, whether by threats or promises or otherwise; or (c) has been in any way, by act or omission, directly or indirectly, knowingly concerned in or party to the contravention; or (d) has conspired with others to effect the contravention." ;
    cof:pageNumber "136"^^xsd:integer .

concept:fair-work-act-2009-sec-551 a cml:Concept ;
    skos:prefLabel "551 Civil evidence and procedure rules for proceedings relating to"@en ;
    cml:realizedBy doc:sec-551 ;
    values:originalText "civil remedy provisions A court must apply the rules of evidence and procedure for civil matters when hearing proceedings relating to a contravention, or proposed contravention, of a civil remedy provision.  Compliance and enforcement  Chapter 4 Civil remedies  Part 4-1 General provisions relating to civil remedies  Division 4 Section 552 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "civil remedy provisions A court must apply the rules of evidence and procedure for civil matters when hearing proceedings relating to a contravention, or proposed contravention, of a civil remedy provision.  Compliance and enforcement  Chapter 4 Civil remedies  Part 4-1 General provisions relating to civil remedies  Division 4 Section 552 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "ff786d5b14b634dbfbdfb4343dd7ce304053862212875a584df397d037557855" ;
    cof:pageNumber "136"^^xsd:integer ;
    skos:note "Court must apply rules of evidence and procedure for civil matters when hearing proceedings relating to a contravention or proposed contravention of a civil remedy provision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.136" ;
