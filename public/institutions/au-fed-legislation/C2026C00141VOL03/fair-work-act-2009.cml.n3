doc:sec-558a-ss-1 a cof:Section ;
    cof:title "558A(1) Meaning of franchisee entity and responsible franchisor entity" ;
    values:kind "subsection" ;
    values:originalText "(1) A person is a franchisee entity of a franchise if: (a) the person is a franchisee (including a subfranchisee) in relation to the franchise; and (b) the business conducted by the person under the franchise is substantially or materially associated with intellectual property relating to the franchise." ;
    cof:pageNumber "145"^^xsd:integer .

concept:fair-work-act-2009-sec-558a-ss-2 a cml:Concept ;
    skos:prefLabel "558A(2) Meaning of franchisee entity and responsible franchisor entity"@en ;
    cml:realizedBy doc:sec-558a-ss-2 ;
    values:originalText "(2) A person is a responsible franchisor entity for a franchisee entity of a franchise if: (a) the person is a franchisor (including a subfranchisor) in relation to the franchise; and (b) the person has a significant degree of influence or control over the franchisee entity’s affairs." ;
    skos:definition "(2) A person is a responsible franchisor entity for a franchisee entity of a franchise if: (a) the person is a franchisor (including a subfranchisor) in relation to the franchise; and (b) the person has a significant degree of influence or control over the franchisee entity’s affairs."@en ;
    cml:integrityHash "e9fd30fac3d34040f859cd0b6bbd9068edb38c47f5fdab3b1239e82cf1daae27" ;
    values:partOf concept:fair-work-act-2009-sec-558a ;
    cof:pageNumber "145"^^xsd:integer ;
    skos:note "Person is a responsible franchisor entity for a franchisee entity if they have significant influence or control over the franchisee's affairs." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
