concept:fair-work-act-2009-sec-651-ss-5 a cml:Concept ;
    skos:prefLabel "651(5) Seals"@en ;
    cml:realizedBy doc:sec-651-ss-5 ;
    values:originalText "(5) All courts, judges and persons acting judicially must: (a) take judicial notice of the imprint of the seal of the FWC appearing on a document; and (b) presume that the document was duly sealed.  Chapter 5  Administration" ;
    skos:definition "(5) All courts, judges and persons acting judicially must: (a) take judicial notice of the imprint of the seal of the FWC appearing on a document; and (b) presume that the document was duly sealed.  Chapter 5  Administration"@en ;
    cml:integrityHash "a930558dd0aaab92b47955b4ec73fc60e088b50030edb07776864cef9597e56b" ;
    values:partOf concept:fair-work-act-2009-sec-651 ;
    cof:pageNumber "237"^^xsd:integer ;
    skos:note "Courts, judges and persons acting judicially must take notice of the seal and presume it was sealed." ;
    cml:curationStatus cml:Proposed ;
