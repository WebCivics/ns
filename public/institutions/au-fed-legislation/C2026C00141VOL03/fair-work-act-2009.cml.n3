    cml:logicSummary "Obligation to obtain consent for withdrawal" ;
    cml:premiseText "The Fair Work Ombudsman has the power to grant or refuse consent." ;
    cml:conclusionText "A person must obtain consent from the Fair Work Ombudsman to withdraw from a cooperation agreement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
