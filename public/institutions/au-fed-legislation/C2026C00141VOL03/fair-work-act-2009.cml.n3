doc:sec-768az-ss-1 a cof:Section ;
    cof:title "768AZ(1) What this Division is about" ;
    values:kind "subsection" ;
    values:originalText "(1) This Division provides for orders to be made if there is, or is likely to be, a transfer of business." ;
