doc:sec-604-ss-1 a cof:Section ;
    cof:title "604(1) Appeal of decisions" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who is aggrieved by a decision: (a) made by the FWC (other than a decision of a Full Bench or an Expert Panel); or (b) made under the Registered Organisations Act by the General Manager (including a delegate of the General Manager); may appeal the decision, with the permission of the FWC." ;
    cof:pageNumber "185"^^xsd:integer .

concept:fair-work-act-2009-sec-604-ss-2 a cml:Concept ;
    skos:prefLabel "604(2) Appeal of decisions"@en ;
    cml:realizedBy doc:sec-604-ss-2 ;
    values:originalText "(2) Without limiting when the FWC may grant permission, the FWC must grant permission if the FWC is satisfied that it is in the public interest to do so.  Chapter 5  Administration" ;
    skos:definition "(2) Without limiting when the FWC may grant permission, the FWC must grant permission if the FWC is satisfied that it is in the public interest to do so.  Chapter 5  Administration"@en ;
    cml:integrityHash "accb99e0f8fb8d61823cf3eebba2804a6b691a04682279b6d8944669a37d862e" ;
    values:partOf concept:fair-work-act-2009-sec-604 ;
    cof:pageNumber "185"^^xsd:integer ;
    skos:note "FWC must grant permission if in public interest." ;
