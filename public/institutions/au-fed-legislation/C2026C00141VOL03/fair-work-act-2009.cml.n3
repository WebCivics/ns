doc:sec-608-ss-2 a cof:Section ;
    cof:title "608(2) Referring questions of law to the Federal Court" ;
    values:kind "subsection" ;
    values:originalText "(2) A question of law referred under subsection (1) must be determined by the Full Court of the Federal Court." ;
    cof:pageNumber "188"^^xsd:integer .

concept:fair-work-act-2009-sec-608-ss-3 a cml:Concept ;
    skos:prefLabel "608(3) Referring questions of law to the Federal Court"@en ;
    cml:realizedBy doc:sec-608-ss-3 ;
    values:originalText "(3) The FWC may make a decision in relation to the matter even if the Federal Court is determining the question of law, except if the question is whether the FWC may exercise powers in relation to the matter." ;
    skos:definition "(3) The FWC may make a decision in relation to the matter even if the Federal Court is determining the question of law, except if the question is whether the FWC may exercise powers in relation to the matter."@en ;
    cml:integrityHash "1759cde1ca500d963b5bc780b466ac6ddca2ba607e699cf2187b97cf6fc21c00" ;
