concept:fair-work-act-2009-sec-785-ss-4 a cml:Concept ;
    skos:prefLabel "785(4) Employer to notify Centrelink of certain proposed terminations"@en ;
    cml:realizedBy doc:sec-785-ss-4 ;
    values:originalText "(4) The employer must not terminate an employee’s employment in accordance with the decision unless the employer has complied with this section. Note: This subsection is a civil remedy provision (see Part 4-1)." ;
    skos:definition "(4) The employer must not terminate an employee’s employment in accordance with the decision unless the employer has complied with this section. Note: This subsection is a civil remedy provision (see Part 4-1)."@en ;
    cml:integrityHash "c54a6566f0eaacfc0ea808948cf18d85c9d2e4bb3fa349419758b6c07614d125" ;
    values:partOf concept:fair-work-act-2009-sec-785 ;
    cof:pageNumber "394"^^xsd:integer ;
