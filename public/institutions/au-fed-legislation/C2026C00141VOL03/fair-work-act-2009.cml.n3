concept:fair-work-act-2009-sec-650 a cml:Concept ;
    skos:prefLabel "650 Provision of administrative support"@en ;
    cml:realizedBy doc:sec-650 ;
    values:originalText "The President may make a written arrangement with a prescribed State industrial authority for: (a) the FWC to provide administrative support to the authority; or (b) the authority to provide administrative support to the FWC.  Administration  Chapter 5 The Fair Work Commission  Part 5-1 Seals and additional powers and functions of the President and the General Manager" ;
    skos:definition "The President may make a written arrangement with a prescribed State industrial authority for: (a) the FWC to provide administrative support to the authority; or (b) the authority to provide administrative support to the FWC.  Administration  Chapter 5 The Fair Work Commission  Part 5-1 Seals and additional powers and functions of the President and the General Manager"@en ;
    cml:integrityHash "f524a68eb73e6f5925a1fe2168c7682e18b4226b0364f801474ac51c4893b391" ;
    cof:pageNumber "236"^^xsd:integer ;
    skos:note "The President may make an arrangement with a State industrial authority for administrative support." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
