    cof:pageNumber "240"^^xsd:integer ;
    skos:note "General Manager may make written arrangement with Federal Court and Family Court of Australia for FWC to provide administrative support." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
