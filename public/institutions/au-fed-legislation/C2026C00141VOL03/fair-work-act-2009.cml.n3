    cml:operator "isDefinedBy" ;
    cml:logicSummary "The jurisdiction of the Federal Circuit and Family Court of Australia (Division 2) is defined by section 566." ;
    cml:premiseText "Section 567" ;
    cml:conclusionText "The jurisdiction of the Federal Circuit and Family Court of Australia (Division 2) is defined by section 566." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-567 a cof:Section ;
    cof:title "567 Exercising jurisdiction in the Fair Work Division of the Federal" ;
    values:kind "section" ;
    values:originalText "Circuit and Family Court of Australia (Division 2) Jurisdiction conferred on the Federal Circuit and Family Court of Australia (Division 2) under section 566 is to be exercised in the Fair Work Division of the Court if: (a) an application is made to the Court under this Act; or (b) an injunction is sought under section 140 of the Federal Circuit and Family Court of Australia Act 2021 in relation to a matter arising under this Act; or (c) a declaration is sought under section 141 of the Federal Circuit and Family Court of Australia Act 2021 in relation to a matter arising under this Act; or (d) proceedings in relation to a matter arising under this Act are transferred to the Federal Circuit and Family Court of Australia (Division 2) from the Federal Court; or (e) the High Court remits a matter arising under this Act to the Federal Circuit and Family Court of Australia (Division 2)." ;
    cof:pageNumber "157"^^xsd:integer .

concept:fair-work-act-2009-sec-568 a cml:Concept ;
    skos:prefLabel "568 No limitation on powers of the Federal Circuit and Family"@en ;
    cml:realizedBy doc:sec-568 ;
    values:originalText "Court of Australia (Division 2) To avoid doubt, nothing in this Act limits the powers of the Federal Circuit and Family Court of Australia (Division 2) under  Chapter 4  Compliance and enforcement" ;
    skos:definition "Court of Australia (Division 2) To avoid doubt, nothing in this Act limits the powers of the Federal Circuit and Family Court of Australia (Division 2) under  Chapter 4  Compliance and enforcement"@en ;
    cml:integrityHash "65bc902bb05b1072341413be1fe01ff16a8d66179c969f26130916f9d8cb9d03" ;
    cof:pageNumber "157"^^xsd:integer ;
    skos:note "Nothing in this Act limits the powers of the Federal Circuit and Family Court of Australia (Division 2) under Chapter 4." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.157" ;
    cml:asserts concept:fair-work-act-2009-sec-568-norm .
