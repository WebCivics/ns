doc:sec-536qn-ss-2 a cof:Section ;
    cof:title "536QN(2) Finalising draft order" ;
    values:kind "subsection" ;
    values:originalText "(2) If changes proposed to be made under subsection (1) are significant, the FWC must: (a) decide not to vary the road transport contractual chain order based on the draft; and (b) publish a subsequent notice of intent under paragraph 536QL(1)(a) in relation to the revised draft road transport contractual chain order, and publish the revised draft; and (c) follow the process set out in section 536QM (as affected by subsection (3) or (4) of this section) in relation to the revised draft road transport contractual chain order." ;
    cof:pageNumber "78"^^xsd:integer .

concept:fair-work-act-2009-sec-536qn-ss-3 a cml:Concept ;
    skos:prefLabel "536QN(3) Finalising draft order"@en ;
    cml:realizedBy doc:sec-536qn-ss-3 ;
    values:originalText "(3) For the purposes of paragraph (2)(c), the period of consultation under section 536QM in relation to the revised draft road transport contractual chain order is to be the period of at least 12 months starting when the subsequent notice of intent and the revised draft required by paragraph (2)(b) of this section were published." ;
    skos:definition "(3) For the purposes of paragraph (2)(c), the period of consultation under section 536QM in relation to the revised draft road transport contractual chain order is to be the period of at least 12 months starting when the subsequent notice of intent and the revised draft required by paragraph (2)(b) of this section were published."@en ;
    cml:integrityHash "3b4c75ae3e619c4dd45ea17474267707485d2cb802daf63fef3dcf72f83cdaad" ;
    values:partOf concept:fair-work-act-2009-sec-536qn ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Defines the period of consultation for a revised draft road transport contractual chain order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.78" ;
    cml:asserts concept:fair-work-act-2009-sec-536qn-ss-3-norm .
