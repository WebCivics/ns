concept:fair-work-act-2009-sec-712ad-ss-6 a cml:Concept ;
    skos:prefLabel "712AD(6) Fair Work Ombudsman may give FWO notice to person in"@en ;
    cml:realizedBy doc:sec-712ad-ss-6 ;
    values:originalText "(6) If the person is notified of a later time under subsection (3) or (4), the FWO notice has effect as if the later time (or the latest of those times) were the time specified in the FWO notice.  Chapter 5  Administration" ;
    skos:definition "(6) If the person is notified of a later time under subsection (3) or (4), the FWO notice has effect as if the later time (or the latest of those times) were the time specified in the FWO notice.  Chapter 5  Administration"@en ;
    cml:integrityHash "227c64b8da89b87a52413b5ba160a4f07defb301488bb0495ab3665d4c5126a6" ;
    values:partOf concept:fair-work-act-2009-sec-712ad ;
    cof:pageNumber "277"^^xsd:integer ;
    skos:note "FWO notice has effect as if the later time were the specified time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
