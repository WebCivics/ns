concept:fair-work-act-2009-sec-676 a cml:Concept ;
    skos:prefLabel "676 Intimidation etc."@en ;
    cml:realizedBy doc:sec-676 ;
    values:originalText "A person commits an offence if: (a) the person threatens, intimidates, coerces or prejudices another person; and (b) the person does so because the other person has given, or proposes to give, information or documents to the FWC. Penalty: Imprisonment for 12 months. Note: A person may also contravene a civil remedy provision by threatening etc. a person who has given, or proposes to give, information or documents to the FWC (see section 343).  Administration  Chapter 5 The Fair Work Commission  Part 5-1 Offences relating to the Fair Work Commission  Division 9 Section 677 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "A person commits an offence if: (a) the person threatens, intimidates, coerces or prejudices another person; and (b) the person does so because the other person has given, or proposes to give, information or documents to the FWC. Penalty: Imprisonment for 12 months. Note: A person may also contravene a civil remedy provision by threatening etc. a person who has given, or proposes to give, information or documents to the FWC (see section 343).  Administration  Chapter 5 The Fair Work Commission  Part 5-1 Offences relating to the Fair Work Commission  Division 9 Section 677 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "e870414b5e7754d3c1bab7b4f899b02e219fd85f3b1a71b09435af1247e469ee" ;
    cof:pageNumber "252"^^xsd:integer ;
    skos:note "Threatening, intimidating, coercing or prejudicing another person because they have given information to the FWC is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.252" ;
    cml:asserts concept:fair-work-act-2009-sec-676-norm .
