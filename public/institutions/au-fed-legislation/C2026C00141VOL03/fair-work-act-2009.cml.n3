doc:sec-559-ss-1 a cof:Section ;
    cof:title "559(1) Unclaimed money" ;
    values:kind "subsection" ;
    values:originalText "(1) An employer may pay an amount to the Commonwealth if: (a) the employer was required to pay the amount to an employee under this Act or a fair work instrument; and (b) the employee has left the employment of the employer without having been paid the amount; and (c) the employer is unable to pay the amount to the employee because the employer does not know the employee’s whereabouts. Discharge of employer" ;
    cof:pageNumber "151"^^xsd:integer .

concept:fair-work-act-2009-sec-559-ss-2 a cml:Concept ;
    skos:prefLabel "559(2) Unclaimed money"@en ;
    cml:realizedBy doc:sec-559-ss-2 ;
    values:originalText "(2) Payment of the amount to the Commonwealth is a sufficient discharge to the employer, as against the employee, for the amount paid. Payment where money later claimed" ;
    skos:definition "(2) Payment of the amount to the Commonwealth is a sufficient discharge to the employer, as against the employee, for the amount paid. Payment where money later claimed"@en ;
    cml:integrityHash "f676c3209e41e20274c36ce3d970d900f7bc9bec39cba2c0300b2ae4268a1242" ;
