doc:sec-768ba-ss-4 a cof:Section ;
    cof:title "768BA(4) FWC orders about coverage for transferring employees" ;
    values:kind "subsection" ;
    values:originalText "(4) An order under subsection (1) must not come into operation in relation to a particular transferring employee before the later of the following: (a) the transferring employee’s re-employment time; (b) the day on which the order is made." ;
    cof:pageNumber "354"^^xsd:integer .

