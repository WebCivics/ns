concept:fair-work-act-2009-sec-665 a cml:Concept ;
    skos:prefLabel "665 Resignation of the General Manager"@en ;
    cml:realizedBy doc:sec-665 ;
    values:originalText "(1) The General Manager may resign his or her appointment by giving the Governor-General a written resignation. (2) The resignation takes effect on the day it is received by the Governor-General or, if a later day is specified in the resignation, on that later day.  Administration  Chapter 5 The Fair Work Commission  Part 5-1 General Manager, staff and consultants  Division 8 Section 666 Fair Work Act 2009 Compilation date: 02/04/2026" ;
    skos:definition "(1) The General Manager may resign his or her appointment by giving the Governor-General a written resignation. (2) The resignation takes effect on the day it is received by the Governor-General or, if a later day is specified in the resignation, on that later day.  Administration  Chapter 5 The Fair Work Commission  Part 5-1 General Manager, staff and consultants  Division 8 Section 666 Fair Work Act 2009 Compilation date: 02/04/2026"@en ;
    cml:integrityHash "0eb2eca81d9e30024982496676419df49fc2a441e704ad06e0c058e09c0e47c9" ;
    cof:pageNumber "244"^^xsd:integer ;
