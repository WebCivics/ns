concept:fair-work-act-2009-sec-725 a cml:Concept ;
    skos:prefLabel "725 General rule"@en ;
    cml:realizedBy doc:sec-725 ;
    values:originalText "A person who has been dismissed must not make an application or complaint of a kind referred to in any one of sections 726 to 732 in relation to the dismissal if any other of those sections applies." ;
    skos:definition "A person who has been dismissed must not make an application or complaint of a kind referred to in any one of sections 726 to 732 in relation to the dismissal if any other of those sections applies."@en ;
    cml:integrityHash "a59305d9600f17fe97ca5e73037cba00e66114867ed1ec6261cac312ee197f12" ;
    cof:pageNumber "300"^^xsd:integer ;
    skos:note "Cannot make an application or complaint after dismissal if another section applies." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
