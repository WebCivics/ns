concept:fair-work-act-2009-sec-608-ss-4 a cml:Concept ;
    skos:prefLabel "608(4) Referring questions of law to the Federal Court"@en ;
    cml:realizedBy doc:sec-608-ss-4 ;
    values:originalText "(4) Once the Federal Court has determined the question, the FWC may only make a decision in relation to the matter that is not inconsistent with the opinion of the Federal Court (if the FWC has not already done so)." ;
    skos:definition "(4) Once the Federal Court has determined the question, the FWC may only make a decision in relation to the matter that is not inconsistent with the opinion of the Federal Court (if the FWC has not already done so)."@en ;
    cml:integrityHash "dc4eae10bc49cc7e430139e9b93b7b12bdebe85a9ae312872ce7cf50647cb1f8" ;
    values:partOf concept:fair-work-act-2009-sec-608 ;
    cof:pageNumber "188"^^xsd:integer ;
    skos:note "FWC must make a decision not inconsistent with Federal Court's opinion" ;
    cml:curationStatus cml:Proposed ;
