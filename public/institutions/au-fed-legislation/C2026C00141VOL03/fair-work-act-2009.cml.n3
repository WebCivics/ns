doc:sec-617-ss-1 a cof:Section ;
    cof:title "617(1) FWC’s functions etc. that must be performed by an Expert" ;
    values:kind "subsection" ;
    values:originalText "(1) An annual wage review must be conducted under Part 2-6 by an Expert Panel constituted for the purposes of the review. Note: For the constitution of an Expert Panel for the purposes of an annual wage review, see subsection 620(1)." ;
    cof:pageNumber "197"^^xsd:integer .

concept:fair-work-act-2009-sec-617-ss-2 a cml:Concept ;
    skos:prefLabel "617(2) FWC’s functions etc. that must be performed by an Expert"@en ;
    cml:realizedBy doc:sec-617-ss-2 ;
    values:originalText "(2) A national minimum wage order, or a determination, made in an annual wage review must be made by an Expert Panel constituted for the purposes of the review.  Chapter 5  Administration" ;
