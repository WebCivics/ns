concept:fair-work-act-2009-sec-794a-ss-4 cml:asserts concept:fair-work-act-2009-sec-794a-ss-4-logic-deontic-1 .
concept:fair-work-act-2009-sec-794a-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "establishes" ;
    cml:logicSummary "Establishs obligation" ;
    cml:premiseText "(a) that the conduct was engaged in by an official of the government; and (b) that the official had that state of mind." ;
    cml:conclusionText "The Australian government is obligated to establish the state of mind of its officials in relation to particular conduct." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-794a-ss-4 cml:asserts concept:fair-work-act-2009-sec-794a-ss-4-logic-deontic-2 .
concept:fair-work-act-2009-sec-794a-ss-4-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "establishes" ;
    cml:logicSummary "Establishes obligation to determine penalty amounts" ;
    cml:premiseText "(4) If, for the purposes of this Act or the procedural rules, it is necessary to establish the state of mind of an Australian government in relation to particular conduct." ;
    cml:conclusionText "The Australian government is obligated to determine penalty amounts based on its established state of mind." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-794a-ss-4 cml:asserts concept:fair-work-act-2009-sec-794a-ss-4-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-794a-ss-4-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Establishes temporal relationship between conduct and state of mind" ;
    cml:premiseText "(a) that the conduct was engaged in by an official of the government; and (b) that the official had that state of mind." ;
    cml:conclusionText "The conduct occurred during the time when the official had the established state of mind." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-794a-ss-4 cml:asserts concept:fair-work-act-2009-sec-794a-ss-4-logic-deontic-4 .
concept:fair-work-act-2009-sec-794a-ss-4-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "establishes" ;
    cml:logicSummary "Establishes obligation to provide information on penalty amounts" ;
    cml:premiseText "(4) If, for the purposes of this Act or the procedural rules, it is necessary to establish the state of mind of an Australian government in relation to particular conduct." ;
    cml:conclusionText "The Australian government is obligated to provide information on penalty amounts based on its established state of mind." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-794a-ss-4 a cof:Section ;
    cof:title "794A(4) Liability of Australian governments under civil remedy" ;
    values:kind "subsection" ;
    values:originalText "(4) If, for the purposes of this Act or the procedural rules, it is necessary to establish the state of mind of an Australian government in relation to particular conduct, it is enough to show: (a) that the conduct was engaged in by an official of the government; and (b) that the official had that state of mind. Note: For state of mind, see subsection 793(3). Determining penalty amounts for Australian governments" ;
    cof:pageNumber "450"^^xsd:integer .

concept:fair-work-act-2009-sec-794a-ss-5 a cml:Concept ;
    skos:prefLabel "794A(5) Liability of Australian governments under civil remedy"@en ;
    cml:realizedBy doc:sec-794a-ss-5 ;
    values:originalText "(5) If an Australian government contravenes a civil remedy provision, the pecuniary penalty that government may be ordered to pay  Miscellaneous  Chapter 6 Miscellaneous  Part 6-5 Miscellaneous  Division 2 Section 794B Fair Work Act 2009 Compilation date: 02/04/2026 under a pecuniary penalty order is the penalty applicable to a body corporate. Modifications" ;
    skos:definition "(5) If an Australian government contravenes a civil remedy provision, the pecuniary penalty that government may be ordered to pay  Miscellaneous  Chapter 6 Miscellaneous  Part 6-5 Miscellaneous  Division 2 Section 794B Fair Work Act 2009 Compilation date: 02/04/2026 under a pecuniary penalty order is the penalty applicable to a body corporate. Modifications"@en ;
    cml:integrityHash "6bca1de61d993f6677b62931f83c93cdb058cd1983db22b2a20bccf809436d61" ;
    values:partOf concept:fair-work-act-2009-sec-794a ;
    cof:pageNumber "450"^^xsd:integer ;
    skos:note "Pecuniary penalty for contravening a civil remedy provision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
