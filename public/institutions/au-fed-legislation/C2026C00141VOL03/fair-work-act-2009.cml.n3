doc:sec-779a-ss-1 a cof:Section ;
    cof:title "779A(1) Costs orders against parties" ;
    values:kind "subsection" ;
    values:originalText "(1) The FWC may make an order for costs against a party (the first party) to a dispute for costs incurred by the other party to the dispute if: (a) an application for the FWC to deal with the dispute has been made under section 773; and (b) the FWC is satisfied that the first party caused those costs to be incurred because of an unreasonable act or omission of the first party in connection with the conduct or continuation of the dispute." ;
    cof:pageNumber "391"^^xsd:integer .

concept:fair-work-act-2009-sec-779a-ss-2 a cml:Concept ;
    skos:prefLabel "779A(2) Costs orders against parties"@en ;
    cml:realizedBy doc:sec-779a-ss-2 ;
    values:originalText "(2) The FWC may make an order under subsection (1) only if the other party to the dispute has applied for it in accordance with section 781." ;
