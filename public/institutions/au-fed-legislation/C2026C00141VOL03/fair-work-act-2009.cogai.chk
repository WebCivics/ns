  provision: sec-581;
  logic: Deontic;
  operator: MUST;
  summary: Ensure adequate service to employers, employees, and persons covered by Chapters 3A and 3B;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: The President is responsible for ensuring that the FWC performs its functions and exercises its powers in a manner that: (a) is efficient; and (b) adequately serves the needs of employers and employees throughout Australia; and (c) adequately serves the needs of persons covered by Chapter 3A; and (d) adequately serves the needs of persons covered by Chapter 3B.;
  @action: The President MUST ensure adequate service to employers, employees, and persons covered by Chapters 3A and 3B.;
}

