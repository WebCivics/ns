    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee approval precedes FWC approval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Employee approval must occur before FWC approval.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The employee vote occurs before the FWC approves the agreement."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee approval involves cognitive processing.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
