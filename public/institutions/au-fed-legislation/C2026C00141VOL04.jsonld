      "cml:logicSummary": "Employee approval is a cognitive process.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The employees must make an informed decision about the agreement."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employer must obtain employee approval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Employer must obtain employee approval.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Section 205A of the amended Act does not apply."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employee approval is communicated to other relevant parties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Employee approval spreads to other relevant parties.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The employer and employees are notified of the agreement."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Employee approval is necessary for FWC approval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Employee approval is a necessary condition for FWC approval.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The FWC only approves agreements that have been approved by the employees."
