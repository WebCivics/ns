    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "Regardless of past incidents, the worker is entitled to protection." ;
    cml:premiseText "Past incidents do not affect entitlement." ;
    cml:conclusionText "Immunity from sexual harassment claims regardless of past incidents." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

