doc:sch-1-sec-43-ss-5 a cof:Section ;
    cof:title "43(5) Amendments about flexible unpaid parental leave" ;
    values:kind "subsection" ;
    values:originalText "(5) If the employee gives notice in accordance with subclauses (2) and (3), then: (a) the notice is taken to be a notice given under subsection 74(1) in relation to the taking of flexible unpaid parental leave; and (b) subsections 74(3A) and (3B) are taken to have been complied with in relation to the giving of that notice; and (c) if the notice contains advice as referred to in subclause (4)— the employee is taken to have complied with subsection 74(4) in relation to the initial leave period." ;
    cof:pageNumber "36"^^xsd:integer .

concept:fair-work-act-2009-sch-1-sec-43-ss-6 a cml:Concept ;
    skos:prefLabel "43(6) Amendments about flexible unpaid parental leave"@en ;
    cml:realizedBy doc:sch-1-sec-43-ss-6 ;
    values:originalText "(6) The employee cannot take flexible unpaid parental leave before the end of 4 weeks starting on the day the notice under subclause (2) is given, despite subsection 74(4B).  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act" ;
    skos:definition "(6) The employee cannot take flexible unpaid parental leave before the end of 4 weeks starting on the day the notice under subclause (2) is given, despite subsection 74(4B).  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act"@en ;
