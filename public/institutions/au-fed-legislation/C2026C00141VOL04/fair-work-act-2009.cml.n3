concept:fair-work-act-2009-sch-1-sec-113 a cml:Concept ;
    skos:prefLabel "113 Application of amendments—right of entry"@en ;
    cml:realizedBy doc:sch-1-sec-113 ;
    values:originalText "The amendments of subsection 510(1) made by Part 10 of Schedule 1 to the amending Act apply in relation to each entry permit held by a permit holder whether issued before, on or after the commencement of that Part.  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act" ;
    skos:definition "The amendments of subsection 510(1) made by Part 10 of Schedule 1 to the amending Act apply in relation to each entry permit held by a permit holder whether issued before, on or after the commencement of that Part.  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act"@en ;
    cml:integrityHash "8268bfae2e589abe8c260685e11291bc6684055bd0a47a157260614384088b67" ;
    cof:pageNumber "103"^^xsd:integer ;
    skos:note "Amendments apply to existing permits" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.103" ;
