doc:sch-1-sec-43-ss-4 a cof:Section ;
    cof:title "43(4) Amendments about flexible unpaid parental leave" ;
    values:kind "subsection" ;
    values:originalText "(4) The employee may, in the notice under subclause (2), advise the employer of a change to the end date of the initial leave period, but only if the change is necessary to allow the employee to take the flexible unpaid parental leave for the number of days referred to in subclause (3)." ;
    cof:pageNumber "36"^^xsd:integer .

concept:fair-work-act-2009-sch-1-sec-43-ss-5 a cml:Concept ;
    skos:prefLabel "43(5) Amendments about flexible unpaid parental leave"@en ;
    cml:realizedBy doc:sch-1-sec-43-ss-5 ;
    values:originalText "(5) If the employee gives notice in accordance with subclauses (2) and (3), then: (a) the notice is taken to be a notice given under subsection 74(1) in relation to the taking of flexible unpaid parental leave; and (b) subsections 74(3A) and (3B) are taken to have been complied with in relation to the giving of that notice; and (c) if the notice contains advice as referred to in subclause (4)— the employee is taken to have complied with subsection 74(4) in relation to the initial leave period." ;
    skos:definition "(5) If the employee gives notice in accordance with subclauses (2) and (3), then: (a) the notice is taken to be a notice given under subsection 74(1) in relation to the taking of flexible unpaid parental leave; and (b) subsections 74(3A) and (3B) are taken to have been complied with in relation to the giving of that notice; and (c) if the notice contains advice as referred to in subclause (4)— the employee is taken to have complied with subsection 74(4) in relation to the initial leave period."@en ;
    cml:integrityHash "2cad733146719c2214ddf1abc28dbc955a8d5b3cc6f1051940ab24f045a7fe36" ;
    values:partOf concept:fair-work-act-2009-sch-1-sec-43 ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Notice requirements for flexible unpaid parental leave" ;
    dc:description "Notice in accordance with subclauses (2) and (3)" ;
    cml:curationStatus cml:Proposed ;
