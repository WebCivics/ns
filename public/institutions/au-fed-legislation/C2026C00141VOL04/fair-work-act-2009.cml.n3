    cml:integrityHash "a0790907c2c44aca770e3ef7e69b06948621abf0f09abfc08daf1dbf1c4a74c9" ;
    values:partOf concept:fair-work-act-2009-sch-3-sec-29 ;
    cof:pageNumber "134"^^xsd:integer ;
    skos:note "Continuation of General Manager's office upon commencement of Part 1 of Schedule 9" ;
