doc:sch-1-sec-104-ss-3 a cof:Section ;
    cof:title "104(3) Replacement agreements" ;
    values:kind "subsection" ;
    values:originalText "(3) Subsections 236(1B) and 238(2), as inserted by the amending Act, apply in relation to applications made after the commencement of Part 4 of Schedule 1 to that Act, whether the single interest employer agreement or supported bargaining agreement was made before or after that commencement." ;
    cof:pageNumber "95"^^xsd:integer .

