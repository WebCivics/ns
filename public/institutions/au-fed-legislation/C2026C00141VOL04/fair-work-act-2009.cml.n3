doc:sch-1-sec-94-ss-1 a cof:Section ;
    cof:title "94(1) Application of section 149E of amended Act" ;
    values:kind "subsection" ;
    values:originalText "(1) Section 149E (delegates’ rights terms) of the amended Act applies in relation to a modern award that is in operation on or after 1 July 2024, whether or not the award was made before that day." ;
    cof:pageNumber "85"^^xsd:integer .

concept:fair-work-act-2009-sch-1-sec-94-ss-2 a cml:Concept ;
    skos:prefLabel "94(2) Application of section 149E of amended Act"@en ;
    cml:realizedBy doc:sch-1-sec-94-ss-2 ;
    values:originalText "(2) However, a modern award is not invalid on or after 1 July 2024 only because it does not include a delegates’ rights term." ;
    skos:definition "(2) However, a modern award is not invalid on or after 1 July 2024 only because it does not include a delegates’ rights term."@en ;
