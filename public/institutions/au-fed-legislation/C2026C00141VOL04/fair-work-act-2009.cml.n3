doc:sch-3-sec-24-ss-1 a cof:Section ;
    cof:title "24(1) Transitional provision—President" ;
    values:kind "subsection" ;
    values:originalText "(1) The person holding office as the President of FWA immediately before the commencement of Part 1 of Schedule 9 to the amending Act continues to hold office as the President of the FWC." ;
    cof:pageNumber "130"^^xsd:integer .

concept:fair-work-act-2009-sch-3-sec-24-ss-2 a cml:Concept ;
    skos:prefLabel "24(2) Transitional provision—President"@en ;
    cml:realizedBy doc:sch-3-sec-24-ss-2 ;
    values:originalText "(2) If, before that commencement, a thing was done by, or in relation to, the President of FWA, then, for the purposes of the operation of any law on or after that commencement, the thing is taken to have been done by, or in relation to, the President of the FWC." ;
