    cml:conclusionText "The employee approval is communicated to other relevant parties." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-96 cml:asserts concept:fair-work-act-2009-sch-1-sec-96-logic-cogai-5 .
