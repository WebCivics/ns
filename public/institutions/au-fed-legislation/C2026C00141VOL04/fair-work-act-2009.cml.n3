concept:fair-work-act-2009-sch-1-sec-41 a cml:Concept ;
    skos:prefLabel "41 Definitions"@en ;
    cml:realizedBy doc:sch-1-sec-41 ;
    values:originalText "In this Part: amending Act means the Fair Work Amendment (Improving Unpaid Parental Leave for Parents of Stillborn Babies and Other Measures) Act 2020. Schedule 1 commencement day means the day on which Schedule 1 to the amending Act commences. Schedule 2 commencement day means the day on which Schedule 2 to the amending Act commences." ;
    skos:definition "In this Part: amending Act means the Fair Work Amendment (Improving Unpaid Parental Leave for Parents of Stillborn Babies and Other Measures) Act 2020. Schedule 1 commencement day means the day on which Schedule 1 to the amending Act commences. Schedule 2 commencement day means the day on which Schedule 2 to the amending Act commences."@en ;
    cml:integrityHash "86836d67ff64e5301fa8baa37343a7613b23f5dcefe0cb8226dbcde01751009c" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Defines terms related to Schedule 1 and 2 commencement days." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
