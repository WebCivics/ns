doc:sch-1-sec-111-ss-6 a cof:Section ;
    cof:title "111(6) Application of amendments to intractable bargaining workplace" ;
    values:kind "subsection" ;
    values:originalText "(6) A variation operates from the day specified by the FWC in the variation, which must not be a day before the variation is made.  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act" ;
    cof:pageNumber "98"^^xsd:integer .

