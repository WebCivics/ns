concept:fair-work-act-2009-sch-1-sec-115 a cml:Concept ;
    skos:prefLabel "115 Definitions"@en ;
    cml:realizedBy doc:sch-1-sec-115 ;
    values:originalText "In this Part: amended Act means this Act as amended by the Fair Work Legislation Amendment (Closing Loopholes No. 2) Act 2024. amending Act means the Fair Work Legislation Amendment (Closing Loopholes No. 2) Act 2024. commencement means the commencement of item 237 of Part 15 of Schedule 1 to the amending Act. old Act means this Act as in force immediately before commencement.  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act" ;
    skos:definition "In this Part: amended Act means this Act as amended by the Fair Work Legislation Amendment (Closing Loopholes No. 2) Act 2024. amending Act means the Fair Work Legislation Amendment (Closing Loopholes No. 2) Act 2024. commencement means the commencement of item 237 of Part 15 of Schedule 1 to the amending Act. old Act means this Act as in force immediately before commencement.  Schedule 1  Application, saving and transitional provisions relating to amendments of this Act"@en ;
    cml:integrityHash "3de72a6e92c16632bf09d54582e22bfdb4be1404d1ecc34805da74e2fe941908" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "Definitions for amended Act and commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
