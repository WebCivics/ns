    cof:title "57(1) Objects of the Act" ;
    values:kind "subsection" ;
    values:originalText "(1) Sections 3 and 134 of the amended Act apply, after commencement, in relation to the FWC performing functions, or exercising powers, in relation to: (a) a matter that arises after commencement; or (b) a proceeding in the FWC that was on foot at commencement, or commences after commencement." ;
    cof:pageNumber "53"^^xsd:integer .

concept:fair-work-act-2009-sch-1-sec-57-ss-2 a cml:Concept ;
    skos:prefLabel "57(2) Objects of the Act"@en ;
