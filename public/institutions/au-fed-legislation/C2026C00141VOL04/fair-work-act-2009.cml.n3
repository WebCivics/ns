    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Employee approval must occur before FWC approval." ;
    cml:premiseText "The employee vote occurs before the FWC approves the agreement." ;
    cml:conclusionText "The employee approval precedes FWC approval." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-96 cml:asserts concept:fair-work-act-2009-sch-1-sec-96-logic-ltl-3 .
