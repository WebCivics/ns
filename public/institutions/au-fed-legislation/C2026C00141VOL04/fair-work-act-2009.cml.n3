concept:fair-work-act-2009-sch-1-sec-78b a cml:Concept ;
    skos:prefLabel "78B Application to certain authorisations made after"@en ;
    cml:realizedBy doc:sch-1-sec-78b ;
    values:originalText "commencement If, because of the operation of clause 74, 75 or 76 of this Part, the FWC makes a single interest employer authorisation after the commencement of Part 21 of Schedule 1 to the amending Act: (a) Division 10 of Part 2-4 of this Act, as in force immediately before that commencement, continues to apply in relation to the authorisation; and (b) for the purposes of section 172 of the amended Act, the employers specified in the authorisation are taken to be related employers within the meaning of subsection 172(5A)." ;
    skos:definition "commencement If, because of the operation of clause 74, 75 or 76 of this Part, the FWC makes a single interest employer authorisation after the commencement of Part 21 of Schedule 1 to the amending Act: (a) Division 10 of Part 2-4 of this Act, as in force immediately before that commencement, continues to apply in relation to the authorisation; and (b) for the purposes of section 172 of the amended Act, the employers specified in the authorisation are taken to be related employers within the meaning of subsection 172(5A)."@en ;
    cml:integrityHash "9e68d7f31920077870310989c7c5768c90f1d945112e5ee0b93e4fb6f7113e5b" ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "Application to certain authorisations made after commencement" ;
