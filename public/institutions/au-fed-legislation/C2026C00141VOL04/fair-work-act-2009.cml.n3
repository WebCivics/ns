    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The provision overlaps with the commencement date of the clause." ;
    cml:premiseText "Commencement date is relevant to immunity." ;
    cml:conclusionText "Immunity from sexual harassment claims regardless of past incidents." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-50 cml:asserts concept:fair-work-act-2009-sch-1-sec-50-logic-argumentation-3 .
concept:fair-work-act-2009-sch-1-sec-50-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implicates" ;
    cml:logicSummary "The provision implies that the worker's entitlement to protection is not affected by past incidents." ;
    cml:premiseText "Past incidents do not affect entitlement." ;
    cml:conclusionText "Immunity from sexual harassment claims regardless of past incidents." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-50 cml:asserts concept:fair-work-act-2009-sch-1-sec-50-logic-diffusion-4 .
concept:fair-work-act-2009-sch-1-sec-50-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Spreads" ;
    cml:logicSummary "The provision spreads the worker's entitlement to protection across all relevant dates." ;
    cml:premiseText "Entitlement is not limited to a specific date." ;
    cml:conclusionText "Immunity from sexual harassment claims regardless of past incidents." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-50 cml:asserts concept:fair-work-act-2009-sch-1-sec-50-logic-cogai-5 .
