    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-129",
      "@type": "cml:Concept",
      "skos:prefLabel": "129 Application provision—employer-funded paid parental leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-129"
