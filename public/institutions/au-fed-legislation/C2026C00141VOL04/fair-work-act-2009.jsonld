      },
      "dc:source": "fair-work-act-2009.pdf, p.87",
      "values:originalText": "Subsection 327A(1) of the amended Act applies in relation to\nconduct that occurs after the commencement of Part 14 of\nSchedule 1 to the amending Act, including conduct that occurs\nafter that commencement that is part of a course of conduct that\nbegan before that commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "Subsection 327A(1) of the amended Act applies in relation to\nconduct that occurs after the commencement of Part 14 of\nSchedule 1 to the amending Act, including conduct that occurs\nafter that commencement that is part of a course of conduct that\nbegan before that commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-98-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-98-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7336370263eeb9d1458215b4eae3b246ec0318b2b87088d15a05261a52009433",
      "skos:note": "Failure to pay certain amounts as required is an offence."
    },
