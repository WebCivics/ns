    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-111b-ss-2",
      "@type": "cof:Section",
      "cof:title": "111B(2) Application of section 149F of the amended Act",
      "values:kind": "subsection",
      "cof:pageNumber": 100,
      "values:originalText": "(2) However, a modern award is not invalid on or after\ncommencement only because it does not include a right to\ndisconnect term."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-111b-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
