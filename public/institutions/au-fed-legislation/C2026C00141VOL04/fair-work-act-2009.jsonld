      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.71",
      "values:originalText": "and employees\nSubdivision AC of Division 7 of Part 2-4 of the amended Act\napplies in relation to a variation of a cooperative workplace\nagreement, if the agreement was made after the commencement of\nthat Subdivision.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "and employees\nSubdivision AC of Division 7 of Part 2-4 of the amended Act\napplies in relation to a variation of a cooperative workplace\nagreement, if the agreement was made after the commencement of\nthat Subdivision.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-82-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-82-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ec75b06e663d64d21e10c8d7f14675198be4521c808be9de417c32746507ab71",
      "skos:note": "Variation of cooperative workplace agreement to add employer"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-82",
      "@type": "cof:Section",
      "cof:title": "82 Variation of cooperative workplace agreement to add employer",
      "values:kind": "section",
      "cof:pageNumber": 71,
      "values:originalText": "and employees\nSubdivision AC of Division 7 of Part 2-4 of the amended Act\napplies in relation to a variation of a cooperative workplace\nagreement, if the agreement was made after the commencement of\nthat Subdivision.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
