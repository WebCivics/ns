    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Part 7 of Schedule 8 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.129",
      "values:originalText": "The amendments made by Part 7 of Schedule 8 to the amending\nAct (which is about handling complaints) apply after the\ncommencement of that Part in relation to a complaint about an\nFWC Member, regardless of whether:\n(a) the complaint is made before or after that commencement; or\n(b) the circumstances that give rise to the complaint occur before\nor after that commencement.",
      "skos:definition": "The amendments made by Part 7 of Schedule 8 to the amending\nAct (which is about handling complaints) apply after the\ncommencement of that Part in relation to a complaint about an\nFWC Member, regardless of whether:\n(a) the complaint is made before or after that commencement; or\n(b) the circumstances that give rise to the complaint occur before\nor after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-22-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "215cbc528bec4aa19918332eb093d4fde35712e6cc0d0c93324c22810cea26c4",
      "skos:note": "Complaints made before or after commencement are handled regardless of timing."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Part 7 of Schedule 8 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 129,
      "values:originalText": "The amendments made by Part 7 of Schedule 8 to the amending\nAct (which is about handling complaints) apply after the\ncommencement of that Part in relation to a complaint about an\nFWC Member, regardless of whether:\n(a) the complaint is made before or after that commencement; or\n(b) the circumstances that give rise to the complaint occur before\nor after that commencement."
    },
