    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Schedule 4 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.144",
      "values:originalText": "Application of amendment relating to sections 492 and 492A\n(1) The amendment made by item 7 of Schedule 4 to the amending Act\napplies in relation to interviews conducted and discussions held\nafter the commencement of that item.\nApplication of amendments relating to section 505A\n(2) The amendments made by items 12 and 13 of Schedule 4 to the\namending Act apply in relation to the frequency of entry after the\ncommencement of those items.\nApplication of amendments relating to accommodation\narrangements and transport arrangements\n(3) The amendments made by items 14 and 15 of Schedule 4 to the\namending Act do not apply in relation to arrangements entered into\nbefore the commencement of those items.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nConsent arbitration for general protections and unlawful termination (Schedule 4A)",
      "skos:definition": "Application of amendment relating to sections 492 and 492A\n(1) The amendment made by item 7 of Schedule 4 to the amending Act\napplies in relation to interviews conducted and discussions held\nafter the commencement of that item.\nApplication of amendments relating to section 505A\n(2) The amendments made by items 12 and 13 of Schedule 4 to the\namending Act apply in relation to the frequency of entry after the\ncommencement of those items.\nApplication of amendments relating to accommodation\narrangements and transport arrangements\n(3) The amendments made by items 14 and 15 of Schedule 4 to the\namending Act do not apply in relation to arrangements entered into\nbefore the commencement of those items.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nConsent arbitration for general protections and unlawful termination (Schedule 4A)",
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-9-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-9-ss-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-9-ss-3"
        }
      ],
      "cml:integrityHash": "00da00d480228299a9d3a83400b0868f47ad343596195b272a222502fc7422dd"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Schedule 4 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 144,
      "values:originalText": "Application of amendment relating to sections 492 and 492A\n(1) The amendment made by item 7 of Schedule 4 to the amending Act\napplies in relation to interviews conducted and discussions held\nafter the commencement of that item.\nApplication of amendments relating to section 505A\n(2) The amendments made by items 12 and 13 of Schedule 4 to the\namending Act apply in relation to the frequency of entry after the\ncommencement of those items.\nApplication of amendments relating to accommodation\narrangements and transport arrangements\n(3) The amendments made by items 14 and 15 of Schedule 4 to the\namending Act do not apply in relation to arrangements entered into\nbefore the commencement of those items.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nConsent arbitration for general protections and unlawful termination (Schedule 4A)"
    },
