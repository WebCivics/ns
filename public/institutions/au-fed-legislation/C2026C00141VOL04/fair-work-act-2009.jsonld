    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-106",
      "@type": "cml:Concept",
      "skos:prefLabel": "106 Application of better off overall test to replacement agreements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-106"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
