    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-91",
      "@type": "cml:Concept",
      "skos:prefLabel": "91 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-91"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.82",
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Closing Loopholes) Act 2023.\namending Act means the Fair Work Legislation Amendment\n(Closing Loopholes) Act 2023.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Closing Loopholes) Act",
      "skos:definition": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Closing Loopholes) Act 2023.\namending Act means the Fair Work Legislation Amendment\n(Closing Loopholes) Act 2023.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Closing Loopholes) Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-91-norm"
        }
      ],
      "cml:integrityHash": "856ce5e63cb234289062b153a874b0c8c4a850a6969644a2fa24e4edb32fe0d7",
      "skos:note": "Definitions for amended Act and namending Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-91",
      "@type": "cof:Section",
      "cof:title": "91 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 82,
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Closing Loopholes) Act 2023.\namending Act means the Fair Work Legislation Amendment\n(Closing Loopholes) Act 2023.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Closing Loopholes) Act"
    },
