      },
      "dc:source": "fair-work-act-2009.pdf, p.68",
      "values:originalText": "and employees\nSubdivision AD of Division 7 of Part 2-4 of the amended Act, as\ninserted by Part 21 of Schedule 1 to the amending Act, applies in\nrelation to variations of single interest employer agreements on or\nafter the commencement of that Part of the amending Act, if the\nagreements were made after that commencement.",
      "skos:definition": "and employees\nSubdivision AD of Division 7 of Part 2-4 of the amended Act, as\ninserted by Part 21 of Schedule 1 to the amending Act, applies in\nrelation to variations of single interest employer agreements on or\nafter the commencement of that Part of the amending Act, if the\nagreements were made after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-73-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-73-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fa6fd370a9ecbf4232b77bbd9a0d2e7b2b6145f0a21b7340ce917bdc8a13f88e",
      "skos:note": "Variation of single interest employer agreement to add employer"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-73",
      "@type": "cof:Section",
      "cof:title": "73 Variation of single interest employer agreement to add employer",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "and employees\nSubdivision AD of Division 7 of Part 2-4 of the amended Act, as\ninserted by Part 21 of Schedule 1 to the amending Act, applies in\nrelation to variations of single interest employer agreements on or\nafter the commencement of that Part of the amending Act, if the\nagreements were made after that commencement."
    },
