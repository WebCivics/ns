          "@id": "concept:fair-work-act-2009-sch-1-sec-52-ss-2-norm"
        }
      ],
      "cml:integrityHash": "3c6b669f9d5f7a3fb9d430c49c204210374a35208528462512457a16e3b197c0",
      "skos:note": "Applicability of amendments to Schedule 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-52-ss-2",
      "@type": "cof:Section",
      "cof:title": "52(2) Entitlement to paid family and domestic violence leave",
      "values:kind": "subsection",
      "cof:pageNumber": 47,
      "values:originalText": "(2) The amendments made by Schedule 1 to the amending Act also\napply, from the commencement of that Schedule, in relation to an\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
