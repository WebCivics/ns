    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50",
      "@type": "cml:Concept",
      "skos:prefLabel": "50 Orders to stop sexual harassment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-50"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.46",
      "values:originalText": "For the purposes of subparagraph 789FF(1)(b)(ii) (as amended by\nthe Sex Discrimination and Fair Work (Respect at Work)\nAmendment Act 2021), it is immaterial whether the worker has\nbeen sexually harassed at work before, at or after the\ncommencement of this clause.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Paid Family and Domestic Violence\nLeave) Act 2022  Part 12\n\nClause 51\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "For the purposes of subparagraph 789FF(1)(b)(ii) (as amended by\nthe Sex Discrimination and Fair Work (Respect at Work)\nAmendment Act 2021), it is immaterial whether the worker has\nbeen sexually harassed at work before, at or after the\ncommencement of this clause.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Paid Family and Domestic Violence\nLeave) Act 2022  Part 12\n\nClause 51\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-50-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-alleninterval-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-argumentation-3"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-diffusion-4"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "3d74ba5c725fb0fa27cf1b76abd1a3a5a3468ca69bcf6c3db3ce26eb76a6bd71",
      "skos:note": "Immunity from sexual harassment claims regardless of past incidents."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-50",
      "@type": "cof:Section",
      "cof:title": "50 Orders to stop sexual harassment",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "For the purposes of subparagraph 789FF(1)(b)(ii) (as amended by\nthe Sex Discrimination and Fair Work (Respect at Work)\nAmendment Act 2021), it is immaterial whether the worker has\nbeen sexually harassed at work before, at or after the\ncommencement of this clause.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Paid Family and Domestic Violence\nLeave) Act 2022  Part 12\n\nClause 51\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-50"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "Regardless of past incidents, the worker is entitled to protection.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Past incidents do not affect entitlement.",
      "cml:conclusionText": "Immunity from sexual harassment claims regardless of past incidents."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The provision overlaps with the commencement date of the clause.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commencement date is relevant to immunity.",
      "cml:conclusionText": "Immunity from sexual harassment claims regardless of past incidents."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implicates",
      "cml:logicSummary": "The provision implies that the worker's entitlement to protection is not affected by past incidents.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Past incidents do not affect entitlement.",
      "cml:conclusionText": "Immunity from sexual harassment claims regardless of past incidents."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spreads",
      "cml:logicSummary": "The provision spreads the worker's entitlement to protection across all relevant dates.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entitlement is not limited to a specific date.",
      "cml:conclusionText": "Immunity from sexual harassment claims regardless of past incidents."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-50-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "The provision recognizes the worker's entitlement to protection as a fundamental right.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entitlement is a fundamental right.",
      "cml:conclusionText": "Immunity from sexual harassment claims regardless of past incidents."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-51",
      "@type": "cml:Concept",
      "skos:prefLabel": "51 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-51"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.47",
      "values:originalText": "In this Part:\namending Act means the Fair Work Amendment (Paid Family and\nDomestic Violence Leave) Act 2022.\ndeferred start day means the day after the end of the period of 3\nmonths beginning on the day Schedule 2 to the amending Act\ncommences.\npre-commencement enterprise agreement means an enterprise\nagreement made before the commencement of Schedule 1 to the\namending Act.\nsmall business employee means an employee whose employer\nwas, on the day Schedule 1 to the amending Act commences, a\nsmall business employer (whether or not the employee was\nemployed by the employer on that day).",
      "skos:definition": "In this Part:\namending Act means the Fair Work Amendment (Paid Family and\nDomestic Violence Leave) Act 2022.\ndeferred start day means the day after the end of the period of 3\nmonths beginning on the day Schedule 2 to the amending Act\ncommences.\npre-commencement enterprise agreement means an enterprise\nagreement made before the commencement of Schedule 1 to the\namending Act.\nsmall business employee means an employee whose employer\nwas, on the day Schedule 1 to the amending Act commences, a\nsmall business employer (whether or not the employee was\nemployed by the employer on that day).",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-51-norm"
        }
      ],
      "cml:integrityHash": "4ca749fbee5864668d428b52fd3974d339a2d58ee8fc21711bd39aa310ae975d",
      "skos:note": "Definitions for the Fair Work Amendment (Paid Family and Domestic Violence Leave) Act 2022."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-51",
      "@type": "cof:Section",
      "cof:title": "51 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "In this Part:\namending Act means the Fair Work Amendment (Paid Family and\nDomestic Violence Leave) Act 2022.\ndeferred start day means the day after the end of the period of 3\nmonths beginning on the day Schedule 2 to the amending Act\ncommences.\npre-commencement enterprise agreement means an enterprise\nagreement made before the commencement of Schedule 1 to the\namending Act.\nsmall business employee means an employee whose employer\nwas, on the day Schedule 1 to the amending Act commences, a\nsmall business employer (whether or not the employee was\nemployed by the employer on that day)."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-51-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-51"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Entitlement to paid family and domestic violence leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-52"
      },
      "cml:curationStatus": {
