        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) In this section: introduction day means the day on which the Fair Work Legislation Amendment (Closing Loopholes) Bill 2023 was introduced into the Parliament.",
      "cml:conclusionText": "Introduction day is defined as the introduction date of the bill"
    },
