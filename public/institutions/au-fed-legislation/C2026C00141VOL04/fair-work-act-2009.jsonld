    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-84",
      "@type": "cml:Concept",
      "skos:prefLabel": "84 Employment advertisements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-84"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.74",
      "values:originalText": "Division 4 of Part 3-6 of this Act, as inserted by Part 25 of\nSchedule 1 to the amending Act, applies in relation to employment\nadvertised on or after the day that is one month after the\ncommencement of Part 25 of Schedule 1 to the amending Act\n(whether the employment was first advertised before, on or after\nthat day).\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 25B of Schedule 1 to the amending Act  Division 20\nClause 85\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "Division 4 of Part 3-6 of this Act, as inserted by Part 25 of\nSchedule 1 to the amending Act, applies in relation to employment\nadvertised on or after the day that is one month after the\ncommencement of Part 25 of Schedule 1 to the amending Act\n(whether the employment was first advertised before, on or after\nthat day).\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 25B of Schedule 1 to the amending Act  Division 20\nClause 85\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-84-norm"
        }
      ],
      "cml:integrityHash": "17b3f753f3d378d61a8e989a68e5000f7bf37005eea908ffed1daa2612915096",
      "skos:note": "Employment advertisements subject to Division 4 of Part 3-6 of the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-84",
      "@type": "cof:Section",
      "cof:title": "84 Employment advertisements",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "Division 4 of Part 3-6 of this Act, as inserted by Part 25 of\nSchedule 1 to the amending Act, applies in relation to employment\nadvertised on or after the day that is one month after the\ncommencement of Part 25 of Schedule 1 to the amending Act\n(whether the employment was first advertised before, on or after\nthat day).\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 25B of Schedule 1 to the amending Act  Division 20\nClause 85\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
