      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78",
      "@type": "cml:Concept",
      "skos:prefLabel": "78 Application to existing applications to vary authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.69",
      "values:originalText": "The amendments to section 251 made by Part 21 of Schedule 1 to\nthe amending Act do not apply in relation to applications for\nvariations made before the commencement of that Part.",
      "skos:definition": "The amendments to section 251 made by Part 21 of Schedule 1 to\nthe amending Act do not apply in relation to applications for\nvariations made before the commencement of that Part.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-78-norm"
        }
      ],
      "cml:integrityHash": "686893fb534bf521b10e1beb47f5ab64b5b66f4a5a6635cdfa0d858a9feefb19",
      "skos:note": "Amendments do not apply to pre-commencement applications"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78",
      "@type": "cof:Section",
      "cof:title": "78 Application to existing applications to vary authorisations",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "The amendments to section 251 made by Part 21 of Schedule 1 to\nthe amending Act do not apply in relation to applications for\nvariations made before the commencement of that Part."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-78"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78a",
      "@type": "cml:Concept",
      "skos:prefLabel": "78A Application to authorisations in operation before",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.69",
      "values:originalText": "commencement\n(1) This clause applies in relation to 2 or more employers that were,\nimmediately before the commencement of Part 21 of Schedule 1 to\nthe amending Act, specified in a single interest employer\nauthorisation made under subsection 249(1) that is in operation.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "commencement\n(1) This clause applies in relation to 2 or more employers that were,\nimmediately before the commencement of Part 21 of Schedule 1 to\nthe amending Act, specified in a single interest employer\nauthorisation made under subsection 249(1) that is in operation.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-78a-norm"
        }
      ],
      "cml:integrityHash": "3f3258c3be464267ae43318ff4760810f4c502573c8e564df68963e1ee1b41e8",
      "skos:note": "Application to authorisations in operation before commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78a",
      "@type": "cof:Section",
      "cof:title": "78A Application to authorisations in operation before",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "commencement\n(1) This clause applies in relation to 2 or more employers that were,\nimmediately before the commencement of Part 21 of Schedule 1 to\nthe amending Act, specified in a single interest employer\nauthorisation made under subsection 249(1) that is in operation.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78a-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-78a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78b",
      "@type": "cml:Concept",
      "skos:prefLabel": "78B Application to certain authorisations made after",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.70",
      "values:originalText": "commencement\nIf, because of the operation of clause 74, 75 or 76 of this Part, the\nFWC makes a single interest employer authorisation after the\ncommencement of Part 21 of Schedule 1 to the amending Act:\n(a) Division 10 of Part 2-4 of this Act, as in force immediately\nbefore that commencement, continues to apply in relation to\nthe authorisation; and\n(b) for the purposes of section 172 of the amended Act, the\nemployers specified in the authorisation are taken to be\nrelated employers within the meaning of subsection 172(5A).",
      "skos:definition": "commencement\nIf, because of the operation of clause 74, 75 or 76 of this Part, the\nFWC makes a single interest employer authorisation after the\ncommencement of Part 21 of Schedule 1 to the amending Act:\n(a) Division 10 of Part 2-4 of this Act, as in force immediately\nbefore that commencement, continues to apply in relation to\nthe authorisation; and\n(b) for the purposes of section 172 of the amended Act, the\nemployers specified in the authorisation are taken to be\nrelated employers within the meaning of subsection 172(5A).",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-78b-norm"
        }
      ],
      "cml:integrityHash": "9e68d7f31920077870310989c7c5768c90f1d945112e5ee0b93e4fb6f7113e5b",
      "skos:note": "Application to certain authorisations made after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78b",
      "@type": "cof:Section",
      "cof:title": "78B Application to certain authorisations made after",
      "values:kind": "section",
      "cof:pageNumber": 70,
      "values:originalText": "commencement\nIf, because of the operation of clause 74, 75 or 76 of this Part, the\nFWC makes a single interest employer authorisation after the\ncommencement of Part 21 of Schedule 1 to the amending Act:\n(a) Division 10 of Part 2-4 of this Act, as in force immediately\nbefore that commencement, continues to apply in relation to\nthe authorisation; and\n(b) for the purposes of section 172 of the amended Act, the\nemployers specified in the authorisation are taken to be\nrelated employers within the meaning of subsection 172(5A)."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78b-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-78b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78c",
      "@type": "cml:Concept",
      "skos:prefLabel": "78C Availability of scope orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.70",
      "values:originalText": "Despite the repeal of subsection 238(2) of this Act by Part 21 of\nSchedule 1 to the amending Act, that subsection continues to apply\nafter the commencement of that Part to proposed single-enterprise\nagreements in relation to which a single interest employer\nauthorisation is in operation.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 23 of Schedule 1 to the amending Act  Division 17\nClause 80A\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "Despite the repeal of subsection 238(2) of this Act by Part 21 of\nSchedule 1 to the amending Act, that subsection continues to apply\nafter the commencement of that Part to proposed single-enterprise\nagreements in relation to which a single interest employer\nauthorisation is in operation.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 23 of Schedule 1 to the amending Act  Division 17\nClause 80A\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-78c-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-78c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c5cfd04abb9f741152bad52c4c1485653f478b82c4cd2087c4c67f9cbc7f79e0",
      "skos:note": "Single-enterprise agreements with single interest employer authorization continue to apply despite repeal."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-78c",
      "@type": "cof:Section",
      "cof:title": "78C Availability of scope orders",
      "values:kind": "section",
      "cof:pageNumber": 70,
      "values:originalText": "Despite the repeal of subsection 238(2) of this Act by Part 21 of\nSchedule 1 to the amending Act, that subsection continues to apply\nafter the commencement of that Part to proposed single-enterprise\nagreements in relation to which a single interest employer\nauthorisation is in operation.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 23 of Schedule 1 to the amending Act  Division 17\nClause 80A\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-78c-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-78c"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
