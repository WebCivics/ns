        },
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-25-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cc71f5edfd35b3e7396d50dad733f36c4d41d86e46526fa2d88ba772df5db9eb",
      "skos:note": "Determination by Minister regarding subclause (3)"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-25-ss-5",
      "@type": "cof:Section",
      "cof:title": "25(5) Transitional provision—Deputy President",
      "values:kind": "subsection",
      "cof:pageNumber": 131,
      "values:originalText": "(5) The Minister may, by writing, determine that subclause (3):\n(a) does not apply in relation to a specified thing done by, or in\nrelation to, a Deputy President of FWA; or\n(b) applies as if the reference in that subclause to the Deputy\nPresident of the FWC were a reference to the FWC; or\n(c) applies as if the reference in that subclause to the Deputy\nPresident of the FWC were a reference to another FWC\nmember.\nA determination under this subclause has effect accordingly."
    },
