      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "43(6) Amendments about flexible unpaid parental leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-43-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
