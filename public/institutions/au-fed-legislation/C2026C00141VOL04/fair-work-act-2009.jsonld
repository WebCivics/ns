    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "90(3) Employee authorised deductions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-90-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.81",
      "values:originalText": "(3) An authorisation is covered by this subclause if the authorisation:\n(a) was purportedly made for the purposes of\nparagraph 324(1)(a) as in force immediately before the\ncommencement of Schedule 5; and\n(b) purportedly authorises multiple or ongoing deductions for\namounts as varied from time to time; and\n(c) would, after the commencement, comply with section 324 of\nthe amended Act.",
      "skos:definition": "(3) An authorisation is covered by this subclause if the authorisation:\n(a) was purportedly made for the purposes of\nparagraph 324(1)(a) as in force immediately before the\ncommencement of Schedule 5; and\n(b) purportedly authorises multiple or ongoing deductions for\namounts as varied from time to time; and\n(c) would, after the commencement, comply with section 324 of\nthe amended Act.",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-90"
      },
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-ltl-3"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-diffusion-4"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "6eabcd0f46026a5296f656afc57eb188ec92517bfc7e08e05aa2318877ef8ced",
      "skos:note": "Authorisation for employee deductions must comply with section 324 of the amended Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-90-ss-3",
      "@type": "cof:Section",
      "cof:title": "90(3) Employee authorised deductions",
      "values:kind": "subsection",
      "cof:pageNumber": 81,
      "values:originalText": "(3) An authorisation is covered by this subclause if the authorisation:\n(a) was purportedly made for the purposes of\nparagraph 324(1)(a) as in force immediately before the\ncommencement of Schedule 5; and\n(b) purportedly authorises multiple or ongoing deductions for\namounts as varied from time to time; and\n(c) would, after the commencement, comply with section 324 of\nthe amended Act."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
