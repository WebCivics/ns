    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Application of sections 149A and 155A of amended Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.19",
      "values:originalText": "Sections 149A and 155A of the amended Act apply in relation to a\nmodern award that is in operation on or after 1 January 2014,\nwhether or not the award was made before that day.",
      "skos:definition": "Sections 149A and 155A of the amended Act apply in relation to a\nmodern award that is in operation on or after 1 January 2014,\nwhether or not the award was made before that day.",
