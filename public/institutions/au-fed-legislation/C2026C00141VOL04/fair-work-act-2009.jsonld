        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-118-ss-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "8cc39941f58e11ed5676f16d19cb50ac76cebbc47bbff0a1c95cc9e169d8fa84",
      "skos:note": "Right or entitlement under the amended Act or a fair work instrument is determined by reference to length of service or minimum period of employment."
    },
    {
