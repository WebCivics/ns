      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "before the commencement of Part 5 of Schedule 4 to the amending Act",
      "cml:conclusionText": "immediately before that commencement"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Part 1 of Schedule 5 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-9"
      },
      "cml:curationStatus": {
