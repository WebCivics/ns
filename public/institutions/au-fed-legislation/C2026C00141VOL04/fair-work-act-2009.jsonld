      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Temporal interval applies after commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "commencement of that Part",
      "cml:conclusionText": "after the commencement of that Part"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Part 2 of Schedule 1 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.139",
      "values:originalText": "The amendments made by Part 2 of Schedule 1 to the amending\nAct apply in relation to the taking of unpaid parental leave by\nmembers of an employee couple if the first taking of leave by\neither member of the employee couple occurs after the\ncommencement of that Part.",
      "skos:definition": "The amendments made by Part 2 of Schedule 1 to the amending\nAct apply in relation to the taking of unpaid parental leave by\nmembers of an employee couple if the first taking of leave by\neither member of the employee couple occurs after the\ncommencement of that Part.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-3-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "ab74e80e8519b917e2535d1a03eb691da484fd0a756f8c98a15c2c139e0cc028",
      "skos:note": "Amendments apply to unpaid parental leave taking after commencement of Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Part 2 of Schedule 1 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 139,
      "values:originalText": "The amendments made by Part 2 of Schedule 1 to the amending\nAct apply in relation to the taking of unpaid parental leave by\nmembers of an employee couple if the first taking of leave by\neither member of the employee couple occurs after the\ncommencement of that Part."
    },
    {
