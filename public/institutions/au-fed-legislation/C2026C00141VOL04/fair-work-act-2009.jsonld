    {
      "@id": "concept:fair-work-act-2009-sch-5-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Part 5 of Schedule 1 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-5-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.147",
      "values:originalText": "The amendments made by Part 5 of Schedule 1 to the amending\nAct, so far as they concern proposed enterprise agreements, apply\nin relation to a proposed enterprise agreement if an employer\nagrees to bargain for the proposed enterprise agreement after the\ncommencement of that Part.",
      "skos:definition": "The amendments made by Part 5 of Schedule 1 to the amending\nAct, so far as they concern proposed enterprise agreements, apply\nin relation to a proposed enterprise agreement if an employer\nagrees to bargain for the proposed enterprise agreement after the\ncommencement of that Part.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-5-sec-9-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-5-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a9facd8231c612ef1abe017cf1797098ee78382bd553f559629420ca1b857fd2",
      "skos:note": "Amendments apply if employer agrees to bargain after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-5-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Part 5 of Schedule 1 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 147,
      "values:originalText": "The amendments made by Part 5 of Schedule 1 to the amending\nAct, so far as they concern proposed enterprise agreements, apply\nin relation to a proposed enterprise agreement if an employer\nagrees to bargain for the proposed enterprise agreement after the\ncommencement of that Part."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-5-sec-9-norm",
