      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Part 1 of Schedule 10 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.136",
      "values:originalText": "The amendment made by Part 1 of Schedule 10 to the amending\nAct (which is about costs orders in court proceedings) applies in\nrelation to proceedings commenced after the commencement of\nthat Part.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nRegulations  Part 11\n\nClause 32\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "The amendment made by Part 1 of Schedule 10 to the amending\nAct (which is about costs orders in court proceedings) applies in\nrelation to proceedings commenced after the commencement of\nthat Part.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nRegulations  Part 11\n\nClause 32\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-31-norm"
        }
      ],
      "cml:integrityHash": "b62d382dd4aba8485b68044dcd171d2b11017fd65f9e7a522bc1fcfd9888849a",
      "skos:note": "Conditional commencement of amendment made by Part 1 of Schedule 10 to the amending Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Part 1 of Schedule 10 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "The amendment made by Part 1 of Schedule 10 to the amending\nAct (which is about costs orders in court proceedings) applies in\nrelation to proceedings commenced after the commencement of\nthat Part.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nRegulations  Part 11\n\nClause 32\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-31-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
