          "@id": "concept:fair-work-act-2009-sch-1-sec-120-ss-5-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-120-ss-5-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "f661ed159064a6c3f4892d1f09341581809a7ab46563d3ca2df345bc234ff201",
      "skos:note": "Variation of a fair work instrument takes effect on specified day."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-120-ss-5",
      "@type": "cof:Section",
      "cof:title": "120(5) FWC power to deal with uncertainties or difficulties arising",
      "values:kind": "subsection",
      "cof:pageNumber": 108,
      "values:originalText": "(5) A variation of a fair work instrument under this clause operates\nfrom the day specified in the determination, which may be a day\nbefore the determination was made."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-120-ss-5-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
