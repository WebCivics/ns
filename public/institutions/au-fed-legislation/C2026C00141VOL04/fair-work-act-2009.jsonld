    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-70",
      "@type": "cml:Concept",
      "skos:prefLabel": "70 Serious breach declarations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-70"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.65",
      "values:originalText": "Despite the amendments made to the following provisions of this\nAct by Part 18 of Schedule 1 to the amending Act, those provisions\ncontinue to apply, in relation to an application made under\nsection 234 of this Act before that Part commences, as if the\namendments had not been made:\n(a) Subdivision B of Division 8 of Part 2-4;\n(b) Division 4 of Part 2-5;\n(c) section 274;\n(d) section 413.",
      "skos:definition": "Despite the amendments made to the following provisions of this\nAct by Part 18 of Schedule 1 to the amending Act, those provisions\ncontinue to apply, in relation to an application made under\nsection 234 of this Act before that Part commences, as if the\namendments had not been made:\n(a) Subdivision B of Division 8 of Part 2-4;\n(b) Division 4 of Part 2-5;\n(c) section 274;\n(d) section 413.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-70-norm"
        }
      ],
      "cml:integrityHash": "c0985c7654b4416c6a0320c4124a4bf2750cddace17f4a0b597d30d0e87b03d8",
      "skos:note": "Exemptions from amendments for applications made before Part 18 of Schedule 1 commences"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Serious breach declarations",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Despite the amendments made to the following provisions of this\nAct by Part 18 of Schedule 1 to the amending Act, those provisions\ncontinue to apply, in relation to an application made under\nsection 234 of this Act before that Part commences, as if the\namendments had not been made:\n(a) Subdivision B of Division 8 of Part 2-4;\n(b) Division 4 of Part 2-5;\n(c) section 274;\n(d) section 413."
    },
    {
