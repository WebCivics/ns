    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Schedule 4A to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-10"
      },
      "cml:curationStatus": {
