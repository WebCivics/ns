    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "82 Variation of cooperative workplace agreement to add employer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
