      "values:kind": "subsection",
      "cof:pageNumber": 134,
      "values:originalText": "(4) A determination made under subclause (3) is not a legislative\ninstrument."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-28-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
