    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-115",
      "@type": "cml:Concept",
      "skos:prefLabel": "115 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-115"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.105",
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Closing Loopholes No. 2) Act 2024.\namending Act means the Fair Work Legislation Amendment\n(Closing Loopholes No. 2) Act 2024.\ncommencement means the commencement of item 237 of Part 15\nof Schedule 1 to the amending Act.\nold Act means this Act as in force immediately before\ncommencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Closing Loopholes No. 2) Act 2024.\namending Act means the Fair Work Legislation Amendment\n(Closing Loopholes No. 2) Act 2024.\ncommencement means the commencement of item 237 of Part 15\nof Schedule 1 to the amending Act.\nold Act means this Act as in force immediately before\ncommencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-115-norm"
        }
      ],
      "cml:integrityHash": "3de72a6e92c16632bf09d54582e22bfdb4be1404d1ecc34805da74e2fe941908",
      "skos:note": "Definitions for amended Act and commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-115",
      "@type": "cof:Section",
      "cof:title": "115 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Closing Loopholes No. 2) Act 2024.\namending Act means the Fair Work Legislation Amendment\n(Closing Loopholes No. 2) Act 2024.\ncommencement means the commencement of item 237 of Part 15\nof Schedule 1 to the amending Act.\nold Act means this Act as in force immediately before\ncommencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
