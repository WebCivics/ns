    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-24-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "24(5) Transitional provision—President",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-24-ss-5"
      },
