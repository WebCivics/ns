      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.95",
      "values:originalText": "Sections 193 and 193A, as amended by the amending Act, apply in\nrelation to single-enterprise agreements made on or after the\ncommencement of Part 4 of Schedule 1 to that Act, whether the\nsupported bargaining agreement or single interest employer\nagreement was made before or after that commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "Sections 193 and 193A, as amended by the amending Act, apply in\nrelation to single-enterprise agreements made on or after the\ncommencement of Part 4 of Schedule 1 to that Act, whether the\nsupported bargaining agreement or single interest employer\nagreement was made before or after that commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-106-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-106-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "98cdba1963ec808e9aac3a20c34cb62f9e783cdfd6c32c2be17b423b444c889b",
      "skos:note": "Application of better off overall test to replacement agreements"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-106",
      "@type": "cof:Section",
      "cof:title": "106 Application of better off overall test to replacement agreements",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "Sections 193 and 193A, as amended by the amending Act, apply in\nrelation to single-enterprise agreements made on or after the\ncommencement of Part 4 of Schedule 1 to that Act, whether the\nsupported bargaining agreement or single interest employer\nagreement was made before or after that commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
