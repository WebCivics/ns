    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Part 1 of Schedule 3 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
