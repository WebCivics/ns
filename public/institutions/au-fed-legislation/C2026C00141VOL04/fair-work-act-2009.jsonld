    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Superannuation—reduction of employer’s liability to the extent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-88"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.79",
      "values:originalText": "of superannuation charge payments\nSubsection 149B(2), as inserted by Part 2 of Schedule 3 to the\namending Act, applies in relation to an employer’s obligation to\nmake superannuation contributions on behalf of an employee,\nwhether the requirements of that subsection are satisfied before or\nafter the commencement of that Part.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "of superannuation charge payments\nSubsection 149B(2), as inserted by Part 2 of Schedule 3 to the\namending Act, applies in relation to an employer’s obligation to\nmake superannuation contributions on behalf of an employee,\nwhether the requirements of that subsection are satisfied before or\nafter the commencement of that Part.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-88-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-88-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-88-logic-alleninterval-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-88-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "b0e62142fae1f51afd89f21f80f50670ab50e47f185943efab0e84acd78cfa07",
      "skos:note": "Employer's obligation to make superannuation contributions on behalf of an employee is unaffected by the commencement of Part 2 of Schedule 3."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Superannuation—reduction of employer’s liability to the extent",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "of superannuation charge payments\nSubsection 149B(2), as inserted by Part 2 of Schedule 3 to the\namending Act, applies in relation to an employer’s obligation to\nmake superannuation contributions on behalf of an employee,\nwhether the requirements of that subsection are satisfied before or\nafter the commencement of that Part.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
