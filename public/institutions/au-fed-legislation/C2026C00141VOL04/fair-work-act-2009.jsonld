    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Operation of section 7 and subsection 25B(1) of the Acts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.135",
      "values:originalText": "Interpretation Act 1901 not limited\nThis Part and Schedule 9 to the amending Act do not limit the\noperation of section 7 or subsection 25B(1) of the Acts\nInterpretation Act 1901.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "skos:definition": "Interpretation Act 1901 not limited\nThis Part and Schedule 9 to the amending Act do not limit the\noperation of section 7 or subsection 25B(1) of the Acts\nInterpretation Act 1901.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-30-norm"
        }
      ],
      "cml:integrityHash": "e894788aceb5f91b8b565e9c3a756ef11a7fe2dbbf7b2800a1d1b349edc959b2",
      "skos:note": "Does not limit operation of section 7 or subsection 25B(1) of the Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Operation of section 7 and subsection 25B(1) of the Acts",
      "values:kind": "section",
      "cof:pageNumber": 135,
      "values:originalText": "Interpretation Act 1901 not limited\nThis Part and Schedule 9 to the amending Act do not limit the\noperation of section 7 or subsection 25B(1) of the Acts\nInterpretation Act 1901.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012"
    },
    {
