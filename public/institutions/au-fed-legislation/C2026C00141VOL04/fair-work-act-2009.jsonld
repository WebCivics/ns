    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "96 Application of section 205A of amended Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.85",
      "values:originalText": "(1) Section 205A (enterprise agreements to include delegates’ rights\nterms etc.) of the amended Act does not apply in relation to an\nenterprise agreement if:\n(a) before 1 July 2024, the employer concerned asks the\nemployees to approve the agreement by voting for it; and\n(b) by that vote, the employees approve the agreement; and\n(c) the FWC approves the agreement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "(1) Section 205A (enterprise agreements to include delegates’ rights\nterms etc.) of the amended Act does not apply in relation to an\nenterprise agreement if:\n(a) before 1 July 2024, the employer concerned asks the\nemployees to approve the agreement by voting for it; and\n(b) by that vote, the employees approve the agreement; and\n(c) the FWC approves the agreement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-96-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-alleninterval-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-ltl-3"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-diffusion-4"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "6fc1a9c007b9c3d474de4d367d86cecf69bd04d7fc42528282ed67548aac4560",
      "skos:note": "Employer must obtain employee approval for enterprise agreement before FWC approval."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-96",
      "@type": "cof:Section",
      "cof:title": "96 Application of section 205A of amended Act",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "(1) Section 205A (enterprise agreements to include delegates’ rights\nterms etc.) of the amended Act does not apply in relation to an\nenterprise agreement if:\n(a) before 1 July 2024, the employer concerned asks the\nemployees to approve the agreement by voting for it; and\n(b) by that vote, the employees approve the agreement; and\n(c) the FWC approves the agreement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-96"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Employer must obtain employee approval.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 205A of the amended Act does not apply.",
      "cml:conclusionText": "Employer must obtain employee approval."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Employee approval must occur before FWC approval.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee vote occurs before the FWC approves the agreement.",
      "cml:conclusionText": "The employee approval precedes FWC approval."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Employee approval is a necessary condition for FWC approval.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The FWC only approves agreements that have been approved by the employees.",
      "cml:conclusionText": "Employee approval is necessary for FWC approval."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Employee approval spreads to other relevant parties.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employer and employees are notified of the agreement.",
      "cml:conclusionText": "The employee approval is communicated to other relevant parties."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-96-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Employee approval is a cognitive process.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employees must make an informed decision about the agreement.",
      "cml:conclusionText": "The employee approval involves cognitive processing."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-97",
