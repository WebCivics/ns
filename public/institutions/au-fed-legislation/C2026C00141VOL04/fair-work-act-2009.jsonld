      "cml:operator": "May",
      "cml:logicSummary": "FWC has the power to make a determination varying a fair work instrument.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
