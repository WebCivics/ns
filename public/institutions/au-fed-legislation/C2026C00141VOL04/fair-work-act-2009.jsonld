    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-86",
      "@type": "cml:Concept",
      "skos:prefLabel": "86 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-86"
      },
      "cml:curationStatus": {
