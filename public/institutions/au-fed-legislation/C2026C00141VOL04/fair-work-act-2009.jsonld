    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Application of Division 3 of Part 6-4A of amended Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.17",
      "values:originalText": "For the purposes of Division 3 of Part 6-4A of the amended Act, an\nentity is not an indirectly responsible entity in relation to particular\nTCF work if the arrangement to which the entity is a party, being\nthe arrangement because of which the work can be regarded as\nbeing performed indirectly for the entity, was entered into before\ncommencement.",
      "skos:definition": "For the purposes of Division 3 of Part 6-4A of the amended Act, an\nentity is not an indirectly responsible entity in relation to particular\nTCF work if the arrangement to which the entity is a party, being\nthe arrangement because of which the work can be regarded as\nbeing performed indirectly for the entity, was entered into before\ncommencement.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-5-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "76ae3bc79401ed2008e87192e11d121219f51e06711c59d71da371f2f70e244c",
      "skos:note": "Entity is not indirectly responsible if arrangement was entered into before commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Application of Division 3 of Part 6-4A of amended Act",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "For the purposes of Division 3 of Part 6-4A of the amended Act, an\nentity is not an indirectly responsible entity in relation to particular\nTCF work if the arrangement to which the entity is a party, being\nthe arrangement because of which the work can be regarded as\nbeing performed indirectly for the entity, was entered into before\ncommencement."
    },
