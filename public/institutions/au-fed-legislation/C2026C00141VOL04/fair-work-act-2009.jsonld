      "skos:note": "Sections 149A and 155A apply to modern awards made on or after 1 January 2014."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Application of sections 149A and 155A of amended Act",
      "values:kind": "section",
