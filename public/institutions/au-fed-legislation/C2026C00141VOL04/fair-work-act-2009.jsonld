    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-128",
      "@type": "cml:Concept",
      "skos:prefLabel": "128 Application provision—employer-funded paid parental leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-128"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.115",
      "values:originalText": "under workplace instruments etc.\nSection 333X (employer-funded paid parental leave—preserved if\nchild is stillborn or dies) applies in relation to an employee if:\n(a) the stillbirth or death mentioned in paragraph 333X(1)(a)\noccurs on or after the commencement of section 333X; and\n(b) the employee would have had an entitlement to leave\nmentioned in paragraph 333X(1)(b); and\n(c) the entitlement arises other than under a contract of\nemployment (regardless of whether the source of the\nentitlement was made before, on or after that\ncommencement).",
      "skos:definition": "under workplace instruments etc.\nSection 333X (employer-funded paid parental leave—preserved if\nchild is stillborn or dies) applies in relation to an employee if:\n(a) the stillbirth or death mentioned in paragraph 333X(1)(a)\noccurs on or after the commencement of section 333X; and\n(b) the employee would have had an entitlement to leave\nmentioned in paragraph 333X(1)(b); and\n(c) the entitlement arises other than under a contract of\nemployment (regardless of whether the source of the\nentitlement was made before, on or after that\ncommencement).",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-128-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-128-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-128-logic-alleninterval-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-128-logic-ltl-3"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-128-logic-cogai-4"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-128-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "9f7bd29433d0b14bb71cc7e53314f6840e447f83b8a8a2f88822df170831997f",
      "skos:note": "Employer-funded paid parental leave entitlement preserved under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-128",
      "@type": "cof:Section",
      "cof:title": "128 Application provision—employer-funded paid parental leave",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "under workplace instruments etc.\nSection 333X (employer-funded paid parental leave—preserved if\nchild is stillborn or dies) applies in relation to an employee if:\n(a) the stillbirth or death mentioned in paragraph 333X(1)(a)\noccurs on or after the commencement of section 333X; and\n(b) the employee would have had an entitlement to leave\nmentioned in paragraph 333X(1)(b); and\n(c) the entitlement arises other than under a contract of\nemployment (regardless of whether the source of the\nentitlement was made before, on or after that\ncommencement)."
    },
