    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Part 4 of Schedule 1 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
