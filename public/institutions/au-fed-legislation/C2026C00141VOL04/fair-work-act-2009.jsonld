    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Definition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.138",
      "values:originalText": "In this Schedule:\namending Act means the Fair Work Amendment Act 2013.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nFamily-friendly measures (Schedule 1)  Part 2\n\nClause 2\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "In this Schedule:\namending Act means the Fair Work Amendment Act 2013.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nFamily-friendly measures (Schedule 1)  Part 2\n\nClause 2\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-1-norm"
        }
      ],
      "cml:integrityHash": "587069b6de3f501e062e3bac218d95b6fd45c7983fc108b4776df5c898503a2c",
      "skos:note": "Definition of amending Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Definition",
      "values:kind": "section",
      "cof:pageNumber": 138,
      "values:originalText": "In this Schedule:\namending Act means the Fair Work Amendment Act 2013.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nFamily-friendly measures (Schedule 1)  Part 2\n\nClause 2\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-1-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
