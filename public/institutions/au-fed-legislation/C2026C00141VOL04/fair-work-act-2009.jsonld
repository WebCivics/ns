    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-27-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "27(4) Transitional provision—Minimum Wage Panel Member",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-27-ss-4"
      },
      "cml:curationStatus": {
