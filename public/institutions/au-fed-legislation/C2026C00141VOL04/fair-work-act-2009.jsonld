      },
      "dc:source": "fair-work-act-2009.pdf, p.147",
      "values:originalText": "The amendment of section 437 made by Part 7 of Schedule 1 to the\namending Act applies in relation to an application made under that\nsection, if the application was made after the commencement of\nthat Part.",
      "skos:definition": "The amendment of section 437 made by Part 7 of Schedule 1 to the\namending Act applies in relation to an application made under that\nsection, if the application was made after the commencement of\nthat Part.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-5-sec-11-norm"
        }
      ],
      "cml:integrityHash": "f08712a971de75ff00e2db38fb3c31eb1f7c0aef733518fbd76cf1286dda3c2f",
      "skos:note": "Amendment applies if application was made after commencement of Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-5-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Part 7 of Schedule 1 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 147,
      "values:originalText": "The amendment of section 437 made by Part 7 of Schedule 1 to the\namending Act applies in relation to an application made under that\nsection, if the application was made after the commencement of\nthat Part."
    },
    {
