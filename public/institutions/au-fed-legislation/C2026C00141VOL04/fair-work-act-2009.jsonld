      "cml:integrityHash": "9a778d2909439d012578874c80fe1791f3690cdfc4e62eae74522342a66f7651",
      "skos:note": "Application of amendments to intractable bargaining workplace determinations"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-110-ss-3",
      "@type": "cof:Section",
      "cof:title": "110(3) Application of amendments—intractable bargaining workplace",
