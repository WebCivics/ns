    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Offence relating to failure to pay certain amounts as required",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-98"
      },
      "cml:curationStatus": {
