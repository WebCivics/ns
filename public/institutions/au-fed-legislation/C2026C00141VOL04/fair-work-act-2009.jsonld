      },
      "dc:source": "fair-work-act-2009.pdf, p.94",
      "values:originalText": "For the purposes of applying section 66L of this Act during the\nperiod beginning when this clause commences and ending when\nPart 1 of Schedule 1 to the amending Act commences, the\nreference to “this Division” in that provision is taken to include a\nreference to that Division as amended by that Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nMain amendments made by the Fair Work Legislation Amendment (Closing Loopholes\nNo. 2) Act 2024  Part 16\nAmendments made by Part 4 of Schedule 1 to the amending Act  Division 3\nClause 104\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "For the purposes of applying section 66L of this Act during the\nperiod beginning when this clause commences and ending when\nPart 1 of Schedule 1 to the amending Act commences, the\nreference to “this Division” in that provision is taken to include a\nreference to that Division as amended by that Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nMain amendments made by the Fair Work Legislation Amendment (Closing Loopholes\nNo. 2) Act 2024  Part 16\nAmendments made by Part 4 of Schedule 1 to the amending Act  Division 3\nClause 104\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-103-norm"
        }
      ],
      "cml:integrityHash": "355475bd02d2c4639388655c4fefd1950384ed7961232e1abb5265558a7ccb1b",
      "skos:note": "Transitional provision for applying section 66L of the Act during a specific period."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-103",
      "@type": "cof:Section",
      "cof:title": "103 Transitional provision",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "For the purposes of applying section 66L of this Act during the\nperiod beginning when this clause commences and ending when\nPart 1 of Schedule 1 to the amending Act commences, the\nreference to “this Division” in that provision is taken to include a\nreference to that Division as amended by that Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nMain amendments made by the Fair Work Legislation Amendment (Closing Loopholes\nNo. 2) Act 2024  Part 16\nAmendments made by Part 4 of Schedule 1 to the amending Act  Division 3\nClause 104\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
