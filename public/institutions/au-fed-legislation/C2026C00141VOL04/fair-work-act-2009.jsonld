      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.81",
      "values:originalText": "(2) An authorisation covered by subclause (3) that is in force\nimmediately before the commencement of Schedule 5:\n(a) is taken to be, and taken always to have been, made in\ncompliance with section 324 as in force immediately before\nthe commencement; and\n(b) continues in force, after the commencement, until it is\nwithdrawn.",
      "skos:definition": "(2) An authorisation covered by subclause (3) that is in force\nimmediately before the commencement of Schedule 5:\n(a) is taken to be, and taken always to have been, made in\ncompliance with section 324 as in force immediately before\nthe commencement; and\n(b) continues in force, after the commencement, until it is\nwithdrawn.",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-90"
      },
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-2-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "0e0ad7582be989a159a2dd1fcb77228b7294f230b956a49faf01a7861e31e370",
      "skos:note": "Continuation of existing authorizations after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-90-ss-2",
      "@type": "cof:Section",
      "cof:title": "90(2) Employee authorised deductions",
      "values:kind": "subsection",
      "cof:pageNumber": 81,
      "values:originalText": "(2) An authorisation covered by subclause (3) that is in force\nimmediately before the commencement of Schedule 5:\n(a) is taken to be, and taken always to have been, made in\ncompliance with section 324 as in force immediately before\nthe commencement; and\n(b) continues in force, after the commencement, until it is\nwithdrawn."
    },
