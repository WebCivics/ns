        }
      ],
      "cml:integrityHash": "17184897a00e5bcdd181c242270b79ab695cd8b473864b2039aa9ef1eeee5196",
      "skos:note": "Sections 149A and 155A continue in force for modern awards made before 1 January 2014."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-2-ss-2",
      "@type": "cof:Section",
