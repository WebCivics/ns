    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-26-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "26(5) Transitional provision—Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-26-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
