    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-108",
      "@type": "cml:Concept",
      "skos:prefLabel": "108 Model terms and copied State instruments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-108"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.96",
      "values:originalText": "Despite the amendments made by Part 5 of Schedule 1 to the\namending Act, section 768BK, as in force immediately before the\ncommencement of that Part, continues to apply in relation to a\nmodel term that is taken, before that commencement, to be a term\nof a copied State instrument.",
      "skos:definition": "Despite the amendments made by Part 5 of Schedule 1 to the\namending Act, section 768BK, as in force immediately before the\ncommencement of that Part, continues to apply in relation to a\nmodel term that is taken, before that commencement, to be a term\nof a copied State instrument.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-108-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-108-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c808bf5e42980eab9f4489d154b94ef6635a5298b8ab0cf3046715e22d56b7db",
      "skos:note": "Section 768BK continues to apply despite amendments."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-108",
      "@type": "cof:Section",
      "cof:title": "108 Model terms and copied State instruments",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "Despite the amendments made by Part 5 of Schedule 1 to the\namending Act, section 768BK, as in force immediately before the\ncommencement of that Part, continues to apply in relation to a\nmodel term that is taken, before that commencement, to be a term\nof a copied State instrument."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-108-norm",
      "@type": "values:Obligation",
      "cml:modality": {
