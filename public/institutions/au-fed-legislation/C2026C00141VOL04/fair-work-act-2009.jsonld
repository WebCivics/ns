      "dc:source": "fair-work-act-2009.pdf, p.118",
      "values:originalText": "In this Schedule:\namending Act means the Fair Work Amendment (Transfer of\nBusiness) Act 2012.\ncommencement means the commencement of this Schedule.",
      "skos:definition": "In this Schedule:\namending Act means the Fair Work Amendment (Transfer of\nBusiness) Act 2012.\ncommencement means the commencement of this Schedule.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-2-sec-1-norm"
        }
      ],
      "cml:integrityHash": "5caa2718962da8c3365eee5312cb266a70f270813aa3cf21fcae412c13d0a2f7",
      "skos:note": "Definitions for the Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 118,
      "values:originalText": "In this Schedule:\namending Act means the Fair Work Amendment (Transfer of\nBusiness) Act 2012.\ncommencement means the commencement of this Schedule."
    },
