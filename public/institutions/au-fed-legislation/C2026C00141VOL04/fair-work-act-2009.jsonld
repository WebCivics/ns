      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Part 1 of Schedule 1 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.139",
      "values:originalText": "The amendments made by Part 1 of Schedule 1 to the amending\nAct apply in relation to a period of unpaid special maternity leave\nthat starts after the commencement of that Part.",
      "skos:definition": "The amendments made by Part 1 of Schedule 1 to the amending\nAct apply in relation to a period of unpaid special maternity leave\nthat starts after the commencement of that Part.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-2-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "62107a3ad1bdccd3e88bb941bd055fb0e0f3c7d5ddfc5e4705d132fa20e5b97c",
      "skos:note": "Amendments apply after commencement of Part 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Part 1 of Schedule 1 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 139,
      "values:originalText": "The amendments made by Part 1 of Schedule 1 to the amending\nAct apply in relation to a period of unpaid special maternity leave\nthat starts after the commencement of that Part."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
