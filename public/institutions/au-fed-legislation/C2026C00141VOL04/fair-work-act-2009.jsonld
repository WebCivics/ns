    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-125",
      "@type": "cml:Concept",
      "skos:prefLabel": "125 New applications relating to unfair contracts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-125"
