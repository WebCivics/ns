    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-111d",
      "@type": "cml:Concept",
      "skos:prefLabel": "111D Application of amendments to small business employers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-111d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.101",
      "values:originalText": "The amendments made by Part 8 of Schedule 1 to the amending\nAct do not apply in relation to an employer that is a small business\nemployer on the day of commencement, or an employee of the\nemployer, for a period of 12 months beginning on that day.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "The amendments made by Part 8 of Schedule 1 to the amending\nAct do not apply in relation to an employer that is a small business\nemployer on the day of commencement, or an employee of the\nemployer, for a period of 12 months beginning on that day.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-111d-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-111d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ef6508b3672496b74b21242a6560c7e5c7b2fc708bd899820e79362bdf78d523",
      "skos:note": "Exemption from amendments for small business employers and employees"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-111d",
      "@type": "cof:Section",
      "cof:title": "111D Application of amendments to small business employers",
      "values:kind": "section",
      "cof:pageNumber": 101,
      "values:originalText": "The amendments made by Part 8 of Schedule 1 to the amending\nAct do not apply in relation to an employer that is a small business\nemployer on the day of commencement, or an employee of the\nemployer, for a period of 12 months beginning on that day.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
