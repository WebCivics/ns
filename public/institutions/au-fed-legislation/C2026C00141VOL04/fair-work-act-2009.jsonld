    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-71",
      "@type": "cml:Concept",
      "skos:prefLabel": "71 Intractable bargaining declarations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-71"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.65",
      "values:originalText": "In making a declaration under section 235 of the amended Act, the\nFWC may have regard to conduct engaged in before or after the\ncommencement of Subdivision B of Division 8 of Part 2-4 of the\namended Act.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "In making a declaration under section 235 of the amended Act, the\nFWC may have regard to conduct engaged in before or after the\ncommencement of Subdivision B of Division 8 of Part 2-4 of the\namended Act.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-71-norm"
        }
      ],
      "cml:integrityHash": "d016e80a063f38e367dab0779a0937d9d622c43bb05554cf3d0b5adea98137c0",
      "skos:note": "Consider conduct before or after Subdivision B of Division 8 of Part 2-4 of the amended Act when making a declaration under section 235."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-71",
      "@type": "cof:Section",
      "cof:title": "71 Intractable bargaining declarations",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "In making a declaration under section 235 of the amended Act, the\nFWC may have regard to conduct engaged in before or after the\ncommencement of Subdivision B of Division 8 of Part 2-4 of the\namended Act.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
