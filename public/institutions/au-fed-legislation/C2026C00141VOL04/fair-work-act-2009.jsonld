      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission granted by employee to advise employer.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
