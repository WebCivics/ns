    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-8-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "8(2) Part 5 of Schedule 4 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-8-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.124",
      "values:originalText": "(2) Regulations that:\n(a) were made for the purposes of subsection 174(6) before the\ncommencement of Part 5 of Schedule 4 to the amending Act;\nand\n(b) were in force immediately before that commencement;\ncontinue in force (and may be dealt with) after that commencement\nas if they had been made for the purposes of subsection 174(1A)\n(as inserted by Part 5 of Schedule 4 to the amending Act).\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nGeneral protections (Schedule 5)  Part 5\n\nClause 9\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "(2) Regulations that:\n(a) were made for the purposes of subsection 174(6) before the\ncommencement of Part 5 of Schedule 4 to the amending Act;\nand\n(b) were in force immediately before that commencement;\ncontinue in force (and may be dealt with) after that commencement\nas if they had been made for the purposes of subsection 174(1A)\n(as inserted by Part 5 of Schedule 4 to the amending Act).\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nGeneral protections (Schedule 5)  Part 5\n\nClause 9\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-3-sec-8"
      },
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-8-ss-2-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-8-ss-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "38900758e0a334ac2b44b3596b5ef1a764b868dfc576b9e0ea92868550716e51",
      "skos:note": "Exemptions for pre-existing regulations"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-8-ss-2",
      "@type": "cof:Section",
      "cof:title": "8(2) Part 5 of Schedule 4 to the amending Act",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(2) Regulations that:\n(a) were made for the purposes of subsection 174(6) before the\ncommencement of Part 5 of Schedule 4 to the amending Act;\nand\n(b) were in force immediately before that commencement;\ncontinue in force (and may be dealt with) after that commencement\nas if they had been made for the purposes of subsection 174(1A)\n(as inserted by Part 5 of Schedule 4 to the amending Act).\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nGeneral protections (Schedule 5)  Part 5\n\nClause 9\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-8-ss-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
