      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.133",
      "values:originalText": "(5) A determination made under subclause (4) is not a legislative\ninstrument.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "skos:definition": "(5) A determination made under subclause (4) is not a legislative\ninstrument.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
