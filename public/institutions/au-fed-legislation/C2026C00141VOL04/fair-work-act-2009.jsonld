    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-122-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "122(3) Other general provisions about regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-122-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
