        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-4-logic-linearlogic-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-4-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "f105bab0242eac649fdefb20a16b225cc856a586a6161918b7c2eb0847247b0f",
      "skos:note": "Rights or liabilities arising from an authorisation covered by subclause (3) are unaffected."
    },
    {
