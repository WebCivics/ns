      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.21",
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nAmendment (Respect for Emergency Services Volunteers) Act\n2016.\ncommencement means the commencement of this Part.",
      "skos:definition": "In this Part:\namended Act means this Act as amended by the Fair Work\nAmendment (Respect for Emergency Services Volunteers) Act\n2016.\ncommencement means the commencement of this Part.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-13-norm"
        }
      ],
      "cml:integrityHash": "56b603c8d18d961412e5f4c1e690b977f0e2df269f38b8adbc0510928871dec3",
      "skos:note": "Defines amended Act and commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nAmendment (Respect for Emergency Services Volunteers) Act\n2016.\ncommencement means the commencement of this Part."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-13-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Application of amendments—objectionable emergency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.21",
      "values:originalText": "management terms\nApplication of amendments\n(1) The amended Act applies, after commencement, in relation to\nenterprise agreements approved, and workplace determinations\nmade, before or after commencement.\n(2) Sections 254A and 281AA of the amended Act apply in relation to\na matter that is before the FWC on or after commencement, even if\nthe matter was before the FWC before commencement.\nEnterprise agreements approved before commencement—\npreservation of terms in accordance with amended Act\n(3) If an enterprise agreement approved before commencement\nincludes an objectionable emergency management term, a term of\nthe agreement has effect after commencement to the extent that:\n(a) the term can have effect in accordance with the amended Act;\nand\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "management terms\nApplication of amendments\n(1) The amended Act applies, after commencement, in relation to\nenterprise agreements approved, and workplace determinations\nmade, before or after commencement.\n(2) Sections 254A and 281AA of the amended Act apply in relation to\na matter that is before the FWC on or after commencement, even if\nthe matter was before the FWC before commencement.\nEnterprise agreements approved before commencement—\npreservation of terms in accordance with amended Act\n(3) If an enterprise agreement approved before commencement\nincludes an objectionable emergency management term, a term of\nthe agreement has effect after commencement to the extent that:\n(a) the term can have effect in accordance with the amended Act;\nand\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-14-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-14-ss-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-14-ss-3"
        }
      ],
      "cml:integrityHash": "5bf105588e4ce127452e97f907b8cd57d8658a079e43f954b687be8425e0299a"
    },
    {
