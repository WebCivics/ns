    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.51",
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Secure Jobs, Better Pay) Act 2022.\namending Act means the Fair Work Legislation Amendment\n(Secure Jobs, Better Pay) Act 2022.\ncommencement means the commencement of this Part.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Secure Jobs, Better Pay) Act 2022.\namending Act means the Fair Work Legislation Amendment\n(Secure Jobs, Better Pay) Act 2022.\ncommencement means the commencement of this Part.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-55-norm"
        }
      ],
      "cml:integrityHash": "2d29fbfbb7f2f74902f124c09b2685880462cfc2c0dc2238d1205d4858e2e36d",
      "skos:note": "Definitions for amended Act and commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nLegislation Amendment (Secure Jobs, Better Pay) Act 2022.\namending Act means the Fair Work Legislation Amendment\n(Secure Jobs, Better Pay) Act 2022.\ncommencement means the commencement of this Part.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-55-norm",
