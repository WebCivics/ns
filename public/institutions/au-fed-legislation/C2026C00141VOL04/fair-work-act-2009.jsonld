      "skos:prefLabel": "77 Effect of making a single interest employer authorisation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-77"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.69",
      "values:originalText": "Paragraph 172(5)(b) of the amended Act, as inserted by Part 21 of\nSchedule 1 to the amending Act, applies in relation to single\ninterest employer authorisations on or after the commencement of\nthat Part if the authorisation was made on or after that\ncommencement.",
      "skos:definition": "Paragraph 172(5)(b) of the amended Act, as inserted by Part 21 of\nSchedule 1 to the amending Act, applies in relation to single\ninterest employer authorisations on or after the commencement of\nthat Part if the authorisation was made on or after that\ncommencement.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-77-norm"
        }
      ],
      "cml:integrityHash": "0d6ee3c128f025bcfcb9ae262d2e1312ce2731b439b8d0cac9ef3410b52f21fd",
      "skos:note": "Effect of making a single interest employer authorisation"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-77",
      "@type": "cof:Section",
      "cof:title": "77 Effect of making a single interest employer authorisation",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "Paragraph 172(5)(b) of the amended Act, as inserted by Part 21 of\nSchedule 1 to the amending Act, applies in relation to single\ninterest employer authorisations on or after the commencement of\nthat Part if the authorisation was made on or after that\ncommencement."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-77-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
