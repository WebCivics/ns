        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-108-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continues",
      "cml:logicSummary": "Obligation persists despite changes.",
      "cml:executionSurface": "modalities::logic::deontic",
