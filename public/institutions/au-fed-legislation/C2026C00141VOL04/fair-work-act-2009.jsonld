        }
      ],
      "cml:integrityHash": "12f660ffb783b0cc6ea946a82e113c7cb43397e2736063f6a98230a8110befba",
      "skos:note": "Legislative instrument determination is not valid."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-24-ss-5",
      "@type": "cof:Section",
      "cof:title": "24(5) Transitional provision—President",
      "values:kind": "subsection",
      "cof:pageNumber": 130,
      "values:originalText": "(5) A determination made under subclause (4) is not a legislative\ninstrument.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nChanging the name of Fair Work Australia (Schedule 9)  Part 9\n\nClause 25\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-24-ss-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
