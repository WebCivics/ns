        },
        {
          "@id": "concept:fair-work-act-2009-sch-5-sec-14-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "0a421225977c89f0542cfac86f75229f61fc3c07121348a610bf8493e0e27ade",
      "skos:note": "Paragraph 559(3A)(c) applies in relation to an amount that was paid to the Commonwealth under subsection 559(1) after the commencement of Part 10 of Schedule 1 to the amending Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-5-sec-14",
