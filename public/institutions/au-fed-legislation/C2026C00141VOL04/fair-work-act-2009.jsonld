      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.125",
      "values:originalText": "The amendment made by Part 1 of Schedule 5 to the amending Act\n(which is about time limits for making applications) applies in\nrelation to dismissals that take effect after the commencement of\nthat Part.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "skos:definition": "The amendment made by Part 1 of Schedule 5 to the amending Act\n(which is about time limits for making applications) applies in\nrelation to dismissals that take effect after the commencement of\nthat Part.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-9-norm"
        }
      ],
      "cml:integrityHash": "82d90cc26574684e54cedf844d65a30628dc9ae630cf77e751d4ecf22984f29e",
      "skos:note": "Amendment applies in relation to dismissals after commencement of Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-9",
      "@type": "cof:Section",
