      "dc:source": "fair-work-act-2009.pdf, p.38",
      "values:originalText": "In this Part:\namended Act means this Act as amended by the Fair Work\nAmendment (Supporting Australia’s Jobs and Economic Recovery)\nAct 2021.\namending Act means the Fair Work Amendment (Supporting\nAustralia’s Jobs and Economic Recovery) Act 2021.\ncommencement means the commencement of this Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Supporting Australia’s Jobs and\nEconomic Recovery) Act 2021  Part 10\nAmendments made by Schedule 1 to the amending Act  Division 2\nClause 45\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "In this Part:\namended Act means this Act as amended by the Fair Work\nAmendment (Supporting Australia’s Jobs and Economic Recovery)\nAct 2021.\namending Act means the Fair Work Amendment (Supporting\nAustralia’s Jobs and Economic Recovery) Act 2021.\ncommencement means the commencement of this Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Supporting Australia’s Jobs and\nEconomic Recovery) Act 2021  Part 10\nAmendments made by Schedule 1 to the amending Act  Division 2\nClause 45\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-44-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-44-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-44-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "66ea2e71f4b4dde08f5b0294ea3d0367b6f2dd2f0274bf1eedba05021e437c2a",
      "skos:note": "Definitions for amended Act and commencement"
    },
