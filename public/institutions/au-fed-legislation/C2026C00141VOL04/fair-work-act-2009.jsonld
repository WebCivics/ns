      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-4-sec-8a",
      "@type": "cml:Concept",
      "skos:prefLabel": "8A Schedule 3A to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-8a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.143",
      "values:originalText": "The amendments made by Schedule 3A to the amending Act apply\nin relation to a matter that arises before or after the commencement\nof that Schedule, whether or not a conference starts to be\nconducted in relation to the matter before or after that\ncommencement.\n\nSchedule 4  Amendments made by the Fair Work Amendment Act 2013",
      "skos:definition": "The amendments made by Schedule 3A to the amending Act apply\nin relation to a matter that arises before or after the commencement\nof that Schedule, whether or not a conference starts to be\nconducted in relation to the matter before or after that\ncommencement.\n\nSchedule 4  Amendments made by the Fair Work Amendment Act 2013",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-8a-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-8a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "03e12636b99b3426904ccb79d094e47bf03cb07e66e1e82a7979635e011003b0",
      "skos:note": "Conditional commencement of Schedule 3A amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-8a",
      "@type": "cof:Section",
      "cof:title": "8A Schedule 3A to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 143,
      "values:originalText": "The amendments made by Schedule 3A to the amending Act apply\nin relation to a matter that arises before or after the commencement\nof that Schedule, whether or not a conference starts to be\nconducted in relation to the matter before or after that\ncommencement.\n\nSchedule 4  Amendments made by the Fair Work Amendment Act 2013"
    },
