    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Effect on TCF contract outworker’s entitlements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-3"
