    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-95",
      "@type": "cml:Concept",
      "skos:prefLabel": "95 FWC to vary certain modern awards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-95"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.85",
      "values:originalText": "(1) This clause applies in relation to a modern award if the award:\n(a) is made before 1 July 2024; and\n(b) is to be in operation on that day.\n(2) The FWC must, by 30 June 2024, make a determination varying\nthe modern award to include a delegates’ rights term.\n(3) A determination made under subclause (2) comes into operation on\n(and takes effect from) 1 July 2024.\n(4) Section 168 applies to a determination made under subclause (2) as\nif it were a determination made under Part 2-3.",
      "skos:definition": "(1) This clause applies in relation to a modern award if the award:\n(a) is made before 1 July 2024; and\n(b) is to be in operation on that day.\n(2) The FWC must, by 30 June 2024, make a determination varying\nthe modern award to include a delegates’ rights term.\n(3) A determination made under subclause (2) comes into operation on\n(and takes effect from) 1 July 2024.\n(4) Section 168 applies to a determination made under subclause (2) as\nif it were a determination made under Part 2-3.",
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-95-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-95-ss-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-95-ss-3"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-95-ss-4"
        }
      ],
      "cml:integrityHash": "ccbbe9d1627573d0bde3df45808d506a590a22ceabfe9b443608ba57cb6ee21f"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-95",
      "@type": "cof:Section",
      "cof:title": "95 FWC to vary certain modern awards",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "(1) This clause applies in relation to a modern award if the award:\n(a) is made before 1 July 2024; and\n(b) is to be in operation on that day.\n(2) The FWC must, by 30 June 2024, make a determination varying\nthe modern award to include a delegates’ rights term.\n(3) A determination made under subclause (2) comes into operation on\n(and takes effect from) 1 July 2024.\n(4) Section 168 applies to a determination made under subclause (2) as\nif it were a determination made under Part 2-3."
    },
