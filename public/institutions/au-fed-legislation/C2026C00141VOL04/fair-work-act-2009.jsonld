      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-66"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "67 The better off overall test",
      "cml:realizedBy": {
