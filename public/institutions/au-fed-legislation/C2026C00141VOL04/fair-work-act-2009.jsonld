    {
      "@id": "concept:fair-work-act-2009-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Application of the amendments made by the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.118",
      "values:originalText": "The amendments made by the amending Act apply in relation to a\ntransfer of business referred to in Part 6-3A (as inserted by item 1\nof Schedule 1 to the amending Act), but only if the connection\nbetween the old State employer and the new employer referred to\nin paragraph 768AD(1)(d) (as inserted by that item) occurs on or\nafter commencement.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nPreliminary  Part 1\n\nClause 1\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "The amendments made by the amending Act apply in relation to a\ntransfer of business referred to in Part 6-3A (as inserted by item 1\nof Schedule 1 to the amending Act), but only if the connection\nbetween the old State employer and the new employer referred to\nin paragraph 768AD(1)(d) (as inserted by that item) occurs on or\nafter commencement.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nPreliminary  Part 1\n\nClause 1\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-2-sec-2-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-2-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-2-sec-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "1022c7490c6de3f8ec899fe8228b26fa9c5c9113f4bb62e5648abadbdc616c74",
      "skos:note": "Amendments apply only if connection between old and new employer occurs on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Application of the amendments made by the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 118,
      "values:originalText": "The amendments made by the amending Act apply in relation to a\ntransfer of business referred to in Part 6-3A (as inserted by item 1\nof Schedule 1 to the amending Act), but only if the connection\nbetween the old State employer and the new employer referred to\nin paragraph 768AD(1)(d) (as inserted by that item) occurs on or\nafter commencement.\n\nAmendments made by the Fair Work Amendment Act 2012  Schedule 3\nPreliminary  Part 1\n\nClause 1\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
