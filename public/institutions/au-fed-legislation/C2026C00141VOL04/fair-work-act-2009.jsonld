    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-111-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "111(6) Application of amendments to intractable bargaining workplace",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-111-ss-6"
