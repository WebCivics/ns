    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-124",
      "@type": "cml:Concept",
      "skos:prefLabel": "124 Unfair deactivation and unfair termination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-124"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.113",
      "values:originalText": "(1) Part 3A-3 (unfair deactivation or unfair termination of regulated\nworkers) applies to a deactivation or termination that occurs after\ncommencement.\n(2) For the purposes of determining under paragraph 536LD(c)\nwhether an employee-like worker has been performing work for a\nperiod of at least 6 months, a period or periods before\ncommencement are not to be counted.\n(3) For the purposes of determining under paragraph 536LE(c)\nwhether a regulated road transport contractor has been performing\nwork for a period of at least 6 months, a period or periods before\ncommencement are not to be counted.",
      "skos:definition": "(1) Part 3A-3 (unfair deactivation or unfair termination of regulated\nworkers) applies to a deactivation or termination that occurs after\ncommencement.\n(2) For the purposes of determining under paragraph 536LD(c)\nwhether an employee-like worker has been performing work for a\nperiod of at least 6 months, a period or periods before\ncommencement are not to be counted.\n(3) For the purposes of determining under paragraph 536LE(c)\nwhether a regulated road transport contractor has been performing\nwork for a period of at least 6 months, a period or periods before\ncommencement are not to be counted.",
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-124-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-124-ss-2"
        },
        {
