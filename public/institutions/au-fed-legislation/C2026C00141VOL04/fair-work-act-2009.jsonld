        }
      ],
      "cml:integrityHash": "4e357fb3c9b24b93e3909630bdcbc1d98560beafade9fe0f1f1d14323077741b",
      "skos:note": "Transitional provision for Deputy President of FWA"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-25-ss-3",
      "@type": "cof:Section",
      "cof:title": "25(3) Transitional provision—Deputy President",
      "values:kind": "subsection",
      "cof:pageNumber": 131,
      "values:originalText": "(3) If, before that commencement, a thing was done by, or in relation\nto, a Deputy President of FWA, then, for the purposes of the\noperation of any law on or after that commencement, the thing is\ntaken to have been done by, or in relation to, a Deputy President of\nthe FWC."
    },
