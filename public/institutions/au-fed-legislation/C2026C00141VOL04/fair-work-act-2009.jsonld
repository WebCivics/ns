        }
      ],
      "cml:integrityHash": "ce0cea879897f3e85b28168b9e956b3e43aea5609a0f08d0f73edb53861e3b76",
      "skos:note": "Variation of supported bargaining authorisations"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-105",
      "@type": "cof:Section",
      "cof:title": "105 Variation of supported bargaining authorisations",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "Subsection 245(2), as inserted by the amending Act, applies in\nrelation to enterprise agreements and workplace determinations\nthat come into operation before or after the commencement of\nPart 4 of Schedule 1 to that Act."
    },
