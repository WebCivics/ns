    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
