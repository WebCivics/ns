      "cml:integrityHash": "aa33bc60ed402871783045fe7ccd070e37d127534ae38c0f88ec2fb30f0e78b0",
      "skos:note": "Minister must make a decision on application before commencement of Part 21."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-74-ss-1",
      "@type": "cof:Section",
      "cof:title": "74(1) Application to existing applications for declarations",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(1) This clause applies in relation to applications for declarations made\nunder subsection 247(1) of the Act immediately before the\ncommencement of Part 21 of Schedule 1 to the amending Act if,\nimmediately before that commencement, the Minister had not\nmade a decision on the application."
    },
