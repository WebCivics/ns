        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-6-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "41a6fb3f7ae9d03730fdc241b8b170eeaf934f27b15b7cdf74d355920ac07436",
      "skos:note": "Employee cannot take flexible unpaid parental leave before a certain period."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-43-ss-6",
      "@type": "cof:Section",
      "cof:title": "43(6) Amendments about flexible unpaid parental leave",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(6) The employee cannot take flexible unpaid parental leave before the\nend of 4 weeks starting on the day the notice under subclause (2) is\ngiven, despite subsection 74(4B).\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
