        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-4-logic-deontic-1",
