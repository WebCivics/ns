    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-49a",
      "@type": "cml:Concept",
      "skos:prefLabel": "49A Applications for orders to stop sexual harassment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-49a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.46",
      "values:originalText": "The amendments of section 789FC made by the Sex\nDiscrimination and Fair Work (Respect at Work) Amendment Act\n2021 apply in relation to an application made under that section\nafter the end of the 2-month period beginning at the\ncommencement of this clause.",
      "skos:definition": "The amendments of section 789FC made by the Sex\nDiscrimination and Fair Work (Respect at Work) Amendment Act\n2021 apply in relation to an application made under that section\nafter the end of the 2-month period beginning at the\ncommencement of this clause.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-49a-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-49a-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-49a-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "d44eef1366732f3d4a714087bbe9d5f5113048c9dcf93b20f7b3fb5ea6896e52",
      "skos:note": "Amendments apply to applications made after a certain period."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-49a",
      "@type": "cof:Section",
      "cof:title": "49A Applications for orders to stop sexual harassment",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "The amendments of section 789FC made by the Sex\nDiscrimination and Fair Work (Respect at Work) Amendment Act\n2021 apply in relation to an application made under that section\nafter the end of the 2-month period beginning at the\ncommencement of this clause."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-49a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
