      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.113",
      "values:originalText": "An application in relation to a services contract may be made under\nsection 536ND only if the contract was entered into on or after\ncommencement.",
      "skos:definition": "An application in relation to a services contract may be made under\nsection 536ND only if the contract was entered into on or after\ncommencement.",
