    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-92",
      "@type": "cml:Concept",
      "skos:prefLabel": "92 Application—section 121",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-92"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.83",
      "values:originalText": "Despite the amendment made by item 28 of Part 2 of Schedule 1 to\nthe amending Act, section 121, as in force immediately before the\ncommencement of that item, continues to apply in relation to the\ntermination of an employee’s employment if any of the following\noccurred before that commencement:\n(a) the termination of the employee;\n(b) any other termination covered by that section as amended\nthat caused the employer to become a small business\nemployer.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "Despite the amendment made by item 28 of Part 2 of Schedule 1 to\nthe amending Act, section 121, as in force immediately before the\ncommencement of that item, continues to apply in relation to the\ntermination of an employee’s employment if any of the following\noccurred before that commencement:\n(a) the termination of the employee;\n(b) any other termination covered by that section as amended\nthat caused the employer to become a small business\nemployer.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-92-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-92-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-92-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "1a65b015f2a3949e850b4efd2f5328192e47f946df6b8852c3c6a68f8b23bd15",
      "skos:note": "Section 121 continues to apply in relation to the termination of an employee's employment under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-92",
      "@type": "cof:Section",
      "cof:title": "92 Application—section 121",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "Despite the amendment made by item 28 of Part 2 of Schedule 1 to\nthe amending Act, section 121, as in force immediately before the\ncommencement of that item, continues to apply in relation to the\ntermination of an employee’s employment if any of the following\noccurred before that commencement:\n(a) the termination of the employee;\n(b) any other termination covered by that section as amended\nthat caused the employer to become a small business\nemployer.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
