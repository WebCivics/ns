      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Obligation to comply with section 324 of the amended Act.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An authorisation is covered by this subclause...",
      "cml:conclusionText": "The authorisation must comply with section 324 of the amended Act."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Overlap between the commencement of Schedule 5 and the amended Act.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An authorisation is covered by this subclause...",
      "cml:conclusionText": "The commencement of Schedule 5 overlaps with the amended Act."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Repeatable obligation to comply with section 324 of the amended Act.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An authorisation is covered by this subclause...",
      "cml:conclusionText": "The obligation to comply with section 324 of the amended Act. repeats."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of obligations from Schedule 5 to the amended Act.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An authorisation is covered by this subclause...",
      "cml:conclusionText": "The obligations from Schedule 5 diffuse to the amended Act."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognises",
      "cml:logicSummary": "Recognition of obligations in artificial intelligence systems.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An authorisation is covered by this subclause...",
      "cml:conclusionText": "The system recognises the obligation."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-90-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "90(4) Employee authorised deductions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-90-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.81",
      "values:originalText": "(4) However, paragraph (2)(a) does not affect rights or liabilities\narising between parties to proceedings:\n(a) in which judgment is reserved by a court before the\ncommencement of Schedule 5; or\n(b) which have been heard and finally determined by a court\nbefore the commencement;\nto the extent those rights or liabilities arose from, or were affected\nby, an authorisation covered by subclause (3).\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "(4) However, paragraph (2)(a) does not affect rights or liabilities\narising between parties to proceedings:\n(a) in which judgment is reserved by a court before the\ncommencement of Schedule 5; or\n(b) which have been heard and finally determined by a court\nbefore the commencement;\nto the extent those rights or liabilities arose from, or were affected\nby, an authorisation covered by subclause (3).\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-90"
      },
      "cml:asserts": [
        {
