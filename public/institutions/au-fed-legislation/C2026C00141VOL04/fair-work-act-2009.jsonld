      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "43(5) Amendments about flexible unpaid parental leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-43-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.36",
      "values:originalText": "(5) If the employee gives notice in accordance with subclauses (2) and\n(3), then:\n(a) the notice is taken to be a notice given under\nsubsection 74(1) in relation to the taking of flexible unpaid\nparental leave; and\n(b) subsections 74(3A) and (3B) are taken to have been complied\nwith in relation to the giving of that notice; and\n(c) if the notice contains advice as referred to in subclause (4)—\nthe employee is taken to have complied with\nsubsection 74(4) in relation to the initial leave period.",
      "skos:definition": "(5) If the employee gives notice in accordance with subclauses (2) and\n(3), then:\n(a) the notice is taken to be a notice given under\nsubsection 74(1) in relation to the taking of flexible unpaid\nparental leave; and\n(b) subsections 74(3A) and (3B) are taken to have been complied\nwith in relation to the giving of that notice; and\n(c) if the notice contains advice as referred to in subclause (4)—\nthe employee is taken to have complied with\nsubsection 74(4) in relation to the initial leave period.",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-43"
      },
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-5-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2cad733146719c2214ddf1abc28dbc955a8d5b3cc6f1051940ab24f045a7fe36",
      "skos:note": "Notice requirements for flexible unpaid parental leave",
      "dc:description": "Notice in accordance with subclauses (2) and (3)"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-43-ss-5",
      "@type": "cof:Section",
      "cof:title": "43(5) Amendments about flexible unpaid parental leave",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(5) If the employee gives notice in accordance with subclauses (2) and\n(3), then:\n(a) the notice is taken to be a notice given under\nsubsection 74(1) in relation to the taking of flexible unpaid\nparental leave; and\n(b) subsections 74(3A) and (3B) are taken to have been complied\nwith in relation to the giving of that notice; and\n(c) if the notice contains advice as referred to in subclause (4)—\nthe employee is taken to have complied with\nsubsection 74(4) in relation to the initial leave period."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-43-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
