    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.15",
      "values:originalText": "In this Part:\namended Act means this Act as amended by the amending Act.\namending Act means the Fair Work Amendment (Textile, Clothing\nand Footwear Industry) Act 2012.\ncommencement means the commencement of this Part.\ndeemed employee means a TCF contract outworker who is taken\nby section 789BB of the amended Act to be an employee.\ndeemed employer means a person who is taken by section 789BB\nof the amended Act to be the employer of a deemed employee.",
      "skos:definition": "In this Part:\namended Act means this Act as amended by the amending Act.\namending Act means the Fair Work Amendment (Textile, Clothing\nand Footwear Industry) Act 2012.\ncommencement means the commencement of this Part.\ndeemed employee means a TCF contract outworker who is taken\nby section 789BB of the amended Act to be an employee.\ndeemed employer means a person who is taken by section 789BB\nof the amended Act to be the employer of a deemed employee.",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-1-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-1-logic-descriptionlogic-3"
        }
      ],
      "cml:integrityHash": "43043a3f39cb23a32f22b2893806c5ef7b4ae337bf9024de727b76633743b0e2",
      "skos:note": "Defines terms used in this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "In this Part:\namended Act means this Act as amended by the amending Act.\namending Act means the Fair Work Amendment (Textile, Clothing\nand Footwear Industry) Act 2012.\ncommencement means the commencement of this Part.\ndeemed employee means a TCF contract outworker who is taken\nby section 789BB of the amended Act to be an employee.\ndeemed employer means a person who is taken by section 789BB\nof the amended Act to be the employer of a deemed employee."
    },
    {
