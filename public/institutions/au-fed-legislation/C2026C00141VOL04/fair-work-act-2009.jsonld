      "@type": "cml:Concept",
      "skos:prefLabel": "2 Schedule 1 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-2"
      },
      "cml:curationStatus": {
