    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Application of section 641B of the amended Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.31",
      "values:originalText": "Section 641B of the amended Act applies in relation to alleged\nmisbehaviour or incapacity of an FWC Member occurring before\nor after the commencement of Schedule 3 to the amending Act.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "Section 641B of the amended Act applies in relation to alleged\nmisbehaviour or incapacity of an FWC Member occurring before\nor after the commencement of Schedule 3 to the amending Act.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-29-norm"
        }
      ],
      "cml:integrityHash": "8a7344d2035676b8a63a2aa429d722b56957b519fa8d6811681cd3a04610a039",
      "skos:note": "Section applies in relation to alleged misbehaviour or incapacity of an FWC Member before or after commencement of Schedule 3."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Application of section 641B of the amended Act",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Section 641B of the amended Act applies in relation to alleged\nmisbehaviour or incapacity of an FWC Member occurring before\nor after the commencement of Schedule 3 to the amending Act.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
    {
