    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Requests for flexible working arrangements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.60",
      "values:originalText": "The amendments made by Divisions 1, 3, 4 and 5 of Part 11 of\nSchedule 1 to the amending Act apply in relation to a request made\nunder subsection 65(1) of this Act on or after the commencement\nof that Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 12 of Schedule 1 to the amending Act  Division 10\nClause 65\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "The amendments made by Divisions 1, 3, 4 and 5 of Part 11 of\nSchedule 1 to the amending Act apply in relation to a request made\nunder subsection 65(1) of this Act on or after the commencement\nof that Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 12 of Schedule 1 to the amending Act  Division 10\nClause 65\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-64-norm"
        }
      ],
      "cml:integrityHash": "c3852b82e9ba465d27ddab441501e3748aa0c985b47263bfaf67ef194d2126a1",
      "skos:note": "Amendments apply to requests made on or after commencement of Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Requests for flexible working arrangements",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "The amendments made by Divisions 1, 3, 4 and 5 of Part 11 of\nSchedule 1 to the amending Act apply in relation to a request made\nunder subsection 65(1) of this Act on or after the commencement\nof that Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Legislation Amendment (Secure Jobs, Better Pay)\nAct 2022  Part 13\nAmendments made by Part 12 of Schedule 1 to the amending Act  Division 10\nClause 65\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-64-norm",
      "@type": "values:Undertaking",
