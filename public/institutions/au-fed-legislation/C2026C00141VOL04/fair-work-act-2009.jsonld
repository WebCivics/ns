    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 789BB of amended Act applies to contracts entered into",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.15",
      "values:originalText": "after commencement\n(1) Section 789BB of the amended Act applies in relation to particular\nTCF work performed by a TCF contract outworker only if the\ncontract for the provision of services, for the purpose of which the\noutworker performs the work, is entered into after commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "skos:definition": "after commencement\n(1) Section 789BB of the amended Act applies in relation to particular\nTCF work performed by a TCF contract outworker only if the\ncontract for the provision of services, for the purpose of which the\noutworker performs the work, is entered into after commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5d858039712f96f16a5ddaf1b8b82eef707a3103fde018fb17eb429356cebd1c",
      "skos:note": "Section applies after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Section 789BB of amended Act applies to contracts entered into",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "after commencement\n(1) Section 789BB of the amended Act applies in relation to particular\nTCF work performed by a TCF contract outworker only if the\ncontract for the provision of services, for the purpose of which the\noutworker performs the work, is entered into after commencement.\n\nSchedule 1  Application, saving and transitional provisions relating to amendments of\nthis Act"
    },
