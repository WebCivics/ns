      "dc:source": "fair-work-act-2009.pdf, p.133",
      "values:originalText": "(1) A person holding office as a Minimum Wage Panel Member of\nFWA immediately before the commencement of Part 1 of\nSchedule 9 to the amending Act continues to hold office:\n(a) as a Minimum Wage Panel Member of the FWC; and\n(b) for the balance of the person’s term of appointment that\nremains immediately before that commencement.",
      "skos:definition": "(1) A person holding office as a Minimum Wage Panel Member of\nFWA immediately before the commencement of Part 1 of\nSchedule 9 to the amending Act continues to hold office:\n(a) as a Minimum Wage Panel Member of the FWC; and\n(b) for the balance of the person’s term of appointment that\nremains immediately before that commencement.",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-3-sec-27"
      },
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-27-ss-1-norm"
        }
      ],
      "cml:integrityHash": "dbff9df40795c6f58b94e1c337412e5a0630f67c6caf6f902c7ffc85e8568222",
      "skos:note": "Continuation of office after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-27-ss-1",
      "@type": "cof:Section",
      "cof:title": "27(1) Transitional provision—Minimum Wage Panel Member",
      "values:kind": "subsection",
      "cof:pageNumber": 133,
      "values:originalText": "(1) A person holding office as a Minimum Wage Panel Member of\nFWA immediately before the commencement of Part 1 of\nSchedule 9 to the amending Act continues to hold office:\n(a) as a Minimum Wage Panel Member of the FWC; and\n(b) for the balance of the person’s term of appointment that\nremains immediately before that commencement."
    },
