    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Orders to stop bullying",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.46",
      "values:originalText": "Scope\n(1) This clause applies to an order that was in force under\nsubsection 789FF(1) immediately before the commencement of\nthis clause.\nTransitional\n(2) Despite the repeal of that subsection by the Sex Discrimination and\nFair Work (Respect at Work) Amendment Act 2021, that subsection\ncontinues to apply, in relation to the order, as if that repeal had not\nhappened.",
      "skos:definition": "Scope\n(1) This clause applies to an order that was in force under\nsubsection 789FF(1) immediately before the commencement of\nthis clause.\nTransitional\n(2) Despite the repeal of that subsection by the Sex Discrimination and\nFair Work (Respect at Work) Amendment Act 2021, that subsection\ncontinues to apply, in relation to the order, as if that repeal had not\nhappened.",
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-49-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-49-ss-2"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Orders to stop bullying",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Scope\n(1) This clause applies to an order that was in force under\nsubsection 789FF(1) immediately before the commencement of\nthis clause.\nTransitional\n(2) Despite the repeal of that subsection by the Sex Discrimination and\nFair Work (Respect at Work) Amendment Act 2021, that subsection\ncontinues to apply, in relation to the order, as if that repeal had not\nhappened."
    },
