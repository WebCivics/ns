    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Part 8 of Schedule 8 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.129",
      "values:originalText": "The amendments made by Part 8 of Schedule 8 to the amending\nAct (which is about engaging in outside work) apply in relation to\npaid work that is engaged in after the commencement of that Part.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "skos:definition": "The amendments made by Part 8 of Schedule 8 to the amending\nAct (which is about engaging in outside work) apply in relation to\npaid work that is engaged in after the commencement of that Part.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-3-sec-23-norm"
        }
      ],
      "cml:integrityHash": "0265a0c47b4ebe8c68b2be7688e4577c64ceceb73d4fbb6e72a6c811bd49bb95",
      "skos:note": "Amendments apply in relation to paid work engaged after commencement of Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-3-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Part 8 of Schedule 8 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 129,
      "values:originalText": "The amendments made by Part 8 of Schedule 8 to the amending\nAct (which is about engaging in outside work) apply in relation to\npaid work that is engaged in after the commencement of that Part.\n\nSchedule 3  Amendments made by the Fair Work Amendment Act 2012"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-3-sec-23-norm",
      "@type": "values:Undertaking",
