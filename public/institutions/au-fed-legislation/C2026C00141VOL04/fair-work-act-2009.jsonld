    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-62",
      "@type": "cml:Concept",
      "skos:prefLabel": "62 Fixed term contracts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-62"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
