    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-120-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "120(5) FWC power to deal with uncertainties or difficulties arising",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-120-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.108",
      "values:originalText": "(5) A variation of a fair work instrument under this clause operates\nfrom the day specified in the determination, which may be a day\nbefore the determination was made.",
      "skos:definition": "(5) A variation of a fair work instrument under this clause operates\nfrom the day specified in the determination, which may be a day\nbefore the determination was made.",
      "values:partOf": {
        "@id": "concept:fair-work-act-2009-sch-1-sec-120"
      },
      "cml:asserts": [
