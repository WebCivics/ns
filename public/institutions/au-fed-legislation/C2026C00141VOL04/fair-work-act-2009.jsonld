      },
      "dc:source": "fair-work-act-2009.pdf, p.140",
      "values:originalText": "The amendments made by Part 5 of Schedule 1 to the amending\nAct apply in relation to evidence that is given under section 81\nafter the commencement of that Part.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nModern awards objective (Schedule 2)  Part 3\n\nClause 7\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "The amendments made by Part 5 of Schedule 1 to the amending\nAct apply in relation to evidence that is given under section 81\nafter the commencement of that Part.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nModern awards objective (Schedule 2)  Part 3\n\nClause 7\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-6-norm"
        }
      ],
      "cml:integrityHash": "8f4a620f4e7dc61d59e63224c39aade53b9dd5d9c9257b4ca74c0b86dcffb3b1",
      "skos:note": "Amendments apply in relation to evidence given under section 81 after commencement of Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-4-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Part 5 of Schedule 1 to the amending Act",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "The amendments made by Part 5 of Schedule 1 to the amending\nAct apply in relation to evidence that is given under section 81\nafter the commencement of that Part.\n\nAmendments made by the Fair Work Amendment Act 2013  Schedule 4\nModern awards objective (Schedule 2)  Part 3\n\nClause 7\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
