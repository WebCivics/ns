      "cml:premiseText": "Employer agrees to bargain after commencement.",
      "cml:conclusionText": "Amendments apply."
    },
    {
      "@id": "concept:fair-work-act-2009-sch-5-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Part 7 of Schedule 1 to the amending Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-5-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
