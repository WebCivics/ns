    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-53-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "SubclassOf",
      "cml:logicSummary": "Agreement must be consistent with NES entitlement",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
