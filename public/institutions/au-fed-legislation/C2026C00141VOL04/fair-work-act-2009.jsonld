        }
      ],
      "cml:integrityHash": "1af5f439ae198895b971d0869eddddac728e19d20e75b79fb3a104ca47bcb9aa"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-124",
      "@type": "cof:Section",
