    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Resolving uncertainties and difficulties about interaction between",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-40"
      },
      "cml:curationStatus": {
