      }
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Disclosure by organisations and employers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.32",
      "values:originalText": "The amendments of Subdivision A of Division 4 of Part 2-4 made\nby Schedule 2 to the Fair Work Amendment (Corrupting Benefits)\nAct 2017 apply in relation to a proposed enterprise agreement for\nwhich the access period under subsection 180(4) begins on or after\nthe commencement of this Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Family and Domestic Violence\nLeave) Act 2018  Part 8\n\nClause 39\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "skos:definition": "The amendments of Subdivision A of Division 4 of Part 2-4 made\nby Schedule 2 to the Fair Work Amendment (Corrupting Benefits)\nAct 2017 apply in relation to a proposed enterprise agreement for\nwhich the access period under subsection 180(4) begins on or after\nthe commencement of this Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Family and Domestic Violence\nLeave) Act 2018  Part 8\n\nClause 39\nFair Work Act 2009\nCompilation date: 02/04/2026",
      "cml:asserts": [
        {
          "@id": "concept:fair-work-act-2009-sch-1-sec-30-norm"
        }
      ],
      "cml:integrityHash": "69edebc004fac9bb0615340b777f532ccfd83a33421c63fd7303e65547c6981b",
      "skos:note": "Disclosure by organisations and employers"
    },
    {
      "@id": "https://ns.webcivics.net/values/fair-work-act-2009#sch-1-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Disclosure by organisations and employers",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "The amendments of Subdivision A of Division 4 of Part 2-4 made\nby Schedule 2 to the Fair Work Amendment (Corrupting Benefits)\nAct 2017 apply in relation to a proposed enterprise agreement for\nwhich the access period under subsection 180(4) begins on or after\nthe commencement of this Part.\n\nApplication, saving and transitional provisions relating to amendments of this Act\nSchedule 1\nAmendments made by the Fair Work Amendment (Family and Domestic Violence\nLeave) Act 2018  Part 8\n\nClause 39\nFair Work Act 2009\nCompilation date: 02/04/2026"
    },
    {
