      },
      "prov:wasDerivedFrom": {
        "@id": "fair-work-act-2009.pdf"
      },
      "dc:source": "fair-work-act-2009.pdf, p.145",
      "values:originalText": "(1) The amendments made by Part 1 of Schedule 4A to the amending\nAct apply in relation to dismissals that take effect after the\ncommencement of that Schedule.\n(2) The amendments made by Part 2 of Schedule 4A to the amending\nAct apply in relation to employment that is terminated after the\ncommencement of that Schedule.\n\nSchedule 4  Amendments made by the Fair Work Amendment Act 2013",
      "skos:definition": "(1) The amendments made by Part 1 of Schedule 4A to the amending\nAct apply in relation to dismissals that take effect after the\ncommencement of that Schedule.\n(2) The amendments made by Part 2 of Schedule 4A to the amending\nAct apply in relation to employment that is terminated after the\ncommencement of that Schedule.\n\nSchedule 4  Amendments made by the Fair Work Amendment Act 2013",
      "cml:hasPart": [
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-10-ss-1"
        },
        {
          "@id": "concept:fair-work-act-2009-sch-4-sec-10-ss-2"
        }
      ],
      "cml:integrityHash": "315d2ab24a3222fe20f80b62b8bc35b75527d7780ccabb99a00e094a5e412a7b"
    },
    {
