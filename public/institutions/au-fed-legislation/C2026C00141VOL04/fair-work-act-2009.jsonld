      },
      "cml:premiseText": "Agreement includes terms entitling employees to paid family and domestic violence leave",
      "cml:conclusionText": "Agreement is inconsistent with NES entitlement"
    },
    {
      "@id": "concept:fair-work-act-2009-sch-1-sec-53-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "FWC's power to vary agreement overlaps with employee's right to claim NES entitlement",
      "cml:executionSurface": "modalities::interval_reasoning",
