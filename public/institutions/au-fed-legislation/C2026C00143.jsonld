    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compilation is a representation of the law at that time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies the text of the law as amended and in force.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The compilation shows the text of the law as amended and in force on 27 March 2026."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The notes provide additional context on amendments.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Includes information about amending laws and amendment history.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The notes include information about amending laws and the amendment history of provisions."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Uncommenced amendments are accessible on the Register.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Provides details on uncommenced amendments and their effect.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The effect of uncommenced amendments is not shown in the text of the compiled law."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Details are included in the endnotes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Includes details on applications, saving, and transitional provisions.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If the operation of a provision or amendment is affected by an application, saving, or transitional provision."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Presentational changes are applied to give a more consistent look and feel.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Provides information on editorial changes and presentational changes.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "For more information about any editorial changes made in this compilation, see the endnotes."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Modifications affecting the law are accessible on the Register.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Includes details on modifications and self-repealing provisions.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If the compiled law is modified by another law, the compilation does not show the text as modified."
    },
