      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-28-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If Minister approves, then CEO can engage in paid work outside duties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
