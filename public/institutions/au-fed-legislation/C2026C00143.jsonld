        "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-alleninterval-2",
        "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-ltl-3",
        "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-diffusion-4",
        "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "42af4f5b2c9f1d9bd062d190d54cf9a2f9875960c600cbdbab4b159d0ef4a23d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
