    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2",
      "@type": "cml:Concept",
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.27",
      "skos:note": "Governor-General must terminate CEO appointment under certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "29C(2) Termination of appointment"
      },
      "wasDerivedFrom": "australian-centre-for-international-agricultural-research-act-1982.pdf",
      "asserts": [
        "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-norm",
