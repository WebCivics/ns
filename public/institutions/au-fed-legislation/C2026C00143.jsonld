    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The termination occurs during bankruptcy, application for debt relief, or compounding with creditors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for termination",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(2) The Governor-General must terminate the appointment of the CEO if..."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The AI system recommends termination under bankruptcy, application for debt relief, or compounding with creditors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Artificial intelligence application",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "must",
      "cml:premiseText": "(2) The Governor-General must terminate the appointment of the CEO if..."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The CEO's appointment is terminated.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory action",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "The Governor-General must terminate the appointment of the CEO."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The termination is conditional on bankruptcy, application for debt relief, or compounding with creditors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Conditional diffusion",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if",
      "cml:premiseText": "(2) The Governor-General must terminate the appointment of the CEO if..."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The termination occurs until bankruptcy, application for debt relief, or compounding with creditors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval for termination",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "(2) The Governor-General must terminate the appointment of the CEO if..."
    },
