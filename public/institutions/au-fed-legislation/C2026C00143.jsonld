      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Minister's approval implies CEO's right to engage in paid work outside duties.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The CEO must not engage in paid work outside the duties of the CEO without the Minister's approval."
    },
