doc:sec-33-ss-2 a cof:Section ;
    cof:title "33(2) Australian Centre for International Agricultural Research" ;
    values:kind "subsection" ;
    values:originalText "(2) The Account is a special account for the purposes of the Public Governance, Performance and Accountability Act 2013." ;
    cof:pageNumber "31"^^xsd:integer .

concept:australian-centre-for-international-agricultural-research-act-1982-sec-34 a cml:Concept ;
    skos:prefLabel "34 Credits to the Account"@en ;
    cml:realizedBy doc:sec-34 ;
    values:originalText "There must be credited to the Account amounts equal to the following: (a) all money appropriated by the Parliament for the purposes of the Account; (b) other money received by the Commonwealth in relation to the performance of the functions of the CEO; (c) amounts of any gifts given or bequests made for the purposes of the Account. Note: An Appropriation Act provides for amounts to be credited to a special account if any of the purposes of the special account is a purpose that is covered by an item in the Appropriation Act." ;
    skos:definition "There must be credited to the Account amounts equal to the following: (a) all money appropriated by the Parliament for the purposes of the Account; (b) other money received by the Commonwealth in relation to the performance of the functions of the CEO; (c) amounts of any gifts given or bequests made for the purposes of the Account. Note: An Appropriation Act provides for amounts to be credited to a special account if any of the purposes of the special account is a purpose that is covered by an item in the Appropriation Act."@en ;
    cml:integrityHash "04d42c2a32622275f2514a726d886255c2157f51af36a371be7612a8488a95dd" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Must credit specified amounts to the Account" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-international-agricultural-research-act-1982.pdf> ;
    dc:source "australian-centre-for-international-agricultural-research-act-1982.pdf, p.31" ;
