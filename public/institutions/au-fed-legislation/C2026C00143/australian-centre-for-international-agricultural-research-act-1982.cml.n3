concept:australian-centre-for-international-agricultural-research-act-1982-sec-22 a cml:Concept ;
    skos:prefLabel "22 Resignation"@en ;
    cml:realizedBy doc:sec-22 ;
    values:originalText "An appointed member of the Council may resign his or her office by writing signed by him or her and delivered to the Minister." ;
