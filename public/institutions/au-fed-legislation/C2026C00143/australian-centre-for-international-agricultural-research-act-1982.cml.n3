concept:australian-centre-for-international-agricultural-research-act-1982-sec-13 a cml:Concept ;
    skos:prefLabel "13 Remuneration and allowances"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "(1) A Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the Commissioner is to be paid the remuneration that is prescribed by the regulations. (2) A Commissioner is to be paid the allowances that are prescribed by the regulations. (3) This section has effect subject to the Remuneration Tribunal Act 1973.   Commission for International Agricultural Research  Part III The Commissioners  Division 2 Section 14 Australian Centre for International Agricultural Research Act 1982 Compilation date: 27/03/2026" ;
    skos:definition "(1) A Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the Commissioner is to be paid the remuneration that is prescribed by the regulations. (2) A Commissioner is to be paid the allowances that are prescribed by the regulations. (3) This section has effect subject to the Remuneration Tribunal Act 1973.   Commission for International Agricultural Research  Part III The Commissioners  Division 2 Section 14 Australian Centre for International Agricultural Research Act 1982 Compilation date: 27/03/2026"@en ;
    cml:integrityHash "99e9a7de2ee082bd9a8c2ceb51a961cf97102c96d69e2831dfc9da980737b364" ;
    cof:pageNumber "12"^^xsd:integer ;
    cml:hasPart concept:australian-centre-for-international-agricultural-research-act-1982-sec-13-ss-1 ;
    cml:hasPart concept:australian-centre-for-international-agricultural-research-act-1982-sec-13-ss-2 ;
    cml:hasPart concept:australian-centre-for-international-agricultural-research-act-1982-sec-13-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-international-agricultural-research-act-1982.pdf> ;
    dc:source "australian-centre-for-international-agricultural-research-act-1982.pdf, p.12" .
