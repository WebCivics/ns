doc:sec-23-ss-7 a cof:Section ;
    cof:title "23(7) Meetings of Council" ;
    values:kind "subsection" ;
    values:originalText "(7) In the event of an equality of votes on a motion proposed at a meeting of the Council, the motion shall be taken not to be passed." ;
    cof:pageNumber "22"^^xsd:integer .

concept:australian-centre-for-international-agricultural-research-act-1982-sec-23-ss-8 a cml:Concept ;
    skos:prefLabel "23(8) Meetings of Council"@en ;
