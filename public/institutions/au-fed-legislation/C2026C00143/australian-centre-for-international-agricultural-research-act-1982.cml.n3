concept:australian-centre-for-international-agricultural-research-act-1982-sec-41 a cml:Concept ;
    skos:prefLabel "41 Delegation by Minister"@en ;
    cml:realizedBy doc:sec-41 ;
    values:originalText "The Minister may, by writing, delegate to any person all or any of the Minister’s functions or powers under this Act." ;
