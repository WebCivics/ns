concept:australian-centre-for-international-agricultural-research-act-1982-sec-29 a cml:Concept ;
    skos:prefLabel "29 Acting CEO"@en ;
    cml:realizedBy doc:sec-29 ;
    values:originalText "The Minister may appoint a person to act as the CEO: (a) during a vacancy in the office of the CEO (whether or not an appointment has previously been made to the office); or (b) during any period, or during all periods, when the CEO is suspended from office, is absent from duty or from Australia, or is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see section 33A of the Acts Interpretation Act 1901." ;
    skos:definition "The Minister may appoint a person to act as the CEO: (a) during a vacancy in the office of the CEO (whether or not an appointment has previously been made to the office); or (b) during any period, or during all periods, when the CEO is suspended from office, is absent from duty or from Australia, or is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see section 33A of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "03e4dc389b0620e3173e2a594bf5217dbc5ce020503c63358478f64b140ca142" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "The Minister may appoint a person to act as CEO under certain circumstances." ;
    dc:references "sec-33A" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-international-agricultural-research-act-1982.pdf> ;
    dc:source "australian-centre-for-international-agricultural-research-act-1982.pdf, p.24" ;
    cml:asserts concept:australian-centre-for-international-agricultural-research-act-1982-sec-29-norm .
