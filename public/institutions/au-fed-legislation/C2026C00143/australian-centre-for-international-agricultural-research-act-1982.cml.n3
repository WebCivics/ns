doc:sec-16j-ss-1 a cof:Section ;
    cof:title "16J(1) Delegation by Commission" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commission may, by resolution, delegate all or any of its functions or powers under this Act to a Commissioner. Note: Sections 34AA to 34A of the Acts Interpretation Act 1901 contain provisions relating to delegations." ;
    cof:pageNumber "17"^^xsd:integer .

concept:australian-centre-for-international-agricultural-research-act-1982-sec-16j-ss-2 a cml:Concept ;
    skos:prefLabel "16J(2) Delegation by Commission"@en ;
    cml:realizedBy doc:sec-16j-ss-2 ;
    values:originalText "(2) In exercising a delegated function or power, the delegate must comply with any written directions of the Commission." ;
