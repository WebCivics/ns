    cml:hasPart concept:australian-centre-for-international-agricultural-research-act-1982-sec-16k-ss-2 ;
    cml:hasPart concept:australian-centre-for-international-agricultural-research-act-1982-sec-16k-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-centre-for-international-agricultural-research-act-1982.pdf> ;
    dc:source "australian-centre-for-international-agricultural-research-act-1982.pdf, p.18" .
