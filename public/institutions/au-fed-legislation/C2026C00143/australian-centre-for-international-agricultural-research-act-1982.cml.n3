doc:sec-29ba-ss-6 a cof:Section ;
    cof:title "29BA(6) Suspension of appointment" ;
    values:kind "subsection" ;
    values:originalText "(6) The period of suspension, as extended, must not exceed: (a) if subsection (7) applies—12 months; or (b) otherwise—3 months." ;
    cof:pageNumber "25"^^xsd:integer .

