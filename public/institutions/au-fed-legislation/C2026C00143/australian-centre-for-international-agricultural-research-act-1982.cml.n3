concept:australian-centre-for-international-agricultural-research-act-1982-sec-8 a cml:Concept ;
    skos:prefLabel "8 Constitution of the Commission"@en ;
    cml:realizedBy doc:sec-8 ;
    values:originalText "The Commission consists of: (a) a Chair; and (b) 6 other Commissioners." ;
