doc:sec-13-ss-1 a cof:Section ;
    cof:title "13(1) Remuneration and allowances" ;
    values:kind "subsection" ;
    values:originalText "(1) A Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the Commissioner is to be paid the remuneration that is prescribed by the regulations." ;
    cof:pageNumber "12"^^xsd:integer .

