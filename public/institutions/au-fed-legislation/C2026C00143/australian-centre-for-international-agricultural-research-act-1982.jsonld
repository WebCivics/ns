      "skos:note": "Member must resign by writing signed and delivered to the Minister.",
      "dc:description": "writing signed by the member"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Resignation",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "An appointed member of the Council may resign his or her office\nby writing signed by him or her and delivered to the Minister."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-22-norm",
