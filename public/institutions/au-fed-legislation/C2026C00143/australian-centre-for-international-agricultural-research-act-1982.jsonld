    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.12",
      "values:originalText": "(1) A Commissioner is to be paid the remuneration that is determined\nby the Remuneration Tribunal. If no determination of that\nremuneration by the Tribunal is in operation, the Commissioner is\nto be paid the remuneration that is prescribed by the regulations.\n(2) A Commissioner is to be paid the allowances that are prescribed by\nthe regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.\n\n\nCommission for International Agricultural Research  Part III\nThe Commissioners  Division 2\nSection 14\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "skos:definition": "(1) A Commissioner is to be paid the remuneration that is determined\nby the Remuneration Tribunal. If no determination of that\nremuneration by the Tribunal is in operation, the Commissioner is\nto be paid the remuneration that is prescribed by the regulations.\n(2) A Commissioner is to be paid the allowances that are prescribed by\nthe regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.\n\n\nCommission for International Agricultural Research  Part III\nThe Commissioners  Division 2\nSection 14\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "cml:hasPart": [
