    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29a",
      "@type": "cml:Concept",
      "skos:prefLabel": "29A Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-29a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.24",
      "values:originalText": "(1) The CEO has the recreation leave entitlements that are determined\nby the Remuneration Tribunal.\n(2) The Minister may grant the CEO leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.\n\n\nThe CEO  Part V\n\nSection 29B\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "skos:definition": "(1) The CEO has the recreation leave entitlements that are determined\nby the Remuneration Tribunal.\n(2) The Minister may grant the CEO leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.\n\n\nThe CEO  Part V\n\nSection 29B\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29a-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29a-ss-2"
        }
      ],
      "cml:integrityHash": "486a2c4c5c7899bdc875c46e957ea59d652824115d2a355dd743ecd4565fa4bf"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-29a",
      "@type": "cof:Section",
      "cof:title": "29A Leave of absence",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(1) The CEO has the recreation leave entitlements that are determined\nby the Remuneration Tribunal.\n(2) The Minister may grant the CEO leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.\n\n\nThe CEO  Part V\n\nSection 29B\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026"
    },
