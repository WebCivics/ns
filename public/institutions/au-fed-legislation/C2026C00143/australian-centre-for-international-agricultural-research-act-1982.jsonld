        }
      ],
      "cml:integrityHash": "f15a617f47762466d45a1a2bc3dbbb00f0415b3308fa66e0ad6c3113fb3acbe0",
      "skos:note": "Conditional commencement of remaining provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-26-2-ss-4",
      "@type": "cof:Section",
      "cof:title": "26(4) Mar",
      "values:kind": "subsection",
      "cof:pageNumber": 39,
      "values:originalText": "(4) The remaining provisions of this Act shall come into operation on such\nday as is, or on such respective days as are, fixed by Proclamation.\n(d)\nThe Australian Centre for International Agricultural Research Act 1982 was\namended by section 45 only of the Public Service and Statutory Authorities\nAmendment Act 1985, subsection 2(7) of which provides as follows:"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-4-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-4-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires a relation between identifiable temporal intervals for conditional commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text mentions 'such day as is, or on such respective days as are, fixed by Proclamation'",
      "cml:conclusionText": "Therefore, it requires an AllenInterval"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies the legal effect as Undertaking",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text does not impose a duty, ban conduct, grant permission, or create a right",
      "cml:conclusionText": "Therefore, it is an Undertaking"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires an ordered or recurring trace for conditional commencement",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text mentions 'such day as is, or on such respective days as are, fixed by Proclamation'",
      "cml:conclusionText": "Therefore, it requires an LTL"
    },
