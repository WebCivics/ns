    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-28-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must Not",
      "cml:logicSummary": "Prohibition of paid work outside CEO duties.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "CEO must not engage in paid work outside the duties of the CEO without the Minister's approval.",
      "cml:conclusionText": "No paid work outside CEO duties."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-28-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Paid work outside CEO duties overlaps with other work.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
