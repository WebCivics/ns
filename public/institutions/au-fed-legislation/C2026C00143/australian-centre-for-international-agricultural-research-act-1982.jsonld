      "@type": "cof:Section",
      "cof:title": "28 Other paid work",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "The CEO must not engage in paid work outside the duties of the\nCEO without the Minister’s approval."
    },
    {
