    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-19a",
      "@type": "cml:Concept",
      "skos:prefLabel": "19A Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-19a"
      },
      "cml:curationStatus": {
