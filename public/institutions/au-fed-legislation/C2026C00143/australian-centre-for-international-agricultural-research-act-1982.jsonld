      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.13",
      "values:originalText": "A Commissioner may resign his or her appointment by giving the\nGovernor-General a written resignation.",
      "skos:definition": "A Commissioner may resign his or her appointment by giving the\nGovernor-General a written resignation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16-norm"
        }
      ],
      "cml:integrityHash": "c6b69f7fe85c2336fd10b21d380a18d6bd973af072a83edcae1099cbd722446c",
      "skos:note": "A Commissioner may resign by giving a written resignation to the Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Resignation",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "A Commissioner may resign his or her appointment by giving the\nGovernor-General a written resignation."
    },
