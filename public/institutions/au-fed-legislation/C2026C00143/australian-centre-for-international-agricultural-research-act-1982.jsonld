    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-16"
      },
      "cml:curationStatus": {
