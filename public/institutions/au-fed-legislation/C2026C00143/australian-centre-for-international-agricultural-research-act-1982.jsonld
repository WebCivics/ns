      },
      "cml:premiseText": "The CEO must not engage in paid work outside the duties of the CEO without the Minister's approval.",
      "cml:conclusionText": "If Minister approves, then information about CEO's right to engage in paid work outside duties diffuses."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-28-logic-cogai-5",
