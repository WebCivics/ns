    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Acting CEO",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.24",
      "values:originalText": "The Minister may appoint a person to act as the CEO:\n(a) during a vacancy in the office of the CEO (whether or not an\nappointment has previously been made to the office); or\n(b) during any period, or during all periods, when the CEO is\nsuspended from office, is absent from duty or from Australia,\nor is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "skos:definition": "The Minister may appoint a person to act as the CEO:\n(a) during a vacancy in the office of the CEO (whether or not an\nappointment has previously been made to the office); or\n(b) during any period, or during all periods, when the CEO is\nsuspended from office, is absent from duty or from Australia,\nor is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "03e4dc389b0620e3173e2a594bf5217dbc5ce020503c63358478f64b140ca142",
      "skos:note": "The Minister may appoint a person to act as CEO under certain circumstances.",
      "dc:references": [
        "sec-33A"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Acting CEO",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "The Minister may appoint a person to act as the CEO:\n(a) during a vacancy in the office of the CEO (whether or not an\nappointment has previously been made to the office); or\n(b) during any period, or during all periods, when the CEO is\nsuspended from office, is absent from duty or from Australia,\nor is, for any reason, unable to perform the duties of the\noffice.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901."
    },
