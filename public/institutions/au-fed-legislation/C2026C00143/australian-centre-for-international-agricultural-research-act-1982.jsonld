    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 March 2026",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-27"
      },
      "cml:curationStatus": {
