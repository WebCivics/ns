      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-4-ss-2",
      "@type": "cof:Section",
      "cof:title": "4(2) Establishment of Centre",
      "values:kind": "subsection",
      "cof:pageNumber": 9,
      "values:originalText": "(2) The Centre consists of:\n(a) the CEO; and\n(b) the staff of the Centre referred to in section 30."
    },
