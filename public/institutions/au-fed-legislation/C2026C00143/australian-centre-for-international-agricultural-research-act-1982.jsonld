    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-32a",
      "@type": "cml:Concept",
      "skos:prefLabel": "32A Application of the finance law",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-32a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.30",
      "values:originalText": "For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the following combination of bodies is a listed entity:\n(i) the Centre;\n(ii) the Commission;\n(iii) the Council; and\n(b) the listed entity is to be known as the Australian Centre for\nInternational Agricultural Research; and\n(c) the CEO is the accountable authority of the listed entity; and\n(d) the following persons are officials of the listed entity:\n(i) the CEO;\n(ii) the Commissioners;\n(iii) the members of the Council referred to in\nsubsection 19(1);\n(iv) the staff of the Centre referred to in section 30;\n(v) persons whose services are made available to the CEO\nunder section 31;\n(vi) consultants engaged under section 32; and\n(e) the purposes of the listed entity include:\n(i) the functions of the CEO referred to in section 5; and\n(ii) the functions of the staff of the Centre referred to in\nsection 6; and\n(iii) the functions of the Commission referred to in section 9;\nand\n(iv) the function of the Council referred to in section 18.\n\n\nThe Australian Centre for International Agricultural Research Account  Part VII\n\nSection 33\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "skos:definition": "For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the following combination of bodies is a listed entity:\n(i) the Centre;\n(ii) the Commission;\n(iii) the Council; and\n(b) the listed entity is to be known as the Australian Centre for\nInternational Agricultural Research; and\n(c) the CEO is the accountable authority of the listed entity; and\n(d) the following persons are officials of the listed entity:\n(i) the CEO;\n(ii) the Commissioners;\n(iii) the members of the Council referred to in\nsubsection 19(1);\n(iv) the staff of the Centre referred to in section 30;\n(v) persons whose services are made available to the CEO\nunder section 31;\n(vi) consultants engaged under section 32; and\n(e) the purposes of the listed entity include:\n(i) the functions of the CEO referred to in section 5; and\n(ii) the functions of the staff of the Centre referred to in\nsection 6; and\n(iii) the functions of the Commission referred to in section 9;\nand\n(iv) the function of the Council referred to in section 18.\n\n\nThe Australian Centre for International Agricultural Research Account  Part VII\n\nSection 33\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-32a-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-32a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ae178376cfa357166a178d7f57b18bc9d2b5f03650e70f40d4c738c6b989290e",
      "skos:note": "Defines the Australian Centre for International Agricultural Research as a listed entity and specifies its officials."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-32a",
      "@type": "cof:Section",
      "cof:title": "32A Application of the finance law",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "For the purposes of the finance law (within the meaning of the\nPublic Governance, Performance and Accountability Act 2013):\n(a) the following combination of bodies is a listed entity:\n(i) the Centre;\n(ii) the Commission;\n(iii) the Council; and\n(b) the listed entity is to be known as the Australian Centre for\nInternational Agricultural Research; and\n(c) the CEO is the accountable authority of the listed entity; and\n(d) the following persons are officials of the listed entity:\n(i) the CEO;\n(ii) the Commissioners;\n(iii) the members of the Council referred to in\nsubsection 19(1);\n(iv) the staff of the Centre referred to in section 30;\n(v) persons whose services are made available to the CEO\nunder section 31;\n(vi) consultants engaged under section 32; and\n(e) the purposes of the listed entity include:\n(i) the functions of the CEO referred to in section 5; and\n(ii) the functions of the staff of the Centre referred to in\nsection 6; and\n(iii) the functions of the Commission referred to in section 9;\nand\n(iv) the function of the Council referred to in section 18.\n\n\nThe Australian Centre for International Agricultural Research Account  Part VII\n\nSection 33\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026"
    },
    {
