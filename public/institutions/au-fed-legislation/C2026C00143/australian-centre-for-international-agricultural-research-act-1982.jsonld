    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-7-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires a relation between identifiable temporal intervals for conditional commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The commencement is dependent on the day of Royal Assent",
      "cml:conclusionText": "Therefore, it requires an AllenInterval"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2-ss-7-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies the legal effect as Undertaking",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text describes a conditional commencement",
      "cml:conclusionText": "Therefore, it is a deontic Undertaking"
    },
