      "@type": "cml:Concept",
      "skos:prefLabel": "6 Functions of the staff of the Centre",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-6"
      },
      "cml:curationStatus": {
