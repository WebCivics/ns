    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Delegation by Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.33",
      "values:originalText": "The Minister may, by writing, delegate to any person all or any of\nthe Minister’s functions or powers under this Act.",
      "skos:definition": "The Minister may, by writing, delegate to any person all or any of\nthe Minister’s functions or powers under this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-41-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-41-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8ecab957bfd8506f9b05b7d9b53ec66c0a3c2efae4e7fa3b09d8937a85bb2fb3",
      "skos:note": "The Minister may delegate functions or powers."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Delegation by Minister",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "The Minister may, by writing, delegate to any person all or any of\nthe Minister’s functions or powers under this Act."
    },
