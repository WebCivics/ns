    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16c",
      "@type": "cml:Concept",
      "skos:prefLabel": "16C Times and places of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-16c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.15",
      "values:originalText": "(1) The Commission must hold such meetings as are necessary for the\nefficient performance of its functions.\n(2) Meetings are to be held at the times and places determined by the\nCommission.\n(3) The Chair may call a meeting at any time.\n(4) The Chair must ensure that at least 4 meetings are held each\nfinancial year.",
      "skos:definition": "(1) The Commission must hold such meetings as are necessary for the\nefficient performance of its functions.\n(2) Meetings are to be held at the times and places determined by the\nCommission.\n(3) The Chair may call a meeting at any time.\n(4) The Chair must ensure that at least 4 meetings are held each\nfinancial year.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16c-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16c-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16c-ss-3"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16c-ss-4"
        }
      ],
      "cml:integrityHash": "2148df3d9f16b688080c02fe48d88d9d0870feccf8c500cf757f5920a5312be0"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-16c",
      "@type": "cof:Section",
      "cof:title": "16C Times and places of meetings",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(1) The Commission must hold such meetings as are necessary for the\nefficient performance of its functions.\n(2) Meetings are to be held at the times and places determined by the\nCommission.\n(3) The Chair may call a meeting at any time.\n(4) The Chair must ensure that at least 4 meetings are held each\nfinancial year."
    },
