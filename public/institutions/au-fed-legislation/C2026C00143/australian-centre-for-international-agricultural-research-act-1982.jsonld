    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Functions of the Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.11",
      "values:originalText": "The functions of the Commission are:\n(a) to provide advice to the Minister in relation to the\nformulation of programs of the kind referred to in\nparagraph 5(1)(a); and\n(b) to provide advice to the Minister in relation to the funding of\nthings referred to in paragraphs 5(1)(d), (e) and (f); and\n(c) to provide advice to the Minister on program and funding\npriorities; and\n(d) to provide advice to the Minister, on the Minister’s request,\non any other matter relating to this Act.",
      "skos:definition": "The functions of the Commission are:\n(a) to provide advice to the Minister in relation to the\nformulation of programs of the kind referred to in\nparagraph 5(1)(a); and\n(b) to provide advice to the Minister in relation to the funding of\nthings referred to in paragraphs 5(1)(d), (e) and (f); and\n(c) to provide advice to the Minister on program and funding\npriorities; and\n(d) to provide advice to the Minister, on the Minister’s request,\non any other matter relating to this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-9-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "73681f1edd1e7959786e58ddbb1e11247b5595e752c2843593a144c12542a1db",
      "skos:note": "The Commission must provide advice on certain matters to the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Functions of the Commission",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The functions of the Commission are:\n(a) to provide advice to the Minister in relation to the\nformulation of programs of the kind referred to in\nparagraph 5(1)(a); and\n(b) to provide advice to the Minister in relation to the funding of\nthings referred to in paragraphs 5(1)(d), (e) and (f); and\n(c) to provide advice to the Minister on program and funding\npriorities; and\n(d) to provide advice to the Minister, on the Minister’s request,\non any other matter relating to this Act."
    },
