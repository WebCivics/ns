    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Appointment of Commissioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.12",
      "values:originalText": "(1) A Commissioner is to be appointed by the Governor-General by\nwritten instrument.\n(2) A Commissioner holds office for the period specified in the\ninstrument of appointment. The period must not exceed 3 years.\n(3) A person cannot be appointed as a Commissioner if the person is a\nmember of the Council.",
      "skos:definition": "(1) A Commissioner is to be appointed by the Governor-General by\nwritten instrument.\n(2) A Commissioner holds office for the period specified in the\ninstrument of appointment. The period must not exceed 3 years.\n(3) A person cannot be appointed as a Commissioner if the person is a\nmember of the Council.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-10-ss-1"
