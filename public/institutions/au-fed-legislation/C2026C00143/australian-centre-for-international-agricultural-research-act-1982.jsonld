    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-26-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Mar",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-26-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
