      ],
      "cml:integrityHash": "4bde4595237f2d4ac001d05b341fce27b72c9649f1e67b085249afa7230a4245",
      "skos:note": "Majority vote required for decisions at Council meetings."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-23-ss-6",
      "@type": "cof:Section",
      "cof:title": "23(6) Meetings of Council",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(6) Subject to subsection (7), all questions arising at a meeting of the\nCouncil shall be decided by a majority of the votes of the members\npresent and voting, including the member presiding."
    },
    {
