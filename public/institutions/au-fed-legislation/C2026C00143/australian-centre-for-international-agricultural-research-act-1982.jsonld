    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-23-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(6) Meetings of Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-23-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.22",
      "values:originalText": "(6) Subject to subsection (7), all questions arising at a meeting of the\nCouncil shall be decided by a majority of the votes of the members\npresent and voting, including the member presiding.",
      "skos:definition": "(6) Subject to subsection (7), all questions arising at a meeting of the\nCouncil shall be decided by a majority of the votes of the members\npresent and voting, including the member presiding.",
