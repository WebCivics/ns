    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Appointment of CEO",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.23",
      "values:originalText": "(1) The CEO is to be appointed by the Governor-General by written\ninstrument.\n(2) The CEO holds office for the period specified in the instrument of\nappointment. The period must not exceed 5 years.\n(3) A person may be appointed as both the CEO and a Commissioner\n(including the Chair).\nPerformance standard\n(4) The Minister may, in writing, determine a performance standard\nfor the CEO.\nNote:\nUnsatisfactory performance may lead to termination of the CEO’s\nappointment: see subsection 29C(3).\n(5) The performance standard is not a legislative instrument.",
      "skos:definition": "(1) The CEO is to be appointed by the Governor-General by written\ninstrument.\n(2) The CEO holds office for the period specified in the instrument of\nappointment. The period must not exceed 5 years.\n(3) A person may be appointed as both the CEO and a Commissioner\n(including the Chair).\nPerformance standard\n(4) The Minister may, in writing, determine a performance standard\nfor the CEO.\nNote:\nUnsatisfactory performance may lead to termination of the CEO’s\nappointment: see subsection 29C(3).\n(5) The performance standard is not a legislative instrument.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-24-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-24-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-24-ss-3"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-24-ss-4"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-24-ss-5"
        }
      ],
      "cml:integrityHash": "521defffe3471c3034b22472cd059f64c4a85e7c88dce4f88bdebce27b936444"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Appointment of CEO",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "(1) The CEO is to be appointed by the Governor-General by written\ninstrument.\n(2) The CEO holds office for the period specified in the instrument of\nappointment. The period must not exceed 5 years.\n(3) A person may be appointed as both the CEO and a Commissioner\n(including the Chair).\nPerformance standard\n(4) The Minister may, in writing, determine a performance standard\nfor the CEO.\nNote:\nUnsatisfactory performance may lead to termination of the CEO’s\nappointment: see subsection 29C(3).\n(5) The performance standard is not a legislative instrument."
    },
