        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Governor-General must terminate the appointment of the CEO.",
      "cml:conclusionText": "The CEO's appointment is terminated."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-alleninterval-2",
