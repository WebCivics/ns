    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-23-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(7) Meetings of Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-23-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.22",
      "values:originalText": "(7) In the event of an equality of votes on a motion proposed at a\nmeeting of the Council, the motion shall be taken not to be passed.",
      "skos:definition": "(7) In the event of an equality of votes on a motion proposed at a\nmeeting of the Council, the motion shall be taken not to be passed.",
      "values:partOf": {
        "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-23"
      },
      "cml:asserts": [
