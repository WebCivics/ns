    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 Annual report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-39"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.33",
      "values:originalText": "The annual report prepared by the CEO and given to the Minister\nunder section 46 of the Public Governance, Performance and\nAccountability Act 2013 for a period must include:\n(a) particulars of all directions given during the period by the\nMinister to the CEO under section 5A of this Act; and\n(b) particulars of all directions given during the period by the\nMinister to the Commission under section 16K of this Act.",
      "skos:definition": "The annual report prepared by the CEO and given to the Minister\nunder section 46 of the Public Governance, Performance and\nAccountability Act 2013 for a period must include:\n(a) particulars of all directions given during the period by the\nMinister to the CEO under section 5A of this Act; and\n(b) particulars of all directions given during the period by the\nMinister to the Commission under section 16K of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-39-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-39-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2fb4b0cbeec3b80502d6643847e9635b9b4b4d156ba3cfa80d0783f36e13f006",
      "skos:note": "Annual report must include particulars of directions given by Minister to CEO and Commission.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Annual report",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "The annual report prepared by the CEO and given to the Minister\nunder section 46 of the Public Governance, Performance and\nAccountability Act 2013 for a period must include:\n(a) particulars of all directions given during the period by the\nMinister to the CEO under section 5A of this Act; and\n(b) particulars of all directions given during the period by the\nMinister to the Commission under section 16K of this Act."
    },
    {
