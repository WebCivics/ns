    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16k",
      "@type": "cml:Concept",
      "skos:prefLabel": "16K Directions by the Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-16k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.18",
      "values:originalText": "(1) The Minister may, by writing, give directions to the Commission\nwith respect to the performance of the Commission’s functions\nunder this Act.\n(2) In giving a direction, the Minister must have regard to any relevant\nadvice that he or she may have received from the Council under\nsection 18.\n(3) The Minister must give a copy of a direction to the CEO.\nNote:\nA direction under this section is included in the annual report: see\nsection 39.\n\n\nThe Policy Advisory Council  Part IV\n\nSection 17\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "skos:definition": "(1) The Minister may, by writing, give directions to the Commission\nwith respect to the performance of the Commission’s functions\nunder this Act.\n(2) In giving a direction, the Minister must have regard to any relevant\nadvice that he or she may have received from the Council under\nsection 18.\n(3) The Minister must give a copy of a direction to the CEO.\nNote:\nA direction under this section is included in the annual report: see\nsection 39.\n\n\nThe Policy Advisory Council  Part IV\n\nSection 17\nAustralian Centre for International Agricultural Research Act 1982\nCompilation date: 27/03/2026",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-16k-ss-1"
        },
