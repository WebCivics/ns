      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-21-ss-1",
      "@type": "cof:Section",
      "cof:title": "21(1) Termination of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 21,
      "values:originalText": "(1) The Minister may terminate the appointment of an appointed\nmember of the Council by reason of misbehaviour or physical or\nmental incapacity."
    },
