    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Credits to the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.31",
      "values:originalText": "There must be credited to the Account amounts equal to the\nfollowing:\n(a) all money appropriated by the Parliament for the purposes of\nthe Account;\n(b) other money received by the Commonwealth in relation to\nthe performance of the functions of the CEO;\n(c) amounts of any gifts given or bequests made for the purposes\nof the Account.\nNote:\nAn Appropriation Act provides for amounts to be credited to a special\naccount if any of the purposes of the special account is a purpose that\nis covered by an item in the Appropriation Act.",
      "skos:definition": "There must be credited to the Account amounts equal to the\nfollowing:\n(a) all money appropriated by the Parliament for the purposes of\nthe Account;\n(b) other money received by the Commonwealth in relation to\nthe performance of the functions of the CEO;\n(c) amounts of any gifts given or bequests made for the purposes\nof the Account.\nNote:\nAn Appropriation Act provides for amounts to be credited to a special\naccount if any of the purposes of the special account is a purpose that\nis covered by an item in the Appropriation Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-34-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "04d42c2a32622275f2514a726d886255c2157f51af36a371be7612a8488a95dd",
      "skos:note": "Must credit specified amounts to the Account",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Credits to the Account",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "There must be credited to the Account amounts equal to the\nfollowing:\n(a) all money appropriated by the Parliament for the purposes of\nthe Account;\n(b) other money received by the Commonwealth in relation to\nthe performance of the functions of the CEO;\n(c) amounts of any gifts given or bequests made for the purposes\nof the Account.\nNote:\nAn Appropriation Act provides for amounts to be credited to a special\naccount if any of the purposes of the special account is a purpose that\nis covered by an item in the Appropriation Act."
    },
