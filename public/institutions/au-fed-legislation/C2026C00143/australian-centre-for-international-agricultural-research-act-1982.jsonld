        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "42af4f5b2c9f1d9bd062d190d54cf9a2f9875960c600cbdbab4b159d0ef4a23d",
      "skos:note": "Governor-General must terminate CEO appointment under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-29c-ss-2",
      "@type": "cof:Section",
      "cof:title": "29C(2) Termination of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 27,
      "values:originalText": "(2) The Governor-General must terminate the appointment of the CEO\nif:\n(a) the CEO:\n(i) becomes bankrupt; or\n(ii) applies to take the benefit of any law for the relief of\nbankrupt or insolvent debtors; or\n(iii) compounds with his or her creditors; or"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-29c-ss-2-norm",
