      ],
      "cml:integrityHash": "7e1b0d5641f2640ce9a953ec231eea2c27a2a7633f7d3c273e5735e2b30c10b7"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Australian Centre for International Agricultural Research",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Account\n(1) There is continued in existence the Australian Centre for\nInternational Agricultural Research Account.\nNote:\nThe Account was established by subsection 5(3) of the Financial\nManagement Legislation Amendment Act 1999.\n(2) The Account is a special account for the purposes of the Public\nGovernance, Performance and Accountability Act 2013."
    },
