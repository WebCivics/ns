    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.7",
      "values:originalText": "In this Act, unless the contrary intention appears:\nAccount means the account continued in existence by section 33.\nagricultural research means scientific, technical, economic or\nsocio-economic research in connection with agriculture, and\nincludes the publication of reports, periodicals, books and papers in\nconnection with any such research.\nagriculture includes such uses of land as are prescribed for the\npurposes of this definition.\nannual report means the report referred to in section 39.\nappointed member of the Council means a member of the Council\nappointed under subsection 19(2).\nAPS Code of Conduct means the Code of Conduct (within the\nmeaning of the Public Service Act 1999).",
      "skos:definition": "In this Act, unless the contrary intention appears:\nAccount means the account continued in existence by section 33.\nagricultural research means scientific, technical, economic or\nsocio-economic research in connection with agriculture, and\nincludes the publication of reports, periodicals, books and papers in\nconnection with any such research.\nagriculture includes such uses of land as are prescribed for the\npurposes of this definition.\nannual report means the report referred to in section 39.\nappointed member of the Council means a member of the Council\nappointed under subsection 19(2).\nAPS Code of Conduct means the Code of Conduct (within the\nmeaning of the Public Service Act 1999).",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-3-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-3-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "52c02f277dd0bdd85a212aa8d3969f2068ac449021184472112eeca63a84a899",
      "skos:note": "Definitions and interpretations for the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "In this Act, unless the contrary intention appears:\nAccount means the account continued in existence by section 33.\nagricultural research means scientific, technical, economic or\nsocio-economic research in connection with agriculture, and\nincludes the publication of reports, periodicals, books and papers in\nconnection with any such research.\nagriculture includes such uses of land as are prescribed for the\npurposes of this definition.\nannual report means the report referred to in section 39.\nappointed member of the Council means a member of the Council\nappointed under subsection 19(2).\nAPS Code of Conduct means the Code of Conduct (within the\nmeaning of the Public Service Act 1999)."
    },
