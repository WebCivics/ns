    {
      "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Acting Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-act-1982.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-act-1982.pdf, p.13",
      "values:originalText": "The Minister may appoint a person to act as a Commissioner:\n(a) during a vacancy in the office of the Commissioner (whether\nor not an appointment has previously been made to the\noffice); or\n(b) during any period, or during all periods, when the\nCommissioner is absent from duty or from Australia, or is,\nfor any reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "skos:definition": "The Minister may appoint a person to act as a Commissioner:\n(a) during a vacancy in the office of the Commissioner (whether\nor not an appointment has previously been made to the\noffice); or\n(b) during any period, or during all periods, when the\nCommissioner is absent from duty or from Australia, or is,\nfor any reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-14-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2e13617a0aad2735682008eee007894de4eec7961b279137e0b732ea6b2608f7",
      "skos:note": "The Minister may appoint a person to act as a Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-14",
