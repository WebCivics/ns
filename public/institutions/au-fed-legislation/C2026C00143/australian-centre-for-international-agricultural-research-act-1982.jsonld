          "@id": "concept:australian-centre-for-international-agricultural-research-act-1982-sec-23-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7726cbfdc861d1de61911e76acffe877a5c8cd39face059553c9261c9b1484a1",
      "skos:note": "Motion cannot be passed in case of equality of votes."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-act-1982#sec-23-ss-7",
      "@type": "cof:Section",
      "cof:title": "23(7) Meetings of Council",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(7) In the event of an equality of votes on a motion proposed at a\nmeeting of the Council, the motion shall be taken not to be passed."
