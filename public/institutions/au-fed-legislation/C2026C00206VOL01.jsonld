      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the Commission determines terms and conditions, then they are binding.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implication of determination",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "determined",
      "cml:premiseText": "If the Commission determines terms and conditions, then those terms and conditions apply."
    },
