        "concept:competition-and-consumer-act-2010-sec-46a-logic-diffusion-5",
        "concept:competition-and-consumer-act-2010-sec-46a-logic-cogai-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "acdb392f71d41724e2e79b2e6d4c1607d6ad4949fd24e13be4f6be964c69c733",
      "cml:proposedBy": {
