        "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-argumentation-3",
        "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-diffusion-4",
        "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "12b68776d407de969a2d65b7954f19a15d09f3dcb3a6500cf7fe377a125c0d20",
      "cml:proposedBy": {
