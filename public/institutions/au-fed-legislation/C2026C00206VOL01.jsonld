      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.105",
      "skos:note": "The validity of a determination is not affected by defects in the Tribunal's constitution.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "38 Validity of determinations"
      },
