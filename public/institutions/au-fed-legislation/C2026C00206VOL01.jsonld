    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.148",
      "skos:note": "Request for recommendation of a service to be declared",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "44F(1) Person may request recommendation"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
