    {
      "@id": "concept:competition-and-consumer-act-2010-sec-46a",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.325",
      "skos:note": "Prohibition on misuse of market power by corporations with substantial degree",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "46A Misuse of market power—corporation with substantial degree"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sec-46a-norm",
