    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
