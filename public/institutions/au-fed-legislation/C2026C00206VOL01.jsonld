        "@id": "cml:AllenInterval"
      },
      "cml:operator": "determined",
      "cml:premiseText": "The Commission's determination of terms and conditions occurs at a specific point in time."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-27a-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Artificial intelligence systems must comply with the determined terms and conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
