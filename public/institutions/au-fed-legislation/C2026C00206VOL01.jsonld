      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "(i) occurring on or after the effective notification date of the notification; and (ii) at which the Commission has not decided to cease considering the notification under section 51ABZD;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must notify the Commission.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must notify the Commission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) a person is the notifying party of a notification of an acquisition; and (b) a change of fact occurs; and (c) the change of fact is material to the Commission making a determination under subsection 51ABZE(1) in respect of the notification;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must notify the Commission within a timeframe.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must notify the Commission within a timeframe",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(iii) at which the Commission has not made a determination in respect of the notification under subsection 51ABZE(1); and (iv) if the notification is subject to phase 2 review—occurring at least 15 business days (within the meaning of section 51ABK) before the end of the phase 2 determination period for the notification."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
