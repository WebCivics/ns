      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of prohibited actions.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:premiseText": "(e) requiring the provider to bear some or all of the costs of extending the facility (including expanding the capacity of the facility and expanding the geographical reach of the facility);"
    },
