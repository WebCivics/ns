    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission MUST act speedily within a reasonable timeframe.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Commission must act speedily within a reasonable timeframe.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "There is no specific time limit for the Commission's action."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the Commission acts speedily, then it implies a fair settlement of the dispute.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Commission's speediness implies fairness in settlement of dispute.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "The Commission's action is related to the settlement of the dispute."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission's speediness IS A part of its ability to inform itself.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Commission's speediness relates to its ability to inform itself.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS A",
      "cml:premiseText": "The Commission has the ability to inform itself."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission MUST act speedily.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Commission must act speedily.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Commission has a duty to act speedily."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission's speediness IS A part of the investigation and inquiry process.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Commission's speediness affects the investigation and inquiry process.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS A",
      "cml:premiseText": "The Commission's action is related to the investigation and inquiry process."
    },
