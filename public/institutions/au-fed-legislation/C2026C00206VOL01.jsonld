    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.222",
      "skos:note": "Commission must act speedily in arbitration hearing about access dispute.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "44ZF(1) Procedure of Commission"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
