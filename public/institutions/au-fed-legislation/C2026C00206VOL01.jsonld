    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "ACMA is a legal person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "ACMA means the Australian Communications and Media Authority."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person with an accreditation is an accredited person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Accredited Person",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "accredited person means a person who holds an accreditation under subsection 56CA(1)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An accredited action initiator is defined in section 56AMC.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Accredited Action Initiator",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "accredited action initiator has the meaning given by section 56AMC."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An accredited data recipient is defined in section 56AK.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Accredited Data Recipient",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "accredited data recipient has the meaning given by section 56AK."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An acquisition determination is defined by subsection 51ABZE(1).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Acquisition Determination",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "acquisition determination, in respect of a notification of an acquisition, means:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4-logic-descriptionlogic-7",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Acquire means to acquire goods through purchase, exchange, or lease, or to accept a service.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Acquire",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "acquire includes: (a) in relation to goods—acquire by way of purchase, exchange or taking on lease, on hire or on hire-purchase; and (b) in relation to services—accept."
    },
