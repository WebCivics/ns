        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Causal links between prohibited actions.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Causal Link",
      "cml:premiseText": "(c) depriving any person of a protected contractual right;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44w-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of certain actions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) The Commission must not make a determination that would have any of the following effects:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44w-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
