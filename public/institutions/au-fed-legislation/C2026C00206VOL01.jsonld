      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Prohibition with temporal scope.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Prohibition",
      "cml:premiseText": "(f) requiring the provider to bear some or all of the costs of interconnections to the facility or maintaining interconnections to the facility."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44w-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implications of prohibited actions.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(d) resulting in the third party becoming the owner (or one of the owners) of any part of the facility, or of extensions of the facility,"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44w-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
