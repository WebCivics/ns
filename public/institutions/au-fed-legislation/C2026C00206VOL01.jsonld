      "cml:logicSummary": "Duty to provide terms and conditions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "determined",
      "cml:premiseText": "The Commission has the authority to determine terms and conditions."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-27a-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "All parties must comply with the determined terms and conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spread of determination",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "determined",
      "cml:premiseText": "The Commission's determination of terms and conditions spreads to all parties involved."
    },
    {
