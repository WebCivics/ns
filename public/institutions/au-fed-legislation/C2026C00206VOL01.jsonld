    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The service is not eligible to be declared if there is a 15-year no-coverage determination in force",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "15-year no-coverage determination within the National Gas Law",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "(i) a 15-year no-coverage determination is in force under the National Gas Law in respect of the pipeline"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The designated Minister may apply in writing to the Council asking the Council to recommend that a particular service be declared",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission granted by the State",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:premiseText": "None"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The service is not eligible to be declared if there is a decision under section 44LG",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Service ineligible due to decision under section 44LG",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "there is a decision of the designated Minister in force under section 44LG that the service is ineligible to be declared"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The service is not eligible to be declared if it is part of a regime with an effective access regime in force",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Service classification based on regime or access undertaking",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "(a) the service is the subject of a regime for which a decision under section 44N that the regime is an effective access regime is in force (including as a result of an extension under section 44NB); or"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The service is not eligible to be declared if it is part of an access undertaking in operation",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Service classification based on access undertaking",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "(b) the service is the subject of an access undertaking in operation under Division 6"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The service is not eligible to be declared if there is a price regulation exemption in force",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Price regulation exemption recurring trace",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(ii) a price regulation exemption is in force under the National Gas Law in respect of the pipeline"
    },
