      "cml:premiseText": "The Tribunal's constitution is valid."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-38-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defect or irregularity in the constitution does not affect the determination's validity.",
