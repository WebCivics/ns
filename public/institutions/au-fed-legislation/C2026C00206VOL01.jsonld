      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must not make an order under subsection (2).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
