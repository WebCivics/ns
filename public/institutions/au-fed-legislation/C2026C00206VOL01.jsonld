      "cml:logicSummary": "Artificial intelligence application",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "determined",
      "cml:premiseText": "The Commission's determination of terms and conditions can be applied by artificial intelligence systems."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-27a-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Terms and conditions of engagement must be as determined by the Commission.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
