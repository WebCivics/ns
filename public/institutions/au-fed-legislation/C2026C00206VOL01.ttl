    <https://ns.webcivics.net/cml/premiseText> "(5) The designated Minister must not decide that the service is ineligible to be a declared service unless he or she is satisfied of both of the following matters:";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
