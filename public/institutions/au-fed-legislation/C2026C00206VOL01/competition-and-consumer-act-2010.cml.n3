doc:sec-53ze-ss-1 a cof:Section ;
    cof:title "53ZE(1) What gas market instruments may refer to" ;
    values:kind "subsection" ;
    values:originalText "(1) A gas market instrument may make provision in relation to a matter by applying, adopting or incorporating (with or without modification) any matter contained in any other instrument or writing:  (a) as in force or existing at a particular time; or  (b) as in force or existing from time to time." ;
    cof:pageNumber "531"^^xsd:integer .

