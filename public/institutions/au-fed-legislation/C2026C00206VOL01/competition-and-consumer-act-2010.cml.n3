doc:sec-45ag-ss-1 a cof:Section ;
    cof:title "45AG(1) Giving effect to a cartel provision" ;
    values:kind "subsection" ;
    values:originalText "(1) A corporation commits an offence if:  (a) a contract, arrangement or understanding contains a cartel provision; and  (b) the corporation gives effect to the cartel provision. Note: Chapter 2 of the Criminal Code sets out the general principles of criminal responsibility." ;
    cof:pageNumber "292"^^xsd:integer .

