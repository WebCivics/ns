doc:sec-44kb-ss-3 a cof:Section ;
    cof:title "44KB(3) Tribunal may order costs be awarded" ;
    values:kind "subsection" ;
    values:originalText "(3) If the Tribunal makes an order under subsection (1), it may make further orders that it considers appropriate in relation to the assessment or taxation of the costs." ;
    cof:pageNumber "162"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44kb-ss-4 a cml:Concept ;
    skos:prefLabel "44KB(4) Tribunal may order costs be awarded"@en ;
    cml:realizedBy doc:sec-44kb-ss-4 ;
    values:originalText "(4) The regulations may make provision for and in relation to fees payable for the assessment or taxation of costs ordered by the Tribunal to be paid." ;
    skos:definition "(4) The regulations may make provision for and in relation to fees payable for the assessment or taxation of costs ordered by the Tribunal to be paid."@en ;
