concept:competition-and-consumer-act-2010-sec-52o a cml:Concept ;
    skos:prefLabel "52O Australian audience test"@en ;
    cml:realizedBy doc:sec-52o ;
    values:originalText "(1) The requirement in this subsection is met in relation to a news business if every news source covered by subsection (2) operates predominantly in Australia for the dominant purpose of serving Australian audiences.  (2) This subsection covers a news source if it comprises, whether by itself or together with other news sources, the news business.  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBA  News media and digital platforms mandatory bargaining code" ;
    skos:definition "(1) The requirement in this subsection is met in relation to a news business if every news source covered by subsection (2) operates predominantly in Australia for the dominant purpose of serving Australian audiences.  (2) This subsection covers a news source if it comprises, whether by itself or together with other news sources, the news business.  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBA  News media and digital platforms mandatory bargaining code"@en ;
    cml:integrityHash "aabd9bdfb262e3385ec0e89688ffaf12d2df4722883d19bd0b2021108cefdb7a" ;
    cof:pageNumber "459"^^xsd:integer ;
