doc:sec-44na-ss-2 a cof:Section ;
    cof:title "44NA(2) Recommendation by Council" ;
    values:kind "subsection" ;
    values:originalText "(2) The Council must:  (a) give a copy of the notice to:  (i) if the person is not the applicant—the applicant; and  (ii) if the person is not the provider of the service—the provider; and  (b) publish, by electronic or other means, the notice." ;
    cof:pageNumber "184"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44na-ss-3 a cml:Concept ;
    skos:prefLabel "44NA(3) Recommendation by Council"@en ;
    cml:realizedBy doc:sec-44na-ss-3 ;
    values:originalText "(3) In deciding what recommendation to make on the application, the Council:  (a) must have regard to any information given in compliance with a notice under subsection (1) within the specified period; and  (b) may disregard any information of the kind specified in the notice that is given after the specified period has ended." ;
    skos:definition "(3) In deciding what recommendation to make on the application, the Council:  (a) must have regard to any information given in compliance with a notice under subsection (1) within the specified period; and  (b) may disregard any information of the kind specified in the notice that is given after the specified period has ended."@en ;
    cml:integrityHash "8915b1633629ad4b15f73387b412a8678e1855d3df08597293302d0b88bfb542" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44na ;
    cof:pageNumber "184"^^xsd:integer ;
    skos:note "Must consider information given within specified period, may disregard later information. Minister may specify variations to access regime" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
