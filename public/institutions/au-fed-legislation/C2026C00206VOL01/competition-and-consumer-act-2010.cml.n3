    cml:modality cml:Deontic ;
    cml:operator "MUST NOT" ;
    cml:logicSummary "Must not consider matter in making interim determination" ;
    cml:premiseText "(4) In making an interim determination, the Commission does not have a duty to consider whether to take into account a matter referred to in subsection (1)." ;
    cml:conclusionText "The Commission MUST NOT consider the matter." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-44x-ss-4 cml:asserts concept:competition-and-consumer-act-2010-sec-44x-ss-4-logic-linearlogic-4 .
concept:competition-and-consumer-act-2010-sec-44x-ss-4-logic-linearlogic-4 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "⇒" ;
    cml:logicSummary "Not considering matter implies duty not to consider matter" ;
    cml:premiseText "(4) In making an interim determination, the Commission does not have a duty to consider whether to take into account a matter referred to in subsection (1)." ;
    cml:conclusionText "If the Commission does NOT consider the matter, then the Commission MUST NOT consider the matter." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-44x-ss-4 a cof:Section ;
