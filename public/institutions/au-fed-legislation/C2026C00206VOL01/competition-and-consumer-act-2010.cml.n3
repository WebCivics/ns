doc:sec-44am-ss-1 a cof:Section ;
    cof:title "44AM(1) Appointment of Commonwealth AER members" ;
    values:kind "subsection" ;
    values:originalText "(1) A Commonwealth AER member is to be appointed by the Governor-General by written instrument, on either a full-time or part-time basis. Note: A Commonwealth AER member is also taken to be an associate member of the Commission: see section 8AB." ;
    cof:pageNumber "116"^^xsd:integer .

