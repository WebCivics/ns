doc:sec-44zb-ss-3 a cof:Section ;
    cof:title "44ZB(3) Reconstitution of Commission" ;
    values:kind "subsection" ;
    values:originalText "(3) If a direction under subsection (2) is given, the Commission as constituted in accordance with the direction must continue and finish the arbitration and may, for that purpose, have regard to any record of the proceedings of the arbitration made by the Commission as previously constituted." ;
    cof:pageNumber "221"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44zc a cml:Concept ;
    skos:prefLabel "44ZC Determination of questions"@en ;
    cml:realizedBy doc:sec-44zc ;
    values:originalText "If the Commission is constituted for an arbitration by 2 or more members of the Commission, any question before the Commission is to be decided:  (a) unless paragraph (b) applies—according to the opinion of the majority of those members; or  (b) if the members are evenly divided on the question— according to the opinion of the member who is presiding." ;
    skos:definition "If the Commission is constituted for an arbitration by 2 or more members of the Commission, any question before the Commission is to be decided:  (a) unless paragraph (b) applies—according to the opinion of the majority of those members; or  (b) if the members are evenly divided on the question— according to the opinion of the member who is presiding."@en ;
    cml:integrityHash "433a7afd35b27abafa33d8e702e31fa878a2733984d0fbfe93defbfc9f6903e3" ;
    cof:pageNumber "221"^^xsd:integer ;
    skos:note "The Commission must decide questions according to the opinion of the majority of its members." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
