concept:competition-and-consumer-act-2010-sec-44aa a cml:Concept ;
    skos:prefLabel "44AA Objects of Part"@en ;
    cml:realizedBy doc:sec-44aa ;
    values:originalText "The objects of this Part are to:  (a) promote the economically efficient operation of, use of and investment in the infrastructure by which services are provided, thereby promoting effective competition in upstream and downstream markets; and  (b) provide a framework and guiding principles to encourage a consistent approach to access regulation in each industry." ;
    skos:definition "The objects of this Part are to:  (a) promote the economically efficient operation of, use of and investment in the infrastructure by which services are provided, thereby promoting effective competition in upstream and downstream markets; and  (b) provide a framework and guiding principles to encourage a consistent approach to access regulation in each industry."@en ;
    cml:integrityHash "a7db8b484ccd21c319fefea8060b54c738d3e069c1eb48a3a689ed5acd331e08" ;
    cof:pageNumber "139"^^xsd:integer ;
    skos:note "Promote economically efficient infrastructure operation and investment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.139" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-44aa-norm .
