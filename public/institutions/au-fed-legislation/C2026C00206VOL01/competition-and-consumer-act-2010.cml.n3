doc:sec-29ba-ss-2 a cof:Section ;
    cof:title "29BA(2) Commonwealth consent to conferral of functions etc. on" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not authorise the conferral of a function or power, or the imposition of a duty, by a State/Territory energy law to the extent to which:  (a) the conferral or imposition, or the authorisation, would contravene any constitutional doctrines restricting the duties that may be imposed on the Council; or  (b) the authorisation would otherwise exceed the legislative power of the Commonwealth." ;
    cof:pageNumber "93"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-29ba-ss-3 a cml:Concept ;
    skos:prefLabel "29BA(3) Commonwealth consent to conferral of functions etc. on"@en ;
    cml:realizedBy doc:sec-29ba-ss-3 ;
    values:originalText "(3) The Council cannot perform a duty or function, or exercise a power, under a State/Territory energy law unless the conferral of the function or power, or the imposition of the duty, is in  Chapter 1  Preliminary" ;
    skos:definition "(3) The Council cannot perform a duty or function, or exercise a power, under a State/Territory energy law unless the conferral of the function or power, or the imposition of the duty, is in  Chapter 1  Preliminary"@en ;
    cml:integrityHash "d0e0cce21e17c988449881990f0bed86197d3a88c75bde6c8dbcb411a33de669" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-29ba ;
    cof:pageNumber "93"^^xsd:integer ;
    skos:note "Council must obtain Commonwealth consent to perform a duty or function under a State/Territory energy law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
