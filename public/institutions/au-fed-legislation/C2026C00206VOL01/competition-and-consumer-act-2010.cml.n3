    values:originalText "(1) Subject to subsection (2), the gas market provisions are not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with the gas market provisions." ;
    skos:definition "(1) Subject to subsection (2), the gas market provisions are not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with the gas market provisions."@en ;
    cml:integrityHash "6d4a6bc7ff0da3801bcaf2b39c7c93879cec98435ddca482000861c04392bc4e" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-53zz ;
    cof:pageNumber "548"^^xsd:integer ;
    skos:note "States and Territories can operate concurrently with the gas market provisions. Prohibits conduct that affects the activities, functions, relationships or business of a constitutional corporation. Regulations may incorporate or adopt provisions from other instruments." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
