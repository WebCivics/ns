    values:partOf concept:competition-and-consumer-act-2010-sec-44li ;
    cof:pageNumber "174"^^xsd:integer ;
    skos:note "Must revoke ineligibility decision upon receiving recommendation" ;
    cml:curationStatus cml:Proposed ;
