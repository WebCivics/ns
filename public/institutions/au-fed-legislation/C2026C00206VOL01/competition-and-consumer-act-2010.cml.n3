concept:competition-and-consumer-act-2010-sec-44h-ss-9 a cml:Concept ;
    skos:prefLabel "44H(9) Designated Minister may declare a service"@en ;
    cml:realizedBy doc:sec-44h-ss-9 ;
    values:originalText "(9) If the designated Minister does not publish under section 44HA his or her decision on the declaration recommendation within 60 days after receiving the declaration recommendation, the designated Minister is taken, at the end of that 60-day period:  (a) to have made a decision under this section in accordance with the declaration recommendation; and  (b) to have published that decision under section 44HA." ;
    skos:definition "(9) If the designated Minister does not publish under section 44HA his or her decision on the declaration recommendation within 60 days after receiving the declaration recommendation, the designated Minister is taken, at the end of that 60-day period:  (a) to have made a decision under this section in accordance with the declaration recommendation; and  (b) to have published that decision under section 44HA."@en ;
    cml:integrityHash "90817e260cb7a0d77c31c507c44b1f2a9ada2777c0597dde67518169c3467886" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44h ;
    cof:pageNumber "156"^^xsd:integer ;
    skos:note "Designated Minister must publish decision within 60 days or be deemed to have made a decision in accordance with the declaration recommendation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.156" ;
