doc:sec-45aq-ss-1 a cof:Section ;
    cof:title "45AQ(1) Resale price maintenance" ;
    values:kind "subsection" ;
    values:originalText "(1) Sections 45AF, 45AG, 45AJ and 45AK do not apply in relation to a contract, arrangement or understanding containing a cartel provision, in so far as the cartel provision relates to:  (a) conduct that contravenes section 48; or  (b) conduct that would contravene section 48 but for the operation of section 88; or  Restrictive trade practices  Chapter 3 Restrictive trade practices  Part IV Cartel conduct  Division 1  Section 45AR  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (c) conduct that would contravene section 48 if this Act defined the acts constituting the practice of resale price maintenance by reference to the maximum price at which goods or services are to be sold or supplied or are to be advertised, displayed or offered for sale or supply. Note: A defendant bears an evidential burden in relation to the matter in subsection (1) (see subsection 13.3(3) of the Criminal Code and subsection (2) of this section)." ;
    cof:pageNumber "298"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-45aq-ss-2 a cml:Concept ;
    skos:prefLabel "45AQ(2) Resale price maintenance"@en ;
    cml:realizedBy doc:sec-45aq-ss-2 ;
    values:originalText "(2) A person who wishes to rely on subsection (1) in relation to a contravention of section 45AJ or 45AK bears an evidential burden in relation to that matter." ;
    skos:definition "(2) A person who wishes to rely on subsection (1) in relation to a contravention of section 45AJ or 45AK bears an evidential burden in relation to that matter."@en ;
    cml:integrityHash "6c1fcac4af6b0121a37ace8f1d28239b17302a90851adb006317fe1676c443d0" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-45aq ;
    cof:pageNumber "298"^^xsd:integer ;
    skos:note "Evidential burden for relying on subsection (1) in relation to a contravention of section 45AJ or 45AK" ;
    cml:curationStatus cml:Proposed ;
