concept:competition-and-consumer-act-2010-sec-52zj a cml:Concept ;
    skos:prefLabel "52ZJ Bargaining over other issues"@en ;
    cml:realizedBy doc:sec-52zj ;
    values:originalText "To avoid doubt, nothing in this Division limits the bargaining parties to negotiating only over the core bargaining issues.  Provisions relating to particular industries, payment surcharges etc.  Chapter 4 News media and digital platforms mandatory bargaining code  Part IVBA Arbitration about remuneration issue  Division 7  Section 52ZK  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "To avoid doubt, nothing in this Division limits the bargaining parties to negotiating only over the core bargaining issues.  Provisions relating to particular industries, payment surcharges etc.  Chapter 4 News media and digital platforms mandatory bargaining code  Part IVBA Arbitration about remuneration issue  Division 7  Section 52ZK  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "2679bf1b27a485dbc8dce2648bbb9ebe62bcfba79b1ac9c597c765efe3adfc02" ;
    cof:pageNumber "476"^^xsd:integer ;
    skos:note "Nothing in this Division limits the bargaining parties to negotiating only over the core bargaining issues." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
