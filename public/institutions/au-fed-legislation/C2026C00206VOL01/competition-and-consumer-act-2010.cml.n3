concept:competition-and-consumer-act-2010-sec-44r a cml:Concept ;
    skos:prefLabel "44R Constitutional limits on operation of this Division"@en ;
    cml:realizedBy doc:sec-44r ;
    values:originalText "This Division does not apply in relation to a third party’s access to a service unless:  (a) the provider is a corporation (or a partnership or joint venture consisting wholly of corporations); or  (b) the third party is a corporation; or  (c) the access is (or would be) in the course of, or for the purposes of, constitutional trade or commerce. Subdivision B—Notification of access disputes" ;
    skos:definition "This Division does not apply in relation to a third party’s access to a service unless:  (a) the provider is a corporation (or a partnership or joint venture consisting wholly of corporations); or  (b) the third party is a corporation; or  (c) the access is (or would be) in the course of, or for the purposes of, constitutional trade or commerce. Subdivision B—Notification of access disputes"@en ;
    cml:integrityHash "31f50704446f741dcf50fa54b85325eab3273e71a8a8f856831c88b039f8a2e9" ;
    cof:pageNumber "212"^^xsd:integer ;
    skos:note "Restricts access to services by third parties under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.212" ;
