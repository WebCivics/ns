concept:competition-and-consumer-act-2010-sec-50-ss-4 a cml:Concept ;
    skos:prefLabel "50(4) Prohibition of acquisitions that would result in a substantial"@en ;
    cml:realizedBy doc:sec-50-ss-4 ;
    values:originalText "(4) Where:  (a) a person has entered into a contract to acquire shares in the capital of a body corporate or assets of a person;  (b) the contract is subject to a condition that the provisions of the contract relating to the acquisition will not come into force unless and until the person has been granted an authorisation to acquire the shares or assets; and  Chapter 3  Restrictive trade practices" ;
    skos:definition "(4) Where:  (a) a person has entered into a contract to acquire shares in the capital of a body corporate or assets of a person;  (b) the contract is subject to a condition that the provisions of the contract relating to the acquisition will not come into force unless and until the person has been granted an authorisation to acquire the shares or assets; and  Chapter 3  Restrictive trade practices"@en ;
    cml:integrityHash "9bfbf9cd50331113590acbc25b2c2a3cfd645221eadf8974bc7cf5bea0cdfaf7" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-50 ;
    cof:pageNumber "336"^^xsd:integer ;
    skos:note "Acquisitions subject to a condition that requires authorisation before coming into force." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
