concept:competition-and-consumer-act-2010-sec-44j-ss-7 a cml:Concept ;
    skos:prefLabel "44J(7) Revocation of declaration"@en ;
    cml:realizedBy doc:sec-44j-ss-7 ;
    values:originalText "(7) If the designated Minister does not publish under subsection (4) his or her decision on the revocation recommendation within the period starting at the start of the day the recommendation is received and ending at the end of 60 days after that day, the designated Minister is taken, immediately after the end of that 60-day period:  (a) to have made a decision that the declaration be revoked; and  (b) to have published that decision in accordance with this section." ;
    skos:definition "(7) If the designated Minister does not publish under subsection (4) his or her decision on the revocation recommendation within the period starting at the start of the day the recommendation is received and ending at the end of 60 days after that day, the designated Minister is taken, immediately after the end of that 60-day period:  (a) to have made a decision that the declaration be revoked; and  (b) to have published that decision in accordance with this section."@en ;
    cml:integrityHash "0431364543b267fd9fcfe1e9824ffe726919f7b33c8766c12cc7729ce0e4cc94" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44j ;
    cof:pageNumber "158"^^xsd:integer ;
    skos:note "Failure to publish decision within 60 days results in automatic revocation of declaration." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
