doc:sec-44na-ss-1 a cof:Section ;
    cof:title "44NA(1) Recommendation by Council" ;
    values:kind "subsection" ;
    values:originalText "(1) The Council may give a person a written notice requesting the person give to the Council, within a specified period, information of the kind specified in the notice that the Council considers may be relevant to deciding what recommendation to make on an application under section 44NA." ;
