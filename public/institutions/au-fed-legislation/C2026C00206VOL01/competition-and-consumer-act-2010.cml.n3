doc:sec-52zi-ss-1 a cof:Section ;
    cof:title "52ZI(1) Obligation to notify Commission if agreement reached" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) the bargaining parties have not reached agreement over each core bargaining issue within 3 months after the notification was made for the purposes of subsection 52ZE(1); or  (b) the bargaining parties agree to refer the core bargaining issues to mediation under this Subdivision." ;
    cof:pageNumber "474"^^xsd:integer .

