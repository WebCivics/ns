concept:competition-and-consumer-act-2010-sec-53p a cml:Concept ;
    skos:prefLabel "53P General"@en ;
    cml:realizedBy doc:sec-53p ;
    values:originalText "A gas market code may include rules regulating gas market conduct. Note: The other provisions of this Subdivision and Subdivision D do not limit this section: see section 53ZF." ;
    skos:definition "A gas market code may include rules regulating gas market conduct. Note: The other provisions of this Subdivision and Subdivision D do not limit this section: see section 53ZF."@en ;
