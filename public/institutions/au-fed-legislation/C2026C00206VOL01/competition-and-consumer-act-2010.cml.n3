doc:sec-29ba-ss-1 a cof:Section ;
    cof:title "29BA(1) Commonwealth consent to conferral of functions etc. on" ;
    values:kind "subsection" ;
    values:originalText "(1) A State/Territory energy law may confer functions or powers, or impose duties, on the Council for the purposes of that law. Note: Section 29BC sets out when such a law imposes a duty on the Council." ;
    cof:pageNumber "93"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-29ba-ss-2 a cml:Concept ;
    skos:prefLabel "29BA(2) Commonwealth consent to conferral of functions etc. on"@en ;
    cml:realizedBy doc:sec-29ba-ss-2 ;
    values:originalText "(2) Subsection (1) does not authorise the conferral of a function or power, or the imposition of a duty, by a State/Territory energy law to the extent to which:  (a) the conferral or imposition, or the authorisation, would contravene any constitutional doctrines restricting the duties that may be imposed on the Council; or  (b) the authorisation would otherwise exceed the legislative power of the Commonwealth." ;
    skos:definition "(2) Subsection (1) does not authorise the conferral of a function or power, or the imposition of a duty, by a State/Territory energy law to the extent to which:  (a) the conferral or imposition, or the authorisation, would contravene any constitutional doctrines restricting the duties that may be imposed on the Council; or  (b) the authorisation would otherwise exceed the legislative power of the Commonwealth."@en ;
    cml:integrityHash "22f82a79d64e42134df43b712de4f964ed0c6f28a0103bc042968a596e2be297" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-29ba ;
    cof:pageNumber "93"^^xsd:integer ;
    skos:note "No conferral of function or power by State/Territory energy law if it contravenes constitutional doctrines." ;
    cml:curationStatus cml:Proposed ;
