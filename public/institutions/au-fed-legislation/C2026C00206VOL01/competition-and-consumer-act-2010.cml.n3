concept:competition-and-consumer-act-2010-sec-53h a cml:Concept ;
    skos:prefLabel "53H Geographical application—supplies and acquisitions"@en ;
    cml:realizedBy doc:sec-53h ;
    values:originalText "(1) The gas market provisions apply in relation to supplying a gas commodity if the supply:  (a) occurs in Australia; or  (b) is:  (i) to a person in Australia, including by means of importing the gas commodity into Australia; or  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBB  Gas market" ;
    skos:definition "(1) The gas market provisions apply in relation to supplying a gas commodity if the supply:  (a) occurs in Australia; or  (b) is:  (i) to a person in Australia, including by means of importing the gas commodity into Australia; or  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBB  Gas market"@en ;
    cml:integrityHash "d95c4f49794b5bf7f43e4bce5df7f2d6fd009f17b1b7a4e720db87f1252321ca" ;
    cof:pageNumber "511"^^xsd:integer ;
    skos:note "The gas market provisions apply in relation to supplying a gas commodity if the supply occurs in Australia or is imported into Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
