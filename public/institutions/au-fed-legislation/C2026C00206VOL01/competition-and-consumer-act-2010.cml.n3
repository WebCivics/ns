concept:competition-and-consumer-act-2010-sec-44zn-ss-4 a cml:Concept ;
    skos:prefLabel "44ZN(4) Parties to pay costs of an arbitration"@en ;
    cml:realizedBy doc:sec-44zn-ss-4 ;
