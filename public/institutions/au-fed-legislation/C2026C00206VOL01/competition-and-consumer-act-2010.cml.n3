doc:sec-53z-ss-1 a cof:Section ;
    cof:title "53Z(1) Transparency" ;
    values:kind "subsection" ;
    values:originalText "(1) A gas market instrument may include rules about a gas market participant, the Minister or the Commission publishing information that relates to a gas market matter, including rules about any of the following:  (a) the type of information that is published;  (b) the circumstances in which information is published;  (c) the manner in which information is published. Example: A rule requiring information to be published at specified intervals." ;
    cof:pageNumber "526"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-53z-ss-2 a cml:Concept ;
    skos:prefLabel "53Z(2) Transparency"@en ;
    cml:realizedBy doc:sec-53z-ss-2 ;
    values:originalText "(2) A gas market instrument may include rules requiring a gas market participant to give to another gas market participant information or documents relevant to a gas market matter." ;
    skos:definition "(2) A gas market instrument may include rules requiring a gas market participant to give to another gas market participant information or documents relevant to a gas market matter."@en ;
