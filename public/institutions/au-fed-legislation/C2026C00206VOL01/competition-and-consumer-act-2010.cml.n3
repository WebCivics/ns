concept:competition-and-consumer-act-2010-sec-52zp a cml:Concept ;
    skos:prefLabel "52ZP Chair to notify start of arbitration"@en ;
    cml:realizedBy doc:sec-52zp ;
    values:originalText "(1) The Chair must notify the bargaining parties that arbitration about terms for resolving the remuneration issue will start on a specified day that is no later than 5 business days (or, if the regulations specify a different period, the end of that period) after the appointment of the Chair.  (2) The notice must:  (a) be in writing; and  (b) if regulations made for the purposes of this paragraph specify requirements—meet those requirements." ;
    skos:definition "(1) The Chair must notify the bargaining parties that arbitration about terms for resolving the remuneration issue will start on a specified day that is no later than 5 business days (or, if the regulations specify a different period, the end of that period) after the appointment of the Chair.  (2) The notice must:  (a) be in writing; and  (b) if regulations made for the purposes of this paragraph specify requirements—meet those requirements."@en ;
    cml:integrityHash "f752ab4fa307cec728912b151e6103f2c664f92e984cd4ea16b1da9da9370c0b" ;
    cof:pageNumber "481"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-52zp-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-52zp-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
