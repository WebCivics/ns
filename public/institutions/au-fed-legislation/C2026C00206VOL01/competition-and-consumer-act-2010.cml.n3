    cof:pageNumber "474"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-52zi-ss-3 a cml:Concept ;
    skos:prefLabel "52ZI(3) Obligation to notify Commission if agreement reached"@en ;
    cml:realizedBy doc:sec-52zi-ss-3 ;
    values:originalText "(3) Despite subsection 14(2) of the Legislation Act 2003, regulations made for the purposes of subsection (1) may make provision in relation to a matter by applying, adopting or incorporating, with or without modification, any matter contained in an instrument or other writing as in force or existing from time to time." ;
    skos:definition "(3) Despite subsection 14(2) of the Legislation Act 2003, regulations made for the purposes of subsection (1) may make provision in relation to a matter by applying, adopting or incorporating, with or without modification, any matter contained in an instrument or other writing as in force or existing from time to time."@en ;
    cml:integrityHash "a6ddeec28077ab170cfdb554987182c9d8f5d92d6be571dc0259efb00cb8bde8" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-52zi ;
    cof:pageNumber "474"^^xsd:integer ;
    skos:note "Notify Commission of agreement reached in good faith negotiations. Regulations may incorporate existing instruments or writings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
