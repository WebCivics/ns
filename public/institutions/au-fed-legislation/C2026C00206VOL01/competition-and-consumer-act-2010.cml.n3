doc:sec-44k-ss-1 a cof:Section ;
    cof:title "44K(1) Review of declaration" ;
    values:kind "subsection" ;
    values:originalText "(1) If the designated Minister declares a service, the provider may apply in writing to the Tribunal for review of the declaration." ;
    cof:pageNumber "159"^^xsd:integer .

