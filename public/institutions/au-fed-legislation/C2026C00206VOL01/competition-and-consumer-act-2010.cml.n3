concept:competition-and-consumer-act-2010-sec-44na-ss-2 a cml:Concept ;
    skos:prefLabel "44NA(2) Recommendation by Council"@en ;
    cml:realizedBy doc:sec-44na-ss-2 ;
    values:originalText "(2) The Council must:  (a) give a copy of the notice to:  (i) if the person is not the applicant—the applicant; and  (ii) if the person is not the provider of the service—the provider; and  (b) publish, by electronic or other means, the notice." ;
    skos:definition "(2) The Council must:  (a) give a copy of the notice to:  (i) if the person is not the applicant—the applicant; and  (ii) if the person is not the provider of the service—the provider; and  (b) publish, by electronic or other means, the notice."@en ;
    cml:integrityHash "02aba1c5f258f60d185a8999d71f74bc388c97f34d71965f5cd57ae039736ca5" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44na ;
    cof:pageNumber "184"^^xsd:integer ;
    skos:note "Council must give a copy of notice to applicant and provider, and publish the notice. Minister may make written application to Council for recommendation on extending decision period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
