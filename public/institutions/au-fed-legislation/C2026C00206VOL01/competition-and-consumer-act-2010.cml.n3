concept:competition-and-consumer-act-2010-sec-4k a cml:Concept ;
    skos:prefLabel "4K Loss or damage to include injury"@en ;
    cml:realizedBy doc:sec-4k ;
    values:originalText "In this Act:  (a) a reference to loss or damage, other than a reference to the amount of any loss or damage, includes a reference to injury; and  (b) a reference to the amount of any loss or damage includes a reference to damages in respect of an injury." ;
    skos:definition "In this Act:  (a) a reference to loss or damage, other than a reference to the amount of any loss or damage, includes a reference to injury; and  (b) a reference to the amount of any loss or damage includes a reference to damages in respect of an injury."@en ;
    cml:integrityHash "bda52cdbf81c7e60dad590ab45367ad7bb7b18ae16ef44aa2bf102bae7f7d218" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Reference to loss or damage includes injury." ;
    cml:curationStatus cml:Proposed ;
