doc:sec-44na-ss-4 a cof:Section ;
    cof:title "44NA(4) Recommendation by Council" ;
    values:kind "subsection" ;
    values:originalText "(4) The Council must assess whether the access regime (including any proposed variations) is an effective access regime. It must do this in accordance with subsection 44M(4)." ;
    cof:pageNumber "184"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44na-ss-5 a cml:Concept ;
    skos:prefLabel "44NA(5) Recommendation by Council"@en ;
    cml:realizedBy doc:sec-44na-ss-5 ;
    values:originalText "(5) If the Council is satisfied that it is an effective access regime, the Council must, in writing, recommend to the Commonwealth Minister that he or she extend the period for which the decision under section 44N is in force. The Council must also recommend an extension period." ;
    skos:definition "(5) If the Council is satisfied that it is an effective access regime, the Council must, in writing, recommend to the Commonwealth Minister that he or she extend the period for which the decision under section 44N is in force. The Council must also recommend an extension period."@en ;
