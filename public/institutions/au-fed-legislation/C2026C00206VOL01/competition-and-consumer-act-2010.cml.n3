    cof:pageNumber "213"^^xsd:integer ;
    skos:note "List of parties to arbitration" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
