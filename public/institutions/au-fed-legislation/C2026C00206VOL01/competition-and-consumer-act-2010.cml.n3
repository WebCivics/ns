    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must consider information given within specified period." ;
    cml:premiseText "Given a notice under subsection (1) within the specified period, the Council must have regard to any information." ;
    cml:conclusionText "The Council may disregard any information of the kind specified in the notice that is given after the specified period has ended." ;
    cml:executionSurface "modalities::logic::deontic" ;
