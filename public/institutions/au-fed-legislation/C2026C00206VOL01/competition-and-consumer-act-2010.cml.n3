doc:sec-43-ss-4 a cof:Section ;
    cof:title "43(4) Member of Tribunal ceasing to be available" ;
    values:kind "subsection" ;
    values:originalText "(4) Where the President has given a direction under subsection (3), he or she may, at any time before the determination of the proceedings, direct that a third member be added to the Tribunal as constituted in accordance with subsection (3)." ;
    cof:pageNumber "107"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-43-ss-5 a cml:Concept ;
    skos:prefLabel "43(5) Member of Tribunal ceasing to be available"@en ;
    cml:realizedBy doc:sec-43-ss-5 ;
    values:originalText "(5) The Tribunal as constituted in accordance with any of the provisions of this section for the purposes of any proceedings may have regard to any record of the proceedings before the Tribunal as previously constituted." ;
