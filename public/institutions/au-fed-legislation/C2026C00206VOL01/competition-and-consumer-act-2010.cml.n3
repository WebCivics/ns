    cml:premiseText "(5) If a member of the Tribunal becomes bankrupt..." ;
    cml:conclusionText "...the Governor-General shall remove him or her from office." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-35-ss-5 cml:asserts concept:competition-and-consumer-act-2010-sec-35-ss-5-logic-cogai-5 .
