doc:sec-29bb-ss-5 a cof:Section ;
    cof:title "29BB(5) How duty is imposed" ;
    values:kind "subsection" ;
    values:originalText "(5) The duty is taken to be imposed by this Part in accordance with subsection (3) only to the extent to which imposing the duty:  (a) is within the legislative powers of the Commonwealth; and  (b) is consistent with the constitutional doctrines restricting the duties that may be imposed on the Council." ;
    cof:pageNumber "94"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-29bb-ss-6 a cml:Concept ;
    skos:prefLabel "29BB(6) How duty is imposed"@en ;
    cml:realizedBy doc:sec-29bb-ss-6 ;
    values:originalText "(6) Subsections (1) to (5) do not limit section 29BA. 29BC  When a State/Territory energy law imposes a duty  For the purposes of sections 29BA and 29BB, a State/Territory energy law imposes a duty on the Council if:  (a) the law confers a function or power on the Council; and  (b) the circumstances in which the function or power is conferred give rise to an obligation on the Council to perform the function or to exercise the power." ;
    skos:definition "(6) Subsections (1) to (5) do not limit section 29BA. 29BC  When a State/Territory energy law imposes a duty  For the purposes of sections 29BA and 29BB, a State/Territory energy law imposes a duty on the Council if:  (a) the law confers a function or power on the Council; and  (b) the circumstances in which the function or power is conferred give rise to an obligation on the Council to perform the function or to exercise the power."@en ;
    cml:integrityHash "19ecda15558ee6748e3cf7fa00dc127216f7108d34961efec603bcaa8e2ba6c6" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-29bb ;
    cof:pageNumber "94"^^xsd:integer ;
    skos:note "A State/Territory energy law imposes a duty on the Council if it confers a function or power on the Council." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.94" ;
