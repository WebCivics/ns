concept:competition-and-consumer-act-2010-sec-38 a cml:Concept ;
    skos:prefLabel "38 Validity of determinations"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "The validity of a determination of the Tribunal shall not be affected or called in question by reason of any defect or irregularity in the constitution of the Tribunal." ;
    skos:definition "The validity of a determination of the Tribunal shall not be affected or called in question by reason of any defect or irregularity in the constitution of the Tribunal."@en ;
    cml:integrityHash "dc2859db40e099aa1da9aadb3ccd66b6005f7daf2fb74f450dc841a9622c9f02" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "The validity of a determination is not affected by defects in the Tribunal's constitution." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
