concept:competition-and-consumer-act-2010-sec-44ld-ss-10 a cml:Concept ;
    skos:prefLabel "44LD(10) Time limit for Council recommendations"@en ;
    cml:realizedBy doc:sec-44ld-ss-10 ;
    values:originalText "(10) If the Council extends the consideration period under subsection (7), it must publish a notice in a manner that results in the notice being accessible to the public and reasonably prominent:  (a) stating that it has done so; and  (b) specifying the day by which it must now make a recommendation on the application.  Chapter 2  Access to services" ;
    skos:definition "(10) If the Council extends the consideration period under subsection (7), it must publish a notice in a manner that results in the notice being accessible to the public and reasonably prominent:  (a) stating that it has done so; and  (b) specifying the day by which it must now make a recommendation on the application.  Chapter 2  Access to services"@en ;
    cml:integrityHash "764147cbea646c8f05544889264e949461b5a7e25dfb907eac372f2f01d3d611" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44ld ;
    cof:pageNumber "168"^^xsd:integer ;
    skos:note "Publish a notice stating the extension and new deadline for recommendation." ;
    dc:description "Notice to the public" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
