concept:competition-and-consumer-act-2010-sec-44la a cml:Concept ;
    skos:prefLabel "44LA Constitutional limits on operation of this Division"@en ;
    cml:realizedBy doc:sec-44la ;
    values:originalText "This Division does not apply in relation to a service unless:  (a) the person who is, or expects to be, the provider of the service is a corporation (or a partnership or joint venture consisting wholly of corporations); or  (b) access to the service is (or would be) in the course of, or for the purposes of, constitutional trade or commerce. Subdivision B—Ineligibility recommendation by Council" ;
    skos:definition "This Division does not apply in relation to a service unless:  (a) the person who is, or expects to be, the provider of the service is a corporation (or a partnership or joint venture consisting wholly of corporations); or  (b) access to the service is (or would be) in the course of, or for the purposes of, constitutional trade or commerce. Subdivision B—Ineligibility recommendation by Council"@en ;
    cml:integrityHash "dfd8106510e52e1bcec98710bd44edf4a18551189e8a737351837263b0274640" ;
    cof:pageNumber "165"^^xsd:integer ;
    skos:note "Service provision is subject to constitutional limits." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
