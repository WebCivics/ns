concept:competition-and-consumer-act-2010-sec-44x-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must consider matter" ;
