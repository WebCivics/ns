doc:sec-44zb-ss-2 a cof:Section ;
    cof:title "44ZB(2) Reconstitution of Commission" ;
    values:kind "subsection" ;
    values:originalText "(2) The Chairperson must either:  (a) direct that the Commission is to be constituted for the purposes of finishing the arbitration by the remaining member or members; or  (b) direct that the Commission is to be constituted for that purpose by the remaining member or members together with one or more other members of the Commission." ;
    cof:pageNumber "221"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44zb-ss-3 a cml:Concept ;
    skos:prefLabel "44ZB(3) Reconstitution of Commission"@en ;
    cml:realizedBy doc:sec-44zb-ss-3 ;
    values:originalText "(3) If a direction under subsection (2) is given, the Commission as constituted in accordance with the direction must continue and finish the arbitration and may, for that purpose, have regard to any record of the proceedings of the arbitration made by the Commission as previously constituted." ;
    skos:definition "(3) If a direction under subsection (2) is given, the Commission as constituted in accordance with the direction must continue and finish the arbitration and may, for that purpose, have regard to any record of the proceedings of the arbitration made by the Commission as previously constituted."@en ;
    cml:integrityHash "fb87ae31a7931aa2916a7a121a1e63504a83cadb8a9ff921db31a5137debf3b1" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44zb ;
    cof:pageNumber "221"^^xsd:integer ;
    skos:note "Commission must continue and finish arbitration upon direction." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
