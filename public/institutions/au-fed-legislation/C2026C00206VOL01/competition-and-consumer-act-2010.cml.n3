doc:sec-44f-ss-6 a cof:Section ;
    cof:title "44F(6) Person may request recommendation" ;
    values:kind "subsection" ;
    values:originalText "(6) The applicant may request, in writing, the Council to vary the application at any time before the Council makes a recommendation relating to it." ;
    cof:pageNumber "148"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44f-ss-7 a cml:Concept ;
    skos:prefLabel "44F(7) Person may request recommendation"@en ;
    cml:realizedBy doc:sec-44f-ss-7 ;
    values:originalText "(7) If a request is made under subsection (6), the Council must decide to:  (a) make the variation; or  (b) reject the variation.  Chapter 2  Access to services" ;
