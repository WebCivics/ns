concept:competition-and-consumer-act-2010-sec-53n a cml:Concept ;
    skos:prefLabel "53N Scope of gas market instruments"@en ;
    cml:realizedBy doc:sec-53n ;
    values:originalText "Gas commodities  (1) A gas market instrument may limit the application of:  (a) the instrument; or  (b) a specified provision of the instrument; or  (c) a specified rule included in the instrument;  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBB  Gas market" ;
    skos:definition "Gas commodities  (1) A gas market instrument may limit the application of:  (a) the instrument; or  (b) a specified provision of the instrument; or  (c) a specified rule included in the instrument;  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBB  Gas market"@en ;
    cml:integrityHash "3e7b1a5001efd9149036df82a7e6a2903d7ed13f6603158168ac55e06acea3bd" ;
    cof:pageNumber "515"^^xsd:integer ;
    skos:note "Limits the application of a gas market instrument or its provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
