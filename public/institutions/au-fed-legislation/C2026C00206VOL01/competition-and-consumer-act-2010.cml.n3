concept:competition-and-consumer-act-2010-sec-4l a cml:Concept ;
    skos:prefLabel "4L Severability"@en ;
    cml:realizedBy doc:sec-4l ;
    values:originalText "If the making of a contract after the commencement of this section contravenes this Act by reason of the inclusion of a particular provision in the contract, then, subject to any order made under section 51ADB, 53ZO or 87, nothing in this Act affects the validity or enforceability of the contract otherwise than in relation to that provision in so far as that provision is severable.  Chapter 1  Preliminary" ;
    skos:definition "If the making of a contract after the commencement of this section contravenes this Act by reason of the inclusion of a particular provision in the contract, then, subject to any order made under section 51ADB, 53ZO or 87, nothing in this Act affects the validity or enforceability of the contract otherwise than in relation to that provision in so far as that provision is severable.  Chapter 1  Preliminary"@en ;
    cml:integrityHash "b5404f1be1af47d38dbc5d487c886dd25891951edd2ca745747ac5b37488629c" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Nothing in this Act affects the validity or enforceability of a contract otherwise than in relation to a severable provision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.63" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-4l-norm .
