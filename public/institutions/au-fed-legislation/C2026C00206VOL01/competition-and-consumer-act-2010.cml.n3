concept:competition-and-consumer-act-2010-sec-53 a cml:Concept ;
    skos:prefLabel "53 Object of this Part"@en ;
    cml:realizedBy doc:sec-53 ;
    values:originalText "The object of this Part is to enhance the welfare of Australians through:  (a) the regulation of the Australian gas market; and  (b) in particular, limitation of increases in gas prices." ;
    skos:definition "The object of this Part is to enhance the welfare of Australians through:  (a) the regulation of the Australian gas market; and  (b) in particular, limitation of increases in gas prices."@en ;
    cml:integrityHash "a1d93705cfacf9c7dcab020e1340a4d37e85351fe93284f59516c7db103fc8c2" ;
