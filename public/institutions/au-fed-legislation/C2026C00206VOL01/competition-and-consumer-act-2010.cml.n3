concept:competition-and-consumer-act-2010-sec-44n-ss-3 a cml:Concept ;
    skos:prefLabel "44N(3) Ministerial decision on effectiveness of access regime"@en ;
    cml:realizedBy doc:sec-44n-ss-3 ;
    values:originalText "(3) The decision must specify the period for which it is in force. Note: The period for which the decision is in force may be extended: see section 44NB." ;
    skos:definition "(3) The decision must specify the period for which it is in force. Note: The period for which the decision is in force may be extended: see section 44NB."@en ;
    cml:integrityHash "aa3762d164c77041598cf80cf04111c2a3a77c02c5f93ce1e3b733b206439bdf" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44n ;
