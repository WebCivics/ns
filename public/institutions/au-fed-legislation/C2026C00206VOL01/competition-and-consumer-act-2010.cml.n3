doc:sec-35-ss-5 a cof:Section ;
    cof:title "35(5) Suspension and removal of members of Tribunal" ;
    values:kind "subsection" ;
    values:originalText "(5) If a member of the Tribunal becomes bankrupt, applies to take the benefit of any law for the relief of bankrupt or insolvent debtors, compounds with his or her creditors or makes an assignment of his or her remuneration for their benefit, the Governor-General shall remove him or her from office." ;
    cof:pageNumber "104"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-35-ss-6 a cml:Concept ;
    skos:prefLabel "35(6) Suspension and removal of members of Tribunal"@en ;
    cml:realizedBy doc:sec-35-ss-6 ;
    values:originalText "(6) A member of the Tribunal shall not be removed from office except as provided by this section." ;
