concept:competition-and-consumer-act-2010-sec-45aa a cml:Concept ;
    skos:prefLabel "45AA Simplified outline"@en ;
    cml:realizedBy doc:sec-45aa ;
    values:originalText "The following is a simplified outline of this Division: • This Division sets out parallel offences and civil penalty provisions relating to cartel conduct. • A corporation must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision. • A cartel provision is a provision relating to:  (a) price-fixing; or  (b) restricting outputs in the production and supply chain; or  (c) allocating customers, suppliers or territories; or  (d) bid-rigging;  by parties that are, or would otherwise be, in competition with each other." ;
    skos:definition "The following is a simplified outline of this Division: • This Division sets out parallel offences and civil penalty provisions relating to cartel conduct. • A corporation must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision. • A cartel provision is a provision relating to:  (a) price-fixing; or  (b) restricting outputs in the production and supply chain; or  (c) allocating customers, suppliers or territories; or  (d) bid-rigging;  by parties that are, or would otherwise be, in competition with each other."@en ;
    cml:integrityHash "03e115c8e10189969d9ad1b61e32b4d26b9b6d31fb13ed734086677ec0396733" ;
    cof:pageNumber "283"^^xsd:integer ;
    skos:note "Corporation cannot make or give effect to a contract with cartel provision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.283" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-45aa-norm .
