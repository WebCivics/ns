doc:sec-53zn-ss-2 a cof:Section ;
    cof:title "53ZN(2) Proceedings for defamation not to lie" ;
    values:kind "subsection" ;
    values:originalText "(2) An order under subsection (1) may be made against:  (a) the person mentioned in paragraph (1)(a); or  (b) a person involved in the contravening conduct." ;
    cof:pageNumber "538"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-53zn-ss-3 a cml:Concept ;
    skos:prefLabel "53ZN(3) Proceedings for defamation not to lie"@en ;
    cml:realizedBy doc:sec-53zn-ss-3 ;
    values:originalText "(3) A court must not make an order under subsection (1) unless the court considers that the order will:  (a) redress, in whole or in part, the loss or damage suffered by the non-parties in relation to the contravening conduct; or  (b) prevent or reduce the loss or damage suffered, or likely to be suffered, by the non-parties in relation to the contravening conduct.  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBB  Gas market" ;
    skos:definition "(3) A court must not make an order under subsection (1) unless the court considers that the order will:  (a) redress, in whole or in part, the loss or damage suffered by the non-parties in relation to the contravening conduct; or  (b) prevent or reduce the loss or damage suffered, or likely to be suffered, by the non-parties in relation to the contravening conduct.  Chapter 4  Provisions relating to particular industries, payment surcharges etc. Part IVBB  Gas market"@en ;
    cml:integrityHash "8088d3e75a12d86fd20877248897627cc1a94c285857187536a7c74318b55824" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-53zn ;
    cof:pageNumber "538"^^xsd:integer ;
    skos:note "Court must consider redress or prevention of loss/damage before making an order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.538" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-53zn-ss-3-norm .
