concept:competition-and-consumer-act-2010-sec-44nf-ss-5 a cml:Concept ;
    skos:prefLabel "44NF(5) Publication—Council"@en ;
    cml:realizedBy doc:sec-44nf-ss-5 ;
    values:originalText "(5) The Council must have regard to any submission so made in deciding what to publish. It may have regard to any other matter it considers relevant." ;
