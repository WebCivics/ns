concept:competition-and-consumer-act-2010-sec-44x-ss-4 cml:asserts concept:competition-and-consumer-act-2010-sec-44x-ss-4-logic-linearlogic-2 .
concept:competition-and-consumer-act-2010-sec-44x-ss-4-logic-linearlogic-2 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "⇒" ;
    cml:logicSummary "Duty to consider matter implies consideration of matter" ;
    cml:premiseText "(4) In making an interim determination, the Commission does not have a duty to consider whether to take into account a matter referred to in subsection (1)." ;
    cml:conclusionText "If the Commission has a duty to consider the matter, then the Commission MUST consider the matter." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-44x-ss-4 cml:asserts concept:competition-and-consumer-act-2010-sec-44x-ss-4-logic-deontic-3 .
