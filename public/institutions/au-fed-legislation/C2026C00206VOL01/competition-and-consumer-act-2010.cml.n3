    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-53zr-ss-1 a cof:Section ;
    cof:title "53ZR(1) Whether it is reasonable to draw conclusion as to purpose" ;
    values:kind "subsection" ;
    values:originalText "(1) Regard must be had to any matters prescribed by the regulations for the purposes of this subsection in determining, for the purposes of section 53ZQ, whether it would be reasonable to conclude that the purpose of a person entering into or carrying out (to any extent) a scheme was to avoid the application of a civil penalty provision of a gas market instrument." ;
    cof:pageNumber "544"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-53zr-ss-2 a cml:Concept ;
    skos:prefLabel "53ZR(2) Whether it is reasonable to draw conclusion as to purpose"@en ;
    cml:realizedBy doc:sec-53zr-ss-2 ;
    values:originalText "(2) Subsection (1) does not limit the matters to which regard may be had in making a determination described in that subsection. 53ZS  This Subdivision does not limit Division 2  This Subdivision does not limit a provision of Division 2.  Provisions relating to particular industries, payment surcharges etc.  Chapter 4 Gas market  Part IVBB Investigation powers  Division 4  Section 53ZT  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "(2) Subsection (1) does not limit the matters to which regard may be had in making a determination described in that subsection. 53ZS  This Subdivision does not limit Division 2  This Subdivision does not limit a provision of Division 2.  Provisions relating to particular industries, payment surcharges etc.  Chapter 4 Gas market  Part IVBB Investigation powers  Division 4  Section 53ZT  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "422114e8ac05cef65d3729a35d20591046d0c4f6fd1d452a69ffde3c2b6e45e9" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-53zr ;
    cof:pageNumber "544"^^xsd:integer ;
    skos:note "Does not limit matters to which regard may be had in making a determination." ;
