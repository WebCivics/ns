concept:competition-and-consumer-act-2010-sec-44pg a cml:Concept ;
    skos:prefLabel "44PG Review of Commission’s initial decision"@en ;
    cml:realizedBy doc:sec-44pg ;
    values:originalText "Application  (1) A person whose interests are affected by a decision of the Commission under subsection 44PA(3) may apply in writing to the Tribunal for review of the decision.  (2) The person must apply for review within 21 days after the Commission publishes its decision. Review  (3) The review by the Tribunal is a reconsideration of the matter based on the information, reports and things referred to in section 44ZZOAA. Note: There are limits on the information to which the Tribunal may have regard (see section 44ZZOAA) and time limits that apply to the Tribunal’s decision on the review (see section 44ZZOA).  Chapter 2  Access to services" ;
    skos:definition "Application  (1) A person whose interests are affected by a decision of the Commission under subsection 44PA(3) may apply in writing to the Tribunal for review of the decision.  (2) The person must apply for review within 21 days after the Commission publishes its decision. Review  (3) The review by the Tribunal is a reconsideration of the matter based on the information, reports and things referred to in section 44ZZOAA. Note: There are limits on the information to which the Tribunal may have regard (see section 44ZZOAA) and time limits that apply to the Tribunal’s decision on the review (see section 44ZZOA).  Chapter 2  Access to services"@en ;
    cml:integrityHash "e7ad522ea327e5ba95534ef8355038ef7f7b86328c7cf9175886f60464c40d28" ;
    cof:pageNumber "207"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44pg-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44pg-ss-2 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44pg-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.207" .
