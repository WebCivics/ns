concept:competition-and-consumer-act-2010-sec-40 a cml:Concept ;
    skos:prefLabel "40 Disclosure of interests by members of Tribunal"@en ;
    cml:realizedBy doc:sec-40 ;
    values:originalText "(1) Where a member of the Tribunal is, or is to be, a member of a Division of the Tribunal in any proceedings and the member has or acquires any pecuniary interest that could conflict with the proper performance of his or her functions in relation to the proceedings:  (a) the member shall disclose the interest to the President; and  Chapter 1  Preliminary" ;
    skos:definition "(1) Where a member of the Tribunal is, or is to be, a member of a Division of the Tribunal in any proceedings and the member has or acquires any pecuniary interest that could conflict with the proper performance of his or her functions in relation to the proceedings:  (a) the member shall disclose the interest to the President; and  Chapter 1  Preliminary"@en ;
    cml:integrityHash "a4f25d9e7a3a90b4ed26ce2a24cdeb3d8aab8a52c112b1abfee748e9312a8f8d" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "Member must disclose pecuniary interest to President." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.105" ;
