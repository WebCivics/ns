concept:competition-and-consumer-act-2010-sec-52zu-ss-6 a cml:Concept ;
    skos:prefLabel "52ZU(6) Information request by bargaining party—challenges by"@en ;
    cml:realizedBy doc:sec-52zu-ss-6 ;
    values:originalText "(6) Nothing in section 52ZT requires the giving of information to the extent (if any) that the panel makes a ruling under subsection (3) that it was not reasonable for the bargaining party to make the request for the purposes of this Division, in relation to all or a specified part of the information requested." ;
    skos:definition "(6) Nothing in section 52ZT requires the giving of information to the extent (if any) that the panel makes a ruling under subsection (3) that it was not reasonable for the bargaining party to make the request for the purposes of this Division, in relation to all or a specified part of the information requested."@en ;
    cml:integrityHash "b2b9e6cf5bc8c2c2b91aa197dae8323e345b51cf86c3c1eec652358234f73e08" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-52zu ;
    cof:pageNumber "484"^^xsd:integer ;
    skos:note "No obligation to provide information beyond what is reasonable" ;
    cml:curationStatus cml:Proposed ;
