doc:sec-44lk-ss-5 a cof:Section ;
    cof:title "44LK(5) Review of decision to revoke or not revoke an ineligibility" ;
    values:kind "subsection" ;
    values:originalText "(5) The member of the Tribunal presiding at the review may require the Council to give assistance for the purposes of the review." ;
    cof:pageNumber "178"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44lk-ss-6 a cml:Concept ;
    skos:prefLabel "44LK(6) Review of decision to revoke or not revoke an ineligibility"@en ;
    cml:realizedBy doc:sec-44lk-ss-6 ;
    values:originalText "(6) Without limiting subsection (5), the member may, by written notice, require the Council to give information, and to make reports, of a kind specified in the notice, within the period specified in the notice, for the purposes of the review." ;
    skos:definition "(6) Without limiting subsection (5), the member may, by written notice, require the Council to give information, and to make reports, of a kind specified in the notice, within the period specified in the notice, for the purposes of the review."@en ;
