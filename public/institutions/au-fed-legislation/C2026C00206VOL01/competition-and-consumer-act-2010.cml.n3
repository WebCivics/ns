    skos:prefLabel "44KA(4) Tribunal may stay operation of declaration"@en ;
    cml:realizedBy doc:sec-44ka-ss-4 ;
    values:originalText "(4) Subsection (3) does not prohibit the Tribunal from making an order without giving to a person referred to in that subsection a  Chapter 2  Access to services" ;
    skos:definition "(4) Subsection (3) does not prohibit the Tribunal from making an order without giving to a person referred to in that subsection a  Chapter 2  Access to services"@en ;
    cml:integrityHash "4e086709f39b4b06ea0f37636e05dcfefe49e632a13b0e5df8b2070ba0cec41c" ;
