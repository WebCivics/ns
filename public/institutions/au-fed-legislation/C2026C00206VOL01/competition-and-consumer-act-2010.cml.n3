    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ld-ss-5 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ld-ss-6 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ld-ss-7 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ld-ss-8 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ld-ss-9 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ld-ss-10 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
