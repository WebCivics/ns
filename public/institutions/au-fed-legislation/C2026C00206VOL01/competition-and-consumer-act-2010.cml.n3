concept:competition-and-consumer-act-2010-sec-37 a cml:Concept ;
    skos:prefLabel "37 Constitution of Tribunal for particular matters"@en ;
    cml:realizedBy doc:sec-37 ;
    values:originalText "For the purpose of hearing and determining proceedings, the Tribunal must be constituted by a Division of the Tribunal consisting of:  (a) in any case—a presidential member of the Tribunal and 2 members of the Tribunal who are not presidential members; or  (b) if the proceedings are proceedings on a review under Division 1A of Part IX—a presidential member of the Tribunal." ;
    skos:definition "For the purpose of hearing and determining proceedings, the Tribunal must be constituted by a Division of the Tribunal consisting of:  (a) in any case—a presidential member of the Tribunal and 2 members of the Tribunal who are not presidential members; or  (b) if the proceedings are proceedings on a review under Division 1A of Part IX—a presidential member of the Tribunal."@en ;
    cml:integrityHash "e9ac39d927102b273258da650606d358be0bd54c2ff5c6c4649cf3c9d10513ed" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "Presidential member and 2 non-presidential members must constitute the Tribunal for hearing and determining proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
