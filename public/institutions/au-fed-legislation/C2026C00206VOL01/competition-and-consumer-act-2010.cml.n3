    cml:conclusionText "The person must notify the Commission within a timeframe." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-45ax-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-4 .
