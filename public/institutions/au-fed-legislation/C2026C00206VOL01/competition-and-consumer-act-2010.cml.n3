concept:competition-and-consumer-act-2010-sec-53zg a cml:Concept ;
    skos:prefLabel "53ZG Constitution—gas market instruments must not give"@en ;
    cml:realizedBy doc:sec-53zg ;
    values:originalText "preference to States etc.  (1) A gas market instrument must not give preference to one State or any part thereof within the meaning of section 99 of the Constitution.  (2) A power or function conferred by a gas market instrument must not be exercised or performed in such a way as to give preference to one State or any part thereof within the meaning of section 99 of the Constitution." ;
    skos:definition "preference to States etc.  (1) A gas market instrument must not give preference to one State or any part thereof within the meaning of section 99 of the Constitution.  (2) A power or function conferred by a gas market instrument must not be exercised or performed in such a way as to give preference to one State or any part thereof within the meaning of section 99 of the Constitution."@en ;
    cml:integrityHash "64f1eb797d0b773b6532ae1d70e0e6bfae88404eff8015730e87566955126e77" ;
    cof:pageNumber "532"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-53zg-ss-1 ;
