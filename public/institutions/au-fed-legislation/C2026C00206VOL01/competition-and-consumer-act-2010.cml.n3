concept:competition-and-consumer-act-2010-sec-44lk-ss-8 a cml:Concept ;
    skos:prefLabel "44LK(8) Review of decision to revoke or not revoke an ineligibility"@en ;
    cml:realizedBy doc:sec-44lk-ss-8 ;
    values:originalText "(8) If the designated Minister decided to revoke his or her decision (the ineligibility decision) that the service is ineligible to be a declared service, the Tribunal may either:  (a) affirm the designated Minister’s decision; or  (b) set aside the designated Minister’s decision to revoke the ineligibility decision." ;
    skos:definition "(8) If the designated Minister decided to revoke his or her decision (the ineligibility decision) that the service is ineligible to be a declared service, the Tribunal may either:  (a) affirm the designated Minister’s decision; or  (b) set aside the designated Minister’s decision to revoke the ineligibility decision."@en ;
    cml:integrityHash "53d8d9ea2e802baf000d8ae37864e1e224569ad9209eceaf8d874652421c16c0" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44lk ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Tribunal may affirm or set aside designated Minister's decision to revoke ineligibility" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
