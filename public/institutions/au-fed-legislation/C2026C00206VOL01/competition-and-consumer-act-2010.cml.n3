doc:sec-52zx-ss-7 a cof:Section ;
    cof:title "52ZX(7) Final offer arbitration" ;
    values:kind "subsection" ;
    values:originalText "(7) The panel must accept one of the final offers unless the panel considers that each final offer is not in the public interest because it is highly likely to result in serious detriment to:  (a) the provision of covered news content in Australia; or  (b) Australian consumers." ;
    cof:pageNumber "486"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-52zx-ss-8 a cml:Concept ;
    skos:prefLabel "52ZX(8) Final offer arbitration"@en ;
    cml:realizedBy doc:sec-52zx-ss-8 ;
    values:originalText "(8) If the panel does not accept one of those final offers, it must ascertain the remuneration amount by adjusting the most reasonable of those offers in a manner that results in that offer being in the public interest." ;
    skos:definition "(8) If the panel does not accept one of those final offers, it must ascertain the remuneration amount by adjusting the most reasonable of those offers in a manner that results in that offer being in the public interest."@en ;
    cml:integrityHash "f4a000a56fcfe9c963587438941486c439e05ac2041cdd6c3c98b05d8491795e" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-52zx ;
    cof:pageNumber "486"^^xsd:integer ;
    skos:note "Panel must adjust final offer to be in public interest if not accepted." ;
