concept:competition-and-consumer-act-2010-sec-44ze a cml:Concept ;
    skos:prefLabel "44ZE Right to representation"@en ;
    cml:realizedBy doc:sec-44ze ;
    values:originalText "In an arbitration hearing before the Commission under this Part, a party may appear in person or be represented by someone else." ;
