doc:sec-44le-ss-2 a cof:Section ;
    cof:title "44LE(2) Council may invite public submissions on the application" ;
    values:kind "subsection" ;
    values:originalText "(2) The notice must specify how submissions may be made and the day by which submissions may be made (which must be at least 14 days after the day the notice is published). Consideration of submissions" ;
    cof:pageNumber "170"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-44le-ss-3 a cml:Concept ;
    skos:prefLabel "44LE(3) Council may invite public submissions on the application"@en ;
    cml:realizedBy doc:sec-44le-ss-3 ;
    values:originalText "(3) Subject to subsection (6), in deciding what recommendation to make on the application, the Council:  (a) must have regard to any submission made on or before the day specified in the notice; and  (b) may disregard any submission made after the day specified in the notice. Council may make submissions publicly available" ;
    skos:definition "(3) Subject to subsection (6), in deciding what recommendation to make on the application, the Council:  (a) must have regard to any submission made on or before the day specified in the notice; and  (b) may disregard any submission made after the day specified in the notice. Council may make submissions publicly available"@en ;
    cml:integrityHash "264e5efaba22c6a879e1a69c3460000b8e8bdf36f89e9e59a7b5bbccf916b446" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44le ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Must consider submissions before specified day" ;
    cml:curationStatus cml:Proposed ;
