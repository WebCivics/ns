doc:sec-52k-ss-1 a cof:Section ;
    cof:title "52K(1) Adding or removing news source from registered news business" ;
    values:kind "subsection" ;
    values:originalText "(1) A registered news business corporation for a registered news business may apply to the ACMA for:  (a) the addition of a news source to the news business; or  (b) the removal of a news source from the news business." ;
    cof:pageNumber "457"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-52k-ss-2 a cml:Concept ;
    skos:prefLabel "52K(2) Adding or removing news source from registered news business"@en ;
    cml:realizedBy doc:sec-52k-ss-2 ;
    values:originalText "(2) The application must:  (a) be in writing; and  (b) set out every news source that comprises the news business; and  (c) specify the news source to be added or removed; and  (d) if regulations made for the purposes of this paragraph specify requirements—meet those requirements." ;
    skos:definition "(2) The application must:  (a) be in writing; and  (b) set out every news source that comprises the news business; and  (c) specify the news source to be added or removed; and  (d) if regulations made for the purposes of this paragraph specify requirements—meet those requirements."@en ;
    cml:integrityHash "c3005ae665178276a3afde6b3bc0900ce9a9183870b41ce1405f979eba2a9524" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-52k ;
    cof:pageNumber "457"^^xsd:integer ;
    skos:note "Application must be in writing and meet specified requirements." ;
    dc:description "news source that comprises the news business, specifications for added or removed sources" ;
    cml:curationStatus cml:Proposed ;
