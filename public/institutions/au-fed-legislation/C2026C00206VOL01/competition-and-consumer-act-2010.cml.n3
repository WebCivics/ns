    skos:prefLabel "45AG(2) Giving effect to a cartel provision"@en ;
    cml:realizedBy doc:sec-45ag-ss-2 ;
    values:originalText "(2) The fault element for paragraph (1)(a) is knowledge or belief. Penalty" ;
