concept:competition-and-consumer-act-2010-sec-44ax a cml:Concept ;
    skos:prefLabel "44AX Outside employment"@en ;
    cml:realizedBy doc:sec-44ax ;
    values:originalText "(1) A full-time AER member must not engage in paid employment outside the duties of the member’s office without the Minister’s consent.  (2) A part-time AER member must not engage in any paid employment that conflicts or could conflict with the proper performance of the member’s duties." ;
    skos:definition "(1) A full-time AER member must not engage in paid employment outside the duties of the member’s office without the Minister’s consent.  (2) A part-time AER member must not engage in any paid employment that conflicts or could conflict with the proper performance of the member’s duties."@en ;
    cml:integrityHash "0a376932e988fcb9fd5bfbeb939b755ae3710b7bd7e0b02f50f9e8dcaa44b8d4" ;
    cof:pageNumber "121"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ax-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-44ax-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
