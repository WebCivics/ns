concept:competition-and-consumer-act-2010-sec-45ab a cml:Concept ;
    skos:prefLabel "45AB Definitions"@en ;
    cml:realizedBy doc:sec-45ab ;
    values:originalText "In this Division: benefit includes any advantage and is not limited to property. bid includes:  (a) tender; and  Chapter 3  Restrictive trade practices" ;
    skos:definition "In this Division: benefit includes any advantage and is not limited to property. bid includes:  (a) tender; and  Chapter 3  Restrictive trade practices"@en ;
