    values:partOf concept:competition-and-consumer-act-2010-sec-45az ;
    cof:pageNumber "306"^^xsd:integer ;
    skos:note "Providing false or misleading information is prohibited. Failure to comply with conditions is a contravention." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
