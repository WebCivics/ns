concept:competition-and-consumer-act-2010-sec-45ay a cml:Concept ;
    skos:prefLabel "45AY Stayed acquisitions must not be put into effect"@en ;
    cml:realizedBy doc:sec-45ay ;
    values:originalText "A person contravenes this section if:  (a) the person puts an acquisition into effect; and  (b) the acquisition is stayed. Note 1: For when an acquisition is stayed, see section 51ABE. Note 2: For enforcement, see Part VI.  Chapter 3  Restrictive trade practices" ;
    skos:definition "A person contravenes this section if:  (a) the person puts an acquisition into effect; and  (b) the acquisition is stayed. Note 1: For when an acquisition is stayed, see section 51ABE. Note 2: For enforcement, see Part VI.  Chapter 3  Restrictive trade practices"@en ;
    cml:integrityHash "a65f47c93663e2a3a2bcd1f94ec3fdc4c37df7a2e7aeaf12bccb2ae71fb4c4cf" ;
    cof:pageNumber "305"^^xsd:integer ;
    skos:note "Acquisitions stayed must not be put into effect" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.305" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-45ay-norm .
