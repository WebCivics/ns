doc:sec-45ab a cof:Section ;
    cof:title "45AB Definitions" ;
    values:kind "section" ;
    values:originalText "In this Division: benefit includes any advantage and is not limited to property. bid includes:  (a) tender; and  Chapter 3  Restrictive trade practices" ;
    cof:pageNumber "283"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-45ac a cml:Concept ;
    skos:prefLabel "45AC Extended meaning of party"@en ;
    cml:realizedBy doc:sec-45ac ;
    values:originalText "For the purposes of this Division, if a body corporate is a party to a contract, arrangement or understanding (otherwise than because of this section), each body corporate related to that body corporate is taken to be a party to that contract, arrangement or understanding." ;
    skos:definition "For the purposes of this Division, if a body corporate is a party to a contract, arrangement or understanding (otherwise than because of this section), each body corporate related to that body corporate is taken to be a party to that contract, arrangement or understanding."@en ;
    cml:integrityHash "b655b7617f58417f3b897266eccafa41edd492e33dea7c26758363ccc6e2d10f" ;
    cof:pageNumber "284"^^xsd:integer ;
    skos:note "Each related body corporate is taken to be a party to the contract, arrangement or understanding." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
