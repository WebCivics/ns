concept:competition-and-consumer-act-2010-sec-53e a cml:Concept ;
    skos:prefLabel "53E Extension to external Territories"@en ;
    cml:realizedBy doc:sec-53e ;
    values:originalText "(1) The gas market provisions extend to every external Territory.  (2) A reference in the gas market provisions to Australia is taken to include a reference to the external Territories." ;
    skos:definition "(1) The gas market provisions extend to every external Territory.  (2) A reference in the gas market provisions to Australia is taken to include a reference to the external Territories."@en ;
