concept:competition-and-consumer-act-2010-sec-45aw a cml:Concept ;
    skos:prefLabel "45AW Commission must be notified of acquisitions"@en ;
    cml:realizedBy doc:sec-45aw ;
    values:originalText "A person contravenes this section if:  (a) the person is a principal party to an acquisition; and  (b) the acquisition is required to be notified; and  (c) the acquisition is put into effect; and  (d) when the acquisition is put into effect:  (i) the acquisition is not a notified acquisition; or  (ii) no notification of the acquisition has an effective notification date (see section 51ABZ); or  (iii) the latest notification of the acquisition that has an effective notification date is stale. Note 1: For when an acquisition is required to be notified, see Division 2 of" ;
    skos:definition "A person contravenes this section if:  (a) the person is a principal party to an acquisition; and  (b) the acquisition is required to be notified; and  (c) the acquisition is put into effect; and  (d) when the acquisition is put into effect:  (i) the acquisition is not a notified acquisition; or  (ii) no notification of the acquisition has an effective notification date (see section 51ABZ); or  (iii) the latest notification of the acquisition that has an effective notification date is stale. Note 1: For when an acquisition is required to be notified, see Division 2 of"@en ;
    cml:integrityHash "7bd2b4b0110f956af5072a699b8b642d2b756c4eafcd43f0d4a61cc2ecf36d83" ;
    cof:pageNumber "303"^^xsd:integer ;
    skos:note "Failure to notify acquisitions is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.303" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-45aw-norm .
