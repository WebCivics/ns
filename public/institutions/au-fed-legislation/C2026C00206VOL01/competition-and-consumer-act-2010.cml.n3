concept:competition-and-consumer-act-2010-sec-53m-ss-7 a cml:Concept ;
    skos:prefLabel "53M(7) Minister may make gas market emergency price orders"@en ;
    cml:realizedBy doc:sec-53m-ss-7 ;
    values:originalText "(7) A gas market emergency price order is repealed by force of this subsection at the time specified by subsection (8), unless the gas market emergency price order is repealed earlier." ;
    skos:definition "(7) A gas market emergency price order is repealed by force of this subsection at the time specified by subsection (8), unless the gas market emergency price order is repealed earlier."@en ;
