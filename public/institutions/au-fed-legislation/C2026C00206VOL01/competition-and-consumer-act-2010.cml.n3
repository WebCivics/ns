concept:competition-and-consumer-act-2010-sec-44g a cml:Concept ;
    skos:prefLabel "44G Criteria for the Council recommending declaration of a service"@en ;
    cml:realizedBy doc:sec-44g ;
    values:originalText "The Council cannot recommend that a service be declared unless it is satisfied of all of the declaration criteria for the service." ;
    skos:definition "The Council cannot recommend that a service be declared unless it is satisfied of all of the declaration criteria for the service."@en ;
    cml:integrityHash "ed218e4ce3c1de9fbdb0881684974105c7c972f76a640438ca5337ae7e8d997c" ;
    cof:pageNumber "151"^^xsd:integer ;
    skos:note "The Council must satisfy all declaration criteria before recommending a service." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
