concept:competition-and-consumer-act-2010-sec-44ai-ss-4 a cml:Concept ;
    skos:prefLabel "44AI(4) Commonwealth consent to conferral of functions etc. on AER"@en ;
    cml:realizedBy doc:sec-44ai-ss-4 ;
    values:originalText "(4) A local energy instrument may confer functions or powers, or impose duties, on the AER only if the instrument is designated for the purposes of this subsection under the Australian Energy Market Agreement, or any other relevant agreement between the Commonwealth and the State or Territory that made the instrument." ;
    skos:definition "(4) A local energy instrument may confer functions or powers, or impose duties, on the AER only if the instrument is designated for the purposes of this subsection under the Australian Energy Market Agreement, or any other relevant agreement between the Commonwealth and the State or Territory that made the instrument."@en ;
    cml:integrityHash "b18d0bc9b49ced57339b105c270ec42abcc3edb97380463befceb3553b775803" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-44ai ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "A local energy instrument must be designated for the purposes of this subsection under a relevant agreement before conferring functions or powers on the AER." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
