    cml:conclusionText "...acquire shares or assets..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-50-ss-1 a cof:Section ;
    cof:title "50(1) Prohibition of acquisitions that would result in a substantial" ;
    values:kind "subsection" ;
    values:originalText "(1) A corporation must not directly or indirectly:  (a) acquire shares in the capital of a body corporate; or  (b) acquire any assets of a person; if the acquisition would have the effect, or be likely to have the effect, of substantially lessening competition in any market. Note: The corporation will not be prevented from making the acquisition if the corporation is granted an authorisation for the acquisition under section 88." ;
    cof:pageNumber "336"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-50-ss-2 a cml:Concept ;
