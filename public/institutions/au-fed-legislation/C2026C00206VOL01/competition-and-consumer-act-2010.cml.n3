doc:sec-7-ss-1 a cof:Section ;
    cof:title "7(1) Constitution of Commission" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commission shall consist of a Chairperson and such number of other members as are from time to time appointed in accordance with this Act." ;
    cof:pageNumber "77"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-7-ss-2 a cml:Concept ;
    skos:prefLabel "7(2) Constitution of Commission"@en ;
    cml:realizedBy doc:sec-7-ss-2 ;
    values:originalText "(2) The members of the Commission shall be appointed by the Governor-General and shall be so appointed as full-time members." ;
