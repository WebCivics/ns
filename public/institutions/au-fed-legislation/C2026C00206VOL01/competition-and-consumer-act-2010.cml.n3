    skos:prefLabel "44AM(2) Appointment of Commonwealth AER members"@en ;
    cml:realizedBy doc:sec-44am-ss-2 ;
    values:originalText "(2) A Commonwealth AER member holds office for the period specified in the instrument of appointment. The period must not exceed 5 years." ;
