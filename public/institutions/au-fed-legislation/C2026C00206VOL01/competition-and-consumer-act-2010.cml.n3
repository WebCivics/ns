concept:competition-and-consumer-act-2010-sec-44v a cml:Concept ;
    skos:prefLabel "44V Determination by Commission"@en ;
    cml:realizedBy doc:sec-44v ;
    values:originalText "(1) Unless it terminates the arbitration under section 44Y, 44YA, 44ZZCB or 44ZZCBA, the Commission:  (a) must make a written final determination; and  (b) may make a written interim determination;  Chapter 2  Access to services" ;
    skos:definition "(1) Unless it terminates the arbitration under section 44Y, 44YA, 44ZZCB or 44ZZCBA, the Commission:  (a) must make a written final determination; and  (b) may make a written interim determination;  Chapter 2  Access to services"@en ;
    cml:integrityHash "7cb60930ab55f16f67f8293403ebce215d1d68f7163e47e9e5a5dfb874bc57a2" ;
    cof:pageNumber "213"^^xsd:integer ;
    skos:note "Must make written final determination unless terminating arbitration under specified sections." ;
    dc:description "Written final determination" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
