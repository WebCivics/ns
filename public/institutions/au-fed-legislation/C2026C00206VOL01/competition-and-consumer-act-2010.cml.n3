doc:sec-52zt-ss-4 a cof:Section ;
    cof:title "52ZT(4) Information request by bargaining party—general" ;
    values:kind "subsection" ;
    values:originalText "(4) The bargaining party must give a copy of the request to the panel on the same day that it gives the request to the other bargaining party." ;
