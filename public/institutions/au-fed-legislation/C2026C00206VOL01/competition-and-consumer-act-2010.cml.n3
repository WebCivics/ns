concept:competition-and-consumer-act-2010-sec-44zy a cml:Concept ;
    skos:prefLabel "44ZY Effect of registration of contract"@en ;
    cml:realizedBy doc:sec-44zy ;
    values:originalText "The parties to a contract that has been registered:  (a) may enforce the contract under Division 7 as if the contract were a determination of the Commission under section 44V and they were parties to the determination; and  (b) cannot enforce the contract by any other means.  Access to services  Chapter 2 Access to services  Part IIIA Hindering access to declared services  Division 5  Section 44ZZ  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "The parties to a contract that has been registered:  (a) may enforce the contract under Division 7 as if the contract were a determination of the Commission under section 44V and they were parties to the determination; and  (b) cannot enforce the contract by any other means.  Access to services  Chapter 2 Access to services  Part IIIA Hindering access to declared services  Division 5  Section 44ZZ  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "55f61543a3cdb6f8bb5d8f7219c0e87df471ca28cb1eb5f1ebef3e5d2d1079a9" ;
    cof:pageNumber "238"^^xsd:integer ;
    skos:note "Parties to a registered contract can enforce it under Division 7 as if it were a determination of the Commission." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
