concept:competition-and-consumer-act-2010-sec-53zf a cml:Concept ;
    skos:prefLabel "53ZF Provisions do not limit other provisions"@en ;
    cml:realizedBy doc:sec-53zf ;
    values:originalText "(1) A provision to which this section applies does not limit another provision to which this section applies.  (2) This section applies to:  (a) subsection 53N(1); and  (b) subsection 53N(4); and  (c) each provision of Subdivision B; and  (d) each provision of Subdivision C; and  (e) each provision of Subdivision D; and  (f) subsection 53ZJ(1)." ;
    skos:definition "(1) A provision to which this section applies does not limit another provision to which this section applies.  (2) This section applies to:  (a) subsection 53N(1); and  (b) subsection 53N(4); and  (c) each provision of Subdivision B; and  (d) each provision of Subdivision C; and  (e) each provision of Subdivision D; and  (f) subsection 53ZJ(1)."@en ;
    cml:integrityHash "c413e69b9eb6effd465cd5d40b57faa05914ee1b34de37c63822c2d9679f6b84" ;
    cof:pageNumber "532"^^xsd:integer ;
