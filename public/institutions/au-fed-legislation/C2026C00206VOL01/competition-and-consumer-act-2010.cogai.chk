  logic: Deontic;
  operator: MUST;
  summary: Service declaration must promote public interest.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (d) that access (or increased access) to the service, on reasonable terms and conditions, as a result of a declaration of the service would promote the public interest.;
  @action: (d) that access (or increased access) to the service, on reasonable terms and conditions, as a result of a declaration of the service would promote the public interest.;
}

competition-and-consumer-act-2010-sec-44ca-ss-1-logic-448 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-44ca-ss-1;
  logic: Deontic;
  operator: MUST;
  summary: Service declaration must meet market demand criteria.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (b) that the facility that is used (or will be used) to provide the service could meet the total foreseeable demand in the market: (i) over the period for which the service would be declared; and (ii) at the least cost compared to any 2 or more facilities (which could include the first-mentioned facility);;
  @action: (b) that the facility that is used (or will be used) to provide the service could meet the total foreseeable demand in the market: (i) over the period for which the service would be declared; and (ii) at the least cost compared to any 2 or more facilities (which could include the first-mentioned facility);;
}

