competition-and-consumer-act-2010-sec-44ca-ss-1-logic-445 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-44ca-ss-1;
  logic: Deontic;
  operator: MUST;
  summary: Service declaration must promote material increase in competition and public interest.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) The declaration criteria for a service are: (a) that access (or increased access) to the service, on reasonable terms and conditions, as a result of a declaration of the service would promote a material increase in competition in at least one market (whether or not in Australia), other than the market for the service; and;
  @action: (1) The declaration criteria for a service are: (a) that access (or increased access) to the service, on reasonable terms and conditions, as a result of a declaration of the service would promote a material increase in competition in at least one market (whether or not in Australia), other than the market for the service; and;
}

competition-and-consumer-act-2010-sec-44ca-ss-1-logic-446 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-44ca-ss-1;
  logic: Deontic;
  operator: MUST;
  summary: Service declaration must meet facility size and importance criteria.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (c) that the facility is of national significance, having regard to: (i) the size of the facility; or (ii) the importance of the facility to constitutional trade or commerce; or (iii) the importance of the facility to the national economy;;
  @action: (c) that the facility is of national significance, having regard to: (i) the size of the facility; or (ii) the importance of the facility to constitutional trade or commerce; or (iii) the importance of the facility to the national economy;;
}

