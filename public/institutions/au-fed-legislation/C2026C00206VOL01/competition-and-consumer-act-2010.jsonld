      "cml:integrityHash": "8e97f3a11c6407a6cca9d70548a2d0e3f5005065b953dd0b6059427bf952df85",
      "skos:note": "Notification of arbitration required for remuneration issue"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zl-ss-1",
      "@type": "cof:Section",
      "cof:title": "52ZL(1) Notification of arbitration",
      "values:kind": "subsection",
      "cof:pageNumber": 477,
      "values:originalText": "(1) This section applies if:\n\n(a) a notification has been made for the purposes of\nsubsection 52ZE(1) to a responsible digital platform\ncorporation for a designated digital platform service; and\n\n(b) one of the core bargaining issues (the remuneration issue)\nconcerns the remuneration to be paid to a registered news\nbusiness for the making available of the registered news\nbusiness’ covered news content by the designated digital\nplatform service."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zl-ss-1-norm",
