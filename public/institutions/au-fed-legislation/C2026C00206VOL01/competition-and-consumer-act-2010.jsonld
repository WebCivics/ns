      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Tribunal must reconsider decision",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 44ZZOAA",
      "cml:conclusionText": "Review by Tribunal is a reconsideration of the matter"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
