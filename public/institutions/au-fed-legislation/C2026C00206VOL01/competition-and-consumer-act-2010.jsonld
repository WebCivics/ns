    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53zz-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "53ZZ(2) Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zz-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
