    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zp-ss-5b",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZP(5B) Review by Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zp-ss-5b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.232",
      "values:originalText": "(5B) The Tribunal must:\n\n(a) give a copy of the notice to:\n\n(i) the person who applied for review; and\n\n(ii) the other party or parties to the final determination; and\n\n(iii) any other person who has been made a party to the\nproceedings for review by the Tribunal; and\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nAccess to declared services  Division 3\n\nSection 44ZQ\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) publish, by electronic or other means, the notice.",
      "skos:definition": "(5B) The Tribunal must:\n\n(a) give a copy of the notice to:\n\n(i) the person who applied for review; and\n\n(ii) the other party or parties to the final determination; and\n\n(iii) any other person who has been made a party to the\nproceedings for review by the Tribunal; and\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nAccess to declared services  Division 3\n\nSection 44ZQ\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) publish, by electronic or other means, the notice.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44zp"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zp-ss-5b-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zp-ss-5b-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zp-ss-5b-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3128a542b2cb9a3c6f1e6de834e96a9f0a92ab585830959175ccc24f43ad7bfd",
      "skos:note": "The Tribunal must give a copy of the notice to certain parties and publish it."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zp-ss-5b",
      "@type": "cof:Section",
      "cof:title": "44ZP(5B) Review by Tribunal",
      "values:kind": "subsection",
      "cof:pageNumber": 232,
      "values:originalText": "(5B) The Tribunal must:\n\n(a) give a copy of the notice to:\n\n(i) the person who applied for review; and\n\n(ii) the other party or parties to the final determination; and\n\n(iii) any other person who has been made a party to the\nproceedings for review by the Tribunal; and\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nAccess to declared services  Division 3\n\nSection 44ZQ\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) publish, by electronic or other means, the notice."
    },
