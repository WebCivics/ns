    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ea",
      "@type": "cml:Concept",
      "skos:prefLabel": "45EA Provisions contravening section 45E not to be given effect",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ea"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.322",
      "values:originalText": "A person must not give effect to a provision of a contract,\narrangement or understanding if, because of the provision, the\nmaking of the contract or arrangement, or the arriving at the\nunderstanding, by the person:\n\nRestrictive trade practices  Chapter 3\nRestrictive trade practices  Part IV\nOther provisions  Division 2\n\nSection 45EB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(a) contravened subsection 45E(2) or (3); or\n\n(b) would have contravened subsection 45E(2) or (3) if:\n\n(i) section 45E had been in force when the contract or\narrangement was made, or the understanding was\narrived at; and\n\n(ii) the words “is in writing and” and “written” were not\nincluded in subsection 45E(4).\nNote:\nConduct that would otherwise contravene this section can be\nauthorised under section 88.",
      "skos:definition": "A person must not give effect to a provision of a contract,\narrangement or understanding if, because of the provision, the\nmaking of the contract or arrangement, or the arriving at the\nunderstanding, by the person:\n\nRestrictive trade practices  Chapter 3\nRestrictive trade practices  Part IV\nOther provisions  Division 2\n\nSection 45EB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(a) contravened subsection 45E(2) or (3); or\n\n(b) would have contravened subsection 45E(2) or (3) if:\n\n(i) section 45E had been in force when the contract or\narrangement was made, or the understanding was\narrived at; and\n\n(ii) the words “is in writing and” and “written” were not\nincluded in subsection 45E(4).\nNote:\nConduct that would otherwise contravene this section can be\nauthorised under section 88.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ea-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "875c9fe55331ea937a9fc511e5f5f8d614a7f0e18a6f43efd52da3e941ac1c5d",
      "skos:note": "Prohibition on giving effect to provisions contravening section 45E"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ea",
      "@type": "cof:Section",
      "cof:title": "45EA Provisions contravening section 45E not to be given effect",
      "values:kind": "section",
      "cof:pageNumber": 322,
      "values:originalText": "A person must not give effect to a provision of a contract,\narrangement or understanding if, because of the provision, the\nmaking of the contract or arrangement, or the arriving at the\nunderstanding, by the person:\n\nRestrictive trade practices  Chapter 3\nRestrictive trade practices  Part IV\nOther provisions  Division 2\n\nSection 45EB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(a) contravened subsection 45E(2) or (3); or\n\n(b) would have contravened subsection 45E(2) or (3) if:\n\n(i) section 45E had been in force when the contract or\narrangement was made, or the understanding was\narrived at; and\n\n(ii) the words “is in writing and” and “written” were not\nincluded in subsection 45E(4).\nNote:\nConduct that would otherwise contravene this section can be\nauthorised under section 88."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ea-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
