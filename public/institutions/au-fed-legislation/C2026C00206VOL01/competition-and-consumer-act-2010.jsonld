    {
      "@id": "concept:competition-and-consumer-act-2010-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.104",
      "values:originalText": "A member of the Tribunal may resign his or her office by writing\nsigned by him or her and delivered to the Governor-General.\n\nPreliminary  Chapter 1\nThe Australian Competition Tribunal  Part III\n\nSection 37\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "A member of the Tribunal may resign his or her office by writing\nsigned by him or her and delivered to the Governor-General.\n\nPreliminary  Chapter 1\nThe Australian Competition Tribunal  Part III\n\nSection 37\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-36-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6810b71285279e6dfb92ea4965ca44134cbaa0984945cf93b9c07932f663b5ac",
      "skos:note": "A member of the Tribunal may resign by writing signed and delivered to the Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Resignation",
      "values:kind": "section",
      "cof:pageNumber": 104,
      "values:originalText": "A member of the Tribunal may resign his or her office by writing\nsigned by him or her and delivered to the Governor-General.\n\nPreliminary  Chapter 1\nThe Australian Competition Tribunal  Part III\n\nSection 37\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
