        }
      ],
      "cml:integrityHash": "b7214175e8167b66aea845a43046710e36cb5bec2ea2ac0e71f28167c2de64f5",
      "skos:note": "Council must be given a reasonable opportunity to make submissions before making an order under subsection (2)"
    },
    {
