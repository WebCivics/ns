      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.448",
      "values:originalText": "(2) Subsection (1) does not limit, for the purposes of this Part, the\nways in which a user of a service interacts with content made\navailable by a service.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nBasic concepts  Division 1\n\nSection 52D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(2) Subsection (1) does not limit, for the purposes of this Part, the\nways in which a user of a service interacts with content made\navailable by a service.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nBasic concepts  Division 1\n\nSection 52D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52c"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8e9f52ad54f3598f12441fbab9c1f2b9d6935ab40f72a042fd5fe59e18e4eb96",
      "skos:note": "No limitation on user interaction with content."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52c-ss-2",
      "@type": "cof:Section",
      "cof:title": "52C(2) Interacting with content",
      "values:kind": "subsection",
      "cof:pageNumber": 448,
      "values:originalText": "(2) Subsection (1) does not limit, for the purposes of this Part, the\nways in which a user of a service interacts with content made\navailable by a service.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nBasic concepts  Division 1\n\nSection 52D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
