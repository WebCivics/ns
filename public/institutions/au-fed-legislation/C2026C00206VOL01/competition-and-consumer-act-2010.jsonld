      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.77",
      "values:originalText": "(1) Subject to this Part, a member of the Commission holds office for\nsuch period, not exceeding 5 years, as is specified in the instrument\nof his or her appointment and on such terms and conditions as the\nGovernor-General determines, but is eligible for re-appointment.",
      "skos:definition": "(1) Subject to this Part, a member of the Commission holds office for\nsuch period, not exceeding 5 years, as is specified in the instrument\nof his or her appointment and on such terms and conditions as the\nGovernor-General determines, but is eligible for re-appointment.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-8-norm"
        }
      ],
      "cml:integrityHash": "cd2526f916ed97703f3eddd669560a68b4e68e78903cc4b658715124102435dc",
      "skos:note": "Member of Commission holds office for specified period and on terms and conditions determined by Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Terms and conditions of appointment",
      "values:kind": "section",
      "cof:pageNumber": 77,
      "values:originalText": "(1) Subject to this Part, a member of the Commission holds office for\nsuch period, not exceeding 5 years, as is specified in the instrument\nof his or her appointment and on such terms and conditions as the\nGovernor-General determines, but is eligible for re-appointment."
    },
