      "@type": "cof:Section",
      "cof:title": "44F(5) Person may request recommendation",
      "values:kind": "subsection",
      "cof:pageNumber": 148,
      "values:originalText": "(5) The applicant may withdraw the application at any time before the\nCouncil makes a recommendation relating to it."
    },
    {
