    {
      "@id": "concept:competition-and-consumer-act-2010-sec-35-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "35(7) Suspension and removal of members of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-35-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
