    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44h",
      "@type": "cml:Concept",
      "skos:prefLabel": "44H Designated Minister may declare a service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.156",
      "values:originalText": "(1) On receiving a declaration recommendation, the designated\nMinister must either declare the service or decide not to declare it.\nNote:\nThe designated Minister must publish his or her decision: see\nsection 44HA.\n\n(1A) The designated Minister must have regard to the objects of this\nPart in making his or her decision.\n\n(4) The designated Minister cannot declare a service unless he or she\nis satisfied of all of the declaration criteria for the service.\n\n(8) If the designated Minister declares the service, the declaration must\nspecify the expiry date of the declaration.\n\n(9) If the designated Minister does not publish under section 44HA his\nor her decision on the declaration recommendation within 60 days\nafter receiving the declaration recommendation, the designated\nMinister is taken, at the end of that 60-day period:\n\n(a) to have made a decision under this section in accordance with\nthe declaration recommendation; and\n\n(b) to have published that decision under section 44HA.",
      "skos:definition": "(1) On receiving a declaration recommendation, the designated\nMinister must either declare the service or decide not to declare it.\nNote:\nThe designated Minister must publish his or her decision: see\nsection 44HA.\n\n(1A) The designated Minister must have regard to the objects of this\nPart in making his or her decision.\n\n(4) The designated Minister cannot declare a service unless he or she\nis satisfied of all of the declaration criteria for the service.\n\n(8) If the designated Minister declares the service, the declaration must\nspecify the expiry date of the declaration.\n\n(9) If the designated Minister does not publish under section 44HA his\nor her decision on the declaration recommendation within 60 days\nafter receiving the declaration recommendation, the designated\nMinister is taken, at the end of that 60-day period:\n\n(a) to have made a decision under this section in accordance with\nthe declaration recommendation; and\n\n(b) to have published that decision under section 44HA.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44h-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44h-ss-1a"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44h-ss-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44h-ss-8"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44h-ss-9"
        }
      ],
      "cml:integrityHash": "7267dc993f0da2da375ab5e983d371ab7d025917aa086dce5044d9de9bfd6e54"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44h",
      "@type": "cof:Section",
      "cof:title": "44H Designated Minister may declare a service",
      "values:kind": "section",
      "cof:pageNumber": 156,
      "values:originalText": "(1) On receiving a declaration recommendation, the designated\nMinister must either declare the service or decide not to declare it.\nNote:\nThe designated Minister must publish his or her decision: see\nsection 44HA.\n\n(1A) The designated Minister must have regard to the objects of this\nPart in making his or her decision.\n\n(4) The designated Minister cannot declare a service unless he or she\nis satisfied of all of the declaration criteria for the service.\n\n(8) If the designated Minister declares the service, the declaration must\nspecify the expiry date of the declaration.\n\n(9) If the designated Minister does not publish under section 44HA his\nor her decision on the declaration recommendation within 60 days\nafter receiving the declaration recommendation, the designated\nMinister is taken, at the end of that 60-day period:\n\n(a) to have made a decision under this section in accordance with\nthe declaration recommendation; and\n\n(b) to have published that decision under section 44HA."
    },
