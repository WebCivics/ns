          "@id": "concept:competition-and-consumer-act-2010-sec-29b-ss-2a-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "f3e82735437091fa97a93b208b932a600710d323f67bce70ea67a79999d8f83f",
      "skos:note": "Council cannot perform functions or exercise powers unless in accordance with the Competition Principles Agreement."
    },
