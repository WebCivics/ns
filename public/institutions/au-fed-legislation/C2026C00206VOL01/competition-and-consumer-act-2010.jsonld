      "cml:conclusionText": "...the panel considers that each final offer is not in the public interest."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zx-ss-7-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classification",
      "cml:logicSummary": "Classification of detrimental final offers by CogAI.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(7) The panel must accept one of the final offers unless...",
      "cml:conclusionText": "...the panel considers that each final offer is not in the public interest."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zx-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZX(8) Final offer arbitration",
      "cml:realizedBy": {
