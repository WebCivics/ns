    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44g",
      "@type": "cml:Concept",
      "skos:prefLabel": "44G Criteria for the Council recommending declaration of a service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.151",
      "values:originalText": "The Council cannot recommend that a service be declared unless it\nis satisfied of all of the declaration criteria for the service.",
      "skos:definition": "The Council cannot recommend that a service be declared unless it\nis satisfied of all of the declaration criteria for the service.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44g-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ed218e4ce3c1de9fbdb0881684974105c7c972f76a640438ca5337ae7e8d997c",
      "skos:note": "The Council must satisfy all declaration criteria before recommending a service."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44g",
      "@type": "cof:Section",
      "cof:title": "44G Criteria for the Council recommending declaration of a service",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "The Council cannot recommend that a service be declared unless it\nis satisfied of all of the declaration criteria for the service."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44g-norm",
      "@type": "values:Obligation",
