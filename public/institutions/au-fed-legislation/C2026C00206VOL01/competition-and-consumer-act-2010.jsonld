    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ag",
      "@type": "cml:Concept",
      "skos:prefLabel": "44AG Constitution of the AER",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ag"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.111",
      "values:originalText": "The AER consists of:\n\n(a) 2 Commonwealth AER members, appointed in accordance\nwith section 44AM; and\n\n(b) 3 State/Territory AER members, appointed in accordance\nwith section 44AP.\n\nChapter 1  Preliminary\nPart IIIAA  The Australian Energy Regulator (AER)",
      "skos:definition": "The AER consists of:\n\n(a) 2 Commonwealth AER members, appointed in accordance\nwith section 44AM; and\n\n(b) 3 State/Territory AER members, appointed in accordance\nwith section 44AP.\n\nChapter 1  Preliminary\nPart IIIAA  The Australian Energy Regulator (AER)",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ag-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ag-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0598d28d4eb22b0aab5a0bf915821031a6fc3b4f7e4b8551f585da37300d3f44",
      "skos:note": "Appoint Commonwealth and State/Territory AER members."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ag",
      "@type": "cof:Section",
      "cof:title": "44AG Constitution of the AER",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "The AER consists of:\n\n(a) 2 Commonwealth AER members, appointed in accordance\nwith section 44AM; and\n\n(b) 3 State/Territory AER members, appointed in accordance\nwith section 44AP.\n\nChapter 1  Preliminary\nPart IIIAA  The Australian Energy Regulator (AER)"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ag-norm",
