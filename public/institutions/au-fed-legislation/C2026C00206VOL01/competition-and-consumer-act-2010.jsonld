        }
      ],
      "cml:integrityHash": "e21f60e2379a50a99aae1c6293f1732394114748e3e2d9c2528aaae5661f4d08",
      "skos:note": "Partnerships and joint ventures are subject to the provision's costs."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44c-ss-3",
