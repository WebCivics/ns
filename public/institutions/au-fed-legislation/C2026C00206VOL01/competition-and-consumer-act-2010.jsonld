    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "44F(6) Person may request recommendation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44f-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.148",
      "values:originalText": "(6) The applicant may request, in writing, the Council to vary the\napplication at any time before the Council makes a\nrecommendation relating to it.",
