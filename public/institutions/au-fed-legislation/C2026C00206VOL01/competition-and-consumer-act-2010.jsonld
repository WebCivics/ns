    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44gb",
      "@type": "cml:Concept",
      "skos:prefLabel": "44GB Council may invite public submissions on the application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44gb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.153",
      "values:originalText": "Invitation\n\n(1) The Council may publish, by electronic or other means, a notice\ninviting public submissions on an application under section 44F if\nit considers that it is appropriate and practicable to do so.\n\n(2) The notice must specify how submissions may be made and the\nday by which submissions may be made (which must be at least 14\ndays after the day the notice is published).\n\nChapter 2  Access to services",
      "skos:definition": "Invitation\n\n(1) The Council may publish, by electronic or other means, a notice\ninviting public submissions on an application under section 44F if\nit considers that it is appropriate and practicable to do so.\n\n(2) The notice must specify how submissions may be made and the\nday by which submissions may be made (which must be at least 14\ndays after the day the notice is published).\n\nChapter 2  Access to services",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44gb-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44gb-ss-2"
        }
      ],
      "cml:integrityHash": "af4ea02852eb08ea7b96b093b59e744da12779a5997fd70804d7068c90a7cda0"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44gb",
      "@type": "cof:Section",
      "cof:title": "44GB Council may invite public submissions on the application",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "Invitation\n\n(1) The Council may publish, by electronic or other means, a notice\ninviting public submissions on an application under section 44F if\nit considers that it is appropriate and practicable to do so.\n\n(2) The notice must specify how submissions may be made and the\nday by which submissions may be made (which must be at least 14\ndays after the day the notice is published).\n\nChapter 2  Access to services"
    },
