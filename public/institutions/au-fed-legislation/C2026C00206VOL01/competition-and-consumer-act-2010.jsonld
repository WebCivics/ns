      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person is not eligible for appointment to act as a Commonwealth\nAER member unless the person has knowledge of, or experience\nin, industry, commerce, economics, law, consumer protection or\npublic administration.",
      "cml:conclusionText": "The information about the appointment spreads during the time period when the person has knowledge or experience in specified fields."
    },
