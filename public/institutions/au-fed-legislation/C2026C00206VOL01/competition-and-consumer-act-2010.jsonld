    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "29B(2) Functions and powers of Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29b-ss-2"
      },
      "cml:curationStatus": {
