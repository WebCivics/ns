    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53zy",
      "@type": "cml:Concept",
      "skos:prefLabel": "53ZY Certain provisions of this Act do not limit other provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zy"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.548",
      "values:originalText": "(1) A provision to which subsection (3) applies does not limit the gas\nmarket provisions.\n\n(2) The gas market provisions do not limit a provision to which\nsubsection (3) applies.\n\n(3) This subsection applies to:\n\n(a) Part IIIAA; and\n\n(b) Part IIIA; and\n\n(c) Part IVB; and\n\n(d) Part V; and\n\n(e) Part VIIA; and\n\n(f) Part XICA.",
      "skos:definition": "(1) A provision to which subsection (3) applies does not limit the gas\nmarket provisions.\n\n(2) The gas market provisions do not limit a provision to which\nsubsection (3) applies.\n\n(3) This subsection applies to:\n\n(a) Part IIIAA; and\n\n(b) Part IIIA; and\n\n(c) Part IVB; and\n\n(d) Part V; and\n\n(e) Part VIIA; and\n\n(f) Part XICA.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53zy-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53zy-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53zy-ss-3"
        }
      ],
      "cml:integrityHash": "338f6db45799761e9734eedffd2506ea930b4a79aa5f761560f33521841d79dd"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zy",
      "@type": "cof:Section",
      "cof:title": "53ZY Certain provisions of this Act do not limit other provisions",
      "values:kind": "section",
      "cof:pageNumber": 548,
      "values:originalText": "(1) A provision to which subsection (3) applies does not limit the gas\nmarket provisions.\n\n(2) The gas market provisions do not limit a provision to which\nsubsection (3) applies.\n\n(3) This subsection applies to:\n\n(a) Part IIIAA; and\n\n(b) Part IIIA; and\n\n(c) Part IVB; and\n\n(d) Part V; and\n\n(e) Part VIIA; and\n\n(f) Part XICA."
    },
    {
