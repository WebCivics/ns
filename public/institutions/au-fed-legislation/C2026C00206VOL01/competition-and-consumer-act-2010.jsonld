    {
      "@id": "concept:competition-and-consumer-act-2010-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Termination of appointment of members of the Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-13"
