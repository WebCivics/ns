      "cml:integrityHash": "1e103662ac2568593994978a1f402cfafd72316141585b0cf83f83c0ad88212a",
      "skos:note": "Commission must ask tenderer to provide report on conduct of tender process after selection.",
      "dc:description": "Yes"
    },
