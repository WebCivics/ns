      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29h",
      "@type": "cml:Concept",
      "skos:prefLabel": "29H Termination of appointment of Councillors",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.97",
      "values:originalText": "(1) The Governor-General may terminate the appointment of a\nCouncillor for misbehaviour or for physical or mental incapacity.\n\n(2) The Governor-General must terminate the appointment of a\nCouncillor who:\n\n(a) becomes bankrupt, applies to take the benefit of any law for\nthe relief of bankrupt or insolvent debtors, compounds with\nhis or her creditors or makes an assignment of his or her\nremuneration for their benefit;\n\n(b) fails to comply with his or her obligations under section 29 of\nthe Public Governance, Performance and Accountability Act\n2013 (which deals with the duty to disclose interests) or rules\nmade for the purposes of that section;\n\n(c) in the case of a full-time Councillor—engages in any paid\nemployment outside the duties of the Councillor’s office\nwithout the consent of the Minister;\n\n(d) in the case of a full-time Councillor—is absent from duty,\nexcept on leave of absence, for 14 consecutive days or for 28\ndays in any 12 months.",
      "skos:definition": "(1) The Governor-General may terminate the appointment of a\nCouncillor for misbehaviour or for physical or mental incapacity.\n\n(2) The Governor-General must terminate the appointment of a\nCouncillor who:\n\n(a) becomes bankrupt, applies to take the benefit of any law for\nthe relief of bankrupt or insolvent debtors, compounds with\nhis or her creditors or makes an assignment of his or her\nremuneration for their benefit;\n\n(b) fails to comply with his or her obligations under section 29 of\nthe Public Governance, Performance and Accountability Act\n2013 (which deals with the duty to disclose interests) or rules\nmade for the purposes of that section;\n\n(c) in the case of a full-time Councillor—engages in any paid\nemployment outside the duties of the Councillor’s office\nwithout the consent of the Minister;\n\n(d) in the case of a full-time Councillor—is absent from duty,\nexcept on leave of absence, for 14 consecutive days or for 28\ndays in any 12 months.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29h-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29h-ss-2"
        }
      ],
      "cml:integrityHash": "70eca85eef623649294e8a8d4b390af60c5799d10205a604d9ea344b1c00abaf"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29h",
      "@type": "cof:Section",
      "cof:title": "29H Termination of appointment of Councillors",
      "values:kind": "section",
      "cof:pageNumber": 97,
      "values:originalText": "(1) The Governor-General may terminate the appointment of a\nCouncillor for misbehaviour or for physical or mental incapacity.\n\n(2) The Governor-General must terminate the appointment of a\nCouncillor who:\n\n(a) becomes bankrupt, applies to take the benefit of any law for\nthe relief of bankrupt or insolvent debtors, compounds with\nhis or her creditors or makes an assignment of his or her\nremuneration for their benefit;\n\n(b) fails to comply with his or her obligations under section 29 of\nthe Public Governance, Performance and Accountability Act\n2013 (which deals with the duty to disclose interests) or rules\nmade for the purposes of that section;\n\n(c) in the case of a full-time Councillor—engages in any paid\nemployment outside the duties of the Councillor’s office\nwithout the consent of the Minister;\n\n(d) in the case of a full-time Councillor—is absent from duty,\nexcept on leave of absence, for 14 consecutive days or for 28\ndays in any 12 months."
    },
