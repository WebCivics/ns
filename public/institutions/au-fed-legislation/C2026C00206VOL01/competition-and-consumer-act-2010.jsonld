    {
      "@id": "concept:competition-and-consumer-act-2010-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Terms and conditions of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-8"
