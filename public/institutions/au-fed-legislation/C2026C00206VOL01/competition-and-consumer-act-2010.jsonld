    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52s-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "52S(2) Change to algorithm to bring about identified alteration to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52s-ss-2"
      },
      "cml:curationStatus": {
