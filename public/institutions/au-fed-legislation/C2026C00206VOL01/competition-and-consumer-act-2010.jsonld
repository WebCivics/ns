      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to preside",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Decision of questions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.106",
      "values:originalText": "(1) A question of law arising in a matter before a Division of the\nTribunal (including the question whether a particular question is\none of law) shall be determined in accordance with the opinion of\nthe presidential member presiding.\n\n(2) Subject to subsection (1), a question arising in proceedings before\na Division of the Tribunal shall be determined in accordance with\nthe opinion of a majority of the members constituting the Division.\n\nPreliminary  Chapter 1\nThe Australian Competition Tribunal  Part III\n\nSection 43\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) A question of law arising in a matter before a Division of the\nTribunal (including the question whether a particular question is\none of law) shall be determined in accordance with the opinion of\nthe presidential member presiding.\n\n(2) Subject to subsection (1), a question arising in proceedings before\na Division of the Tribunal shall be determined in accordance with\nthe opinion of a majority of the members constituting the Division.\n\nPreliminary  Chapter 1\nThe Australian Competition Tribunal  Part III\n\nSection 43\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
