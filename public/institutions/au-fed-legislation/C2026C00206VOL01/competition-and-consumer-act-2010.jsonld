          "@id": "concept:competition-and-consumer-act-2010-sec-44j-ss-3a"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44j-ss-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44j-ss-5"
