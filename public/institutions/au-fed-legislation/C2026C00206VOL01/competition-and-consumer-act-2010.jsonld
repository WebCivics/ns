    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "45AA Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.283",
      "values:originalText": "The following is a simplified outline of this Division:\n•\nThis Division sets out parallel offences and civil penalty\nprovisions relating to cartel conduct.\n•\nA corporation must not make, or give effect to, a contract,\narrangement or understanding that contains a cartel provision.\n•\nA cartel provision is a provision relating to:\n\n(a)\nprice-fixing; or\n\n(b)\nrestricting outputs in the production and supply chain; or\n\n(c)\nallocating customers, suppliers or territories; or\n\n(d)\nbid-rigging;\n\nby parties that are, or would otherwise be, in competition with\neach other.",
      "skos:definition": "The following is a simplified outline of this Division:\n•\nThis Division sets out parallel offences and civil penalty\nprovisions relating to cartel conduct.\n•\nA corporation must not make, or give effect to, a contract,\narrangement or understanding that contains a cartel provision.\n•\nA cartel provision is a provision relating to:\n\n(a)\nprice-fixing; or\n\n(b)\nrestricting outputs in the production and supply chain; or\n\n(c)\nallocating customers, suppliers or territories; or\n\n(d)\nbid-rigging;\n\nby parties that are, or would otherwise be, in competition with\neach other.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45aa-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "03e115c8e10189969d9ad1b61e32b4d26b9b6d31fb13ed734086677ec0396733",
      "skos:note": "Corporation cannot make or give effect to a contract with cartel provision."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45aa",
      "@type": "cof:Section",
      "cof:title": "45AA Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 283,
      "values:originalText": "The following is a simplified outline of this Division:\n•\nThis Division sets out parallel offences and civil penalty\nprovisions relating to cartel conduct.\n•\nA corporation must not make, or give effect to, a contract,\narrangement or understanding that contains a cartel provision.\n•\nA cartel provision is a provision relating to:\n\n(a)\nprice-fixing; or\n\n(b)\nrestricting outputs in the production and supply chain; or\n\n(c)\nallocating customers, suppliers or territories; or\n\n(d)\nbid-rigging;\n\nby parties that are, or would otherwise be, in competition with\neach other."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45aa-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
