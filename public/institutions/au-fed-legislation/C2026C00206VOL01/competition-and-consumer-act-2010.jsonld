        }
      ],
      "cml:integrityHash": "12b68776d407de969a2d65b7954f19a15d09f3dcb3a6500cf7fe377a125c0d20",
      "skos:note": "Commission must act speedily in arbitration hearing about access dispute."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zf-ss-1",
      "@type": "cof:Section",
      "cof:title": "44ZF(1) Procedure of Commission",
      "values:kind": "subsection",
      "cof:pageNumber": 222,
      "values:originalText": "(1) In an arbitration hearing about an access dispute, the Commission:\n\n(a) is not bound by technicalities, legal forms or rules of\nevidence; and\n\n(b) must act as speedily as a proper consideration of the dispute\nallows, having regard to the need to carefully and quickly\ninquire into and investigate the dispute and all matters\naffecting the merits, and fair settlement, of the dispute; and\n\n(c) may inform itself of any matter relevant to the dispute in any\nway it thinks appropriate."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Commission must act speedily.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commission has a duty to act speedily.",
      "cml:conclusionText": "The Commission MUST act speedily."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Commission must act speedily within a reasonable timeframe.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There is no specific time limit for the Commission's action.",
      "cml:conclusionText": "The Commission MUST act speedily within a reasonable timeframe."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Commission's speediness implies fairness in settlement of dispute.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commission's action is related to the settlement of the dispute.",
      "cml:conclusionText": "If the Commission acts speedily, then it implies a fair settlement of the dispute."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS A",
      "cml:logicSummary": "Commission's speediness affects the investigation and inquiry process.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commission's action is related to the investigation and inquiry process.",
      "cml:conclusionText": "The Commission's speediness IS A part of the investigation and inquiry process."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zf-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS A",
      "cml:logicSummary": "Commission's speediness relates to its ability to inform itself.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commission has the ability to inform itself.",
      "cml:conclusionText": "The Commission's speediness IS A part of its ability to inform itself."
    },
