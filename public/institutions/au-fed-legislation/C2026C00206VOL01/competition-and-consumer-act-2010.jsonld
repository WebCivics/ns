    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44q",
      "@type": "cml:Concept",
      "skos:prefLabel": "44Q Register of decisions, declarations and ineligibility decisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.211",
      "values:originalText": "The Commission must maintain a public register that includes:\n\n(a) each decision of the Commonwealth Minister that a regime\nestablished by a State or Territory for access to a service is an\neffective access regime for the service or proposed service;\nand\n\n(aa) each decision of the Commonwealth Minister to extend the\nperiod for which a decision under section 44N is in force;\nand\n\n(b) each declaration (including a declaration that is no longer in\nforce); and\n\n(ba) each decision of a designated Minister under section 44LG\nthat a service is ineligible to be a declared service; and\n\n(bb) each decision of a designated Minister under section 44LI to\nrevoke his or her decision that a service is ineligible to be a\ndeclared service; and\n\n(c) each decision of the Commission under subsection 44PA(3)\nto approve a tender process as a competitive tender process;\nand\n\n(d) each decision of the Commission under section 44PC to\nrevoke a decision under subsection 44PA(3).\n\nChapter 2  Access to services",
      "skos:definition": "The Commission must maintain a public register that includes:\n\n(a) each decision of the Commonwealth Minister that a regime\nestablished by a State or Territory for access to a service is an\neffective access regime for the service or proposed service;\nand\n\n(aa) each decision of the Commonwealth Minister to extend the\nperiod for which a decision under section 44N is in force;\nand\n\n(b) each declaration (including a declaration that is no longer in\nforce); and\n\n(ba) each decision of a designated Minister under section 44LG\nthat a service is ineligible to be a declared service; and\n\n(bb) each decision of a designated Minister under section 44LI to\nrevoke his or her decision that a service is ineligible to be a\ndeclared service; and\n\n(c) each decision of the Commission under subsection 44PA(3)\nto approve a tender process as a competitive tender process;\nand\n\n(d) each decision of the Commission under section 44PC to\nrevoke a decision under subsection 44PA(3).\n\nChapter 2  Access to services",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44q-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44q-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44q-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "10add1f6913640eada89c3f7ee94db9643772de724305958638c8f7f566d23f9",
      "skos:note": "Maintain a public register of decisions, declarations and ineligibility decisions.",
      "dc:description": "Register of decisions, declarations and ineligibility decisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44q",
      "@type": "cof:Section",
      "cof:title": "44Q Register of decisions, declarations and ineligibility decisions",
      "values:kind": "section",
      "cof:pageNumber": 211,
      "values:originalText": "The Commission must maintain a public register that includes:\n\n(a) each decision of the Commonwealth Minister that a regime\nestablished by a State or Territory for access to a service is an\neffective access regime for the service or proposed service;\nand\n\n(aa) each decision of the Commonwealth Minister to extend the\nperiod for which a decision under section 44N is in force;\nand\n\n(b) each declaration (including a declaration that is no longer in\nforce); and\n\n(ba) each decision of a designated Minister under section 44LG\nthat a service is ineligible to be a declared service; and\n\n(bb) each decision of a designated Minister under section 44LI to\nrevoke his or her decision that a service is ineligible to be a\ndeclared service; and\n\n(c) each decision of the Commission under subsection 44PA(3)\nto approve a tender process as a competitive tender process;\nand\n\n(d) each decision of the Commission under section 44PC to\nrevoke a decision under subsection 44PA(3).\n\nChapter 2  Access to services"
    },
    {
