      ],
      "cml:integrityHash": "b30cc7b8497ae323dca03af1352702ead4d5ebe3fa0b0f55c7c1b5de3bc1b0a8",
      "skos:note": "Court may make orders against a person referred to in subsection (2) if the contravening conduct caused loss or damage to a class of persons. No defamation action against Commonwealth, Commission, or staff in relation to notice issuance."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zn-ss-1",
      "@type": "cof:Section",
      "cof:title": "53ZN(1) Proceedings for defamation not to lie",
      "values:kind": "subsection",
      "cof:pageNumber": 538,
      "values:originalText": "(1) If the Commission issues a notice under section 53ZM, no action\nor proceeding for defamation lies against the Commonwealth, the\nCommission or a member of the staff of the Commission in\nrelation to the issuing of the notice."
    },
