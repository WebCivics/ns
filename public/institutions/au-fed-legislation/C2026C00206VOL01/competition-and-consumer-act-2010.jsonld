      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.545",
      "values:originalText": "(2) A member of the Commission may, by written notice given to the\nperson, extend the period within which the person must comply\nwith the notice.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBB  Gas market",
      "skos:definition": "(2) A member of the Commission may, by written notice given to the\nperson, extend the period within which the person must comply\nwith the notice.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBB  Gas market",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-53zu"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53zu-ss-2-norm"
        }
      ],
      "cml:integrityHash": "bebdf52b73d190a531cac00d3ae934fe0fa05f79e509ceedd4135ac20f15ffa5",
      "skos:note": "Member of Commission may extend period for complying with notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zu-ss-2",
      "@type": "cof:Section",
      "cof:title": "53ZU(2) Extending periods for complying with notices",
      "values:kind": "subsection",
      "cof:pageNumber": 545,
      "values:originalText": "(2) A member of the Commission may, by written notice given to the\nperson, extend the period within which the person must comply\nwith the notice.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBB  Gas market"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53zu-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
