    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4g",
      "@type": "cml:Concept",
      "skos:prefLabel": "4G Lessening of competition to include preventing or hindering",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4g"
      },
      "cml:curationStatus": {
