        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zx-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a61285eff7af923d63b0cebc23d8879489f4c464496f8553f346a561e247b70f",
      "skos:note": "An offer that does not comply with subsection (4) is not a final offer."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zx-ss-5",
