      },
      "cml:premiseText": "(d) inviting the person to make a written submission to the\nCommission within 14 days after the notice is given"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44pf-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "44PF(4) Commission must publish its decisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44pf-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.206",
      "values:originalText": "(4) The Commission must have regard to any submission so made in\ndeciding what to publish. It may have regard to any other matter it\nconsiders relevant.",
      "skos:definition": "(4) The Commission must have regard to any submission so made in\ndeciding what to publish. It may have regard to any other matter it\nconsiders relevant.",
