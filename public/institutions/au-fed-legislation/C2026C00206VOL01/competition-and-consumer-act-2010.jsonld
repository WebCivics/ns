    {
      "@id": "concept:competition-and-consumer-act-2010-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Disclosure of interests by members of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.105",
      "values:originalText": "(1) Where a member of the Tribunal is, or is to be, a member of a\nDivision of the Tribunal in any proceedings and the member has or\nacquires any pecuniary interest that could conflict with the proper\nperformance of his or her functions in relation to the proceedings:\n\n(a) the member shall disclose the interest to the President; and\n\nChapter 1  Preliminary",
      "skos:definition": "(1) Where a member of the Tribunal is, or is to be, a member of a\nDivision of the Tribunal in any proceedings and the member has or\nacquires any pecuniary interest that could conflict with the proper\nperformance of his or her functions in relation to the proceedings:\n\n(a) the member shall disclose the interest to the President; and\n\nChapter 1  Preliminary",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-40-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-40-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a4f25d9e7a3a90b4ed26ce2a24cdeb3d8aab8a52c112b1abfee748e9312a8f8d",
      "skos:note": "Member must disclose pecuniary interest to President."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-40",
      "@type": "cof:Section",
      "cof:title": "40 Disclosure of interests by members of Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "(1) Where a member of the Tribunal is, or is to be, a member of a\nDivision of the Tribunal in any proceedings and the member has or\nacquires any pecuniary interest that could conflict with the proper\nperformance of his or her functions in relation to the proceedings:\n\n(a) the member shall disclose the interest to the President; and\n\nChapter 1  Preliminary"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-40-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-40"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
