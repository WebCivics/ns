        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zu-ss-2"
        }
      ],
      "cml:integrityHash": "43e464a7c80a40928d32dbd3d1f15e361a2ddd31a0d4b382aa70b7742a121d50"
    },
