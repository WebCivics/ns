    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44pg",
      "@type": "cml:Concept",
      "skos:prefLabel": "44PG Review of Commission’s initial decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44pg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.207",
      "values:originalText": "Application\n\n(1) A person whose interests are affected by a decision of the\nCommission under subsection 44PA(3) may apply in writing to the\nTribunal for review of the decision.\n\n(2) The person must apply for review within 21 days after the\nCommission publishes its decision.\nReview\n\n(3) The review by the Tribunal is a reconsideration of the matter based\non the information, reports and things referred to in\nsection 44ZZOAA.\nNote:\nThere are limits on the information to which the Tribunal may have\nregard (see section 44ZZOAA) and time limits that apply to the\nTribunal’s decision on the review (see section 44ZZOA).\n\nChapter 2  Access to services",
      "skos:definition": "Application\n\n(1) A person whose interests are affected by a decision of the\nCommission under subsection 44PA(3) may apply in writing to the\nTribunal for review of the decision.\n\n(2) The person must apply for review within 21 days after the\nCommission publishes its decision.\nReview\n\n(3) The review by the Tribunal is a reconsideration of the matter based\non the information, reports and things referred to in\nsection 44ZZOAA.\nNote:\nThere are limits on the information to which the Tribunal may have\nregard (see section 44ZZOAA) and time limits that apply to the\nTribunal’s decision on the review (see section 44ZZOA).\n\nChapter 2  Access to services",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44pg-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44pg-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44pg-ss-3"
        }
      ],
      "cml:integrityHash": "e7ad522ea327e5ba95534ef8355038ef7f7b86328c7cf9175886f60464c40d28"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44pg",
      "@type": "cof:Section",
      "cof:title": "44PG Review of Commission’s initial decision",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "Application\n\n(1) A person whose interests are affected by a decision of the\nCommission under subsection 44PA(3) may apply in writing to the\nTribunal for review of the decision.\n\n(2) The person must apply for review within 21 days after the\nCommission publishes its decision.\nReview\n\n(3) The review by the Tribunal is a reconsideration of the matter based\non the information, reports and things referred to in\nsection 44ZZOAA.\nNote:\nThere are limits on the information to which the Tribunal may have\nregard (see section 44ZZOAA) and time limits that apply to the\nTribunal’s decision on the review (see section 44ZZOA).\n\nChapter 2  Access to services"
    },
