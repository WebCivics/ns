      "cml:integrityHash": "99da8b3dd265c6e96fdf7aab20a30301fae47388742672a83db7d39ab9d15d32",
      "skos:note": "Notice must be given within a specified time period after subsection 52ZL(5) notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zm-ss-7",
      "@type": "cof:Section",
      "cof:title": "52ZM(7) Formation of arbitral panel",
      "values:kind": "subsection",
      "cof:pageNumber": 478,
      "values:originalText": "(7) For the purposes of subsection (6), the notice must be given no\nlater than the end of:\n\n(a) the period of 10 business days after the notice was given\nunder subsection 52ZL(5); or\n\n(b) if regulations made for the purposes of this paragraph specify\na different period—that period."
    },
