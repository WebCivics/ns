    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ze",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZE Right to representation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ze"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.222",
      "values:originalText": "In an arbitration hearing before the Commission under this Part, a\nparty may appear in person or be represented by someone else.",
      "skos:definition": "In an arbitration hearing before the Commission under this Part, a\nparty may appear in person or be represented by someone else.",
