      "cml:integrityHash": "77401b0238f2b32592297b54652a9f681dc3c53e28eceb12087291c9f893000a"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29a",
      "@type": "cof:Section",
