    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44lh-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "44LH(4) Designated Minister must publish his or her decision",
      "cml:realizedBy": {
