          "@id": "concept:competition-and-consumer-act-2010-sec-18-ss-5-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-18-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b18a37ddff5fe43f2509c0aa101255064bbbd1eb852b64a770737faade51d451",
      "skos:note": "Member presiding at Commission meeting may give directions on procedure."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-18-ss-5",
      "@type": "cof:Section",
      "cof:title": "18(5) Meetings of Commission",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(5) Subject to this Act and the regulations, the member presiding at a\nmeeting of the Commission may give directions regarding the\nprocedure to be followed at or in connexion with the meeting."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-18-ss-5-norm",
      "@type": "values:Obligation",
