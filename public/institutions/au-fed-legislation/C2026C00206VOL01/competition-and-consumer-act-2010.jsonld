      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Recurring application of presumption",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Alleged in any proceeding under this Act or other proceeding in respect of a matter arising under this Act.",
      "cml:conclusionText": "That the person was a consumer in relation to particular goods or services."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4b-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Information Spread",
      "cml:logicSummary": "Spread of presumption through proceedings",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Alleged in any proceeding under this Act or other proceeding in respect of a matter arising under this Act.",
      "cml:conclusionText": "That the person was a consumer in relation to those goods or services."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4b-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge Representation",
      "cml:logicSummary": "Semantic representation of consumer status",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
