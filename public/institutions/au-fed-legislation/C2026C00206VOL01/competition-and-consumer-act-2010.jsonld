      "skos:note": "Cannot register contracts related to access matters dealt with in an existing access undertaking."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zw-ss-2a",
      "@type": "cof:Section",
      "cof:title": "44ZW(2A) Registration of contract",
      "values:kind": "subsection",
      "cof:pageNumber": 236,
      "values:originalText": "(2A) The Commission must not register a contract if it deals with a\nmatter or matters relating to access to the service that are dealt with\nin an access undertaking that is in operation."
    },
