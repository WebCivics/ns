    {
      "@id": "concept:competition-and-consumer-act-2010-sec-35-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "35(5) Suspension and removal of members of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-35-ss-5"
