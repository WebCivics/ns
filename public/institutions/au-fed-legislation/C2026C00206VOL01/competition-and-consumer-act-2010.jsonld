    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zi-ss-1",
      "@type": "cof:Section",
      "cof:title": "52ZI(1) Obligation to notify Commission if agreement reached",
      "values:kind": "subsection",
      "cof:pageNumber": 474,
      "values:originalText": "(1) The regulations may set out rules relating to the conduct of a\nmediation under this Subdivision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zi-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
