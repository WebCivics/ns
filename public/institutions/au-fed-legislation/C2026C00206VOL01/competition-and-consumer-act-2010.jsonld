    {
      "@id": "concept:competition-and-consumer-act-2010-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Constitution of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.101",
      "values:originalText": "(1) The Trade Practices Tribunal that existed immediately before this\nsubsection commenced continues to exist as the Australian\nCompetition Tribunal.\n\n(2) The Tribunal so continued in existence shall consist of a President\nand such number of Deputy Presidents and other members as are\nappointed in accordance with this section.\n\n(3) A member of the Tribunal shall be appointed by the\nGovernor-General.",
      "skos:definition": "(1) The Trade Practices Tribunal that existed immediately before this\nsubsection commenced continues to exist as the Australian\nCompetition Tribunal.\n\n(2) The Tribunal so continued in existence shall consist of a President\nand such number of Deputy Presidents and other members as are\nappointed in accordance with this section.\n\n(3) A member of the Tribunal shall be appointed by the\nGovernor-General.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-30-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-30-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-30-ss-3"
        }
      ],
      "cml:integrityHash": "cfa0b216f9571d3c93b85f6c7f4639715928fde751426d3f51959aeac1800e35"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Constitution of Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 101,
      "values:originalText": "(1) The Trade Practices Tribunal that existed immediately before this\nsubsection commenced continues to exist as the Australian\nCompetition Tribunal.\n\n(2) The Tribunal so continued in existence shall consist of a President\nand such number of Deputy Presidents and other members as are\nappointed in accordance with this section.\n\n(3) A member of the Tribunal shall be appointed by the\nGovernor-General."
    },
