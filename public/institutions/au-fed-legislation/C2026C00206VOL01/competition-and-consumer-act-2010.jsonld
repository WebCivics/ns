      "dc:source": "competition-and-consumer-act-2010.pdf, p.184",
      "values:originalText": "(3) The responsible Minister for the State or Territory may specify in\nthe application proposed variations to the access regime.\nAssessment by Council",
      "skos:definition": "(3) The responsible Minister for the State or Territory may specify in\nthe application proposed variations to the access regime.\nAssessment by Council",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44na"
      },
      "cml:asserts": [
