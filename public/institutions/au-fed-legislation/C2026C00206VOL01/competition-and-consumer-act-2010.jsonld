    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44fa-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY DISREGARD",
      "cml:logicSummary": "Council may disregard information of the kind specified in the notice given after the specified period has ended.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Information of the kind specified in the notice that is given after the specified period has ended.",
      "cml:conclusionText": "Council may disregard this information."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44fa-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "WITHIN",
      "cml:logicSummary": "The specified period is an interval that must be considered by the Council.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A specified period has ended.",
      "cml:conclusionText": "This information was given within the specified period."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44fa-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RECURSIVE",
      "cml:logicSummary": "The Council's decision-making process involves considering information in a recursive manner.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Council considers information given in compliance with a notice under subsection (1) within the specified period.",
      "cml:conclusionText": "This is part of the Council's recursive decision-making process."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44fa-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "44FA(4) Council may request information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44fa-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.150",
      "values:originalText": "(4) Subsections 44GB(4) to (6) apply to information given in response\nto a notice under this section (whether given in compliance with\nthe notice or not) in a corresponding way to the way those\nsubsections apply to a submission made in response to a notice\nunder subsection 44GB(1).\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nDeclared services  Division 2\n\nSection 44G\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote:\nThis allows the Council to make the information publicly available,\nsubject to any confidentiality concerns.",
      "skos:definition": "(4) Subsections 44GB(4) to (6) apply to information given in response\nto a notice under this section (whether given in compliance with\nthe notice or not) in a corresponding way to the way those\nsubsections apply to a submission made in response to a notice\nunder subsection 44GB(1).\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nDeclared services  Division 2\n\nSection 44G\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote:\nThis allows the Council to make the information publicly available,\nsubject to any confidentiality concerns.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44fa"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44fa-ss-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44fa-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "032b608aac9aa945e592c0f19ceefc010cc7a2b0ad0aa5b5eddea494c030203e",
      "skos:note": "Council must provide information in response to a notice under this section in a corresponding way to the way those subsections apply to a submission made in response to a notice under subsection 44GB(1).",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44fa-ss-4",
      "@type": "cof:Section",
      "cof:title": "44FA(4) Council may request information",
      "values:kind": "subsection",
      "cof:pageNumber": 150,
      "values:originalText": "(4) Subsections 44GB(4) to (6) apply to information given in response\nto a notice under this section (whether given in compliance with\nthe notice or not) in a corresponding way to the way those\nsubsections apply to a submission made in response to a notice\nunder subsection 44GB(1).\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nDeclared services  Division 2\n\nSection 44G\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote:\nThis allows the Council to make the information publicly available,\nsubject to any confidentiality concerns."
    },
