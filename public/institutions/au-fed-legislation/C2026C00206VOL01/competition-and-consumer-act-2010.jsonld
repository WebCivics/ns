    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zp-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZP(7) Review by Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zp-ss-7"
