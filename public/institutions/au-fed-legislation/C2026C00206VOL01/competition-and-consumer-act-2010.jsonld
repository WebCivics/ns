      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.121",
      "values:originalText": "An AER member holds office on the terms and conditions (if any)\nin relation to matters not covered by this Act that are determined\nby the Governor-General.",
      "skos:definition": "An AER member holds office on the terms and conditions (if any)\nin relation to matters not covered by this Act that are determined\nby the Governor-General.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44aw-norm"
        }
      ],
      "cml:integrityHash": "3d088593a64fd5dab4bf1019a1f8e0a72c79dbb0d2b365ee38009238e9305ec9",
      "skos:note": "Terms and conditions for AER members"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44aw",
      "@type": "cof:Section",
      "cof:title": "44AW Other terms and conditions",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "An AER member holds office on the terms and conditions (if any)\nin relation to matters not covered by this Act that are determined\nby the Governor-General."
    },
