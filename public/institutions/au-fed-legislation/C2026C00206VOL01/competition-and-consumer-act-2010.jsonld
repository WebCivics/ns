      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.189",
      "values:originalText": "Council to make recommendation within the consideration period\n\n(1) The Council must make a recommendation on an application under\nsection 44M, 44NA or 44NBA, or on a consideration by the\n\nChapter 2  Access to services",
      "skos:definition": "Council to make recommendation within the consideration period\n\n(1) The Council must make a recommendation on an application under\nsection 44M, 44NA or 44NBA, or on a consideration by the\n\nChapter 2  Access to services",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44nc-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44nc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4e1933ddb4dad43ec07f60e13941abc9705b650bb8127703777b6006172b4feb",
      "skos:note": "Council must make recommendation within consideration period"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44nc",
      "@type": "cof:Section",
      "cof:title": "44NC Time limit for Council recommendations",
      "values:kind": "section",
      "cof:pageNumber": 189,
      "values:originalText": "Council to make recommendation within the consideration period\n\n(1) The Council must make a recommendation on an application under\nsection 44M, 44NA or 44NBA, or on a consideration by the\n\nChapter 2  Access to services"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44nc-norm",
      "@type": "values:Obligation",
