        }
      ],
      "cml:integrityHash": "6d4a6bc7ff0da3801bcaf2b39c7c93879cec98435ddca482000861c04392bc4e",
      "skos:note": "States and Territories can operate concurrently with the gas market provisions. Prohibits conduct that affects the activities, functions, relationships or business of a constitutional corporation. Regulations may incorporate or adopt provisions from other instruments."
    },
