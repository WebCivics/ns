        }
      ],
      "cml:integrityHash": "2269d6423382b392b075d7afdda6e873138f118e75e6b84c19aa2cb664e1030a",
      "skos:note": "Consider bargaining power imbalance between Australian news businesses and digital platform corporation."
    },
    {
