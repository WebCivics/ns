    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44nf-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "44NF(5) Publication—Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44nf-ss-5"
