    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ka-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "44KA(3) Tribunal may stay operation of declaration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ka-ss-3"
      },
      "cml:curationStatus": {
