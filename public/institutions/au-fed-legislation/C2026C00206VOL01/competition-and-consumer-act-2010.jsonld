    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44",
      "@type": "cml:Concept",
      "skos:prefLabel": "44 Staff of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.108",
      "values:originalText": "(1) There shall be a Registrar of the Tribunal and such Deputy\nRegistrars of the Tribunal as are appointed in accordance with this\nsection.\n\n(2) The Registrar and the Deputy Registrars shall be appointed by the\nMinister and shall have such duties and functions as are provided\nby this Act and the regulations and such other duties and functions\nas the President directs.\n\n(3) The Registrar and the Deputy Registrars, and the staff necessary to\nassist them, shall be persons engaged under the Public Service Act\n1999.",
      "skos:definition": "(1) There shall be a Registrar of the Tribunal and such Deputy\nRegistrars of the Tribunal as are appointed in accordance with this\nsection.\n\n(2) The Registrar and the Deputy Registrars shall be appointed by the\nMinister and shall have such duties and functions as are provided\nby this Act and the regulations and such other duties and functions\nas the President directs.\n\n(3) The Registrar and the Deputy Registrars, and the staff necessary to\nassist them, shall be persons engaged under the Public Service Act\n1999.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44-ss-3"
        }
      ],
      "cml:integrityHash": "2d1b276c0903bed64d462926a10111f77d8b62d1056117cd137ab4f6e88b4f01"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44",
      "@type": "cof:Section",
      "cof:title": "44 Staff of Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "(1) There shall be a Registrar of the Tribunal and such Deputy\nRegistrars of the Tribunal as are appointed in accordance with this\nsection.\n\n(2) The Registrar and the Deputy Registrars shall be appointed by the\nMinister and shall have such duties and functions as are provided\nby this Act and the regulations and such other duties and functions\nas the President directs.\n\n(3) The Registrar and the Deputy Registrars, and the staff necessary to\nassist them, shall be persons engaged under the Public Service Act\n1999."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44-ss-1",
