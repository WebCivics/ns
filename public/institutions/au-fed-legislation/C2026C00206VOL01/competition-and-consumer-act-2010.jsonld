      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires a quorum of 3 members",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "At least 3 AER members must be present",
      "cml:conclusionText": "The meeting is invalid if less than 3 members are present"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
