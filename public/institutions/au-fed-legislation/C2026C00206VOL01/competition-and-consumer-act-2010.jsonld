      "@id": "concept:competition-and-consumer-act-2010-sec-31a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "does not affect",
      "cml:logicSummary": "Obligation negation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Terms and conditions of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.102",
      "values:originalText": "Subject to this Part, a member of the Tribunal holds office for such\nperiod, not exceeding 7 years, as is specified in the instrument of\nhis or her appointment and on such terms and conditions as the\nGovernor-General determines, but is eligible for re-appointment.",
      "skos:definition": "Subject to this Part, a member of the Tribunal holds office for such\nperiod, not exceeding 7 years, as is specified in the instrument of\nhis or her appointment and on such terms and conditions as the\nGovernor-General determines, but is eligible for re-appointment.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-32-norm"
        }
      ],
      "cml:integrityHash": "1bb640517d0aec5e7fc90262757e10a381aed3423812eb639f3ef5dce48039c4",
      "skos:note": "Member of Tribunal holds office for a specified period and on terms and conditions determined by Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Terms and conditions of appointment",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "Subject to this Part, a member of the Tribunal holds office for such\nperiod, not exceeding 7 years, as is specified in the instrument of\nhis or her appointment and on such terms and conditions as the\nGovernor-General determines, but is eligible for re-appointment."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-32-norm",
