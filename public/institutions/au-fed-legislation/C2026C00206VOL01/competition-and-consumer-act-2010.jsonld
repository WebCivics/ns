        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zx-ss-9"
        }
      ],
      "cml:integrityHash": "dc3d82db91fe221a0db1cd45297b9666a4bb340bab2f1f883ac2938bbc048f94"
