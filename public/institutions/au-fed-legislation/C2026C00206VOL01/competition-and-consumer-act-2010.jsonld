        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Possession of a conflict of interest",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has any interest, pecuniary or otherwise",
      "cml:conclusionText": "The person has a conflict of interest"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between interests and arbitration",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has an interest that could conflict with the proper performance of their functions in relation to the arbitration",
      "cml:conclusionText": "The interest conflicts with the arbitration during its duration"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-6-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implication of a conflict of interest on arbitration",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has a conflict of interest in relation to the arbitration",
      "cml:conclusionText": "The person's functions cannot be properly performed in relation to the arbitration"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-6-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:logicSummary": "Spread of conflicts of interest",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has an interest that could conflict with the proper performance of their functions in relation to the arbitration",
      "cml:conclusionText": "The conflict of interest spreads to other areas of the person's functions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-6-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:logicSummary": "Recognition of conflicts of interest by ACMA",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA appoints a person with a conflict of interest",
      "cml:conclusionText": "ACMA recognizes the conflict of interest"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zo",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZO Costs of arbitral panel",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zo"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.481",
      "values:originalText": "(1) The bargaining parties must each pay half of the costs of each\nmember of the panel.\n\n(2) Each member of the panel is to determine that member’s costs,\nworked out as daily costs.\n\n(3) If regulations made for the purposes of this subsection specify rules\nrelating to those costs (including the amount of those costs), the\nbargaining parties must comply with those rules.",
      "skos:definition": "(1) The bargaining parties must each pay half of the costs of each\nmember of the panel.\n\n(2) Each member of the panel is to determine that member’s costs,\nworked out as daily costs.\n\n(3) If regulations made for the purposes of this subsection specify rules\nrelating to those costs (including the amount of those costs), the\nbargaining parties must comply with those rules.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zo-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zo-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zo-ss-3"
        }
      ],
      "cml:integrityHash": "7874ba581d27eafc09faaa093814d0c697a7ac968ec50bb0d672d16e72c3b19a"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zo",
      "@type": "cof:Section",
      "cof:title": "52ZO Costs of arbitral panel",
      "values:kind": "section",
      "cof:pageNumber": 481,
      "values:originalText": "(1) The bargaining parties must each pay half of the costs of each\nmember of the panel.\n\n(2) Each member of the panel is to determine that member’s costs,\nworked out as daily costs.\n\n(3) If regulations made for the purposes of this subsection specify rules\nrelating to those costs (including the amount of those costs), the\nbargaining parties must comply with those rules."
    },
