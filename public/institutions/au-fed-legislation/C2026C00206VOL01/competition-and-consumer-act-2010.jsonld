          "@id": "concept:competition-and-consumer-act-2010-sec-52zm-ss-6-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "1818327d9d9b33b385835d8d2be887042fa24036b582ee84989a478e2b53dd06",
      "skos:note": "Notice of appointment of arbitral panel members must be provided to Commission and ACMA.",
      "dc:description": "Yes"
    },
    {
