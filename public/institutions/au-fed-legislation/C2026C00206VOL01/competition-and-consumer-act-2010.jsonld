    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zv-ss-4",
      "@type": "cof:Section",
      "cof:title": "52ZV(4) Information request by bargaining party—miscellaneous",
      "values:kind": "subsection",
      "cof:pageNumber": 484,
      "values:originalText": "(4) Subsection (5) applies if:\n\n(a) there is a reference to a number of business days in a\nprovision in section 52ZT or 52ZU; and\n\n(b) regulations made for the purposes of this paragraph specify a\ndifferent number of business days in respect of that\nprovision."
    },
