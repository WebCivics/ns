      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the content is reproduced on the service, or is otherwise placed on the service, and the user interacts with the content;",
      "cml:conclusionText": "User interaction occurs during content placement."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-1-logic-ltl-5",
