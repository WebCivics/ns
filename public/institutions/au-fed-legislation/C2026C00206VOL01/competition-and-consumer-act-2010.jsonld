      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate",
      "cml:logicSummary": "Requires ACMA to give notice to the person before removing them from the panel",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has reason to consider a conflict of interest",
      "cml:conclusionText": "The person should receive notice before being removed from the panel"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prevents a person with conflict of interest from serving on the panel",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has reason to consider a conflict of interest",
      "cml:conclusionText": "The person should not be on the panel"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate",
      "cml:logicSummary": "Requires ACMA to take action before removing a panel member with conflict of interest",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has reason to consider a conflict of interest",
      "cml:conclusionText": "The person should be removed from the panel after notice is given"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prevents ACMA from removing a panel member with conflict of interest without giving notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has reason to consider a conflict of interest",
      "cml:conclusionText": "The person should not be removed from the panel without notice"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZN(4) Disclosure of conflicts of interest where ACMA appoints",
