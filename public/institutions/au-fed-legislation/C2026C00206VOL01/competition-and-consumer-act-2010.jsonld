      ],
      "cml:integrityHash": "66a81fb120815fb31ac54869e915c40aa12263838103411c78e56646b00d3ede",
      "skos:note": "Council must assess effectiveness of access regime."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44na-ss-4",
      "@type": "cof:Section",
      "cof:title": "44NA(4) Recommendation by Council",
      "values:kind": "subsection",
      "cof:pageNumber": 184,
      "values:originalText": "(4) The Council must assess whether the access regime (including any\nproposed variations) is an effective access regime. It must do this\nin accordance with subsection 44M(4)."
    },
