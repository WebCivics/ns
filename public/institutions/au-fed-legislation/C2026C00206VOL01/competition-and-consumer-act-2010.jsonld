        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ld-ss-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9d391a52f393a145ae11283ae1d4c0164ae5232bb24e8d7db1c8550067f61b99",
      "skos:note": "Specify when Council must make a recommendation and explain inability to do so within consideration period.",
      "dc:description": "Notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ld-ss-8",
      "@type": "cof:Section",
      "cof:title": "44LD(8) Time limit for Council recommendations",
      "values:kind": "subsection",
      "cof:pageNumber": 168,
      "values:originalText": "(8) The notice must:\n\n(a) specify when the Council must now make a recommendation\non the application; and\n\n(b) include a statement explaining why the Council has been\nunable to make a decision on the recommendation within the\nconsideration period."
    },
