      "skos:note": "Council must give a copy of the notice to applicant and provider.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ld-ss-9",
      "@type": "cof:Section",
      "cof:title": "44LD(9) Time limit for Council recommendations",
