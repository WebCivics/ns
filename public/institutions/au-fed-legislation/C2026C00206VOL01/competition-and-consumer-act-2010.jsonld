      "cml:premiseText": "(1) This section applies if:\n\n(a) a notification has been made for the purposes of\nsubsection 52ZE(1) to a responsible digital platform\ncorporation for a designated digital platform service;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zl-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZL(2) Notification of arbitration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zl-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
