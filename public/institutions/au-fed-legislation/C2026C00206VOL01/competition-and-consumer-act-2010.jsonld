      "cml:premiseText": "Chairperson absent",
      "cml:conclusionText": "Nominate Deputy Chairperson"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-18-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "18(5) Meetings of Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-18-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.84",
      "values:originalText": "(5) Subject to this Act and the regulations, the member presiding at a\nmeeting of the Commission may give directions regarding the\nprocedure to be followed at or in connexion with the meeting.",
      "skos:definition": "(5) Subject to this Act and the regulations, the member presiding at a\nmeeting of the Commission may give directions regarding the\nprocedure to be followed at or in connexion with the meeting.",
      "values:partOf": {
