    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zm-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZM(6) Formation of arbitral panel",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zm-ss-6"
      },
      "cml:curationStatus": {
