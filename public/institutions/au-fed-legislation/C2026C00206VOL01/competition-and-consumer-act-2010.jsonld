    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53zg",
      "@type": "cml:Concept",
      "skos:prefLabel": "53ZG Constitution—gas market instruments must not give",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.532",
      "values:originalText": "preference to States etc.\n\n(1) A gas market instrument must not give preference to one State or\nany part thereof within the meaning of section 99 of the\nConstitution.\n\n(2) A power or function conferred by a gas market instrument must not\nbe exercised or performed in such a way as to give preference to\none State or any part thereof within the meaning of section 99 of\nthe Constitution.",
      "skos:definition": "preference to States etc.\n\n(1) A gas market instrument must not give preference to one State or\nany part thereof within the meaning of section 99 of the\nConstitution.\n\n(2) A power or function conferred by a gas market instrument must not\nbe exercised or performed in such a way as to give preference to\none State or any part thereof within the meaning of section 99 of\nthe Constitution.",
      "cml:hasPart": [
