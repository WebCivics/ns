      "cml:operator": "excludedBy",
      "cml:logicSummary": "Exclusion of days from the expected period",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Column 1, Column 2, and Column 3 are specified",
      "cml:conclusionText": "Disregard any day in a period starting on the day referred to in column 2 and ending on the day referred to in column 3"
    },
