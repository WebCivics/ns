    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52o",
      "@type": "cml:Concept",
      "skos:prefLabel": "52O Australian audience test",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52o"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.459",
      "values:originalText": "(1) The requirement in this subsection is met in relation to a news\nbusiness if every news source covered by subsection (2) operates\npredominantly in Australia for the dominant purpose of serving\nAustralian audiences.\n\n(2) This subsection covers a news source if it comprises, whether by\nitself or together with other news sources, the news business.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code",
      "skos:definition": "(1) The requirement in this subsection is met in relation to a news\nbusiness if every news source covered by subsection (2) operates\npredominantly in Australia for the dominant purpose of serving\nAustralian audiences.\n\n(2) This subsection covers a news source if it comprises, whether by\nitself or together with other news sources, the news business.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code",
      "cml:hasPart": [
