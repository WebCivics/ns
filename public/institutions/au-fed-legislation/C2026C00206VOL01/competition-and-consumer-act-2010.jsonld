      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits a person from being on the panel with conflict of interest",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has reason to consider a conflict of interest",
      "cml:conclusionText": "The person should no longer be on the panel"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-3-logic-deontic-2",
