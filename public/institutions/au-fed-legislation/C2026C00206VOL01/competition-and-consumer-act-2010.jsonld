      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52j-ss-2",
      "@type": "cof:Section",
      "cof:title": "52J(2) Obligation on registered news business corporation to notify",
      "values:kind": "subsection",
      "cof:pageNumber": 456,
      "values:originalText": "(2) The notification must be in writing."
    },
