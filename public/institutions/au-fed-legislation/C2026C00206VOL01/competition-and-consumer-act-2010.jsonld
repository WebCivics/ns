      "skos:note": "The Tribunal may consider previous proceedings records."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-43-ss-5",
      "@type": "cof:Section",
      "cof:title": "43(5) Member of Tribunal ceasing to be available",
      "values:kind": "subsection",
      "cof:pageNumber": 107,
      "values:originalText": "(5) The Tribunal as constituted in accordance with any of the\nprovisions of this section for the purposes of any proceedings may\nhave regard to any record of the proceedings before the Tribunal as\npreviously constituted."
    },
