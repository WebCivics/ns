      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.109",
      "values:originalText": "It is the intention of the Parliament that the operation of this Part\nshould, as far as possible, include operation in relation to the\nfollowing:\n\n(a) things situated in or outside Australia;\n\n(b) acts, transactions and matters done, entered into or occurring\nin or outside Australia;\n\nChapter 1  Preliminary\nPart IIIAA  The Australian Energy Regulator (AER)",
      "skos:definition": "It is the intention of the Parliament that the operation of this Part\nshould, as far as possible, include operation in relation to the\nfollowing:\n\n(a) things situated in or outside Australia;\n\n(b) acts, transactions and matters done, entered into or occurring\nin or outside Australia;\n\nChapter 1  Preliminary\nPart IIIAA  The Australian Energy Regulator (AER)",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ad-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ad-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bbe404b3f13b8c6f887d478bab9efc74ca61b344a3189367092d984e9ac5df60",
      "skos:note": "Include operation in relation to things and acts outside Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ad",
      "@type": "cof:Section",
      "cof:title": "44AD Extra-territorial operation",
      "values:kind": "section",
      "cof:pageNumber": 109,
      "values:originalText": "It is the intention of the Parliament that the operation of this Part\nshould, as far as possible, include operation in relation to the\nfollowing:\n\n(a) things situated in or outside Australia;\n\n(b) acts, transactions and matters done, entered into or occurring\nin or outside Australia;\n\nChapter 1  Preliminary\nPart IIIAA  The Australian Energy Regulator (AER)"
    },
