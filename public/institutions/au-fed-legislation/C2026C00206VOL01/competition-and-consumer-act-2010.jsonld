    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zh",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZH Power to take evidence on oath or affirmation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.223",
      "values:originalText": "(1) The Commission may take evidence on oath or affirmation and for\nthat purpose a member of the Commission may administer an oath\nor affirmation.\n\nChapter 2  Access to services",
      "skos:definition": "(1) The Commission may take evidence on oath or affirmation and for\nthat purpose a member of the Commission may administer an oath\nor affirmation.\n\nChapter 2  Access to services",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zh-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fa391efc8fd94e41c7c3d5ba17546d2e41c511e16693b06b1a3dffcdad5482ef",
      "skos:note": "Commission may take evidence on oath or affirmation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zh",
      "@type": "cof:Section",
      "cof:title": "44ZH Power to take evidence on oath or affirmation",
      "values:kind": "section",
      "cof:pageNumber": 223,
      "values:originalText": "(1) The Commission may take evidence on oath or affirmation and for\nthat purpose a member of the Commission may administer an oath\nor affirmation.\n\nChapter 2  Access to services"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zh-norm",
