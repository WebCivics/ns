    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ak-ss-2",
      "@type": "cof:Section",
      "cof:title": "45AK(2) Giving effect to a cartel provision",
      "values:kind": "subsection",
      "cof:pageNumber": 294,
      "values:originalText": "(2) Paragraph (1)(a) applies to contracts or arrangements made, or\nunderstandings arrived at, before, at or after the commencement of\nthis section.\n\nRestrictive trade practices  Chapter 3\nRestrictive trade practices  Part IV\nCartel conduct  Division 1\n\nSection 45AL\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nSubdivision D—Exceptions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ak-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
