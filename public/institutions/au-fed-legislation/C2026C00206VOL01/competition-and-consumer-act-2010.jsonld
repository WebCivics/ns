    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zj",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZJ Bargaining over other issues",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.476",
      "values:originalText": "To avoid doubt, nothing in this Division limits the bargaining\nparties to negotiating only over the core bargaining issues.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nArbitration about remuneration issue  Division 7\n\nSection 52ZK\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "To avoid doubt, nothing in this Division limits the bargaining\nparties to negotiating only over the core bargaining issues.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nArbitration about remuneration issue  Division 7\n\nSection 52ZK\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zj-norm"
        }
      ],
      "cml:integrityHash": "2679bf1b27a485dbc8dce2648bbb9ebe62bcfba79b1ac9c597c765efe3adfc02",
      "skos:note": "Nothing in this Division limits the bargaining parties to negotiating only over the core bargaining issues."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zj",
      "@type": "cof:Section",
      "cof:title": "52ZJ Bargaining over other issues",
      "values:kind": "section",
      "cof:pageNumber": 476,
      "values:originalText": "To avoid doubt, nothing in this Division limits the bargaining\nparties to negotiating only over the core bargaining issues.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nArbitration about remuneration issue  Division 7\n\nSection 52ZK\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
