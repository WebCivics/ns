    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53m-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "53M(7) Minister may make gas market emergency price orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53m-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.514",
      "values:originalText": "(7) A gas market emergency price order is repealed by force of this\nsubsection at the time specified by subsection (8), unless the gas\nmarket emergency price order is repealed earlier.",
      "skos:definition": "(7) A gas market emergency price order is repealed by force of this\nsubsection at the time specified by subsection (8), unless the gas\nmarket emergency price order is repealed earlier.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-53m"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53m-ss-7-norm"
        }
      ],
      "cml:integrityHash": "aebdab2e05800b754c896b179507baf0afb8eb73f6e1b5940e37bd0ebd587fdc",
      "skos:note": "Gas market emergency price order is repealed at a specified time unless earlier repealed."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53m-ss-7",
      "@type": "cof:Section",
      "cof:title": "53M(7) Minister may make gas market emergency price orders",
      "values:kind": "subsection",
      "cof:pageNumber": 514,
      "values:originalText": "(7) A gas market emergency price order is repealed by force of this\nsubsection at the time specified by subsection (8), unless the gas\nmarket emergency price order is repealed earlier."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53m-ss-7-norm",
