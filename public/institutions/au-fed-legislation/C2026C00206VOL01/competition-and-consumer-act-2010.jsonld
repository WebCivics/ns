      },
      "cml:premiseText": "(7) A decision made by the Tribunal is to be taken to be a decision of the Commonwealth Minister for all purposes of this Part (except this section).",
      "cml:conclusionText": "The decision is binding on the Commonwealth Minister."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-7-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
