      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4k",
      "@type": "cml:Concept",
      "skos:prefLabel": "4K Loss or damage to include injury",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.63",
      "values:originalText": "In this Act:\n\n(a) a reference to loss or damage, other than a reference to the\namount of any loss or damage, includes a reference to injury;\nand\n\n(b) a reference to the amount of any loss or damage includes a\nreference to damages in respect of an injury.",
      "skos:definition": "In this Act:\n\n(a) a reference to loss or damage, other than a reference to the\namount of any loss or damage, includes a reference to injury;\nand\n\n(b) a reference to the amount of any loss or damage includes a\nreference to damages in respect of an injury.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4k-norm"
        }
      ],
      "cml:integrityHash": "bda52cdbf81c7e60dad590ab45367ad7bb7b18ae16ef44aa2bf102bae7f7d218",
      "skos:note": "Reference to loss or damage includes injury."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4k",
      "@type": "cof:Section",
      "cof:title": "4K Loss or damage to include injury",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "In this Act:\n\n(a) a reference to loss or damage, other than a reference to the\namount of any loss or damage, includes a reference to injury;\nand\n\n(b) a reference to the amount of any loss or damage includes a\nreference to damages in respect of an injury."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4k-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-4k"
      },
