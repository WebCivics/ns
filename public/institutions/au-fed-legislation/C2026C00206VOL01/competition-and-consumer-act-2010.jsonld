      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Council must tell the provider of the service that it has received an application.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "44F(3) Person may request recommendation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44f-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.148",
      "values:originalText": "(3) If the applicant is a person other than the designated Minister, the\nCouncil may recommend that the service not be declared if the\nCouncil thinks that the application was not made in good faith.\nThis subsection does not limit the grounds on which the Council\nmay decide to recommend that the service not be declared.",
      "skos:definition": "(3) If the applicant is a person other than the designated Minister, the\nCouncil may recommend that the service not be declared if the\nCouncil thinks that the application was not made in good faith.\nThis subsection does not limit the grounds on which the Council\nmay decide to recommend that the service not be declared.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44f"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c8dfd7c5a4b5f8795d3e3f0b20ee795a96941c7573010069f814efff0403b0db",
      "skos:note": "Service not declared if application made in bad faith"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44f-ss-3",
      "@type": "cof:Section",
      "cof:title": "44F(3) Person may request recommendation",
      "values:kind": "subsection",
      "cof:pageNumber": 148,
      "values:originalText": "(3) If the applicant is a person other than the designated Minister, the\nCouncil may recommend that the service not be declared if the\nCouncil thinks that the application was not made in good faith.\nThis subsection does not limit the grounds on which the Council\nmay decide to recommend that the service not be declared."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-3-norm",
