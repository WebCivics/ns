    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44na-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must consider information given within specified period.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Given a notice under subsection (1) within the specified period, the Council must have regard to any information.",
      "cml:conclusionText": "The Council may disregard any information of the kind specified in the notice that is given after the specified period has ended."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44na-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "May disregard later information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Given a notice under subsection (1) within the specified period, the Council may disregard any information of the kind specified in the notice that is given after the specified period has ended."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44na-ss-3-logic-deontic-3",
