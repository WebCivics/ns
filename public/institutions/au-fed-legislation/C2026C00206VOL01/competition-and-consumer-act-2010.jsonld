      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53n",
      "@type": "cml:Concept",
      "skos:prefLabel": "53N Scope of gas market instruments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.515",
      "values:originalText": "Gas commodities\n\n(1) A gas market instrument may limit the application of:\n\n(a) the instrument; or\n\n(b) a specified provision of the instrument; or\n\n(c) a specified rule included in the instrument;\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBB  Gas market",
      "skos:definition": "Gas commodities\n\n(1) A gas market instrument may limit the application of:\n\n(a) the instrument; or\n\n(b) a specified provision of the instrument; or\n\n(c) a specified rule included in the instrument;\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBB  Gas market",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53n-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3e7b1a5001efd9149036df82a7e6a2903d7ed13f6603158168ac55e06acea3bd",
      "skos:note": "Limits the application of a gas market instrument or its provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53n",
      "@type": "cof:Section",
      "cof:title": "53N Scope of gas market instruments",
      "values:kind": "section",
      "cof:pageNumber": 515,
      "values:originalText": "Gas commodities\n\n(1) A gas market instrument may limit the application of:\n\n(a) the instrument; or\n\n(b) a specified provision of the instrument; or\n\n(c) a specified rule included in the instrument;\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBB  Gas market"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53n-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
