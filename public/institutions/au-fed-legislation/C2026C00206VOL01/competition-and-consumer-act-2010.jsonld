    {
      "@id": "concept:competition-and-consumer-act-2010-sec-2ba-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2BA(2) Application of Parts IV and IVA to local government bodies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-2ba-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.30",
      "values:originalText": "(2) In this section:\nlocal government body means a body established by or under a law\nof a State or Territory for the purposes of local government, other\nthan a body established solely or primarily for the purposes of\nproviding a particular service, such as the supply of electricity or\nwater.",
      "skos:definition": "(2) In this section:\nlocal government body means a body established by or under a law\nof a State or Territory for the purposes of local government, other\nthan a body established solely or primarily for the purposes of\nproviding a particular service, such as the supply of electricity or\nwater.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-2ba"
      },
      "cml:asserts": [
