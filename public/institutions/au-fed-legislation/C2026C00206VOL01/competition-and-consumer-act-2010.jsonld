        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "7ebd36dd91779d36deb1dbacd60460de25d8c84e7ee9940cf1c91a12b4a180ed",
      "skos:note": "ACMA must appoint only persons listed on the register of bargaining code arbitrators."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zn-ss-5",
      "@type": "cof:Section",
      "cof:title": "52ZN(5) Disclosure of conflicts of interest where ACMA appoints",
      "values:kind": "subsection",
      "cof:pageNumber": 480,
      "values:originalText": "(5) For the purposes of paragraph (4)(b), the ACMA may only make\nan appointment of a person who is listed on the register of\nbargaining code arbitrators."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5"
      },
      "values:deonticStatus": {
