      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4h-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "In this Act: ... (b) a reference to making or entering into a contract, in relation to such a lease or licence...",
      "cml:conclusionText": "the act of making or entering into a contract occurs after the lease or licence is granted"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4h-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Recurring trace",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "In this Act: ... (a) a reference to a contract shall be construed as including a reference to a lease of, or a licence in respect of, land or a building...",
      "cml:conclusionText": "the act of referencing a contract occurs before the lease or licence is granted"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4h-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "a reference to making or entering into a contract, in relation to such a lease or licence, shall be read as a reference to granting or taking the lease or licence",
      "cml:conclusionText": "there is an obligation to grant or take the lease or licence"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4j",
      "@type": "cml:Concept",
      "skos:prefLabel": "4J Joint ventures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.62",
      "values:originalText": "In this Act:\n\n(a) a reference to a joint venture is a reference to an activity in\ntrade or commerce:\n\n(i) carried on jointly by two or more persons, whether or\nnot in partnership; or\n\nPreliminary  Chapter 1\nPreliminary  Part I\n\nSection 4K\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(ii) carried on by a body corporate formed by two or more\npersons for the purpose of enabling those persons to\ncarry on that activity jointly by means of their joint\ncontrol, or by means of their ownership of shares in the\ncapital, of that body corporate; and\n\n(b) a reference to a contract or arrangement made or\nunderstanding arrived at, or to a proposed contract or\narrangement to be made or proposed understanding to be\narrived at, for the purposes of a joint venture shall, in relation\nto a joint venture by way of an activity carried on by a body\ncorporate as mentioned in subparagraph (a)(ii), be read as\nincluding a reference to the memorandum and articles of\nassociation, rules or other document that constitute or\nconstitutes, or are or is to constitute, that body corporate.",
      "skos:definition": "In this Act:\n\n(a) a reference to a joint venture is a reference to an activity in\ntrade or commerce:\n\n(i) carried on jointly by two or more persons, whether or\nnot in partnership; or\n\nPreliminary  Chapter 1\nPreliminary  Part I\n\nSection 4K\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(ii) carried on by a body corporate formed by two or more\npersons for the purpose of enabling those persons to\ncarry on that activity jointly by means of their joint\ncontrol, or by means of their ownership of shares in the\ncapital, of that body corporate; and\n\n(b) a reference to a contract or arrangement made or\nunderstanding arrived at, or to a proposed contract or\narrangement to be made or proposed understanding to be\narrived at, for the purposes of a joint venture shall, in relation\nto a joint venture by way of an activity carried on by a body\ncorporate as mentioned in subparagraph (a)(ii), be read as\nincluding a reference to the memorandum and articles of\nassociation, rules or other document that constitute or\nconstitutes, or are or is to constitute, that body corporate.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4j-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4j-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4j-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "ada8bfe74d3b9aa486b24d2540a64878811545e2e2ebec31608ce77182267b29",
      "skos:note": "Definition of joint venture"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4j",
      "@type": "cof:Section",
      "cof:title": "4J Joint ventures",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "In this Act:\n\n(a) a reference to a joint venture is a reference to an activity in\ntrade or commerce:\n\n(i) carried on jointly by two or more persons, whether or\nnot in partnership; or\n\nPreliminary  Chapter 1\nPreliminary  Part I\n\nSection 4K\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(ii) carried on by a body corporate formed by two or more\npersons for the purpose of enabling those persons to\ncarry on that activity jointly by means of their joint\ncontrol, or by means of their ownership of shares in the\ncapital, of that body corporate; and\n\n(b) a reference to a contract or arrangement made or\nunderstanding arrived at, or to a proposed contract or\narrangement to be made or proposed understanding to be\narrived at, for the purposes of a joint venture shall, in relation\nto a joint venture by way of an activity carried on by a body\ncorporate as mentioned in subparagraph (a)(ii), be read as\nincluding a reference to the memorandum and articles of\nassociation, rules or other document that constitute or\nconstitutes, or are or is to constitute, that body corporate."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4j-norm",
      "@type": "values:Obligation",
      "cml:modality": {
