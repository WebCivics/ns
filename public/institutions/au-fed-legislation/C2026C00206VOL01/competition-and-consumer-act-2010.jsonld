        }
      ],
      "cml:integrityHash": "0258ca53f35a39648abfd2d3a6e90653d82e0a973b0754da802e79e948beaf58",
      "skos:note": "Chairperson must nominate a member of the Commission to preside at an arbitration."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44za-ss-2",
      "@type": "cof:Section",
      "cof:title": "44ZA(2) Member of the Commission presiding at an arbitration",
      "values:kind": "subsection",
      "cof:pageNumber": 220,
      "values:originalText": "(2) If the Chairperson is not a member of the Commission as\nconstituted under section 44Z in relation to a particular arbitration,\nthe Chairperson must nominate a member of the Commission to\npreside at the arbitration.\n\nAccess to services  Chapter 2\nAccess to services  Part IIIA\nAccess to declared services  Division 3\n\nSection 44ZB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44za-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44za-ss-2"
      },
