    {
      "@id": "concept:competition-and-consumer-act-2010-sec-39-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "39(2) President may give directions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-39-ss-2"
