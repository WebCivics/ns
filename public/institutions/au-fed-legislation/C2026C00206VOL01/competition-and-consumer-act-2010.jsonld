      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commission publishes report on time",
      "cml:conclusionText": "Commission makes final determination"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44y",
      "@type": "cml:Concept",
      "skos:prefLabel": "44Y Commission may terminate arbitration in certain cases",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44y"
      },
      "cml:curationStatus": {
