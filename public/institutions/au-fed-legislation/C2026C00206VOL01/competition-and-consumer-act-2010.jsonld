    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "44O(5A) Review of Ministerial decision on effectiveness of access regime",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44o-ss-5a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.196",
      "values:originalText": "(5A) Without limiting subsection (5), the member may, by written\nnotice, require the Council to give information, and to make\nreports, of a kind specified in the notice, within the period\nspecified in the notice, for the purposes of the review.",
      "skos:definition": "(5A) Without limiting subsection (5), the member may, by written\nnotice, require the Council to give information, and to make\nreports, of a kind specified in the notice, within the period\nspecified in the notice, for the purposes of the review.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44o"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-5a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-5a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "28950652da6636e8b824639afc09074c2921344b2dbd148a7c940f3a70238b3b",
      "skos:note": "Member may require Council to provide information and reports."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44o-ss-5a",
      "@type": "cof:Section",
      "cof:title": "44O(5A) Review of Ministerial decision on effectiveness of access regime",
      "values:kind": "subsection",
      "cof:pageNumber": 196,
      "values:originalText": "(5A) Without limiting subsection (5), the member may, by written\nnotice, require the Council to give information, and to make\nreports, of a kind specified in the notice, within the period\nspecified in the notice, for the purposes of the review."
    },
