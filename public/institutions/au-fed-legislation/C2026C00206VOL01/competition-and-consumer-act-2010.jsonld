      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Remuneration and allowances of members of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.102",
      "values:originalText": "(4) A member of the Tribunal other than a presidential member shall\nbe paid such remuneration as is determined by the Remuneration\nTribunal.\n\n(5) A member of the Tribunal other than a presidential member shall\nbe paid such allowances as are prescribed.\n\n(6) Subsections (4) and (5) have effect subject to the Remuneration\nTribunal Act 1973.",
      "skos:definition": "(4) A member of the Tribunal other than a presidential member shall\nbe paid such remuneration as is determined by the Remuneration\nTribunal.\n\n(5) A member of the Tribunal other than a presidential member shall\nbe paid such allowances as are prescribed.\n\n(6) Subsections (4) and (5) have effect subject to the Remuneration\nTribunal Act 1973.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-33-ss-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-33-ss-5"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-33-ss-6"
        }
      ],
      "cml:integrityHash": "aeaaed272bf4bfbd6dd76be30b664282bd28c7d967ef5e47f23853adfd60d4c6"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Remuneration and allowances of members of Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "(4) A member of the Tribunal other than a presidential member shall\nbe paid such remuneration as is determined by the Remuneration\nTribunal.\n\n(5) A member of the Tribunal other than a presidential member shall\nbe paid such allowances as are prescribed.\n\n(6) Subsections (4) and (5) have effect subject to the Remuneration\nTribunal Act 1973."
    },
