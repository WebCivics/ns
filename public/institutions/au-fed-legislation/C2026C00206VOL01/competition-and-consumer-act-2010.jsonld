    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zy-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZY(1) Final offer arbitration—termination of arbitration if no final",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zy-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
