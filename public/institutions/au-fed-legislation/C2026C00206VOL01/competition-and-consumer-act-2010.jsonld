        }
      ],
      "cml:integrityHash": "62a04a5f33604557c524402f23cc7563afb4d0eed36e2c33e61cefcad42c61e4",
      "skos:note": "Restrictive trade practices"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45-ss-3",
