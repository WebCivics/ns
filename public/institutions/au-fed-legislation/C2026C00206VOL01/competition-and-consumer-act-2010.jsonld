        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Alleged in any proceeding under this Act or other proceeding in respect of a matter arising under this Act.",
      "cml:conclusionText": "That the person was a consumer in relation to those goods or services."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4b-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal scope of presumption",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Alleged in any proceeding under this Act or other proceeding in respect of a matter arising under this Act.",
      "cml:conclusionText": "Unless the contrary is established, that the person was a consumer in relation to those goods or services."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4b-ss-2-logic-ltl-3",
