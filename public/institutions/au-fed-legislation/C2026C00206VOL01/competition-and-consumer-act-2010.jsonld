    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZK Intimidation etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.225",
      "values:originalText": "A person must not:\n\n(a) threaten, intimidate or coerce another person; or\n\n(b) cause or procure damage, loss or disadvantage to another\nperson;\nbecause that other person:\n\n(c) proposes to produce, or has produced, documents to the\nCommission; or\n\n(d) proposes to appear or has appeared as a witness before the\nCommission.\nPenalty: Imprisonment for 12 months.",
      "skos:definition": "A person must not:\n\n(a) threaten, intimidate or coerce another person; or\n\n(b) cause or procure damage, loss or disadvantage to another\nperson;\nbecause that other person:\n\n(c) proposes to produce, or has produced, documents to the\nCommission; or\n\n(d) proposes to appear or has appeared as a witness before the\nCommission.\nPenalty: Imprisonment for 12 months.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zk-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-argumentation-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-diffusion-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "7fd09846d55f87183846929bbc60d7d3467941a638180eb17d84cc5ea2e5ead7",
      "skos:note": "Threatening or coercing someone due to producing documents before the Commission is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zk",
      "@type": "cof:Section",
      "cof:title": "44ZK Intimidation etc.",
      "values:kind": "section",
      "cof:pageNumber": 225,
      "values:originalText": "A person must not:\n\n(a) threaten, intimidate or coerce another person; or\n\n(b) cause or procure damage, loss or disadvantage to another\nperson;\nbecause that other person:\n\n(c) proposes to produce, or has produced, documents to the\nCommission; or\n\n(d) proposes to appear or has appeared as a witness before the\nCommission.\nPenalty: Imprisonment for 12 months."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44zk"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits threatening or coercing someone",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Threatening or coercing is generally considered wrong",
      "cml:conclusionText": "This provision prohibits threatening or coercing"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Prohibition applies when producing documents before the Commission",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Producing documents before the Commission is a relevant action",
      "cml:conclusionText": "This provision applies to actions of producing documents before the Commission"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Threatening or coercing implies a violation of this provision",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Threatening or coercing is generally considered wrong",
      "cml:conclusionText": "This provision is violated when threatening or coercing"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "None",
      "cml:logicSummary": "No diffusion logic applies to this provision",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This provision does not affect the behavior of others",
      "cml:conclusionText": "There is no diffusion logic for this provision"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zk-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "None",
      "cml:logicSummary": "No cognitive AI logic applies to this provision",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
