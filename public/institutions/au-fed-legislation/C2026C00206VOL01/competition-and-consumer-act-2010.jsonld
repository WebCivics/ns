    {
      "@id": "concept:competition-and-consumer-act-2010-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.79",
      "values:originalText": "(1) A member of the Commission shall be paid such remuneration as\nis determined by the Remuneration Tribunal, but, until that\nremuneration is so determined, he or she shall be paid such\nremuneration as is prescribed.\n\n(2) Subject to the Remuneration Tribunal Act 1973, a member of the\nCommission shall be paid such allowances as are prescribed.\n\n(3) In this section, member of the Commission includes an associate\nmember of the Commission.\n\nChapter 1  Preliminary",
      "skos:definition": "(1) A member of the Commission shall be paid such remuneration as\nis determined by the Remuneration Tribunal, but, until that\nremuneration is so determined, he or she shall be paid such\nremuneration as is prescribed.\n\n(2) Subject to the Remuneration Tribunal Act 1973, a member of the\nCommission shall be paid such allowances as are prescribed.\n\n(3) In this section, member of the Commission includes an associate\nmember of the Commission.\n\nChapter 1  Preliminary",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-9-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-9-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-9-ss-3"
        }
      ],
      "cml:integrityHash": "e501bdf955da0e3293828096648ade79aab7d6def61e09c07be201c8a07afb8c"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Remuneration",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "(1) A member of the Commission shall be paid such remuneration as\nis determined by the Remuneration Tribunal, but, until that\nremuneration is so determined, he or she shall be paid such\nremuneration as is prescribed.\n\n(2) Subject to the Remuneration Tribunal Act 1973, a member of the\nCommission shall be paid such allowances as are prescribed.\n\n(3) In this section, member of the Commission includes an associate\nmember of the Commission.\n\nChapter 1  Preliminary"
    },
