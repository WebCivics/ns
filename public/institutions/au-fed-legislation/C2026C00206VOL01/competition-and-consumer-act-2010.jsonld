      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Cannot",
      "cml:logicSummary": "Prohibition of signing a document in favour of a resolution with a pecuniary interest.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Councillor has a pecuniary interest.",
      "cml:conclusionText": "Signing is prohibited."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Cannot",
      "cml:logicSummary": "Prohibition of signing a document in favour of a resolution with a pecuniary interest.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Councillor's functions may be affected by the interest.",
      "cml:conclusionText": "Signing is prohibited."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The key overlaps with other resolutions without meetings.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Councillor signs a document in favour of a resolution.",
      "cml:conclusionText": "Signing is prohibited."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29m",
      "@type": "cml:Concept",
      "skos:prefLabel": "29M Staff to help Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.99",
      "values:originalText": "(1) The staff needed to help the Council are to be persons engaged\nunder the Public Service Act 1999.\n\n(2) For the purposes of the Public Service Act 1999:\n\n(a) the Council President and the APS employees assisting the\nCouncil President together constitute a Statutory Agency;\nand\n\n(b) the Council President is the Head of that Statutory Agency.",
      "skos:definition": "(1) The staff needed to help the Council are to be persons engaged\nunder the Public Service Act 1999.\n\n(2) For the purposes of the Public Service Act 1999:\n\n(a) the Council President and the APS employees assisting the\nCouncil President together constitute a Statutory Agency;\nand\n\n(b) the Council President is the Head of that Statutory Agency.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29m-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29m-ss-2"
        }
      ],
      "cml:integrityHash": "4493d6c599d9d146d9bf34cfd0df885ce40d5808bc282a47ba471da0116d7a52"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29m",
      "@type": "cof:Section",
      "cof:title": "29M Staff to help Council",
      "values:kind": "section",
      "cof:pageNumber": 99,
      "values:originalText": "(1) The staff needed to help the Council are to be persons engaged\nunder the Public Service Act 1999.\n\n(2) For the purposes of the Public Service Act 1999:\n\n(a) the Council President and the APS employees assisting the\nCouncil President together constitute a Statutory Agency;\nand\n\n(b) the Council President is the Head of that Statutory Agency."
    },
