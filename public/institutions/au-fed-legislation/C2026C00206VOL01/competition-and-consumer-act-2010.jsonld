        }
      ],
      "cml:integrityHash": "ca892953c2962098fd527fab9e3745fca07302f8a60a580d0b3c3353604cf1d1",
      "skos:note": "Commission must consider submissions when deciding what to publish."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44pf-ss-4",
      "@type": "cof:Section",
      "cof:title": "44PF(4) Commission must publish its decisions",
      "values:kind": "subsection",
      "cof:pageNumber": 206,
      "values:originalText": "(4) The Commission must have regard to any submission so made in\ndeciding what to publish. It may have regard to any other matter it\nconsiders relevant."
    },
