      "cml:integrityHash": "0e1673f1a12235875620f9e10199b1c360a0be956fb6277450b780feffa1982b",
      "skos:note": "Compliance with section 45AY is required. Must comply with conditions when putting an acquisition into effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45az-ss-1",
