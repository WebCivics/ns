      "skos:note": "Staff must be persons engaged under the Public Service Act 1999."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44-ss-3",
      "@type": "cof:Section",
      "cof:title": "44(3) Staff of Tribunal",
      "values:kind": "subsection",
      "cof:pageNumber": 108,
      "values:originalText": "(3) The Registrar and the Deputy Registrars, and the staff necessary to\nassist them, shall be persons engaged under the Public Service Act\n1999."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
