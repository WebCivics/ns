    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44li-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Council must recommend to the designated Minister.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Council has a duty to make recommendations.",
      "cml:conclusionText": "The designated Minister must revoke their decision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44li-ss-1-logic-alleninterval-2",
