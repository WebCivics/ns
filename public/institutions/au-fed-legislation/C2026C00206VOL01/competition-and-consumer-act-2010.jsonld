          "@id": "concept:competition-and-consumer-act-2010-sec-43-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8092cd4afde0e30144d4800f1563635abd2f7569e0f51d555a2e01be3ce2e75",
      "skos:note": "President may add a third member to the Tribunal at any time before proceedings determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-43-ss-4",
      "@type": "cof:Section",
      "cof:title": "43(4) Member of Tribunal ceasing to be available",
      "values:kind": "subsection",
      "cof:pageNumber": 107,
      "values:originalText": "(4) Where the President has given a direction under subsection (3), he\nor she may, at any time before the determination of the\nproceedings, direct that a third member be added to the Tribunal as\nconstituted in accordance with subsection (3)."
    },
