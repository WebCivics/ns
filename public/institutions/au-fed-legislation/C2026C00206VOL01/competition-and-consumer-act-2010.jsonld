      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires link to content.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) a link to the content is provided on the service and the user interacts with the link;",
      "cml:conclusionText": "User interaction with link to content on a service."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires extract of content.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) an extract of the content is provided on the service and the user interacts with the extract;",
      "cml:conclusionText": "User interaction with extract of content on a service."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-1-logic-alleninterval-4",
