      "cml:integrityHash": "b4fce97512a7c0458f2ab4c6349334002b5536ab022d9abd61bdf2e8e8a41d83",
      "skos:note": "A person may apply in writing to the Tribunal for review of a Commission's decision."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44pg-ss-1",
      "@type": "cof:Section",
      "cof:title": "44PG(1) Review of Commission’s initial decision",
      "values:kind": "subsection",
      "cof:pageNumber": 207,
      "values:originalText": "(1) A person whose interests are affected by a decision of the\nCommission under subsection 44PA(3) may apply in writing to the\nTribunal for review of the decision."
    },
