    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4e",
      "@type": "cml:Concept",
      "skos:prefLabel": "4E Market",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.61",
      "values:originalText": "For the purposes of this Act, unless the contrary intention appears,\nmarket means a market in Australia and, when used in relation to\nany goods or services, includes a market for those goods or\nservices and other goods or services that are substitutable for, or\notherwise competitive with, the first-mentioned goods or services.",
      "skos:definition": "For the purposes of this Act, unless the contrary intention appears,\nmarket means a market in Australia and, when used in relation to\nany goods or services, includes a market for those goods or\nservices and other goods or services that are substitutable for, or\notherwise competitive with, the first-mentioned goods or services.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4e-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4e-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4e-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "cccb2b3ea15f7259dcb66de972b4a305d7b90b6bed646bf07ed08b885e68a78a",
      "skos:note": "Defines market for purposes of the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4e",
      "@type": "cof:Section",
      "cof:title": "4E Market",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "For the purposes of this Act, unless the contrary intention appears,\nmarket means a market in Australia and, when used in relation to\nany goods or services, includes a market for those goods or\nservices and other goods or services that are substitutable for, or\notherwise competitive with, the first-mentioned goods or services."
    },
    {
