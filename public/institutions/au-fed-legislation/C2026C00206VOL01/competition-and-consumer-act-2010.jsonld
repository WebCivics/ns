    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-27a-ss-2",
      "@type": "cof:Section",
      "cof:title": "27A(2) Consultants",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
