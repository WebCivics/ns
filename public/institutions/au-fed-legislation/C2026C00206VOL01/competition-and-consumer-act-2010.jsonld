      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44a",
      "@type": "cml:Concept",
      "skos:prefLabel": "44A Acting appointments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.108",
      "values:originalText": "The Minister may appoint a person who is engaged under the\nPublic Service Act 1999 to act as the Registrar or as a Deputy\nRegistrar during any period, or during all periods, when:\n\n(a) the Registrar or that Deputy Registrar, as the case may be, is\nabsent from duty or from Australia or is, for any other\nreason, unable to perform the duties and functions of his or\nher office; or\n\n(b) there is a vacancy in the office of Registrar or in that office of\nDeputy Registrar, as the case may be.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\nPreliminary  Chapter 1\nThe Australian Energy Regulator (AER)  Part IIIAA\nPreliminary  Division 1\n\nSection 44AB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nPart IIIAA—The Australian Energy Regulator\n(AER)",
      "skos:definition": "The Minister may appoint a person who is engaged under the\nPublic Service Act 1999 to act as the Registrar or as a Deputy\nRegistrar during any period, or during all periods, when:\n\n(a) the Registrar or that Deputy Registrar, as the case may be, is\nabsent from duty or from Australia or is, for any other\nreason, unable to perform the duties and functions of his or\nher office; or\n\n(b) there is a vacancy in the office of Registrar or in that office of\nDeputy Registrar, as the case may be.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\nPreliminary  Chapter 1\nThe Australian Energy Regulator (AER)  Part IIIAA\nPreliminary  Division 1\n\nSection 44AB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nPart IIIAA—The Australian Energy Regulator\n(AER)",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "62cef4d3d778c7ff7f6257f2e724cf5bddfd59a2eb023959b9fb7068dd85756e",
      "skos:note": "The Minister may appoint a person to act as Registrar or Deputy Registrar."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44a",
      "@type": "cof:Section",
      "cof:title": "44A Acting appointments",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "The Minister may appoint a person who is engaged under the\nPublic Service Act 1999 to act as the Registrar or as a Deputy\nRegistrar during any period, or during all periods, when:\n\n(a) the Registrar or that Deputy Registrar, as the case may be, is\nabsent from duty or from Australia or is, for any other\nreason, unable to perform the duties and functions of his or\nher office; or\n\n(b) there is a vacancy in the office of Registrar or in that office of\nDeputy Registrar, as the case may be.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\nPreliminary  Chapter 1\nThe Australian Energy Regulator (AER)  Part IIIAA\nPreliminary  Division 1\n\nSection 44AB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nPart IIIAA—The Australian Energy Regulator\n(AER)"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44a"
      },
