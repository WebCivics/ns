      "@id": "concept:competition-and-consumer-act-2010-sec-53h-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The state has an obligation to apply the gas market provisions.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The gas market provisions apply in relation to supplying a gas commodity if the supply occurs in Australia; or (b) is:...",
      "cml:conclusionText": "...the supply:\n\n(a) occurs in Australia; or\n(b) is:..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53j",
      "@type": "cml:Concept",
      "skos:prefLabel": "53J Gas market provisions bind the Crown",
