        }
      ],
      "cml:integrityHash": "154c311766bf6e916fb06000dec1c802985ea5c061bb764f75bc9e8f1f72f4c1",
      "skos:note": "The Governor-General may terminate a member's appointment for misbehaviour or incapacity."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Termination of appointment of members of the Commission",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "(1) The Governor-General may terminate the appointment of a\nmember of the Commission for misbehaviour or physical or mental\nincapacity.\n\nChapter 1  Preliminary"
    },
