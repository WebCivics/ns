    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53zq-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "53ZQ(4) Schemes for avoidance purposes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zq-ss-4"
      },
      "cml:curationStatus": {
