        }
      ],
      "cml:integrityHash": "501c9c5237d3cdb257bad2561336d09c7849a1180468fb1eede4b87c60e60eb3",
      "skos:note": "Appointment of arbitrator must be from register"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zm-ss-9",
      "@type": "cof:Section",
      "cof:title": "52ZM(9) Formation of arbitral panel",
      "values:kind": "subsection",
      "cof:pageNumber": 478,
      "values:originalText": "(9) The ACMA may only make an appointment of a person who is\nlisted on the register of bargaining code arbitrators.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zm-ss-9-norm",
