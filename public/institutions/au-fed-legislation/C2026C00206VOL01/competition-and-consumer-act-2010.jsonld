    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "29LA(3) Resolutions without meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29la-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.98",
      "values:originalText": "(3) A Councillor must not sign a document containing a statement in\nfavour of a resolution if the resolution concerns a matter in which\nthe Councillor has any pecuniary interest, being an interest that\ncould conflict with the proper performance of the Councillor’s\nfunctions in relation to any matter.",
      "skos:definition": "(3) A Councillor must not sign a document containing a statement in\nfavour of a resolution if the resolution concerns a matter in which\nthe Councillor has any pecuniary interest, being an interest that\ncould conflict with the proper performance of the Councillor’s\nfunctions in relation to any matter.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-29la"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "e1a38ccddddd8d08d6cd225b976d79193d1b41213fe9b1ede9ca2bab7fbea853",
      "skos:note": "Signing a document in favour of a resolution with a pecuniary interest is prohibited for Councillors."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29la-ss-3",
      "@type": "cof:Section",
      "cof:title": "29LA(3) Resolutions without meetings",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(3) A Councillor must not sign a document containing a statement in\nfavour of a resolution if the resolution concerns a matter in which\nthe Councillor has any pecuniary interest, being an interest that\ncould conflict with the proper performance of the Councillor’s\nfunctions in relation to any matter."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-29la-ss-3"
      },
      "values:deonticStatus": {
