    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zb",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZB Personal information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.467",
      "values:originalText": "Nothing in this Division requires or authorises the giving of\ninformation that is personal information (within the meaning of the\nPrivacy Act 1988).\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code",
      "skos:definition": "Nothing in this Division requires or authorises the giving of\ninformation that is personal information (within the meaning of the\nPrivacy Act 1988).\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zb-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b45c1103d957f8264404626d79cb1de610ae4bbe3ca87c7b7bc1c02eb8737922",
      "skos:note": "No information that is personal information can be given."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zb",
      "@type": "cof:Section",
      "cof:title": "52ZB Personal information",
      "values:kind": "section",
      "cof:pageNumber": 467,
      "values:originalText": "Nothing in this Division requires or authorises the giving of\ninformation that is personal information (within the meaning of the\nPrivacy Act 1988).\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zb-norm",
      "@type": "values:Prohibition",
