    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44av",
      "@type": "cml:Concept",
      "skos:prefLabel": "44AV Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44av"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.120",
      "values:originalText": "(1) A full-time AER member has the recreation leave entitlements that\nare determined by the Remuneration Tribunal.\n\n(2) The Minister may grant a full-time AER member leave of absence,\nother than recreation leave, on the terms and conditions as to\nremuneration or otherwise that the Minister determines.\n\n(3) The AER Chair may grant leave of absence to any part-time AER\nmember on the terms and conditions that the AER Chair\ndetermines.\n\nPreliminary  Chapter 1\nThe Australian Energy Regulator (AER)  Part IIIAA\nAdministrative provisions relating to the AER  Division 4\n\nSection 44AW\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) A full-time AER member has the recreation leave entitlements that\nare determined by the Remuneration Tribunal.\n\n(2) The Minister may grant a full-time AER member leave of absence,\nother than recreation leave, on the terms and conditions as to\nremuneration or otherwise that the Minister determines.\n\n(3) The AER Chair may grant leave of absence to any part-time AER\nmember on the terms and conditions that the AER Chair\ndetermines.\n\nPreliminary  Chapter 1\nThe Australian Energy Regulator (AER)  Part IIIAA\nAdministrative provisions relating to the AER  Division 4\n\nSection 44AW\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44av-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44av-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44av-ss-3"
        }
      ],
      "cml:integrityHash": "9803d6872216445c40b1348f78b53c3f96c242bddb143edac3cba9c2b8ec38c8"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44av",
      "@type": "cof:Section",
      "cof:title": "44AV Leave of absence",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "(1) A full-time AER member has the recreation leave entitlements that\nare determined by the Remuneration Tribunal.\n\n(2) The Minister may grant a full-time AER member leave of absence,\nother than recreation leave, on the terms and conditions as to\nremuneration or otherwise that the Minister determines.\n\n(3) The AER Chair may grant leave of absence to any part-time AER\nmember on the terms and conditions that the AER Chair\ndetermines.\n\nPreliminary  Chapter 1\nThe Australian Energy Regulator (AER)  Part IIIAA\nAdministrative provisions relating to the AER  Division 4\n\nSection 44AW\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
