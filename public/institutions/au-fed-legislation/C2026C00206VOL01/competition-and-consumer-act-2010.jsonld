      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the member is absent, except on leave of absence, from 3 consecutive meetings of the AER;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-7",
