      "cml:premiseText": "(1) A gas market instrument may include rules about a gas market participant, the Minister or the Commission publishing information",
      "cml:conclusionText": "The rule requires publishing information at specified intervals."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53z-ss-1-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Publishing information implies compliance with the rule",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
