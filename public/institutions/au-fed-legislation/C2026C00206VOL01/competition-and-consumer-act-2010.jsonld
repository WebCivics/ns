        }
      ],
      "cml:integrityHash": "4e086709f39b4b06ea0f37636e05dcfefe49e632a13b0e5df8b2070ba0cec41c",
      "skos:note": "Tribunal may make an order without informing a person"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ka-ss-4",
