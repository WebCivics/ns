    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZC Determination of questions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.221",
      "values:originalText": "If the Commission is constituted for an arbitration by 2 or more\nmembers of the Commission, any question before the Commission\nis to be decided:\n\n(a) unless paragraph (b) applies—according to the opinion of the\nmajority of those members; or\n\n(b) if the members are evenly divided on the question—\naccording to the opinion of the member who is presiding.",
      "skos:definition": "If the Commission is constituted for an arbitration by 2 or more\nmembers of the Commission, any question before the Commission\nis to be decided:\n\n(a) unless paragraph (b) applies—according to the opinion of the\nmajority of those members; or\n\n(b) if the members are evenly divided on the question—\naccording to the opinion of the member who is presiding.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zc-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44zc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "433a7afd35b27abafa33d8e702e31fa878a2733984d0fbfe93defbfc9f6903e3",
      "skos:note": "The Commission must decide questions according to the opinion of the majority of its members."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zc",
      "@type": "cof:Section",
      "cof:title": "44ZC Determination of questions",
      "values:kind": "section",
      "cof:pageNumber": 221,
      "values:originalText": "If the Commission is constituted for an arbitration by 2 or more\nmembers of the Commission, any question before the Commission\nis to be decided:\n\n(a) unless paragraph (b) applies—according to the opinion of the\nmajority of those members; or\n\n(b) if the members are evenly divided on the question—\naccording to the opinion of the member who is presiding."
    },
