      },
      "cml:premiseText": "(1) A gas market emergency price order may include rules...",
      "cml:conclusionText": "...including rules about any of the following matters:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53x-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
