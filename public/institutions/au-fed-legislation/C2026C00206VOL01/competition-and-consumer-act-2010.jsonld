    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ac",
      "@type": "cml:Concept",
      "skos:prefLabel": "45AC Extended meaning of party",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ac"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.284",
      "values:originalText": "For the purposes of this Division, if a body corporate is a party to a\ncontract, arrangement or understanding (otherwise than because of\nthis section), each body corporate related to that body corporate is\ntaken to be a party to that contract, arrangement or understanding.",
      "skos:definition": "For the purposes of this Division, if a body corporate is a party to a\ncontract, arrangement or understanding (otherwise than because of\nthis section), each body corporate related to that body corporate is\ntaken to be a party to that contract, arrangement or understanding.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ac-norm"
        }
      ],
      "cml:integrityHash": "b655b7617f58417f3b897266eccafa41edd492e33dea7c26758363ccc6e2d10f",
      "skos:note": "Each related body corporate is taken to be a party to the contract, arrangement or understanding."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ac",
      "@type": "cof:Section",
      "cof:title": "45AC Extended meaning of party",
      "values:kind": "section",
      "cof:pageNumber": 284,
      "values:originalText": "For the purposes of this Division, if a body corporate is a party to a\ncontract, arrangement or understanding (otherwise than because of\nthis section), each body corporate related to that body corporate is\ntaken to be a party to that contract, arrangement or understanding."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ac-norm",
      "@type": "values:Obligation",
