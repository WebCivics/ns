    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53zz-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "53ZZ(1) Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53zz-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.548",
      "values:originalText": "(1) Regulations (other than a gas market code) made for the purposes\nof a provision of this Part may make provision in relation to a\nmatter by applying, adopting or incorporating (with or without\nmodification) any matter contained in any other instrument or\nwriting:\n\n(a) as in force or existing at a particular time; or\n\n(b) as in force or existing from time to time.\nNote:\nFor a gas market code, see subsection 53ZE(1).",
      "skos:definition": "(1) Regulations (other than a gas market code) made for the purposes\nof a provision of this Part may make provision in relation to a\nmatter by applying, adopting or incorporating (with or without\nmodification) any matter contained in any other instrument or\nwriting:\n\n(a) as in force or existing at a particular time; or\n\n(b) as in force or existing from time to time.\nNote:\nFor a gas market code, see subsection 53ZE(1).",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-53zz"
      },
      "cml:asserts": [
