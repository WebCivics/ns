      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(8) The decision of the Tribunal takes effect from when it is made.",
      "cml:conclusionText": "The decision takes effect immediately upon making."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zq",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZQ Provisions that do not apply in relation to a Tribunal review",
