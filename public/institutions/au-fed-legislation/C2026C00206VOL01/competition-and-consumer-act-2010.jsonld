    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zx-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZX(3) Final offer arbitration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zx-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
