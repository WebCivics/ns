    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52b",
      "@type": "cml:Concept",
      "skos:prefLabel": "52B Making content available",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.448",
      "values:originalText": "(1) For the purposes of this Part, a service makes content available if:\n\n(a) the content is reproduced on the service, or is otherwise\nplaced on the service; or\n\n(b) a link to the content is provided on the service; or\n\n(c) an extract of the content is provided on the service.\n\n(2) Subsection (1) does not limit, for the purposes of this Part, the\nways in which a service makes content available.",
      "skos:definition": "(1) For the purposes of this Part, a service makes content available if:\n\n(a) the content is reproduced on the service, or is otherwise\nplaced on the service; or\n\n(b) a link to the content is provided on the service; or\n\n(c) an extract of the content is provided on the service.\n\n(2) Subsection (1) does not limit, for the purposes of this Part, the\nways in which a service makes content available.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52b-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52b-ss-2"
        }
      ],
