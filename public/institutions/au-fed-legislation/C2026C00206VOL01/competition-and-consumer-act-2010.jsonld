      "skos:note": "Party may appear in person or be represented by someone else."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ze",
      "@type": "cof:Section",
      "cof:title": "44ZE Right to representation",
      "values:kind": "section",
      "cof:pageNumber": 222,
      "values:originalText": "In an arbitration hearing before the Commission under this Part, a\nparty may appear in person or be represented by someone else."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ze-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44ze"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "held by: NaturalPerson"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ze-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Right to representation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
