    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53za-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "53ZA(3) Reporting, records and auditing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53za-ss-3"
      },
