        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52s-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "31612389968b55e95046b7829f825dbb00880a0719f9555c2852f25174864803",
      "skos:note": "Notice must be given to registered news business corporations at least 14 days before change is made."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52s-ss-2",
      "@type": "cof:Section",
      "cof:title": "52S(2) Change to algorithm to bring about identified alteration to",
      "values:kind": "subsection",
      "cof:pageNumber": 463,
      "values:originalText": "(2) The responsible digital platform corporation for the designated\ndigital platform service must ensure that:\n\n(a) notice of the change is given to the registered news business\ncorporation for each registered news business; and\n\n(b) the notice is given:\n\n(i) unless subparagraph (ii) applies—at least 14 days before\nthe change is made; or\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52s-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52s-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52s-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
