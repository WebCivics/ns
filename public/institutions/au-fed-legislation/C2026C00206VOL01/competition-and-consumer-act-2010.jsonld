      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.62",
      "values:originalText": "competition\n\nFor the purposes of this Act, references to the lessening of\ncompetition shall be read as including references to preventing or\nhindering competition.",
      "skos:definition": "competition\n\nFor the purposes of this Act, references to the lessening of\ncompetition shall be read as including references to preventing or\nhindering competition.",
      "cml:asserts": [
