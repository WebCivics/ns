    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ax",
      "@type": "cml:Concept",
      "skos:prefLabel": "44AX Outside employment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ax"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.121",
      "values:originalText": "(1) A full-time AER member must not engage in paid employment\noutside the duties of the member’s office without the Minister’s\nconsent.\n\n(2) A part-time AER member must not engage in any paid\nemployment that conflicts or could conflict with the proper\nperformance of the member’s duties.",
      "skos:definition": "(1) A full-time AER member must not engage in paid employment\noutside the duties of the member’s office without the Minister’s\nconsent.\n\n(2) A part-time AER member must not engage in any paid\nemployment that conflicts or could conflict with the proper\nperformance of the member’s duties.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ax-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44ax-ss-2"
        }
      ],
      "cml:integrityHash": "0a376932e988fcb9fd5bfbeb939b755ae3710b7bd7e0b02f50f9e8dcaa44b8d4"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44ax",
      "@type": "cof:Section",
      "cof:title": "44AX Outside employment",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "(1) A full-time AER member must not engage in paid employment\noutside the duties of the member’s office without the Minister’s\nconsent.\n\n(2) A part-time AER member must not engage in any paid\nemployment that conflicts or could conflict with the proper\nperformance of the member’s duties."
    },
