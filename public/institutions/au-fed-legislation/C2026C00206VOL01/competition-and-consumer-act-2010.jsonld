    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44aw",
      "@type": "cml:Concept",
      "skos:prefLabel": "44AW Other terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44aw"
      },
      "cml:curationStatus": {
