    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44c-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "44C(3) How this Part applies to partnerships and joint ventures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44c-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.143",
      "values:originalText": "(3) If a provision of this Part refers to the provider bearing any costs,\nthe provision applies as if the provision referred to any of the\nparticipants bearing any costs.\n\nChapter 2  Access to services",
      "skos:definition": "(3) If a provision of this Part refers to the provider bearing any costs,\nthe provision applies as if the provision referred to any of the\nparticipants bearing any costs.\n\nChapter 2  Access to services",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44c"
      },
