        }
      ],
      "cml:integrityHash": "d35cadd5ca0ef7e8bab455e16523002d24752816dc2e629e86bf3e2bd250fb84",
      "skos:note": "Tribunal may affirm or revoke designated Minister's decision on ineligibility"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44lk-ss-9",
      "@type": "cof:Section",
      "cof:title": "44LK(9) Review of decision to revoke or not revoke an ineligibility",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(9) If the designated Minister decided not to revoke his or her\nineligibility decision, the Tribunal may either:\n\n(a) affirm the designated Minister’s decision; or\n\n(b) set aside the designated Minister’s decision and revoke the\nineligibility decision.\n\nChapter 2  Access to services"
    },
