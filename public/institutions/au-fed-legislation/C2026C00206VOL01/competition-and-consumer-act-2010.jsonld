      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.323",
      "values:originalText": "provisions of Part\n\nNothing in section 45D, 45DA, 45DB, 45DC, 45DD, 45E or 45EA\naffects the operation of any other provision of this Part.",
      "skos:definition": "provisions of Part\n\nNothing in section 45D, 45DA, 45DB, 45DC, 45DD, 45E or 45EA\naffects the operation of any other provision of this Part.",
      "cml:asserts": [
