    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52z",
      "@type": "cml:Concept",
      "skos:prefLabel": "52Z Facilitating open communication—registered news business",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52z"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
