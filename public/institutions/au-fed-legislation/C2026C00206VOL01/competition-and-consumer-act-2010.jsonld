      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zo-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZO(7) Operation of final determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zo-ss-7"
