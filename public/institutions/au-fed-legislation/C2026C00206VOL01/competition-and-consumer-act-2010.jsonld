    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44lk-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "44LK(9) Review of decision to revoke or not revoke an ineligibility",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44lk-ss-9"
      },
      "cml:curationStatus": {
