    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44c-ss-2",
      "@type": "cof:Section",
      "cof:title": "44C(2) How this Part applies to partnerships and joint ventures",
      "values:kind": "subsection",
      "cof:pageNumber": 143,
      "values:originalText": "(2) If this Part requires or permits something to be done by the\nprovider, the thing may be done by one or more of the participants\non behalf of the provider."
    },
