    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29g",
      "@type": "cml:Concept",
      "skos:prefLabel": "29G Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.96",
      "values:originalText": "(1) A full-time Councillor has such recreation leave entitlements as are\ndetermined by the Remuneration Tribunal.\n\n(2) The Minister may grant a full-time Councillor leave of absence,\nother than recreation leave, on such terms and conditions as the\nMinister determines. The terms and conditions may include terms\nand conditions relating to remuneration.\n\nPreliminary  Chapter 1\nThe National Competition Council  Part IIA\n\nSection 29H\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) A full-time Councillor has such recreation leave entitlements as are\ndetermined by the Remuneration Tribunal.\n\n(2) The Minister may grant a full-time Councillor leave of absence,\nother than recreation leave, on such terms and conditions as the\nMinister determines. The terms and conditions may include terms\nand conditions relating to remuneration.\n\nPreliminary  Chapter 1\nThe National Competition Council  Part IIA\n\nSection 29H\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29g-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29g-ss-2"
        }
      ],
      "cml:integrityHash": "5c09bd7226daa47a7daff1f93694af0c2306559f0fd243d0eb567c3997379453"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29g",
      "@type": "cof:Section",
      "cof:title": "29G Leave of absence",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "(1) A full-time Councillor has such recreation leave entitlements as are\ndetermined by the Remuneration Tribunal.\n\n(2) The Minister may grant a full-time Councillor leave of absence,\nother than recreation leave, on such terms and conditions as the\nMinister determines. The terms and conditions may include terms\nand conditions relating to remuneration.\n\nPreliminary  Chapter 1\nThe National Competition Council  Part IIA\n\nSection 29H\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
