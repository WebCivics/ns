        }
      ],
      "cml:integrityHash": "e53802502730c5f507cefa516da10431ac2495a75fe89038dd71bd2d0c90090f",
      "skos:note": "Must consider information given within specified period, may disregard later information. Minister may specify variations to access regime"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44na-ss-3",
      "@type": "cof:Section",
      "cof:title": "44NA(3) Recommendation by Council",
      "values:kind": "subsection",
      "cof:pageNumber": 184,
      "values:originalText": "(3) The responsible Minister for the State or Territory may specify in\nthe application proposed variations to the access regime.\nAssessment by Council"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44na-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
