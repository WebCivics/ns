        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 45EA enforces a prohibition on giving effect to provisions contravening section 45E"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45eb",
