    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45aj",
      "@type": "cml:Concept",
      "skos:prefLabel": "45AJ Making a contract etc. containing a cartel provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45aj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.294",
      "values:originalText": "A corporation contravenes this section if:\n\n(a) the corporation makes a contract or arrangement, or arrives at\nan understanding; and\n\n(b) the contract, arrangement or understanding contains a cartel\nprovision.\nNote:\nFor enforcement, see Part VI.",
      "skos:definition": "A corporation contravenes this section if:\n\n(a) the corporation makes a contract or arrangement, or arrives at\nan understanding; and\n\n(b) the contract, arrangement or understanding contains a cartel\nprovision.\nNote:\nFor enforcement, see Part VI.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45aj-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45aj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e94dcadd18522d54f40d3166e6023789f486783565d9007fafb56297cdc39bfd",
      "skos:note": "Making a contract or arrangement with a cartel provision is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45aj",
      "@type": "cof:Section",
      "cof:title": "45AJ Making a contract etc. containing a cartel provision",
      "values:kind": "section",
      "cof:pageNumber": 294,
      "values:originalText": "A corporation contravenes this section if:\n\n(a) the corporation makes a contract or arrangement, or arrives at\nan understanding; and\n\n(b) the contract, arrangement or understanding contains a cartel\nprovision.\nNote:\nFor enforcement, see Part VI."
    },
