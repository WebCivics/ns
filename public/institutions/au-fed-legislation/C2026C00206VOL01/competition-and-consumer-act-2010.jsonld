    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "52C(2) Interacting with content",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52c-ss-2"
      },
      "cml:curationStatus": {
