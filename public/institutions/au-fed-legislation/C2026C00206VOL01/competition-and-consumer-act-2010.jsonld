    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44nf-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must perform action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Council must do the things under subsections (1) and (2)",
      "cml:conclusionText": "The Council must take action on the day the Commonwealth Minister publishes his or her decision"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44nf-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must perform action within a timeframe",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "on the day the Commonwealth Minister publishes his or her decision\nor as soon as practicable after that day",
      "cml:conclusionText": "The Council must take action on the specified day or shortly thereafter"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44nf-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEGINS_ON",
      "cml:logicSummary": "Describes a temporal relationship",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "on the day the Commonwealth Minister publishes his or her decision\nor as soon as practicable after that day",
      "cml:conclusionText": "The action begins on the specified day"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44nf-ss-3-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
