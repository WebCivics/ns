    {
      "@id": "concept:competition-and-consumer-act-2010-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Termination of appointment of associate members of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.82",
      "values:originalText": "Commission\n\n(1) The Minister may terminate the appointment of an associate\nmember of the Commission for misbehaviour or physical or mental\nincapacity.\n\n(2) If an associate member of the Commission:\n\n(a) becomes bankrupt, applies to take the benefit of any law for\nthe relief of bankrupt or insolvent debtors, compounds with\nhis or her creditors or makes an assignment of his or her\nremuneration for their benefit; or\n\n(b) fails to comply with his or her obligations under section 29 of\nthe Public Governance, Performance and Accountability Act\n2013 (which deals with the duty to disclose interests) or rules\nmade for the purposes of that section;\nthe Minister shall terminate the appointment of that associate\nmember of the Commission.\n\nPreliminary  Chapter 1\nThe Australian Competition and Consumer Commission  Part II\n\nSection 15\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Commission\n\n(1) The Minister may terminate the appointment of an associate\nmember of the Commission for misbehaviour or physical or mental\nincapacity.\n\n(2) If an associate member of the Commission:\n\n(a) becomes bankrupt, applies to take the benefit of any law for\nthe relief of bankrupt or insolvent debtors, compounds with\nhis or her creditors or makes an assignment of his or her\nremuneration for their benefit; or\n\n(b) fails to comply with his or her obligations under section 29 of\nthe Public Governance, Performance and Accountability Act\n2013 (which deals with the duty to disclose interests) or rules\nmade for the purposes of that section;\nthe Minister shall terminate the appointment of that associate\nmember of the Commission.\n\nPreliminary  Chapter 1\nThe Australian Competition and Consumer Commission  Part II\n\nSection 15\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-14-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-14-ss-2"
        }
      ],
      "cml:integrityHash": "3d41e1a66a7daeb8da761812e830ca56fe19dd3ec7c8e2e6b0ca2abeef1a2010"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Termination of appointment of associate members of the",
      "values:kind": "section",
      "cof:pageNumber": 82,
      "values:originalText": "Commission\n\n(1) The Minister may terminate the appointment of an associate\nmember of the Commission for misbehaviour or physical or mental\nincapacity.\n\n(2) If an associate member of the Commission:\n\n(a) becomes bankrupt, applies to take the benefit of any law for\nthe relief of bankrupt or insolvent debtors, compounds with\nhis or her creditors or makes an assignment of his or her\nremuneration for their benefit; or\n\n(b) fails to comply with his or her obligations under section 29 of\nthe Public Governance, Performance and Accountability Act\n2013 (which deals with the duty to disclose interests) or rules\nmade for the purposes of that section;\nthe Minister shall terminate the appointment of that associate\nmember of the Commission.\n\nPreliminary  Chapter 1\nThe Australian Competition and Consumer Commission  Part II\n\nSection 15\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
