    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44z",
      "@type": "cml:Concept",
      "skos:prefLabel": "44Z Constitution of Commission for conduct of arbitration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44z"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.220",
      "values:originalText": "For the purposes of a particular arbitration, the Commission is to\nbe constituted by 2 or more members of the Commission\nnominated in writing by the Chairperson.",
      "skos:definition": "For the purposes of a particular arbitration, the Commission is to\nbe constituted by 2 or more members of the Commission\nnominated in writing by the Chairperson.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44z-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44z-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d25a9bf57968a93fdc16aae6722ea176b363db1ca25351a642257e2975ada4bb",
      "skos:note": "Commission constitution for arbitration"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44z",
      "@type": "cof:Section",
      "cof:title": "44Z Constitution of Commission for conduct of arbitration",
      "values:kind": "section",
      "cof:pageNumber": 220,
      "values:originalText": "For the purposes of a particular arbitration, the Commission is to\nbe constituted by 2 or more members of the Commission\nnominated in writing by the Chairperson."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44z-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
