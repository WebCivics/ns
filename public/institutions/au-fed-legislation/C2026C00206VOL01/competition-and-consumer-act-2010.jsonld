    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29bb-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "29BB(4) How duty is imposed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29bb-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
