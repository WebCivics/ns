    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53y",
      "@type": "cml:Concept",
      "skos:prefLabel": "53Y Gas exchanges",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53y"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.526",
      "values:originalText": "A gas market emergency price order may include rules regulating\nthe operation of a gas exchange.\nSubdivision D—Incidental and other matters that gas market\ncodes and gas market emergency price orders may\ndeal with",
      "skos:definition": "A gas market emergency price order may include rules regulating\nthe operation of a gas exchange.\nSubdivision D—Incidental and other matters that gas market\ncodes and gas market emergency price orders may\ndeal with",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-53y-norm"
        }
      ],
      "cml:integrityHash": "a9f5088e0407feb7fc990fb2e428c0aff62794a4c11aa98c8d117eeb8258946a",
      "skos:note": "Regulates gas exchange operation under a gas market emergency price order"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53y",
      "@type": "cof:Section",
      "cof:title": "53Y Gas exchanges",
      "values:kind": "section",
      "cof:pageNumber": 526,
      "values:originalText": "A gas market emergency price order may include rules regulating\nthe operation of a gas exchange.\nSubdivision D—Incidental and other matters that gas market\ncodes and gas market emergency price orders may\ndeal with"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53y-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-53y"
