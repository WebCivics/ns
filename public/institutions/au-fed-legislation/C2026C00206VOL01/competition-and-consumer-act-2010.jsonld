      "values:kind": "subsection",
      "cof:pageNumber": 448,
      "values:originalText": "(1) For the purposes of this Part, a user of a service interacts with\ncontent made available by the service if:\n\n(a) the content is reproduced on the service, or is otherwise\nplaced on the service, and the user interacts with the content;\nor\n\n(b) a link to the content is provided on the service and the user\ninteracts with the link; or\n\n(c) an extract of the content is provided on the service and the\nuser interacts with the extract."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
