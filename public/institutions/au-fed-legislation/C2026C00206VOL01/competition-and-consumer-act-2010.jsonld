      },
      "cml:operator": "overlaps",
      "cml:logicSummary": "Identifies overlapping temporal intervals",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
