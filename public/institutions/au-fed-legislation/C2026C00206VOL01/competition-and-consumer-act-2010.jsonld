    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ae",
      "@type": "cml:Concept",
      "skos:prefLabel": "45AE Meaning of expressions in other provisions of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ae"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.291",
      "values:originalText": "In determining the meaning of an expression used in a provision of\nthis Act (other than this Division, subsection 6(2C),\nparagraph 76(1B)(b) or subsection 93AB(1A)), this Division is to\nbe disregarded.\nSubdivision B—Offences etc.",
      "skos:definition": "In determining the meaning of an expression used in a provision of\nthis Act (other than this Division, subsection 6(2C),\nparagraph 76(1B)(b) or subsection 93AB(1A)), this Division is to\nbe disregarded.\nSubdivision B—Offences etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ae-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-45ae-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ba83a2479a9d7e93ca16caae211125d9570147897c2608bc7a5766dabcd0174d",
      "skos:note": "Disregard this Division in determining expression meanings."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-45ae",
      "@type": "cof:Section",
      "cof:title": "45AE Meaning of expressions in other provisions of this Act",
      "values:kind": "section",
      "cof:pageNumber": 291,
      "values:originalText": "In determining the meaning of an expression used in a provision of\nthis Act (other than this Division, subsection 6(2C),\nparagraph 76(1B)(b) or subsection 93AB(1A)), this Division is to\nbe disregarded.\nSubdivision B—Offences etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ae-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
