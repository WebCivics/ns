      "skos:note": "Matters that the Commission must take into account"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44x-ss-3",
      "@type": "cof:Section",
      "cof:title": "44X(3) Matters that the Commission must take into account",
      "values:kind": "subsection",
      "cof:pageNumber": 217,
      "values:originalText": "(3) The Commission may take the following matters into account in\nmaking an interim determination:\n\n(a) a matter referred to in subsection (1);\n\n(b) any other matter it considers relevant."
    },
