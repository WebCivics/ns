      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.486",
      "values:originalText": "(3) If a bargaining party gives a copy of the final offer to the\nCommission, the Commission must give a copy of the final offer to\nthe other bargaining party as soon as practicable.",
      "skos:definition": "(3) If a bargaining party gives a copy of the final offer to the\nCommission, the Commission must give a copy of the final offer to\nthe other bargaining party as soon as practicable.",
      "values:partOf": {
