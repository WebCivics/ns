    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44lf",
      "@type": "cml:Concept",
      "skos:prefLabel": "44LF Council must publish its recommendation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44lf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.171",
      "values:originalText": "Council must publish its recommendation\n\n(1) The Council must publish, by electronic or other means, a\nrecommendation under section 44LB and its reasons for the\nrecommendation.\n\n(2) The Council must give a copy of the publication to:\n\n(a) the person who made the application under section 44LB;\nand\n\n(b) if the applicant is not the person who is, or expects to be, the\nprovider—that person.\n\nChapter 2  Access to services",
      "skos:definition": "Council must publish its recommendation\n\n(1) The Council must publish, by electronic or other means, a\nrecommendation under section 44LB and its reasons for the\nrecommendation.\n\n(2) The Council must give a copy of the publication to:\n\n(a) the person who made the application under section 44LB;\nand\n\n(b) if the applicant is not the person who is, or expects to be, the\nprovider—that person.\n\nChapter 2  Access to services",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44lf-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44lf-ss-2"
        }
      ],
      "cml:integrityHash": "3f1e5d0aafc27084931ebf2f9280b1b8760210aea545566ee9fb441da1e54f88"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44lf",
      "@type": "cof:Section",
      "cof:title": "44LF Council must publish its recommendation",
      "values:kind": "section",
      "cof:pageNumber": 171,
      "values:originalText": "Council must publish its recommendation\n\n(1) The Council must publish, by electronic or other means, a\nrecommendation under section 44LB and its reasons for the\nrecommendation.\n\n(2) The Council must give a copy of the publication to:\n\n(a) the person who made the application under section 44LB;\nand\n\n(b) if the applicant is not the person who is, or expects to be, the\nprovider—that person.\n\nChapter 2  Access to services"
    },
