      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4l",
      "@type": "cml:Concept",
      "skos:prefLabel": "4L Severability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.63",
      "values:originalText": "If the making of a contract after the commencement of this section\ncontravenes this Act by reason of the inclusion of a particular\nprovision in the contract, then, subject to any order made under\nsection 51ADB, 53ZO or 87, nothing in this Act affects the validity\nor enforceability of the contract otherwise than in relation to that\nprovision in so far as that provision is severable.\n\nChapter 1  Preliminary",
      "skos:definition": "If the making of a contract after the commencement of this section\ncontravenes this Act by reason of the inclusion of a particular\nprovision in the contract, then, subject to any order made under\nsection 51ADB, 53ZO or 87, nothing in this Act affects the validity\nor enforceability of the contract otherwise than in relation to that\nprovision in so far as that provision is severable.\n\nChapter 1  Preliminary",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4l-norm"
        }
      ],
      "cml:integrityHash": "b5404f1be1af47d38dbc5d487c886dd25891951edd2ca745747ac5b37488629c",
      "skos:note": "Nothing in this Act affects the validity or enforceability of a contract otherwise than in relation to a severable provision."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4l",
      "@type": "cof:Section",
      "cof:title": "4L Severability",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "If the making of a contract after the commencement of this section\ncontravenes this Act by reason of the inclusion of a particular\nprovision in the contract, then, subject to any order made under\nsection 51ADB, 53ZO or 87, nothing in this Act affects the validity\nor enforceability of the contract otherwise than in relation to that\nprovision in so far as that provision is severable.\n\nChapter 1  Preliminary"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4l-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
