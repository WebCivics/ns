    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44x-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "44X(3) Matters that the Commission must take into account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44x-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.217",
      "values:originalText": "(3) The Commission may take the following matters into account in\nmaking an interim determination:\n\n(a) a matter referred to in subsection (1);\n\n(b) any other matter it considers relevant.",
      "skos:definition": "(3) The Commission may take the following matters into account in\nmaking an interim determination:\n\n(a) a matter referred to in subsection (1);\n\n(b) any other matter it considers relevant.",
      "values:partOf": {
