    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZN(5) Disclosure of conflicts of interest where ACMA appoints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zn-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
