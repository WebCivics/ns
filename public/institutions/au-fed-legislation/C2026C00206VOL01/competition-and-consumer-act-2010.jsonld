        }
      ],
      "cml:integrityHash": "11d4b59dbd95fe4b3fe25bff56add60b59bb7f710df74d4b0e5b40c2b2fc1b1d",
      "skos:note": "Quorum requirement for AER meetings Termination of appointment for absence or conflict of interest Resignation obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44az-ss-3",
      "@type": "cof:Section",
      "cof:title": "44AZ(3) Resignation",
      "values:kind": "subsection",
      "cof:pageNumber": 122,
      "values:originalText": "(3) A person who is the AER Deputy Chair may resign the person’s\nappointment as AER Deputy Chair by giving the\nGovernor-General a written resignation. The resignation does not\naffect the person’s appointment as an AER member.\n44AAB  Termination of appointment\nAll AER members"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires a quorum of 3 members",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "At least 3 AER members must be present",
      "cml:conclusionText": "The meeting is invalid if less than 3 members are present"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires the AER Chair to be present",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "At least one member must be present",
      "cml:conclusionText": "The meeting is invalid if less than one member is present"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires a quorum of at least 3 members",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "At least 2 members must be present",
      "cml:conclusionText": "The meeting is invalid if less than 2 members are present"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition on termination without cause",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The Governor-General may terminate the appointment of a part-time AER member if:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition on paid employment that conflicts with duties",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the member engages in paid employment that conflicts or could conflict with the proper performance of the duties of his or her office."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-alleninterval-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlap between absence and duty period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the member is absent, except on leave of absence, from 3 consecutive meetings of the AER;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-3-logic-deontic-7",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "OBLIGES",
      "cml:logicSummary": "Governor-General is obligated to receive resignation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "AER Deputy Chair appointment",
      "cml:conclusionText": "Resignation received"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "44AZ(1) Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44az-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.122",
      "values:originalText": "(1) The Governor-General may terminate the appointment of an AER\nmember:\n\n(a) for misbehaviour or physical or mental incapacity; or\n\n(b) if the member:\n\n(i) becomes bankrupt; or\n\n(ii) applies to take the benefit of any law for the relief of\nbankrupt or insolvent debtors; or\n\n(iii) compounds with his or her creditors; or\n\n(iv) makes an assignment of his or her remuneration for the\nbenefit of his or her creditors; or\n\n(c) if the member fails, without reasonable excuse, to comply\nwith section 44AY.\nAdditional grounds: full-time AER members",
      "skos:definition": "(1) The Governor-General may terminate the appointment of an AER\nmember:\n\n(a) for misbehaviour or physical or mental incapacity; or\n\n(b) if the member:\n\n(i) becomes bankrupt; or\n\n(ii) applies to take the benefit of any law for the relief of\nbankrupt or insolvent debtors; or\n\n(iii) compounds with his or her creditors; or\n\n(iv) makes an assignment of his or her remuneration for the\nbenefit of his or her creditors; or\n\n(c) if the member fails, without reasonable excuse, to comply\nwith section 44AY.\nAdditional grounds: full-time AER members",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44az"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-1-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44az-ss-1-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "4413b8cce41be8e73b4b6795534142b46446ef15498df5a6b3b1a403d3aa9a54",
      "skos:note": "The AER Chair must convene meetings as necessary. Resignation obligation Governor-General may terminate appointment of AER member under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44az-ss-1",
      "@type": "cof:Section",
      "cof:title": "44AZ(1) Resignation",
      "values:kind": "subsection",
      "cof:pageNumber": 122,
      "values:originalText": "(1) The Governor-General may terminate the appointment of an AER\nmember:\n\n(a) for misbehaviour or physical or mental incapacity; or\n\n(b) if the member:\n\n(i) becomes bankrupt; or\n\n(ii) applies to take the benefit of any law for the relief of\nbankrupt or insolvent debtors; or\n\n(iii) compounds with his or her creditors; or\n\n(iv) makes an assignment of his or her remuneration for the\nbenefit of his or her creditors; or\n\n(c) if the member fails, without reasonable excuse, to comply\nwith section 44AY.\nAdditional grounds: full-time AER members"
    },
