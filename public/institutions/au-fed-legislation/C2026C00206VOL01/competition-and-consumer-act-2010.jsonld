    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44au",
      "@type": "cml:Concept",
      "skos:prefLabel": "44AU Additional remuneration of AER Chair",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44au"
      },
      "cml:curationStatus": {
