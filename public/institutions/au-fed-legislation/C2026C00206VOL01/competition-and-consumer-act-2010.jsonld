    {
      "@id": "concept:competition-and-consumer-act-2010-sec-53l",
      "@type": "cml:Concept",
      "skos:prefLabel": "53L Regulations may prescribe gas market codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-53l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
