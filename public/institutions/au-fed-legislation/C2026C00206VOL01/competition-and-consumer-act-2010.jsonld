        }
      ],
      "cml:integrityHash": "3d9e573364b1ec1a02727b4e0f5d92fefada2158feabc0c3855035b9802bf908",
      "skos:note": "Commission must provide copy of final offer to other bargaining party upon request.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zx-ss-3",
