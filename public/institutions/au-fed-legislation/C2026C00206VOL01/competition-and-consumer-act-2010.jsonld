      "skos:prefLabel": "29BA(2) Commonwealth consent to conferral of functions etc. on",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29ba-ss-2"
      },
