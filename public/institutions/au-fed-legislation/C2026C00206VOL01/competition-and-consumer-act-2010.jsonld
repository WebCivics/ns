      "dc:source": "competition-and-consumer-act-2010.pdf, p.182",
      "values:originalText": "(3) The decision must specify the period for which it is in force.\nNote:\nThe period for which the decision is in force may be extended: see\nsection 44NB.",
      "skos:definition": "(3) The decision must specify the period for which it is in force.\nNote:\nThe period for which the decision is in force may be extended: see\nsection 44NB.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44n"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44n-ss-3-norm"
        }
      ],
      "cml:integrityHash": "aa3762d164c77041598cf80cf04111c2a3a77c02c5f93ce1e3b733b206439bdf",
      "skos:note": "Specifies period for which ministerial decision is in force."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44n-ss-3",
      "@type": "cof:Section",
      "cof:title": "44N(3) Ministerial decision on effectiveness of access regime",
      "values:kind": "subsection",
      "cof:pageNumber": 182,
      "values:originalText": "(3) The decision must specify the period for which it is in force.\nNote:\nThe period for which the decision is in force may be extended: see\nsection 44NB."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44n-ss-3-norm",
      "@type": "values:Undertaking",
