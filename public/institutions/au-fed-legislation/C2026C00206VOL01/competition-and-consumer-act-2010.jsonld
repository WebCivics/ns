    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44pe-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "44PE(4) Commission may invite public submissions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44pe-ss-4"
