    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44m-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "44M(2) Recommendation for a Ministerial decision on effectiveness of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44m-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.181",
      "values:originalText": "(2) The responsible Minister for the State or Territory may make a\nwritten application to the Council asking the Council to\nrecommend that the Commonwealth Minister decide that the\nregime for access to the service or proposed service is an effective\naccess regime.",
      "skos:definition": "(2) The responsible Minister for the State or Territory may make a\nwritten application to the Council asking the Council to\nrecommend that the Commonwealth Minister decide that the\nregime for access to the service or proposed service is an effective\naccess regime.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44m"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44m-ss-2-norm"
        }
      ],
      "cml:integrityHash": "8aa4d8d0ff48f7abac2024347153c0f7f9970535003511c29cbf740d4f9d5472",
      "skos:note": "Minister may make written application to Council for recommendation on access regime effectiveness"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44m-ss-2",
      "@type": "cof:Section",
      "cof:title": "44M(2) Recommendation for a Ministerial decision on effectiveness of",
      "values:kind": "subsection",
      "cof:pageNumber": 181,
      "values:originalText": "(2) The responsible Minister for the State or Territory may make a\nwritten application to the Council asking the Council to\nrecommend that the Commonwealth Minister decide that the\nregime for access to the service or proposed service is an effective\naccess regime."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44m-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
