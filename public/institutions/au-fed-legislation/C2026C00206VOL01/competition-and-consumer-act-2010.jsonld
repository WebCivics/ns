    {
      "@id": "concept:competition-and-consumer-act-2010-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Qualifications of members of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.101",
      "values:originalText": "(1) A person shall not be appointed as a presidential member of the\nTribunal unless he or she is a Judge of a Federal Court, not being\nthe High Court or a court of an external Territory.\n\n(2) A person shall not be appointed as a member of the Tribunal other\nthan a presidential member unless he or she appears to the\nGovernor-General to be qualified for appointment by virtue of his\nor her knowledge of, or experience in, industry, commerce,\neconomics, law or public administration.",
      "skos:definition": "(1) A person shall not be appointed as a presidential member of the\nTribunal unless he or she is a Judge of a Federal Court, not being\nthe High Court or a court of an external Territory.\n\n(2) A person shall not be appointed as a member of the Tribunal other\nthan a presidential member unless he or she appears to the\nGovernor-General to be qualified for appointment by virtue of his\nor her knowledge of, or experience in, industry, commerce,\neconomics, law or public administration.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-31-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-31-ss-2"
        }
      ],
      "cml:integrityHash": "0079198b11ef6c6e6bd7cd05968d2d67213b2ce5d81cdd5fe850780f89907825"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Qualifications of members of Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 101,
      "values:originalText": "(1) A person shall not be appointed as a presidential member of the\nTribunal unless he or she is a Judge of a Federal Court, not being\nthe High Court or a court of an external Territory.\n\n(2) A person shall not be appointed as a member of the Tribunal other\nthan a presidential member unless he or she appears to the\nGovernor-General to be qualified for appointment by virtue of his\nor her knowledge of, or experience in, industry, commerce,\neconomics, law or public administration."
    },
