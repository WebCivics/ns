      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4ka",
      "@type": "cml:Concept",
      "skos:prefLabel": "4KA Definitions etc. that do not apply in Part XI or Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4ka"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.63",
      "values:originalText": "Despite any other provision of this Act, sections 4 to 4K do not\naffect the meaning of any expression used in Part XI or Schedule 2,\nunless a contrary intention appears.",
      "skos:definition": "Despite any other provision of this Act, sections 4 to 4K do not\naffect the meaning of any expression used in Part XI or Schedule 2,\nunless a contrary intention appears.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-4ka-norm"
        }
      ],
      "cml:integrityHash": "ca487e93ca1b94b9507919e345b52c799948629408be8ed4d700ee735befe9eb",
      "skos:note": "Exemptions for certain expressions in Part XI or Schedule 2"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-4ka",
      "@type": "cof:Section",
      "cof:title": "4KA Definitions etc. that do not apply in Part XI or Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Despite any other provision of this Act, sections 4 to 4K do not\naffect the meaning of any expression used in Part XI or Schedule 2,\nunless a contrary intention appears."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-4ka-norm",
      "@type": "values:Undertaking",
