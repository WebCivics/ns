      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.480",
      "values:originalText": "(5) For the purposes of paragraph (4)(b), the ACMA may only make\nan appointment of a person who is listed on the register of\nbargaining code arbitrators.",
      "skos:definition": "(5) For the purposes of paragraph (4)(b), the ACMA may only make\nan appointment of a person who is listed on the register of\nbargaining code arbitrators.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52zn"
      },
