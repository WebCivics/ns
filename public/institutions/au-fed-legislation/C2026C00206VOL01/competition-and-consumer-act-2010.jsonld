    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52l",
      "@type": "cml:Concept",
      "skos:prefLabel": "52L Requirements for connection between corporation and news",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.458",
      "values:originalText": "business\n\nFor the purposes of this Division, the requirement is that the\ncorporation, either by itself or together with other corporations,\noperates or controls the news business.",
      "skos:definition": "business\n\nFor the purposes of this Division, the requirement is that the\ncorporation, either by itself or together with other corporations,\noperates or controls the news business.",
      "cml:asserts": [
        {
