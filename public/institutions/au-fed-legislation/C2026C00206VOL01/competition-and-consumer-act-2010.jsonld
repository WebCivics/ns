        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45am-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:logicSummary": "Conditional permission",
      "cml:executionSurface": "modalities::logic::deontic",
