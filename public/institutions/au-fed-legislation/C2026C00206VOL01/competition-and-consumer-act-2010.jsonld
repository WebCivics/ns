      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 44ZZOA",
      "cml:conclusionText": "The review by the Tribunal is a reconsideration of the matter between the time limits that apply to the Tribunal’s decision on the review (see section 44ZZOA)"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Tribunal must have regard to specified information and reports",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 44ZZOAA",
      "cml:conclusionText": "The review by the Tribunal is a reconsideration of the matter based on the information, reports and things referred to in section 44ZZOAA"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44o-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Tribunal must make decision within time limits",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 44ZZOA",
      "cml:conclusionText": "The review by the Tribunal is a reconsideration of the matter between the time limits that apply to the Tribunal’s decision on the review (see section 44ZZOA)"
    },
