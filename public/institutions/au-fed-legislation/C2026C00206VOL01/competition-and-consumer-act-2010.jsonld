      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with subsection (4) of section 44AI(5).",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) To avoid doubt, if a State/Territory energy law is also a local\nenergy instrument, subsection (4) applies to the law.",
      "cml:conclusionText": "Subsection (4) applies to the law."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ai-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Recurring trace of merits review prohibition.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
