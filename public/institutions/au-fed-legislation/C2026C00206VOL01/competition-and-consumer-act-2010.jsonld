    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zt-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZT(5) Information request by bargaining party—general",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zt-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
