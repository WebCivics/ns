    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44f-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "44F(5) Person may request recommendation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44f-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.148",
      "values:originalText": "(5) The applicant may withdraw the application at any time before the\nCouncil makes a recommendation relating to it.",
      "skos:definition": "(5) The applicant may withdraw the application at any time before the\nCouncil makes a recommendation relating to it.",
      "values:partOf": {
