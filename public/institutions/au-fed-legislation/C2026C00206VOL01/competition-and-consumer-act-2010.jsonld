    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(3) Deputy Chairpersons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.80",
      "values:originalText": "(3) Where a member of the Commission appointed as Deputy\nChairperson is, upon ceasing to be a Deputy Chairperson by virtue\nof the expiration of the period of his or her appointment as a\nmember, re-appointed as a member, he or she is eligible for\nre-appointment as Deputy Chairperson.",
      "skos:definition": "(3) Where a member of the Commission appointed as Deputy\nChairperson is, upon ceasing to be a Deputy Chairperson by virtue\nof the expiration of the period of his or her appointment as a\nmember, re-appointed as a member, he or she is eligible for\nre-appointment as Deputy Chairperson.",
      "values:partOf": {
