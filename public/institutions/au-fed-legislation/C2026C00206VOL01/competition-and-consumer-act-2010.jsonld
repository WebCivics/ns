    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29b-ss-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "29B(2A) Functions and powers of Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29b-ss-2a"
      },
