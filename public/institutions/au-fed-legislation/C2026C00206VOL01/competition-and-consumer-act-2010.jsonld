      "cml:logicSummary": "Prohibition on giving effect to provisions contravening section 45E",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 45EA imposes a duty on individuals and entities not to give effect to provisions contravening section 45E"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbids",
      "cml:logicSummary": "Prohibition on giving effect to provisions contravening section 45E",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 45EA forbids individuals and entities from giving effect to provisions contravening section 45E"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires prohibition",
      "cml:logicSummary": "Prohibition on giving effect to provisions contravening section 45E",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 45EA requires a prohibition on giving effect to provisions contravening section 45E"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "enforces prohibition",
      "cml:logicSummary": "Prohibition on giving effect to provisions contravening section 45E",
      "cml:executionSurface": "modalities::logic::deontic",
