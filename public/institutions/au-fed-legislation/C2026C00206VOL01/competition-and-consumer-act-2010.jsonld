          "@id": "concept:competition-and-consumer-act-2010-sec-47-ss-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "7892d0e09d40985de650c02cd71eda6b7bbc01fd6f854dcaa75c5264536e0d39",
      "skos:note": "Refusal to supply goods or services under certain conditions."
