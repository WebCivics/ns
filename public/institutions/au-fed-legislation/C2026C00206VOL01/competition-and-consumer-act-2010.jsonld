    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zx-ss-5b",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZX(5B) Review of decision not to register contract",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zx-ss-5b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
