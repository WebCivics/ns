    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zy-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZY(2) Final offer arbitration—termination of arbitration if no final",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zy-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.488",
      "values:originalText": "(2) In considering the matters set out in subsection (1), the panel must\nconsider the bargaining power imbalance between Australian news\nbusinesses and the designated digital platform corporation.\n52ZZA  Other requirements for arbitration determination",
      "skos:definition": "(2) In considering the matters set out in subsection (1), the panel must\nconsider the bargaining power imbalance between Australian news\nbusinesses and the designated digital platform corporation.\n52ZZA  Other requirements for arbitration determination",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52zy"
      },
      "cml:asserts": [
