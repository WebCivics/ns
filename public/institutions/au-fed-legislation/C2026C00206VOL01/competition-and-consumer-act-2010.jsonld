      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-40-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Member has a duty to disclose pecuniary interest.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Presidential member to preside",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.106",
      "values:originalText": "The presidential member who is a member of a Division shall\npreside at proceedings of that Division.",
      "skos:definition": "The presidential member who is a member of a Division shall\npreside at proceedings of that Division.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-41-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-41-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "19a4eda7a783cd52421bb988ad4b74d2c80a861b53d434dccb245f9cb9c07661",
      "skos:note": "Presidential member must preside at Division proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Presidential member to preside",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "The presidential member who is a member of a Division shall\npreside at proceedings of that Division."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-41-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
