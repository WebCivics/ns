      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ka-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Council must be given a reasonable opportunity to make submissions before making an order under subsection (2)",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Council has not been given a reasonable opportunity to make a submission.",
      "cml:conclusionText": "The Tribunal must not make an order under subsection (2)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ka-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Council and the person who requested the making of the order under paragraph (2)(a) must be given a reasonable opportunity to make submissions before making an order varying or revoking an existing order.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Council has not been given a reasonable opportunity to make a submission.",
      "cml:conclusionText": "The Tribunal must not make an order varying or revoking an existing order under paragraph (2)(a)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44ka-ss-4",
