    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zi-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZI(3) Obligation to notify Commission if agreement reached",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zi-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.474",
      "values:originalText": "(3) Despite subsection 14(2) of the Legislation Act 2003, regulations\nmade for the purposes of subsection (1) may make provision in\nrelation to a matter by applying, adopting or incorporating, with or\nwithout modification, any matter contained in an instrument or\nother writing as in force or existing from time to time.",
      "skos:definition": "(3) Despite subsection 14(2) of the Legislation Act 2003, regulations\nmade for the purposes of subsection (1) may make provision in\nrelation to a matter by applying, adopting or incorporating, with or\nwithout modification, any matter contained in an instrument or\nother writing as in force or existing from time to time.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52zi"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zi-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52zi-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a6ddeec28077ab170cfdb554987182c9d8f5d92d6be571dc0259efb00cb8bde8",
      "skos:note": "Notify Commission of agreement reached in good faith negotiations. Regulations may incorporate existing instruments or writings."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zi-ss-3",
      "@type": "cof:Section",
      "cof:title": "52ZI(3) Obligation to notify Commission if agreement reached",
      "values:kind": "subsection",
      "cof:pageNumber": 474,
      "values:originalText": "(3) Despite subsection 14(2) of the Legislation Act 2003, regulations\nmade for the purposes of subsection (1) may make provision in\nrelation to a matter by applying, adopting or incorporating, with or\nwithout modification, any matter contained in an instrument or\nother writing as in force or existing from time to time."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zi-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52zi-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
