    {
      "@id": "concept:competition-and-consumer-act-2010-sec-29c",
      "@type": "cml:Concept",
      "skos:prefLabel": "29C Membership of Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.95",
      "values:originalText": "(1) The Council consists of the Council President and up to 4 other\nCouncillors.\n\n(2) Each Councillor is to be appointed by the Governor-General, for a\nterm of up to 5 years.\n\n(3) The Governor-General must not appoint a person as a Councillor\nor Council President unless the Governor-General is satisfied that:\n\n(a) the person qualifies for the appointment because of the\nperson’s knowledge of, or experience in, industry,\ncommerce, economics, law, consumer protection or public\nadministration; and\n\n(b) a majority of the States and Territories that are parties to the\nCompetition Principles Agreement support the appointment.",
      "skos:definition": "(1) The Council consists of the Council President and up to 4 other\nCouncillors.\n\n(2) Each Councillor is to be appointed by the Governor-General, for a\nterm of up to 5 years.\n\n(3) The Governor-General must not appoint a person as a Councillor\nor Council President unless the Governor-General is satisfied that:\n\n(a) the person qualifies for the appointment because of the\nperson’s knowledge of, or experience in, industry,\ncommerce, economics, law, consumer protection or public\nadministration; and\n\n(b) a majority of the States and Territories that are parties to the\nCompetition Principles Agreement support the appointment.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29c-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29c-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-29c-ss-3"
        }
      ],
      "cml:integrityHash": "e91d7a15b861657c33384cf518ea3a474771c60d4d99e8ca098f1181cc1bb0d0"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29c",
      "@type": "cof:Section",
      "cof:title": "29C Membership of Council",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "(1) The Council consists of the Council President and up to 4 other\nCouncillors.\n\n(2) Each Councillor is to be appointed by the Governor-General, for a\nterm of up to 5 years.\n\n(3) The Governor-General must not appoint a person as a Councillor\nor Council President unless the Governor-General is satisfied that:\n\n(a) the person qualifies for the appointment because of the\nperson’s knowledge of, or experience in, industry,\ncommerce, economics, law, consumer protection or public\nadministration; and\n\n(b) a majority of the States and Territories that are parties to the\nCompetition Principles Agreement support the appointment."
    },
