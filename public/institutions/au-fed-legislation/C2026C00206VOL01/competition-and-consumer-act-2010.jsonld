        }
      ],
      "cml:integrityHash": "de4f2ab701371ac4410d81714dac996510cdda02c2f2d93d997b180f92a99d97",
      "skos:note": "Annual report requirements",
      "dc:description": "Details of Chapter 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-29o",
      "@type": "cof:Section",
      "cof:title": "29O Annual report",
      "values:kind": "section",
      "cof:pageNumber": 99,
      "values:originalText": "An annual report prepared by the Council President and given to\nthe Minister under section 46 of the Public Governance,\nPerformance and Accountability Act 2013 for a period must\ninclude details of the following:\n\nChapter 1  Preliminary"
    },
