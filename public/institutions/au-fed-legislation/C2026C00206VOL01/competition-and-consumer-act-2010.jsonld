        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 45EA prohibits giving effect to provisions contravening section 45E"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-45ea-logic-deontic-2",
