      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44na-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "44NA(4) Recommendation by Council",
