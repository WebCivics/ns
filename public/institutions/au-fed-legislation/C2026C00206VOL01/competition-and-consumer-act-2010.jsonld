    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44la",
      "@type": "cml:Concept",
      "skos:prefLabel": "44LA Constitutional limits on operation of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44la"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.165",
      "values:originalText": "This Division does not apply in relation to a service unless:\n\n(a) the person who is, or expects to be, the provider of the\nservice is a corporation (or a partnership or joint venture\nconsisting wholly of corporations); or\n\n(b) access to the service is (or would be) in the course of, or for\nthe purposes of, constitutional trade or commerce.\nSubdivision B—Ineligibility recommendation by Council",
      "skos:definition": "This Division does not apply in relation to a service unless:\n\n(a) the person who is, or expects to be, the provider of the\nservice is a corporation (or a partnership or joint venture\nconsisting wholly of corporations); or\n\n(b) access to the service is (or would be) in the course of, or for\nthe purposes of, constitutional trade or commerce.\nSubdivision B—Ineligibility recommendation by Council",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44la-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44la-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dfd8106510e52e1bcec98710bd44edf4a18551189e8a737351837263b0274640",
      "skos:note": "Service provision is subject to constitutional limits."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44la",
      "@type": "cof:Section",
      "cof:title": "44LA Constitutional limits on operation of this Division",
      "values:kind": "section",
      "cof:pageNumber": 165,
      "values:originalText": "This Division does not apply in relation to a service unless:\n\n(a) the person who is, or expects to be, the provider of the\nservice is a corporation (or a partnership or joint venture\nconsisting wholly of corporations); or\n\n(b) access to the service is (or would be) in the course of, or for\nthe purposes of, constitutional trade or commerce.\nSubdivision B—Ineligibility recommendation by Council"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44la-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-44la"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44la-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits service provision under certain conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "None",
      "cml:conclusionText": "None"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44lb",
      "@type": "cml:Concept",
      "skos:prefLabel": "44LB Ineligibility recommendation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44lb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.165",
      "values:originalText": "Person may request recommendation\n\n(1) A person with a material interest in a particular service proposed to\nbe provided by means of a proposed facility may make a written\napplication to the Council asking the Council to recommend that\nthe designated Minister decide that the service is ineligible to be a\ndeclared service.\nNote:\nThe application must be made before construction of the facility\ncommences: see the definition of proposed facility in section 44B.\nCouncil must make recommendation\n\n(2) After receiving the application, the Council must, after having\nregard to the objects of this Part:\n\n(a) recommend to the designated Minister:\n\n(i) that he or she decide that the service is ineligible to be a\ndeclared service; and\n\n(ii) the period for which the decision should be in force\n(which must be at least 20 years); or\n\nChapter 2  Access to services",
      "skos:definition": "Person may request recommendation\n\n(1) A person with a material interest in a particular service proposed to\nbe provided by means of a proposed facility may make a written\napplication to the Council asking the Council to recommend that\nthe designated Minister decide that the service is ineligible to be a\ndeclared service.\nNote:\nThe application must be made before construction of the facility\ncommences: see the definition of proposed facility in section 44B.\nCouncil must make recommendation\n\n(2) After receiving the application, the Council must, after having\nregard to the objects of this Part:\n\n(a) recommend to the designated Minister:\n\n(i) that he or she decide that the service is ineligible to be a\ndeclared service; and\n\n(ii) the period for which the decision should be in force\n(which must be at least 20 years); or\n\nChapter 2  Access to services",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44lb-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-44lb-ss-2"
        }
      ],
      "cml:integrityHash": "0e4c98caf34f2dec4cda6639c64073d6d7b5250363263e63fc024e466bbbdb4a"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44lb",
      "@type": "cof:Section",
      "cof:title": "44LB Ineligibility recommendation",
      "values:kind": "section",
      "cof:pageNumber": 165,
      "values:originalText": "Person may request recommendation\n\n(1) A person with a material interest in a particular service proposed to\nbe provided by means of a proposed facility may make a written\napplication to the Council asking the Council to recommend that\nthe designated Minister decide that the service is ineligible to be a\ndeclared service.\nNote:\nThe application must be made before construction of the facility\ncommences: see the definition of proposed facility in section 44B.\nCouncil must make recommendation\n\n(2) After receiving the application, the Council must, after having\nregard to the objects of this Part:\n\n(a) recommend to the designated Minister:\n\n(i) that he or she decide that the service is ineligible to be a\ndeclared service; and\n\n(ii) the period for which the decision should be in force\n(which must be at least 20 years); or\n\nChapter 2  Access to services"
    },
