      "cml:operator": "requires",
      "cml:logicSummary": "Requires user interaction.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the content is reproduced on the service, or is otherwise placed on the service, and the user interacts with the content;",
      "cml:conclusionText": "User interaction with content on a service."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52c-ss-1-logic-deontic-2",
