        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-52h-ss-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "e79931d80d7ffef115d18c2ed0c2bdaeed3b84e923e0359d1a7b3ee85daeed31",
      "skos:note": "Revocation of endorsement for non-compliance with section 52L"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52h-ss-6",
      "@type": "cof:Section",
      "cof:title": "52H(6) Revocation of registration or endorsement—general",
      "values:kind": "subsection",
      "cof:pageNumber": 454,
      "values:originalText": "(6) The ACMA may revoke the endorsement of a registered news\nbusiness corporation as the registered news business corporation\nfor a registered news business if the ACMA considers that the\ncorporation does not meet the requirement in section 52L\n(connection between corporation and news business) in relation to\nthe registered news business.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.\nPart IVBA  News media and digital platforms mandatory bargaining code"
    },
