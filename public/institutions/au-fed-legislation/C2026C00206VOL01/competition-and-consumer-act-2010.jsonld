    {
      "@id": "concept:competition-and-consumer-act-2010-sec-44zn-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "44ZN(6) Parties to pay costs of an arbitration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-44zn-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
