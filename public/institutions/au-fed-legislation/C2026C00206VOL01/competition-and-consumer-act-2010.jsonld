        }
      ],
      "cml:integrityHash": "352fd8e15c787b6ef9e9f07fb77b53b69449d68d397280f3a9e08bd2ed963f5d",
      "skos:note": "Corporation must operate or control news business"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52l",
      "@type": "cof:Section",
      "cof:title": "52L Requirements for connection between corporation and news",
      "values:kind": "section",
      "cof:pageNumber": 458,
      "values:originalText": "business\n\nFor the purposes of this Division, the requirement is that the\ncorporation, either by itself or together with other corporations,\noperates or controls the news business."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52l-norm",
      "@type": "values:Obligation",
