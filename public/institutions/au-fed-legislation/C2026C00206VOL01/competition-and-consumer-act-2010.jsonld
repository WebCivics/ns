      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "onlyIf",
      "cml:logicSummary": "ACMA's appointment is conditional on the person being listed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person to be appointed must be listed on the register.",
      "cml:conclusionText": "Appointment made only if condition met."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "The appointment is conditional on the person being listed during a specific period.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person to be appointed must be listed before appointment.",
      "cml:conclusionText": "Appointment made only if condition met."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "The appointment is conditional on the person being listed until a certain point in time.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person to be appointed must be listed before appointment.",
      "cml:conclusionText": "Appointment made only if condition met."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustBe",
      "cml:logicSummary": "The appointment is conditional on the person being a registered arbitrator.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person to be appointed must be an arbitrator.",
      "cml:conclusionText": "Appointment made only if condition met."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-5-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustBe",
      "cml:logicSummary": "The appointment is conditional on the person being listed before appointment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person to be appointed must be listed before appointment.",
      "cml:conclusionText": "Appointment made only if condition met."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-52zn-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "52ZN(6) Disclosure of conflicts of interest where ACMA appoints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-52zn-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.480",
      "values:originalText": "(6) For the purposes of this section, a person has a conflict of interest\nin relation to the arbitration if the person has any interest,\npecuniary or otherwise, that could conflict with the proper\nperformance of the person’s functions in relation to the arbitration.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nArbitration about remuneration issue  Division 7\n\nSection 52ZO\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(6) For the purposes of this section, a person has a conflict of interest\nin relation to the arbitration if the person has any interest,\npecuniary or otherwise, that could conflict with the proper\nperformance of the person’s functions in relation to the arbitration.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nNews media and digital platforms mandatory bargaining code  Part IVBA\nArbitration about remuneration issue  Division 7\n\nSection 52ZO\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-52zn"
      },
