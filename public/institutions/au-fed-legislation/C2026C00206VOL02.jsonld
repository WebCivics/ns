    {
      "@id": "concept:competition-and-consumer-act-2010-sec-76b-ss-5",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.328",
      "skos:note": "Prevents admissibility of evidence in criminal proceedings if individual previously gave the same evidence or produced documents in a previous proceeding for a pecuniary penalty order.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "76B(5) Consequences in some cases if substantially the same conduct"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sec-76b-ss-5-norm",
        "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-deontic-1",
