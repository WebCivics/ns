    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ev-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...10% of the adjusted turnover of the body corporate during the 12-month period ending at the end of the month in which the contravention happened or began.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Limits maximum penalty to within 12-month period",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "(2) For the purposes of subsection (1), the maximum penalty amount for a contravention by a body corporate of a privacy safeguard penalty provision is..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ev-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...if that court cannot determine the value of that benefit—10% of the adjusted turnover of the body corporate during the 12-month period ending at the end of the month in which the contravention happened or began.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Analyzes benefit value for calculation",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Analyze",
      "cml:premiseText": "(2) For the purposes of subsection (1), the maximum penalty amount for a contravention by a body corporate of a privacy safeguard penalty provision is..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ev-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the greater of the following:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits contravention of privacy safeguard penalty provision",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(2) For the purposes of subsection (1), the maximum penalty amount for a contravention by a body corporate of a privacy safeguard penalty provision is..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ev-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and that is reasonably attributable to the contravention—3 times the value of that benefit;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
