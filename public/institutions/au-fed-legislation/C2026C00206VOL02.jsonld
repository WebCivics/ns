    {
      "@id": "concept:competition-and-consumer-act-2010-sec-109-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1AA) A notifying party of a notification of an acquisition is entitled to participate in any proceedings before the Tribunal under Division 1B instituted by another person for review of an acquisition determination in respect of the notification.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has right to participate",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRight",
      "cml:premiseText": "(1) A person to whom an authorisation under Division 1 of Part VII was granted is entitled to participate in any proceedings before the Tribunal instituted by another person in relation to that authorisation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-109-logic-deontic-3",
