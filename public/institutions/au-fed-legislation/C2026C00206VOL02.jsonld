    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.352",
      "skos:note": "Findings and admissions of fact in proceedings are prima facie evidence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "83(1) Findings and admissions of fact in proceedings to be evidence"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sec-83-ss-1-norm",
        "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-2",
        "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-epistemic-3",
        "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-ltl-4",
        "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "355c2c146a0d730b8f7b6ce6d073b4ca8892e8ae2cdc2124deedb338cb47c347",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sec-83-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sec-83"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, these findings and admissions are prima facie evidence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to provide prima facie evidence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Findings and admissions of fact in proceedings are made in certain types of proceedings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, permission to provide prima facie evidence is not required.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission to provide prima facie evidence is not required.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "There is no requirement for a person to provide prima facie evidence in proceedings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, there is an obligation on the person to provide prima facie evidence in certain types of proceedings.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "There is an obligation on the person to provide prima facie evidence in certain types of proceedings.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The court's findings are a basis for the admission of prima facie evidence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, findings and admissions of fact in proceedings are justified by the court's findings.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Findings and admissions of fact in proceedings are justified by the court's findings.",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Justification",
      "cml:premiseText": "The court's findings are a justification for the admission of prima facie evidence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, findings and admissions of fact in proceedings have a temporal relation to the proceedings.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Findings and admissions of fact in proceedings have a temporal relation to the proceedings.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "TemporalRelation",
      "cml:premiseText": "The findings and admissions of fact in proceedings occur at the same time as the proceedings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
