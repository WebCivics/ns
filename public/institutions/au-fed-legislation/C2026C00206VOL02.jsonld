      },
      "cml:operator": "permission",
      "cml:premiseText": "(2) This Subdivision does not:  (ii) an SPF infringement notice issued to the person for the crime is withdrawn under section 58FU;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fn-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The subdivision permits non-compliance with the notice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
