        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to balance competing interests",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(3) In deciding whether or not to exclude a part of the report from publication, the Information Commissioner must:  (a) have regard to the need to prevent the matters in subsection 33(2) of the Privacy Act 1988; and  (b) try to achieve an appropriate balance between the need to prevent those matters and the desirability of ensuring that interested persons are sufficiently informed of the Information Commissioner’s analysis in the report."
    },
