    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bz-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The action must end before 28 days after the entity reasonably believes that the activity is or is not a scam.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The action must be taken during the period when the intelligence becomes actionable scam intelligence for the entity.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The action must start on the day that the intelligence becomes actionable scam intelligence for the entity."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bz-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The regulated entity is not liable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The regulated entity has an obligation not to be liable for taking action to disrupt an activity.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The action must be taken in good faith, compliance with SPF provisions, and proportionate to the activity."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bz-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The regulated entity has permission to take action to disrupt an activity.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The regulated entity has permission to take action to disrupt an activity if it is taken in good faith, compliance with SPF provisions, and proportionate to the activity.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "The action must be taken in good faith, compliance with SPF provisions, and proportionate to the activity."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bz-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The action must be reversed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The action must be promptly reversed if the entity identifies that the activity is not a scam.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "The entity identifies that the activity is not a scam."
    },
