      "@id": "concept:competition-and-consumer-act-2010-sec-58fx-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Court may grant an injunction under section 58FW restraining a person from engaging in conduct:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of conduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) whether or not it appears to the Court that the person intends to engage again, or to continue to engage, in conduct of that kind;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fx-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Court may grant an injunction under section 58FW restraining a person from engaging in conduct:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of conduct without regard to intent or previous engagement.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) whether or not the person has previously engaged in conduct of that kind;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fx-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Court may grant an injunction under section 58FW restraining a person from engaging in conduct:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of conduct without regard to imminent danger.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) whether or not there is an imminent danger of substantial damage to any person if the first-mentioned person engages in conduct of that kind;"
    },
