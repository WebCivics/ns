      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defendant became aware of matter or circumstance capable of constituting reason for their action within 6 months before the time of the action",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(c) during the period of 6 months immediately before the time when the defendant so acted, the defendant became aware of a matter or circumstance capable of constituting a reason referred to in paragraph 96(3)(d) or (e) for the defendant’s so acting;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "then, subject to subsection (2), it shall be presumed, unless the contrary is established, that that matter or circumstance was the reason for the defendant’s so acting.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Defendant has a duty to provide reason for their action",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(a) the defendant has acted, in relation to the plaintiff, as mentioned in paragraph 98(1)(a), (b), (c) or (d);"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Defendant is permitted to act as mentioned in paragraph 98(1)(a), (b), (c) or (d)",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(a) the defendant has acted, in relation to the plaintiff, as mentioned in paragraph 98(1)(a), (b), (c) or (d);"
    },
