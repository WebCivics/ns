      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Minister must consider matters and consult.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(1) Before making an instrument under subsection 58AC(1) about a sector of the economy, the Minister must:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ae-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Minister must consult businesses or services making up the sector.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) Consult the businesses or services making up the sector, or such associations or other bodies representing them as the Minister thinks appropriate;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ae-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Minister must consult persons who would be SPF consumers of regulated services for the sector.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(c) Consult such associations or other bodies representing the persons referred to in subparagraph (a)(iii) as the Minister thinks appropriate."
    },
