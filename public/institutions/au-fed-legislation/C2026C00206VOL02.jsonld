      "partOf": "concept:competition-and-consumer-act-2010-sec-83-ss-1"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-2",
      "@type": "cml:Concept",
      "dc:description": "Yes",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.352",
      "skos:note": "Produce a document under court seal to prove a finding or admission.",
      "skos:prefLabel": {
