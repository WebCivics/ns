      },
      "cml:operator": "if-then",
      "cml:premiseText": "(a) the act or omission is by (or on behalf of) an Australian person"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ao-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "CDR provisions apply",
