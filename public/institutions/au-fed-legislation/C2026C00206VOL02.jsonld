    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual's current evidence is not admissible if it overlaps with their previous evidence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval during which the individual's evidence is not admissible",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The individual's previous evidence was given before the current proceeding"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The system applies the exemption to the individual's current evidence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Defines how the system recognizes the exemption",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "The system recognizes the individual's previous evidence as exempt from admissibility"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Individual's previous evidence is not admissible",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prevents admissibility of evidence",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "State prohibits admissibility"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual's current evidence is not admissible if it includes documents that were previously given or produced in a pecuniary penalty order",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Defines how the prohibition applies to related information",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "The individual's previous evidence includes documents that are also relevant to the current proceeding"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual's current evidence is not admissible until their previous evidence is no longer relevant",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines the temporal interval during which the individual's evidence is not admissible",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "The individual's previous evidence was given before the current proceeding"
    },
