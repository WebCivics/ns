        "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-ltl-3",
        "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-diffusion-4",
        "concept:competition-and-consumer-act-2010-sec-76b-ss-5-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "ac5df5c476f5402dff65e428b7e770bf8eae1e9124aeebad6827d7d68ea1b7e3",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
