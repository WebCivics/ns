    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.490",
      "skos:note": "Supplies goods or services at a particular price exceeds the highest price supplied in the same locality and terms within 12 months.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "95Z(1) Price restrictions"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sec-95z-ss-1-norm",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-1-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-1-logic-alleninterval-2",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-1-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "c688e0a98e60df8ce092a3c5d32bea4d52524ea480e03e29a40b99f76a7d82d6",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sec-95z-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sec-95z"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The actual price exceeds the highest price at which the person has supplied goods or services of that description in that locality on the same or substantially similar terms and conditions in that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the time period within which the supply must be made.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(c) the person has supplied goods or services of that description in that locality on the same or substantially similar terms and conditions in the period of 12 months before the current supply;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits supplying goods or services at a particular price.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person is a declared person in relation to notified goods or services;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty to supply goods or services at a particular price.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(d) the actual price exceeds the highest price at which the person has supplied goods or services of that description in that locality on the same or substantially similar terms and conditions in that period;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-1-norm",
      "@type": "doc:Prohibition",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:competition-and-consumer-act-2010-sec-95z-ss-1"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-2",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.490",
      "skos:note": "Supplies goods or services of a particular description on substantially similar terms and conditions within the last 12 months in Australia, exceeding the highest price paid for those goods or services elsewhere in Australia.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "95Z(2) Price restrictions"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sec-95z-ss-2-norm",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-alleninterval-2",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-ltl-3",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-diffusion-4",
        "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "778a1cdf1b316667ed17dd07f8e03bb97887fa804ccb2070832fb2afa370747b",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sec-95z-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sec-95z"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The current supply overlaps with supplies of goods or services on substantially similar terms and conditions within the last 12 months in Australia, exceeding the highest price paid for those goods or services elsewhere in Australia.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If a person supplies goods or services of a particular description on substantially similar terms and conditions within the last 12 months in Australia, exceeding the highest price paid for those goods or services elsewhere in Australia, then they commit an offence.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits supplying goods or services on substantially similar terms and conditions within the last 12 months in Australia, exceeding the highest price paid for those goods or services elsewhere in Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The current supply diffuses supplies of goods or services on substantially similar terms and conditions within the last 12 months in Australia, exceeding the highest price paid for those goods or services elsewhere in Australia.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95z-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The current supply repeats supplies of goods or services on substantially similar terms and conditions within the last 12 months in Australia, exceeding the highest price paid for those goods or services elsewhere in Australia.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats"
    },
