    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56aq-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The CDR provisions apply to the Crown's capacities from the time they come into effect until they are repealed or amended.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
