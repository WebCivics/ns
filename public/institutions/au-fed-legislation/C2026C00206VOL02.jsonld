      "cml:logicSummary": "Conditional obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "(c) the act or omission occurs wholly outside Australia, and an Australian person suffers, or is likely to suffer, financial or other disadvantage as a result of the act or omission"
    },
