    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bz-ss-2",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.222",
      "skos:note": "The regulated entity is not liable for taking action to disrupt an activity if it is taken in good faith, compliance with SPF provisions, and proportionate to the activity.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "58BZ(2) Sector-specific details can be set out in SPF codes"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
