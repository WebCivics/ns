    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.352",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "83 Findings and admissions of fact in proceedings to be evidence"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:hasPart": [
