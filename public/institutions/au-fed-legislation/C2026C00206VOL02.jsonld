      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The CDR entity will destroy the redundant data during the period it retains it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
