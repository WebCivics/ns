      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "(b) the act or omission occurs wholly or partly in Australia, or wholly or partly on board an Australian aircraft or an Australian ship"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ao-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "CDR provisions apply",
      "cml:confidence": {
