    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The acquirer must divest shares or assets.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Acquirer has an obligation to divest shares or assets.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The acquirer was granted a merger authorization on false information."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Court may grant permission for divestiture.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court may grant permission for divestiture if certain conditions are met.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "The Court or another court has found that the acquirer or related body corporate has contravened section 92 or Part 7.4 of the Criminal Code."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The acquirer must ensure that the acquisition would not have contravened section 50.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Acquirer must ensure that the acquisition would not have contravened section 50 without the authorization.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Apart from the authorisation, the acquisition would have contravened section 50."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Court must ensure that the authorisation would not have been granted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must ensure that the authorisation would not have been granted without the false information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "If that information had not been given, the authorisation would not have been granted."
    },
