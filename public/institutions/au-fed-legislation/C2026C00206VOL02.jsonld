      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.384",
      "skos:note": "If a cause of action is founded on the death or injury to a minor, disregard any period before the victim turns 25.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "87K(1) The effect of close relationships"
