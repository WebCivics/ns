      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The changes set out in this section apply to a partnership as if it were a person."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ga-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An artificial intelligence system must ensure that all partners comply with the SPF provisions if one partner is classified as an individual for compliance purposes.",
