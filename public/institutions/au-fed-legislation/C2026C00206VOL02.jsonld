        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to disregard periods before the victim turns 25.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "(1) If:..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87k-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...disregard any period:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "If a cause of action is founded on the death or injury to a minor, then disregard any period before the victim turns 25.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "(1) If:..."
    },
