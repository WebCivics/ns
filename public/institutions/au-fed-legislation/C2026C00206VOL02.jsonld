      },
      "cml:operator": "MUST",
      "cml:premiseText": "(3) In deciding whether or not to exclude a part of the report from publication, the Information Commissioner must:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56af-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
