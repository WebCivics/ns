    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86d-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adverse publicity order applies during the period from when it is made to when the person is no longer guilty or has paid the penalty",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
