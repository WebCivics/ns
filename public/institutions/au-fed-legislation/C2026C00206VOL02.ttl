    <https://ns.webcivics.net/cml/premiseText> "The entity identifies that the activity is not a scam.";
    <https://ns.webcivics.net/cml/conclusionText> "The action must be reversed.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
