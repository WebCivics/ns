competition-and-consumer-act-2010-sec-95n-ss-3-logic-1549 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sec-95n-ss-3;
  logic: Deontic;
  operator: forbid;
  summary: Prohibits supplying goods or services on particular terms and conditions before the applicable day.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (3) The person commits an offence if: (a) before the applicable day in relation to the business notice, the person supplies (the current supply) goods or services of that description in a locality on particular terms and conditions; and;
  @action: The person must not supply goods or services on particular terms and conditions before the applicable day.;
}

