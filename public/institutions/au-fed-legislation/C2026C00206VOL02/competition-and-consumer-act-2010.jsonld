    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58gf",
      "@type": "cml:Concept",
      "skos:prefLabel": "58GF Report of the operation of the SPF provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58gf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
