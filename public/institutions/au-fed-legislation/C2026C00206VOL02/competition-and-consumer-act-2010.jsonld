      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.65",
      "values:originalText": "(2) Without limiting paragraph 56BB(a), the consumer data rules may\ninclude the following rules:\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(2) Without limiting paragraph 56BB(a), the consumer data rules may\ninclude the following rules:\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-56bc"
      },
      "cml:asserts": [
