      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chargeable CDR data is disclosed in chargeable circumstances if it is disclosed in circumstances specified:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person is a voluntary action service provider if...",
      "cml:conclusionText": "...and the person holds an approval under the consumer data rules"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:logicSummary": "Conditional permission based on accreditation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person is a voluntary action service provider if...",
      "cml:conclusionText": "...and the person holds an approval under the consumer data rules"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-alleninterval-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal interval for application to be approved",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person will need to have applied to be approved as an action service provider...",
      "cml:conclusionText": "...for that type of CDR action"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-deontic-7",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Definition of accredited action initiator",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person is an accredited action initiator for a type of CDR action if...",
      "cml:conclusionText": "...and the person’s accreditation authorises the person to initiate that type of CDR action"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-descriptionlogic-8",
      "@type": "cml:LogicApplication",
      "cml:modality": {
