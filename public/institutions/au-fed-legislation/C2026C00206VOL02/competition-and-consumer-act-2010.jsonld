    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "79A(2) Enforcement and recovery of certain fines",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-79a-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.335",
      "values:originalText": "(2) Where a person in relation to whom an order is made under\nsubsection (1) in respect of a fine gives security for the payment of\nthe fine, the Court shall cancel the order in respect of the fine.",
      "skos:definition": "(2) Where a person in relation to whom an order is made under\nsubsection (1) in respect of a fine gives security for the payment of\nthe fine, the Court shall cancel the order in respect of the fine.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-79a"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-79a-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-79a-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "73ac2b82eb4d567bc10726b9b2d590c8e2177e05a94510e8cd9c114e02239373",
      "skos:note": "Court must cancel order in respect of fine if person provides security for payment.",
      "dc:description": "Security for payment of fine"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-79a-ss-2",
      "@type": "cof:Section",
      "cof:title": "79A(2) Enforcement and recovery of certain fines",
      "values:kind": "subsection",
      "cof:pageNumber": 335,
      "values:originalText": "(2) Where a person in relation to whom an order is made under\nsubsection (1) in respect of a fine gives security for the payment of\nthe fine, the Court shall cancel the order in respect of the fine."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79a-ss-2-norm",
