      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.485",
      "values:originalText": "(2) Subsection (1) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "(2) Subsection (1) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "values:partOf": {
