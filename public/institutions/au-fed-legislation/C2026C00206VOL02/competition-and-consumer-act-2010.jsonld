      "cml:integrityHash": "7f744b97b6b1ecc555232352426543fcef658639261c378903826c8bd4dc242e",
      "skos:note": "Court must not award personal injury damages for non-economic loss in most extreme cases. Court must not award personal injury damages for non-economic loss exceeding a certain percentage."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87p-ss-1",
      "@type": "cof:Section",
      "cof:title": "87P(1) Most extreme cases",
      "values:kind": "subsection",
      "cof:pageNumber": 386,
      "values:originalText": "(1) The court must not award as personal injury damages for\nnon-economic loss the maximum amount of damages for\nnon-economic loss except in a most extreme case."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
