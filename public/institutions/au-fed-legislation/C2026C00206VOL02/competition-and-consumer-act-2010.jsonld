    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "60P(7) Infringement notice compliance period for infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60p-ss-7"
      },
