      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ef",
      "@type": "cml:Concept",
      "skos:prefLabel": "57EF Mediation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ef"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.187",
      "values:originalText": "(1) Subject to this section, a mediator appointed by the parties to a\ndispute may decide the time and place for mediation.\n\n(2) The mediator may, with the agreement of the parties to the dispute,\nappoint a technical expert to assist in the resolution of the dispute.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) Subject to this section, a mediator appointed by the parties to a\ndispute may decide the time and place for mediation.\n\n(2) The mediator may, with the agreement of the parties to the dispute,\nappoint a technical expert to assist in the resolution of the dispute.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ef-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ef-ss-2"
        }
      ],
      "cml:integrityHash": "2fa37dae36e71ed82a184d43f8abe576ae6d38ebff2c3211f4c39fd4f9bb983b"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ef",
      "@type": "cof:Section",
      "cof:title": "57EF Mediation",
      "values:kind": "section",
      "cof:pageNumber": 187,
      "values:originalText": "(1) Subject to this section, a mediator appointed by the parties to a\ndispute may decide the time and place for mediation.\n\n(2) The mediator may, with the agreement of the parties to the dispute,\nappoint a technical expert to assist in the resolution of the dispute.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
