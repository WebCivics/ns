      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ao-ss-3a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "apply",
      "cml:logicSummary": "Applicability of CDR provisions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "CDR provisions have effect in relation to a CDR action to be performed within Australia.",
      "cml:conclusionText": "The CDR provisions apply in relation to all persons (including foreign persons)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ao-ss-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "56AO(3B) Extraterritorial operation of the CDR provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ao-ss-3b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.54",
      "values:originalText": "(3B) To the extent that the CDR provisions have effect in relation to an\nact, or omission, relating to a CDR action to be performed outside\nAustralia, the CDR provisions only apply if:\n\n(a) the act or omission is by (or on behalf of) an Australian\nperson; or\n\n(b) the act or omission occurs wholly or partly in Australia, or\nwholly or partly on board an Australian aircraft or an\nAustralian ship.\nExample: Requirements in the consumer data rules relating to giving a valid\ninstruction for the performance of a CDR action outside Australia can\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(3B) To the extent that the CDR provisions have effect in relation to an\nact, or omission, relating to a CDR action to be performed outside\nAustralia, the CDR provisions only apply if:\n\n(a) the act or omission is by (or on behalf of) an Australian\nperson; or\n\n(b) the act or omission occurs wholly or partly in Australia, or\nwholly or partly on board an Australian aircraft or an\nAustralian ship.\nExample: Requirements in the consumer data rules relating to giving a valid\ninstruction for the performance of a CDR action outside Australia can\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-56ao"
      },
      "cml:asserts": [
