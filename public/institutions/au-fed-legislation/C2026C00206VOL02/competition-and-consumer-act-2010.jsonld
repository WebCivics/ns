    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ca-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CA(3) Granting accreditations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ca-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.102",
      "values:originalText": "(3) An accreditation is granted on the basis that no compensation is\npayable if the accreditation is varied, transferred, suspended,\nrevoked or surrendered in any way.",
      "skos:definition": "(3) An accreditation is granted on the basis that no compensation is\npayable if the accreditation is varied, transferred, suspended,\nrevoked or surrendered in any way.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-56ca"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ca-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ca-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "998795b6fe8f6f6eee0ed4e99e265792e499448b1edc1f6df7a2cfff957dbf8b",
      "skos:note": "No compensation is payable if accreditation is varied, transferred, suspended, or revoked."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ca-ss-3",
      "@type": "cof:Section",
      "cof:title": "56CA(3) Granting accreditations",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(3) An accreditation is granted on the basis that no compensation is\npayable if the accreditation is varied, transferred, suspended,\nrevoked or surrendered in any way."
    },
