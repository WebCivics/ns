        }
      ],
      "cml:integrityHash": "4c6f7723d90d30de2a9381ad392d09432bf17941439a91319ba04bcf040d3934",
      "skos:note": "Carbon tax removal substantiation notice must explain certain effects.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60fa-ss-5",
      "@type": "cof:Section",
      "cof:title": "60FA(5) Carbon tax removal substantiation notices",
      "values:kind": "subsection",
      "cof:pageNumber": 300,
      "values:originalText": "(5) A carbon tax removal substantiation notice must explain the effect\nof:\n\n(a) section 60FB; and\n\n(b) section 60FC; and\n\n(c) sections 137.1 and 137.2 of the Criminal Code.\nSection does not limit section 60H"
    },
