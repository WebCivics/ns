      "skos:note": "Compliance with carbon tax removal substantiation notices within applicable compliance period."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60fc",
      "@type": "cof:Section",
      "cof:title": "60FC Compliance with carbon tax removal substantiation notices",
