    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ec",
      "@type": "cml:Concept",
      "skos:prefLabel": "57EC Right to bring proceedings unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ec"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.186",
      "values:originalText": "This Division does not affect the right of the initiating party or the\nresponding party to bring legal proceedings, under this Act or\notherwise.",
      "skos:definition": "This Division does not affect the right of the initiating party or the\nresponding party to bring legal proceedings, under this Act or\notherwise.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ec-norm"
        }
      ],
      "cml:integrityHash": "9c8f59c4d6e0a7d8fc231162c58fd1e41ac34f788030bd63b62e73e3ab90117e",
      "skos:note": "Right to bring proceedings unaffected"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ec",
      "@type": "cof:Section",
      "cof:title": "57EC Right to bring proceedings unaffected",
      "values:kind": "section",
      "cof:pageNumber": 186,
      "values:originalText": "This Division does not affect the right of the initiating party or the\nresponding party to bring legal proceedings, under this Act or\notherwise."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ec-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
