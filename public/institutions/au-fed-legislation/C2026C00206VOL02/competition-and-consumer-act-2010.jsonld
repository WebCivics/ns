      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-79a-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-79a-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a22928dc6a46f4186f3fe11985da811df53995a420503a3ed810fe1c69e51652",
