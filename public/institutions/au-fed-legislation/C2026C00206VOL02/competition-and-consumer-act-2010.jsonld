    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56bo-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BO(3) Misleading or deceptive conduct—civil penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56bo-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.86",
      "values:originalText": "(3) A person who wishes to rely on subsection (2) bears the burden of\nadducing or pointing to evidence that suggests a reasonable\npossibility that the conduct is not misleading or deceptive in a\nmaterial particular.\nSubdivision C—Process for making consumer data rules etc.",
      "skos:definition": "(3) A person who wishes to rely on subsection (2) bears the burden of\nadducing or pointing to evidence that suggests a reasonable\npossibility that the conduct is not misleading or deceptive in a\nmaterial particular.\nSubdivision C—Process for making consumer data rules etc.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-56bo"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56bo-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56bo-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56bo-ss-3-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "39cd86257e689225b5a95b1bd1cc5a1f055a2136d5bccaed6227a08f959c15ad",
      "skos:note": "Bears burden of adducing evidence to suggest a reasonable possibility that conduct is not misleading or deceptive."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56bo-ss-3",
      "@type": "cof:Section",
      "cof:title": "56BO(3) Misleading or deceptive conduct—civil penalty",
      "values:kind": "subsection",
      "cof:pageNumber": 86,
      "values:originalText": "(3) A person who wishes to rely on subsection (2) bears the burden of\nadducing or pointing to evidence that suggests a reasonable\npossibility that the conduct is not misleading or deceptive in a\nmaterial particular.\nSubdivision C—Process for making consumer data rules etc."
    },
