    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95zh",
      "@type": "cml:Concept",
      "skos:prefLabel": "95ZH Ministerial directions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95zh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.499",
      "values:originalText": "Commission\n\n(1) The Minister may, by notice in writing give to the Chairperson,\ndirect the Commission to give special consideration to a specified\nmatter or matters in exercising its powers and performing its\nfunctions under this Part.\n\n(2) The Commission must comply with any such directions.\nOther bodies\n\n(3) The Minister may, by notice in writing given to the person\npresiding at an external inquiry, direct the body holding the inquiry\nto give special consideration to a specified matter or matters in\nholding the inquiry.\n\n(4) The body must comply with any such directions.",
      "skos:definition": "Commission\n\n(1) The Minister may, by notice in writing give to the Chairperson,\ndirect the Commission to give special consideration to a specified\nmatter or matters in exercising its powers and performing its\nfunctions under this Part.\n\n(2) The Commission must comply with any such directions.\nOther bodies\n\n(3) The Minister may, by notice in writing given to the person\npresiding at an external inquiry, direct the body holding the inquiry\nto give special consideration to a specified matter or matters in\nholding the inquiry.\n\n(4) The body must comply with any such directions.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zh-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zh-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zh-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zh-ss-4"
        }
      ],
      "cml:integrityHash": "3d41e1a66a7daeb8da761812e830ca56fe19dd3ec7c8e2e6b0ca2abeef1a2010"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95zh",
      "@type": "cof:Section",
      "cof:title": "95ZH Ministerial directions",
      "values:kind": "section",
      "cof:pageNumber": 499,
      "values:originalText": "Commission\n\n(1) The Minister may, by notice in writing give to the Chairperson,\ndirect the Commission to give special consideration to a specified\nmatter or matters in exercising its powers and performing its\nfunctions under this Part.\n\n(2) The Commission must comply with any such directions.\nOther bodies\n\n(3) The Minister may, by notice in writing given to the person\npresiding at an external inquiry, direct the body holding the inquiry\nto give special consideration to a specified matter or matters in\nholding the inquiry.\n\n(4) The body must comply with any such directions."
    },
