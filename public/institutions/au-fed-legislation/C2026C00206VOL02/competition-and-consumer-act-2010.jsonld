    {
      "@id": "concept:competition-and-consumer-act-2010-sec-93ab-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "93AB(1) Notification of collective bargaining",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-93ab-ss-1"
