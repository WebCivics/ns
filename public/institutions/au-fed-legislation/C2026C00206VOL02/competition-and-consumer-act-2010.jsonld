      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-89-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "89(5) Procedure for applications and the keeping of a register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-89-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.400",
      "values:originalText": "(5) Where a person furnishes a document to the Commission in\nrelation to an application or proposal referred to in subsection (3)\nor makes an oral submission to the Commission in relation to such\nan application or proposal, he or she may, at the time when the\ndocument is furnished or the submission is made, request that the\ndocument or a part of the document, or that particulars of the\nsubmission or of part of the submission, be excluded from the\nregister kept under subsection (3) by reason of the confidential\n\nChapter 6  Other provisions",
      "skos:definition": "(5) Where a person furnishes a document to the Commission in\nrelation to an application or proposal referred to in subsection (3)\nor makes an oral submission to the Commission in relation to such\nan application or proposal, he or she may, at the time when the\ndocument is furnished or the submission is made, request that the\ndocument or a part of the document, or that particulars of the\nsubmission or of part of the submission, be excluded from the\nregister kept under subsection (3) by reason of the confidential\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-89"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-89-ss-5-norm"
        }
      ],
      "cml:integrityHash": "c5232c0331c556efee29dd540a7b40182793e6614f9c3fe5fbf4caf90babea84",
      "skos:note": "Request for exclusion of document or submission from register"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-89-ss-5",
      "@type": "cof:Section",
      "cof:title": "89(5) Procedure for applications and the keeping of a register",
      "values:kind": "subsection",
      "cof:pageNumber": 400,
      "values:originalText": "(5) Where a person furnishes a document to the Commission in\nrelation to an application or proposal referred to in subsection (3)\nor makes an oral submission to the Commission in relation to such\nan application or proposal, he or she may, at the time when the\ndocument is furnished or the submission is made, request that the\ndocument or a part of the document, or that particulars of the\nsubmission or of part of the submission, be excluded from the\nregister kept under subsection (3) by reason of the confidential\n\nChapter 6  Other provisions"
    },
    {
