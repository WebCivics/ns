    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95d",
      "@type": "cml:Concept",
      "skos:prefLabel": "95D Crown to be bound",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.471",
      "values:originalText": "(1) This Part binds the Crown in right of the Commonwealth, of each\nof the States, of the Australian Capital Territory and of the\nNorthern Territory.\n\n(2) Nothing in this Part makes the Crown liable to be prosecuted for an\noffence.\n\n(3) The protection in subsection (2) does not apply to an incorporated\nCommonwealth authority or an incorporated State or Territory\nauthority.",
      "skos:definition": "(1) This Part binds the Crown in right of the Commonwealth, of each\nof the States, of the Australian Capital Territory and of the\nNorthern Territory.\n\n(2) Nothing in this Part makes the Crown liable to be prosecuted for an\noffence.\n\n(3) The protection in subsection (2) does not apply to an incorporated\nCommonwealth authority or an incorporated State or Territory\nauthority.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95d-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95d-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95d-ss-3"
        }
      ],
      "cml:integrityHash": "b9106b98961013208f05e482c7086eed4941ac6ede31da1dff655a22e9ffb256"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95d",
      "@type": "cof:Section",
      "cof:title": "95D Crown to be bound",
      "values:kind": "section",
      "cof:pageNumber": 471,
      "values:originalText": "(1) This Part binds the Crown in right of the Commonwealth, of each\nof the States, of the Australian Capital Territory and of the\nNorthern Territory.\n\n(2) Nothing in this Part makes the Crown liable to be prosecuted for an\noffence.\n\n(3) The protection in subsection (2) does not apply to an incorporated\nCommonwealth authority or an incorporated State or Territory\nauthority."
    },
