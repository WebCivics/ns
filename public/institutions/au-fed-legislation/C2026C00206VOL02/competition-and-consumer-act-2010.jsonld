        {
          "@id": "concept:competition-and-consumer-act-2010-sec-31-norm"
        }
      ],
      "cml:integrityHash": "0345e4e8f5a5e284d595b1bcdd014de37baaa18898f0c626be44b1cbe4dd898c",
      "skos:note": "Adjusts applicable period for response notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 May.",
      "values:kind": "section",
      "cof:pageNumber": 494,
      "values:originalText": "If the Commission also gives the person a response notice, under\nsubsection (4), the applicable period instead of ending on 31 May ends\non 14 June."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-31-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-31"
      },
      "values:deonticStatus": {
