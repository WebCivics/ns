      "skos:note": "Issue of infringement notice as an alternative to proceedings for a pecuniary penalty"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55f-ss-1",
      "@type": "cof:Section",
