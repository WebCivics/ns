    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ga-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "56GA(1) CDR functions of the Information Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ga-ss-1"
      },
