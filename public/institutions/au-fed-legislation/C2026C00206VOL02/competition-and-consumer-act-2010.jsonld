      "cml:integrityHash": "2ed5e7dff68a411e6f17d59afb8e2d6035736db2e91da9b86ceac9daf44ebe00",
      "skos:note": "Regulator of a regulated sector must monitor, investigate and enforce compliance with the provisions of the SPF code for the sector."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ed-ss-3",
