          "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-alleninterval-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-argumentation-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-diffusion-5"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-cogai-6"
        }
      ],
      "cml:integrityHash": "3d117f07585447978b553643a42a21fb80ff85387f6a47314d0843f9b127fe6e",
      "skos:note": "Agrees to observe standard and engage in conduct required by the standard."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56fd-ss-2",
      "@type": "cof:Section",
      "cof:title": "56FD(2) Legal effect of data standards",
      "values:kind": "subsection",
      "cof:pageNumber": 149,
      "values:originalText": "(2) If there is a designated gateway for CDR data to which a binding\ndata standard applies, a contract is taken to be in force between:\n\n(a) a data holder of the CDR data; and\n\n(b) the designated gateway for the CDR data; and\n\n(c) each accredited person;\nunder which each of those persons:\n\n(d) agrees to observe the standard to the extent that the standard\napplies to the person; and\n\n(e) agrees to engage in conduct that the person is required by the\nstandard to engage in.\nNote:\nThis means the data holder will be taken to have a separate 3-party\ncontract with the designated gateway and each accredited person."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obliges",
      "cml:logicSummary": "Agrees to observe standard and engage in conduct required by the standard.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a data holder of the CDR data; (b) the designated gateway for the CDR data; (c) each accredited person;",
      "cml:conclusionText": "(d) agrees to observe the standard to the extent that the standard applies to the person; and (e) agrees to engage in conduct that the person is required by the standard to engage in."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "appliesTo",
      "cml:logicSummary": "Standard applies to the person.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) agrees to observe the standard to the extent that the standard applies to the person;",
      "cml:conclusionText": "the standard applies to the person."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Agrees to engage in conduct during the applicable period.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) agrees to engage in conduct that the person is required by the standard to engage in;",
      "cml:conclusionText": "the person engages in conduct during the applicable period."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Agrees to observe standard implies engagement in conduct.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) agrees to observe the standard to the extent that the standard applies to the person; (e) agrees to engage in conduct that the person is required by the standard to engage in;",
      "cml:conclusionText": "the person agrees to observe the standard and engage in conduct."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:logicSummary": "Data holder's agreement diffuses through gateway and accredited persons.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a data holder of the CDR data; (b) the designated gateway for the CDR data; (c) each accredited person;",
      "cml:conclusionText": "the data holder's agreement diffuses through the gateway and accredited persons."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "asserts",
      "cml:logicSummary": "Data holder asserts standard applies to themselves.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) agrees to observe the standard to the extent that the standard applies to the person;",
      "cml:conclusionText": "the data holder asserts that the standard applies to them."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-2a",
