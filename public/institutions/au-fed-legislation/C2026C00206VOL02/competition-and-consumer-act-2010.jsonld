    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95zg",
      "@type": "cml:Concept",
      "skos:prefLabel": "95ZG Exceptions to price monitoring",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95zg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.498",
      "values:originalText": "Exempt supplies\n\n(1) The Minister must not direct the Commission under this Division\nto monitor prices, costs and profits relating to a supply of goods or\nservices of a particular description that is an exempt supply in\nrelation to goods or services of that description.\nState or Territory authorities\n\n(2) The Minister must not direct the Commission under this Division\nto monitor prices, costs and profits of a State or Territory authority\nthat supplies goods or services unless the State or Territory\nconcerned has agreed to the direction being given.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nOther provisions  Division 6\n\nSection 95ZH\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Exempt supplies\n\n(1) The Minister must not direct the Commission under this Division\nto monitor prices, costs and profits relating to a supply of goods or\nservices of a particular description that is an exempt supply in\nrelation to goods or services of that description.\nState or Territory authorities\n\n(2) The Minister must not direct the Commission under this Division\nto monitor prices, costs and profits of a State or Territory authority\nthat supplies goods or services unless the State or Territory\nconcerned has agreed to the direction being given.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nOther provisions  Division 6\n\nSection 95ZH\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zg-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zg-ss-2"
        }
      ],
      "cml:integrityHash": "dac59779775a094d6e2bd3c1268c645f28380ce3e75610ba65e3891461b14126"
    },
    {
