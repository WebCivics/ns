    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56bc-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BC(2) Rules about disclosure, collection, use, accuracy, storage,",
      "cml:realizedBy": {
