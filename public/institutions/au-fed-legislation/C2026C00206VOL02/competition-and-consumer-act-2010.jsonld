    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95s-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "95S(3) Taking of evidence on oath or affirmation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95s-ss-3"
      },
      "cml:curationStatus": {
