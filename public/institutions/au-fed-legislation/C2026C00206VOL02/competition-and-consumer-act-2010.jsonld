        }
      ],
      "cml:integrityHash": "7492014762b3aa260c5ce35e500b1d22c0d87aa04ff161380ca5cf8e8ca16729",
      "skos:note": "Supplier must withhold supply of goods"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-98",
      "@type": "cof:Section",
      "cof:title": "98 Withholding the supply of goods",
      "values:kind": "section",
      "cof:pageNumber": 515,
      "values:originalText": "(1) For the purposes of paragraph 96(3)(d) or (e), the supplier shall be\ndeemed to withhold the supply of goods to another person if:\n\nChapter 6  Other provisions"
    },
