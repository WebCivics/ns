    {
      "@id": "concept:competition-and-consumer-act-2010-sec-77b",
      "@type": "cml:Concept",
      "skos:prefLabel": "77B Certain indemnities not authorised and certain documents void",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-77b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.330",
      "values:originalText": "(1) Section 77A does not authorise anything that would otherwise be\nunlawful.\n\n(2) Anything that purports to indemnify a person against a liability is\nvoid to the extent that it contravenes section 77A.",
      "skos:definition": "(1) Section 77A does not authorise anything that would otherwise be\nunlawful.\n\n(2) Anything that purports to indemnify a person against a liability is\nvoid to the extent that it contravenes section 77A.",
      "cml:hasPart": [
