    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95y-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "95Y(4) Declarations in relation to State or Territory authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95y-ss-4"
