      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100g",
      "@type": "cml:Concept",
      "skos:prefLabel": "100G Tribunal may dismiss applications if fees not paid",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.523",
      "values:originalText": "The Tribunal may dismiss an application for review made to the\nTribunal under subsection 100C(1) if a fee payable by the applicant\nto the Tribunal in respect of the application is not paid by the time\ndetermined under subsection 112(2).",
      "skos:definition": "The Tribunal may dismiss an application for review made to the\nTribunal under subsection 100C(1) if a fee payable by the applicant\nto the Tribunal in respect of the application is not paid by the time\ndetermined under subsection 112(2).",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100g-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "12201b83b6a2f9e9257fc80a2febf1e99ff798004fcf9ad85563ebdce004c7a9",
      "skos:note": "Failure to pay fees may result in dismissal of application."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100g",
      "@type": "cof:Section",
      "cof:title": "100G Tribunal may dismiss applications if fees not paid",
      "values:kind": "section",
      "cof:pageNumber": 523,
      "values:originalText": "The Tribunal may dismiss an application for review made to the\nTribunal under subsection 100C(1) if a fee payable by the applicant\nto the Tribunal in respect of the application is not paid by the time\ndetermined under subsection 112(2)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100g-norm",
      "@type": "values:Prohibition",
