    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57gc",
      "@type": "cml:Concept",
      "skos:prefLabel": "57GC Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.194",
      "values:originalText": "It is the Parliament’s intention that a law of a State or Territory\nshould be able to operate concurrently with this Part unless the law\nis directly inconsistent with this Part.",
      "skos:definition": "It is the Parliament’s intention that a law of a State or Territory\nshould be able to operate concurrently with this Part unless the law\nis directly inconsistent with this Part.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57gc-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57gc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4094131739fc723db6a00e48ccb5eb85eec21316db649e676e3f428f471aeff6",
      "skos:note": "States and Territories can operate concurrently with this Part unless directly inconsistent."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gc",
      "@type": "cof:Section",
      "cof:title": "57GC Concurrent operation of State and Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 194,
      "values:originalText": "It is the Parliament’s intention that a law of a State or Territory\nshould be able to operate concurrently with this Part unless the law\nis directly inconsistent with this Part."
    },
    {
