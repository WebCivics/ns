    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "57FB(2) Scheme adviser—functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57fb-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.190",
      "values:originalText": "(2) Information about the terms and conditions of a contract on which\nscheme information is supplied under this Part that is notified to\nthe scheme adviser under subsection 57CB(4) is taken not to be\ninformation obtained in confidence, except to the extent that it\nidentifies, or enables identification of, the parties to the contract.",
      "skos:definition": "(2) Information about the terms and conditions of a contract on which\nscheme information is supplied under this Part that is notified to\nthe scheme adviser under subsection 57CB(4) is taken not to be\ninformation obtained in confidence, except to the extent that it\nidentifies, or enables identification of, the parties to the contract.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-57fb"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "81dffd038e08902c74f099e60c3993cea8c865a83184f51995e944bf02ca8b12",
      "skos:note": "Information about contract terms is not confidential to the extent it identifies parties."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57fb-ss-2",
      "@type": "cof:Section",
      "cof:title": "57FB(2) Scheme adviser—functions",
      "values:kind": "subsection",
      "cof:pageNumber": 190,
      "values:originalText": "(2) Information about the terms and conditions of a contract on which\nscheme information is supplied under this Part that is notified to\nthe scheme adviser under subsection 57CB(4) is taken not to be\ninformation obtained in confidence, except to the extent that it\nidentifies, or enables identification of, the parties to the contract."
    },
