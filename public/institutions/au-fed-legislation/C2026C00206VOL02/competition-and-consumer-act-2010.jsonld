    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fc",
      "@type": "cml:Concept",
      "skos:prefLabel": "56FC Data standards must be published",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56fc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.149",
      "values:originalText": "The Data Standards Chair must publish on the internet a copy of\neach data standard made under subsection 56FA(1).\nNote:\nOnce published, the data standards will be available for free.",
      "skos:definition": "The Data Standards Chair must publish on the internet a copy of\neach data standard made under subsection 56FA(1).\nNote:\nOnce published, the data standards will be available for free.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56fc-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56fc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2b65a159c722832f032397e0d662674d255886a4729aa01ee18cd983019967d8",
      "skos:note": "Publish data standards on the internet",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56fc",
      "@type": "cof:Section",
      "cof:title": "56FC Data standards must be published",
      "values:kind": "section",
      "cof:pageNumber": 149,
      "values:originalText": "The Data Standards Chair must publish on the internet a copy of\neach data standard made under subsection 56FA(1).\nNote:\nOnce published, the data standards will be available for free."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fc-norm",
      "@type": "values:Obligation",
