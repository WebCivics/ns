      },
      "cml:operator": "is",
      "cml:logicSummary": "Definition of person acting in a way",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "a person to the extent that the person is both (a) carrying on or providing a business or service that is part of the regulated sector; and (b) acting using a postal, telegraphic, telephonic or other like service so much of that business or service as relates to the person acting in that way."
    },
    {
