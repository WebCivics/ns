    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95af-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "95AF(2) Extension of declaration of exceptional circumstances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95af-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.465",
      "values:originalText": "(2) The Minister may, under subsection (1), extend the operation of an\norder more than once. However, each period of extension must not\nexceed 3 months.\n\nChapter 6  Other provisions",
      "skos:definition": "(2) The Minister may, under subsection (1), extend the operation of an\norder more than once. However, each period of extension must not\nexceed 3 months.\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-95af"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95af-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95af-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c97372846d5f42e8af684637d87c1d0bc0b6592ed1d2e024de914e36af6421b",
      "skos:note": "The Minister may extend the operation of an order more than once, but each extension must not exceed 3 months."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95af-ss-2",
