      },
      "cml:premiseText": "a corporation that carries on or provides a business or service that is part of the regulated sector that business or service."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ad-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
