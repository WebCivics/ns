      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.84",
      "values:originalText": "The consumer data rules may provide that specified provisions of\nthe rules are civil penalty provisions (within the meaning of the\nRegulatory Powers Act).\nNote:\nSections 76 to 77 deal with enforcing the civil penalty provisions.",
      "skos:definition": "The consumer data rules may provide that specified provisions of\nthe rules are civil penalty provisions (within the meaning of the\nRegulatory Powers Act).\nNote:\nSections 76 to 77 deal with enforcing the civil penalty provisions.",
      "cml:asserts": [
        {
