    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60fa-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "60FA(5) Carbon tax removal substantiation notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60fa-ss-5"
      },
