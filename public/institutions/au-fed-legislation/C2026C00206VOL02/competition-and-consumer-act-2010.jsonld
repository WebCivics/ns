    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58aj-ss-2",
      "@type": "cof:Section",
      "cof:title": "58AJ(2) Extension to external Territories and outside of Australia",
      "values:kind": "subsection",
      "cof:pageNumber": 205,
      "values:originalText": "(2) The SPF provisions extend to acts, omissions, matters and things\noutside Australia.\nSubdivision E—Application to acts done by or in relation to\nagents etc. of regulated entities"
    },
