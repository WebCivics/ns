        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The provision limits the number of collective bargaining notices that can be given",
      "cml:conclusionText": "The provision restricts the giving of collective bargaining notices"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-93af-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Imply",
      "cml:logicSummary": "Implication of the prohibition on further collective bargaining notices",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a collective bargaining notice is given, no further notice may be given",
      "cml:conclusionText": "The prohibition implies that no further collective bargaining notice may be given"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-93af-logic-deontic-4",
