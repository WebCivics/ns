    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60n",
      "@type": "cml:Concept",
      "skos:prefLabel": "60N Effect of failure to comply with an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.316",
      "values:originalText": "If:\n\n(a) an infringement notice for an alleged contravention of an\ninfringement notice provision is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 60Q;\nthe person is liable to proceedings under Part VI in relation to the\nalleged contravention of the infringement notice provision.",
      "skos:definition": "If:\n\n(a) an infringement notice for an alleged contravention of an\ninfringement notice provision is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 60Q;\nthe person is liable to proceedings under Part VI in relation to the\nalleged contravention of the infringement notice provision.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60n-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6b08d2524d80a88dd07f7acf9d64024d617c49ab77346653cc950db09c81147c",
      "skos:note": "Liability for failure to comply with infringement notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60n",
      "@type": "cof:Section",
      "cof:title": "60N Effect of failure to comply with an infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 316,
      "values:originalText": "If:\n\n(a) an infringement notice for an alleged contravention of an\ninfringement notice provision is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 60Q;\nthe person is liable to proceedings under Part VI in relation to the\nalleged contravention of the infringement notice provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60n-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
