    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ba-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide requirements for deleting CDR data on request from consumer",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ba-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "\\u2262",
      "cml:logicSummary": "Cannot delete CDR data under certain conditions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The accredited data recipient is required to retain the CDR data",
      "cml:conclusionText": "The rule cannot require deletion of all or part of the CDR data"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ba-ss-2-logic-alleninterval-3",
