      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The data holder must meet the conditions to be declared as a class of data holders.",
      "cml:conclusionText": "The person is an action service provider for that type of CDR action."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-1-logic-deontic-7",
      "@type": "cml:LogicApplication",
