        }
      ],
      "cml:integrityHash": "f6e16909a7f45397dc9f14434666b8393886a41ca72178a50b9ad4708fc9ab97",
      "skos:note": "May give notice to Commission about conduct or proposed conduct",
      "dc:description": "notice setting out particulars of conduct or proposed conduct"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-93-ss-8",
      "@type": "cof:Section",
      "cof:title": "93(8) Notification of exclusive dealing or resale price maintenance",
      "values:kind": "subsection",
