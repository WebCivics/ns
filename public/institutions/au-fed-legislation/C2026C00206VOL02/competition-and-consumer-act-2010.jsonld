      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Court decision is subject to temporal constraints",
      "cml:conclusionText": "Most extreme cases are defined by a specific temporal interval"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1-logic-argumentation-3",
