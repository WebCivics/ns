        }
      ],
      "cml:integrityHash": "75e7abc2237e5ad412e1e82df40d01a06b87a960493076e95559c1e80c7a17b6",
      "skos:note": "The Commission must monitor prices, costs and profits in a directed industry or business."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95g-ss-6",
      "@type": "cof:Section",
      "cof:title": "95G(6) Commission’s functions under this Part",
      "values:kind": "subsection",
      "cof:pageNumber": 473,
      "values:originalText": "(6) The Commission is to monitor prices, costs and profits in any\nindustry or business that the Minister directs it to monitor and is to\ngive the Minister a report on the results of such monitoring.\nGeneral"
    },
