    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95b",
      "@type": "cml:Concept",
      "skos:prefLabel": "95B Exempt supplies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.470",
      "values:originalText": "(1) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare a supply of goods\nor services of a specified description, that is a supply in a specified\nmanner, of a specified kind or in specified circumstances, to be an\nexempt supply for the purposes of this Part.\n\n(2) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under subsection (1).",
      "skos:definition": "(1) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare a supply of goods\nor services of a specified description, that is a supply in a specified\nmanner, of a specified kind or in specified circumstances, to be an\nexempt supply for the purposes of this Part.\n\n(2) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95b-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95b-ss-2"
        }
      ],
      "cml:integrityHash": "e8b3d963665cb3148c6a3e9f871a52e01666f2fe183605a0443e08fc84e0e3e0"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95b",
