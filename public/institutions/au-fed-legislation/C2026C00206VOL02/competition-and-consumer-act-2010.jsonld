    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60f",
      "@type": "cml:Concept",
      "skos:prefLabel": "60F Acquisition of property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.299",
      "values:originalText": "Scope\n\n(1) This section applies to the following provisions of this Act:\n\n(a) section 60C;\n\n(b) any other provision to the extent to which it relates to\nsection 60C.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) otherwise than\non just terms (within the meaning of that paragraph).\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "Scope\n\n(1) This section applies to the following provisions of this Act:\n\n(a) section 60C;\n\n(b) any other provision to the extent to which it relates to\nsection 60C.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) otherwise than\non just terms (within the meaning of that paragraph).\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
