    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100t",
      "@type": "cml:Concept",
      "skos:prefLabel": "100T Information etc. to which Tribunal may have regard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.530",
      "values:originalText": "Despite section 100N, the Tribunal must not, for the purposes of a\nreview under this Division, have regard to any information,\ndocuments or evidence other than:\n\n(a) information that was referred to in the Commission’s reasons\nfor making the determination to which the review relates; and\n\n(b) the information, documents or evidence referred to in\nsubsection 100B(5); and\n\n(c) the information or documents given to the Tribunal under\nsubsection 100D(1); and\n\n(d) the information, documents or evidence referred to in\nsubparagraph 100Q(b)(ii); and\n\n(e) any information or report given to the Tribunal under\nsubsection 100R(1); and\n\n(f) the information, documents or evidence referred to in\nsubsection 100R(2); and\n\n(g) information given to the Tribunal as a result of the Tribunal\nseeking such relevant information, and consulting with such\npersons, as it believes reasonable and appropriate for the sole\npurpose of clarifying the information, documents or evidence\nreferred to in subsection 100R(2); and\n\n(h) the information, documents or evidence referred to in\nparagraph 100S(1)(b); and\n\n(i) any information, documents or evidence referred to in\nsubsection 100S(2).\n\nOther provisions  Chapter 6\nReview by Tribunal of decisions of Commission  Part IX\nApplications for review of determinations by the Commission under Part VII  Division\n\nSection 101\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Despite section 100N, the Tribunal must not, for the purposes of a\nreview under this Division, have regard to any information,\ndocuments or evidence other than:\n\n(a) information that was referred to in the Commission’s reasons\nfor making the determination to which the review relates; and\n\n(b) the information, documents or evidence referred to in\nsubsection 100B(5); and\n\n(c) the information or documents given to the Tribunal under\nsubsection 100D(1); and\n\n(d) the information, documents or evidence referred to in\nsubparagraph 100Q(b)(ii); and\n\n(e) any information or report given to the Tribunal under\nsubsection 100R(1); and\n\n(f) the information, documents or evidence referred to in\nsubsection 100R(2); and\n\n(g) information given to the Tribunal as a result of the Tribunal\nseeking such relevant information, and consulting with such\npersons, as it believes reasonable and appropriate for the sole\npurpose of clarifying the information, documents or evidence\nreferred to in subsection 100R(2); and\n\n(h) the information, documents or evidence referred to in\nparagraph 100S(1)(b); and\n\n(i) any information, documents or evidence referred to in\nsubsection 100S(2).\n\nOther provisions  Chapter 6\nReview by Tribunal of decisions of Commission  Part IX\nApplications for review of determinations by the Commission under Part VII  Division\n\nSection 101\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100t-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100t-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100t-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100t-logic-deontic-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100t-logic-deontic-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100t-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "c6dd82c31528196e4e62fe1ba46bf251dcbb58863827620360292644a41a6f0f",
      "skos:note": "Limitation on information considered by Tribunal in review under Division"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100t",
      "@type": "cof:Section",
      "cof:title": "100T Information etc. to which Tribunal may have regard",
      "values:kind": "section",
      "cof:pageNumber": 530,
      "values:originalText": "Despite section 100N, the Tribunal must not, for the purposes of a\nreview under this Division, have regard to any information,\ndocuments or evidence other than:\n\n(a) information that was referred to in the Commission’s reasons\nfor making the determination to which the review relates; and\n\n(b) the information, documents or evidence referred to in\nsubsection 100B(5); and\n\n(c) the information or documents given to the Tribunal under\nsubsection 100D(1); and\n\n(d) the information, documents or evidence referred to in\nsubparagraph 100Q(b)(ii); and\n\n(e) any information or report given to the Tribunal under\nsubsection 100R(1); and\n\n(f) the information, documents or evidence referred to in\nsubsection 100R(2); and\n\n(g) information given to the Tribunal as a result of the Tribunal\nseeking such relevant information, and consulting with such\npersons, as it believes reasonable and appropriate for the sole\npurpose of clarifying the information, documents or evidence\nreferred to in subsection 100R(2); and\n\n(h) the information, documents or evidence referred to in\nparagraph 100S(1)(b); and\n\n(i) any information, documents or evidence referred to in\nsubsection 100S(2).\n\nOther provisions  Chapter 6\nReview by Tribunal of decisions of Commission  Part IX\nApplications for review of determinations by the Commission under Part VII  Division\n\nSection 101\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
