        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exemption",
      "cml:logicSummary": "Section 34C exemption",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 34C of the Acts Interpretation Act 1901 requires periodic reports.",
      "cml:conclusionText": "Reports are exempt from Section 34C."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ga",
      "@type": "cml:Concept",
      "skos:prefLabel": "57GA Civil penalty provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ga"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.192",
      "values:originalText": "A provision of this Part that is of one of the following kinds and\nsets out at its foot a pecuniary penalty indicated by the words “civil\npenalty” is a civil penalty provision for the purposes of this Part\nand item 11 of the table in subsection 76(1A):\n\n(a) a subsection;\n\n(b) a section that is not divided into subsections.",
      "skos:definition": "A provision of this Part that is of one of the following kinds and\nsets out at its foot a pecuniary penalty indicated by the words “civil\npenalty” is a civil penalty provision for the purposes of this Part\nand item 11 of the table in subsection 76(1A):\n\n(a) a subsection;\n\n(b) a section that is not divided into subsections.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ga-norm"
        }
      ],
      "cml:integrityHash": "232032c6a5e631d4697f577efdadbd5804188a8f0d354af675f8d0f08ca67c15",
      "skos:note": "Defines civil penalty provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ga",
      "@type": "cof:Section",
      "cof:title": "57GA Civil penalty provisions",
      "values:kind": "section",
      "cof:pageNumber": 192,
      "values:originalText": "A provision of this Part that is of one of the following kinds and\nsets out at its foot a pecuniary penalty indicated by the words “civil\npenalty” is a civil penalty provision for the purposes of this Part\nand item 11 of the table in subsection 76(1A):\n\n(a) a subsection;\n\n(b) a section that is not divided into subsections."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ga-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-57ga"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57gb",
      "@type": "cml:Concept",
      "skos:prefLabel": "57GB Infringement notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.192",
      "values:originalText": "(1) Division 2A of Part IVB applies in relation to an alleged\ncontravention of a civil penalty provision mentioned in an item in\nthe table in subsection (2) in the same way in which it applies in\nrelation to an alleged contravention of a civil penalty provision of\nan industry code (within the meaning of that Part).\n\n(2) For the purposes of the application of Division 2A of Part IVB\nunder subsection (1), the penalty to be specified in an infringement\nnotice in relation to an alleged contravention of a provision\nmentioned in columns 1 and 2 of an item of the following table\nmust be a penalty equal to the applicable penalty for the\ncontravention mentioned in column 3 or 4 of that item.\n\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nMiscellaneous  Division 7\n\nSection 57GB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nPenalties to be specified in infringement notices issued under this Part\nItem\nColumn 1\nColumn 2\nColumn 3\nColumn 4\n\nFor an\nalleged\ncontraven\ntion of the\nfollowing\nprovision:\nthat relates to:\nif the alleged\ncontravention\nis by a body\ncorporate—\nthe number of\npenalty units\nmust be:\nif the alleged\ncontravention\nis by a person\nother than a\nbody\ncorporate—\nthe number of\npenalty units\nmust be:\nsubsection\n57CA(3)\nthe choice of supply\nperiod in scheme offer\nsubsection\n57CA(6)\npublishing a scheme\noffer\nsubsection\n57CA(7)\nnotifying the scheme\nadviser about scheme\ninformation offered\nsubsection\n57CB(2)\nfailing to supply scheme\ninformation within the\nperiod covered by\nparagraph 57CB(2)(b)\nsubsection\n57CB(4)\nnotifying the scheme\nadviser of terms and\nconditions of supply\nsubsection\n57CC(2)\nprohibited terms or\nconditions in contracts of\nsupply\nSection 57\nDA\npackaging of scheme\ninformation\nsubsection\n57DB(1)\nrestrictions on supplying\nsafety and security\ninformation\nsubsection\n57DE(2)\nrequiring a data provider\nto keep records\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) Division 2A of Part IVB applies in relation to an alleged\ncontravention of a civil penalty provision mentioned in an item in\nthe table in subsection (2) in the same way in which it applies in\nrelation to an alleged contravention of a civil penalty provision of\nan industry code (within the meaning of that Part).\n\n(2) For the purposes of the application of Division 2A of Part IVB\nunder subsection (1), the penalty to be specified in an infringement\nnotice in relation to an alleged contravention of a provision\nmentioned in columns 1 and 2 of an item of the following table\nmust be a penalty equal to the applicable penalty for the\ncontravention mentioned in column 3 or 4 of that item.\n\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nMiscellaneous  Division 7\n\nSection 57GB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nPenalties to be specified in infringement notices issued under this Part\nItem\nColumn 1\nColumn 2\nColumn 3\nColumn 4\n\nFor an\nalleged\ncontraven\ntion of the\nfollowing\nprovision:\nthat relates to:\nif the alleged\ncontravention\nis by a body\ncorporate—\nthe number of\npenalty units\nmust be:\nif the alleged\ncontravention\nis by a person\nother than a\nbody\ncorporate—\nthe number of\npenalty units\nmust be:\nsubsection\n57CA(3)\nthe choice of supply\nperiod in scheme offer\nsubsection\n57CA(6)\npublishing a scheme\noffer\nsubsection\n57CA(7)\nnotifying the scheme\nadviser about scheme\ninformation offered\nsubsection\n57CB(2)\nfailing to supply scheme\ninformation within the\nperiod covered by\nparagraph 57CB(2)(b)\nsubsection\n57CB(4)\nnotifying the scheme\nadviser of terms and\nconditions of supply\nsubsection\n57CC(2)\nprohibited terms or\nconditions in contracts of\nsupply\nSection 57\nDA\npackaging of scheme\ninformation\nsubsection\n57DB(1)\nrestrictions on supplying\nsafety and security\ninformation\nsubsection\n57DE(2)\nrequiring a data provider\nto keep records\n\nChapter 4  Provisions re",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57gb-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57gb-ss-2"
        }
      ],
      "cml:integrityHash": "e7ffb07c308305f3192359302ef506d45dcf397b7bca94c270a8ab4fd9d6c63d"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gb",
      "@type": "cof:Section",
      "cof:title": "57GB Infringement notices",
      "values:kind": "section",
      "cof:pageNumber": 192,
      "values:originalText": "(1) Division 2A of Part IVB applies in relation to an alleged\ncontravention of a civil penalty provision mentioned in an item in\nthe table in subsection (2) in the same way in which it applies in\nrelation to an alleged contravention of a civil penalty provision of\nan industry code (within the meaning of that Part).\n\n(2) For the purposes of the application of Division 2A of Part IVB\nunder subsection (1), the penalty to be specified in an infringement\nnotice in relation to an alleged contravention of a provision\nmentioned in columns 1 and 2 of an item of the following table\nmust be a penalty equal to the applicable penalty for the\ncontravention mentioned in column 3 or 4 of that item.\n\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nMiscellaneous  Division 7\n\nSection 57GB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nPenalties to be specified in infringement notices issued under this Part\nItem\nColumn 1\nColumn 2\nColumn 3\nColumn 4\n\nFor an\nalleged\ncontraven\ntion of the\nfollowing\nprovision:\nthat relates to:\nif the alleged\ncontravention\nis by a body\ncorporate—\nthe number of\npenalty units\nmust be:\nif the alleged\ncontravention\nis by a person\nother than a\nbody\ncorporate—\nthe number of\npenalty units\nmust be:\nsubsection\n57CA(3)\nthe choice of supply\nperiod in scheme offer\nsubsection\n57CA(6)\npublishing a scheme\noffer\nsubsection\n57CA(7)\nnotifying the scheme\nadviser about scheme\ninformation offered\nsubsection\n57CB(2)\nfailing to supply scheme\ninformation within the\nperiod covered by\nparagraph 57CB(2)(b)\nsubsection\n57CB(4)\nnotifying the scheme\nadviser of terms and\nconditions of supply\nsubsection\n57CC(2)\nprohibited terms or\nconditions in contracts of\nsupply\nSection 57\nDA\npackaging of scheme\ninformation\nsubsection\n57DB(1)\nrestrictions on supplying\nsafety and security\ninformation\nsubsection\n57DE(2)\nrequiring a data provider\nto keep records\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
