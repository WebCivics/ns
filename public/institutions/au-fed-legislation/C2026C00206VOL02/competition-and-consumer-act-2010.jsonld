    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58eh-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to consider object of Part",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "SPF regulator must have regard to the object of this Part",
      "cml:conclusionText": "when deciding whether to make a disclosure under this Subdivision"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ei",
      "@type": "cml:Concept",
      "skos:prefLabel": "58EI Notice need not be given of a collection, use or disclosure of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ei"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.244",
      "values:originalText": "information or documents under this Part\n\nAn SPF regulator need not notify any person that the SPF\nregulator:\n\n(a) has collected SPF personal information under this Part; or\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nRegulating the Scams Prevention Framework  Division 5\n\nSection 58EJ\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) plans to make a disclosure of information or documents\nunder this Part; or\n\n(c) has made such a disclosure under this Part; or\n\n(d) plans to use information or documents disclosed under this\nPart; or\n\n(e) has used such information or documents under this Part.",
      "skos:definition": "information or documents under this Part\n\nAn SPF regulator need not notify any person that the SPF\nregulator:\n\n(a) has collected SPF personal information under this Part; or\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nRegulating the Scams Prevention Framework  Division 5\n\nSection 58EJ\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) plans to make a disclosure of information or documents\nunder this Part; or\n\n(c) has made such a disclosure under this Part; or\n\n(d) plans to use information or documents disclosed under this\nPart; or\n\n(e) has used such information or documents under this Part.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58ei-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58ei-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dac4be3f30f7f2ddc091b30ce15af59a2215396665a760505527938891872b46",
      "skos:note": "No notification required for certain actions under this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ei",
      "@type": "cof:Section",
      "cof:title": "58EI Notice need not be given of a collection, use or disclosure of",
      "values:kind": "section",
      "cof:pageNumber": 244,
      "values:originalText": "information or documents under this Part\n\nAn SPF regulator need not notify any person that the SPF\nregulator:\n\n(a) has collected SPF personal information under this Part; or\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nRegulating the Scams Prevention Framework  Division 5\n\nSection 58EJ\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) plans to make a disclosure of information or documents\nunder this Part; or\n\n(c) has made such a disclosure under this Part; or\n\n(d) plans to use information or documents disclosed under this\nPart; or\n\n(e) has used such information or documents under this Part."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ei-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
