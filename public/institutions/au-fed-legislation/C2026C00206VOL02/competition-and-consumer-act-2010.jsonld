      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.488",
      "values:originalText": "(4) In deciding whether there is effective supervision of prices charged\nby a State or Territory authority, if the State or Territory concerned\nis a party to the Competition Principles Agreement, the Council\nmust apply the relevant principles set out in the agreement.\nDefinitions",
      "skos:definition": "(4) In deciding whether there is effective supervision of prices charged\nby a State or Territory authority, if the State or Territory concerned\nis a party to the Competition Principles Agreement, the Council\nmust apply the relevant principles set out in the agreement.\nDefinitions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-95y"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95y-ss-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95y-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f29b26aa0c72b1261fc3a5d09a50d1446ae4d2811df1e725261c46d7a97e8632",
      "skos:note": "Council must apply relevant principles from the Competition Principles Agreement when deciding on effective supervision of prices charged by a State or Territory authority."
    },
    {
