      },
      "cml:premiseText": "(1) The CDR provisions bind the Crown in each of its capacities.",
      "cml:conclusionText": "The Crown is obligated to comply with the CDR provisions."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56aq-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
