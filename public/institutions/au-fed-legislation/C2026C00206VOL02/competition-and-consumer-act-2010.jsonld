      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.524",
      "values:originalText": "(1) The Tribunal may order that a participant in a proceeding before\nthe Tribunal under this Division ceases to be a participant in the\nproceeding if the participant gives written notice to the Tribunal\nthat the participant wishes to cease being a participant in the\nproceeding.\nException",
      "skos:definition": "(1) The Tribunal may order that a participant in a proceeding before\nthe Tribunal under this Division ceases to be a participant in the\nproceeding if the participant gives written notice to the Tribunal\nthat the participant wishes to cease being a participant in the\nproceeding.\nException",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-100k"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100k-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100k-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "757eeb2a9c513159245836a07bdc8bf118196cfa544f0670da5e4e6e9cb9a5a8",
      "skos:note": "Participant must provide written notice to cease participation.",
      "dc:description": "Written notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100k-ss-1",
      "@type": "cof:Section",
      "cof:title": "100K(1) Certain participants may seek to withdraw from being",
      "values:kind": "subsection",
      "cof:pageNumber": 524,
      "values:originalText": "(1) The Tribunal may order that a participant in a proceeding before\nthe Tribunal under this Division ceases to be a participant in the\nproceeding if the participant gives written notice to the Tribunal\nthat the participant wishes to cease being a participant in the\nproceeding.\nException"
    },
