        }
      ],
      "cml:integrityHash": "83d0fcd3b0ffa7e8390750a8b3c46ead214eaa9e401d6557b41218bc15684d62",
      "skos:note": "Initiating party must provide written notice to responding party before initiating action.",
      "dc:description": "yes"
