      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-86d-ss-1a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-86d-ss-1a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "888b05114b61121dadf8f868cacd9ddff11ce68e9fb34e1ad240e512a9b67ab1",
      "skos:note": "Court may make adverse publicity order against a person guilty of certain offences."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-86d-ss-1a",
      "@type": "cof:Section",
      "cof:title": "86D(1A) Punitive orders—adverse publicity",
      "values:kind": "subsection",
      "cof:pageNumber": 360,
      "values:originalText": "(1A) The Court may, on application by the Director of Public\nProsecutions, make an adverse publicity order in relation to a\nperson who is guilty of an offence against section 45AF or 45AG\nor subsection 56BN(1) or 56BZI(1)."
    },
    {
