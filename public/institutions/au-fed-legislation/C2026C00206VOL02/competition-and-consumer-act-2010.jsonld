    {
      "@id": "concept:competition-and-consumer-act-2010-sec-55l",
      "@type": "cml:Concept",
      "skos:prefLabel": "55L Effect of failure to comply with an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.34",
      "values:originalText": "If:\n\n(a) an infringement notice for an alleged contravention of\nsection 55B is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 55N;\nthe person is liable to proceedings under section 76 in relation to\nthe alleged contravention of section 55B.",
      "skos:definition": "If:\n\n(a) an infringement notice for an alleged contravention of\nsection 55B is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 55N;\nthe person is liable to proceedings under section 76 in relation to\nthe alleged contravention of section 55B.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55l-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "da7b8deef654e01c8df08fb07367a8a925d93fc388156c36fce17aa3722c227e",
      "skos:note": "Failure to comply with infringement notice results in liability for alleged contravention."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55l",
      "@type": "cof:Section",
      "cof:title": "55L Effect of failure to comply with an infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "If:\n\n(a) an infringement notice for an alleged contravention of\nsection 55B is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 55N;\nthe person is liable to proceedings under section 76 in relation to\nthe alleged contravention of section 55B."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-55l-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-55l"
