      "cof:pageNumber": 528,
      "values:originalText": "(3) Subsection (2) does not apply to information, documents or\nevidence to which the Commission was not permitted to have\nregard in making the determination."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100r-ss-3-norm",
      "@type": "values:Prohibition",
