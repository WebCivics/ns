      },
      "cml:premiseText": "(1) The CDR provisions bind the Crown in each of its capacities.",
      "cml:conclusionText": "The CDR provisions apply to the Crown's capacities from the time they come into effect until they are repealed or amended."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56aq-ss-1-logic-dialectical-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Dialectical"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "The CDR provisions imply a duty on the Crown to comply with them.",
      "cml:executionSurface": "modalities::dialectical",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The CDR provisions bind the Crown in each of its capacities.",
      "cml:conclusionText": "The Crown's compliance with the CDR provisions is implied by their binding nature."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56aq-ss-1-logic-linearlogic-4",
