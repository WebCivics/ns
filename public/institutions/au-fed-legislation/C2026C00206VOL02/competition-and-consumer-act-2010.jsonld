      "cml:logicSummary": "Defines temporal intervals for carbon tax removal and repeal",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "carbon tax repeal means...",
      "cml:conclusionText": "occurs after specified events"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Establishes obligations related to carbon tax removal and repeal",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "carbon charge component of levy means...",
      "cml:conclusionText": "must be calculated as such"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60a-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Relates payment surcharges to industry provisions",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Provisions relating to particular industries, payment surcharges etc.",
      "cml:conclusionText": "payment surcharges are relevant"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60a-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
