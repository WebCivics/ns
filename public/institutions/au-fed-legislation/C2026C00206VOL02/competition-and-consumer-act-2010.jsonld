      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fs",
      "@type": "cml:Concept",
      "skos:prefLabel": "58FS Effect of failure to comply with an SPF infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fs"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.262",
      "values:originalText": "If:\n\n(a) an SPF infringement notice for an alleged contravention of a\ncivil penalty provision is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the notice\nwithin the infringement notice compliance period and in\naccordance with the notice; and\n\n(c) the notice is not withdrawn under section 58FU;\nthe person is liable to proceedings for an SPF civil penalty order in\nrelation to the alleged contravention of the civil penalty provision.",
      "skos:definition": "If:\n\n(a) an SPF infringement notice for an alleged contravention of a\ncivil penalty provision is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the notice\nwithin the infringement notice compliance period and in\naccordance with the notice; and\n\n(c) the notice is not withdrawn under section 58FU;\nthe person is liable to proceedings for an SPF civil penalty order in\nrelation to the alleged contravention of the civil penalty provision.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58fs-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58fs-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58fs-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "96c7d5c2d53f4e6fd8a7767a73bd436783d2780279eeed045a0c76ab698922bd",
      "skos:note": "Failure to pay penalty results in liability for SPF civil penalty order."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fs",
      "@type": "cof:Section",
      "cof:title": "58FS Effect of failure to comply with an SPF infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 262,
      "values:originalText": "If:\n\n(a) an SPF infringement notice for an alleged contravention of a\ncivil penalty provision is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the notice\nwithin the infringement notice compliance period and in\naccordance with the notice; and\n\n(c) the notice is not withdrawn under section 58FU;\nthe person is liable to proceedings for an SPF civil penalty order in\nrelation to the alleged contravention of the civil penalty provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fs-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58fs"
      },
