      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.300",
      "values:originalText": "(5) A carbon tax removal substantiation notice must explain the effect\nof:\n\n(a) section 60FB; and\n\n(b) section 60FC; and\n\n(c) sections 137.1 and 137.2 of the Criminal Code.\nSection does not limit section 60H",
      "skos:definition": "(5) A carbon tax removal substantiation notice must explain the effect\nof:\n\n(a) section 60FB; and\n\n(b) section 60FC; and\n\n(c) sections 137.1 and 137.2 of the Criminal Code.\nSection does not limit section 60H",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-60fa"
      },
