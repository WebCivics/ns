          "@id": "concept:competition-and-consumer-act-2010-sec-87cg-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "327408e675da9310ad265f0e0bc0aafa9201f788b7cf0c6449e38f44acf2bcca",
      "skos:note": "Allows a plaintiff to bring another action against a concurrent wrongdoer for the same damage or loss."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87cg-ss-1",
