      "cml:premiseText": "(aa) attempts to contravene; or (a) aids, abets, counsels or procures a person to contravene;",
      "cml:conclusionText": "is punishable"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits being knowingly concerned in or party to the contravention by a person of a provision.",
