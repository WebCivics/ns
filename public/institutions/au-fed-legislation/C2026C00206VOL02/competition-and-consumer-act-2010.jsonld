    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95zi",
      "@type": "cml:Concept",
      "skos:prefLabel": "95ZI Inquiries by an unincorporated body or a group of 2 or more",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95zi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.499",
      "values:originalText": "individuals\n\n(1) This section applies to inquiries by an unincorporated body or a\ngroup of 2 or more individuals.\n\n(2) The regulations may make provision for and in relation to the\nmanner in which the unincorporated body or group of individuals\nis to:\n\n(a) give a notice, report or other document to a person under this\nPart; or\n\n(b) do any other thing under this Part.\n\nChapter 6  Other provisions",
      "skos:definition": "individuals\n\n(1) This section applies to inquiries by an unincorporated body or a\ngroup of 2 or more individuals.\n\n(2) The regulations may make provision for and in relation to the\nmanner in which the unincorporated body or group of individuals\nis to:\n\n(a) give a notice, report or other document to a person under this\nPart; or\n\n(b) do any other thing under this Part.\n\nChapter 6  Other provisions",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zi-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zi-ss-2"
        }
      ],
      "cml:integrityHash": "195c703b019ccaecd75b62a9492643a90c25a9d1f22006744ecb212ba2e92fd0"
    },
