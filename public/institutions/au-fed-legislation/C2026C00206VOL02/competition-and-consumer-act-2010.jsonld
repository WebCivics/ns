    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57be",
      "@type": "cml:Concept",
      "skos:prefLabel": "57BE Meaning of data provider",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57be"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.170",
      "values:originalText": "A data provider is:\n\n(a) a corporation carrying on a business that includes supplying,\nto any extent and whether directly or indirectly, scheme\ninformation to one or more Australian repairers or scheme\nRTOs; or\n\n(b) any person who carries on such a business in the course of, or\nin relation to, trade or commerce.",
      "skos:definition": "A data provider is:\n\n(a) a corporation carrying on a business that includes supplying,\nto any extent and whether directly or indirectly, scheme\ninformation to one or more Australian repairers or scheme\nRTOs; or\n\n(b) any person who carries on such a business in the course of, or\nin relation to, trade or commerce.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57be-norm"
        }
      ],
      "cml:integrityHash": "a8e5614cc703181e671301b0b1ef51d5ba4ac0344d9195155536274966fd6c5b",
      "skos:note": "Definition of data provider"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57be",
      "@type": "cof:Section",
      "cof:title": "57BE Meaning of data provider",
      "values:kind": "section",
      "cof:pageNumber": 170,
      "values:originalText": "A data provider is:\n\n(a) a corporation carrying on a business that includes supplying,\nto any extent and whether directly or indirectly, scheme\ninformation to one or more Australian repairers or scheme\nRTOs; or\n\n(b) any person who carries on such a business in the course of, or\nin relation to, trade or commerce."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57be-norm",
      "@type": "values:Obligation",
