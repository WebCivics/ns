    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j",
      "@type": "cml:Concept",
      "skos:prefLabel": "87J The effect of minority or incapacity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.383",
      "values:originalText": "In working out whether the period of 3 years after the date of\ndiscoverability, or the long-stop period, has expired, disregard any\nperiod during which the plaintiff has been:\n\nChapter 5  Enforcement and remedies",
      "skos:definition": "In working out whether the period of 3 years after the date of\ndiscoverability, or the long-stop period, has expired, disregard any\nperiod during which the plaintiff has been:\n\nChapter 5  Enforcement and remedies",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87j-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-ltl-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-diffusion-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "79deae7382e58f4e5f8d33b303e8b3ba0890ccd62acb82bcca013a4f80a7c0a6",
      "skos:note": "Disregard periods of minority or incapacity when determining the expiration of a period."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87j",
      "@type": "cof:Section",
      "cof:title": "87J The effect of minority or incapacity",
      "values:kind": "section",
      "cof:pageNumber": 383,
      "values:originalText": "In working out whether the period of 3 years after the date of\ndiscoverability, or the long-stop period, has expired, disregard any\nperiod during which the plaintiff has been:\n\nChapter 5  Enforcement and remedies"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87j"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Ignore",
      "cml:logicSummary": "Ignoring minority or incapacity periods",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The period of 3 years after the date of discoverability has expired.",
      "cml:conclusionText": "Disregard any period during which the plaintiff has been unable to work."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between minority or incapacity periods and the expiration of a period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The long-stop period may have begun before the plaintiff's minority or incapacity began.",
      "cml:conclusionText": "Disregard any period during which the plaintiff has been unable to work."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between minority or incapacity periods and the expiration of a period (recurring trace)",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The plaintiff's inability to work is a recurring characteristic of the class of persons affected by the provision.",
      "cml:conclusionText": "Disregard any period during which the plaintiff has been unable to work."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between minority or incapacity periods and the expiration of a period (diffusion)",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The long-stop period may have begun before the plaintiff's minority or incapacity began.",
      "cml:conclusionText": "Disregard any period during which the plaintiff has been unable to work."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87j-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between minority or incapacity periods and the expiration of a period (cognitive AI)",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The plaintiff's inability to work is a characteristic of the class of persons affected by the provision.",
      "cml:conclusionText": "Disregard any period during which the plaintiff has been unable to work."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87k",
      "@type": "cml:Concept",
      "skos:prefLabel": "87K The effect of close relationships",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.384",
      "values:originalText": "(1) If:\n\n(a) a cause of action to which the proceeding relates is founded\non the death or injury to a person (the victim) who was a\nminor at the time of the act or omission alleged to have\ncaused the death or injury; and\n\n(b) the proceeding is taken against a person who was at that\ntime:\n\n(i) a parent or guardian of the victim; or\n\n(ii) a person in a close relationship with a parent or guardian\nof the victim;\nin working out whether the period of 3 years after the date of\ndiscoverability, or the long-stop period, has expired, disregard any\nperiod:\n\n(c) before the victim turns 25; or\n\n(d) if the victim dies before turning 25—before the victim’s\ndeath.\n\n(2) For the purposes of subparagraph (1)(b)(ii), a person is taken to be\nin a close relationship with a parent or guardian of the victim if the\nperson’s relationship with the parent or guardian is such that:\n\n(a) the person might influence the parent or guardian not to bring\na claim on behalf of the victim against the person; or\n\n(b) the victim might be unwilling to disclose to the parent or\nguardian the acts, omissions or events in respect of which the\ncause of action is founded.\n\nEnforcement and remedies  Chapter 5\nClaims for damages or compensation for death or personal injury  Part VIB\nLimits on personal injury damages for non-economic loss  Division 3\n\nSection 87L\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) If:\n\n(a) a cause of action to which the proceeding relates is founded\non the death or injury to a person (the victim) who was a\nminor at the time of the act or omission alleged to have\ncaused the death or injury; and\n\n(b) the proceeding is taken against a person who was at that\ntime:\n\n(i) a parent or guardian of the victim; or\n\n(ii) a person in a close relationship with a parent or guardian\nof the victim;\nin working out whether the period of 3 years after the date of\ndiscoverability, or the long-stop period, has expired, disregard any\nperiod:\n\n(c) before the victim turns 25; or\n\n(d) if the victim dies before turning 25—before the victim’s\ndeath.\n\n(2) For the purposes of subparagraph (1)(b)(ii), a person is taken to be\nin a close relationship with a parent or guardian of the victim if the\nperson’s relationship with the parent or guardian is such that:\n\n(a) the person might influence the parent or guardian not to bring\na claim on behalf of the victim against the person; or\n\n(b) the victim might be unwilling to disclose to the parent or\nguardian the acts, omissions or events in respect of which the\ncause of action is founded.\n\nEnforcement and remedies  Chapter 5\nClaims for damages or compensation for death or personal injury  Part VIB\nLimits on personal injury damages for non-economic loss  Division 3\n\nSection 87L\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
