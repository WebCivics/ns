        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) conspires with others to contravene;",
      "cml:conclusionText": "is punishable"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits a person not being a body corporate from contravening a provision.",
