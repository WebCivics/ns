    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95x",
      "@type": "cml:Concept",
      "skos:prefLabel": "95X Declarations by Minister or Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.488",
      "values:originalText": "Notified goods or services\n\n(1) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare goods or services of\na specified description to be notified goods or services for the\npurposes of this Part.\nDeclared persons\n\n(2) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare a person to be, in\nrelation to goods or services of a specified description, a declared\nperson for the purposes of this Part.\n\n(3) The Commission must give the person notice in writing of a\ndeclaration under subsection (2). The notice must set out the effect\nof section 95Z.\n\n(4) A declaration under subsection (2) must specify the time when it is\nto cease to have effect. Such a declaration ceases to have effect at\nthe time specified, unless it is revoked sooner.\nVariation or revocation\n\n(5) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under this section.",
      "skos:definition": "Notified goods or services\n\n(1) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare goods or services of\na specified description to be notified goods or services for the\npurposes of this Part.\nDeclared persons\n\n(2) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare a person to be, in\nrelation to goods or services of a specified description, a declared\nperson for the purposes of this Part.\n\n(3) The Commission must give the person notice in writing of a\ndeclaration under subsection (2). The notice must set out the effect\nof section 95Z.\n\n(4) A declaration under subsection (2) must specify the time when it is\nto cease to have effect. Such a declaration ceases to have effect at\nthe time specified, unless it is revoked sooner.\nVariation or revocation\n\n(5) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under this section.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95x-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95x-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95x-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95x-ss-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95x-ss-5"
        }
      ],
      "cml:integrityHash": "78bbd191e5e3e5812d64904d9c3bcac740442da42c5e9fd07e50dcf328447eef"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95x",
      "@type": "cof:Section",
      "cof:title": "95X Declarations by Minister or Commission",
      "values:kind": "section",
      "cof:pageNumber": 488,
      "values:originalText": "Notified goods or services\n\n(1) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare goods or services of\na specified description to be notified goods or services for the\npurposes of this Part.\nDeclared persons\n\n(2) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette declare a person to be, in\nrelation to goods or services of a specified description, a declared\nperson for the purposes of this Part.\n\n(3) The Commission must give the person notice in writing of a\ndeclaration under subsection (2). The notice must set out the effect\nof section 95Z.\n\n(4) A declaration under subsection (2) must specify the time when it is\nto cease to have effect. Such a declaration ceases to have effect at\nthe time specified, unless it is revoked sooner.\nVariation or revocation\n\n(5) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under this section."
    },
