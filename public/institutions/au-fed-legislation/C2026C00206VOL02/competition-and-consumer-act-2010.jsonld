    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57eh",
      "@type": "cml:Concept",
      "skos:prefLabel": "57EH Costs of mediation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57eh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.189",
      "values:originalText": "(1) The parties are equally liable for the costs of mediation under this\nDivision unless they agree otherwise.\n\n(2) The parties must pay their own costs of attending the mediation.\n\n(3) The costs of mediation under this Division under subsection (1)\ninclude the following:\n\n(a) the cost of the mediator;\n\n(b) the cost of any additional input (including from technical\nexperts) agreed by both parties to be necessary to conduct the\nmediation.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) The parties are equally liable for the costs of mediation under this\nDivision unless they agree otherwise.\n\n(2) The parties must pay their own costs of attending the mediation.\n\n(3) The costs of mediation under this Division under subsection (1)\ninclude the following:\n\n(a) the cost of the mediator;\n\n(b) the cost of any additional input (including from technical\nexperts) agreed by both parties to be necessary to conduct the\nmediation.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57eh-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57eh-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57eh-ss-3"
        }
      ],
      "cml:integrityHash": "cc998d6872ceebd2c000327212641118a587054756af2fc9b5179a58bc94eb93"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57eh",
      "@type": "cof:Section",
      "cof:title": "57EH Costs of mediation",
      "values:kind": "section",
      "cof:pageNumber": 189,
      "values:originalText": "(1) The parties are equally liable for the costs of mediation under this\nDivision unless they agree otherwise.\n\n(2) The parties must pay their own costs of attending the mediation.\n\n(3) The costs of mediation under this Division under subsection (1)\ninclude the following:\n\n(a) the cost of the mediator;\n\n(b) the cost of any additional input (including from technical\nexperts) agreed by both parties to be necessary to conduct the\nmediation.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
