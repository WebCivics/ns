      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58de",
      "@type": "cml:Concept",
      "skos:prefLabel": "58DE Disclosing information to the operator of an SPF EDR scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58de"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.237",
      "values:originalText": "(1) An SPF regulator may disclose information to the operator of an\nSPF EDR scheme for the purposes of enabling or assisting the\noperator to perform any of the operator’s functions or powers.\n\n(2) The SPF regulator may impose conditions to be complied with by\nthe operator in relation to the information.\n\n(3) If an SPF regulator is to disclose SPF personal information under\nsubsection (1), the SPF regulator must de-identify the information\nunless the SPF regulator reasonably believes that doing so would\nnot achieve the object of this Part.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) An SPF regulator may disclose information to the operator of an\nSPF EDR scheme for the purposes of enabling or assisting the\noperator to perform any of the operator’s functions or powers.\n\n(2) The SPF regulator may impose conditions to be complied with by\nthe operator in relation to the information.\n\n(3) If an SPF regulator is to disclose SPF personal information under\nsubsection (1), the SPF regulator must de-identify the information\nunless the SPF regulator reasonably believes that doing so would\nnot achieve the object of this Part.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58de-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58de-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58de-ss-3"
        }
      ],
      "cml:integrityHash": "93ddd01e0b72ca5c010819f1685be9285744f4e2d03566b9bf9ff4f7ed964938"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58de",
      "@type": "cof:Section",
      "cof:title": "58DE Disclosing information to the operator of an SPF EDR scheme",
      "values:kind": "section",
      "cof:pageNumber": 237,
      "values:originalText": "(1) An SPF regulator may disclose information to the operator of an\nSPF EDR scheme for the purposes of enabling or assisting the\noperator to perform any of the operator’s functions or powers.\n\n(2) The SPF regulator may impose conditions to be complied with by\nthe operator in relation to the information.\n\n(3) If an SPF regulator is to disclose SPF personal information under\nsubsection (1), the SPF regulator must de-identify the information\nunless the SPF regulator reasonably believes that doing so would\nnot achieve the object of this Part.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58de-ss-1",
