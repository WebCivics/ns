    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57gd",
      "@type": "cml:Concept",
      "skos:prefLabel": "57GD Acquisition of property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.194",
      "values:originalText": "Scope\n\n(1) This section applies to any of the following provisions:\n\n(a) a provision of Division 3;\n\n(b) any other provision of this Act, to the extent to which the\nprovision relates to Division 3.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) from a person\notherwise than on just terms (within the meaning of that\nparagraph).\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nMiscellaneous  Division 7\n\nSection 57GE\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Scope\n\n(1) This section applies to any of the following provisions:\n\n(a) a provision of Division 3;\n\n(b) any other provision of this Act, to the extent to which the\nprovision relates to Division 3.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) from a person\notherwise than on just terms (within the meaning of that\nparagraph).\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nMiscellaneous  Division 7\n\nSection 57GE\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57gd-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57gd-ss-2"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gd",
      "@type": "cof:Section",
      "cof:title": "57GD Acquisition of property",
      "values:kind": "section",
      "cof:pageNumber": 194,
      "values:originalText": "Scope\n\n(1) This section applies to any of the following provisions:\n\n(a) a provision of Division 3;\n\n(b) any other provision of this Act, to the extent to which the\nprovision relates to Division 3.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) from a person\notherwise than on just terms (within the meaning of that\nparagraph).\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nMiscellaneous  Division 7\n\nSection 57GE\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
