    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95g-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "95G(7) Commission’s functions under this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95g-ss-7"
      },
      "cml:curationStatus": {
