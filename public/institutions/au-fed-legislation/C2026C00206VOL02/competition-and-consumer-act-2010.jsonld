    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60g-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "60G(4) Commission may monitor prices in relation to the carbon tax",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60g-ss-4"
      },
