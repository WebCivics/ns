      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The data provider is a small business operator within the meaning of the Privacy Act 1988.",
      "cml:conclusionText": "Use or disclosure of sensitive information is restricted."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57dc-logic-alleninterval-2",
