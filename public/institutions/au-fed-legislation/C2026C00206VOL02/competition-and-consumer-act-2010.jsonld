      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57aa-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Promote competition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ab",
      "@type": "cml:Concept",
      "skos:prefLabel": "57AB Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ab"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.166",
      "values:originalText": "This Part sets up a scheme to improve access by Australian motor\nvehicle repairers and registered training organisations (called\n“scheme RTOs”) to information used to diagnose faults with,\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nObjects of Part and simplified outline  Division 1\n\nSection 57AB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nservice, repair, modify or dismantle motor vehicles covered by the\nscheme.\nSuch information (called “scheme information”) is required to be\noffered for supply to Australian repairers and scheme RTOs at a\nprice that does not exceed fair market value.\nThose who supply scheme information (called “data providers”) to\nAustralian repairers and scheme RTOs are protected from certain\ncivil claims in doing so.\nTo protect the safety and security of vehicle owners, individuals\nworking for an Australian repairer or scheme RTO who access\nscheme information relating to vehicle safety and security must\nsatisfy certain criteria relating to whether they are fit and proper\npersons to have access to such information.\nSensitive information about such individuals may be obtained by\ndata providers for this purpose. The handling of such information\nis also restricted under this Part. The information cannot be made\navailable to anyone outside Australia (including to any data\nprovider).\nProvision is made for resolving disputes about the application of\nthe Part.\nProvision is made for a scheme adviser. The scheme adviser’s\nfunctions include facilitating mediation of disputes between data\nproviders and Australian repairers or scheme RTOs, and providing\ninformation about the operation of the scheme.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "This Part sets up a scheme to improve access by Australian motor\nvehicle repairers and registered training organisations (called\n“scheme RTOs”) to information used to diagnose faults with,\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nObjects of Part and simplified outline  Division 1\n\nSection 57AB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nservice, repair, modify or dismantle motor vehicles covered by the\nscheme.\nSuch information (called “scheme information”) is required to be\noffered for supply to Australian repairers and scheme RTOs at a\nprice that does not exceed fair market value.\nThose who supply scheme information (called “data providers”) to\nAustralian repairers and scheme RTOs are protected from certain\ncivil claims in doing so.\nTo protect the safety and security of vehicle owners, individuals\nworking for an Australian repairer or scheme RTO who access\nscheme information relating to vehicle safety and security must\nsatisfy certain criteria relating to whether they are fit and proper\npersons to have access to such information.\nSensitive information about such individuals may be obtained by\ndata providers for this purpose. The handling of such information\nis also restricted under this Part. The information cannot be made\navailable to anyone outside Australia (including to any data\nprovider).\nProvision is made for resolving disputes about the application of\nthe Part.\nProvision is made for a scheme adviser. The scheme adviser’s\nfunctions include facilitating mediation of disputes between data\nproviders and Australian repairers or scheme RTOs, and providing\ninformation about the operation of the scheme.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ab-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ab-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ab-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ab-logic-linearlogic-3"
        }
      ],
      "cml:integrityHash": "fd0b804ff1a79ba7767252a2f303f79dc447f85eb0e7f76d73503b7fb3f8ed9c",
      "skos:note": "Supply of scheme information to Australian repairers and scheme RTOs is required.",
      "dc:description": "Fair market value"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ab",
      "@type": "cof:Section",
      "cof:title": "57AB Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 166,
      "values:originalText": "This Part sets up a scheme to improve access by Australian motor\nvehicle repairers and registered training organisations (called\n“scheme RTOs”) to information used to diagnose faults with,\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nMotor vehicle service and repair information sharing scheme  Part IVE\nObjects of Part and simplified outline  Division 1\n\nSection 57AB\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nservice, repair, modify or dismantle motor vehicles covered by the\nscheme.\nSuch information (called “scheme information”) is required to be\noffered for supply to Australian repairers and scheme RTOs at a\nprice that does not exceed fair market value.\nThose who supply scheme information (called “data providers”) to\nAustralian repairers and scheme RTOs are protected from certain\ncivil claims in doing so.\nTo protect the safety and security of vehicle owners, individuals\nworking for an Australian repairer or scheme RTO who access\nscheme information relating to vehicle safety and security must\nsatisfy certain criteria relating to whether they are fit and proper\npersons to have access to such information.\nSensitive information about such individuals may be obtained by\ndata providers for this purpose. The handling of such information\nis also restricted under this Part. The information cannot be made\navailable to anyone outside Australia (including to any data\nprovider).\nProvision is made for resolving disputes about the application of\nthe Part.\nProvision is made for a scheme adviser. The scheme adviser’s\nfunctions include facilitating mediation of disputes between data\nproviders and Australian repairers or scheme RTOs, and providing\ninformation about the operation of the scheme.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ab-norm",
