    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60h-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "prohibition",
      "cml:logicSummary": "Prohibition on omitting to comply with a requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person omits to do an act; and (d) the omission breaches the requirement;",
      "cml:conclusionText": "The person commits an offence if..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60h-ss-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:logicSummary": "Temporal interval between a requirement and its breach.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person omits to do an act; and (d) the omission breaches the requirement;",
      "cml:conclusionText": "The omission occurs within the temporal interval between the requirement and its breach."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60h-ss-4-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "between",
      "cml:logicSummary": "Temporal interval between a requirement and its breach.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person omits to do an act; and (d) the omission breaches the requirement;",
      "cml:conclusionText": "The temporal interval between the requirement and its breach is non-empty."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60h-ss-4-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
