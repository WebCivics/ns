      "cml:integrityHash": "b656c745cd0ef72c639ea77ddcc1b283f2206d8f209b314f012ecb6316e8a29a",
      "skos:note": "The Information Commissioner has certain functions and may consult with others about matters relevant to the operation of this Part. Delegation of functions or powers under this Part",
      "dc:references": [
        "Acts Interpretation Act 1901"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ga-ss-1",
      "@type": "cof:Section",
      "cof:title": "56GA(1) CDR functions of the Information Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 158,
      "values:originalText": "(1) The Secretary of the Department may, in writing, delegate all or\nany of the Secretary’s functions or powers under this Part to an\nSES employee, or an acting SES employee, in the Department.\nNote:\nSections 34AA to 34A of the Acts Interpretation Act 1901 contain\nprovisions relating to delegations."
    },
