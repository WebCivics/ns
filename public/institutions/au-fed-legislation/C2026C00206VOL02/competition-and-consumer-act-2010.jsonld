    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "58AA Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.196",
      "values:originalText": "The object of this Part is to prevent and respond to scams\nimpacting:\n\n(a) either:\n\n(i) natural persons while they are in Australia; or\n\n(ii) persons who carry on small businesses in Australia;\n\nif the scams relate to, are connected with, or use certain\nservices that are or may be provided or purportedly provided\nto those persons; or\n\n(b) natural persons while they are outside of Australia if:\n\n(i) they are ordinarily resident in Australia; and\n\n(ii) the scams relate to, are connected with, or use certain\nservices that are or may be provided or purportedly\nprovided to those persons by Australian service\nproviders or by foreign service providers through\npermanent establishments in Australia.",
      "skos:definition": "The object of this Part is to prevent and respond to scams\nimpacting:\n\n(a) either:\n\n(i) natural persons while they are in Australia; or\n\n(ii) persons who carry on small businesses in Australia;\n\nif the scams relate to, are connected with, or use certain\nservices that are or may be provided or purportedly provided\nto those persons; or\n\n(b) natural persons while they are outside of Australia if:\n\n(i) they are ordinarily resident in Australia; and\n\n(ii) the scams relate to, are connected with, or use certain\nservices that are or may be provided or purportedly\nprovided to those persons by Australian service\nproviders or by foreign service providers through\npermanent establishments in Australia.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58aa-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b067985a0fa8422d3c059fb54d7753f1de4efe07678d1a8673e91a84c91d75c2",
      "skos:note": "Prevent and respond to scams impacting natural persons in Australia or those who carry on small businesses in Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58aa",
      "@type": "cof:Section",
      "cof:title": "58AA Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 196,
      "values:originalText": "The object of this Part is to prevent and respond to scams\nimpacting:\n\n(a) either:\n\n(i) natural persons while they are in Australia; or\n\n(ii) persons who carry on small businesses in Australia;\n\nif the scams relate to, are connected with, or use certain\nservices that are or may be provided or purportedly provided\nto those persons; or\n\n(b) natural persons while they are outside of Australia if:\n\n(i) they are ordinarily resident in Australia; and\n\n(ii) the scams relate to, are connected with, or use certain\nservices that are or may be provided or purportedly\nprovided to those persons by Australian service\nproviders or by foreign service providers through\npermanent establishments in Australia."
    },
    {
