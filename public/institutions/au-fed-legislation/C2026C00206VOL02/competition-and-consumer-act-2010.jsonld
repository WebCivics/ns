      },
      "cml:premiseText": "(3) If, at any time after granting an authorisation...",
      "cml:conclusionText": "The Commission may revoke the authorisation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with temporal intervals related to authorisation grant",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "there has been a material change of circumstances since the authorisation was granted;",
      "cml:conclusionText": "The Commission considers revocation during overlapping time periods."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-3-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Imply",
      "cml:logicSummary": "Implies that persons interested must be informed of proposed revocation",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) inform those persons that it is considering the revocation of the authorisation;",
      "cml:conclusionText": "The Commission informs persons of proposed revocation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Spreads information about proposed revocation to interested parties",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) inform those persons that it is considering the revocation of the authorisation;",
      "cml:conclusionText": "The Commission spreads information about proposed revocation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Analyze",
      "cml:logicSummary": "Analyzes submissions received in response to proposed revocation",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(f) invite submissions in respect of the revocation within a period specified by the Commission.",
      "cml:conclusionText": "The Commission analyzes submissions."
    },
    {
