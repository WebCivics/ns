    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95c",
      "@type": "cml:Concept",
      "skos:prefLabel": "95C Application of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.470",
      "values:originalText": "This Part applies in relation to the supply of goods or services:\n\n(a) by a Commonwealth authority; or\n\n(b) by a foreign corporation; or\n\n(c) by a trading corporation in the course of, or for the purposes\nof, its trading operations; or\n\n(d) by a financial corporation in the course of, or for the\npurposes of, its business operations; or\n\n(e) by a body corporate incorporated in a Territory (other than\nthe Northern Territory); or\n\n(f) in a Territory (other than the Northern Territory); or\n\n(g) in the course of, or in connection with, trade or commerce:\n\n(i) among the States; or\n\n(ii) between a State and a Territory; or\n\n(iii) between 2 Territories;\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPreliminary  Division 1\n\nSection 95D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nand not otherwise.",
      "skos:definition": "This Part applies in relation to the supply of goods or services:\n\n(a) by a Commonwealth authority; or\n\n(b) by a foreign corporation; or\n\n(c) by a trading corporation in the course of, or for the purposes\nof, its trading operations; or\n\n(d) by a financial corporation in the course of, or for the\npurposes of, its business operations; or\n\n(e) by a body corporate incorporated in a Territory (other than\nthe Northern Territory); or\n\n(f) in a Territory (other than the Northern Territory); or\n\n(g) in the course of, or in connection with, trade or commerce:\n\n(i) among the States; or\n\n(ii) between a State and a Territory; or\n\n(iii) between 2 Territories;\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPreliminary  Division 1\n\nSection 95D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nand not otherwise.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95c-norm"
        }
      ],
      "cml:integrityHash": "c3066888bfd4b5a321db4b5fc26e427a9d1908e7fb18cadae6c5a1cf43cecbfe",
      "skos:note": "This Part applies in relation to the supply of goods or services by certain entities."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95c",
      "@type": "cof:Section",
      "cof:title": "95C Application of Part",
      "values:kind": "section",
      "cof:pageNumber": 470,
      "values:originalText": "This Part applies in relation to the supply of goods or services:\n\n(a) by a Commonwealth authority; or\n\n(b) by a foreign corporation; or\n\n(c) by a trading corporation in the course of, or for the purposes\nof, its trading operations; or\n\n(d) by a financial corporation in the course of, or for the\npurposes of, its business operations; or\n\n(e) by a body corporate incorporated in a Territory (other than\nthe Northern Territory); or\n\n(f) in a Territory (other than the Northern Territory); or\n\n(g) in the course of, or in connection with, trade or commerce:\n\n(i) among the States; or\n\n(ii) between a State and a Territory; or\n\n(iii) between 2 Territories;\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPreliminary  Division 1\n\nSection 95D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nand not otherwise."
    },
    {
