    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The scheme adviser has a duty to report to the Minister and the Commission.",
