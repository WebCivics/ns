      "cml:integrityHash": "995edec5010ed13da47ca26a9a7e57be4dd8820b2391988bca02b448c74b086b",
      "skos:note": "Definition of evidential burden"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56gc-ss-3",
      "@type": "cof:Section",
      "cof:title": "56GC(3) Complying with CDR requirements etc.: protection from",
      "values:kind": "subsection",
      "cof:pageNumber": 160,
      "values:originalText": "(3) In this section:\nevidential burden, in relation to a matter, means the burden of\nadducing or pointing to evidence that suggests a reasonable\npossibility that the matter exists or does not exist."
    },
