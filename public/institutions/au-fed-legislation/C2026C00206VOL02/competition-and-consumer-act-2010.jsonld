        }
      ],
      "cml:integrityHash": "a3fcac9f48eaef0c801395caf8b80eedc4fe8fcf426d13465633caa60d84e3c1",
      "skos:note": "Allowances for witnesses must be provided by reference to a scale of expenses.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95w-ss-3",
      "@type": "cof:Section",
      "cof:title": "95W(3) Allowances to witnesses",
      "values:kind": "subsection",
      "cof:pageNumber": 486,
      "values:originalText": "(3) The regulations may provide for those allowances and expenses by\nreference to a scale of expenses for witnesses who attend before a\ncourt specified in the regulations.\n\nChapter 6  Other provisions"
    },
