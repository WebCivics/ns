    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60fc",
      "@type": "cml:Concept",
      "skos:prefLabel": "60FC Compliance with carbon tax removal substantiation notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60fc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
