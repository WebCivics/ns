      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-102a",
      "@type": "cml:Concept",
      "skos:prefLabel": "102A Reviews are re-hearings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-102a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.543",
      "values:originalText": "A review by the Tribunal under this Part is a re-hearing of the\nmatter, unless it is a review of:\n\n(a) a determination by the Commission:\n\n(i) in relation to an application for a merger authorisation\nor a minor variation of a merger authorisation; or\n\n(ii) in relation to the revocation of a merger authorisation,\nor the revocation of a merger authorisation and the\nsubstitution of another merger authorisation; or\n\n(b) an acquisition determination.",
      "skos:definition": "A review by the Tribunal under this Part is a re-hearing of the\nmatter, unless it is a review of:\n\n(a) a determination by the Commission:\n\n(i) in relation to an application for a merger authorisation\nor a minor variation of a merger authorisation; or\n\n(ii) in relation to the revocation of a merger authorisation,\nor the revocation of a merger authorisation and the\nsubstitution of another merger authorisation; or\n\n(b) an acquisition determination.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-102a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-102a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1173cf82aa7d7446d1a4c0d2fe11b28676dcc71620b0241d3fb258108a1470df",
      "skos:note": "A review by the Tribunal under this Part is a re-hearing of the matter, unless it is a review of certain determinations."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-102a",
      "@type": "cof:Section",
      "cof:title": "102A Reviews are re-hearings",
      "values:kind": "section",
      "cof:pageNumber": 543,
      "values:originalText": "A review by the Tribunal under this Part is a re-hearing of the\nmatter, unless it is a review of:\n\n(a) a determination by the Commission:\n\n(i) in relation to an application for a merger authorisation\nor a minor variation of a merger authorisation; or\n\n(ii) in relation to the revocation of a merger authorisation,\nor the revocation of a merger authorisation and the\nsubstitution of another merger authorisation; or\n\n(b) an acquisition determination."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-102a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-102a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-102a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on the Tribunal.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-103",
      "@type": "cml:Concept",
      "skos:prefLabel": "103 Procedure generally",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-103"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.543",
      "values:originalText": "(1) In proceedings before the Tribunal:\n\n(a) the procedure of the Tribunal is, subject to this Act and the\nregulations, within the discretion of the Tribunal;\n\n(b) the proceedings shall be conducted with as little formality\nand technicality, and with as much expedition, as the\nrequirements of this Act and a proper consideration of the\nmatters before the Tribunal permit; and\n\n(c) the Tribunal is not bound by the rules of evidence.\n\n(2) The powers of the Tribunal with respect to matters of procedure in\nparticular proceedings may be exercised by a presidential member.\n\n(3) The powers mentioned in subsection (2) may be exercised by a\npresidential member:\n\n(a) whether or not the Tribunal has been constituted under\nsection 37 in relation to the proceedings; and\n\n(b) once the Tribunal is so constituted—whether or not that\nmember is part of the Division of the Tribunal so constituted.\n\nChapter 6  Other provisions",
      "skos:definition": "(1) In proceedings before the Tribunal:\n\n(a) the procedure of the Tribunal is, subject to this Act and the\nregulations, within the discretion of the Tribunal;\n\n(b) the proceedings shall be conducted with as little formality\nand technicality, and with as much expedition, as the\nrequirements of this Act and a proper consideration of the\nmatters before the Tribunal permit; and\n\n(c) the Tribunal is not bound by the rules of evidence.\n\n(2) The powers of the Tribunal with respect to matters of procedure in\nparticular proceedings may be exercised by a presidential member.\n\n(3) The powers mentioned in subsection (2) may be exercised by a\npresidential member:\n\n(a) whether or not the Tribunal has been constituted under\nsection 37 in relation to the proceedings; and\n\n(b) once the Tribunal is so constituted—whether or not that\nmember is part of the Division of the Tribunal so constituted.\n\nChapter 6  Other provisions",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-103-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-103-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-103-ss-3"
        }
      ],
      "cml:integrityHash": "88c9d9aadeb6eed03ae419b178156bba3c5147ea2bbe9a6a2a12a5a1eccba3ec"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-103",
      "@type": "cof:Section",
      "cof:title": "103 Procedure generally",
      "values:kind": "section",
      "cof:pageNumber": 543,
      "values:originalText": "(1) In proceedings before the Tribunal:\n\n(a) the procedure of the Tribunal is, subject to this Act and the\nregulations, within the discretion of the Tribunal;\n\n(b) the proceedings shall be conducted with as little formality\nand technicality, and with as much expedition, as the\nrequirements of this Act and a proper consideration of the\nmatters before the Tribunal permit; and\n\n(c) the Tribunal is not bound by the rules of evidence.\n\n(2) The powers of the Tribunal with respect to matters of procedure in\nparticular proceedings may be exercised by a presidential member.\n\n(3) The powers mentioned in subsection (2) may be exercised by a\npresidential member:\n\n(a) whether or not the Tribunal has been constituted under\nsection 37 in relation to the proceedings; and\n\n(b) once the Tribunal is so constituted—whether or not that\nmember is part of the Division of the Tribunal so constituted.\n\nChapter 6  Other provisions"
    },
