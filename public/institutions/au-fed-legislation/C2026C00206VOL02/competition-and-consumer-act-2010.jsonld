      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "86AA Limit on jurisdiction of Federal Circuit and Family Court of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-86aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.357",
      "values:originalText": "Australia (Division 2)\n\nIf proceedings under section 82 are instituted in, or transferred to,\nthe Federal Circuit and Family Court of Australia (Division 2), the\nCourt does not have jurisdiction to award an amount for loss or\ndamage that exceeds:\n\n(a) $750,000; or\n\n(b) if another amount is specified in the regulations—that other\namount.\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153\nof the Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976.",
      "skos:definition": "Australia (Division 2)\n\nIf proceedings under section 82 are instituted in, or transferred to,\nthe Federal Circuit and Family Court of Australia (Division 2), the\nCourt does not have jurisdiction to award an amount for loss or\ndamage that exceeds:\n\n(a) $750,000; or\n\n(b) if another amount is specified in the regulations—that other\namount.\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153\nof the Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-86aa-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-86aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7a0f0cc9ee8056999c4ce930774e16c03899bae80759de2b2d4e6b2e924ce61c",
      "skos:note": "Limit on jurisdiction of Federal Circuit and Family Court of Australia (Division 2)",
      "dc:references": [
        "sec-153",
        "sec-32AC"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-86aa",
      "@type": "cof:Section",
      "cof:title": "86AA Limit on jurisdiction of Federal Circuit and Family Court of",
      "values:kind": "section",
      "cof:pageNumber": 357,
      "values:originalText": "Australia (Division 2)\n\nIf proceedings under section 82 are instituted in, or transferred to,\nthe Federal Circuit and Family Court of Australia (Division 2), the\nCourt does not have jurisdiction to award an amount for loss or\ndamage that exceeds:\n\n(a) $750,000; or\n\n(b) if another amount is specified in the regulations—that other\namount.\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153\nof the Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976."
    },
    {
