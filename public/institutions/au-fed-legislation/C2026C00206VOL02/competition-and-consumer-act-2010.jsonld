      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87v",
      "@type": "cml:Concept",
      "skos:prefLabel": "87V Average weekly earnings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.389",
      "values:originalText": "(1) Average weekly earnings, for a quarter, means the amount:\n\n(a) published by the Australian Statistician as the average\nweekly earnings for all employees (total earnings, seasonally\nadjusted) for the reference period in that quarter; or\n\nChapter 5  Enforcement and remedies",
      "skos:definition": "(1) Average weekly earnings, for a quarter, means the amount:\n\n(a) published by the Australian Statistician as the average\nweekly earnings for all employees (total earnings, seasonally\nadjusted) for the reference period in that quarter; or\n\nChapter 5  Enforcement and remedies",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87v-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87v-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87v-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "48a0bcad6c678fc173787be024bda8d7482f8ef191cdcd908725b1e59cd4e7b9",
      "skos:note": "Defines average weekly earnings for a quarter."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87v",
      "@type": "cof:Section",
      "cof:title": "87V Average weekly earnings",
      "values:kind": "section",
      "cof:pageNumber": 389,
      "values:originalText": "(1) Average weekly earnings, for a quarter, means the amount:\n\n(a) published by the Australian Statistician as the average\nweekly earnings for all employees (total earnings, seasonally\nadjusted) for the reference period in that quarter; or\n\nChapter 5  Enforcement and remedies"
    },
    {
