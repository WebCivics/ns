    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-92c",
      "@type": "cml:Concept",
      "skos:prefLabel": "92C Procedure for applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-92c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.426",
      "values:originalText": "An application for an authorisation under this Division must:\n\n(a) be in a form approved by the Commission in writing and\ncontain the information required by the form; and\n\n(b) be accompanied by any other information or documents\nprescribed by the regulations; and\n\n(c) specify that it is an application made under this Division.\n\nOther provisions  Chapter 6\nAuthorisations and notifications  Part VII\nAuthorisations in exceptional circumstances and emergencies  Division 1A\n\nSection 92D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "An application for an authorisation under this Division must:\n\n(a) be in a form approved by the Commission in writing and\ncontain the information required by the form; and\n\n(b) be accompanied by any other information or documents\nprescribed by the regulations; and\n\n(c) specify that it is an application made under this Division.\n\nOther provisions  Chapter 6\nAuthorisations and notifications  Part VII\nAuthorisations in exceptional circumstances and emergencies  Division 1A\n\nSection 92D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-92c-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-92c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a231f26bae17caa82135c99639083b7d7580cf1164f2edd85bee361187e30786",
      "skos:note": "Application must be in approved form and contain required information.",
      "dc:description": "Form, prescribed documents, and application statement"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-92c",
      "@type": "cof:Section",
      "cof:title": "92C Procedure for applications",
      "values:kind": "section",
      "cof:pageNumber": 426,
      "values:originalText": "An application for an authorisation under this Division must:\n\n(a) be in a form approved by the Commission in writing and\ncontain the information required by the form; and\n\n(b) be accompanied by any other information or documents\nprescribed by the regulations; and\n\n(c) specify that it is an application made under this Division.\n\nOther provisions  Chapter 6\nAuthorisations and notifications  Part VII\nAuthorisations in exceptional circumstances and emergencies  Division 1A\n\nSection 92D\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
