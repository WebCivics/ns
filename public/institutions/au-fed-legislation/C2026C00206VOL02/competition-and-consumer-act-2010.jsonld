    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ea",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EA Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ea"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.111",
      "values:originalText": "This Division sets out privacy safeguards that protect the privacy\nor confidentiality of CDR consumers’ CDR data, whether the CDR\nconsumers are individuals or bodies corporate.\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders, designated gateways and action service\nproviders, in relation to their handling or future handling of the\nCDR data.\nThe circumstances in which these safeguards can apply to an\naccredited person include where the person is an accredited action\ninitiator for a type of CDR action who is or may become an\naccredited data recipient of CDR data.\nA person’s failure to comply with any of these safeguards may lead\nto consequences, including liability to a civil penalty (see\nSubdivision G) or the suspension or revocation of the person’s\naccreditation (see subsection 56BH(3)).",
      "skos:definition": "This Division sets out privacy safeguards that protect the privacy\nor confidentiality of CDR consumers’ CDR data, whether the CDR\nconsumers are individuals or bodies corporate.\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders, designated gateways and action service\nproviders, in relation to their handling or future handling of the\nCDR data.\nThe circumstances in which these safeguards can apply to an\naccredited person include where the person is an accredited action\ninitiator for a type of CDR action who is or may become an\naccredited data recipient of CDR data.\nA person’s failure to comply with any of these safeguards may lead\nto consequences, including liability to a civil penalty (see\nSubdivision G) or the suspension or revocation of the person’s\naccreditation (see subsection 56BH(3)).",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ea-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ea-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ea-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3d3d2fccd54400240ece42631cbc7958930e8bfb4ea51824efe506be15802ed7",
      "skos:note": "Failure to comply with privacy safeguards may lead to consequences."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ea",
      "@type": "cof:Section",
      "cof:title": "56EA Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "This Division sets out privacy safeguards that protect the privacy\nor confidentiality of CDR consumers’ CDR data, whether the CDR\nconsumers are individuals or bodies corporate.\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders, designated gateways and action service\nproviders, in relation to their handling or future handling of the\nCDR data.\nThe circumstances in which these safeguards can apply to an\naccredited person include where the person is an accredited action\ninitiator for a type of CDR action who is or may become an\naccredited data recipient of CDR data.\nA person’s failure to comply with any of these safeguards may lead\nto consequences, including liability to a civil penalty (see\nSubdivision G) or the suspension or revocation of the person’s\naccreditation (see subsection 56BH(3))."
    },
