    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87c-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "87C(4) Enforcement of undertakings—Secretary of the Department",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87c-ss-4"
