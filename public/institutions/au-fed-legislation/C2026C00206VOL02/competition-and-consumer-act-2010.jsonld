    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "57FB(4) Scheme adviser—functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57fb-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.190",
      "values:originalText": "(4) Section 34C of the Acts Interpretation Act 1901 does not apply in\nrelation to a report mentioned in this section.\nNote:\nSection 34C of the Acts Interpretation Act 1901 would otherwise\nrequire any periodic reports to be given to the Minister and tabled in\nParliament.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(4) Section 34C of the Acts Interpretation Act 1901 does not apply in\nrelation to a report mentioned in this section.\nNote:\nSection 34C of the Acts Interpretation Act 1901 would otherwise\nrequire any periodic reports to be given to the Minister and tabled in\nParliament.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-57fb"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6e636c5a4a685a5339dd6308685a50eb41d16614f8337aa6f0b6c49180698ee0",
      "skos:note": "Exempts reports from Section 34C of the Acts Interpretation Act 1901."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57fb-ss-4",
      "@type": "cof:Section",
      "cof:title": "57FB(4) Scheme adviser—functions",
      "values:kind": "subsection",
      "cof:pageNumber": 190,
      "values:originalText": "(4) Section 34C of the Acts Interpretation Act 1901 does not apply in\nrelation to a report mentioned in this section.\nNote:\nSection 34C of the Acts Interpretation Act 1901 would otherwise\nrequire any periodic reports to be given to the Minister and tabled in\nParliament.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-57fb-ss-4"
