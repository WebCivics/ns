      },
      "cml:premiseText": "(3) Subsection (1) includes the provision or purported provision of a regulated service:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ah-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "58AH(4) Meaning of SPF consumer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ah-ss-4"
