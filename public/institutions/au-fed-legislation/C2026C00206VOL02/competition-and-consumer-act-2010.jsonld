    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87ca",
      "@type": "cml:Concept",
      "skos:prefLabel": "87CA Intervention by Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87ca"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.371",
      "values:originalText": "(1) The Commission may, with the leave of the Court and subject to\nany conditions imposed by the Court, intervene in any proceeding\ninstituted under this Act.\n\n(2) If the Commission intervenes in a proceeding, the Commission is\ntaken to be a party to the proceeding and has all the rights, duties\nand liabilities of such a party.\n\nChapter 5  Enforcement and remedies",
      "skos:definition": "(1) The Commission may, with the leave of the Court and subject to\nany conditions imposed by the Court, intervene in any proceeding\ninstituted under this Act.\n\n(2) If the Commission intervenes in a proceeding, the Commission is\ntaken to be a party to the proceeding and has all the rights, duties\nand liabilities of such a party.\n\nChapter 5  Enforcement and remedies",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87ca-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87ca-ss-2"
        }
      ],
      "cml:integrityHash": "e1151289734848bbcb75815b22a37d5ab2e5957c76b8fcfebe518a7b8a699aa3"
    },
