    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ab-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "Multiple obligations apply to data providers and Australian repairers/scheme RTOs.",
      "cml:executionSurface": "modalities::linear",
