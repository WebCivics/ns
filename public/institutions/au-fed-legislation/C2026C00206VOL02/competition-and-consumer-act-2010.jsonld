    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fq",
      "@type": "cml:Concept",
      "skos:prefLabel": "58FQ Amount of penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.261",
      "values:originalText": "The penalty to be specified in an SPF infringement notice that is to\nbe issued to a person must be equal to the following amount:\n\n(a) if the person is a body corporate—60 penalty units;\n\n(b) otherwise—12 penalty units.",
      "skos:definition": "The penalty to be specified in an SPF infringement notice that is to\nbe issued to a person must be equal to the following amount:\n\n(a) if the person is a body corporate—60 penalty units;\n\n(b) otherwise—12 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58fq-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58fq-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9cfc8b5a19d88674eea3ca73793a1cebaa913de46da60d2deb4b9fd7d5aa15f4",
      "skos:note": "Penalty amount for SPF infringement notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fq",
      "@type": "cof:Section",
      "cof:title": "58FQ Amount of penalty",
      "values:kind": "section",
      "cof:pageNumber": 261,
      "values:originalText": "The penalty to be specified in an SPF infringement notice that is to\nbe issued to a person must be equal to the following amount:\n\n(a) if the person is a body corporate—60 penalty units;\n\n(b) otherwise—12 penalty units."
    },
