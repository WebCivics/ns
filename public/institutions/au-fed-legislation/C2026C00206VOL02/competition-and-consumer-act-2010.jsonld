      },
      "cml:premiseText": "Given a collective bargaining notice under subsection 93AB(1)",
      "cml:conclusionText": "No further collective bargaining notice may be given"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-93af-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Restrict",
      "cml:logicSummary": "Restriction on the giving of collective bargaining notices",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
