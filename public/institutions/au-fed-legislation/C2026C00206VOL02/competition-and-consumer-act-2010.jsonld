      },
      "cml:premiseText": "A person carries on or actively seeks to carry on a business...",
      "cml:conclusionText": "The person is an Australian repairer if they carry on or actively seek to carry on such a business"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57bb-logic-diffusion-4",
