    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56gh",
      "@type": "cml:Concept",
      "skos:prefLabel": "56GH Review of the operation of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56gh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.165",
      "values:originalText": "(1) The Minister must cause an independent review to be conducted of\nthe operation of this Part.\n\n(2) The persons who conduct the review must complete it, and give the\nMinister a written report of the review, before 1 July 2022.\n\n(3) The Minister must cause copies of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) The Minister must cause an independent review to be conducted of\nthe operation of this Part.\n\n(2) The persons who conduct the review must complete it, and give the\nMinister a written report of the review, before 1 July 2022.\n\n(3) The Minister must cause copies of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
