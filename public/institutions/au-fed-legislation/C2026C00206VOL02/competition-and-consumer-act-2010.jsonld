    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "56AA Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.37",
      "values:originalText": "The object of this Part is:\n\n(a) to enable consumers in certain sectors of the Australian\neconomy to require information relating to themselves in\nthose sectors to be disclosed safely, efficiently and\nconveniently:\n\n(i) to themselves for use as they see fit; or\n\n(ii) to accredited persons for use subject to privacy\nsafeguards; and\n\n(b) to enable any person to efficiently and conveniently access\ninformation in those sectors that:\n\n(i) is about goods (such as products) or services; and\n\n(ii) does not relate to any identifiable, or reasonably\nidentifiable, consumers; and\n\n(ba) to enable consumers in those sectors to request accredited\npersons to give instructions:\n\n(i) safely, efficiently and conveniently on behalf of the\nconsumers; and\n\n(ii) to service providers in those sectors;\n\nfor the performance of actions; and\n\n(c) as a result of paragraphs (a) to (ba), to create more choice and\ncompetition, or to otherwise promote the public interest.",
      "skos:definition": "The object of this Part is:\n\n(a) to enable consumers in certain sectors of the Australian\neconomy to require information relating to themselves in\nthose sectors to be disclosed safely, efficiently and\nconveniently:\n\n(i) to themselves for use as they see fit; or\n\n(ii) to accredited persons for use subject to privacy\nsafeguards; and\n\n(b) to enable any person to efficiently and conveniently access\ninformation in those sectors that:\n\n(i) is about goods (such as products) or services; and\n\n(ii) does not relate to any identifiable, or reasonably\nidentifiable, consumers; and\n\n(ba) to enable consumers in those sectors to request accredited\npersons to give instructions:\n\n(i) safely, efficiently and conveniently on behalf of the\nconsumers; and\n\n(ii) to service providers in those sectors;\n\nfor the performance of actions; and\n\n(c) as a result of paragraphs (a) to (ba), to create more choice and\ncompetition, or to otherwise promote the public interest.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56aa-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e4edc203562814f31d4e7ead77222c84a3b63200431329ea40c3ab774fa96d01",
      "skos:note": "To enable consumers in certain sectors of the Australian economy to require information relating to themselves."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56aa",
      "@type": "cof:Section",
      "cof:title": "56AA Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "The object of this Part is:\n\n(a) to enable consumers in certain sectors of the Australian\neconomy to require information relating to themselves in\nthose sectors to be disclosed safely, efficiently and\nconveniently:\n\n(i) to themselves for use as they see fit; or\n\n(ii) to accredited persons for use subject to privacy\nsafeguards; and\n\n(b) to enable any person to efficiently and conveniently access\ninformation in those sectors that:\n\n(i) is about goods (such as products) or services; and\n\n(ii) does not relate to any identifiable, or reasonably\nidentifiable, consumers; and\n\n(ba) to enable consumers in those sectors to request accredited\npersons to give instructions:\n\n(i) safely, efficiently and conveniently on behalf of the\nconsumers; and\n\n(ii) to service providers in those sectors;\n\nfor the performance of actions; and\n\n(c) as a result of paragraphs (a) to (ba), to create more choice and\ncompetition, or to otherwise promote the public interest."
    },
