      "cml:integrityHash": "5a4c4762f4dac4a2507a61891aa58892e118c92681e9c9c5ec5be11b317e320f",
      "skos:note": "Failure to provide information or documents within 30 days results in withdrawal of application.",
      "dc:description": "information or documents"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100d-ss-4",
      "@type": "cof:Section",
      "cof:title": "100D(4) Further information and documents in relation to applications",
      "values:kind": "subsection",
      "cof:pageNumber": 522,
      "values:originalText": "(4) If the applicant does not give the information or documents to the\nTribunal by the end of those 30 days, the applicant is taken to\nwithdraw the application under subsection 100E(1) at the end of\nthose 30 days."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100d-ss-4-norm",
      "@type": "values:Prohibition",
