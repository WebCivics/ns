        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "a70374d7f0e7d78c1c26f1d8fcc6723fa548c6e5adc8aa3d212ed4b760519e6d",
      "skos:note": "Court must not award personal injury damages for non-economic loss in most extreme cases. Court must not award personal injury damages for non-economic loss exceeding a certain percentage."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87p-ss-1",
      "@type": "cof:Section",
      "cof:title": "87P(1) Most extreme cases",
      "values:kind": "subsection",
      "cof:pageNumber": 386,
      "values:originalText": "(1) If the non-economic loss the plaintiff suffers is at least 33%, but\nless than 100%, of a most extreme case, the court must not award\nas personal injury damages for non-economic loss an amount that\nexceeds the applicable percentage of the maximum amount of\ndamages for non-economic loss."
    },
