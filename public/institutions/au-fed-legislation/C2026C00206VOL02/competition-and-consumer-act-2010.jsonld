      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The changes set out in this section apply to a partnership as if it were a person.",
      "cml:conclusionText": "All partners must comply with the SPF provisions if one partner is classified as an individual for compliance purposes."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ga-ss-1-logic-cogai-5",
