    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fr-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "56FR(2) Termination of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56fr-ss-2"
