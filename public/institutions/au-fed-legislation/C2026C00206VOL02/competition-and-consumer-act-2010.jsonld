        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a data holder of CDR data to which a binding data standard applies;",
      "cml:conclusionText": "(d) agrees to engage in conduct that the person is required by the standard to engage in."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "Data holder and accredited persons are part of a class included in the data standard.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a data holder of CDR data to which a binding data standard applies;",
      "cml:conclusionText": "and (b) each accredited person;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The contract is in force between the data holder and accredited persons during the overlap of their engagement with the standard.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) agrees to observe the standard to the extent that the standard applies to the person;",
      "cml:conclusionText": "(d) agrees to engage in conduct that the person is required by the standard to engage in."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The contract is in force until the data holder and accredited persons cease to observe the standard and engage in conduct required by it.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) agrees to observe the standard to the extent that the standard applies to the person;",
      "cml:conclusionText": "(d) agrees to engage in conduct that the person is required by the standard to engage in."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "The data holder and accredited persons diffuse their obligations to observe the standard and engage in conduct required by it.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a data holder of CDR data to which a binding data standard applies;",
      "cml:conclusionText": "(b) each accredited person;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fd-ss-1-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Enforces",
      "cml:logicSummary": "The state enforces the obligations of the data holder and accredited persons to observe the standard and engage in conduct required by it.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
