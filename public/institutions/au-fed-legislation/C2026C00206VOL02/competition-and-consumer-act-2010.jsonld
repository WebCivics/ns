    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56cl-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CL(3) Functions, powers and annual report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56cl-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
