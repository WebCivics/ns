      "@id": "concept:competition-and-consumer-act-2010-sec-58bq",
      "@type": "cml:Concept",
      "skos:prefLabel": "58BQ Simplified outline of this Subdivision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58bq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.214",
      "values:originalText": "Each regulated entity must give the SPF general regulator reports\nof any actionable intelligence the entity has about activities relating\nto, connected with, or using the entity’s regulated services.\nA regulated entity must give an SPF regulator a report about a\nscam if the SPF regulator requests.\nThe SPF general regulator may disclose information about scams\nto certain other entities.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nOverarching principles of the Scams Prevention Framework  Division 2\n\nSection 58BR\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Each regulated entity must give the SPF general regulator reports\nof any actionable intelligence the entity has about activities relating\nto, connected with, or using the entity’s regulated services.\nA regulated entity must give an SPF regulator a report about a\nscam if the SPF regulator requests.\nThe SPF general regulator may disclose information about scams\nto certain other entities.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nOverarching principles of the Scams Prevention Framework  Division 2\n\nSection 58BR\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58bq-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58bq-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2face7912a93bdaf0d63d752fe570c6f9c8dc8194d0f051fd400449f67f9ce2f",
      "skos:note": "Must provide reports on actionable intelligence and scams to SPF regulators.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58bq",
      "@type": "cof:Section",
      "cof:title": "58BQ Simplified outline of this Subdivision",
      "values:kind": "section",
      "cof:pageNumber": 214,
      "values:originalText": "Each regulated entity must give the SPF general regulator reports\nof any actionable intelligence the entity has about activities relating\nto, connected with, or using the entity’s regulated services.\nA regulated entity must give an SPF regulator a report about a\nscam if the SPF regulator requests.\nThe SPF general regulator may disclose information about scams\nto certain other entities.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nOverarching principles of the Scams Prevention Framework  Division 2\n\nSection 58BR\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bq-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
