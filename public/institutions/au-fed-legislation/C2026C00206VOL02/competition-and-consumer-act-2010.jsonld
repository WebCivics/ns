      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Determination of applications for authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.403",
      "values:originalText": "(1) The Commission shall, in respect of an application for an\nauthorisation:\n\n(a) make a determination in writing granting such authorisation\nas it considers appropriate; or\n\n(b) make a determination in writing dismissing the application.\n\n(4) The Commission shall state in writing its reasons for a\ndetermination made by it.\n\nChapter 6  Other provisions",
      "skos:definition": "(1) The Commission shall, in respect of an application for an\nauthorisation:\n\n(a) make a determination in writing granting such authorisation\nas it considers appropriate; or\n\n(b) make a determination in writing dismissing the application.\n\n(4) The Commission shall state in writing its reasons for a\ndetermination made by it.\n\nChapter 6  Other provisions",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-90-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-90-ss-4"
        }
      ],
      "cml:integrityHash": "57dc93fc2aad34793d76397b416fde31613eb24b1472638022ec14e91bd1b352"
    },
    {
