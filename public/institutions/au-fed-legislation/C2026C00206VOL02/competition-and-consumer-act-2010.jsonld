    {
      "@id": "concept:competition-and-consumer-act-2010-sec-77",
      "@type": "cml:Concept",
      "skos:prefLabel": "77 Civil action for recovery of pecuniary penalties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-77"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.329",
      "values:originalText": "(1) The Commission may institute a proceeding in the Court for the\nrecovery on behalf of the Commonwealth of a pecuniary penalty\nreferred to in section 76.\n\n(2) A proceeding under subsection (1) may be commenced within 6\nyears after the contravention.",
      "skos:definition": "(1) The Commission may institute a proceeding in the Court for the\nrecovery on behalf of the Commonwealth of a pecuniary penalty\nreferred to in section 76.\n\n(2) A proceeding under subsection (1) may be commenced within 6\nyears after the contravention.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-77-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-77-ss-2"
        }
      ],
      "cml:integrityHash": "bc0aaed60e735f69bfdbba02f0e3c4aa8cd9965d6c9480ecdfc82c0f0f3f93ba"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-77",
      "@type": "cof:Section",
      "cof:title": "77 Civil action for recovery of pecuniary penalties",
      "values:kind": "section",
      "cof:pageNumber": 329,
      "values:originalText": "(1) The Commission may institute a proceeding in the Court for the\nrecovery on behalf of the Commonwealth of a pecuniary penalty\nreferred to in section 76.\n\n(2) A proceeding under subsection (1) may be commenced within 6\nyears after the contravention."
    },
