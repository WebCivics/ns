      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of further collective bargaining notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
