    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-55g",
      "@type": "cml:Concept",
      "skos:prefLabel": "55G Issuing an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.32",
      "values:originalText": "(1) If the Commission has reasonable grounds to believe that a person\nhas contravened section 55B, the Commission may issue an\ninfringement notice to the person.\n\n(2) The Commission must not issue more than one infringement notice\nto the person for the same alleged contravention of section 55B.\n\n(3) The infringement notice does not have any effect if the notice:\n\n(a) is issued more than 12 months after the day that the\ncontravention of section 55B is alleged to have occurred; or\n\n(b) relates to more than one alleged contravention of section 55B\nby the person.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nPayment surcharges  Part IVC\nInfringement notices  Division 4\n\nSection 55H\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) If the Commission has reasonable grounds to believe that a person\nhas contravened section 55B, the Commission may issue an\ninfringement notice to the person.\n\n(2) The Commission must not issue more than one infringement notice\nto the person for the same alleged contravention of section 55B.\n\n(3) The infringement notice does not have any effect if the notice:\n\n(a) is issued more than 12 months after the day that the\ncontravention of section 55B is alleged to have occurred; or\n\n(b) relates to more than one alleged contravention of section 55B\nby the person.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nPayment surcharges  Part IVC\nInfringement notices  Division 4\n\nSection 55H\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55g-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55g-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55g-ss-3"
        }
      ],
      "cml:integrityHash": "e2cd8869ee594545344372bdb931960ed89128226d640071dcde42322a236925"
    },
