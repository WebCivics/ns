    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95w-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "95W(3) Allowances to witnesses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95w-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
