      "cml:integrityHash": "79cec9f73fbb11be91d96a9db49eda4bbd5b39c53afc3bfa7abb696e4ddef356",
      "skos:note": "Cannot disclose protected information or produce protected documents to a court unless necessary for carrying out the provisions of this Act. Protection and immunity for inquiry persons"
    },
