        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Recurring trace",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The data holder has been declared as a class of data holders for at least one type of CDR action.",
      "cml:conclusionText": "The person is an action service provider for that type of CDR action."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must meet the conditions to be an action service provider.",
      "cml:conclusionText": "The person is an action service provider for that type of CDR action."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
