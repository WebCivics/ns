      "cml:integrityHash": "dc4426d23f49318f45921ac2dfaf5e89962cfb1f09edd5cf84e495fda8f978a5",
      "skos:note": "Division 2A of Part IVB applies to alleged contraventions of civil penalty provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57gb-ss-1",
      "@type": "cof:Section",
      "cof:title": "57GB(1) Infringement notices",
      "values:kind": "subsection",
      "cof:pageNumber": 192,
      "values:originalText": "(1) Division 2A of Part IVB applies in relation to an alleged\ncontravention of a civil penalty provision mentioned in an item in\nthe table in subsection (2) in the same way in which it applies in\nrelation to an alleged contravention of a civil penalty provision of\nan industry code (within the meaning of that Part)."
    },
