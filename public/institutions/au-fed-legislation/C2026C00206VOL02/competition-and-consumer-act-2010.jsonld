    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56bl",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BL Obligation to comply with consumer data rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56bl"
      },
      "cml:curationStatus": {
