        }
      ],
      "cml:integrityHash": "ae4601faefe6ca4b0a5200ef92dbac561f7f06a16ef1b902d233a31c207675cd",
      "skos:note": "Defines infringement notice compliance period"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55m-ss-1",
      "@type": "cof:Section",
      "cof:title": "55M(1) Infringement notice compliance period for infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(1) Subject to this section, the infringement notice compliance period\nfor an infringement notice is the period of 28 days beginning on the\nday after the day that the infringement notice is issued by the\nCommission."
    },
