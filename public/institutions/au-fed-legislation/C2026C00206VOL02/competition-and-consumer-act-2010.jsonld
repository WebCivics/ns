    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57eb",
      "@type": "cml:Concept",
      "skos:prefLabel": "57EB Resolving disputes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57eb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.186",
      "values:originalText": "A party to the dispute (the initiating party) may initiate action to\nresolve the dispute against another party (the responding party) in\naccordance with the procedure set out in this Division.",
      "skos:definition": "A party to the dispute (the initiating party) may initiate action to\nresolve the dispute against another party (the responding party) in\naccordance with the procedure set out in this Division.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57eb-norm"
        },
