      "cml:premiseText": "Published by the Australian Statistician",
      "cml:conclusionText": "as the average weekly earnings for all employees (total earnings, seasonally adjusted) for the reference period in that quarter"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87w",
      "@type": "cml:Concept",
      "skos:prefLabel": "87W Personal injury damages for gratuitous attendant care services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87w"
      },
      "cml:curationStatus": {
