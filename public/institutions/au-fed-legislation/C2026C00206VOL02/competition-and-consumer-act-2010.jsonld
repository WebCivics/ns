    {
      "@id": "concept:competition-and-consumer-act-2010-sec-92e",
      "@type": "cml:Concept",
      "skos:prefLabel": "92E Period for which authorisations remain in force",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-92e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.428",
      "values:originalText": "An authorisation under this Division is in force for the period:\n\n(a) starting on the day specified in the determination (which may\nbe before the commencement of this section, but must not be\nbefore 1 April 2026); and\n\n(b) ending at the earliest of the following:\n\n(i) the start of the day specified in the determination;\n\n(ii) if the determination is revoked—the end of the day the\nrevocation takes effect;\n\n(iii) the end of the last day on which a declaration mentioned\nin subsection 92D(2) to which the determination relates\nis in force.",
      "skos:definition": "An authorisation under this Division is in force for the period:\n\n(a) starting on the day specified in the determination (which may\nbe before the commencement of this section, but must not be\nbefore 1 April 2026); and\n\n(b) ending at the earliest of the following:\n\n(i) the start of the day specified in the determination;\n\n(ii) if the determination is revoked—the end of the day the\nrevocation takes effect;\n\n(iii) the end of the last day on which a declaration mentioned\nin subsection 92D(2) to which the determination relates\nis in force.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-92e-norm"
        }
      ],
      "cml:integrityHash": "7715babbe6a5cb3a3eccae8e47bc8892c83300c70cebf7850de4b7ddc53b8e5f",
      "skos:note": "Authorisation duration"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-92e",
      "@type": "cof:Section",
      "cof:title": "92E Period for which authorisations remain in force",
      "values:kind": "section",
      "cof:pageNumber": 428,
      "values:originalText": "An authorisation under this Division is in force for the period:\n\n(a) starting on the day specified in the determination (which may\nbe before the commencement of this section, but must not be\nbefore 1 April 2026); and\n\n(b) ending at the earliest of the following:\n\n(i) the start of the day specified in the determination;\n\n(ii) if the determination is revoked—the end of the day the\nrevocation takes effect;\n\n(iii) the end of the last day on which a declaration mentioned\nin subsection 92D(2) to which the determination relates\nis in force."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-92e-norm",
      "@type": "values:Undertaking",
