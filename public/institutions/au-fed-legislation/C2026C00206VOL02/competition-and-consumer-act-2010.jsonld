      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "\\u2262",
      "cml:logicSummary": "CDR data must be retained by or under an Australian law or court/tribunal order",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
