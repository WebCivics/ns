      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "81A(7) Divestiture where merger done under authorisation granted on",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-81a-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.346",
      "values:originalText": "(7) If an application is made to the Court for an order under\nsubsection (2) or (4) against a person, the Court may, instead of\nmaking an order of the kind mentioned in that subsection, accept,\nupon such conditions (if any) as the Court thinks fit, an\nundertaking by the person to dispose of other shares or assets\nowned by the person.\n\nChapter 5  Enforcement and remedies",
      "skos:definition": "(7) If an application is made to the Court for an order under\nsubsection (2) or (4) against a person, the Court may, instead of\nmaking an order of the kind mentioned in that subsection, accept,\nupon such conditions (if any) as the Court thinks fit, an\nundertaking by the person to dispose of other shares or assets\nowned by the person.\n\nChapter 5  Enforcement and remedies",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-81a"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-7-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cf155dd7545a9fce98e1ca8b9cc422dfef77b69559a90b50ae4493ac84aaa675",
      "skos:note": "Court may accept undertaking to dispose of shares or assets"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-81a-ss-7",
      "@type": "cof:Section",
      "cof:title": "81A(7) Divestiture where merger done under authorisation granted on",
      "values:kind": "subsection",
      "cof:pageNumber": 346,
      "values:originalText": "(7) If an application is made to the Court for an order under\nsubsection (2) or (4) against a person, the Court may, instead of\nmaking an order of the kind mentioned in that subsection, accept,\nupon such conditions (if any) as the Court thinks fit, an\nundertaking by the person to dispose of other shares or assets\nowned by the person.\n\nChapter 5  Enforcement and remedies"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-7-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-7"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-81a-ss-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Court discretion",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
