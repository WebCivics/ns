      "skos:note": "Summoning a person to appear at an inquiry and produce documents."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95s-ss-3",
      "@type": "cof:Section",
      "cof:title": "95S(3) Taking of evidence on oath or affirmation",
      "values:kind": "subsection",
