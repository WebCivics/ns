      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87u",
      "@type": "cml:Concept",
      "skos:prefLabel": "87U Personal injury damages for loss of earning capacity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.389",
      "values:originalText": "In determining, in a proceeding to which this Part applies, personal\ninjury damages for:\n\n(a) past economic loss due to loss of earnings or the deprivation\nor impairment of earning capacity; or\n\n(b) future economic loss due to the deprivation or impairment of\nearning capacity; or\n\n(c) the loss of expectation of financial support;\na court must disregard the amount by which the plaintiff’s gross\nweekly earnings during any quarter would (but for the personal\ninjury or death in question) have exceeded:\n\n(d) if, at the time the award was made, the amount of average\nweekly earnings for the quarter was ascertainable—an\namount that is twice the amount of average weekly earnings\nfor the quarter; or\n\n(e) if:\n\n(i) at the time the award was made, the amount of average\nweekly earnings for the quarter was not ascertainable; or\n\n(ii) the award was made during, or before the start of, the\nquarter;\n\nan amount that is twice the amount of average weekly\nearnings for the quarter that, at the time the award was made,\nwas the most recent quarter for which the amount of average\nweekly earnings was ascertainable.",
      "skos:definition": "In determining, in a proceeding to which this Part applies, personal\ninjury damages for:\n\n(a) past economic loss due to loss of earnings or the deprivation\nor impairment of earning capacity; or\n\n(b) future economic loss due to the deprivation or impairment of\nearning capacity; or\n\n(c) the loss of expectation of financial support;\na court must disregard the amount by which the plaintiff’s gross\nweekly earnings during any quarter would (but for the personal\ninjury or death in question) have exceeded:\n\n(d) if, at the time the award was made, the amount of average\nweekly earnings for the quarter was ascertainable—an\namount that is twice the amount of average weekly earnings\nfor the quarter; or\n\n(e) if:\n\n(i) at the time the award was made, the amount of average\nweekly earnings for the quarter was not ascertainable; or\n\n(ii) the award was made during, or before the start of, the\nquarter;\n\nan amount that is twice the amount of average weekly\nearnings for the quarter that, at the time the award was made,\nwas the most recent quarter for which the amount of average\nweekly earnings was ascertainable.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87u-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87u-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4671999963e653eb6e021b390277d8bacfc5ed0cc13a05436f6e5cc391c756f7",
      "skos:note": "Court must disregard amount of plaintiff's gross weekly earnings exceeding twice the average weekly earnings for the quarter."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87u",
      "@type": "cof:Section",
      "cof:title": "87U Personal injury damages for loss of earning capacity",
      "values:kind": "section",
      "cof:pageNumber": 389,
      "values:originalText": "In determining, in a proceeding to which this Part applies, personal\ninjury damages for:\n\n(a) past economic loss due to loss of earnings or the deprivation\nor impairment of earning capacity; or\n\n(b) future economic loss due to the deprivation or impairment of\nearning capacity; or\n\n(c) the loss of expectation of financial support;\na court must disregard the amount by which the plaintiff’s gross\nweekly earnings during any quarter would (but for the personal\ninjury or death in question) have exceeded:\n\n(d) if, at the time the award was made, the amount of average\nweekly earnings for the quarter was ascertainable—an\namount that is twice the amount of average weekly earnings\nfor the quarter; or\n\n(e) if:\n\n(i) at the time the award was made, the amount of average\nweekly earnings for the quarter was not ascertainable; or\n\n(ii) the award was made during, or before the start of, the\nquarter;\n\nan amount that is twice the amount of average weekly\nearnings for the quarter that, at the time the award was made,\nwas the most recent quarter for which the amount of average\nweekly earnings was ascertainable."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87u-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
