        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) If...",
      "cml:conclusionText": "then the collective bargaining notice is taken to be withdrawn."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-93af",
      "@type": "cml:Concept",
      "skos:prefLabel": "93AF Only 1 collective bargaining notice under subsection 93AB(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-93af"
      },
      "cml:curationStatus": {
