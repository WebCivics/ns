      "@id": "concept:competition-and-consumer-act-2010-sec-58gb",
      "@type": "cml:Concept",
      "skos:prefLabel": "58GB Treatment of unincorporated associations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58gb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.283",
      "values:originalText": "(1) The SPF provisions apply to an unincorporated association as if it\nwere a person, but with the changes set out in this section.\n\n(2) An obligation that would otherwise be imposed on the association\nby an SPF provision is imposed on each member of the\nassociation’s committee of management instead, but may be\ndischarged by any of the members.\n\n(3) If an SPF provision would otherwise permit something to be done\nby the unincorporated association, the thing may be done by one or\nmore of the members of the association’s committee of\nmanagement on behalf of the association.",
      "skos:definition": "(1) The SPF provisions apply to an unincorporated association as if it\nwere a person, but with the changes set out in this section.\n\n(2) An obligation that would otherwise be imposed on the association\nby an SPF provision is imposed on each member of the\nassociation’s committee of management instead, but may be\ndischarged by any of the members.\n\n(3) If an SPF provision would otherwise permit something to be done\nby the unincorporated association, the thing may be done by one or\nmore of the members of the association’s committee of\nmanagement on behalf of the association.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58gb-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58gb-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58gb-ss-3"
        }
      ],
      "cml:integrityHash": "c054288348b064893177794cce3fbb2bbf68ffc14ee0e0dd2612ae22352dec80"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58gb",
      "@type": "cof:Section",
      "cof:title": "58GB Treatment of unincorporated associations",
      "values:kind": "section",
      "cof:pageNumber": 283,
      "values:originalText": "(1) The SPF provisions apply to an unincorporated association as if it\nwere a person, but with the changes set out in this section.\n\n(2) An obligation that would otherwise be imposed on the association\nby an SPF provision is imposed on each member of the\nassociation’s committee of management instead, but may be\ndischarged by any of the members.\n\n(3) If an SPF provision would otherwise permit something to be done\nby the unincorporated association, the thing may be done by one or\nmore of the members of the association’s committee of\nmanagement on behalf of the association."
    },
