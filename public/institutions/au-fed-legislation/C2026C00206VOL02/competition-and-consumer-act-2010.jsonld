        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87k-ss-2"
        }
      ],
      "cml:integrityHash": "090eb6e866d475159bef1da263ba478719df5d08d993c1460d661fba392a2949"
    },
    {
