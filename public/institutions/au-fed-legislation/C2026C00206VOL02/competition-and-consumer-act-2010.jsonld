    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "87N(4) Index numbers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87n-ss-4"
      },
      "cml:curationStatus": {
