      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ab-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "SHALL",
      "cml:logicSummary": "Data providers must protect individuals accessing scheme information from civil claims.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
