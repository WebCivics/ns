        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The adverse publicity order applies until the person is no longer guilty of the offence or has paid the pecuniary penalty",
      "cml:conclusionText": "The adverse publicity order applies during the period from when it is made to when the person is no longer guilty or has paid the penalty"
    },
