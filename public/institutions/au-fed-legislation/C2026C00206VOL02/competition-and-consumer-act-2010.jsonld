    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95zm",
      "@type": "cml:Concept",
      "skos:prefLabel": "95ZM Retention of documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95zm"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.505",
      "values:originalText": "(1) The Commission, or a body other than the Commission, may retain\na document given or produced to it as mentioned in section 95ZL.\nIt may retain the document for such reasonable period as it thinks\nfit.\n\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the Commission or other body, as the case may be, to be a true\ncopy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the Commission or other body,\nas the case may be, must, at such times and places as it thinks\nappropriate, permit the person otherwise entitled to possession of\nthe document, or a person authorised by that person, to inspect and\nmake copies of, or take extracts from, the document.",
      "skos:definition": "(1) The Commission, or a body other than the Commission, may retain\na document given or produced to it as mentioned in section 95ZL.\nIt may retain the document for such reasonable period as it thinks\nfit.\n\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the Commission or other body, as the case may be, to be a true\ncopy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the Commission or other body,\nas the case may be, must, at such times and places as it thinks\nappropriate, permit the person otherwise entitled to possession of\nthe document, or a person authorised by that person, to inspect and\nmake copies of, or take extracts from, the document.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zm-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zm-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zm-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zm-ss-4"
        }
      ],
      "cml:integrityHash": "dc50b8c64be2e4c537c776584a80c10ea84fe226aed7893b30cce18efe753b22"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95zm",
      "@type": "cof:Section",
      "cof:title": "95ZM Retention of documents",
      "values:kind": "section",
      "cof:pageNumber": 505,
      "values:originalText": "(1) The Commission, or a body other than the Commission, may retain\na document given or produced to it as mentioned in section 95ZL.\nIt may retain the document for such reasonable period as it thinks\nfit.\n\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the Commission or other body, as the case may be, to be a true\ncopy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the Commission or other body,\nas the case may be, must, at such times and places as it thinks\nappropriate, permit the person otherwise entitled to possession of\nthe document, or a person authorised by that person, to inspect and\nmake copies of, or take extracts from, the document."
    },
