        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A CDR action is an action of a type declared under section 56ACA.",
      "cml:conclusionText": "A CDR action is an obligation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-1-logic-linearlogic-10",
