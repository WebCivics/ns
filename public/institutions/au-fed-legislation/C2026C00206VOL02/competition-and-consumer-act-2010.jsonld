    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "58AK Acts done by or in relation to agents etc. of regulated entities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ak"
      },
      "cml:curationStatus": {
