        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58ft-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "76957ca531f679bc33db7cd92afcced08894ffdfb53e7ea8ee271d62abb2b641",
      "skos:note": "Infringement notice compliance period obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ft-ss-1",
      "@type": "cof:Section",
      "cof:title": "58FT(1) Infringement notice compliance period for infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 262,
      "values:originalText": "(1) Subject to this section, the infringement notice compliance period,\nfor an SPF infringement notice issued to a person, is the period of\n28 days beginning on the day after the day that the notice is so\nissued by an inspector of an SPF regulator."
    },
