    {
      "@id": "concept:competition-and-consumer-act-2010-sec-104",
      "@type": "cml:Concept",
      "skos:prefLabel": "104 Regulations as to certain matters",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-104"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.544",
      "values:originalText": "The regulations may make provision:\n\n(a) for securing, by means of preliminary statements of facts and\ncontentions, and by the production of documents, that all\nmaterial facts and considerations are brought before the\nTribunal by all persons participating in any proceedings\nbefore the Tribunal or by the Commission; and\n\n(aa) with respect to evidence in proceedings before the Tribunal,\nincluding the appointment of persons to assist the Tribunal\nby giving evidence (whether personally or by means of a\nwritten report); and\n\n(b) with respect to the representation in any such proceedings of\npersons having a common interest in the proceedings.",
      "skos:definition": "The regulations may make provision:\n\n(a) for securing, by means of preliminary statements of facts and\ncontentions, and by the production of documents, that all\nmaterial facts and considerations are brought before the\nTribunal by all persons participating in any proceedings\nbefore the Tribunal or by the Commission; and\n\n(aa) with respect to evidence in proceedings before the Tribunal,\nincluding the appointment of persons to assist the Tribunal\nby giving evidence (whether personally or by means of a\nwritten report); and\n\n(b) with respect to the representation in any such proceedings of\npersons having a common interest in the proceedings.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-104-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-104-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-104-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "b5bc7db9d5ff4a8bc9c7e59725b72683fa8a02b600f8647aaba63f72e94ceddd",
      "skos:note": "Regulations for securing material facts and considerations in proceedings before the Tribunal or Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-104",
      "@type": "cof:Section",
      "cof:title": "104 Regulations as to certain matters",
      "values:kind": "section",
      "cof:pageNumber": 544,
      "values:originalText": "The regulations may make provision:\n\n(a) for securing, by means of preliminary statements of facts and\ncontentions, and by the production of documents, that all\nmaterial facts and considerations are brought before the\nTribunal by all persons participating in any proceedings\nbefore the Tribunal or by the Commission; and\n\n(aa) with respect to evidence in proceedings before the Tribunal,\nincluding the appointment of persons to assist the Tribunal\nby giving evidence (whether personally or by means of a\nwritten report); and\n\n(b) with respect to the representation in any such proceedings of\npersons having a common interest in the proceedings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-104-norm",
