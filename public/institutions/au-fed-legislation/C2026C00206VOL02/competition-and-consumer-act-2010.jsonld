    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95k",
      "@type": "cml:Concept",
      "skos:prefLabel": "95K Period for completing inquiry",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.477",
      "values:originalText": "Inquiry period\n\n(1) An inquiry notice must specify the period within which the inquiry\nis to be completed and a report on the inquiry is to be given to the\nMinister.\n\n(2) The inquiry body must complete the inquiry and give the report to\nthe Minister within that period.\nExtensions\n\n(3) The Minister may, before the end of the completion period, extend\nor further extend that period by notice in writing given to the\ninquiry Chair.\nExample: A notice under subsection (1) specifies that an inquiry is to be\ncompleted and a report given by 1 August.\n\nOn 30 July the Minister gives a notice under subsection (3) extending\nthe deadline to 8 August.\n\nOn 6 August the Minister gives another notice under subsection (3)\nfurther extending the deadline to 12 August.\n\n(4) If the Minister does so, the inquiry body must complete the inquiry\nand give its report within the completion period as so extended or\nfurther extended.\n\n(5) In this section:\ncompletion period means the period within which the inquiry body\nis required by this section to complete an inquiry and to give its\nreport on the inquiry.\n\nChapter 6  Other provisions",
      "skos:definition": "Inquiry period\n\n(1) An inquiry notice must specify the period within which the inquiry\nis to be completed and a report on the inquiry is to be given to the\nMinister.\n\n(2) The inquiry body must complete the inquiry and give the report to\nthe Minister within that period.\nExtensions\n\n(3) The Minister may, before the end of the completion period, extend\nor further extend that period by notice in writing given to the\ninquiry Chair.\nExample: A notice under subsection (1) specifies that an inquiry is to be\ncompleted and a report given by 1 August.\n\nOn 30 July the Minister gives a notice under subsection (3) extending\nthe deadline to 8 August.\n\nOn 6 August the Minister gives another notice under subsection (3)\nfurther extending the deadline to 12 August.\n\n(4) If the Minister does so, the inquiry body must complete the inquiry\nand give its report within the completion period as so extended or\nfurther extended.\n\n(5) In this section:\ncompletion period means the period within which the inquiry body\nis required by this section to complete an inquiry and to give its\nreport on the inquiry.\n\nChapter 6  Other provisions",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95k-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95k-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95k-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95k-ss-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95k-ss-5"
        }
      ],
      "cml:integrityHash": "2a67a294105649927e2b37e6b6873620176af233c65557f6bae73a06e3e22bd7"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95k",
      "@type": "cof:Section",
      "cof:title": "95K Period for completing inquiry",
      "values:kind": "section",
      "cof:pageNumber": 477,
      "values:originalText": "Inquiry period\n\n(1) An inquiry notice must specify the period within which the inquiry\nis to be completed and a report on the inquiry is to be given to the\nMinister.\n\n(2) The inquiry body must complete the inquiry and give the report to\nthe Minister within that period.\nExtensions\n\n(3) The Minister may, before the end of the completion period, extend\nor further extend that period by notice in writing given to the\ninquiry Chair.\nExample: A notice under subsection (1) specifies that an inquiry is to be\ncompleted and a report given by 1 August.\n\nOn 30 July the Minister gives a notice under subsection (3) extending\nthe deadline to 8 August.\n\nOn 6 August the Minister gives another notice under subsection (3)\nfurther extending the deadline to 12 August.\n\n(4) If the Minister does so, the inquiry body must complete the inquiry\nand give its report within the completion period as so extended or\nfurther extended.\n\n(5) In this section:\ncompletion period means the period within which the inquiry body\nis required by this section to complete an inquiry and to give its\nreport on the inquiry.\n\nChapter 6  Other provisions"
    },
