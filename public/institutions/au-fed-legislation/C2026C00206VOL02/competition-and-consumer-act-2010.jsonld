    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58af",
      "@type": "cml:Concept",
      "skos:prefLabel": "58AF Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58af"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.201",
      "values:originalText": "The Minister may, in writing, delegate the Minister’s power to\nmake an instrument under subsection 58AC(1) to another Minister.\nNote:\nSections 34AA to 34A of the Acts Interpretation Act 1901 contain\nprovisions relating to delegations. For example, section 34A of that\nAct means that section 58AE of this Act can be satisfied by the\ndelegate.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "The Minister may, in writing, delegate the Minister’s power to\nmake an instrument under subsection 58AC(1) to another Minister.\nNote:\nSections 34AA to 34A of the Acts Interpretation Act 1901 contain\nprovisions relating to delegations. For example, section 34A of that\nAct means that section 58AE of this Act can be satisfied by the\ndelegate.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58af-norm"
        }
      ],
      "cml:integrityHash": "0cd7caf9c4902bbf99e00d4125eb8839331c949c7b7dc6c2ab729b20cbdd950a",
      "skos:note": "Delegation of power to another Minister"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58af",
      "@type": "cof:Section",
      "cof:title": "58AF Delegation",
      "values:kind": "section",
      "cof:pageNumber": 201,
      "values:originalText": "The Minister may, in writing, delegate the Minister’s power to\nmake an instrument under subsection 58AC(1) to another Minister.\nNote:\nSections 34AA to 34A of the Acts Interpretation Act 1901 contain\nprovisions relating to delegations. For example, section 34A of that\nAct means that section 58AE of this Act can be satisfied by the\ndelegate.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58af-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58af"
      },
      "values:deonticStatus": {
