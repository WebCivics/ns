      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Court may not make an adverse publicity order",
      "cml:conclusionText": "A person who meets the conditions cannot be subject to an adverse publicity order"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86d-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
