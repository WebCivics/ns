      ],
      "cml:integrityHash": "d62b052e53adaf26dcee4241b4b9c640a8e163c8a55e5cd211a5b4fd191ab6c7",
      "skos:note": "Mediator appointed by parties decides time and place for mediation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ef-ss-1",
      "@type": "cof:Section",
      "cof:title": "57EF(1) Mediation",
      "values:kind": "subsection",
      "cof:pageNumber": 187,
      "values:originalText": "(1) Subject to this section, a mediator appointed by the parties to a\ndispute may decide the time and place for mediation."
    },
