      ],
      "cml:integrityHash": "78720e8f8af3ac9fdf10b3d4a422e35f6a4f811c734a9c8d4c18f06b85698b39",
      "skos:note": "Identify SPF consumers at risk of being targeted by a scam",
      "dc:description": "Information about scams to identified consumers"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58bk-ss-2",
      "@type": "cof:Section",
      "cof:title": "58BK(2) Further detail about certain concepts",
      "values:kind": "subsection",
      "cof:pageNumber": 212,
      "values:originalText": "(2) For the purposes of (but without limiting) subsection 58CC(1), the\nSPF code for a regulated sector may include sector-specific\nprovisions:\n\n(a) describing what are reasonable steps for the purposes of this\nSubdivision (see also section 58BB); or\n\n(b) requiring each regulated entity for the sector to:\n\n(i) identify its SPF consumers who are at risk of being\ntargeted by a scam; or\n\n(ii) identify its SPF consumers who have a higher risk of\nbeing targeted by a scam; or\n\n(c) requiring each regulated entity for the sector to provide\ninformation about such scams to an SPF consumer described\nin subparagraph (b)(i) or (ii).\nSubdivision D—SPF principle 3: Detect"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bk-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58bk-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bk-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to identify SPF consumers",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bl",
      "@type": "cml:Concept",
      "skos:prefLabel": "58BL Simplified outline of this Subdivision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58bl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.212",
      "values:originalText": "Each regulated entity for a regulated sector must take reasonable\nsteps to detect scams. This includes:\n\n(a)\ninvestigating, in a timely way, activities that are the\nsubjects of its actionable scam intelligence; and\n\n(b)\nidentifying, in a timely way, its consumers that have or\nmay have been impacted by such activities.\nThe SPF code for the sector may include sector-specific provisions\nfor this principle.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nOverarching principles of the Scams Prevention Framework  Division 2\n\nSection 58BM\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Each regulated entity for a regulated sector must take reasonable\nsteps to detect scams. This includes:\n\n(a)\ninvestigating, in a timely way, activities that are the\nsubjects of its actionable scam intelligence; and\n\n(b)\nidentifying, in a timely way, its consumers that have or\nmay have been impacted by such activities.\nThe SPF code for the sector may include sector-specific provisions\nfor this principle.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nScams Prevention Framework  Part IVF\nOverarching principles of the Scams Prevention Framework  Division 2\n\nSection 58BM\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58bl-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58bl-logic-deontic-1"
        },
