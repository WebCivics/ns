    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "86D(2) Punitive orders—adverse publicity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-86d-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
