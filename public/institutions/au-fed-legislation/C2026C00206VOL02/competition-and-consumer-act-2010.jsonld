      },
      "cml:premiseText": "(c) is in any way, directly or indirectly, knowingly concerned in, nor party to, the contravention by a person of;",
      "cml:conclusionText": "is punishable"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits conspiring with others to contravene a provision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
