        }
      ],
      "cml:integrityHash": "2076c6d957e622443950c7f191cf3861d449905935b450776438ba41e442d6f4",
      "skos:note": "Supplies goods or services of a particular description in a locality on particular terms and conditions before the applicable day."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95n-ss-3",
      "@type": "cof:Section",
      "cof:title": "95N(3) Price restrictions",
      "values:kind": "subsection",
      "cof:pageNumber": 479,
      "values:originalText": "(3) The person commits an offence if:\n\n(a) before the applicable day in relation to the business notice,\nthe person supplies (the current supply) goods or services of\nthat description in a locality on particular terms and\nconditions; and\n\n(b) the person has not supplied goods or services of that\ndescription in that locality on the same or substantially\nsimilar terms and conditions in the period of 12 months\nbefore the current supply, but has supplied goods or services\n\nChapter 6  Other provisions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3"
