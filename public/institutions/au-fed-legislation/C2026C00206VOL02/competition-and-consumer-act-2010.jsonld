      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60n-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to pay penalty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Failure to comply with infringement notice",
      "cml:conclusionText": "Liability for contravention"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60p",
      "@type": "cml:Concept",
      "skos:prefLabel": "60P Infringement notice compliance period for infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60p"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.316",
      "values:originalText": "(1) The infringement notice compliance period for an infringement\nnotice is the period of 28 days beginning on the day after the day\non which the infringement notice is issued by the Commission.\n\n(2) Subsection (1) has effect subject to subsection (7).\n\n(3) The Commission may extend, by notice in writing, the\ninfringement notice compliance period for the notice if the\nCommission is satisfied that it is appropriate to do so.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nCarbon tax price reduction obligation  Part V\nInfringement notices  Division 5\n\nSection 60Q\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(4) Only one extension may be given, and the extension must not be\nfor longer than 28 days.\n\n(5) Notice of the extension must be given to the person who was\nissued the infringement notice.\n\n(6) A failure to comply with subsection (5) does not affect the validity\nof the extension.\n\n(7) If the Commission extends the infringement notice compliance\nperiod for an infringement notice, a reference in this Division to\nthe infringement notice compliance period for an infringement\nnotice is taken to be a reference to the infringement notice\ncompliance period as so extended.",
      "skos:definition": "(1) The infringement notice compliance period for an infringement\nnotice is the period of 28 days beginning on the day after the day\non which the infringement notice is issued by the Commission.\n\n(2) Subsection (1) has effect subject to subsection (7).\n\n(3) The Commission may extend, by notice in writing, the\ninfringement notice compliance period for the notice if the\nCommission is satisfied that it is appropriate to do so.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nCarbon tax price reduction obligation  Part V\nInfringement notices  Division 5\n\nSection 60Q\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(4) Only one extension may be given, and the extension must not be\nfor longer than 28 days.\n\n(5) Notice of the extension must be given to the person who was\nissued the infringement notice.\n\n(6) A failure to comply with subsection (5) does not affect the validity\nof the extension.\n\n(7) If the Commission extends the infringement notice compliance\nperiod for an infringement notice, a reference in this Division to\nthe infringement notice compliance period for an infringement\nnotice is taken to be a reference to the infringement notice\ncompliance period as so extended.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-5"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-6"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60p-ss-7"
        }
      ],
      "cml:integrityHash": "2bfcca1717a0a7247e4f99154dcd34b6849914e7905260ef9d5175f66000e52e"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60p",
      "@type": "cof:Section",
      "cof:title": "60P Infringement notice compliance period for infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 316,
      "values:originalText": "(1) The infringement notice compliance period for an infringement\nnotice is the period of 28 days beginning on the day after the day\non which the infringement notice is issued by the Commission.\n\n(2) Subsection (1) has effect subject to subsection (7).\n\n(3) The Commission may extend, by notice in writing, the\ninfringement notice compliance period for the notice if the\nCommission is satisfied that it is appropriate to do so.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nCarbon tax price reduction obligation  Part V\nInfringement notices  Division 5\n\nSection 60Q\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(4) Only one extension may be given, and the extension must not be\nfor longer than 28 days.\n\n(5) Notice of the extension must be given to the person who was\nissued the infringement notice.\n\n(6) A failure to comply with subsection (5) does not affect the validity\nof the extension.\n\n(7) If the Commission extends the infringement notice compliance\nperiod for an infringement notice, a reference in this Division to\nthe infringement notice compliance period for an infringement\nnotice is taken to be a reference to the infringement notice\ncompliance period as so extended."
    },
