    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57fa",
      "@type": "cml:Concept",
      "skos:prefLabel": "57FA Scheme adviser—establishment and appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57fa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.190",
      "values:originalText": "(1) There is to be a motor vehicle service and repair information\nscheme adviser for the purposes of this Part.\n\n(2) The Minister may, by instrument, appoint a person to be the\nscheme adviser.\n\n(3) The scheme adviser is not entitled to any payment (including any\nremuneration or allowances) relating to this appointment.\nNote:\nThe person appointed could be a body corporate or an individual.",
      "skos:definition": "(1) There is to be a motor vehicle service and repair information\nscheme adviser for the purposes of this Part.\n\n(2) The Minister may, by instrument, appoint a person to be the\nscheme adviser.\n\n(3) The scheme adviser is not entitled to any payment (including any\nremuneration or allowances) relating to this appointment.\nNote:\nThe person appointed could be a body corporate or an individual.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fa-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fa-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57fa-ss-3"
        }
      ],
      "cml:integrityHash": "8a0c976920d26fd604c1231b92a7d7e568e09cbb25d69a2191efe39168b8e584"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57fa",
      "@type": "cof:Section",
      "cof:title": "57FA Scheme adviser—establishment and appointment",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "(1) There is to be a motor vehicle service and repair information\nscheme adviser for the purposes of this Part.\n\n(2) The Minister may, by instrument, appoint a person to be the\nscheme adviser.\n\n(3) The scheme adviser is not entitled to any payment (including any\nremuneration or allowances) relating to this appointment.\nNote:\nThe person appointed could be a body corporate or an individual."
    },
