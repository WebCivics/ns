        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "57BA Meaning of scheme vehicle",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ba"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.168",
      "values:originalText": "A scheme vehicle is:\n\n(a) a light goods vehicle, within the meaning of a national road\nvehicle standard made under the Road Vehicle Standards Act\n2018 that specifies definitions and vehicle categories for the\npurposes of that Act, that was manufactured on or after:\n\n(i) 1 January 2002; or\n\n(ii) a later date prescribed by the scheme rules; or\n\n(b) a passenger vehicle (other than an omnibus), within the\nmeaning of a national road vehicle standard made under the\nRoad Vehicle Standards Act 2018 that specifies definitions\nand vehicle categories for the purposes of that Act, that was\nmanufactured on or after:\n\n(i) 1 January 2002; or\n\n(ii) a later date prescribed by the scheme rules; or\n\n(c) another kind of vehicle prescribed by the scheme rules.",
      "skos:definition": "A scheme vehicle is:\n\n(a) a light goods vehicle, within the meaning of a national road\nvehicle standard made under the Road Vehicle Standards Act\n2018 that specifies definitions and vehicle categories for the\npurposes of that Act, that was manufactured on or after:\n\n(i) 1 January 2002; or\n\n(ii) a later date prescribed by the scheme rules; or\n\n(b) a passenger vehicle (other than an omnibus), within the\nmeaning of a national road vehicle standard made under the\nRoad Vehicle Standards Act 2018 that specifies definitions\nand vehicle categories for the purposes of that Act, that was\nmanufactured on or after:\n\n(i) 1 January 2002; or\n\n(ii) a later date prescribed by the scheme rules; or\n\n(c) another kind of vehicle prescribed by the scheme rules.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ba-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ba-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ba-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57ba-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "dbf274fadef7583758476b60f3217725218c175e5ba9795bc03dba95a6c824e4",
      "skos:note": "Definition of scheme vehicle"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ba",
      "@type": "cof:Section",
      "cof:title": "57BA Meaning of scheme vehicle",
      "values:kind": "section",
      "cof:pageNumber": 168,
      "values:originalText": "A scheme vehicle is:\n\n(a) a light goods vehicle, within the meaning of a national road\nvehicle standard made under the Road Vehicle Standards Act\n2018 that specifies definitions and vehicle categories for the\npurposes of that Act, that was manufactured on or after:\n\n(i) 1 January 2002; or\n\n(ii) a later date prescribed by the scheme rules; or\n\n(b) a passenger vehicle (other than an omnibus), within the\nmeaning of a national road vehicle standard made under the\nRoad Vehicle Standards Act 2018 that specifies definitions\nand vehicle categories for the purposes of that Act, that was\nmanufactured on or after:\n\n(i) 1 January 2002; or\n\n(ii) a later date prescribed by the scheme rules; or\n\n(c) another kind of vehicle prescribed by the scheme rules."
    },
    {
