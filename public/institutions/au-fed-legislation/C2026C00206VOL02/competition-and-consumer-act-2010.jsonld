      },
      "cml:premiseText": "(a) the person is subject to a requirement under subsection (1); and (b) the person is capable of complying with the requirement;",
      "cml:conclusionText": "The requirement diffuses to the person."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60h-ss-5",
