      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.386",
      "values:originalText": "(4) In this section:\nAustralian Statistician means the Australian Statistician referred\nto in subsection 5(2) of the Australian Bureau of Statistics Act\n1975.",
      "skos:definition": "(4) In this section:\nAustralian Statistician means the Australian Statistician referred\nto in subsection 5(2) of the Australian Bureau of Statistics Act\n1975.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87n"
      },
      "cml:asserts": [
