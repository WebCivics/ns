    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95g-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "95G(6) Commission’s functions under this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95g-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
