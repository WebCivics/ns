    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58bp",
      "@type": "cml:Concept",
      "skos:prefLabel": "58BP Sector-specific details can be set out in SPF codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58bp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.214",
      "values:originalText": "For the purposes of (but without limiting) subsection 58CC(1), the\nSPF code for a regulated sector may include sector-specific\nprovisions describing:\n\n(a) what are reasonable steps (see also section 58BB); or\n\n(b) what is a reasonable time;\nfor the purposes of this Subdivision.\nSubdivision E—SPF principle 4: Report",
      "skos:definition": "For the purposes of (but without limiting) subsection 58CC(1), the\nSPF code for a regulated sector may include sector-specific\nprovisions describing:\n\n(a) what are reasonable steps (see also section 58BB); or\n\n(b) what is a reasonable time;\nfor the purposes of this Subdivision.\nSubdivision E—SPF principle 4: Report",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58bp-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58bp-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f713f1d59f5292fcaa42150c482dd43e9ea752d2a875eaeeee5f6998369963aa",
      "skos:note": "Regulated sector may include sector-specific provisions describing reasonable steps and time."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58bp",
      "@type": "cof:Section",
      "cof:title": "58BP Sector-specific details can be set out in SPF codes",
      "values:kind": "section",
      "cof:pageNumber": 214,
      "values:originalText": "For the purposes of (but without limiting) subsection 58CC(1), the\nSPF code for a regulated sector may include sector-specific\nprovisions describing:\n\n(a) what are reasonable steps (see also section 58BB); or\n\n(b) what is a reasonable time;\nfor the purposes of this Subdivision.\nSubdivision E—SPF principle 4: Report"
    },
