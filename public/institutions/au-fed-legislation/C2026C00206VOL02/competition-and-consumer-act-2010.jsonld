    {
      "@id": "concept:competition-and-consumer-act-2010-sec-109",
      "@type": "cml:Concept",
      "skos:prefLabel": "109 Participants in proceedings before Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-109"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.545",
      "values:originalText": "(1) A person to whom an authorisation under Division 1 of Part VII\nwas granted is entitled to participate in any proceedings before the\nTribunal instituted by another person in relation to that\nauthorisation.\n\n(1AA) A notifying party of a notification of an acquisition is entitled to\nparticipate in any proceedings before the Tribunal under\nDivision 1B instituted by another person for review of an\nacquisition determination in respect of the notification.\n\nChapter 6  Other provisions",
      "skos:definition": "(1) A person to whom an authorisation under Division 1 of Part VII\nwas granted is entitled to participate in any proceedings before the\nTribunal instituted by another person in relation to that\nauthorisation.\n\n(1AA) A notifying party of a notification of an acquisition is entitled to\nparticipate in any proceedings before the Tribunal under\nDivision 1B instituted by another person for review of an\nacquisition determination in respect of the notification.\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-109-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-109-logic-deontic-1"
