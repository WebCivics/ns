    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100c-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "100C(4) Applications for review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100c-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
