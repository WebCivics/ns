    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87zb",
      "@type": "cml:Concept",
      "skos:prefLabel": "87ZB Exemplary and aggravated damages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87zb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
