      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87ce-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "87CE(2) Defendant to notify plaintiff of concurrent wrongdoer of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87ce-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.374",
      "values:originalText": "(2) The court may order that the costs to be paid by the defendant be\nassessed on an indemnity basis or otherwise.\n\nEnforcement and remedies  Chapter 5\nProportionate liability for misleading and deceptive conduct  Part VIA\n\nSection 87CF\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(2) The court may order that the costs to be paid by the defendant be\nassessed on an indemnity basis or otherwise.\n\nEnforcement and remedies  Chapter 5\nProportionate liability for misleading and deceptive conduct  Part VIA\n\nSection 87CF\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87ce"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87ce-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87ce-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "20aed2b4898b9c8128c6544b66e356c7ab587b658e120f10fab415fbe6fd1407",
      "skos:note": "Defendant must pay costs on an indemnity basis or otherwise."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87ce-ss-2",
      "@type": "cof:Section",
      "cof:title": "87CE(2) Defendant to notify plaintiff of concurrent wrongdoer of",
      "values:kind": "subsection",
      "cof:pageNumber": 374,
      "values:originalText": "(2) The court may order that the costs to be paid by the defendant be\nassessed on an indemnity basis or otherwise.\n\nEnforcement and remedies  Chapter 5\nProportionate liability for misleading and deceptive conduct  Part VIA\n\nSection 87CF\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87ce-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87ce-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
