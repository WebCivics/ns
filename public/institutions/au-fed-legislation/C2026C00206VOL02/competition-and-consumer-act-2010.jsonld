    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60m",
      "@type": "cml:Concept",
      "skos:prefLabel": "60M Effect of compliance with an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.315",
      "values:originalText": "Scope\n\n(1) This section applies if:\n\n(a) an infringement notice for an alleged contravention of an\ninfringement notice provision is issued to a person; and\n\n(b) the person pays the penalty specified in the infringement\nnotice within the infringement notice compliance period and\nin accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 60Q.\nEffect\n\n(2) The person is not, merely because of the payment, regarded as:\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "Scope\n\n(1) This section applies if:\n\n(a) an infringement notice for an alleged contravention of an\ninfringement notice provision is issued to a person; and\n\n(b) the person pays the penalty specified in the infringement\nnotice within the infringement notice compliance period and\nin accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 60Q.\nEffect\n\n(2) The person is not, merely because of the payment, regarded as:\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60m-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60m-ss-2"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60m",
      "@type": "cof:Section",
      "cof:title": "60M Effect of compliance with an infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 315,
      "values:originalText": "Scope\n\n(1) This section applies if:\n\n(a) an infringement notice for an alleged contravention of an\ninfringement notice provision is issued to a person; and\n\n(b) the person pays the penalty specified in the infringement\nnotice within the infringement notice compliance period and\nin accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 60Q.\nEffect\n\n(2) The person is not, merely because of the payment, regarded as:\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60m-ss-1",
