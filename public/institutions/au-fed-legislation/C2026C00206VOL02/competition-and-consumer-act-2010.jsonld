    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60d-ss-4",
      "@type": "cof:Section",
      "cof:title": "60D(4) Notice to entity that is considered to have engaged in price",
      "values:kind": "subsection",
      "cof:pageNumber": 297,
      "values:originalText": "(4) The Commission may vary or revoke the notice on its own\ninitiative or on application made by the entity. The Commission\nmust give the entity written notice of the variation or revocation."
    },
