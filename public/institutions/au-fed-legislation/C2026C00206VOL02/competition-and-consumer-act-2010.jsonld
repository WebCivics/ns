    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56cn",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CN Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56cn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
