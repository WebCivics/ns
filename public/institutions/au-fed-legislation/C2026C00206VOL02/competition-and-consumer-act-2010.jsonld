      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An inspector of the SPF sector regulator is an authorised person.",
      "cml:conclusionText": "The inspector of the SPF sector regulator is an authorised applicant."
    },
    {
