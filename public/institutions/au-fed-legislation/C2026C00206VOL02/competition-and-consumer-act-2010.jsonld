        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95zc-ss-7"
        }
      ],
      "cml:integrityHash": "b41a5f15cff640efeeaa59eb267576648df1fa70233367180a762bbd924380ca"
