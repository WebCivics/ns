      },
      "cml:operator": "during",
      "cml:logicSummary": "The CDR provisions bind the Crown during its various capacities.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
