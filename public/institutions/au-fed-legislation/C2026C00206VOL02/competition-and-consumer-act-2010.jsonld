        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.352",
      "values:originalText": "(1) In a proceeding against a person under section 82 or in an\napplication under subsection 51ADB(1), 53ZO(1) or 87(1A) for an\norder against a person, a finding of any fact made by a court, or an\nadmission of any fact made by the person, is prima facie evidence\nof that fact if the finding or admission is made in proceedings:\n\n(a) that are proceedings:\n\n(i) under section 77, 80, 81, 86C, 86D or 86E; or\n\n(ii) for an offence against section 45AF or 45AG or\nsubsection 56BN(1) or 56BZI(1); and\n\n(b) in which that person has been found to have contravened, or\nto have been involved in a contravention of:\n\n(i) a provision of Part IV, IVB, IVBA, IVBB or IVE; or\n\n(ii) section 55B, 60C or 60K; or\n\n(iia) a civil penalty provision of a gas market instrument; or\n\n(iii) subsection 56BO(1) or 56BU(1), section 56BZA,\n56BZB or 56BZC, subsection 56BZD(1), section 56BZJ\nor a civil penalty provision of the consumer data rules.",
      "skos:definition": "(1) In a proceeding against a person under section 82 or in an\napplication under subsection 51ADB(1), 53ZO(1) or 87(1A) for an\norder against a person, a finding of any fact made by a court, or an\nadmission of any fact made by the person, is prima facie evidence\nof that fact if the finding or admission is made in proceedings:\n\n(a) that are proceedings:\n\n(i) under section 77, 80, 81, 86C, 86D or 86E; or\n\n(ii) for an offence against section 45AF or 45AG or\nsubsection 56BN(1) or 56BZI(1); and\n\n(b) in which that person has been found to have contravened, or\nto have been involved in a contravention of:\n\n(i) a provision of Part IV, IVB, IVBA, IVBB or IVE; or\n\n(ii) section 55B, 60C or 60K; or\n\n(iia) a civil penalty provision of a gas market instrument; or\n\n(iii) subsection 56BO(1) or 56BU(1), section 56BZA,\n56BZB or 56BZC, subsection 56BZD(1), section 56BZJ\nor a civil penalty provision of the consumer data rules.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-83"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-epistemic-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-ltl-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "355c2c146a0d730b8f7b6ce6d073b4ca8892e8ae2cdc2124deedb338cb47c347",
      "skos:note": "Findings and admissions of fact in proceedings are prima facie evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-83-ss-1",
      "@type": "cof:Section",
      "cof:title": "83(1) Findings and admissions of fact in proceedings to be evidence",
      "values:kind": "subsection",
      "cof:pageNumber": 352,
      "values:originalText": "(1) In a proceeding against a person under section 82 or in an\napplication under subsection 51ADB(1), 53ZO(1) or 87(1A) for an\norder against a person, a finding of any fact made by a court, or an\nadmission of any fact made by the person, is prima facie evidence\nof that fact if the finding or admission is made in proceedings:\n\n(a) that are proceedings:\n\n(i) under section 77, 80, 81, 86C, 86D or 86E; or\n\n(ii) for an offence against section 45AF or 45AG or\nsubsection 56BN(1) or 56BZI(1); and\n\n(b) in which that person has been found to have contravened, or\nto have been involved in a contravention of:\n\n(i) a provision of Part IV, IVB, IVBA, IVBB or IVE; or\n\n(ii) section 55B, 60C or 60K; or\n\n(iia) a civil penalty provision of a gas market instrument; or\n\n(iii) subsection 56BO(1) or 56BU(1), section 56BZA,\n56BZB or 56BZC, subsection 56BZD(1), section 56BZJ\nor a civil penalty provision of the consumer data rules."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to provide prima facie evidence.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Findings and admissions of fact in proceedings are made in certain types of proceedings.",
      "cml:conclusionText": "Therefore, these findings and admissions are prima facie evidence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Permission to provide prima facie evidence is not required.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There is no requirement for a person to provide prima facie evidence in proceedings.",
      "cml:conclusionText": "Therefore, permission to provide prima facie evidence is not required."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Justification",
      "cml:logicSummary": "Findings and admissions of fact in proceedings are justified by the court's findings.",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The court's findings are a justification for the admission of prima facie evidence.",
      "cml:conclusionText": "Therefore, findings and admissions of fact in proceedings are justified by the court's findings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "TemporalRelation",
      "cml:logicSummary": "Findings and admissions of fact in proceedings have a temporal relation to the proceedings.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The findings and admissions of fact in proceedings occur at the same time as the proceedings.",
      "cml:conclusionText": "Therefore, findings and admissions of fact in proceedings have a temporal relation to the proceedings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "There is an obligation on the person to provide prima facie evidence in certain types of proceedings.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The court's findings are a basis for the admission of prima facie evidence.",
      "cml:conclusionText": "Therefore, there is an obligation on the person to provide prima facie evidence in certain types of proceedings."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-83-ss-2",
