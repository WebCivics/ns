    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "87P(1) Most extreme cases",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87p-ss-1"
