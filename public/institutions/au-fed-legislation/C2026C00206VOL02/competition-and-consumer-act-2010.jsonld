    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95",
      "@type": "cml:Concept",
      "skos:prefLabel": "95 Register of notifications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.455",
      "values:originalText": "(1) The Commission shall keep a register containing:\n\n(aa) notices relating to voluntary industry codes given to the\nCommission pursuant to regulations made under\nsection 51AE (including notices that have been withdrawn\npursuant to those regulations); and\n\n(a) draft notices, and summaries of reasons, by the Commission\nfurnished to any person under section 93A; and\n\n(b) records of conferences made in accordance with\nsubsection 93A(7) and certificates in relation to conferences\ngiven under subsection 93A(8); and\n\n(c) notices (including notices that have been withdrawn) given to\nthe Commission under section 93 or 93AB; and\n\n(d) documents furnished to the Commission in relation to such\nnotices; and\n\nChapter 6  Other provisions",
      "skos:definition": "(1) The Commission shall keep a register containing:\n\n(aa) notices relating to voluntary industry codes given to the\nCommission pursuant to regulations made under\nsection 51AE (including notices that have been withdrawn\npursuant to those regulations); and\n\n(a) draft notices, and summaries of reasons, by the Commission\nfurnished to any person under section 93A; and\n\n(b) records of conferences made in accordance with\nsubsection 93A(7) and certificates in relation to conferences\ngiven under subsection 93A(8); and\n\n(c) notices (including notices that have been withdrawn) given to\nthe Commission under section 93 or 93AB; and\n\n(d) documents furnished to the Commission in relation to such\nnotices; and\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9050238ddb1313b3c81f77191219c0991f820f0a93dc7f1732067207d0c900ea",
      "skos:note": "The Commission shall keep a register containing certain notices and documents."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95",
      "@type": "cof:Section",
      "cof:title": "95 Register of notifications",
      "values:kind": "section",
      "cof:pageNumber": 455,
      "values:originalText": "(1) The Commission shall keep a register containing:\n\n(aa) notices relating to voluntary industry codes given to the\nCommission pursuant to regulations made under\nsection 51AE (including notices that have been withdrawn\npursuant to those regulations); and\n\n(a) draft notices, and summaries of reasons, by the Commission\nfurnished to any person under section 93A; and\n\n(b) records of conferences made in accordance with\nsubsection 93A(7) and certificates in relation to conferences\ngiven under subsection 93A(8); and\n\n(c) notices (including notices that have been withdrawn) given to\nthe Commission under section 93 or 93AB; and\n\n(d) documents furnished to the Commission in relation to such\nnotices; and\n\nChapter 6  Other provisions"
    },
