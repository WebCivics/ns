    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95aa-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "95AA(3) Commission may determine class exemptions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95aa-ss-3"
      },
      "cml:curationStatus": {
