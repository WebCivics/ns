      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-91-ss-1a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
