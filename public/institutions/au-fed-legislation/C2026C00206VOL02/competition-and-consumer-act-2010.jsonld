      },
      "cml:premiseText": "The court may order that the costs to be paid by the defendant...",
      "cml:conclusionText": "The defendant must pay costs on an indemnity basis or otherwise."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87cf",
      "@type": "cml:Concept",
      "skos:prefLabel": "87CF Contribution not recoverable from defendant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87cf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.375",
      "values:originalText": "A defendant against whom judgment is given under this Part as a\nconcurrent wrongdoer in relation to an apportionable claim:\n\n(a) cannot be required to contribute to any damages or\ncontribution recovered from another concurrent wrongdoer in\nrespect of the apportionable claim (whether or not the\ndamages or contribution are recovered in the same\nproceedings in which judgment is given against the\ndefendant); and\n\n(b) cannot be required to indemnify any such wrongdoer.",
      "skos:definition": "A defendant against whom judgment is given under this Part as a\nconcurrent wrongdoer in relation to an apportionable claim:\n\n(a) cannot be required to contribute to any damages or\ncontribution recovered from another concurrent wrongdoer in\nrespect of the apportionable claim (whether or not the\ndamages or contribution are recovered in the same\nproceedings in which judgment is given against the\ndefendant); and\n\n(b) cannot be required to indemnify any such wrongdoer.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87cf-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87cf-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2a9c5d15c4fd9c1d705bf20a68b8ac6099000312480fabf2579069b8b758cb13",
      "skos:note": "Defendant cannot be required to contribute or indemnify another wrongdoer."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87cf",
      "@type": "cof:Section",
      "cof:title": "87CF Contribution not recoverable from defendant",
      "values:kind": "section",
      "cof:pageNumber": 375,
      "values:originalText": "A defendant against whom judgment is given under this Part as a\nconcurrent wrongdoer in relation to an apportionable claim:\n\n(a) cannot be required to contribute to any damages or\ncontribution recovered from another concurrent wrongdoer in\nrespect of the apportionable claim (whether or not the\ndamages or contribution are recovered in the same\nproceedings in which judgment is given against the\ndefendant); and\n\n(b) cannot be required to indemnify any such wrongdoer."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87cf-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87cf"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
