    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ft-ss-4",
      "@type": "cof:Section",
      "cof:title": "58FT(4) Infringement notice compliance period for infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 262,
      "values:originalText": "(4) A failure to give the person written notice of the extension does not\naffect the validity of the extension."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58ft-ss-4-norm",
