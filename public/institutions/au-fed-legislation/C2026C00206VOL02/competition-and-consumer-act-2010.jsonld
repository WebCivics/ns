    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95e",
      "@type": "cml:Concept",
      "skos:prefLabel": "95E Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.471",
      "values:originalText": "The object of this Part is to have prices surveillance applied only in\nthose markets where, in the view of the Minister, competitive\npressures are not sufficient to achieve efficient prices and protect\nconsumers.",
      "skos:definition": "The object of this Part is to have prices surveillance applied only in\nthose markets where, in the view of the Minister, competitive\npressures are not sufficient to achieve efficient prices and protect\nconsumers.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95e-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f675301338814b33dcdb0e6ba7d02a9d5669b0d822a15d2c53db40b9353a0604",
      "skos:note": "Prices surveillance should be applied only in markets where competitive pressures are insufficient to achieve efficient prices and protect consumers."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95e",
      "@type": "cof:Section",
      "cof:title": "95E Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 471,
      "values:originalText": "The object of this Part is to have prices surveillance applied only in\nthose markets where, in the view of the Minister, competitive\npressures are not sufficient to achieve efficient prices and protect\nconsumers."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95e-norm",
