      },
      "cml:operator": ">=",
      "cml:logicSummary": "Includes provisions for specific dates or periods",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Without limiting subparagraph (1)(b)(ii), an SPF code for a regulated sector may include the following:",
      "cml:conclusionText": "Provisions regarding services and consumers from a certain point in time"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58cc-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "for all",
      "cml:logicSummary": "Applies to all regulated entities",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
