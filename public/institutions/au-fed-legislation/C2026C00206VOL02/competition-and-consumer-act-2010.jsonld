    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95t-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "95T(2) Failure of witness to attend",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95t-ss-2"
      },
      "cml:curationStatus": {
