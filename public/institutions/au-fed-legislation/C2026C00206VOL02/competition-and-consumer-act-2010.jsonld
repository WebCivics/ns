    {
      "@id": "concept:competition-and-consumer-act-2010-sec-112-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "112(4) Tribunal may charge fees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-112-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
