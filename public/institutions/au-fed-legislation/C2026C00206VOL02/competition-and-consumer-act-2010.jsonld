    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56cb",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CB Review of decisions refusing to accredit",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56cb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.102",
      "values:originalText": "Applications may be made to the Administrative Review Tribunal\nfor review of decisions of the CDR Accreditor under\nsubsection 56CA(1) refusing to accredit persons.\nNote:\nFor review by the Administrative Review Tribunal of decisions to\nvary, suspend or revoke accreditations, see subsection 56BH(4).\nSubdivision B—Register of Accredited Persons",
      "skos:definition": "Applications may be made to the Administrative Review Tribunal\nfor review of decisions of the CDR Accreditor under\nsubsection 56CA(1) refusing to accredit persons.\nNote:\nFor review by the Administrative Review Tribunal of decisions to\nvary, suspend or revoke accreditations, see subsection 56BH(4).\nSubdivision B—Register of Accredited Persons",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56cb-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56cb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4251491feae2b368d61b0dab1fc7fe781388941d7ab724336e1cba5104deda94",
      "skos:note": "Application for review of decision refusing accreditation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56cb",
      "@type": "cof:Section",
      "cof:title": "56CB Review of decisions refusing to accredit",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "Applications may be made to the Administrative Review Tribunal\nfor review of decisions of the CDR Accreditor under\nsubsection 56CA(1) refusing to accredit persons.\nNote:\nFor review by the Administrative Review Tribunal of decisions to\nvary, suspend or revoke accreditations, see subsection 56BH(4).\nSubdivision B—Register of Accredited Persons"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56cb-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
