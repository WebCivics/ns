      "cml:operator": "=",
      "cml:logicSummary": "Identifies the scope of National Electricity Rules",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
