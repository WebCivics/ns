      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-101a-logic-deontic-1",
      "@type": "cml:LogicApplication",
