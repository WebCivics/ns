      "cml:operator": "substantially",
      "cml:logicSummary": "Substantial inclusion",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
