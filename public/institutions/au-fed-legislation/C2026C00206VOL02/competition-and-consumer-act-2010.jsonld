        }
      ],
      "cml:integrityHash": "b35789622f666b7946489026c0becbe4b1672698832ba1eee4492b20099d07c1",
      "skos:note": "Minister may extend declaration of exceptional circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95af-ss-1",
      "@type": "cof:Section",
      "cof:title": "95AF(1) Extension of declaration of exceptional circumstances",
      "values:kind": "subsection",
      "cof:pageNumber": 465,
      "values:originalText": "(1) The Minister may, by legislative instrument, extend the operation\nof a declaration under section 95AE if the Minister is satisfied that\nthe exceptional circumstances mentioned in\nsubparagraph 95AE(1)(a)(i) are likely to continue to exist beyond\nthe period in which the order will be in force."
    },
