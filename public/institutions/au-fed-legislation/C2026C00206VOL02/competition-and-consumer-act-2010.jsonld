    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fb-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "58FB(3) Appointment of inspectors",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fb-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.247",
      "values:originalText": "(3) A person must, in exercising powers as an inspector of an SPF\nregulator, comply with any directions of the SPF regulator that are\nof an administrative character.",
      "skos:definition": "(3) A person must, in exercising powers as an inspector of an SPF\nregulator, comply with any directions of the SPF regulator that are\nof an administrative character.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58fb"
      },
