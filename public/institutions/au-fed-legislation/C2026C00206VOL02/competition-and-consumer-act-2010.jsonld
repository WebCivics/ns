        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Damages assessment is relevant to non-economic loss",
      "cml:conclusionText": "Non-economic loss must be considered in damages assessment"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1-logic-diffusion-4",
