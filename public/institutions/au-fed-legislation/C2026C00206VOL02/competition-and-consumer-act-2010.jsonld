      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.459",
      "values:originalText": "(3) The determination must specify the period, ending no later than the\nend of the period of 10 years beginning on the day it is made, for\nwhich it is to be in force.",
      "skos:definition": "(3) The determination must specify the period, ending no later than the\nend of the period of 10 years beginning on the day it is made, for\nwhich it is to be in force.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-95aa"
      },
      "cml:asserts": [
