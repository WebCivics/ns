      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.301",
      "values:originalText": "(1) An entity that is given a carbon tax removal substantiation notice\nmust comply with it within the applicable compliance period for\nthe notice.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) An entity that is given a carbon tax removal substantiation notice\nmust comply with it within the applicable compliance period for\nthe notice.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
