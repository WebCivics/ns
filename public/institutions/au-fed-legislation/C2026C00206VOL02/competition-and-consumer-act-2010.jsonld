    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "87N(2) Index numbers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87n-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.386",
      "values:originalText": "(2) Subject to subsection (3), if, at any time before or after the\ncommencement of this Act:\n\n(a) the Australian Statistician has published or publishes an\nindex number in respect of a quarter; and\n\n(b) that index number is in substitution for an index number\npreviously published by the Australian Statistician in respect\nof that quarter;\ndisregard the publication of the later index number for the purposes\nof this section.",
      "skos:definition": "(2) Subject to subsection (3), if, at any time before or after the\ncommencement of this Act:\n\n(a) the Australian Statistician has published or publishes an\nindex number in respect of a quarter; and\n\n(b) that index number is in substitution for an index number\npreviously published by the Australian Statistician in respect\nof that quarter;\ndisregard the publication of the later index number for the purposes\nof this section.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87n"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "394930ffe71ed60818a5a1edd83ac1abca842461e2c06a2b2a2f3a689b801f68",
      "skos:note": "Disregard publication of later index number if previous one is still in effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87n-ss-2",
      "@type": "cof:Section",
      "cof:title": "87N(2) Index numbers",
      "values:kind": "subsection",
      "cof:pageNumber": 386,
      "values:originalText": "(2) Subject to subsection (3), if, at any time before or after the\ncommencement of this Act:\n\n(a) the Australian Statistician has published or publishes an\nindex number in respect of a quarter; and\n\n(b) that index number is in substitution for an index number\npreviously published by the Australian Statistician in respect\nof that quarter;\ndisregard the publication of the later index number for the purposes\nof this section."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
