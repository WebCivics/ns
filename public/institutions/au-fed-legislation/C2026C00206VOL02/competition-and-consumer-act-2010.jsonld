    {
      "@id": "concept:competition-and-consumer-act-2010-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 January 2014;",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-1-2"
      },
      "cml:curationStatus": {
