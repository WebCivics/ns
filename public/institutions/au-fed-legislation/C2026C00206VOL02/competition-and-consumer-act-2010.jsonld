        }
      ],
      "cml:integrityHash": "1c346658cd564a2559c27cf7bec1f37334aed1f212e66ab85a4e138fa8acbd71",
      "skos:note": "Comply with consumer data rules when making, varying or revoking a data standard"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56fa-ss-2",
