    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56gc-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56GC(3) Complying with CDR requirements etc.: protection from",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56gc-ss-3"
      },
      "cml:curationStatus": {
