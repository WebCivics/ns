    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79b",
      "@type": "cml:Concept",
      "skos:prefLabel": "79B Preference must be given to compensation for victims",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-79b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.337",
      "values:originalText": "If the Court considers that:\n\n(a) it is appropriate to order a person (the defendant):\n\n(i) to pay a pecuniary penalty under section 76; or\n\n(ii) to impose a fine under section 45AF or 45AG or\nsubsection 56BN(1) or 56BZI(1);\n\nin respect of a contravention, or an involvement in a\ncontravention, of this Act, a gas market instrument or the\nconsumer data rules; and\n\n(b) it is appropriate to order the defendant to pay compensation\nto a person who has suffered loss or damage in respect of the\ncontravention or the involvement; and\n\n(c) the defendant does not have sufficient financial resources to\npay both the pecuniary penalty or fine and the compensation;\nthe Court must give preference to making an order for\ncompensation.",
      "skos:definition": "If the Court considers that:\n\n(a) it is appropriate to order a person (the defendant):\n\n(i) to pay a pecuniary penalty under section 76; or\n\n(ii) to impose a fine under section 45AF or 45AG or\nsubsection 56BN(1) or 56BZI(1);\n\nin respect of a contravention, or an involvement in a\ncontravention, of this Act, a gas market instrument or the\nconsumer data rules; and\n\n(b) it is appropriate to order the defendant to pay compensation\nto a person who has suffered loss or damage in respect of the\ncontravention or the involvement; and\n\n(c) the defendant does not have sufficient financial resources to\npay both the pecuniary penalty or fine and the compensation;\nthe Court must give preference to making an order for\ncompensation.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-79b-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-79b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "de2983cb8c92b565e56d9b1473f243834890507e961dea271ad450c22198c4b2",
      "skos:note": "Court must give preference to making an order for compensation if defendant cannot pay pecuniary penalty or fine and compensation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-79b",
      "@type": "cof:Section",
      "cof:title": "79B Preference must be given to compensation for victims",
      "values:kind": "section",
      "cof:pageNumber": 337,
      "values:originalText": "If the Court considers that:\n\n(a) it is appropriate to order a person (the defendant):\n\n(i) to pay a pecuniary penalty under section 76; or\n\n(ii) to impose a fine under section 45AF or 45AG or\nsubsection 56BN(1) or 56BZI(1);\n\nin respect of a contravention, or an involvement in a\ncontravention, of this Act, a gas market instrument or the\nconsumer data rules; and\n\n(b) it is appropriate to order the defendant to pay compensation\nto a person who has suffered loss or damage in respect of the\ncontravention or the involvement; and\n\n(c) the defendant does not have sufficient financial resources to\npay both the pecuniary penalty or fine and the compensation;\nthe Court must give preference to making an order for\ncompensation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-79b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-79b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
