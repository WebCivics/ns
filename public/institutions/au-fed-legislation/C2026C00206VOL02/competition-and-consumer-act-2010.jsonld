    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100l",
      "@type": "cml:Concept",
      "skos:prefLabel": "100L Notice of withdrawals and dismissals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.524",
      "values:originalText": "If, under this Subdivision:\n\n(a) an applicant withdraws an application for review; or\n\n(b) the Tribunal dismisses an application;\nthe Tribunal must give the Commission and each participant in the\nproceedings for review notice of the withdrawal or dismissal.",
      "skos:definition": "If, under this Subdivision:\n\n(a) an applicant withdraws an application for review; or\n\n(b) the Tribunal dismisses an application;\nthe Tribunal must give the Commission and each participant in the\nproceedings for review notice of the withdrawal or dismissal.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100l-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b61d56f6db4adc803878fc2f7c8525da0fe6c240e3d97aca37adfe433e558aed",
      "skos:note": "Notice of withdrawal or dismissal to Commission and participants"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100l",
      "@type": "cof:Section",
      "cof:title": "100L Notice of withdrawals and dismissals",
      "values:kind": "section",
      "cof:pageNumber": 524,
      "values:originalText": "If, under this Subdivision:\n\n(a) an applicant withdraws an application for review; or\n\n(b) the Tribunal dismisses an application;\nthe Tribunal must give the Commission and each participant in the\nproceedings for review notice of the withdrawal or dismissal."
    },
