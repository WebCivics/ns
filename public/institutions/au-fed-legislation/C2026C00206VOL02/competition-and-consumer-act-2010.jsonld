    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57cd-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits supply of scheme information infringing copyright",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Subsection (3) applies if...",
      "cml:conclusionText": "...the infringement would constitute an acquisition of property otherwise than on just terms"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57cd-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with copyright infringement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the supply constitutes or results in an infringement of the copyright of the third party claimant;",
      "cml:conclusionText": "...apart from this section, the infringement would constitute an acquisition of property otherwise than on just terms"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57cd-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Recurring supply of scheme information infringes copyright",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a data provider supplies scheme information to an Australian repairer or scheme RTO under this Part;",
      "cml:conclusionText": "...some or all of the scheme information that is the subject of the supply;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57cd-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffuses copyright infringement through supply of scheme information",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) a person (the third party claimant) holds copyright in relation to some or all of the scheme information that is the subject of the supply;",
      "cml:conclusionText": "...apart from this section, the infringement would constitute an acquisition of property otherwise than on just terms"
    },
    {
