      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95ac-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
