      },
      "cml:operator": "CLASSIFICATION",
      "cml:logicSummary": "Classification of regulations for securing material facts and considerations.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-105",
      "@type": "cml:Concept",
      "skos:prefLabel": "105 Power to take evidence on oath",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-105"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.544",
      "values:originalText": "(1) The Tribunal may take evidence on oath or affirmation and for that\npurpose a member of the Tribunal may administer an oath or\naffirmation.\n\n(2) A member of the Tribunal may summon a person to appear before\nthe Tribunal to give evidence and to produce such documents (if\nany) as are referred to in the summons.",
      "skos:definition": "(1) The Tribunal may take evidence on oath or affirmation and for that\npurpose a member of the Tribunal may administer an oath or\naffirmation.\n\n(2) A member of the Tribunal may summon a person to appear before\nthe Tribunal to give evidence and to produce such documents (if\nany) as are referred to in the summons.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-105-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-105-ss-2"
        }
      ],
      "cml:integrityHash": "b64e48a240440ecc794fbbed6bf37e3f3d46a5ae93405fae4f8faceba9349a69"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-105",
      "@type": "cof:Section",
      "cof:title": "105 Power to take evidence on oath",
      "values:kind": "section",
      "cof:pageNumber": 544,
      "values:originalText": "(1) The Tribunal may take evidence on oath or affirmation and for that\npurpose a member of the Tribunal may administer an oath or\naffirmation.\n\n(2) A member of the Tribunal may summon a person to appear before\nthe Tribunal to give evidence and to produce such documents (if\nany) as are referred to in the summons."
    },
