    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100f",
      "@type": "cml:Concept",
      "skos:prefLabel": "100F Tribunal may dismiss applications if parties consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.523",
      "values:originalText": "The Tribunal may, at any time, dismiss an application for review\nmade to the Tribunal under subsection 100C(1) if the Tribunal has\nthe consent of the participants in the proceedings for review.",
      "skos:definition": "The Tribunal may, at any time, dismiss an application for review\nmade to the Tribunal under subsection 100C(1) if the Tribunal has\nthe consent of the participants in the proceedings for review.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100f-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100f-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "335353ee677ed6920db0e1163bf4ca4d90e47cfebae223375e6d33049629e527",
      "skos:note": "Tribunal may dismiss applications with party consent"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100f",
      "@type": "cof:Section",
      "cof:title": "100F Tribunal may dismiss applications if parties consent",
      "values:kind": "section",
      "cof:pageNumber": 523,
      "values:originalText": "The Tribunal may, at any time, dismiss an application for review\nmade to the Tribunal under subsection 100C(1) if the Tribunal has\nthe consent of the participants in the proceedings for review."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100f-norm",
