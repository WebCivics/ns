      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.484",
      "values:originalText": "(1) An inquiry body may take evidence at an inquiry on oath or\naffirmation.",
      "skos:definition": "(1) An inquiry body may take evidence at an inquiry on oath or\naffirmation.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-95s"
      },
      "cml:asserts": [
