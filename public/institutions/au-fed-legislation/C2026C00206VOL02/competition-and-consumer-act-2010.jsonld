    {
      "@id": "concept:competition-and-consumer-act-2010-sec-107",
      "@type": "cml:Concept",
      "skos:prefLabel": "107 Evidence in form of written statement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-107"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.545",
      "values:originalText": "The Tribunal may permit a person appearing as a witness before\nthe Tribunal to give evidence by tendering, and, if the Tribunal\nthinks fit, verifying by oath or affirmation, a written statement,\nwhich shall be filed with the Registrar.",
      "skos:definition": "The Tribunal may permit a person appearing as a witness before\nthe Tribunal to give evidence by tendering, and, if the Tribunal\nthinks fit, verifying by oath or affirmation, a written statement,\nwhich shall be filed with the Registrar.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-107-norm"
        }
      ],
      "cml:integrityHash": "b824221fede56a1984a1541f4b2a4fec05193fe8485c01c4ed1e2c8d3a86d8fa",
      "skos:note": "Permit witness to give evidence by written statement"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-107",
      "@type": "cof:Section",
      "cof:title": "107 Evidence in form of written statement",
      "values:kind": "section",
      "cof:pageNumber": 545,
      "values:originalText": "The Tribunal may permit a person appearing as a witness before\nthe Tribunal to give evidence by tendering, and, if the Tribunal\nthinks fit, verifying by oath or affirmation, a written statement,\nwhich shall be filed with the Registrar."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-107-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-107"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-108",
      "@type": "cml:Concept",
      "skos:prefLabel": "108 Taking of evidence by single member",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-108"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.545",
      "values:originalText": "The Tribunal as constituted for the purposes of any proceedings in\nwhich evidence may be taken may authorise a presidential member\nto take evidence for the purposes of the proceedings on its behalf,\nwith such limitations (if any) as the Tribunal so constituted directs,\nand, where such an authority is given:\n\n(a) that member may take evidence accordingly; and\n\n(b) for the purposes of this Act, that member shall, in relation to\nthe taking of evidence in accordance with the authority, be\ndeemed to constitute the Tribunal.",
      "skos:definition": "The Tribunal as constituted for the purposes of any proceedings in\nwhich evidence may be taken may authorise a presidential member\nto take evidence for the purposes of the proceedings on its behalf,\nwith such limitations (if any) as the Tribunal so constituted directs,\nand, where such an authority is given:\n\n(a) that member may take evidence accordingly; and\n\n(b) for the purposes of this Act, that member shall, in relation to\nthe taking of evidence in accordance with the authority, be\ndeemed to constitute the Tribunal.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-108-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-108-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-108-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "316ce131932072994689eacf25b65b1442dc2b66d99d919b2377ec77c312c120",
      "skos:note": "Authority to take evidence on behalf of the Tribunal"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-108",
      "@type": "cof:Section",
      "cof:title": "108 Taking of evidence by single member",
      "values:kind": "section",
      "cof:pageNumber": 545,
      "values:originalText": "The Tribunal as constituted for the purposes of any proceedings in\nwhich evidence may be taken may authorise a presidential member\nto take evidence for the purposes of the proceedings on its behalf,\nwith such limitations (if any) as the Tribunal so constituted directs,\nand, where such an authority is given:\n\n(a) that member may take evidence accordingly; and\n\n(b) for the purposes of this Act, that member shall, in relation to\nthe taking of evidence in accordance with the authority, be\ndeemed to constitute the Tribunal."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-108-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-108"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
