    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57ed-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "57ED(4) Attempt to resolve dispute before mediation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57ed-ss-4"
      },
      "cml:curationStatus": {
