    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ad-ss-1",
      "@type": "cof:Section",
      "cof:title": "58AD(1) Regulated entities for regulated sectors and their regulated",
      "values:kind": "subsection",
