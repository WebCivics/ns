      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Ignore",
      "cml:logicSummary": "Disregard later publication if previous one is still in effect.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) and (b)",
      "cml:conclusionText": "Disregard publication of later index number for the purposes of this section."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "87N(3) Index numbers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87n-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.386",
      "values:originalText": "(3) If, at any time, the Australian Statistician has changed or changes\nthe index reference period for the Consumer Price Index, then, in\napplying this section after the change took place or takes place,\nhave regard only to index numbers published in terms of the new\nindex reference period.",
      "skos:definition": "(3) If, at any time, the Australian Statistician has changed or changes\nthe index reference period for the Consumer Price Index, then, in\napplying this section after the change took place or takes place,\nhave regard only to index numbers published in terms of the new\nindex reference period.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87n"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87n-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c340cbbe4d4aa9a28ed3b82ea2e86e0258fea9ea81e526a6cf74cdca57eee5b",
      "skos:note": "Regard index numbers published in terms of the new index reference period when applying this section after a change."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87n-ss-3",
      "@type": "cof:Section",
      "cof:title": "87N(3) Index numbers",
      "values:kind": "subsection",
      "cof:pageNumber": 386,
      "values:originalText": "(3) If, at any time, the Australian Statistician has changed or changes\nthe index reference period for the Consumer Price Index, then, in\napplying this section after the change took place or takes place,\nhave regard only to index numbers published in terms of the new\nindex reference period."
    },
