      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chargeable CDR data is disclosed in chargeable circumstances if it is disclosed in circumstances specified:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:logicSummary": "Classification of chargeable CDR data",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chargeable CDR data is disclosed in chargeable circumstances if it is disclosed in circumstances specified:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56am-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
