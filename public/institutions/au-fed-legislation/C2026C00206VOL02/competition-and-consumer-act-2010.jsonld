    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95aa-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "95AA(2) Commission may determine class exemptions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95aa-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
