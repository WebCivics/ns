      "dc:source": "competition-and-consumer-act-2010.pdf, p.230",
      "values:originalText": "The Minister may, by legislative instrument, make a code (an SPF\ncode) for a regulated sector.",
      "skos:definition": "The Minister may, by legislative instrument, make a code (an SPF\ncode) for a regulated sector.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58cb-norm"
        }
      ],
