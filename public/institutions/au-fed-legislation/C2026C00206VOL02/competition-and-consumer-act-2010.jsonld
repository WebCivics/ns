    {
      "@id": "concept:competition-and-consumer-act-2010-sec-55a",
      "@type": "cml:Concept",
      "skos:prefLabel": "55A Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.27",
      "values:originalText": "In this Part:\nexcessive, in relation to a payment surcharge, has the meaning\ngiven by subsection 55B(2).\ninfringement notice compliance period has the meaning given by\nsubsection 55M(1).\nlisted corporation has the meaning given by section 9 of the\nCorporations Act 2001.\npayment surcharge means:\n\n(a) an amount charged, in addition to the price of goods or\nservices, for processing payment for the goods or services; or\n\n(b) an amount (however described) charged for using one\npayment method rather than another.\npayment system standard means a standard determined under\nsection 18 of the Payment Systems (Regulation) Act 1998.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "In this Part:\nexcessive, in relation to a payment surcharge, has the meaning\ngiven by subsection 55B(2).\ninfringement notice compliance period has the meaning given by\nsubsection 55M(1).\nlisted corporation has the meaning given by section 9 of the\nCorporations Act 2001.\npayment surcharge means:\n\n(a) an amount charged, in addition to the price of goods or\nservices, for processing payment for the goods or services; or\n\n(b) an amount (however described) charged for using one\npayment method rather than another.\npayment system standard means a standard determined under\nsection 18 of the Payment Systems (Regulation) Act 1998.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55a-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55a-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "8879a327a0155cf185a52f3d802392474d724a2b851b13e996b88a1cdbda6a55",
      "skos:note": "Defines payment surcharge and infringement notice compliance period"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55a",
      "@type": "cof:Section",
      "cof:title": "55A Definitions",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "In this Part:\nexcessive, in relation to a payment surcharge, has the meaning\ngiven by subsection 55B(2).\ninfringement notice compliance period has the meaning given by\nsubsection 55M(1).\nlisted corporation has the meaning given by section 9 of the\nCorporations Act 2001.\npayment surcharge means:\n\n(a) an amount charged, in addition to the price of goods or\nservices, for processing payment for the goods or services; or\n\n(b) an amount (however described) charged for using one\npayment method rather than another.\npayment system standard means a standard determined under\nsection 18 of the Payment Systems (Regulation) Act 1998.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
