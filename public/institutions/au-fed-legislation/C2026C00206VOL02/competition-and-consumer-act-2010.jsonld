      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ak-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Has authorisation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is authorised by the consumer data rules",
      "cml:conclusionText": "The CDR data can be used or disclosed"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56al",
      "@type": "cml:Concept",
      "skos:prefLabel": "56AL Meanings of CDR participant and designated gateway",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56al"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.51",
      "values:originalText": "(1) A CDR participant, for CDR data, is a data holder, or an\naccredited data recipient, of the CDR data.\n\n(2) A person is a designated gateway, for CDR data, if:\n\n(a) the person is specified as a gateway, as described in\nsubparagraph 56AC(2)(e)(i), in an instrument designating a\nsector under subsection 56AC(2); and\n\n(b) the CDR data is information within a class, specified in that\ninstrument, for which the person is a gateway; and\n\n(c) the CDR data is, or is to be, disclosed to the person under the\nconsumer data rules because the person is:\n\n(i) acting as described in a subparagraph of\nparagraph 56BG(1)(a) or (b); or\n\n(ii) if there are no consumers for the CDR data—acting\nbetween a CDR participant for the CDR data and a\nperson requesting a disclosure of the CDR data;\n\nand not because the person is an accredited person or a CDR\nconsumer for the CDR data.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(1) A CDR participant, for CDR data, is a data holder, or an\naccredited data recipient, of the CDR data.\n\n(2) A person is a designated gateway, for CDR data, if:\n\n(a) the person is specified as a gateway, as described in\nsubparagraph 56AC(2)(e)(i), in an instrument designating a\nsector under subsection 56AC(2); and\n\n(b) the CDR data is information within a class, specified in that\ninstrument, for which the person is a gateway; and\n\n(c) the CDR data is, or is to be, disclosed to the person under the\nconsumer data rules because the person is:\n\n(i) acting as described in a subparagraph of\nparagraph 56BG(1)(a) or (b); or\n\n(ii) if there are no consumers for the CDR data—acting\nbetween a CDR participant for the CDR data and a\nperson requesting a disclosure of the CDR data;\n\nand not because the person is an accredited person or a CDR\nconsumer for the CDR data.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56al-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56al-ss-2"
        }
      ],
      "cml:integrityHash": "bed295dc15e6c83c100efd8fb90d785e651ce4b77f34487356c05c03cef53367"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56al",
      "@type": "cof:Section",
      "cof:title": "56AL Meanings of CDR participant and designated gateway",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "(1) A CDR participant, for CDR data, is a data holder, or an\naccredited data recipient, of the CDR data.\n\n(2) A person is a designated gateway, for CDR data, if:\n\n(a) the person is specified as a gateway, as described in\nsubparagraph 56AC(2)(e)(i), in an instrument designating a\nsector under subsection 56AC(2); and\n\n(b) the CDR data is information within a class, specified in that\ninstrument, for which the person is a gateway; and\n\n(c) the CDR data is, or is to be, disclosed to the person under the\nconsumer data rules because the person is:\n\n(i) acting as described in a subparagraph of\nparagraph 56BG(1)(a) or (b); or\n\n(ii) if there are no consumers for the CDR data—acting\nbetween a CDR participant for the CDR data and a\nperson requesting a disclosure of the CDR data;\n\nand not because the person is an accredited person or a CDR\nconsumer for the CDR data.\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
