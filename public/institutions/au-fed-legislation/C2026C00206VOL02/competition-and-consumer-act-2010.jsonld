    {
      "@id": "concept:competition-and-consumer-act-2010-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 July 2014; and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.288",
      "values:originalText": "(c)\nprovide information with the statement that substantiates\nsuch an estimate; and\n\n(d)\nin a case where the entity sells electricity or natural gas\nto customers—communicate to customers a statement\nthat identifies, on an average annual percentage price\nbasis, or an average annual dollar price basis, the\nestimated cost savings to customers that are for the\nfinancial year that began on 1 July 2014.\n•\nInfringement notices may be issued for certain contraventions\nof this Part.",
      "skos:definition": "(c)\nprovide information with the statement that substantiates\nsuch an estimate; and\n\n(d)\nin a case where the entity sells electricity or natural gas\nto customers—communicate to customers a statement\nthat identifies, on an average annual percentage price\nbasis, or an average annual dollar price basis, the\nestimated cost savings to customers that are for the\nfinancial year that began on 1 July 2014.\n•\nInfringement notices may be issued for certain contraventions\nof this Part.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ed7e7543ba0b9a53cee26a453a0457e9b453516811760ed6cc4ff4820fc7e452",
      "skos:note": "Provide information with substantiating estimate.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-1",
      "@type": "cof:Section",
      "cof:title": "1 July 2014; and",
      "values:kind": "section",
      "cof:pageNumber": 288,
      "values:originalText": "(c)\nprovide information with the statement that substantiates\nsuch an estimate; and\n\n(d)\nin a case where the entity sells electricity or natural gas\nto customers—communicate to customers a statement\nthat identifies, on an average annual percentage price\nbasis, or an average annual dollar price basis, the\nestimated cost savings to customers that are for the\nfinancial year that began on 1 July 2014.\n•\nInfringement notices may be issued for certain contraventions\nof this Part."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-1-norm",
