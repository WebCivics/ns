        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58bs-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
