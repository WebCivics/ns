      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RECURSIVE",
      "cml:logicSummary": "The action service provider must maintain and handle CDR data for all time periods.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
