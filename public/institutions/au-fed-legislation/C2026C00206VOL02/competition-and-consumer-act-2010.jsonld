    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ca-ss-1",
      "@type": "cof:Section",
      "cof:title": "56CA(1) Granting accreditations",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(1) The CDR Accreditor may, in writing, accredit a person if the CDR\nAccreditor is satisfied that the person meets the criteria for\naccreditation specified in the consumer data rules."
    },
