      "@type": "cml:Concept",
      "skos:prefLabel": "56AU(2) Acts done by or in relation to agents etc. of CDR entities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56au-ss-2"
