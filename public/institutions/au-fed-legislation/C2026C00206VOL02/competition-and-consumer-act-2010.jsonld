        }
      ],
      "cml:integrityHash": "9a3c4a7f97566233c9a08158935955e3b8cee883f3c5ec91f2b03a46c75e5c7d",
      "skos:note": "Comply with administrative directions as an inspector."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fb-ss-3",
      "@type": "cof:Section",
