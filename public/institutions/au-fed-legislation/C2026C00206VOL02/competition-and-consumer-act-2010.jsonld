    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87t-ss-3",
      "@type": "cof:Section",
      "cof:title": "87T(3) Referring to earlier decisions on non-economic loss",
      "values:kind": "subsection",
      "cof:pageNumber": 388,
      "values:originalText": "(3) This section does not affect the rules for determination of other\ndamages or compensation.\n\nEnforcement and remedies  Chapter 5\nClaims for damages or compensation for death or personal injury  Part VIB\nLimits on personal injury damages for loss of earning capacity  Division 4\n\nSection 87U\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87t-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87t-ss-3"
      },
      "values:deonticStatus": {
