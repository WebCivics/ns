    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100d",
      "@type": "cml:Concept",
      "skos:prefLabel": "100D Further information and documents in relation to applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.522",
      "values:originalText": "(1) An applicant for review under this Division must give to the\nTribunal the information or documents that are determined under\nsubsection (2) in relation to the application for the purposes of this\nsubsection.\n\n(2) The Minister may, by legislative instrument, determine information\nor documents in relation to an application for the purposes of\nsubsection (1).\n\n(3) The applicant must give the information or documents:\n\n(a) when the applicant applies for the review; or\n\n(b) no later than 30 days after the applicant applies for review.\n\n(4) If the applicant does not give the information or documents to the\nTribunal by the end of those 30 days, the applicant is taken to\nwithdraw the application under subsection 100E(1) at the end of\nthose 30 days.",
      "skos:definition": "(1) An applicant for review under this Division must give to the\nTribunal the information or documents that are determined under\nsubsection (2) in relation to the application for the purposes of this\nsubsection.\n\n(2) The Minister may, by legislative instrument, determine information\nor documents in relation to an application for the purposes of\nsubsection (1).\n\n(3) The applicant must give the information or documents:\n\n(a) when the applicant applies for the review; or\n\n(b) no later than 30 days after the applicant applies for review.\n\n(4) If the applicant does not give the information or documents to the\nTribunal by the end of those 30 days, the applicant is taken to\nwithdraw the application under subsection 100E(1) at the end of\nthose 30 days.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100d-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100d-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100d-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100d-ss-4"
        }
      ],
      "cml:integrityHash": "df4f29e086c6696026c4edb7c117e68eb066885fc14de3ba8bb196dc263a5acc"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100d",
      "@type": "cof:Section",
      "cof:title": "100D Further information and documents in relation to applications",
      "values:kind": "section",
      "cof:pageNumber": 522,
      "values:originalText": "(1) An applicant for review under this Division must give to the\nTribunal the information or documents that are determined under\nsubsection (2) in relation to the application for the purposes of this\nsubsection.\n\n(2) The Minister may, by legislative instrument, determine information\nor documents in relation to an application for the purposes of\nsubsection (1).\n\n(3) The applicant must give the information or documents:\n\n(a) when the applicant applies for the review; or\n\n(b) no later than 30 days after the applicant applies for review.\n\n(4) If the applicant does not give the information or documents to the\nTribunal by the end of those 30 days, the applicant is taken to\nwithdraw the application under subsection 100E(1) at the end of\nthose 30 days."
    },
