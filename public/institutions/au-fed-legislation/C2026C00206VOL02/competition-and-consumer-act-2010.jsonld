    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Court must not award damages",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State bears the duty to prevent non-economic loss",
      "cml:conclusionText": "Damages cannot be awarded"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87p-ss-1-logic-alleninterval-2",
