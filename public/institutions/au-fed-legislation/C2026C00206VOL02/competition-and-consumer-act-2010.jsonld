    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "86(1A) Jurisdiction of courts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-86-ss-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.355",
      "values:originalText": "(1A) Jurisdiction is conferred on the Federal Circuit and Family Court of\nAustralia (Division 2) in any matter arising under section 46,\nPart IVB or IVBB, section 55B, subsection 56BO(1) or 56BU(1),\nsection 56BZA, 56BZB or 56BZC, subsection 56BZD(1),\nsection 56BZJ, Part IVE, a civil penalty provision of a gas market\n\nChapter 5  Enforcement and remedies",
      "skos:definition": "(1A) Jurisdiction is conferred on the Federal Circuit and Family Court of\nAustralia (Division 2) in any matter arising under section 46,\nPart IVB or IVBB, section 55B, subsection 56BO(1) or 56BU(1),\nsection 56BZA, 56BZB or 56BZC, subsection 56BZD(1),\nsection 56BZJ, Part IVE, a civil penalty provision of a gas market\n\nChapter 5  Enforcement and remedies",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-86"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-86-ss-1a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-86-ss-1a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1b1a7dd1b678c9214013de0d1aa94ef34aaf3c913ca3256d1f10e7968675eb32",
      "skos:note": "Jurisdiction is conferred on the Federal Circuit and Family Court of Australia (Division 2) in certain matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-86-ss-1a",
      "@type": "cof:Section",
      "cof:title": "86(1A) Jurisdiction of courts",
      "values:kind": "subsection",
      "cof:pageNumber": 355,
      "values:originalText": "(1A) Jurisdiction is conferred on the Federal Circuit and Family Court of\nAustralia (Division 2) in any matter arising under section 46,\nPart IVB or IVBB, section 55B, subsection 56BO(1) or 56BU(1),\nsection 56BZA, 56BZB or 56BZC, subsection 56BZD(1),\nsection 56BZJ, Part IVE, a civil penalty provision of a gas market\n\nChapter 5  Enforcement and remedies"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86-ss-1a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-86-ss-1a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasJurisdiction",
      "cml:logicSummary": "Establishes jurisdiction",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
