      "cml:logicSummary": "Cost savings estimates must be provided within 30 days after Royal Assent day.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
