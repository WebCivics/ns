    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95m",
      "@type": "cml:Concept",
      "skos:prefLabel": "95M Notice of extension of period for completing inquiry",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.478",
      "values:originalText": "If:\n\n(a) an inquiry is being held in relation to the supply of goods or\nservices of a particular description by a particular person or\npersons; and\n\n(b) the Minister extends, or further extends, the period within\nwhich the inquiry is required to be completed and a report on\nthe inquiry given to the Minister;\nthe inquiry body must, as soon as possible, give the person, or each\nof the persons, a notice in writing giving details of the extension or\nfurther extension.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPrice inquiries  Division 3\n\nSection 95N\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "If:\n\n(a) an inquiry is being held in relation to the supply of goods or\nservices of a particular description by a particular person or\npersons; and\n\n(b) the Minister extends, or further extends, the period within\nwhich the inquiry is required to be completed and a report on\nthe inquiry given to the Minister;\nthe inquiry body must, as soon as possible, give the person, or each\nof the persons, a notice in writing giving details of the extension or\nfurther extension.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPrice inquiries  Division 3\n\nSection 95N\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95m-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95m-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c1993fce0b2b4952b674227e40b8d84294109c7c74ba925760dc10a5d3140544",
      "skos:note": "Must provide notice of extension to person(s) involved in inquiry.",
      "dc:description": "Notice in writing"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95m",
      "@type": "cof:Section",
      "cof:title": "95M Notice of extension of period for completing inquiry",
      "values:kind": "section",
      "cof:pageNumber": 478,
      "values:originalText": "If:\n\n(a) an inquiry is being held in relation to the supply of goods or\nservices of a particular description by a particular person or\npersons; and\n\n(b) the Minister extends, or further extends, the period within\nwhich the inquiry is required to be completed and a report on\nthe inquiry given to the Minister;\nthe inquiry body must, as soon as possible, give the person, or each\nof the persons, a notice in writing giving details of the extension or\nfurther extension.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPrice inquiries  Division 3\n\nSection 95N\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95m-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-95m"
      },
