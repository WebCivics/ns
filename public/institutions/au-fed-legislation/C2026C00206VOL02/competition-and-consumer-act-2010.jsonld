      },
      "cml:premiseText": "scheme rules prescribe definitions and categories for vehicles",
      "cml:conclusionText": "vehicle is a scheme vehicle if it meets these criteria"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-57bb",
      "@type": "cml:Concept",
      "skos:prefLabel": "57BB Meaning of Australian repairer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57bb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.168",
      "values:originalText": "A person is an Australian repairer to the extent that the person\ncarries on or actively seeks to carry on, in Australia, a business that\ninvolves diagnosing faults with, servicing, repairing, modifying or\ndismantling scheme vehicles.\nNote:\nIn some State and Territory jurisdictions, a person may need to hold a\nlicence or particular qualifications to lawfully carry on such a\nbusiness.",
      "skos:definition": "A person is an Australian repairer to the extent that the person\ncarries on or actively seeks to carry on, in Australia, a business that\ninvolves diagnosing faults with, servicing, repairing, modifying or\ndismantling scheme vehicles.\nNote:\nIn some State and Territory jurisdictions, a person may need to hold a\nlicence or particular qualifications to lawfully carry on such a\nbusiness.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57bb-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57bb-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57bb-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57bb-logic-argumentation-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57bb-logic-diffusion-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-57bb-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "6e34b592b08cd921dc8d392764997c9cc7957099eff715f6a5eb3647ddbf756d",
      "skos:note": "A person is an Australian repairer if they carry on or actively seek to carry on a business involving diagnosing faults with, servicing, repairing, modifying or dismantling scheme vehicles."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-57bb",
      "@type": "cof:Section",
      "cof:title": "57BB Meaning of Australian repairer",
      "values:kind": "section",
      "cof:pageNumber": 168,
      "values:originalText": "A person is an Australian repairer to the extent that the person\ncarries on or actively seeks to carry on, in Australia, a business that\ninvolves diagnosing faults with, servicing, repairing, modifying or\ndismantling scheme vehicles.\nNote:\nIn some State and Territory jurisdictions, a person may need to hold a\nlicence or particular qualifications to lawfully carry on such a\nbusiness."
    },
