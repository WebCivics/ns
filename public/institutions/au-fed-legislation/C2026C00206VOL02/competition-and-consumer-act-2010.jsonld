    {
      "@id": "concept:competition-and-consumer-act-2010-sec-97",
      "@type": "cml:Concept",
      "skos:prefLabel": "97 Recommended prices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-97"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.515",
      "values:originalText": "For the purposes of paragraph 96(3)(b), the supplier is not to be\ntaken as inducing, or attempting to induce, a second person as\nmentioned in that paragraph in relation to any goods:\n\n(a) by reason only of a statement of a price being applied to the\ngoods as mentioned in paragraph 99(1)(a) or being applied to\na covering, label, reel or thing as mentioned in\nparagraph 99(1)(b), provided that the statement is preceded\nby the words “recommended price”; or\n\n(b) by reason only of his or her having given notification in\nwriting to the second person (not being a notification by way\nof a statement being applied as mentioned in paragraph (a))\nof the price that he or she recommends as appropriate for the\nsale of those goods, provided that there is included in the\nnotification, and in each writing that refers, whether\nexpressly or by implication, to the notification, a statement to\nthe following effect:\n\n“The price set out or referred to herein is a recommended\nprice only and there is no obligation to comply with the\nrecommendation.”.",
      "skos:definition": "For the purposes of paragraph 96(3)(b), the supplier is not to be\ntaken as inducing, or attempting to induce, a second person as\nmentioned in that paragraph in relation to any goods:\n\n(a) by reason only of a statement of a price being applied to the\ngoods as mentioned in paragraph 99(1)(a) or being applied to\na covering, label, reel or thing as mentioned in\nparagraph 99(1)(b), provided that the statement is preceded\nby the words “recommended price”; or\n\n(b) by reason only of his or her having given notification in\nwriting to the second person (not being a notification by way\nof a statement being applied as mentioned in paragraph (a))\nof the price that he or she recommends as appropriate for the\nsale of those goods, provided that there is included in the\nnotification, and in each writing that refers, whether\nexpressly or by implication, to the notification, a statement to\nthe following effect:\n\n“The price set out or referred to herein is a recommended\nprice only and there is no obligation to comply with the\nrecommendation.”.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-97-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-97-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bbf54cf3a807e76de73f01d4ba08b6db5967ed90da02ee111f76867c89229c3e",
      "skos:note": "Supplier cannot induce or attempt to induce a second person in relation to goods"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-97",
      "@type": "cof:Section",
      "cof:title": "97 Recommended prices",
      "values:kind": "section",
      "cof:pageNumber": 515,
      "values:originalText": "For the purposes of paragraph 96(3)(b), the supplier is not to be\ntaken as inducing, or attempting to induce, a second person as\nmentioned in that paragraph in relation to any goods:\n\n(a) by reason only of a statement of a price being applied to the\ngoods as mentioned in paragraph 99(1)(a) or being applied to\na covering, label, reel or thing as mentioned in\nparagraph 99(1)(b), provided that the statement is preceded\nby the words “recommended price”; or\n\n(b) by reason only of his or her having given notification in\nwriting to the second person (not being a notification by way\nof a statement being applied as mentioned in paragraph (a))\nof the price that he or she recommends as appropriate for the\nsale of those goods, provided that there is included in the\nnotification, and in each writing that refers, whether\nexpressly or by implication, to the notification, a statement to\nthe following effect:\n\n“The price set out or referred to herein is a recommended\nprice only and there is no obligation to comply with the\nrecommendation.”."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-97-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-97"
      },
