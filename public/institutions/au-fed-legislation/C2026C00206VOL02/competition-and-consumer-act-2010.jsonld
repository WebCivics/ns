    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fk-ss-3",
      "@type": "cof:Section",
      "cof:title": "58FK(3) Maximum penalty for tier 1 contraventions",
      "values:kind": "subsection",
      "cof:pageNumber": 257,
      "values:originalText": "(3) For the purposes of subsection (1), the maximum penalty amount\nfor such a contravention by a person other than a body corporate is\n7,990 penalty units."
    },
