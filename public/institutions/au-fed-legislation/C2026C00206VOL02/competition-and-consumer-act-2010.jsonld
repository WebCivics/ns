    {
      "@id": "concept:competition-and-consumer-act-2010-sec-86d-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits making an adverse publicity order",
