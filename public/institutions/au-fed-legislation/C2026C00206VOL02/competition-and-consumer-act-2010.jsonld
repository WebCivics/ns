      "cml:integrityHash": "d9306e92e32e21a4c9f6f93797966d6fcff369861c34548aebed98dfb0a1a3fb",
      "skos:note": "Person is not an SPF consumer if a condition applies to them."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58ah-ss-4",
      "@type": "cof:Section",
      "cof:title": "58AH(4) Meaning of SPF consumer",
      "values:kind": "subsection",
      "cof:pageNumber": 202,
      "values:originalText": "(4) However, the person is not an SPF consumer of the regulated\nservice if a condition prescribed by the SPF rules applies to the\nperson in relation to regulated services of that kind."
    },
