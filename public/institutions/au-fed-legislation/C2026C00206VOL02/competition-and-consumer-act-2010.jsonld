    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60fb",
      "@type": "cml:Concept",
      "skos:prefLabel": "60FB Extending periods for complying with carbon tax removal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60fb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.301",
      "values:originalText": "substantiation notices\n\n(1) An entity that has been given a carbon tax removal substantiation\nnotice may, at any time within 14 days after the notice was given to\nthe entity by the Commission, apply in writing to the Commission\nfor an extension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the entity, extend\nthe period within which the entity must comply with the notice, so\nlong as the extension is for a period of not more than 28 days.",
      "skos:definition": "substantiation notices\n\n(1) An entity that has been given a carbon tax removal substantiation\nnotice may, at any time within 14 days after the notice was given to\nthe entity by the Commission, apply in writing to the Commission\nfor an extension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the entity, extend\nthe period within which the entity must comply with the notice, so\nlong as the extension is for a period of not more than 28 days.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60fb-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60fb-ss-2"
        }
      ],
      "cml:integrityHash": "565215fb3859d5c27292188b81644f06e691a3d002c55f925790c158d9e8df74"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60fb",
      "@type": "cof:Section",
      "cof:title": "60FB Extending periods for complying with carbon tax removal",
      "values:kind": "section",
      "cof:pageNumber": 301,
      "values:originalText": "substantiation notices\n\n(1) An entity that has been given a carbon tax removal substantiation\nnotice may, at any time within 14 days after the notice was given to\nthe entity by the Commission, apply in writing to the Commission\nfor an extension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the entity, extend\nthe period within which the entity must comply with the notice, so\nlong as the extension is for a period of not more than 28 days."
    },
