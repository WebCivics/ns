    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ek-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EK(2) Privacy safeguard 8—overseas disclosure of CDR data by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ek-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.122",
      "values:originalText": "(2) If:\n\n(a) the accredited data recipient of the CDR data makes the\ndisclosure to the new recipient; and\n\n(b) none of paragraphs (1)(c), (e) and (f) apply in relation to the\ndisclosure to the new recipient; and\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "skos:definition": "(2) If:\n\n(a) the accredited data recipient of the CDR data makes the\ndisclosure to the new recipient; and\n\n(b) none of paragraphs (1)(c), (e) and (f) apply in relation to the\ndisclosure to the new recipient; and\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-56ek"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ek-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56ek-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a645c99b90587645ffa8d71492767789837849758be91e8d9f5d544fbfccecd8",
      "skos:note": "Disclosure of CDR data to new recipient is allowed under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ek-ss-2",
      "@type": "cof:Section",
      "cof:title": "56EK(2) Privacy safeguard 8—overseas disclosure of CDR data by",
      "values:kind": "subsection",
      "cof:pageNumber": 122,
      "values:originalText": "(2) If:\n\n(a) the accredited data recipient of the CDR data makes the\ndisclosure to the new recipient; and\n\n(b) none of paragraphs (1)(c), (e) and (f) apply in relation to the\ndisclosure to the new recipient; and\n\nChapter 4  Provisions relating to particular industries, payment surcharges etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ek-ss-2-norm",
      "@type": "values:Permission",
      "cml:modality": {
