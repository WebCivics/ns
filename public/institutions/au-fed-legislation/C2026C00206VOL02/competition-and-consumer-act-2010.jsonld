        }
      ],
      "cml:integrityHash": "51ce340c58d52867390b6ee3c4d7d8147354f8a4192287f21001612fa47f9b55",
      "skos:note": "Definition of Australian Statistician"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87n-ss-4",
