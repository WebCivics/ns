    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s",
      "@type": "cml:Concept",
      "skos:prefLabel": "87S Cases of less than 15% of a most extreme case",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.388",
      "values:originalText": "If the non-economic loss the plaintiff suffers is less than 15% of a\nmost extreme case, the court must not award personal injury\ndamages for non-economic loss.",
      "skos:definition": "If the non-economic loss the plaintiff suffers is less than 15% of a\nmost extreme case, the court must not award personal injury\ndamages for non-economic loss.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87s-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-ltl-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-diffusion-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "5ff8f9000f698b68457917097b1fddb240f4590c608467e3fbb1a9c0b081c668",
      "skos:note": "Court must not award personal injury damages for non-economic loss if the plaintiff suffers less than 15% of a most extreme case."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87s",
      "@type": "cof:Section",
      "cof:title": "87S Cases of less than 15% of a most extreme case",
      "values:kind": "section",
      "cof:pageNumber": 388,
      "values:originalText": "If the non-economic loss the plaintiff suffers is less than 15% of a\nmost extreme case, the court must not award personal injury\ndamages for non-economic loss."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-87s"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Court must not award personal injury damages.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Plaintiff suffers less than 15% of a most extreme case.",
      "cml:conclusionText": "No personal injury damages for non-economic loss."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Temporal intervals overlap.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Plaintiff suffers non-economic loss before or after the most extreme case.",
      "cml:conclusionText": "No personal injury damages for non-economic loss during this time."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Tracing of events.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Plaintiff suffers less than 15% of a most extreme case repeatedly.",
      "cml:conclusionText": "No personal injury damages for non-economic loss in these cases."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Information spreads.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Plaintiff suffers less than 15% of a most extreme case widely.",
      "cml:conclusionText": "No personal injury damages for non-economic loss in these cases."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87s-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognize",
      "cml:logicSummary": "Artificial intelligence recognizes.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Plaintiff suffers less than 15% of a most extreme case.",
      "cml:conclusionText": "No personal injury damages for non-economic loss in this case."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-87t",
      "@type": "cml:Concept",
      "skos:prefLabel": "87T Referring to earlier decisions on non-economic loss",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-87t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.388",
      "values:originalText": "(1) In determining personal injury damages for non-economic loss, the\ncourt may refer to earlier decisions of the court or of other courts\nfor the purpose of establishing the appropriate award in the\nproceeding.\n\n(2) For that purpose, the parties to the proceeding or their counsel may\nbring the court’s attention to awards of personal injury damages for\nnon-economic loss in those earlier decisions.\n\n(3) This section does not affect the rules for determination of other\ndamages or compensation.\n\nEnforcement and remedies  Chapter 5\nClaims for damages or compensation for death or personal injury  Part VIB\nLimits on personal injury damages for loss of earning capacity  Division 4\n\nSection 87U\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) In determining personal injury damages for non-economic loss, the\ncourt may refer to earlier decisions of the court or of other courts\nfor the purpose of establishing the appropriate award in the\nproceeding.\n\n(2) For that purpose, the parties to the proceeding or their counsel may\nbring the court’s attention to awards of personal injury damages for\nnon-economic loss in those earlier decisions.\n\n(3) This section does not affect the rules for determination of other\ndamages or compensation.\n\nEnforcement and remedies  Chapter 5\nClaims for damages or compensation for death or personal injury  Part VIB\nLimits on personal injury damages for loss of earning capacity  Division 4\n\nSection 87U\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
