    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95q",
      "@type": "cml:Concept",
      "skos:prefLabel": "95Q Notification of proposed prices after receipt of report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.482",
      "values:originalText": "(1) This section applies if a person receives a copy of a report on an\ninquiry held in relation to the supply by the person of goods or\nservices of a particular description.\nPrice notification\n\n(2) The person must, within 14 days after receiving the copy, give the\nCommission a notice in writing specifying the price or prices at\nwhich the person is supplying, or proposing to supply, goods or\nservices of that description.\nOffence\n\n(3) A person commits an offence if the person contravenes\nsubsection (2).\nPenalty: 10 penalty units.\nPublic notification\n\n(4) The Commission must, within 14 days after it receives the notice\nunder subsection (2), make publicly available details of the price or\nprices specified in the notice.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPrice inquiries  Division 3\n\nSection 95R\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nSubdivision C—Procedure at inquiries",
      "skos:definition": "(1) This section applies if a person receives a copy of a report on an\ninquiry held in relation to the supply by the person of goods or\nservices of a particular description.\nPrice notification\n\n(2) The person must, within 14 days after receiving the copy, give the\nCommission a notice in writing specifying the price or prices at\nwhich the person is supplying, or proposing to supply, goods or\nservices of that description.\nOffence\n\n(3) A person commits an offence if the person contravenes\nsubsection (2).\nPenalty: 10 penalty units.\nPublic notification\n\n(4) The Commission must, within 14 days after it receives the notice\nunder subsection (2), make publicly available details of the price or\nprices specified in the notice.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPrice inquiries  Division 3\n\nSection 95R\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nSubdivision C—Procedure at inquiries",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95q-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95q-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95q-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95q-ss-4"
        }
      ],
      "cml:integrityHash": "261e61b9a1b089f085f8ec80fedcca2a6dc3f6d68ea88b37de025e633c073e86"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95q",
      "@type": "cof:Section",
      "cof:title": "95Q Notification of proposed prices after receipt of report",
      "values:kind": "section",
      "cof:pageNumber": 482,
      "values:originalText": "(1) This section applies if a person receives a copy of a report on an\ninquiry held in relation to the supply by the person of goods or\nservices of a particular description.\nPrice notification\n\n(2) The person must, within 14 days after receiving the copy, give the\nCommission a notice in writing specifying the price or prices at\nwhich the person is supplying, or proposing to supply, goods or\nservices of that description.\nOffence\n\n(3) A person commits an offence if the person contravenes\nsubsection (2).\nPenalty: 10 penalty units.\nPublic notification\n\n(4) The Commission must, within 14 days after it receives the notice\nunder subsection (2), make publicly available details of the price or\nprices specified in the notice.\n\nOther provisions  Chapter 6\nPrices surveillance  Part VIIA\nPrice inquiries  Division 3\n\nSection 95R\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nSubdivision C—Procedure at inquiries"
    },
