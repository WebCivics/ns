    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95b-ss-2",
      "@type": "cof:Section",
      "cof:title": "95B(2) Exempt supplies",
      "values:kind": "subsection",
      "cof:pageNumber": 470,
      "values:originalText": "(2) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under subsection (1)."
    },
