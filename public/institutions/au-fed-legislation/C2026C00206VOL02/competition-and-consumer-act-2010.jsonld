    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56cf",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CF Evidentiary value of the register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56cf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.103",
      "values:originalText": "(1) The register is admissible in any proceedings as prima facie\nevidence of the matters in it.\n\n(2) The Accreditation Registrar may issue a document containing the\ndetails of a matter taken from the register.\n\n(3) The document issued under subsection (2) is admissible in any\nproceedings as prima facie evidence of the matter.\nSubdivision C—CDR Accreditor",
      "skos:definition": "(1) The register is admissible in any proceedings as prima facie\nevidence of the matters in it.\n\n(2) The Accreditation Registrar may issue a document containing the\ndetails of a matter taken from the register.\n\n(3) The document issued under subsection (2) is admissible in any\nproceedings as prima facie evidence of the matter.\nSubdivision C—CDR Accreditor",
      "cml:hasPart": [
