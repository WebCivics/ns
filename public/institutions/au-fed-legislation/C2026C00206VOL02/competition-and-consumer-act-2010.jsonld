        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95t-ss-2-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "cf371c4799aaa57f00ea35ed1bd0ba19e5b789c3d2ead2efeba874185fe2da7f",
      "skos:note": "Defendant bears evidential burden for reasonable excuse"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95t-ss-2",
      "@type": "cof:Section",
      "cof:title": "95T(2) Failure of witness to attend",
      "values:kind": "subsection",
      "cof:pageNumber": 485,
      "values:originalText": "(2) Subsection (1) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code)."
    },
