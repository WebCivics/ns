      "dc:source": "competition-and-consumer-act-2010.pdf, p.418",
      "values:originalText": "(1) A person to whom an authorisation was granted, or another person\non behalf of such a person, may apply to the Commission for a\nrevocation of the authorisation.",
      "skos:definition": "(1) A person to whom an authorisation was granted, or another person\non behalf of such a person, may apply to the Commission for a\nrevocation of the authorisation.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-91b"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-1-norm"
        }
      ],
      "cml:integrityHash": "4cf8745fdd3bfd28fea5acd8b68598976bd28bf056ee7264d8588ec4f6f29555",
      "skos:note": "Application for revocation of authorisation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-91b-ss-1",
      "@type": "cof:Section",
      "cof:title": "91B(1) Revocation of an authorisation",
      "values:kind": "subsection",
      "cof:pageNumber": 418,
      "values:originalText": "(1) A person to whom an authorisation was granted, or another person\non behalf of such a person, may apply to the Commission for a\nrevocation of the authorisation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-91b-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
