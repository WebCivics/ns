    {
      "@id": "concept:competition-and-consumer-act-2010-sec-55d",
      "@type": "cml:Concept",
      "skos:prefLabel": "55D Extending periods for complying with notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.30",
      "values:originalText": "(1) A surcharge participant that has been given a notice under\nsection 55C may, at any time within 21 days after the notice was\ngiven to the participant, apply in writing to the Commission for an\nextension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the surcharge\nparticipant, extend the period within which the participant must\ncomply with the notice.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nPayment surcharges  Part IVC\nInformation about payment surcharges  Division 3\n\nSection 55E\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) A surcharge participant that has been given a notice under\nsection 55C may, at any time within 21 days after the notice was\ngiven to the participant, apply in writing to the Commission for an\nextension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the surcharge\nparticipant, extend the period within which the participant must\ncomply with the notice.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nPayment surcharges  Part IVC\nInformation about payment surcharges  Division 3\n\nSection 55E\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55d-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-55d-ss-2"
        }
      ],
      "cml:integrityHash": "f1805c4a335050e404234496d72958df9f3e68a04b8915624c520e28ab07c5b6"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-55d",
      "@type": "cof:Section",
      "cof:title": "55D Extending periods for complying with notices",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "(1) A surcharge participant that has been given a notice under\nsection 55C may, at any time within 21 days after the notice was\ngiven to the participant, apply in writing to the Commission for an\nextension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the surcharge\nparticipant, extend the period within which the participant must\ncomply with the notice.\n\nProvisions relating to particular industries, payment surcharges etc.  Chapter 4\nPayment surcharges  Part IVC\nInformation about payment surcharges  Division 3\n\nSection 55E\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
