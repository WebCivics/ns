    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56fo-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "56FO(1) Leave",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56fo-ss-1"
