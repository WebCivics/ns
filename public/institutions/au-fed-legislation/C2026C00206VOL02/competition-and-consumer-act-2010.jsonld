      },
      "cml:operator": "consider",
      "cml:logicSummary": "Consideration of public benefit and detriment",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
