      "skos:note": "There is an obligation to have a Data Standards Chair."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56ff",
      "@type": "cof:Section",
      "cof:title": "56FF Data Standards Chair",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "There is to be a Data Standards Chair."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56ff-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
