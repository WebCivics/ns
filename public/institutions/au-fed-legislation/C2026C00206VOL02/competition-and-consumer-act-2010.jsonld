    {
      "@id": "concept:competition-and-consumer-act-2010-sec-60d-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "60D(3) Notice to entity that is considered to have engaged in price",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60d-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.297",
      "values:originalText": "(3) In any proceedings:\n\n(aa) under section 60CA; or\n\n(a) under section 76 for a pecuniary penalty order relating to\nsection 60C; or\n\n(b) under section 80 for an injunction relating to section 60C; or\n\n(c) under section 80A, 82, 86C, 86D or 87 for an order relating\nto section 60C;\nthe notice is prima facie evidence that the price for the supply did\nnot pass through all of the entity’s cost savings relating to the\nsupply that were directly or indirectly attributable to the carbon tax\nrepeal.",
      "skos:definition": "(3) In any proceedings:\n\n(aa) under section 60CA; or\n\n(a) under section 76 for a pecuniary penalty order relating to\nsection 60C; or\n\n(b) under section 80 for an injunction relating to section 60C; or\n\n(c) under section 80A, 82, 86C, 86D or 87 for an order relating\nto section 60C;\nthe notice is prima facie evidence that the price for the supply did\nnot pass through all of the entity’s cost savings relating to the\nsupply that were directly or indirectly attributable to the carbon tax\nrepeal.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-60d"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60d-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-60d-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6eae73058cec9d144203d5e61dfa668bddf967163c5989615b596d8baa2762f5",
      "skos:note": "Notice is prima facie evidence that the price for the supply did not pass through all of the entity’s cost savings relating to the supply that were directly or indirectly attributable to the carbon tax repeal."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-60d-ss-3",
      "@type": "cof:Section",
      "cof:title": "60D(3) Notice to entity that is considered to have engaged in price",
      "values:kind": "subsection",
      "cof:pageNumber": 297,
      "values:originalText": "(3) In any proceedings:\n\n(aa) under section 60CA; or\n\n(a) under section 76 for a pecuniary penalty order relating to\nsection 60C; or\n\n(b) under section 80 for an injunction relating to section 60C; or\n\n(c) under section 80A, 82, 86C, 86D or 87 for an order relating\nto section 60C;\nthe notice is prima facie evidence that the price for the supply did\nnot pass through all of the entity’s cost savings relating to the\nsupply that were directly or indirectly attributable to the carbon tax\nrepeal."
    },
