    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58fy",
      "@type": "cml:Concept",
      "skos:prefLabel": "58FY Interim injunctions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fy"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.267",
      "values:originalText": "The Court may, if in the opinion of the Court it is desirable to do\nso, grant an interim injunction pending determination of an\napplication for an injunction under section 58FW.",
      "skos:definition": "The Court may, if in the opinion of the Court it is desirable to do\nso, grant an interim injunction pending determination of an\napplication for an injunction under section 58FW.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58fy-norm"
        }
      ],
      "cml:integrityHash": "58b1983126913101f551e386f899e2be225c1bd4626e6c4ce03ef0fb48e53a27",
      "skos:note": "Granting of interim injunctions"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58fy",
      "@type": "cof:Section",
      "cof:title": "58FY Interim injunctions",
      "values:kind": "section",
      "cof:pageNumber": 267,
      "values:originalText": "The Court may, if in the opinion of the Court it is desirable to do\nso, grant an interim injunction pending determination of an\napplication for an injunction under section 58FW."
    },
