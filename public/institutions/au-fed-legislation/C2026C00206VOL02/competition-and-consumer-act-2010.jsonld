    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58eh",
      "@type": "cml:Concept",
      "skos:prefLabel": "58EH Regard must be had to the object of this Part when",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58eh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.244",
      "values:originalText": "considering whether to make such a disclosure\n\nAn SPF regulator must have regard to the object of this Part when\ndeciding whether to make a disclosure under this Subdivision.\nNote:\nArrangements made under section 58EF between SPF regulators could\ndeal with when disclosures should be made (see subsection 58EF(3) in\nparticular).",
      "skos:definition": "considering whether to make such a disclosure\n\nAn SPF regulator must have regard to the object of this Part when\ndeciding whether to make a disclosure under this Subdivision.\nNote:\nArrangements made under section 58EF between SPF regulators could\ndeal with when disclosures should be made (see subsection 58EF(3) in\nparticular).",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58eh-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58eh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c9936de251bcffd4cdb5cac91e9f58affdbd2d0b0ce9c3227ed6ae106c54e47",
      "skos:note": "Must consider object of Part when deciding to make disclosure"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58eh",
      "@type": "cof:Section",
      "cof:title": "58EH Regard must be had to the object of this Part when",
      "values:kind": "section",
      "cof:pageNumber": 244,
      "values:originalText": "considering whether to make such a disclosure\n\nAn SPF regulator must have regard to the object of this Part when\ndeciding whether to make a disclosure under this Subdivision.\nNote:\nArrangements made under section 58EF between SPF regulators could\ndeal with when disclosures should be made (see subsection 58EF(3) in\nparticular)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58eh-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58eh"
      },
      "values:deonticStatus": {
