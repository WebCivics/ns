    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-96a-ss-2",
      "@type": "cof:Section",
      "cof:title": "96A(2) Resale price maintenance in relation to services",
      "values:kind": "subsection",
