      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-82-ss-6",
      "@type": "cof:Section",
      "cof:title": "82(6) Actions for damages",
      "values:kind": "subsection",
      "cof:pageNumber": 350,
      "values:originalText": "(6) The court may satisfy itself of the matters in subsection (5) by\nhaving regard only to the documents filed with the court in the\nproceedings."
    },
