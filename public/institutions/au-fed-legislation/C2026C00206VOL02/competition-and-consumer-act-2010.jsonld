      "cml:logicSummary": "Council must provide evidence of effective supervision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The Council must also not recommend a declaration of a State or Territory authority..."
    },
    {
