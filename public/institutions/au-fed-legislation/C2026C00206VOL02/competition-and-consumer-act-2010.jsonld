      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58da",
      "@type": "cml:Concept",
      "skos:prefLabel": "58DA Simplified outline of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58da"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.234",
      "values:originalText": "One or more external dispute resolution schemes may be\nauthorised for dealing with consumer complaints about scams\nrelating to, connected with, or using regulated services.\nAn existing scheme like the AFCA scheme could be authorised for\nthis purpose, or new schemes could be developed and authorised.",
      "skos:definition": "One or more external dispute resolution schemes may be\nauthorised for dealing with consumer complaints about scams\nrelating to, connected with, or using regulated services.\nAn existing scheme like the AFCA scheme could be authorised for\nthis purpose, or new schemes could be developed and authorised.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58da-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-58da-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "077e93a17b7e801a5771d5f380efdb448ab08ac9a642cf56bc9ad2f1f1de24c6",
      "skos:note": "Authorise external dispute resolution schemes for consumer complaints about scams."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-58da",
      "@type": "cof:Section",
      "cof:title": "58DA Simplified outline of this Division",
      "values:kind": "section",
      "cof:pageNumber": 234,
      "values:originalText": "One or more external dispute resolution schemes may be\nauthorised for dealing with consumer complaints about scams\nrelating to, connected with, or using regulated services.\nAn existing scheme like the AFCA scheme could be authorised for\nthis purpose, or new schemes could be developed and authorised."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-58da-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-58da"
