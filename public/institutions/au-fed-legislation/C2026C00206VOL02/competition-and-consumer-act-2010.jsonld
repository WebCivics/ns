    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits supplying goods or services on particular terms and conditions before the applicable day.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The person commits an offence if:\n\n(a) before the applicable day in relation to the business notice,\nthe person supplies (the current supply) goods or services of\nthat description in a locality on particular terms and conditions; and",
      "cml:conclusionText": "The person must not supply goods or services on particular terms and conditions before the applicable day."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Describes the temporal relation between supplying goods or services before the applicable day and committing an offence.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The person commits an offence if:\n\n(a) before the applicable day in relation to the business notice,\nthe person supplies (the current supply) goods or services of\nthat description in a locality on particular terms and conditions; and",
      "cml:conclusionText": "The supplying of goods or services before the applicable day is during the committing of an offence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Describes the temporal relation between supplying goods or services on particular terms and conditions after the applicable day and committing an offence.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The person commits an offence if:\n\n(a) before the applicable day in relation to the business notice,\nthe person supplies (the current supply) goods or services of\nthat description in a locality on particular terms and conditions; and",
      "cml:conclusionText": "The supplying of goods or services on particular terms and conditions after the applicable day is until the committing of an offence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if",
      "cml:logicSummary": "Describes the condition under which supplying goods or services before the applicable day leads to committing an offence.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The person commits an offence if:\n\n(a) before the applicable day in relation to the business notice,\nthe person supplies (the current supply) goods or services of\nthat description in a locality on particular terms and conditions; and",
      "cml:conclusionText": "The supplying of goods or services before the applicable day is if the person commits an offence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95n-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "hasPart",
      "cml:logicSummary": "Describes the relation between supplying goods or services of a particular description in a locality on particular terms and conditions and having a business notice.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The person commits an offence if:\n\n(a) before the applicable day in relation to the business notice,\nthe person supplies (the current supply) goods or services of\nthat description in a locality on particular terms and conditions; and",
      "cml:conclusionText": "The supplying of goods or services of that description in that locality on particular terms and conditions is part of having a business notice."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95p",
      "@type": "cml:Concept",
      "skos:prefLabel": "95P Copies of report to be made available",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95p"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.481",
      "values:originalText": "Inquiry into supply of goods or services by particular persons\n\n(1) For an inquiry held in relation to the supply of goods or services by\na particular person or persons, the inquiry body must send the\nperson, or each of the persons, a copy of the report on the inquiry\non the day on which it gives the Minister the report.\n\n(2) A copy of a report sent to a person must be accompanied by a\nnotice in writing setting out the effect of section 95Q.\n\nChapter 6  Other provisions",
      "skos:definition": "Inquiry into supply of goods or services by particular persons\n\n(1) For an inquiry held in relation to the supply of goods or services by\na particular person or persons, the inquiry body must send the\nperson, or each of the persons, a copy of the report on the inquiry\non the day on which it gives the Minister the report.\n\n(2) A copy of a report sent to a person must be accompanied by a\nnotice in writing setting out the effect of section 95Q.\n\nChapter 6  Other provisions",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95p-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-95p-ss-2"
        }
      ],
      "cml:integrityHash": "b5f88c0ad334ec95621cc3e0033026145c8f862eeb77b816817f4b36942c29ce"
    },
