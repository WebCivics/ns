      "skos:note": "Minister or Commission may vary or revoke a declaration."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-95x-ss-5",
      "@type": "cof:Section",
      "cof:title": "95X(5) Declarations by Minister or Commission",
      "values:kind": "subsection",
      "cof:pageNumber": 488,
      "values:originalText": "(5) The Minister, or the Commission with the approval of the Minister,\nmay by notice published in the Gazette vary or revoke a\ndeclaration under this section."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-95x-ss-5-norm",
      "@type": "values:Permission",
