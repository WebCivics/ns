    {
      "@id": "concept:competition-and-consumer-act-2010-sec-101a",
      "@type": "cml:Concept",
      "skos:prefLabel": "101A Application for review of notices under Division 2 of Part VII",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-101a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.533",
      "values:originalText": "A person dissatisfied with the giving of a notice by the\nCommission under subsection 93(3), (3A) or (3B), 93AAA(1),\n93AC(1), (2) or (2A), 93ACA(1), 93AD(5) or 93AG(7) may, as\nprescribed and within the time allowed by or under the regulations,\napply to the Tribunal for a review of the giving of the notice and, if\nthe person was the person to whom the notice was given or the\nTribunal is satisfied that the person has a sufficient interest, the\nTribunal shall review the giving of the notice.",
      "skos:definition": "A person dissatisfied with the giving of a notice by the\nCommission under subsection 93(3), (3A) or (3B), 93AAA(1),\n93AC(1), (2) or (2A), 93ACA(1), 93AD(5) or 93AG(7) may, as\nprescribed and within the time allowed by or under the regulations,\napply to the Tribunal for a review of the giving of the notice and, if\nthe person was the person to whom the notice was given or the\nTribunal is satisfied that the person has a sufficient interest, the\nTribunal shall review the giving of the notice.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-101a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-101a-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-101a-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "0555a553228a64d6f0dae77e41654941dd616fffb90956dd9fdbbce35f7b3991",
      "skos:note": "A person may apply for a review of a notice within the time allowed by or under regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-101a",
      "@type": "cof:Section",
      "cof:title": "101A Application for review of notices under Division 2 of Part VII",
      "values:kind": "section",
      "cof:pageNumber": 533,
      "values:originalText": "A person dissatisfied with the giving of a notice by the\nCommission under subsection 93(3), (3A) or (3B), 93AAA(1),\n93AC(1), (2) or (2A), 93ACA(1), 93AD(5) or 93AG(7) may, as\nprescribed and within the time allowed by or under the regulations,\napply to the Tribunal for a review of the giving of the notice and, if\nthe person was the person to whom the notice was given or the\nTribunal is satisfied that the person has a sufficient interest, the\nTribunal shall review the giving of the notice."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-101a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
