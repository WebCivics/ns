    {
      "@id": "concept:competition-and-consumer-act-2010-sec-56an",
      "@type": "cml:Concept",
      "skos:prefLabel": "56AN Extension to external Territories",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56an"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.54",
      "values:originalText": "Each of the following provisions (the CDR provisions) extends to\nevery external Territory:\n\n(a) a provision of this Part;\n\n(b) a provision of the regulations made for the purposes of a\nprovision of this Part;\n\n(c) a provision of the consumer data rules;\n\n(ca) a provision of any other instrument made under this Part;\n\n(d) another provision of this Act to the extent that it relates to a\nprovision covered by paragraph (a), (b), (c) or (ca);\n\n(e) a provision of the Regulatory Powers Act to the extent that it\napplies in relation to a provision of this Part;\n\n(f) a provision of the Privacy Act 1988 to the extent that it\napplies as described in section 56ES or 56ET of this Act.",
      "skos:definition": "Each of the following provisions (the CDR provisions) extends to\nevery external Territory:\n\n(a) a provision of this Part;\n\n(b) a provision of the regulations made for the purposes of a\nprovision of this Part;\n\n(c) a provision of the consumer data rules;\n\n(ca) a provision of any other instrument made under this Part;\n\n(d) another provision of this Act to the extent that it relates to a\nprovision covered by paragraph (a), (b), (c) or (ca);\n\n(e) a provision of the Regulatory Powers Act to the extent that it\napplies in relation to a provision of this Part;\n\n(f) a provision of the Privacy Act 1988 to the extent that it\napplies as described in section 56ES or 56ET of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56an-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-56an-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fbba9c12d8d3c65a1595daabbf9099e81f57d3267feac7e930b119ee10505aa3",
      "skos:note": "Extends provisions of this Part and other Acts to external Territories"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-56an",
      "@type": "cof:Section",
      "cof:title": "56AN Extension to external Territories",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Each of the following provisions (the CDR provisions) extends to\nevery external Territory:\n\n(a) a provision of this Part;\n\n(b) a provision of the regulations made for the purposes of a\nprovision of this Part;\n\n(c) a provision of the consumer data rules;\n\n(ca) a provision of any other instrument made under this Part;\n\n(d) another provision of this Act to the extent that it relates to a\nprovision covered by paragraph (a), (b), (c) or (ca);\n\n(e) a provision of the Regulatory Powers Act to the extent that it\napplies in relation to a provision of this Part;\n\n(f) a provision of the Privacy Act 1988 to the extent that it\napplies as described in section 56ES or 56ET of this Act."
    },
