    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100q",
      "@type": "cml:Concept",
      "skos:prefLabel": "100Q Technical experts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.528",
      "values:originalText": "For the purposes of a review under this Division, the Tribunal:\n\n(a) may, in such manner as it sees fit:\n\n(i) ask questions of a technical expert; or\n\n(ii) seek information, documents or evidence from a\ntechnical expert; and\n\n(b) if it does so:\n\n(i) may allow a participant in the proceedings or the\nCommission to ask questions of the technical expert\nbefore the Tribunal; and\n\n(ii) may have regard to any information furnished,\ndocuments produced or evidence given to the Tribunal\nby the expert.",
      "skos:definition": "For the purposes of a review under this Division, the Tribunal:\n\n(a) may, in such manner as it sees fit:\n\n(i) ask questions of a technical expert; or\n\n(ii) seek information, documents or evidence from a\ntechnical expert; and\n\n(b) if it does so:\n\n(i) may allow a participant in the proceedings or the\nCommission to ask questions of the technical expert\nbefore the Tribunal; and\n\n(ii) may have regard to any information furnished,\ndocuments produced or evidence given to the Tribunal\nby the expert.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100q-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-100q-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0991b3dc90eb38d839f915847bddee9e4bcb84e186666bb5af6d9dde37c1c229",
      "skos:note": "The Tribunal may ask questions of a technical expert or seek information, documents or evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-100q",
      "@type": "cof:Section",
      "cof:title": "100Q Technical experts",
      "values:kind": "section",
      "cof:pageNumber": 528,
      "values:originalText": "For the purposes of a review under this Division, the Tribunal:\n\n(a) may, in such manner as it sees fit:\n\n(i) ask questions of a technical expert; or\n\n(ii) seek information, documents or evidence from a\ntechnical expert; and\n\n(b) if it does so:\n\n(i) may allow a participant in the proceedings or the\nCommission to ask questions of the technical expert\nbefore the Tribunal; and\n\n(ii) may have regard to any information furnished,\ndocuments produced or evidence given to the Tribunal\nby the expert."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-100q-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
