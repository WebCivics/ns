concept:competition-and-consumer-act-2010-sec-132j-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-alleninterval-2 .
concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlap" ;
    cml:logicSummary "Requires overlap between the time of danger and the provision of product-related services." ;
    cml:premiseText "(2) If it appears to the Commonwealth Minister..." ;
    cml:conclusionText "The interim ban should be imposed without delay during the period when product-related services pose an imminent risk of death, serious illness or serious injury." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-132j-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-ltl-3 .
concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Requires recurring trace of danger and provision of product-related services." ;
    cml:premiseText "(2) If it appears to the Commonwealth Minister..." ;
    cml:conclusionText "The interim ban should be imposed without delay during periods when product-related services pose an imminent risk of death, serious illness or serious injury." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-132j-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-diffusion-4 .
concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Spread" ;
    cml:logicSummary "Requires spread of information about the danger and provision of product-related services." ;
    cml:premiseText "(2) If it appears to the Commonwealth Minister..." ;
    cml:conclusionText "The interim ban should be imposed without delay when information about the danger is disseminated." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-132j-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-132j-ss-2-logic-cogai-5 .
