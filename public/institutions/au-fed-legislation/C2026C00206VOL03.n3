    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Imposes a prohibition on product-related services." ;
    cml:premiseText "(2) If it appears to the Commonwealth Minister..." ;
    cml:conclusionText "An interim ban on services of that kind should be imposed without delay." ;
    cml:executionSurface "modalities::logic::deontic" ;
