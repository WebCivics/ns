concept:competition-and-consumer-act-2010-sec-135z-ss-3 cml:asserts concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires specification of purpose and premises." ;
    cml:premiseText "(3) The warrant must:  (a) specify the purpose for which the warrant is issued; and  (b) describe the premises to which the warrant relates;" ;
    cml:conclusionText "The warrant must specify its purpose and premises." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-135z-ss-3 cml:asserts concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-2 .
concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires naming of inspectors." ;
    cml:premiseText "(3) The warrant must:  (d) name one or more inspectors;" ;
    cml:conclusionText "The warrant must name its inspectors." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-135z-ss-3 cml:asserts concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-3 .
concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires authorisation of search powers." ;
    cml:premiseText "(3) The warrant must:  (e) authorise the inspector or inspectors so named:  (i) to enter the premises; and  (ii) to exercise search-related powers in relation to the premises;" ;
    cml:conclusionText "The warrant must authorise its inspectors to enter and exercise search powers." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-135z-ss-3 cml:asserts concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-4 .
concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires specification of entry times." ;
    cml:premiseText "(3) The warrant must:  (f) state whether the entry is authorised to be made at any time of the day or night, or during specified hours of the day or night;" ;
    cml:conclusionText "The warrant must specify its entry times." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-135z-ss-3 cml:asserts concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-5 .
concept:competition-and-consumer-act-2010-sec-135z-ss-3-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires specification of warrant validity period." ;
    cml:premiseText "(3) The warrant must:  (g) specify a day (which must not be more than 7 days after the day the warrant is issued) on which the warrant ceases to be in force." ;
    cml:conclusionText "The warrant must specify its validity period." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


