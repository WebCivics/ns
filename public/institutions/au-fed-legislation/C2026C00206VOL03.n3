concept:competition-and-consumer-act-2010-sec-152bc-ss-3 cml:asserts concept:competition-and-consumer-act-2010-sec-152bc-ss-3-logic-descriptionlogic-2 .
concept:competition-and-consumer-act-2010-sec-152bc-ss-3-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "specifies" ;
    cml:logicSummary "Specifies terms and conditions for carrier or provider compliance." ;
    cml:premiseText "(3) An access determination may:  (a) specify any or all of the terms and conditions on which a carrier or carriage service provider is to comply with any or all of the standard access obligations applicable to the carrier or provider;" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

