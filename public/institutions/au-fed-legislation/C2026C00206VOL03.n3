concept:competition-and-consumer-act-2010-sec-151bw-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:competition-and-consumer-act-2010-sec-151bw ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
