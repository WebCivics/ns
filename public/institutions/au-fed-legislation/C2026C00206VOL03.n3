concept:competition-and-consumer-act-2010-sec-151ay-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sec-151ay-ss-1-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sec-151ay-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "refusal" ;
    cml:logicSummary "Commission's refusal is a duty." ;
    cml:premiseText "(1) This section applies if:  (a) the Commission receives, or has received, an application for an exemption order; and  (b) the Commission receives, or has received, a notice under subsection 93(1) or 93AB(1A) or (1); and  (c) the application for the exemption order and the notice relate to the same conduct." ;
    cml:conclusionText "The Commission may refuse to consider the application." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

