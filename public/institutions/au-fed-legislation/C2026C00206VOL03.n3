concept:competition-and-consumer-act-2010-sec-132e-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sec-132e-ss-1-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sec-132e-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide opportunity for conference" ;
    cml:premiseText "(1) This section applies if:  (a) an interim ban on consumer goods of a particular kind, or on product related services of a particular kind, is in force; and  (b) the interim ban was imposed by the Commonwealth Minister; and  (c) before the ban was imposed, the Commonwealth Minister published a notice under section 132J certifying that the interim ban should be imposed without delay." ;
    cml:conclusionText "(1) This section applies if:  (a) an interim ban on consumer goods of a particular kind, or on product related services of a particular kind, is in force; and  (b) the interim ban was imposed by the Commonwealth Minister; and  (c) before the ban was imposed, the Commonwealth Minister published a notice under section 132J certifying that the interim ban should be imposed without delay." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


