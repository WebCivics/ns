concept:competition-and-consumer-act-2010-sec-10-165-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "must" ;
    cml:logicSummary "The Minister has a duty to not make an order under subsection 10.54(1) unless certain conditions are met." ;
    cml:premiseText "section 10.52 (non-conference ocean carrier with substantial market power to negotiate with certain designated shipper bodies etc.) applies to the ocean carrier concerned, and that the ocean carrier has contravened, or proposes to contravene, that section;" ;
    cml:conclusionText "The Minister must not make an order under subsection 10.54(1) unless..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

