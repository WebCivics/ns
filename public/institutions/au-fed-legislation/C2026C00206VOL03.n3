    cml:modality cml:LTL ;
    cml:operator "until" ;
    cml:logicSummary "Temporal relation between a person and a contravention" ;
    cml:premiseText "has been in any way, directly or indirectly, knowingly concerned in, or party to, the contravention;" ;
    cml:conclusionText "the contravention occurred until this period" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-151bw cml:asserts concept:competition-and-consumer-act-2010-sec-151bw-logic-diffusion-4 .
concept:competition-and-consumer-act-2010-sec-151bw-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "through" ;
    cml:logicSummary "Transmission of a contravention through a person" ;
    cml:premiseText "has conspired with others to effect the contravention;" ;
    cml:conclusionText "the contravention was transmitted through this person" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

