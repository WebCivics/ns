concept:competition-and-consumer-act-2010-sec-151bw cml:asserts concept:competition-and-consumer-act-2010-sec-151bw-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sec-151bw-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "is-a" ;
    cml:logicSummary "Classification as involved in a contravention" ;
    cml:premiseText "Person involved in a contravention of the competition rule, a" ;
    cml:conclusionText "has aided, abetted, counselled or procured the contravention; or has induced, whether by threats or promises or otherwise, the contravention; or has been in any way, directly or indirectly, knowingly concerned in, or party to, the contravention;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

