    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "The Minister must not make an order under subsection 10.54(1) during certain circumstances." ;
    cml:premiseText "the Minister has carried on or attempted to carry on, either personally or through authorised officers, consultations with the ocean carrier directed at obtaining an undertaking" ;
