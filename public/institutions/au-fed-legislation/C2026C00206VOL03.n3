    cml:modality cml:CogAI ;
    cml:operator "Recognize" ;
    cml:logicSummary "Requires recognition of product-related services as posing an imminent risk of death, serious illness or serious injury." ;
    cml:premiseText "(2) If it appears to the Commonwealth Minister..." ;
    cml:conclusionText "The interim ban should be imposed without delay when product-related services are recognized as posing an imminent risk of death, serious illness or serious injury." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


