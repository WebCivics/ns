concept:competition-and-consumer-act-2010-sec-135z-ss-2 a cml:Concept ;
    skos:prefLabel "135Z(2) Issue of search warrants"@en ;
    cml:realizedBy doc:sec-135z-ss-2 ;
    cml:integrityHash "3ec48d178b59a449df9262dc2879a21f08236c81153a5d0b8b716a104911a91d" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-135z ;
    skos:note "Grounds for issuing a search warrant" ;
    dc:description "(a) an affidavit has been given to the judge setting out the grounds on which the issue of the warrant is being sought; (b) the applicant, or some other person, has given to the judge such further information (if any) as the judge requires concerning the grounds on which the issue of the warrant is being sought" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
