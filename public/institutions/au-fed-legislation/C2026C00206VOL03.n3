    cml:modality cml:Argumentation ;
    cml:operator "implies" ;
    cml:logicSummary "Implication of a person's involvement in a contravention" ;
    cml:premiseText "(a) has aided, abetted, counselled or procured the contravention; (b) has induced, whether by threats or promises or otherwise, the contravention;" ;
    cml:conclusionText "the person is involved in the contravention" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


