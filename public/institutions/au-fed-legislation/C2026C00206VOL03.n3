    cml:operator "Prohibition" ;
    cml:logicSummary "Refusal to comply with disclosure notice is prohibited." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person is given a disclosure notice; and  (b) the person refuses or fails to comply with the notice." ;
    cml:conclusionText "The person must comply with the disclosure notice." ;
    cml:executionSurface "modalities::logic::deontic" ;
