concept:competition-and-consumer-act-2010-sec-152be cml:asserts concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-2 .
concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the terms and conditions of an access agreement." ;
    cml:premiseText "The agreement relates to access to a declared service." ;
    cml:conclusionText "The agreement embodies any or all of the terms and conditions on which the carrier or carriage service provider is to comply with any or all of the standard access obligations applicable to the carrier or provider." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-152be cml:asserts concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-3 .
concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-3 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the requirements imposed by an access determination." ;
    cml:premiseText "If an access determination imposes requirements on a carrier or carriage service provider in relation to access to the declared service, as mentioned in paragraph 152BC(3)(e)—" ;
    cml:conclusionText "The agreement embodies any or all of the terms and conditions on which the carrier or carriage service provider is to comply with any or all of those requirements." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-152be cml:asserts concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-4 .
concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-4 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the terms and conditions of an access seeker's access to a declared service." ;
    cml:premiseText "The agreement embodies any other terms and conditions of the access seeker’s access to the declared service;" ;
    cml:conclusionText "The agreement requires the carrier or carriage service provider to comply with any or all of the standard access obligations applicable to the carrier or provider in a manner specified in the agreement;" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-152be cml:asserts concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-5 .
concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-5 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the requirements for the extension or enhancement of a facility." ;
    cml:premiseText "The agreement requires the carrier or carriage service provider to extend or enhance the capability of a facility by means of which the declared service is supplied;" ;
    cml:conclusionText "The agreement embodies any other terms and conditions of the access seeker’s access to the declared service;" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-152be cml:asserts concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-6 .
concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-6 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the parties involved in an access agreement." ;
    cml:premiseText "The parties to the agreement are: an access seeker and the carrier or carriage service provider who supplies, or proposes to supply, the declared service;" ;
    cml:conclusionText "The agreement is between an access seeker and a carrier or carriage service provider." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-152be cml:asserts concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-7 .
concept:competition-and-consumer-act-2010-sec-152be-logic-descriptionlogic-7 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the declaration of a service in an access agreement." ;
    cml:premiseText "The agreement relates to access to a declared service;" ;
    cml:conclusionText "The agreement is related to a declared service." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


