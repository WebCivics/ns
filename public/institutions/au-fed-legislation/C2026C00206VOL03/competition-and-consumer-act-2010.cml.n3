concept:competition-and-consumer-act-2010-sec-153v-ss-4 a cml:Concept ;
    skos:prefLabel "153V(4) Commission may vary or revoke no Treasurer action notice"@en ;
    cml:realizedBy doc:sec-153v-ss-4 ;
    values:originalText "(4) The Commission cannot make a revocation under subsection (1) unless the Commission is satisfied that the conditions in subsections (5) and (6) are met." ;
