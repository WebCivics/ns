concept:competition-and-consumer-act-2010-sec-140h a cml:Concept ;
    skos:prefLabel "140H Application laws may operate concurrently with this Act"@en ;
    cml:realizedBy doc:sec-140h ;
    values:originalText "This Act is not intended to exclude the operation of any application law, to the extent that the application law is capable of operating concurrently with this Act." ;
    skos:definition "This Act is not intended to exclude the operation of any application law, to the extent that the application law is capable of operating concurrently with this Act."@en ;
