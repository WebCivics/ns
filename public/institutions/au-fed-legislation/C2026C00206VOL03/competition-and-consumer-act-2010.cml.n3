doc:sec-10-178-ss-1 a cof:Section ;
    cof:title "10(1) 68  Ocean carrier who provides international liner cargo shipping" ;
    values:kind "subsection" ;
    values:originalText "(1) Every ocean carrier who provides international liner cargo shipping services shall, at all times, be represented for the purposes of this Act by a person who:  (a) is an individual resident in Australia;  (b) has been appointed by the ocean carrier as the ocean carrier’s agent for the purposes of this Act; and  (c) is specified in the register of ocean carrier agents as the ocean carrier’s agent." ;
    cof:pageNumber "100"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-10-178-ss-2 a cml:Concept ;
    skos:prefLabel "10(2) 68  Ocean carrier who provides international liner cargo shipping"@en ;
    cml:realizedBy doc:sec-10-178-ss-2 ;
    values:originalText "(2) An ocean carrier who, without reasonable excuse, contravenes subsection (1) commits an offence punishable, on conviction, by a fine not exceeding:  (a) in the case of a natural person—20 penalty units; and  (b) in the case of a body corporate—100 penalty units." ;
    skos:definition "(2) An ocean carrier who, without reasonable excuse, contravenes subsection (1) commits an offence punishable, on conviction, by a fine not exceeding:  (a) in the case of a natural person—20 penalty units; and  (b) in the case of a body corporate—100 penalty units."@en ;
    cml:integrityHash "95fc664c260b5a9a671bd844827e25e7d21d579e41e9f8193684b97125ec4e71" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-10-178 ;
    cof:pageNumber "100"^^xsd:integer ;
    skos:note "Ocean carrier who provides international liner cargo shipping must not contravene subsection (1) without reasonable excuse." ;
