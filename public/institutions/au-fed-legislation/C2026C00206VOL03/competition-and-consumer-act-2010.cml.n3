concept:competition-and-consumer-act-2010-sec-154zz a cml:Concept ;
    skos:prefLabel "154ZZ Designated complaints determination"@en ;
    cml:realizedBy doc:sec-154zz ;
    values:originalText "The Minister may, by legislative instrument, make a determination (the designated complaints determination) prescribing matters required or permitted by this Part to be prescribed by the designated complaints determination.  Miscellaneous  Chapter 8 Miscellaneous  Part XII  Section 155  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "The Minister may, by legislative instrument, make a determination (the designated complaints determination) prescribing matters required or permitted by this Part to be prescribed by the designated complaints determination.  Miscellaneous  Chapter 8 Miscellaneous  Part XII  Section 155  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "3cd2ace7aa268ca3419cb27de87c2982a55eca0378c49b8befa7f4d44987859b" ;
    cof:pageNumber "534"^^xsd:integer ;
    skos:note "The Minister may make a determination prescribing matters required or permitted by this Part." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
