concept:competition-and-consumer-act-2010-sec-153m-ss-3 a cml:Concept ;
    skos:prefLabel "153M(3) Commission may issue public warning notice"@en ;
    cml:realizedBy doc:sec-153m-ss-3 ;
    values:originalText "(3) The notice must:  (a) state the day on which the notice is issued; and  (b) identify:  (i) the corporation mentioned in paragraph (2)(a); and  (ii) the prohibited conduct mentioned in paragraph (2)(a)." ;
    skos:definition "(3) The notice must:  (a) state the day on which the notice is issued; and  (b) identify:  (i) the corporation mentioned in paragraph (2)(a); and  (ii) the prohibited conduct mentioned in paragraph (2)(a)."@en ;
