doc:sec-135u a cof:Section ;
    cof:title "135U Multiple embargo notices for the same consumer goods or" ;
    values:kind "section" ;
    values:originalText "product related services  An inspector must not give an embargo notice in relation to consumer goods, or product related services, of a particular kind if:  (a) an embargo notice (the earlier embargo notice) has already been given in relation to consumer goods, or product related services, of that kind; and  (b) the embargo period for the earlier embargo notice did not end at least 5 days ago." ;
    cof:pageNumber "168"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-135v a cml:Concept ;
    skos:prefLabel "135V Power of inspectors to secure consumer goods"@en ;
    cml:realizedBy doc:sec-135v ;
    values:originalText "If:  (a) an embargo notice relates to consumer goods; and  (b) the inspector who gives the notice believes on reasonable grounds that it is necessary to secure the consumer goods in order to ensure that the notice is complied with; the inspector may, during the embargo period for the embargo notice, do anything that the inspector thinks is necessary to secure those consumer goods (whether by locking them up, placing a guard or otherwise)." ;
    skos:definition "If:  (a) an embargo notice relates to consumer goods; and  (b) the inspector who gives the notice believes on reasonable grounds that it is necessary to secure the consumer goods in order to ensure that the notice is complied with; the inspector may, during the embargo period for the embargo notice, do anything that the inspector thinks is necessary to secure those consumer goods (whether by locking them up, placing a guard or otherwise)."@en ;
    cml:integrityHash "1b8dc252442188c8f8c954ec27f7209a00e783f1f30ddaa76fe69e5d323b4535" ;
    cof:pageNumber "168"^^xsd:integer ;
    skos:note "Inspector may take actions to secure consumer goods during embargo period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.168" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-135v-norm .
