concept:competition-and-consumer-act-2010-sec-131b a cml:Concept ;
    skos:prefLabel "131B Division does not apply to interim bans imposed by State or"@en ;
    cml:realizedBy doc:sec-131b ;
    values:originalText "Territory Ministers  Despite section 131, this Division does not apply to an interim ban that is not imposed by the Commonwealth Minister." ;
