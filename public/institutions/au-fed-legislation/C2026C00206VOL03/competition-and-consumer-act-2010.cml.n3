    cml:hasPart concept:competition-and-consumer-act-2010-sec-157aa-ss-2b ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-157aa-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
