doc:sec-151as-ss-2 a cof:Section ;
    cof:title "151AS(2) Exemption orders" ;
    values:kind "subsection" ;
    values:originalText "(2) An exemption order is not invalid only because the conduct specified in the order is conduct of a kind that, apart from the order, is outside the scope of section 151AJ (which deals with anti-competitive conduct)." ;
    cof:pageNumber "233"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-151at a cml:Concept ;
    skos:prefLabel "151AT Form of application"@en ;
    cml:realizedBy doc:sec-151at ;
    values:originalText "An application for an exemption order must be:  (a) in writing; and  (b) in a form approved in writing by the Commission; and  (c) accompanied by the prescribed fee.  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "An application for an exemption order must be:  (a) in writing; and  (b) in a form approved in writing by the Commission; and  (c) accompanied by the prescribed fee.  Chapter 7  Further provisions relating to particular industries etc."@en ;
