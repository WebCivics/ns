concept:competition-and-consumer-act-2010-sec-135d-ss-4 a cml:Concept ;
    skos:prefLabel "135D(4) Persons assisting inspectors"@en ;
    cml:realizedBy doc:sec-135d-ss-4 ;
    values:originalText "(4) A power exercised by a person assisting the inspector as mentioned in subsection (3) is taken for all purposes to have been exercised by the inspector." ;
