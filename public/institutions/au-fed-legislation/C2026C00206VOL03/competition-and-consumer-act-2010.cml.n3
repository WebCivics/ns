concept:competition-and-consumer-act-2010-sec-151ac a cml:Concept ;
    skos:prefLabel "151AC Extension to external Territories"@en ;
    cml:realizedBy doc:sec-151ac ;
    values:originalText "(1) This Part, and the other provisions of this Act so far as they relate to this Part, extend to each eligible Territory (within the meaning of the Telecommunications Act 1997).  (2) The operation of this Part, and the other provisions of this Act so far as they relate to this Part, in relation to Norfolk Island is not affected by the amendments made by Division 1 of Part 1 of Schedule 5 to the Territories Legislation Amendment Act 2016." ;
    skos:definition "(1) This Part, and the other provisions of this Act so far as they relate to this Part, extend to each eligible Territory (within the meaning of the Telecommunications Act 1997).  (2) The operation of this Part, and the other provisions of this Act so far as they relate to this Part, in relation to Norfolk Island is not affected by the amendments made by Division 1 of Part 1 of Schedule 5 to the Territories Legislation Amendment Act 2016."@en ;
    cml:integrityHash "2bd7c6e179ee3883c2249717d4a119f63345d63f15504bbb73528fe251d3a8c4" ;
    cof:pageNumber "217"^^xsd:integer ;
