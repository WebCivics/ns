doc:sec-134a-ss-3 a cof:Section ;
    cof:title "134A(3) Issuing an infringement notice" ;
    values:kind "subsection" ;
    values:originalText "(3) The Commission must not issue more than one infringement notice to the person for the same alleged contravention of the infringement notice provision." ;
