doc:sec-151cc-ss-1 a cof:Section ;
    cof:title "151CC(1) Actions for damages—breach of the competition rule" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who suffers loss or damage by conduct of another person that was done in contravention of the competition rule may recover the amount of the loss or damage by action against:  (a) that other person; or  (b) any person involved in the contravention." ;
    cof:pageNumber "271"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-151cc-ss-2 a cml:Concept ;
    skos:prefLabel "151CC(2) Actions for damages—breach of the competition rule"@en ;
    cml:realizedBy doc:sec-151cc-ss-2 ;
    values:originalText "(2) An action under subsection (1) may be commenced at any time within 3 years after the date on which the cause of action accrued.  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "(2) An action under subsection (1) may be commenced at any time within 3 years after the date on which the cause of action accrued.  Chapter 7  Further provisions relating to particular industries etc."@en ;
