doc:sec-10-194 a cof:Section ;
    cof:title "10 80  Registrar and staff to be public servants" ;
    values:kind "section" ;
    values:originalText "The Registrar, and any staff of the Registrar, shall be persons engaged under the Public Service Act 1999." ;
    cof:pageNumber "106"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-10-195 a cml:Concept ;
    skos:prefLabel "10 81  Delegation by Minister"@en ;
    cml:realizedBy doc:sec-10-195 ;
    values:originalText "The Minister may, by signed writing, delegate to the Registrar, or to a person occupying a specified office in the Department, all or any of the Minister’s powers under or in relation to this Part (other than powers under sections 10.02A and 10.03, subsections 10.06(1) and 10.44(1), sections 10.46, 10.47, 10.48 and 10.50, subsection 10.54(1), sections 10.56, 10.57 and 10.58, subsection 10.61(1) and sections 10.63 and 10.72A).  Other provisions  Chapter 6 International liner cargo shipping  Part X Administration  Division 14  Section 10.82  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "The Minister may, by signed writing, delegate to the Registrar, or to a person occupying a specified office in the Department, all or any of the Minister’s powers under or in relation to this Part (other than powers under sections 10.02A and 10.03, subsections 10.06(1) and 10.44(1), sections 10.46, 10.47, 10.48 and 10.50, subsection 10.54(1), sections 10.56, 10.57 and 10.58, subsection 10.61(1) and sections 10.63 and 10.72A).  Other provisions  Chapter 6 International liner cargo shipping  Part X Administration  Division 14  Section 10.82  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "3a6555bd2441037a8932d343bd1fa1040edea5261453cf4ffa0d8ffa9fb3e494" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "The Minister may delegate powers under certain conditions." ;
    cml:curationStatus cml:Proposed ;
