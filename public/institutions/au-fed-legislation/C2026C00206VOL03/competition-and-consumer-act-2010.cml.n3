doc:sec-151ci-ss-1 a cof:Section ;
    cof:title "151CI(1) Review by Tribunal" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Commission makes a decision under section 151BA to refuse to make an exemption order relating to conduct of a person, the person may apply to the Tribunal for a review of the decision." ;
    cof:pageNumber "278"^^xsd:integer .

