doc:sec-151bv-ss-1 a cof:Section ;
    cof:title "151BV(1) Incorrect records" ;
    values:kind "subsection" ;
    values:originalText "(1) A person must not, in purported compliance with a requirement imposed by the record-keeping rules, make a record of any matter or thing in such a way that it does not correctly record the matter or thing." ;
    cof:pageNumber "264"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-151bv-ss-2 a cml:Concept ;
    skos:prefLabel "151BV(2) Incorrect records"@en ;
    cml:realizedBy doc:sec-151bv-ss-2 ;
    values:originalText "(2) A person who contravenes subsection (1) commits an offence punishable on conviction by imprisonment for a term not exceeding 6 months. Note: See also sections 4AA and 4B of the Crimes Act 1914.  Further provisions relating to particular industries etc.  Chapter 7 The Telecommunications Industry: Anti-competitive conduct and record-keeping rules" ;
    skos:definition "(2) A person who contravenes subsection (1) commits an offence punishable on conviction by imprisonment for a term not exceeding 6 months. Note: See also sections 4AA and 4B of the Crimes Act 1914.  Further provisions relating to particular industries etc.  Chapter 7 The Telecommunications Industry: Anti-competitive conduct and record-keeping rules"@en ;
