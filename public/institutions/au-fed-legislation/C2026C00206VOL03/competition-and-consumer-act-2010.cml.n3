doc:sec-157d-ss-2 a cof:Section ;
    cof:title "157D(2) General powers of a court" ;
    values:kind "subsection" ;
    values:originalText "(2) A refusal by a court to grant leave under subsection 157B(1) does not prevent the court from later ordering that a criminal proceeding be stayed on the ground that the refusal would have a substantial adverse effect on a defendant’s right to receive a fair hearing. Stay order—civil proceeding" ;
    cof:pageNumber "564"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-157d-ss-3 a cml:Concept ;
    skos:prefLabel "157D(3) General powers of a court"@en ;
    cml:realizedBy doc:sec-157d-ss-3 ;
    values:originalText "(3) A refusal by a court to grant leave under subsection 157B(1) does not prevent the court from later ordering that a civil proceeding be stayed on the ground that the refusal would have a substantial adverse effect on the hearing in the proceeding." ;
    skos:definition "(3) A refusal by a court to grant leave under subsection 157B(1) does not prevent the court from later ordering that a civil proceeding be stayed on the ground that the refusal would have a substantial adverse effect on the hearing in the proceeding."@en ;
    cml:integrityHash "ca3de5db748840326dc6dcca139419bc86ce96dfb59cafbe5069eb02366b1396" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-157d ;
    cof:pageNumber "564"^^xsd:integer ;
    skos:note "Court's power to order stay of civil proceeding despite refusal to grant leave." ;
