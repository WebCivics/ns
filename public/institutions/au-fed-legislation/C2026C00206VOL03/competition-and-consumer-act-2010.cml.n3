    cml:modality cml:Deontic ;
    values:partOf concept:competition-and-consumer-act-2010-sec-135v ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:competition-and-consumer-act-2010-sec-135v cml:asserts concept:competition-and-consumer-act-2010-sec-135v-logic-deontic-1 .
