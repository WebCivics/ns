concept:competition-and-consumer-act-2010-sec-154t a cml:Concept ;
    skos:prefLabel "154T Receipts for things seized or moved under warrant"@en ;
    cml:realizedBy doc:sec-154t ;
    values:originalText "(1) If a thing is seized under a search warrant or moved under subsection 154GA(1), the executing officer or an officer assisting must provide a receipt for the thing.  (2) If 2 or more things are seized or moved, they may be covered in the one receipt." ;
    skos:definition "(1) If a thing is seized under a search warrant or moved under subsection 154GA(1), the executing officer or an officer assisting must provide a receipt for the thing.  (2) If 2 or more things are seized or moved, they may be covered in the one receipt."@en ;
    cml:integrityHash "685d8146fd2435c670e0ca1556d79fbec1e9af10d5a4ab6c7b85ee3b9e6a303c" ;
    cof:pageNumber "508"^^xsd:integer ;
