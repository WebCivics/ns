concept:competition-and-consumer-act-2010-sec-10-175 a cml:Concept ;
    skos:prefLabel "10 65  Enforcement of orders and undertakings"@en ;
    cml:realizedBy doc:sec-10-175 ;
    values:originalText "(1) An ocean carrier shall not contravene an order made under subsection 10.61(1) or an undertaking given under section 10.64.  (2) Part VI applies in relation to subsection (1) as if that subsection were a provision of Part IV (but not of Division 1A of Part IV)." ;
    skos:definition "(1) An ocean carrier shall not contravene an order made under subsection 10.61(1) or an undertaking given under section 10.64.  (2) Part VI applies in relation to subsection (1) as if that subsection were a provision of Part IV (but not of Division 1A of Part IV)."@en ;
    cml:integrityHash "8f8bfeca6d045cc77227f9d816dfd3744d1939287307dd3320e7f353e1230dbc" ;
    cof:pageNumber "97"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-175-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-175-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.97" .
