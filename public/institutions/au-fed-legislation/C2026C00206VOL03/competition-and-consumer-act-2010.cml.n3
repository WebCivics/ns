    values:partOf concept:competition-and-consumer-act-2010-sec-10-202 ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "Minister must comply with request from Tribunal member." ;
    dc:description "Information, reports, and assistance as specified by the Tribunal member." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
