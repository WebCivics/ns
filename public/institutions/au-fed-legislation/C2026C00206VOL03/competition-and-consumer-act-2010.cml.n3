    cof:title "10(1) 30  Application for final registration of conference agreement" ;
    values:kind "subsection" ;
    values:originalText "(1) The parties to a provisionally registered conference agreement may apply for its final registration under this Part." ;
    cof:pageNumber "64"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-10-139-ss-2 a cml:Concept ;
    skos:prefLabel "10(2) 30  Application for final registration of conference agreement"@en ;
    cml:realizedBy doc:sec-10-139-ss-2 ;
    values:originalText "(2) The application must comply with the following provisions:  (a) subsections 10.31(1) and (2) (how application is to be made and verified);  (b) section 10.32 (copy of agreement to be filed with application etc.)." ;
    skos:definition "(2) The application must comply with the following provisions:  (a) subsections 10.31(1) and (2) (how application is to be made and verified);  (b) section 10.32 (copy of agreement to be filed with application etc.)."@en ;
