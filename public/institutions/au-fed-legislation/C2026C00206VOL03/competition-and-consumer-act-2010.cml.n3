concept:competition-and-consumer-act-2010-sec-10-170 a cml:Concept ;
    skos:prefLabel "10 60  Enforcement of orders and undertakings"@en ;
    cml:realizedBy doc:sec-10-170 ;
    values:originalText "(1) An ocean carrier shall not contravene an order made under subsection 10.54(1) or an undertaking given under section 10.59.  (2) Part VI applies in relation to subsection (1) as if that subsection were a provision of Part IV (but not of Division 1A of Part IV).  Other provisions  Chapter 6 International liner cargo shipping  Part X Unfair pricing practices  Division 11  Section 10.61  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "(1) An ocean carrier shall not contravene an order made under subsection 10.54(1) or an undertaking given under section 10.59.  (2) Part VI applies in relation to subsection (1) as if that subsection were a provision of Part IV (but not of Division 1A of Part IV).  Other provisions  Chapter 6 International liner cargo shipping  Part X Unfair pricing practices  Division 11  Section 10.61  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "4df96490ec1a2653dfadb98bcf4bdd8fb7a84b7e85236fed5a9bccde3ffbb02a" ;
    cof:pageNumber "94"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-170-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-170-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.94" .
