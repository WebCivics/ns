doc:sec-152eo-ss-3 a cof:Section ;
    cof:title "152EO(3) Conduct by directors, servants or agents" ;
    values:kind "subsection" ;
    values:originalText "(3) A reference in subsection (1) to the state of mind of a person includes a reference to:  (a) the knowledge, intention, opinion, belief or purpose of the person; and  (b) the person’s reasons for the intention, opinion, belief or purpose." ;
    cof:pageNumber "428"^^xsd:integer .

