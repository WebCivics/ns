concept:competition-and-consumer-act-2010-sec-134a-ss-4 a cml:Concept ;
    skos:prefLabel "134A(4) Issuing an infringement notice"@en ;
    cml:realizedBy doc:sec-134a-ss-4 ;
    values:originalText "(4) The infringement notice does not have any effect if the notice:  (a) is issued more than 12 months after the day on which the contravention of the infringement notice provision is alleged to have occurred; or  (b) relates to more than one alleged contravention of an infringement notice provision by the person." ;
    skos:definition "(4) The infringement notice does not have any effect if the notice:  (a) is issued more than 12 months after the day on which the contravention of the infringement notice provision is alleged to have occurred; or  (b) relates to more than one alleged contravention of an infringement notice provision by the person."@en ;
    cml:integrityHash "89b955d520fedc623979b5e1b95827814d5963d58845234908414a1dfe228076" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-134a ;
    cof:pageNumber "144"^^xsd:integer ;
    skos:note "Infringement notice has no effect if issued more than 12 months after alleged contravention." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.144" ;
