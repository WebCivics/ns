doc:sec-10-152-ss-3 a cof:Section ;
    cof:title "10(3) 43  Parties to registered conference agreement to notify" ;
    values:kind "subsection" ;
    values:originalText "(3) The notice must comply with any regulations requiring its verification (in whole or part)." ;
    cof:pageNumber "74"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-10-152-ss-4 a cml:Concept ;
    skos:prefLabel "10(4) 43  Parties to registered conference agreement to notify"@en ;
    cml:realizedBy doc:sec-10-152-ss-4 ;
    values:originalText "(4) Where the parties to a registered conference agreement give a notice under subsection (1), the Registrar may make such variations (if any) to the particulars entered in the register of conference agreements in relation to the agreement as the Registrar considers necessary or desirable to take account of the notice.  Chapter 6  Other provisions" ;
