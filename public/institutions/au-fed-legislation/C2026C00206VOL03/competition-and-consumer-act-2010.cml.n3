concept:competition-and-consumer-act-2010-sec-151bw a cml:Concept ;
    skos:prefLabel "151BW Person involved in a contravention of the competition rule, a"@en ;
    cml:realizedBy doc:sec-151bw ;
    values:originalText "record-keeping rule or a disclosure direction  A reference in this Division to a person involved in a contravention of the competition rule, a record-keeping rule or a disclosure direction is a reference to a person who:  (a) has aided, abetted, counselled or procured the contravention; or  (b) has induced, whether by threats or promises or otherwise, the contravention; or  (c) has been in any way, directly or indirectly, knowingly concerned in, or party to, the contravention; or  (d) has conspired with others to effect the contravention." ;
    skos:definition "record-keeping rule or a disclosure direction  A reference in this Division to a person involved in a contravention of the competition rule, a record-keeping rule or a disclosure direction is a reference to a person who:  (a) has aided, abetted, counselled or procured the contravention; or  (b) has induced, whether by threats or promises or otherwise, the contravention; or  (c) has been in any way, directly or indirectly, knowingly concerned in, or party to, the contravention; or  (d) has conspired with others to effect the contravention."@en ;
    cml:integrityHash "e1a9de386af88550f7e5b19bf43d4d112fa0a01e5325cc6d3ebec955ab369d3b" ;
    cof:pageNumber "265"^^xsd:integer ;
    skos:note "Defines who is considered involved in a contravention of the competition rule." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
