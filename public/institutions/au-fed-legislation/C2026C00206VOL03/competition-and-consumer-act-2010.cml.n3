concept:competition-and-consumer-act-2010-sec-151am a cml:Concept ;
    skos:prefLabel "151AM Competition notice to be given to carrier or carriage service"@en ;
    cml:realizedBy doc:sec-151am ;
    values:originalText "provider  As soon as practicable after issuing a competition notice, the Commission must give a copy of the competition notice to the carrier or carriage service provider concerned." ;
