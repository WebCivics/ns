concept:competition-and-consumer-act-2010-sec-152en a cml:Concept ;
    skos:prefLabel "152EN Treatment of partnerships"@en ;
    cml:realizedBy doc:sec-152en ;
    values:originalText "This Part applies to a partnership as if the partnership were a person, but it applies with the following changes:  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "This Part applies to a partnership as if the partnership were a person, but it applies with the following changes:  Chapter 7  Further provisions relating to particular industries etc."@en ;
