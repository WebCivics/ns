doc:sec-153m-ss-1 a cof:Section ;
    cof:title "153M(1) Commission may issue public warning notice" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) the Commission gave a corporation a notice under section 153L in relation to prohibited conduct; and  (b) at least 21 days have passed since the Commission gave the corporation the notice; and  (c) no more than 90 days have passed since the Commission gave the corporation the notice." ;
    cof:pageNumber "439"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-153m-ss-2 a cml:Concept ;
    skos:prefLabel "153M(2) Commission may issue public warning notice"@en ;
    cml:realizedBy doc:sec-153m-ss-2 ;
    values:originalText "(2) The Commission may issue to the public a written notice containing a warning about the prohibited conduct if the Commission reasonably believes that:  (a) any of the following conditions are satisfied:  (i) the corporation has engaged in the prohibited conduct;  (ii) the corporation is engaging in the prohibited conduct; and  (b) one or more persons has suffered, or is likely to suffer, detriment as a result of the prohibited conduct; and  (c) it is in the public interest to issue the notice." ;
    skos:definition "(2) The Commission may issue to the public a written notice containing a warning about the prohibited conduct if the Commission reasonably believes that:  (a) any of the following conditions are satisfied:  (i) the corporation has engaged in the prohibited conduct;  (ii) the corporation is engaging in the prohibited conduct; and  (b) one or more persons has suffered, or is likely to suffer, detriment as a result of the prohibited conduct; and  (c) it is in the public interest to issue the notice."@en ;
    cml:integrityHash "3575974e1f36bf6b22f63056c856d424caf8c5a4cd7c9ac05685cef1ca5b983d" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-153m ;
    cof:pageNumber "439"^^xsd:integer ;
    skos:note "Commission may issue public warning notice for prohibited conduct." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.439" ;
