doc:sec-10-158-ss-4 a cof:Section ;
    cof:title "10(4) 49  Undertakings by parties to registered conference agreement" ;
    values:kind "subsection" ;
    values:originalText "(4) If the Minister accepts the offer, the parties shall be taken to have given the undertaking, and the Registrar shall immediately register the undertaking by entering particulars of it in the register of conference agreements." ;
    cof:pageNumber "84"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-10-158-ss-5 a cml:Concept ;
    skos:prefLabel "10(5) 49  Undertakings by parties to registered conference agreement"@en ;
    cml:realizedBy doc:sec-10-158-ss-5 ;
    values:originalText "(5) If the Minister revokes a direction given under subsection 10.44(1), the Registrar shall immediately include in the register a notation to the effect that the direction has been revoked." ;
    skos:definition "(5) If the Minister revokes a direction given under subsection 10.44(1), the Registrar shall immediately include in the register a notation to the effect that the direction has been revoked."@en ;
