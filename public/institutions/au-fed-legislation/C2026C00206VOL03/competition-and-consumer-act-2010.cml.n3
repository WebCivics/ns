doc:sec-10-124-ss-2 a cof:Section ;
    cof:title "10(2) 17  Exemptions from sections 45AF, 45AG, 45AJ, 45AK and 45" ;
    values:kind "subsection" ;
    values:originalText "(2) Sections 45AG, 45AK and 45 do not apply in relation to conduct engaged in by a party to a registered conference agreement so far as the conduct gives effect to a provision of the agreement in  Chapter 6  Other provisions" ;
