doc:sec-10-156-ss-1 a cof:Section ;
    cof:title "10(1) 47  Investigation and report by Commission on reference by" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may refer to the Commission for investigation and report the question whether grounds exist for the Minister to be satisfied in relation to a registered conference agreement of one or more specified matters referred to in paragraph 10.45(1)(a)." ;
    cof:pageNumber "82"^^xsd:integer .

