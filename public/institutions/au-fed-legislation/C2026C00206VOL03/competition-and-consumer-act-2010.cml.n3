concept:competition-and-consumer-act-2010-sec-10-117 a cml:Concept ;
    skos:prefLabel "10 10  Registers and conference agreement files open to public"@en ;
    cml:realizedBy doc:sec-10-117 ;
    values:originalText "inspection  (1) The registers and conference agreement files kept by the Registrar and the Commission under this Part are open to public inspection.  (2) A person is entitled, on application to the Registrar or the Commission, as the case requires, and payment of the prescribed fee, to obtain a copy of the whole or any part of:  (a) an entry in a register kept under this Part; or  (b) a conference agreement file kept under this Part." ;
    skos:definition "inspection  (1) The registers and conference agreement files kept by the Registrar and the Commission under this Part are open to public inspection.  (2) A person is entitled, on application to the Registrar or the Commission, as the case requires, and payment of the prescribed fee, to obtain a copy of the whole or any part of:  (a) an entry in a register kept under this Part; or  (b) a conference agreement file kept under this Part."@en ;
    cml:integrityHash "3b1957f394d1b896c8064464feca7a2fcdcacad82e22ee7413eca63e5e7cc596" ;
    cof:pageNumber "48"^^xsd:integer ;
