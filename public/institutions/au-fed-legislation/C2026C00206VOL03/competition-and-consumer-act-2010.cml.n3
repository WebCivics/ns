concept:competition-and-consumer-act-2010-sec-10-143 a cml:Concept ;
    skos:prefLabel "10 34  Request for confidentiality"@en ;
    cml:realizedBy doc:sec-10-143 ;
    values:originalText "(1) An application for the provisional or final registration of a conference agreement may include a request that a specified part of the application, or of a document accompanying the application, not be open to public inspection under this Part.  (2) If such a request is included in the application, the application must include a statement of reasons in support of the request." ;
    skos:definition "(1) An application for the provisional or final registration of a conference agreement may include a request that a specified part of the application, or of a document accompanying the application, not be open to public inspection under this Part.  (2) If such a request is included in the application, the application must include a statement of reasons in support of the request."@en ;
    cml:integrityHash "2d4f9222509c888e96eb3858989de9f6da720bc0d13bae2772049b42899ddef0" ;
    cof:pageNumber "67"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-143-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-143-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
