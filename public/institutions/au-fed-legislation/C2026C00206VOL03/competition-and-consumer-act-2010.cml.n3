    values:originalText "(1) A Commission official must not disclose any protected Part VB information to any person, except:  Miscellaneous  Chapter 8 Miscellaneous  Part XII  Section 155A  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (a) when the Commission official is performing duties or functions as a Commission official; or  (b) when the Commission official or the Commission is required or permitted by law to disclose the information." ;
    cof:pageNumber "548"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-155aa-ss-2 a cml:Concept ;
    skos:prefLabel "155AA(2) Protection of Part VB information"@en ;
    cml:realizedBy doc:sec-155aa-ss-2 ;
    values:originalText "(2) Subsection (1) does not allow a Commission official to disclose protected Part VB information when performing a function of the Commission described in section 28." ;
    skos:definition "(2) Subsection (1) does not allow a Commission official to disclose protected Part VB information when performing a function of the Commission described in section 28."@en ;
