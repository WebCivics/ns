doc:sec-154c-ss-5 a cof:Section ;
    cof:title "154C(5) Identity cards" ;
    values:kind "subsection" ;
    values:originalText "(5) Subsection (3) does not apply if the identity card was lost or destroyed. Note: A defendant bears an evidential burden in relation to the matter in this subsection: see subsection 13.3(3) of the Criminal Code. Inspector must carry card" ;
    cof:pageNumber "494"^^xsd:integer .

