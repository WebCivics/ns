doc:sec-140f-ss-4 a cof:Section ;
    cof:title "140F(4) How duty is imposed" ;
    values:kind "subsection" ;
    values:originalText "(4) If, because of subsection (3), this Act is taken to impose the duty, it is the intention of the Parliament to rely on all powers available to it under the Constitution to support the imposition of the duty by this Act." ;
    cof:pageNumber "203"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-140f-ss-5 a cml:Concept ;
    skos:prefLabel "140F(5) How duty is imposed"@en ;
    cml:realizedBy doc:sec-140f-ss-5 ;
    values:originalText "(5) The duty is taken to be imposed by this Act in accordance with subsection (3) only to the extent to which imposing the duty:  (a) is within the legislative powers of the Commonwealth; and  (b) is consistent with the constitutional doctrines restricting the duties that may be imposed on the entity." ;
    skos:definition "(5) The duty is taken to be imposed by this Act in accordance with subsection (3) only to the extent to which imposing the duty:  (a) is within the legislative powers of the Commonwealth; and  (b) is consistent with the constitutional doctrines restricting the duties that may be imposed on the entity."@en ;
    cml:integrityHash "b8ca9db6da72b3d5ee17588b306e69e6387b84c83decb30817b7f5052f1a2b63" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-140f ;
    cof:pageNumber "203"^^xsd:integer ;
    skos:note "Duty is imposed by this Act within legislative powers and constitutional doctrines." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
