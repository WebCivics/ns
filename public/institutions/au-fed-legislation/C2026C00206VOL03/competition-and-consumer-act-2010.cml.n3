concept:competition-and-consumer-act-2010-sec-188 a cml:Concept ;
    skos:prefLabel "188 Notifications may be made on or after 1 July 2025"@en ;
    cml:realizedBy doc:sec-188 ;
    values:originalText "Division 3 of Part IVA applies in relation to a notification made on or after 1 July 2025." ;
    skos:definition "Division 3 of Part IVA applies in relation to a notification made on or after 1 July 2025."@en ;
    cml:integrityHash "b621368ba48fe39e2b6e9cfd06b51f084eb09cff1cc801ecde9d202701eac95b" ;
