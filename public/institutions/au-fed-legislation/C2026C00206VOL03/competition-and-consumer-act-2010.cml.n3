concept:competition-and-consumer-act-2010-sec-10-121-ss-4 a cml:Concept ;
    skos:prefLabel "10(4) 14  Exemptions apply only to certain activities"@en ;
    cml:realizedBy doc:sec-10-121-ss-4 ;
    values:originalText "(4) To avoid doubt, the exemptions provided by this Subdivision do not extend to any dealings between the parties to a conference agreement and a person who provides ancillary services on behalf of the provider of a scheduled cargo shipping service." ;
    skos:definition "(4) To avoid doubt, the exemptions provided by this Subdivision do not extend to any dealings between the parties to a conference agreement and a person who provides ancillary services on behalf of the provider of a scheduled cargo shipping service."@en ;
