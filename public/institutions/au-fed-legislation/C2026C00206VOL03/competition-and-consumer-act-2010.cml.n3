concept:competition-and-consumer-act-2010-sec-135e a cml:Concept ;
    skos:prefLabel "135E Use of force in executing a search warrant"@en ;
    cml:realizedBy doc:sec-135e ;
    values:originalText "In executing a search warrant, an inspector executing the warrant may use such force against persons and things as is necessary and reasonable in the circumstances." ;
    skos:definition "In executing a search warrant, an inspector executing the warrant may use such force against persons and things as is necessary and reasonable in the circumstances."@en ;
