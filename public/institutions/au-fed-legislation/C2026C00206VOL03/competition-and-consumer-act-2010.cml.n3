doc:sec-10-114-ss-2 a cof:Section ;
    cof:title "10(2) 07  Minimum levels of shipping services to be specified in" ;
    values:kind "subsection" ;
    values:originalText "(2) An inwards conference agreement must contain provisions specifying the minimum level of inwards liner cargo shipping services to be provided under the agreement. Note: See also paragraph 10.33(1)(b) and section 10.72A." ;
    cof:pageNumber "45"^^xsd:integer .

