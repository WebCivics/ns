doc:sec-151bz-ss-1 a cof:Section ;
    cof:title "151BZ(1) Criminal proceedings not to be brought for contraventions of" ;
    values:kind "subsection" ;
    values:originalText "(1) Criminal proceedings do not lie against a person only because the person:  (a) has contravened the competition rule, a record-keeping rule or a disclosure direction; or  (b) has attempted to contravene the competition rule, a record-keeping rule or a disclosure direction; or  (c) has been involved in a contravention of the competition rule, a record-keeping rule or a disclosure direction." ;
    cof:pageNumber "268"^^xsd:integer .

