concept:competition-and-consumer-act-2010-sec-153zc a cml:Concept ;
    skos:prefLabel "153ZC Acquisition of property"@en ;
    cml:realizedBy doc:sec-153zc ;
    values:originalText "Scope  (1) This section applies to the following:  (a) Divisions 5 and 6;  (b) any other provision of this Act, to the extent to which the provision relates to Division 5 or 6. Effect of provision  (2) The provision has no effect to the extent (if any) to which its operation would result in the acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) otherwise than on just terms (within the meaning of that paragraph)." ;
    skos:definition "Scope  (1) This section applies to the following:  (a) Divisions 5 and 6;  (b) any other provision of this Act, to the extent to which the provision relates to Division 5 or 6. Effect of provision  (2) The provision has no effect to the extent (if any) to which its operation would result in the acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) otherwise than on just terms (within the meaning of that paragraph)."@en ;
    cml:integrityHash "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000" ;
    cof:pageNumber "461"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-153zc-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-153zc-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.461" .
