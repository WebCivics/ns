concept:competition-and-consumer-act-2010-sec-151by-ss-3 a cml:Concept ;
    skos:prefLabel "151BY(3) Civil action for recovery of pecuniary penalties"@en ;
    cml:realizedBy doc:sec-151by-ss-3 ;
    values:originalText "(3) A proceeding under subsection (1) must not be instituted in relation to:  (a) a contravention of the competition rule; or  (b) attempting to contravene the competition rule; or  (c) aiding, abetting, counselling or procuring a person to contravene the competition rule; or  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "(3) A proceeding under subsection (1) must not be instituted in relation to:  (a) a contravention of the competition rule; or  (b) attempting to contravene the competition rule; or  (c) aiding, abetting, counselling or procuring a person to contravene the competition rule; or  Chapter 7  Further provisions relating to particular industries etc."@en ;
    cml:integrityHash "04b26db607f48dc76aee9d6e93132683b4e360738a2682a7d40e0e4b9df69def" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-151by ;
    cof:pageNumber "267"^^xsd:integer ;
    skos:note "Instituting a proceeding under subsection (1) is prohibited in relation to certain actions." ;
