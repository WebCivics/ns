    cml:premiseText "(a) an act or omission is an offence against this Act and is also an offence against an application law;" ;
    cml:conclusionText "the offender has been punished for the offence under the application law;" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-150h-ss-1 a cof:Section ;
    cof:title "150H(1) No doubling-up of liabilities" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) an act or omission is an offence against this Act and is also an offence against an application law; and  (b) the offender has been punished for the offence under the application law; the offender is not liable to be punished for the offence against this Act." ;
    cof:pageNumber "212"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-150h-ss-2 a cml:Concept ;
    skos:prefLabel "150H(2) No doubling-up of liabilities"@en ;
    cml:realizedBy doc:sec-150h-ss-2 ;
    values:originalText "(2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct." ;
    skos:definition "(2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct."@en ;
