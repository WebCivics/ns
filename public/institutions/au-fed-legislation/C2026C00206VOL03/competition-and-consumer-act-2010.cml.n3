concept:competition-and-consumer-act-2010-sec-154zp-ss-6 a cml:Concept ;
    skos:prefLabel "154ZP(6) Application for approval as designated complainant"@en ;
    cml:realizedBy doc:sec-154zp-ss-6 ;
    values:originalText "(6) If the application is withdrawn, it is taken never to have been made.  Chapter 8  Miscellaneous" ;
    skos:definition "(6) If the application is withdrawn, it is taken never to have been made.  Chapter 8  Miscellaneous"@en ;
    cml:integrityHash "4c0d27506f583959fa0084a648a9c8a82e36cf8d0f1ee41e7ac879faed9dd88f" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-154zp ;
    cof:pageNumber "527"^^xsd:integer ;
    skos:note "Withdrawal of application does not create a new event." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
