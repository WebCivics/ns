doc:sec-140f-ss-5 a cof:Section ;
    cof:title "140F(5) How duty is imposed" ;
    values:kind "subsection" ;
    values:originalText "(5) The duty is taken to be imposed by this Act in accordance with subsection (3) only to the extent to which imposing the duty:  (a) is within the legislative powers of the Commonwealth; and  (b) is consistent with the constitutional doctrines restricting the duties that may be imposed on the entity." ;
    cof:pageNumber "203"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-140f-ss-6 a cml:Concept ;
    skos:prefLabel "140F(6) How duty is imposed"@en ;
    cml:realizedBy doc:sec-140f-ss-6 ;
    values:originalText "(6) Subsections (1) to (5) do not limit section 140E. 140G  When an application law imposes a duty  For the purposes of this Part, an application law imposes a duty on a Commonwealth entity if:  (a) the law confers a function or power on the entity; and  (b) the circumstances in which the function or power is conferred give rise to an obligation on the entity to perform the function or to exercise the power." ;
    skos:definition "(6) Subsections (1) to (5) do not limit section 140E. 140G  When an application law imposes a duty  For the purposes of this Part, an application law imposes a duty on a Commonwealth entity if:  (a) the law confers a function or power on the entity; and  (b) the circumstances in which the function or power is conferred give rise to an obligation on the entity to perform the function or to exercise the power."@en ;
    cml:integrityHash "2832342ce6713c704b67471b791d7fae0d14ee35818255f3538c844f12ea574b" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-140f ;
    cof:pageNumber "203"^^xsd:integer ;
    skos:note "Application law imposes a duty on Commonwealth entity if it confers a function or power." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.203" ;
