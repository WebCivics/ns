doc:sec-153v-ss-1 a cof:Section ;
    cof:title "153V(1) Commission may vary or revoke no Treasurer action notice" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commission may, in writing, vary or revoke a no Treasurer action notice." ;
    cof:pageNumber "448"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-153v-ss-2 a cml:Concept ;
    skos:prefLabel "153V(2) Commission may vary or revoke no Treasurer action notice"@en ;
    cml:realizedBy doc:sec-153v-ss-2 ;
    values:originalText "(2) The Commission cannot make a variation or revocation under subsection (1) later than 45 days after:  (a) unless paragraph (b) applies—the day on which the Commission made the no Treasurer action notice; or  (b) if there has been a previous variation of the no Treasurer action notice under this section—the day on which the Commission made the previous variation." ;
    skos:definition "(2) The Commission cannot make a variation or revocation under subsection (1) later than 45 days after:  (a) unless paragraph (b) applies—the day on which the Commission made the no Treasurer action notice; or  (b) if there has been a previous variation of the no Treasurer action notice under this section—the day on which the Commission made the previous variation."@en ;
    cml:integrityHash "1cd667900e6eb0d0a267e690687341f203fa0ebacad37a752f1891a94550eb78" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-153v ;
    cof:pageNumber "448"^^xsd:integer ;
    skos:note "Commission must provide notice within 45 days of making a variation or revocation." ;
    dc:description "Notice" ;
