concept:competition-and-consumer-act-2010-sec-10-123 a cml:Concept ;
    skos:prefLabel "10 16  Exemptions do not apply to variations of conference"@en ;
    cml:realizedBy doc:sec-10-123 ;
    values:originalText "agreement unless varying agreement registered  Where a registered conference agreement is varied or otherwise affected by a varying conference agreement (other than an agreement that consists solely of freight rate charges), the exemptions provided by this Subdivision (other than sections 10.17A and 10.18A) apply only in relation to the operation of the registered conference agreement itself, and not that agreement as varied or otherwise affected, unless the varying conference agreement has been finally registered." ;
    skos:definition "agreement unless varying agreement registered  Where a registered conference agreement is varied or otherwise affected by a varying conference agreement (other than an agreement that consists solely of freight rate charges), the exemptions provided by this Subdivision (other than sections 10.17A and 10.18A) apply only in relation to the operation of the registered conference agreement itself, and not that agreement as varied or otherwise affected, unless the varying conference agreement has been finally registered."@en ;
    cml:integrityHash "cc52c7dd67a67b2ec3d3b2dbc29c10e2afb7facd6e8bff4e440ba951d28a419f" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "Exemptions apply only to operation of registered conference agreement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
