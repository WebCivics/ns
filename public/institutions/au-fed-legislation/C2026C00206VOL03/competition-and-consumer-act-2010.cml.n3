doc:sec-151cj-ss-2 a cof:Section ;
    cof:title "151CJ(2) Functions and powers of Tribunal" ;
    values:kind "subsection" ;
    values:originalText "(2) A decision by the Tribunal:  (a) affirming a decision of the Commission; or  (b) setting aside a decision of the Commission; or  (c) made in substitution for a decision of the Commission; or  (d) varying a decision of the Commission; is taken, for the purposes of this Act (other than this Division), to be a decision of the Commission. Conduct of review" ;
    cof:pageNumber "279"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-151cj-ss-3 a cml:Concept ;
    skos:prefLabel "151CJ(3) Functions and powers of Tribunal"@en ;
    cml:realizedBy doc:sec-151cj-ss-3 ;
    values:originalText "(3) For the purposes of a review by the Tribunal, the member of the Tribunal presiding at the review may require the Commission to give such information, make such reports and provide such other assistance to the Tribunal as the member specifies.  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "(3) For the purposes of a review by the Tribunal, the member of the Tribunal presiding at the review may require the Commission to give such information, make such reports and provide such other assistance to the Tribunal as the member specifies.  Chapter 7  Further provisions relating to particular industries etc."@en ;
    cml:integrityHash "e96bb81457a5a66f9f8d561feaf922830d1718309b71ead76a56a1f91b0fb5fe" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-151cj ;
    cof:pageNumber "279"^^xsd:integer ;
    skos:note "Commission must provide information, reports, and assistance to the Tribunal as specified by a member." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
