concept:competition-and-consumer-act-2010-sec-152em a cml:Concept ;
    skos:prefLabel "152EM Continuity of partnerships"@en ;
    cml:realizedBy doc:sec-152em ;
    values:originalText "For the purposes of this Part, a change in the composition of a partnership does not affect the continuity of the partnership." ;
