    values:originalText "(1) The Chairperson may, by writing, appoint a member of the staff assisting the Commission to be an inspector. Staff member to have suitable qualifications and experience" ;
    cof:pageNumber "494"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-154b-ss-2 a cml:Concept ;
    skos:prefLabel "154B(2) Appointment of inspectors"@en ;
    cml:realizedBy doc:sec-154b-ss-2 ;
    values:originalText "(2) The Chairperson must not do so unless he or she is satisfied that the staff member has suitable qualifications and experience to properly exercise the powers of an inspector. Inspector to comply with Chairperson’s directions" ;
    skos:definition "(2) The Chairperson must not do so unless he or she is satisfied that the staff member has suitable qualifications and experience to properly exercise the powers of an inspector. Inspector to comply with Chairperson’s directions"@en ;
    cml:integrityHash "4a1ae83987667805375d155ab28881d0556bb27264aabc081aeec8451c01cac0" ;
