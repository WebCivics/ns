concept:competition-and-consumer-act-2010-sec-153f a cml:Concept ;
    skos:prefLabel "153F Prohibited conduct—electricity financial contract liquidity"@en ;
    cml:realizedBy doc:sec-153f ;
    values:originalText "A corporation contravenes this section if:  (a) any of the following conditions are satisfied:  (i) the corporation generates electricity;  (ii) a body corporate that is related to the corporation generates electricity; and  (b) the corporation does any of the following:  (i) fails to offer electricity financial contracts;  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "A corporation contravenes this section if:  (a) any of the following conditions are satisfied:  (i) the corporation generates electricity;  (ii) a body corporate that is related to the corporation generates electricity; and  (b) the corporation does any of the following:  (i) fails to offer electricity financial contracts;  Chapter 7  Further provisions relating to particular industries etc."@en ;
    cml:integrityHash "dbd7f110760a8f7b21b23e001caa563ef43e97a2ead22e47f94a5e1fcacadd84" ;
    cof:pageNumber "435"^^xsd:integer ;
