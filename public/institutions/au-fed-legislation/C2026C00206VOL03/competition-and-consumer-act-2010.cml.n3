doc:sec-153v-ss-4 a cof:Section ;
    cof:title "153V(4) Commission may vary or revoke no Treasurer action notice" ;
    values:kind "subsection" ;
    values:originalText "(4) The Commission cannot make a revocation under subsection (1) unless the Commission is satisfied that the conditions in subsections (5) and (6) are met." ;
    cof:pageNumber "448"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-153v-ss-5 a cml:Concept ;
    skos:prefLabel "153V(5) Commission may vary or revoke no Treasurer action notice"@en ;
    cml:realizedBy doc:sec-153v-ss-5 ;
    values:originalText "(5) The condition in this subsection is met if the Commission reasonably believes that it is appropriate to:  (a) give the Treasurer a prohibited conduct recommendation in respect of the prohibited conduct notice; or  (b) give the corporation a new prohibited conduct notice in respect of the prohibited conduct identified in the prohibited conduct notice (in accordance with subparagraph 153P(2)(c)(ii))." ;
    skos:definition "(5) The condition in this subsection is met if the Commission reasonably believes that it is appropriate to:  (a) give the Treasurer a prohibited conduct recommendation in respect of the prohibited conduct notice; or  (b) give the corporation a new prohibited conduct notice in respect of the prohibited conduct identified in the prohibited conduct notice (in accordance with subparagraph 153P(2)(c)(ii))."@en ;
    cml:integrityHash "e7d143fec1d0ad98c8549663d5e60133649d6e42b362c0f76159a6251f220372" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-153v ;
    cof:pageNumber "448"^^xsd:integer ;
    skos:note "Commission may give Treasurer a prohibited conduct recommendation or corporation a new notice." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.448" ;
