    values:partOf concept:competition-and-consumer-act-2010-sec-10-121 ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Dealing between parties to a conference agreement and ancillary services provider is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
