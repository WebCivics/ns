doc:sec-171a-ss-1 a cof:Section ;
    cof:title "171A(1) Charges by the Commission" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commission may make a charge of an amount, or at a rate, determined by the Commission for:  (a) supplying a person with material published by the Commission in the course of carrying out its functions or exercising its powers; or  (b) permitting a person to attend or take part in a prescribed activity arranged by or on behalf of the Commission for the purpose of carrying out any of its functions." ;
    cof:pageNumber "582"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-171a-ss-2 a cml:Concept ;
    skos:prefLabel "171A(2) Charges by the Commission"@en ;
    cml:realizedBy doc:sec-171a-ss-2 ;
    values:originalText "(2) Where:  (a) the Commission provides a discretionary service for a person; and  (b) this Act does not otherwise provide for a charge for the service; the Commission may make a charge of such amount, or at such a rate, as is agreed between the Commission and the person." ;
    skos:definition "(2) Where:  (a) the Commission provides a discretionary service for a person; and  (b) this Act does not otherwise provide for a charge for the service; the Commission may make a charge of such amount, or at such a rate, as is agreed between the Commission and the person."@en ;
