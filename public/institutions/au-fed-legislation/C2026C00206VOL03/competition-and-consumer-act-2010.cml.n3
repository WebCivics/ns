concept:competition-and-consumer-act-2010-sec-152bc-ss-4c a cml:Concept ;
    skos:prefLabel "152BC(4C) Access determinations"@en ;
    cml:realizedBy doc:sec-152bc-ss-4c ;
    values:originalText "(4C) If an access determination is expressed to be an NBN-specific access determination, the access determination does not apply in relation to access to a declared service to the extent to which the service is supplied, or is capable of being supplied, by a person other than an NBN corporation." ;
    skos:definition "(4C) If an access determination is expressed to be an NBN-specific access determination, the access determination does not apply in relation to access to a declared service to the extent to which the service is supplied, or is capable of being supplied, by a person other than an NBN corporation."@en ;
    cml:integrityHash "bafd96656c807c1f9fde3ad092d9e69dbfcbf461b37b97150106f87e9ada6c8f" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-152bc ;
    cof:pageNumber "342"^^xsd:integer ;
    skos:note "Access determination does not apply to access supplied by a person other than an NBN corporation." ;
    cml:curationStatus cml:Proposed ;
