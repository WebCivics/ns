concept:competition-and-consumer-act-2010-sec-140j a cml:Concept ;
    skos:prefLabel "140J No doubling-up of liabilities"@en ;
    cml:realizedBy doc:sec-140j ;
    values:originalText "(1) If:  (a) an act or omission is an offence against this Act and is also an offence against an application law; and  (b) the offender has been punished for the offence under the application law; the offender is not liable to be punished for the offence against this Act.  Other provisions  Chapter 6 Application of the Australian Consumer Law as a law of a State or Territory  Part XIAA  Section 140K  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct." ;
    skos:definition "(1) If:  (a) an act or omission is an offence against this Act and is also an offence against an application law; and  (b) the offender has been punished for the offence under the application law; the offender is not liable to be punished for the offence against this Act.  Other provisions  Chapter 6 Application of the Australian Consumer Law as a law of a State or Territory  Part XIAA  Section 140K  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct."@en ;
    cml:integrityHash "d8bc2dec49bc065df0dd3debd9cb539d3165f21644fb749b47feca8b2af003bd" ;
    cof:pageNumber "204"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-140j-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-140j-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.204" .
