concept:competition-and-consumer-act-2010-sec-151ck a cml:Concept ;
    skos:prefLabel "151CK Provisions that do not apply in relation to a Tribunal review"@en ;
    cml:realizedBy doc:sec-151ck ;
    values:originalText "Division 1 of Part IX does not apply in relation to a review by the Tribunal of a decision of the Commission of a kind mentioned in section 151CI.  Further provisions relating to particular industries etc.  Chapter 7 The Telecommunications Industry: Anti-competitive conduct and record-keeping rules" ;
    skos:definition "Division 1 of Part IX does not apply in relation to a review by the Tribunal of a decision of the Commission of a kind mentioned in section 151CI.  Further provisions relating to particular industries etc.  Chapter 7 The Telecommunications Industry: Anti-competitive conduct and record-keeping rules"@en ;
    cml:integrityHash "b5fc88cd545ca532e8225e117cbcd6a8914abb37b46af206f9ab145bb6637dc8" ;
    cof:pageNumber "280"^^xsd:integer ;
