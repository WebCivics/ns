concept:competition-and-consumer-act-2010-sec-135s a cml:Concept ;
    skos:prefLabel "135S Embargo notices"@en ;
    cml:realizedBy doc:sec-135s ;
    values:originalText "(1) An inspector who enters premises under a search warrant may give an embargo notice to the occupier of the premises.  (2) The inspector may give the notice to the occupier of the premises:  (a) by causing a copy of the notice to be served on the occupier; or  Chapter 6  Other provisions" ;
    skos:definition "(1) An inspector who enters premises under a search warrant may give an embargo notice to the occupier of the premises.  (2) The inspector may give the notice to the occupier of the premises:  (a) by causing a copy of the notice to be served on the occupier; or  Chapter 6  Other provisions"@en ;
    cml:integrityHash "bee81da9c6a322671027e54e43e2594408838f3d7b1adde2e76aeae16bd0a9ac" ;
    cof:pageNumber "165"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-135s-ss-1 ;
