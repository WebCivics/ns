doc:sec-152am-ss-2 a cof:Section ;
    cof:title "152AM(2) Inquiries about proposals to declare services" ;
    values:kind "subsection" ;
    values:originalText "(2) The Commission may hold the inquiry:  (a) on its own initiative; or  (b) if requested in writing to do so by a person." ;
    cof:pageNumber "313"^^xsd:integer .

