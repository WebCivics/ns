concept:competition-and-consumer-act-2010-sec-10-210 a cml:Concept ;
    skos:prefLabel "10 57(1) and 10.63(1); and"@en ;
    cml:realizedBy doc:sec-10-210 ;
    values:originalText "(b) decisions made by it under subsections 10.48(2), 10.48(2A) and 10.58(2) to hold investigations.  Other provisions  Chapter 6 International liner cargo shipping  Part X Miscellaneous  Division 15  Section 10.88  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "(b) decisions made by it under subsections 10.48(2), 10.48(2A) and 10.58(2) to hold investigations.  Other provisions  Chapter 6 International liner cargo shipping  Part X Miscellaneous  Division 15  Section 10.88  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "81bc294d1ad33a478c41407686fda88e77eb795572a27c450284f58e80e1a395" ;
    cof:pageNumber "114"^^xsd:integer ;
