concept:competition-and-consumer-act-2010-sec-154zb a cml:Concept ;
    skos:prefLabel "154ZB Operation of electronic equipment at premises"@en ;
    cml:realizedBy doc:sec-154zb ;
    values:originalText "A person may operate electronic equipment at premises in order to exercise a power under this Part only if he or she believes on reasonable grounds that the operation of the equipment can be carried out without damage to the equipment." ;
    skos:definition "A person may operate electronic equipment at premises in order to exercise a power under this Part only if he or she believes on reasonable grounds that the operation of the equipment can be carried out without damage to the equipment."@en ;
    cml:integrityHash "7456acfc44804491627e7ea9aa1f5e252fbc5d7f4de4c2486c748a6da028ab79" ;
    cof:pageNumber "516"^^xsd:integer ;
    skos:note "Permission to operate electronic equipment under reasonable grounds." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.516" ;
    cml:asserts concept:competition-and-consumer-act-2010-sec-154zb-norm .
concept:competition-and-consumer-act-2010-sec-154zb-norm a values:Permission ;
    cml:modality cml:Deontic ;
