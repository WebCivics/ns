doc:sec-139a-ss-2 a cof:Section ;
    cof:title "139A(2) Terms excluding consumer guarantees from supplies of" ;
    values:kind "subsection" ;
    values:originalText "(2) Recreational services are services that consist of participation in:  (a) a sporting activity or a similar leisure time pursuit; or  (b) any other activity that:  (i) involves a significant degree of physical exertion or physical risk; and  (ii) is undertaken for the purposes of recreation, enjoyment or leisure." ;
    cof:pageNumber "191"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-139a-ss-3 a cml:Concept ;
    skos:prefLabel "139A(3) Terms excluding consumer guarantees from supplies of"@en ;
    cml:realizedBy doc:sec-139a-ss-3 ;
    values:originalText "(3) This section does not apply unless the exclusion, restriction or modification is limited to liability for:  (a) death; or  Chapter 6  Other provisions" ;
    skos:definition "(3) This section does not apply unless the exclusion, restriction or modification is limited to liability for:  (a) death; or  Chapter 6  Other provisions"@en ;
    cml:integrityHash "40ef49972499fe688bb7bc8a122caf3b16b4ec83e734a5391c0899c521ac1db8" ;
