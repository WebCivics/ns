concept:competition-and-consumer-act-2010-sec-154zj a cml:Concept ;
    skos:prefLabel "154ZJ Notice—no further action on complaint—contents"@en ;
    cml:realizedBy doc:sec-154zj ;
    values:originalText "A notice given under subsection 154ZH(1) must set out the following:  (a) a summary of the complaint;  (b) which of subsections 154ZH(2), (3), (4) and (5) apply in relation to the complaint;  (c) the reasons for the Commission’s decision.  Miscellaneous  Chapter 8 Designated complaints  Part XIE Commission handling of designated complaints  Division 2  Section 154ZK  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "A notice given under subsection 154ZH(1) must set out the following:  (a) a summary of the complaint;  (b) which of subsections 154ZH(2), (3), (4) and (5) apply in relation to the complaint;  (c) the reasons for the Commission’s decision.  Miscellaneous  Chapter 8 Designated complaints  Part XIE Commission handling of designated complaints  Division 2  Section 154ZK  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "5750621a82f0c52a1e45b5acf95609aec53b340b1b8a570d753a750e7d6b1c6b" ;
    cof:pageNumber "522"^^xsd:integer ;
    skos:note "Notice must set out a summary of the complaint, reasons for Commission's decision, and which subsections apply." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
