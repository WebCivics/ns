doc:sec-151by-ss-1 a cof:Section ;
    cof:title "151BY(1) Civil action for recovery of pecuniary penalties" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commission may institute a proceeding in the Federal Court for the recovery on behalf of the Commonwealth of a pecuniary penalty referred to in section 151BX." ;
    cof:pageNumber "267"^^xsd:integer .

