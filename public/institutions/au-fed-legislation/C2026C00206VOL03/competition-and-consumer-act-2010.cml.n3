doc:sec-154zk-ss-4 a cof:Section ;
    cof:title "154ZK(4) Notice—further action to deal with complaint" ;
    values:kind "subsection" ;
    values:originalText "(4) However, subsection (3) does not apply if the Commission is satisfied that circumstances prescribed in the designated complaints determination apply." ;
    cof:pageNumber "523"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-154zk-ss-5 a cml:Concept ;
    skos:prefLabel "154ZK(5) Notice—further action to deal with complaint"@en ;
    cml:realizedBy doc:sec-154zk-ss-5 ;
    values:originalText "(5) If subsection (4) applies, the Commission must use its best endeavours to notify this to the entity that made the complaint (even if the entity has ceased to be a designated complainant).  Chapter 8  Miscellaneous" ;
    skos:definition "(5) If subsection (4) applies, the Commission must use its best endeavours to notify this to the entity that made the complaint (even if the entity has ceased to be a designated complainant).  Chapter 8  Miscellaneous"@en ;
    cml:integrityHash "1215cd643cb56f8c9a873cf546e237bb2d39b41a7c0a97305ef313de18029299" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-154zk ;
    cof:pageNumber "523"^^xsd:integer ;
    skos:note "Commission must notify entity of complaint" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
