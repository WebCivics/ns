    values:partOf concept:competition-and-consumer-act-2010-sec-10-158 ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Registrar notation upon direction revocation" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
