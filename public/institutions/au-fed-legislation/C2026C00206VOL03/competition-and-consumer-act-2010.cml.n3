    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-153-ss-6 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-153-ss-7 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sec-10-153-ss-8 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
