concept:competition-and-consumer-act-2010-sec-151ae a cml:Concept ;
    skos:prefLabel "151AE Additional operation of Part"@en ;
    cml:realizedBy doc:sec-151ae ;
    values:originalText "(1) Without prejudice to its effect apart from this section, this Part also has effect as provided by this section.  (2) This Part has, by force of this subsection, the effect it would have if:  (a) any references in this Part to a carrier were, by express provision, confined to a carrier that is a corporation; and  Chapter 7  Further provisions relating to particular industries etc." ;
    skos:definition "(1) Without prejudice to its effect apart from this section, this Part also has effect as provided by this section.  (2) This Part has, by force of this subsection, the effect it would have if:  (a) any references in this Part to a carrier were, by express provision, confined to a carrier that is a corporation; and  Chapter 7  Further provisions relating to particular industries etc."@en ;
    cml:integrityHash "05a53134720a4b876663885f39e75db85b84dfe1abd2e42b2dc07a0e013e8841" ;
    cof:pageNumber "217"^^xsd:integer ;
