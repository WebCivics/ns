concept:competition-and-consumer-act-2010-sec-10-188 a cml:Concept ;
    skos:prefLabel "10 74  Deletion of entries wrongly existing in certain registers"@en ;
    cml:realizedBy doc:sec-10-188 ;
    values:originalText "Where the Registrar is satisfied that an entry wrongly exists in a register kept by the Registrar, the Registrar shall delete the entry." ;
