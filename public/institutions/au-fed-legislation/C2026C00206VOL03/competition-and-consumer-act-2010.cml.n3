concept:competition-and-consumer-act-2010-sec-152bc-ss-5 a cml:Concept ;
    skos:prefLabel "152BC(5) Access determinations"@en ;
    cml:realizedBy doc:sec-152bc-ss-5 ;
    values:originalText "(5) An access determination may make different provision with respect to:  (a) different carriers or carriage service providers; or  (b) different classes of carriers or carriage service providers; or  (c) different access seekers; or  (d) different classes of access seekers." ;
