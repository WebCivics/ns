concept:competition-and-consumer-act-2010-sec-154k a cml:Concept ;
    skos:prefLabel "154K Authorisation of officers assisting"@en ;
    cml:realizedBy doc:sec-154k ;
    values:originalText "The executing officer for a search warrant may, by writing, authorise a member of the Australian Federal Police, a member of the staff assisting the Commission, or a consultant, to assist in executing the warrant." ;
