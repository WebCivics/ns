doc:sec-154r-ss-3 a cof:Section ;
    cof:title "154R(3) Answering of questions or producing evidential material" ;
    values:kind "subsection" ;
    values:originalText "(3) An individual is not excused from answering a question or producing evidential material on the ground that the answer, or the production of the material, might tend to incriminate the individual or make the individual liable to a penalty." ;
    cof:pageNumber "506"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-154r-ss-4 a cml:Concept ;
    skos:prefLabel "154R(4) Answering of questions or producing evidential material"@en ;
    cml:realizedBy doc:sec-154r-ss-4 ;
    values:originalText "(4) However, the answer is not admissible in evidence against the individual in any criminal proceedings, other than:  (a) proceedings for an offence against subsection (2); or  (b) proceedings for an offence against section 137.1, 137.2 or" ;
    skos:definition "(4) However, the answer is not admissible in evidence against the individual in any criminal proceedings, other than:  (a) proceedings for an offence against subsection (2); or  (b) proceedings for an offence against section 137.1, 137.2 or"@en ;
    cml:integrityHash "9406dfbb4abaa93184ba3c9a6a0ff1fef5ca99df97ca74e139d4d440af1f487d" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-154r ;
    cof:pageNumber "506"^^xsd:integer ;
    skos:note "Answer must be provided in certain circumstances" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
