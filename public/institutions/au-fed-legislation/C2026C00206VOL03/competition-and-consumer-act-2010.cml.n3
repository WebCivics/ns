concept:competition-and-consumer-act-2010-sec-10-213-ss-4 a cml:Concept ;
    skos:prefLabel "10(4) 89  Disclosure of confidential information"@en ;
    cml:realizedBy doc:sec-10-213-ss-4 ;
    values:originalText "(4) An officer shall not:  (a) make a record of any information to which this section applies;  (b) divulge or communicate to a person any information to which this section applies; or  (c) give a person a part of a document to which this section applies; unless the record is made, the information divulged or communicated or the part of the document given:  (d) for the purposes of this Act; or  (e) in relation to the performance of a duty or the exercise of a power under or in relation to this Act. Penalty: $5,000 or imprisonment for 2 years, or both." ;
    skos:definition "(4) An officer shall not:  (a) make a record of any information to which this section applies;  (b) divulge or communicate to a person any information to which this section applies; or  (c) give a person a part of a document to which this section applies; unless the record is made, the information divulged or communicated or the part of the document given:  (d) for the purposes of this Act; or  (e) in relation to the performance of a duty or the exercise of a power under or in relation to this Act. Penalty: $5,000 or imprisonment for 2 years, or both."@en ;
    cml:integrityHash "be813b8defa7bb57331ac96ba8f3051944fdcff049a6dabbb986cbfb12520c05" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-10-213 ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "Officer shall not divulge confidential information without a valid reason." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
