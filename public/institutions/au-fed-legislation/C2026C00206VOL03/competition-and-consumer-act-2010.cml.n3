concept:competition-and-consumer-act-2010-sec-150c a cml:Concept ;
    skos:prefLabel "150C The Competition Code"@en ;
    cml:realizedBy doc:sec-150c ;
    values:originalText "(1) The Competition Code consists of:  (a) the Schedule version of Part IV;  (b) the remaining provisions of this Act (except sections 2A, 5, 6 and 172), so far as they would relate to the Schedule version if the Schedule version were substituted for Part IV;  Chapter 6  Other provisions" ;
    skos:definition "(1) The Competition Code consists of:  (a) the Schedule version of Part IV;  (b) the remaining provisions of this Act (except sections 2A, 5, 6 and 172), so far as they would relate to the Schedule version if the Schedule version were substituted for Part IV;  Chapter 6  Other provisions"@en ;
    cml:integrityHash "d4620a2579831d4778015e59920e3abd549a2506f8f64f612ef0be52bc56f4c7" ;
    cof:pageNumber "207"^^xsd:integer ;
