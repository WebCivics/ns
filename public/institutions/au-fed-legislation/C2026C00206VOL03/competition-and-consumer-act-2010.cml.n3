doc:sec-10-202-ss-1 a cof:Section ;
    cof:title "10(1) 82E  Functions and powers of Tribunal" ;
    values:kind "subsection" ;
    values:originalText "(1) On a review of a decision of the Minister of a kind mentioned in section 10.82D, the Tribunal may make a decision affirming, setting aside or varying the decision of the Minister and, for the purposes of the review, may perform all the functions and exercise all the powers of the Minister." ;
    cof:pageNumber "111"^^xsd:integer .

