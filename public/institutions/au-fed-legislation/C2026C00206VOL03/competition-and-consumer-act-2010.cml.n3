concept:competition-and-consumer-act-2010-sec-152aq-ss-1 a cml:Concept ;
    skos:prefLabel "152AQ(1) Register of declared services"@en ;
    cml:realizedBy doc:sec-152aq-ss-1 ;
    values:originalText "(1) If the operation of any or all of the following provisions:  (a) subsection 152AL(9), (10), (11), (12), (13) or (14);  (b) subsection 152ALA(10), (11), (12) or (13); would result in an acquisition of property from a person otherwise than on just terms, the Commonwealth is liable to pay a reasonable amount of compensation to the person." ;
    skos:definition "(1) If the operation of any or all of the following provisions:  (a) subsection 152AL(9), (10), (11), (12), (13) or (14);  (b) subsection 152ALA(10), (11), (12) or (13); would result in an acquisition of property from a person otherwise than on just terms, the Commonwealth is liable to pay a reasonable amount of compensation to the person."@en ;
    cml:integrityHash "c9677a7cd198e7f2174a904977d7fd753714e339a5f7dc1f4be509ba89dd2646" ;
    values:partOf concept:competition-and-consumer-act-2010-sec-152aq ;
    cof:pageNumber "314"^^xsd:integer ;
    skos:note "Commonwealth liable for compensation if acquisition of property results in unfair terms. The Commission must keep a Register in relation to declarations under section 152AL." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.314" ;
