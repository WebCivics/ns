doc:sec-10-186 a cof:Section ;
    cof:title "10 72D  Conditions of exemption order" ;
    values:kind "section" ;
    values:originalText "An exemption order may be expressed to be subject to such conditions as are specified in the order.  Other provisions  Chapter 6 International liner cargo shipping  Part X General provisions relating to registers and conference agreement files  Division 13  Section 10.73  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    cof:pageNumber "104"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-10-187 a cml:Concept ;
    skos:prefLabel "10 73  Form of registers and conference agreement files"@en ;
    cml:realizedBy doc:sec-10-187 ;
    values:originalText "(1) The registers and conference agreement files kept by the Registrar may be kept in such form (whether or not documentary form) as the Registrar considers appropriate.  (2) The register of Commission investigations may be kept in such form (whether or not documentary form) as the Commission considers appropriate." ;
    skos:definition "(1) The registers and conference agreement files kept by the Registrar may be kept in such form (whether or not documentary form) as the Registrar considers appropriate.  (2) The register of Commission investigations may be kept in such form (whether or not documentary form) as the Commission considers appropriate."@en ;
