concept:competition-and-consumer-act-2010-sec-140b a cml:Concept ;
    skos:prefLabel "140B The applied Australian Consumer Law"@en ;
    cml:realizedBy doc:sec-140b ;
    values:originalText "The applied Australian Consumer Law consists of:  (a) Schedule 2; and  (b) the regulations made under section 139G of this Act." ;
