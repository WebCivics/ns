concept:competition-and-consumer-act-2010-sec-10-153-ss-7 a cml:Concept ;
    skos:prefLabel "10(7) 44  Powers exercisable by Minister in relation to registered"@en ;
    cml:realizedBy doc:sec-10-153-ss-7 ;
    values:originalText "(7) A direction under subsection (1) must be given in writing, and the Registrar shall serve a copy of the direction on the parties to the conference agreement concerned." ;
