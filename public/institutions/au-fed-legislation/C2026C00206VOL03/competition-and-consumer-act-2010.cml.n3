concept:competition-and-consumer-act-2010-sec-181 a cml:Concept ;
    skos:prefLabel "181 Amendment of the definition of competition"@en ;
    cml:realizedBy doc:sec-181 ;
    values:originalText "The repeal and substitution of the definition of competition in subsection 4(1) made by Schedule 1 to the amending Act applies in relation to conduct engaged in at or after the commencement time." ;
