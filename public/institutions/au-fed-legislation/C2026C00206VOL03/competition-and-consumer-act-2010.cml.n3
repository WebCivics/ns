doc:sec-131c-ss-1 a cof:Section ;
    cof:title "131C(1) Saving of other laws and remedies" ;
    values:kind "subsection" ;
    values:originalText "(1) This Part is not intended to exclude or limit the concurrent operation of any law, whether written or unwritten, of a State or a Territory." ;
    cof:pageNumber "124"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-131c-ss-2 a cml:Concept ;
    skos:prefLabel "131C(2) Saving of other laws and remedies"@en ;
    cml:realizedBy doc:sec-131c-ss-2 ;
    values:originalText "(2) Section 73 of the Australian Consumer Law does not operate in a State or a Territory to the extent necessary to ensure that no inconsistency arises between:  (a) that section; and  (b) a provision of a law of the State or Territory that would, but for this subsection, be inconsistent with that section." ;
    skos:definition "(2) Section 73 of the Australian Consumer Law does not operate in a State or a Territory to the extent necessary to ensure that no inconsistency arises between:  (a) that section; and  (b) a provision of a law of the State or Territory that would, but for this subsection, be inconsistent with that section."@en ;
