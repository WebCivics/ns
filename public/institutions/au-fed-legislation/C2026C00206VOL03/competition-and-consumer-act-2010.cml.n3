doc:sec-154zf-ss-2 a cof:Section ;
    cof:title "154ZF(2) Designated complaints" ;
    values:kind "subsection" ;
    values:originalText "(2) The complaint must:  (a) be in writing; and  (b) if the Commission has approved a manner for making the complaint—be made in that manner; and  (c) if the Commission has approved a form for making the complaint:  (i) be made in the approved form; and  (ii) include the information required by the form; and  (iii) be accompanied by any documents required by the form; and  (d) meet the requirements (if any) prescribed in the designated complaints determination relating to the number and types of designated complaints that a designated complainant may make during a specified period." ;
    cof:pageNumber "520"^^xsd:integer .

concept:competition-and-consumer-act-2010-sec-154zf-ss-3 a cml:Concept ;
    skos:prefLabel "154ZF(3) Designated complaints"@en ;
    cml:realizedBy doc:sec-154zf-ss-3 ;
    values:originalText "(3) The complaint is a designated complaint starting from the day it meets the requirements mentioned in subsection (2)." ;
