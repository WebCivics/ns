    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134b",
      "@type": "cml:Concept",
      "skos:prefLabel": "134B Matters to be included in an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.145",
      "values:originalText": "An infringement notice must:\n\n(a) be identified by a unique number; and\n\n(b) state the day on which it is issued; and\n\n(c) state the name and address of the person to whom it is issued;\nand\n\n(d) identify the Commission; and\n\n(e) state how the Commission may be contacted; and\n\n(f) give details of the alleged contravention by the person,\nincluding:\n\n(i) the date of the alleged contravention; and\n\n(ii) the particular infringement notice provision that was\nallegedly contravened; and\n\nChapter 6  Other provisions",
      "skos:definition": "An infringement notice must:\n\n(a) be identified by a unique number; and\n\n(b) state the day on which it is issued; and\n\n(c) state the name and address of the person to whom it is issued;\nand\n\n(d) identify the Commission; and\n\n(e) state how the Commission may be contacted; and\n\n(f) give details of the alleged contravention by the person,\nincluding:\n\n(i) the date of the alleged contravention; and\n\n(ii) the particular infringement notice provision that was\nallegedly contravened; and\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134b-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "04cf7ae03cc1ee3c38d9793a099e90a915440c234dfd492c7059edb5b68a04f6",
      "skos:note": "Requirements for an infringement notice",
      "dc:description": "Details of the alleged contravention, including date and provision number"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134b",
      "@type": "cof:Section",
      "cof:title": "134B Matters to be included in an infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 145,
      "values:originalText": "An infringement notice must:\n\n(a) be identified by a unique number; and\n\n(b) state the day on which it is issued; and\n\n(c) state the name and address of the person to whom it is issued;\nand\n\n(d) identify the Commission; and\n\n(e) state how the Commission may be contacted; and\n\n(f) give details of the alleged contravention by the person,\nincluding:\n\n(i) the date of the alleged contravention; and\n\n(ii) the particular infringement notice provision that was\nallegedly contravened; and\n\nChapter 6  Other provisions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-134b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Requires specific information to be included in the notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134c",
      "@type": "cml:Concept",
      "skos:prefLabel": "134C Amount of penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.146",
      "values:originalText": "The penalty to be specified in an infringement notice that is to be\nissued to a person, in relation to an alleged contravention of a\nprovision of the Australian Consumer Law, must be a penalty\nequal to the amount worked out using the following table:\n\nAmount of penalty\nItem\nIf the infringement notice is\nfor an alleged contravention\nof one of the following\nprovisions of the Australian\nConsumer Law ...\nthe amount is ...\na provision of Part 2-2\n(a) if the person is a listed\ncorporation—600\npenalty units; or\n(b) if the person is a body\ncorporate other than a\nlisted corporation—60\npenalty units; or\n(c) if the person is not a\nbody corporate—12\npenalty units.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of the Commonwealth  Part XI\nInfringement notices  Division 5\n\nSection 134C\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nAmount of penalty\nItem\nIf the infringement notice is\nfor an alleged contravention\nof one of the following\nprovisions of the Australian\nConsumer Law ...\nthe amount is ...\na provision of Part 3-1 (other\nthan subsection 32(1), 35(1),\n36(1), (2) or (3), section 40 or\n43 or subsection 47(1))\n(a) if the person is a listed\ncorporation—600\npenalty units; or\n(b) if the person is a body\ncorporate other than a\nlisted corporation—60\npenalty units; or\n(c) if the person is not a\nbody corporate—12\npenalty units.\nsubsection 47(1)\n(a) if the person is a body\ncorporate—10 penalty\nunits; or\n(b) if the person is not a\nbody corporate—2\npenalty units.\nsubsection 66(2)\n(a) if the person is a body\ncorporate—55 penalty\nunits; or\n(b) if the person is not a\nbody corporate—11\npenalty units.\na provision of Division 2 of",
      "skos:definition": "The penalty to be specified in an infringement notice that is to be\nissued to a person, in relation to an alleged contravention of a\nprovision of the Australian Consumer Law, must be a penalty\nequal to the amount worked out using the following table:\n\nAmount of penalty\nItem\nIf the infringement notice is\nfor an alleged contravention\nof one of the following\nprovisions of the Australian\nConsumer Law ...\nthe amount is ...\na provision of Part 2-2\n(a) if the person is a listed\ncorporation—600\npenalty units; or\n(b) if the person is a body\ncorporate other than a\nlisted corporation—60\npenalty units; or\n(c) if the person is not a\nbody corporate—12\npenalty units.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of the Commonwealth  Part XI\nInfringement notices  Division 5\n\nSection 134C\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nAmount of penalty\nItem\nIf the infringement notice is\nfor an alleged contravention\nof one of the following\nprovisions of the Australian\nConsumer Law ...\nthe amount is ...\na provision of Part 3-1 (other\nthan subsection 32(1), 35(1),\n36(1), (2) or (3), section 40 or\n43 or subsection 47(1))\n(a) if the person is a listed\ncorporation—600\npenalty units; or\n(b) if the person is a body\ncorporate other than a\nlisted corporation—60\npenalty units; or\n(c) if the person is not a\nbody corporate—12\npenalty units.\nsubsection 47(1)\n(a) if the person is a body\ncorporate—10 penalty\nunits; or\n(b) if the person is not a\nbody corporate—2\npenalty units.\nsubsection 66(2)\n(a) if the person is a body\ncorporate—55 penalty\nunits; or\n(b) if the person is not a\nbody corporate—11\npenalty units.\na provision of Division 2 of",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134c-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134c-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134c-logic-deontic-2"
        },
