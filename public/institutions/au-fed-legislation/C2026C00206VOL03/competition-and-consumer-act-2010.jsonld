    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154k",
      "@type": "cml:Concept",
      "skos:prefLabel": "154K Authorisation of officers assisting",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.504",
      "values:originalText": "The executing officer for a search warrant may, by writing,\nauthorise a member of the Australian Federal Police, a member of\nthe staff assisting the Commission, or a consultant, to assist in\nexecuting the warrant.",
      "skos:definition": "The executing officer for a search warrant may, by writing,\nauthorise a member of the Australian Federal Police, a member of\nthe staff assisting the Commission, or a consultant, to assist in\nexecuting the warrant.",
