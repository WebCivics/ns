      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.42",
      "values:originalText": "(6) The Registrar shall enter particulars of any nomination of a\ndesignated secondary shipper body for the purposes of\nsection 10.29, 10.41 or 10.52 in the register of designated shipper\nbodies.\n\nChapter 6  Other provisions",
      "skos:definition": "(6) The Registrar shall enter particulars of any nomination of a\ndesignated secondary shipper body for the purposes of\nsection 10.29, 10.41 or 10.52 in the register of designated shipper\nbodies.\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-10-111"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-111-ss-6-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-111-ss-6-logic-deontic-1"
        }
      ],
