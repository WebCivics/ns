    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-125-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Classifies the freight rate agreement as a permissible action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Sections 45AF, 45AJ and 45 do not apply to...",
      "cml:conclusionText": "...the making of freight rate charges in a freight rate agreement if..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-125-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Specifies the parties required for the exemption to apply",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the parties to the freight rate agreement are the same as the parties to the registered inwards conference agreement.",
      "cml:conclusionText": "...the parties to the registered inwards conference agreement."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-125-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(3) 17A  Exemptions from sections 45AF, 45AG, 45AJ, 45AK and 45",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-125-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.52",
      "values:originalText": "(3) Sections 45AG, 45AK and 45 do not apply to conduct engaged in\nby a party to a freight rate agreement, so far as the conduct gives\neffect to freight rate charges in the freight rate agreement, if:\n\n(a) the freight rates (including base freight rates, surcharges,\nrebates and allowances) specified in the freight rate\nagreement are for outwards liner cargo shipping services\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nExemptions from certain restrictive trade practice prohibitions  Division 5\n\nSection 10.18\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nprovided under a single registered outwards conference\nagreement after the end of 30 days after the last-mentioned\nagreement is finally registered; and\n\n(b) the parties to the freight rate agreement are the same as the\nparties to the registered outwards conference agreement.",
      "skos:definition": "(3) Sections 45AG, 45AK and 45 do not apply to conduct engaged in\nby a party to a freight rate agreement, so far as the conduct gives\neffect to freight rate charges in the freight rate agreement, if:\n\n(a) the freight rates (including base freight rates, surcharges,\nrebates and allowances) specified in the freight rate\nagreement are for outwards liner cargo shipping services\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nExemptions from certain restrictive trade practice prohibitions  Division 5\n\nSection 10.18\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nprovided under a single registered outwards conference\nagreement after the end of 30 days after the last-mentioned\nagreement is finally registered; and\n\n(b) the parties to the freight rate agreement are the same as the\nparties to the registered outwards conference agreement.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-10-125"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-125-ss-3-norm"
        }
      ],
      "cml:integrityHash": "de6c5b58f3fac658393dee98c2dc3a8ef598dab9be14616df8a6fe0044843b38",
      "skos:note": "Exemptions from certain restrictive trade practice prohibitions"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-125-ss-3",
      "@type": "cof:Section",
      "cof:title": "10(3) 17A  Exemptions from sections 45AF, 45AG, 45AJ, 45AK and 45",
      "values:kind": "subsection",
      "cof:pageNumber": 52,
      "values:originalText": "(3) Sections 45AG, 45AK and 45 do not apply to conduct engaged in\nby a party to a freight rate agreement, so far as the conduct gives\neffect to freight rate charges in the freight rate agreement, if:\n\n(a) the freight rates (including base freight rates, surcharges,\nrebates and allowances) specified in the freight rate\nagreement are for outwards liner cargo shipping services\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nExemptions from certain restrictive trade practice prohibitions  Division 5\n\nSection 10.18\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nprovided under a single registered outwards conference\nagreement after the end of 30 days after the last-mentioned\nagreement is finally registered; and\n\n(b) the parties to the freight rate agreement are the same as the\nparties to the registered outwards conference agreement."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-125-ss-3-norm",
      "@type": "values:Obligation",
