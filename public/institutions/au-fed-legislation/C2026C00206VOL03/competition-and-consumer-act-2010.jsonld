    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-153-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(7) 44  Powers exercisable by Minister in relation to registered",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-153-ss-7"
