      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "165(6) Inspection of, furnishing of copies of, and evidence of,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-165-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.576",
      "values:originalText": "(6) A copy of a declaration under section 50A or a determination of, or\nundertaking given to, the Tribunal, certified to be a true copy under\nthe hand of the Registrar or of a Deputy Registrar, shall be\nreceived in all courts as evidence of the declaration, determination\nor undertaking.",
      "skos:definition": "(6) A copy of a declaration under section 50A or a determination of, or\nundertaking given to, the Tribunal, certified to be a true copy under\nthe hand of the Registrar or of a Deputy Registrar, shall be\nreceived in all courts as evidence of the declaration, determination\nor undertaking.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-165"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-6-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c3382e8af70c46141f58cc0c00082df17167ae1eb4f78fa73ca4ef0e64e3f485",
      "skos:note": "Receives certified copies of declarations, determinations, or undertakings as evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-165-ss-6",
      "@type": "cof:Section",
      "cof:title": "165(6) Inspection of, furnishing of copies of, and evidence of,",
      "values:kind": "subsection",
      "cof:pageNumber": 576,
      "values:originalText": "(6) A copy of a declaration under section 50A or a determination of, or\nundertaking given to, the Tribunal, certified to be a true copy under\nthe hand of the Registrar or of a Deputy Registrar, shall be\nreceived in all courts as evidence of the declaration, determination\nor undertaking."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-6-norm",
