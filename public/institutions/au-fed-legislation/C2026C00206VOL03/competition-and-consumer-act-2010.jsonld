      "cml:integrityHash": "f0f49db236374723f09001c6c386482dd0a3ad6fbd56bbceb52026fc54656d0c",
      "skos:note": "Exemption order may be revoked"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-185-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) 72C  Duration of exemption order may be limited",
      "values:kind": "subsection",
      "cof:pageNumber": 104,
      "values:originalText": "(2) Subsection (1) does not prevent the revocation of an exemption\norder in accordance with subsection 33(3) of the Acts\nInterpretation Act 1901."
    },
