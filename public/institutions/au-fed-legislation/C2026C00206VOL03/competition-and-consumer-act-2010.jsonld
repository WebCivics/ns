    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151aq-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AQ(2) Commission to act expeditiously",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151aq-ss-2"
