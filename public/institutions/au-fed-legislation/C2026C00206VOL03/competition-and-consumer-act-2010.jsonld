      },
      "cml:premiseText": "Consent given by occupier ceases to have effect",
      "cml:conclusionText": "Inspector must leave premises if consent ceases to have effect"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-3-logic-deontic-4",
