    {
      "@id": "concept:competition-and-consumer-act-2010-sec-162",
      "@type": "cml:Concept",
      "skos:prefLabel": "162 Contempt",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-162"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.570",
      "values:originalText": "(1) A person shall not:\n\n(a) insult a member of the Tribunal, a member of the\nCommission or an AER member in the exercise of his or her\npowers or functions as a member;\n\n(b) interrupt the proceedings of the Tribunal or a conference held\nby the Commission under section 90 or 93A, Division 3 of\nPart XI or section 151AZ;\n\n(c) create a disturbance, or take part in creating or continuing a\ndisturbance, in or near a place where the Tribunal is sitting or\nthe Commission is holding such a conference; or\n\n(d) do any other act or thing that would, if the Tribunal were a\ncourt of record, constitute a contempt of that court.\n\n(2) A person who contravenes subsection (1) is guilty of an offence\npunishable on conviction by a fine not exceeding 20 penalty units\nor imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nMiscellaneous  Chapter 8\nMiscellaneous  Part XII\n\nSection 162A\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties.",
      "skos:definition": "(1) A person shall not:\n\n(a) insult a member of the Tribunal, a member of the\nCommission or an AER member in the exercise of his or her\npowers or functions as a member;\n\n(b) interrupt the proceedings of the Tribunal or a conference held\nby the Commission under section 90 or 93A, Division 3 of\nPart XI or section 151AZ;\n\n(c) create a disturbance, or take part in creating or continuing a\ndisturbance, in or near a place where the Tribunal is sitting or\nthe Commission is holding such a conference; or\n\n(d) do any other act or thing that would, if the Tribunal were a\ncourt of record, constitute a contempt of that court.\n\n(2) A person who contravenes subsection (1) is guilty of an offence\npunishable on conviction by a fine not exceeding 20 penalty units\nor imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nMiscellaneous  Chapter 8\nMiscellaneous  Part XII\n\nSection 162A\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-162-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-162-ss-2"
        }
      ],
      "cml:integrityHash": "73dba637276ae9b96b06b7e83a0bb8cbe554c29d1cadbdcd26bfd69ff0fe68fe"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-162",
      "@type": "cof:Section",
      "cof:title": "162 Contempt",
      "values:kind": "section",
