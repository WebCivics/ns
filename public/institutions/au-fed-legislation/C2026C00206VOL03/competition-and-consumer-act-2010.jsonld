        }
      ],
      "cml:integrityHash": "527794df0049aa6b4b73f5467f5f6e5a31a943662c25910c7a26f9199db0423d",
      "skos:note": "Approval may be subject to conditions if Minister is satisfied."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zr-ss-1",
      "@type": "cof:Section",
      "cof:title": "154ZR(1) Conditions in approval",
      "values:kind": "subsection",
      "cof:pageNumber": 529,
      "values:originalText": "(1) The approval may specify that it is subject to conditions if the\nMinister is satisfied that the conditions are appropriate.\nConsiderations"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zr-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
