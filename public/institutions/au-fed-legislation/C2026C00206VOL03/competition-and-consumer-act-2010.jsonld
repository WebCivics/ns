      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152bc-ss-4c",
      "@type": "cml:Concept",
      "skos:prefLabel": "152BC(4C) Access determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152bc-ss-4c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.342",
      "values:originalText": "(4C) If an access determination is expressed to be an NBN-specific\naccess determination, the access determination does not apply in\nrelation to access to a declared service to the extent to which the\nservice is supplied, or is capable of being supplied, by a person\nother than an NBN corporation.",
      "skos:definition": "(4C) If an access determination is expressed to be an NBN-specific\naccess determination, the access determination does not apply in\nrelation to access to a declared service to the extent to which the\nservice is supplied, or is capable of being supplied, by a person\nother than an NBN corporation.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-152bc"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152bc-ss-4c-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152bc-ss-4c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bafd96656c807c1f9fde3ad092d9e69dbfcbf461b37b97150106f87e9ada6c8f",
      "skos:note": "Access determination does not apply to access supplied by a person other than an NBN corporation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152bc-ss-4c",
      "@type": "cof:Section",
      "cof:title": "152BC(4C) Access determinations",
      "values:kind": "subsection",
      "cof:pageNumber": 342,
      "values:originalText": "(4C) If an access determination is expressed to be an NBN-specific\naccess determination, the access determination does not apply in\nrelation to access to a declared service to the extent to which the\nservice is supplied, or is capable of being supplied, by a person\nother than an NBN corporation."
    },
