    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-202-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(4) 82E  Functions and powers of Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-202-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
