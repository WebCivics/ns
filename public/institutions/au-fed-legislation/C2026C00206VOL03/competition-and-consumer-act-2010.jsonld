    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153w",
      "@type": "cml:Concept",
      "skos:prefLabel": "153W Conditions for making contracting order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.451",
      "values:originalText": "The Treasurer may make an order under section 153X in respect of\na body corporate if the Treasurer is satisfied that the following\nconditions are met:\n\n(a) the Commission has given the Treasurer a prohibited conduct\nrecommendation under section 153S;\n\n(b) the body corporate is identified in the recommendation (in\naccordance with subparagraph 153S(2)(c)(i) or (iii));\n\n(c) the order is made no later than 45 days after:\n\n(i) unless subparagraph (ii) applies—the day on which the\nCommission gave the Treasurer the recommendation; or\n\n(ii) if there has been a variation of the recommendation\nunder section 153T—the day on which the Commission\nmade the variation;\n\n(d) the order is of a kind stated in the recommendation (in\naccordance with paragraph 153S(2)(d));\n\n(e) the conduct identified in the recommendation (in accordance\nwith subparagraph 153S(2)(c)(ii)):\n\n(i) is prohibited conduct engaged in by the corporation\nidentified in the recommendation (in accordance with\nsubparagraph 153S(2)(c)(i)) (the relevant corporation);\nand\n\n(ii) is, or includes, prohibited conduct under section 153F\n(electricity financial contract liquidity) or section 153H\n(electricity spot market (aggravated case));\n\n(f) the order is a proportionate means of preventing the relevant\ncorporation, or any related body corporate, from engaging in\nthat kind of prohibited conduct in the future;\n\n(g) any of the following generate electricity:\n\n(i) the body corporate;\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "The Treasurer may make an order under section 153X in respect of\na body corporate if the Treasurer is satisfied that the following\nconditions are met:\n\n(a) the Commission has given the Treasurer a prohibited conduct\nrecommendation under section 153S;\n\n(b) the body corporate is identified in the recommendation (in\naccordance with subparagraph 153S(2)(c)(i) or (iii));\n\n(c) the order is made no later than 45 days after:\n\n(i) unless subparagraph (ii) applies—the day on which the\nCommission gave the Treasurer the recommendation; or\n\n(ii) if there has been a variation of the recommendation\nunder section 153T—the day on which the Commission\nmade the variation;\n\n(d) the order is of a kind stated in the recommendation (in\naccordance with paragraph 153S(2)(d));\n\n(e) the conduct identified in the recommendation (in accordance\nwith subparagraph 153S(2)(c)(ii)):\n\n(i) is prohibited conduct engaged in by the corporation\nidentified in the recommendation (in accordance with\nsubparagraph 153S(2)(c)(i)) (the relevant corporation);\nand\n\n(ii) is, or includes, prohibited conduct under section 153F\n(electricity financial contract liquidity) or section 153H\n(electricity spot market (aggravated case));\n\n(f) the order is a proportionate means of preventing the relevant\ncorporation, or any related body corporate, from engaging in\nthat kind of prohibited conduct in the future;\n\n(g) any of the following generate electricity:\n\n(i) the body corporate;\n\nChapter 7  Further provisions relating to particular industries etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153w-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153w-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153w-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153w-logic-alleninterval-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153w-logic-deontic-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153w-logic-descriptionlogic-5"
        }
      ],
      "cml:integrityHash": "412fd02d68227dfb53c28a97316e214a9d9c5c7ca80b233d70857a95eec847da",
      "skos:note": "Treasurer must make order under section 153X if conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153w",
      "@type": "cof:Section",
      "cof:title": "153W Conditions for making contracting order",
      "values:kind": "section",
      "cof:pageNumber": 451,
      "values:originalText": "The Treasurer may make an order under section 153X in respect of\na body corporate if the Treasurer is satisfied that the following\nconditions are met:\n\n(a) the Commission has given the Treasurer a prohibited conduct\nrecommendation under section 153S;\n\n(b) the body corporate is identified in the recommendation (in\naccordance with subparagraph 153S(2)(c)(i) or (iii));\n\n(c) the order is made no later than 45 days after:\n\n(i) unless subparagraph (ii) applies—the day on which the\nCommission gave the Treasurer the recommendation; or\n\n(ii) if there has been a variation of the recommendation\nunder section 153T—the day on which the Commission\nmade the variation;\n\n(d) the order is of a kind stated in the recommendation (in\naccordance with paragraph 153S(2)(d));\n\n(e) the conduct identified in the recommendation (in accordance\nwith subparagraph 153S(2)(c)(ii)):\n\n(i) is prohibited conduct engaged in by the corporation\nidentified in the recommendation (in accordance with\nsubparagraph 153S(2)(c)(i)) (the relevant corporation);\nand\n\n(ii) is, or includes, prohibited conduct under section 153F\n(electricity financial contract liquidity) or section 153H\n(electricity spot market (aggravated case));\n\n(f) the order is a proportionate means of preventing the relevant\ncorporation, or any related body corporate, from engaging in\nthat kind of prohibited conduct in the future;\n\n(g) any of the following generate electricity:\n\n(i) the body corporate;\n\nChapter 7  Further provisions relating to particular industries etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153w-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
