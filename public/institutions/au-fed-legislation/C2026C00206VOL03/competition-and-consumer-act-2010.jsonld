      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-137b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Claimant's failure to take reasonable care reduces recoverable loss or damage",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Claimant makes a claim under subsection 236(1) of the Australian Consumer Law",
      "cml:conclusionText": "Amount of loss or damage reduced"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-137c",
      "@type": "cml:Concept",
      "skos:prefLabel": "137C Limits on recovery of amounts for death or personal injury",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-137c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.177",
      "values:originalText": "(1) A person is not entitled to recover an amount of loss or damage by\naction under subsection 236(1) of the Australian Consumer Law to\nthe extent to which:\n\n(a) the action would be based on the conduct contravening a\nprovision of Part 2-1 or 3-1 of the Australian Consumer Law;\nand\n\n(b) the loss or damage is, or results from, death or personal\ninjury; and\n\nChapter 6  Other provisions",
      "skos:definition": "(1) A person is not entitled to recover an amount of loss or damage by\naction under subsection 236(1) of the Australian Consumer Law to\nthe extent to which:\n\n(a) the action would be based on the conduct contravening a\nprovision of Part 2-1 or 3-1 of the Australian Consumer Law;\nand\n\n(b) the loss or damage is, or results from, death or personal\ninjury; and\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-137c-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-137c-logic-deontic-1"
        },
