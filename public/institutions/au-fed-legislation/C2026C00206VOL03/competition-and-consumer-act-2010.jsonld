      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission to apply for warrant",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes on reasonable grounds",
      "cml:conclusionText": "Warrant may be issued"
    },
