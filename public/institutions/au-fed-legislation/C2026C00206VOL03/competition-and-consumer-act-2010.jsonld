    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-111-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(3) 03  Designated shipper bodies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-111-ss-3"
      },
      "cml:curationStatus": {
