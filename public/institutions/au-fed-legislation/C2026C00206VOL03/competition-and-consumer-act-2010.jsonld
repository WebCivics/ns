    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-201-ss-4",
      "@type": "cof:Section",
      "cof:title": "10(4) 64(3)(a) to:",
      "values:kind": "subsection",
      "cof:pageNumber": 110,
      "values:originalText": "(4) If the Tribunal receives an application under this section for a\nreview of a decision, the Tribunal must review the decision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-201-ss-4-norm",
