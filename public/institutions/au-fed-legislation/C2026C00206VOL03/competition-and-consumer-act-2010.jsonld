      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.104",
      "values:originalText": "(1) An exemption order may be expressed to be in force for a period\nspecified in the order.\n\n(2) Subsection (1) does not prevent the revocation of an exemption\norder in accordance with subsection 33(3) of the Acts\nInterpretation Act 1901.",
      "skos:definition": "(1) An exemption order may be expressed to be in force for a period\nspecified in the order.\n\n(2) Subsection (1) does not prevent the revocation of an exemption\norder in accordance with subsection 33(3) of the Acts\nInterpretation Act 1901.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-185-ss-1"
        },
