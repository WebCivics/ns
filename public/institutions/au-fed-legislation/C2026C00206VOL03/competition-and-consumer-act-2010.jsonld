      "skos:prefLabel": "154E(1) Powers in relation to premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154e-ss-1"
      },
      "cml:curationStatus": {
