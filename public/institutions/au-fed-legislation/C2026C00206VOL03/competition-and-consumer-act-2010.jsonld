    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134d-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to pay penalty within infringement notice compliance period.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 134D(1) states that this section applies if...",
      "cml:conclusionText": "The person must pay the penalty specified in the infringement notice."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134d-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "This section has a temporal relation with Section 134E.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 134D(1) is followed by Section 134E.",
      "cml:conclusionText": "The infringement notice compliance period ends when the penalty is paid."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134d-ss-1-logic-ltl-3",
