    {
      "@id": "concept:competition-and-consumer-act-2010-sec-137e-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "137E(3) Limits on compensation orders etc. for death or personal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-137e-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.178",
      "values:originalText": "(3) Division 7 of Part VIB of this Act applies to a proceeding in which\nan order under subsection 237(1) or 238(1) of the Australian\nConsumer Law to compensate a person for loss or damage the\nperson suffers because of the conduct of another person is made, to\nthe extent to which:\n\n(a) the action would be based on the conduct contravening a\nprovision of Part 2-1 or Part 3-1 of the Australian Consumer\nLaw; and\n\nChapter 6  Other provisions",
      "skos:definition": "(3) Division 7 of Part VIB of this Act applies to a proceeding in which\nan order under subsection 237(1) or 238(1) of the Australian\nConsumer Law to compensate a person for loss or damage the\nperson suffers because of the conduct of another person is made, to\nthe extent to which:\n\n(a) the action would be based on the conduct contravening a\nprovision of Part 2-1 or Part 3-1 of the Australian Consumer\nLaw; and\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-137e"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-137e-ss-3-norm"
        }
      ],
      "cml:integrityHash": "8ebde3af056427c7ae7053c4ee1102b0394851c05967e957a06b1723436dca1f",
      "skos:note": "Limits on compensation orders for death or personal injury"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-137e-ss-3",
      "@type": "cof:Section",
      "cof:title": "137E(3) Limits on compensation orders etc. for death or personal",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(3) Division 7 of Part VIB of this Act applies to a proceeding in which\nan order under subsection 237(1) or 238(1) of the Australian\nConsumer Law to compensate a person for loss or damage the\nperson suffers because of the conduct of another person is made, to\nthe extent to which:\n\n(a) the action would be based on the conduct contravening a\nprovision of Part 2-1 or Part 3-1 of the Australian Consumer\nLaw; and\n\nChapter 6  Other provisions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-137e-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
