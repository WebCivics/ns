    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151al",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AL Part B competition notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151al"
