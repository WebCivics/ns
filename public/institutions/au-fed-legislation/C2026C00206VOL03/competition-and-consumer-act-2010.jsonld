    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153k",
      "@type": "cml:Concept",
      "skos:prefLabel": "153K Prohibited conduct may be covered by other provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.437",
      "values:originalText": "To avoid doubt, this Division does not limit the operation of any\nother provision of this Act.\nExample: Particular conduct of a corporation could result in the corporation\ncontravening both section 46 and section 153F.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "To avoid doubt, this Division does not limit the operation of any\nother provision of this Act.\nExample: Particular conduct of a corporation could result in the corporation\ncontravening both section 46 and section 153F.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153k-norm"
        }
      ],
      "cml:integrityHash": "c359edec35fe51e695fe5d97e98f0a6d8e76930c1e1ada6754d077a837693380",
      "skos:note": "No obligation imposed by this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153k",
      "@type": "cof:Section",
      "cof:title": "153K Prohibited conduct may be covered by other provisions",
      "values:kind": "section",
      "cof:pageNumber": 437,
      "values:originalText": "To avoid doubt, this Division does not limit the operation of any\nother provision of this Act.\nExample: Particular conduct of a corporation could result in the corporation\ncontravening both section 46 and section 153F.\n\nChapter 7  Further provisions relating to particular industries etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153k-norm",
      "@type": "values:Obligation",
      "cml:modality": {
