    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154q",
      "@type": "cml:Concept",
      "skos:prefLabel": "154Q Occupier to provide reasonable facilities and assistance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.506",
      "values:originalText": "The occupier of premises in relation to which a search warrant is\nbeing executed must provide the executing officer and any officer\nassisting with all reasonable facilities and assistance for the\neffective exercise of their powers.\nPenalty: 30 penalty units.",
      "skos:definition": "The occupier of premises in relation to which a search warrant is\nbeing executed must provide the executing officer and any officer\nassisting with all reasonable facilities and assistance for the\neffective exercise of their powers.\nPenalty: 30 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154q-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154q-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f244cb10aedf07f517a32d9e9872632bd0cebf13339fac090e8ad523acbd4880",
      "skos:note": "Must provide reasonable facilities and assistance for search warrant execution.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154q",
      "@type": "cof:Section",
      "cof:title": "154Q Occupier to provide reasonable facilities and assistance",
      "values:kind": "section",
      "cof:pageNumber": 506,
      "values:originalText": "The occupier of premises in relation to which a search warrant is\nbeing executed must provide the executing officer and any officer\nassisting with all reasonable facilities and assistance for the\neffective exercise of their powers.\nPenalty: 30 penalty units."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154q-norm",
      "@type": "values:Obligation",
