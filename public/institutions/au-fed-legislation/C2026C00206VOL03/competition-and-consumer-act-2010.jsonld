    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zs",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZS Contents of approval",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zs"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.529",
      "values:originalText": "The approval must set out the following:\n\n(a) the name of the designated complainant;\n\n(b) the date (if any) on which the approval ceases to be in force;\n\n(c) the conditions (if any) to which the approval is subject.\n\nChapter 8  Miscellaneous",
      "skos:definition": "The approval must set out the following:\n\n(a) the name of the designated complainant;\n\n(b) the date (if any) on which the approval ceases to be in force;\n\n(c) the conditions (if any) to which the approval is subject.\n\nChapter 8  Miscellaneous",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zs-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zs-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "641fb97a2b3ef6619e98a02a7ca97b3a7f11191e9da14cb61ddf6e756b7337db",
      "skos:note": "Approval must provide specific details.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zs",
      "@type": "cof:Section",
      "cof:title": "154ZS Contents of approval",
      "values:kind": "section",
      "cof:pageNumber": 529,
      "values:originalText": "The approval must set out the following:\n\n(a) the name of the designated complainant;\n\n(b) the date (if any) on which the approval ceases to be in force;\n\n(c) the conditions (if any) to which the approval is subject.\n\nChapter 8  Miscellaneous"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zs-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154zs"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zs-logic-deontic-1",
