    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "153ZC Acquisition of property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153zc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.461",
      "values:originalText": "Scope\n\n(1) This section applies to the following:\n\n(a) Divisions 5 and 6;\n\n(b) any other provision of this Act, to the extent to which the\nprovision relates to Division 5 or 6.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) otherwise than\non just terms (within the meaning of that paragraph).",
      "skos:definition": "Scope\n\n(1) This section applies to the following:\n\n(a) Divisions 5 and 6;\n\n(b) any other provision of this Act, to the extent to which the\nprovision relates to Division 5 or 6.\nEffect of provision\n\n(2) The provision has no effect to the extent (if any) to which its\noperation would result in the acquisition of property (within the\nmeaning of paragraph 51(xxxi) of the Constitution) otherwise than\non just terms (within the meaning of that paragraph).",
      "cml:hasPart": [
