    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-167",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 57  Investigation and report by Commission on reference by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-167"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.92",
      "values:originalText": "Minister\n\n(1) The Minister may refer to the Commission for investigation and\nreport the question whether grounds exist for the Minister to be\nsatisfied in relation to a registered non-conference ocean carrier\nwith substantial market power of one or more specified matters\nreferred to in paragraph 10.55(a).\n\n(2) The Commission shall hold an investigation into the question and\nreport to the Minister.\n\n(3) In its investigation, the Commission shall give special\nconsideration to any matters specified in the reference as matters to\nbe given special consideration by the Commission.",
      "skos:definition": "Minister\n\n(1) The Minister may refer to the Commission for investigation and\nreport the question whether grounds exist for the Minister to be\nsatisfied in relation to a registered non-conference ocean carrier\nwith substantial market power of one or more specified matters\nreferred to in paragraph 10.55(a).\n\n(2) The Commission shall hold an investigation into the question and\nreport to the Minister.\n\n(3) In its investigation, the Commission shall give special\nconsideration to any matters specified in the reference as matters to\nbe given special consideration by the Commission.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-167-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-167-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-167-ss-3"
        }
      ],
      "cml:integrityHash": "27e1c95e64999f594001f3b8fada27406bb96ae8adfdedf0b0b67e2e95c59347"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-167",
      "@type": "cof:Section",
      "cof:title": "10 57  Investigation and report by Commission on reference by",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "Minister\n\n(1) The Minister may refer to the Commission for investigation and\nreport the question whether grounds exist for the Minister to be\nsatisfied in relation to a registered non-conference ocean carrier\nwith substantial market power of one or more specified matters\nreferred to in paragraph 10.55(a).\n\n(2) The Commission shall hold an investigation into the question and\nreport to the Minister.\n\n(3) In its investigation, the Commission shall give special\nconsideration to any matters specified in the reference as matters to\nbe given special consideration by the Commission."
    },
