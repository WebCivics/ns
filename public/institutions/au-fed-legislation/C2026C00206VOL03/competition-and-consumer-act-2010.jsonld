    {
      "@id": "concept:competition-and-consumer-act-2010-sec-158",
      "@type": "cml:Concept",
      "skos:prefLabel": "158 Protection of members of Tribunal, counsel and witnesses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-158"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.565",
      "values:originalText": "(1) A member of the Tribunal has, in the performance of his or her\nduty as a member, the same protection and immunity as a Justice\nof the High Court.\n\n(2) A person appearing before the Tribunal on behalf of a person, or\nassisting the Tribunal as counsel, has the same protection and\nimmunity as a barrister has in appearing for a party in proceedings\nin the High Court.\n\n(3) Subject to this Act, a person appearing before the Tribunal or the\nCommission to give evidence has the same protection, and is, in\naddition to the penalties provided by this Act, subject to the same\nliabilities, in any civil or criminal proceedings as a witness in\nproceedings in the High Court.",
      "skos:definition": "(1) A member of the Tribunal has, in the performance of his or her\nduty as a member, the same protection and immunity as a Justice\nof the High Court.\n\n(2) A person appearing before the Tribunal on behalf of a person, or\nassisting the Tribunal as counsel, has the same protection and\nimmunity as a barrister has in appearing for a party in proceedings\nin the High Court.\n\n(3) Subject to this Act, a person appearing before the Tribunal or the\nCommission to give evidence has the same protection, and is, in\naddition to the penalties provided by this Act, subject to the same\nliabilities, in any civil or criminal proceedings as a witness in\nproceedings in the High Court.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-158-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-158-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-158-ss-3"
        }
      ],
      "cml:integrityHash": "2249fee15cfab582efe3c65bd507c54cdd876583f3597e4cab95c0dfb82e8501"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-158",
      "@type": "cof:Section",
      "cof:title": "158 Protection of members of Tribunal, counsel and witnesses",
      "values:kind": "section",
      "cof:pageNumber": 565,
      "values:originalText": "(1) A member of the Tribunal has, in the performance of his or her\nduty as a member, the same protection and immunity as a Justice\nof the High Court.\n\n(2) A person appearing before the Tribunal on behalf of a person, or\nassisting the Tribunal as counsel, has the same protection and\nimmunity as a barrister has in appearing for a party in proceedings\nin the High Court.\n\n(3) Subject to this Act, a person appearing before the Tribunal or the\nCommission to give evidence has the same protection, and is, in\naddition to the penalties provided by this Act, subject to the same\nliabilities, in any civil or criminal proceedings as a witness in\nproceedings in the High Court."
    },
