    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-185",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 72C  Duration of exemption order may be limited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-185"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
