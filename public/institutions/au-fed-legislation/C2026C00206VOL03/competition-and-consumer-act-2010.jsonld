    {
      "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "165(4) Inspection of, furnishing of copies of, and evidence of,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-165-ss-4"
      },
      "cml:curationStatus": {
