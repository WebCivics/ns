      "@type": "cml:Concept",
      "skos:prefLabel": "155B(5) Australian Competition and Consumer Commission may",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-155b-ss-5"
