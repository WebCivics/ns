    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135s-ss-2",
      "@type": "cof:Section",
      "cof:title": "135S(2) Embargo notices",
      "values:kind": "subsection",
      "cof:pageNumber": 165,
      "values:originalText": "(2) The inspector may give the notice to the occupier of the premises:\n\n(a) by causing a copy of the notice to be served on the occupier;\nor\n\nChapter 6  Other provisions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135s-ss-2-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
