    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-169-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(3) 59  Undertakings by ocean carrier",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-169-ss-3"
