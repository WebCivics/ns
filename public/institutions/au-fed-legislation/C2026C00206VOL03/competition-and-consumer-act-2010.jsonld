      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implies that non-compliance leads to a penalty.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) if the person is a body corporate—150 penalty units; or\n\n(b) if the person is not a body corporate—30 penalty units.",
      "cml:conclusionText": "Non-compliance implies a penalty."
    },
