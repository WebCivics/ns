      ],
      "cml:integrityHash": "95fc664c260b5a9a671bd844827e25e7d21d579e41e9f8193684b97125ec4e71",
      "skos:note": "Ocean carrier who provides international liner cargo shipping must not contravene subsection (1) without reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-178-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) 68  Ocean carrier who provides international liner cargo shipping",
      "values:kind": "subsection",
      "cof:pageNumber": 100,
      "values:originalText": "(2) An ocean carrier who, without reasonable excuse, contravenes\nsubsection (1) commits an offence punishable, on conviction, by a\nfine not exceeding:\n\n(a) in the case of a natural person—20 penalty units; and\n\n(b) in the case of a body corporate—100 penalty units."
    },
