          "@id": "concept:competition-and-consumer-act-2010-sec-132h-ss-3"
        }
      ],
      "cml:integrityHash": "511fe392f45bda61b05c5d47ae0edc088ee28f4c5c99eae376bb291d2b57b0e5"
    },
    {
