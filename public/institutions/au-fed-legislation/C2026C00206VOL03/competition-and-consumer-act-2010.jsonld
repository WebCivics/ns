      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The system recognizes the delegation of a power as a valid authority transfer",
      "cml:conclusionText": "The Registrar or specified person may perform certain actions if delegated by the Minister"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-196",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 82  Delegation by Registrar",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-196"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.107",
      "values:originalText": "The Registrar may, by signed writing, delegate to a person\noccupying a specified office in the Department all or any of the\nRegistrar’s powers under this Part.\n\nChapter 6  Other provisions",
      "skos:definition": "The Registrar may, by signed writing, delegate to a person\noccupying a specified office in the Department all or any of the\nRegistrar’s powers under this Part.\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-196-norm"
        }
      ],
      "cml:integrityHash": "fbd0307ba3c5ae841395fe42a238b8ee4e7ff555572912ea2011481e1053f8e5",
      "skos:note": "Delegation of powers by Registrar"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-196",
      "@type": "cof:Section",
      "cof:title": "10 82  Delegation by Registrar",
      "values:kind": "section",
      "cof:pageNumber": 107,
      "values:originalText": "The Registrar may, by signed writing, delegate to a person\noccupying a specified office in the Department all or any of the\nRegistrar’s powers under this Part.\n\nChapter 6  Other provisions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-196-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-10-196"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
