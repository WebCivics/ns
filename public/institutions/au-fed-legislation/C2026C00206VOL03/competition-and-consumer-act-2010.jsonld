    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "151BA Commission must grant or reject application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ba"
      },
      "cml:curationStatus": {
