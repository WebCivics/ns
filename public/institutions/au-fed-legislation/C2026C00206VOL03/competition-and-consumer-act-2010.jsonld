    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151by",
      "@type": "cml:Concept",
      "skos:prefLabel": "151BY Civil action for recovery of pecuniary penalties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151by"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.267",
      "values:originalText": "(1) The Commission may institute a proceeding in the Federal Court\nfor the recovery on behalf of the Commonwealth of a pecuniary\npenalty referred to in section 151BX.\n\n(2) A proceeding under subsection (1) may be commenced within 6\nyears after the contravention.\n\n(3) A proceeding under subsection (1) must not be instituted in relation\nto:\n\n(a) a contravention of the competition rule; or\n\n(b) attempting to contravene the competition rule; or\n\n(c) aiding, abetting, counselling or procuring a person to\ncontravene the competition rule; or\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "(1) The Commission may institute a proceeding in the Federal Court\nfor the recovery on behalf of the Commonwealth of a pecuniary\npenalty referred to in section 151BX.\n\n(2) A proceeding under subsection (1) may be commenced within 6\nyears after the contravention.\n\n(3) A proceeding under subsection (1) must not be instituted in relation\nto:\n\n(a) a contravention of the competition rule; or\n\n(b) attempting to contravene the competition rule; or\n\n(c) aiding, abetting, counselling or procuring a person to\ncontravene the competition rule; or\n\nChapter 7  Further provisions relating to particular industries etc.",
      "cml:hasPart": [
