    {
      "@id": "concept:competition-and-consumer-act-2010-sec-133a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "133A(3) Identity cards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-133a-ss-3"
      },
      "cml:curationStatus": {
