      },
      "cml:operator": "during",
      "cml:logicSummary": "Timeframe for requesting information",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
