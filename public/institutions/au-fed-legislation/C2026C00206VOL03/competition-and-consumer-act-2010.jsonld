    {
      "@id": "concept:competition-and-consumer-act-2010-sec-187",
      "@type": "cml:Concept",
      "skos:prefLabel": "187 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-187"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.598",
      "values:originalText": "The amendments made by Part 2 of Schedule 1 to the Treasury\nLaws Amendment (More Competition, Better Prices) Act 2022\napply in relation to offences committed on or after the\ncommencement of that Schedule.\n\nMiscellaneous  Chapter 8\nApplication and transitional provisions relating to the competition provisions  Part XIII\nApplication of amendments made by the Treasury Laws Amendment (Mergers and\nAcquisitions Reform) Act 2024  Division 6\n\nSection 188\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "The amendments made by Part 2 of Schedule 1 to the Treasury\nLaws Amendment (More Competition, Better Prices) Act 2022\napply in relation to offences committed on or after the\ncommencement of that Schedule.\n\nMiscellaneous  Chapter 8\nApplication and transitional provisions relating to the competition provisions  Part XIII\nApplication of amendments made by the Treasury Laws Amendment (Mergers and\nAcquisitions Reform) Act 2024  Division 6\n\nSection 188\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-187-norm"
        }
      ],
      "cml:integrityHash": "108a2f47e04a55c664a3189a9c3a5468be7d787c559e6fc0e05598b758631bd6",
      "skos:note": "Application of amendments made by Part 2 of Schedule 1 to the Treasury Laws Amendment (More Competition, Better Prices) Act 2022."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-187",
      "@type": "cof:Section",
      "cof:title": "187 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 598,
      "values:originalText": "The amendments made by Part 2 of Schedule 1 to the Treasury\nLaws Amendment (More Competition, Better Prices) Act 2022\napply in relation to offences committed on or after the\ncommencement of that Schedule.\n\nMiscellaneous  Chapter 8\nApplication and transitional provisions relating to the competition provisions  Part XIII\nApplication of amendments made by the Treasury Laws Amendment (Mergers and\nAcquisitions Reform) Act 2024  Division 6\n\nSection 188\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
