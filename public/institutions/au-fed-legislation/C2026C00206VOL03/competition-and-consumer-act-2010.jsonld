    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134g-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "134G(7) Withdrawal of an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134g-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.152",
      "values:originalText": "(7) If the infringement notice is withdrawn after the person has paid\nthe penalty specified in the infringement notice, the Commission\nmust refund to the person an amount equal to the amount paid.\n\nChapter 6  Other provisions",
      "skos:definition": "(7) If the infringement notice is withdrawn after the person has paid\nthe penalty specified in the infringement notice, the Commission\nmust refund to the person an amount equal to the amount paid.\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-134g"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134g-ss-7-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-134g-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9fa1c80fdd04bc055d13094edbc09d4e595dcfa10c29a900a5399f3f14c59551",
      "skos:note": "Commission must refund amount paid if infringement notice is withdrawn after payment."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134g-ss-7",
      "@type": "cof:Section",
      "cof:title": "134G(7) Withdrawal of an infringement notice",
      "values:kind": "subsection",
