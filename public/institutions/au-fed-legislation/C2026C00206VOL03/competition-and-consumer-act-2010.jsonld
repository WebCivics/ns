      },
      "cml:premiseText": "(1A) Subsection (1) does not apply if the person has a reasonable excuse.",
      "cml:conclusionText": "If there is a reasonable excuse, then the witness is not obligated to attend court."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-160-ss-1a-logic-diffusion-4",
