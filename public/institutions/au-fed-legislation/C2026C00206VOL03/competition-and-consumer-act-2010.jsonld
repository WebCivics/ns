      ],
      "cml:integrityHash": "0801ab7fde08ea9c40c0a38e69c1fa6921238bb62669af2f22823569810117cd",
      "skos:note": "The Minister may refer the Commission for investigation and report on a registered non-conference ocean carrier with substantial market power."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-167-ss-1",
      "@type": "cof:Section",
      "cof:title": "10(1) 57  Investigation and report by Commission on reference by",
      "values:kind": "subsection",
      "cof:pageNumber": 92,
      "values:originalText": "(1) The Minister may refer to the Commission for investigation and\nreport the question whether grounds exist for the Minister to be\nsatisfied in relation to a registered non-conference ocean carrier\nwith substantial market power of one or more specified matters\nreferred to in paragraph 10.55(a)."
    },
