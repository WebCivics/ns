    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zq-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZQ(4) Minister may grant approval",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zq-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
