    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-138b-ss-5",
      "@type": "cof:Section",
      "cof:title": "138B(5) Conferring jurisdiction on State and Territory Courts",
      "values:kind": "subsection",
