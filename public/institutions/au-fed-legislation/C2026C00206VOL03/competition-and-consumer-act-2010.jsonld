    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151bd",
      "@type": "cml:Concept",
      "skos:prefLabel": "151BD Notification of decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151bd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.238",
      "values:originalText": "(1) If the Commission makes an exemption order, the Commission\nmust give the applicant a written notice setting out the order and\nthe reasons for the order.\n\n(2) If the Commission refuses to make an exemption order, the\nCommission must give the applicant a written notice stating that\nthe order has been refused and setting out the reasons for the\nrefusal.",
      "skos:definition": "(1) If the Commission makes an exemption order, the Commission\nmust give the applicant a written notice setting out the order and\nthe reasons for the order.\n\n(2) If the Commission refuses to make an exemption order, the\nCommission must give the applicant a written notice stating that\nthe order has been refused and setting out the reasons for the\nrefusal.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151bd-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151bd-ss-2"
        }
      ],
      "cml:integrityHash": "f9736860f79bde9ebc6294b98c26142075e68a826434d8c7a64a95bfc0db84ea"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151bd",
      "@type": "cof:Section",
      "cof:title": "151BD Notification of decision",
      "values:kind": "section",
      "cof:pageNumber": 238,
      "values:originalText": "(1) If the Commission makes an exemption order, the Commission\nmust give the applicant a written notice setting out the order and\nthe reasons for the order.\n\n(2) If the Commission refuses to make an exemption order, the\nCommission must give the applicant a written notice stating that\nthe order has been refused and setting out the reasons for the\nrefusal."
    },
