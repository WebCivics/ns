    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154b-ss-3",
      "@type": "cof:Section",
      "cof:title": "154B(3) Appointment of inspectors",
      "values:kind": "subsection",
