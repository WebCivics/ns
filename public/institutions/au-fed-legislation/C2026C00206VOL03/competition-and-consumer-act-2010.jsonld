      ],
      "cml:integrityHash": "8e1a418aa729ff61248ef45ce6535c72d2f69fc32924282717dd51548ac27031",
      "skos:note": "Regulation of conduct by directors, employees or agents"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151cf",
      "@type": "cof:Section",
      "cof:title": "151CF Conduct by directors, employees or agents",
      "values:kind": "section",
      "cof:pageNumber": 274,
      "values:originalText": "Part 32 of the Telecommunications Act 1997 applies in relation to\nproceedings under this Division in a corresponding way to the way\nin which it applies to proceedings under that Act (as defined by\nsection 574 of that Act).\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules"
    },
