    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-188",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 74  Deletion of entries wrongly existing in certain registers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-188"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.105",
      "values:originalText": "Where the Registrar is satisfied that an entry wrongly exists in a\nregister kept by the Registrar, the Registrar shall delete the entry.",
      "skos:definition": "Where the Registrar is satisfied that an entry wrongly exists in a\nregister kept by the Registrar, the Registrar shall delete the entry.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-188-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-188-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cd04e333948c0f7f818a919062d569d122ed6d7eebea176795b5691636822bf0",
      "skos:note": "The Registrar must delete an entry wrongly existing in a register."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-188",
      "@type": "cof:Section",
      "cof:title": "10 74  Deletion of entries wrongly existing in certain registers",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "Where the Registrar is satisfied that an entry wrongly exists in a\nregister kept by the Registrar, the Registrar shall delete the entry."
    },
    {
