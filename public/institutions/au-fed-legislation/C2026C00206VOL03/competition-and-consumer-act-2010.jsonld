      "@id": "concept:competition-and-consumer-act-2010-sec-158a",
      "@type": "cml:Concept",
      "skos:prefLabel": "158A Proceedings without initiation notice—use of virtual enquiry",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-158a"
