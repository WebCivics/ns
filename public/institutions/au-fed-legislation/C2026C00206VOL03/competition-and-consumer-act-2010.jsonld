    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-170",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 60  Enforcement of orders and undertakings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-170"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
