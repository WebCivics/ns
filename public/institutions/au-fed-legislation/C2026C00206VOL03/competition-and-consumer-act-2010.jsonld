    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-1",
      "@type": "cof:Section",
      "cof:title": "154ZC(1) Compensation for damage to electronic equipment",
      "values:kind": "subsection",
      "cof:pageNumber": 516,
      "values:originalText": "(1) This section applies if:\n\n(a) as a result of electronic equipment being operated as\nmentioned in section 154E, 154F, 154G, 154H or 154J:\n\n(i) damage is caused to the equipment; or\n\n(ii) the data recorded on the equipment is damaged; or\n\n(iii) programs associated with the use of the equipment, or\nwith the use of the data, are damaged or corrupted; and\n\n(b) the damage or corruption occurs because:\n\n(i) insufficient care was exercised in selecting the person\nwho was to operate the equipment; or\n\n(ii) insufficient care was exercised by the person operating\nthe equipment."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Duty to provide compensation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Insufficient care was exercised in selecting the person who was to operate the equipment.",
      "cml:conclusionText": "State must provide compensation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Duty to provide compensation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Insufficient care was exercised by the person operating the equipment.",
      "cml:conclusionText": "State must provide compensation."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZC(2) Compensation for damage to electronic equipment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.516",
      "values:originalText": "(2) The Commonwealth must pay the owner of the equipment, or the\nuser of the data or programs, such reasonable compensation for the\ndamage or corruption as the Commonwealth and the owner or user\nagree on.",
      "skos:definition": "(2) The Commonwealth must pay the owner of the equipment, or the\nuser of the data or programs, such reasonable compensation for the\ndamage or corruption as the Commonwealth and the owner or user\nagree on.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154zc"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0e58d048e0d25d5c613350276758f33202ef41ce8d37f44b59d7a342a0166c35",
      "skos:note": "Commonwealth must pay reasonable compensation for damage to electronic equipment.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-2",
