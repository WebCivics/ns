      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the experience and ability of the applicant in representing the interests of consumers or small businesses (or both) in Australia in relation to a range of market issues that affect them;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zq-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Consider future integrity.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the extent to which the Minister is satisfied that the applicant will, if approved as a designated complainant, act with integrity in connection with being a designated complainant;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zq-ss-2-logic-deontic-4",
