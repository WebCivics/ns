        }
      ],
      "cml:integrityHash": "8b600270251f48b74b8921676afde7ca319039a98788f63acc3501c9f608eb31",
      "skos:note": "Consent must be voluntary to have effect."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135h-ss-2",
      "@type": "cof:Section",
      "cof:title": "135H(2) Consent",
      "values:kind": "subsection",
      "cof:pageNumber": 160,
      "values:originalText": "(2) A consent has no effect unless the consent is voluntary."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
