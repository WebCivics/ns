    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152eo-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "152EO(2) Conduct by directors, servants or agents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152eo-ss-2"
      },
