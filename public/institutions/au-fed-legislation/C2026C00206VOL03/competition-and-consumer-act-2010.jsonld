    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zp-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZP(6) Application for approval as designated complainant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zp-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.527",
      "values:originalText": "(6) If the application is withdrawn, it is taken never to have been\nmade.\n\nChapter 8  Miscellaneous",
      "skos:definition": "(6) If the application is withdrawn, it is taken never to have been\nmade.\n\nChapter 8  Miscellaneous",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154zp"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zp-ss-6-norm"
        }
      ],
      "cml:integrityHash": "4c0d27506f583959fa0084a648a9c8a82e36cf8d0f1ee41e7ac879faed9dd88f",
      "skos:note": "Withdrawal of application does not create a new event."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zp-ss-6",
      "@type": "cof:Section",
      "cof:title": "154ZP(6) Application for approval as designated complainant",
      "values:kind": "subsection",
      "cof:pageNumber": 527,
      "values:originalText": "(6) If the application is withdrawn, it is taken never to have been\nmade.\n\nChapter 8  Miscellaneous"
    },
