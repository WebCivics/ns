        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct.",
      "cml:conclusionText": "The person is not liable to a pecuniary penalty under this Act in respect of the same conduct."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150h-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "A spreads out",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct.",
      "cml:conclusionText": "The diffusion of penalties is affected by this provision"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150i",
      "@type": "cml:Concept",
      "skos:prefLabel": "150I References in instruments to the Competition Code",
