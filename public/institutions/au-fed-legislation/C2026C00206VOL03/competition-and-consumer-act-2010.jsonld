    {
      "@id": "concept:competition-and-consumer-act-2010-sec-140a",
      "@type": "cml:Concept",
      "skos:prefLabel": "140A Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140a"
      },
      "cml:curationStatus": {
