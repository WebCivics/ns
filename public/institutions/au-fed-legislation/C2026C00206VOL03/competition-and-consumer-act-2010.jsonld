      "cml:integrityHash": "72f6f56e644053c0202a5b704ae76f3ed1191910252a8192d403aaa56d7fcb3b",
      "skos:note": "Withdrawal notice must be given within infringement notice compliance period."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134g-ss-6",
      "@type": "cof:Section",
      "cof:title": "134G(6) Withdrawal of an infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 152,
      "values:originalText": "(6) To be effective, the withdrawal notice must be given to the person\nwithin the infringement notice compliance period for the\ninfringement notice.\nRefunds"
    },
