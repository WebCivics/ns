      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.496",
      "values:originalText": "(1) An inspector may enter premises if:\n\n(a) the Commission, the Chairperson or a Deputy Chairperson\nhas reasonable grounds for suspecting that there may be\nevidential material on the premises; and\n\n(b) the inspector obtains the consent of the occupier of the\npremises to enter the premises.",
