    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151cc",
      "@type": "cml:Concept",
      "skos:prefLabel": "151CC Actions for damages—breach of the competition rule",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151cc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.271",
      "values:originalText": "(1) A person who suffers loss or damage by conduct of another person\nthat was done in contravention of the competition rule may recover\nthe amount of the loss or damage by action against:\n\n(a) that other person; or\n\n(b) any person involved in the contravention.\n\n(2) An action under subsection (1) may be commenced at any time\nwithin 3 years after the date on which the cause of action accrued.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "(1) A person who suffers loss or damage by conduct of another person\nthat was done in contravention of the competition rule may recover\nthe amount of the loss or damage by action against:\n\n(a) that other person; or\n\n(b) any person involved in the contravention.\n\n(2) An action under subsection (1) may be commenced at any time\nwithin 3 years after the date on which the cause of action accrued.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151cc-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151cc-ss-2"
        }
      ],
      "cml:integrityHash": "272d647cae25d5295eb17f452623f254d3be57f79f7ba4e1c76bf4a97db0f439"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151cc",
      "@type": "cof:Section",
      "cof:title": "151CC Actions for damages—breach of the competition rule",
      "values:kind": "section",
