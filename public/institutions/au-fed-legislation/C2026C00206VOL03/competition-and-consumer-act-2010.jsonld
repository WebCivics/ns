    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-135-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) Section 10",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(2) A document that accompanies an application for the provisional\nregistration of a conference agreement must comply with any\nregulations requiring its verification (in whole or part) by or on\nbehalf of the applicants."
    },
