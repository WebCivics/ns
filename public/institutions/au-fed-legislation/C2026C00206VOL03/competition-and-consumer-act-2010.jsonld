    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-133",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 25  Application for provisional registration of conference",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-133"
      },
      "cml:curationStatus": {
