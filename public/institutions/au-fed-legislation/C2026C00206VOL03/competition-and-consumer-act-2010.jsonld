    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153v-ss-1",
      "@type": "cof:Section",
      "cof:title": "153V(1) Commission may vary or revoke no Treasurer action notice",
      "values:kind": "subsection",
      "cof:pageNumber": 448,
      "values:originalText": "(1) The Commission may, in writing, vary or revoke a no Treasurer\naction notice."
    },
