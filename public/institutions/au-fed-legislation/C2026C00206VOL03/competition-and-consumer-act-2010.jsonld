    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ej",
      "@type": "cml:Concept",
      "skos:prefLabel": "152EJ Factors relevant to granting a restraining injunction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ej"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.424",
      "values:originalText": "The power of the Federal Court to grant an injunction under\nsection 152EG restraining a person from engaging in conduct may\nbe exercised whether or not:\n\n(a) it appears to the Court that the person intends to engage\nagain, or to continue to engage, in conduct of that kind; or\n\n(b) the person has previously engaged in conduct of that kind; or\n\n(c) there is an imminent danger of substantial damage to any\nperson if the first-mentioned person engages in conduct of\nthat kind.",
      "skos:definition": "The power of the Federal Court to grant an injunction under\nsection 152EG restraining a person from engaging in conduct may\nbe exercised whether or not:\n\n(a) it appears to the Court that the person intends to engage\nagain, or to continue to engage, in conduct of that kind; or\n\n(b) the person has previously engaged in conduct of that kind; or\n\n(c) there is an imminent danger of substantial damage to any\nperson if the first-mentioned person engages in conduct of\nthat kind.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152ej-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152ej-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ff8e72a5258da575fdcf59d364d3fa09983768585420b6328fa16c930a8f5342",
      "skos:note": "Factors relevant to granting a restraining injunction"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ej",
      "@type": "cof:Section",
      "cof:title": "152EJ Factors relevant to granting a restraining injunction",
      "values:kind": "section",
      "cof:pageNumber": 424,
      "values:originalText": "The power of the Federal Court to grant an injunction under\nsection 152EG restraining a person from engaging in conduct may\nbe exercised whether or not:\n\n(a) it appears to the Court that the person intends to engage\nagain, or to continue to engage, in conduct of that kind; or\n\n(b) the person has previously engaged in conduct of that kind; or\n\n(c) there is an imminent danger of substantial damage to any\nperson if the first-mentioned person engages in conduct of\nthat kind."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ej-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-152ej"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ej-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Granting an injunction under section 152EG may be exercised",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ek",
      "@type": "cml:Concept",
      "skos:prefLabel": "152EK Factors relevant to granting a mandatory injunction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ek"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.424",
      "values:originalText": "The power of the Federal Court to grant an injunction under\nsection 152EG requiring a person to do a thing may be exercised\nwhether or not:\n\n(a) it appears to the Court that the person intends to refuse or fail\nagain, or to continue to refuse or fail, to do that thing; or\n\n(b) the person has previously refused or failed to do that thing; or\n\n(c) there is an imminent danger of substantial damage to any\nperson if the first-mentioned person refuses or fails to do that\nthing.",
      "skos:definition": "The power of the Federal Court to grant an injunction under\nsection 152EG requiring a person to do a thing may be exercised\nwhether or not:\n\n(a) it appears to the Court that the person intends to refuse or fail\nagain, or to continue to refuse or fail, to do that thing; or\n\n(b) the person has previously refused or failed to do that thing; or\n\n(c) there is an imminent danger of substantial damage to any\nperson if the first-mentioned person refuses or fails to do that\nthing.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152ek-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152ek-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "680c783742a009601cb4208cd5d50ecb5bf906768f820e29a301944b050cac81",
      "skos:note": "Court may grant injunction regardless of person's intentions or past actions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ek",
      "@type": "cof:Section",
      "cof:title": "152EK Factors relevant to granting a mandatory injunction",
      "values:kind": "section",
      "cof:pageNumber": 424,
      "values:originalText": "The power of the Federal Court to grant an injunction under\nsection 152EG requiring a person to do a thing may be exercised\nwhether or not:\n\n(a) it appears to the Court that the person intends to refuse or fail\nagain, or to continue to refuse or fail, to do that thing; or\n\n(b) the person has previously refused or failed to do that thing; or\n\n(c) there is an imminent danger of substantial damage to any\nperson if the first-mentioned person refuses or fails to do that\nthing."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ek-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-152ek"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
