          "@id": "concept:competition-and-consumer-act-2010-sec-154u-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154u-ss-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154u-ss-1-logic-ltl-3"
        },
