    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150k",
      "@type": "cml:Concept",
      "skos:prefLabel": "150K Gazettal of jurisdictions that excessively modify the Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.213",
      "values:originalText": "(1) If the Minister is satisfied that the laws of a participating\njurisdiction have made significant modifications to the\nCompetition Code in its application to persons within the\nlegislative competence of the participating jurisdiction, the\nMinister may publish a notice in the Gazette stating that the\nMinister is so satisfied.\n\n(2) The Minister may, by further notice in the Gazette, revoke a notice\npublished under subsection (1).\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "(1) If the Minister is satisfied that the laws of a participating\njurisdiction have made significant modifications to the\nCompetition Code in its application to persons within the\nlegislative competence of the participating jurisdiction, the\nMinister may publish a notice in the Gazette stating that the\nMinister is so satisfied.\n\n(2) The Minister may, by further notice in the Gazette, revoke a notice\npublished under subsection (1).\n\nChapter 7  Further provisions relating to particular industries etc.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150k-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150k-ss-2"
        }
      ],
      "cml:integrityHash": "6b7102d778db883f295a8c6b15a2a1f5855dcb9361238c98aee310cc4b1ee81a"
    },
