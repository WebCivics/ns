      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-140h",
      "@type": "cml:Concept",
      "skos:prefLabel": "140H Application laws may operate concurrently with this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.204",
      "values:originalText": "This Act is not intended to exclude the operation of any application\nlaw, to the extent that the application law is capable of operating\nconcurrently with this Act.",
      "skos:definition": "This Act is not intended to exclude the operation of any application\nlaw, to the extent that the application law is capable of operating\nconcurrently with this Act.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-140h-norm"
        }
      ],
      "cml:integrityHash": "091bd3ea92ee11a9fa1d8c991fd2559994ca6f5f9fc6a187ab92a2a4cd8c2c33",
      "skos:note": "Application laws may operate concurrently with this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140h",
      "@type": "cof:Section",
      "cof:title": "140H Application laws may operate concurrently with this Act",
      "values:kind": "section",
