        }
      ],
      "cml:integrityHash": "d4c1e2122e04ba519f3b4e9a23d5cee03606c69c07f05896de0ee0298ba9d1bd",
      "skos:note": "Registrar may make variations to conference agreement particulars"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-149-ss-4",
      "@type": "cof:Section",
