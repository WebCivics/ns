      },
      "cml:premiseText": "A defendant bears an evidential burden in relation to the matters in subsection (1A), see subsection 13.3(3) of the Criminal Code.",
      "cml:conclusionText": "The defendant is related to the matter of providing evidence for the excuse."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-160-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "160(2) Failure of witness to attend",
