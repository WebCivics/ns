    {
      "@id": "concept:competition-and-consumer-act-2010-sec-140j",
      "@type": "cml:Concept",
      "skos:prefLabel": "140J No doubling-up of liabilities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.204",
      "values:originalText": "(1) If:\n\n(a) an act or omission is an offence against this Act and is also\nan offence against an application law; and\n\n(b) the offender has been punished for the offence under the\napplication law;\nthe offender is not liable to be punished for the offence against this\nAct.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of a State or Territory  Part\nXIAA\n\nSection 140K\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(2) If a person has been ordered to pay a pecuniary penalty under an\napplication law, the person is not liable to a pecuniary penalty\nunder this Act in respect of the same conduct.",
      "skos:definition": "(1) If:\n\n(a) an act or omission is an offence against this Act and is also\nan offence against an application law; and\n\n(b) the offender has been punished for the offence under the\napplication law;\nthe offender is not liable to be punished for the offence against this\nAct.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of a State or Territory  Part\nXIAA\n\nSection 140K\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(2) If a person has been ordered to pay a pecuniary penalty under an\napplication law, the person is not liable to a pecuniary penalty\nunder this Act in respect of the same conduct.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-140j-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-140j-ss-2"
        }
      ],
      "cml:integrityHash": "d8bc2dec49bc065df0dd3debd9cb539d3165f21644fb749b47feca8b2af003bd"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140j",
      "@type": "cof:Section",
      "cof:title": "140J No doubling-up of liabilities",
      "values:kind": "section",
      "cof:pageNumber": 204,
      "values:originalText": "(1) If:\n\n(a) an act or omission is an offence against this Act and is also\nan offence against an application law; and\n\n(b) the offender has been punished for the offence under the\napplication law;\nthe offender is not liable to be punished for the offence against this\nAct.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of a State or Territory  Part\nXIAA\n\nSection 140K\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(2) If a person has been ordered to pay a pecuniary penalty under an\napplication law, the person is not liable to a pecuniary penalty\nunder this Act in respect of the same conduct."
    },
