    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-206-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Certain decisions are not reviewable.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Decision to provisionally or finally register a conference agreement is exempt.",
      "cml:conclusionText": "Review of such decision is not allowed."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-206-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
