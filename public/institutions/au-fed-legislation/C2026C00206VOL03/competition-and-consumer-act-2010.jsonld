      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.599",
      "values:originalText": "Division 3 of Part IVA applies in relation to a notification made on\nor after 1 July 2025.",
      "skos:definition": "Division 3 of Part IVA applies in relation to a notification made on\nor after 1 July 2025.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-188-norm"
        }
      ],
      "cml:integrityHash": "b621368ba48fe39e2b6e9cfd06b51f084eb09cff1cc801ecde9d202701eac95b",
      "skos:note": "Notification made on or after 1 July 2025 triggers Division 3 of Part IVA."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-188",
      "@type": "cof:Section",
      "cof:title": "188 Notifications may be made on or after 1 July 2025",
      "values:kind": "section",
      "cof:pageNumber": 599,
      "values:originalText": "Division 3 of Part IVA applies in relation to a notification made on\nor after 1 July 2025."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-188-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
