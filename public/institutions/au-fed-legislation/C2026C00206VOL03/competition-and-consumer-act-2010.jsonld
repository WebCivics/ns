      },
      "cml:premiseText": "There are reasonable grounds for suspecting that evidential material is held in, or is accessible from, the computer",
      "cml:conclusionText": "...the temporal interval for suspecting evidential material is held in or accessible from the computer"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "Specified person is reasonably suspected of having committed a contravention repeatedly",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The specified person is reasonably suspected of having committed one or more of the contraventions, stated in the search warrant",
      "cml:conclusionText": "...the specified person is reasonably suspected of having committed the contravention, or one or more of the contraventions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Magistrate has permission to grant the order if reasonable grounds exist",
      "cml:executionSurface": "modalities::logic::deontic",
