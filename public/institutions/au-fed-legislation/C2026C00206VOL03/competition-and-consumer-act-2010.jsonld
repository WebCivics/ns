    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150e",
      "@type": "cml:Concept",
      "skos:prefLabel": "150E Exercise of jurisdiction under cross-vesting provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.208",
      "values:originalText": "This Part does not affect the operation of any other law of the\nCommonwealth, or any law of a State or Territory, relating to\ncross-vesting of jurisdiction.",
      "skos:definition": "This Part does not affect the operation of any other law of the\nCommonwealth, or any law of a State or Territory, relating to\ncross-vesting of jurisdiction.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150e-norm"
        }
      ],
      "cml:integrityHash": "837cb7bbb834cf2d06acb68c135c36493b7560a588f3425b7425d4caab3cb8f9",
      "skos:note": "Does not affect other laws regarding cross-vesting of jurisdiction"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150e",
      "@type": "cof:Section",
      "cof:title": "150E Exercise of jurisdiction under cross-vesting provisions",
      "values:kind": "section",
      "cof:pageNumber": 208,
      "values:originalText": "This Part does not affect the operation of any other law of the\nCommonwealth, or any law of a State or Territory, relating to\ncross-vesting of jurisdiction."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150e-norm",
      "@type": "values:Undertaking",
