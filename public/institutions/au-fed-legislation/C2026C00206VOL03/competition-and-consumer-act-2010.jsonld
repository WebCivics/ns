      ],
      "cml:integrityHash": "1841774ff4fd58a0c59b69b4ae7b6869a68e19bcbc1a5f33f415cec24f44f6e0",
      "skos:note": "A person assisting an inspector may enter premises and exercise search-related powers under the direction of the inspector."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135d-ss-3",
      "@type": "cof:Section",
      "cof:title": "135D(3) Persons assisting inspectors",
      "values:kind": "subsection",
      "cof:pageNumber": 158,
      "values:originalText": "(3) A person assisting the inspector may:\n\n(a) enter the premises; and\n\n(b) exercise search-related powers in relation to the premises, but\nonly in accordance with a direction given to the person by the\ninspector.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of the Commonwealth  Part XI\nSearch, seizure and entry  Division 6\n\nSection 135E\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
