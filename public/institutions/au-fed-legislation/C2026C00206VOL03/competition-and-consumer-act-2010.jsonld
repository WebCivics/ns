      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.570",
      "values:originalText": "(2) A person who contravenes subsection (1) is guilty of an offence\npunishable on conviction by a fine not exceeding 20 penalty units\nor imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nMiscellaneous  Chapter 8\nMiscellaneous  Part XII\n\nSection 162A\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties.",
      "skos:definition": "(2) A person who contravenes subsection (1) is guilty of an offence\npunishable on conviction by a fine not exceeding 20 penalty units\nor imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nMiscellaneous  Chapter 8\nMiscellaneous  Part XII\n\nSection 162A\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-162"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-162-ss-2-norm"
        }
      ],
      "cml:integrityHash": "8138c8dc0c8bdbde683649c444361d60d29deca2b8b6feeac31405f8d50de32c",
      "skos:note": "Contravening subsection (1) is an offence punishable by fine or imprisonment."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-162-ss-2",
      "@type": "cof:Section",
      "cof:title": "162(2) Contempt",
      "values:kind": "subsection",
      "cof:pageNumber": 570,
      "values:originalText": "(2) A person who contravenes subsection (1) is guilty of an offence\npunishable on conviction by a fine not exceeding 20 penalty units\nor imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\nMiscellaneous  Chapter 8\nMiscellaneous  Part XII\n\nSection 162A\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties."
    },
