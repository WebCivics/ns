    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-193",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 79  Acting Registrar",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-193"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.106",
      "values:originalText": "The Minister may appoint a person to act as Registrar:\n\n(a) during a vacancy in the office of Registrar (whether or not an\nappointment has previously been made to the office); or\n\n(b) during any period, or during all periods, when the Registrar is\nabsent from duty or from Australia or is, for any other\nreason, unable to perform the duties of the office.",
      "skos:definition": "The Minister may appoint a person to act as Registrar:\n\n(a) during a vacancy in the office of Registrar (whether or not an\nappointment has previously been made to the office); or\n\n(b) during any period, or during all periods, when the Registrar is\nabsent from duty or from Australia or is, for any other\nreason, unable to perform the duties of the office.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-193-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-193-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d9375aaab76286f8f070afe9985ed96622ef6acd0633499f9b68e4fea38ec576",
      "skos:note": "Minister may appoint acting Registrar under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-193",
      "@type": "cof:Section",
      "cof:title": "10 79  Acting Registrar",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "The Minister may appoint a person to act as Registrar:\n\n(a) during a vacancy in the office of Registrar (whether or not an\nappointment has previously been made to the office); or\n\n(b) during any period, or during all periods, when the Registrar is\nabsent from duty or from Australia or is, for any other\nreason, unable to perform the duties of the office."
    },
