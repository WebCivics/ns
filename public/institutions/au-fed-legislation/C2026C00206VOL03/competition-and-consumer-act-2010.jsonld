    {
      "@id": "concept:competition-and-consumer-act-2010-sec-131g",
      "@type": "cml:Concept",
      "skos:prefLabel": "131G Application of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-131g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.126",
      "values:originalText": "Corporate criminal responsibility\n\n(1) Part 2.5 of the Criminal Code does not apply to an offence against\nthis Part or the Australian Consumer Law.\nMistake of fact defence\n\n(2) Section 9.2 of the Criminal Code does not apply to an offence\nagainst Chapter 4 of the Australian Consumer Law.\nNote:\nSection 207 of the Australian Consumer Law provides a mistake of\nfact defence for offences under Chapter 4 of the Australian Consumer\nLaw.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of the Commonwealth  Part XI\nConferences for proposed bans and recall notices  Division 3\n\nSection 132\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Corporate criminal responsibility\n\n(1) Part 2.5 of the Criminal Code does not apply to an offence against\nthis Part or the Australian Consumer Law.\nMistake of fact defence\n\n(2) Section 9.2 of the Criminal Code does not apply to an offence\nagainst Chapter 4 of the Australian Consumer Law.\nNote:\nSection 207 of the Australian Consumer Law provides a mistake of\nfact defence for offences under Chapter 4 of the Australian Consumer\nLaw.\n\nOther provisions  Chapter 6\nApplication of the Australian Consumer Law as a law of the Commonwealth  Part XI\nConferences for proposed bans and recall notices  Division 3\n\nSection 132\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-131g-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-131g-ss-2"
        }
      ],
      "cml:integrityHash": "6fcd8612d5f1cb808f07958d0e63f93cbebb0523bd7b6131950060ed657aaf28"
    },
