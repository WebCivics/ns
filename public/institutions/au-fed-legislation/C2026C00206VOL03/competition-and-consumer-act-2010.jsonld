    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ar-ss-4a",
      "@type": "cml:Concept",
      "skos:prefLabel": "152AR(4A) Category A standard access obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ar-ss-4a"
