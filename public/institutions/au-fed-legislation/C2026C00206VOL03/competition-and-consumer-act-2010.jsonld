      },
      "cml:operator": "Cannot",
      "cml:logicSummary": "Prohibition of giving embargo notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Earlier embargo notice did not end at least 5 days ago",
      "cml:conclusionText": "Inspector must not give embargo notice"
    },
