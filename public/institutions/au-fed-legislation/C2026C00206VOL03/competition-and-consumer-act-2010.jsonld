      "skos:note": "Conditions must be met before revocation can occur."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153v-ss-4",
      "@type": "cof:Section",
      "cof:title": "153V(4) Commission may vary or revoke no Treasurer action notice",
      "values:kind": "subsection",
      "cof:pageNumber": 448,
