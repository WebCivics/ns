    {
      "@id": "concept:competition-and-consumer-act-2010-sec-139c-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "139C(2) Conduct of employees or agents of persons other than bodies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-139c-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.193",
      "values:originalText": "(2) Any conduct engaged in on behalf of a person (the principal) other\nthan a body corporate:\n\n(a) by an employee or agent of the principal within the scope of\nthe actual or apparent authority of the employee or agent; or\n\n(b) by any other person:\n\n(i) at the direction of an employee or agent of the principal;\nor\n\nChapter 6  Other provisions",
      "skos:definition": "(2) Any conduct engaged in on behalf of a person (the principal) other\nthan a body corporate:\n\n(a) by an employee or agent of the principal within the scope of\nthe actual or apparent authority of the employee or agent; or\n\n(b) by any other person:\n\n(i) at the direction of an employee or agent of the principal;\nor\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-139c"
      },
      "cml:asserts": [
