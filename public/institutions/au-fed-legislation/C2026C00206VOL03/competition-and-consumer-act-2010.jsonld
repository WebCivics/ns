    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ar-ss-4b",
      "@type": "cml:Concept",
      "skos:prefLabel": "152AR(4B) Category A standard access obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ar-ss-4b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.316",
      "values:originalText": "(4B) The regulations may provide that, for the purposes of\nsubsection (4A), a specified act or thing is taken to be ordering.\nNote:\nFor specification by class, see subsection 13(3) of the Legislation Act\n2003.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "(4B) The regulations may provide that, for the purposes of\nsubsection (4A), a specified act or thing is taken to be ordering.\nNote:\nFor specification by class, see subsection 13(3) of the Legislation Act\n2003.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-152ar"
      },
      "cml:asserts": [
