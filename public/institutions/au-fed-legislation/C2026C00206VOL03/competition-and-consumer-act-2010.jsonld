      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval for delegation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The delegation is valid during the period of the Minister's power",
      "cml:conclusionText": "The Registrar or specified person may perform certain actions during this time"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Delegation implies authority",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the Minister delegates a power, then the Registrar or specified person has that power",
      "cml:conclusionText": "The Registrar or specified person may perform certain actions if delegated by the Minister"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:logicSummary": "Delegation diffuses authority",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The delegation of a power diffuses the authority from the Minister to the Registrar or specified person",
      "cml:conclusionText": "The Registrar or specified person has the authority to perform certain actions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-cogai-5",
