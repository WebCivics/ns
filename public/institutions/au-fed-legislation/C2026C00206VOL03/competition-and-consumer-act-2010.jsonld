      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153v-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to give recommendations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153v-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "153V(6) Commission may vary or revoke no Treasurer action notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153v-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.448",
      "values:originalText": "(6) The condition in this subsection is met if the Commission\nreasonably believes that:\n\n(a) all of the following conditions are met:\n\n(i) the corporation or any related body corporate gave the\nCommission information relevant to the prohibited\nconduct notice that is false or misleading in a material\nparticular, or failed to give the Commission information\nrelevant to the prohibited conduct notice that is not\npublicly available;\n\n(ii) the revocation is reasonably necessary to address the\ncircumstances described in subparagraph (i); or\n\n(b) the revocation is reasonably necessary to address information\nthat was not in existence, or that the Commission did not\nhave, when the prohibited conduct notice was given.",
      "skos:definition": "(6) The condition in this subsection is met if the Commission\nreasonably believes that:\n\n(a) all of the following conditions are met:\n\n(i) the corporation or any related body corporate gave the\nCommission information relevant to the prohibited\nconduct notice that is false or misleading in a material\nparticular, or failed to give the Commission information\nrelevant to the prohibited conduct notice that is not\npublicly available;\n\n(ii) the revocation is reasonably necessary to address the\ncircumstances described in subparagraph (i); or\n\n(b) the revocation is reasonably necessary to address information\nthat was not in existence, or that the Commission did not\nhave, when the prohibited conduct notice was given.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-153v"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153v-ss-6-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153v-ss-6-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153v-ss-6-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153v-ss-6-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "a15fe20c478b7836c1d6401dd54ff7c4d65f89c17069231dab0aeac9e1eda9a3",
      "skos:note": "Commission may revoke notice if corporation provides false or misleading information."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153v-ss-6",
      "@type": "cof:Section",
      "cof:title": "153V(6) Commission may vary or revoke no Treasurer action notice",
      "values:kind": "subsection",
      "cof:pageNumber": 448,
      "values:originalText": "(6) The condition in this subsection is met if the Commission\nreasonably believes that:\n\n(a) all of the following conditions are met:\n\n(i) the corporation or any related body corporate gave the\nCommission information relevant to the prohibited\nconduct notice that is false or misleading in a material\nparticular, or failed to give the Commission information\nrelevant to the prohibited conduct notice that is not\npublicly available;\n\n(ii) the revocation is reasonably necessary to address the\ncircumstances described in subparagraph (i); or\n\n(b) the revocation is reasonably necessary to address information\nthat was not in existence, or that the Commission did not\nhave, when the prohibited conduct notice was given."
    },
