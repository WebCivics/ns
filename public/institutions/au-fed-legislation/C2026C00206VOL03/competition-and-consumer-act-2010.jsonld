    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-163-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(2) 53  Non-conference ocean carrier with substantial market power",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-163-ss-2"
      },
      "cml:curationStatus": {
