        }
      ],
      "cml:integrityHash": "623f04e19b68c009becc4d2a45e599af718de17b8196b393447bfe4c05588a8d",
      "skos:note": "Person liable for costs of seizing consumer goods or equipment"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135q-ss-1",
      "@type": "cof:Section",
      "cof:title": "135Q(1) Recovery of reasonable costs of seizing consumer goods or",
      "values:kind": "subsection",
      "cof:pageNumber": 164,
      "values:originalText": "(1) If an inspector seizes consumer goods or equipment under a search\nwarrant:\n\n(a) the person from whom the consumer goods were seized, or\nthe equipment was seized; or\n\n(b) if that person is not entitled to possess the consumer goods or\nequipment—the owner of the consumer goods or equipment;\nis liable to pay an amount equal to the costs reasonably incurred by\nthe inspector in seizing the consumer goods or equipment."
    },
