    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135q-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "135Q(2) Recovery of reasonable costs of seizing consumer goods or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135q-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
