      },
      "cml:premiseText": "Body corporate takes reasonable precautions and exercises due diligence",
      "cml:conclusionText": "Conduct not taken by body corporate is excused"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152eo-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
