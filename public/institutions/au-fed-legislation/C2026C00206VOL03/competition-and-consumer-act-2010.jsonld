      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.76",
      "values:originalText": "(7) A direction under subsection (1) must be given in writing, and the\nRegistrar shall serve a copy of the direction on the parties to the\nconference agreement concerned.",
      "skos:definition": "(7) A direction under subsection (1) must be given in writing, and the\nRegistrar shall serve a copy of the direction on the parties to the\nconference agreement concerned.",
