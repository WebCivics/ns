        }
      ],
      "cml:integrityHash": "d04f292ee65b00d07b8b20a970b811e485b99d6d57488ec440df68253f14a458",
      "skos:note": "Different provision for different carriers or carriage service providers"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152bc-ss-5",
      "@type": "cof:Section",
      "cof:title": "152BC(5) Access determinations",
      "values:kind": "subsection",
      "cof:pageNumber": 342,
      "values:originalText": "(5) An access determination may make different provision with respect\nto:\n\n(a) different carriers or carriage service providers; or\n\n(b) different classes of carriers or carriage service providers; or\n\n(c) different access seekers; or\n\n(d) different classes of access seekers."
    },
