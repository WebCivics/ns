      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.342",
      "values:originalText": "(5) An access determination may make different provision with respect\nto:\n\n(a) different carriers or carriage service providers; or\n\n(b) different classes of carriers or carriage service providers; or\n\n(c) different access seekers; or\n\n(d) different classes of access seekers.",
      "skos:definition": "(5) An access determination may make different provision with respect\nto:\n\n(a) different carriers or carriage service providers; or\n\n(b) different classes of carriers or carriage service providers; or\n\n(c) different access seekers; or\n\n(d) different classes of access seekers.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-152bc"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152bc-ss-5-norm"
        },
