    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-138d-ss-1",
      "@type": "cof:Section",
      "cof:title": "138D(1) Transfer of matters by a State or Territory court",
      "values:kind": "subsection",
      "cof:pageNumber": 187,
      "values:originalText": "(1) This section applies if:\n\n(a) a proceeding is pending in a court (other than the Supreme\nCourt) of a State or a Territory; and\n\n(b) a matter for determination in the proceeding arises under this\nPart or the Australian Consumer Law, other than under\nChapter 4 of the Australian Consumer Law."
    },
