      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to delegate",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
