    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-186",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 72D  Conditions of exemption order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-186"
      },
      "cml:curationStatus": {
