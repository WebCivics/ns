      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.316",
      "values:originalText": "(4A) To avoid doubt, ordering and provisioning are taken to be aspects\nof technical and operational quality referred to in paragraph (3)(b).",
      "skos:definition": "(4A) To avoid doubt, ordering and provisioning are taken to be aspects\nof technical and operational quality referred to in paragraph (3)(b).",
      "values:partOf": {
