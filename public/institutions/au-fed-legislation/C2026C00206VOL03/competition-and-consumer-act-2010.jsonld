      "cml:integrityHash": "7498851fdd60a6dbba50977fdb3a6f4a592bf965281cc4ded4e33676bf7dd06e",
      "skos:note": "Commission's satisfaction is a condition for exemption from subsection (3)"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zk-ss-4",
      "@type": "cof:Section",
      "cof:title": "154ZK(4) Notice—further action to deal with complaint",
      "values:kind": "subsection",
      "cof:pageNumber": 523,
      "values:originalText": "(4) However, subsection (3) does not apply if the Commission is\nsatisfied that circumstances prescribed in the designated\ncomplaints determination apply."
    },
