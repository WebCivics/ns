          "@id": "concept:competition-and-consumer-act-2010-sec-10-185-ss-2"
        }
      ],
      "cml:integrityHash": "d2a35ec136d3a4763fb2532d40f4528824df2af2d6814c4d3faeb665a8112f1f"
    },
