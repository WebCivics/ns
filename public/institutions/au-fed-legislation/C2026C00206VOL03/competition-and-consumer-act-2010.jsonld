    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-155-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(6) 46  Action to be taken where powers exercised by Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-155-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.81",
      "values:originalText": "(6) Subsection (1) shall not be taken by implication to limit the matters\nthat may be referred to the Commission under section 10.47.\n\nChapter 6  Other provisions",
      "skos:definition": "(6) Subsection (1) shall not be taken by implication to limit the matters\nthat may be referred to the Commission under section 10.47.\n\nChapter 6  Other provisions",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-10-155"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-155-ss-6-norm"
        }
      ],
      "cml:integrityHash": "0833ff39ed6f783643686d65a23d4fa530f6a9d45940baf6b195998a4e401ccd",
      "skos:note": "No implication that subsection (1) limits matters referred to the Commission under section 10.47."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-155-ss-6",
      "@type": "cof:Section",
      "cof:title": "10(6) 46  Action to be taken where powers exercised by Minister",
      "values:kind": "subsection",
      "cof:pageNumber": 81,
      "values:originalText": "(6) Subsection (1) shall not be taken by implication to limit the matters\nthat may be referred to the Commission under section 10.47.\n\nChapter 6  Other provisions"
    },
