    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152aq-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "152AQ(2) Register of declared services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152aq-ss-2"
