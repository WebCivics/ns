      ],
      "cml:integrityHash": "0eb73634c38b4bd61e3634a3c8d488d4993a1046b2737a486f015fc3f8a79864",
      "skos:note": "Commission must grant or reject application"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ba",
      "@type": "cof:Section",
      "cof:title": "151BA Commission must grant or reject application",
      "values:kind": "section",
      "cof:pageNumber": 236,
      "values:originalText": "If the Commission receives an application for an exemption order,\nthe Commission must either:\n\n(a) make the order; or\n\n(b) refuse to make the order."
    },
