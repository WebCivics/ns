        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-202-ss-4-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "b88fee00363e8bae15f1ae0ca072f94605917fa7215c1f6299d4e44bbe87c6d1",
      "skos:note": "May consider information given to Minister in connection with decision-making."
    },
    {
