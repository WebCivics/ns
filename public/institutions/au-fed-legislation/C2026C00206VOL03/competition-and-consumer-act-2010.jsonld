        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151aq-ss-2-logic-linearlogic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151aq-ss-2-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "bf359b1db42e4ed2951b76090260db3dca66b048618b0a443958f64b69fe8a76",
      "skos:note": "Failure to comply does not affect competition notice validity Court must not make orders staying or affecting the operation of a decision pending its finalisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151aq-ss-2",
      "@type": "cof:Section",
      "cof:title": "151AQ(2) Commission to act expeditiously",
      "values:kind": "subsection",
