    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-204",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 82G  Provisions that do not apply in relation to a Tribunal review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-204"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.112",
      "values:originalText": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Minister of a kind mentioned in\nsection 10.82D.\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nMiscellaneous  Division 15\n\nSection 10.83\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Minister of a kind mentioned in\nsection 10.82D.\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nMiscellaneous  Division 15\n\nSection 10.83\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-204-norm"
        }
      ],
      "cml:integrityHash": "d9433025d7cc0a453c27a21bdfb8c2ccfe3c8f3ee1855338f1291475d5818a29",
      "skos:note": "Division 1 of Part IX does not apply in relation to a review by the Tribunal of a decision of the Minister of a kind mentioned in section 10.82D."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-204",
      "@type": "cof:Section",
      "cof:title": "10 82G  Provisions that do not apply in relation to a Tribunal review",
      "values:kind": "section",
      "cof:pageNumber": 112,
      "values:originalText": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Minister of a kind mentioned in\nsection 10.82D.\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nMiscellaneous  Division 15\n\nSection 10.83\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
