    {
      "@id": "concept:competition-and-consumer-act-2010-sec-162a",
      "@type": "cml:Concept",
      "skos:prefLabel": "162A Intimidation etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-162a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.571",
      "values:originalText": "A person who:\n\n(a) threatens, intimidates or coerces another person; or\n\n(b) causes or procures damage, loss or disadvantage to another\nperson;\nfor or on account of that other person proposing to furnish or\nhaving furnished information, or proposing to produce or having\nproduced documents, to the Commission, the Tribunal or the AER,\nor for or on account of the other person proposing to appear or\nhaving appeared as a witness before the Tribunal is guilty of an\noffence punishable on conviction by a fine not exceeding 20\npenalty units or imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties.",
      "skos:definition": "A person who:\n\n(a) threatens, intimidates or coerces another person; or\n\n(b) causes or procures damage, loss or disadvantage to another\nperson;\nfor or on account of that other person proposing to furnish or\nhaving furnished information, or proposing to produce or having\nproduced documents, to the Commission, the Tribunal or the AER,\nor for or on account of the other person proposing to appear or\nhaving appeared as a witness before the Tribunal is guilty of an\noffence punishable on conviction by a fine not exceeding 20\npenalty units or imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-162a-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-162a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d0f63340d47dad101913a48b6de8537aa565aa290183113423203afd65080a81",
      "skos:note": "Threatening, intimidating or coercing another person is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-162a",
      "@type": "cof:Section",
      "cof:title": "162A Intimidation etc.",
      "values:kind": "section",
      "cof:pageNumber": 571,
      "values:originalText": "A person who:\n\n(a) threatens, intimidates or coerces another person; or\n\n(b) causes or procures damage, loss or disadvantage to another\nperson;\nfor or on account of that other person proposing to furnish or\nhaving furnished information, or proposing to produce or having\nproduced documents, to the Commission, the Tribunal or the AER,\nor for or on account of the other person proposing to appear or\nhaving appeared as a witness before the Tribunal is guilty of an\noffence punishable on conviction by a fine not exceeding 20\npenalty units or imprisonment for 12 months.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\nNote 2:\nPart IA of the Crimes Act 1914 contains provisions dealing with\npenalties."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-162a-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-162a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
