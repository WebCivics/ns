        }
      ],
      "cml:integrityHash": "bca354b2726e90192281e87786e0ec82c33ec1e0b0bea0fd7c0f0511bd9f54b2",
      "skos:note": "Exemptions from application of Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-172-ss-2",
