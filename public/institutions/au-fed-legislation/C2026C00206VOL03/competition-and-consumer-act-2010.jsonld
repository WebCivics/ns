    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151at",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AT Form of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151at"
