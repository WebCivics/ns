    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154j-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Executing officer has a duty to secure electronic equipment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Reasonable grounds exist that evidence may be destroyed or altered if not secured.",
      "cml:conclusionText": "Executing officer must take action to secure the equipment."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154j-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Securing electronic equipment is a necessary step in executing a search warrant.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The kind of evidential material specified in the warrant may be accessible by operating electronic equipment at the premises.",
      "cml:conclusionText": "Securing electronic equipment is a prerequisite for executing the search warrant."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154j-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Executing officer must take action to secure the equipment before the evidence may be destroyed or altered.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If he or she does not take action under this subsection, the material may be destroyed, altered or otherwise interfered with;",
      "cml:conclusionText": "Executing officer's inaction would result in destruction or alteration of evidence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154j-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Executing officer must take action to secure the equipment before the evidence may be destroyed or altered.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If he or she does not take action under this subsection, the material may be destroyed, altered or otherwise interfered with;",
      "cml:conclusionText": "Executing officer's inaction would result in destruction or alteration of evidence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154j-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "Executing officer has permission to take action to secure electronic equipment if necessary.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Reasonable grounds exist that evidence may be destroyed or altered if not secured.",
      "cml:conclusionText": "Executing officer is authorized to take action to secure the equipment."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154j-ss-1-logic-argumentation-6",
