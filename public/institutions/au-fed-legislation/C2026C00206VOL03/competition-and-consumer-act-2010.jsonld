    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-131",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 24  Exemptions from sections 45AF, 45AG, 45AJ, 45AK, 45 and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-131"
