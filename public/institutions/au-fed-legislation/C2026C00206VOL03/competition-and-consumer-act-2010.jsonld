    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ck",
      "@type": "cml:Concept",
      "skos:prefLabel": "151CK Provisions that do not apply in relation to a Tribunal review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ck"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.280",
      "values:originalText": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Commission of a kind mentioned in\nsection 151CI.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "skos:definition": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Commission of a kind mentioned in\nsection 151CI.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151ck-norm"
        }
      ],
      "cml:integrityHash": "b5fc88cd545ca532e8225e117cbcd6a8914abb37b46af206f9ab145bb6637dc8",
      "skos:note": "Exempts Division 1 of Part IX from Tribunal review for Commission decisions under section 151CI."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ck",
      "@type": "cof:Section",
      "cof:title": "151CK Provisions that do not apply in relation to a Tribunal review",
      "values:kind": "section",
      "cof:pageNumber": 280,
      "values:originalText": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Commission of a kind mentioned in\nsection 151CI.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ck-norm",
