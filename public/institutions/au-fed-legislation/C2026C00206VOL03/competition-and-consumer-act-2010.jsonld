      "cml:integrityHash": "cc089699c7d46d8e7adc083e69f20dcddabeac98e1773afa3d83fb7c37f305ec",
      "skos:note": "Chairperson may appoint a staff member as an inspector."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154b-ss-1",
      "@type": "cof:Section",
      "cof:title": "154B(1) Appointment of inspectors",
      "values:kind": "subsection",
      "cof:pageNumber": 494,
      "values:originalText": "(1) The Chairperson may, by writing, appoint a member of the staff\nassisting the Commission to be an inspector.\nStaff member to have suitable qualifications and experience"
    },
