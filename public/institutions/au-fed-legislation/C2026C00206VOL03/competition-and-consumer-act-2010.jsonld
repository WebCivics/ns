      "cml:conclusionText": "must equal the amount worked out using the table"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134c-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": ">",
      "cml:logicSummary": "Specifies different penalty amounts for different types of corporations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) if the person is a listed corporation—600 penalty units...",
      "cml:conclusionText": "must be greater than or equal to that amount"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134c-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "<",
      "cml:logicSummary": "Specifies different penalty amounts for different types of corporations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) if the person is a body corporate other than a listed corporation—60 penalty units...",
      "cml:conclusionText": "must be less than or equal to that amount"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134c-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "<",
      "cml:logicSummary": "Specifies different penalty amounts for individuals",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) if the person is not a body corporate—12 penalty units...",
      "cml:conclusionText": "must be less than or equal to that amount"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134c-logic-alleninterval-5",
