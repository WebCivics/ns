        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-3a-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "3923196cc3ec7ff2b087e7c59eb05476c95fb604012f6af99ede2b535b2ce976",
      "skos:note": "Defendant bears evidential burden in relation to reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-155b-ss-3a",
      "@type": "cof:Section",
      "cof:title": "155B(3A) Australian Competition and Consumer Commission may",
      "values:kind": "subsection",
      "cof:pageNumber": 550,
      "values:originalText": "(3A) Paragraph (3)(a) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matters in\nsubsection (3A), see subsection 13.3(3) of the Criminal Code."
    },
