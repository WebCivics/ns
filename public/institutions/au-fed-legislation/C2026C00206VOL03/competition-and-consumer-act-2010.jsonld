    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-199",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 82C  Provisions that do not apply in relation to a Tribunal review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-199"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.109",
      "values:originalText": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Commission of a kind mentioned in\nsection 10.82A.\n\nChapter 6  Other provisions",
      "skos:definition": "Division 1 of Part IX does not apply in relation to a review by the\nTribunal of a decision of the Commission of a kind mentioned in\nsection 10.82A.\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
