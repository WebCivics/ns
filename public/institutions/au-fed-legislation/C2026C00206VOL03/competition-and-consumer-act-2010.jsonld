    {
      "@id": "concept:competition-and-consumer-act-2010-sec-181",
      "@type": "cml:Concept",
      "skos:prefLabel": "181 Amendment of the definition of competition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-181"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.590",
      "values:originalText": "The repeal and substitution of the definition of competition in\nsubsection 4(1) made by Schedule 1 to the amending Act applies in\nrelation to conduct engaged in at or after the commencement time.",
      "skos:definition": "The repeal and substitution of the definition of competition in\nsubsection 4(1) made by Schedule 1 to the amending Act applies in\nrelation to conduct engaged in at or after the commencement time.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-181-norm"
        }
      ],
      "cml:integrityHash": "75dad2a738ab6b1064e4cd8260c2a221b8ea7d560c7d7079cb0d91f8b95b3deb",
      "skos:note": "Repeal and substitution of definition of competition applies in relation to conduct engaged in at or after commencement time."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-181",
      "@type": "cof:Section",
      "cof:title": "181 Amendment of the definition of competition",
      "values:kind": "section",
      "cof:pageNumber": 590,
      "values:originalText": "The repeal and substitution of the definition of competition in\nsubsection 4(1) made by Schedule 1 to the amending Act applies in\nrelation to conduct engaged in at or after the commencement time."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-181-norm",
