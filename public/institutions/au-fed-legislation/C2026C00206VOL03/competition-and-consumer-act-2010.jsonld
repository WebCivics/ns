    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140e-ss-3",
      "@type": "cof:Section",
      "cof:title": "140E(3) Commonwealth consent to conferral of functions etc. on",
      "values:kind": "subsection",
      "cof:pageNumber": 202,
      "values:originalText": "(3) The Commonwealth entity cannot perform a duty or function, or\nexercise a power, under an application law unless the conferral of\nthe function or power, or the imposition of the duty, is in\naccordance with an agreement between the Commonwealth and the\nState or Territory concerned."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-140e-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
