    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153x-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "153X(6) Treasurer may make contracting order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153x-ss-6"
