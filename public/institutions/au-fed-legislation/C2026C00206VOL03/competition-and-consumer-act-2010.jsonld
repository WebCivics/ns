    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135t-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "135T(5) Embargo period for embargo notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135t-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.167",
      "values:originalText": "(5) The judge may extend the embargo period for a specified period if\nthe judge is satisfied that the extension is necessary in all the\ncircumstances.\n\nChapter 6  Other provisions",
      "skos:definition": "(5) The judge may extend the embargo period for a specified period if\nthe judge is satisfied that the extension is necessary in all the\ncircumstances.\n\nChapter 6  Other provisions",
