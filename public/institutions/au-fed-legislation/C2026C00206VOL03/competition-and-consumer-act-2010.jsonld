    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-140",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 31  How application is to be made and verified",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-140"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.64",
      "values:originalText": "(1) An application for the final registration of a conference agreement\nmust be:\n\n(a) in the appropriate prescribed form;\n\n(b) made to the Registrar in accordance with the regulations; and\n\n(c) accompanied by the appropriate prescribed fee.\n\n(2) The application must comply with any regulations requiring its\nverification (in whole or part) by or on behalf of the applicants.\n\n(3) The application may be made by a party to the agreement on behalf\nof the party and other parties to the agreement.",
      "skos:definition": "(1) An application for the final registration of a conference agreement\nmust be:\n\n(a) in the appropriate prescribed form;\n\n(b) made to the Registrar in accordance with the regulations; and\n\n(c) accompanied by the appropriate prescribed fee.\n\n(2) The application must comply with any regulations requiring its\nverification (in whole or part) by or on behalf of the applicants.\n\n(3) The application may be made by a party to the agreement on behalf\nof the party and other parties to the agreement.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-140-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-140-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-140-ss-3"
        }
      ],
      "cml:integrityHash": "c6ba8b24a532c7a9e4f94021b3f407cc75c407c533756d7008a2cdc37615bf09"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-140",
      "@type": "cof:Section",
      "cof:title": "10 31  How application is to be made and verified",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "(1) An application for the final registration of a conference agreement\nmust be:\n\n(a) in the appropriate prescribed form;\n\n(b) made to the Registrar in accordance with the regulations; and\n\n(c) accompanied by the appropriate prescribed fee.\n\n(2) The application must comply with any regulations requiring its\nverification (in whole or part) by or on behalf of the applicants.\n\n(3) The application may be made by a party to the agreement on behalf\nof the party and other parties to the agreement."
    },
