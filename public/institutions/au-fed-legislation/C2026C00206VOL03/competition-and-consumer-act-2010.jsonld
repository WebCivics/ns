      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.125",
      "values:originalText": "Law\n\nChapter 5 of the Australian Consumer Law has effect subject to",
      "skos:definition": "Law\n\nChapter 5 of the Australian Consumer Law has effect subject to",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-131d-norm"
        }
      ],
      "cml:integrityHash": "7e8fd96dbc5a7804d5971ae065ff50491b0879389d590ea27fb07c75f4299689",
      "skos:note": "Chapter 5 of the Australian Consumer Law has effect subject to certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-131d",
      "@type": "cof:Section",
      "cof:title": "131D Effect of Part VIB on Chapter 5 of the Australian Consumer",
      "values:kind": "section",
      "cof:pageNumber": 125,
      "values:originalText": "Law\n\nChapter 5 of the Australian Consumer Law has effect subject to"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-131d-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
