          "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-3a"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-4"
        },
