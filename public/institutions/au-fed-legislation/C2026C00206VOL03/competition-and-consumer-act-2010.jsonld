      "skos:note": "Certificate as evidence of furnished particulars"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-166-ss-2",
      "@type": "cof:Section",
      "cof:title": "166(2) Certificates as to furnishing of particulars to Commission",
      "values:kind": "subsection",
      "cof:pageNumber": 577,
      "values:originalText": "(2) A certificate referred to in subsection (1) shall be received in all\ncourts as evidence that the particulars specified in the certificate\nwere furnished to the Commission on the date so specified.\n\nChapter 8  Miscellaneous"
    },
