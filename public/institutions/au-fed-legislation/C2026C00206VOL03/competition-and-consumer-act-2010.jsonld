        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135q-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "04a966848fa0abd627f152fdaab120e3622ff650d3443961eaa00d4a605e0d94",
      "skos:note": "Debt due by a person to the Commonwealth"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135q-ss-2",
      "@type": "cof:Section",
      "cof:title": "135Q(2) Recovery of reasonable costs of seizing consumer goods or",
      "values:kind": "subsection",
      "cof:pageNumber": 164,
      "values:originalText": "(2) An amount payable by a person under subsection (1):\n\n(a) is a debt due by the person to the Commonwealth; and\n\n(b) may be recovered by action in a court of competent\njurisdiction."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135q-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
