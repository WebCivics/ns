    {
      "@id": "concept:competition-and-consumer-act-2010-sec-138-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "138(2) Conferring jurisdiction on the Federal Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-138-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
