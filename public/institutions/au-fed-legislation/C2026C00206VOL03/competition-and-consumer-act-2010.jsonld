    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "135(3) Inspector may enter premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135-ss-3"
      },
      "cml:curationStatus": {
