      ],
      "cml:integrityHash": "9aa1b75e23ddd9c51d2fd6d542ef8edf4e6e731b2b3de95f8b4b6b21ca77a7bc",
      "skos:note": "Registrar must enter particulars of order in register of obligations concerning unfair pricing practices."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-171-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) 61  Powers exercisable by Minister in relation to pricing practices",
      "values:kind": "subsection",
      "cof:pageNumber": 95,
      "values:originalText": "(2) Where the Minister makes an order under subsection (1), the\nRegistrar shall immediately enter particulars of the order in the\nregister of obligations concerning unfair pricing practices."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-171-ss-2-norm",
