    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-145",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 36  Examination of abstract",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-145"
      },
      "cml:curationStatus": {
