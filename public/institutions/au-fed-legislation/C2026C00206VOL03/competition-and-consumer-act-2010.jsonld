      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.42",
      "values:originalText": "(3) Where the Minister declares that an association is a designated\noutwards peak shipper body, a designated inwards peak shipper\nbody, a designated outwards secondary shipper body or a\ndesignated inwards secondary shipper body for the purposes of this\nPart, the Registrar shall enter particulars of the association in the\nregister of designated shipper bodies.",
      "skos:definition": "(3) Where the Minister declares that an association is a designated\noutwards peak shipper body, a designated inwards peak shipper\nbody, a designated outwards secondary shipper body or a\ndesignated inwards secondary shipper body for the purposes of this\nPart, the Registrar shall enter particulars of the association in the\nregister of designated shipper bodies.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-10-111"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-111-ss-3-norm"
        }
      ],
      "cml:integrityHash": "235026d3142f8cbdf3f9e5cb606e218e8b09c8c76168811f3388c030ea658797",
      "skos:note": "Designation of shipper bodies by Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-111-ss-3",
      "@type": "cof:Section",
      "cof:title": "10(3) 03  Designated shipper bodies",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(3) Where the Minister declares that an association is a designated\noutwards peak shipper body, a designated inwards peak shipper\nbody, a designated outwards secondary shipper body or a\ndesignated inwards secondary shipper body for the purposes of this\nPart, the Registrar shall enter particulars of the association in the\nregister of designated shipper bodies."
    },
