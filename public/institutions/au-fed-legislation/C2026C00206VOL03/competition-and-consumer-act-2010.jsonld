    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ac",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AC Extension to external Territories",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ac"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.217",
      "values:originalText": "(1) This Part, and the other provisions of this Act so far as they relate\nto this Part, extend to each eligible Territory (within the meaning\nof the Telecommunications Act 1997).\n\n(2) The operation of this Part, and the other provisions of this Act so\nfar as they relate to this Part, in relation to Norfolk Island is not\naffected by the amendments made by Division 1 of Part 1 of\nSchedule 5 to the Territories Legislation Amendment Act 2016.",
      "skos:definition": "(1) This Part, and the other provisions of this Act so far as they relate\nto this Part, extend to each eligible Territory (within the meaning\nof the Telecommunications Act 1997).\n\n(2) The operation of this Part, and the other provisions of this Act so\nfar as they relate to this Part, in relation to Norfolk Island is not\naffected by the amendments made by Division 1 of Part 1 of\nSchedule 5 to the Territories Legislation Amendment Act 2016.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151ac-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151ac-ss-2"
        }
      ],
      "cml:integrityHash": "2bd7c6e179ee3883c2249717d4a119f63345d63f15504bbb73528fe251d3a8c4"
    },
    {
