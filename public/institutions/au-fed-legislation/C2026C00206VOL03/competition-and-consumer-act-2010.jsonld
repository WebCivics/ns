      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:logicSummary": "Voluntary consent is necessary for its effectiveness.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A consent has no effect unless the consent is voluntary.",
      "cml:conclusionText": "If a consent is voluntary, then it has an effect."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:logicSummary": "Voluntary consent is necessary for its effectiveness.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A consent has no effect unless the consent is voluntary.",
      "cml:conclusionText": "If a consent is not voluntary, then it does not have an effect."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The temporal interval of 'consent' must overlap with the current time for this provision to apply.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A consent has no effect unless the consent is voluntary.",
      "cml:conclusionText": "Consent can only be given at a time when it is effective."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The temporal interval of 'consent' must be before the current time for this provision to apply.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A consent has no effect unless the consent is voluntary.",
      "cml:conclusionText": "Consent can only be given in the past."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The information about 'consent' must be diffused to all relevant parties for this provision to apply.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A consent has no effect unless the consent is voluntary.",
      "cml:conclusionText": "Consent must be communicated to all parties involved."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "135H(3) Consent",
      "cml:realizedBy": {
