      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Restrictive",
      "cml:logicSummary": "Limits binding rules of conduct to specific entities.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) In particular, binding rules of conduct may be limited to:\n\n(a) particular carriers or carriage service providers; or\n\n(b) particular classes of carriers or carriage service providers; or\n\n(c) particular access seekers; or\n\n(d) particular classes of access seekers."
    },
