    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150b",
      "@type": "cml:Concept",
      "skos:prefLabel": "150B Objects of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.207",
      "values:originalText": "The objects of this Part are:\n\n(a) to facilitate the application of the Competition Code by\nparticipating Territories; and\n\n(b) to facilitate the application of the Competition Code by\nparticipating States.",
      "skos:definition": "The objects of this Part are:\n\n(a) to facilitate the application of the Competition Code by\nparticipating Territories; and\n\n(b) to facilitate the application of the Competition Code by\nparticipating States.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150b-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "20948b41353de70b90491f7f0c3386682644718f3e54e65757ac095de9ab331d",
      "skos:note": "Facilitate application of Competition Code by participating Territories and States."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150b",
      "@type": "cof:Section",
      "cof:title": "150B Objects of this Part",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "The objects of this Part are:\n\n(a) to facilitate the application of the Competition Code by\nparticipating Territories; and\n\n(b) to facilitate the application of the Competition Code by\nparticipating States."
    },
