      "cml:conclusionText": "...the magistrate may grant the order"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "149(3) Section 149",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-149-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.506",
      "values:originalText": "(3) A person commits an offence if:\n\n(a) the person is subject to an order under this section; and\n\n(b) the person engages in conduct; and\n\n(c) the person’s conduct breaches the order.\nPenalty for a contravention of this subsection:\nImprisonment\nfor 6 months.\n\nChapter 8  Miscellaneous",
      "skos:definition": "(3) A person commits an offence if:\n\n(a) the person is subject to an order under this section; and\n\n(b) the person engages in conduct; and\n\n(c) the person’s conduct breaches the order.\nPenalty for a contravention of this subsection:\nImprisonment\nfor 6 months.\n\nChapter 8  Miscellaneous",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-149"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-3-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-149-ss-3-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "b2bf382986e2eb54bc3743c90e99b33e1c2bf5983fd662e20c90a175ad7e6990",
      "skos:note": "Breach of order results in imprisonment for 6 months."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-149-ss-3",
      "@type": "cof:Section",
      "cof:title": "149(3) Section 149",
      "values:kind": "subsection",
      "cof:pageNumber": 506,
      "values:originalText": "(3) A person commits an offence if:\n\n(a) the person is subject to an order under this section; and\n\n(b) the person engages in conduct; and\n\n(c) the person’s conduct breaches the order.\nPenalty for a contravention of this subsection:\nImprisonment\nfor 6 months.\n\nChapter 8  Miscellaneous"
    },
