      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of action by the Commission",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Subsection (5) applies if...",
      "cml:conclusionText": "...the Commission has made a revocation of the no Treasurer action notice under subsection 153V(1)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "153R(5) Commission must give Treasurer prohibited conduct",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153r-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.444",
      "values:originalText": "(5) The Commission must, within 45 days after making the revocation:\n\n(a) give the Treasurer a prohibited conduct recommendation in\nrespect of the prohibited conduct notice; or\n\n(b) give the corporation a new prohibited conduct notice in\nrespect of the prohibited conduct identified in the prohibited\nconduct notice (in accordance with\nsubparagraph 153P(2)(c)(ii)).\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nProcedure before contracting order or divestiture order  Division 4\n\nSection 153S\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(5) The Commission must, within 45 days after making the revocation:\n\n(a) give the Treasurer a prohibited conduct recommendation in\nrespect of the prohibited conduct notice; or\n\n(b) give the corporation a new prohibited conduct notice in\nrespect of the prohibited conduct identified in the prohibited\nconduct notice (in accordance with\nsubparagraph 153P(2)(c)(ii)).\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nProcedure before contracting order or divestiture order  Division 4\n\nSection 153S\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-153r"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-5-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "05cdb04ac9620279b77e7e8df0d9eb3b0881e486ad0384ba956a5048cc0dcc23",
      "skos:note": "Commission must give Treasurer a prohibited conduct recommendation within 45 days after revocation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153r-ss-5",
      "@type": "cof:Section",
      "cof:title": "153R(5) Commission must give Treasurer prohibited conduct",
      "values:kind": "subsection",
      "cof:pageNumber": 444,
      "values:originalText": "(5) The Commission must, within 45 days after making the revocation:\n\n(a) give the Treasurer a prohibited conduct recommendation in\nrespect of the prohibited conduct notice; or\n\n(b) give the corporation a new prohibited conduct notice in\nrespect of the prohibited conduct identified in the prohibited\nconduct notice (in accordance with\nsubparagraph 153P(2)(c)(ii)).\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nProcedure before contracting order or divestiture order  Division 4\n\nSection 153S\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
