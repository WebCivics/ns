      "cml:integrityHash": "ada2585398c7e3f7e9605ef0f5bab259a23208709cf56d9dc7ba4b1bc1603a30",
      "skos:note": "Registrar notation upon direction revocation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-158-ss-5",
      "@type": "cof:Section",
      "cof:title": "10(5) 49  Undertakings by parties to registered conference agreement",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(5) If the Minister revokes a direction given under subsection 10.44(1),\nthe Registrar shall immediately include in the register a notation to\nthe effect that the direction has been revoked."
    },
