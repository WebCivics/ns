      "skos:note": "Do not make a record in an incorrect way."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151bv-ss-1",
      "@type": "cof:Section",
      "cof:title": "151BV(1) Incorrect records",
      "values:kind": "subsection",
