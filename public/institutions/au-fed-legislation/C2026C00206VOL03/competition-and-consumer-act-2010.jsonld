      "cml:premiseText": "(1) A person commits an offence if:\n\n(a) the person is given a disclosure notice; and\n\n(b) the person refuses or fails to comply with the notice.",
      "cml:conclusionText": "The person is committing an offence."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-133f-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Refusal to comply with disclosure notice is prohibited.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A person commits an offence if:\n\n(a) the person is given a disclosure notice; and\n\n(b) the person refuses or fails to comply with the notice.",
      "cml:conclusionText": "The person must comply with the disclosure notice."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-133f-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Compliance with disclosure notice is permitted.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A person commits an offence if:\n\n(a) the person is given a disclosure notice; and\n\n(b) the person refuses or fails to comply with the notice.",
      "cml:conclusionText": "The person may refuse to comply with the disclosure notice."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-133f-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
