    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-201-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to review decision",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the Tribunal receives an application under this section for a review of a decision, the Tribunal must review the decision.",
      "cml:conclusionText": "The Tribunal MUST review the decision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-201-ss-4-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Review decision implies application under this section",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the Tribunal receives an application under this section for a review of a decision, the Tribunal must review the decision.",
      "cml:conclusionText": "If the Tribunal receives an application under this section, it implies that the Tribunal MUST review the decision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-201-ss-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
