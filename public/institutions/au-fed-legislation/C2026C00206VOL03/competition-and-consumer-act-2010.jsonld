    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150d",
      "@type": "cml:Concept",
      "skos:prefLabel": "150D Federal Court may exercise jurisdiction under application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.208",
      "values:originalText": "laws of Territories\n\nThe Federal Court may exercise jurisdiction (whether original or\nappellate) conferred on that Court by an application law of a\nTerritory with respect to matters arising under the Competition\nCode.",
      "skos:definition": "laws of Territories\n\nThe Federal Court may exercise jurisdiction (whether original or\nappellate) conferred on that Court by an application law of a\nTerritory with respect to matters arising under the Competition\nCode.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150d-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0942aff41dd4cebbf9c314243a4d20b99a185c8e49a1e64831f66bd25e4cc8a9",
      "skos:note": "Jurisdiction under application law of a Territory"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150d",
      "@type": "cof:Section",
      "cof:title": "150D Federal Court may exercise jurisdiction under application",
      "values:kind": "section",
      "cof:pageNumber": 208,
      "values:originalText": "laws of Territories\n\nThe Federal Court may exercise jurisdiction (whether original or\nappellate) conferred on that Court by an application law of a\nTerritory with respect to matters arising under the Competition\nCode."
    },
    {
