    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-126",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 18  Exemption from section 47",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-126"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
