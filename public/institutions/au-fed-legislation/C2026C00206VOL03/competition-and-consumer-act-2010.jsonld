      ],
      "cml:integrityHash": "74dff6abf3d5bd086638759ab410beb8ab25b71f2416ef4e9db522388215822a",
      "skos:note": "Binding rules of conduct may be limited to specific carriers or carriage service providers."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152bd-ss-4",
      "@type": "cof:Section",
      "cof:title": "152BD(4) Binding rules of conduct",
      "values:kind": "subsection",
      "cof:pageNumber": 367,
      "values:originalText": "(4) In particular, binding rules of conduct may be limited to:\n\n(a) particular carriers or carriage service providers; or\n\n(b) particular classes of carriers or carriage service providers; or\n\n(c) particular access seekers; or\n\n(d) particular classes of access seekers."
    },
