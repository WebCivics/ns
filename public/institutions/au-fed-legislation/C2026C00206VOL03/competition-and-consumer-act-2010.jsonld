      "cml:premiseText": "(1A) Subsection (1) does not apply if the person has a reasonable excuse.",
      "cml:conclusionText": "The witness's absence meets the condition of subsection (1)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-160-ss-1a-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Reasonable excuse implies no obligation to attend",
      "cml:executionSurface": "modalities::argumentation",
