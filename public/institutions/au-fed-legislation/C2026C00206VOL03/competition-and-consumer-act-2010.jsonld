      "values:originalText": "(3) An inspector must comply with any directions of the Chairperson\nin exercising powers or performing functions as an inspector."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154b-ss-3-norm",
      "@type": "values:Obligation",
