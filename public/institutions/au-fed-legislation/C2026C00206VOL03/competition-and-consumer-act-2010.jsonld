    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-138-ss-1b",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(1B) 29  Parties to conference agreement to negotiate minimum level of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-138-ss-1b"
      },
      "cml:curationStatus": {
