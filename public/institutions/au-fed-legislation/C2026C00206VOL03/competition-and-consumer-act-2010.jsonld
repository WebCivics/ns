    {
      "@id": "concept:competition-and-consumer-act-2010-sec-162-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "162(2) Contempt",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-162-ss-2"
      },
      "cml:curationStatus": {
