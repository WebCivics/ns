        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of anti-competitive conduct",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ab",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AB Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ab"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.215",
      "values:originalText": "In this Part, unless the contrary intention appears:\nanti-competitive conduct has the meaning given by section 151AJ.\ncarriage service has the same meaning as in the\nTelecommunications Act 1997.\ncarriage service provider has the same meaning as in the\nTelecommunications Act 1997.\ncarrier has the same meaning as in the Telecommunications Act\n1997.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "skos:definition": "In this Part, unless the contrary intention appears:\nanti-competitive conduct has the meaning given by section 151AJ.\ncarriage service has the same meaning as in the\nTelecommunications Act 1997.\ncarriage service provider has the same meaning as in the\nTelecommunications Act 1997.\ncarrier has the same meaning as in the Telecommunications Act\n1997.\n\nChapter 7  Further provisions relating to particular industries etc.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151ab-norm"
        }
      ],
      "cml:integrityHash": "cea81bbbe6d14bec7a8064d11ff6be8fb0ecade4374e6e3160b6d13896a65cba",
      "skos:note": "Definitions for anti-competitive conduct, carriage service, and carrier."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ab",
      "@type": "cof:Section",
      "cof:title": "151AB Definitions",
      "values:kind": "section",
      "cof:pageNumber": 215,
      "values:originalText": "In this Part, unless the contrary intention appears:\nanti-competitive conduct has the meaning given by section 151AJ.\ncarriage service has the same meaning as in the\nTelecommunications Act 1997.\ncarriage service provider has the same meaning as in the\nTelecommunications Act 1997.\ncarrier has the same meaning as in the Telecommunications Act\n1997.\n\nChapter 7  Further provisions relating to particular industries etc."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ab-norm",
