      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.121",
      "values:originalText": "An expression has the same meaning in this Part as in Schedule 2.\n\nChapter 6  Other provisions",
      "skos:definition": "An expression has the same meaning in this Part as in Schedule 2.\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-130a-norm"
        }
      ],
      "cml:integrityHash": "643aaa4015f71f54b61d0fc04880143d955b525630a791e9d6ee309119e25266",
      "skos:note": "Defines expressions in this Part as in Schedule 2."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-130a",
      "@type": "cof:Section",
      "cof:title": "130A Expressions defined in Schedule 2",
