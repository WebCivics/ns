    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154p",
      "@type": "cml:Concept",
      "skos:prefLabel": "154P Occupier entitled to observe search being conducted",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154p"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.505",
      "values:originalText": "(1) If a search warrant in relation to premises is being executed and the\noccupier of the premises is present at the premises, the occupier is\nentitled to observe the search being conducted.\n\n(2) The occupier’s right to observe the search being conducted ends if\nthe occupier impedes the search.\n\nChapter 8  Miscellaneous",
      "skos:definition": "(1) If a search warrant in relation to premises is being executed and the\noccupier of the premises is present at the premises, the occupier is\nentitled to observe the search being conducted.\n\n(2) The occupier’s right to observe the search being conducted ends if\nthe occupier impedes the search.\n\nChapter 8  Miscellaneous",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154p-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154p-ss-2"
        }
