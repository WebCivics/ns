      "cml:integrityHash": "8a42954f2de45e8e90a4dceb880406179609db3d4e52d061012c12c6b407b5a4",
      "skos:note": "Must provide information or document to Australian Competition and Consumer Commission upon request from New Zealand Commerce Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-155b-ss-1",
      "@type": "cof:Section",
      "cof:title": "155B(1) Australian Competition and Consumer Commission may",
      "values:kind": "subsection",
      "cof:pageNumber": 550,
      "values:originalText": "(1) Where, by notice under section 98H of the Commerce Act 1986 of\nNew Zealand, the New Zealand Commerce Commission requires a\nperson to furnish any information or produce any document, the\ninformation or document may be provided to the Australian\nCompetition and Consumer Commission for transmission to the\nNew Zealand Commerce Commission."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
