          "@id": "concept:competition-and-consumer-act-2010-sec-159-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-159-ss-2"
        }
      ],
      "cml:integrityHash": "619beb576f291b8bfd7a771b6091750d9d01bce5f64582ebe090b9e82a5a6aa3"
