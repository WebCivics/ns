      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.500",
      "values:originalText": "(4) An executing officer may apply to a magistrate for one or more\nextensions of that time if the executing officer believes on\nreasonable grounds that the thing cannot be examined or processed\nwithin 72 hours or that time as previously extended.",
      "skos:definition": "(4) An executing officer may apply to a magistrate for one or more\nextensions of that time if the executing officer believes on\nreasonable grounds that the thing cannot be examined or processed\nwithin 72 hours or that time as previously extended.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154ga"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154ga-ss-4-norm"
        }
      ],
      "cml:integrityHash": "460625725ef71041aa10955c0f2033629004fb47374c67b841ab41049b8ec23d",
      "skos:note": "Executive officer may request extension of time for examination or processing."
    },
    {
