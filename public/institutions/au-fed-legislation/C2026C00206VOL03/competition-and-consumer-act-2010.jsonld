          "@id": "concept:competition-and-consumer-act-2010-sec-135w-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135w-ss-4"
        }
      ],
      "cml:integrityHash": "1cbcf89c836b8b7112ac097d47d31c56a14a5e31430e6ce3b82ca734aab035aa"
