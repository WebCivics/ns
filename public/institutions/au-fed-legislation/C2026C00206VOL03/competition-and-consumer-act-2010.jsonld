    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "153R(4) Commission must give Treasurer prohibited conduct",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153r-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.444",
      "values:originalText": "(4) Subsection (5) applies if:\n\n(a) the Commission has given the Treasurer a no Treasurer\naction notice in respect of the prohibited conduct notice, in\naccordance with paragraph (1)(b); and\n\n(b) the Commission has made a revocation of the no Treasurer\naction notice under subsection 153V(1).",
      "skos:definition": "(4) Subsection (5) applies if:\n\n(a) the Commission has given the Treasurer a no Treasurer\naction notice in respect of the prohibited conduct notice, in\naccordance with paragraph (1)(b); and\n\n(b) the Commission has made a revocation of the no Treasurer\naction notice under subsection 153V(1).",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-153r"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4487c15d5ef601e6a2bfb7176cdf4475546320fe1c813eb498eb069e2c086ee2",
      "skos:note": "Commission must not give Treasurer prohibited conduct under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153r-ss-4",
      "@type": "cof:Section",
      "cof:title": "153R(4) Commission must give Treasurer prohibited conduct",
      "values:kind": "subsection",
      "cof:pageNumber": 444,
      "values:originalText": "(4) Subsection (5) applies if:\n\n(a) the Commission has given the Treasurer a no Treasurer\naction notice in respect of the prohibited conduct notice, in\naccordance with paragraph (1)(b); and\n\n(b) the Commission has made a revocation of the no Treasurer\naction notice under subsection 153V(1)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153r-ss-4-norm",
