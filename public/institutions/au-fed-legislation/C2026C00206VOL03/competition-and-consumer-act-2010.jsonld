      "skos:note": "Defines damage by erasure or addition of data"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-6",
      "@type": "cof:Section",
      "cof:title": "154ZC(6) Compensation for damage to electronic equipment",
