      "dc:source": "competition-and-consumer-act-2010.pdf, p.160",
      "values:originalText": "(1) An inspector must, before obtaining the consent of an occupier of\npremises for the purposes of paragraph 135(3)(a), inform the\noccupier that the occupier may refuse consent.",
      "skos:definition": "(1) An inspector must, before obtaining the consent of an occupier of\npremises for the purposes of paragraph 135(3)(a), inform the\noccupier that the occupier may refuse consent.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-135h"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dff1de06b4a0198f2c1696d30af37e18e8f0be563724b357bdffed1fc49839d0",
      "skos:note": "Inspector must inform occupier of right to refuse consent.",
      "dc:description": "Information about refusal of consent"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135h-ss-1",
      "@type": "cof:Section",
      "cof:title": "135H(1) Consent",
      "values:kind": "subsection",
      "cof:pageNumber": 160,
      "values:originalText": "(1) An inspector must, before obtaining the consent of an occupier of\npremises for the purposes of paragraph 135(3)(a), inform the\noccupier that the occupier may refuse consent."
    },
