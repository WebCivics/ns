    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZC(6) Compensation for damage to electronic equipment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
