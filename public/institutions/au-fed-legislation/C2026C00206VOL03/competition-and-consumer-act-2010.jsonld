      "cml:integrityHash": "cfa9efe4bf7e0f63d46ddbe7a892829d5fc363bae7648c8f2b2c281445d6e834",
      "skos:note": "Defines eligible Australian contracts and relevant designated shipper bodies for conference agreements."
