      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Imprisonment term equals amount of fine",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) The term of a sentence...",
      "cml:conclusionText": "...one day’s imprisonment for each $25..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-139da",
      "@type": "cml:Concept",
      "skos:prefLabel": "139DA Application of section 229 of the Australian Consumer Law",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-139da"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.195",
      "values:originalText": "to a person other than a body corporate\n\nIf, as a result of the operation of Part 2.4 of the Criminal Code, a\nperson other than a body corporate is:\n\n(a) convicted of an offence (the relevant offence) against\nsubsection 229(1) of the Australian Consumer Law; or\n\n(b) convicted of an offence (the relevant offence) against\nsection 11.4 of the Criminal Code in relation to an offence\nreferred to in subsection 229(1) of the Australian Consumer\nLaw;\n\nChapter 6  Other provisions",
      "skos:definition": "to a person other than a body corporate\n\nIf, as a result of the operation of Part 2.4 of the Criminal Code, a\nperson other than a body corporate is:\n\n(a) convicted of an offence (the relevant offence) against\nsubsection 229(1) of the Australian Consumer Law; or\n\n(b) convicted of an offence (the relevant offence) against\nsection 11.4 of the Criminal Code in relation to an offence\nreferred to in subsection 229(1) of the Australian Consumer\nLaw;\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139da-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139da-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139da-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139da-logic-linearlogic-3"
        }
      ],
      "cml:integrityHash": "3b587fbdac78726c8c381b995299cede93c4a886baa7b227fd8c4c86655b4f59",
      "skos:note": "Conviction of an offence against subsection 229(1) of the Australian Consumer Law or section 11.4 of the Criminal Code requires application of this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-139da",
      "@type": "cof:Section",
      "cof:title": "139DA Application of section 229 of the Australian Consumer Law",
      "values:kind": "section",
      "cof:pageNumber": 195,
      "values:originalText": "to a person other than a body corporate\n\nIf, as a result of the operation of Part 2.4 of the Criminal Code, a\nperson other than a body corporate is:\n\n(a) convicted of an offence (the relevant offence) against\nsubsection 229(1) of the Australian Consumer Law; or\n\n(b) convicted of an offence (the relevant offence) against\nsection 11.4 of the Criminal Code in relation to an offence\nreferred to in subsection 229(1) of the Australian Consumer\nLaw;\n\nChapter 6  Other provisions"
    },
