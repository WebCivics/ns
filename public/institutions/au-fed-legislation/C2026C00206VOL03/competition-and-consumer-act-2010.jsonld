    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152az",
      "@type": "cml:Concept",
      "skos:prefLabel": "152AZ Carrier licence condition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152az"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.335",
      "values:originalText": "A carrier licence held by a carrier is subject to a condition that the\ncarrier must comply with:\n\n(a) any standard access obligations that are applicable to the\ncarrier; and\n\n(aa) any rule in section 152AXC or 152AXD that is applicable to\nthe carrier; and\n\n(b) any obligations under section 152AYA that are applicable to\nthe carrier.",
      "skos:definition": "A carrier licence held by a carrier is subject to a condition that the\ncarrier must comply with:\n\n(a) any standard access obligations that are applicable to the\ncarrier; and\n\n(aa) any rule in section 152AXC or 152AXD that is applicable to\nthe carrier; and\n\n(b) any obligations under section 152AYA that are applicable to\nthe carrier.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152az-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152az-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "67081ec152092fae759cfe6df559501dc9144b5bc0464b11520bd282888ce2be",
      "skos:note": "Carrier must comply with standards and rules."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152az",
      "@type": "cof:Section",
      "cof:title": "152AZ Carrier licence condition",
      "values:kind": "section",
      "cof:pageNumber": 335,
      "values:originalText": "A carrier licence held by a carrier is subject to a condition that the\ncarrier must comply with:\n\n(a) any standard access obligations that are applicable to the\ncarrier; and\n\n(aa) any rule in section 152AXC or 152AXD that is applicable to\nthe carrier; and\n\n(b) any obligations under section 152AYA that are applicable to\nthe carrier."
    },
