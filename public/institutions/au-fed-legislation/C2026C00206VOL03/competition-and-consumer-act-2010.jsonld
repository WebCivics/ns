        }
      ],
      "cml:integrityHash": "c989bb56ef4c7382ca369ea18f23e9a1e5a58cba2df5fea0b1d40d244c3fbf62",
      "skos:note": "Ordering and provisioning are aspects of technical and operational quality."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ar-ss-4a",
      "@type": "cof:Section",
      "cof:title": "152AR(4A) Category A standard access obligations",
      "values:kind": "subsection",
      "cof:pageNumber": 316,
      "values:originalText": "(4A) To avoid doubt, ordering and provisioning are taken to be aspects\nof technical and operational quality referred to in paragraph (3)(b)."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ar-ss-4a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
