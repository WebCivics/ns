      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.164",
      "values:originalText": "(2) An amount payable by a person under subsection (1):\n\n(a) is a debt due by the person to the Commonwealth; and\n\n(b) may be recovered by action in a court of competent\njurisdiction.",
      "skos:definition": "(2) An amount payable by a person under subsection (1):\n\n(a) is a debt due by the person to the Commonwealth; and\n\n(b) may be recovered by action in a court of competent\njurisdiction.",
