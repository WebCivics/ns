    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AA Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.214",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThis Part sets up a special regime for regulating\nanti-competitive conduct in the telecommunications industry.\nThe regime applies in addition to Part IV.\n•\nThe Part sets out the circumstances in which carriers and\ncarriage service providers are said to engage in\nanti-competitive conduct.\n•\nA carrier or carriage service provider must not engage in\nanti-competitive conduct. This rule is called the competition\nrule.\n•\nThe Commission may issue a notice stating that a specified\ncarrier or carriage service provider has engaged, or is\nengaging, in anti-competitive conduct. The notice is called a\nPart A competition notice.\n•\nProceedings for the enforcement of the competition rule (other\nthan proceedings for injunctive relief) must not be instituted\nunless the alleged conduct is of a kind dealt with in a Part A\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nThis Part sets up a special regime for regulating\nanti-competitive conduct in the telecommunications industry.\nThe regime applies in addition to Part IV.\n•\nThe Part sets out the circumstances in which carriers and\ncarriage service providers are said to engage in\nanti-competitive conduct.\n•\nA carrier or carriage service provider must not engage in\nanti-competitive conduct. This rule is called the competition\nrule.\n•\nThe Commission may issue a notice stating that a specified\ncarrier or carriage service provider has engaged, or is\nengaging, in anti-competitive conduct. The notice is called a\nPart A competition notice.\n•\nProceedings for the enforcement of the competition rule (other\nthan proceedings for injunctive relief) must not be instituted\nunless the alleged conduct is of a kind dealt with in a Part A\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151aa-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fdbc28b2de5512bbf294efe3e4d61fbb54be9114a39dc1d0613e480c1b4627e0",
      "skos:note": "A carrier or carriage service provider must not engage in anti-competitive conduct."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151aa",
      "@type": "cof:Section",
      "cof:title": "151AA Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 214,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThis Part sets up a special regime for regulating\nanti-competitive conduct in the telecommunications industry.\nThe regime applies in addition to Part IV.\n•\nThe Part sets out the circumstances in which carriers and\ncarriage service providers are said to engage in\nanti-competitive conduct.\n•\nA carrier or carriage service provider must not engage in\nanti-competitive conduct. This rule is called the competition\nrule.\n•\nThe Commission may issue a notice stating that a specified\ncarrier or carriage service provider has engaged, or is\nengaging, in anti-competitive conduct. The notice is called a\nPart A competition notice.\n•\nProceedings for the enforcement of the competition rule (other\nthan proceedings for injunctive relief) must not be instituted\nunless the alleged conduct is of a kind dealt with in a Part A\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151aa-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-151aa"
      },
