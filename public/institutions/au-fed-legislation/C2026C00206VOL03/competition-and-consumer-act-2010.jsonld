    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZC(4) Compensation for damage to electronic equipment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.516",
      "values:originalText": "(4) In determining the amount of compensation payable, regard is to\nbe had to whether the occupier of the premises, or the occupier’s\nemployees and agents, if they were available at the time, provided\nany appropriate warning or guidance on the operation of the\nequipment.",
      "skos:definition": "(4) In determining the amount of compensation payable, regard is to\nbe had to whether the occupier of the premises, or the occupier’s\nemployees and agents, if they were available at the time, provided\nany appropriate warning or guidance on the operation of the\nequipment.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154zc"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zc-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "148c9694dcacae3645e79b9c9ebb1d15c82de3feab484c561891171f184026dc",
      "skos:note": "Occupier must provide warning or guidance on equipment operation.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zc-ss-4",
      "@type": "cof:Section",
      "cof:title": "154ZC(4) Compensation for damage to electronic equipment",
      "values:kind": "subsection",
      "cof:pageNumber": 516,
      "values:originalText": "(4) In determining the amount of compensation payable, regard is to\nbe had to whether the occupier of the premises, or the occupier’s\nemployees and agents, if they were available at the time, provided\nany appropriate warning or guidance on the operation of the\nequipment."
    },
