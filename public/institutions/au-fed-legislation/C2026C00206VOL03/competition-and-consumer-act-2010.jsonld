      "cml:integrityHash": "ffdfa0d8542cf2b50fe43874ea3190719311895734664e17d0a24655588d97bc",
      "skos:note": "Failure to comply with a requirement is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135c-ss-1",
      "@type": "cof:Section",
      "cof:title": "135C(1) Failure to answer questions or produce documents",
      "values:kind": "subsection",
      "cof:pageNumber": 157,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person is subject to a requirement under\nsubsection 135B(2); and\n\n(b) the person fails to comply with the requirement.\nPenalty:\n\n(a) if the person is a body corporate—150 penalty units; or\n\n(b) if the person is not a body corporate—30 penalty units."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135c-ss-1-norm",
      "@type": "values:Obligation",
