    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154t",
      "@type": "cml:Concept",
      "skos:prefLabel": "154T Receipts for things seized or moved under warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
