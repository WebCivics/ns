    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152cj",
      "@type": "cml:Concept",
      "skos:prefLabel": "152CJ Register of Ministerial pricing determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152cj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.414",
      "values:originalText": "(1) The Commission must keep a Register of Ministerial pricing\ndeterminations.\n\n(2) The Register is to be maintained by electronic means.\n\n(3) The Register is to be made available for inspection on the\nCommission’s website.\n\n(4) The Register is not a legislative instrument.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nSupply of services by NBN corporations  Division 6A\n\nSection 152CJA\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) The Commission must keep a Register of Ministerial pricing\ndeterminations.\n\n(2) The Register is to be maintained by electronic means.\n\n(3) The Register is to be made available for inspection on the\nCommission’s website.\n\n(4) The Register is not a legislative instrument.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nSupply of services by NBN corporations  Division 6A\n\nSection 152CJA\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152cj-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152cj-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152cj-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152cj-ss-4"
        }
      ],
      "cml:integrityHash": "6cf12258218391abfc8d5d5c0d6350608f364dcda6e218590b2f2243ad9c2008"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152cj",
      "@type": "cof:Section",
      "cof:title": "152CJ Register of Ministerial pricing determinations",
      "values:kind": "section",
      "cof:pageNumber": 414,
      "values:originalText": "(1) The Commission must keep a Register of Ministerial pricing\ndeterminations.\n\n(2) The Register is to be maintained by electronic means.\n\n(3) The Register is to be made available for inspection on the\nCommission’s website.\n\n(4) The Register is not a legislative instrument.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nSupply of services by NBN corporations  Division 6A\n\nSection 152CJA\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
