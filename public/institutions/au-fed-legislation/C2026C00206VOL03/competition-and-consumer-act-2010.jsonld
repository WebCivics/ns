    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-195",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 81  Delegation by Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-195"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.106",
      "values:originalText": "The Minister may, by signed writing, delegate to the Registrar, or\nto a person occupying a specified office in the Department, all or\nany of the Minister’s powers under or in relation to this Part (other\nthan powers under sections 10.02A and 10.03, subsections 10.06(1)\nand 10.44(1), sections 10.46, 10.47, 10.48 and 10.50,\nsubsection 10.54(1), sections 10.56, 10.57 and 10.58,\nsubsection 10.61(1) and sections 10.63 and 10.72A).\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nAdministration  Division 14\n\nSection 10.82\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "The Minister may, by signed writing, delegate to the Registrar, or\nto a person occupying a specified office in the Department, all or\nany of the Minister’s powers under or in relation to this Part (other\nthan powers under sections 10.02A and 10.03, subsections 10.06(1)\nand 10.44(1), sections 10.46, 10.47, 10.48 and 10.50,\nsubsection 10.54(1), sections 10.56, 10.57 and 10.58,\nsubsection 10.61(1) and sections 10.63 and 10.72A).\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nAdministration  Division 14\n\nSection 10.82\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-195-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-argumentation-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-diffusion-4"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "3a6555bd2441037a8932d343bd1fa1040edea5261453cf4ffa0d8ffa9fb3e494",
      "skos:note": "The Minister may delegate powers under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-195",
      "@type": "cof:Section",
      "cof:title": "10 81  Delegation by Minister",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "The Minister may, by signed writing, delegate to the Registrar, or\nto a person occupying a specified office in the Department, all or\nany of the Minister’s powers under or in relation to this Part (other\nthan powers under sections 10.02A and 10.03, subsections 10.06(1)\nand 10.44(1), sections 10.46, 10.47, 10.48 and 10.50,\nsubsection 10.54(1), sections 10.56, 10.57 and 10.58,\nsubsection 10.61(1) and sections 10.63 and 10.72A).\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nAdministration  Division 14\n\nSection 10.82\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
