        }
      ],
      "cml:integrityHash": "b1d0f856bf170928994b79a3c3372a8c3b9c74157c93d22d665f2f94a7262885",
      "skos:note": "Notification required for negotiations in conference agreement"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-138-ss-1b",
      "@type": "cof:Section",
      "cof:title": "10(1B) 29  Parties to conference agreement to negotiate minimum level of",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(1B) Subsections (1) and (1A) do not apply in relation to a conference\nagreement unless, within 14 days after the provisional registration\nof the agreement, the shipper bodies notify, as prescribed, the\nRegistrar and the parties to the agreement that they wish to have\nnegotiations in relation to the agreement."
    },
