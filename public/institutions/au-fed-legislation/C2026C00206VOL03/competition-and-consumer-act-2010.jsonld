    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AK The competition rule",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151ak"
      },
      "cml:curationStatus": {
