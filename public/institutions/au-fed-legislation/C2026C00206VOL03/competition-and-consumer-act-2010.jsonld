    {
      "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "165(5) Inspection of, furnishing of copies of, and evidence of,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-165-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.576",
      "values:originalText": "(5) A document purporting to be a copy of a determination of the\nCommission and to be certified to be a true copy in accordance\nwith subsection (4) shall, unless the contrary is established, be\ndeemed to be such a copy and to be so certified.",
      "skos:definition": "(5) A document purporting to be a copy of a determination of the\nCommission and to be certified to be a true copy in accordance\nwith subsection (4) shall, unless the contrary is established, be\ndeemed to be such a copy and to be so certified.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-165"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-5-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e571f069ca262db166b75c8112da90883ea89e38809653bbfcc711d09890c5e9",
      "skos:note": "Document purporting to be a copy of a determination is deemed valid unless proven otherwise."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-165-ss-5",
      "@type": "cof:Section",
      "cof:title": "165(5) Inspection of, furnishing of copies of, and evidence of,",
      "values:kind": "subsection",
      "cof:pageNumber": 576,
      "values:originalText": "(5) A document purporting to be a copy of a determination of the\nCommission and to be certified to be a true copy in accordance\nwith subsection (4) shall, unless the contrary is established, be\ndeemed to be such a copy and to be so certified."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-165-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
