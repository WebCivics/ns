      },
      "cml:premiseText": "(2) If the Registrar is not so satisfied...",
      "cml:conclusionText": "The decision to refuse the request for confidentiality requires reasoning and analysis"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-147",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 38  Application for registration to be returned where request for",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-147"
      },
      "cml:curationStatus": {
