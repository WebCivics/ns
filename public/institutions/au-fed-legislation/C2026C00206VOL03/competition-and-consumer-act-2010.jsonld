    {
      "@id": "concept:competition-and-consumer-act-2010-sec-150h",
      "@type": "cml:Concept",
      "skos:prefLabel": "150H No doubling-up of liabilities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.212",
      "values:originalText": "(1) If:\n\n(a) an act or omission is an offence against this Act and is also\nan offence against an application law; and\n\n(b) the offender has been punished for the offence under the\napplication law;\nthe offender is not liable to be punished for the offence against this\nAct.\n\n(2) If a person has been ordered to pay a pecuniary penalty under an\napplication law, the person is not liable to a pecuniary penalty\nunder this Act in respect of the same conduct.",
      "skos:definition": "(1) If:\n\n(a) an act or omission is an offence against this Act and is also\nan offence against an application law; and\n\n(b) the offender has been punished for the offence under the\napplication law;\nthe offender is not liable to be punished for the offence against this\nAct.\n\n(2) If a person has been ordered to pay a pecuniary penalty under an\napplication law, the person is not liable to a pecuniary penalty\nunder this Act in respect of the same conduct.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150h-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-150h-ss-2"
        }
      ],
      "cml:integrityHash": "d08c45e6ae438948f06ada57fc775162e217ad194c9ea00c1dc39128e9479077"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-150h",
      "@type": "cof:Section",
      "cof:title": "150H No doubling-up of liabilities",
      "values:kind": "section",
      "cof:pageNumber": 212,
      "values:originalText": "(1) If:\n\n(a) an act or omission is an offence against this Act and is also\nan offence against an application law; and\n\n(b) the offender has been punished for the offence under the\napplication law;\nthe offender is not liable to be punished for the offence against this\nAct.\n\n(2) If a person has been ordered to pay a pecuniary penalty under an\napplication law, the person is not liable to a pecuniary penalty\nunder this Act in respect of the same conduct."
    },
