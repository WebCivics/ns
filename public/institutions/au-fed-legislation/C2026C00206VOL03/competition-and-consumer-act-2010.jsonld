    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zj",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZJ Notice—no further action on complaint—contents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.522",
      "values:originalText": "A notice given under subsection 154ZH(1) must set out the\nfollowing:\n\n(a) a summary of the complaint;\n\n(b) which of subsections 154ZH(2), (3), (4) and (5) apply in\nrelation to the complaint;\n\n(c) the reasons for the Commission’s decision.\n\nMiscellaneous  Chapter 8\nDesignated complaints  Part XIE\nCommission handling of designated complaints  Division 2\n\nSection 154ZK\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "A notice given under subsection 154ZH(1) must set out the\nfollowing:\n\n(a) a summary of the complaint;\n\n(b) which of subsections 154ZH(2), (3), (4) and (5) apply in\nrelation to the complaint;\n\n(c) the reasons for the Commission’s decision.\n\nMiscellaneous  Chapter 8\nDesignated complaints  Part XIE\nCommission handling of designated complaints  Division 2\n\nSection 154ZK\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zj-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5750621a82f0c52a1e45b5acf95609aec53b340b1b8a570d753a750e7d6b1c6b",
      "skos:note": "Notice must set out a summary of the complaint, reasons for Commission's decision, and which subsections apply.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zj",
      "@type": "cof:Section",
      "cof:title": "154ZJ Notice—no further action on complaint—contents",
      "values:kind": "section",
      "cof:pageNumber": 522,
      "values:originalText": "A notice given under subsection 154ZH(1) must set out the\nfollowing:\n\n(a) a summary of the complaint;\n\n(b) which of subsections 154ZH(2), (3), (4) and (5) apply in\nrelation to the complaint;\n\n(c) the reasons for the Commission’s decision.\n\nMiscellaneous  Chapter 8\nDesignated complaints  Part XIE\nCommission handling of designated complaints  Division 2\n\nSection 154ZK\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zj-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-154zj"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zj-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide notice with specified information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
