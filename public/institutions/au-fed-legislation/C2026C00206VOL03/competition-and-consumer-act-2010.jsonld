        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-140f-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "If the duty must be imposed by a law of the Commonwealth, then it is taken to be imposed by this Act.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Duty must be imposed by a law of the Commonwealth.",
      "cml:conclusionText": "Duty is taken to be imposed by this Act."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-140f-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "140F(4) How duty is imposed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140f-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.203",
      "values:originalText": "(4) If, because of subsection (3), this Act is taken to impose the duty, it\nis the intention of the Parliament to rely on all powers available to\nit under the Constitution to support the imposition of the duty by\nthis Act.",
      "skos:definition": "(4) If, because of subsection (3), this Act is taken to impose the duty, it\nis the intention of the Parliament to rely on all powers available to\nit under the Constitution to support the imposition of the duty by\nthis Act.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-140f"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-140f-ss-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-140f-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1ab7d1ba785d7b5e4fd1558ab3b8be515df8d226bbbe4450c708a56d200dd1f3",
      "skos:note": "Parliament's intention to rely on available powers under the Constitution to support duty imposition."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-140f-ss-4",
      "@type": "cof:Section",
      "cof:title": "140F(4) How duty is imposed",
      "values:kind": "subsection",
      "cof:pageNumber": 203,
      "values:originalText": "(4) If, because of subsection (3), this Act is taken to impose the duty, it\nis the intention of the Parliament to rely on all powers available to\nit under the Constitution to support the imposition of the duty by\nthis Act."
    },
