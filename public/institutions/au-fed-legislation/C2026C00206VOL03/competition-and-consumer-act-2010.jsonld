    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-171-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(2) 61  Powers exercisable by Minister in relation to pricing practices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-171-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.95",
      "values:originalText": "(2) Where the Minister makes an order under subsection (1), the\nRegistrar shall immediately enter particulars of the order in the\nregister of obligations concerning unfair pricing practices.",
      "skos:definition": "(2) Where the Minister makes an order under subsection (1), the\nRegistrar shall immediately enter particulars of the order in the\nregister of obligations concerning unfair pricing practices.",
      "values:partOf": {
