    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "152AK Operation of Parts IV, IVA and VII not affected by this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ak"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.304",
      "values:originalText": "This Part does not affect the operation of Parts IV, IVA and VII.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nDeclared services  Division 2\n\nSection 152AL\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "This Part does not affect the operation of Parts IV, IVA and VII.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nDeclared services  Division 2\n\nSection 152AL\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152ak-norm"
        }
      ],
      "cml:integrityHash": "6204304f9405d83464e0a731956395143a5e2731b056e8a806f8f0c37d64c071",
      "skos:note": "Does not affect operation of Parts IV, IVA and VII"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152ak",
      "@type": "cof:Section",
      "cof:title": "152AK Operation of Parts IV, IVA and VII not affected by this Part",
      "values:kind": "section",
      "cof:pageNumber": 304,
      "values:originalText": "This Part does not affect the operation of Parts IV, IVA and VII.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nDeclared services  Division 2\n\nSection 152AL\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
