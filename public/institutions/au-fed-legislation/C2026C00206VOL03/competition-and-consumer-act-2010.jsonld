      },
      "cml:premiseText": "Consent given by occupier",
      "cml:conclusionText": "Inspector and assisting person must leave premises"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-3-logic-alleninterval-2",
