    {
      "@id": "concept:competition-and-consumer-act-2010-sec-184",
      "@type": "cml:Concept",
      "skos:prefLabel": "184 Notices under section 93",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-184"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.592",
      "values:originalText": "A notice that was in force under a provision of section 93\nimmediately before the commencement time continues in force\n(and may be dealt with) at and after the commencement time as if\nit had been given under that provision as amended by the amending\nAct.\n\nMiscellaneous  Chapter 8\nApplication and transitional provisions relating to the competition provisions  Part XIII\nApplication of amendments made by the Competition and Consumer Amendment\n(Competition Policy Review) Act 2017  Division 3\n\nSection 185\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "A notice that was in force under a provision of section 93\nimmediately before the commencement time continues in force\n(and may be dealt with) at and after the commencement time as if\nit had been given under that provision as amended by the amending\nAct.\n\nMiscellaneous  Chapter 8\nApplication and transitional provisions relating to the competition provisions  Part XIII\nApplication of amendments made by the Competition and Consumer Amendment\n(Competition Policy Review) Act 2017  Division 3\n\nSection 185\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-184-norm"
        }
      ],
      "cml:integrityHash": "7aece7d4eabd18a45a1b7369eff0434eb330107b7228a5b65a3ea9c63b81f7df",
      "skos:note": "Continuation of notices under section 93 after commencement time"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-184",
      "@type": "cof:Section",
      "cof:title": "184 Notices under section 93",
      "values:kind": "section",
      "cof:pageNumber": 592,
      "values:originalText": "A notice that was in force under a provision of section 93\nimmediately before the commencement time continues in force\n(and may be dealt with) at and after the commencement time as if\nit had been given under that provision as amended by the amending\nAct.\n\nMiscellaneous  Chapter 8\nApplication and transitional provisions relating to the competition provisions  Part XIII\nApplication of amendments made by the Competition and Consumer Amendment\n(Competition Policy Review) Act 2017  Division 3\n\nSection 185\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-184-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-184"
      },
