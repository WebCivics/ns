          "@id": "concept:competition-and-consumer-act-2010-sec-139c-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7a8c74c2c6720bff8d308c5a5ee5f4e8a0c85fa827c6623a35ac84939b8615c1",
      "skos:note": "Any conduct engaged in on behalf of a person other than a body corporate within the scope of actual or apparent authority."
    },
    {
