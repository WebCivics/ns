      },
      "cml:premiseText": "(5) Without limiting subsection (1)",
      "cml:conclusionText": "outwards liner cargo shipping services provided, or proposed to be provided, on the trade route specified in relation to the ocean carrier in the register of non-conference ocean carriers with substantial market power;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-168-ss-5-logic-deontic-4",
