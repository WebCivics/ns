        }
      ],
      "cml:integrityHash": "c4b0cb17ddc1ebe0d5c3b2017b022fb65ccb09b366c38448887269b2a06e5091",
      "skos:note": "Minister may direct Registrar to register ocean carrier with substantial market power."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-161-ss-1",
