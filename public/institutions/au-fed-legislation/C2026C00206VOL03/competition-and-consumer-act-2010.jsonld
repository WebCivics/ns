    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152eh",
      "@type": "cml:Concept",
      "skos:prefLabel": "152EH Consent injunctions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152eh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.423",
      "values:originalText": "On an application for an injunction under section 152EG, the\nFederal Court may grant an injunction by consent of all of the\nparties to the proceedings, whether or not the Court is satisfied that\nthe section applies.",
      "skos:definition": "On an application for an injunction under section 152EG, the\nFederal Court may grant an injunction by consent of all of the\nparties to the proceedings, whether or not the Court is satisfied that\nthe section applies.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152eh-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152eh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1e97bb057c022381b3eccf70e47d0f18f07134092222c2ddec3a2d0095f6cd12",
      "skos:note": "Federal Court may grant an injunction by consent of all parties to the proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152eh",
      "@type": "cof:Section",
      "cof:title": "152EH Consent injunctions",
      "values:kind": "section",
      "cof:pageNumber": 423,
      "values:originalText": "On an application for an injunction under section 152EG, the\nFederal Court may grant an injunction by consent of all of the\nparties to the proceedings, whether or not the Court is satisfied that\nthe section applies."
    },
