    {
      "@id": "concept:competition-and-consumer-act-2010-sec-139b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "139B(2) Conduct of directors, employees or agents of bodies corporate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-139b-ss-2"
