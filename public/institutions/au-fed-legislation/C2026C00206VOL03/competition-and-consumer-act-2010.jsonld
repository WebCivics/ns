    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zu",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZU Variation or revocation of approval",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zu"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.530",
      "values:originalText": "(1) A designated complainant may apply to the Minister for a variation\nor revocation of its approval.\n\n(2) The application must be:\n\n(a) in writing; and\n\n(b) in the approved form.\nWithdrawal of application\n\n(3) The designated complainant may, in writing, withdraw the\napplication if the Minister has not decided it.\n\n(4) If the designated complainant withdraws the application, it is taken\nnever to have been made.\n\nMiscellaneous  Chapter 8\nDesignated complaints  Part XIE\nDesignated complainants  Division 3\n\nSection 154ZV\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "(1) A designated complainant may apply to the Minister for a variation\nor revocation of its approval.\n\n(2) The application must be:\n\n(a) in writing; and\n\n(b) in the approved form.\nWithdrawal of application\n\n(3) The designated complainant may, in writing, withdraw the\napplication if the Minister has not decided it.\n\n(4) If the designated complainant withdraws the application, it is taken\nnever to have been made.\n\nMiscellaneous  Chapter 8\nDesignated complaints  Part XIE\nDesignated complainants  Division 3\n\nSection 154ZV\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zu-ss-1"
        },
