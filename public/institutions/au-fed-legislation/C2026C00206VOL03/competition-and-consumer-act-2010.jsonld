          "@id": "concept:competition-and-consumer-act-2010-sec-137g-ss-2"
        }
      ],
      "cml:integrityHash": "bc3e59dc5cb11e46bebba1b7ab57b37d2ee31aa15b1f8db7d8c2b32b92e94128"
    },
