      "cml:integrityHash": "5da5fd8dce0e55737a054e8781b833ddbbdcbb4ad87bd995c511a88b0ee6c8b9",
      "skos:note": "Exemptions from certain sections for conduct under a registered conference agreement"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-124-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) 17  Exemptions from sections 45AF, 45AG, 45AJ, 45AK and 45",
      "values:kind": "subsection",
      "cof:pageNumber": 51,
      "values:originalText": "(2) Sections 45AG, 45AK and 45 do not apply in relation to conduct\nengaged in by a party to a registered conference agreement so far\nas the conduct gives effect to a provision of the agreement in\n\nChapter 6  Other provisions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-124-ss-2-norm",
      "@type": "values:Permission",
