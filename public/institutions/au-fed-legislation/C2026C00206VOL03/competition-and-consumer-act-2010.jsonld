    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153u-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "153U(3) No Treasurer action notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153u-ss-3"
      },
