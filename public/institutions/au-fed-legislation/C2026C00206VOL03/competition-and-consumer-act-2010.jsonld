        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) For the purposes of being satisfied that it is appropriate to grant the approval, the Minister must have regard to the following matters:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zq-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
