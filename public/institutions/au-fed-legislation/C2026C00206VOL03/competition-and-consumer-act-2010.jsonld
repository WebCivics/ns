    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-111-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(6) 03  Designated shipper bodies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-111-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
