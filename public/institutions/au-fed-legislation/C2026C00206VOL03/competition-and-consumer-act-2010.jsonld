    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135l",
      "@type": "cml:Concept",
      "skos:prefLabel": "135L Occupier etc. to provide inspector etc. with facilities and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.161",
      "values:originalText": "assistance\n\n(1) A person commits an offence if:\n\n(a) the person is:\n\n(i) the occupier of premises to which a search warrant\nrelates; or\n\n(ii) another person who apparently represents the occupier\nof those premises; and\n\n(b) the person fails to provide:\n\n(i) an inspector executing the warrant; and\n\nChapter 6  Other provisions",
      "skos:definition": "assistance\n\n(1) A person commits an offence if:\n\n(a) the person is:\n\n(i) the occupier of premises to which a search warrant\nrelates; or\n\n(ii) another person who apparently represents the occupier\nof those premises; and\n\n(b) the person fails to provide:\n\n(i) an inspector executing the warrant; and\n\nChapter 6  Other provisions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135l-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eea6d8a33b3e2a6292397d714e8df4a5e14a90775ad15832556e9bf9308cb6b6",
      "skos:note": "Failing to provide inspector with facilities and assistance is an offence.",
      "dc:description": "Facilities and assistance for inspectors"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135l",
      "@type": "cof:Section",
      "cof:title": "135L Occupier etc. to provide inspector etc. with facilities and",
      "values:kind": "section",
      "cof:pageNumber": 161,
      "values:originalText": "assistance\n\n(1) A person commits an offence if:\n\n(a) the person is:\n\n(i) the occupier of premises to which a search warrant\nrelates; or\n\n(ii) another person who apparently represents the occupier\nof those premises; and\n\n(b) the person fails to provide:\n\n(i) an inspector executing the warrant; and\n\nChapter 6  Other provisions"
    },
