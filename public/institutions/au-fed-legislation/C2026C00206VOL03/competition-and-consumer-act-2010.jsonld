        }
      ],
      "cml:integrityHash": "d799de7b6d63d9452c73b28319f5ff934aa4cb4953ae3d3abbfe606814ee4434",
      "skos:note": "Notice must be given to the Registrar in a prescribed form.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-149-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) 40  Notification of happening of affecting events prior to final",
      "values:kind": "subsection",
      "cof:pageNumber": 70,
      "values:originalText": "(2) The notice must be:\n\nOther provisions  Chapter 6\nInternational liner cargo shipping  Part X\nRegistration of conference agreements  Division 6\n\nSection 10.40\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(a) in the appropriate prescribed form; and\n\n(b) given to the Registrar in accordance with the regulations."
    },
