    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-177-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(3) 67  Determination of whether practice contrary to national",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-177-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
