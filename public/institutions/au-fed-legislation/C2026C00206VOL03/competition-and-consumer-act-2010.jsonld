      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135q-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
