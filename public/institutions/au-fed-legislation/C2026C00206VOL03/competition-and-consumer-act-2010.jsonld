    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152ar-ss-3-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "⊢",
      "cml:logicSummary": "Implication: if access provider supplies active declared service, then technical and operational quality of the active declared service supplied to the service provider is equivalent to that which the access provider provides to itself.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
