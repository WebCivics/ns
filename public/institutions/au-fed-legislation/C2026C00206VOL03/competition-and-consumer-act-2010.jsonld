    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152bc-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "152BC(5) Access determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152bc-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
