      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Review decision within a specific interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the Tribunal receives an application under this section for a review of a decision, the Tribunal must review the decision.",
      "cml:conclusionText": "The review decision is contained within the interval specified by the application."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-201-ss-4-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "ENTAILMENT",
      "cml:logicSummary": "Entailment of review obligation",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the Tribunal receives an application under this section for a review of a decision, the Tribunal must review the decision.",
      "cml:conclusionText": "The entailment of the review obligation is that if the Tribunal receives an application, it MUST review the decision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-201-ss-4-logic-n3logic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
