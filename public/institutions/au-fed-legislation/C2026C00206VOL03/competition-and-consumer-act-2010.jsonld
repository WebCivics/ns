    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153b",
      "@type": "cml:Concept",
      "skos:prefLabel": "153B Part etc. ceases to be in force",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.432",
      "values:originalText": "The following cease to be in force on 1 January 2031:\n\n(a) this Part;\n\n(b) any other provision of this Act, to the extent that the\nprovision relates to this Part.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nPreliminary  Division 1\n\nSection 153C\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "The following cease to be in force on 1 January 2031:\n\n(a) this Part;\n\n(b) any other provision of this Act, to the extent that the\nprovision relates to this Part.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nPreliminary  Division 1\n\nSection 153C\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153b-norm"
        }
      ],
      "cml:integrityHash": "928d9f009f4eb5af89b29490bd9d32e9ae005dbe444454c0ff49dbb0d2216e73",
      "skos:note": "Provisions related to Part XICA cease to be in force on January 1, 2031."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153b",
      "@type": "cof:Section",
      "cof:title": "153B Part etc. ceases to be in force",
      "values:kind": "section",
      "cof:pageNumber": 432,
      "values:originalText": "The following cease to be in force on 1 January 2031:\n\n(a) this Part;\n\n(b) any other provision of this Act, to the extent that the\nprovision relates to this Part.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nPreliminary  Division 1\n\nSection 153C\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153b-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-153b"
      },
