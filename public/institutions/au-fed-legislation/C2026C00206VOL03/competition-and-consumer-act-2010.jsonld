      "cml:integrityHash": "8cc9d7f67bc76b367b3cff4af95fb64763cd693ca718ccb39938d2fd5ed1024f",
      "skos:note": "Commission must provide certificate to party upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-166-ss-1",
