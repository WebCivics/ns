    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151bv",
      "@type": "cml:Concept",
      "skos:prefLabel": "151BV Incorrect records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151bv"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.264",
      "values:originalText": "(1) A person must not, in purported compliance with a requirement\nimposed by the record-keeping rules, make a record of any matter\nor thing in such a way that it does not correctly record the matter or\nthing.\n\n(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by imprisonment for a term not\nexceeding 6 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "skos:definition": "(1) A person must not, in purported compliance with a requirement\nimposed by the record-keeping rules, make a record of any matter\nor thing in such a way that it does not correctly record the matter or\nthing.\n\n(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by imprisonment for a term not\nexceeding 6 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151bv-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151bv-ss-2"
        }
      ],
      "cml:integrityHash": "74df4528e26ff68f77fbcfa34cbb30ab0a61f9afb2503a0384ca419ae224e68e"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151bv",
      "@type": "cof:Section",
      "cof:title": "151BV Incorrect records",
      "values:kind": "section",
      "cof:pageNumber": 264,
      "values:originalText": "(1) A person must not, in purported compliance with a requirement\nimposed by the record-keeping rules, make a record of any matter\nor thing in such a way that it does not correctly record the matter or\nthing.\n\n(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by imprisonment for a term not\nexceeding 6 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151bv-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "151BV(1) Incorrect records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151bv-ss-1"
      },
      "cml:curationStatus": {
