    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153g",
      "@type": "cml:Concept",
      "skos:prefLabel": "153G Prohibited conduct—electricity spot market (basic case)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.436",
      "values:originalText": "A corporation contravenes this section if:\n\n(a) the corporation:\n\n(i) bids or offers to supply electricity in relation to an\nelectricity spot market; or\n\n(ii) fails to bid or offer to supply electricity in relation to an\nelectricity spot market; and\n\n(b) the corporation does so:\n\n(i) fraudulently, dishonestly or in bad faith; or\n\n(ii) for the purpose of distorting or manipulating prices in\nthat electricity spot market.\nNote 1:\nThe Treasurer cannot make a contracting order in respect of a\ncontravention of this section (see paragraph 153W(e)).\nNote 2:\nThe Treasurer cannot apply for a divestiture order in respect of a\ncontravention of this section (see paragraph 153ZA(e)).",
      "skos:definition": "A corporation contravenes this section if:\n\n(a) the corporation:\n\n(i) bids or offers to supply electricity in relation to an\nelectricity spot market; or\n\n(ii) fails to bid or offer to supply electricity in relation to an\nelectricity spot market; and\n\n(b) the corporation does so:\n\n(i) fraudulently, dishonestly or in bad faith; or\n\n(ii) for the purpose of distorting or manipulating prices in\nthat electricity spot market.\nNote 1:\nThe Treasurer cannot make a contracting order in respect of a\ncontravention of this section (see paragraph 153W(e)).\nNote 2:\nThe Treasurer cannot apply for a divestiture order in respect of a\ncontravention of this section (see paragraph 153ZA(e)).",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153g-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cafb9b7d7b4cfb29d7806b30f4aad9f7361535740de384f2976d5061ce4a6c22",
      "skos:note": "Bidding or failing to bid in an electricity spot market is prohibited if done fraudulently, dishonestly, or in bad faith."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153g",
      "@type": "cof:Section",
      "cof:title": "153G Prohibited conduct—electricity spot market (basic case)",
      "values:kind": "section",
      "cof:pageNumber": 436,
      "values:originalText": "A corporation contravenes this section if:\n\n(a) the corporation:\n\n(i) bids or offers to supply electricity in relation to an\nelectricity spot market; or\n\n(ii) fails to bid or offer to supply electricity in relation to an\nelectricity spot market; and\n\n(b) the corporation does so:\n\n(i) fraudulently, dishonestly or in bad faith; or\n\n(ii) for the purpose of distorting or manipulating prices in\nthat electricity spot market.\nNote 1:\nThe Treasurer cannot make a contracting order in respect of a\ncontravention of this section (see paragraph 153W(e)).\nNote 2:\nThe Treasurer cannot apply for a divestiture order in respect of a\ncontravention of this section (see paragraph 153ZA(e))."
    },
    {
