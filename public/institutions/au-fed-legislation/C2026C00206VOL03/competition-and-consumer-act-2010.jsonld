      "cml:integrityHash": "3e7fe4183e49d2d0eb9bf3a9f5cdf99586b02bbeabfcb2bc98c4635d535f33f7",
      "skos:note": "Notice requirements for prohibited conduct recommendation",
      "dc:description": "Reasons for not giving Treasurer a recommendation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153u-ss-2",
      "@type": "cof:Section",
      "cof:title": "153U(2) No Treasurer action notice",
      "values:kind": "subsection",
      "cof:pageNumber": 448,
      "values:originalText": "(2) The notice must:\n\n(a) be expressed to be given under this section; and\n\n(b) state the day on which the notice is given; and\n\n(c) explain the reasons why the Commission considers that it is\nnot appropriate to give the Treasurer a prohibited conduct\nrecommendation in respect of the prohibited conduct notice."
    },
