    {
      "@id": "concept:competition-and-consumer-act-2010-sec-166",
      "@type": "cml:Concept",
      "skos:prefLabel": "166 Certificates as to furnishing of particulars to Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-166"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.577",
      "values:originalText": "(1) Where particulars of a provision of a contract, arrangement or\nunderstanding, or particulars of a concerted practice, have been\nfurnished to the Commission for the purposes of\nparagraph 51(2)(g), the Commission shall, on application by a\nparty to the contract, arrangement, understanding or concerted\npractice, cause to be furnished to the party a certificate signed by a\nmember of the Commission specifying the particulars so furnished\nand the date on which the particulars were furnished.\n\n(2) A certificate referred to in subsection (1) shall be received in all\ncourts as evidence that the particulars specified in the certificate\nwere furnished to the Commission on the date so specified.\n\nChapter 8  Miscellaneous",
      "skos:definition": "(1) Where particulars of a provision of a contract, arrangement or\nunderstanding, or particulars of a concerted practice, have been\nfurnished to the Commission for the purposes of\nparagraph 51(2)(g), the Commission shall, on application by a\nparty to the contract, arrangement, understanding or concerted\npractice, cause to be furnished to the party a certificate signed by a\nmember of the Commission specifying the particulars so furnished\nand the date on which the particulars were furnished.\n\n(2) A certificate referred to in subsection (1) shall be received in all\ncourts as evidence that the particulars specified in the certificate\nwere furnished to the Commission on the date so specified.\n\nChapter 8  Miscellaneous",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-166-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-166-ss-2"
        }
      ],
      "cml:integrityHash": "4cb5116feae4172197f648f4dd0b93a1df646416e9e61819054e68f7fdb696b1"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-166",
      "@type": "cof:Section",
      "cof:title": "166 Certificates as to furnishing of particulars to Commission",
      "values:kind": "section",
      "cof:pageNumber": 577,
      "values:originalText": "(1) Where particulars of a provision of a contract, arrangement or\nunderstanding, or particulars of a concerted practice, have been\nfurnished to the Commission for the purposes of\nparagraph 51(2)(g), the Commission shall, on application by a\nparty to the contract, arrangement, understanding or concerted\npractice, cause to be furnished to the party a certificate signed by a\nmember of the Commission specifying the particulars so furnished\nand the date on which the particulars were furnished.\n\n(2) A certificate referred to in subsection (1) shall be received in all\ncourts as evidence that the particulars specified in the certificate\nwere furnished to the Commission on the date so specified.\n\nChapter 8  Miscellaneous"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-166-ss-1",
