      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-152el",
      "@type": "cml:Concept",
      "skos:prefLabel": "152EL Discharge or variation of injunction or other order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152el"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.424",
      "values:originalText": "The Federal Court may discharge or vary an injunction or order\ngranted under this Division.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nProcedural Rules  Division 10A\n\nSection 152ELA\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "skos:definition": "The Federal Court may discharge or vary an injunction or order\ngranted under this Division.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nTelecommunications access regime  Part XIC\nProcedural Rules  Division 10A\n\nSection 152ELA\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152el-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152el-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-152el-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "2564f68b5775831aff1918aa5f90b860dcdb552303a5ee95c3cdbef6c8d3a114",
      "skos:note": "May discharge or vary an injunction or order granted under this Division."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-152el",
      "@type": "cof:Section",
      "cof:title": "152EL Discharge or variation of injunction or other order",
