      },
      "cml:operator": "Right",
      "cml:logicSummary": "Compliance with disclosure notice is a right.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A person commits an offence if:\n\n(a) the person is given a disclosure notice; and\n\n(b) the person refuses or fails to comply with the notice.",
      "cml:conclusionText": "The person has the right to refuse compliance."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-133f-ss-1-logic-deontic-5",
