    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135s",
      "@type": "cml:Concept",
      "skos:prefLabel": "135S Embargo notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135s"
      },
      "cml:curationStatus": {
