      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.508",
      "values:originalText": "(1) If a thing is seized under a search warrant or moved under\nsubsection 154GA(1), the executing officer or an officer assisting\nmust provide a receipt for the thing.\n\n(2) If 2 or more things are seized or moved, they may be covered in\nthe one receipt.",
      "skos:definition": "(1) If a thing is seized under a search warrant or moved under\nsubsection 154GA(1), the executing officer or an officer assisting\nmust provide a receipt for the thing.\n\n(2) If 2 or more things are seized or moved, they may be covered in\nthe one receipt.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154t-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154t-ss-2"
        }
      ],
      "cml:integrityHash": "685d8146fd2435c670e0ca1556d79fbec1e9af10d5a4ab6c7b85ee3b9e6a303c"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154t",
      "@type": "cof:Section",
      "cof:title": "154T Receipts for things seized or moved under warrant",
      "values:kind": "section",
      "cof:pageNumber": 508,
      "values:originalText": "(1) If a thing is seized under a search warrant or moved under\nsubsection 154GA(1), the executing officer or an officer assisting\nmust provide a receipt for the thing.\n\n(2) If 2 or more things are seized or moved, they may be covered in\nthe one receipt."
    },
