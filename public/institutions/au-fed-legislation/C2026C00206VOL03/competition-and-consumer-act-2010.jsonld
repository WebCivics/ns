      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154u-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Duty to return seized thing",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Seizer must take reasonable steps to return the thing",
      "cml:conclusionText": "Unless certain conditions are met"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154v",
      "@type": "cml:Concept",
      "skos:prefLabel": "154V Magistrate may permit a thing to be retained",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.509",
      "values:originalText": "Application for extension\n\n(1) An inspector may apply to a magistrate for an order that he or she\nmay retain the thing for a further period if:\n\n(a) before the end of 120 days after the seizure; or\n\n(b) before the end of a period previously specified in an order of\na magistrate under this section;\nproceedings in respect of which the thing may afford evidence\nhave not commenced.\nGrant of extension\n\n(2) If the magistrate is satisfied that it is necessary for the inspector to\ncontinue to retain the thing for the purposes of an investigation as\nto whether there has been:\n\n(a) a contravention of this Act, a gas market instrument or the\nconsumer data rules; or\n\n(b) a contravention of Part 20 of the Telecommunications Act\n1997; or\n\n(c) a contravention of Part 9 of the Telecommunications\n(Consumer Protection and Service Standards) Act 1999; or\n\nChapter 8  Miscellaneous",
      "skos:definition": "Application for extension\n\n(1) An inspector may apply to a magistrate for an order that he or she\nmay retain the thing for a further period if:\n\n(a) before the end of 120 days after the seizure; or\n\n(b) before the end of a period previously specified in an order of\na magistrate under this section;\nproceedings in respect of which the thing may afford evidence\nhave not commenced.\nGrant of extension\n\n(2) If the magistrate is satisfied that it is necessary for the inspector to\ncontinue to retain the thing for the purposes of an investigation as\nto whether there has been:\n\n(a) a contravention of this Act, a gas market instrument or the\nconsumer data rules; or\n\n(b) a contravention of Part 20 of the Telecommunications Act\n1997; or\n\n(c) a contravention of Part 9 of the Telecommunications\n(Consumer Protection and Service Standards) Act 1999; or\n\nChapter 8  Miscellaneous",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154v-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154v-ss-2"
        }
      ],
      "cml:integrityHash": "768f981afa83a77975b7c75f5c65f6c10408b62b8dffb82eb77c23d93a367217"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154v",
      "@type": "cof:Section",
      "cof:title": "154V Magistrate may permit a thing to be retained",
      "values:kind": "section",
      "cof:pageNumber": 509,
      "values:originalText": "Application for extension\n\n(1) An inspector may apply to a magistrate for an order that he or she\nmay retain the thing for a further period if:\n\n(a) before the end of 120 days after the seizure; or\n\n(b) before the end of a period previously specified in an order of\na magistrate under this section;\nproceedings in respect of which the thing may afford evidence\nhave not commenced.\nGrant of extension\n\n(2) If the magistrate is satisfied that it is necessary for the inspector to\ncontinue to retain the thing for the purposes of an investigation as\nto whether there has been:\n\n(a) a contravention of this Act, a gas market instrument or the\nconsumer data rules; or\n\n(b) a contravention of Part 20 of the Telecommunications Act\n1997; or\n\n(c) a contravention of Part 9 of the Telecommunications\n(Consumer Protection and Service Standards) Act 1999; or\n\nChapter 8  Miscellaneous"
    },
