      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-154-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "cannot",
      "cml:logicSummary": "Prohibition on giving direction",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Minister is not allowed to give direction",
      "cml:conclusionText": "unless certain conditions are met"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-154-logic-alleninterval-2",
