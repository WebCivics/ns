        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-10-111-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e113c3bc3578dac4ba0bc4eb91fee37b409df070ded6f5940935a27813660236",
      "skos:note": "Must provide particulars in register regarding shipper body designation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-111-ss-4",
      "@type": "cof:Section",
      "cof:title": "10(4) 03  Designated shipper bodies",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(4) The particulars entered in the register shall include whether the\nassociation is a designated outwards peak shipper body, a\ndesignated inwards peak shipper body, a designated outwards\nsecondary shipper body or a designated inwards secondary shipper\nbody."
    },
