        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.264",
      "values:originalText": "(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by imprisonment for a term not\nexceeding 6 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "skos:definition": "(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by imprisonment for a term not\nexceeding 6 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Telecommunications Industry: Anti-competitive conduct and record-keeping rules",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-151bv"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151bv-ss-2-norm"
        },
        {
