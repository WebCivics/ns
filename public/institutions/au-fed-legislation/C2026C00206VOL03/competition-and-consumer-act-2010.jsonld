      "@type": "cml:Concept",
      "skos:prefLabel": "137D Compensation orders etc. arising out of unconscionable",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-137d"
