    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134g-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "134G(2) Withdrawal of an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134g-ss-2"
