    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135e",
      "@type": "cml:Concept",
      "skos:prefLabel": "135E Use of force in executing a search warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.159",
      "values:originalText": "In executing a search warrant, an inspector executing the warrant\nmay use such force against persons and things as is necessary and\nreasonable in the circumstances.",
      "skos:definition": "In executing a search warrant, an inspector executing the warrant\nmay use such force against persons and things as is necessary and\nreasonable in the circumstances.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135e-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6116e34dd07a1d9c3e23d56770271a4c665f0c4ad97b746af2927b4e41817731",
      "skos:note": "Inspector may use necessary and reasonable force in executing a search warrant."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135e",
      "@type": "cof:Section",
      "cof:title": "135E Use of force in executing a search warrant",
      "values:kind": "section",
      "cof:pageNumber": 159,
      "values:originalText": "In executing a search warrant, an inspector executing the warrant\nmay use such force against persons and things as is necessary and\nreasonable in the circumstances."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135e-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
