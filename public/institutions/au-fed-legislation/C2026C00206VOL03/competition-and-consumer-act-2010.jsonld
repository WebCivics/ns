      ],
      "cml:integrityHash": "2149d99647b34a3d507670a68d875f48c192a0f7a65814c732c711219acfc090",
      "skos:note": "Commission must give notice to designated complainant."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zl-ss-3",
      "@type": "cof:Section",
      "cof:title": "154ZL(3) Replacement notices",
      "values:kind": "subsection",
      "cof:pageNumber": 524,
      "values:originalText": "(3) If paragraph (1)(b) applies:\n\n(a) the Commission must give the designated complainant the\nnotice mentioned in that paragraph; and\n\n(b) subsection 154ZK(3) ceases to apply in relation to the\ncomplaint."
    },
