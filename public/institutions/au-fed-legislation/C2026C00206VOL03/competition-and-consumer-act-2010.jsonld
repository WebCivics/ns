    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154ga-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "154GA(3) Removing things for examination or processing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154ga-ss-3"
