    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154f",
      "@type": "cml:Concept",
      "skos:prefLabel": "154F Operation of electronic equipment at premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.497",
      "values:originalText": "(1) If:\n\n(a) an inspector or an assistant enters premises under this\nDivision; and\n\n(b) he or she believes on reasonable grounds that any data\naccessed by operating electronic equipment at the premises\n(including data not held at the premises) might constitute\nevidential material;\nhe or she may do only 1 of 2 things.\nRemoval of documents\n\n(2) One thing he or she may do is operate the equipment or other\nfacilities at the premises to put the data in documentary form and\nremove the documents so produced from the premises.\n\nChapter 8  Miscellaneous",
      "skos:definition": "(1) If:\n\n(a) an inspector or an assistant enters premises under this\nDivision; and\n\n(b) he or she believes on reasonable grounds that any data\naccessed by operating electronic equipment at the premises\n(including data not held at the premises) might constitute\nevidential material;\nhe or she may do only 1 of 2 things.\nRemoval of documents\n\n(2) One thing he or she may do is operate the equipment or other\nfacilities at the premises to put the data in documentary form and\nremove the documents so produced from the premises.\n\nChapter 8  Miscellaneous",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154f-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154f-ss-2"
        }
      ],
      "cml:integrityHash": "6769b952307035ffcb499befa0e6fb1104dc93fff6997d54e67e69c7e5b16e81"
    },
