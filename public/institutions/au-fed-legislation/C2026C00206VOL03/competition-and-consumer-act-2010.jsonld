      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister has the power to delegate",
      "cml:conclusionText": "The Registrar or specified person may perform certain actions"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-195-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
