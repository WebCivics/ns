    {
      "@id": "concept:competition-and-consumer-act-2010-sec-137b",
      "@type": "cml:Concept",
      "skos:prefLabel": "137B Reduction of the amount of loss or damage if the claimant fails",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-137b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.177",
      "values:originalText": "to take reasonable care\n\nIf:\n\n(a) a person (the claimant) makes a claim under\nsubsection 236(1) of the Australian Consumer Law in\nrelation to economic loss, or damage to property, suffered by\nthe claimant because of the conduct of another person; and\n\n(b) the conduct contravened section 18 of the Australian\nConsumer Law; and\n\n(c) the claimant suffered the loss or damage as result:\n\n(i) partly of the claimant’s failure to take reasonable care;\nand\n\n(ii) partly of the conduct of the other person; and\n\n(d) the other person did not intend to cause the loss or damage\nand did not fraudulently cause the loss or damage;\nthe amount of the loss or damage that the claimant may recover\nunder subsection 236(1) of the Australian Consumer Law is to be\nreduced to the extent to which a court thinks just and equitable\nhaving regard to the claimant’s share in the responsibility for the\nloss or damage.",
      "skos:definition": "to take reasonable care\n\nIf:\n\n(a) a person (the claimant) makes a claim under\nsubsection 236(1) of the Australian Consumer Law in\nrelation to economic loss, or damage to property, suffered by\nthe claimant because of the conduct of another person; and\n\n(b) the conduct contravened section 18 of the Australian\nConsumer Law; and\n\n(c) the claimant suffered the loss or damage as result:\n\n(i) partly of the claimant’s failure to take reasonable care;\nand\n\n(ii) partly of the conduct of the other person; and\n\n(d) the other person did not intend to cause the loss or damage\nand did not fraudulently cause the loss or damage;\nthe amount of the loss or damage that the claimant may recover\nunder subsection 236(1) of the Australian Consumer Law is to be\nreduced to the extent to which a court thinks just and equitable\nhaving regard to the claimant’s share in the responsibility for the\nloss or damage.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-137b-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-137b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "14fa9d3822e6f9c962ba6386b44ef64fece47d07272b02c31ca49a92c486be21",
      "skos:note": "Reduction of loss or damage if claimant fails to take reasonable care"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-137b",
      "@type": "cof:Section",
      "cof:title": "137B Reduction of the amount of loss or damage if the claimant fails",
      "values:kind": "section",
      "cof:pageNumber": 177,
      "values:originalText": "to take reasonable care\n\nIf:\n\n(a) a person (the claimant) makes a claim under\nsubsection 236(1) of the Australian Consumer Law in\nrelation to economic loss, or damage to property, suffered by\nthe claimant because of the conduct of another person; and\n\n(b) the conduct contravened section 18 of the Australian\nConsumer Law; and\n\n(c) the claimant suffered the loss or damage as result:\n\n(i) partly of the claimant’s failure to take reasonable care;\nand\n\n(ii) partly of the conduct of the other person; and\n\n(d) the other person did not intend to cause the loss or damage\nand did not fraudulently cause the loss or damage;\nthe amount of the loss or damage that the claimant may recover\nunder subsection 236(1) of the Australian Consumer Law is to be\nreduced to the extent to which a court thinks just and equitable\nhaving regard to the claimant’s share in the responsibility for the\nloss or damage."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-137b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-137b"
      },
      "values:deonticStatus": {
