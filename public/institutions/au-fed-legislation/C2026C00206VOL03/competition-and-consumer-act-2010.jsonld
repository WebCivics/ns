        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139d-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f1e55a9935e3635342c3d164f13c1fa31b2ef5f0cbef8fffe32d9cb4fc3c1282",
      "skos:note": "Allow person to pay fine by instalments"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-139d-ss-3",
      "@type": "cof:Section",
      "cof:title": "139D(3) Enforcement and recovery of certain fines",
      "values:kind": "subsection",
      "cof:pageNumber": 194,
      "values:originalText": "(3) If the court makes an enforcement order, the court may, at any time\nbefore the enforcement order is executed:\n\n(a) allow the person a specified time in which to pay the fine; or\n\n(b) allow the person to pay the fine by specified instalments."
    },
