    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135g",
      "@type": "cml:Concept",
      "skos:prefLabel": "135G Inspector must be in possession of search warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.160",
      "values:originalText": "If a search warrant is being executed in relation to premises, an\ninspector executing the warrant must be in possession of:\n\n(a) the warrant issued under section 135Z or a copy of that\nwarrant; or\n\n(b) the form of warrant completed under subsection 136(7), or a\ncopy of that form.\nSubdivision B—Obligations of inspectors",
      "skos:definition": "If a search warrant is being executed in relation to premises, an\ninspector executing the warrant must be in possession of:\n\n(a) the warrant issued under section 135Z or a copy of that\nwarrant; or\n\n(b) the form of warrant completed under subsection 136(7), or a\ncopy of that form.\nSubdivision B—Obligations of inspectors",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135g-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c36b667f0270128c5e8d8148ccf5b9d081f3c2cdc0c37cf556ede5be322af6a8",
      "skos:note": "Inspector must be in possession of search warrant",
      "dc:description": "a) the warrant issued under section 135Z or a copy of that warrant; or b) the form of warrant completed under subsection 136(7), or a copy of that form."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135g",
      "@type": "cof:Section",
      "cof:title": "135G Inspector must be in possession of search warrant",
      "values:kind": "section",
      "cof:pageNumber": 160,
      "values:originalText": "If a search warrant is being executed in relation to premises, an\ninspector executing the warrant must be in possession of:\n\n(a) the warrant issued under section 135Z or a copy of that\nwarrant; or\n\n(b) the form of warrant completed under subsection 136(7), or a\ncopy of that form.\nSubdivision B—Obligations of inspectors"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135g-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-act-2010-sec-135g"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MustHave",
      "cml:logicSummary": "Inspector must have the warrant",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h",
      "@type": "cml:Concept",
      "skos:prefLabel": "135H Consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.160",
      "values:originalText": "(1) An inspector must, before obtaining the consent of an occupier of\npremises for the purposes of paragraph 135(3)(a), inform the\noccupier that the occupier may refuse consent.\n\n(2) A consent has no effect unless the consent is voluntary.\n\n(3) If an inspector enters premises because the occupier of the\npremises consented to the entry, the inspector, and a person\nassisting the inspector, must leave the premises if the consent\nceases to have effect.",
      "skos:definition": "(1) An inspector must, before obtaining the consent of an occupier of\npremises for the purposes of paragraph 135(3)(a), inform the\noccupier that the occupier may refuse consent.\n\n(2) A consent has no effect unless the consent is voluntary.\n\n(3) If an inspector enters premises because the occupier of the\npremises consented to the entry, the inspector, and a person\nassisting the inspector, must leave the premises if the consent\nceases to have effect.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-3"
        }
      ],
      "cml:integrityHash": "8318c7eaf6f729e1ddb0818cfad7cd14cb0cc6c16458a7a50c24488e51558f32"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-135h",
      "@type": "cof:Section",
      "cof:title": "135H Consent",
      "values:kind": "section",
      "cof:pageNumber": 160,
      "values:originalText": "(1) An inspector must, before obtaining the consent of an occupier of\npremises for the purposes of paragraph 135(3)(a), inform the\noccupier that the occupier may refuse consent.\n\n(2) A consent has no effect unless the consent is voluntary.\n\n(3) If an inspector enters premises because the occupier of the\npremises consented to the entry, the inspector, and a person\nassisting the inspector, must leave the premises if the consent\nceases to have effect."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135h-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "135H(1) Consent",
