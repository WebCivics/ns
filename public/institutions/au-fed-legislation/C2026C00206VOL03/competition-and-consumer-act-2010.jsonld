    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-203",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 82F  Modifying register after Tribunal review",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-203"
      },
      "cml:curationStatus": {
