    {
      "@id": "concept:competition-and-consumer-act-2010-sec-151au",
      "@type": "cml:Concept",
      "skos:prefLabel": "151AU Further information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151au"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.234",
      "values:originalText": "(1) The Commission may request an applicant for an exemption order\nto give the Commission further information about the application.\n\n(2) The Commission may refuse to consider the application until the\napplicant gives the Commission the information.\n\n(3) The Commission may withdraw its request for further information,\nin whole or in part.",
      "skos:definition": "(1) The Commission may request an applicant for an exemption order\nto give the Commission further information about the application.\n\n(2) The Commission may refuse to consider the application until the\napplicant gives the Commission the information.\n\n(3) The Commission may withdraw its request for further information,\nin whole or in part.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151au-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151au-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151au-ss-3"
        }
      ],
      "cml:integrityHash": "5bc380e91e6cfac8a1397b0d03073d1b97d7ccae7add98763079eb0362cf4b7c"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-151au",
      "@type": "cof:Section",
      "cof:title": "151AU Further information",
      "values:kind": "section",
      "cof:pageNumber": 234,
      "values:originalText": "(1) The Commission may request an applicant for an exemption order\nto give the Commission further information about the application.\n\n(2) The Commission may refuse to consider the application until the\napplicant gives the Commission the information.\n\n(3) The Commission may withdraw its request for further information,\nin whole or in part."
    },
