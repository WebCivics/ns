        }
      ],
      "cml:integrityHash": "dbec263bd84fa25b19ae19a3071adc07d984a68e4f555773d9c01fb1714e36c0",
      "skos:note": "Inspector must produce identity card upon request",
      "dc:description": "Identity card"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154c-ss-7",
      "@type": "cof:Section",
      "cof:title": "154C(7) Identity cards",
      "values:kind": "subsection",
      "cof:pageNumber": 494,
      "values:originalText": "(7) An inspector is not entitled to exercise any powers under this\nPart in relation to premises if:\n\n(a) the occupier of the premises has requested the inspector to\nproduce the inspector’s identity card for inspection by the\noccupier; and\n\n(b) the inspector fails to comply with the request.\n\nChapter 8  Miscellaneous"
    },
