    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-114",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 07  Minimum levels of shipping services to be specified in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-114"
      },
      "cml:curationStatus": {
