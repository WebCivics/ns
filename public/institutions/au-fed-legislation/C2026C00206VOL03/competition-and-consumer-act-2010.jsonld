    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135c-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to comply with a requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A person commits an offence if:\n\n(a) the person is subject to a requirement under subsection 135B(2); and\n\n(b) the person fails to comply with the requirement.",
      "cml:conclusionText": "The person must comply with the requirement."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135c-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "prohibition",
      "cml:logicSummary": "Prohibition of non-compliance.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) if the person is a body corporate—150 penalty units; or\n\n(b) if the person is not a body corporate—30 penalty units.",
      "cml:conclusionText": "Non-compliance is prohibited."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135c-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to pay penalty.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) if the person is a body corporate—150 penalty units; or\n\n(b) if the person is not a body corporate—30 penalty units.",
      "cml:conclusionText": "The person must pay the penalty."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135c-ss-1-logic-linearlogic-4",
