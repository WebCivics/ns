    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-152-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(4) 43  Parties to registered conference agreement to notify",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-152-ss-4"
