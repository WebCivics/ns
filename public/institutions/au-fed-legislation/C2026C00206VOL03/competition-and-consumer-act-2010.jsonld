      "skos:note": "Commission may withdraw infringement notice if satisfied it is appropriate to do so."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-134g-ss-3",
      "@type": "cof:Section",
