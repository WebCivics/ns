    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154ga-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "154GA(4) Removing things for examination or processing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154ga-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
