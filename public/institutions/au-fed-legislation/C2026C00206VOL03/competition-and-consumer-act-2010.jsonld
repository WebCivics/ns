    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-121-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Prohibits dealing between parties to a conference agreement and ancillary services provider.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) To avoid doubt, the exemptions provided by this Subdivision do not extend to any dealings between the parties to a conference agreement and a person who provides ancillary services on behalf of the provider of a scheduled cargo shipping service.",
      "cml:conclusionText": "Dealing is prohibited."
    },
    {
