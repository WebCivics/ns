    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zn",
      "@type": "cml:Concept",
      "skos:prefLabel": "154ZN Publication requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.525",
      "values:originalText": "(1) If the Commission gives:\n\n(a) a notice under subsection 154ZH(1) (no further action on\ncomplaint); or\n\n(b) a notice under subsection 154ZK(1) (further action to deal\nwith complaint); or\n\n(c) a notification under paragraph 154ZK(3)(c) (actions have\nbeen completed); or\n\n(d) a notification under subsection 154ZK(5) (Commission not\nrequired to take further action); or\n\n(e) a notice under paragraph 154ZL(2)(a) (replacement notice\nwith further action to deal with complaint); or\n\n(f) a notice under paragraph 154ZL(3)(a) (replacement notice\nwhere other inquiry or action, or appropriate to take no\nfurther action); or\n\nChapter 8  Miscellaneous",
      "skos:definition": "(1) If the Commission gives:\n\n(a) a notice under subsection 154ZH(1) (no further action on\ncomplaint); or\n\n(b) a notice under subsection 154ZK(1) (further action to deal\nwith complaint); or\n\n(c) a notification under paragraph 154ZK(3)(c) (actions have\nbeen completed); or\n\n(d) a notification under subsection 154ZK(5) (Commission not\nrequired to take further action); or\n\n(e) a notice under paragraph 154ZL(2)(a) (replacement notice\nwith further action to deal with complaint); or\n\n(f) a notice under paragraph 154ZL(3)(a) (replacement notice\nwhere other inquiry or action, or appropriate to take no\nfurther action); or\n\nChapter 8  Miscellaneous",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zn-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zn-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "004cd53635ec8dda7a17a978ec215b05320fc8d7c382282c9f29a56be3360a63",
      "skos:note": "Commission must provide notice under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zn",
      "@type": "cof:Section",
      "cof:title": "154ZN Publication requirements",
      "values:kind": "section",
      "cof:pageNumber": 525,
      "values:originalText": "(1) If the Commission gives:\n\n(a) a notice under subsection 154ZH(1) (no further action on\ncomplaint); or\n\n(b) a notice under subsection 154ZK(1) (further action to deal\nwith complaint); or\n\n(c) a notification under paragraph 154ZK(3)(c) (actions have\nbeen completed); or\n\n(d) a notification under subsection 154ZK(5) (Commission not\nrequired to take further action); or\n\n(e) a notice under paragraph 154ZL(2)(a) (replacement notice\nwith further action to deal with complaint); or\n\n(f) a notice under paragraph 154ZL(3)(a) (replacement notice\nwhere other inquiry or action, or appropriate to take no\nfurther action); or\n\nChapter 8  Miscellaneous"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-154zn-norm",
