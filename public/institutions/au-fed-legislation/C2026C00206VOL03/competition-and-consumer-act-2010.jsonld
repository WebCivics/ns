    {
      "@id": "concept:competition-and-consumer-act-2010-sec-131d",
      "@type": "cml:Concept",
      "skos:prefLabel": "131D Effect of Part VIB on Chapter 5 of the Australian Consumer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-131d"
      },
      "cml:curationStatus": {
