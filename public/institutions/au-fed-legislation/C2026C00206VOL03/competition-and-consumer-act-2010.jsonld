      },
      "cml:premiseText": "Section 134D(1) is part of Division 5.",
      "cml:conclusionText": "The person must comply with the infringement notice provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-134d-ss-1-logic-cogai-4",
