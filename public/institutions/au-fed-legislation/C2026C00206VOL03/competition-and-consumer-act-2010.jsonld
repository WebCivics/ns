      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits bidding or failing to bid in an electricity spot market.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-153h",
      "@type": "cml:Concept",
      "skos:prefLabel": "153H Prohibited conduct—electricity spot market (aggravated case)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.436",
      "values:originalText": "A corporation contravenes this section if:\n\n(a) the corporation:\n\n(i) bids or offers to supply electricity in relation to an\nelectricity spot market; or\n\n(ii) fails to bid or offer to supply electricity in relation to an\nelectricity spot market; and\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nProhibited conduct  Division 2\n\nSection 153J\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) the corporation does so fraudulently, dishonestly or in bad\nfaith, for the purpose of distorting or manipulating prices in\nthat electricity spot market.",
      "skos:definition": "A corporation contravenes this section if:\n\n(a) the corporation:\n\n(i) bids or offers to supply electricity in relation to an\nelectricity spot market; or\n\n(ii) fails to bid or offer to supply electricity in relation to an\nelectricity spot market; and\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nProhibited conduct  Division 2\n\nSection 153J\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) the corporation does so fraudulently, dishonestly or in bad\nfaith, for the purpose of distorting or manipulating prices in\nthat electricity spot market.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153h-norm"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-153h-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f45d67c41bd97b17e9d4f249e02bfe950aec0eb0c0e1a91dfe0f332323bd3759",
      "skos:note": "Bidding or failing to bid on electricity spot market is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-153h",
      "@type": "cof:Section",
      "cof:title": "153H Prohibited conduct—electricity spot market (aggravated case)",
      "values:kind": "section",
      "cof:pageNumber": 436,
      "values:originalText": "A corporation contravenes this section if:\n\n(a) the corporation:\n\n(i) bids or offers to supply electricity in relation to an\nelectricity spot market; or\n\n(ii) fails to bid or offer to supply electricity in relation to an\nelectricity spot market; and\n\nFurther provisions relating to particular industries etc.  Chapter 7\nThe Electricity Industry  Part XICA\nProhibited conduct  Division 2\n\nSection 153J\n\nCompetition and Consumer Act 2010\n\nCompilation date: 27/05/2026\n\n(b) the corporation does so fraudulently, dishonestly or in bad\nfaith, for the purpose of distorting or manipulating prices in\nthat electricity spot market."
    },
