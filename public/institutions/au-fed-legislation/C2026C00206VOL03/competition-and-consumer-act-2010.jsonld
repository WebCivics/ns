    {
      "@id": "concept:competition-and-consumer-act-2010-sec-155b-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "155B(3A) Australian Competition and Consumer Commission may",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-155b-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
