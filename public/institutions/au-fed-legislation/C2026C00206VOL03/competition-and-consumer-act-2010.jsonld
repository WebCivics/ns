      "cml:conclusionText": "Diffusion of embargo notices"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-135u-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "CogAI",
      "cml:logicSummary": "CogAI application for embargo notices",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
