    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-138d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "138D(2) Transfer of matters by a State or Territory court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-138d-ss-2"
