    {
      "@id": "concept:competition-and-consumer-act-2010-sec-188",
      "@type": "cml:Concept",
      "skos:prefLabel": "188 Notifications may be made on or after 1 July 2025",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-188"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
