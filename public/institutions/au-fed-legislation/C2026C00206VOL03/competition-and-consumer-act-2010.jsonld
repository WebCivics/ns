    {
      "@id": "concept:competition-and-consumer-act-2010-sec-139",
      "@type": "cml:Concept",
      "skos:prefLabel": "139 Intervention by the Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-139"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.191",
      "values:originalText": "(1) The Commission may, with the leave of a court and subject to any\nconditions imposed by the court, intervene in any proceeding\ninstituted under this Part or the Australian Consumer Law.\n\n(2) If the Commission intervenes in a proceeding, the Commission is\ntaken to be a party to the proceeding and has all the rights, duties\nand liabilities of such a party.",
      "skos:definition": "(1) The Commission may, with the leave of a court and subject to any\nconditions imposed by the court, intervene in any proceeding\ninstituted under this Part or the Australian Consumer Law.\n\n(2) If the Commission intervenes in a proceeding, the Commission is\ntaken to be a party to the proceeding and has all the rights, duties\nand liabilities of such a party.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-139-ss-2"
        }
      ],
      "cml:integrityHash": "b197018f7cbd94d3c2ecf1f4c09897d7e18bf4a16257bc1f00a6c8cfad0d9383"
    },
