          "@id": "concept:competition-and-consumer-act-2010-sec-154zu-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zu-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-154zu-ss-4"
        }
      ],
      "cml:integrityHash": "68cd92a078afaaf8f8b46aab5d40453c69cee8d798b5394ac76fe9a9954c5662"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-154zu",
