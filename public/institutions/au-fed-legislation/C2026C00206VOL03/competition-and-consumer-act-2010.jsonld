    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-149-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(4) 40  Notification of happening of affecting events prior to final",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-10-149-ss-4"
