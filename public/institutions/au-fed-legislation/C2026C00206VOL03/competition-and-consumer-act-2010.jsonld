      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.236",
      "values:originalText": "If the Commission receives an application for an exemption order,\nthe Commission must either:\n\n(a) make the order; or\n\n(b) refuse to make the order.",
      "skos:definition": "If the Commission receives an application for an exemption order,\nthe Commission must either:\n\n(a) make the order; or\n\n(b) refuse to make the order.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-151ba-norm"
        },
