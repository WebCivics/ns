    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-113-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Deviation from Australian law is allowed with agreement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Parties and Minister may agree in writing to deviate.",
      "cml:conclusionText": "Deviation from Australian law is permitted."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sec-10-113-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State must ensure agreement is made.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Minister must be informed of agreement.",
      "cml:conclusionText": "State ensures agreement is made."
    },
