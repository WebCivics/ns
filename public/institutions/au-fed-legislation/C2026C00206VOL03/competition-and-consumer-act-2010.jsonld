    {
      "@id": "concept:competition-and-consumer-act-2010-sec-133",
      "@type": "cml:Concept",
      "skos:prefLabel": "133 Appointment of inspectors",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-133"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "competition-and-consumer-act-2010.pdf, p.136",
      "values:originalText": "(1) The Chairperson may, in writing, appoint a member of the staff\nassisting the Commission as an inspector.\n\n(2) The Chairperson must not appoint a person as an inspector unless\nthe Chairperson is satisfied that the person has suitable\nqualifications and experience to exercise properly the powers of an\ninspector.\n\n(3) An inspector must, in exercising powers as an inspector, comply\nwith any directions of the Chairperson.\n\n(4) If a direction under subsection (3) is given in writing, the direction\nis not a legislative instrument.",
      "skos:definition": "(1) The Chairperson may, in writing, appoint a member of the staff\nassisting the Commission as an inspector.\n\n(2) The Chairperson must not appoint a person as an inspector unless\nthe Chairperson is satisfied that the person has suitable\nqualifications and experience to exercise properly the powers of an\ninspector.\n\n(3) An inspector must, in exercising powers as an inspector, comply\nwith any directions of the Chairperson.\n\n(4) If a direction under subsection (3) is given in writing, the direction\nis not a legislative instrument.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-133-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-133-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-133-ss-3"
        },
        {
          "@id": "concept:competition-and-consumer-act-2010-sec-133-ss-4"
        }
      ],
      "cml:integrityHash": "bb2c1b0b83bcc72b74d2e9d790b21122b9957504373df6d40130273f17814915"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-act-2010#sec-133",
      "@type": "cof:Section",
      "cof:title": "133 Appointment of inspectors",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "(1) The Chairperson may, in writing, appoint a member of the staff\nassisting the Commission as an inspector.\n\n(2) The Chairperson must not appoint a person as an inspector unless\nthe Chairperson is satisfied that the person has suitable\nqualifications and experience to exercise properly the powers of an\ninspector.\n\n(3) An inspector must, in exercising powers as an inspector, comply\nwith any directions of the Chairperson.\n\n(4) If a direction under subsection (3) is given in writing, the direction\nis not a legislative instrument."
    },
