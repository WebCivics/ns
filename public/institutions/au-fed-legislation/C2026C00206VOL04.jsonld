    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The price at which goods or services can be purchased is within this interval",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval of reasonable purchasing time",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "There is a temporal interval during which the buyer could have reasonably purchased"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The buyer must pay the lowest price offered by an alternative supplier",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Price determination based on alternative suppliers",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If there are alternative suppliers, the price is determined by their lowest prices"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The buyer must pay the correct amount",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to pay the correct amount",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The supplier must provide the correct price"
