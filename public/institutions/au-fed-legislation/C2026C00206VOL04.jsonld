      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Giving effect to a cartel provision is an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
