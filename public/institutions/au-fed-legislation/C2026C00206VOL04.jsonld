    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-4-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Identifies representations with respect to future matters as overlapping with the provision's scope.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) If: a person makes a representation with respect to any future matter (including the doing of, or the refusing to do, any act); and the person does not have reasonable grounds for making the representation; the representation is taken, for the purposes of this Schedule, to be misleading."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-4-ss-1-logic-cogai-5",
