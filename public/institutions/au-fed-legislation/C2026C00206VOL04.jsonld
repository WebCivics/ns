    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-40-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is no right to payment without reasonable cause.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of asserting a right to payment without reasonable cause.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "A person must not assert a right to payment from another person for unsolicited services unless the person has reasonable cause to believe that there is a right to the payment."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-40-ss-2-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is reasonable cause to believe in the existence of a right to payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "The person must have reasonable cause to believe in the existence of a right to payment.",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Belief",
      "cml:premiseText": "A person must not assert a right to payment from another person for unsolicited services unless the person has reasonable cause to believe that there is a right to the payment."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-40-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is no right to payment without reasonable cause in recurring traces.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The prohibition applies to recurring traces of asserting a right to payment without reasonable cause.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "A person must not assert a right to payment from another person for unsolicited services unless the person has reasonable cause to believe that there is a right to the payment."
    },
