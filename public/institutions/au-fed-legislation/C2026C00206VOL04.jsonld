      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(1) A person commits an offence if:  (a) a contract, arrangement or understanding contains a cartel provision; and  (b) the person gives effect to the cartel provision."
