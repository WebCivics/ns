    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-67-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Proper law of a contract is not the same as the law provided by the contract term.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The contract term provides for a different law than the proper law.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Contract term provides for foreign law."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-67-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This Division applies.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the proper law of a contract would be foreign, then this Division applies.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Proper law of a contract is foreign."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-67-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This Division applies despite that term.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the proper law of a contract would be foreign, then this Division applies.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Term substitutes provisions of foreign law."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-67-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Provisions of this Division repeat despite that term.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The provisions of this Division apply despite a term substituting foreign law.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "Provisions of this Division apply."
    },
