      "cml:logicSummary": "Defence overlap with liability period",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The defence applies to a period before the goods were supplied by their actual manufacturer."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-142-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defence implies a discharge of liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Defence implication for liability discharge",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If the defence is established, the liability is discharged."
    },
    {
