    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-22-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court must consider these factors when making a determination.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The court must consider the relative strengths of the bargaining positions of the supplier and the customer during the supply or possible supply of goods or services.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Section 22 lists factors that the court may have regard to, including the relative strengths of the bargaining positions of the supplier and the customer."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-22-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court must consider these factors when making a determination.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The court has an obligation to consider the factors listed in section 22 when determining whether a person has contravened section 21.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "Section 22 lists various factors that the court may have regard to."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-22-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The supplier must comply with these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The supplier must comply with certain conditions when supplying goods or services.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "Section 22 lists factors that the court may have regard to, including whether the customer was required to comply with conditions that were not reasonably necessary for the protection of the legitimate interests of the supplier."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-22-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "These factors are relevant to determining whether a person has contravened section 21.",
      "cml:confidence": {
