    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-273-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An affected person may commence an action for damages under this Division at any time within 3 years after the day on which the affected person first became aware, or ought reasonably to have become aware, that the guarantee to which the action relates has not been complied with.",
