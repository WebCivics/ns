      "cml:logicSummary": "Prohibits advertising goods or services at a specified price without reasonable grounds.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person, in trade or commerce, advertises goods or services for supply at a specified price; and"
    },
    {
