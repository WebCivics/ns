    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.115",
      "skos:note": "Asserting a right to payment from another person",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "10(1) Asserting a right to payment"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-2",
        "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-3",
        "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-4",
        "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "3bfecb9b4ebe7a1045ae3388f12f376f09de20c65cd6c33d4cc2c87397ff7dbf",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-10-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sch-2-sec-10"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is taken to assert a right to payment from another person",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Asserting an obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(a) makes a demand for the payment or asserts a present or prospective right to the payment;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is taken to assert a right to payment from another person",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Asserting an obligation through threats",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(b) threatens to bring any legal proceedings with a view to obtaining the payment;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is taken to assert a right to payment from another person",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Asserting an obligation through listing",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(c) places or causes to be placed the name of the other person on a list of defaulters or debtors, or threatens to do so, with a view to obtaining the payment;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is taken to assert a right to payment from another person",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Asserting an obligation through collection procedures",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(d) invokes or causes to be invoked any other collection procedure, or threatens to do so, with a view to obtaining the payment;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-10-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is taken to assert a right to payment from another person",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Asserting an obligation through documents",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(e) sends any invoice or other document that: (i) states the amount of the payment; or (ii) sets out the price of unsolicited goods or unsolicited services; or (iii) sets out the charge for placing, in a publication, an entry or advertisement;"
    },
