      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...if the agreement was negotiated by telephone—the period starting on the day on which the agreement was made and ending at the end of the tenth business day after the day on which the consumer was given the agreement document relating to the agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
