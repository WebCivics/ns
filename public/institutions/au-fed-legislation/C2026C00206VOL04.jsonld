        "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-deontic-3",
        "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-epistemic-4",
        "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-ltl-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "f1ad43217a7ccc4aa874905764025db99da377d05c769a93d019dff72476f12f",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-232-ss-4",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sch-2-sec-232"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only grant an injunction if the person intends to engage again or continues to engage in such conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Restricts court power to grant injunction based on intent and previous conduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Restriction",
      "cml:premiseText": "(a) whether or not it appears to the court that the person intends to engage again, or to continue to engage, in conduct of a kind referred to in that subsection;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only grant an injunction if the person has previously engaged in such conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Restricts court power to grant injunction based on previous conduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Restriction",
      "cml:premiseText": "(b) whether or not the person has previously engaged in conduct of that kind;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only grant an injunction if there is an imminent danger of substantial damage.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Restricts court power to grant injunction based on imminent danger",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Restriction",
      "cml:premiseText": "(c) whether or not there is an imminent danger of substantial damage to any other person if the person engages in conduct of that kind."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-epistemic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only grant an injunction if it is possible that such damage will occur.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Court power to grant injunction depends on possibility of imminent danger",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Possibility",
      "cml:premiseText": "(c) whether or not there is an imminent danger of substantial damage to any other person if the person engages in conduct of that kind."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only grant an injunction until such time as it becomes possible that such damage will occur.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Court power to grant injunction until imminent danger occurs",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(c) whether or not there is an imminent danger of substantial damage to any other person if the person engages in conduct of that kind."
    },
