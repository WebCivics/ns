      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-189-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the supplier may dispute the termination charge.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The excerpt permits the supplier to dispute the termination charge.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "permission",
      "cml:premiseText": "(3) A supplier of goods who is a party to a lay-by agreement commits an offence if:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-189-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the consumer has a right to claim the termination charge.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The excerpt creates a right for the consumer to claim termination charge.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "right",
      "cml:premiseText": "(3) A supplier of goods who is a party to a lay-by agreement commits an offence if:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-189-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the supplier undertakes to pay the termination charge.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The excerpt requires the supplier to undertake to pay the termination charge.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "undertaking",
      "cml:premiseText": "(3) A supplier of goods who is a party to a lay-by agreement commits an offence if:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-189-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the supplier must provide evidence of their costs.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The excerpt requires a trace of the supplier's costs.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "trace",
      "cml:premiseText": "(3) A supplier of goods who is a party to a lay-by agreement commits an offence if:"
    },
