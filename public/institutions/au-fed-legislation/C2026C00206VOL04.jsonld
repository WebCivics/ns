        "concept:competition-and-consumer-act-2010-sch-2-sec-260-logic-ltl-3",
        "concept:competition-and-consumer-act-2010-sch-2-sec-260-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "36f9572347ee05e95da457a2eb242e081c9d531e5e534d09ffceda4a0455cfd4",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-260",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-260-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an interval within a reasonable time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The goods cannot be remedied within a reasonable time.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "within-a-reasonable-time",
      "cml:premiseText": "The goods depart in one or more significant respects: (c) the goods are substantially unfit for a purpose for which goods of the same kind are commonly supplied and they cannot, easily and within a reasonable time, be remedied to make them fit for such a purpose;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-260-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to comply.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Failure to comply implies obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The goods would not have been acquired by a reasonable consumer fully acquainted with the nature and extent of the failure."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-260-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to comply.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Failure to comply implies obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(a) the goods would not have been acquired by a reasonable consumer fully acquainted with the nature and extent of the failure;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-260-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an ordered trace.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The goods depart in one or more significant respects.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "ordered-trace",
      "cml:premiseText": "(b) the goods depart in one or more significant respects: (i) if they were supplied by description—from that description; or (ii) if they were supplied by reference to a sample or demonstration model—from that sample or demonstration model;"
    },
