    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-158-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(3) A person commits an offence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of accepting payment for goods or services with intention to supply different goods/services",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(3) A person commits an offence if:  (a) the person, in trade or commerce, accepts payment or other consideration for goods or services; and  (b) at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted."
    },
