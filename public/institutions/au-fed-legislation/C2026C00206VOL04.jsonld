      "cml:logicSummary": "Recognizes the need for 'reasonable grounds' in advertising.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognize",
      "cml:premiseText": "(a) the person, in trade or commerce, advertises goods or services for supply at a specified price; and"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-157-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "there is an offence if (b) there are reasonable grounds for believing that the person will not be able to offer for supply those goods or services at that price for a period that is, and in quantities that are, reasonable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
