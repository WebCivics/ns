    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-167-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.271",
      "skos:note": "Inducing consumers to provide customer information in exchange for benefits is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "167(1) Referral selling"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-167-ss-1-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-167-ss-1-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sch-2-sec-167-ss-1-logic-deontic-2"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "dee6baab1c1f0ad725b54c2af2fa8a999eb430df809ebfbfa7cbaf1d0a35d4a2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-167-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sch-2-sec-167"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-167-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they induce a consumer to provide customer information in exchange for benefits.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits the action of inducing consumers to provide customer information in exchange for benefits.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The person induces a consumer to acquire goods or services by representing that the consumer will receive a rebate, commission or other benefit in return for giving the person the names of prospective customers or otherwise assisting the person to supply goods or services to other consumers."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-167-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision is a prohibition on inducing consumers to provide customer information in exchange for benefits.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits the action of inducing consumers to provide customer information in exchange for benefits.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The provision states that a person commits an offence if they induce a consumer to acquire goods or services by representing that the consumer will receive a rebate, commission or other benefit in return for giving the person the names of prospective customers or otherwise assisting the person to supply goods or services to other consumers."
    },
