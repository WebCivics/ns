    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-140-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.241",
      "skos:note": "Manufacturer liable for loss or damage caused by safety defect in goods supplied in trade or commerce.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "140(1) Liability for loss or damage suffered by a person if other goods"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
