    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-179-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...if the agreement was not negotiated by telephone—the period starting on the day on which the agreement was made and ending at the end of the tenth business day after the day on which the agreement was made;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
