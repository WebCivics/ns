      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The court must consider all relevant factors listed in section 22 when determining whether a person has contravened section 21.",
