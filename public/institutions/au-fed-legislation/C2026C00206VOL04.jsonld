    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-227",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.328",
      "skos:note": "Court must give preference to making an order for compensation if defendant cannot pay both penalty and compensation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "227 Preference must be given to compensation for victims"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-227-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-alleninterval-2",
        "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-argumentation-3",
        "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-diffusion-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
