    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-9-ss-4",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.114",
      "skos:note": "Goods have a safety defect if there is an inference based on non-compliance with the safest possible standard.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "9(4) Meaning of safety defect in relation to goods"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-9-ss-4-norm",
