      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The buyer can use this information to make a decision",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
