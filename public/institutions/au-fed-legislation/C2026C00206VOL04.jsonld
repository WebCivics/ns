      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-64a-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Fairness of reliance on a contract term is determined.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider certain circumstances.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Court is to have regard to all the circumstances of the case."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-64a-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Fairness of reliance on a contract term is determined based on these circumstances.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider all circumstances when determining fairness.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "A court is to have regard to all the circumstances of the case;"
