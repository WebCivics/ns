      "@type": "cml:Concept",
      "dc:description": "minimum amount of a charge in relation to sending the goods from the supplier to the other person",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.156",
      "skos:note": "Specify minimum charge for sending goods",
