      "cml:logicSummary": "Class hierarchy",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "a reference to a contract includes a reference to a lease of, or a licence in respect of, land or a building or part of a building"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-12-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "a reference to a party to a contract, in relation to such a lease or licence, is a reference to any person bound by, or entitled to the benefit of, any provision contained in the lease or licence",
