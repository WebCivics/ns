      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Previous course of dealing is relevant to determining fairness.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Circumstances include previous course of dealing between parties.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "Having regard, among other things, to any custom of the trade and any previous course of dealing between the parties;"
    },
