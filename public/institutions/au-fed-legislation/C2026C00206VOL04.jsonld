      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an overlap between the representation and the supply of goods or services",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
