      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Requires overlap between supply and acquisition situations.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(a) a supply situation—in this situation, a person (the first person) has been accustomed, or is under an obligation, to supply goods or services to another person (the second person); or (b) an acquisition situation—in this situation, a person (the first person) has been accustomed, or is under an obligation, to acquire goods or services from another person (the second person)."
    },
