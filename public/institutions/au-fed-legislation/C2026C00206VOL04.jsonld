      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.34",
      "skos:note": "Exempts cartel provisions in joint ventures from certain sections of the Competition and Consumer Act 2010.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "45AO(1) Joint ventures—prosecution"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-norm",
