    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-260",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.355",
      "skos:note": "Failure to comply with a guarantee is a major failure if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "260 When a failure to comply with a guarantee is a major failure"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-260-norm",
