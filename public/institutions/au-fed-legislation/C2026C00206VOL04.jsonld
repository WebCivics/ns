      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Manufacturer has an obligation to compensate a person for loss or damage caused by safety defect.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A manufacturer of goods is liable to compensate a person if..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-140-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (e) the person suffers loss or damage as a result of the destruction or damage.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The destruction or damage of goods occurs until the time the person suffers loss or damage.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(c) other goods of a kind ordinarily acquired for personal, domestic or household use or consumption are destroyed or damaged because of the safety defect;"
    },
