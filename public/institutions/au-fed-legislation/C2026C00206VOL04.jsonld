    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.330",
      "skos:note": "Court power to grant injunction without intent or previous conduct",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "232(4) Injunctions"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-logic-deontic-1",
