      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(d) a person (the first person) who causes or permits another person, in connection with: ... to hold out the first person to the public as the manufacturer of the goods;"
    },
    {
