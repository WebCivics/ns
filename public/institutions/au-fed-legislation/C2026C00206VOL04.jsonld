    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.107",
      "skos:note": "The amount paid or payable for goods or services is determined by the lowest price that could have been reasonably purchased from another supplier.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3(5) Meaning of consumer"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
