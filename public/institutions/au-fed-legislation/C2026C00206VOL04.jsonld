      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The supplier must ensure that the gift card ceases to be redeemable within 3 years after supply.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
