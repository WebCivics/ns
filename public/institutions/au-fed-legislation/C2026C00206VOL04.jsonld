    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-142-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the defence overlaps with the liability period, the liability is discharged.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
