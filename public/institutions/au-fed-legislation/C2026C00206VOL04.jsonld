        "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-descriptionlogic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9102ee50f1d0aacfb69c6ee353ef22e9a2aad1df2b9789a784f051330cace6be",
      "cml:proposedBy": {
