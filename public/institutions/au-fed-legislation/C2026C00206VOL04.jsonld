      "cml:logicSummary": "Requires that the day the gift card ceases to be redeemable is within 3 years after the day of supply.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "(b) the day the gift card ceases to be redeemable is earlier than 3 years after the day of that supply."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-191a-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implies that supplying a gift card to a consumer before it ceases to be redeemable within 3 years is an offence.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(a) the person, in trade or commerce, supplies a gift card to a consumer;"
    },
