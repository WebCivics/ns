        "@language": "en",
        "@value": "4(1) Misleading representations with respect to future matters"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-4-ss-1-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-4-ss-1-logic-deontic-1",
