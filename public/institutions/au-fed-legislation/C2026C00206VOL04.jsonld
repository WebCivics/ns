    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.309",
      "skos:note": "Court permission required for reliance on information from another person.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "207(3) Reasonable mistake of fact"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-deontic-2",
        "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-epistemic-3",
        "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-ltl-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "7cda3177db6b6bf60d9faa3c9d7938dfde86f07ec2e0f2121f3c09621eaa9330",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-207-ss-3",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sch-2-sec-207"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Defendant is not entitled to rely on the defence unless court gives leave.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court permission is required.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:premiseText": "Defendant must obtain court leave to rely on information from another person."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Defendant is not entitled to rely on the defence unless they have served notice on the person who instituted the proceeding.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court permission is required for reliance on information from another person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:premiseText": "Defendant must serve notice on the person who instituted the proceeding within 7 days before the hearing commences."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Defendant is not entitled to rely on the defence unless they have served notice on the person who instituted the proceeding.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Defendant must believe that they had information that would identify or assist in identifying the other person.",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Belief",
      "cml:premiseText": "Defendant has not provided sufficient evidence to rely on the defence unless they have served notice on the person who instituted the proceeding."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-207-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Defendant is not entitled to rely on the defence unless they have served notice on the person who instituted the proceeding within 7 days before the hearing commences.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The interval between serving notice and the hearing commences must be considered.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Interval",
      "cml:premiseText": "Defendant has not provided sufficient evidence to rely on the defence unless they have served notice on the person who instituted the proceeding within 7 days before the hearing commences."
    },
