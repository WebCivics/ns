    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45aa",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.21",
      "skos:note": "Making or giving effect to a contract with a cartel provision is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "45AA Simplified outline"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-norm",
        "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-alleninterval-2",
        "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-ltl-3",
        "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-cogai-4",
        "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-shacl-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "6358dbd2deea5cad1907104a1bee39739d6d75fcaa78a9fcad0f1e5260ad9f87",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-1-sec-45aa",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition on making or giving effect to a contract with a cartel provision applies at all times.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for cartel provisions.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "A person must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition on making or giving effect to a contract with a cartel provision applies to all persons who make or give effect to such contracts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognizes entities involved in cartel provisions.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Entity Recognition",
      "cml:premiseText": "A person must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Making or giving effect to a contract with a cartel provision is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits making or giving effect to a contract with a cartel provision.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "A person must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition on making or giving effect to a contract with a cartel provision applies in all cases where a person makes or gives effect to such a contract.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines a recurring trace for cartel provisions.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "A person must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45aa-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition on making or giving effect to a contract with a cartel provision is validated by the schema for cartel provisions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:logicSummary": "Validates schema for cartel provisions.",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Schema Validation",
      "cml:premiseText": "A person must not make, or give effect to, a contract, arrangement or understanding that contains a cartel provision."
    },
