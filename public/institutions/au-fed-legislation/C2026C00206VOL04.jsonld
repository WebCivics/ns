    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-38-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(4) Subsection (1) does not apply to a publication of matter in connection with the sale or grant, or possible sale or grant, of, or the promotion by any means of the sale or grant of, interests in land (the publicised interests in land), if:"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-38-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to exempt",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) the publicised interests in land were interests of a kind sold or granted by the information provider or, if the information provider is a body corporate, by a body corporate that is related to the information provider;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-38-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to exempt",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(b) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a person who sells or grants interests of the same kind as the publicised interests in land;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-38-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to exempt",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(c) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a body corporate that is related to a body corporate that sells or grants interests of the same kind as the publicised interests in land."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-38-ss-4-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
