      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits unfair terms in consumer contracts and small business contracts.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(1) A term of a consumer contract or small business contract is void if:  (a) the term is unfair; and  (b) the contract is a standard form contract."
    },
