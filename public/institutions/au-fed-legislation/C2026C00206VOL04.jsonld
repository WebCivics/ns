      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-12-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "a reference to making or entering into a contract, in relation to such a lease or licence, is a reference to granting or taking the lease or licence",
      "cml:confidence": {
        "@type": "xsd:decimal",
