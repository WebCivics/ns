      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-157-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.255",
      "skos:note": "Advertising goods or services at a specified price without reasonable grounds for believing it can be fulfilled.",
