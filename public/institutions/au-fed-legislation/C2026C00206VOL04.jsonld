        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits notification",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the rejection period for the goods has ended; or (b) the goods have been lost, destroyed or disposed of by the consumer; or (c) the goods were damaged after being delivered to the consumer for reasons not related to their state or condition at the time of supply; or (d) the goods have been attached to, or incorporated in, any real or personal property and they cannot be detached or isolated without damaging them."
    },
