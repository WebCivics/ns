    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-48-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must specify the minimum amount",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Specify minimum charge",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "The person knows, at the time of the representation, the minimum amount of a charge in relation to sending the goods from the supplier to the other person that must be paid by the other person"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-48-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must not make the representation referred to in subsection (1) unless the person also specifies that minimum amount",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Do not make representation without specifying minimum charge",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must Not",
      "cml:premiseText": "(a) The person does not include in the single price a charge that is payable in relation to sending the goods from the supplier to the other person; and (b) The person knows, at the time of the representation, the minimum amount of a charge in relation to sending the goods from the supplier to the other person that must be paid by the other person"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-48-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must specify the minimum amount",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Specify minimum amount of charge",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must Provide",
      "cml:premiseText": "(3) However, if: (a) The person does not include in the single price a charge that is payable in relation to sending the goods from the supplier to the other person; and (b) The person knows, at the time of the representation, the minimum amount of a charge in relation to sending the goods from the supplier to the other person that must be paid by the other person;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-48-ss-3-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person knows the minimum amount",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Person knows minimum charge",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Knows",
      "cml:premiseText": "(b) The person knows, at the time of the representation, the minimum amount of a charge in relation to sending the goods from the supplier to the other person that must be paid by the other person"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-48-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The minimum charge is recurring",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Minimum charge for sending goods is recurring",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(b) The person knows, at the time of the representation, the minimum amount of a charge in relation to sending the goods from the supplier to the other person that must be paid by the other person"
    },
