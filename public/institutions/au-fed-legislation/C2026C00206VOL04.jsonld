        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "(1) A dealer commits an offence if the dealer calls on a person for the purpose of negotiating an unsolicited consumer agreement, or for an incidental or related purpose:"
    },
