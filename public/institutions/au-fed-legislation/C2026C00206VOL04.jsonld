      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-227",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The court must give preference to making an order for compensation between the time the defendant is ordered to pay the penalty and the time the defendant is able to pay the compensation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court must give preference to making an order for compensation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If the defendant does not have sufficient financial resources, then the court must give preference to making an order for compensation.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IF-THEN",
      "cml:premiseText": "The defendant does not have sufficient financial resources."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must give preference to making an order for compensation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The obligation to give preference to making an order for compensation spreads to all courts that have jurisdiction over the defendant.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "SPREADS-TO"
    },
