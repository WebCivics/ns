      "cml:logicSummary": "Defines temporal interval for prohibition",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(1) The supplier under an unsolicited consumer agreement commits an offence..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-179-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...if the person is a body corporate—$50,000; or (b) if the person is not a body corporate—$10,000.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits supplier from supplying goods or services under unsolicited consumer agreement",
