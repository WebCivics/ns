    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the activity mentioned in paragraph (b) jointly by means of:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Establishes a temporal relationship between the joint venture and its purpose.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(b) the joint venture is for any one or more of..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the joint venture is for any one or more of the following:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permits cartel provisions in joint ventures under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(1) Sections 45AF and 45AG do not apply..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the purpose of substantially lessening competition;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation on parties to a contract or arrangement to comply with certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(c) the joint venture is not carried on for..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the supply of goods or services;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies joint ventures into different types based on their purpose.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "(i) production of goods;"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the body corporate for the purpose of enabling those parties to carry on...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies the type of joint venture based on its ownership structure.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "(e) in a case where subparagraph 4J(a)(ii) applies to..."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-1-sec-45ao-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...their ownership of shares in the capital;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Establishes a recurring trace between the joint venture and its purpose.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:premiseText": "(ii) their joint control;"
    },
