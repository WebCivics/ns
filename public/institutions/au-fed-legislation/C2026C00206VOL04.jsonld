      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(b) there are reasonable grounds for believing that the person will not be able to offer for supply those goods or services at that price for a period that is, and in quantities that are, reasonable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
