    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-act-2010.pdf, p.367",
      "skos:note": "Manufacturer must indemnify supplier if liable to pay damages under section 259(4) or section 271.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "274(1) Indemnification of suppliers by manufacturers"
      },
      "wasDerivedFrom": "competition-and-consumer-act-2010.pdf",
      "asserts": [
        "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-norm",
        "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-deontic-1",
        "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-alleninterval-2",
        "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-ltl-3",
        "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-diffusion-4",
        "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d5819f158723fc7446072b2b30a4ed60fbe89c4f8f8d1dab0cf40ba8d7835cbf",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-act-2010#sch-2-sec-274-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-act-2010-sch-2-sec-274"
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Temporal interval of liability overlaps with temporal interval of payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval of liability overlaps with temporal interval of payment.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) A manufacturer of goods is liable to indemnify a person (the supplier) who supplies the goods to a consumer if:  (a) the supplier is liable to pay damages under section 259(4) to the consumer for loss or damage suffered by the consumer; and  (b) the manufacturer is or would be liable under section 271 to pay damages to the consumer for the same loss or damage."
    },
    {
      "@id": "concept:competition-and-consumer-act-2010-sch-2-sec-274-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Legislative excerpt recognizes concept of indemnification.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Legislative excerpt recognizes concept of indemnification.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "(1) A manufacturer of goods is liable to indemnify a person (the supplier) who supplies the goods to a consumer if:  (a) the supplier is liable to pay damages under section 259(4) to the consumer for loss or damage suffered by the consumer; and  (b) the manufacturer is or would be liable under section 271 to pay damages to the consumer for the same loss or damage."
    },
