doc:sch-2-sec-205-ss-1 a cof:Section ;
    cof:title "205(1) Compliance with substantiation notices" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if the person:  (a) is given a substantiation notice; and  (b) refuses or fails to comply with it within the substantiation notice compliance period for the notice. Penalty:  (a) if the person is a body corporate—$16,500; or  (b) if the person is not a body corporate—$3,300." ;
    cof:pageNumber "307"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-205-ss-2 a cml:Concept ;
    skos:prefLabel "205(2) Compliance with substantiation notices"@en ;
    cml:realizedBy doc:sch-2-sec-205-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply if:  (a) the person is an individual; and  (b) the person refuses or fails to give particular information or produce a particular document in compliance with a substantiation notice; and  (c) the information, or production of the document, might tend to incriminate the individual or to expose the individual to a penalty." ;
    skos:definition "(2) Subsection (1) does not apply if:  (a) the person is an individual; and  (b) the person refuses or fails to give particular information or produce a particular document in compliance with a substantiation notice; and  (c) the information, or production of the document, might tend to incriminate the individual or to expose the individual to a penalty."@en ;
    cml:integrityHash "4be864f21e86cc38074f4d35de65899f672930c26427618119ed032111e34025" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-205 ;
