doc:sch-1-sec-45dc a cof:Section ;
    cof:title "45DC Involvement and liability of employee organisations" ;
    values:kind "section" ;
    values:originalText "Certain organisations taken to be acting in concert  (1) If 2 or more persons (the participants), each of whom is a member or officer of the same organisation of employees, engage in conduct in concert with one another, whether or not the conduct is also engaged in in concert with another person, then, unless the organisation proves otherwise, the organisation is taken for the purposes of sections 45D and 45DA:  Schedule 1  The Schedule version of Part IV" ;
    cof:pageNumber "49"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-1-sec-45dd a cml:Concept ;
    skos:prefLabel "45DD Situations in which boycotts permitted"@en ;
    cml:realizedBy doc:sch-1-sec-45dd ;
    values:originalText "Dominant purpose of conduct relates to employment matters— conduct by a person  (1) A person does not contravene, and is not involved in a contravention of, subsection 45D(1) or 45DA(1) by engaging in conduct if the dominant purpose for which the conduct is engaged  Schedule 1  The Schedule version of Part IV" ;
    skos:definition "Dominant purpose of conduct relates to employment matters— conduct by a person  (1) A person does not contravene, and is not involved in a contravention of, subsection 45D(1) or 45DA(1) by engaging in conduct if the dominant purpose for which the conduct is engaged  Schedule 1  The Schedule version of Part IV"@en ;
    cml:integrityHash "86b14955b892739e21d3d762fc887c0c10f670c20e6400de2cdc37b487cff83f" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "Boycotts permitted for dominant employment purpose" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.51" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-1-sec-45dd-norm .
