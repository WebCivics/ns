    cof:pageNumber "328"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-228 a cml:Concept ;
    skos:prefLabel "228 Civil action for recovery of pecuniary penalties"@en ;
    cml:realizedBy doc:sch-2-sec-228 ;
    values:originalText "(1) The regulator may institute a proceeding in a court for the recovery on behalf of the Commonwealth, a State or a Territory, as the case may be, of a pecuniary penalty referred to in section 224.  (2) A proceeding under subsection (1) may be commenced at any time within 6 years after the contravention or conduct." ;
    skos:definition "(1) The regulator may institute a proceeding in a court for the recovery on behalf of the Commonwealth, a State or a Territory, as the case may be, of a pecuniary penalty referred to in section 224.  (2) A proceeding under subsection (1) may be commenced at any time within 6 years after the contravention or conduct."@en ;
    cml:integrityHash "3b32fabab4b69864443a02eaab4336200e8471231a76d0deaa8144ed4ab73e2d" ;
    cof:pageNumber "329"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-228-ss-1 ;
