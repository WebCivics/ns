concept:competition-and-consumer-act-2010-sch-2-sec-71 a cml:Concept ;
    skos:prefLabel "71 Meaning of dealer"@en ;
    cml:realizedBy doc:sch-2-sec-71 ;
    values:originalText "A dealer is a person who, in trade or commerce:  (a) enters into negotiations with a consumer with a view to making an agreement for the supply of goods or services to the consumer; or  (b) calls on, or telephones, a consumer for the purpose of entering into such negotiations; whether or not that person is, or is to be, the supplier of the goods or services." ;
    skos:definition "A dealer is a person who, in trade or commerce:  (a) enters into negotiations with a consumer with a view to making an agreement for the supply of goods or services to the consumer; or  (b) calls on, or telephones, a consumer for the purpose of entering into such negotiations; whether or not that person is, or is to be, the supplier of the goods or services."@en ;
    cml:integrityHash "49ad72f9a852471a24378d74f4d2fafe92855fbec228ae6f8be99020f1d5cc9a" ;
    cof:pageNumber "176"^^xsd:integer ;
    skos:note "Defines what constitutes a dealer in trade or commerce." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
