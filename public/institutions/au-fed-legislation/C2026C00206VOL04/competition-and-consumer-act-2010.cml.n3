    cml:integrityHash "ca00763755ee26dfd2d05f702869508c1be78e4228577b4560e32fc48ab186ea" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-106 ;
    cof:pageNumber "204"^^xsd:integer ;
    skos:note "Defence for manufacture, possession or control of goods not for export" ;
