concept:competition-and-consumer-act-2010-sch-2-sec-49 a cml:Concept ;
    skos:prefLabel "49 Referral selling"@en ;
    cml:realizedBy doc:sch-2-sec-49 ;
    values:originalText "A person must not, in trade or commerce, induce a consumer to acquire goods or services by representing that the consumer will, after the contract for the acquisition of the goods or services is made, receive a rebate, commission or other benefit in return for:  (a) giving the person the names of prospective customers; or  (b) otherwise assisting the person to supply goods or services to other consumers; if receipt of the rebate, commission or other benefit is contingent on an event occurring after that contract is made. Note: A pecuniary penalty may be imposed for a contravention of this section." ;
    skos:definition "A person must not, in trade or commerce, induce a consumer to acquire goods or services by representing that the consumer will, after the contract for the acquisition of the goods or services is made, receive a rebate, commission or other benefit in return for:  (a) giving the person the names of prospective customers; or  (b) otherwise assisting the person to supply goods or services to other consumers; if receipt of the rebate, commission or other benefit is contingent on an event occurring after that contract is made. Note: A pecuniary penalty may be imposed for a contravention of this section."@en ;
    cml:integrityHash "b7a85cccadfbacf76d1411f4fec98cb9c333e88db1261e6830a682f91a115305" ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "No inducing consumers for benefits in return for assisting others" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.160" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-49-norm .
