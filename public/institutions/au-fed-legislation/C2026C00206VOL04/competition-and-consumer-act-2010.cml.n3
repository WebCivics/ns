doc:sch-2-sec-78-ss-1 a cof:Section ;
    cof:title "78(1) Requirement to give document to the consumer" ;
    values:kind "subsection" ;
    values:originalText "(1) If an unsolicited consumer agreement was not negotiated by telephone, the dealer who negotiated the agreement must give a copy of the agreement to the consumer under the agreement immediately after the consumer signs the agreement. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "179"^^xsd:integer .

