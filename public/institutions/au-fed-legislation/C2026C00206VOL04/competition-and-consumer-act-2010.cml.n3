concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-6 a cml:Concept ;
    skos:prefLabel "3(6) Meaning of consumer"@en ;
    cml:realizedBy doc:sch-2-sec-3-ss-6 ;
    values:originalText "(6) For the purposes of subsection (1) or (3), the amount paid or payable for goods or services acquired by a person other than by way of purchase is taken to be the price at which, at the time of the acquisition, the person could have purchased the goods or services from the supplier, unless subsection (7) or (8) applies." ;
    skos:definition "(6) For the purposes of subsection (1) or (3), the amount paid or payable for goods or services acquired by a person other than by way of purchase is taken to be the price at which, at the time of the acquisition, the person could have purchased the goods or services from the supplier, unless subsection (7) or (8) applies."@en ;
    cml:integrityHash "0cfda468db3f72e0fe78eb44a4c935704735e1a4cf4fa71f52f14388600c55d0" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-3 ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "The price of goods or services acquired by a person other than purchase is determined by the market price at the time of acquisition." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.107" ;
