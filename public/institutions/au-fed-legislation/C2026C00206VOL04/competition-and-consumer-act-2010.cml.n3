concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-12 a cml:Concept ;
    skos:prefLabel "3(12) Meaning of consumer"@en ;
    cml:realizedBy doc:sch-2-sec-3-ss-12 ;
    values:originalText "(12) In this Schedule, a reference to a supply of goods or services to a consumer is a reference to a supply of goods or services to a person who is taken to have acquired them as a consumer." ;
    skos:definition "(12) In this Schedule, a reference to a supply of goods or services to a consumer is a reference to a supply of goods or services to a person who is taken to have acquired them as a consumer."@en ;
    cml:integrityHash "9d70e23bedcf6d49d9050ffe916da0d5d760496dcc776bd9bc7eaccdfbafb255" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-3 ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Definition of consumer for the purpose of this Schedule." ;
    cml:curationStatus cml:Proposed ;
