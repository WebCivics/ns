concept:competition-and-consumer-act-2010-sch-2-sec-240-ss-2 a cml:Concept ;
    skos:prefLabel "240(2) Determining whether to make a redress order etc. for"@en ;
    cml:realizedBy doc:sch-2-sec-240-ss-2 ;
    values:originalText "(2) Any other order made under section 239(1) that relates to that loss or damage has no effect in relation to the non-party." ;
    skos:definition "(2) Any other order made under section 239(1) that relates to that loss or damage has no effect in relation to the non-party."@en ;
    cml:integrityHash "7c88e2265d45253def339d4a55d713651944f1d2e8fb796270b75b49eecd83cf" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-240 ;
    cof:pageNumber "336"^^xsd:integer ;
    skos:note "No effect on non-party in relation to other orders. Court may consider conduct of person and non-parties in relation to declared term when determining whether to make a redress order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
