concept:competition-and-consumer-act-2010-sch-2-sec-67 a cml:Concept ;
    skos:prefLabel "67 Conflict of laws"@en ;
    cml:realizedBy doc:sch-2-sec-67 ;
    values:originalText "If:  (a) the proper law of a contract for the supply of goods or services to a consumer would be the law of any part of Australia but for a term of the contract that provides otherwise; or  (b) a contract for the supply of goods or services to a consumer contains a term that purports to substitute, or has the effect of substituting, the following provisions for all or any of the provisions of this Division:  (i) the provisions of the law of a country other than Australia;  (ii) the provisions of the law of a State or a Territory; the provisions of this Division apply in relation to the supply under the contract despite that term." ;
    skos:definition "If:  (a) the proper law of a contract for the supply of goods or services to a consumer would be the law of any part of Australia but for a term of the contract that provides otherwise; or  (b) a contract for the supply of goods or services to a consumer contains a term that purports to substitute, or has the effect of substituting, the following provisions for all or any of the provisions of this Division:  (i) the provisions of the law of a country other than Australia;  (ii) the provisions of the law of a State or a Territory; the provisions of this Division apply in relation to the supply under the contract despite that term."@en ;
    cml:integrityHash "4da5eaf61ff75860cab01f1df453fc8cbd442e7ad7dd23dad94c1f5fd4ace392" ;
    cof:pageNumber "173"^^xsd:integer ;
    skos:note "Provisions of this Division apply despite a term substituting foreign law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
