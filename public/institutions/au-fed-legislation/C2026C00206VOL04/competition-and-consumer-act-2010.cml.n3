concept:competition-and-consumer-act-2010-sch-2-sec-124-ss-2 a cml:Concept ;
    skos:prefLabel "124(2) Obligations of a supplier in relation to a recall notice"@en ;
    cml:realizedBy doc:sch-2-sec-124-ss-2 ;
    values:originalText "(2) If the supplier undertakes to repair the consumer goods, the supplier must cause the goods to be repaired so that:  (a) any defect in the goods identified in the recall notice is remedied; and  (b) if a safety standard for the goods is in force—the goods comply with that standard." ;
    skos:definition "(2) If the supplier undertakes to repair the consumer goods, the supplier must cause the goods to be repaired so that:  (a) any defect in the goods identified in the recall notice is remedied; and  (b) if a safety standard for the goods is in force—the goods comply with that standard."@en ;
    cml:integrityHash "0594c366e4a7fff7099441f767a967dd92b53b7bbcf48ddb502bb7cd1708b268" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-124 ;
    cof:pageNumber "220"^^xsd:integer ;
    skos:note "Supplier must repair consumer goods to comply with safety standards and remedy defects." ;
    dc:description "Repair of defective goods" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.220" ;
