doc:sch-2-sec-198-ss-1 a cof:Section ;
    cof:title "198(1) Supplying etc. product related services covered by a ban" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if:  (a) the person, in trade or commerce, supplies product related services of a particular kind; and  (b) either:  (i) an interim ban on services of that kind is in force in the place where the supply occurs; or  (ii) a permanent ban on services of that kind is in force." ;
    cof:pageNumber "297"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-198-ss-2 a cml:Concept ;
    skos:prefLabel "198(2) Supplying etc. product related services covered by a ban"@en ;
    cml:realizedBy doc:sch-2-sec-198-ss-2 ;
    values:originalText "(2) A person commits an offence if:  (a) the person, in trade or commerce, offers for supply product related services of a particular kind; and  (b) the supply would be prohibited by subsection (1)." ;
    skos:definition "(2) A person commits an offence if:  (a) the person, in trade or commerce, offers for supply product related services of a particular kind; and  (b) the supply would be prohibited by subsection (1)."@en ;
