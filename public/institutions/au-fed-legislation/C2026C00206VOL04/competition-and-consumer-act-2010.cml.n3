concept:competition-and-consumer-act-2010-sch-2-sec-144 a cml:Concept ;
    skos:prefLabel "144 Liability joint and several"@en ;
    cml:realizedBy doc:sch-2-sec-144 ;
    values:originalText "If 2 or more persons are liable under Division 1 for the same loss or damage, they are jointly and severally liable." ;
