doc:sch-2-sec-102-ss-1 a cof:Section ;
    cof:title "102(1) Prescribed requirements for warranties against defects" ;
    values:kind "subsection" ;
    values:originalText "(1) The regulations may prescribe requirements relating to the form and content of warranties against defects." ;
    cof:pageNumber "201"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-102-ss-2 a cml:Concept ;
    skos:prefLabel "102(2) Prescribed requirements for warranties against defects"@en ;
    cml:realizedBy doc:sch-2-sec-102-ss-2 ;
    values:originalText "(2) A person must not, in connection with the supply, in trade or commerce, of goods or services to a consumer:  (a) give to the consumer a document that evidences a warranty against defects that does not comply with the requirements prescribed for the purposes of subsection (1); or  (b) represent directly to the consumer that the goods or services are goods or services to which such a warranty against defects relates. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(2) A person must not, in connection with the supply, in trade or commerce, of goods or services to a consumer:  (a) give to the consumer a document that evidences a warranty against defects that does not comply with the requirements prescribed for the purposes of subsection (1); or  (b) represent directly to the consumer that the goods or services are goods or services to which such a warranty against defects relates. Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
    cml:integrityHash "8d7163de230b78dda97585d170aa646ca403cb6868b3b35ae5326e507e78107a" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-102 ;
    cof:pageNumber "201"^^xsd:integer ;
    skos:note "Do not give a document evidencing a warranty against defects that does not comply with the requirements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
