concept:competition-and-consumer-act-2010-sch-2-sec-62 a cml:Concept ;
    skos:prefLabel "62 Guarantee as to reasonable time for supply"@en ;
    cml:realizedBy doc:sch-2-sec-62 ;
    values:originalText "If:  (a) a person (the supplier) supplies, in trade or commerce, services to a consumer; and  (b) the time within which the services are to be supplied:  (i) is not fixed by the contract for the supply of the services; or  (ii) is not to be determined in a manner agreed to by the consumer and supplier; there is a guarantee that the services will be supplied within a reasonable time." ;
    skos:definition "If:  (a) a person (the supplier) supplies, in trade or commerce, services to a consumer; and  (b) the time within which the services are to be supplied:  (i) is not fixed by the contract for the supply of the services; or  (ii) is not to be determined in a manner agreed to by the consumer and supplier; there is a guarantee that the services will be supplied within a reasonable time."@en ;
    cml:integrityHash "c58f9e7d4ac6176a1fcf0114b63474d4c6f0390c28db6988bdc86d25451700f5" ;
    cof:pageNumber "169"^^xsd:integer ;
    skos:note "Guarantee of reasonable time for supply" ;
    dc:description "Services to be supplied within a reasonable time" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.169" ;
