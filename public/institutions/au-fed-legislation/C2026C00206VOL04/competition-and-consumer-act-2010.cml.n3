doc:sch-2-sec-19-ss-1 a cof:Section ;
    cof:title "19(1) Application of this Part to information providers" ;
    values:kind "subsection" ;
    values:originalText "(1) This Part does not apply to a publication of matter by an information provider if:  (a) in any case—the information provider made the publication in the course of carrying on a business of providing information; or  (b) if the information provider is the Australian Broadcasting Corporation, the Special Broadcasting Service Corporation or the holder of a licence granted under the Broadcasting Services Act 1992—the publication was by way of a radio or television broadcast by the information provider." ;
    cof:pageNumber "120"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-19-ss-2 a cml:Concept ;
    skos:prefLabel "19(2) Application of this Part to information providers"@en ;
    cml:realizedBy doc:sch-2-sec-19-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to a publication of an advertisement." ;
    skos:definition "(2) Subsection (1) does not apply to a publication of an advertisement."@en ;
    cml:integrityHash "a2c31272210e505cf68b824e6f5ad4a936bba2664f2b6cecde93c976d9d90525" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-19 ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Exemption from subsection (1) for publications of advertisements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.120" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-19-ss-2-norm .
