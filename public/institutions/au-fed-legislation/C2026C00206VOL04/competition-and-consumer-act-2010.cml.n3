doc:sch-2-sec-221-ss-3 a cof:Section ;
    cof:title "221(3) Compliance with substantiation notices" ;
    values:kind "subsection" ;
    values:originalText "(3) Despite subsection (1), an individual may refuse or fail to give particular information or produce a particular document in compliance with a substantiation notice on the ground that the information or production of the document might tend to incriminate the individual or to expose the individual to a penalty. 222  False or misleading information etc." ;
    cof:pageNumber "320"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-221-ss-1 a cml:Concept ;
    skos:prefLabel "221(1) Compliance with substantiation notices"@en ;
    cml:realizedBy doc:sch-2-sec-221-ss-1 ;
    values:originalText "(1) A person must not, in compliance or purported compliance with a substantiation notice given by the regulator:  (a) give to the regulator false or misleading information; or  (b) produce to the regulator documents that contain false or misleading information. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  The Australian Consumer Law  Schedule 2 Enforcement and remedies  Chapter 5 Enforcement  Part 5-1  Section 222  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "(1) A person must not, in compliance or purported compliance with a substantiation notice given by the regulator:  (a) give to the regulator false or misleading information; or  (b) produce to the regulator documents that contain false or misleading information. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  The Australian Consumer Law  Schedule 2 Enforcement and remedies  Chapter 5 Enforcement  Part 5-1  Section 222  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "c1f9b7a4c389d81719999f884a405ffca37c974a926d2a67250fc8557bd2f024" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-221 ;
    cof:pageNumber "320"^^xsd:integer ;
    skos:note "Comply with substantiation notice within specified period. Do not give false or misleading information to the regulator." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
