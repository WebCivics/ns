doc:sch-2-sec-125-ss-3 a cof:Section ;
    cof:title "125(3) Notification by persons who supply consumer goods outside" ;
    values:kind "subsection" ;
    values:originalText "(3) The notice under subsection (1) must be given as soon as practicable after the supply of the consumer goods to the person outside Australia." ;
    cof:pageNumber "221"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-125-ss-4 a cml:Concept ;
    skos:prefLabel "125(4) Notification by persons who supply consumer goods outside"@en ;
    cml:realizedBy doc:sch-2-sec-125-ss-4 ;
    values:originalText "(4) A person who is required to give a notice under subsection (1) must, within 10 days after giving the notice, give a copy of the notice to the responsible Minister who issued the recall notice. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(4) A person who is required to give a notice under subsection (1) must, within 10 days after giving the notice, give a copy of the notice to the responsible Minister who issued the recall notice. Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
