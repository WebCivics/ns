concept:competition-and-consumer-act-2010-sch-2-sec-113 a cml:Concept ;
    skos:prefLabel "113 Revocation of interim bans"@en ;
    cml:realizedBy doc:sch-2-sec-113 ;
    values:originalText "If a responsible Minister imposes an interim ban:  (a) the responsible Minister may, by written notice published on the internet, revoke the ban at any time; and  (b) the ban ceases to be in force on the day specified by the responsible Minister in the notice. Subdivision B—Permanent bans" ;
    skos:definition "If a responsible Minister imposes an interim ban:  (a) the responsible Minister may, by written notice published on the internet, revoke the ban at any time; and  (b) the ban ceases to be in force on the day specified by the responsible Minister in the notice. Subdivision B—Permanent bans"@en ;
    cml:integrityHash "58261dfe3dda021ea64cd928d3628c65e7fd7e3810e61b983e4ba001aaac1c85" ;
    cof:pageNumber "212"^^xsd:integer ;
    skos:note "Responsible Minister may revoke interim ban at any time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
