concept:competition-and-consumer-act-2010-sch-2-sec-197-ss-9 a cml:Concept ;
    skos:prefLabel "197(9) Supplying etc. consumer goods covered by a ban"@en ;
    cml:realizedBy doc:sch-2-sec-197-ss-9 ;
    values:originalText "(9) An offence against subsection (1), (2), (3) or (5) committed by a person other than a body corporate is punishable on conviction by a fine of not more than $2,500,000." ;
