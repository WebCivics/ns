concept:competition-and-consumer-act-2010-sch-2-sec-203-ss-4 a cml:Concept ;
    skos:prefLabel "203(4) Supplying etc. goods that do not comply with information"@en ;
    cml:realizedBy doc:sch-2-sec-203-ss-4 ;
    values:originalText "(4) Subsection (3) does not apply if the person does not manufacture, possess or control the goods for the purpose of supplying the goods." ;
