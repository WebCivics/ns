concept:competition-and-consumer-act-2010-sch-2-sec-68 a cml:Concept ;
    skos:prefLabel "68 Convention on Contracts for the International Sale of Goods"@en ;
    cml:realizedBy doc:sch-2-sec-68 ;
    values:originalText "The provisions of the United Nations Convention on Contracts for the International Sale of Goods, done at Vienna on 11 April 1980, as amended and in force for Australia from time to time, prevail over the provisions of this Division to the extent of any inconsistency. Note: The text of the Convention is set out in Australian Treaty Series 1988 No. 32 ([1988] ATS 32). In 2010, the text of a Convention in the Australian Treaty Series was accessible through the Australian Treaties Library on the AustLII website (www.austlii.edu.au).  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections" ;
    skos:definition "The provisions of the United Nations Convention on Contracts for the International Sale of Goods, done at Vienna on 11 April 1980, as amended and in force for Australia from time to time, prevail over the provisions of this Division to the extent of any inconsistency. Note: The text of the Convention is set out in Australian Treaty Series 1988 No. 32 ([1988] ATS 32). In 2010, the text of a Convention in the Australian Treaty Series was accessible through the Australian Treaties Library on the AustLII website (www.austlii.edu.au).  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections"@en ;
    cml:integrityHash "b245bd3f6fe4ca86c410b817003d6c85c4c16daf7f2a230d497bc81fbca70b3f" ;
    cof:pageNumber "173"^^xsd:integer ;
    skos:note "Provisions of the United Nations Convention on Contracts for the International Sale of Goods prevail over Australian provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.173" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-68-norm .
