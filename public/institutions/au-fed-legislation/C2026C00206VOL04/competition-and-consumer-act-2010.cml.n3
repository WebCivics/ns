concept:competition-and-consumer-act-2010-sch-2-sec-13 a cml:Concept ;
    skos:prefLabel "13 Loss or damage to include injury"@en ;
    cml:realizedBy doc:sch-2-sec-13 ;
    values:originalText "In this Schedule:  (a) a reference to loss or damage, other than a reference to the amount of any loss or damage, includes a reference to injury; and  (b) a reference to the amount of any loss or damage includes a reference to damages in respect of an injury." ;
    skos:definition "In this Schedule:  (a) a reference to loss or damage, other than a reference to the amount of any loss or damage, includes a reference to injury; and  (b) a reference to the amount of any loss or damage includes a reference to damages in respect of an injury."@en ;
    cml:integrityHash "e1848d1dfdc7d8c6dc751bd94ee76b18d982187d565cccfca1267e65a0a2a7b8" ;
    cof:pageNumber "117"^^xsd:integer ;
    skos:note "Definition of loss or damage includes injury" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
