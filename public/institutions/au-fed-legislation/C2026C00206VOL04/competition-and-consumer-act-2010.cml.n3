doc:sch-2-sec-243b-ss-4 a cof:Section ;
    cof:title "243B(4) Orders made on application of the regulator to prevent and" ;
    values:kind "subsection" ;
    values:originalText "(4) An order made under this section against the respondent binds a person affected by the order, even if the person is not a party to the proceedings in which the order is made." ;
    cof:pageNumber "340"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-245 a cml:Concept ;
