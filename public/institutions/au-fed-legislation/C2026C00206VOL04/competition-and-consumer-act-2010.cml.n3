doc:sch-2-sec-137-ss-1b a cof:Section ;
    cof:title "137(1B) Supplying etc. services that do not comply with information" ;
    values:kind "subsection" ;
    values:originalText "(1B) A person who wishes to rely on subsection (1A) in proceedings bears an evidential burden in relation to that matter." ;
    cof:pageNumber "237"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-137-ss-2 a cml:Concept ;
    skos:prefLabel "137(2) Supplying etc. services that do not comply with information"@en ;
    cml:realizedBy doc:sch-2-sec-137-ss-2 ;
    values:originalText "(2) A person must not, in trade or commerce, offer for supply services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(2) A person must not, in trade or commerce, offer for supply services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
    cml:integrityHash "6bf50d20967469234f9d3b25f501bec12c6a4fbd2b0280fa7f993782828ef6be" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-137 ;
    cof:pageNumber "237"^^xsd:integer ;
    skos:note "Offering prohibited services in trade or commerce" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
