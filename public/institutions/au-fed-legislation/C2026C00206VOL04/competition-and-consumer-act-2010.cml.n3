concept:competition-and-consumer-act-2010-sch-2-sec-98 a cml:Concept ;
    skos:prefLabel "98 Termination of lay-by agreements by suppliers"@en ;
    cml:realizedBy doc:sch-2-sec-98 ;
    values:originalText "A supplier of goods who is a party to a lay-by agreement must not terminate the agreement unless:  (a) the consumer who is a party to the agreement breached a term of the agreement; or  (b) the supplier is no longer engaged in trade or commerce; or  (c) the goods to which the agreement relates are no longer available. Note: A pecuniary penalty may be imposed for a contravention of this section." ;
    skos:definition "A supplier of goods who is a party to a lay-by agreement must not terminate the agreement unless:  (a) the consumer who is a party to the agreement breached a term of the agreement; or  (b) the supplier is no longer engaged in trade or commerce; or  (c) the goods to which the agreement relates are no longer available. Note: A pecuniary penalty may be imposed for a contravention of this section."@en ;
    cml:integrityHash "81971195ddc13c76f0721e2734a93a6023a90e33e72cc8ce8566b7915d8468e8" ;
    cof:pageNumber "193"^^xsd:integer ;
    skos:note "Termination of lay-by agreements by suppliers under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.193" ;
