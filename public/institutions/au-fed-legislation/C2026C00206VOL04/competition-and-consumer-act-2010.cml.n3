    cof:pageNumber "334"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-239 a cml:Concept ;
    skos:prefLabel "239 Orders to redress etc. loss or damage suffered by non-parties"@en ;
    cml:realizedBy doc:sch-2-sec-239 ;
    values:originalText "(1) If:  (a) a person:  (i) engaged in conduct (the contravening conduct) in contravention of a provision of Chapter 2, Part 3-1," ;
    skos:definition "(1) If:  (a) a person:  (i) engaged in conduct (the contravening conduct) in contravention of a provision of Chapter 2, Part 3-1,"@en ;
    cml:integrityHash "1f8d395bba28b5a47057deaf3310e4c81de7e9e138675d211c9e92b37321a158" ;
    cof:pageNumber "335"^^xsd:integer ;
    skos:note "If a person engages in contravening conduct, the state may take action." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.335" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-239-norm .
