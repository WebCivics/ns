concept:competition-and-consumer-act-2010-sch-2-sec-120 a cml:Concept ;
    skos:prefLabel "120 Temporary exemption under the Trans-Tasman Mutual"@en ;
    cml:realizedBy doc:sch-2-sec-120 ;
    values:originalText "Recognition Act 1997  (1) If:  (a) an interim ban on consumer goods of a particular kind is in force; or  (b) a permanent ban on consumer goods of a particular kind is in force; the goods are taken, for the purposes of section 46 of the Trans-Tasman Mutual Recognition Act 1997, to be goods of a kind that are declared, in the manner provided by section 46(2) of that Act, to be exempt from the operation of that Act.  (2) This section does not affect the application of section 46(4) of that Act in relation to such an exemption." ;
    skos:definition "Recognition Act 1997  (1) If:  (a) an interim ban on consumer goods of a particular kind is in force; or  (b) a permanent ban on consumer goods of a particular kind is in force; the goods are taken, for the purposes of section 46 of the Trans-Tasman Mutual Recognition Act 1997, to be goods of a kind that are declared, in the manner provided by section 46(2) of that Act, to be exempt from the operation of that Act.  (2) This section does not affect the application of section 46(4) of that Act in relation to such an exemption."@en ;
    cml:integrityHash "f178eb27f18010be4c1594bfb5e4dec91980d1a69d80ab8428892070874ac8d9" ;
    cof:pageNumber "216"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-120-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-120-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.216" .
