concept:competition-and-consumer-act-2010-sch-1-sec-45aj a cml:Concept ;
    skos:prefLabel "45AJ Making a contract etc. containing a cartel provision"@en ;
    cml:realizedBy doc:sch-1-sec-45aj ;
    values:originalText "A person contravenes this section if:  (a) the person makes a contract or arrangement, or arrives at an understanding; and  (b) the contract, arrangement or understanding contains a cartel provision. Note: For enforcement, see Part VI." ;
    skos:definition "A person contravenes this section if:  (a) the person makes a contract or arrangement, or arrives at an understanding; and  (b) the contract, arrangement or understanding contains a cartel provision. Note: For enforcement, see Part VI."@en ;
    cml:integrityHash "dee1970b47095c91ee0144c3cd060ecfeab767e74851dd0524b67eda794f83d6" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Making a contract or arrangement with a cartel provision is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.32" ;
