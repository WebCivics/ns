    cml:premiseText "The person gives to the consumer a document that evidences a warranty against defects and that does not comply with the requirements prescribed for the purposes of section 102(1); or represents directly to the consumer that the goods or services are goods or services to which such a warranty against defects relates." ;
    cml:conclusionText "An offence is committed if the person, in connection with the supply, in trade or commerce, of goods or services to a consumer: ..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

