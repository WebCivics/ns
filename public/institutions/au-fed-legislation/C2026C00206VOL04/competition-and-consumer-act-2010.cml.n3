doc:sch-2-sec-305-ss-2 a cof:Section ;
    cof:title "305(2) Application of amendments relating to unfair contract terms" ;
    values:kind "subsection" ;
    values:originalText "(2) The amendments:  (a) apply in relation to a contract made at or after the commencement (the relevant commencement) of the amending Schedule; and  (b) do not apply to a contract (an existing contract) made before the relevant commencement, except as provided in this section." ;
    cof:pageNumber "390"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-305-ss-3 a cml:Concept ;
    skos:prefLabel "305(3) Application of amendments relating to unfair contract terms"@en ;
    cml:realizedBy doc:sch-2-sec-305-ss-3 ;
    values:originalText "(3) If an existing contract is renewed at or after the relevant commencement, the amendments apply to the contract as renewed, on and from the day (the renewal day) on which the renewal takes effect, in relation to conduct that occurs on or after the renewal day." ;
    skos:definition "(3) If an existing contract is renewed at or after the relevant commencement, the amendments apply to the contract as renewed, on and from the day (the renewal day) on which the renewal takes effect, in relation to conduct that occurs on or after the renewal day."@en ;
    cml:integrityHash "874c454dbe5f41cf8f86e5a13bc229dcc3685134745651eaea979e3ef6391253" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-305 ;
    cof:pageNumber "390"^^xsd:integer ;
    skos:note "Prohibits conduct occurring on or after the renewal day for existing contracts renewed at or after the relevant commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
