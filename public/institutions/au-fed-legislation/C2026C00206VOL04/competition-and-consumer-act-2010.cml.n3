concept:competition-and-consumer-act-2010-sch-2-sec-271-ss-5 a cml:Concept ;
    skos:prefLabel "271(5) Action for damages against manufacturers of goods"@en ;
    cml:realizedBy doc:sch-2-sec-271-ss-5 ;
    values:originalText "(5) If:  (a) the guarantee under section 58 or 59(1) applies to a supply of goods to a consumer; and  (b) the guarantee is not complied with; an affected person in relation to the goods may, by action against the manufacturer of the goods, recover damages from the manufacturer." ;
    skos:definition "(5) If:  (a) the guarantee under section 58 or 59(1) applies to a supply of goods to a consumer; and  (b) the guarantee is not complied with; an affected person in relation to the goods may, by action against the manufacturer of the goods, recover damages from the manufacturer."@en ;
    cml:integrityHash "bf5730ad601146db41302e8edfe66a98d8108dfebafc34267c52520b0e710102" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-271 ;
    cof:pageNumber "364"^^xsd:integer ;
    skos:note "Manufacturer must provide damages for non-compliance with guarantee." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
