concept:competition-and-consumer-act-2010-sch-1-sec-45eb a cml:Concept ;
    skos:prefLabel "45EB Sections 45D to 45EA do not affect operation of other"@en ;
    cml:realizedBy doc:sch-1-sec-45eb ;
    values:originalText "provisions of Part  Nothing in section 45D, 45DA, 45DC, 45DD, 45E or 45EA affects the operation of any other provision of this Part." ;
