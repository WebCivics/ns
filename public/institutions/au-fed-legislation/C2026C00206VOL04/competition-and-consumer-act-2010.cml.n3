    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-259-ss-6 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-259-ss-7 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-259-ss-1 ;
