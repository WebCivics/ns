    cof:pageNumber "375"^^xsd:integer ;
    skos:note "Judgment cannot be enforced against linked credit provider unless written demand is made." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.375" ;
