concept:competition-and-consumer-act-2010-sch-2-sec-217 a cml:Concept ;
    skos:prefLabel "217 Criminal proceedings not to be brought for contraventions of"@en ;
    cml:realizedBy doc:sch-2-sec-217 ;
    values:originalText "Chapter 2 or 3  Criminal proceedings do not lie against a person only because the person:  (a) has contravened a provision of Chapter 2 or 3; or  (b) has attempted to contravene such a provision; or  (c) has aided, abetted, counselled or procured a person to contravene such a provision; or  (d) has induced, or attempted to induce, a person, whether by threats or promises or otherwise, to contravene such a provision; or  Schedule 2  The Australian Consumer Law Chapter 4  Offences" ;
    skos:definition "Chapter 2 or 3  Criminal proceedings do not lie against a person only because the person:  (a) has contravened a provision of Chapter 2 or 3; or  (b) has attempted to contravene such a provision; or  (c) has aided, abetted, counselled or procured a person to contravene such a provision; or  (d) has induced, or attempted to induce, a person, whether by threats or promises or otherwise, to contravene such a provision; or  Schedule 2  The Australian Consumer Law Chapter 4  Offences"@en ;
    cml:integrityHash "cc0a25e2c2a7b11202869ae94e2d1fc9cd178c9cc6cf350cb31f89bb494a746b" ;
    cof:pageNumber "315"^^xsd:integer ;
    skos:note "Criminal proceedings not allowed for contraventions of Chapter 2 or 3" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.315" ;
