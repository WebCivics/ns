concept:competition-and-consumer-act-2010-sch-2-sec-171 a cml:Concept ;
    skos:prefLabel "171 Disclosing purpose and identity"@en ;
    cml:realizedBy doc:sch-2-sec-171 ;
    values:originalText "(1) A dealer commits an offence if the dealer:  (a) calls on a person for the purpose of negotiating an unsolicited consumer agreement, or for an incidental or related purpose; and  (b) does not as soon as practicable and in any event before starting to negotiate:  Schedule 2  The Australian Consumer Law Chapter 4  Offences" ;
    skos:definition "(1) A dealer commits an offence if the dealer:  (a) calls on a person for the purpose of negotiating an unsolicited consumer agreement, or for an incidental or related purpose; and  (b) does not as soon as practicable and in any event before starting to negotiate:  Schedule 2  The Australian Consumer Law Chapter 4  Offences"@en ;
    cml:integrityHash "1d8e9dee03768f053353c1aa454c196418a05ceb918abdf0bdf33966cb17df2a" ;
    cof:pageNumber "275"^^xsd:integer ;
