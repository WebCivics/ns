concept:competition-and-consumer-act-2010-sch-2-sec-162 a cml:Concept ;
    skos:prefLabel "162 Assertion of right to payment for unsolicited goods or services"@en ;
    cml:realizedBy doc:sch-2-sec-162 ;
    values:originalText "(1) A person commits an offence if the person, in trade or commerce, asserts a right to payment from another person for unsolicited goods.  (2) A person commits an offence if the person, in trade or commerce, asserts a right to payment from another person for unsolicited services.  (3) A person commits an offence if the person, in trade or commerce, sends to another person an invoice or other document that:  (a) states the amount of a payment, or sets out the charge, for unsolicited goods or unsolicited services; and  Schedule 2  The Australian Consumer Law Chapter 4  Offences" ;
    skos:definition "(1) A person commits an offence if the person, in trade or commerce, asserts a right to payment from another person for unsolicited goods.  (2) A person commits an offence if the person, in trade or commerce, asserts a right to payment from another person for unsolicited services.  (3) A person commits an offence if the person, in trade or commerce, sends to another person an invoice or other document that:  (a) states the amount of a payment, or sets out the charge, for unsolicited goods or unsolicited services; and  Schedule 2  The Australian Consumer Law Chapter 4  Offences"@en ;
    cml:integrityHash "30c2181c4cad2b0f4423b38c9472887e8ee16523bbfb3ca875aa18365631f4cb" ;
    cof:pageNumber "263"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-162-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-162-ss-2 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-162-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.263" .
