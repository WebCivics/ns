    cml:premiseText "(3) A person (the first person) also engages in the practice of exclusive dealing if the first person refuses:  (a) to supply goods or services to a second person;  (b) to supply goods or services to a second person at a particular price;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

