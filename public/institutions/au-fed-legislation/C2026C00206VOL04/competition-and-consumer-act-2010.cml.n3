doc:sch-2-sec-191a-ss-1 a cof:Section ;
    cof:title "191A(1) Gift cards to be redeemable for at least 3 years" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if:  (a) the person, in trade or commerce, supplies a gift card to a consumer; and  (b) the day the gift card ceases to be redeemable is earlier than 3 years after the day of that supply. Penalty:  (a) if the person is a body corporate—$30,000; or  (b) if the person is not a body corporate—$6,000." ;
    cof:pageNumber "289"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-191a-ss-2 a cml:Concept ;
    skos:prefLabel "191A(2) Gift cards to be redeemable for at least 3 years"@en ;
    cml:realizedBy doc:sch-2-sec-191a-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability. 191B  When gift card ceases to be redeemable to appear prominently on gift card" ;
    skos:definition "(2) Subsection (1) is an offence of strict liability. 191B  When gift card ceases to be redeemable to appear prominently on gift card"@en ;
    cml:integrityHash "952dc71f620b462932804ee9b8c08bc0578c1c3cb35cb41d81ee71501dbc6766" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-191a ;
    cof:pageNumber "289"^^xsd:integer ;
    skos:note "Gift card must be redeemable for at least 3 years." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
