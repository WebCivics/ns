concept:competition-and-consumer-act-2010-sch-2-sec-235 a cml:Concept ;
    skos:prefLabel "235 Variation and discharge of injunctions"@en ;
    cml:realizedBy doc:sch-2-sec-235 ;
    values:originalText "A court may vary or discharge an injunction (including an interim injunction) that it has granted under this Division.  The Australian Consumer Law  Schedule 2 Enforcement and remedies  Chapter 5 Remedies  Part 5-2  Section 236  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "A court may vary or discharge an injunction (including an interim injunction) that it has granted under this Division.  The Australian Consumer Law  Schedule 2 Enforcement and remedies  Chapter 5 Remedies  Part 5-2  Section 236  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "bb1a6bca469441fe96a2f8d58b9129e86f156e4dfda83d8c94abc8877e476c5e" ;
    cof:pageNumber "332"^^xsd:integer ;
