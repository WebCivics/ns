concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-9 a cml:Concept ;
    skos:prefLabel "3(9) Meaning of consumer"@en ;
    cml:realizedBy doc:sch-2-sec-3-ss-9 ;
    values:originalText "(9) If:  (a) a person obtains credit in connection with the acquisition of goods or services by him or her; and  (b) the amount paid or payable by him or her for the goods or services is increased because he or she so obtains credit; obtaining the credit is taken for the purposes of subsection (3) to be the acquisition of a service, and the amount paid or payable by him or her for the service of being provided with the credit is taken to include the amount of the increase. Presumption that persons are consumers" ;
    skos:definition "(9) If:  (a) a person obtains credit in connection with the acquisition of goods or services by him or her; and  (b) the amount paid or payable by him or her for the goods or services is increased because he or she so obtains credit; obtaining the credit is taken for the purposes of subsection (3) to be the acquisition of a service, and the amount paid or payable by him or her for the service of being provided with the credit is taken to include the amount of the increase. Presumption that persons are consumers"@en ;
    cml:integrityHash "0291f1a9a0c6c480662f1c5853889e25d2dd0f4d72b83ed8106c9a9fb883e03f" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-3 ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Presumption that persons are consumers if they obtain credit and the amount paid or payable is increased." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.107" ;
