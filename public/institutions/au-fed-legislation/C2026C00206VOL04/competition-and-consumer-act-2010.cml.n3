concept:competition-and-consumer-act-2010-sch-2-sec-153-ss-1 a cml:Concept ;
    skos:prefLabel "153(1) Misleading conduct relating to employment"@en ;
    cml:realizedBy doc:sch-2-sec-153-ss-1 ;
    values:originalText "(1) A person commits an offence if:  (a) the person, in trade or commerce, offers any rebate, gift, prize or other free item; and  (b) the offer is connected with:  (i) the supply or possible supply of goods or services; or  (ii) the promotion by any means of the supply or use of goods or services; or  (iii) the sale or grant, or the possible sale or grant, of an interest in land; or  Schedule 2  The Australian Consumer Law Chapter 4  Offences" ;
    skos:definition "(1) A person commits an offence if:  (a) the person, in trade or commerce, offers any rebate, gift, prize or other free item; and  (b) the offer is connected with:  (i) the supply or possible supply of goods or services; or  (ii) the promotion by any means of the supply or use of goods or services; or  (iii) the sale or grant, or the possible sale or grant, of an interest in land; or  Schedule 2  The Australian Consumer Law Chapter 4  Offences"@en ;
    cml:integrityHash "59ead3dbe911b80841d080ef78d85c0676ae5ad1e02a683b2d632cea42ebb5d2" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-153 ;
    cof:pageNumber "250"^^xsd:integer ;
    skos:note "Offering a rebate, gift, prize or other free item connected with the supply or use of goods or services is prohibited. Misleading conduct relating to employment" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.250" ;
