concept:competition-and-consumer-act-2010-sch-2-sec-43 a cml:Concept ;
    skos:prefLabel "43 Assertion of right to payment for unauthorised entries or"@en ;
    cml:realizedBy doc:sch-2-sec-43 ;
    values:originalText "advertisements  (1) A person must not assert a right to payment from another person of a charge for placing, in a publication, an entry or advertisement relating to:  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections" ;
    skos:definition "advertisements  (1) A person must not assert a right to payment from another person of a charge for placing, in a publication, an entry or advertisement relating to:  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections"@en ;
    cml:integrityHash "66bb3d103b6b6fcf48fa2abdd8732a2d97d94ffd2000090d38f29ef4ab3af2ea" ;
    cof:pageNumber "149"^^xsd:integer ;
