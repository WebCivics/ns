concept:competition-and-consumer-act-2010-sch-2-sec-142 cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-142-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sch-2-sec-142-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Liability obligation" ;
    cml:premiseText "The manufacturer must provide a defence against liability for defective goods actions." ;
    cml:conclusionText "If the defence is established, the liability is discharged." ;
    cml:executionSurface "modalities::logic::deontic" ;
