concept:competition-and-consumer-act-2010-sch-2-sec-19-ss-5 a cml:Concept ;
    skos:prefLabel "19(5) Application of this Part to information providers"@en ;
    cml:realizedBy doc:sch-2-sec-19-ss-5 ;
