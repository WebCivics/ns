    cml:hasPart concept:competition-and-consumer-act-2010-sch-1-sec-45-ss-4 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-1-sec-45-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
