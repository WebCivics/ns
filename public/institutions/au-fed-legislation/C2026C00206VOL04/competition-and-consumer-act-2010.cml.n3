concept:competition-and-consumer-act-2010-sch-2-sec-273 a cml:Concept ;
    skos:prefLabel "273 Time limit for actions against manufacturers of goods"@en ;
    cml:realizedBy doc:sch-2-sec-273 ;
    values:originalText "An affected person may commence an action for damages under this Division at any time within 3 years after the day on which the affected person first became aware, or ought reasonably to have become aware, that the guarantee to which the action relates has not been complied with.  The Australian Consumer Law  Schedule 2 Enforcement and remedies  Chapter 5 Remedies relating to guarantees  Part 5-4  Section 274  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "An affected person may commence an action for damages under this Division at any time within 3 years after the day on which the affected person first became aware, or ought reasonably to have become aware, that the guarantee to which the action relates has not been complied with.  The Australian Consumer Law  Schedule 2 Enforcement and remedies  Chapter 5 Remedies relating to guarantees  Part 5-4  Section 274  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "2f3de81ba358533bdd20d9bc6449e9031fa693c5497fec1541399d6fd2ac28d5" ;
    cof:pageNumber "366"^^xsd:integer ;
    skos:note "Time limit for actions against manufacturers of goods" ;
