concept:competition-and-consumer-act-2010-sch-1-sec-45au-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sch-1-sec-45au-ss-1-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sch-1-sec-45au-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits application of sections 45AF, 45AG, 45AJ and 45AK to contracts with cartel provisions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-45au-ss-1 a cof:Section ;
    cof:title "45AU(1) Collective acquisition of goods or services by the parties to a" ;
    values:kind "subsection" ;
    values:originalText "(1) Sections 45AF, 45AG, 45AJ and 45AK do not apply in relation to a contract, arrangement or understanding containing a cartel provision, in so far as:  (a) the cartel provision has the purpose, or has or is likely to have the effect, mentioned in subsection 45AD(2); and  (b) either:  (i) the cartel provision relates to the price for goods or services to be collectively acquired, whether directly or indirectly, by the parties to the contract, arrangement or understanding; or  (ii) the cartel provision is for the joint advertising of the price for the re-supply of goods or services so acquired." ;
    cof:pageNumber "39"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-1-sec-45au-ss-2 a cml:Concept ;
    skos:prefLabel "45AU(2) Collective acquisition of goods or services by the parties to a"@en ;
    cml:realizedBy doc:sch-1-sec-45au-ss-2 ;
    values:originalText "(2) A person who wishes to rely on subsection (1) bears an evidential burden in relation to that matter.  Schedule 1  The Schedule version of Part IV" ;
    skos:definition "(2) A person who wishes to rely on subsection (1) bears an evidential burden in relation to that matter.  Schedule 1  The Schedule version of Part IV"@en ;
    cml:integrityHash "71068890b3c51d126228c37b4f05f604298f21e02827e8884ce5ccdf98950a0b" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-1-sec-45au ;
    cof:pageNumber "39"^^xsd:integer ;
    skos:note "Person bears evidential burden to rely on subsection (1)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.39" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-1-sec-45au-ss-2-norm .
