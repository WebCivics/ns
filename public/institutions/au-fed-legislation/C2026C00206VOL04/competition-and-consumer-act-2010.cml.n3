doc:sch-2-sec-124-ss-1 a cof:Section ;
    cof:title "124(1) Obligations of a supplier in relation to a recall notice" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if a recall notice for consumer goods requires a supplier to take action of a kind referred to in section 123(1)(c)." ;
