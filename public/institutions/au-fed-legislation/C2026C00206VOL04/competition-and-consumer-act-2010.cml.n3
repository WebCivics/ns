doc:sch-1-sec-45ak-ss-1 a cof:Section ;
    cof:title "45AK(1) Giving effect to a cartel provision" ;
    values:kind "subsection" ;
    values:originalText "(1) A person contravenes this section if:  (a) a contract, arrangement or understanding contains a cartel provision; and  (b) the person gives effect to the cartel provision.  The Schedule version of Part IV  Schedule 1 Schedule version of Part IV  Part 1 Cartel conduct  Division 1  Section 45AL  Competition and Consumer Act 2010  Compilation date: 27/05/2026  Note: For enforcement, see Part VI." ;
    cof:pageNumber "32"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-1-sec-45ak-ss-2 a cml:Concept ;
    skos:prefLabel "45AK(2) Giving effect to a cartel provision"@en ;
    cml:realizedBy doc:sch-1-sec-45ak-ss-2 ;
    values:originalText "(2) Paragraph (1)(a) applies to contracts or arrangements made, or understandings arrived at, before, at or after the commencement of this section. Subdivision D—Exceptions" ;
    skos:definition "(2) Paragraph (1)(a) applies to contracts or arrangements made, or understandings arrived at, before, at or after the commencement of this section. Subdivision D—Exceptions"@en ;
    cml:integrityHash "7a951e5fc63f54ca7311ad3dab23574dffeb61bd401e56233d14659ea2faec63" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-1-sec-45ak ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Applicability of paragraph (1)(a) to contracts or arrangements made before, at, or after the commencement of this section." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.32" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-1-sec-45ak-ss-2-norm .
