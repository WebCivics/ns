    cml:operator "hasClass" ;
    cml:logicSummary "Defines a class of consumer goods" ;
    cml:premiseText "(2) Without limiting subsection (1), a safety standard for consumer goods of a particular kind may consist of requirements about the following matters:" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
