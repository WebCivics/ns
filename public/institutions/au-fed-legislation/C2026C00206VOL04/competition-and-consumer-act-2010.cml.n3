doc:sch-2-sec-194-ss-2 a cof:Section ;
    cof:title "194(2) Supplying etc. consumer goods that do not comply with safety" ;
    values:kind "subsection" ;
    values:originalText "(2) A person commits an offence if:  (a) the person, in trade or commerce, offers for supply (other than for export) consumer goods of a particular kind; and  (b) a safety standard for consumer goods of that kind is in force; and  (c) those goods do not comply with the standard." ;
    cof:pageNumber "293"^^xsd:integer .

