concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5 cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5-logic-argumentation-3 .
concept:competition-and-consumer-act-2010-sch-2-sec-3-ss-5-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "Price determination based on alternative suppliers" ;
    cml:premiseText "If there are alternative suppliers, the price is determined by their lowest prices" ;
    cml:conclusionText "The buyer must pay the lowest price offered by an alternative supplier" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

