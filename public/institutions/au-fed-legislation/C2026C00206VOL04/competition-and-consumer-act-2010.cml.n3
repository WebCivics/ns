doc:sch-1-sec-45ak-ss-2 a cof:Section ;
    cof:title "45AK(2) Giving effect to a cartel provision" ;
    values:kind "subsection" ;
    values:originalText "(2) Paragraph (1)(a) applies to contracts or arrangements made, or understandings arrived at, before, at or after the commencement of this section. Subdivision D—Exceptions" ;
    cof:pageNumber "32"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-1-sec-45al a cml:Concept ;
    skos:prefLabel "45AL Conduct notified"@en ;
    cml:realizedBy doc:sch-1-sec-45al ;
    values:originalText "(1) Sections 45AF, 45AG, 45AJ and 45AK do not apply to a person in relation to a contract, arrangement or understanding containing a cartel provision, in so far as:  (a) the cartel provision:  (i) has the purpose, or has or is likely to have the effect, mentioned in subsection 45AD(2); or  (ii) has the purpose mentioned in a paragraph of subsection 45AD(3) other than paragraph (c); and  (b) the person has given the Commission a collective bargaining notice under subsection 93AB(1A) setting out particulars of the contract, arrangement or understanding; and  (c) the notice is in force under section 93AD.  (2) A person who wishes to rely on subsection (1) bears an evidential burden in relation to that matter." ;
    skos:definition "(1) Sections 45AF, 45AG, 45AJ and 45AK do not apply to a person in relation to a contract, arrangement or understanding containing a cartel provision, in so far as:  (a) the cartel provision:  (i) has the purpose, or has or is likely to have the effect, mentioned in subsection 45AD(2); or  (ii) has the purpose mentioned in a paragraph of subsection 45AD(3) other than paragraph (c); and  (b) the person has given the Commission a collective bargaining notice under subsection 93AB(1A) setting out particulars of the contract, arrangement or understanding; and  (c) the notice is in force under section 93AD.  (2) A person who wishes to rely on subsection (1) bears an evidential burden in relation to that matter."@en ;
    cml:integrityHash "274dd315a7972deeed39ab625fd6264374fcb3b2c1f34cd8d4385664200efb82" ;
    cof:pageNumber "33"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-1-sec-45al-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-1-sec-45al-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.33" .
