doc:sch-2-sec-265-ss-3 a cof:Section ;
    cof:title "265(3) Termination of contracts for the supply of services that are" ;
    values:kind "subsection" ;
    values:originalText "(3) The consumer is entitled to recover, by action against the supplier of the services, a refund of:  (a) any money paid by the consumer for the services; and  (b) an amount that is equal to the value of any other consideration provided by the consumer for the services; to the extent that the consumer has not already consumed the services at the time the termination takes effect." ;
    cof:pageNumber "359"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-266 a cml:Concept ;
    skos:prefLabel "266 Rights of gift recipients"@en ;
    cml:realizedBy doc:sch-2-sec-266 ;
    values:originalText "If a consumer acquires goods from a supplier and gives them to another person as a gift, the other person may, subject to any defence which would be available to the supplier against the consumer:  Schedule 2  The Australian Consumer Law Chapter 5  Enforcement and remedies" ;
    skos:definition "If a consumer acquires goods from a supplier and gives them to another person as a gift, the other person may, subject to any defence which would be available to the supplier against the consumer:  Schedule 2  The Australian Consumer Law Chapter 5  Enforcement and remedies"@en ;
    cml:integrityHash "e3db57ce97d1842001c7761463f287ed5e5236fe5cf5d623a962f9d61d50ad9c" ;
    cof:pageNumber "359"^^xsd:integer ;
    skos:note "Recipient of a gift has certain rights against the supplier" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.359" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-266-norm .
