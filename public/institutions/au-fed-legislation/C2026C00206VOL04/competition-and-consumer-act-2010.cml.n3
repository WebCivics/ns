concept:competition-and-consumer-act-2010-sch-2-sec-40 a cml:Concept ;
    skos:prefLabel "40 Assertion of right to payment for unsolicited goods or services"@en ;
    cml:realizedBy doc:sch-2-sec-40 ;
    values:originalText "(1) A person must not, in trade or commerce, assert a right to payment from another person for unsolicited goods unless the person has reasonable cause to believe that there is a right to the payment. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  (2) A person must not, in trade or commerce, assert a right to payment from another person for unsolicited services unless the person has reasonable cause to believe that there is a right to the payment. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  (3) A person must not, in trade or commerce, send to another person an invoice or other document that:  (a) states the amount of a payment, or sets out the charge, for unsolicited goods or unsolicited services; and  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections" ;
    skos:definition "(1) A person must not, in trade or commerce, assert a right to payment from another person for unsolicited goods unless the person has reasonable cause to believe that there is a right to the payment. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  (2) A person must not, in trade or commerce, assert a right to payment from another person for unsolicited services unless the person has reasonable cause to believe that there is a right to the payment. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  (3) A person must not, in trade or commerce, send to another person an invoice or other document that:  (a) states the amount of a payment, or sets out the charge, for unsolicited goods or unsolicited services; and  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections"@en ;
    cml:integrityHash "aac3e25529b4dbf0517033fb6bdc3d1ad0b627358fc7ce6d882e8303221309d3" ;
    cof:pageNumber "147"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-40-ss-1 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-40-ss-2 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-40-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.147" .
doc:sch-2-sec-40 a cof:Section ;
