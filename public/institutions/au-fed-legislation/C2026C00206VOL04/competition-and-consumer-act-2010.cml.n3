concept:competition-and-consumer-act-2010-sch-2-sec-212 a cml:Concept ;
    skos:prefLabel "212 Prosecutions to be commenced within 3 years"@en ;
    cml:realizedBy doc:sch-2-sec-212 ;
    values:originalText "A prosecution for an offence against a provision of this Chapter may be commenced at any time within 3 years after the commission of the offence." ;
