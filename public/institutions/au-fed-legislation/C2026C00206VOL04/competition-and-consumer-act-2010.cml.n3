concept:competition-and-consumer-act-2010-sch-2-sec-205-ss-1 a cml:Concept ;
    skos:prefLabel "205(1) Compliance with substantiation notices"@en ;
    cml:realizedBy doc:sch-2-sec-205-ss-1 ;
    values:originalText "(1) A person commits an offence if the person, in compliance or purported compliance with a substantiation notice given by the regulator:  (a) gives to the regulator false or misleading information; or  (b) produces to the regulator documents that contain false or misleading information. Penalty:  (a) if the person is a body corporate—$27,500; or  (b) if the person is not a body corporate—$5,500.  Schedule 2  The Australian Consumer Law Chapter 4  Offences" ;
    skos:definition "(1) A person commits an offence if the person, in compliance or purported compliance with a substantiation notice given by the regulator:  (a) gives to the regulator false or misleading information; or  (b) produces to the regulator documents that contain false or misleading information. Penalty:  (a) if the person is a body corporate—$27,500; or  (b) if the person is not a body corporate—$5,500.  Schedule 2  The Australian Consumer Law Chapter 4  Offences"@en ;
    cml:integrityHash "ee9dbe82497885d6e89639ba73f341c6fe3444d5aa479770165dc6885745390c" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-205 ;
    cof:pageNumber "307"^^xsd:integer ;
    skos:note "Giving false or misleading information to the regulator is prohibited. Refusal to comply with substantiation notice within specified period is an offence." ;
    cml:curationStatus cml:Proposed ;
