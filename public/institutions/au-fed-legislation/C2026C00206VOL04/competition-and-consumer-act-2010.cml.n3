doc:sch-2-sec-192-ss-1 a cof:Section ;
    cof:title "192(1) Prescribed requirements for warranties against defects" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if the person, in connection with the supply, in trade or commerce, of goods or services to a consumer:  (a) gives to the consumer a document that evidences a warranty against defects and that does not comply with the requirements prescribed for the purposes of section 102(1); or  (b) represents directly to the consumer that the goods or services are goods or services to which such a warranty against defects relates. Penalty:  (a) if the person is a body corporate—$50,000; or  (b) if the person is not a body corporate—$10,000." ;
    cof:pageNumber "292"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-192-ss-2 a cml:Concept ;
    skos:prefLabel "192(2) Prescribed requirements for warranties against defects"@en ;
    cml:realizedBy doc:sch-2-sec-192-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability." ;
    skos:definition "(2) Subsection (1) is an offence of strict liability."@en ;
    cml:integrityHash "c567ddf47efaa5e0ffaa5e6fb964b73c79feb99480fc64b1f194d45392f4ff4e" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-192 ;
    cof:pageNumber "292"^^xsd:integer ;
    skos:note "Offence of strict liability for non-compliance with warranty requirements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
