doc:sch-2-sec-73-ss-1 a cof:Section ;
    cof:title "73(1) Permitted hours for negotiating an unsolicited consumer" ;
    values:kind "subsection" ;
    values:originalText "(1) A dealer must not call on a person for the purpose of negotiating an unsolicited consumer agreement, or for an incidental or related purpose:  (a) at any time on a Sunday or a public holiday; or  (b) before 9 am on any other day; or  The Australian Consumer Law  Schedule 2 Specific protections  Chapter 3 Consumer transactions  Part 3-2  Section 74  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (c) after 6 pm on any other day (or after 5 pm if the other day is a Saturday). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "176"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-73-ss-2 a cml:Concept ;
    skos:prefLabel "73(2) Permitted hours for negotiating an unsolicited consumer"@en ;
    cml:realizedBy doc:sch-2-sec-73-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply if the dealer calls on the person in accordance with consent that:  (a) was given by the person to the dealer or a person acting on the dealer’s behalf; and  (b) was not given in the presence of the dealer or a person acting on the dealer’s behalf. Note: The Do Not Call Register Act 2006 may apply to a telephone call made for the purpose of negotiating an unsolicited consumer agreement." ;
    skos:definition "(2) Subsection (1) does not apply if the dealer calls on the person in accordance with consent that:  (a) was given by the person to the dealer or a person acting on the dealer’s behalf; and  (b) was not given in the presence of the dealer or a person acting on the dealer’s behalf. Note: The Do Not Call Register Act 2006 may apply to a telephone call made for the purpose of negotiating an unsolicited consumer agreement."@en ;
    cml:integrityHash "e1227408e73f632d8bb05873a24040b9cdf3362c0c04964d2de0f2278d4c961a" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-73 ;
    cof:pageNumber "176"^^xsd:integer ;
    skos:note "Permitted hours for negotiating an unsolicited consumer agreement" ;
