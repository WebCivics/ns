doc:sch-2-sec-99d-ss-2 a cof:Section ;
    cof:title "99D(2) Terms and conditions not to allow post-supply fees" ;
    values:kind "subsection" ;
    values:originalText "(2) A post-supply fee is a fee or charge payable in relation to a gift card after it is supplied to a consumer, other than a fee or charge of a kind specified in the regulations." ;
    cof:pageNumber "196"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-99e a cml:Concept ;
    skos:prefLabel "99E Post-supply fees not to be demanded or received"@en ;
    cml:realizedBy doc:sch-2-sec-99e ;
    values:originalText "A person must not, in trade or commerce, demand or receive payment of a post-supply fee in relation to a gift card. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  The Australian Consumer Law  Schedule 2 Specific protections  Chapter 3 Consumer transactions  Part 3-2  Section 99F  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "A person must not, in trade or commerce, demand or receive payment of a post-supply fee in relation to a gift card. Note: A pecuniary penalty may be imposed for a contravention of this subsection.  The Australian Consumer Law  Schedule 2 Specific protections  Chapter 3 Consumer transactions  Part 3-2  Section 99F  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "2291031a0f873fbea607a09ff101e072444941f54a7824a24bae73c31ae867ed" ;
    cof:pageNumber "196"^^xsd:integer ;
    skos:note "Demanding or receiving post-supply fees in relation to a gift card is prohibited." ;
