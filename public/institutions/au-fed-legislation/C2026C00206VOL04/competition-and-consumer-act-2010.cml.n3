concept:competition-and-consumer-act-2010-sch-2-sec-99g a cml:Concept ;
    skos:prefLabel "99G Regulations may limit application of this Division"@en ;
    cml:realizedBy doc:sch-2-sec-99g ;
    values:originalText "The regulations may provide that some or all of the provisions of this Division do not apply to or in relation to:  (a) gift cards of a kind prescribed by the regulations; or  (b) persons of a kind prescribed by the regulations; or  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections" ;
    skos:definition "The regulations may provide that some or all of the provisions of this Division do not apply to or in relation to:  (a) gift cards of a kind prescribed by the regulations; or  (b) persons of a kind prescribed by the regulations; or  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections"@en ;
    cml:integrityHash "f7838d199bea7327383ca225549f5b3a91a5710a9a43357d131eac6fdd84d338" ;
    cof:pageNumber "197"^^xsd:integer ;
    skos:note "Regulations may limit application of this Division" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
