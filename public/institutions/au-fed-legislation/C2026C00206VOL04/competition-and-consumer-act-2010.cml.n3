doc:sch-2-sec-124-ss-2 a cof:Section ;
    cof:title "124(2) Obligations of a supplier in relation to a recall notice" ;
    values:kind "subsection" ;
    values:originalText "(2) If the supplier undertakes to repair the consumer goods, the supplier must cause the goods to be repaired so that:  (a) any defect in the goods identified in the recall notice is remedied; and  (b) if a safety standard for the goods is in force—the goods comply with that standard." ;
    cof:pageNumber "220"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-124-ss-3 a cml:Concept ;
    skos:prefLabel "124(3) Obligations of a supplier in relation to a recall notice"@en ;
    cml:realizedBy doc:sch-2-sec-124-ss-3 ;
    values:originalText "(3) If the supplier undertakes to replace the consumer goods, the supplier must replace the goods with similar consumer goods which:  (a) if a defect in, or a dangerous characteristic of, the goods to be replaced was identified in the recall notice—do not contain that defect or have that characteristic; and  (b) if a safety standard for the goods to be replaced is in force— comply with that standard." ;
    skos:definition "(3) If the supplier undertakes to replace the consumer goods, the supplier must replace the goods with similar consumer goods which:  (a) if a defect in, or a dangerous characteristic of, the goods to be replaced was identified in the recall notice—do not contain that defect or have that characteristic; and  (b) if a safety standard for the goods to be replaced is in force— comply with that standard."@en ;
    cml:integrityHash "c809c09bf00d23be54923c2c66d25c8870d2022ef9a139ce8a1a7e2273359c1a" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-124 ;
    cof:pageNumber "220"^^xsd:integer ;
    skos:note "Supplier must replace goods with similar consumer goods that do not contain a defect or have a dangerous characteristic." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.220" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-124-ss-3-norm .
