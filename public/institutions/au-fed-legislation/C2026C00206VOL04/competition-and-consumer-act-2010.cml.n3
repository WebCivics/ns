doc:sch-2-sec-164-ss-3 a cof:Section ;
    cof:title "164(3) Participation in pyramid schemes" ;
    values:kind "subsection" ;
    values:originalText "(3) Subsections (1) and (2) are offences of strict liability. Penalty" ;
    cof:pageNumber "267"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-164-ss-4 a cml:Concept ;
    skos:prefLabel "164(4) Participation in pyramid schemes"@en ;
    cml:realizedBy doc:sch-2-sec-164-ss-4 ;
    values:originalText "(4) An offence against subsection (1) or (2) committed by a body corporate is punishable on conviction by a fine of not more than the greater of the following:  (a) $100,000,000;  (b) if the court can determine the value of the benefit that the body corporate, and any body corporate related to the body corporate, have obtained directly or indirectly and that is reasonably attributable to the commission of the offence—3 times the value of that benefit;  (c) if the court cannot determine the value of that benefit—30% of the body corporate’s adjusted turnover during the breach turnover period for the offence." ;
    skos:definition "(4) An offence against subsection (1) or (2) committed by a body corporate is punishable on conviction by a fine of not more than the greater of the following:  (a) $100,000,000;  (b) if the court can determine the value of the benefit that the body corporate, and any body corporate related to the body corporate, have obtained directly or indirectly and that is reasonably attributable to the commission of the offence—3 times the value of that benefit;  (c) if the court cannot determine the value of that benefit—30% of the body corporate’s adjusted turnover during the breach turnover period for the offence."@en ;
    cml:integrityHash "522080448efa3323ad7f24bb9dcbd549bd4080df19ef3bf2fac0e76f541eeff1" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-164 ;
    cof:pageNumber "267"^^xsd:integer ;
    skos:note "Participation in pyramid schemes is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
