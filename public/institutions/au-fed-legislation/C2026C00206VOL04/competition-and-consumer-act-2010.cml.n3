concept:competition-and-consumer-act-2010-sch-2-sec-185 a cml:Concept ;
    skos:prefLabel "185 Application of this Division to supplies to third parties"@en ;
    cml:realizedBy doc:sch-2-sec-185 ;
    values:originalText "This Division applies in relation to a contract for the supply of goods or services to a consumer (the original consumer) on the order of another person as if the other person were also the consumer." ;
