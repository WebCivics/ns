doc:sch-2-sec-232-ss-2 a cof:Section ;
    cof:title "232(2) Injunctions" ;
    values:kind "subsection" ;
    values:originalText "(2) The court may grant the injunction on application by the regulator or any other person." ;
    cof:pageNumber "330"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4 a cml:Concept ;
    skos:prefLabel "232(4) Injunctions"@en ;
    cml:realizedBy doc:sch-2-sec-232-ss-4 ;
    values:originalText "(4) The power of the court to grant an injunction under subsection (1) restraining a person from engaging in conduct may be exercised:  (a) whether or not it appears to the court that the person intends to engage again, or to continue to engage, in conduct of a kind referred to in that subsection; and  (b) whether or not the person has previously engaged in conduct of that kind; and  (c) whether or not there is an imminent danger of substantial damage to any other person if the person engages in conduct of that kind." ;
    skos:definition "(4) The power of the court to grant an injunction under subsection (1) restraining a person from engaging in conduct may be exercised:  (a) whether or not it appears to the court that the person intends to engage again, or to continue to engage, in conduct of a kind referred to in that subsection; and  (b) whether or not the person has previously engaged in conduct of that kind; and  (c) whether or not there is an imminent danger of substantial damage to any other person if the person engages in conduct of that kind."@en ;
    cml:integrityHash "f1ad43217a7ccc4aa874905764025db99da377d05c769a93d019dff72476f12f" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-232 ;
    cof:pageNumber "330"^^xsd:integer ;
    skos:note "Court power to grant injunction without intent or previous conduct" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.330" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-232-ss-4-norm .
