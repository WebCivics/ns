concept:competition-and-consumer-act-2010-sch-2-sec-267-ss-5 a cml:Concept ;
    skos:prefLabel "267(5) Action against suppliers of services"@en ;
    cml:realizedBy doc:sch-2-sec-267-ss-5 ;
