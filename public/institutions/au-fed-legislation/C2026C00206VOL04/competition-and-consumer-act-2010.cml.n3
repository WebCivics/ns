concept:competition-and-consumer-act-2010-sch-2-sec-307 a cml:Concept ;
    skos:prefLabel "307 Saving—safety standards declared by the Minister"@en ;
    cml:realizedBy doc:sch-2-sec-307 ;
    values:originalText "Despite the repeal of section 105 by the amending Schedule, a safety standard that:  (a) was declared for the purposes of that section; and  (b) was in force immediately before the commencement of Part 1 of the amending Schedule; continues in force (and may be dealt with) on and after the commencement of Part 1 of the amending Schedule as if it were made for the purposes of section 104, as amended by the amending Schedule." ;
    skos:definition "Despite the repeal of section 105 by the amending Schedule, a safety standard that:  (a) was declared for the purposes of that section; and  (b) was in force immediately before the commencement of Part 1 of the amending Schedule; continues in force (and may be dealt with) on and after the commencement of Part 1 of the amending Schedule as if it were made for the purposes of section 104, as amended by the amending Schedule."@en ;
    cml:integrityHash "5d2a686ed25d1953c623dfcab1fdd7886fd0c66f239315437bb9519ba007b0c4" ;
    cof:pageNumber "392"^^xsd:integer ;
    skos:note "Safety standards continue in force despite repeal of section 105." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.392" ;
