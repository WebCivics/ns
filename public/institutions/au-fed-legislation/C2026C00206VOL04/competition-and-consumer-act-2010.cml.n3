concept:competition-and-consumer-act-2010-sch-2-sec-4-ss-4 a cml:Concept ;
    skos:prefLabel "4(4) Misleading representations with respect to future matters"@en ;
    cml:realizedBy doc:sch-2-sec-4-ss-4 ;
    values:originalText "(4) Subsection (1) does not limit by implication the meaning of a reference in this Schedule to:  (a) a misleading representation; or  Schedule 2  The Australian Consumer Law Chapter 1  Introduction  Section 5  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (b) a representation that is misleading in a material particular; or  (c) conduct that is misleading or is likely or liable to mislead; and, in particular, does not imply that a representation that a person makes with respect to any future matter is not misleading merely because the person has reasonable grounds for making the representation. 5  When donations are treated as supplies or acquisitions" ;
    skos:definition "(4) Subsection (1) does not limit by implication the meaning of a reference in this Schedule to:  (a) a misleading representation; or  Schedule 2  The Australian Consumer Law Chapter 1  Introduction  Section 5  Competition and Consumer Act 2010  Compilation date: 27/05/2026  (b) a representation that is misleading in a material particular; or  (c) conduct that is misleading or is likely or liable to mislead; and, in particular, does not imply that a representation that a person makes with respect to any future matter is not misleading merely because the person has reasonable grounds for making the representation. 5  When donations are treated as supplies or acquisitions"@en ;
    cml:integrityHash "d750dda66375cb620b8fa44cc8c23ed2da91011a5bae82119d7fb5294ec3444e" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-4 ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "Prohibits implying a representation is not misleading if the person has reasonable grounds for making it." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
