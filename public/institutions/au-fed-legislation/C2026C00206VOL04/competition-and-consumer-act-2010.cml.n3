concept:competition-and-consumer-act-2010-sch-2-sec-77 a cml:Concept ;
    skos:prefLabel "77 Liability of suppliers for contraventions by dealers"@en ;
    cml:realizedBy doc:sch-2-sec-77 ;
    values:originalText "If:  (a) a dealer contravenes a provision of this Subdivision in relation to an unsolicited consumer agreement; and  (b) the dealer is not, or is not to be, the supplier of the goods or services to which the agreement relates; the supplier of the goods or services is also taken to have contravened that provision in relation to the agreement. Subdivision C—Requirements for unsolicited consumer agreements etc." ;
    skos:definition "If:  (a) a dealer contravenes a provision of this Subdivision in relation to an unsolicited consumer agreement; and  (b) the dealer is not, or is not to be, the supplier of the goods or services to which the agreement relates; the supplier of the goods or services is also taken to have contravened that provision in relation to the agreement. Subdivision C—Requirements for unsolicited consumer agreements etc."@en ;
    cml:integrityHash "fca839a67e8925f07e56b4709533fb8bcce78ca842c6923216de6b6de56c3f87" ;
    cof:pageNumber "179"^^xsd:integer ;
    skos:note "Supplier liable for contraventions by dealers" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
