concept:competition-and-consumer-act-2010-sch-2-sec-15 a cml:Concept ;
    skos:prefLabel "15 Contraventions of this Schedule"@en ;
    cml:realizedBy doc:sch-2-sec-15 ;
    values:originalText "Conduct is not taken, for the purposes of this Schedule, to contravene a provision of this Schedule merely because of the application of:  (a) section 23(1); or  (b) a provision of Division 1 of Part 3-2 (other than section 66(2)); or  (c) a provision of Part 3-5." ;
    skos:definition "Conduct is not taken, for the purposes of this Schedule, to contravene a provision of this Schedule merely because of the application of:  (a) section 23(1); or  (b) a provision of Division 1 of Part 3-2 (other than section 66(2)); or  (c) a provision of Part 3-5."@en ;
    cml:integrityHash "3e356626c7d07ac455988ac5fceb3c61f9a8975089838b87d277676e3cc18d5b" ;
    cof:pageNumber "118"^^xsd:integer ;
    skos:note "Exemptions from contravention of Schedule provisions" ;
