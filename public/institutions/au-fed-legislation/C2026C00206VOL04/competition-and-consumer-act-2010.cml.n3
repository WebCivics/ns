concept:competition-and-consumer-act-2010-sch-2-sec-240-ss-3 a cml:Concept ;
    skos:prefLabel "240(3) Determining whether to make a redress order etc. for"@en ;
    cml:realizedBy doc:sch-2-sec-240-ss-3 ;
    values:originalText "(3) Despite any other provision of:  (a) this Schedule; or  (b) any other law of the Commonwealth, or a State or a Territory; no claim, action or demand may be made or taken against the person by the non-party in relation to that loss or damage." ;
    skos:definition "(3) Despite any other provision of:  (a) this Schedule; or  (b) any other law of the Commonwealth, or a State or a Territory; no claim, action or demand may be made or taken against the person by the non-party in relation to that loss or damage."@en ;
    cml:integrityHash "c48a380a1b54b9de7e97d3ae35e237276dd096fdfec8d51418fac4ee5c71f28b" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-240 ;
    cof:pageNumber "336"^^xsd:integer ;
    skos:note "Court does not need to make a finding about non-parties in relation to contravening conduct or declared term. No claim or action can be made against the non-party in relation to a loss or damage." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
