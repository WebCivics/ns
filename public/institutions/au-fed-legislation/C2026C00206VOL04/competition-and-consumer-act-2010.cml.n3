    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-136-ss-2 ;
    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-136-ss-3 ;
    cml:curationStatus cml:Proposed ;
