    cml:operator "until" ;
    cml:logicSummary "Injunction can be granted until the person does the act or thing." ;
    cml:premiseText "(7) The power of the court to grant an injunction under subsection (1)" ;
    cml:conclusionText "The injunction can be granted until the person does the act or thing." ;
    cml:executionSurface "modalities::temporal_ltl" ;
