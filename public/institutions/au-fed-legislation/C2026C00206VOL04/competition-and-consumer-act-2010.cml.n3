doc:sch-1-sec-50-ss-3a a cof:Section ;
    cof:title "50(3A) Prohibition of acquisitions that would result in a substantial" ;
    values:kind "subsection" ;
    values:originalText "(3A) Subsections 46(3) to (8) have effect for the purposes of this section as if:  (a) a reference in those subsections (other than in paragraph 46(8)(b)) to section 46 included a reference to this section; and  (b) a reference in those subsections to a market were a reference to a market (within the meaning of this section). Note: Subsections 46(3) to (8) contain matters relevant to working out whether a corporation has a substantial degree of power in a market." ;
    cof:pageNumber "69"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-1-sec-50-ss-3b a cml:Concept ;
    skos:prefLabel "50(3B) Prohibition of acquisitions that would result in a substantial"@en ;
    cml:realizedBy doc:sch-1-sec-50-ss-3b ;
    values:originalText "(3B) To avoid doubt, subsection (3) does not affect the meaning of substantially lessening competition outside this section.  Schedule 1  The Schedule version of Part IV" ;
    skos:definition "(3B) To avoid doubt, subsection (3) does not affect the meaning of substantially lessening competition outside this section.  Schedule 1  The Schedule version of Part IV"@en ;
    cml:integrityHash "7f28a29c32707cc2db60fde19d75ea35c622e52e913b2bffb8e17dff09d21ce4" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-1-sec-50 ;
    cof:pageNumber "69"^^xsd:integer ;
    skos:note "Acquisitions that would result in a substantial lessening of competition are prohibited." ;
