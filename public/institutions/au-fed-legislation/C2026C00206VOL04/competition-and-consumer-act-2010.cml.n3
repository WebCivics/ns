doc:sch-2-sec-19-ss-2 a cof:Section ;
    cof:title "19(2) Application of this Part to information providers" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply to a publication of an advertisement." ;
    cof:pageNumber "120"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-19-ss-3 a cml:Concept ;
    skos:prefLabel "19(3) Application of this Part to information providers"@en ;
    cml:realizedBy doc:sch-2-sec-19-ss-3 ;
    values:originalText "(3) Subsection (1) does not apply to a publication of matter in connection with the supply or possible supply of, or the promotion by any means of the supply or use of, goods or services (the publicised goods or services), if:  (a) the publicised goods or services were goods or services of a kind supplied by the information provider or, if the  The Australian Consumer Law  Schedule 2 General protections  Chapter 2 Misleading or deceptive conduct  Part 2-1  Section 19  Competition and Consumer Act 2010  Compilation date: 27/05/2026  information provider is a body corporate, by a body corporate that is related to the information provider; or  (b) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a person who supplies goods or services of the same kind as the publicised goods or services; or  (c) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a body corporate that is related to a body corporate that supplies goods or services of the same kind as the publicised goods or services." ;
    skos:definition "(3) Subsection (1) does not apply to a publication of matter in connection with the supply or possible supply of, or the promotion by any means of the supply or use of, goods or services (the publicised goods or services), if:  (a) the publicised goods or services were goods or services of a kind supplied by the information provider or, if the  The Australian Consumer Law  Schedule 2 General protections  Chapter 2 Misleading or deceptive conduct  Part 2-1  Section 19  Competition and Consumer Act 2010  Compilation date: 27/05/2026  information provider is a body corporate, by a body corporate that is related to the information provider; or  (b) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a person who supplies goods or services of the same kind as the publicised goods or services; or  (c) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a body corporate that is related to a body corporate that supplies goods or services of the same kind as the publicised goods or services."@en ;
    cml:integrityHash "cda96fa752a32a1f8acb4cb2cf8263e04da0696e29721dabffce670c12f9e771" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-19 ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Exemptions from subsection (1) for certain publications" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.120" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-19-ss-3-norm .
