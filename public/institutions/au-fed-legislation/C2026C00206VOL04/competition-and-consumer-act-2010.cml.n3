    cml:hasPart concept:competition-and-consumer-act-2010-sch-2-sec-39-ss-6 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
