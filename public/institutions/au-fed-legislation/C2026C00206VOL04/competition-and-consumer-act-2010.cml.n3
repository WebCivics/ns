doc:sch-2-sec-99-ss-2 a cof:Section ;
    cof:title "99(2) Effect of termination" ;
    values:kind "subsection" ;
    values:originalText "(2) The supplier is entitled to recover any unpaid termination charge from the consumer as a debt if the amounts paid by the consumer under the lay-by agreement are not enough to cover the charge.  Schedule 2  The Australian Consumer Law Chapter 3  Specific protections" ;
    cof:pageNumber "193"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-99a a cml:Concept ;
    skos:prefLabel "99A Meaning of gift card"@en ;
    cml:realizedBy doc:sch-2-sec-99a ;
    values:originalText "A gift card is:  (a) an article (whether in physical or electronic form) that:  (i) is of a kind that is commonly known as a gift card or gift voucher; and  (ii) is redeemable for goods or services; or  (b) an article of a kind specified in regulations made for the purposes of this paragraph; but does not include an article of a kind specified in the regulations. Subdivision B—Requirements relating to gift cards" ;
    skos:definition "A gift card is:  (a) an article (whether in physical or electronic form) that:  (i) is of a kind that is commonly known as a gift card or gift voucher; and  (ii) is redeemable for goods or services; or  (b) an article of a kind specified in regulations made for the purposes of this paragraph; but does not include an article of a kind specified in the regulations. Subdivision B—Requirements relating to gift cards"@en ;
    cml:integrityHash "8e42c82c3a0cf236fe20162f06238d306415fe09f8ca5a5b83c20ee6fbb793b6" ;
    cof:pageNumber "195"^^xsd:integer ;
    skos:note "Definition of gift card" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
