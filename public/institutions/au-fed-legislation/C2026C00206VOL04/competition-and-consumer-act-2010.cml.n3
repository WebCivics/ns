doc:sch-2-sec-137-ss-2 a cof:Section ;
    cof:title "137(2) Supplying etc. services that do not comply with information" ;
    values:kind "subsection" ;
    values:originalText "(2) A person must not, in trade or commerce, offer for supply services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "237"^^xsd:integer .

concept:competition-and-consumer-act-2010-sch-2-sec-137-ss-3 a cml:Concept ;
    skos:prefLabel "137(3) Supplying etc. services that do not comply with information"@en ;
    cml:realizedBy doc:sch-2-sec-137-ss-3 ;
    values:originalText "(3) If:  (a) a person (the supplier) supplies services in contravention of subsection (1) or (2); and  (b) another person suffers loss or damage because, contrary to the information standard, he or she was not provided with particular information in relation to the services; and  (c) the other person would not have suffered the loss or damage if the supplier had complied with the information standard; the other person is taken, for the purposes of this Schedule, to have suffered the loss or damage because of that supply." ;
    skos:definition "(3) If:  (a) a person (the supplier) supplies services in contravention of subsection (1) or (2); and  (b) another person suffers loss or damage because, contrary to the information standard, he or she was not provided with particular information in relation to the services; and  (c) the other person would not have suffered the loss or damage if the supplier had complied with the information standard; the other person is taken, for the purposes of this Schedule, to have suffered the loss or damage because of that supply."@en ;
    cml:integrityHash "9a71ec2f9aac3be87c42173c5e280eceaddffb4b4ee9c30e261b61145002d404" ;
    values:partOf concept:competition-and-consumer-act-2010-sch-2-sec-137 ;
    cof:pageNumber "237"^^xsd:integer ;
    skos:note "Supplier must provide particular information to avoid liability for loss or damage." ;
    dc:description "particular information" ;
