concept:competition-and-consumer-act-2010-sch-1-sec-45ay a cml:Concept ;
    skos:prefLabel "45AY Stayed acquisitions must not be put into effect"@en ;
    cml:realizedBy doc:sch-1-sec-45ay ;
    values:originalText "A person contravenes this section if:  (a) the person puts an acquisition into effect; and  (b) the acquisition is stayed. Note 1: For when an acquisition is stayed, see section 51ABE. Note 2: For enforcement, see Part VI.  The Schedule version of Part IV  Schedule 1 Schedule version of Part IV  Part 1 Acquisitions  Division 1A  Section 45AZ  Competition and Consumer Act 2010  Compilation date: 27/05/2026" ;
    skos:definition "A person contravenes this section if:  (a) the person puts an acquisition into effect; and  (b) the acquisition is stayed. Note 1: For when an acquisition is stayed, see section 51ABE. Note 2: For enforcement, see Part VI.  The Schedule version of Part IV  Schedule 1 Schedule version of Part IV  Part 1 Acquisitions  Division 1A  Section 45AZ  Competition and Consumer Act 2010  Compilation date: 27/05/2026"@en ;
    cml:integrityHash "9067834e92d4f251e61a645ecebd2c757b995833901116a7f0f5ca21e71757f7" ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "Acquisitions stayed must not be put into effect" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.42" ;
