    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sch-2-sec-227 cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-alleninterval-2 .
concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "The court must give preference to making an order for compensation between the time the defendant is ordered to pay the penalty and the time the defendant is able to pay the compensation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sch-2-sec-227 cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-argumentation-3 .
concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "IF-THEN" ;
    cml:logicSummary "If the defendant does not have sufficient financial resources, then the court must give preference to making an order for compensation." ;
    cml:premiseText "The defendant does not have sufficient financial resources." ;
    cml:conclusionText "The court must give preference to making an order for compensation." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sch-2-sec-227 cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-diffusion-4 .
concept:competition-and-consumer-act-2010-sch-2-sec-227-logic-diffusion-4 a cml:LogicApplication ;
