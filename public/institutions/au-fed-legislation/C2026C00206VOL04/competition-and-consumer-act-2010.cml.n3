concept:competition-and-consumer-act-2010-sch-2-sec-209 a cml:Concept ;
    skos:prefLabel "209 Publication of advertisements in the ordinary course of business"@en ;
    cml:realizedBy doc:sch-2-sec-209 ;
    values:originalText "In a prosecution for a contravention of a provision of this Chapter that was committed by publication of an advertisement, it is a defence if the defendant proves that:  (a) the defendant is a person whose business it is to publish or arrange for the publication of advertisements; and  (b) the defendant received the advertisement for publication in the ordinary course of business; and  (c) the defendant did not know, and had no reason to suspect, that its publication would amount to a contravention of such a provision." ;
    skos:definition "In a prosecution for a contravention of a provision of this Chapter that was committed by publication of an advertisement, it is a defence if the defendant proves that:  (a) the defendant is a person whose business it is to publish or arrange for the publication of advertisements; and  (b) the defendant received the advertisement for publication in the ordinary course of business; and  (c) the defendant did not know, and had no reason to suspect, that its publication would amount to a contravention of such a provision."@en ;
    cml:integrityHash "0e396b1f670d04cacdafdf33e9d5b494fa12f3990e76c9b7f3fb4bd560452cfe" ;
    cof:pageNumber "310"^^xsd:integer ;
    skos:note "Defendant must prove they are a business publisher and received advertisement in ordinary course of business to avoid prosecution for contravention." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-act-2010.pdf> ;
    dc:source "competition-and-consumer-act-2010.pdf, p.310" ;
    cml:asserts concept:competition-and-consumer-act-2010-sch-2-sec-209-norm .
