      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "23576f0ed2ec5650fa75eee4ad68dcc44a0f7204586fc04f1a76be3c9b68dacf",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
