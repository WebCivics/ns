    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The assistance provided by the chief officer is contained within the timeframe of the inspection of records.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relationship between actions",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:premiseText": "The chief officer must ensure that members of staff of the agency assist the Ombudsman with inspection of records within a reasonable timeframe."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The chief officer's provision of assistance implies that they have met their obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Inference from premises to conclusion",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "If the chief officer has a duty to assist the Ombudsman, then they must provide assistance within a reasonable timeframe."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The chief officer's recognition of their responsibility implies that they have met their obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognition of patterns or relationships",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "RECOGNIZES",
      "cml:premiseText": "The chief officer recognizes their responsibility to assist the Ombudsman."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The chief officer must ensure that members of staff of the agency give the Ombudsman any assistance the Ombudsman reasonably requires.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to assist Ombudsman",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Chief officer has a duty to assist the Ombudsman"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The assistance provided by the chief officer diffuses to the Ombudsman and other relevant parties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spread of information or influence",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "SPREADS",
      "cml:premiseText": "The chief officer's provision of assistance spreads to the Ombudsman and other relevant parties."
    },
