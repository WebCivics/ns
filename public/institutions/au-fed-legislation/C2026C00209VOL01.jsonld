      "cml:premiseText": "(3) A warrant under this section shall specify the period for which it is to remain in force, being a period that does not exceed 48 hours,"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-10-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Attorney-General may revoke the warrant at any time before expiration.",
