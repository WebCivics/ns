    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.421",
      "skos:note": "Chief officer must assist Ombudsman with inspection of records.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "186B(4) Inspection of records"
      },
      "wasDerivedFrom": "telecommunications-interception-and-access-act-1979.pdf",
      "asserts": [
