      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180h-ss-2",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.384",
      "skos:note": "Authorized officer must not disclose information or documents of a particular person if they are a journalist or their employer.",
