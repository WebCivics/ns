      "skos:prefLabel": {
        "@language": "en",
        "@value": "107R(1) Revoking a foreign preservation notice"
      },
      "wasDerivedFrom": "telecommunications-interception-and-access-act-1979.pdf",
      "asserts": [
        "concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-norm",
        "concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "2bb8e4ef7c3c24525ae4081dcad86504b103913041563218572c354259671e81",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-interception-and-access-act-1979#sec-107r-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-interception-and-access-act-1979-sec-107r"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "then the Australian Federal Police must, by the third working day after the end of that period, revoke the preservation notice by giving the carrier to whom it was given written notice of the revocation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Entity must revoke preservation notice after 180 days without access request",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) an entity requests under section 107P the Australian Federal Police to arrange for the preservation of stored communications that are held by a carrier; and (b) in response to the request, the Australian Federal Police gives a foreign preservation notice to the carrier in relation to those stored communications under subsection 107N(1); and (c) during the period of 180 days starting on the day the carrier was given the notice, the entity did not make an access request to the Attorney-General to arrange for access to those communications;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-norm",
