    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.421",
      "skos:note": "The Ombudsman may inspect records to determine compliance with Part 15 of the Telecommunications Act 1997.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "186B(1A) Inspection of records"
      },
      "wasDerivedFrom": "telecommunications-interception-and-access-act-1979.pdf",
      "asserts": [
        "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-norm",
