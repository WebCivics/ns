        "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-alleninterval-2",
        "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-ltl-3",
        "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-diffusion-4",
        "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "2ed7fab2ed404fe15a8c42cfe6204b0d5d25485d495882e4dd30661ecdf2fa0b",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-interception-and-access-act-1979#sec-186b-ss-1a",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-interception-and-access-act-1979-sec-186b"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The records are related to the performance of a function or exercise of power within a certain time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Records must be related to the performance of a function or exercise of power within a certain time frame",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(b) an enforcement agency, except the ACC or any agency, or part of an agency performing any functions, prescribed by regulations made under the Ombudsman Act 1976 for the purposes of subsection (1B) of this section, has records that relate to the performance of that function or the exercise of that power;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The records are related to the performance of a function or exercise of power in order to determine compliance with Part 15 of the Telecommunications Act 1997.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Records must be related to the performance of a function or exercise of power in order to determine compliance with Part 15 of the Telecommunications Act 1997",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "(b) an enforcement agency, except the ACC or any agency, or part of an agency performing any functions, prescribed by regulations made under the Ombudsman Act 1976 for the purposes of subsection (1B) of this section, has records that relate to the performance of that function or the exercise of that power;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to provide records.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to provide records",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:premiseText": "The Ombudsman may inspect records."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The records are related to the performance of a function or exercise of power and also meet certain conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Records must be related to the performance of a function or exercise of power and also meet certain conditions",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "AND",
      "cml:premiseText": "(a) the performance of a function, or the exercise of a power, conferred by Part 15 of the Telecommunications Act 1997 is in connection with..."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The records are related to the performance of a function or exercise of power in at least one of two possible ways.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Records must be related to the performance of a function or exercise of power in at least one of two possible ways",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "OR",
      "cml:premiseText": "(a) the performance of a function, or the exercise of a power, conferred by Part 15 of the Telecommunications Act 1997 is in connection with..."
    },
