    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.310",
      "skos:note": "Accessing stored communications without knowledge of sender and recipient is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "108(1) Stored communications not to be accessed"
      },
      "wasDerivedFrom": "telecommunications-interception-and-access-act-1979.pdf",
      "asserts": [
        "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1-norm",
