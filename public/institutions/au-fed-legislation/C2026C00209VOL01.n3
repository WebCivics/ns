concept:telecommunications-interception-and-access-act-1979-sec-57-ss-7 cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-57-ss-7-logic-alleninterval-2 .
concept:telecommunications-interception-and-access-act-1979-sec-57-ss-7-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines temporal interval for revocation" ;
    cml:premiseText "(7) For the purposes of the application of subsection (1) to a community safety supervision order warrant issued on the ground that a community safety supervision order was in force, that ground is taken to have ceased to exist if, and only if, neither that community safety supervision order, nor any succeeding community safety supervision order, is in force." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

