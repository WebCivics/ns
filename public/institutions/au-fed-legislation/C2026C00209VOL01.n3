    skos:prefLabel "107R(1) Revoking a foreign preservation notice"@en ;
    cml:realizedBy doc:sec-107r-ss-1 ;
    cml:integrityHash "2bb8e4ef7c3c24525ae4081dcad86504b103913041563218572c354259671e81" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-107r ;
    skos:note "Revocation of foreign preservation notice after 180 days without access request" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
