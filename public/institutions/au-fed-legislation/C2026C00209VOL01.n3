concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1 cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-logic-deontic-1 .
concept:telecommunications-interception-and-access-act-1979-sec-107r-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Entity must revoke preservation notice after 180 days without access request" ;
    cml:premiseText "(a) an entity requests under section 107P the Australian Federal Police to arrange for the preservation of stored communications that are held by a carrier; and (b) in response to the request, the Australian Federal Police gives a foreign preservation notice to the carrier in relation to those stored communications under subsection 107N(1); and (c) during the period of 180 days starting on the day the carrier was given the notice, the entity did not make an access request to the Attorney-General to arrange for access to those communications;" ;
    cml:conclusionText "then the Australian Federal Police must, by the third working day after the end of that period, revoke the preservation notice by giving the carrier to whom it was given written notice of the revocation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


