concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1 a cml:Concept ;
    skos:prefLabel "108(1) Stored communications not to be accessed"@en ;
    cml:realizedBy doc:sec-108-ss-1 ;
    cml:integrityHash "23576f0ed2ec5650fa75eee4ad68dcc44a0f7204586fc04f1a76be3c9b68dacf" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-108 ;
    skos:note "Accessing stored communications without knowledge of sender and recipient is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
