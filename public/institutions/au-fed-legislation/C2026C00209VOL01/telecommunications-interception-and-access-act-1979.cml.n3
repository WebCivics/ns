    cml:premiseText "The chief officer recognizes their responsibility to assist the Ombudsman." ;
    cml:conclusionText "The chief officer's recognition of their responsibility implies that they have met their obligation." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
