concept:telecommunications-interception-and-access-act-1979-sec-131 a cml:Concept ;
    skos:prefLabel "131 Certified copies of stored communications warrants"@en ;
    cml:realizedBy doc:sec-131 ;
    values:originalText "A document certified in writing by a certifying officer of a criminal law-enforcement agency to be a true copy of a stored communications warrant is to be received in evidence in an exempt proceeding as if it were the original warrant." ;
    skos:definition "A document certified in writing by a certifying officer of a criminal law-enforcement agency to be a true copy of a stored communications warrant is to be received in evidence in an exempt proceeding as if it were the original warrant."@en ;
    cml:integrityHash "35413f90ca11d1c47471725b80e987640c3429cb4ccdfada51b2c80df5dba9a3" ;
    cof:pageNumber "333"^^xsd:integer ;
    skos:note "Exempt proceeding must receive certified copy of stored communications warrant as if it were the original." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.333" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-131-norm .
