concept:telecommunications-interception-and-access-act-1979-sec-64-ss-3 a cml:Concept ;
    skos:prefLabel "64(3) Dealing in connection with Organisation’s functions"@en ;
    cml:realizedBy doc:sec-64-ss-3 ;
    values:originalText "(3) Subsections (1) and (2) do not apply to information:  (a) obtained by a person referred to in paragraph 55(3)(c) or (d) by intercepting a communication when exercising authority under a warrant issued to an agency; or  (b) communicated, in accordance with section 66, to a person referred to in paragraph 55(3)(c); or  (c) that is interception warrant information in relation to a warrant issued to an agency; unless the information has been communicated to the Director-General of Security under section 68." ;
    skos:definition "(3) Subsections (1) and (2) do not apply to information:  (a) obtained by a person referred to in paragraph 55(3)(c) or (d) by intercepting a communication when exercising authority under a warrant issued to an agency; or  (b) communicated, in accordance with section 66, to a person referred to in paragraph 55(3)(c); or  (c) that is interception warrant information in relation to a warrant issued to an agency; unless the information has been communicated to the Director-General of Security under section 68."@en ;
    cml:integrityHash "90ccd32eb508dbe454a774fc75ef74ced820b1d9470c5e4bb33ba9e5f681dfe1" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-64 ;
    cof:pageNumber "226"^^xsd:integer ;
    skos:note "Exemptions from subsections (1) and (2)" ;
    cml:curationStatus cml:Proposed ;
