doc:sec-180m a cof:Section ;
    cof:title "180M Issuing a journalist information warrant in an emergency" ;
    values:kind "section" ;
    values:originalText "(1) The Director-General of Security may issue a journalist information warrant in relation to a particular person if:  (a) a request under section 180J has been made for the issue of a journalist information warrant in relation to the particular person; and  (b) the Attorney-General has not, to the knowledge of the Director-General, made a decision under section 180L in relation to the request; and  (c) within the preceding period of 3 months:  (i) the Attorney-General has not refused to issue a journalist information warrant in relation to the particular person; and  (ii) the Director-General has not issued such a journalist information warrant; and  (d) the Director-General is satisfied that, security will be, or is likely to be, seriously prejudiced if the access to which the request relates does not begin before a journalist information warrant can be issued and made available by the Attorney-General; and  Chapter 4  Access to telecommunications data" ;
    cof:pageNumber "387"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-180n a cml:Concept ;
    skos:prefLabel "180N Duration of a journalist information warrant"@en ;
    cml:realizedBy doc:sec-180n ;
    values:originalText "A journalist information warrant issued under section 180L must specify the period (not exceeding 6 months) for which it is to remain in force. The Attorney-General may revoke the warrant at any time before the end of the specified period.  Chapter 4  Access to telecommunications data" ;
    skos:definition "A journalist information warrant issued under section 180L must specify the period (not exceeding 6 months) for which it is to remain in force. The Attorney-General may revoke the warrant at any time before the end of the specified period.  Chapter 4  Access to telecommunications data"@en ;
    cml:integrityHash "ef76b301a5224710f9639c44b9601c82f1308c2725e271cefa2b9d4394cdf946" ;
    cof:pageNumber "389"^^xsd:integer ;
    skos:note "A journalist information warrant must specify a duration of up to 6 months." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
