    cml:logicSummary "Recurring trace relation" ;
    cml:premiseText "A reference in this Act to an officer of a Territory includes a person holding or acting in an office or appointment, or employed under a law of the Territory." ;
    cml:conclusionText "This person is included in the recurring trace of the reference." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

