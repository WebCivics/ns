concept:telecommunications-interception-and-access-act-1979-sec-126 a cml:Concept ;
    skos:prefLabel "126 Limit on authority conferred by warrant"@en ;
    cml:realizedBy doc:sec-126 ;
    values:originalText "A stored communications warrant does not authorise access to stored communications unless notification of the issue of the warrant has been received under section 121 by an authorised representative of the carrier holding the stored communications." ;
    skos:definition "A stored communications warrant does not authorise access to stored communications unless notification of the issue of the warrant has been received under section 121 by an authorised representative of the carrier holding the stored communications."@en ;
    cml:integrityHash "73b760ecfb744b607b2ac8fbc6902c34b253b721f7c8f0e9c236cfe00a4c2c7a" ;
    cof:pageNumber "330"^^xsd:integer ;
    skos:note "Stored communications warrant does not authorize access unless notification is received by authorized representative." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
