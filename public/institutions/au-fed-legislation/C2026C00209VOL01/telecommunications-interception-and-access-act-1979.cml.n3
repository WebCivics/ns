concept:telecommunications-interception-and-access-act-1979-sec-34 a cml:Concept ;
    skos:prefLabel "34 Declaration of an eligible authority of a State as an agency"@en ;
    cml:realizedBy doc:sec-34 ;
    values:originalText "Subject to section 35, the Minister may, by legislative instrument and at the request of the Premier of a State, declare an eligible authority of that State to be an agency for the purposes of this Act. Note: The declaration may also authorise the eligible authority to apply for" ;
    skos:definition "Subject to section 35, the Minister may, by legislative instrument and at the request of the Premier of a State, declare an eligible authority of that State to be an agency for the purposes of this Act. Note: The declaration may also authorise the eligible authority to apply for"@en ;
    cml:integrityHash "2dffda7438416180b1b3edcee36763b05a8c2cadddb0a98c6f406ff7d7de6824" ;
