concept:telecommunications-interception-and-access-act-1979-sec-100 a cml:Concept ;
    skos:prefLabel "100 Report to set out how many applications made and warrants"@en ;
    cml:realizedBy doc:sec-100 ;
    values:originalText "issued  (1) The report shall set out, for each Commonwealth agency, and for each eligible authority of a State that was an agency at any time during that year:  (a) the relevant statistics about applications for Part 2-5 warrants that the agency or authority made during that year; and  (b) the relevant statistics about telephone applications for" ;
    skos:definition "issued  (1) The report shall set out, for each Commonwealth agency, and for each eligible authority of a State that was an agency at any time during that year:  (a) the relevant statistics about applications for Part 2-5 warrants that the agency or authority made during that year; and  (b) the relevant statistics about telephone applications for"@en ;
    cml:integrityHash "cc45b78eaf10eb608d34369e5160c462aff013bcf35df6d8b75fbea59e10bded" ;
    cof:pageNumber "276"^^xsd:integer ;
    skos:note "Report on applications and warrants" ;
    cml:curationStatus cml:Proposed ;
