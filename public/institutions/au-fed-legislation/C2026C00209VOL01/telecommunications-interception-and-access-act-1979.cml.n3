concept:telecommunications-interception-and-access-act-1979-sec-93 a cml:Concept ;
    skos:prefLabel "93 Annual reports to Minister about interceptions under Part 2-3"@en ;
    cml:realizedBy doc:sec-93 ;
    values:originalText "The Managing Director of a carrier shall, as soon as practicable after each 30 June, give to the Minister a written report about the interceptions carried out by employees of the carrier pursuant to requests made, or purporting to be made, under section 30 during the year ending on that 30 June." ;
    skos:definition "The Managing Director of a carrier shall, as soon as practicable after each 30 June, give to the Minister a written report about the interceptions carried out by employees of the carrier pursuant to requests made, or purporting to be made, under section 30 during the year ending on that 30 June."@en ;
    cml:integrityHash "d02b24f1fd2f03e94e87025982d553be9badb2292719df0a3d1386fb0b151983" ;
    cof:pageNumber "271"^^xsd:integer ;
    skos:note "Annual report on interceptions by employees" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.271" ;
