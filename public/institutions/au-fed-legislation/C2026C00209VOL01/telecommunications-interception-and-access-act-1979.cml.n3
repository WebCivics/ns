doc:sec-105-ss-2 a cof:Section ;
    cof:title "105(2) Contravention of section 7 or 63" ;
    values:kind "subsection" ;
    values:originalText "(2) An offence against subsection 7(1) or section 63 is an indictable offence and, subject to this section, is punishable on conviction by imprisonment for a period not exceeding 2 years." ;
    cof:pageNumber "290"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-105-ss-3 a cml:Concept ;
    skos:prefLabel "105(3) Contravention of section 7 or 63"@en ;
    cml:realizedBy doc:sec-105-ss-3 ;
    values:originalText "(3) Notwithstanding that an offence against subsection 7(1) or section 63 is an indictable offence, a court of summary jurisdiction may hear and determine proceedings in respect of such an offence if, and only if:  (a) the proceedings are brought in the name of the Attorney-General or the Director of Public Prosecutions;  (b) the defendant and the prosecutor consent; and  (c) the court is satisfied that it is proper for the court to hear and determine proceedings in respect of the offence." ;
    skos:definition "(3) Notwithstanding that an offence against subsection 7(1) or section 63 is an indictable offence, a court of summary jurisdiction may hear and determine proceedings in respect of such an offence if, and only if:  (a) the proceedings are brought in the name of the Attorney-General or the Director of Public Prosecutions;  (b) the defendant and the prosecutor consent; and  (c) the court is satisfied that it is proper for the court to hear and determine proceedings in respect of the offence."@en ;
    cml:integrityHash "8cf5a5a78a5eb555c2a5e514eddafb513f30b2ab1ccc160b1f0e56b46df3389f" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-105 ;
    cof:pageNumber "290"^^xsd:integer ;
    skos:note "Court may hear and determine proceedings in respect of an indictable offence under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.290" ;
