concept:telecommunications-interception-and-access-act-1979-sec-31ab a cml:Concept ;
    skos:prefLabel "31AB Access to stored communications under section 31A"@en ;
    cml:realizedBy doc:sec-31ab ;
    values:originalText "authorisations  In addition to authorising interception of communications, a section 31A authorisation also authorises a person to access a stored communication if the section 31A authorisation would have authorised interception of the communication if it were still passing over a telecommunications system." ;
    skos:definition "authorisations  In addition to authorising interception of communications, a section 31A authorisation also authorises a person to access a stored communication if the section 31A authorisation would have authorised interception of the communication if it were still passing over a telecommunications system."@en ;
    cml:integrityHash "12f25ba581da26a77c65a742d0bab1097fa05a824f94cf254588d50eeb242ec1" ;
    cof:pageNumber "148"^^xsd:integer ;
    skos:note "Authorises access to stored communications under section 31A authorisation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
