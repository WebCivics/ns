concept:telecommunications-interception-and-access-act-1979-sec-10-ss-3 a cml:Concept ;
    skos:prefLabel "10(3) Issue of warrant by Director-General of Security in emergency"@en ;
    cml:realizedBy doc:sec-10-ss-3 ;
    values:originalText "(3) A warrant under this section shall specify the period for which it is to remain in force, being a period that does not exceed 48 hours, but may be revoked by the Attorney-General at any time before the expiration of the period so specified." ;
    skos:definition "(3) A warrant under this section shall specify the period for which it is to remain in force, being a period that does not exceed 48 hours, but may be revoked by the Attorney-General at any time before the expiration of the period so specified."@en ;
