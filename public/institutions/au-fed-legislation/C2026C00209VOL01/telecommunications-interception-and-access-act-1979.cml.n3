concept:telecommunications-interception-and-access-act-1979-sec-81b a cml:Concept ;
    skos:prefLabel "81B Regular submission of General Register to Minister"@en ;
    cml:realizedBy doc:sec-81b ;
    values:originalText "(1) Within 3 months after the commencement of Schedule 5 to the Telecommunications (Interception) Amendment Act 2006, the Secretary of the Department must deliver the General Register to the Minister for inspection.  (2) Once at least within each succeeding period of 3 months, the Secretary of the Department must deliver to the Minister, for inspection by the Minister, any part of the General Register that represents information recorded since the General Register, or any part of the General Register, was last delivered to the Minister." ;
    skos:definition "(1) Within 3 months after the commencement of Schedule 5 to the Telecommunications (Interception) Amendment Act 2006, the Secretary of the Department must deliver the General Register to the Minister for inspection.  (2) Once at least within each succeeding period of 3 months, the Secretary of the Department must deliver to the Minister, for inspection by the Minister, any part of the General Register that represents information recorded since the General Register, or any part of the General Register, was last delivered to the Minister."@en ;
    cml:integrityHash "f2b3c77b056dbbe54ccce2c04468a6caa5acc48326d4bddeea64d4e40e6f5b2b" ;
    cof:pageNumber "256"^^xsd:integer ;
