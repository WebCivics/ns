doc:sec-102a a cof:Section ;
    cof:title "102A Report regarding interceptions without warrant" ;
    values:kind "section" ;
    values:originalText "The report must state, for each agency referred to in subsection 7(8), the number of occasions on which an officer or staff member of the agency intercepted a communication in reliance on subsection 7(4) or (5)." ;
    cof:pageNumber "284"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-102b a cml:Concept ;
    skos:prefLabel "102B Report regarding international requests"@en ;
    cml:realizedBy doc:sec-102b ;
    values:originalText "The report must set out the number of occasions on which lawfully intercepted information or interception warrant information was communicated to any of the following:  (a) a foreign country under paragraph 68(l) or section 68A;  (b) the International Criminal Court under paragraph 68(la) or section 68A;  (c) a War Crimes Tribunal under paragraph 68(lb) or section 68A." ;
    skos:definition "The report must set out the number of occasions on which lawfully intercepted information or interception warrant information was communicated to any of the following:  (a) a foreign country under paragraph 68(l) or section 68A;  (b) the International Criminal Court under paragraph 68(la) or section 68A;  (c) a War Crimes Tribunal under paragraph 68(lb) or section 68A."@en ;
    cml:integrityHash "e487ab9b7bab7844d42d5769907d169e23a51b393728a5ded03c044b297daf57" ;
    cof:pageNumber "284"^^xsd:integer ;
    skos:note "Report must provide information on intercepted communications with foreign countries and international courts." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
