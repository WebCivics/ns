doc:sec-61-ss-5 a cof:Section ;
    cof:title "61(5) Evidentiary certificates" ;
    values:kind "subsection" ;
    values:originalText "(5) A document purporting to be a certificate issued under subsection (4) or (4A) by a certifying officer of an agency, or a certifying person, and to be signed by him or her:  Chapter 2  Interception of telecommunications" ;
    cof:pageNumber "206"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-61a a cml:Concept ;
    skos:prefLabel "61A Certified copy of warrant"@en ;
    cml:realizedBy doc:sec-61a ;
    values:originalText "A document certified in writing by a certifying officer of an agency to be a true copy of a warrant shall be received in evidence in an exempt proceeding as if it were the original warrant.  Interception of telecommunications  Chapter 2 Dealing with intercepted information etc.  Part 2-6  Section 62  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    skos:definition "A document certified in writing by a certifying officer of an agency to be a true copy of a warrant shall be received in evidence in an exempt proceeding as if it were the original warrant.  Interception of telecommunications  Chapter 2 Dealing with intercepted information etc.  Part 2-6  Section 62  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "ca29a60de978e3ddf986a242afeb96178080f1ba160a7e0317811ea2faaf5481" ;
    cof:pageNumber "208"^^xsd:integer ;
    skos:note "A document certified in writing by a certifying officer of an agency is admissible as evidence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
