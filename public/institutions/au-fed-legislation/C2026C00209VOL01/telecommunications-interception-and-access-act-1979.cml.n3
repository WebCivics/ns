concept:telecommunications-interception-and-access-act-1979-sec-43 a cml:Concept ;
    skos:prefLabel "43 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sec-43 ;
    values:originalText "The information given to a Judge or nominated ART member in connection with a telephone application to the Judge or nominated ART member:  (a) shall include particulars of the urgent circumstances because of which the person making the application on the agency’s behalf thinks it necessary to make the application by telephone;  (b) shall include each matter that, if the application had been made in writing, section 41, 42 or 48 would have required the  Chapter 2  Interception of telecommunications" ;
    skos:definition "The information given to a Judge or nominated ART member in connection with a telephone application to the Judge or nominated ART member:  (a) shall include particulars of the urgent circumstances because of which the person making the application on the agency’s behalf thinks it necessary to make the application by telephone;  (b) shall include each matter that, if the application had been made in writing, section 41, 42 or 48 would have required the  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "606280077b7e71bd3b86285a731dbe24938f8469daad2ca84d966e2c379d3202" ;
    cof:pageNumber "163"^^xsd:integer ;
    skos:note "Provide information on telephone application" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
