concept:telecommunications-interception-and-access-act-1979-sec-102a a cml:Concept ;
    skos:prefLabel "102A Report regarding interceptions without warrant"@en ;
    cml:realizedBy doc:sec-102a ;
    values:originalText "The report must state, for each agency referred to in subsection 7(8), the number of occasions on which an officer or staff member of the agency intercepted a communication in reliance on subsection 7(4) or (5)." ;
    skos:definition "The report must state, for each agency referred to in subsection 7(8), the number of occasions on which an officer or staff member of the agency intercepted a communication in reliance on subsection 7(4) or (5)."@en ;
    cml:integrityHash "664a2e012f47952912fd93b241ca765c2f67abab04fe233f5d343925fd9000f1" ;
    cof:pageNumber "284"^^xsd:integer ;
    skos:note "Agency must report interceptions without warrant." ;
    dc:description "Number of occasions" ;
