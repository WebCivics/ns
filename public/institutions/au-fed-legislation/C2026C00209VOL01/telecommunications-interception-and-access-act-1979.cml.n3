concept:telecommunications-interception-and-access-act-1979-sec-75a a cml:Concept ;
    skos:prefLabel "75A Evidence that has been given in exempt proceeding"@en ;
    cml:realizedBy doc:sec-75a ;
    values:originalText "If information is given in evidence (whether before or after the commencement of this section) in an exempt proceeding under section 74 or 75, that information, or any part of that information, may later be given in evidence in any proceeding. Note: This section was inserted as a response to the decision of the Court of Appeal of New South Wales in Wood v Beves (1997) 92 A Crim R 209.  Chapter 2  Interception of telecommunications" ;
    skos:definition "If information is given in evidence (whether before or after the commencement of this section) in an exempt proceeding under section 74 or 75, that information, or any part of that information, may later be given in evidence in any proceeding. Note: This section was inserted as a response to the decision of the Court of Appeal of New South Wales in Wood v Beves (1997) 92 A Crim R 209.  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "86d608be4993250b575572571d38d536348ca7b8cf0138e402998f4b619da8de" ;
    cof:pageNumber "245"^^xsd:integer ;
    skos:note "Permits later use of exempt proceeding evidence in other proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.245" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-75a-norm .
