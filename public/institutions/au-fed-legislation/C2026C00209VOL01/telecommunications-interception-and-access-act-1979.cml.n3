concept:telecommunications-interception-and-access-act-1979-sec-107e a cml:Concept ;
    skos:prefLabel "107E State or Territory courts—jurisdictional limits"@en ;
    cml:realizedBy doc:sec-107e ;
    values:originalText "This Part does not enable an inferior court of a State or Territory to grant remedial relief of a kind that the court is unable to grant under the law of that State or Territory." ;
    skos:definition "This Part does not enable an inferior court of a State or Territory to grant remedial relief of a kind that the court is unable to grant under the law of that State or Territory."@en ;
    cml:integrityHash "0ded6e42698722b2507238c29f1d9ec4edc797b98820dd3a6ce0ae709f419cce" ;
    cof:pageNumber "296"^^xsd:integer ;
    skos:note "No remedial relief beyond what the State/Territory law allows" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.296" ;
