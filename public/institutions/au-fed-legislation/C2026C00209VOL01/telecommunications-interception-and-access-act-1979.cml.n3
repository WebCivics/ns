concept:telecommunications-interception-and-access-act-1979-sec-72 a cml:Concept ;
    skos:prefLabel "72 Making record for purpose of permitted communication"@en ;
    cml:realizedBy doc:sec-72 ;
    values:originalText "A person who is permitted by section 63B, 63C, 63D, 63E, 65 or 65A, subsection 66(1), section 68 or subsection 71(2) to communicate particular information to another person may, for the purpose of so communicating the information in accordance with that section or subsection, make a record of the information, or cause such a record to be made." ;
    skos:definition "A person who is permitted by section 63B, 63C, 63D, 63E, 65 or 65A, subsection 66(1), section 68 or subsection 71(2) to communicate particular information to another person may, for the purpose of so communicating the information in accordance with that section or subsection, make a record of the information, or cause such a record to be made."@en ;
    cml:integrityHash "f2791c6bfa934c4303b3f05ecab55e92060c51d5f9e278a18e99bbf702661349" ;
    cof:pageNumber "243"^^xsd:integer ;
