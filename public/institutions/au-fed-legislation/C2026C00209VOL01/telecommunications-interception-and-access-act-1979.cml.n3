doc:sec-43 a cof:Section ;
    cof:title "43 Information to be given on telephone application" ;
    values:kind "section" ;
    values:originalText "The information given to a Judge or nominated ART member in connection with a telephone application to the Judge or nominated ART member:  (a) shall include particulars of the urgent circumstances because of which the person making the application on the agency’s behalf thinks it necessary to make the application by telephone;  (b) shall include each matter that, if the application had been made in writing, section 41, 42 or 48 would have required the  Chapter 2  Interception of telecommunications" ;
    cof:pageNumber "163"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-44 a cml:Concept ;
    skos:prefLabel "44 Giving further information to Judge"@en ;
    cml:realizedBy doc:sec-44 ;
    values:originalText "(1) A Judge or nominated ART member may require further information to be given in connection with an application to the Judge or nominated ART member for a warrant.  (2) The further information:  (a) shall be given on oath if the application was made in writing; and  (b) shall be given orally or otherwise, as the Judge or nominated ART member directs." ;
    skos:definition "(1) A Judge or nominated ART member may require further information to be given in connection with an application to the Judge or nominated ART member for a warrant.  (2) The further information:  (a) shall be given on oath if the application was made in writing; and  (b) shall be given orally or otherwise, as the Judge or nominated ART member directs."@en ;
    cml:integrityHash "fddb65a66e64438be1659f351adb48342c4bb2b6829cfa13e14343613fe81b07" ;
    cof:pageNumber "164"^^xsd:integer ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sec-44-ss-1 ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sec-44-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.164" .
