doc:sec-107r-ss-3 a cof:Section ;
    cof:title "107R(3) Revoking a foreign preservation notice" ;
    values:kind "subsection" ;
    values:originalText "(3) If:  (a) an entity requests under section 107P the Australian Federal Police to arrange for the preservation of stored communications that are held by a carrier; and  (b) in response to the request, the Australian Federal Police gives a foreign preservation notice to the carrier in relation to those stored communications under subsection 107N(1); and  (c) the entity withdraws the request; then the Australian Federal Police must, by the third working day after it is notified of the withdrawal, revoke the preservation notice by giving the carrier to whom it was given written notice of the revocation." ;
    cof:pageNumber "306"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-107s a cml:Concept ;
    skos:prefLabel "107S Persons who act on the AFP’s behalf"@en ;
    cml:realizedBy doc:sec-107s ;
    values:originalText "A foreign preservation notice must be given or revoked on behalf of the Australian Federal Police by an authorised officer of the Australian Federal Police.  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "A foreign preservation notice must be given or revoked on behalf of the Australian Federal Police by an authorised officer of the Australian Federal Police.  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "c4c94ef6a7647fb1687dfe877ada9facb7cad51c570754f4f6d778869e0dfdc9" ;
    cof:pageNumber "307"^^xsd:integer ;
    skos:note "Must provide foreign preservation notice on behalf of AFP" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.307" ;
