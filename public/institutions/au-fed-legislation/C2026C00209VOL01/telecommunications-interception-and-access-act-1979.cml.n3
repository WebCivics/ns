doc:sec-79aa a cof:Section ;
    cof:title "79AA Destruction of restricted records—information obtained" ;
    values:kind "section" ;
    values:originalText "before a Part 5.3 supervisory order came into force  (1) If:  (a) a restricted record is in the possession of an agency; and  (b) the restricted record relates to an interception authorised by a" ;
    cof:pageNumber "249"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-79ab a cml:Concept ;
    skos:prefLabel "79AB Destruction of restricted records—information obtained"@en ;
    cml:realizedBy doc:sec-79ab ;
    values:originalText "before a community safety supervision order came into force  (1) If:  (a) a restricted record is in the possession of an agency; and  (b) the restricted record relates to an interception authorised by a community safety supervision order warrant; and  (c) the warrant was issued for the purpose, or for purposes that include the purpose, of obtaining information that would be likely to assist in connection with determining whether the relevant community safety supervision order, or any succeeding community safety supervision order, has been, or is being, complied with; and  Chapter 2  Interception of telecommunications" ;
    skos:definition "before a community safety supervision order came into force  (1) If:  (a) a restricted record is in the possession of an agency; and  (b) the restricted record relates to an interception authorised by a community safety supervision order warrant; and  (c) the warrant was issued for the purpose, or for purposes that include the purpose, of obtaining information that would be likely to assist in connection with determining whether the relevant community safety supervision order, or any succeeding community safety supervision order, has been, or is being, complied with; and  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "c59720a8fbdadc310eec0a57a22956ef281bb5efb0791e901a1083dea6c20eeb" ;
    cof:pageNumber "249"^^xsd:integer ;
    skos:note "Prohibition on destroying restricted records obtained before a community safety supervision order came into force." ;
    cml:curationStatus cml:Proposed ;
