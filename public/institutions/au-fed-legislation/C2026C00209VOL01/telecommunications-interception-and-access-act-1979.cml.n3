concept:telecommunications-interception-and-access-act-1979-sec-80 a cml:Concept ;
    skos:prefLabel "80 Commonwealth agencies to keep documents connected with issue"@en ;
    cml:realizedBy doc:sec-80 ;
    values:originalText "of warrants  The chief officer of a Commonwealth agency must cause to be kept in the agency’s records:  (a) each warrant issued to the agency; and  (b) a copy of each notification under subsection 59A(2), being a notification given to the Secretary of the Department; and  (c) each instrument revoking such a warrant; and  (d) a copy of each certificate issued under subsection 61(4) by a certifying officer of the agency; and  (e) each authorisation by the chief officer under subsection 66(2); and  (f) a copy of each advice the chief officer gives to the Minister under subsection 103B(2) or paragraph 103B(4)(b); and  (g) each notice the chief officer receives from the Minister under paragraph 103B(3)(a) or (5)(a)." ;
    skos:definition "of warrants  The chief officer of a Commonwealth agency must cause to be kept in the agency’s records:  (a) each warrant issued to the agency; and  (b) a copy of each notification under subsection 59A(2), being a notification given to the Secretary of the Department; and  (c) each instrument revoking such a warrant; and  (d) a copy of each certificate issued under subsection 61(4) by a certifying officer of the agency; and  (e) each authorisation by the chief officer under subsection 66(2); and  (f) a copy of each advice the chief officer gives to the Minister under subsection 103B(2) or paragraph 103B(4)(b); and  (g) each notice the chief officer receives from the Minister under paragraph 103B(3)(a) or (5)(a)."@en ;
    cml:integrityHash "672c8168e3c8d605623286314f4f4cafd90f35448b2709ec7f96b5e50e54ad78" ;
    cof:pageNumber "252"^^xsd:integer ;
    skos:note "Commonwealth agencies must keep documents connected with issue." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
