doc:sec-15-ss-1b a cof:Section ;
    cof:title "15(1B) How warrants etc. to be dealt with" ;
    values:kind "subsection" ;
    values:originalText "(1B) Where:  (a) an authorised representative of a carrier has been informed, under subsection (1A), of the issue of a warrant; and  (b) the Director-General of Security is informed under paragraph (1)(a) that the warrant has been revoked; the Director-General of Security shall cause:  (c) that authorised representative to be informed forthwith of the revocation; and  (d) where, under paragraph (1)(b), the Director-General of Security receives the instrument of revocation—a copy of the instrument, certified in writing by a certifying person to be a true copy of the instrument, to be forwarded as soon as practicable to that authorised representative." ;
    cof:pageNumber "136"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-15-ss-3 a cml:Concept ;
    skos:prefLabel "15(3) How warrants etc. to be dealt with"@en ;
    cml:realizedBy doc:sec-15-ss-3 ;
    values:originalText "(3) The Attorney-General shall record on each request in writing for the issue of a warrant received by him or her from the Director-General of Security his or her decision with respect to the request and shall cause the request to be returned to the Director-General of Security." ;
    skos:definition "(3) The Attorney-General shall record on each request in writing for the issue of a warrant received by him or her from the Director-General of Security his or her decision with respect to the request and shall cause the request to be returned to the Director-General of Security."@en ;
