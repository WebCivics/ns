concept:telecommunications-interception-and-access-act-1979-sec-167 a cml:Concept ;
    skos:prefLabel "167 No limitation on other liability"@en ;
    cml:realizedBy doc:sec-167 ;
    values:originalText "No limitation  (1) This Part does not limit any liability (whether criminal or civil) that a person has under any other provision of this Act or under any other law.  Chapter 3  Preserving and accessing stored communications" ;
