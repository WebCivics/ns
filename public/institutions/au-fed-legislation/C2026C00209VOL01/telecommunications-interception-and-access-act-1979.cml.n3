    cml:premiseText "If the chief officer has a duty to assist the Ombudsman, then they must provide assistance within a reasonable timeframe." ;
    cml:conclusionText "The chief officer's provision of assistance implies that they have met their obligation." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

