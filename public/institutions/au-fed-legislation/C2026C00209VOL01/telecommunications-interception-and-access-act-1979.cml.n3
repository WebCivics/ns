concept:telecommunications-interception-and-access-act-1979-sec-107w a cml:Concept ;
    skos:prefLabel "107W How notices are to be given to carriers"@en ;
    cml:realizedBy doc:sec-107w ;
    values:originalText "For the purposes of this Part:  (a) a preservation notice; or  (b) a revocation notice under section 107L or 107R; may only be given to a carrier by giving it to an authorised representative of the carrier.  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "For the purposes of this Part:  (a) a preservation notice; or  (b) a revocation notice under section 107L or 107R; may only be given to a carrier by giving it to an authorised representative of the carrier.  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "ce3a78ac1a8688a1a79d08a5983bd42d2a168d6daea67c63be28346060f50091" ;
    cof:pageNumber "309"^^xsd:integer ;
    skos:note "Notice must be given to an authorized representative of the carrier." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.309" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-107w-norm .
