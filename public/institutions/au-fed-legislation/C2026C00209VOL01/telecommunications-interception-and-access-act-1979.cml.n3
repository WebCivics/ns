concept:telecommunications-interception-and-access-act-1979-sec-6v a cml:Concept ;
    skos:prefLabel "6V Substitution of references to the Attorney-General"@en ;
    cml:realizedBy doc:sec-6v ;
    values:originalText "Unless the Prime Minister is satisfied that exceptional circumstances exist, the Governor-General must not make a substituted reference order under subsection 19B(2) of the Acts Interpretation Act 1901 that relates to a provision of this Act that refers to the Attorney-General.  Chapter 2  Interception of telecommunications" ;
    skos:definition "Unless the Prime Minister is satisfied that exceptional circumstances exist, the Governor-General must not make a substituted reference order under subsection 19B(2) of the Acts Interpretation Act 1901 that relates to a provision of this Act that refers to the Attorney-General.  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "6b3bb675534c5e3d8a5853d2a125c3063378d7118f9953d627fa151a71f8f00d" ;
    cof:pageNumber "113"^^xsd:integer ;
    skos:note "Prohibition on making substituted reference orders under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.113" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-6v-norm .
