doc:sec-131 a cof:Section ;
    cof:title "131 Certified copies of stored communications warrants" ;
    values:kind "section" ;
    values:originalText "A document certified in writing by a certifying officer of a criminal law-enforcement agency to be a true copy of a stored communications warrant is to be received in evidence in an exempt proceeding as if it were the original warrant." ;
    cof:pageNumber "333"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-132 a cml:Concept ;
    skos:prefLabel "132 Obstruction"@en ;
    cml:realizedBy doc:sec-132 ;
    values:originalText "(1) A person commits an offence if the person obstructs or hinders another person acting under a stored communications warrant. Penalty: Imprisonment for 6 months or 30 penalty units, or both.  (2) Subsection (1) does not apply if the person obstructing or hindering has a reasonable excuse. Note: A defendant bears an evidential burden in relation to the matter in subsection (2) (see subsection 13.3(3) of the Criminal Code).  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "(1) A person commits an offence if the person obstructs or hinders another person acting under a stored communications warrant. Penalty: Imprisonment for 6 months or 30 penalty units, or both.  (2) Subsection (1) does not apply if the person obstructing or hindering has a reasonable excuse. Note: A defendant bears an evidential burden in relation to the matter in subsection (2) (see subsection 13.3(3) of the Criminal Code).  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "d223b30bc8b1d97840afc3a049b0a08217c93e15c95b4a471962d3ce252daa6c" ;
    cof:pageNumber "333"^^xsd:integer ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sec-132-ss-1 ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sec-132-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.333" .
doc:sec-132 a cof:Section ;
    cof:title "132 Obstruction" ;
    values:kind "section" ;
    values:originalText "(1) A person commits an offence if the person obstructs or hinders another person acting under a stored communications warrant. Penalty: Imprisonment for 6 months or 30 penalty units, or both.  (2) Subsection (1) does not apply if the person obstructing or hindering has a reasonable excuse. Note: A defendant bears an evidential burden in relation to the matter in subsection (2) (see subsection 13.3(3) of the Criminal Code).  Chapter 3  Preserving and accessing stored communications" ;
    cof:pageNumber "333"^^xsd:integer .

