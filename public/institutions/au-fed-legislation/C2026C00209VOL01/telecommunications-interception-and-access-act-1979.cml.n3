doc:sec-87-ss-4 a cof:Section ;
    cof:title "87(4) Power to obtain relevant information" ;
    values:kind "subsection" ;
    values:originalText "(4) Where the Ombudsman:  (a) has reason to believe that an officer of an agency is able to give information relevant to an inspection under this Part of the agency’s records; and  (b) does not know the officer’s identity; the Ombudsman may, by writing given to the chief officer of the agency, require the chief officer, or a person nominated by the chief officer, to attend:  (c) before a specified inspecting officer;  (d) at a specified place; and  (e) within a specified period or at a specified time on a specified day; in order to answer questions relevant to the inspection." ;
    cof:pageNumber "264"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-87-ss-5 a cml:Concept ;
    skos:prefLabel "87(5) Power to obtain relevant information"@en ;
    cml:realizedBy doc:sec-87-ss-5 ;
    values:originalText "(5) The place, and the period or the time and day, specified in a requirement under this section shall be reasonable having regard to the circumstances in which the requirement is made." ;
    skos:definition "(5) The place, and the period or the time and day, specified in a requirement under this section shall be reasonable having regard to the circumstances in which the requirement is made."@en ;
    cml:integrityHash "c79da8f26f0d3df201e974bf9d415ecb3540c2d44955c6762c507c5ea0978a23" ;
