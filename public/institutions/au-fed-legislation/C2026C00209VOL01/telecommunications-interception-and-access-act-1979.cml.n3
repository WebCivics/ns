doc:sec-77-ss-3 a cof:Section ;
    cof:title "77(3) Intercepted material and interception warrant information" ;
    values:kind "subsection" ;
    values:originalText "(3) Interception warrant information is admissible in evidence in a proceeding only to the extent that section 63AA, 74, 75A, 76 or 76A permits a person to give interception warrant information in evidence in that proceeding." ;
    cof:pageNumber "247"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-77-ss-4 a cml:Concept ;
    skos:prefLabel "77(4) Intercepted material and interception warrant information"@en ;
    cml:realizedBy doc:sec-77-ss-4 ;
    values:originalText "(4) For the purpose of determining the extent (if any) to which section 63AA, 74, 75A, 76 or 76A permits a person to give interception warrant information in evidence in a proceeding:  (a) a person may:  (i) communicate the information to another person; or  Chapter 2  Interception of telecommunications" ;
    skos:definition "(4) For the purpose of determining the extent (if any) to which section 63AA, 74, 75A, 76 or 76A permits a person to give interception warrant information in evidence in a proceeding:  (a) a person may:  (i) communicate the information to another person; or  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "092f4838bd9b60827a7f984b2fcf80d3ab178eb1adcada5818652a69d0edc377" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-77 ;
