concept:telecommunications-interception-and-access-act-1979-sec-11a a cml:Concept ;
    skos:prefLabel "11A Telecommunications service warrant for collection of foreign"@en ;
    cml:realizedBy doc:sec-11a ;
    values:originalText "intelligence  (1) Where:  (a) the Director-General of Security gives a notice in writing to the Attorney-General requesting the Attorney-General to issue a warrant under this section authorising persons approved under section 12 in respect of the warrant to do acts or things referred to in subsection 9(1) in relation to a particular telecommunications service for the purpose of obtaining foreign intelligence relating to a matter specified in the notice; and  Chapter 2  Interception of telecommunications" ;
    skos:definition "intelligence  (1) Where:  (a) the Director-General of Security gives a notice in writing to the Attorney-General requesting the Attorney-General to issue a warrant under this section authorising persons approved under section 12 in respect of the warrant to do acts or things referred to in subsection 9(1) in relation to a particular telecommunications service for the purpose of obtaining foreign intelligence relating to a matter specified in the notice; and  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "e1fd00f3b97b8501bc770be9afef199ce7a252a888bc96ecddab04bdec98a041" ;
    cof:pageNumber "125"^^xsd:integer ;
    skos:note "The Attorney-General must issue a warrant for the collection of foreign intelligence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.125" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-11a-norm .
