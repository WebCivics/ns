concept:telecommunications-interception-and-access-act-1979-sec-12-ss-4 a cml:Concept ;
    skos:prefLabel "12(4) Persons authorised to intercept communications for Organisation"@en ;
    cml:realizedBy doc:sec-12-ss-4 ;
    values:originalText "(4) The Director-General of Security must, as soon as practicable after the authority conferred by a Part 2-2 warrant is exercised on behalf of the Organisation, cause one or more written records to be made that identify each person who exercised that authority." ;
    skos:definition "(4) The Director-General of Security must, as soon as practicable after the authority conferred by a Part 2-2 warrant is exercised on behalf of the Organisation, cause one or more written records to be made that identify each person who exercised that authority."@en ;
    cml:integrityHash "2b53ec0fa955747109d44c03c8ac491dd79ba078bef55b009265b0a39bfdd65b" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-12 ;
    cof:pageNumber "135"^^xsd:integer ;
    skos:note "Must create written records after authority is exercised" ;
    cml:curationStatus cml:Proposed ;
