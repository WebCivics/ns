    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-105 ;
    cof:pageNumber "290"^^xsd:integer ;
    skos:note "Imprisonment for a period not exceeding 6 months is prohibited for certain convictions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
