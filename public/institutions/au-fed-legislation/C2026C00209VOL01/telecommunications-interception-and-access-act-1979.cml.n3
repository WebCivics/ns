doc:sec-5ae a cof:Section ;
    cof:title "5AE Authorisation of members of the staff of a Commonwealth" ;
    values:kind "section" ;
    values:originalText "Royal Commission  A sole Commissioner or a member of a Commonwealth Royal Commission may authorise, in writing, a person assisting the Commission to be a member of the staff of the Commission for the purposes of this Act." ;
    cof:pageNumber "75"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-5a a cml:Concept ;
    skos:prefLabel "5A Communicating etc. certain information"@en ;
    cml:realizedBy doc:sec-5a ;
    values:originalText "For the purposes of this Act (other than Schedule 1), a person who gives to another person, makes use of, makes a record of, or produces in evidence in a proceeding, a record (in this section called the relevant record) obtained by an interception, whether or not in contravention of subsection 7(1), of a communication shall  Chapter 1  Introduction" ;
    skos:definition "For the purposes of this Act (other than Schedule 1), a person who gives to another person, makes use of, makes a record of, or produces in evidence in a proceeding, a record (in this section called the relevant record) obtained by an interception, whether or not in contravention of subsection 7(1), of a communication shall  Chapter 1  Introduction"@en ;
    cml:integrityHash "380f732db6263f97e9402de93f6e53f3633d6043e89117d369ab1e5128066118" ;
