doc:sec-107u-ss-1 a cof:Section ;
    cof:title "107U(1) Evidentiary certificates relating to actions by issuing agencies" ;
    values:kind "subsection" ;
    values:originalText "(1) A certifying official of an issuing agency may issue a written certificate signed by him or her setting out such facts as he or she considers relevant with respect to anything done by an officer or staff member of the agency in connection with a preservation notice.  Preserving and accessing stored communications  Chapter 3 Preserving stored communications  Part 3-1A Provisions relating to preservation notices  Division 4  Section 107V  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    cof:pageNumber "308"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-107u-ss-2 a cml:Concept ;
    skos:prefLabel "107U(2) Evidentiary certificates relating to actions by issuing agencies"@en ;
    cml:realizedBy doc:sec-107u-ss-2 ;
    values:originalText "(2) A document purporting to be a certificate issued under this section by a certifying official of an issuing agency and purporting to be signed by him or her:  (a) is to be received in evidence in an exempt proceeding without further proof; and  (b) in an exempt proceeding, is prima facie evidence of the matters stated in the document." ;
    skos:definition "(2) A document purporting to be a certificate issued under this section by a certifying official of an issuing agency and purporting to be signed by him or her:  (a) is to be received in evidence in an exempt proceeding without further proof; and  (b) in an exempt proceeding, is prima facie evidence of the matters stated in the document."@en ;
    cml:integrityHash "510121bd142175cbfb093503d643bd35844f20eda1186e046de4d363ecb1013b" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-107u ;
    cof:pageNumber "308"^^xsd:integer ;
    skos:note "Exempt proceeding evidence of certificate matters" ;
    cml:curationStatus cml:Proposed ;
