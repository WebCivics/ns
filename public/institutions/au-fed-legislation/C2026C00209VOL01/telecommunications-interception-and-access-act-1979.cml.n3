concept:telecommunications-interception-and-access-act-1979-sec-107c a cml:Concept ;
    skos:prefLabel "107C No limitation on other liability"@en ;
    cml:realizedBy doc:sec-107c ;
    values:originalText "No limitation  (1) This Part does not limit any liability (whether criminal or civil) that a person has under any other provision of this Act or under any other law.  Chapter 2  Interception of telecommunications" ;
    skos:definition "No limitation  (1) This Part does not limit any liability (whether criminal or civil) that a person has under any other provision of this Act or under any other law.  Chapter 2  Interception of telecommunications"@en ;
