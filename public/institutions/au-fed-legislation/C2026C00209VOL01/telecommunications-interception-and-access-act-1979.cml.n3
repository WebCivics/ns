doc:sec-137-ss-1 a cof:Section ;
    cof:title "137(1) Dealing in information obtained by Organisation" ;
    values:kind "subsection" ;
    values:originalText "(1) The Director-General of Security may, in accordance with subsection 18(3) or (4A), or subsection 19A(4) of the Australian Security Intelligence Organisation Act 1979, communicate the following to another person:  (a) lawfully accessed information;  (aa) preservation notice information;  (b) stored communications warrant information." ;
    cof:pageNumber "338"^^xsd:integer .

