doc:sec-31a-ss-4b a cof:Section ;
    cof:title "31A(4B) Attorney-General may authorise interception for developing" ;
    values:kind "subsection" ;
    values:originalText "(4B) To avoid doubt, subparagraph (2)(a)(ii) has the effect that lawfully intercepted information obtained under the authorisation may be communicated, used or recorded for the purposes of development or testing of technologies, or interception capabilities." ;
    cof:pageNumber "146"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4c a cml:Concept ;
    skos:prefLabel "31A(4C) Attorney-General may authorise interception for developing"@en ;
    cml:realizedBy doc:sec-31a-ss-4c ;
    values:originalText "(4C) The reference in subsection (1) and subparagraph (2)(a)(i) to interception of communications passing over a telecommunications system includes a reference to the accessing of the communications as stored communications after they have ceased to pass over a telecommunications system." ;
    skos:definition "(4C) The reference in subsection (1) and subparagraph (2)(a)(i) to interception of communications passing over a telecommunications system includes a reference to the accessing of the communications as stored communications after they have ceased to pass over a telecommunications system."@en ;
