concept:telecommunications-interception-and-access-act-1979-sec-172 a cml:Concept ;
    skos:prefLabel "172 No disclosure of the contents or substance of a communication"@en ;
    cml:realizedBy doc:sec-172 ;
    values:originalText "Divisions 3, 4 and 4A do not permit the disclosure of:  (a) information that is the contents or substance of a communication; or  (b) a document to the extent that the document contains the contents or substance of a communication." ;
    skos:definition "Divisions 3, 4 and 4A do not permit the disclosure of:  (a) information that is the contents or substance of a communication; or  (b) a document to the extent that the document contains the contents or substance of a communication."@en ;
