concept:telecommunications-interception-and-access-act-1979-sec-90 a cml:Concept ;
    skos:prefLabel "90 Ombudsman not to be sued"@en ;
    cml:realizedBy doc:sec-90 ;
    values:originalText "Subject to the provisions applying by virtue of subsection 92(3), an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function, power or authority conferred by this Part." ;
    skos:definition "Subject to the provisions applying by virtue of subsection 92(3), an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function, power or authority conferred by this Part."@en ;
    cml:integrityHash "bbd478568c4643d8990736966d9ba9427f607304a0bc82f55716abc3ba6210e1" ;
    cof:pageNumber "267"^^xsd:integer ;
    skos:note "No liability for acts done in good faith" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.267" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-90-norm .
