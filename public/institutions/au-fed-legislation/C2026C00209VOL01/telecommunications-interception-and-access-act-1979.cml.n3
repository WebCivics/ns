concept:telecommunications-interception-and-access-act-1979-sec-141 a cml:Concept ;
    skos:prefLabel "141 Making record for purpose of permitted communication"@en ;
    cml:realizedBy doc:sec-141 ;
    values:originalText "A person who is permitted by section 135, 137 or 138 or subsection 140(1) to communicate particular information to another person may:  (a) make a record of the information, or  (b) cause such a record to be made; for the purpose of so communicating the information in accordance with that section or subsection." ;
    skos:definition "A person who is permitted by section 135, 137 or 138 or subsection 140(1) to communicate particular information to another person may:  (a) make a record of the information, or  (b) cause such a record to be made; for the purpose of so communicating the information in accordance with that section or subsection."@en ;
    cml:integrityHash "022b8c08caf5226499c46d1fc7659756b896009d9ad2b1da1c128c4ac1e3de76" ;
    cof:pageNumber "345"^^xsd:integer ;
    skos:note "A person who is permitted by section 135, 137 or 138 or subsection 140(1) to communicate particular information to another person may make a record of the information." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
