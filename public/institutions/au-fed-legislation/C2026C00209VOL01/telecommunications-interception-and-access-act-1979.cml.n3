doc:sec-137-ss-2 a cof:Section ;
    cof:title "137(2) Dealing in information obtained by Organisation" ;
    values:kind "subsection" ;
    values:originalText "(2) The communication under subsection (1) or (1A) may be made by the Director-General of Security personally or by a person authorised by the Director-General." ;
