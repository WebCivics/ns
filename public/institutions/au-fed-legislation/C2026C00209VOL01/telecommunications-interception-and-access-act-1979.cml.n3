doc:sec-186b-ss-4 a cof:Section ;
    cof:title "186B(4) Inspection of records" ;
    values:kind "subsection" ;
    values:originalText "(4) The chief officer must ensure that members of staff of the agency give the Ombudsman any assistance the Ombudsman reasonably requires to enable the Ombudsman to perform functions under this section." ;
    cof:pageNumber "421"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-5 a cml:Concept ;
    skos:prefLabel "186B(5) Inspection of records"@en ;
    cml:realizedBy doc:sec-186b-ss-5 ;
    values:originalText "(5) To avoid doubt, subsection (1) does not require the Ombudsman to inspect all of the records of an enforcement agency that are relevant to the matters referred to in paragraphs (1)(a) and (b)." ;
    skos:definition "(5) To avoid doubt, subsection (1) does not require the Ombudsman to inspect all of the records of an enforcement agency that are relevant to the matters referred to in paragraphs (1)(a) and (b)."@en ;
    cml:integrityHash "492c86a8bd95d171fdd94e1daa9a0dbd181dfad6ebc21a36b0c802edad374875" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-186b ;
    cof:pageNumber "421"^^xsd:integer ;
    skos:note "No requirement to inspect all records" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.421" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-5-norm .
