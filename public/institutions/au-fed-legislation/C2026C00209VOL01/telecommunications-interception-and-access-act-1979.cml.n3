    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-180u ;
    cof:pageNumber "393"^^xsd:integer ;
    skos:note "Allows for multiple warrants to be issued under the same Act." ;
    cml:curationStatus cml:Proposed ;
