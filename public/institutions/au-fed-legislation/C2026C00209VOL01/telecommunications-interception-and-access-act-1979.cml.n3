concept:telecommunications-interception-and-access-act-1979-sec-139b a cml:Concept ;
    skos:prefLabel "139B Dealing for purposes relating to Part 5.3 orders or Part 9.10"@en ;
    cml:realizedBy doc:sec-139b ;
    values:originalText "orders  (1) An officer or staff member of:  (a) the Australian Federal Police; or  (b) the Police Force of a State or Territory; may, for one or more purposes referred to in subsection (2), and for no other purpose (other than a purpose referred to in subsection 139(2) or (4A) or 139A(2), if applicable), communicate to another person, make use of, or make a record of lawfully accessed information other than foreign intelligence information.  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "orders  (1) An officer or staff member of:  (a) the Australian Federal Police; or  (b) the Police Force of a State or Territory; may, for one or more purposes referred to in subsection (2), and for no other purpose (other than a purpose referred to in subsection 139(2) or (4A) or 139A(2), if applicable), communicate to another person, make use of, or make a record of lawfully accessed information other than foreign intelligence information.  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "080e11f64a2977ff4bdc3021761c759fecb4635c1c21d35cb3f94df69a0bba0e" ;
    cof:pageNumber "343"^^xsd:integer ;
    skos:note "Authorized personnel may access lawfully obtained information." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.343" ;
