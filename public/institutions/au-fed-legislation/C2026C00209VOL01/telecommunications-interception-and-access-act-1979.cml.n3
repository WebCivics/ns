concept:telecommunications-interception-and-access-act-1979-sec-6j a cml:Concept ;
    skos:prefLabel "6J Proceeding by way of a prosecution for an offence"@en ;
    cml:realizedBy doc:sec-6j ;
    values:originalText "A reference in this Act to a proceeding by way of a prosecution for an offence includes a reference to a proceeding with a view to the committal of a person for trial for the offence." ;
    skos:definition "A reference in this Act to a proceeding by way of a prosecution for an offence includes a reference to a proceeding with a view to the committal of a person for trial for the offence."@en ;
