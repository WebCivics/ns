concept:telecommunications-interception-and-access-act-1979-sec-6da-ss-4 a cml:Concept ;
    skos:prefLabel "6DA(4) Nominated ART members"@en ;
    cml:realizedBy doc:sec-6da-ss-4 ;
    values:originalText "(4) A nominated ART member has, in performing a function of or connected with, issuing a warrant under Part 2-5, the same protection and immunity as a Justice of the High Court has in relation to proceedings in the High Court." ;
    skos:definition "(4) A nominated ART member has, in performing a function of or connected with, issuing a warrant under Part 2-5, the same protection and immunity as a Justice of the High Court has in relation to proceedings in the High Court."@en ;
    cml:integrityHash "c2a03286652817e9d14927c0e1c1775693542a8e544f37a0979b9fca351a3f86" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-6da ;
    cof:pageNumber "96"^^xsd:integer ;
    skos:note "Protection and immunity for nominated ART members issuing warrants" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.96" ;
