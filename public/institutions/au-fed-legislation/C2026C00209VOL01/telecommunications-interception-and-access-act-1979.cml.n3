doc:sec-163 a cof:Section ;
    cof:title "163 Report to contain information about effectiveness of warrants" ;
    values:kind "section" ;
    values:originalText "The report must set out, for each criminal law-enforcement agency:  (a) how many arrests were made during that year on the basis of information that was, or included, lawfully accessed information; and  (b) how many proceedings ended during that year that were proceedings in which, according to the records of the agency, lawfully accessed information was given in evidence." ;
    cof:pageNumber "358"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-163a a cml:Concept ;
    skos:prefLabel "163A Report regarding international requests"@en ;
    cml:realizedBy doc:sec-163a ;
    values:originalText "The report must set out the number of occasions on which lawfully accessed information or stored communications warrant information was communicated under subsection 139(1) or section 142 to any of the following:  (a) a foreign country;  (b) the International Criminal Court;  (c) a War Crimes Tribunal; for a purpose connected with an authorisation referred to in paragraph 139(2)(e).  Preserving and accessing stored communications  Chapter 3 Reports about access to stored communications  Part 3-6 Provisions about annual reports  Division 3  Section 164  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    skos:definition "The report must set out the number of occasions on which lawfully accessed information or stored communications warrant information was communicated under subsection 139(1) or section 142 to any of the following:  (a) a foreign country;  (b) the International Criminal Court;  (c) a War Crimes Tribunal; for a purpose connected with an authorisation referred to in paragraph 139(2)(e).  Preserving and accessing stored communications  Chapter 3 Reports about access to stored communications  Part 3-6 Provisions about annual reports  Division 3  Section 164  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "db5b6e026d6ae1e497792aae8abcd66d1314211a2f9fb9f6817eed5c6c1b01b8" ;
    cof:pageNumber "358"^^xsd:integer ;
    skos:note "Report must set out number of occasions information was communicated under subsection 139(1) or section 142 to certain entities." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.358" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-163a-norm .
