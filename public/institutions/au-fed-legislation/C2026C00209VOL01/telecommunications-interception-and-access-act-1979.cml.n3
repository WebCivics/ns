concept:telecommunications-interception-and-access-act-1979-sec-87-ss-6 a cml:Concept ;
    skos:prefLabel "87(6) Power to obtain relevant information"@en ;
    cml:realizedBy doc:sec-87-ss-6 ;
    values:originalText "(6) A person must not refuse:  (a) to attend before a person; or  (b) to give information; or  (c) to answer questions; when required to do so under this section. Penalty for an offence against this subsection: Imprisonment for 6 months.  Chapter 2  Interception of telecommunications" ;
    skos:definition "(6) A person must not refuse:  (a) to attend before a person; or  (b) to give information; or  (c) to answer questions; when required to do so under this section. Penalty for an offence against this subsection: Imprisonment for 6 months.  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "561f281e7b4481dc7cdc22bef1ad3abd3016ffe3cf86b282dc621575b6c5e717" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-87 ;
    cof:pageNumber "264"^^xsd:integer ;
    skos:note "Must attend, give information, and answer questions when required." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.264" ;
