concept:telecommunications-interception-and-access-act-1979-sec-6p a cml:Concept ;
    skos:prefLabel "6P Identification of service"@en ;
    cml:realizedBy doc:sec-6p ;
    values:originalText "For the purposes of this Act (other than Schedule 1), a service may be identified by:  (a) a number assigned to it from time to time; or  (b) by any other unique identifying factor." ;
    skos:definition "For the purposes of this Act (other than Schedule 1), a service may be identified by:  (a) a number assigned to it from time to time; or  (b) by any other unique identifying factor."@en ;
