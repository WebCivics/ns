concept:telecommunications-interception-and-access-act-1979-sec-145 a cml:Concept ;
    skos:prefLabel "145 Evidence that has been given in exempt proceeding"@en ;
    cml:realizedBy doc:sec-145 ;
    values:originalText "If information is given in evidence in an exempt proceeding under section 143 or 144, that information, or any part of that information, may later be given in evidence in any proceeding. Note: This section was inserted as a response to the decision of the Court of Appeal of New South Wales in Wood v Beves (1997) 92 A Crim R 209.  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "If information is given in evidence in an exempt proceeding under section 143 or 144, that information, or any part of that information, may later be given in evidence in any proceeding. Note: This section was inserted as a response to the decision of the Court of Appeal of New South Wales in Wood v Beves (1997) 92 A Crim R 209.  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "c0c464484eb45df4056e10f1617b1a1c0e9b63ecf2ad86cf407703e3f2b0f76d" ;
    cof:pageNumber "347"^^xsd:integer ;
    skos:note "Permits later use of exempt proceeding evidence in other proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
