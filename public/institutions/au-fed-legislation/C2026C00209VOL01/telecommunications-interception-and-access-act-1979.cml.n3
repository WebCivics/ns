doc:sec-79-ss-1 a cof:Section ;
    cof:title "79(1) Destruction of restricted records that are not likely to be" ;
    values:kind "subsection" ;
    values:originalText "(1) Where:  (a) a restricted record (whether made before or after the commencement of this section) is in the possession of an agency (other than an eligible authority of a State in relation to which a declaration is in force under section 34); and  (b) the chief officer of the agency is satisfied that the restricted record is not likely to be required for a permitted purpose in relation to the agency; the chief officer shall cause the restricted record to be destroyed forthwith." ;
    cof:pageNumber "248"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-79-ss-2 a cml:Concept ;
    skos:prefLabel "79(2) Destruction of restricted records that are not likely to be"@en ;
    cml:realizedBy doc:sec-79-ss-2 ;
    values:originalText "(2) In spite of subsection (1), a restricted record must not be destroyed unless the agency has received from the Secretary of the Department written notice that the entry in the General Register relating to the warrant under which the record was obtained has been inspected by the Minister." ;
    skos:definition "(2) In spite of subsection (1), a restricted record must not be destroyed unless the agency has received from the Secretary of the Department written notice that the entry in the General Register relating to the warrant under which the record was obtained has been inspected by the Minister."@en ;
    cml:integrityHash "7c685b251165be57a10e90865e262113618b620519f087bcf8965d7b0413510d" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-79 ;
    cof:pageNumber "248"^^xsd:integer ;
    skos:note "Destroying restricted records without permission is prohibited." ;
    cml:curationStatus cml:Proposed ;
