concept:telecommunications-interception-and-access-act-1979-sec-137-ss-3 a cml:Concept ;
    skos:prefLabel "137(3) Dealing in information obtained by Organisation"@en ;
    cml:realizedBy doc:sec-137-ss-3 ;
    values:originalText "(3) A person to whom foreign intelligence information has been communicated under subsection (1) may, in the proper performance or exercise of the person’s functions, duties or powers:  (a) for the purposes (if any) approved, and subject to the conditions (if any) specified, by the Attorney-General in writing:  (i) communicate that information to another person (the second person); and  (ii) use that information; and  (b) make a record of that information; and the second person, and any other person to whom that information is communicated under this subsection, may communicate it to another person, and use and make a record of it." ;
    skos:definition "(3) A person to whom foreign intelligence information has been communicated under subsection (1) may, in the proper performance or exercise of the person’s functions, duties or powers:  (a) for the purposes (if any) approved, and subject to the conditions (if any) specified, by the Attorney-General in writing:  (i) communicate that information to another person (the second person); and  (ii) use that information; and  (b) make a record of that information; and the second person, and any other person to whom that information is communicated under this subsection, may communicate it to another person, and use and make a record of it."@en ;
    cml:integrityHash "130041812bc1bcdc07e2ddd1319f604f12b280d3ae5863686d117d7104521922" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-137 ;
    cof:pageNumber "338"^^xsd:integer ;
    skos:note "A person may communicate and use foreign intelligence information under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.338" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-137-ss-3-norm .
