concept:telecommunications-interception-and-access-act-1979-sec-62 a cml:Concept ;
    skos:prefLabel "62 Application of Part"@en ;
    cml:realizedBy doc:sec-62 ;
    values:originalText "Except so far as the contrary intention appears, this Part applies in relation to:  (a) information, whether obtained before or after the commencement of this Part;  (b) an interception, whether before or after that commencement, of a communication; and  (c) a proceeding, whether begun before or after that commencement." ;
    skos:definition "Except so far as the contrary intention appears, this Part applies in relation to:  (a) information, whether obtained before or after the commencement of this Part;  (b) an interception, whether before or after that commencement, of a communication; and  (c) a proceeding, whether begun before or after that commencement."@en ;
    cml:integrityHash "0e9dd41d0416dc649b95819bf347e858f80059dc6ba6aa5089a8baabf4108dda" ;
    cof:pageNumber "209"^^xsd:integer ;
    skos:note "This Part applies in relation to certain types of information, interceptions, and proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.209" ;
