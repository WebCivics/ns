    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-10 ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Warrant revocation by Attorney-General within 48 hours" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
