doc:sec-44-ss-1 a cof:Section ;
    cof:title "44(1) Giving further information to Judge" ;
    values:kind "subsection" ;
    values:originalText "(1) A Judge or nominated ART member may require further information to be given in connection with an application to the Judge or nominated ART member for a warrant." ;
    cof:pageNumber "164"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-44-ss-2 a cml:Concept ;
    skos:prefLabel "44(2) Giving further information to Judge"@en ;
    cml:realizedBy doc:sec-44-ss-2 ;
    values:originalText "(2) The further information:  (a) shall be given on oath if the application was made in writing; and  (b) shall be given orally or otherwise, as the Judge or nominated ART member directs." ;
    skos:definition "(2) The further information:  (a) shall be given on oath if the application was made in writing; and  (b) shall be given orally or otherwise, as the Judge or nominated ART member directs."@en ;
    cml:integrityHash "4f0a85cd19aca378b22d245e222367ab52a8f08ac57fb5b5f31d301ca2de7139" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-44 ;
