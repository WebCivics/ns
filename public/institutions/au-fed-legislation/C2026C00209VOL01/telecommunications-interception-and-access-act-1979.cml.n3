doc:sec-180u-ss-3 a cof:Section ;
    cof:title "180U(3) Form and content of a journalist information warrant" ;
    values:kind "subsection" ;
    values:originalText "(3) A journalist information warrant issued under this Subdivision must specify, as the period for which it is to be in force, a period of up to 90 days." ;
    cof:pageNumber "393"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-180u-ss-4 a cml:Concept ;
    skos:prefLabel "180U(4) Form and content of a journalist information warrant"@en ;
