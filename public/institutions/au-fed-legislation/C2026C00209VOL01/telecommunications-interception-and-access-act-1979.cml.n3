doc:sec-63a-ss-1 a cof:Section ;
    cof:title "63A(1) Dealing in connection with existing proceeding" ;
    values:kind "subsection" ;
    values:originalText "(1) A person may:  (a) for a purpose connected with a proceeding begun before the commencement of this Part, or for 2 or more such purposes, and for no other purpose, communicate to another person, make use of, or make a record of; or  (b) give in evidence in such a proceeding; information:  (c) obtained by intercepting a communication before that commencement, whether or not in contravention of subsection 7(1); or  (d) obtained, before that commencement, by virtue of a warrant issued under section 11A." ;
    cof:pageNumber "222"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-2 a cml:Concept ;
    skos:prefLabel "63A(2) Dealing in connection with existing proceeding"@en ;
    cml:realizedBy doc:sec-63a-ss-2 ;
    values:originalText "(2) Nothing in subsection (1) makes admissible in evidence in any proceedings information, obtained by virtue of a warrant that was defective, that would not have been admissible in those proceedings if that subsection had not been enacted." ;
    skos:definition "(2) Nothing in subsection (1) makes admissible in evidence in any proceedings information, obtained by virtue of a warrant that was defective, that would not have been admissible in those proceedings if that subsection had not been enacted."@en ;
