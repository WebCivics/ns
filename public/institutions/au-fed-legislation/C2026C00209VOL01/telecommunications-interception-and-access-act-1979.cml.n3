concept:telecommunications-interception-and-access-act-1979-sec-163 a cml:Concept ;
    skos:prefLabel "163 Report to contain information about effectiveness of warrants"@en ;
    cml:realizedBy doc:sec-163 ;
    values:originalText "The report must set out, for each criminal law-enforcement agency:  (a) how many arrests were made during that year on the basis of information that was, or included, lawfully accessed information; and  (b) how many proceedings ended during that year that were proceedings in which, according to the records of the agency, lawfully accessed information was given in evidence." ;
    skos:definition "The report must set out, for each criminal law-enforcement agency:  (a) how many arrests were made during that year on the basis of information that was, or included, lawfully accessed information; and  (b) how many proceedings ended during that year that were proceedings in which, according to the records of the agency, lawfully accessed information was given in evidence."@en ;
    cml:integrityHash "d3a7e8255baa986118da55689666698e957b6db2c3e970aa90caf4c8edfe1498" ;
    cof:pageNumber "358"^^xsd:integer ;
    skos:note "Report must contain information about effectiveness of warrants" ;
    dc:description "yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.358" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-163-norm .
