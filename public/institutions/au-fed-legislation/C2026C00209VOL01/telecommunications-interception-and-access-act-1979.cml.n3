concept:telecommunications-interception-and-access-act-1979-sec-13 a cml:Concept ;
    skos:prefLabel "13 Discontinuance of interception before expiration of warrant"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "Where, before a Part 2-2 warrant ceases to be in force, the Director-General of Security is satisfied that the grounds on which the warrant was issued have ceased to exist, he or she shall forthwith inform the Attorney-General accordingly and take such steps that are necessary to ensure that the interception of communications under the warrant is discontinued.  Chapter 2  Interception of telecommunications" ;
    skos:definition "Where, before a Part 2-2 warrant ceases to be in force, the Director-General of Security is satisfied that the grounds on which the warrant was issued have ceased to exist, he or she shall forthwith inform the Attorney-General accordingly and take such steps that are necessary to ensure that the interception of communications under the warrant is discontinued.  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "b658e8782a73b3a867b1f4673f9b181f563ef34aba49df12759fb6cbe9a5e77e" ;
    cof:pageNumber "135"^^xsd:integer ;
    skos:note "Ensure discontinuation of interception upon warrant expiration" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.135" ;
