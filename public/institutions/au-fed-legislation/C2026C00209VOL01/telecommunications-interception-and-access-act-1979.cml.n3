concept:telecommunications-interception-and-access-act-1979-sec-186h a cml:Concept ;
    skos:prefLabel "186H Ombudsman not to be sued"@en ;
    cml:realizedBy doc:sec-186h ;
    values:originalText "The Ombudsman, an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function or power conferred by this Chapter." ;
    skos:definition "The Ombudsman, an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function or power conferred by this Chapter."@en ;
    cml:integrityHash "863373f5b33bb5b1ea7b33298d477909d6d1d9531a05050c9e4a88bb8b30d70d" ;
    cof:pageNumber "428"^^xsd:integer ;
    skos:note "No liability for acts done in good faith while performing a function or power under the Chapter." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.428" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-186h-norm .
