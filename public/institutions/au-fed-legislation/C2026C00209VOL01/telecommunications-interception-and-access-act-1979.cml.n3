concept:telecommunications-interception-and-access-act-1979-sec-10-ss-4 a cml:Concept ;
    skos:prefLabel "10(4) Issue of warrant by Director-General of Security in emergency"@en ;
    cml:realizedBy doc:sec-10-ss-4 ;
    values:originalText "(4) Where the Director-General of Security issues a warrant under this section, he or she shall forthwith furnish to the Attorney-General:  (a) a copy of the warrant; and  (b) a statement of the grounds on which he or she is satisfied as to the matters referred to in subparagraph (1)(d)(ii)." ;
    skos:definition "(4) Where the Director-General of Security issues a warrant under this section, he or she shall forthwith furnish to the Attorney-General:  (a) a copy of the warrant; and  (b) a statement of the grounds on which he or she is satisfied as to the matters referred to in subparagraph (1)(d)(ii)."@en ;
    cml:integrityHash "0d9060af421c8053a1367832f501281dc55bcc809e5e70ed764439c180315ec5" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-10 ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Furnishing information to the Attorney-General upon issuing a warrant" ;
    dc:description "a copy of the warrant and a statement of grounds" ;
