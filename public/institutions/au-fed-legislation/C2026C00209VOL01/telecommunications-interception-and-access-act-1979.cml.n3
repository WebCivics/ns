concept:telecommunications-interception-and-access-act-1979-sec-5ae a cml:Concept ;
    skos:prefLabel "5AE Authorisation of members of the staff of a Commonwealth"@en ;
    cml:realizedBy doc:sec-5ae ;
    values:originalText "Royal Commission  A sole Commissioner or a member of a Commonwealth Royal Commission may authorise, in writing, a person assisting the Commission to be a member of the staff of the Commission for the purposes of this Act." ;
    skos:definition "Royal Commission  A sole Commissioner or a member of a Commonwealth Royal Commission may authorise, in writing, a person assisting the Commission to be a member of the staff of the Commission for the purposes of this Act."@en ;
