doc:sec-186f-ss-1 a cof:Section ;
    cof:title "186F(1) Exchange of information between Ombudsman or" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Ombudsman has obtained under this Act information relating to an authority of a State or Territory, the Ombudsman may give the information to another authority of that State or Territory (an inspecting authority) that:  (a) has powers under the law of that State or Territory; and  (b) has the function of making inspections of a similar kind to those provided for in section 186B of this Act when the inspecting authority is exercising those powers." ;
    cof:pageNumber "426"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-186f-ss-2 a cml:Concept ;
    skos:prefLabel "186F(2) Exchange of information between Ombudsman or"@en ;
    cml:realizedBy doc:sec-186f-ss-2 ;
    values:originalText "(2) However, the Ombudsman may give the information only if the Ombudsman is satisfied that giving the information is necessary to enable the inspecting authority to perform its functions in relation to the authority of the State or Territory." ;
    skos:definition "(2) However, the Ombudsman may give the information only if the Ombudsman is satisfied that giving the information is necessary to enable the inspecting authority to perform its functions in relation to the authority of the State or Territory."@en ;
    cml:integrityHash "ea2267ffc5dc9d35b9f9e330a8e6dbcfdcc15ce4c22c95b8b21063744cb1a05d" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-186f ;
    cof:pageNumber "426"^^xsd:integer ;
    skos:note "Ombudsman must provide information if necessary to perform functions." ;
    dc:description "true" ;
