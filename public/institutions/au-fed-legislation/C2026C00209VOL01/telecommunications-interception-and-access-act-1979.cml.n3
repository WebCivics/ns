concept:telecommunications-interception-and-access-act-1979-sec-107v a cml:Concept ;
    skos:prefLabel "107V Certified copies of preservation notices"@en ;
    cml:realizedBy doc:sec-107v ;
    values:originalText "A document certified in writing by a certifying official of an issuing agency to be a true copy of a preservation notice is to be received in evidence in an exempt proceeding as if it were the original preservation notice." ;
    skos:definition "A document certified in writing by a certifying official of an issuing agency to be a true copy of a preservation notice is to be received in evidence in an exempt proceeding as if it were the original preservation notice."@en ;
    cml:integrityHash "34ee5ff31efd1abeb7e084105ff3d6de1ed9582ac7583092af09bdc855861239" ;
    cof:pageNumber "309"^^xsd:integer ;
    skos:note "Exempt proceedings must receive certified copies of preservation notices as evidence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.309" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-107v-norm .
