concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-3 a cml:Concept ;
    skos:prefLabel "63A(3) Dealing in connection with existing proceeding"@en ;
    cml:realizedBy doc:sec-63a-ss-3 ;
    values:originalText "(3) For the purposes of this section, a proceeding by way of a prosecution of a person on indictment for an offence shall be deemed to have begun before the commencement of this Part if a proceeding with a view to the committal of the person for trial for the offence began before that commencement.  Interception of telecommunications  Chapter 2 Dealing with intercepted information etc.  Part 2-6  Section 63B  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    skos:definition "(3) For the purposes of this section, a proceeding by way of a prosecution of a person on indictment for an offence shall be deemed to have begun before the commencement of this Part if a proceeding with a view to the committal of the person for trial for the offence began before that commencement.  Interception of telecommunications  Chapter 2 Dealing with intercepted information etc.  Part 2-6  Section 63B  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "643f44d86dbc8931ef6e5f5c4585282177208ddfde94019b7fccd9f3c3d6d7c5" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-63a ;
    cof:pageNumber "222"^^xsd:integer ;
    skos:note "A proceeding begins before a commencement if a related proceeding began earlier." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.222" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-3-norm .
