concept:telecommunications-interception-and-access-act-1979-sec-9b-ss-4 a cml:Concept ;
    skos:prefLabel "9B(4) Provisions applying to warrants issued under section 9 or 9A"@en ;
    cml:realizedBy doc:sec-9b-ss-4 ;
    values:originalText "(4) Subsection (3) does not prevent the issue of a further warrant in respect of a telecommunications service or a person (as the case may be) in relation to which or whom a warrant has, or warrants have, previously been issued.  Chapter 2  Interception of telecommunications" ;
    skos:definition "(4) Subsection (3) does not prevent the issue of a further warrant in respect of a telecommunications service or a person (as the case may be) in relation to which or whom a warrant has, or warrants have, previously been issued.  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "e7dfdcc23f7a785b13802767ab8636f071b789cacff262d7b60dd3f96e14acbd" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-9b ;
    cof:pageNumber "123"^^xsd:integer ;
    skos:note "Issue of further warrant despite previous warrants" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
