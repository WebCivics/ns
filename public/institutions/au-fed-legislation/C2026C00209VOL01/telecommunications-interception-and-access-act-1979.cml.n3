doc:sec-85-ss-2 a cof:Section ;
    cof:title "85(2) Ombudsman may report on other breaches of this Act" ;
    values:kind "subsection" ;
    values:originalText "(2) To avoid doubt, for the purposes of subsection (1), a contravention of a condition or restriction specified in a warrant issued under this Act is a contravention of a provision of this Act." ;
