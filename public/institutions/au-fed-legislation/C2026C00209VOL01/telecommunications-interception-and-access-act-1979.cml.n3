concept:telecommunications-interception-and-access-act-1979-sec-107d a cml:Concept ;
    skos:prefLabel "107D Concurrent operation of State and Territory laws"@en ;
    cml:realizedBy doc:sec-107d ;
    values:originalText "This Part is not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with this Part." ;
