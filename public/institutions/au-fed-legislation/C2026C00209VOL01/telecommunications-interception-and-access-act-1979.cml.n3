concept:telecommunications-interception-and-access-act-1979-sec-95 a cml:Concept ;
    skos:prefLabel "95 Minister may seek further information from Commonwealth"@en ;
    cml:realizedBy doc:sec-95 ;
    values:originalText "agency  (1) The Minister may by writing request the chief officer of a Commonwealth agency, or eligible Commonwealth authority, to give to the Minister in writing specified information that:  (a) the Minister needs in connection with preparing a report under Division 2; and  (b) is not contained in a report by the chief officer under subsection 94(3).  (2) To the extent that it is practicable to do so, the chief officer of a Commonwealth agency, or eligible Commonwealth authority, shall comply with a request made to the chief officer under subsection (1)." ;
    skos:definition "agency  (1) The Minister may by writing request the chief officer of a Commonwealth agency, or eligible Commonwealth authority, to give to the Minister in writing specified information that:  (a) the Minister needs in connection with preparing a report under Division 2; and  (b) is not contained in a report by the chief officer under subsection 94(3).  (2) To the extent that it is practicable to do so, the chief officer of a Commonwealth agency, or eligible Commonwealth authority, shall comply with a request made to the chief officer under subsection (1)."@en ;
    cml:integrityHash "c4b2af4722ee54e317672875b2d8cf49aa884bf5820ec6091114fea5ec6560e4" ;
    cof:pageNumber "274"^^xsd:integer ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sec-95-ss-1 ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sec-95-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.274" .
doc:sec-95 a cof:Section ;
    cof:title "95 Minister may seek further information from Commonwealth" ;
    values:kind "section" ;
    values:originalText "agency  (1) The Minister may by writing request the chief officer of a Commonwealth agency, or eligible Commonwealth authority, to give to the Minister in writing specified information that:  (a) the Minister needs in connection with preparing a report under Division 2; and  (b) is not contained in a report by the chief officer under subsection 94(3).  (2) To the extent that it is practicable to do so, the chief officer of a Commonwealth agency, or eligible Commonwealth authority, shall comply with a request made to the chief officer under subsection (1)." ;
    cof:pageNumber "274"^^xsd:integer .

