concept:telecommunications-interception-and-access-act-1979-sec-149 a cml:Concept ;
    skos:prefLabel "149 Evidence that is otherwise inadmissible"@en ;
    cml:realizedBy doc:sec-149 ;
    values:originalText "This Part does not render:  (a) information; or  (b) any record that was obtained by accessing a stored communication (whether or not in contravention of subsection 108(1)); admissible in evidence in a proceeding to a greater extent than it would have been admissible in evidence in that proceeding if this Part had not been enacted.  Preserving and accessing stored communications  Chapter 3 Dealing with accessed information etc.  Part 3-4 Destruction of records  Division 4  Section 150  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    skos:definition "This Part does not render:  (a) information; or  (b) any record that was obtained by accessing a stored communication (whether or not in contravention of subsection 108(1)); admissible in evidence in a proceeding to a greater extent than it would have been admissible in evidence in that proceeding if this Part had not been enacted.  Preserving and accessing stored communications  Chapter 3 Dealing with accessed information etc.  Part 3-4 Destruction of records  Division 4  Section 150  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "7f1ba82bf6ea7ffda92b9e550cbce31f8a39aa9f7e1535d71dba33ed9055e8b7" ;
    cof:pageNumber "350"^^xsd:integer ;
    skos:note "Preserves admissibility of records obtained by accessing stored communications" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.350" ;
