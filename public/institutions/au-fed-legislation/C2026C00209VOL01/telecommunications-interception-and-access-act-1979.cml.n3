doc:sec-37-ss-2 a cof:Section ;
    cof:title "37(2) Revocation of declaration" ;
    values:kind "subsection" ;
    values:originalText "(2) Subject to subsection (1), the Minister may, by notice in writing published in the Gazette, revoke a declaration in force under section 34 in relation to an eligible authority of a State if, and only if, the Minister is satisfied that:  (a) the law of that State no longer makes satisfactory provision in relation to the authority as mentioned in subsection 35(1);  (b) the extent of compliance with a requirement of a law of that State, being a requirement of a kind referred to in subsection 35(1), has been unsatisfactory in so far as the requirement relates to the authority;  (c) no agreement of the kind referred to in subsection 35(2), being an agreement entered into by that State that relates to the authority, is in force;  (d) the extent of compliance by that State with the terms of an agreement of the kind referred to in subsection 35(2), being  Interception of telecommunications  Chapter 2 Warrants authorising agencies to intercept telecommunications  Part 2-5 Declaration of State Law Enforcement Authorities as Agencies  Division 2  Section 38  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026  an agreement entered into by that State, has been unsatisfactory in so far as the agreement relates to the authority; or  (e) the extent of compliance by the chief officer of the authority, or by officers of the authority, with this Act has been unsatisfactory." ;
    cof:pageNumber "154"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-38 a cml:Concept ;
    skos:prefLabel "38 Effect of revocation"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "Where a declaration under section 34 in relation to an eligible authority of a State is revoked, this Act:  (a) continues to apply in relation to a warrant that was issued to the authority before the revocation; and  (b) so applies at a particular time as if the authority were an agency at that time." ;
    skos:definition "Where a declaration under section 34 in relation to an eligible authority of a State is revoked, this Act:  (a) continues to apply in relation to a warrant that was issued to the authority before the revocation; and  (b) so applies at a particular time as if the authority were an agency at that time."@en ;
    cml:integrityHash "acca57ac72cd2cbdc8e113922963975ff7f9506c1efd4f1228c0e34f5712a570" ;
    cof:pageNumber "155"^^xsd:integer ;
    skos:note "Continues to apply in relation to a warrant issued before revocation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.155" ;
