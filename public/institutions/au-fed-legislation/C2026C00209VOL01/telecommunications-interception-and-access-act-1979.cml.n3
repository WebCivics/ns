doc:sec-105-ss-1 a cof:Section ;
    cof:title "105(1) Contravention of section 7 or 63" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who contravenes subsection 7(1) or section 63 is guilty of an offence against that subsection or section." ;
    cof:pageNumber "290"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-105-ss-2 a cml:Concept ;
    skos:prefLabel "105(2) Contravention of section 7 or 63"@en ;
    cml:realizedBy doc:sec-105-ss-2 ;
    values:originalText "(2) An offence against subsection 7(1) or section 63 is an indictable offence and, subject to this section, is punishable on conviction by imprisonment for a period not exceeding 2 years." ;
    skos:definition "(2) An offence against subsection 7(1) or section 63 is an indictable offence and, subject to this section, is punishable on conviction by imprisonment for a period not exceeding 2 years."@en ;
    cml:integrityHash "e9a649b342ad2e92bcd38d1707e6ce7e1542cb345d3fa54e5b88500344ed0316" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-105 ;
    cof:pageNumber "290"^^xsd:integer ;
    skos:note "Offence against subsection 7(1) or section 63 is punishable on conviction." ;
    cml:curationStatus cml:Proposed ;
