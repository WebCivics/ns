concept:telecommunications-interception-and-access-act-1979-sec-119-ss-5 a cml:Concept ;
    skos:prefLabel "119(5) Duration of stored communications warrants"@en ;
    cml:realizedBy doc:sec-119-ss-5 ;
    values:originalText "(5) However, if the further warrant relates to the same telecommunications service as the previous warrant, it must not be issued within 3 days after the day on which the previous warrant was executed or (if subsection (2) applies) was last executed.  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "(5) However, if the further warrant relates to the same telecommunications service as the previous warrant, it must not be issued within 3 days after the day on which the previous warrant was executed or (if subsection (2) applies) was last executed.  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "20c2d6549f713c692679c770b88e0a01969e669bfcd9b1dec406a4d9fcadbb20" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-119 ;
    cof:pageNumber "325"^^xsd:integer ;
    skos:note "No new warrant can be issued within 3 days of the previous warrant's execution." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.325" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-119-ss-5-norm .
