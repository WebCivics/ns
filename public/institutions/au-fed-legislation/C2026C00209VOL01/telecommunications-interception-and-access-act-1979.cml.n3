doc:sec-110-ss-4 a cof:Section ;
    cof:title "110(4) Criminal law-enforcement agencies may apply for stored" ;
    values:kind "subsection" ;
    values:originalText "(4) A nomination under subsection (3) is not a legislative instrument." ;
    cof:pageNumber "315"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-110a a cml:Concept ;
    skos:prefLabel "110A Meaning of criminal law-enforcement agency"@en ;
    cml:realizedBy doc:sec-110a ;
    values:originalText "(1) Each of the following is a criminal law-enforcement agency:  (a) the Australian Federal Police;  (b) a Police Force of a State;  (c) the National Anti-Corruption Commission;  (d) the ACC;  Chapter 3  Preserving and accessing stored communications" ;
    skos:definition "(1) Each of the following is a criminal law-enforcement agency:  (a) the Australian Federal Police;  (b) a Police Force of a State;  (c) the National Anti-Corruption Commission;  (d) the ACC;  Chapter 3  Preserving and accessing stored communications"@en ;
    cml:integrityHash "4a543b611bf027f1d07f36ece0603f86bb95ae65be1c28351b1c5e72041fcda9" ;
    cof:pageNumber "315"^^xsd:integer ;
    skos:note "Defines criminal law-enforcement agencies" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
