concept:telecommunications-interception-and-access-act-1979-sec-11d a cml:Concept ;
    skos:prefLabel "11D Provisions applying to foreign intelligence warrants"@en ;
    cml:realizedBy doc:sec-11d ;
    values:originalText "Warrants authorising entry  (1) Where a warrant under section 11A or 11B authorises entry on premises, the warrant:  (a) must state whether entry is authorised to be made at any time of the day or night or only during specified hours; and  Chapter 2  Interception of telecommunications" ;
    skos:definition "Warrants authorising entry  (1) Where a warrant under section 11A or 11B authorises entry on premises, the warrant:  (a) must state whether entry is authorised to be made at any time of the day or night or only during specified hours; and  Chapter 2  Interception of telecommunications"@en ;
    cml:integrityHash "d354e3064f0a198f6bfe0ea9da440d6add1dc48f76bfc03e8dd31174007d89c2" ;
    cof:pageNumber "133"^^xsd:integer ;
