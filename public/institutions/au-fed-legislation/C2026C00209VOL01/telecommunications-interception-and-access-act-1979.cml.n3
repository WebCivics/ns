doc:sec-63a-ss-3 a cof:Section ;
    cof:title "63A(3) Dealing in connection with existing proceeding" ;
    values:kind "subsection" ;
    values:originalText "(3) For the purposes of this section, a proceeding by way of a prosecution of a person on indictment for an offence shall be deemed to have begun before the commencement of this Part if a proceeding with a view to the committal of the person for trial for the offence began before that commencement.  Interception of telecommunications  Chapter 2 Dealing with intercepted information etc.  Part 2-6  Section 63B  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    cof:pageNumber "222"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-4 a cml:Concept ;
    skos:prefLabel "63A(4) Dealing in connection with existing proceeding"@en ;
    cml:realizedBy doc:sec-63a-ss-4 ;
    values:originalText "(4) For the purposes of this section, a proceeding by way of an appeal from, or otherwise arising out of, another proceeding shall be deemed to have begun before the commencement of this Part if the other proceeding began, or by virtue of any other application or applications of this section is deemed to have begun, before that commencement." ;
    skos:definition "(4) For the purposes of this section, a proceeding by way of an appeal from, or otherwise arising out of, another proceeding shall be deemed to have begun before the commencement of this Part if the other proceeding began, or by virtue of any other application or applications of this section is deemed to have begun, before that commencement."@en ;
    cml:integrityHash "248e082fa9a9e49f322377b0e037e4f172ad6d818c792af818a4b2a95e5ff5f2" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sec-63a ;
    cof:pageNumber "222"^^xsd:integer ;
    skos:note "Conditional commencement of a proceeding" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.222" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-4-norm .
