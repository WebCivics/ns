    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-132-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "132(2) Obstruction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-132-ss-2"
      },
      "cml:curationStatus": {
