    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-126",
      "@type": "cml:Concept",
      "skos:prefLabel": "126 Limit on authority conferred by warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-126"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.330",
      "values:originalText": "A stored communications warrant does not authorise access to\nstored communications unless notification of the issue of the\nwarrant has been received under section 121 by an authorised\nrepresentative of the carrier holding the stored communications.",
      "skos:definition": "A stored communications warrant does not authorise access to\nstored communications unless notification of the issue of the\nwarrant has been received under section 121 by an authorised\nrepresentative of the carrier holding the stored communications.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-126-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-126-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "73b760ecfb744b607b2ac8fbc6902c34b253b721f7c8f0e9c236cfe00a4c2c7a",
      "skos:note": "Stored communications warrant does not authorize access unless notification is received by authorized representative."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-126",
      "@type": "cof:Section",
      "cof:title": "126 Limit on authority conferred by warrant",
      "values:kind": "section",
      "cof:pageNumber": 330,
      "values:originalText": "A stored communications warrant does not authorise access to\nstored communications unless notification of the issue of the\nwarrant has been received under section 121 by an authorised\nrepresentative of the carrier holding the stored communications."
    },
    {
