    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-183-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "183(3) Form of authorisations and notifications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-183-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
