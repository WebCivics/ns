    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186j-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "186J(5) Reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186j-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
