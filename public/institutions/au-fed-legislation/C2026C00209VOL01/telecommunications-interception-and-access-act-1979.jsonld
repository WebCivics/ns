      "values:kind": "subsection",
      "cof:pageNumber": 338,
      "values:originalText": "(4) An approval or a condition under subsection (1A) or (3) is not a\nlegislative instrument."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-137-ss-4-norm",
