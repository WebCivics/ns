    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-176a-ss-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "176A(3B) Meaning of enforcement agency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-176a-ss-3b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
