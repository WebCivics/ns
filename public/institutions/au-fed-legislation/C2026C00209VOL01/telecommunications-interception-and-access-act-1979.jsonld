      "cml:integrityHash": "f0860b6b5a727d3c49496640e246b08e1010f11d24fec8636086df026aeabffd",
      "skos:note": "Annual reports must not enable identification of a person."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-164-ss-2",
      "@type": "cof:Section",
      "cof:title": "164(2) Annual reports",
      "values:kind": "subsection",
      "cof:pageNumber": 359,
      "values:originalText": "(2) A report under Division 2 must not be made in a manner that is\nlikely to enable the identification of a person."
    },
