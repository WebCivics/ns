        }
      ],
      "cml:integrityHash": "1e832894a6f433352556d07a39f27e6c09bc7937dbe04c3ed4ac746b3535b7f0",
      "skos:note": "Lawfully intercepted information is defined as information obtained by intercepting a communication passing over a telecommunications system without contravening subsection 7(1)."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6e-ss-1",
