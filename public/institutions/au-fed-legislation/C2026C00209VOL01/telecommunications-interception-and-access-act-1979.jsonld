      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.245",
      "values:originalText": "If information is given in evidence (whether before or after the\ncommencement of this section) in an exempt proceeding under\nsection 74 or 75, that information, or any part of that information,\nmay later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "If information is given in evidence (whether before or after the\ncommencement of this section) in an exempt proceeding under\nsection 74 or 75, that information, or any part of that information,\nmay later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nChapter 2  Interception of telecommunications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-75a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-75a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "86d608be4993250b575572571d38d536348ca7b8cf0138e402998f4b619da8de",
      "skos:note": "Permits later use of exempt proceeding evidence in other proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-75a",
      "@type": "cof:Section",
      "cof:title": "75A Evidence that has been given in exempt proceeding",
      "values:kind": "section",
      "cof:pageNumber": 245,
      "values:originalText": "If information is given in evidence (whether before or after the\ncommencement of this section) in an exempt proceeding under\nsection 74 or 75, that information, or any part of that information,\nmay later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nChapter 2  Interception of telecommunications"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-75a-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-75a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-75a-logic-deontic-1",
