        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-118-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-118-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9192c832f7bcaa4c1ca73a86079546be8bdd79470ebe4a08296f4084e1bd1511",
      "skos:note": "Must set out short particulars of serious contraventions or foreign contraventions.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-118-ss-3",
      "@type": "cof:Section",
      "cof:title": "118(3) Form and content of stored communications warrants",
      "values:kind": "subsection",
      "cof:pageNumber": 324,
      "values:originalText": "(3) A stored communications warrant must set out short particulars of\neach serious contravention or serious foreign contravention in\nrelation to which the issuing authority issuing the warrant was\nsatisfied, on the application for the warrant, as mentioned in\nsubparagraph 116(1)(d)(i) or (ii), as the case may be."
    },
