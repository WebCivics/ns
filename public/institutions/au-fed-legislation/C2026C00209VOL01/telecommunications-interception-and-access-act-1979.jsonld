        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63aa-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "832a7ed056192c632523bafc61bb06b87d1221a00931d3b8ec46c7aa6734524f",
      "skos:note": "Permits communication of interception warrant information to a person or official."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-63aa-ss-3",
      "@type": "cof:Section",
      "cof:title": "63AA(3) Dealing in interception warrant information for the purposes",
      "values:kind": "subsection",
      "cof:pageNumber": 210,
      "values:originalText": "(3) A person may:\n\n(a) communicate information referred to in subsection (4) to a\nperson; or\n\n(b) make use of, or make a record of, that information;\nin connection with:\n\n(c) the performance by an Ombudsman official or IGIS official\nof the official’s functions or duties; or\n\n(d) the exercise by an Ombudsman official or IGIS official of the\nofficial’s powers."
    },
