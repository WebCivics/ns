    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186d-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "186D(3) Ombudsman to be given information and access despite other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186d-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
