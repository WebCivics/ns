    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-185c",
      "@type": "cml:Concept",
      "skos:prefLabel": "185C Evidentiary certificates relating to acts by enforcement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-185c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.409",
      "values:originalText": "agencies\n\n(1) A certifying officer of an enforcement agency may issue a written\ncertificate signed by him or her setting out such facts as he or she\nconsiders relevant with respect to:\n\n(a) anything done by an officer or staff member of the agency in\nconnection with the disclosure of information or a document\n\nChapter 4  Access to telecommunications data",
      "skos:definition": "agencies\n\n(1) A certifying officer of an enforcement agency may issue a written\ncertificate signed by him or her setting out such facts as he or she\nconsiders relevant with respect to:\n\n(a) anything done by an officer or staff member of the agency in\nconnection with the disclosure of information or a document\n\nChapter 4  Access to telecommunications data",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-185c-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-185c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "42618902074b432971ac565e37ebee07fb3ff4e3d23dcdef15664585d27d47b8",
      "skos:note": "Certifying officer must issue written certificate setting out relevant facts."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-185c",
      "@type": "cof:Section",
