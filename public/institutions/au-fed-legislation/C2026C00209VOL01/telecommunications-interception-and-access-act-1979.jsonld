        }
      ],
      "cml:integrityHash": "af9852c7c2159837bb22822171b8bafea8008e45a239f98f45b34888b70cade7",
      "skos:note": "Authorisation for disclosure of information to foreign law enforcement agency"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180a-ss-4",
      "@type": "cof:Section",
      "cof:title": "180A(4) Authorisations for access to existing information or",
      "values:kind": "subsection",
      "cof:pageNumber": 377,
      "values:originalText": "(4) If specified information or specified documents are disclosed\nbecause of an authorisation given under subsection (2), an\nauthorised officer of the Australian Federal Police may authorise\nthe disclosure of the information or documents so disclosed to a\nforeign law enforcement agency.\n\nChapter 4  Access to telecommunications data"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180a-ss-4-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
