    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-80",
      "@type": "cml:Concept",
      "skos:prefLabel": "80 Commonwealth agencies to keep documents connected with issue",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-80"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.252",
      "values:originalText": "of warrants\n\nThe chief officer of a Commonwealth agency must cause to be\nkept in the agency’s records:\n\n(a) each warrant issued to the agency; and\n\n(b) a copy of each notification under subsection 59A(2), being a\nnotification given to the Secretary of the Department; and\n\n(c) each instrument revoking such a warrant; and\n\n(d) a copy of each certificate issued under subsection 61(4) by a\ncertifying officer of the agency; and\n\n(e) each authorisation by the chief officer under\nsubsection 66(2); and\n\n(f) a copy of each advice the chief officer gives to the Minister\nunder subsection 103B(2) or paragraph 103B(4)(b); and\n\n(g) each notice the chief officer receives from the Minister under\nparagraph 103B(3)(a) or (5)(a).",
      "skos:definition": "of warrants\n\nThe chief officer of a Commonwealth agency must cause to be\nkept in the agency’s records:\n\n(a) each warrant issued to the agency; and\n\n(b) a copy of each notification under subsection 59A(2), being a\nnotification given to the Secretary of the Department; and\n\n(c) each instrument revoking such a warrant; and\n\n(d) a copy of each certificate issued under subsection 61(4) by a\ncertifying officer of the agency; and\n\n(e) each authorisation by the chief officer under\nsubsection 66(2); and\n\n(f) a copy of each advice the chief officer gives to the Minister\nunder subsection 103B(2) or paragraph 103B(4)(b); and\n\n(g) each notice the chief officer receives from the Minister under\nparagraph 103B(3)(a) or (5)(a).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-80-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-80-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "672c8168e3c8d605623286314f4f4cafd90f35448b2709ec7f96b5e50e54ad78",
      "skos:note": "Commonwealth agencies must keep documents connected with issue.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-80",
      "@type": "cof:Section",
      "cof:title": "80 Commonwealth agencies to keep documents connected with issue",
      "values:kind": "section",
      "cof:pageNumber": 252,
      "values:originalText": "of warrants\n\nThe chief officer of a Commonwealth agency must cause to be\nkept in the agency’s records:\n\n(a) each warrant issued to the agency; and\n\n(b) a copy of each notification under subsection 59A(2), being a\nnotification given to the Secretary of the Department; and\n\n(c) each instrument revoking such a warrant; and\n\n(d) a copy of each certificate issued under subsection 61(4) by a\ncertifying officer of the agency; and\n\n(e) each authorisation by the chief officer under\nsubsection 66(2); and\n\n(f) a copy of each advice the chief officer gives to the Minister\nunder subsection 103B(2) or paragraph 103B(4)(b); and\n\n(g) each notice the chief officer receives from the Minister under\nparagraph 103B(3)(a) or (5)(a)."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-80-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-80"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-80-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide documents",
      "cml:executionSurface": "modalities::logic::deontic",
