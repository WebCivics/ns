        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the order has been made but the period specified in the order under paragraph 395.13(5)(d) of the Criminal Code has not yet begun.",
      "cml:conclusionText": "a community safety supervision order is taken to be in force in relation to a person if the order has been made but the period specified in the order under paragraph 395.13(5)(d) of the Criminal Code has not yet begun."
    },
