    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180u",
      "@type": "cml:Concept",
      "skos:prefLabel": "180U Form and content of a journalist information warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.393",
      "values:originalText": "(1) A journalist information warrant issued under this Subdivision\nmust be in accordance with the prescribed form and must be signed\nby the Part 4-1 issuing authority who issues it.\n\n(2) A journalist information warrant issued under this Subdivision may\nspecify conditions or restrictions relating to making authorisations\nunder the authority of the warrant.\n\n(3) A journalist information warrant issued under this Subdivision\nmust specify, as the period for which it is to be in force, a period of\nup to 90 days.\n\n(4) A Part 4-1 issuing authority must not vary a journalist information\nwarrant issued under this Subdivision by extending the period for\nwhich it is to be in force.\n\n(5) Neither of subsections (3) and (4) prevents the issue of a further\nwarrant under this Act in relation to a person, in relation to which a\nwarrant under this Act has, or warrants under this Act have,\npreviously been issued.",
      "skos:definition": "(1) A journalist information warrant issued under this Subdivision\nmust be in accordance with the prescribed form and must be signed\nby the Part 4-1 issuing authority who issues it.\n\n(2) A journalist information warrant issued under this Subdivision may\nspecify conditions or restrictions relating to making authorisations\nunder the authority of the warrant.\n\n(3) A journalist information warrant issued under this Subdivision\nmust specify, as the period for which it is to be in force, a period of\nup to 90 days.\n\n(4) A Part 4-1 issuing authority must not vary a journalist information\nwarrant issued under this Subdivision by extending the period for\nwhich it is to be in force.\n\n(5) Neither of subsections (3) and (4) prevents the issue of a further\nwarrant under this Act in relation to a person, in relation to which a\nwarrant under this Act has, or warrants under this Act have,\npreviously been issued.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180u-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180u-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180u-ss-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180u-ss-4"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180u-ss-5"
        }
      ],
      "cml:integrityHash": "f5bf211140f236abcfbd5863bf1a76fc9c5fb310abdd45ae0e05ad09eed102ec"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180u",
      "@type": "cof:Section",
      "cof:title": "180U Form and content of a journalist information warrant",
      "values:kind": "section",
      "cof:pageNumber": 393,
      "values:originalText": "(1) A journalist information warrant issued under this Subdivision\nmust be in accordance with the prescribed form and must be signed\nby the Part 4-1 issuing authority who issues it.\n\n(2) A journalist information warrant issued under this Subdivision may\nspecify conditions or restrictions relating to making authorisations\nunder the authority of the warrant.\n\n(3) A journalist information warrant issued under this Subdivision\nmust specify, as the period for which it is to be in force, a period of\nup to 90 days.\n\n(4) A Part 4-1 issuing authority must not vary a journalist information\nwarrant issued under this Subdivision by extending the period for\nwhich it is to be in force.\n\n(5) Neither of subsections (3) and (4) prevents the issue of a further\nwarrant under this Act in relation to a person, in relation to which a\nwarrant under this Act has, or warrants under this Act have,\npreviously been issued."
    },
