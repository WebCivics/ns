    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "180E(2) Disclosing information etc. to foreign countries or foreign law",
      "cml:realizedBy": {
