    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 June 2026",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
