    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-176-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "176(4) Authorisations for access to prospective information or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-176-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.368",
      "values:originalText": "(4) The eligible person must not make the authorisation unless he or\nshe is satisfied that the disclosure would be in connection with the\nperformance by the Organisation of its functions.\nPeriod for which authorisation is in force",
      "skos:definition": "(4) The eligible person must not make the authorisation unless he or\nshe is satisfied that the disclosure would be in connection with the\nperformance by the Organisation of its functions.\nPeriod for which authorisation is in force",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-176"
      },
