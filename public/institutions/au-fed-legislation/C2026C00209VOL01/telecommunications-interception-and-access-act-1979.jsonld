    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-172",
      "@type": "cml:Concept",
      "skos:prefLabel": "172 No disclosure of the contents or substance of a communication",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-172"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.366",
      "values:originalText": "Divisions 3, 4 and 4A do not permit the disclosure of:\n\n(a) information that is the contents or substance of a\ncommunication; or\n\n(b) a document to the extent that the document contains the\ncontents or substance of a communication.",
      "skos:definition": "Divisions 3, 4 and 4A do not permit the disclosure of:\n\n(a) information that is the contents or substance of a\ncommunication; or\n\n(b) a document to the extent that the document contains the\ncontents or substance of a communication.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-172-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-172-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "000127c8e2cc9f18d90fec21bb6cc421ad56dc6fc4d162897c41c8eda4207112",
      "skos:note": "No disclosure of communication contents or substance"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-172",
      "@type": "cof:Section",
      "cof:title": "172 No disclosure of the contents or substance of a communication",
      "values:kind": "section",
      "cof:pageNumber": 366,
      "values:originalText": "Divisions 3, 4 and 4A do not permit the disclosure of:\n\n(a) information that is the contents or substance of a\ncommunication; or\n\n(b) a document to the extent that the document contains the\ncontents or substance of a communication."
    },
    {
