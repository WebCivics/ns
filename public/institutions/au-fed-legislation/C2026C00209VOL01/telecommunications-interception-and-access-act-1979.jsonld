          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-185d-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "980676258541661565065ce27d740dee44b346a237565df95f0b54f322071b34",
      "skos:note": "Chief officer of ACC must notify Minister and Inspector-General of Intelligence and Security upon issuing a journalist information warrant."
    },
    {
