      },
      "cml:premiseText": "Supervisory order ceases to be in force.",
      "cml:conclusionText": "Warrant remains in force."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-49-ss-6a-logic-diffusion-4",
      "@type": "cml:LogicApplication",
