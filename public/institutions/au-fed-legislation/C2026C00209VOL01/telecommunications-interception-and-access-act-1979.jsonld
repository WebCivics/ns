    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-113-ss-3",
      "@type": "cof:Section",
      "cof:title": "113(3) Affidavits to accompany written applications",
      "values:kind": "subsection",
