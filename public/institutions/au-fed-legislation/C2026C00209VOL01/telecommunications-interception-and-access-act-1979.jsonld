    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-118-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "118(3) Form and content of stored communications warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-118-ss-3"
      },
