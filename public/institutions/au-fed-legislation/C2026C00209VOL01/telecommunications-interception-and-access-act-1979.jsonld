        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-174-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6bca1ad686600b0b2ea063a1f676c7496bef12d8f237eb7af894b4979e51a54a",
      "skos:note": "Holder must disclose information or document if requested by ASIO employee or affiliate."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-174-ss-2",
      "@type": "cof:Section",
      "cof:title": "174(2) Voluntary disclosure",
      "values:kind": "subsection",
      "cof:pageNumber": 367,
      "values:originalText": "(2) This section does not apply if the Director-General of Security, the\nDeputy Director-General of Security or any other ASIO employee\nor ASIO affiliate requests the holder to disclose the information or\ndocument.\nNote:\nSections 175 and 176 deal with the disclosure of information or a\ndocument in response to authorisations by the Organisation."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-174-ss-2-norm",
