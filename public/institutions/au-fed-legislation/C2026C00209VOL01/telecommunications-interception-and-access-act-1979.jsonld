          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-17-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "53e5ea7e701ff8088a190ffa34f41fd9a602e59c1855cb9483d9d117896ac577",
      "skos:note": "Report details of intercepted communication source",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-17-ss-2",
      "@type": "cof:Section",
      "cof:title": "17(2) Reports to be made to Attorney-General on results of",
      "values:kind": "subsection",
      "cof:pageNumber": 140,
      "values:originalText": "(2) A report under subsection (1) in relation to a warrant issued under\nsection 9A or 11B must include details of the telecommunications\nservice to or from which each intercepted communication was\nmade."
    },
