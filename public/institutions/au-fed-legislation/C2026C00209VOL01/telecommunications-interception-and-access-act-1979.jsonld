      },
      "cml:operator": "Exemption",
      "cml:logicSummary": "Exemptions from certain subsections",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "65(4) Dealing in information obtained by Organisation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-65-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.228",
      "values:originalText": "(4) If lawfully intercepted information was obtained under a\nsection 31A authorisation, subsection (1) of this section does not\nauthorise the communication of the information in accordance with\nsubsection 18(3) of the Australian Security Intelligence\nOrganisation Act 1979 to:\n\n(a) a staff member of an authority of the Commonwealth; or\n\n(b) a staff member of an authority of a State;\nunless the communication is for the purpose of the development or\ntesting of technologies, or interception capabilities, of:\n\n(c) that authority; or\n\n(d) the Organisation.",
      "skos:definition": "(4) If lawfully intercepted information was obtained under a\nsection 31A authorisation, subsection (1) of this section does not\nauthorise the communication of the information in accordance with\nsubsection 18(3) of the Australian Security Intelligence\nOrganisation Act 1979 to:\n\n(a) a staff member of an authority of the Commonwealth; or\n\n(b) a staff member of an authority of a State;\nunless the communication is for the purpose of the development or\ntesting of technologies, or interception capabilities, of:\n\n(c) that authority; or\n\n(d) the Organisation.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-4-norm"
        },
