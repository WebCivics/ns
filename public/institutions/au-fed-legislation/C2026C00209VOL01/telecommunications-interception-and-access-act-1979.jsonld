    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-60-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "60(4) Notification to authorised representative of carrier of issue or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-60-ss-4"
      },
      "cml:curationStatus": {
