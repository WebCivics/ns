    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186e-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "186E(8) Application of Ombudsman Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186e-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.425",
      "values:originalText": "(8) of the Ombudsman Act 1976 apply for the purposes of this\nChapter and so apply as if:\n\n(a) a reference in those subsections to an officer were a reference\nto an inspecting officer; and\n\n(b) a reference in those subsections to information did not\ninclude a reference to lawfully accessed information or\nlawfully intercepted information; and\n\n(c) a reference in those subsections to that Act were a reference\nto this Chapter; and\n\n(d) paragraph 35(3)(b) of that Act were omitted; and\n\n(e) section 35A of that Act had not been enacted.\n\nChapter 4A  Oversight by the Commonwealth Ombudsman\n\nSection 186F\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "(8) of the Ombudsman Act 1976 apply for the purposes of this\nChapter and so apply as if:\n\n(a) a reference in those subsections to an officer were a reference\nto an inspecting officer; and\n\n(b) a reference in those subsections to information did not\ninclude a reference to lawfully accessed information or\nlawfully intercepted information; and\n\n(c) a reference in those subsections to that Act were a reference\nto this Chapter; and\n\n(d) paragraph 35(3)(b) of that Act were omitted; and\n\n(e) section 35A of that Act had not been enacted.\n\nChapter 4A  Oversight by the Commonwealth Ombudsman\n\nSection 186F\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186e"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186e-ss-8-norm"
        }
      ],
      "cml:integrityHash": "b4a968c36e923fd5debd2ebdc6489aa62d9545189e8336d8439d93d74809d0eb",
      "skos:note": "Application of Ombudsman Act to this Chapter"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186e-ss-8",
      "@type": "cof:Section",
      "cof:title": "186E(8) Application of Ombudsman Act",
      "values:kind": "subsection",
      "cof:pageNumber": 425,
      "values:originalText": "(8) of the Ombudsman Act 1976 apply for the purposes of this\nChapter and so apply as if:\n\n(a) a reference in those subsections to an officer were a reference\nto an inspecting officer; and\n\n(b) a reference in those subsections to information did not\ninclude a reference to lawfully accessed information or\nlawfully intercepted information; and\n\n(c) a reference in those subsections to that Act were a reference\nto this Chapter; and\n\n(d) paragraph 35(3)(b) of that Act were omitted; and\n\n(e) section 35A of that Act had not been enacted.\n\nChapter 4A  Oversight by the Commonwealth Ombudsman\n\nSection 186F\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186e-ss-8-norm",
      "@type": "values:Obligation",
