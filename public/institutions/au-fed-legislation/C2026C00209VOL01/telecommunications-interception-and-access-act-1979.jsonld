      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.290",
      "values:originalText": "(2) An offence against subsection 7(1) or section 63 is an indictable\noffence and, subject to this section, is punishable on conviction by\nimprisonment for a period not exceeding 2 years.",
      "skos:definition": "(2) An offence against subsection 7(1) or section 63 is an indictable\noffence and, subject to this section, is punishable on conviction by\nimprisonment for a period not exceeding 2 years.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-2-norm"
        }
      ],
      "cml:integrityHash": "e9a649b342ad2e92bcd38d1707e6ce7e1542cb345d3fa54e5b88500344ed0316",
      "skos:note": "Offence against subsection 7(1) or section 63 is punishable on conviction."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105-ss-2",
      "@type": "cof:Section",
      "cof:title": "105(2) Contravention of section 7 or 63",
      "values:kind": "subsection",
      "cof:pageNumber": 290,
      "values:originalText": "(2) An offence against subsection 7(1) or section 63 is an indictable\noffence and, subject to this section, is punishable on conviction by\nimprisonment for a period not exceeding 2 years."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-2-norm",
