      "skos:note": "Must consult ACMA and Information Commissioner on privacy matters before making a determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-183-ss-3",
      "@type": "cof:Section",
