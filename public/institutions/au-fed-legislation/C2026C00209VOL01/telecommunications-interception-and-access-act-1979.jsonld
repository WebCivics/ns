      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6c",
      "@type": "cml:Concept",
      "skos:prefLabel": "6C Issue of warrant to agency or eligible authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.95",
      "values:originalText": "For the purposes of this Act, a warrant issued on an application by\nan agency or an officer of an agency, or on an application by an\neligible authority of a State, shall be taken to be issued to that\nagency or eligible authority, as the case may be.\n\nChapter 1  Introduction",
      "skos:definition": "For the purposes of this Act, a warrant issued on an application by\nan agency or an officer of an agency, or on an application by an\neligible authority of a State, shall be taken to be issued to that\nagency or eligible authority, as the case may be.\n\nChapter 1  Introduction",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6c-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "696822a73a60e91a41102129d282c619ece1180fb566df4d674eeb8202251097",
      "skos:note": "Warrant issuance obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6c",
      "@type": "cof:Section",
      "cof:title": "6C Issue of warrant to agency or eligible authority",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "For the purposes of this Act, a warrant issued on an application by\nan agency or an officer of an agency, or on an application by an\neligible authority of a State, shall be taken to be issued to that\nagency or eligible authority, as the case may be.\n\nChapter 1  Introduction"
    },
