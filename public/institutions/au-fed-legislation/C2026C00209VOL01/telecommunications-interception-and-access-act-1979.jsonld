    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107j",
      "@type": "cml:Concept",
      "skos:prefLabel": "107J Conditions for giving domestic preservation notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107j"
      },
      "cml:curationStatus": {
