    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-173",
      "@type": "cml:Concept",
      "skos:prefLabel": "173 Effect of Divisions 3 to 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-173"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.366",
      "values:originalText": "Nothing in Divisions 3 to 5 limits the generality of anything else in\nthose Divisions or in Subdivision A of Division 3 of Part 13 of the\nTelecommunications Act 1997.\n\nAccess to telecommunications data  Chapter 4\nPermitted access to telecommunications data  Part 4-1\nThe Organisation  Division 3\n\nSection 174\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "Nothing in Divisions 3 to 5 limits the generality of anything else in\nthose Divisions or in Subdivision A of Division 3 of Part 13 of the\nTelecommunications Act 1997.\n\nAccess to telecommunications data  Chapter 4\nPermitted access to telecommunications data  Part 4-1\nThe Organisation  Division 3\n\nSection 174\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-173-norm"
        }
      ],
      "cml:integrityHash": "51ea99bced9d848fef95f037ce641554404345c982eed1b4c380c652d5d6c5b2",
      "skos:note": "Nothing in Divisions 3 to 5 limits the generality of anything else in those Divisions or in Subdivision A of Division 3 of Part 13 of the Telecommunications Act 1997."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-173",
      "@type": "cof:Section",
      "cof:title": "173 Effect of Divisions 3 to 5",
      "values:kind": "section",
      "cof:pageNumber": 366,
      "values:originalText": "Nothing in Divisions 3 to 5 limits the generality of anything else in\nthose Divisions or in Subdivision A of Division 3 of Part 13 of the\nTelecommunications Act 1997.\n\nAccess to telecommunications data  Chapter 4\nPermitted access to telecommunications data  Part 4-1\nThe Organisation  Division 3\n\nSection 174\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-173-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-173"
