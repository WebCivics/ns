          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "80c4337ca2ab10e76714e2f5dcf19834c58e78740938acd19bf74389c063df0a",
      "skos:note": "Authority must keep copy of authorisation",
      "dc:description": "authorisation"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31a-ss-4",
      "@type": "cof:Section",
      "cof:title": "31A(4) Attorney-General may authorise interception for developing",
      "values:kind": "subsection",
      "cof:pageNumber": 146,
      "values:originalText": "(4) The head (however described) of the security authority, or a person\nacting as that head, must ensure that a copy of the authorisation is\nkept by the authority and is available for inspection on request by\nthe Minister who is responsible for the authority."
    },
