      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman may inspect records.",
      "cml:conclusionText": "There is an obligation to provide records."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-1a-logic-alleninterval-2",
