    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-69",
      "@type": "cml:Concept",
      "skos:prefLabel": "69 State authority may ask not to receive information under",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-69"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.241",
      "values:originalText": "section 68\n\n(1) The chief officer of an eligible authority of a State in relation to\nwhich no declaration is in force under section 34 may, by writing\ngiven to the chief officer of another agency, request the other\nagency not to communicate information under section 68 to the\neligible authority.\n\n(2) A request under subsection (1) remains in force until:\n\n(a) the chief officer of the eligible authority revokes the request\nby writing given to the chief officer of the other agency; or\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "section 68\n\n(1) The chief officer of an eligible authority of a State in relation to\nwhich no declaration is in force under section 34 may, by writing\ngiven to the chief officer of another agency, request the other\nagency not to communicate information under section 68 to the\neligible authority.\n\n(2) A request under subsection (1) remains in force until:\n\n(a) the chief officer of the eligible authority revokes the request\nby writing given to the chief officer of the other agency; or\n\nChapter 2  Interception of telecommunications",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-69-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-69-ss-2"
        }
      ],
      "cml:integrityHash": "9d5c88b9e524be5dd76077c7d04ef87eca1e244babca16aa4d42272bf63d0dd0"
    },
