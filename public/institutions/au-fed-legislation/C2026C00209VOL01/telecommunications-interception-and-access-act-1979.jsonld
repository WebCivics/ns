      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-62",
      "@type": "cml:Concept",
      "skos:prefLabel": "62 Application of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-62"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.209",
      "values:originalText": "Except so far as the contrary intention appears, this Part applies in\nrelation to:\n\n(a) information, whether obtained before or after the\ncommencement of this Part;\n\n(b) an interception, whether before or after that commencement,\nof a communication; and\n\n(c) a proceeding, whether begun before or after that\ncommencement.",
      "skos:definition": "Except so far as the contrary intention appears, this Part applies in\nrelation to:\n\n(a) information, whether obtained before or after the\ncommencement of this Part;\n\n(b) an interception, whether before or after that commencement,\nof a communication; and\n\n(c) a proceeding, whether begun before or after that\ncommencement.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-62-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-62-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0e9dd41d0416dc649b95819bf347e858f80059dc6ba6aa5089a8baabf4108dda",
      "skos:note": "This Part applies in relation to certain types of information, interceptions, and proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-62",
      "@type": "cof:Section",
      "cof:title": "62 Application of Part",
      "values:kind": "section",
      "cof:pageNumber": 209,
      "values:originalText": "Except so far as the contrary intention appears, this Part applies in\nrelation to:\n\n(a) information, whether obtained before or after the\ncommencement of this Part;\n\n(b) an interception, whether before or after that commencement,\nof a communication; and\n\n(c) a proceeding, whether begun before or after that\ncommencement."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-62-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
