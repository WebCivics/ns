        }
      ],
      "cml:integrityHash": "05a4e93e91d95cbe16693c660430c752511e609e0d1ea15d76951f26899aa80c",
      "skos:note": "Disclosure of information to enforcement agency is allowed under certain conditions."
    },
    {
