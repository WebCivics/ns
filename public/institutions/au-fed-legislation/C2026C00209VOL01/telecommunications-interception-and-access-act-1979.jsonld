        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) to what extent methods of investigating the serious\ncontravention that do not involve the use of a stored\ncommunications warrant in relation to the person have been\nused by, or are available to, the agency;"
    },
