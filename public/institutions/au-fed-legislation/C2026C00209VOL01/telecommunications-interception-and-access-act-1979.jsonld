    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-113-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "113(3) Affidavits to accompany written applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-113-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.320",
      "values:originalText": "(3) Despite subsection (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, but\nfor this subsection, this section would have required an affidavit\naccompanying the application to set out.",
      "skos:definition": "(3) Despite subsection (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, but\nfor this subsection, this section would have required an affidavit\naccompanying the application to set out.",
