      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c88b41e490a39126ecc9a0d9c81b1ccd5997e187bab279e26d6d98ee14e8abe4",
      "skos:note": "Prohibition on accessing stored communications without notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-108-ss-1a",
      "@type": "cof:Section",
      "cof:title": "108(1A) Stored communications not to be accessed",
      "values:kind": "subsection",
      "cof:pageNumber": 310,
      "values:originalText": "(1A) Without limiting paragraph (1)(b), a person is taken for the\npurposes of that paragraph to have knowledge of an act referred to\nin paragraph (1)(a) if written notice of an intention to do the act is\ngiven to the person.\nNote:\nFor giving notice, see section 28A of the Acts Interpretation Act 1901."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1a-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits access to stored communications",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
