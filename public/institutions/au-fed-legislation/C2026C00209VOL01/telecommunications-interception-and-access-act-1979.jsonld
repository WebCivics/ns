          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-64-ss-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-64-ss-4"
        }
      ],
      "cml:integrityHash": "2a0eaf104f674834af0f586955fc14df2b6c236330929fd59027707b061b1139"
