    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102b",
      "@type": "cml:Concept",
      "skos:prefLabel": "102B Report regarding international requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-102b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.284",
      "values:originalText": "The report must set out the number of occasions on which lawfully\nintercepted information or interception warrant information was\ncommunicated to any of the following:\n\n(a) a foreign country under paragraph 68(l) or section 68A;\n\n(b) the International Criminal Court under paragraph 68(la) or\nsection 68A;\n\n(c) a War Crimes Tribunal under paragraph 68(lb) or\nsection 68A.",
      "skos:definition": "The report must set out the number of occasions on which lawfully\nintercepted information or interception warrant information was\ncommunicated to any of the following:\n\n(a) a foreign country under paragraph 68(l) or section 68A;\n\n(b) the International Criminal Court under paragraph 68(la) or\nsection 68A;\n\n(c) a War Crimes Tribunal under paragraph 68(lb) or\nsection 68A.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102b-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e487ab9b7bab7844d42d5769907d169e23a51b393728a5ded03c044b297daf57",
      "skos:note": "Report must provide information on intercepted communications with foreign countries and international courts.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-102b",
      "@type": "cof:Section",
      "cof:title": "102B Report regarding international requests",
      "values:kind": "section",
      "cof:pageNumber": 284,
      "values:originalText": "The report must set out the number of occasions on which lawfully\nintercepted information or interception warrant information was\ncommunicated to any of the following:\n\n(a) a foreign country under paragraph 68(l) or section 68A;\n\n(b) the International Criminal Court under paragraph 68(la) or\nsection 68A;\n\n(c) a War Crimes Tribunal under paragraph 68(lb) or\nsection 68A."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102b-norm",
