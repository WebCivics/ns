        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107-ss-3-logic-epistemic-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107-ss-3-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107-ss-3-logic-argumentation-4"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107-ss-3-logic-alleninterval-5"
        }
      ],
      "cml:integrityHash": "489c3295b7c34ea87cdc027d7666f3da9625d8a3ef3004d99b4739d076bb2175",
      "skos:note": "Defendant bears evidential burden in relation to reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107-ss-3",
      "@type": "cof:Section",
      "cof:title": "107(3) Offences relating to inspections under Part 2-7",
      "values:kind": "subsection",
      "cof:pageNumber": 291,
      "values:originalText": "(3) Subsection (1) and paragraph (2)(a) do not apply if the person first\nmentioned in subsection (1) or (2) has a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (3) (see subsection 13.3(3) of the Criminal Code).\n\nChapter 2  Interception of telecommunications"
    },
