    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107l",
      "@type": "cml:Concept",
      "skos:prefLabel": "107L Revoking a domestic preservation notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.301",
      "values:originalText": "Discretionary revocation\n\n(1) An issuing agency that has given a domestic preservation notice\nmay revoke the notice at any time.\n\nChapter 3  Preserving and accessing stored communications",
      "skos:definition": "Discretionary revocation\n\n(1) An issuing agency that has given a domestic preservation notice\nmay revoke the notice at any time.\n\nChapter 3  Preserving and accessing stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107l-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5c6155f6b3f4515d2c65bc837c43f5435007956efe39eef71533676411ba9e04",
      "skos:note": "Issuing agency may revoke domestic preservation notice at any time."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107l",
      "@type": "cof:Section",
      "cof:title": "107L Revoking a domestic preservation notice",
      "values:kind": "section",
      "cof:pageNumber": 301,
      "values:originalText": "Discretionary revocation\n\n(1) An issuing agency that has given a domestic preservation notice\nmay revoke the notice at any time.\n\nChapter 3  Preserving and accessing stored communications"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107l-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107l"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107l-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to revoke",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
