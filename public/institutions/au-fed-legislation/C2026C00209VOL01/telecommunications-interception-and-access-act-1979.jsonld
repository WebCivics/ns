        }
      ],
      "cml:integrityHash": "3ae8efda844c20de2fdad4c869517d1153ea3283dcef46d9492ae429a4da71fb",
      "skos:note": "An officer of an enforcement agency must give information to an inspecting officer and access to records."
    },
    {
