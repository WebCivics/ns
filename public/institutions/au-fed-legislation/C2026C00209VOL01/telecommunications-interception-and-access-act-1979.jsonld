    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-145",
      "@type": "cml:Concept",
      "skos:prefLabel": "145 Evidence that has been given in exempt proceeding",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-145"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.347",
      "values:originalText": "If information is given in evidence in an exempt proceeding under\nsection 143 or 144, that information, or any part of that\ninformation, may later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nChapter 3  Preserving and accessing stored communications",
      "skos:definition": "If information is given in evidence in an exempt proceeding under\nsection 143 or 144, that information, or any part of that\ninformation, may later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nChapter 3  Preserving and accessing stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-145-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-145-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c0c464484eb45df4056e10f1617b1a1c0e9b63ecf2ad86cf407703e3f2b0f76d",
      "skos:note": "Permits later use of exempt proceeding evidence in other proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-145",
      "@type": "cof:Section",
      "cof:title": "145 Evidence that has been given in exempt proceeding",
      "values:kind": "section",
      "cof:pageNumber": 347,
      "values:originalText": "If information is given in evidence in an exempt proceeding under\nsection 143 or 144, that information, or any part of that\ninformation, may later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nChapter 3  Preserving and accessing stored communications"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-145-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-145"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
