        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6-ss-2f"
        }
      ],
      "cml:integrityHash": "b4af8ca9c0b1723f78917c4584fddcdae72ebe8c5cf512ec3c35e9612f19088b"
