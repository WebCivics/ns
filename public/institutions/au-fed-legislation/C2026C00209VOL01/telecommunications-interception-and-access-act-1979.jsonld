    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-87-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "87(3) Power to obtain relevant information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-87-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
