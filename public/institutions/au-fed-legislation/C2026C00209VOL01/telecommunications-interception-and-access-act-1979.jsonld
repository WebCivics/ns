      "cml:premiseText": "(1) This Act does not extend to Norfolk Island.",
      "cml:conclusionText": "This Act does not apply to Norfolk Island."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-4b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4B(2) Application to Norfolk Island",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-4b-ss-2"
      },
      "cml:curationStatus": {
