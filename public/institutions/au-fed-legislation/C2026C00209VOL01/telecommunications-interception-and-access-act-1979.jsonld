      "skos:prefLabel": "186H Ombudsman not to be sued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.428",
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nChapter.",
      "skos:definition": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nChapter.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186h-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186h-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186h-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "863373f5b33bb5b1ea7b33298d477909d6d1d9531a05050c9e4a88bb8b30d70d",
      "skos:note": "No liability for acts done in good faith while performing a function or power under the Chapter."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186h",
      "@type": "cof:Section",
      "cof:title": "186H Ombudsman not to be sued",
      "values:kind": "section",
      "cof:pageNumber": 428,
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nChapter."
    },
    {
