    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-81e",
      "@type": "cml:Concept",
      "skos:prefLabel": "81E Provision of information by eligible authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-81e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
