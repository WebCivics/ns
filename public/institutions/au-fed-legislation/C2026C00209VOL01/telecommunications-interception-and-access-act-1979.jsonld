    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-74-ss-3",
      "@type": "cof:Section",
      "cof:title": "74(3) Giving information in evidence in exempt proceeding",
      "values:kind": "subsection",
      "cof:pageNumber": 244,
      "values:originalText": "(3) A person may give interception warrant information in evidence in\nan exempt proceeding.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 75\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-74-ss-3-norm",
