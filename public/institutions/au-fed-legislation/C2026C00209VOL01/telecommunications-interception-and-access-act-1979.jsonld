        }
      ],
      "cml:integrityHash": "c7cc571defc46913f299ba7ccc8ab66ef9882a89bb07150ce894c660db8f9733",
      "skos:note": "Authorises management office or position for enforcement agency purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5ab-ss-1",
      "@type": "cof:Section",
      "cof:title": "5AB(1) Authorised officers",
      "values:kind": "subsection",
