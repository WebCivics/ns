      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-119-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:logicSummary": "Recognize implications of varying warrant duration on issuing authority's power",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An issuing authority must not vary a stored communications\nwarrant by extending the period for which it is to be in force."
    },
