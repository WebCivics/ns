    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31d",
      "@type": "cml:Concept",
      "skos:prefLabel": "31D Reports to the Attorney-General",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.149",
      "values:originalText": "The head (however described) of a security authority, or a person\nacting as that head, must give to the Attorney-General, within 3\nmonths after an authorisation under section 31A given to the\nauthority ceases to have effect, a written report about:\n\n(a) the outcome of the development or testing of technologies, or\ninterception capabilities, in relation to which the\nauthorisation was given; and\n\n(b) the destruction of information or records under section 31C.\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "The head (however described) of a security authority, or a person\nacting as that head, must give to the Attorney-General, within 3\nmonths after an authorisation under section 31A given to the\nauthority ceases to have effect, a written report about:\n\n(a) the outcome of the development or testing of technologies, or\ninterception capabilities, in relation to which the\nauthorisation was given; and\n\n(b) the destruction of information or records under section 31C.\n\nChapter 2  Interception of telecommunications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31d-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9fd61d6f56dfdb053066948c8e160a1dd95e005eb7adae540c895716d28ba9f5",
      "skos:note": "Report on authorisation outcome and destruction of information",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31d",
      "@type": "cof:Section",
      "cof:title": "31D Reports to the Attorney-General",
      "values:kind": "section",
      "cof:pageNumber": 149,
      "values:originalText": "The head (however described) of a security authority, or a person\nacting as that head, must give to the Attorney-General, within 3\nmonths after an authorisation under section 31A given to the\nauthority ceases to have effect, a written report about:\n\n(a) the outcome of the development or testing of technologies, or\ninterception capabilities, in relation to which the\nauthorisation was given; and\n\n(b) the destruction of information or records under section 31C.\n\nChapter 2  Interception of telecommunications"
    },
