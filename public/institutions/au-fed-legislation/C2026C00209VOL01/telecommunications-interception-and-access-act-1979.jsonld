    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-42-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "42(5) Affidavit to accompany written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-42-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.162",
      "values:originalText": "(5) Notwithstanding subsection (1), a written application may be\naccompanied by 2 or more affidavits that together set out each\nmatter that, but for this subsection, this section would have\nrequired an affidavit accompanying the application to set out,\nspecify or state.",
      "skos:definition": "(5) Notwithstanding subsection (1), a written application may be\naccompanied by 2 or more affidavits that together set out each\nmatter that, but for this subsection, this section would have\nrequired an affidavit accompanying the application to set out,\nspecify or state.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-42"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-42-ss-5-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-42-ss-5-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-42-ss-5-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "ae6d5ebf536c2572c3b0f92e454f885bc796d33b44ffb5c198dad745c67626a9",
      "skos:note": "Allows multiple affidavits with written application"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-42-ss-5",
      "@type": "cof:Section",
      "cof:title": "42(5) Affidavit to accompany written application",
      "values:kind": "subsection",
      "cof:pageNumber": 162,
      "values:originalText": "(5) Notwithstanding subsection (1), a written application may be\naccompanied by 2 or more affidavits that together set out each\nmatter that, but for this subsection, this section would have\nrequired an affidavit accompanying the application to set out,\nspecify or state."
    },
