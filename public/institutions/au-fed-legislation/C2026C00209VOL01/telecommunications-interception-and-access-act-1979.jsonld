    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Temporal interval for urgent circumstances",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) shall include particulars of the urgent circumstances because of which the person making the application on the agency's behalf thinks it necessary to make the application by telephone;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Recurring trace for matters requiring written application",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) shall include each matter that, if the application had been made in writing, section 41, 42 or 48 would have required;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Diffusion of information to ART member",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) shall include particulars of the urgent circumstances because of which the person making the application on the agency's behalf thinks it necessary to make the application by telephone;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-44",
      "@type": "cml:Concept",
      "skos:prefLabel": "44 Giving further information to Judge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-44"
