    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-89",
      "@type": "cml:Concept",
      "skos:prefLabel": "89 Dealing with information for the purposes of inspection and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-89"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.267",
      "values:originalText": "report\n\nWhere:\n\n(a) information is given or communicated to an inspecting\nofficer, as permitted by subsection 88(2) or this section, for\nthe purposes of an inspection, or of a report on an inspection,\nunder this Part of an agency’s records; or\n\n(b) an inspecting officer obtains information as a result of being\ngiven access to records of an agency, as permitted by\nsubsection 88(2), for the purposes of an inspection under this\nPart of the agency’s records;\nthe inspecting officer may, notwithstanding section 63 or any other\nlaw, communicate to another inspecting officer, make use of, or\nmake a record of, the information for the purposes of an inspection,\nor of a report on an inspection, under this Part of the agency’s\nrecords.",
      "skos:definition": "report\n\nWhere:\n\n(a) information is given or communicated to an inspecting\nofficer, as permitted by subsection 88(2) or this section, for\nthe purposes of an inspection, or of a report on an inspection,\nunder this Part of an agency’s records; or\n\n(b) an inspecting officer obtains information as a result of being\ngiven access to records of an agency, as permitted by\nsubsection 88(2), for the purposes of an inspection under this\nPart of the agency’s records;\nthe inspecting officer may, notwithstanding section 63 or any other\nlaw, communicate to another inspecting officer, make use of, or\nmake a record of, the information for the purposes of an inspection,\nor of a report on an inspection, under this Part of the agency’s\nrecords.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-89-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-89-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "510a81fee997b532ab0a08a9cdc53fbbc300de53aa33e0a8c6a76c82833f25d0",
      "skos:note": "Inspecting officer may communicate information to another inspecting officer for inspection purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-89",
      "@type": "cof:Section",
      "cof:title": "89 Dealing with information for the purposes of inspection and",
      "values:kind": "section",
      "cof:pageNumber": 267,
      "values:originalText": "report\n\nWhere:\n\n(a) information is given or communicated to an inspecting\nofficer, as permitted by subsection 88(2) or this section, for\nthe purposes of an inspection, or of a report on an inspection,\nunder this Part of an agency’s records; or\n\n(b) an inspecting officer obtains information as a result of being\ngiven access to records of an agency, as permitted by\nsubsection 88(2), for the purposes of an inspection under this\nPart of the agency’s records;\nthe inspecting officer may, notwithstanding section 63 or any other\nlaw, communicate to another inspecting officer, make use of, or\nmake a record of, the information for the purposes of an inspection,\nor of a report on an inspection, under this Part of the agency’s\nrecords."
    },
