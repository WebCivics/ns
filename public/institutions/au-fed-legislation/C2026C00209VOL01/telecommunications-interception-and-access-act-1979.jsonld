    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-106",
      "@type": "cml:Concept",
      "skos:prefLabel": "106 Obstruction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-106"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.290",
      "values:originalText": "(1) A person shall not obstruct or hinder a person acting under a\nwarrant.\nPenalty: Imprisonment for 6 months.\n\nInterception of telecommunications  Chapter 2\nOffences  Part 2-9\n\nSection 107\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "(1) A person shall not obstruct or hinder a person acting under a\nwarrant.\nPenalty: Imprisonment for 6 months.\n\nInterception of telecommunications  Chapter 2\nOffences  Part 2-9\n\nSection 107\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-106-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-106-ss-2"
        }
      ],
