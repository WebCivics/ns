    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "180A(4) Authorisations for access to existing information or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180a-ss-4"
      },
