    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102a",
      "@type": "cml:Concept",
      "skos:prefLabel": "102A Report regarding interceptions without warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-102a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.284",
      "values:originalText": "The report must state, for each agency referred to in\nsubsection 7(8), the number of occasions on which an officer or\nstaff member of the agency intercepted a communication in\nreliance on subsection 7(4) or (5).",
      "skos:definition": "The report must state, for each agency referred to in\nsubsection 7(8), the number of occasions on which an officer or\nstaff member of the agency intercepted a communication in\nreliance on subsection 7(4) or (5).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-102a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "664a2e012f47952912fd93b241ca765c2f67abab04fe233f5d343925fd9000f1",
      "skos:note": "Agency must report interceptions without warrant.",
      "dc:description": "Number of occasions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-102a",
      "@type": "cof:Section",
      "cof:title": "102A Report regarding interceptions without warrant",
      "values:kind": "section",
      "cof:pageNumber": 284,
      "values:originalText": "The report must state, for each agency referred to in\nsubsection 7(8), the number of occasions on which an officer or\nstaff member of the agency intercepted a communication in\nreliance on subsection 7(4) or (5)."
    },
