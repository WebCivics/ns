      "cml:integrityHash": "c331dd9b3004448746a9e96e041860d336bfddcdd06afa429695c8255c24d202",
      "skos:note": "Imprisonment for a period not exceeding 6 months is prohibited for certain convictions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105-ss-4",
      "@type": "cof:Section",
      "cof:title": "105(4) Contravention of section 7 or 63",
      "values:kind": "subsection",
      "cof:pageNumber": 290,
      "values:originalText": "(4) Where, in accordance with subsection (3), a court of summary\njurisdiction convicts a person of an offence against subsection 7(1)\nor section 63, the penalty that the court may impose is\nimprisonment for a period not exceeding 6 months."
    },
