        }
      ],
      "cml:integrityHash": "1b4761dff47cf05d1f538c057ad278c4d7379b4c541fe0a145f0765bd9ca033f",
      "skos:note": "Giving stored communications warrant information in evidence in exempt proceeding"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-143-ss-3",
      "@type": "cof:Section",
      "cof:title": "143(3) Giving information in evidence in exempt proceeding",
      "values:kind": "subsection",
      "cof:pageNumber": 346,
      "values:originalText": "(3) A person may give stored communications warrant information in\nevidence in an exempt proceeding.\n\nPreserving and accessing stored communications  Chapter 3\nDealing with accessed information etc.  Part 3-4\nPermitted dealings with accessed information  Division 2\n\nSection 144\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
