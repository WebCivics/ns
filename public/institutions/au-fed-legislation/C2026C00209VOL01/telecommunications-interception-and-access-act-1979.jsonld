      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4c",
      "@type": "cml:Concept",
      "skos:prefLabel": "31A(4C) Attorney-General may authorise interception for developing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31a-ss-4c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.146",
      "values:originalText": "(4C) The reference in subsection (1) and subparagraph (2)(a)(i) to\ninterception of communications passing over a telecommunications\nsystem includes a reference to the accessing of the communications\nas stored communications after they have ceased to pass over a\ntelecommunications system.",
      "skos:definition": "(4C) The reference in subsection (1) and subparagraph (2)(a)(i) to\ninterception of communications passing over a telecommunications\nsystem includes a reference to the accessing of the communications\nas stored communications after they have ceased to pass over a\ntelecommunications system.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4c-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4c-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4c-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d16cb2389407601880b9bca2339f3981334d0f4c3e50c12776057cc344c92b96",
      "skos:note": "Attorney-General may authorise interception for developing purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31a-ss-4c",
      "@type": "cof:Section",
      "cof:title": "31A(4C) Attorney-General may authorise interception for developing",
      "values:kind": "subsection",
      "cof:pageNumber": 146,
      "values:originalText": "(4C) The reference in subsection (1) and subparagraph (2)(a)(i) to\ninterception of communications passing over a telecommunications\nsystem includes a reference to the accessing of the communications\nas stored communications after they have ceased to pass over a\ntelecommunications system."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4c-norm",
