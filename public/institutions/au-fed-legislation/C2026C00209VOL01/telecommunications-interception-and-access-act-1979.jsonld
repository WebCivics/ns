    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-93",
      "@type": "cml:Concept",
      "skos:prefLabel": "93 Annual reports to Minister about interceptions under Part 2-3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-93"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.271",
      "values:originalText": "The Managing Director of a carrier shall, as soon as practicable\nafter each 30 June, give to the Minister a written report about the\ninterceptions carried out by employees of the carrier pursuant to\nrequests made, or purporting to be made, under section 30 during\nthe year ending on that 30 June.",
      "skos:definition": "The Managing Director of a carrier shall, as soon as practicable\nafter each 30 June, give to the Minister a written report about the\ninterceptions carried out by employees of the carrier pursuant to\nrequests made, or purporting to be made, under section 30 during\nthe year ending on that 30 June.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-93-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-93-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-93-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "d02b24f1fd2f03e94e87025982d553be9badb2292719df0a3d1386fb0b151983",
      "skos:note": "Annual report on interceptions by employees",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-93",
      "@type": "cof:Section",
      "cof:title": "93 Annual reports to Minister about interceptions under Part 2-3",
      "values:kind": "section",
      "cof:pageNumber": 271,
      "values:originalText": "The Managing Director of a carrier shall, as soon as practicable\nafter each 30 June, give to the Minister a written report about the\ninterceptions carried out by employees of the carrier pursuant to\nrequests made, or purporting to be made, under section 30 during\nthe year ending on that 30 June."
    },
