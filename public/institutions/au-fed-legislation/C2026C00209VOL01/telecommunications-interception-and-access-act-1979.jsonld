    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-163a",
      "@type": "cml:Concept",
      "skos:prefLabel": "163A Report regarding international requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-163a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.358",
      "values:originalText": "The report must set out the number of occasions on which lawfully\naccessed information or stored communications warrant\ninformation was communicated under subsection 139(1) or\nsection 142 to any of the following:\n\n(a) a foreign country;\n\n(b) the International Criminal Court;\n\n(c) a War Crimes Tribunal;\nfor a purpose connected with an authorisation referred to in\nparagraph 139(2)(e).\n\nPreserving and accessing stored communications  Chapter 3\nReports about access to stored communications  Part 3-6\nProvisions about annual reports  Division 3\n\nSection 164\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "The report must set out the number of occasions on which lawfully\naccessed information or stored communications warrant\ninformation was communicated under subsection 139(1) or\nsection 142 to any of the following:\n\n(a) a foreign country;\n\n(b) the International Criminal Court;\n\n(c) a War Crimes Tribunal;\nfor a purpose connected with an authorisation referred to in\nparagraph 139(2)(e).\n\nPreserving and accessing stored communications  Chapter 3\nReports about access to stored communications  Part 3-6\nProvisions about annual reports  Division 3\n\nSection 164\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-163a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-163a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db5b6e026d6ae1e497792aae8abcd66d1314211a2f9fb9f6817eed5c6c1b01b8",
      "skos:note": "Report must set out number of occasions information was communicated under subsection 139(1) or section 142 to certain entities."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-163a",
      "@type": "cof:Section",
      "cof:title": "163A Report regarding international requests",
      "values:kind": "section",
      "cof:pageNumber": 358,
      "values:originalText": "The report must set out the number of occasions on which lawfully\naccessed information or stored communications warrant\ninformation was communicated under subsection 139(1) or\nsection 142 to any of the following:\n\n(a) a foreign country;\n\n(b) the International Criminal Court;\n\n(c) a War Crimes Tribunal;\nfor a purpose connected with an authorisation referred to in\nparagraph 139(2)(e).\n\nPreserving and accessing stored communications  Chapter 3\nReports about access to stored communications  Part 3-6\nProvisions about annual reports  Division 3\n\nSection 164\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
