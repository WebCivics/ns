      ],
      "cml:integrityHash": "67508be0b1f69d98250a0798364ef007381cf738a80c64c79b5b020f7bcfeea4",
      "skos:note": "Dealing in information obtained by Organisation is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-137-ss-4",
      "@type": "cof:Section",
