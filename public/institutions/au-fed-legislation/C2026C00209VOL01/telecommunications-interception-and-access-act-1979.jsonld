        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Definition of serious contravention",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A serious contravention is a contravention of a law...",
      "cml:conclusionText": "This is a serious contravention."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Conditions for seriousness",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The contravention must be an offence punishable by imprisonment...",
      "cml:conclusionText": "This contravention must meet the conditions for seriousness."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "5E(2) Serious contraventions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5e-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.88",
      "values:originalText": "(2) Except so far as the contrary intention appears, a contravention, or\na contravention of a particular kind, is taken, for the purposes of\nthis Act, to be a contravention, or to be a contravention of that\nkind, as the case may be, that:\n\n(a) has been committed or is being committed; or\n\n(b) is suspected on reasonable grounds of having been\ncommitted, of being committed or of being likely to be\ncommitted.",
      "skos:definition": "(2) Except so far as the contrary intention appears, a contravention, or\na contravention of a particular kind, is taken, for the purposes of\nthis Act, to be a contravention, or to be a contravention of that\nkind, as the case may be, that:\n\n(a) has been committed or is being committed; or\n\n(b) is suspected on reasonable grounds of having been\ncommitted, of being committed or of being likely to be\ncommitted.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-2-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-2-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5e-ss-2-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "32ad76634182b6ff75597a0a6913b6c787af75f39f74555ec0bd45d5e8fbcab6",
      "skos:note": "A contravention is taken to be a contravention if it has been committed or is suspected on reasonable grounds of having been committed."
    },
