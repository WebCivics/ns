    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-18-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "18(5) Evidentiary certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-18-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.140",
      "values:originalText": "(5) A document purporting to be a certificate issued under\nsubsection (3) or (4) by the Director-General of Security or the\nDeputy Director-General of Security and to be signed by him or\nher is to be received in evidence in an exempt proceeding without\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "(5) A document purporting to be a certificate issued under\nsubsection (3) or (4) by the Director-General of Security or the\nDeputy Director-General of Security and to be signed by him or\nher is to be received in evidence in an exempt proceeding without\n\nChapter 2  Interception of telecommunications",
      "values:partOf": {
