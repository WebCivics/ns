    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "9B(4) Provisions applying to warrants issued under section 9 or 9A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-9b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.123",
      "values:originalText": "(4) Subsection (3) does not prevent the issue of a further warrant in\nrespect of a telecommunications service or a person (as the case\nmay be) in relation to which or whom a warrant has, or warrants\nhave, previously been issued.\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "(4) Subsection (3) does not prevent the issue of a further warrant in\nrespect of a telecommunications service or a person (as the case\nmay be) in relation to which or whom a warrant has, or warrants\nhave, previously been issued.\n\nChapter 2  Interception of telecommunications",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9b-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9b-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7dfdcc23f7a785b13802767ab8636f071b789cacff262d7b60dd3f96e14acbd",
      "skos:note": "Issue of further warrant despite previous warrants"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-9b-ss-4",
      "@type": "cof:Section",
      "cof:title": "9B(4) Provisions applying to warrants issued under section 9 or 9A",
      "values:kind": "subsection",
      "cof:pageNumber": 123,
      "values:originalText": "(4) Subsection (3) does not prevent the issue of a further warrant in\nrespect of a telecommunications service or a person (as the case\nmay be) in relation to which or whom a warrant has, or warrants\nhave, previously been issued.\n\nChapter 2  Interception of telecommunications"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9b-ss-4-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9b-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
