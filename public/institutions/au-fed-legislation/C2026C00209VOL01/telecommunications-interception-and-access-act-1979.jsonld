    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-108-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "108(2) Stored communications not to be accessed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-108-ss-2"
      },
