    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6n",
      "@type": "cml:Concept",
      "skos:prefLabel": "6N Declaration of staff members of State Police Forces",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.108",
      "values:originalText": "(1) This section applies to an agency that is the Police Force of a State.\n\n(2) The Minister may make a written declaration that members of an\nagency included in a specified class of members of the agency\noccupy positions corresponding to those of AFP employees who\nare not members of the Australian Federal Police.\n\n(3) Members included in the class of members of an agency specified\nin a declaration are referred to in this Act, in relation to the agency\nconcerned, as staff members.",
      "skos:definition": "(1) This section applies to an agency that is the Police Force of a State.\n\n(2) The Minister may make a written declaration that members of an\nagency included in a specified class of members of the agency\noccupy positions corresponding to those of AFP employees who\nare not members of the Australian Federal Police.\n\n(3) Members included in the class of members of an agency specified\nin a declaration are referred to in this Act, in relation to the agency\nconcerned, as staff members.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6n-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6n-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6n-ss-3"
        }
      ],
      "cml:integrityHash": "6aa7ecfcab95f6542f6959270f5c8cd12357b0b5b7efe2e61bbcaab472c9dcba"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6n",
      "@type": "cof:Section",
      "cof:title": "6N Declaration of staff members of State Police Forces",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "(1) This section applies to an agency that is the Police Force of a State.\n\n(2) The Minister may make a written declaration that members of an\nagency included in a specified class of members of the agency\noccupy positions corresponding to those of AFP employees who\nare not members of the Australian Federal Police.\n\n(3) Members included in the class of members of an agency specified\nin a declaration are referred to in this Act, in relation to the agency\nconcerned, as staff members."
    },
