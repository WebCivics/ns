    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6h",
      "@type": "cml:Concept",
      "skos:prefLabel": "6H Person to whom application relates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.103",
      "values:originalText": "For the purposes of this Act, an application by an agency to a\nJudge or nominated ART member for a warrant relates to a\nparticular person if, and only if, information has been, or is\nproposed to be, given to the Judge or nominated ART member\nunder Part 2-5, in connection with the application, in order to\nsatisfy the Judge or nominated ART member, in relation to the\nperson, of the matters referred to in:\n\n(a) in the case of a warrant under section 48—paragraphs\n46(1)(c) and (d), 46(4)(c), (d) and (e), 46(7)(c) to (h),\n46(9)(c), (d) and (e), or 46(12)(c) to (g), as the case requires;\nor\n\n(b) in the case of any other Part 2-5 warrant—paragraphs\n46(1)(c) and (d), 46(4)(c), (d) and (e), 46(7)(c) to (h),\n46A(1)(c) and (d), 46A(2A)(c), (d) and (e), 46A(2C)(c) to\n(h), 46A(2E)(c), (d) and (e), or 46A(2G)(a) to (g), as the case\nrequires; or\n\n(c) in the case of a stored communications warrant—\nsubparagraph 116(1)(d)(i) or (ii), as the case requires.",
      "skos:definition": "For the purposes of this Act, an application by an agency to a\nJudge or nominated ART member for a warrant relates to a\nparticular person if, and only if, information has been, or is\nproposed to be, given to the Judge or nominated ART member\nunder Part 2-5, in connection with the application, in order to\nsatisfy the Judge or nominated ART member, in relation to the\nperson, of the matters referred to in:\n\n(a) in the case of a warrant under section 48—paragraphs\n46(1)(c) and (d), 46(4)(c), (d) and (e), 46(7)(c) to (h),\n46(9)(c), (d) and (e), or 46(12)(c) to (g), as the case requires;\nor\n\n(b) in the case of any other Part 2-5 warrant—paragraphs\n46(1)(c) and (d), 46(4)(c), (d) and (e), 46(7)(c) to (h),\n46A(1)(c) and (d), 46A(2A)(c), (d) and (e), 46A(2C)(c) to\n(h), 46A(2E)(c), (d) and (e), or 46A(2G)(a) to (g), as the case\nrequires; or\n\n(c) in the case of a stored communications warrant—\nsubparagraph 116(1)(d)(i) or (ii), as the case requires.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6h-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6h-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3b3660e3ea43c31c39fc2b94c1eaa498aad23f6082a4d4c57e7c7fbf76b8f8d4",
      "skos:note": "Information must be provided to satisfy the Judge or nominated ART member about a particular person.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6h",
      "@type": "cof:Section",
      "cof:title": "6H Person to whom application relates",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "For the purposes of this Act, an application by an agency to a\nJudge or nominated ART member for a warrant relates to a\nparticular person if, and only if, information has been, or is\nproposed to be, given to the Judge or nominated ART member\nunder Part 2-5, in connection with the application, in order to\nsatisfy the Judge or nominated ART member, in relation to the\nperson, of the matters referred to in:\n\n(a) in the case of a warrant under section 48—paragraphs\n46(1)(c) and (d), 46(4)(c), (d) and (e), 46(7)(c) to (h),\n46(9)(c), (d) and (e), or 46(12)(c) to (g), as the case requires;\nor\n\n(b) in the case of any other Part 2-5 warrant—paragraphs\n46(1)(c) and (d), 46(4)(c), (d) and (e), 46(7)(c) to (h),\n46A(1)(c) and (d), 46A(2A)(c), (d) and (e), 46A(2C)(c) to\n(h), 46A(2E)(c), (d) and (e), or 46A(2G)(a) to (g), as the case\nrequires; or\n\n(c) in the case of a stored communications warrant—\nsubparagraph 116(1)(d)(i) or (ii), as the case requires."
    },
