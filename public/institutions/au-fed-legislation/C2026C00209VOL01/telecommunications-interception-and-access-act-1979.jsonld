        "@id": "cml:Deontic"
      },
      "cml:operator": "applies",
      "cml:logicSummary": "The Part applies to the specified types of information, interceptions, and proceedings.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
