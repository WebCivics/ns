    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-141",
      "@type": "cml:Concept",
      "skos:prefLabel": "141 Making record for purpose of permitted communication",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-141"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.345",
      "values:originalText": "A person who is permitted by section 135, 137 or 138 or\nsubsection 140(1) to communicate particular information to\nanother person may:\n\n(a) make a record of the information, or\n\n(b) cause such a record to be made;\nfor the purpose of so communicating the information in accordance\nwith that section or subsection.",
      "skos:definition": "A person who is permitted by section 135, 137 or 138 or\nsubsection 140(1) to communicate particular information to\nanother person may:\n\n(a) make a record of the information, or\n\n(b) cause such a record to be made;\nfor the purpose of so communicating the information in accordance\nwith that section or subsection.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-141-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-141-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "022b8c08caf5226499c46d1fc7659756b896009d9ad2b1da1c128c4ac1e3de76",
      "skos:note": "A person who is permitted by section 135, 137 or 138 or subsection 140(1) to communicate particular information to another person may make a record of the information."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-141",
      "@type": "cof:Section",
      "cof:title": "141 Making record for purpose of permitted communication",
      "values:kind": "section",
      "cof:pageNumber": 345,
      "values:originalText": "A person who is permitted by section 135, 137 or 138 or\nsubsection 140(1) to communicate particular information to\nanother person may:\n\n(a) make a record of the information, or\n\n(b) cause such a record to be made;\nfor the purpose of so communicating the information in accordance\nwith that section or subsection."
    },
