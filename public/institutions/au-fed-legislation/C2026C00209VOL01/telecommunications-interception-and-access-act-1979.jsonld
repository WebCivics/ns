          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-167-norm"
        }
      ],
      "cml:integrityHash": "de14083273d4b085b84f83e2661176491cf6e57a8bb76b5bd5e732768c1dc9d2",
      "skos:note": "No limitation on liability under other provisions or laws"
    },
