    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.163",
      "values:originalText": "The information given to a Judge or nominated ART member in\nconnection with a telephone application to the Judge or nominated\nART member:\n\n(a) shall include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\nbehalf thinks it necessary to make the application by\ntelephone;\n\n(b) shall include each matter that, if the application had been\nmade in writing, section 41, 42 or 48 would have required the\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "The information given to a Judge or nominated ART member in\nconnection with a telephone application to the Judge or nominated\nART member:\n\n(a) shall include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\nbehalf thinks it necessary to make the application by\ntelephone;\n\n(b) shall include each matter that, if the application had been\nmade in writing, section 41, 42 or 48 would have required the\n\nChapter 2  Interception of telecommunications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-43-logic-diffusion-4"
        }
      ],
      "cml:integrityHash": "606280077b7e71bd3b86285a731dbe24938f8469daad2ca84d966e2c379d3202",
      "skos:note": "Provide information on telephone application",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-43",
      "@type": "cof:Section",
      "cof:title": "43 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 163,
      "values:originalText": "The information given to a Judge or nominated ART member in\nconnection with a telephone application to the Judge or nominated\nART member:\n\n(a) shall include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\nbehalf thinks it necessary to make the application by\ntelephone;\n\n(b) shall include each matter that, if the application had been\nmade in writing, section 41, 42 or 48 would have required the\n\nChapter 2  Interception of telecommunications"
    },
    {
