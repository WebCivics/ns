    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107v",
      "@type": "cml:Concept",
      "skos:prefLabel": "107V Certified copies of preservation notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.309",
      "values:originalText": "A document certified in writing by a certifying official of an\nissuing agency to be a true copy of a preservation notice is to be\nreceived in evidence in an exempt proceeding as if it were the\noriginal preservation notice.",
      "skos:definition": "A document certified in writing by a certifying official of an\nissuing agency to be a true copy of a preservation notice is to be\nreceived in evidence in an exempt proceeding as if it were the\noriginal preservation notice.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107v-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107v-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "34ee5ff31efd1abeb7e084105ff3d6de1ed9582ac7583092af09bdc855861239",
      "skos:note": "Exempt proceedings must receive certified copies of preservation notices as evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107v",
      "@type": "cof:Section",
      "cof:title": "107V Certified copies of preservation notices",
      "values:kind": "section",
      "cof:pageNumber": 309,
      "values:originalText": "A document certified in writing by a certifying official of an\nissuing agency to be a true copy of a preservation notice is to be\nreceived in evidence in an exempt proceeding as if it were the\noriginal preservation notice."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107v-norm",
