      "skos:note": "Must provide a copy of authorisation to the Communications Access Coordinator.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5ab-ss-2",
