    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-92-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "The Ombudsman may exercise or perform a power or function despite Section 11A.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman Act 1976",
      "cml:conclusionText": "Section 11A does not prohibit the Ombudsman from exercising or performing a power or function."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-92-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Ombudsman is obligated to exercise or perform a power or function despite Section 11A.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman Act 1976",
      "cml:conclusionText": "Section 11A does not relieve the Ombudsman of its obligations."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-92-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "92(2) Application of Ombudsman Act",
