          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-76a-ss-1-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "a9abd53e33a17803fe840a5be954e8494aedaf687b5a04454c527eb4447fdd8d",
      "skos:note": "Giving information in evidence in civil proceedings for remedial"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-76a-ss-1",
      "@type": "cof:Section",
      "cof:title": "76A(1) Giving information in evidence in civil proceedings for remedial",
      "values:kind": "subsection",
      "cof:pageNumber": 246,
      "values:originalText": "(1) A person may give information obtained by intercepting a\ncommunication in contravention of subsection 7(1) in evidence in a\nproceeding by way of an application under section 107A for\nremedial relief in respect of:\n\n(a) the interception; or\n\n(b) the communication (in contravention of section 63) of\ninformation obtained by the interception."
    },
