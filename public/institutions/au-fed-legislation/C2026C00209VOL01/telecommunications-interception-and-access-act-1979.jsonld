      },
      "cml:premiseText": "The Minister is making a declaration under section 34.",
      "cml:conclusionText": "The report must be given within 3 months after the warrant ceases to be in force."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-35-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The chief officer of the eligible authority must give a written report.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister is making a declaration under section 34.",
      "cml:conclusionText": "The chief officer of the eligible authority must give a written report."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-35-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The chief officer of the eligible authority must impose requirements corresponding to those imposed on Commonwealth agencies.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister is making a declaration under section 34.",
      "cml:conclusionText": "The chief officer of the eligible authority must impose requirements corresponding to those imposed on Commonwealth agencies."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-35-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The chief officer of the eligible authority must give a report about the use made by the eligible authority of information obtained by interceptions under the warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
