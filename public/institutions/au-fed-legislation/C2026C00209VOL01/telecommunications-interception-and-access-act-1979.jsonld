    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "5A Communicating etc. certain information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.75",
      "values:originalText": "For the purposes of this Act (other than Schedule 1), a person who\ngives to another person, makes use of, makes a record of, or\nproduces in evidence in a proceeding, a record (in this section\ncalled the relevant record) obtained by an interception, whether or\nnot in contravention of subsection 7(1), of a communication shall\n\nChapter 1  Introduction",
      "skos:definition": "For the purposes of this Act (other than Schedule 1), a person who\ngives to another person, makes use of, makes a record of, or\nproduces in evidence in a proceeding, a record (in this section\ncalled the relevant record) obtained by an interception, whether or\nnot in contravention of subsection 7(1), of a communication shall\n\nChapter 1  Introduction",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "380f732db6263f97e9402de93f6e53f3633d6043e89117d369ab1e5128066118",
      "skos:note": "A person who gives, makes use of, or produces a record obtained by interception must provide the relevant record in a proceeding.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5a",
      "@type": "cof:Section",
      "cof:title": "5A Communicating etc. certain information",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "For the purposes of this Act (other than Schedule 1), a person who\ngives to another person, makes use of, makes a record of, or\nproduces in evidence in a proceeding, a record (in this section\ncalled the relevant record) obtained by an interception, whether or\nnot in contravention of subsection 7(1), of a communication shall\n\nChapter 1  Introduction"
    },
