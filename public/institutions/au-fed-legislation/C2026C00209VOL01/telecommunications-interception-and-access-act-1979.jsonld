      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chief officer of a criminal law-enforcement agency...",
      "cml:conclusionText": "may approve any of the following persons to exercise the authority conferred by warrants."
    },
