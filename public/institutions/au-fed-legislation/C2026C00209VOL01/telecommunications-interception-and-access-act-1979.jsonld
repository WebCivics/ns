    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "6AA Accessing a stored communication",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.94",
      "values:originalText": "For the purposes of this Act, accessing a stored communication\nconsists of listening to, reading or recording such a\ncommunication, by means of equipment operated by a carrier,\nwithout the knowledge of the intended recipient of the\ncommunication.",
      "skos:definition": "For the purposes of this Act, accessing a stored communication\nconsists of listening to, reading or recording such a\ncommunication, by means of equipment operated by a carrier,\nwithout the knowledge of the intended recipient of the\ncommunication.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6aa-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6aa-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6aa-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "fe5132aa077549d34ba314a77cd3faee89d9beff16c86608cec9ca75e1b1027c",
      "skos:note": "Accessing stored communication without knowledge of recipient is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6aa",
      "@type": "cof:Section",
      "cof:title": "6AA Accessing a stored communication",
      "values:kind": "section",
