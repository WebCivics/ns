      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.378",
      "values:originalText": "(2) An authorised officer of the Australian Federal Police may\nauthorise the disclosure of specified information or specified\ndocuments that come into existence during the period for which the\nauthorisation is in force.",
      "skos:definition": "(2) An authorised officer of the Australian Federal Police may\nauthorise the disclosure of specified information or specified\ndocuments that come into existence during the period for which the\nauthorisation is in force.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-2-norm"
        }
