    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-132",
      "@type": "cml:Concept",
      "skos:prefLabel": "132 Obstruction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-132"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.333",
      "values:originalText": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).\n\nChapter 3  Preserving and accessing stored communications",
      "skos:definition": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).\n\nChapter 3  Preserving and accessing stored communications",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-132-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-132-ss-2"
        }
      ],
      "cml:integrityHash": "d223b30bc8b1d97840afc3a049b0a08217c93e15c95b4a471962d3ce252daa6c"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-132",
      "@type": "cof:Section",
      "cof:title": "132 Obstruction",
      "values:kind": "section",
      "cof:pageNumber": 333,
      "values:originalText": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).\n\nChapter 3  Preserving and accessing stored communications"
    },
