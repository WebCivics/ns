    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-149",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Evidence that is otherwise inadmissible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.350",
      "values:originalText": "This Part does not render:\n\n(a) information; or\n\n(b) any record that was obtained by accessing a stored\ncommunication (whether or not in contravention of\nsubsection 108(1));\nadmissible in evidence in a proceeding to a greater extent than it\nwould have been admissible in evidence in that proceeding if this\nPart had not been enacted.\n\nPreserving and accessing stored communications  Chapter 3\nDealing with accessed information etc.  Part 3-4\nDestruction of records  Division 4\n\nSection 150\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "This Part does not render:\n\n(a) information; or\n\n(b) any record that was obtained by accessing a stored\ncommunication (whether or not in contravention of\nsubsection 108(1));\nadmissible in evidence in a proceeding to a greater extent than it\nwould have been admissible in evidence in that proceeding if this\nPart had not been enacted.\n\nPreserving and accessing stored communications  Chapter 3\nDealing with accessed information etc.  Part 3-4\nDestruction of records  Division 4\n\nSection 150\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-149-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-149-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f1ba82bf6ea7ffda92b9e550cbce31f8a39aa9f7e1535d71dba33ed9055e8b7",
      "skos:note": "Preserves admissibility of records obtained by accessing stored communications"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-149",
      "@type": "cof:Section",
      "cof:title": "149 Evidence that is otherwise inadmissible",
      "values:kind": "section",
      "cof:pageNumber": 350,
      "values:originalText": "This Part does not render:\n\n(a) information; or\n\n(b) any record that was obtained by accessing a stored\ncommunication (whether or not in contravention of\nsubsection 108(1));\nadmissible in evidence in a proceeding to a greater extent than it\nwould have been admissible in evidence in that proceeding if this\nPart had not been enacted.\n\nPreserving and accessing stored communications  Chapter 3\nDealing with accessed information etc.  Part 3-4\nDestruction of records  Division 4\n\nSection 150\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-149-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-149"
      },
