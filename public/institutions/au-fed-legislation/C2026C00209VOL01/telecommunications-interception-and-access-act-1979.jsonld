      },
      "cml:operator": "diffusion",
      "cml:logicSummary": "Spread of warrant's effect despite supervisory order change.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Warrant issued on basis of supervisory order.",
      "cml:conclusionText": "Warrant continues to have effect."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-49-ss-6a-logic-cogai-5",
