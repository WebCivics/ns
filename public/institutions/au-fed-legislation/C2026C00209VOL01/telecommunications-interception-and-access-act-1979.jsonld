    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107w",
      "@type": "cml:Concept",
      "skos:prefLabel": "107W How notices are to be given to carriers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.309",
      "values:originalText": "For the purposes of this Part:\n\n(a) a preservation notice; or\n\n(b) a revocation notice under section 107L or 107R;\nmay only be given to a carrier by giving it to an authorised\nrepresentative of the carrier.\n\nChapter 3  Preserving and accessing stored communications",
      "skos:definition": "For the purposes of this Part:\n\n(a) a preservation notice; or\n\n(b) a revocation notice under section 107L or 107R;\nmay only be given to a carrier by giving it to an authorised\nrepresentative of the carrier.\n\nChapter 3  Preserving and accessing stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107w-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107w-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ce3a78ac1a8688a1a79d08a5983bd42d2a168d6daea67c63be28346060f50091",
      "skos:note": "Notice must be given to an authorized representative of the carrier."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107w",
      "@type": "cof:Section",
      "cof:title": "107W How notices are to be given to carriers",
      "values:kind": "section",
      "cof:pageNumber": 309,
      "values:originalText": "For the purposes of this Part:\n\n(a) a preservation notice; or\n\n(b) a revocation notice under section 107L or 107R;\nmay only be given to a carrier by giving it to an authorised\nrepresentative of the carrier.\n\nChapter 3  Preserving and accessing stored communications"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107w-norm",
