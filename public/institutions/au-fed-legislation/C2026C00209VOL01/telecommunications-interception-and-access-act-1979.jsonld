      "cml:integrityHash": "a4f8cdabee37d6eaf1d94b535b98172c2128d46ec585da6a35d7e8481fc9f383",
      "skos:note": "Exclusion of inspecting officer's actions from Ombudsman Act reference"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-92-ss-2",
      "@type": "cof:Section",
      "cof:title": "92(2) Application of Ombudsman Act",
      "values:kind": "subsection",
      "cof:pageNumber": 268,
      "values:originalText": "(2) A reference in section 19 of the Ombudsman Act 1976 to the\nOmbudsman’s operations does not include a reference to anything\nthat an inspecting officer has done or omitted to do under this Part."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-92-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-92-ss-2"
      },
      "values:deonticStatus": {
