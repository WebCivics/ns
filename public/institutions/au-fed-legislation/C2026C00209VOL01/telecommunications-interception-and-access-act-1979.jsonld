    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Ombudsman not to be sued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.267",
      "values:originalText": "Subject to the provisions applying by virtue of subsection 92(3), an\ninspecting officer, or a person acting under an inspecting officer’s\ndirection or authority, is not liable to an action, suit or proceeding\nfor or in relation to an act done, or omitted to be done, in good\nfaith in the performance or exercise, or the purported performance\nor exercise, of a function, power or authority conferred by this Part.",
      "skos:definition": "Subject to the provisions applying by virtue of subsection 92(3), an\ninspecting officer, or a person acting under an inspecting officer’s\ndirection or authority, is not liable to an action, suit or proceeding\nfor or in relation to an act done, or omitted to be done, in good\nfaith in the performance or exercise, or the purported performance\nor exercise, of a function, power or authority conferred by this Part.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-90-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-90-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bbd478568c4643d8990736966d9ba9427f607304a0bc82f55716abc3ba6210e1",
      "skos:note": "No liability for acts done in good faith"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-90",
      "@type": "cof:Section",
      "cof:title": "90 Ombudsman not to be sued",
      "values:kind": "section",
      "cof:pageNumber": 267,
      "values:originalText": "Subject to the provisions applying by virtue of subsection 92(3), an\ninspecting officer, or a person acting under an inspecting officer’s\ndirection or authority, is not liable to an action, suit or proceeding\nfor or in relation to an act done, or omitted to be done, in good\nfaith in the performance or exercise, or the purported performance\nor exercise, of a function, power or authority conferred by this Part."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-90-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-90"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-90-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If an act is done in good faith, then no liability",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Act done in good faith",
      "cml:conclusionText": "No liability"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-91",
      "@type": "cml:Concept",
      "skos:prefLabel": "91 Delegation by Ombudsman",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-91"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.267",
      "values:originalText": "(1) The Ombudsman may, either generally or as otherwise provided by\nthe instrument of delegation, delegate to another inspecting officer,\nall or any of the Ombudsman’s powers under this Part other than a\npower to report to the Minister and this power of delegation.\n\n(2) A power so delegated, when exercised by the delegate, shall, for\nthe purposes of this Part, be deemed to have been exercised by the\nOmbudsman.\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "(1) The Ombudsman may, either generally or as otherwise provided by\nthe instrument of delegation, delegate to another inspecting officer,\nall or any of the Ombudsman’s powers under this Part other than a\npower to report to the Minister and this power of delegation.\n\n(2) A power so delegated, when exercised by the delegate, shall, for\nthe purposes of this Part, be deemed to have been exercised by the\nOmbudsman.\n\nChapter 2  Interception of telecommunications",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-91-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-91-ss-2"
        }
      ],
      "cml:integrityHash": "c3c945d3519733a619ff85f34a6ef6d68e87a717992b5dbf2cc4bd438e423a3f"
    },
    {
