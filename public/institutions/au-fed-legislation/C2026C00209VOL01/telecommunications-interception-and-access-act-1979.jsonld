          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-1a"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-1b"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-3"
        },
