      ],
      "cml:integrityHash": "3cc75ae558b214370b211a2f17fb924f749c8ad66f448f2d344c3e975314238f",
      "skos:note": "Comply with section within one day after warrant issuance"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-51-ss-1",
      "@type": "cof:Section",
      "cof:title": "51(1) Action by agency after warrant issued on telephone application",
      "values:kind": "subsection",
      "cof:pageNumber": 197,
      "values:originalText": "(1) A person (in this section called the applicant) who makes a\ntelephone application on an agency’s behalf shall comply with this\nsection within one day after the day on which a warrant is issued\non the application."
    },
    {
