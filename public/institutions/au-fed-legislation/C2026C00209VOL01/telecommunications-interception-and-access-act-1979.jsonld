    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-170",
      "@type": "cml:Concept",
      "skos:prefLabel": "170 Extended meaning of conviction—orders under section 19B of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-170"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.364",
      "values:originalText": "the Crimes Act 1914\n\nA reference in this Part to the conviction of a person of an offence\nincludes a reference to the making of an order under section 19B of\nthe Crimes Act 1914 in relation to a person in respect of an offence.\nNote:\nSection 19B of the Crimes Act 1914 empowers a court that has found\na person to have committed an offence to take action without\nproceeding to record a conviction.\n\nAccess to telecommunications data  Chapter 4\nPermitted access to telecommunications data  Part 4-1\nOutline of Part  Division 1\n\nSection 171\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026\n\nChapter 4—Access to telecommunications\ndata",
      "skos:definition": "the Crimes Act 1914\n\nA reference in this Part to the conviction of a person of an offence\nincludes a reference to the making of an order under section 19B of\nthe Crimes Act 1914 in relation to a person in respect of an offence.\nNote:\nSection 19B of the Crimes Act 1914 empowers a court that has found\na person to have committed an offence to take action without\nproceeding to record a conviction.\n\nAccess to telecommunications data  Chapter 4\nPermitted access to telecommunications data  Part 4-1\nOutline of Part  Division 1\n\nSection 171\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026\n\nChapter 4—Access to telecommunications\ndata",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-170-norm"
        },
