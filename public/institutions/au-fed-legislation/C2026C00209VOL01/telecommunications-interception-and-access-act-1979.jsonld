    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-74",
      "@type": "cml:Concept",
      "skos:prefLabel": "74 Giving information in evidence in exempt proceeding",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-74"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.244",
      "values:originalText": "(1) A person may give lawfully intercepted information (other than\nforeign intelligence information, general computer access intercept\ninformation, data disruption intercept information, network activity\nwarrant intercept information or ASIO computer access intercept\ninformation) in evidence in an exempt proceeding.\n\n(2) For the purposes of applying subsection (1) in relation to\ninformation, the question whether or not a communication was\nintercepted in contravention of subsection 7(1) may be determined\non the balance of probabilities.\n\n(3) A person may give interception warrant information in evidence in\nan exempt proceeding.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 75\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "(1) A person may give lawfully intercepted information (other than\nforeign intelligence information, general computer access intercept\ninformation, data disruption intercept information, network activity\nwarrant intercept information or ASIO computer access intercept\ninformation) in evidence in an exempt proceeding.\n\n(2) For the purposes of applying subsection (1) in relation to\ninformation, the question whether or not a communication was\nintercepted in contravention of subsection 7(1) may be determined\non the balance of probabilities.\n\n(3) A person may give interception warrant information in evidence in\nan exempt proceeding.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 75\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-74-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-74-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-74-ss-3"
        }
      ],
      "cml:integrityHash": "264b775e07bbd0a03ec20c996b3821b9110743ec0d5394539ee0a7e9f17b6021"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-74",
      "@type": "cof:Section",
      "cof:title": "74 Giving information in evidence in exempt proceeding",
      "values:kind": "section",
      "cof:pageNumber": 244,
      "values:originalText": "(1) A person may give lawfully intercepted information (other than\nforeign intelligence information, general computer access intercept\ninformation, data disruption intercept information, network activity\nwarrant intercept information or ASIO computer access intercept\ninformation) in evidence in an exempt proceeding.\n\n(2) For the purposes of applying subsection (1) in relation to\ninformation, the question whether or not a communication was\nintercepted in contravention of subsection 7(1) may be determined\non the balance of probabilities.\n\n(3) A person may give interception warrant information in evidence in\nan exempt proceeding.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 75\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
