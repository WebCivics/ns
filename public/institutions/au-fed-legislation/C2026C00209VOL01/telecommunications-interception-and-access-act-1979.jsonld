    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105",
      "@type": "cml:Concept",
      "skos:prefLabel": "105 Contravention of section 7 or 63",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.290",
      "values:originalText": "(1) A person who contravenes subsection 7(1) or section 63 is guilty of\nan offence against that subsection or section.\n\n(2) An offence against subsection 7(1) or section 63 is an indictable\noffence and, subject to this section, is punishable on conviction by\nimprisonment for a period not exceeding 2 years.\n\n(3) Notwithstanding that an offence against subsection 7(1) or\nsection 63 is an indictable offence, a court of summary jurisdiction\nmay hear and determine proceedings in respect of such an offence\nif, and only if:\n\n(a) the proceedings are brought in the name of the\nAttorney-General or the Director of Public Prosecutions;\n\n(b) the defendant and the prosecutor consent; and\n\n(c) the court is satisfied that it is proper for the court to hear and\ndetermine proceedings in respect of the offence.\n\n(4) Where, in accordance with subsection (3), a court of summary\njurisdiction convicts a person of an offence against subsection 7(1)\nor section 63, the penalty that the court may impose is\nimprisonment for a period not exceeding 6 months.\n\n(5) Section 15.1 (extended geographical jurisdiction—category A) of\nthe Criminal Code applies to an offence against subsection 7(1) or\nsection 63.",
      "skos:definition": "(1) A person who contravenes subsection 7(1) or section 63 is guilty of\nan offence against that subsection or section.\n\n(2) An offence against subsection 7(1) or section 63 is an indictable\noffence and, subject to this section, is punishable on conviction by\nimprisonment for a period not exceeding 2 years.\n\n(3) Notwithstanding that an offence against subsection 7(1) or\nsection 63 is an indictable offence, a court of summary jurisdiction\nmay hear and determine proceedings in respect of such an offence\nif, and only if:\n\n(a) the proceedings are brought in the name of the\nAttorney-General or the Director of Public Prosecutions;\n\n(b) the defendant and the prosecutor consent; and\n\n(c) the court is satisfied that it is proper for the court to hear and\ndetermine proceedings in respect of the offence.\n\n(4) Where, in accordance with subsection (3), a court of summary\njurisdiction convicts a person of an offence against subsection 7(1)\nor section 63, the penalty that the court may impose is\nimprisonment for a period not exceeding 6 months.\n\n(5) Section 15.1 (extended geographical jurisdiction—category A) of\nthe Criminal Code applies to an offence against subsection 7(1) or\nsection 63.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-4"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-5"
        }
      ],
      "cml:integrityHash": "4ad55415c8118df028a98acc61ef3b02e83661024474a409477d750996fdd9fd"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105",
      "@type": "cof:Section",
      "cof:title": "105 Contravention of section 7 or 63",
      "values:kind": "section",
      "cof:pageNumber": 290,
      "values:originalText": "(1) A person who contravenes subsection 7(1) or section 63 is guilty of\nan offence against that subsection or section.\n\n(2) An offence against subsection 7(1) or section 63 is an indictable\noffence and, subject to this section, is punishable on conviction by\nimprisonment for a period not exceeding 2 years.\n\n(3) Notwithstanding that an offence against subsection 7(1) or\nsection 63 is an indictable offence, a court of summary jurisdiction\nmay hear and determine proceedings in respect of such an offence\nif, and only if:\n\n(a) the proceedings are brought in the name of the\nAttorney-General or the Director of Public Prosecutions;\n\n(b) the defendant and the prosecutor consent; and\n\n(c) the court is satisfied that it is proper for the court to hear and\ndetermine proceedings in respect of the offence.\n\n(4) Where, in accordance with subsection (3), a court of summary\njurisdiction convicts a person of an offence against subsection 7(1)\nor section 63, the penalty that the court may impose is\nimprisonment for a period not exceeding 6 months.\n\n(5) Section 15.1 (extended geographical jurisdiction—category A) of\nthe Criminal Code applies to an offence against subsection 7(1) or\nsection 63."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "105(1) Contravention of section 7 or 63",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105-ss-1"
      },
      "cml:curationStatus": {
