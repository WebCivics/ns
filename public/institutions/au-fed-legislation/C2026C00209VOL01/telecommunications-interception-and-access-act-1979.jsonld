        }
      ],
      "cml:integrityHash": "0e789403ca7f32f5d5a8efefdbe564556fabe2b4b3f7d5024ef1bbd67226cd3c",
      "skos:note": "Exemptions from prohibition on accessing stored communications"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-108-ss-2",
      "@type": "cof:Section",
