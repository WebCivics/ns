      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.111",
      "values:originalText": "9A(7)(c) of the Criminal Code has not yet begun.\n\nChapter 1  Introduction",
      "skos:definition": "9A(7)(c) of the Criminal Code has not yet begun.\n\nChapter 1  Introduction",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105a-norm"
        }
      ],
      "cml:integrityHash": "aa4cf9b757b0bf54c68c7fac63ba884edc82037104d9147e01e8636a388e4d87",
      "skos:note": "Chapter 1 Introduction"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105a",
      "@type": "cof:Section",
      "cof:title": "105A Section 105A",
      "values:kind": "section",
