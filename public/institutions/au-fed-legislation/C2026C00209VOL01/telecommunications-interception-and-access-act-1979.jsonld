    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-105-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "105(2) Contravention of section 7 or 63",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-105-ss-2"
      },
      "cml:curationStatus": {
