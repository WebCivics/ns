        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-169-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "0ded6e42698722b2507238c29f1d9ec4edc797b98820dd3a6ce0ae709f419cce",
      "skos:note": "No remedial relief beyond State/Territory law limits"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-169",
