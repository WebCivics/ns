      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.264",
      "values:originalText": "(6) A person must not refuse:\n\n(a) to attend before a person; or\n\n(b) to give information; or\n\n(c) to answer questions;\nwhen required to do so under this section.\nPenalty for an offence against this subsection:\nImprisonment\nfor 6 months.\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "(6) A person must not refuse:\n\n(a) to attend before a person; or\n\n(b) to give information; or\n\n(c) to answer questions;\nwhen required to do so under this section.\nPenalty for an offence against this subsection:\nImprisonment\nfor 6 months.\n\nChapter 2  Interception of telecommunications",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-87"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-87-ss-6-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-87-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "561f281e7b4481dc7cdc22bef1ad3abd3016ffe3cf86b282dc621575b6c5e717",
      "skos:note": "Must attend, give information, and answer questions when required."
    },
