    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-50",
      "@type": "cml:Concept",
      "skos:prefLabel": "50 Issue of warrant on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-50"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.197",
      "values:originalText": "(1) As soon as practicable after completing and signing a warrant\nissued on a telephone application, a Judge or nominated ART\nmember shall:\n\n(b) inform the person who made the application on the agency’s\nbehalf of:\n\n(i) the terms of the warrant; and\n\n(ii) the day on which, and the time at which, the warrant\nwas signed; and\n\n(c) give the warrant to that person.\n\n(2) A Judge or nominated ART member who issues a warrant on a\ntelephone application shall keep a copy of the warrant.",
      "skos:definition": "(1) As soon as practicable after completing and signing a warrant\nissued on a telephone application, a Judge or nominated ART\nmember shall:\n\n(b) inform the person who made the application on the agency’s\nbehalf of:\n\n(i) the terms of the warrant; and\n\n(ii) the day on which, and the time at which, the warrant\nwas signed; and\n\n(c) give the warrant to that person.\n\n(2) A Judge or nominated ART member who issues a warrant on a\ntelephone application shall keep a copy of the warrant.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-50-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-50-ss-2"
        }
      ],
      "cml:integrityHash": "d7a515e410daf95226ad5fcc5ac7a33bb0d6b829178d4e9f734d1021fe721c87"
    },
    {
