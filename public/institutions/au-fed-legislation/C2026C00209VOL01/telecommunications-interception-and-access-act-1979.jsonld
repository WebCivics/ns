    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6f",
      "@type": "cml:Concept",
      "skos:prefLabel": "6F Offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.101",
      "values:originalText": "Except so far as the contrary intention appears, a reference in this\nAct to an offence, or to an offence of a particular kind, is a\nreference to an offence, or to an offence of that kind, as the case\nmay be, that:\n\n(a) has been committed or is being committed; or\n\n(b) is suspected on reasonable grounds of having been\ncommitted, of being committed or of being likely to be\ncommitted.\n\nChapter 1  Introduction",
      "skos:definition": "Except so far as the contrary intention appears, a reference in this\nAct to an offence, or to an offence of a particular kind, is a\nreference to an offence, or to an offence of that kind, as the case\nmay be, that:\n\n(a) has been committed or is being committed; or\n\n(b) is suspected on reasonable grounds of having been\ncommitted, of being committed or of being likely to be\ncommitted.\n\nChapter 1  Introduction",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6f-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6f-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6f-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "90b819c82c2ff80c5119f8b73bc42a0b1ac9cc26ea9d8e6aad902fafb1ac0132",
      "skos:note": "Reference to an offence is a reference to an offence that has been committed or is suspected on reasonable grounds of having been committed."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6f",
      "@type": "cof:Section",
      "cof:title": "6F Offences",
      "values:kind": "section",
      "cof:pageNumber": 101,
      "values:originalText": "Except so far as the contrary intention appears, a reference in this\nAct to an offence, or to an offence of a particular kind, is a\nreference to an offence, or to an offence of that kind, as the case\nmay be, that:\n\n(a) has been committed or is being committed; or\n\n(b) is suspected on reasonable grounds of having been\ncommitted, of being committed or of being likely to be\ncommitted.\n\nChapter 1  Introduction"
    },
