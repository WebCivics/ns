    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-181",
      "@type": "cml:Concept",
      "skos:prefLabel": "181 Uses of telecommunications data connected with provision of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-181"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.395",
      "values:originalText": "access\n\nSection 276, 277 or 278 of the Telecommunications Act 1997 does\nnot prohibit a use by a person of information or a document if:\n\n(a) the use is made for the purposes of, or in connection with, a\ndisclosure of the information or document by the person; and\n\n(b) because of Division 3, 4 or 4A of this Part, the disclosure is\nnot prohibited by that section.\n\nChapter 4  Access to telecommunications data",
      "skos:definition": "access\n\nSection 276, 277 or 278 of the Telecommunications Act 1997 does\nnot prohibit a use by a person of information or a document if:\n\n(a) the use is made for the purposes of, or in connection with, a\ndisclosure of the information or document by the person; and\n\n(b) because of Division 3, 4 or 4A of this Part, the disclosure is\nnot prohibited by that section.\n\nChapter 4  Access to telecommunications data",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-181-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-181-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4b1b7d0c34290712ed29a6670373fa6693b3a5d4e3fbc4cea14bcd37ccd700eb",
      "skos:note": "Use of telecommunications data for disclosure purposes is permitted."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-181",
      "@type": "cof:Section",
      "cof:title": "181 Uses of telecommunications data connected with provision of",
      "values:kind": "section",
      "cof:pageNumber": 395,
      "values:originalText": "access\n\nSection 276, 277 or 278 of the Telecommunications Act 1997 does\nnot prohibit a use by a person of information or a document if:\n\n(a) the use is made for the purposes of, or in connection with, a\ndisclosure of the information or document by the person; and\n\n(b) because of Division 3, 4 or 4A of this Part, the disclosure is\nnot prohibited by that section.\n\nChapter 4  Access to telecommunications data"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-181-norm",
      "@type": "values:Permission",
      "cml:modality": {
