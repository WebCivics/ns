      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "5AA Eligible Commonwealth authority declarations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.72",
      "values:originalText": "The Minister may, by notice published in the Gazette, declare a\nCommonwealth Royal Commission to be an eligible\nCommonwealth authority for the purposes of this Act if the\nMinister is satisfied that the Royal Commission is likely to inquire\ninto matters that may involve the commission of a prescribed\noffence.",
      "skos:definition": "The Minister may, by notice published in the Gazette, declare a\nCommonwealth Royal Commission to be an eligible\nCommonwealth authority for the purposes of this Act if the\nMinister is satisfied that the Royal Commission is likely to inquire\ninto matters that may involve the commission of a prescribed\noffence.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5aa-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-5aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f2e0d18f7df1a3e77db7bde2210245d27e324e8d95f7824d99709b54f677eb50",
      "skos:note": "The Minister may declare a Royal Commission an eligible authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-5aa",
      "@type": "cof:Section",
      "cof:title": "5AA Eligible Commonwealth authority declarations",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "The Minister may, by notice published in the Gazette, declare a\nCommonwealth Royal Commission to be an eligible\nCommonwealth authority for the purposes of this Act if the\nMinister is satisfied that the Royal Commission is likely to inquire\ninto matters that may involve the commission of a prescribed\noffence."
    },
    {
