      },
      "cml:premiseText": "Issuing authority must inform person who made application and give instrument of revocation upon revocation",
      "cml:conclusionText": "Issuing authority has an obligation to inform person who made application and give instrument of revocation"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-120-ss-3-logic-deontic-5",
