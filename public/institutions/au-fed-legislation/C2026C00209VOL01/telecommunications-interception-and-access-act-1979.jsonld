    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-169",
      "@type": "cml:Concept",
      "skos:prefLabel": "169 State or Territory courts—jurisdictional limits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-169"
      },
      "cml:curationStatus": {
