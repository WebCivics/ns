    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-117",
      "@type": "cml:Concept",
      "skos:prefLabel": "117 What stored communications warrants authorise",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-117"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.324",
      "values:originalText": "A stored communications warrant authorises persons approved\nunder subsection 127(2) in respect of the warrant to access, subject\nto any conditions or restrictions that are specified in the warrant, a\nstored communication:\n\n(a) that was made by the person in respect of whom the warrant\nwas issued; or\n\n(b) that another person has made and for which the intended\nrecipient is the person in respect of whom the warrant was\nissued;\nand that becomes, or became, a stored communication before the\nwarrant is first executed in relation to the carrier that holds the\ncommunication.",
      "skos:definition": "A stored communications warrant authorises persons approved\nunder subsection 127(2) in respect of the warrant to access, subject\nto any conditions or restrictions that are specified in the warrant, a\nstored communication:\n\n(a) that was made by the person in respect of whom the warrant\nwas issued; or\n\n(b) that another person has made and for which the intended\nrecipient is the person in respect of whom the warrant was\nissued;\nand that becomes, or became, a stored communication before the\nwarrant is first executed in relation to the carrier that holds the\ncommunication.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-117-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-117-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bdbe73276f772d81fab73cd8e2f25e03ef6c059300628f7697ce4cc808a1114e",
      "skos:note": "Authorises access to stored communications under specified conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-117",
      "@type": "cof:Section",
      "cof:title": "117 What stored communications warrants authorise",
      "values:kind": "section",
      "cof:pageNumber": 324,
      "values:originalText": "A stored communications warrant authorises persons approved\nunder subsection 127(2) in respect of the warrant to access, subject\nto any conditions or restrictions that are specified in the warrant, a\nstored communication:\n\n(a) that was made by the person in respect of whom the warrant\nwas issued; or\n\n(b) that another person has made and for which the intended\nrecipient is the person in respect of whom the warrant was\nissued;\nand that becomes, or became, a stored communication before the\nwarrant is first executed in relation to the carrier that holds the\ncommunication."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-117-norm",
