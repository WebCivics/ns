      },
      "cml:premiseText": "Disclosures are permitted if reasonably necessary"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-177-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "177(2) Voluntary disclosure",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-177-ss-2"
      },
