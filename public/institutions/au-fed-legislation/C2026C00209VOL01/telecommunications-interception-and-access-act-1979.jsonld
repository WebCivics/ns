      ],
      "cml:integrityHash": "e80cbeac7e25f8bdf9a454deb4dd7a1314b33b945daa368db019ca4fcaac1150",
      "skos:note": "Exempt proceeding without Chapter 2 Interception of telecommunications"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-18-ss-5",
      "@type": "cof:Section",
      "cof:title": "18(5) Evidentiary certificates",
      "values:kind": "subsection",
      "cof:pageNumber": 140,
      "values:originalText": "(5) A document purporting to be a certificate issued under\nsubsection (3) or (4) by the Director-General of Security or the\nDeputy Director-General of Security and to be signed by him or\nher is to be received in evidence in an exempt proceeding without\n\nChapter 2  Interception of telecommunications"
    },
