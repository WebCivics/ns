    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Contents of application",
      "values:kind": "section",
      "cof:pageNumber": 162,
      "values:originalText": "A written application by an agency for a warrant shall set out:\n\n(a) the name of the agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf."
    },
