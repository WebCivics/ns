      "cml:conclusionText": "Issuing authority is permitted to revoke warrant"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-120-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
