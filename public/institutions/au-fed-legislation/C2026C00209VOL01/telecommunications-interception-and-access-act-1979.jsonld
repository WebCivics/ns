    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "180B(4) Authorisations for access to prospective information or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.378",
      "values:originalText": "(4) An authorised officer of the Australian Federal Police must revoke\nthe authorisation if he or she is satisfied that the disclosure is no\nlonger required.\nNote:\nSection 184 deals with notification of revocations.",
      "skos:definition": "(4) An authorised officer of the Australian Federal Police must revoke\nthe authorisation if he or she is satisfied that the disclosure is no\nlonger required.\nNote:\nSection 184 deals with notification of revocations.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ea2c6ebd7f306ddcd4e0a86f37e32663ad195079c7fa3d5ed15e99c84d0d3bf3",
      "skos:note": "Authorised officer must revoke authorisation if disclosure is no longer required.",
      "dc:references": [
        "sec-184"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180b-ss-4",
      "@type": "cof:Section",
      "cof:title": "180B(4) Authorisations for access to prospective information or",
      "values:kind": "subsection",
      "cof:pageNumber": 378,
      "values:originalText": "(4) An authorised officer of the Australian Federal Police must revoke\nthe authorisation if he or she is satisfied that the disclosure is no\nlonger required.\nNote:\nSection 184 deals with notification of revocations."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
