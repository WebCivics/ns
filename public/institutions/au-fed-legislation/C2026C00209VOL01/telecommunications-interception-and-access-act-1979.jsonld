      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.208",
      "values:originalText": "A document certified in writing by a certifying officer of an agency\nto be a true copy of a warrant shall be received in evidence in an\nexempt proceeding as if it were the original warrant.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 62\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "A document certified in writing by a certifying officer of an agency\nto be a true copy of a warrant shall be received in evidence in an\nexempt proceeding as if it were the original warrant.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 62\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-61a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-61a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ca29a60de978e3ddf986a242afeb96178080f1ba160a7e0317811ea2faaf5481",
      "skos:note": "A document certified in writing by a certifying officer of an agency is admissible as evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-61a",
      "@type": "cof:Section",
      "cof:title": "61A Certified copy of warrant",
      "values:kind": "section",
      "cof:pageNumber": 208,
      "values:originalText": "A document certified in writing by a certifying officer of an agency\nto be a true copy of a warrant shall be received in evidence in an\nexempt proceeding as if it were the original warrant.\n\nInterception of telecommunications  Chapter 2\nDealing with intercepted information etc.  Part 2-6\n\nSection 62\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-61a-norm",
