      ],
      "cml:integrityHash": "ea2267ffc5dc9d35b9f9e330a8e6dbcfdcc15ce4c22c95b8b21063744cb1a05d",
      "skos:note": "Ombudsman must provide information if necessary to perform functions.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186f-ss-2",
      "@type": "cof:Section",
      "cof:title": "186F(2) Exchange of information between Ombudsman or",
      "values:kind": "subsection",
      "cof:pageNumber": 426,
      "values:originalText": "(2) However, the Ombudsman may give the information only if the\nOmbudsman is satisfied that giving the information is necessary to\nenable the inspecting authority to perform its functions in relation\nto the authority of the State or Territory."
    },
