      ],
      "cml:integrityHash": "1a435ea0361fe6979c087b725c426b57d2491d9119d48470bdd2c3822fc0c9b6",
      "skos:note": "Chief officer may appoint an approving officer."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-127-ss-3",
      "@type": "cof:Section",
      "cof:title": "127(3) Exercise of authority conferred by warrant",
      "values:kind": "subsection",
      "cof:pageNumber": 330,
      "values:originalText": "(3) The chief officer of a criminal law-enforcement agency may\nappoint in writing an officer of the agency to be an approving\nofficer for the purposes of subsection (2).\n\nPreserving and accessing stored communications  Chapter 3\nAccess by criminal law-enforcement agencies to stored communications  Part 3-3\nProvisions relating to execution of warrants  Division 4\n\nSection 128\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
