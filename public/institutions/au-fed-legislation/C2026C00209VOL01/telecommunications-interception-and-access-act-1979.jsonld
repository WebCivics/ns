      "cml:integrityHash": "da3320e8bb54ac17676827c18bdb6fd8b6f04be06691abd911e9847f10bf767c",
      "skos:note": "Permission for technical assistance"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-55-ss-5",
      "@type": "cof:Section",
      "cof:title": "55(5) Exercise of authority conferred by warrant",
      "values:kind": "subsection",
      "cof:pageNumber": 199,
      "values:originalText": "(5) In spite of subsection (1), a designated officer, or an employee of a\ncarrier, may provide technical assistance to a person who is\nexercising the authority conferred by a warrant."
    },
