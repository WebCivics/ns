        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-71-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5de7883f1cd28696be424ba7b4cb99d5983079666cea9c8b629879cb059fa65b",
      "skos:note": "Who can be informed about suspected interception of information"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-71-ss-2",
      "@type": "cof:Section",
      "cof:title": "71(2) Dealing with information where interception suspected to be",
      "values:kind": "subsection",
      "cof:pageNumber": 242,
      "values:originalText": "(2) The person may communicate the relevant information to:\n\n(a) the Attorney-General; or\n\n(aa) the Minister; or\n\n(b) the Director of Public Prosecutions; or\n\n(c) the Commissioner of Police; or\n\n(ca) the National Anti-Corruption Commissioner; or\n\n(cb) the Inspector of the National Anti-Corruption Commission;\nor\n\n(d) the Chief Executive Officer of the ACC."
    },
