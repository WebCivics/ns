    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-148-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "148(2) Stored communications warrant information inadmissible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-148-ss-2"
