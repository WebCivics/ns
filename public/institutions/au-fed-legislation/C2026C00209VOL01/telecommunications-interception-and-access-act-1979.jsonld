      },
      "cml:premiseText": "Chief officer satisfied information is not required for law enforcement purposes",
      "cml:conclusionText": "Information or record must be destroyed"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-150-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Time of destruction must be after time of obtaining information",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Chief officer caused information or record to be destroyed forthwith",
      "cml:conclusionText": "Time of destruction is greater than or equal to the time of obtaining information"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-150-ss-1-logic-ltl-3",
