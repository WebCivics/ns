      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.254",
      "values:originalText": "authorities of a State\n\nIf:\n\n(a) the Organisation is exercising the authority conferred by a",
      "skos:definition": "authorities of a State\n\nIf:\n\n(a) the Organisation is exercising the authority conferred by a",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-81aa-norm"
        }
      ],
      "cml:integrityHash": "852c8205fb72ad129428cb2a36cb4d6b861f5f6869c6fd32e208cd9fbee18f7b",
      "skos:note": "Organisation must exercise authority conferred by a certain entity."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-81aa",
