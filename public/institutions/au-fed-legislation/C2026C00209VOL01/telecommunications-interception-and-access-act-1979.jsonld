    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-163",
      "@type": "cml:Concept",
      "skos:prefLabel": "163 Report to contain information about effectiveness of warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-163"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.358",
      "values:originalText": "The report must set out, for each criminal law-enforcement agency:\n\n(a) how many arrests were made during that year on the basis of\ninformation that was, or included, lawfully accessed\ninformation; and\n\n(b) how many proceedings ended during that year that were\nproceedings in which, according to the records of the agency,\nlawfully accessed information was given in evidence.",
      "skos:definition": "The report must set out, for each criminal law-enforcement agency:\n\n(a) how many arrests were made during that year on the basis of\ninformation that was, or included, lawfully accessed\ninformation; and\n\n(b) how many proceedings ended during that year that were\nproceedings in which, according to the records of the agency,\nlawfully accessed information was given in evidence.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-163-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-163-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d3a7e8255baa986118da55689666698e957b6db2c3e970aa90caf4c8edfe1498",
      "skos:note": "Report must contain information about effectiveness of warrants",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-163",
      "@type": "cof:Section",
      "cof:title": "163 Report to contain information about effectiveness of warrants",
      "values:kind": "section",
      "cof:pageNumber": 358,
      "values:originalText": "The report must set out, for each criminal law-enforcement agency:\n\n(a) how many arrests were made during that year on the basis of\ninformation that was, or included, lawfully accessed\ninformation; and\n\n(b) how many proceedings ended during that year that were\nproceedings in which, according to the records of the agency,\nlawfully accessed information was given in evidence."
    },
