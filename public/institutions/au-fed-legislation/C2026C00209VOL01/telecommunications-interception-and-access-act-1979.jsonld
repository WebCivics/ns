    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-68",
      "@type": "cml:Concept",
      "skos:prefLabel": "68 Chief officer may communicate information obtained by agency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-68"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.235",
      "values:originalText": "The chief officer of an agency (in this section called the\noriginating agency) may, personally, or by an officer of the\noriginating agency authorised by the chief officer, communicate\nlawfully intercepted information (other than general computer\naccess intercept information, data disruption intercept information\nor network activity warrant intercept information) that was\noriginally obtained by the originating agency or interception\nwarrant information:\n\n(a) if the information relates, or appears to relate, to activities\nprejudicial to security—to the Director-General of Security;\nand\n\n(aa) if the information relates, or appears to relate, to the\nperformance of the ACC’s function covered by\nparagraph 7A(da) of the Australian Crime Commission Act\n2002—to the Chief Executive Officer of the ACC; and\n\n(b) if the information relates, or appears to relate, to the\ncommission of a relevant offence in relation to another\nagency:\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "The chief officer of an agency (in this section called the\noriginating agency) may, personally, or by an officer of the\noriginating agency authorised by the chief officer, communicate\nlawfully intercepted information (other than general computer\naccess intercept information, data disruption intercept information\nor network activity warrant intercept information) that was\noriginally obtained by the originating agency or interception\nwarrant information:\n\n(a) if the information relates, or appears to relate, to activities\nprejudicial to security—to the Director-General of Security;\nand\n\n(aa) if the information relates, or appears to relate, to the\nperformance of the ACC’s function covered by\nparagraph 7A(da) of the Australian Crime Commission Act\n2002—to the Chief Executive Officer of the ACC; and\n\n(b) if the information relates, or appears to relate, to the\ncommission of a relevant offence in relation to another\nagency:\n\nChapter 2  Interception of telecommunications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-68-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-68-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0f23c18eaca25a90f2bd4672fe66beb5803ce41c62a0a1a16e4447cd9ca00506",
      "skos:note": "Chief officer may communicate information to Director-General of Security and Chief Executive Officer of ACC under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Chief officer may communicate information obtained by agency",
      "values:kind": "section",
      "cof:pageNumber": 235,
      "values:originalText": "The chief officer of an agency (in this section called the\noriginating agency) may, personally, or by an officer of the\noriginating agency authorised by the chief officer, communicate\nlawfully intercepted information (other than general computer\naccess intercept information, data disruption intercept information\nor network activity warrant intercept information) that was\noriginally obtained by the originating agency or interception\nwarrant information:\n\n(a) if the information relates, or appears to relate, to activities\nprejudicial to security—to the Director-General of Security;\nand\n\n(aa) if the information relates, or appears to relate, to the\nperformance of the ACC’s function covered by\nparagraph 7A(da) of the Australian Crime Commission Act\n2002—to the Chief Executive Officer of the ACC; and\n\n(b) if the information relates, or appears to relate, to the\ncommission of a relevant offence in relation to another\nagency:\n\nChapter 2  Interception of telecommunications"
    },
