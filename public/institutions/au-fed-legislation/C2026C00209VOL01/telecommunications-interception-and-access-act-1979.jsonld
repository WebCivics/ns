    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-72",
      "@type": "cml:Concept",
      "skos:prefLabel": "72 Making record for purpose of permitted communication",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-72"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.243",
      "values:originalText": "A person who is permitted by section 63B, 63C, 63D, 63E, 65 or\n65A, subsection 66(1), section 68 or subsection 71(2) to\ncommunicate particular information to another person may, for the\npurpose of so communicating the information in accordance with\nthat section or subsection, make a record of the information, or\ncause such a record to be made.",
      "skos:definition": "A person who is permitted by section 63B, 63C, 63D, 63E, 65 or\n65A, subsection 66(1), section 68 or subsection 71(2) to\ncommunicate particular information to another person may, for the\npurpose of so communicating the information in accordance with\nthat section or subsection, make a record of the information, or\ncause such a record to be made.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-72-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-72-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f2791c6bfa934c4303b3f05ecab55e92060c51d5f9e278a18e99bbf702661349",
      "skos:note": "Making record for permitted communication"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-72",
      "@type": "cof:Section",
      "cof:title": "72 Making record for purpose of permitted communication",
      "values:kind": "section",
      "cof:pageNumber": 243,
      "values:originalText": "A person who is permitted by section 63B, 63C, 63D, 63E, 65 or\n65A, subsection 66(1), section 68 or subsection 71(2) to\ncommunicate particular information to another person may, for the\npurpose of so communicating the information in accordance with\nthat section or subsection, make a record of the information, or\ncause such a record to be made."
    },
