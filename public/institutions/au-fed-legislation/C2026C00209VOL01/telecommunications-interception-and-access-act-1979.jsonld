    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "107(3) Offences relating to inspections under Part 2-7",
      "cml:realizedBy": {
