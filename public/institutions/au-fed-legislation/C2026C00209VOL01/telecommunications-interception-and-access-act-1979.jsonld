    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "31A(4) Attorney-General may authorise interception for developing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31a-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.146",
      "values:originalText": "(4) The head (however described) of the security authority, or a person\nacting as that head, must ensure that a copy of the authorisation is\nkept by the authority and is available for inspection on request by\nthe Minister who is responsible for the authority.",
      "skos:definition": "(4) The head (however described) of the security authority, or a person\nacting as that head, must ensure that a copy of the authorisation is\nkept by the authority and is available for inspection on request by\nthe Minister who is responsible for the authority.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a"
      },
      "cml:asserts": [
