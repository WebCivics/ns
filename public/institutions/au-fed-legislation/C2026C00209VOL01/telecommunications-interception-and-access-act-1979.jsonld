        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-9a-ss-1c-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "30add19aeb23fb6716dbd7e11e2edca20828c3b3c70601df8e8bf28af7cb9d50",
      "skos:note": "Requires Attorney-General to issue named person warrants for interception of communications."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-9a-ss-1c",
      "@type": "cof:Section",
