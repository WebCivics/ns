        }
      ],
      "cml:integrityHash": "cdce1ba2b7a85f8c73484588854724098fba3d867ddce6684de482ebe6e4add1",
      "skos:note": "Recipient of certain information must comply with subsections (1A), (2) and (3)"
    },
    {
