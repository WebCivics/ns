    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107e",
      "@type": "cml:Concept",
      "skos:prefLabel": "107E State or Territory courts—jurisdictional limits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.296",
      "values:originalText": "This Part does not enable an inferior court of a State or Territory to\ngrant remedial relief of a kind that the court is unable to grant\nunder the law of that State or Territory.",
      "skos:definition": "This Part does not enable an inferior court of a State or Territory to\ngrant remedial relief of a kind that the court is unable to grant\nunder the law of that State or Territory.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107e-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0ded6e42698722b2507238c29f1d9ec4edc797b98820dd3a6ce0ae709f419cce",
      "skos:note": "No remedial relief beyond what the State/Territory law allows"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107e",
      "@type": "cof:Section",
      "cof:title": "107E State or Territory courts—jurisdictional limits",
      "values:kind": "section",
      "cof:pageNumber": 296,
      "values:originalText": "This Part does not enable an inferior court of a State or Territory to\ngrant remedial relief of a kind that the court is unable to grant\nunder the law of that State or Territory."
    },
