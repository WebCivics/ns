    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6b",
      "@type": "cml:Concept",
      "skos:prefLabel": "6B Involvement in an offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.95",
      "values:originalText": "For the purposes of this Act, a person shall be taken to be involved\nin an offence if, and only if, the person:\n\n(a) has committed, or is committing, the offence; or\n\n(b) is suspected on reasonable grounds of having committed, of\ncommitting, or of being likely to commit, the offence.",
      "skos:definition": "For the purposes of this Act, a person shall be taken to be involved\nin an offence if, and only if, the person:\n\n(a) has committed, or is committing, the offence; or\n\n(b) is suspected on reasonable grounds of having committed, of\ncommitting, or of being likely to commit, the offence.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6b-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dbdc7128ad3eb72e60bda0582c1a47c78cf31ae674af3ec5caa0a38a262b315f",
      "skos:note": "A person is taken to be involved in an offence if they have committed or are committing the offence, or are suspected of having committed it."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-6b",
      "@type": "cof:Section",
      "cof:title": "6B Involvement in an offence",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "For the purposes of this Act, a person shall be taken to be involved\nin an offence if, and only if, the person:\n\n(a) has committed, or is committing, the offence; or\n\n(b) is suspected on reasonable grounds of having committed, of\ncommitting, or of being likely to commit, the offence."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-6b-norm",
