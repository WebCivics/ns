    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-12-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "12(4) Persons authorised to intercept communications for Organisation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-12-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.135",
      "values:originalText": "(4) The Director-General of Security must, as soon as practicable after\nthe authority conferred by a Part 2-2 warrant is exercised on behalf\nof the Organisation, cause one or more written records to be made\nthat identify each person who exercised that authority.",
      "skos:definition": "(4) The Director-General of Security must, as soon as practicable after\nthe authority conferred by a Part 2-2 warrant is exercised on behalf\nof the Organisation, cause one or more written records to be made\nthat identify each person who exercised that authority.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-12"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-12-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-12-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2b53ec0fa955747109d44c03c8ac491dd79ba078bef55b009265b0a39bfdd65b",
      "skos:note": "Must create written records after authority is exercised"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-12-ss-4",
      "@type": "cof:Section",
      "cof:title": "12(4) Persons authorised to intercept communications for Organisation",
      "values:kind": "subsection",
      "cof:pageNumber": 135,
      "values:originalText": "(4) The Director-General of Security must, as soon as practicable after\nthe authority conferred by a Part 2-2 warrant is exercised on behalf\nof the Organisation, cause one or more written records to be made\nthat identify each person who exercised that authority."
    },
    {
