    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-51",
      "@type": "cml:Concept",
      "skos:prefLabel": "51 Action by agency after warrant issued on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-51"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.197",
      "values:originalText": "(1) A person (in this section called the applicant) who makes a\ntelephone application on an agency’s behalf shall comply with this\nsection within one day after the day on which a warrant is issued\non the application.\n\n(2) The applicant shall cause each person who gave information to the\nJudge or nominated ART member in connection with the\napplication to swear an affidavit setting out the information so\ngiven by the person.\n\n(3) The applicant shall give to the Judge or nominated ART member:\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "(1) A person (in this section called the applicant) who makes a\ntelephone application on an agency’s behalf shall comply with this\nsection within one day after the day on which a warrant is issued\non the application.\n\n(2) The applicant shall cause each person who gave information to the\nJudge or nominated ART member in connection with the\napplication to swear an affidavit setting out the information so\ngiven by the person.\n\n(3) The applicant shall give to the Judge or nominated ART member:\n\nChapter 2  Interception of telecommunications",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-51-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-51-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-51-ss-3"
        }
      ],
      "cml:integrityHash": "cea9d15e162925da6dcf66a02848d102c7ed3f08ab9099f7351b17c0ef45f8c4"
    },
