      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permits",
      "cml:logicSummary": "Authorisation under subsection (2) permits disclosure.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) An authorisation under subsection (2):"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:logicSummary": "The authorisation ceases to be in force during the specified period.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) ceases to be in force at the time specified in the authorisation,"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The authorisation ceases to be in force until the specified period or is revoked earlier.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) ceases to be in force at the time specified in the authorisation, which must not be more than 21 days after the day the authorisation is made,"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-5-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "The authorisation diffuses to the person from whom the disclosure is sought.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) comes into force at the time the person from whom the disclosure is sought receives notification of the authorisation;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180b-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognises",
