    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-114",
      "@type": "cml:Concept",
      "skos:prefLabel": "114 Information to be given on telephone applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-114"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.321",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\nbehalf thinks it necessary to make the application by\ntelephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, section 112 or 113 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\nbehalf thinks it necessary to make the application by\ntelephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, section 112 or 113 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-114-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-114-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8384337b4b07cfff08b0089d4131156cb9ce3cdcd49507e7ac1f9e7822e05899",
      "skos:note": "Information must be provided on telephone applications.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-114",
      "@type": "cof:Section",
      "cof:title": "114 Information to be given on telephone applications",
      "values:kind": "section",
      "cof:pageNumber": 321,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\nbehalf thinks it necessary to make the application by\ntelephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, section 112 or 113 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-114-norm",
      "@type": "values:Obligation",
