    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-31a-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "31A(1) Attorney-General may authorise interception for developing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-31a-ss-1"
