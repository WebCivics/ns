    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-1b",
      "@type": "cml:Concept",
      "skos:prefLabel": "65(1B) Dealing in information obtained by Organisation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-65-ss-1b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.228",
      "values:originalText": "(1B) The second person to whom the foreign intelligence information is\ncommunicated under subsection (1A), and any other person to\nwhom that information is communicated under this subsection,\nmay communicate it to another person, and use and make a record\nof it.",
      "skos:definition": "(1B) The second person to whom the foreign intelligence information is\ncommunicated under subsection (1A), and any other person to\nwhom that information is communicated under this subsection,\nmay communicate it to another person, and use and make a record\nof it.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-1b-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-65-ss-1b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d752f79a06e4ba82a6820a9aaf3fb333249b1635db8a6050321bb9b97a636edf",
      "skos:note": "Communicate foreign intelligence information to another person."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-65-ss-1b",
      "@type": "cof:Section",
      "cof:title": "65(1B) Dealing in information obtained by Organisation",
      "values:kind": "subsection",
      "cof:pageNumber": 228,
      "values:originalText": "(1B) The second person to whom the foreign intelligence information is\ncommunicated under subsection (1A), and any other person to\nwhom that information is communicated under this subsection,\nmay communicate it to another person, and use and make a record\nof it."
    },
