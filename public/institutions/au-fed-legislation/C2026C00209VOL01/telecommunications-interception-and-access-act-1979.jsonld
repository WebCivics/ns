      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-45a",
      "@type": "cml:Concept",
      "skos:prefLabel": "45A State law not affected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-45a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.166",
      "values:originalText": "If:\n\n(a) a person (the applicant) applies, or proposes to apply, under\nsection 39, on behalf of an interception agency of Victoria or\nQueensland for a warrant in respect of a telecommunications\nservice or a person; and\n\n(b) a law of that State authorises or requires the applicant:\n\n(i) to notify the PIM of that State of the application or\nproposed application; or\n\n(ii) to notify the PIM of that State of any information that\nrelates to the application or proposed application; or\n\n(iii) to give the PIM of that State any document that relates\nto the application or proposed application;\nthen nothing in this Act prevents the applicant from making the\nnotification or giving the document to the PIM of that State.\n\nInterception of telecommunications  Chapter 2\nWarrants authorising agencies to intercept telecommunications  Part 2-5\nWarrants  Division 4\n\nSection 46\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "If:\n\n(a) a person (the applicant) applies, or proposes to apply, under\nsection 39, on behalf of an interception agency of Victoria or\nQueensland for a warrant in respect of a telecommunications\nservice or a person; and\n\n(b) a law of that State authorises or requires the applicant:\n\n(i) to notify the PIM of that State of the application or\nproposed application; or\n\n(ii) to notify the PIM of that State of any information that\nrelates to the application or proposed application; or\n\n(iii) to give the PIM of that State any document that relates\nto the application or proposed application;\nthen nothing in this Act prevents the applicant from making the\nnotification or giving the document to the PIM of that State.\n\nInterception of telecommunications  Chapter 2\nWarrants authorising agencies to intercept telecommunications  Part 2-5\nWarrants  Division 4\n\nSection 46\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-45a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-45a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "806e91e4d193c523b4cc5f2d404388742c44d79685c31dcb813f1d6f6efe664a",
      "skos:note": "Notification requirements for interception agencies"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-45a",
      "@type": "cof:Section",
      "cof:title": "45A State law not affected",
      "values:kind": "section",
      "cof:pageNumber": 166,
      "values:originalText": "If:\n\n(a) a person (the applicant) applies, or proposes to apply, under\nsection 39, on behalf of an interception agency of Victoria or\nQueensland for a warrant in respect of a telecommunications\nservice or a person; and\n\n(b) a law of that State authorises or requires the applicant:\n\n(i) to notify the PIM of that State of the application or\nproposed application; or\n\n(ii) to notify the PIM of that State of any information that\nrelates to the application or proposed application; or\n\n(iii) to give the PIM of that State any document that relates\nto the application or proposed application;\nthen nothing in this Act prevents the applicant from making the\nnotification or giving the document to the PIM of that State.\n\nInterception of telecommunications  Chapter 2\nWarrants authorising agencies to intercept telecommunications  Part 2-5\nWarrants  Division 4\n\nSection 46\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-45a-norm",
