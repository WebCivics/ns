      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.263",
      "values:originalText": "(1) For the purposes of an inspection under this Part of an agency’s\nrecords, the Ombudsman:\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "(1) For the purposes of an inspection under this Part of an agency’s\nrecords, the Ombudsman:\n\nChapter 2  Interception of telecommunications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-86-norm"
        }
      ],
      "cml:integrityHash": "38fcb7adb986b3248f688af844261064d7d317611fce7b9d99431601c5f2cbd6",
      "skos:note": "Ombudsman's general powers for inspection of agency records"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-86",
