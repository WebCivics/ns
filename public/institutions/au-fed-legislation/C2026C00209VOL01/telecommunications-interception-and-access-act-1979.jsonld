    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "107A(4) Civil remedies—unlawful interception or communication",
      "cml:realizedBy": {
