      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.247",
      "values:originalText": "(3) Interception warrant information is admissible in evidence in a\nproceeding only to the extent that section 63AA, 74, 75A, 76 or\n76A permits a person to give interception warrant information in\nevidence in that proceeding.",
      "skos:definition": "(3) Interception warrant information is admissible in evidence in a\nproceeding only to the extent that section 63AA, 74, 75A, 76 or\n76A permits a person to give interception warrant information in\nevidence in that proceeding.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-77"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-77-ss-3-norm"
        }
      ],
      "cml:integrityHash": "7642afbe7faab32cc730f0dd7d39b7a9556ce1650cf19d121818009e5ba08317",
      "skos:note": "Exclusion of interception warrant information from evidence"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-77-ss-3",
      "@type": "cof:Section",
      "cof:title": "77(3) Intercepted material and interception warrant information",
      "values:kind": "subsection",
      "cof:pageNumber": 247,
      "values:originalText": "(3) Interception warrant information is admissible in evidence in a\nproceeding only to the extent that section 63AA, 74, 75A, 76 or\n76A permits a person to give interception warrant information in\nevidence in that proceeding."
    },
