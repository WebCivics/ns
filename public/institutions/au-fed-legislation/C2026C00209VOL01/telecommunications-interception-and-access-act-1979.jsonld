    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-175-ss-2",
      "@type": "cof:Section",
      "cof:title": "175(2) Authorisations for access to existing information or documents",
      "values:kind": "subsection",
      "cof:pageNumber": 367,
      "values:originalText": "(2) The following persons (each of whom is an eligible person):\n\n(a) the Director-General of Security;\n\n(b) the Deputy Director-General of Security;\n\n(c) ASIO employee or ASIO affiliate covered by an approval in\nforce under subsection (4);\nmay authorise the disclosure of specified information or specified\ndocuments that came into existence before the time the person\nfrom whom the disclosure is sought receives notification of the\nauthorisation.\nNote:\nSection 184 deals with notification of authorisations.\n\nChapter 4  Access to telecommunications data"
    },
