    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-131",
      "@type": "cml:Concept",
      "skos:prefLabel": "131 Certified copies of stored communications warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-131"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.333",
      "values:originalText": "A document certified in writing by a certifying officer of a criminal\nlaw-enforcement agency to be a true copy of a stored\ncommunications warrant is to be received in evidence in an exempt\nproceeding as if it were the original warrant.",
      "skos:definition": "A document certified in writing by a certifying officer of a criminal\nlaw-enforcement agency to be a true copy of a stored\ncommunications warrant is to be received in evidence in an exempt\nproceeding as if it were the original warrant.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-131-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-131-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35413f90ca11d1c47471725b80e987640c3429cb4ccdfada51b2c80df5dba9a3",
      "skos:note": "Exempt proceeding must receive certified copy of stored communications warrant as if it were the original."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-131",
      "@type": "cof:Section",
      "cof:title": "131 Certified copies of stored communications warrants",
      "values:kind": "section",
      "cof:pageNumber": 333,
      "values:originalText": "A document certified in writing by a certifying officer of a criminal\nlaw-enforcement agency to be a true copy of a stored\ncommunications warrant is to be received in evidence in an exempt\nproceeding as if it were the original warrant."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-131-norm",
