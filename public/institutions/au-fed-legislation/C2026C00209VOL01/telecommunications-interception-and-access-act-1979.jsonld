          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-60-ss-4a"
        }
      ],
      "cml:integrityHash": "03da8760006bc6d08ede716d9a37b73a28845bb1eec555478d8759d36ea7a6bb"
