    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-77-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "77(3) Intercepted material and interception warrant information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-77-ss-3"
      },
      "cml:curationStatus": {
