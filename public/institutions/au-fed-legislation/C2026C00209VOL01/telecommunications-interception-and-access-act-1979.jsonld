      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Permits issuing authority to revoke warrant if subsection (2) has not been complied with",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
