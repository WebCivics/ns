          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-85-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4df555ee28ab651359ffa1550b7a1c1e3ea46d9382729a15dec16b152c88fce1",
      "skos:note": "Contravention of a condition or restriction is also a contravention of the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-85-ss-2",
      "@type": "cof:Section",
      "cof:title": "85(2) Ombudsman may report on other breaches of this Act",
      "values:kind": "subsection",
      "cof:pageNumber": 262,
      "values:originalText": "(2) To avoid doubt, for the purposes of subsection (1), a contravention\nof a condition or restriction specified in a warrant issued under this\nAct is a contravention of a provision of this Act."
    },
