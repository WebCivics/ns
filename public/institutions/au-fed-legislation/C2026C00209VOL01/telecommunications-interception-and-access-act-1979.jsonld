    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-121",
      "@type": "cml:Concept",
      "skos:prefLabel": "121 What happens when stored communications warrants are",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-121"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.327",
      "values:originalText": "issued\n\nThe chief officer of the agency must cause:\n\n(a) an authorised representative of the carrier that holds the\nstored communications to which the warrant relates to be\ninformed forthwith of the issue of the warrant; and\n\n(b) a copy of the warrant, certified in writing by a certifying\nofficer of the agency to be a true copy of the warrant, to be\ngiven as soon as practicable to that authorised representative.",
      "skos:definition": "issued\n\nThe chief officer of the agency must cause:\n\n(a) an authorised representative of the carrier that holds the\nstored communications to which the warrant relates to be\ninformed forthwith of the issue of the warrant; and\n\n(b) a copy of the warrant, certified in writing by a certifying\nofficer of the agency to be a true copy of the warrant, to be\ngiven as soon as practicable to that authorised representative.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-121-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-121-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5faca13e14d22590b6b54381ddeae4be62fb61d6a190e55621e6f351434845d0",
      "skos:note": "Agency must inform carrier and provide copy of warrant.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-121",
      "@type": "cof:Section",
      "cof:title": "121 What happens when stored communications warrants are",
      "values:kind": "section",
      "cof:pageNumber": 327,
      "values:originalText": "issued\n\nThe chief officer of the agency must cause:\n\n(a) an authorised representative of the carrier that holds the\nstored communications to which the warrant relates to be\ninformed forthwith of the issue of the warrant; and\n\n(b) a copy of the warrant, certified in writing by a certifying\nofficer of the agency to be a true copy of the warrant, to be\ngiven as soon as practicable to that authorised representative."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-121-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-121"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-121-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Agency has a duty to inform carrier and provide copy of warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
