      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107c-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "No limitation implies no liability under other provisions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This Part does not limit any liability",
      "cml:conclusionText": "Therefore, no limitation implies no liability under other provisions"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107d",
      "@type": "cml:Concept",
      "skos:prefLabel": "107D Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.296",
      "values:originalText": "This Part is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Part.",
      "skos:definition": "This Part is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Part.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107d-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c3ab4572a33a313757d5e4ad0988c2c53d20856f07d4908f2a0f95248075c91f",
      "skos:note": "No exclusion or limitation of State/Territory laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107d",
      "@type": "cof:Section",
      "cof:title": "107D Concurrent operation of State and Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 296,
      "values:originalText": "This Part is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Part."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
