      },
      "cml:premiseText": "Chief officer satisfied information is not likely to be required for a purpose referred in subsection 139(2) or (4A), 139A(2) or 139B(2)",
      "cml:conclusionText": "Time of destruction is less than or equal to the time of requirement for law enforcement purposes"
    },
