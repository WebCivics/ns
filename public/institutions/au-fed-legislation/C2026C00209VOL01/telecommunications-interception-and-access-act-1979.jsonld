    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-17-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "17(2) Reports to be made to Attorney-General on results of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-17-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.140",
      "values:originalText": "(2) A report under subsection (1) in relation to a warrant issued under\nsection 9A or 11B must include details of the telecommunications\nservice to or from which each intercepted communication was\nmade.",
      "skos:definition": "(2) A report under subsection (1) in relation to a warrant issued under\nsection 9A or 11B must include details of the telecommunications\nservice to or from which each intercepted communication was\nmade.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-17"
      },
