    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-81b",
      "@type": "cml:Concept",
      "skos:prefLabel": "81B Regular submission of General Register to Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-81b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.256",
      "values:originalText": "(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the General Register to\nthe Minister for inspection.\n\n(2) Once at least within each succeeding period of 3 months, the\nSecretary of the Department must deliver to the Minister, for\ninspection by the Minister, any part of the General Register that\nrepresents information recorded since the General Register, or any\npart of the General Register, was last delivered to the Minister.",
      "skos:definition": "(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the General Register to\nthe Minister for inspection.\n\n(2) Once at least within each succeeding period of 3 months, the\nSecretary of the Department must deliver to the Minister, for\ninspection by the Minister, any part of the General Register that\nrepresents information recorded since the General Register, or any\npart of the General Register, was last delivered to the Minister.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-81b-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-81b-ss-2"
        }
      ],
      "cml:integrityHash": "f2b3c77b056dbbe54ccce2c04468a6caa5acc48326d4bddeea64d4e40e6f5b2b"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-81b",
      "@type": "cof:Section",
      "cof:title": "81B Regular submission of General Register to Minister",
      "values:kind": "section",
      "cof:pageNumber": 256,
      "values:originalText": "(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the General Register to\nthe Minister for inspection.\n\n(2) Once at least within each succeeding period of 3 months, the\nSecretary of the Department must deliver to the Minister, for\ninspection by the Minister, any part of the General Register that\nrepresents information recorded since the General Register, or any\npart of the General Register, was last delivered to the Minister."
    },
