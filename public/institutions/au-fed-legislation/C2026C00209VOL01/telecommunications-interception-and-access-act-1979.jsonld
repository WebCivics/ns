        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180d-ss-2-logic-alleninterval-5"
        }
      ],
      "cml:integrityHash": "fa50591477d98a73d99a66a20fb2fac0fdc3e51bcbc394bd75496cc37597cbb5",
      "skos:note": "Authorised officer must make disclosure only if necessary for Organisation's functions or enforcement of laws."
    },
    {
