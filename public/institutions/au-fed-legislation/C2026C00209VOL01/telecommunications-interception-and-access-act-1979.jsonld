          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186f-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186f-ss-2-logic-deontic-2"
