    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Effect of revocation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.155",
      "values:originalText": "Where a declaration under section 34 in relation to an eligible\nauthority of a State is revoked, this Act:\n\n(a) continues to apply in relation to a warrant that was issued to\nthe authority before the revocation; and\n\n(b) so applies at a particular time as if the authority were an\nagency at that time.",
      "skos:definition": "Where a declaration under section 34 in relation to an eligible\nauthority of a State is revoked, this Act:\n\n(a) continues to apply in relation to a warrant that was issued to\nthe authority before the revocation; and\n\n(b) so applies at a particular time as if the authority were an\nagency at that time.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-38-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-38-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "acca57ac72cd2cbdc8e113922963975ff7f9506c1efd4f1228c0e34f5712a570",
      "skos:note": "Continues to apply in relation to a warrant issued before revocation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Effect of revocation",
      "values:kind": "section",
      "cof:pageNumber": 155,
      "values:originalText": "Where a declaration under section 34 in relation to an eligible\nauthority of a State is revoked, this Act:\n\n(a) continues to apply in relation to a warrant that was issued to\nthe authority before the revocation; and\n\n(b) so applies at a particular time as if the authority were an\nagency at that time."
    },
    {
