    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-30-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 June, give to the Minister a written report that sets out such",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-30-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.355",
      "values:originalText": "information as:\n\n(a) Division 2 (other than section 163A) requires to be set out in\nthe Minister’s report under that Division relating to the year\nending on that 30 June; and\n\n(b) can be derived from the agency’s records.\n\n(2) Section 34C of the Acts Interpretation Act 1901 does not apply in\nrelation to a report under this section.",
      "skos:definition": "information as:\n\n(a) Division 2 (other than section 163A) requires to be set out in\nthe Minister’s report under that Division relating to the year\nending on that 30 June; and\n\n(b) can be derived from the agency’s records.\n\n(2) Section 34C of the Acts Interpretation Act 1901 does not apply in\nrelation to a report under this section.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-30-2-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-30-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b8559192e3bc90122a9e840ef59f92495b8857eb702d40bffe93989261c5fb69",
      "skos:note": "Must provide written report with specified information by June 30th.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-30-2",
      "@type": "cof:Section",
      "cof:title": "30 June, give to the Minister a written report that sets out such",
      "values:kind": "section",
      "cof:pageNumber": 355,
      "values:originalText": "information as:\n\n(a) Division 2 (other than section 163A) requires to be set out in\nthe Minister’s report under that Division relating to the year\nending on that 30 June; and\n\n(b) can be derived from the agency’s records.\n\n(2) Section 34C of the Acts Interpretation Act 1901 does not apply in\nrelation to a report under this section."
    },
