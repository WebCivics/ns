      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.324",
      "values:originalText": "(3) A stored communications warrant must set out short particulars of\neach serious contravention or serious foreign contravention in\nrelation to which the issuing authority issuing the warrant was\nsatisfied, on the application for the warrant, as mentioned in\nsubparagraph 116(1)(d)(i) or (ii), as the case may be.",
      "skos:definition": "(3) A stored communications warrant must set out short particulars of\neach serious contravention or serious foreign contravention in\nrelation to which the issuing authority issuing the warrant was\nsatisfied, on the application for the warrant, as mentioned in\nsubparagraph 116(1)(d)(i) or (ii), as the case may be.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-118"
      },
