      "skos:prefLabel": "63A(4) Dealing in connection with existing proceeding",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-63a-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.222",
      "values:originalText": "(4) For the purposes of this section, a proceeding by way of an appeal\nfrom, or otherwise arising out of, another proceeding shall be\ndeemed to have begun before the commencement of this Part if the\nother proceeding began, or by virtue of any other application or\napplications of this section is deemed to have begun, before that\ncommencement.",
      "skos:definition": "(4) For the purposes of this section, a proceeding by way of an appeal\nfrom, or otherwise arising out of, another proceeding shall be\ndeemed to have begun before the commencement of this Part if the\nother proceeding began, or by virtue of any other application or\napplications of this section is deemed to have begun, before that\ncommencement.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63a"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-4-norm"
        }
      ],
      "cml:integrityHash": "248e082fa9a9e49f322377b0e037e4f172ad6d818c792af818a4b2a95e5ff5f2",
      "skos:note": "Conditional commencement of a proceeding"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-63a-ss-4",
      "@type": "cof:Section",
      "cof:title": "63A(4) Dealing in connection with existing proceeding",
      "values:kind": "subsection",
      "cof:pageNumber": 222,
      "values:originalText": "(4) For the purposes of this section, a proceeding by way of an appeal\nfrom, or otherwise arising out of, another proceeding shall be\ndeemed to have begun before the commencement of this Part if the\nother proceeding began, or by virtue of any other application or\napplications of this section is deemed to have begun, before that\ncommencement."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63a-ss-4-norm",
