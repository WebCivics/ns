    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63e",
      "@type": "cml:Concept",
      "skos:prefLabel": "63E Responsible person for a computer network may communicate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-63e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.226",
      "values:originalText": "information to an agency\n\nA responsible person for a computer network may communicate\nlawfully intercepted information (other than foreign intelligence\ninformation) to an officer of an agency if:\n\n(a) the information was communicated to the responsible person\nunder paragraph 63C(2)(a); and\n\n(b) the responsible person suspects, on reasonable grounds, that\nthe information is relevant to determining whether another\nperson has committed a prescribed offence.",
      "skos:definition": "information to an agency\n\nA responsible person for a computer network may communicate\nlawfully intercepted information (other than foreign intelligence\ninformation) to an officer of an agency if:\n\n(a) the information was communicated to the responsible person\nunder paragraph 63C(2)(a); and\n\n(b) the responsible person suspects, on reasonable grounds, that\nthe information is relevant to determining whether another\nperson has committed a prescribed offence.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63e-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63e-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63e-logic-epistemic-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-63e-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "4563ed938763c2d65a19ca5c221f0743ae622563ba49ecf75ea58812d33ed9a5",
      "skos:note": "Communicate intercepted information to an agency officer under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-63e",
      "@type": "cof:Section",
      "cof:title": "63E Responsible person for a computer network may communicate",
      "values:kind": "section",
      "cof:pageNumber": 226,
      "values:originalText": "information to an agency\n\nA responsible person for a computer network may communicate\nlawfully intercepted information (other than foreign intelligence\ninformation) to an officer of an agency if:\n\n(a) the information was communicated to the responsible person\nunder paragraph 63C(2)(a); and\n\n(b) the responsible person suspects, on reasonable grounds, that\nthe information is relevant to determining whether another\nperson has committed a prescribed offence."
    },
