      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the chief officer has a duty to assist the Ombudsman, then they must provide assistance within a reasonable timeframe.",
      "cml:conclusionText": "The chief officer's provision of assistance implies that they have met their obligation."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "SPREADS",
      "cml:logicSummary": "Spread of information or influence",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The chief officer's provision of assistance spreads to the Ombudsman and other relevant parties.",
      "cml:conclusionText": "The assistance provided by the chief officer diffuses to the Ombudsman and other relevant parties."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "RECOGNIZES",
      "cml:logicSummary": "Recognition of patterns or relationships",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The chief officer recognizes their responsibility to assist the Ombudsman.",
      "cml:conclusionText": "The chief officer's recognition of their responsibility implies that they have met their obligation."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-186b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "186B(5) Inspection of records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-186b-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
