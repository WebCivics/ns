    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-181a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "181A(2) Disclosure/use offences: authorisations under Division 3",
      "cml:realizedBy": {
