    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180s",
      "@type": "cml:Concept",
      "skos:prefLabel": "180S Oaths and affirmations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.391",
      "values:originalText": "(1) Information given to the Part 4-1 issuing authority in connection\nwith the application must be verified on oath or affirmation.\n\n(2) For the purposes of this section, the Part 4-1 issuing authority may:\n\n(a) administer an oath or affirmation; or\n\n(b) authorise another person to administer an oath or affirmation.\nThe oath or affirmation may be administered in person, or by\ntelephone, video call, video link or audio link.",
      "skos:definition": "(1) Information given to the Part 4-1 issuing authority in connection\nwith the application must be verified on oath or affirmation.\n\n(2) For the purposes of this section, the Part 4-1 issuing authority may:\n\n(a) administer an oath or affirmation; or\n\n(b) authorise another person to administer an oath or affirmation.\nThe oath or affirmation may be administered in person, or by\ntelephone, video call, video link or audio link.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180s-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-180s-ss-2"
        }
      ],
      "cml:integrityHash": "7c34fa221cc7a618e59bad9b26390596dcdd9d27c9cb6143a587579d85ae0eb9"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-180s",
      "@type": "cof:Section",
      "cof:title": "180S Oaths and affirmations",
      "values:kind": "section",
      "cof:pageNumber": 391,
      "values:originalText": "(1) Information given to the Part 4-1 issuing authority in connection\nwith the application must be verified on oath or affirmation.\n\n(2) For the purposes of this section, the Part 4-1 issuing authority may:\n\n(a) administer an oath or affirmation; or\n\n(b) authorise another person to administer an oath or affirmation.\nThe oath or affirmation may be administered in person, or by\ntelephone, video call, video link or audio link."
    },
