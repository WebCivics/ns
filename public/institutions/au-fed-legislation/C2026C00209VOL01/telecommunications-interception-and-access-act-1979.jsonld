        }
      ],
      "cml:integrityHash": "60ac8c25349910af592b32a5233b92682cf56cef58e5f886bc39aa0be06f3782",
      "skos:note": "Remedial relief for unlawful interception or communication"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107a-ss-4",
