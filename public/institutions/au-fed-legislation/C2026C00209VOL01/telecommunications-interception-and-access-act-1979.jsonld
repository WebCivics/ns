      "cml:premiseText": "(3) A warrant under this section shall specify the period for which it is\nto remain in force, being a period that does not exceed 48 hours,",
      "cml:conclusionText": "The Attorney-General may revoke the warrant at any time before expiration."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-10-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between warrant and revocation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A warrant under this section shall specify the period for which it is\nto remain in force, being a period that does not exceed 48 hours,",
      "cml:conclusionText": "The warrant's duration overlaps with the Attorney-General's power to revoke."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-10-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal relationship between warrant and revocation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A warrant under this section shall specify the period for which it is\nto remain in force, being a period that does not exceed 48 hours,",
      "cml:conclusionText": "The warrant's duration ends before the Attorney-General can revoke."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-10-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Warrant revocation diffuses to Attorney-General",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A warrant under this section shall specify the period for which it is\nto remain in force, being a period that does not exceed 48 hours,",
      "cml:conclusionText": "The Attorney-General's power to revoke diffuses from the warrant."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-10-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:logicSummary": "Warrant revocation inference",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A warrant under this section shall specify the period for which it is\nto remain in force, being a period that does not exceed 48 hours,",
      "cml:conclusionText": "The Attorney-General can infer their power to revoke from the warrant."
    },
    {
