      "cml:integrityHash": "449ecd4931bbcd0b8e482435c9a345d7b50715ad6d26c0357aecaacfab3ccc76",
      "skos:note": "Defines emergency interception action"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-94a-ss-4",
      "@type": "cof:Section",
      "cof:title": "94A(4) Reports regarding emergency interception action",
      "values:kind": "subsection",
      "cof:pageNumber": 272,
      "values:originalText": "(4) In this section:\nemergency interception action means an interception done under\nsubsection 7(4) or (5) or action taken under one of those\nsubsections to cause an interception to occur."
    },
