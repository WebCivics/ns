    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-68a",
      "@type": "cml:Concept",
      "skos:prefLabel": "68A Communicating information obtained by the Secretary of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-68a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.241",
      "values:originalText": "Attorney-General’s Department\n\n(1) This section applies to information communicated to the Secretary\nof the Department administered by the Attorney-General as\ndescribed in an item of the following table:\n\nInformation to which this section applies\nItem\nInformation communicated\nunder this provision:\nFor the purpose of providing it to\nthis entity:\nparagraph 68(l)\nthe foreign country concerned\nparagraph 68(la)\nthe International Criminal Court\nparagraph 68(lb)\nthe War Crimes Tribunal concerned\n\n(2) Each of the following:\n\n(a) the Secretary of that Department;\n\n(b) a person authorised by that Secretary;\n\n(c) a person or other entity to whom the information has been\ncommunicated under this subsection;\nmay communicate the information to another person or entity for\npurposes connected with providing the information to the entity\nmentioned in that table item.",
      "skos:definition": "Attorney-General’s Department\n\n(1) This section applies to information communicated to the Secretary\nof the Department administered by the Attorney-General as\ndescribed in an item of the following table:\n\nInformation to which this section applies\nItem\nInformation communicated\nunder this provision:\nFor the purpose of providing it to\nthis entity:\nparagraph 68(l)\nthe foreign country concerned\nparagraph 68(la)\nthe International Criminal Court\nparagraph 68(lb)\nthe War Crimes Tribunal concerned\n\n(2) Each of the following:\n\n(a) the Secretary of that Department;\n\n(b) a person authorised by that Secretary;\n\n(c) a person or other entity to whom the information has been\ncommunicated under this subsection;\nmay communicate the information to another person or entity for\npurposes connected with providing the information to the entity\nmentioned in that table item.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-68a-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-68a-ss-2"
        }
      ],
      "cml:integrityHash": "c2edc5afabf4a79b3eede1e2cbe0de0f29cd6560c584bf903df30fa9f677f42f"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-68a",
      "@type": "cof:Section",
      "cof:title": "68A Communicating information obtained by the Secretary of the",
      "values:kind": "section",
      "cof:pageNumber": 241,
      "values:originalText": "Attorney-General’s Department\n\n(1) This section applies to information communicated to the Secretary\nof the Department administered by the Attorney-General as\ndescribed in an item of the following table:\n\nInformation to which this section applies\nItem\nInformation communicated\nunder this provision:\nFor the purpose of providing it to\nthis entity:\nparagraph 68(l)\nthe foreign country concerned\nparagraph 68(la)\nthe International Criminal Court\nparagraph 68(lb)\nthe War Crimes Tribunal concerned\n\n(2) Each of the following:\n\n(a) the Secretary of that Department;\n\n(b) a person authorised by that Secretary;\n\n(c) a person or other entity to whom the information has been\ncommunicated under this subsection;\nmay communicate the information to another person or entity for\npurposes connected with providing the information to the entity\nmentioned in that table item."
    },
