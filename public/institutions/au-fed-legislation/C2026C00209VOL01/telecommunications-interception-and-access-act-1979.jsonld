    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-161",
      "@type": "cml:Concept",
      "skos:prefLabel": "161 Annual report by Minister about stored communications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-161"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
