      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of refusal or failure to comply with section 87 requirements.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 87 requires attendance, furnishing of information, and answering of questions.",
      "cml:conclusionText": "Compliance is required."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "107(2) Offences relating to inspections under Part 2-7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.291",
      "values:originalText": "(2) A person shall not:\n\n(a) intentionally obstruct, hinder or resist a person in connection\nwith the performance or exercise of the Ombudsman’s\nfunctions or powers under Part 2-7; or\n\n(b) give to an inspecting officer, in connection with an inspection\nunder Part 2-7, information or a statement that the\nfirst-mentioned person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 6 months.",
      "skos:definition": "(2) A person shall not:\n\n(a) intentionally obstruct, hinder or resist a person in connection\nwith the performance or exercise of the Ombudsman’s\nfunctions or powers under Part 2-7; or\n\n(b) give to an inspecting officer, in connection with an inspection\nunder Part 2-7, information or a statement that the\nfirst-mentioned person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 6 months.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107"
      },
      "cml:asserts": [
