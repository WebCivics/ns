    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-134",
      "@type": "cml:Concept",
      "skos:prefLabel": "134 Dealing in preservation notice information or stored",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-134"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.335",
      "values:originalText": "communications warrant information\n\nA person may, for the purposes of Part 3-1A, 3-2, 3-3, 3-5 or 3-6 or\nChapter 4A:\n\n(a) communicate preservation notice information or stored\ncommunications warrant information to another person; or\n\n(b) make use of preservation notice information or stored\ncommunications warrant information; or\n\n(c) make a record of preservation notice information or stored\ncommunications warrant information; or\n\n(d) give preservation notice information or stored\ncommunications warrant information in evidence in a\nproceeding.",
      "skos:definition": "communications warrant information\n\nA person may, for the purposes of Part 3-1A, 3-2, 3-3, 3-5 or 3-6 or\nChapter 4A:\n\n(a) communicate preservation notice information or stored\ncommunications warrant information to another person; or\n\n(b) make use of preservation notice information or stored\ncommunications warrant information; or\n\n(c) make a record of preservation notice information or stored\ncommunications warrant information; or\n\n(d) give preservation notice information or stored\ncommunications warrant information in evidence in a\nproceeding.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-134-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-134-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "40e3372621b0bdf9dedf1f783acaf4fce1d7c0da89f9d1ada23052f81e8daccb",
      "skos:note": "Communicate preservation notice information or stored communications warrant information."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-134",
      "@type": "cof:Section",
      "cof:title": "134 Dealing in preservation notice information or stored",
      "values:kind": "section",
      "cof:pageNumber": 335,
      "values:originalText": "communications warrant information\n\nA person may, for the purposes of Part 3-1A, 3-2, 3-3, 3-5 or 3-6 or\nChapter 4A:\n\n(a) communicate preservation notice information or stored\ncommunications warrant information to another person; or\n\n(b) make use of preservation notice information or stored\ncommunications warrant information; or\n\n(c) make a record of preservation notice information or stored\ncommunications warrant information; or\n\n(d) give preservation notice information or stored\ncommunications warrant information in evidence in a\nproceeding."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-134-norm",
      "@type": "values:Permission",
