    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-87-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "87(6) Power to obtain relevant information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-87-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
