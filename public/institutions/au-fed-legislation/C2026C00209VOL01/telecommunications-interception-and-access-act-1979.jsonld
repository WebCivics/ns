    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107c",
      "@type": "cml:Concept",
      "skos:prefLabel": "107C No limitation on other liability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.295",
      "values:originalText": "No limitation\n\n(1) This Part does not limit any liability (whether criminal or civil) that\na person has under any other provision of this Act or under any\nother law.\n\nChapter 2  Interception of telecommunications",
      "skos:definition": "No limitation\n\n(1) This Part does not limit any liability (whether criminal or civil) that\na person has under any other provision of this Act or under any\nother law.\n\nChapter 2  Interception of telecommunications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107c-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "07ce08155d39807fdd35e5d476bcbb99edbca0d354d07b01e46753a8b456c788",
      "skos:note": "No limitation on liability under other provisions of this Act or laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sec-107c",
      "@type": "cof:Section",
      "cof:title": "107C No limitation on other liability",
      "values:kind": "section",
      "cof:pageNumber": 295,
      "values:originalText": "No limitation\n\n(1) This Part does not limit any liability (whether criminal or civil) that\na person has under any other provision of this Act or under any\nother law.\n\nChapter 2  Interception of telecommunications"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sec-107c-norm",
      "@type": "values:Obligation",
