    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The document must be kept for 3 years or until it ceases to retain information obtained in accordance with an international production order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval for keeping the document.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The period for which the Director-General of Security must cause a copy of the document to be kept is the period starting when the document came into existence."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation applies the rule by keeping the document.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Describes the application of the rule to the Organisation.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The Director-General of Security must cause a copy of the document to be kept in the Organisation’s records under subclause (1)."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation has a duty to keep the document.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the Organisation to keep the document.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The Director-General of Security must cause a copy of the document to be kept in the Organisation’s records under subclause (1)."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation's records include documents related to international production orders.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Describes the scope of the Organisation's records.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The document is kept in the Organisation’s records under subclause (1)."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The document must be kept in an ordered trace for 3 years or until it ceases to retain information obtained in accordance with an international production order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines the temporal interval for keeping the document as an ordered trace.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The period for which the Director-General of Security must cause a copy of the document to be kept is the period starting when the document came into existence."
    },
