    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.240",
      "skos:note": "The Organisation must keep a copy of the document for 3 years or until it ceases to retain information obtained in accordance with an international production order.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "135(2) Keeping documents associated with international production"
      },
      "wasDerivedFrom": "telecommunications-interception-and-access-act-1979.pdf",
      "asserts": [
        "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-135-ss-2-norm",
