      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Prohibits the use, recording or disclosure of protected information at all times.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Prohibition",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person uses, records or discloses information; and  (b) the information is protected information; and  (c) the use, recording or disclosure of the information is not permitted by this Part."
    },
