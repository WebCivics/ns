    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.211",
      "skos:note": "Must consider if order complies with designated international agreement before giving it to the provider.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "110 Simplified outline of this Part"
      },
      "wasDerivedFrom": "telecommunications-interception-and-access-act-1979.pdf",
      "asserts": [
        "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-norm",
        "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-logic-deontic-1",
        "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-logic-deontic-2"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "debc59e6155c03e10e97a75f2d40ed067b45dbc1732b91cfbf3dbd931a2f426d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-interception-and-access-act-1979#sch-1-sec-110",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the Australian Designated Authority is satisfied that the order complies with the designated international agreement nominated in the application for the order, the Australian Designated Authority must give the order to the prescribed communications provider.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consider if order complies with designated international agreement.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Australian Designated Authority must consider whether the order complies with the designated international agreement nominated in the application for the order."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must cancel the order if it does not comply with designated international agreement.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT",
      "cml:premiseText": "If the Australian Designated Authority is not satisfied that the order complies with the designated international agreement nominated in the application for the order, the Australian Designated Authority must cancel the order."
    },
