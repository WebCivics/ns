doc:sch-1-sec-207 a cof:Section ;
    cof:title "207 Costs to be borne by the carriers" ;
    values:kind "section" ;
    values:originalText "The capital and ongoing costs of developing, installing and maintaining a capability imposed on a carrier under section 190 or 191 in respect of a particular kind of telecommunications service are to be borne by the carrier. Note: The definition of carrier in subsection 5(1) includes carriage service providers.  Co-operation with agencies  Chapter 5 Allocation of costs  Part 5-6 Delivery capability  Division 3  Section 208  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    cof:pageNumber "60"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-208 a cml:Concept ;
    skos:prefLabel "208 Costs to be borne by the interception agencies"@en ;
    cml:realizedBy doc:sch-1-sec-208 ;
    values:originalText "The capital and ongoing costs, worked out in accordance with section 209, of developing, installing and maintaining a delivery capability imposed on a carrier under Part 5-5 in respect of a particular kind of telecommunications service are to be borne by the interception agency concerned. Note: The definition of carrier in subsection 5(1) includes carriage service providers." ;
    skos:definition "The capital and ongoing costs, worked out in accordance with section 209, of developing, installing and maintaining a delivery capability imposed on a carrier under Part 5-5 in respect of a particular kind of telecommunications service are to be borne by the interception agency concerned. Note: The definition of carrier in subsection 5(1) includes carriage service providers."@en ;
    cml:integrityHash "c1c0686aa5522aaeeef04e890f5431fa9fd2fead4657fda4b3a0f0ccfc3f5b34" ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "Interception agencies bear capital and ongoing costs of developing a delivery capability." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
