concept:telecommunications-interception-and-access-act-1979-sch-1-sec-93 a cml:Concept ;
    skos:prefLabel "93 Form of application"@en ;
    cml:realizedBy doc:sch-1-sec-93 ;
    values:originalText "(1) An application under clause 92 must be in writing.  (2) If the person making an application under clause 92 for an international production order on the Organisation’s behalf thinks it necessary, because of urgent circumstances, to make the application by telephone, the person may make the application by telephone. Note: See also clause 17A (urgent circumstances) and clause 172 (action required)." ;
    skos:definition "(1) An application under clause 92 must be in writing.  (2) If the person making an application under clause 92 for an international production order on the Organisation’s behalf thinks it necessary, because of urgent circumstances, to make the application by telephone, the person may make the application by telephone. Note: See also clause 17A (urgent circumstances) and clause 172 (action required)."@en ;
    cml:integrityHash "310b3981ae324f3529de8d7c63c4d09794a6e25202bdf8d9afed0b3f35255737" ;
    cof:pageNumber "195"^^xsd:integer ;
