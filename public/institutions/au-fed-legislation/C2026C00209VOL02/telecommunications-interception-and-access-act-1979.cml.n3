concept:telecommunications-interception-and-access-act-1979-sch-1-sec-71 a cml:Concept ;
    skos:prefLabel "71 Issue of further international production order"@en ;
    cml:realizedBy doc:sch-1-sec-71 ;
    values:originalText "If:  (a) an international production order (the original order) was issued under clause 69; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 69 that:  (d) is in respect of the person; and  Schedule 1  International production orders" ;
    skos:definition "If:  (a) an international production order (the original order) was issued under clause 69; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 69 that:  (d) is in respect of the person; and  Schedule 1  International production orders"@en ;
    cml:integrityHash "4eda6c8e50d97479f4f37eab68cb97e371f5b1b78fa31128a1c8f348695d6b6c" ;
    cof:pageNumber "165"^^xsd:integer ;
    skos:note "Issue of further international production order under clause 69 that is in respect of the person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
