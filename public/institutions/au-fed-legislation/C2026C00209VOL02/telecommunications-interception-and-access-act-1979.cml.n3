concept:telecommunications-interception-and-access-act-1979-sch-1-sec-149 a cml:Concept ;
    skos:prefLabel "149 Ombudsman not to be sued"@en ;
    cml:realizedBy doc:sch-1-sec-149 ;
    values:originalText "The Ombudsman, an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function or power conferred by this Part." ;
    skos:definition "The Ombudsman, an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function or power conferred by this Part."@en ;
    cml:integrityHash "62bf054aaf85932a8e237e5d796bcc3fa8860d751f2d50c751fe27801428fa69" ;
    cof:pageNumber "261"^^xsd:integer ;
    skos:note "Ombudsman not liable to action for acts done in good faith" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.261" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-149-norm .
