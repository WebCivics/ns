concept:telecommunications-interception-and-access-act-1979-sch-1-sec-65 a cml:Concept ;
    skos:prefLabel "65 Contents of written application"@en ;
    cml:realizedBy doc:sch-1-sec-65 ;
    values:originalText "An application under clause 63 must, if it is in writing, set out:  (a) the name of the Part 5.3 IPO agency; and  (b) the name of the person making the application on the agency’s behalf." ;
