concept:telecommunications-interception-and-access-act-1979-sch-1-sec-199 a cml:Concept ;
    skos:prefLabel "199 Commencement of IC plans"@en ;
    cml:realizedBy doc:sch-1-sec-199 ;
    values:originalText "An IC plan of a carrier or nominated carriage service provider:  (a) comes into force on the day the carrier or provider is notified by a Communications Access Coordinator that the plan has been approved; and  (b) continues in force until the day the carrier or provider is notified by a Communications Access Coordinator that another IC plan of the carrier or provider has been approved." ;
    skos:definition "An IC plan of a carrier or nominated carriage service provider:  (a) comes into force on the day the carrier or provider is notified by a Communications Access Coordinator that the plan has been approved; and  (b) continues in force until the day the carrier or provider is notified by a Communications Access Coordinator that another IC plan of the carrier or provider has been approved."@en ;
    cml:integrityHash "19ecc40086e58acdd892d01bbefeb46409acaedf4c2f26a11e725748df8a17a2" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "IC plan comes into force on approval and continues until another approved plan is notified." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.52" ;
