    cof:title "16(4) Issuing authority" ;
    values:kind "subsection" ;
    values:originalText "(4) An appointment under subclause (1) has no effect for the purposes of a provision of this Act (other than this Schedule)." ;
    cof:pageNumber "94"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-16-ss-5 a cml:Concept ;
    skos:prefLabel "16(5) Issuing authority"@en ;
    cml:realizedBy doc:sch-1-sec-16-ss-5 ;
    values:originalText "(5) An issuing authority has, in relation to the performance or exercise of a function or power conferred on an issuing authority by this Schedule, the same protection and immunity as a Justice of the High Court has in relation to proceedings in the High Court." ;
