concept:telecommunications-interception-and-access-act-1979-sch-1-sec-10-ss-2 a cml:Concept ;
    skos:prefLabel "10(2) Uploaded material"@en ;
    cml:realizedBy doc:sch-1-sec-10-ss-2 ;
    values:originalText "(2) For the purposes of the application of this Schedule to a prescribed communications provider that is a body corporate, the provider is based in a foreign country if, and only if:  (a) the provider is incorporated in the foreign country; or  (b) the provider has its principal place of business in the foreign country. Operates in a foreign country" ;
    skos:definition "(2) For the purposes of the application of this Schedule to a prescribed communications provider that is a body corporate, the provider is based in a foreign country if, and only if:  (a) the provider is incorporated in the foreign country; or  (b) the provider has its principal place of business in the foreign country. Operates in a foreign country"@en ;
    cml:integrityHash "95ea093302999d1a3a9b6555cbf9e70ff80984271b729ac579f0cb8708144a2e" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sch-1-sec-10 ;
    cof:pageNumber "91"^^xsd:integer ;
    skos:note "A communications provider is based in a foreign country if it is incorporated or has its principal place of business there." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
