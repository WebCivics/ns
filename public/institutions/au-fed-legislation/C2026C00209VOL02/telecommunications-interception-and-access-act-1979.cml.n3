doc:sch-1-sec-81-ss-2 a cof:Section ;
    cof:title "81(2) Notification to Ombudsman or the Inspector-General of" ;
    values:kind "subsection" ;
    values:originalText "(2) If the chief officer of a Part 5.3 IPO agency contravenes paragraph 114(1)(d) of this Schedule (so far as that paragraph relates to an international production order issued under this Part), the chief officer must:  (a) notify the Ombudsman or the Inspector-General of Intelligence and Security (as the case requires) of the contravention; and  (b) do so as soon as practicable after the contravention." ;
    cof:pageNumber "175"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-81-ss-3 a cml:Concept ;
    skos:prefLabel "81(3) Notification to Ombudsman or the Inspector-General of"@en ;
    cml:realizedBy doc:sch-1-sec-81-ss-3 ;
    values:originalText "(3) A failure to comply with subclause (1) or (2) does not affect the validity of an international production order.  Schedule 1  International production orders" ;
    skos:definition "(3) A failure to comply with subclause (1) or (2) does not affect the validity of an international production order.  Schedule 1  International production orders"@en ;
    cml:integrityHash "1acdd7c7745a26b769b09fab622417b87d9032bacd2a2b9fd97fc22ea520b822" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sch-1-sec-81 ;
    cof:pageNumber "175"^^xsd:integer ;
