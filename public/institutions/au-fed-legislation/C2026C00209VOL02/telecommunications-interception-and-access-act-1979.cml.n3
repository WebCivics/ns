concept:telecommunications-interception-and-access-act-1979-sch-1-sec-173 a cml:Concept ;
    skos:prefLabel "173 Duty of nominated ART Intelligence and Security member"@en ;
    cml:realizedBy doc:sch-1-sec-173 ;
    values:originalText "It is the duty of a nominated ART Intelligence and Security member to ensure, so far as the member is able to do so, that, in or in connection with the performance of a function, or the exercise of a power, conferred on the member by this Schedule, information is not communicated or made available to a person contrary to the requirements of security (within the ordinary meaning of that expression)." ;
    skos:definition "It is the duty of a nominated ART Intelligence and Security member to ensure, so far as the member is able to do so, that, in or in connection with the performance of a function, or the exercise of a power, conferred on the member by this Schedule, information is not communicated or made available to a person contrary to the requirements of security (within the ordinary meaning of that expression)."@en ;
    cml:integrityHash "474ae0d3e2e27f559a96963f5f3d985b4068a1b7c11027ab2d67c5603a5fdfa7" ;
    cof:pageNumber "302"^^xsd:integer ;
    skos:note "Duty to ensure information security" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.302" ;
