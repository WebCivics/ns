concept:telecommunications-interception-and-access-act-1979-sch-1-sec-117-ss-2 a cml:Concept ;
    skos:prefLabel "117(2) Giving of instrument of revocation—the Organisation"@en ;
    cml:realizedBy doc:sch-1-sec-117-ss-2 ;
