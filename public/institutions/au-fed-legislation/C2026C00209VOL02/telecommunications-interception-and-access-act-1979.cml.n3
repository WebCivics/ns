doc:sch-1-sec-106-ss-1 a cof:Section ;
    cof:title "106(1) Giving further information to nominated ART Intelligence and" ;
    values:kind "subsection" ;
    values:originalText "(1) A nominated ART Intelligence and Security member may require further information to be given in connection with an application under clause 101 to the nominated ART Intelligence and Security member for an international production order." ;
    cof:pageNumber "205"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-106-ss-2 a cml:Concept ;
