doc:sch-1-sec-129 a cof:Section ;
    cof:title "129 Reports to be made to the Attorney-General by the" ;
    values:kind "section" ;
    values:originalText "Director-General of Security  The Director-General of Security must:  Schedule 1  International production orders" ;
