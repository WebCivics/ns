doc:sch-1-sec-86-ss-1 a cof:Section ;
    cof:title "86(1) Affidavits to accompany written application" ;
    values:kind "subsection" ;
    values:originalText "(1) A written application under clause 83 for an international production order must be accompanied by an affidavit complying with this clause." ;
    cof:pageNumber "181"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-86-ss-2 a cml:Concept ;
    skos:prefLabel "86(2) Affidavits to accompany written application"@en ;
    cml:realizedBy doc:sch-1-sec-86-ss-2 ;
    values:originalText "(2) The affidavit must set out the facts and other grounds on which the application is based." ;
