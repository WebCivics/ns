doc:sch-1-sec-165-ss-2 a cof:Section ;
    cof:title "165(2) Evidentiary certificates—telecommunications data" ;
    values:kind "subsection" ;
    values:originalText "(2) A certifying officer of a Part 5.3 IPO agency may issue a written certificate signed by the officer setting out such facts as the officer considers relevant with respect to the receipt by the agency of telecommunications data that was disclosed to the agency in accordance with an international production order issued under clause 78." ;
    cof:pageNumber "293"^^xsd:integer .

