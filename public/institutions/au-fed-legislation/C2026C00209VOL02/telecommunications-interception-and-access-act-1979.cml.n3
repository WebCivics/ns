concept:telecommunications-interception-and-access-act-1979-sch-1-sec-56 a cml:Concept ;
    skos:prefLabel "56 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-56 ;
    values:originalText "The information given to an eligible Judge or nominated ART member in connection with a telephone application under clause 52 to the eligible Judge or nominated ART member:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Part 5.3 IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 54 or 55 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the eligible Judge or nominated ART member directs." ;
    skos:definition "The information given to an eligible Judge or nominated ART member in connection with a telephone application under clause 52 to the eligible Judge or nominated ART member:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Part 5.3 IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 54 or 55 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the eligible Judge or nominated ART member directs."@en ;
    cml:integrityHash "2ec301656eda34254a1501555cd6285386a8d8048831c96f35fe26b7744c0e91" ;
    cof:pageNumber "141"^^xsd:integer ;
    skos:note "Information must be provided to an eligible Judge or nominated ART member." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
