doc:sch-1-sec-131-ss-1 a cof:Section ;
    cof:title "131(1) Annual reports by the Minister" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister must, as soon as practicable after the end of each financial year, cause to be prepared a written report that:  (a) sets out, for each relevant agency, the information contained in the report by the chief officer of the agency under clause 128 for the financial year; and  (b) sets out the information contained in the report by the Australian Designated Authority under clause 130 for the financial year. Report to be tabled" ;
    cof:pageNumber "232"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-131-ss-2 a cml:Concept ;
    skos:prefLabel "131(2) Annual reports by the Minister"@en ;
    cml:realizedBy doc:sch-1-sec-131-ss-2 ;
    values:originalText "(2) The Minister must cause a copy of a report under subclause (1) to be tabled in each House of the Parliament within 15 sitting days of that House after the report is prepared." ;
    skos:definition "(2) The Minister must cause a copy of a report under subclause (1) to be tabled in each House of the Parliament within 15 sitting days of that House after the report is prepared."@en ;
    cml:integrityHash "910eb0be4d3a2b608786cada2e7ba18ab1ecd4efb5d04ede0a003c9a1e04ad7b" ;
    values:partOf concept:telecommunications-interception-and-access-act-1979-sch-1-sec-131 ;
