concept:telecommunications-interception-and-access-act-1979-sch-1-sec-94 a cml:Concept ;
    skos:prefLabel "94 Contents of written application"@en ;
    cml:realizedBy doc:sch-1-sec-94 ;
    values:originalText "An application under clause 92 must, if it is in writing, set out:  (a) a statement to the effect that the application is made by the Organisation; and  (b) the name of the person making the application on the Organisation’s behalf.  Schedule 1  International production orders" ;
    skos:definition "An application under clause 92 must, if it is in writing, set out:  (a) a statement to the effect that the application is made by the Organisation; and  (b) the name of the person making the application on the Organisation’s behalf.  Schedule 1  International production orders"@en ;
    cml:integrityHash "467af4dc47f5acea3c5169bdb73ac809075e9264cc8462737a1ae6bb238b31f8" ;
    cof:pageNumber "195"^^xsd:integer ;
    skos:note "Application must provide Organisation's name and person making application on behalf of the Organisation." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
