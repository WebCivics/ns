concept:telecommunications-interception-and-access-act-1979-sch-1-sec-87 a cml:Concept ;
    skos:prefLabel "87 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-87 ;
    values:originalText "The information given to a nominated ART Intelligence and Security member in connection with a telephone application under clause 83 to the nominated ART Intelligence and Security member:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Organisation’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 85 or 86 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the nominated ART Intelligence and Security member directs." ;
    skos:definition "The information given to a nominated ART Intelligence and Security member in connection with a telephone application under clause 83 to the nominated ART Intelligence and Security member:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Organisation’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 85 or 86 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the nominated ART Intelligence and Security member directs."@en ;
    cml:integrityHash "c23823c9e816ca4d2d86ddce4d8f61d6ea25a09ccf8269285260693d9873f38e" ;
    cof:pageNumber "182"^^xsd:integer ;
    skos:note "Information must be provided on telephone application" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.182" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-87-norm .
