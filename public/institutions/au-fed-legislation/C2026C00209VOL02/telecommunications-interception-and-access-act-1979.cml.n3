    cof:title "95(2) Affidavits to accompany written application" ;
    values:kind "subsection" ;
    values:originalText "(2) The affidavit must set out the facts and other grounds on which the application is based." ;
    cof:pageNumber "196"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-95-ss-3 a cml:Concept ;
    skos:prefLabel "95(3) Affidavits to accompany written application"@en ;
    cml:realizedBy doc:sch-1-sec-95-ss-3 ;
    values:originalText "(3) Despite subclause (1), a written application may be accompanied by 2 or more affidavits that together set out each matter that, apart from this subclause, this clause would have required an affidavit accompanying the application to set out." ;
    skos:definition "(3) Despite subclause (1), a written application may be accompanied by 2 or more affidavits that together set out each matter that, apart from this subclause, this clause would have required an affidavit accompanying the application to set out."@en ;
