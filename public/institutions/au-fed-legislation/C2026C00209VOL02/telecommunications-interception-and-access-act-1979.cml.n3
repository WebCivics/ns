concept:telecommunications-interception-and-access-act-1979-sch-1-sec-85 a cml:Concept ;
    skos:prefLabel "85 Contents of application"@en ;
    cml:realizedBy doc:sch-1-sec-85 ;
    values:originalText "A written application under clause 83 for an international production order must set out:  (a) a statement to the effect that the application is made by the Organisation; and  (b) the name of the person making the application on the Organisation’s behalf.  International production orders  Schedule 1 International production orders relating to national security  Part 4 International production orders relating to interception: national security  Division 2  Clause 86  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    skos:definition "A written application under clause 83 for an international production order must set out:  (a) a statement to the effect that the application is made by the Organisation; and  (b) the name of the person making the application on the Organisation’s behalf.  International production orders  Schedule 1 International production orders relating to national security  Part 4 International production orders relating to interception: national security  Division 2  Clause 86  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "627fafd2dcff0d4d42084ff14afa1e0062ea9411874b88f28c6d5924ce35f894" ;
    cof:pageNumber "180"^^xsd:integer ;
    skos:note "Application must provide organization name and representative's name." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
