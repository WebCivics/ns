concept:telecommunications-interception-and-access-act-1979-sch-1-sec-131-ss-3 a cml:Concept ;
    skos:prefLabel "131(3) Annual reports by the Minister"@en ;
    cml:realizedBy doc:sch-1-sec-131-ss-3 ;
    values:originalText "(3) A report under subclause (1) must not be made in a manner that is likely to enable the identification of a person." ;
