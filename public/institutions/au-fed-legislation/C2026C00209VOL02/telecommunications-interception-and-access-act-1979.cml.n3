concept:telecommunications-interception-and-access-act-1979-sch-1-sec-116 a cml:Concept ;
    skos:prefLabel "116 Revocation of international production orders—the"@en ;
    cml:realizedBy doc:sch-1-sec-116 ;
    values:originalText "Organisation  (1) If an international production order was issued under Part 4 of this Schedule, the Director-General of Security:  (a) may revoke the order; and  (b) must revoke the order if the Director-General of Security is satisfied that the grounds on which the order was issued have ceased to exist.  (2) A revocation under this clause is to be set out in a written instrument." ;
    skos:definition "Organisation  (1) If an international production order was issued under Part 4 of this Schedule, the Director-General of Security:  (a) may revoke the order; and  (b) must revoke the order if the Director-General of Security is satisfied that the grounds on which the order was issued have ceased to exist.  (2) A revocation under this clause is to be set out in a written instrument."@en ;
    cml:integrityHash "350be3643ce78043f7c268bdcee1df0bd01bc04f4eb83a62beb66e76c6e776a7" ;
    cof:pageNumber "218"^^xsd:integer ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sch-1-sec-116-ss-1 ;
    cml:hasPart concept:telecommunications-interception-and-access-act-1979-sch-1-sec-116-ss-2 ;
    cml:curationStatus cml:Proposed ;
