concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67 a cml:Concept ;
    skos:prefLabel "67 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-67 ;
    values:originalText "The information given to an issuing authority in connection with a telephone application under clause 63 to the issuing authority:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Part 5.3 IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 65 or 66 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the issuing authority directs." ;
    skos:definition "The information given to an issuing authority in connection with a telephone application under clause 63 to the issuing authority:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Part 5.3 IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 65 or 66 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the issuing authority directs."@en ;
    cml:integrityHash "0936f47544147001a01b1cabd8d6e966411c647774bd758a63233d5ca454c142" ;
    cof:pageNumber "159"^^xsd:integer ;
    skos:note "Information must be provided on telephone application" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
