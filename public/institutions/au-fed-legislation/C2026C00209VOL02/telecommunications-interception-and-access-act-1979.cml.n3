concept:telecommunications-interception-and-access-act-1979-sch-1-sec-13 a cml:Concept ;
    skos:prefLabel "13 Identification of a particular person"@en ;
    cml:realizedBy doc:sch-1-sec-13 ;
    values:originalText "For the purposes of this Schedule, a particular person may be identified:  (a) by the person’s full name; or  (b) by a name by which the person is commonly known; or  International production orders  Schedule 1 Introduction  Part 1  Clause 14  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026  (c) as the person to whom a particular individual transmission service is supplied; or  (d) as the person to whom a particular individual message/call application service is provided; or  (e) as the person who has a particular account with a prescribed communications provider; or  (f) as the person who has a particular telephone number; or  (g) as the person who has a particular email address; or  (h) as the person who has a particular internet protocol address; or  (i) as the person who has a device that has a particular unique identifier (for example, an electronic serial number or a Media Access Control address); or  (j) by any other unique identifying factor that is applicable to the person." ;
    skos:definition "For the purposes of this Schedule, a particular person may be identified:  (a) by the person’s full name; or  (b) by a name by which the person is commonly known; or  International production orders  Schedule 1 Introduction  Part 1  Clause 14  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026  (c) as the person to whom a particular individual transmission service is supplied; or  (d) as the person to whom a particular individual message/call application service is provided; or  (e) as the person who has a particular account with a prescribed communications provider; or  (f) as the person who has a particular telephone number; or  (g) as the person who has a particular email address; or  (h) as the person who has a particular internet protocol address; or  (i) as the person who has a device that has a particular unique identifier (for example, an electronic serial number or a Media Access Control address); or  (j) by any other unique identifying factor that is applicable to the person."@en ;
    cml:integrityHash "f33013da6891cea18e7dd8a365e6037e63d576963c9188c4cf16d0c8e60aef43" ;
    cof:pageNumber "92"^^xsd:integer ;
    skos:note "A particular person may be identified by various means." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.92" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-13-norm .
