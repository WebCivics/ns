    values:partOf concept:telecommunications-interception-and-access-act-1979-sch-1-sec-3 ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Conditional commencement based on agreement entering into force for Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.80" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-3-ss-3-norm .
