concept:telecommunications-interception-and-access-act-1979-sch-1-sec-182 a cml:Concept ;
    skos:prefLabel "182 Specification of international agreements"@en ;
    cml:realizedBy doc:sch-1-sec-182 ;
    values:originalText "(1) If:  (a) there is an agreement between Australia and one or more foreign countries; and  (b) the name of the agreement is specified in:  (i) regulations made for the purposes of this Schedule; or  (ii) an application made under this Schedule; or  (iii) an international production order; or  (iv) any other instrument made under this Schedule; a reference in the regulations, application, order or other instrument (as the case may be) to the agreement is a reference to the agreement as amended and in force for Australia from time to time.  Schedule 1  International production orders" ;
    skos:definition "(1) If:  (a) there is an agreement between Australia and one or more foreign countries; and  (b) the name of the agreement is specified in:  (i) regulations made for the purposes of this Schedule; or  (ii) an application made under this Schedule; or  (iii) an international production order; or  (iv) any other instrument made under this Schedule; a reference in the regulations, application, order or other instrument (as the case may be) to the agreement is a reference to the agreement as amended and in force for Australia from time to time.  Schedule 1  International production orders"@en ;
    cml:integrityHash "5a2945619b8f95d55f116b24f057a39326ed6dfb1203249e8aeaf58076416da3" ;
    cof:pageNumber "307"^^xsd:integer ;
    skos:note "Reference to international agreements is a reference to the agreement as amended and in force for Australia from time to time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.307" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-182-norm .
