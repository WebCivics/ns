concept:telecommunications-interception-and-access-act-1979-sch-1-sec-74 a cml:Concept ;
    skos:prefLabel "74 Contents of written application"@en ;
    cml:realizedBy doc:sch-1-sec-74 ;
    values:originalText "An application under clause 72 must, if it is in writing, set out:  (a) the name of the Part 5.3 IPO agency; and  (b) the name of the person making the application on the agency’s behalf." ;
    skos:definition "An application under clause 72 must, if it is in writing, set out:  (a) the name of the Part 5.3 IPO agency; and  (b) the name of the person making the application on the agency’s behalf."@en ;
