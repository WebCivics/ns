concept:telecommunications-interception-and-access-act-1979-sch-1-sec-198 a cml:Concept ;
    skos:prefLabel "198 Consideration of IC plans"@en ;
    cml:realizedBy doc:sch-1-sec-198 ;
    values:originalText "(1) If a carrier or a nominated carriage service provider gives a Communications Access Coordinator an IC plan under section 196, 197 or 201, or an amended IC plan under this section, a Communications Access Coordinator must, within 60 days of the plan being received:  (a) approve the plan and notify the carrier or provider of the approval; or  (b) give the plan back to the carrier or provider with a written request for the carrier or provider to give a Communications  Chapter 5  Co-operation with agencies" ;
    skos:definition "(1) If a carrier or a nominated carriage service provider gives a Communications Access Coordinator an IC plan under section 196, 197 or 201, or an amended IC plan under this section, a Communications Access Coordinator must, within 60 days of the plan being received:  (a) approve the plan and notify the carrier or provider of the approval; or  (b) give the plan back to the carrier or provider with a written request for the carrier or provider to give a Communications  Chapter 5  Co-operation with agencies"@en ;
    cml:integrityHash "355705210644a096a5febfd2fd283c26874059035ab19737e02f0c23009fbdb1" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "Must approve IC plan within 60 days" ;
    dc:description "approval and notification" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
