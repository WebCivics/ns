concept:telecommunications-interception-and-access-act-1979-sch-1-sec-207 a cml:Concept ;
    skos:prefLabel "207 Costs to be borne by the carriers"@en ;
    cml:realizedBy doc:sch-1-sec-207 ;
    values:originalText "The capital and ongoing costs of developing, installing and maintaining a capability imposed on a carrier under section 190 or 191 in respect of a particular kind of telecommunications service are to be borne by the carrier. Note: The definition of carrier in subsection 5(1) includes carriage service providers.  Co-operation with agencies  Chapter 5 Allocation of costs  Part 5-6 Delivery capability  Division 3  Section 208  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026" ;
    skos:definition "The capital and ongoing costs of developing, installing and maintaining a capability imposed on a carrier under section 190 or 191 in respect of a particular kind of telecommunications service are to be borne by the carrier. Note: The definition of carrier in subsection 5(1) includes carriage service providers.  Co-operation with agencies  Chapter 5 Allocation of costs  Part 5-6 Delivery capability  Division 3  Section 208  Telecommunications (Interception and Access) Act 1979  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "09bef6c2a393d5dbd5bc6004c49edd0d54ec5401455a6c48c5ac12609b94a5f8" ;
    cof:pageNumber "60"^^xsd:integer ;
    skos:note "Carrier bears capital and ongoing costs of developing, installing and maintaining a capability." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
