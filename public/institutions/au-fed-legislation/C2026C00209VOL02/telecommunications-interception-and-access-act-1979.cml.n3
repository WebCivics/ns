    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-116-ss-1 a cof:Section ;
    cof:title "116(1) Revocation of international production orders—the" ;
    values:kind "subsection" ;
    values:originalText "(1) If an international production order was issued under Part 4 of this Schedule, the Director-General of Security:  (a) may revoke the order; and  (b) must revoke the order if the Director-General of Security is satisfied that the grounds on which the order was issued have ceased to exist." ;
    cof:pageNumber "218"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-116-ss-2 a cml:Concept ;
    skos:prefLabel "116(2) Revocation of international production orders—the"@en ;
    cml:realizedBy doc:sch-1-sec-116-ss-2 ;
    values:originalText "(2) A revocation under this clause is to be set out in a written instrument." ;
    skos:definition "(2) A revocation under this clause is to be set out in a written instrument."@en ;
