doc:sch-1-sec-187la-ss-2 a cof:Section ;
    cof:title "187LA(2) Application of the Privacy Act 1988" ;
    values:kind "subsection" ;
    values:originalText "(2) Information that is kept under this Part, or information that is in a document kept under this Part is taken, for the purposes of the Privacy Act 1988, to be personal information about an individual if the information relates to:  (a) the individual; or  (b) a communication to which the individual is a party." ;
    cof:pageNumber "36"^^xsd:integer .

concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187m a cml:Concept ;
    skos:prefLabel "187M Pecuniary penalties and infringement notices"@en ;
    cml:realizedBy doc:sch-1-sec-187m ;
    values:originalText "Subsection 187A(1) and paragraph 187D(a) are civil penalty provisions for the purposes of the Telecommunications Act 1997. Note: Parts 31 and 31B of the Telecommunications Act 1997 provide for pecuniary penalties and infringement notices for contraventions of civil penalty provisions." ;
    skos:definition "Subsection 187A(1) and paragraph 187D(a) are civil penalty provisions for the purposes of the Telecommunications Act 1997. Note: Parts 31 and 31B of the Telecommunications Act 1997 provide for pecuniary penalties and infringement notices for contraventions of civil penalty provisions."@en ;
    cml:integrityHash "51ebcb975cc272fa938244b05f56765b0874cdd3744d5e69f40200d74af646b6" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Pecuniary penalties and infringement notices for contraventions of civil penalty provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.36" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187m-norm .
