doc:sch-1-sec-205-ss-1 a cof:Section ;
    cof:title "205(1) Obligations of persons not covered by a determination in" ;
    values:kind "subsection" ;
    values:originalText "(1) Each carrier supplying a particular kind of telecommunications service that is not covered by any determination under section 203 but that involves, or will involve, the use of a telecommunications system must ensure that the kind of service or the system has a delivery capability. Note: The definition of carrier in subsection 5(1) includes carriage service providers." ;
    cof:pageNumber "58"^^xsd:integer .

