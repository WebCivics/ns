concept:telecommunications-interception-and-access-act-1979-sch-1-sec-202 a cml:Concept ;
    skos:prefLabel "202 Confidential treatment of IC plans"@en ;
    cml:realizedBy doc:sch-1-sec-202 ;
    values:originalText "Once a Communications Access Coordinator, the ACMA or an interception agency receives an IC plan of a carrier or nominated carriage service provider, the Coordinator, the ACMA or the interception agency:  (a) must treat the plan as confidential; and  (b) must ensure that it is not disclosed to any person or body not referred to in this section without the written permission of the carrier or provider.  Chapter 5  Co-operation with agencies" ;
    skos:definition "Once a Communications Access Coordinator, the ACMA or an interception agency receives an IC plan of a carrier or nominated carriage service provider, the Coordinator, the ACMA or the interception agency:  (a) must treat the plan as confidential; and  (b) must ensure that it is not disclosed to any person or body not referred to in this section without the written permission of the carrier or provider.  Chapter 5  Co-operation with agencies"@en ;
    cml:integrityHash "ec4e5d470169eacb4b59d84915b9a1633297cbf4af9f97152a64915a1d948d1e" ;
    cof:pageNumber "53"^^xsd:integer ;
    skos:note "Must treat IC plan as confidential and ensure it is not disclosed without written permission." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.53" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-202-norm .
