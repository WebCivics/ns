concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187d a cml:Concept ;
    skos:prefLabel "187D Effect of data retention implementation plans"@en ;
    cml:realizedBy doc:sch-1-sec-187d ;
    values:originalText "While there is in force a data retention implementation plan for a relevant service operated by a service provider:  (a) the service provider must comply with the plan in relation to communications carried by means of that service; but  (b) the service provider is not required to comply with subsection 187A(1) (or section 187BA or 187C) in relation to those communications." ;
    skos:definition "While there is in force a data retention implementation plan for a relevant service operated by a service provider:  (a) the service provider must comply with the plan in relation to communications carried by means of that service; but  (b) the service provider is not required to comply with subsection 187A(1) (or section 187BA or 187C) in relation to those communications."@en ;
    cml:integrityHash "62ce03ef14c399f33032664537249342d8f26309e8019134bdb776916471e10a" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Comply with data retention implementation plan for communications carried by a service." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
