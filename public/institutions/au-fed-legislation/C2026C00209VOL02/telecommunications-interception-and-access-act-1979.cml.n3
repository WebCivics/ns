doc:sch-1-sec-172-ss-3 a cof:Section ;
    cof:title "172(3) International production order issued in response to a telephone" ;
    values:kind "subsection" ;
    values:originalText "(3) If the issuing person is satisfied that subclause (2) has not been complied with in relation to the order, the issuing person may cancel the order." ;
