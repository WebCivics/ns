concept:telecommunications-interception-and-access-act-1979-sch-1-sec-50 a cml:Concept ;
    skos:prefLabel "50 Issue of further international production order"@en ;
    cml:realizedBy doc:sch-1-sec-50 ;
    values:originalText "If:  (a) an international production order (the original order) was issued under clause 48; and  (b) the original order was directed to a prescribed communications provider; and  (c) the original order relates to the investigation by an enforcement agency of a serious category 1 offence, or serious category 1 offences; this Schedule does not prevent the issue of a further international production order under clause 48 that:  (d) is directed to the provider; and  (e) relates to the investigation by the enforcement agency of that offence or those offences.  Schedule 1  International production orders" ;
    skos:definition "If:  (a) an international production order (the original order) was issued under clause 48; and  (b) the original order was directed to a prescribed communications provider; and  (c) the original order relates to the investigation by an enforcement agency of a serious category 1 offence, or serious category 1 offences; this Schedule does not prevent the issue of a further international production order under clause 48 that:  (d) is directed to the provider; and  (e) relates to the investigation by the enforcement agency of that offence or those offences.  Schedule 1  International production orders"@en ;
    cml:integrityHash "7e117fa9c9aab49a458ef29415a420dc3c2f7bc5d3bf3de2041eb5d11a54d66a" ;
    cof:pageNumber "135"^^xsd:integer ;
    skos:note "Issue of further international production order under certain conditions." ;
    cml:curationStatus cml:Proposed ;
