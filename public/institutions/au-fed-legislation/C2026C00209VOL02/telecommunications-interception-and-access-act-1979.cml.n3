concept:telecommunications-interception-and-access-act-1979-sch-1-sec-153 a cml:Concept ;
    skos:prefLabel "153 Exceptions—general"@en ;
    cml:realizedBy doc:sch-1-sec-153 ;
    values:originalText "(1) Protected information may be used, recorded or disclosed, or may be admitted in evidence, for any of the following purposes:  (a) the investigation of a serious category 1 offence or a serious category 2 offence or the making of a report on the outcome of such an investigation;  (b) the making of a decision whether or not to bring a prosecution for a serious category 1 offence or a serious category 2 offence (other than an offence referred to in paragraph (r));  Schedule 1  International production orders" ;
    skos:definition "(1) Protected information may be used, recorded or disclosed, or may be admitted in evidence, for any of the following purposes:  (a) the investigation of a serious category 1 offence or a serious category 2 offence or the making of a report on the outcome of such an investigation;  (b) the making of a decision whether or not to bring a prosecution for a serious category 1 offence or a serious category 2 offence (other than an offence referred to in paragraph (r));  Schedule 1  International production orders"@en ;
    cml:integrityHash "706a02a8e905c29448257647e5e127d8cecc54cf19e9272f986caeddb1ef7df4" ;
    cof:pageNumber "263"^^xsd:integer ;
    skos:note "Protected information may be used for specific purposes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.263" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-153-norm .
