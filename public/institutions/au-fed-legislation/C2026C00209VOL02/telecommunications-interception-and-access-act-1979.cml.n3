concept:telecommunications-interception-and-access-act-1979-sch-1-sec-44 a cml:Concept ;
    skos:prefLabel "44 Contents of written application"@en ;
    cml:realizedBy doc:sch-1-sec-44 ;
    values:originalText "An application under clause 42 must, if it is in writing, set out:  (a) the name of the enforcement agency; and  (b) the name of the person making the application on the agency’s behalf." ;
