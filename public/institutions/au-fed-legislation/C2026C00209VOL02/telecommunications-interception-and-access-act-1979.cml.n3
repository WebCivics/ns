concept:telecommunications-interception-and-access-act-1979-sch-1-sec-156 a cml:Concept ;
    skos:prefLabel "156 Exception—statistical information"@en ;
    cml:realizedBy doc:sch-1-sec-156 ;
    values:originalText "A prescribed communications provider may disclose the total number of international production orders given to the provider during a period of at least 6 months. Note: This clause authorises the disclosure of aggregate statistical information. That information cannot be broken down: (a) by agency; or (b) in any other way." ;
    skos:definition "A prescribed communications provider may disclose the total number of international production orders given to the provider during a period of at least 6 months. Note: This clause authorises the disclosure of aggregate statistical information. That information cannot be broken down: (a) by agency; or (b) in any other way."@en ;
    cml:integrityHash "a334c11723d9232dfec82db7610fcf62647556fb02aedf7d0b5d3101a5361c4c" ;
    cof:pageNumber "268"^^xsd:integer ;
    skos:note "Disclosure of aggregate statistical information is permitted." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
