concept:telecommunications-interception-and-access-act-1979-sch-1-sec-54 a cml:Concept ;
    skos:prefLabel "54 Contents of application"@en ;
    cml:realizedBy doc:sch-1-sec-54 ;
    values:originalText "A written application under clause 52 by a Part 5.3 IPO agency for an international production order must set out:  (a) the name of the agency; and  (b) the name of the person making the application on the agency’s behalf." ;
    skos:definition "A written application under clause 52 by a Part 5.3 IPO agency for an international production order must set out:  (a) the name of the agency; and  (b) the name of the person making the application on the agency’s behalf."@en ;
