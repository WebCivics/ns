concept:telecommunications-interception-and-access-act-1979-sch-1-sec-200 a cml:Concept ;
    skos:prefLabel "200 Compliance with IC plans"@en ;
    cml:realizedBy doc:sch-1-sec-200 ;
    values:originalText "During the period that an IC plan of a carrier or nominated carriage service provider is in force, the carrier or provider must ensure that its business activities are consistent with the plan." ;
    skos:definition "During the period that an IC plan of a carrier or nominated carriage service provider is in force, the carrier or provider must ensure that its business activities are consistent with the plan."@en ;
    cml:integrityHash "e7900f01dc6c12bc34ca21bbda66f4b2ed3f371352d3e903caa10e647482b9ea" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "Ensure business activities are consistent with IC plan" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-act-1979.pdf> ;
    dc:source "telecommunications-interception-and-access-act-1979.pdf, p.52" ;
    cml:asserts concept:telecommunications-interception-and-access-act-1979-sch-1-sec-200-norm .
