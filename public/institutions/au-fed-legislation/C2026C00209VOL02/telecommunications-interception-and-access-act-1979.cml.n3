doc:sch-1-sec-298-ss-2 a cof:Section ;
    cof:title "298(2) Protection of persons—control order declared to be void" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply to a thing done, or omitted to be done, at a particular time if, at that time, the person knew, or ought reasonably to have known, of the declaration." ;
    cof:pageNumber "65"^^xsd:integer .

