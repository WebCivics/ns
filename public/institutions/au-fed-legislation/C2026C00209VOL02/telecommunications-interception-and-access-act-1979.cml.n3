    skos:prefLabel "58 Application by Part 5.3 IPO agency of Victoria"@en ;
    cml:realizedBy doc:sch-1-sec-58 ;
    values:originalText "Scope  (1) This clause applies if a Part 5.3 IPO agency of Victoria applies, under clause 52, to an eligible Judge or nominated ART member for an international production order under clause 60 that is in respect of:  Schedule 1  International production orders" ;
