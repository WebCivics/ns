concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187b-ss-6 a cml:Concept ;
    skos:prefLabel "187B(6) Certain service providers not covered by this Part"@en ;
    cml:realizedBy doc:sch-1-sec-187b-ss-6 ;
