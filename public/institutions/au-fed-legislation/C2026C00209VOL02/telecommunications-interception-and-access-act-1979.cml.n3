concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187b-ss-2 a cml:Concept ;
    skos:prefLabel "187B(2) Certain service providers not covered by this Part"@en ;
    cml:realizedBy doc:sch-1-sec-187b-ss-2 ;
