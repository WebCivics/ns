concept:telecommunications-interception-and-access-act-1979-sch-1-sec-55 a cml:Concept ;
    skos:prefLabel "55 Affidavits to accompany written application"@en ;
    cml:realizedBy doc:sch-1-sec-55 ;
    values:originalText "(1) A written application under clause 52 by a Part 5.3 IPO agency for an international production order must be accompanied by an affidavit complying with this clause.  Schedule 1  International production orders" ;
