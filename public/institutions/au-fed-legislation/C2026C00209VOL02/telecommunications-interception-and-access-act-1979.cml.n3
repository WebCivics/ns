concept:telecommunications-interception-and-access-act-1979-sch-1-sec-170 a cml:Concept ;
    skos:prefLabel "170 Simplified outline of this Part"@en ;
    cml:realizedBy doc:sch-1-sec-170 ;
    values:originalText "• This Part deals with miscellaneous matters, such as:  (a) electronic service of documents; and  (b) certified copies of international production orders; and  (c) delegations." ;
