concept:telecommunications-interception-and-access-act-1979-sch-1-sec-102 a cml:Concept ;
    skos:prefLabel "102 Form of application"@en ;
    cml:realizedBy doc:sch-1-sec-102 ;
    values:originalText "(1) An application under clause 101 must be in writing.  (2) If the person making an application under clause 101 for an international production order on the Organisation’s behalf thinks it necessary, because of urgent circumstances, to make the application by telephone, the person may make the application by telephone.  Schedule 1  International production orders" ;
    skos:definition "(1) An application under clause 101 must be in writing.  (2) If the person making an application under clause 101 for an international production order on the Organisation’s behalf thinks it necessary, because of urgent circumstances, to make the application by telephone, the person may make the application by telephone.  Schedule 1  International production orders"@en ;
    cml:integrityHash "d31cb89263da4a2b9148d14e2e64e13b3fbfc8733ccf18974a8c75bec6275da6" ;
    cof:pageNumber "203"^^xsd:integer ;
