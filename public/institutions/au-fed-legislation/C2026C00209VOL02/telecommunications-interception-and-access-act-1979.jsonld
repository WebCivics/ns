        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-149-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "Obligation implies duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman is not liable to an action for acts done in good faith.",
      "cml:conclusionText": "If the Ombudsman does not act in good faith, then they are liable to an action."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-149-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Entails",
      "cml:logicSummary": "Obligation entails duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman's obligation implies their duty.",
      "cml:conclusionText": "If the Ombudsman has an obligation, then they must perform their duty."
    },
    {
