    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-142",
      "@type": "cml:Concept",
      "skos:prefLabel": "142 Inspection of records—relevant agency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-142"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
