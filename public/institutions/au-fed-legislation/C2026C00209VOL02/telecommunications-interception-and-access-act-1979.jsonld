    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "3B Statutory requirements certificate—designated international",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-3b"
      },
      "cml:curationStatus": {
