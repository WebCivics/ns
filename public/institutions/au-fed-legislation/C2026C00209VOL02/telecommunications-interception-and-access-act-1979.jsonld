      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-118",
      "@type": "cml:Concept",
      "skos:prefLabel": "118 Delegation by the chief officer of a relevant agency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-118"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
