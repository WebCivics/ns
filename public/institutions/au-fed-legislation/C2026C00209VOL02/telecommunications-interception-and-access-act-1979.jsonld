      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "Inform relevant agencies or Organisation of cancellation"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-3-logic-deontic-2",
