    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-99-ss-4",
      "@type": "cof:Section",
      "cof:title": "99(4) Content of international production order",
      "values:kind": "subsection",
      "cof:pageNumber": 201,
      "values:originalText": "(4) If the order directs a prescribed communications provider to make\na copy of stored communications available to the Organisation, the\norder may require the provider to make that copy available to the\nOrganisation in a specified way."
    },
