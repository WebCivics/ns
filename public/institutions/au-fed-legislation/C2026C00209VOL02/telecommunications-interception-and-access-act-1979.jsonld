      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-177"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
