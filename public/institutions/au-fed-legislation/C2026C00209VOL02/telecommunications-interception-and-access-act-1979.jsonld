    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-152-ss-1",
      "@type": "cof:Section",
      "cof:title": "152(1) Prohibition on use, recording or disclosure of protected",
      "values:kind": "subsection",
      "cof:pageNumber": 263,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person uses, records or discloses information; and\n\n(b) the information is protected information; and\n\n(c) the use, recording or disclosure of the information is not\npermitted by this Part.\nPenalty: Imprisonment for 2 years."
    },
