    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-103",
      "@type": "cml:Concept",
      "skos:prefLabel": "103 Contents of written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-103"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.204",
      "values:originalText": "An application under clause 101 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.",
      "skos:definition": "An application under clause 101 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-103-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-103-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4b445d15b198032cf966d43d72f536d8e73fdbc46e21a2090a9e5e2c4b8de799",
      "skos:note": "Application must provide Organisation's name and person making application on behalf of the organisation.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-103",
      "@type": "cof:Section",
      "cof:title": "103 Contents of written application",
      "values:kind": "section",
      "cof:pageNumber": 204,
      "values:originalText": "An application under clause 101 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf."
    },
