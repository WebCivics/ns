    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-85",
      "@type": "cml:Concept",
      "skos:prefLabel": "85 Contents of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-85"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.180",
      "values:originalText": "A written application under clause 83 for an international\nproduction order must set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.\n\nInternational production orders  Schedule 1\nInternational production orders relating to national security  Part 4\nInternational production orders relating to interception: national security  Division 2\n\nClause 86\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "A written application under clause 83 for an international\nproduction order must set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.\n\nInternational production orders  Schedule 1\nInternational production orders relating to national security  Part 4\nInternational production orders relating to interception: national security  Division 2\n\nClause 86\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-85-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-85-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "627fafd2dcff0d4d42084ff14afa1e0062ea9411874b88f28c6d5924ce35f894",
      "skos:note": "Application must provide organization name and representative's name.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-85",
      "@type": "cof:Section",
      "cof:title": "85 Contents of application",
      "values:kind": "section",
      "cof:pageNumber": 180,
      "values:originalText": "A written application under clause 83 for an international\nproduction order must set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.\n\nInternational production orders  Schedule 1\nInternational production orders relating to national security  Part 4\nInternational production orders relating to interception: national security  Division 2\n\nClause 86\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
