          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-77-ss-2"
        }
      ],
      "cml:integrityHash": "5f26f23002d943b41608b1258cc9ef38e2c6daf6fc88b63b9eab2c382cb4d197"
    },
