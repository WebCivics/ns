      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "(a) the number of previous applications (if any) for international\nproduction orders that the Organisation has made under clause 83 in relation to those individual message/call\napplication services;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-86-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval of previous applications and international production orders",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the number of international production orders (if any)\npreviously issued in response to such applications;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-86-ss-4-logic-ltl-3",
