    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-27-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "27(2) Giving further information to eligible Judge or nominated ART",
      "cml:realizedBy": {
