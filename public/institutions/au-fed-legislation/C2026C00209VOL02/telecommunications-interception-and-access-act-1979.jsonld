      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits cancellation of international production orders",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The Australian Designated Authority may cancel an international\nproduction order.",
      "cml:conclusionText": "The Australian Designated Authority must not cancel an international production order."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-1-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Imply",
      "cml:logicSummary": "Implies that cancellation of international production orders is a prohibition",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The Australian Designated Authority may cancel an international\nproduction order.",
      "cml:conclusionText": "Cancellation of international production orders implies a prohibition"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-1-logic-deontic-3",
