    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.117",
      "values:originalText": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 30; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\n\nSchedule 1  International production orders",
      "skos:definition": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 30; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-32-norm"
        }
      ],
      "cml:integrityHash": "b564fc29f4062eda8d722839f9820abb4d3cb0956593c49eefdfb677b1fe1282",
      "skos:note": "Issue of further international production order"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 117,
      "values:originalText": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 30; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-32-norm",
