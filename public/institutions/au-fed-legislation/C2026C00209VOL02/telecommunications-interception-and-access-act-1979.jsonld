          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-166-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-166-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6a1b3fd5cc128a9316c0d4459cad639807d464b1982d9115047476bf050e8ada",
      "skos:note": "Issue a written certificate with relevant facts about the copy",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-166-ss-3",
