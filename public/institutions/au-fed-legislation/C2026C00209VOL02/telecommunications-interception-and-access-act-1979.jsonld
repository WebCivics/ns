        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-171-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "47b4c0b8774e90ae5198bd826ec9db2ba051df4aacf958ced62d317605b754d7",
      "skos:note": "Requirement to provide international production orders to the Australian Designated Authority",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-171-ss-2",
      "@type": "cof:Section",
      "cof:title": "171(2) Electronic service of documents",
      "values:kind": "subsection",
      "cof:pageNumber": 299,
      "values:originalText": "(2) If:\n\n(a) any of the following is required by this Schedule to be given\nto the Australian Designated Authority by a person, a\nrelevant agency or the Organisation:\n\n(i) an international production order;\n\n(ii) a certified copy of an international production order;\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-171-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-171-ss-2"
      },
      "values:deonticStatus": {
