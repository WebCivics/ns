    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Giving further information to issuing authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-38"
