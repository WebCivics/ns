    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-3a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "3A(5) Disallowance of regulations relating to designated international",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-3a-ss-5"
      },
