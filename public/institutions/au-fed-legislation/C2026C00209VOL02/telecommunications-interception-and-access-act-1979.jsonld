    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Affidavits to accompany written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.168",
      "values:originalText": "(1) An application under clause 72 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "skos:definition": "(1) An application under clause 72 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-75-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-75-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-75-ss-3"
        }
      ],
      "cml:integrityHash": "c6bd415a3161fb609d526a08891d9a87c59d7694a5f4e4d4f674828df13a0d44"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Affidavits to accompany written application",
      "values:kind": "section",
      "cof:pageNumber": 168,
      "values:originalText": "(1) An application under clause 72 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out."
    },
