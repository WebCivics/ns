        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) If...",
      "cml:conclusionText": "the Australian Designated Authority must:"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-173",
      "@type": "cml:Concept",
      "skos:prefLabel": "173 Duty of nominated ART Intelligence and Security member",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-173"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.302",
      "values:originalText": "It is the duty of a nominated ART Intelligence and Security\nmember to ensure, so far as the member is able to do so, that, in or\nin connection with the performance of a function, or the exercise of\na power, conferred on the member by this Schedule, information is\nnot communicated or made available to a person contrary to the\nrequirements of security (within the ordinary meaning of that\nexpression).",
      "skos:definition": "It is the duty of a nominated ART Intelligence and Security\nmember to ensure, so far as the member is able to do so, that, in or\nin connection with the performance of a function, or the exercise of\na power, conferred on the member by this Schedule, information is\nnot communicated or made available to a person contrary to the\nrequirements of security (within the ordinary meaning of that\nexpression).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-173-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-173-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "474ae0d3e2e27f559a96963f5f3d985b4068a1b7c11027ab2d67c5603a5fdfa7",
      "skos:note": "Duty to ensure information security"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-173",
      "@type": "cof:Section",
      "cof:title": "173 Duty of nominated ART Intelligence and Security member",
      "values:kind": "section",
      "cof:pageNumber": 302,
      "values:originalText": "It is the duty of a nominated ART Intelligence and Security\nmember to ensure, so far as the member is able to do so, that, in or\nin connection with the performance of a function, or the exercise of\na power, conferred on the member by this Schedule, information is\nnot communicated or made available to a person contrary to the\nrequirements of security (within the ordinary meaning of that\nexpression)."
    },
