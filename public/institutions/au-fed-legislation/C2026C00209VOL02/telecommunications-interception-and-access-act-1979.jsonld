    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-40-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "40(4) Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-40-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.126",
      "values:originalText": "(4) If the order directs a prescribed communications provider to make\na copy of stored communications available to the criminal\nlaw-enforcement agency, the order may require the provider to\nmake that copy available to the agency in a specified way.",
      "skos:definition": "(4) If the order directs a prescribed communications provider to make\na copy of stored communications available to the criminal\nlaw-enforcement agency, the order may require the provider to\nmake that copy available to the agency in a specified way.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-40"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-40-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-40-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fc96004c139249503e5c044c5160e567835b93c28e06a55af272b0093b5611d0",
      "skos:note": "Prescribed communications provider must make copy of stored communications available to agency in specified way.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-40-ss-4",
      "@type": "cof:Section",
      "cof:title": "40(4) Content of international production order",
      "values:kind": "subsection",
      "cof:pageNumber": 126,
      "values:originalText": "(4) If the order directs a prescribed communications provider to make\na copy of stored communications available to the criminal\nlaw-enforcement agency, the order may require the provider to\nmake that copy available to the agency in a specified way."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-40-ss-4-norm",
