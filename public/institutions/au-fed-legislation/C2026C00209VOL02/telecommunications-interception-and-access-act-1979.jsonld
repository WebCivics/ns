    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-70-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "70(5) Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-70-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
