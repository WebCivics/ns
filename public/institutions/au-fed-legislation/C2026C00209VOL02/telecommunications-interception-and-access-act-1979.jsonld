        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-132-ss-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-132-ss-2-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-132-ss-2-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-132-ss-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "f124a0cb33b6922501bd5154d3aaf3f4deee0383358ddc59b2191b1ad9468c40",
      "skos:note": "Minister must advise not to include information in report if chief officer satisfies certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-132-ss-2",
      "@type": "cof:Section",
      "cof:title": "132(2) Deferral of inclusion of information in Ministerial report",
      "values:kind": "subsection",
      "cof:pageNumber": 232,
      "values:originalText": "(2) If:\n\n(a) subparagraph (1)(a)(i) applies; and\n\n(b) the chief officer of the relevant agency is satisfied that the\ninformation is Part 5.3 information;\nthe chief officer must advise the Minister in writing not to include\nthe information in the next Ministerial report."
    },
