    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-91",
      "@type": "cml:Concept",
      "skos:prefLabel": "91 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-91"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.191",
      "values:originalText": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 89; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 89 that is:\n\n(d) in respect of any or all of those services; and\n\n(e) directed to the provider;\nso long as the period specified in the further order for the purposes\nof subparagraph 89(2)(i)(i) of this Schedule begins after the end of\n\nSchedule 1  International production orders",
      "skos:definition": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 89; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 89 that is:\n\n(d) in respect of any or all of those services; and\n\n(e) directed to the provider;\nso long as the period specified in the further order for the purposes\nof subparagraph 89(2)(i)(i) of this Schedule begins after the end of\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-91-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-91-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "21b9ea8f44063f86f788fc7cb5e99f7e1de29a2404a006ca9d6e44b158b211e0",
      "skos:note": "Issue of further international production order is permitted under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-91",
      "@type": "cof:Section",
      "cof:title": "91 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 191,
      "values:originalText": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 89; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 89 that is:\n\n(d) in respect of any or all of those services; and\n\n(e) directed to the provider;\nso long as the period specified in the further order for the purposes\nof subparagraph 89(2)(i)(i) of this Schedule begins after the end of\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-91-norm",
      "@type": "values:Permission",
      "cml:modality": {
