    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-80",
      "@type": "cml:Concept",
      "skos:prefLabel": "80 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-80"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.174",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 78; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 78 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nInternational production orders  Schedule 1\nInternational production orders relating to Part 5.3 supervisory orders  Part 3\nNotification to Ombudsman or the Inspector-General of Intelligence and Security by",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 78; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 78 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nInternational production orders  Schedule 1\nInternational production orders relating to Part 5.3 supervisory orders  Part 3\nNotification to Ombudsman or the Inspector-General of Intelligence and Security by",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-80-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-80-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-80-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "91bbad84999859b1ecf24ab517697e4d21c567a34a5e6215460aaecd1df0cff9",
      "skos:note": "Issue of further international production order under clause 78 that is in respect of the person and directed to the provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-80",
      "@type": "cof:Section",
      "cof:title": "80 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 174,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 78; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 78 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nInternational production orders  Schedule 1\nInternational production orders relating to Part 5.3 supervisory orders  Part 3\nNotification to Ombudsman or the Inspector-General of Intelligence and Security by"
    },
    {
