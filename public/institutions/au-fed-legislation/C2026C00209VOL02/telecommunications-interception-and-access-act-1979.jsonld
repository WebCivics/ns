          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-200-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-200-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7900f01dc6c12bc34ca21bbda66f4b2ed3f371352d3e903caa10e647482b9ea",
      "skos:note": "Ensure business activities are consistent with IC plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-200",
      "@type": "cof:Section",
      "cof:title": "200 Compliance with IC plans",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "During the period that an IC plan of a carrier or nominated carriage\nservice provider is in force, the carrier or provider must ensure that\nits business activities are consistent with the plan."
    },
