    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Affidavits to accompany written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.129",
      "values:originalText": "(1) An application under clause 42 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "skos:definition": "(1) An application under clause 42 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-45-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-45-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-45-ss-3"
        }
      ],
      "cml:integrityHash": "62fe77291779e95d5174b13a76c773759e13975c0c7c7b13842f77e15967fc41"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Affidavits to accompany written application",
      "values:kind": "section",
      "cof:pageNumber": 129,
      "values:originalText": "(1) An application under clause 42 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out."
    },
