    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-156",
      "@type": "cml:Concept",
      "skos:prefLabel": "156 Exception—statistical information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-156"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.268",
      "values:originalText": "A prescribed communications provider may disclose the total\nnumber of international production orders given to the provider\nduring a period of at least 6 months.\nNote:\nThis clause authorises the disclosure of aggregate statistical\ninformation. That information cannot be broken down:\n(a) by agency; or\n(b) in any other way.",
      "skos:definition": "A prescribed communications provider may disclose the total\nnumber of international production orders given to the provider\nduring a period of at least 6 months.\nNote:\nThis clause authorises the disclosure of aggregate statistical\ninformation. That information cannot be broken down:\n(a) by agency; or\n(b) in any other way.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-156-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-156-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a334c11723d9232dfec82db7610fcf62647556fb02aedf7d0b5d3101a5361c4c",
      "skos:note": "Disclosure of aggregate statistical information is permitted."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-156",
      "@type": "cof:Section",
      "cof:title": "156 Exception—statistical information",
      "values:kind": "section",
      "cof:pageNumber": 268,
      "values:originalText": "A prescribed communications provider may disclose the total\nnumber of international production orders given to the provider\nduring a period of at least 6 months.\nNote:\nThis clause authorises the disclosure of aggregate statistical\ninformation. That information cannot be broken down:\n(a) by agency; or\n(b) in any other way."
    },
