      "@type": "cof:Section",
      "cof:title": "154 Exception—disclosure to the Minister",
      "values:kind": "section",
      "cof:pageNumber": 267,
      "values:originalText": "Protected information may be disclosed to the Minister for the\npurposes of the performance of the functions, or the exercise of the\npowers, of the Minister.\n\nSchedule 1  International production orders"
    },
