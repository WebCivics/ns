      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Giving further information to eligible Judge or nominated ART",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.105",
      "values:originalText": "member\n\n(1) An eligible Judge or nominated ART member may require further\ninformation to be given in connection with an application under\nclause 22 to the eligible Judge or nominated ART member for an\ninternational production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the eligible Judge or\nnominated ART member directs.\n\nSchedule 1  International production orders",
      "skos:definition": "member\n\n(1) An eligible Judge or nominated ART member may require further\ninformation to be given in connection with an application under\nclause 22 to the eligible Judge or nominated ART member for an\ninternational production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the eligible Judge or\nnominated ART member directs.\n\nSchedule 1  International production orders",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-27-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-27-ss-2"
        }
      ],
      "cml:integrityHash": "e31ab643c44f7a0ec824b59d1194d60dac334200d845e61d2d289daa0f087ea4"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Giving further information to eligible Judge or nominated ART",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "member\n\n(1) An eligible Judge or nominated ART member may require further\ninformation to be given in connection with an application under\nclause 22 to the eligible Judge or nominated ART member for an\ninternational production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the eligible Judge or\nnominated ART member directs.\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-27-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "27(1) Giving further information to eligible Judge or nominated ART",
      "cml:realizedBy": {
