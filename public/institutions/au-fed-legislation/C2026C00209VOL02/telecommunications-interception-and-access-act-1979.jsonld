      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-208",
      "@type": "cml:Concept",
      "skos:prefLabel": "208 Costs to be borne by the interception agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-208"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.61",
      "values:originalText": "The capital and ongoing costs, worked out in accordance with\nsection 209, of developing, installing and maintaining a delivery\ncapability imposed on a carrier under Part 5-5 in respect of a\nparticular kind of telecommunications service are to be borne by\nthe interception agency concerned.\nNote:\nThe definition of carrier in subsection 5(1) includes carriage service\nproviders.",
      "skos:definition": "The capital and ongoing costs, worked out in accordance with\nsection 209, of developing, installing and maintaining a delivery\ncapability imposed on a carrier under Part 5-5 in respect of a\nparticular kind of telecommunications service are to be borne by\nthe interception agency concerned.\nNote:\nThe definition of carrier in subsection 5(1) includes carriage service\nproviders.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-208-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-208-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-208-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "c1c0686aa5522aaeeef04e890f5431fa9fd2fead4657fda4b3a0f0ccfc3f5b34",
      "skos:note": "Interception agencies bear capital and ongoing costs of developing a delivery capability."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-208",
      "@type": "cof:Section",
      "cof:title": "208 Costs to be borne by the interception agencies",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "The capital and ongoing costs, worked out in accordance with\nsection 209, of developing, installing and maintaining a delivery\ncapability imposed on a carrier under Part 5-5 in respect of a\nparticular kind of telecommunications service are to be borne by\nthe interception agency concerned.\nNote:\nThe definition of carrier in subsection 5(1) includes carriage service\nproviders."
    },
