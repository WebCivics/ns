        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Permission granted under specific conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the original order was in respect of a particular person",
      "cml:conclusionText": "issue of further international production order is permitted"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Conditions overlap with the original order.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the original order was in respect of a particular person and the original order was directed to a prescribed communications provider",
      "cml:conclusionText": "issue of further international production order overlaps with the original order"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Conditions are until the original order expires.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the original order was in respect of a particular person and the original order was directed to a prescribed communications provider",
      "cml:conclusionText": "issue of further international production order is permitted until the original order expires"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Conditions diffuse through the system.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the original order was in respect of a particular person and the original order was directed to a prescribed communications provider",
      "cml:conclusionText": "issue of further international production order diffuses through the system under these conditions"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "Conditions are recognized by the AI.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the original order was in respect of a particular person and the original order was directed to a prescribed communications provider",
      "cml:conclusionText": "issue of further international production order is recognized under these conditions"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Application for international production order—enforcement of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.128",
      "values:originalText": "the criminal law\n\n(1) An enforcement agency may apply to an issuing authority for an\ninternational production order under clause 48 that is directed to a\nprescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the enforcement agency’s behalf\nby an authorised officer of the agency.",
      "skos:definition": "the criminal law\n\n(1) An enforcement agency may apply to an issuing authority for an\ninternational production order under clause 48 that is directed to a\nprescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the enforcement agency’s behalf\nby an authorised officer of the agency.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-42-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-42-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-42-ss-3"
        }
      ],
      "cml:integrityHash": "89a1420b145908bae01e953e6f597567f43eb5d11b77ff56043c7b3042a442dd"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Application for international production order—enforcement of",
      "values:kind": "section",
      "cof:pageNumber": 128,
      "values:originalText": "the criminal law\n\n(1) An enforcement agency may apply to an issuing authority for an\ninternational production order under clause 48 that is directed to a\nprescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the enforcement agency’s behalf\nby an authorised officer of the agency."
    },
