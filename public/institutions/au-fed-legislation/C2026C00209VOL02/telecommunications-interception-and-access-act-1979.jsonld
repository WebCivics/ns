    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-300",
      "@type": "cml:Concept",
      "skos:prefLabel": "300 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-300"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.67",
      "values:originalText": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing matters:\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\nSchedule 1  International production orders",
      "skos:definition": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing matters:\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-300-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-300-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5a7789a6758afd9f82e82899ec216b414e44bf137d7a7ab9c16c49c165cbd016",
      "skos:note": "May make regulations not inconsistent with the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-300",
      "@type": "cof:Section",
      "cof:title": "300 Regulations",
      "values:kind": "section",
      "cof:pageNumber": 67,
      "values:originalText": "The Governor-General may make regulations, not inconsistent with\nthis Act, prescribing matters:\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\nSchedule 1  International production orders"
    },
