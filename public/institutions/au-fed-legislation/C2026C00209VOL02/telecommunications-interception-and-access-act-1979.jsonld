          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-119-ss-2"
        }
      ],
      "cml:integrityHash": "97465cd66861b8ca8f0969f8de7e99dd6b7f2fe6ad98b17f096bb2ca7cc1bc3f"
    },
