      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.168",
      "values:originalText": "An application under clause 72 must, if it is in writing, set out:\n\n(a) the name of the Part 5.3 IPO agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.",
      "skos:definition": "An application under clause 72 must, if it is in writing, set out:\n\n(a) the name of the Part 5.3 IPO agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-74-norm"
        },
