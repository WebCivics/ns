    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-102",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Form of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-102"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.203",
      "values:originalText": "(1) An application under clause 101 must be in writing.\n\n(2) If the person making an application under clause 101 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\n\nSchedule 1  International production orders",
      "skos:definition": "(1) An application under clause 101 must be in writing.\n\n(2) If the person making an application under clause 101 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\n\nSchedule 1  International production orders",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-102-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-102-ss-2"
        }
      ],
      "cml:integrityHash": "d31cb89263da4a2b9148d14e2e64e13b3fbfc8733ccf18974a8c75bec6275da6"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-102",
      "@type": "cof:Section",
      "cof:title": "102 Form of application",
      "values:kind": "section",
      "cof:pageNumber": 203,
      "values:originalText": "(1) An application under clause 101 must be in writing.\n\n(2) If the person making an application under clause 101 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\n\nSchedule 1  International production orders"
    },
