      "cml:integrityHash": "9bff374cfc923381bd7acf9d658ed369a7e7e601a56d2bfe5ca6f19b843c589d",
      "skos:note": "Authorises persons for the purposes of subclause (2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-34-ss-3",
      "@type": "cof:Section",
      "cof:title": "34(3) Form of application",
      "values:kind": "subsection",
      "cof:pageNumber": 120,
      "values:originalText": "(3) The chief officer of a criminal law-enforcement agency may, in\nwriting, authorise persons (including classes of persons) for the\npurposes of subclause (2). However, each person must be entitled\nunder clause 33 to make applications on the agency’s behalf."
    },
