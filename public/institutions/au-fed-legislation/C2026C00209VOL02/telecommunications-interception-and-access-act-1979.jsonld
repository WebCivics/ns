      ],
      "cml:integrityHash": "76a866c9970ba9da70301da61b3c27b58fc31f91793bacf1f2648cb90fa54861",
      "skos:note": "Application must provide agency name and applicant name.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-74",
      "@type": "cof:Section",
      "cof:title": "74 Contents of written application",
      "values:kind": "section",
      "cof:pageNumber": 168,
      "values:originalText": "An application under clause 72 must, if it is in writing, set out:\n\n(a) the name of the Part 5.3 IPO agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf."
    },
