          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-138-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "5648db54cb6226796ff9e558f0a4d44ec35ef0156b8ddf9e6174b72f35124b6a",
      "skos:note": "The Australian Designated Authority must keep certain records.",
