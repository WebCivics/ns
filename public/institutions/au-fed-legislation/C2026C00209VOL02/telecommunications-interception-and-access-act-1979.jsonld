      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide instrument of cancellation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "122(5) Cancellation of international production orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-122-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.222",
      "values:originalText": "(5) A cancellation under subclause (1) takes effect:\n\n(a) if the instrument of cancellation is required to be given to the\nprescribed communications provider concerned—when the\ninstrument is given; or\n\n(b) otherwise—when the cancellation is made.",
      "skos:definition": "(5) A cancellation under subclause (1) takes effect:\n\n(a) if the instrument of cancellation is required to be given to the\nprescribed communications provider concerned—when the\ninstrument is given; or\n\n(b) otherwise—when the cancellation is made.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-5-norm"
        }
      ],
      "cml:integrityHash": "0da094372120e9711d49e62aab7e71418ca6f4d2418804d1007f26d8eaa5093e",
      "skos:note": "Cancellation takes effect upon instrument of cancellation being given or made."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-122-ss-5",
      "@type": "cof:Section",
      "cof:title": "122(5) Cancellation of international production orders",
      "values:kind": "subsection",
      "cof:pageNumber": 222,
      "values:originalText": "(5) A cancellation under subclause (1) takes effect:\n\n(a) if the instrument of cancellation is required to be given to the\nprescribed communications provider concerned—when the\ninstrument is given; or\n\n(b) otherwise—when the cancellation is made."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-122-ss-5-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
