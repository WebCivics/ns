      "@type": "cml:Concept",
      "skos:prefLabel": "40(6) Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-40-ss-6"
