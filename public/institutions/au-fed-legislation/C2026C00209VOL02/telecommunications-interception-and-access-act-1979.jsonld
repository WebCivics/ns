      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-208-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Interception agencies have an obligation to bear costs.",
      "cml:executionSurface": "modalities::logic::deontic",
