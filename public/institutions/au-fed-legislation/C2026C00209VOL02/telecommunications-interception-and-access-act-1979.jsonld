    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.189",
      "values:originalText": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 89.\nContent\n\n(2) The order must be signed by the nominated ART Intelligence and\nSecurity member who issued it.\n\n(3) The order must set out the following:\n\n(a) the date on which the order was issued;\n\nSchedule 1  International production orders",
      "skos:definition": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 89.\nContent\n\n(2) The order must be signed by the nominated ART Intelligence and\nSecurity member who issued it.\n\n(3) The order must set out the following:\n\n(a) the date on which the order was issued;\n\nSchedule 1  International production orders",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-90-ss-1"
        },
