      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Minister has a duty to notify chief officer in writing.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
