    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-164-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "164(4) Evidentiary certificates—stored communications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-164-ss-4"
      },
