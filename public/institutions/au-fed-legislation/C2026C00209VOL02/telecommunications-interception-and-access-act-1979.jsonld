        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-195-ss-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "92c6db1f1c3d4e53da5ed82c70c01aa6600564dc797874d1000bc93f45ffac81",
      "skos:note": "Carrier or provider must set out policies and strategies for interception capabilities.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-195-ss-2",
      "@type": "cof:Section",
