      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-98-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits storing communications",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) there are reasonable grounds for suspecting that the relevant person is engaged in, or is likely to engage in, activities prejudicial to security;",
      "cml:conclusionText": "The prescribed communications provider must not store such communications."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-98-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Defines temporal interval for prohibition",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) there are reasonable grounds for suspecting that the relevant person is engaged in, or is likely to engage in, activities prejudicial to security;",
      "cml:conclusionText": "The prohibition applies during the relevant period."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-98-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Defines temporal interval for prohibition",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) there are reasonable grounds for suspecting that the prescribed communications provider holds any of the following stored communications:",
      "cml:conclusionText": "The prohibition applies until the relevant period."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-98-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if",
      "cml:logicSummary": "Defines condition for prohibition",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) there are reasonable grounds for suspecting that the relevant person is engaged in, or is likely to engage in, activities prejudicial to security;",
      "cml:conclusionText": "The prohibition applies if the conditions are met."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-98-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
