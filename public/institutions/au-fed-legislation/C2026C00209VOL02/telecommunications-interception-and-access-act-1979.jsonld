      "cml:operator": "RECURSIVE",
      "cml:logicSummary": "Recurring trace of previous applications and international production orders",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the number of international production orders (if any)\npreviously issued in response to such applications;"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-86-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
