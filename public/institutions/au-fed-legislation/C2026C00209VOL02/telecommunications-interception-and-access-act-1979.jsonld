    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-69",
      "@type": "cml:Concept",
      "skos:prefLabel": "69 Issue of international production order—Part 5.3 supervisory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-69"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
