    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-207",
      "@type": "cml:Concept",
      "skos:prefLabel": "207 Costs to be borne by the carriers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-207"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
