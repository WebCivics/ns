    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-199",
      "@type": "cml:Concept",
      "skos:prefLabel": "199 Commencement of IC plans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-199"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.52",
      "values:originalText": "An IC plan of a carrier or nominated carriage service provider:\n\n(a) comes into force on the day the carrier or provider is notified\nby a Communications Access Coordinator that the plan has\nbeen approved; and\n\n(b) continues in force until the day the carrier or provider is\nnotified by a Communications Access Coordinator that\nanother IC plan of the carrier or provider has been approved.",
      "skos:definition": "An IC plan of a carrier or nominated carriage service provider:\n\n(a) comes into force on the day the carrier or provider is notified\nby a Communications Access Coordinator that the plan has\nbeen approved; and\n\n(b) continues in force until the day the carrier or provider is\nnotified by a Communications Access Coordinator that\nanother IC plan of the carrier or provider has been approved.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-199-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-199-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "19ecc40086e58acdd892d01bbefeb46409acaedf4c2f26a11e725748df8a17a2",
      "skos:note": "IC plan comes into force on approval and continues until another approved plan is notified."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-199",
      "@type": "cof:Section",
      "cof:title": "199 Commencement of IC plans",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "An IC plan of a carrier or nominated carriage service provider:\n\n(a) comes into force on the day the carrier or provider is notified\nby a Communications Access Coordinator that the plan has\nbeen approved; and\n\n(b) continues in force until the day the carrier or provider is\nnotified by a Communications Access Coordinator that\nanother IC plan of the carrier or provider has been approved."
    },
    {
