    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-58",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 Application by Part 5.3 IPO agency of Victoria",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-58"
      },
      "cml:curationStatus": {
