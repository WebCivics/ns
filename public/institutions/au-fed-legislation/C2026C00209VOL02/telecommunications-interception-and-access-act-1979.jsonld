    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-200",
      "@type": "cml:Concept",
      "skos:prefLabel": "200 Compliance with IC plans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-200"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.52",
      "values:originalText": "During the period that an IC plan of a carrier or nominated carriage\nservice provider is in force, the carrier or provider must ensure that\nits business activities are consistent with the plan.",
      "skos:definition": "During the period that an IC plan of a carrier or nominated carriage\nservice provider is in force, the carrier or provider must ensure that\nits business activities are consistent with the plan.",
      "cml:asserts": [
