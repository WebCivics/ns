      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-171-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Mandatory provision of international production orders",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
