      "skos:note": "Document purporting to be a certificate is prima facie evidence in proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-165-ss-4",
      "@type": "cof:Section",
