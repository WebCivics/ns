        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-3a-ss-5-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "88e585be38ce7bc403c00d835b56b3cbb18fb734dcbb50dfe9a34b5da87608c6",
      "skos:note": "Disallowance of regulations relating to designated international"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-3a-ss-5",
      "@type": "cof:Section",
      "cof:title": "3A(5) Disallowance of regulations relating to designated international",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(5) Section 42 (disallowance) of the Legislation Act 2003 does not\napply to the regulations.\nNote 1:\nThe 15 sitting day notice period mentioned in paragraph (2)(a) of this\nclause is the same as the 15 sitting day notice period mentioned in\nparagraph 42(1)(a) of the Legislation Act 2003.\nNote 2:\nThe 15 sitting day disallowance period mentioned in paragraph (2)(b)\nof this clause is the same as the 15 sitting day disallowance period\nmentioned in paragraph 42(1)(b) of the Legislation Act 2003."
    },
