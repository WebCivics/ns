      ],
      "cml:integrityHash": "78db78330666a00e3f5223ef6a088e60ab576f1ad1f018a6951bde55c2dc3f82",
      "skos:note": "Enforcement of international production order"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Issue of international production order—enforcement of the",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "criminal law\nScope\n\n(1) This clause applies if a criminal law-enforcement agency applies,\nunder clause 33, to an issuing authority for an international\nproduction order that:\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-39-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-39"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-39-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:logicSummary": "Mandatory enforcement",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
