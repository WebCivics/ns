    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Video call application service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
