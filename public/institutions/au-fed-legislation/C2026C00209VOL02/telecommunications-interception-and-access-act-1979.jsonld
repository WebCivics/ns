    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Constitutional basis of this Schedule",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.98",
      "values:originalText": "This Schedule relies on the Commonwealth’s legislative powers\nunder paragraph 51(v) (communications) of the Constitution.\n\nInternational production orders  Schedule 1\nInternational production orders relating to the enforcement of the criminal law  Part 2\nIntroduction  Division 1\n\nClause 21\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "This Schedule relies on the Commonwealth’s legislative powers\nunder paragraph 51(v) (communications) of the Constitution.\n\nInternational production orders  Schedule 1\nInternational production orders relating to the enforcement of the criminal law  Part 2\nIntroduction  Division 1\n\nClause 21\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "57fdcd8094e38a5863ee4960eb92e18b27078cd87c1a97bcdf71054528fe7a0e",
      "skos:note": "Relies on Commonwealth's legislative powers under paragraph 51(v) (communications) of the Constitution."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Constitutional basis of this Schedule",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "This Schedule relies on the Commonwealth’s legislative powers\nunder paragraph 51(v) (communications) of the Constitution.\n\nInternational production orders  Schedule 1\nInternational production orders relating to the enforcement of the criminal law  Part 2\nIntroduction  Division 1\n\nClause 21\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-20-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-20"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-20-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Relies on",
      "cml:logicSummary": "Relies on Commonwealth's legislative powers",
