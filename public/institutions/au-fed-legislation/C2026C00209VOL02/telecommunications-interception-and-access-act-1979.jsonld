    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.168",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 72 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 74 or 75 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nInternational production orders  Schedule 1\nInternational production orders relating to Part 5.3 supervisory orders  Part 3\nInternational production orders relating to telecommunications data: Part 5.3\nsupervisory orders  Division 4\n\nClause 77\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 72 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 74 or 75 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nInternational production orders  Schedule 1\nInternational production orders relating to Part 5.3 supervisory orders  Part 3\nInternational production orders relating to telecommunications data: Part 5.3\nsupervisory orders  Division 4\n\nClause 77\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-76-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-76-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7e1dc137a713178e0ead181276329db0d5119b8c2c10e3fd7b2d9b09ed160bd2",
      "skos:note": "Information must be provided to the issuing authority in connection with a telephone application.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 168,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 72 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 74 or 75 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nInternational production orders  Schedule 1\nInternational production orders relating to Part 5.3 supervisory orders  Part 3\nInternational production orders relating to telecommunications data: Part 5.3\nsupervisory orders  Division 4\n\nClause 77\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-76-norm",
