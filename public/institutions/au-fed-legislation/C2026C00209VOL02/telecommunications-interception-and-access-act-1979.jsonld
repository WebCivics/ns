    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-63-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "63(5) Application for international production order—Part 5.3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-63-ss-5"
      },
