      ],
      "cml:integrityHash": "852956b25e587b8d9c44bab08810cd481358930a083e0604967439ef45c37473",
      "skos:note": "Prohibition on receiving certified copy of international production order in certain proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-177",
      "@type": "cof:Section",
      "cof:title": "177 Certified copy of international production order—Part 5.3 IPO",
      "values:kind": "section",
      "cof:pageNumber": 303,
      "values:originalText": "agency\nInterception\n\n(1) A document certified in writing by a certifying officer of a Part 5.3\nIPO agency to be a true copy of an international production order\nissued under clause 60 is to be received in evidence in:\n\n(a) a proceeding by way of a prosecution for an offence against:\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-177-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
