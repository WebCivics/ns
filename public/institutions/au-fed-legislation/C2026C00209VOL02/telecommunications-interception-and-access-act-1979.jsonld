    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Meaning of expressions in other provisions of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-18"
      },
