    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-77",
      "@type": "cml:Concept",
      "skos:prefLabel": "77 Giving further information to issuing authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-77"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.169",
      "values:originalText": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 72 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\nSubdivision B—International production orders relating to\ntelecommunications data",
      "skos:definition": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 72 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\nSubdivision B—International production orders relating to\ntelecommunications data",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-77-ss-1"
        },
