      "skos:note": "Civil penalties for failing to comply with international production orders"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-123",
      "@type": "cof:Section",
      "cof:title": "123 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 224,
      "values:originalText": "•\nCivil penalties apply for failing to comply with international\nproduction orders."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-123-norm",
