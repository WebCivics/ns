    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-154",
      "@type": "cml:Concept",
      "skos:prefLabel": "154 Exception—disclosure to the Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-154"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.267",
      "values:originalText": "Protected information may be disclosed to the Minister for the\npurposes of the performance of the functions, or the exercise of the\npowers, of the Minister.\n\nSchedule 1  International production orders",
      "skos:definition": "Protected information may be disclosed to the Minister for the\npurposes of the performance of the functions, or the exercise of the\npowers, of the Minister.\n\nSchedule 1  International production orders",
      "cml:asserts": [
