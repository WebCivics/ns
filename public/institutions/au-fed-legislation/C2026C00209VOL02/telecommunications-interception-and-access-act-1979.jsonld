    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-16-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(5) Issuing authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-16-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.94",
      "values:originalText": "(5) An issuing authority has, in relation to the performance or exercise\nof a function or power conferred on an issuing authority by this\nSchedule, the same protection and immunity as a Justice of the\nHigh Court has in relation to proceedings in the High Court.",
      "skos:definition": "(5) An issuing authority has, in relation to the performance or exercise\nof a function or power conferred on an issuing authority by this\nSchedule, the same protection and immunity as a Justice of the\nHigh Court has in relation to proceedings in the High Court.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-16"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-16-ss-5-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-16-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "76f89d15cd3ac2c1c9029ee4490e750b0995313fa0c62287ebaf881c8fe4f4da",
      "skos:note": "Issuing authority has protection and immunity as a Justice of the High Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-16-ss-5",
      "@type": "cof:Section",
      "cof:title": "16(5) Issuing authority",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(5) An issuing authority has, in relation to the performance or exercise\nof a function or power conferred on an issuing authority by this\nSchedule, the same protection and immunity as a Justice of the\nHigh Court has in relation to proceedings in the High Court."
    },
