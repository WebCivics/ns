      ],
      "cml:integrityHash": "36d396c2c42869a1f96c484c44399ce3876d7a564edd97fd4d8fe180a7d6c9da",
      "skos:note": "Permits telephone application under urgent circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-93-ss-2",
      "@type": "cof:Section",
      "cof:title": "93(2) Form of application",
      "values:kind": "subsection",
      "cof:pageNumber": 195,
      "values:originalText": "(2) If the person making an application under clause 92 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\nNote:\nSee also clause 17A (urgent circumstances) and clause 172 (action\nrequired)."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-93-ss-2-norm",
