        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) particulars of the use made by the Organisation of intercepted\nmessages, voice calls or video calls made available to the\nOrganisation under such orders."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-86-ss-4-logic-cogai-5",
