      "cml:premiseText": "(2) A determination:"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-189-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "189(3) Minister may make determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-189-ss-3"
      },
