    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-163-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "163(2) Evidentiary certificates—interception",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-163-ss-2"
