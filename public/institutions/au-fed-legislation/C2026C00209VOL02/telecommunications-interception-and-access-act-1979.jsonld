    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "67 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-67"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.159",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 63 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 65 or 66 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 63 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 65 or 66 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0936f47544147001a01b1cabd8d6e966411c647774bd758a63233d5ca454c142",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-67",
      "@type": "cof:Section",
      "cof:title": "67 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 159,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 63 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 65 or 66 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-67-logic-deontic-1",
