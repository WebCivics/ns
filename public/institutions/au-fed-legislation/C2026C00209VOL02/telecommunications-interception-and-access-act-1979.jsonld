    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-134-ss-2",
      "@type": "cof:Section",
      "cof:title": "134(2) Other records to be kept—relevant agencies",
