    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.127",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 39; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 39 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nSchedule 1  International production orders",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 39; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 39 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "12816d64da42dab390619d514601dc3588a1bd0e2389cf8d7cdfb3178ab814df",
      "skos:note": "Issue of further international production order is permitted under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 127,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 39; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 39 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-41-norm",
