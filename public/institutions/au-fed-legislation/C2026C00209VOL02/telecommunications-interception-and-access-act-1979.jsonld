      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "CEASES_IF",
      "cml:logicSummary": "Ground for revocation ceases if no supervisory order is in force.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) For the purposes of the application of subclause (1) to an international production order...",
      "cml:conclusionText": "...that ground is taken to have ceased to exist if, and only if, neither that Part 5.3 supervisory order, nor any succeeding Part 5.3 supervisory order, is in force."
    },
