    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-50",
      "@type": "cml:Concept",
      "skos:prefLabel": "50 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-50"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.135",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 48; and\n\n(b) the original order was directed to a prescribed\ncommunications provider; and\n\n(c) the original order relates to the investigation by an\nenforcement agency of a serious category 1 offence, or\nserious category 1 offences;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 48 that:\n\n(d) is directed to the provider; and\n\n(e) relates to the investigation by the enforcement agency of that\noffence or those offences.\n\nSchedule 1  International production orders",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 48; and\n\n(b) the original order was directed to a prescribed\ncommunications provider; and\n\n(c) the original order relates to the investigation by an\nenforcement agency of a serious category 1 offence, or\nserious category 1 offences;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 48 that:\n\n(d) is directed to the provider; and\n\n(e) relates to the investigation by the enforcement agency of that\noffence or those offences.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-50-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-50-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7e117fa9c9aab49a458ef29415a420dc3c2f7bc5d3bf3de2041eb5d11a54d66a",
      "skos:note": "Issue of further international production order under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-50",
      "@type": "cof:Section",
      "cof:title": "50 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 135,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 48; and\n\n(b) the original order was directed to a prescribed\ncommunications provider; and\n\n(c) the original order relates to the investigation by an\nenforcement agency of a serious category 1 offence, or\nserious category 1 offences;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 48 that:\n\n(d) is directed to the provider; and\n\n(e) relates to the investigation by the enforcement agency of that\noffence or those offences.\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-50-norm",
