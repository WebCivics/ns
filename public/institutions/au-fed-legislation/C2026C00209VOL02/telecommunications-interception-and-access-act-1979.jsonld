        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-193-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "99a513b0f1c84327cfb1f78cf64e21bc85ab18ac1a3e8918e875168a71d7a78d",
      "skos:note": "ACMA must consult interception agencies before granting an exemption."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-193-ss-2",
      "@type": "cof:Section",
      "cof:title": "193(2) ACMA may grant exemptions for trial services",
      "values:kind": "subsection",
      "cof:pageNumber": 46,
      "values:originalText": "(2) The ACMA must not grant an exemption unless the ACMA, after\nconsulting any interception agencies that the ACMA considers\nappropriate, is satisfied that the exemption is unlikely to create a\nrisk to national security or law enforcement."
    },
