    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Nominated ART member",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-15"
      },
