    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.105",
      "values:originalText": "The information given to an eligible Judge or nominated ART\nmember in connection with a telephone application under clause 22\nto the eligible Judge or nominated ART member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\ninterception agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 24 or 25 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the eligible Judge or\nnominated ART member directs.",
      "skos:definition": "The information given to an eligible Judge or nominated ART\nmember in connection with a telephone application under clause 22\nto the eligible Judge or nominated ART member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\ninterception agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 24 or 25 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the eligible Judge or\nnominated ART member directs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-26-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4dcedbd62182a23c7fa656aa33fdb44b09e2cd0e07884f4093edf7b9ef329a32",
      "skos:note": "Information must be provided to an eligible Judge or nominated ART member.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "The information given to an eligible Judge or nominated ART\nmember in connection with a telephone application under clause 22\nto the eligible Judge or nominated ART member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\ninterception agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 24 or 25 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the eligible Judge or\nnominated ART member directs."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-26-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-26"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-26-logic-deontic-1",
      "@type": "cml:LogicApplication",
