    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-65",
      "@type": "cml:Concept",
      "skos:prefLabel": "65 Contents of written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-65"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.158",
      "values:originalText": "An application under clause 63 must, if it is in writing, set out:\n\n(a) the name of the Part 5.3 IPO agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.",
      "skos:definition": "An application under clause 63 must, if it is in writing, set out:\n\n(a) the name of the Part 5.3 IPO agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-65-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-65-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d323b06fa9cfd2c6a259e7e363a2f6641450c48d91075c618a5793217943b99d",
      "skos:note": "Application must provide agency name and applicant name.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-65",
      "@type": "cof:Section",
      "cof:title": "65 Contents of written application",
      "values:kind": "section",
      "cof:pageNumber": 158,
      "values:originalText": "An application under clause 63 must, if it is in writing, set out:\n\n(a) the name of the Part 5.3 IPO agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf."
    },
    {
