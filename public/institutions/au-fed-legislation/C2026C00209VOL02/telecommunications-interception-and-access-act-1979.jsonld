    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Intended recipient of a communication",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.92",
      "values:originalText": "For the purposes of this Schedule, the intended recipient of a\ncommunication is:\n\n(a) if the communication is addressed to an individual (either in\nthe individual’s own capacity or in the capacity of an\nemployee or agent of another person)—the individual; or\n\n(b) if the communication is addressed to a person who is not an\nindividual—the person; or\n\n(c) if the communication is not addressed to a person—the\nperson who has, or whose employee or agent has, control\nover the individual transmission service that was used to\nreceive the communication.",
      "skos:definition": "For the purposes of this Schedule, the intended recipient of a\ncommunication is:\n\n(a) if the communication is addressed to an individual (either in\nthe individual’s own capacity or in the capacity of an\nemployee or agent of another person)—the individual; or\n\n(b) if the communication is addressed to a person who is not an\nindividual—the person; or\n\n(c) if the communication is not addressed to a person—the\nperson who has, or whose employee or agent has, control\nover the individual transmission service that was used to\nreceive the communication.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-11-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9ba240184b6de2bdc3c1a02c2f83645948a6ce748dd6e3d74c4d9fc377484cf2",
      "skos:note": "Defines intended recipient of a communication"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Intended recipient of a communication",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "For the purposes of this Schedule, the intended recipient of a\ncommunication is:\n\n(a) if the communication is addressed to an individual (either in\nthe individual’s own capacity or in the capacity of an\nemployee or agent of another person)—the individual; or\n\n(b) if the communication is addressed to a person who is not an\nindividual—the person; or\n\n(c) if the communication is not addressed to a person—the\nperson who has, or whose employee or agent has, control\nover the individual transmission service that was used to\nreceive the communication."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
