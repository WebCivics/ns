    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-87",
      "@type": "cml:Concept",
      "skos:prefLabel": "87 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-87"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.182",
      "values:originalText": "The information given to a nominated ART Intelligence and\nSecurity member in connection with a telephone application under\nclause 83 to the nominated ART Intelligence and Security member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 85 or 86 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated ART\nIntelligence and Security member directs.",
      "skos:definition": "The information given to a nominated ART Intelligence and\nSecurity member in connection with a telephone application under\nclause 83 to the nominated ART Intelligence and Security member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 85 or 86 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated ART\nIntelligence and Security member directs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-87-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-87-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c23823c9e816ca4d2d86ddce4d8f61d6ea25a09ccf8269285260693d9873f38e",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-87",
      "@type": "cof:Section",
      "cof:title": "87 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "The information given to a nominated ART Intelligence and\nSecurity member in connection with a telephone application under\nclause 83 to the nominated ART Intelligence and Security member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 85 or 86 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated ART\nIntelligence and Security member directs."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-87-norm",
      "@type": "values:Obligation",
