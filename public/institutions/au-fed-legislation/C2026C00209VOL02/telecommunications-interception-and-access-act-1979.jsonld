      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.94",
      "values:originalText": "(1) The Attorney-General may, by writing, nominate a person who\nholds one of the following appointments to the Administrative\nReview Tribunal to issue international production orders (except to\nthe National Anti-Corruption Commission) under Division 2 of",
      "skos:definition": "(1) The Attorney-General may, by writing, nominate a person who\nholds one of the following appointments to the Administrative\nReview Tribunal to issue international production orders (except to\nthe National Anti-Corruption Commission) under Division 2 of",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-15-norm"
        }
      ],
      "cml:integrityHash": "db3f105bce3a3a6696da344b9d32df24a0d269c316795baad3a7d360ffdae8c6",
      "skos:note": "Attorney-General may nominate a person to issue international production orders."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Nominated ART member",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "(1) The Attorney-General may, by writing, nominate a person who\nholds one of the following appointments to the Administrative\nReview Tribunal to issue international production orders (except to\nthe National Anti-Corruption Commission) under Division 2 of"
    },
