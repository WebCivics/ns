      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-177-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits receiving certified copy of international production order in certain proceedings",
