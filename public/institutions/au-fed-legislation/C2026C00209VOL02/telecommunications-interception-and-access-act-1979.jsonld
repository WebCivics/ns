    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Use of a thing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.92",
      "values:originalText": "A reference in this Schedule to the use of a thing is a reference to\nthe use of the thing either:\n\n(a) in isolation; or\n\n(b) in conjunction with one or more other things.\nNote:\nSee also section 18A of the Acts Interpretation Act 1901.",
      "skos:definition": "A reference in this Schedule to the use of a thing is a reference to\nthe use of the thing either:\n\n(a) in isolation; or\n\n(b) in conjunction with one or more other things.\nNote:\nSee also section 18A of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-12-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "f307d3f30366556719cf9bbb34178fb83263c2a28f4dc55790c7c898d22e9e9a",
      "skos:note": "Reference to use of a thing is to its use in isolation or conjunction with other things."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Use of a thing",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "A reference in this Schedule to the use of a thing is a reference to\nthe use of the thing either:\n\n(a) in isolation; or\n\n(b) in conjunction with one or more other things.\nNote:\nSee also section 18A of the Acts Interpretation Act 1901."
    },
