      "cml:premiseText": "(1) Subject to subclause (2), an application under clause 22 for an international production order must be in writing."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-23-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(2) Form of application",
