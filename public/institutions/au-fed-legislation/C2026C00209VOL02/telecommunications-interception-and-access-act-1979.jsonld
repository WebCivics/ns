      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.224",
      "values:originalText": "•\nCivil penalties apply for failing to comply with international\nproduction orders.",
      "skos:definition": "•\nCivil penalties apply for failing to comply with international\nproduction orders.",
