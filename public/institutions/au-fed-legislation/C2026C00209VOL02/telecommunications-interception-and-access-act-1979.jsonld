    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-151",
      "@type": "cml:Concept",
      "skos:prefLabel": "151 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-151"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.263",
      "values:originalText": "•\nProtected information must not be used, recorded or disclosed,\nunless an exception applies.\n•\nProtected information must not be admitted in evidence,\nunless an exception applies.",
      "skos:definition": "•\nProtected information must not be used, recorded or disclosed,\nunless an exception applies.\n•\nProtected information must not be admitted in evidence,\nunless an exception applies.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-151-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-151-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db6f1f86a32d863d729bea7b6e8350ad2da256a02375e27923bc16b45c614998",
      "skos:note": "Protected information cannot be used, recorded or disclosed without an exception."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-151",
      "@type": "cof:Section",
      "cof:title": "151 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 263,
      "values:originalText": "•\nProtected information must not be used, recorded or disclosed,\nunless an exception applies.\n•\nProtected information must not be admitted in evidence,\nunless an exception applies."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-151-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-151"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-151-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the use, recording or disclosure of protected information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-152",
      "@type": "cml:Concept",
      "skos:prefLabel": "152 Prohibition on use, recording or disclosure of protected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-152"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.263",
      "values:originalText": "information or its admission in evidence\n\n(1) A person commits an offence if:\n\n(a) the person uses, records or discloses information; and\n\n(b) the information is protected information; and\n\n(c) the use, recording or disclosure of the information is not\npermitted by this Part.\nPenalty: Imprisonment for 2 years.\n\n(2) Subject to this Part, protected information must not be admitted in\nevidence in any proceedings in Australia.",
      "skos:definition": "information or its admission in evidence\n\n(1) A person commits an offence if:\n\n(a) the person uses, records or discloses information; and\n\n(b) the information is protected information; and\n\n(c) the use, recording or disclosure of the information is not\npermitted by this Part.\nPenalty: Imprisonment for 2 years.\n\n(2) Subject to this Part, protected information must not be admitted in\nevidence in any proceedings in Australia.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-152-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-152-ss-2"
        }
      ],
      "cml:integrityHash": "2952a24e6739c3fcf50ad7fd58db12fe3a7a5936119fe7234d70ffbf8fd174db"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-152",
      "@type": "cof:Section",
      "cof:title": "152 Prohibition on use, recording or disclosure of protected",
      "values:kind": "section",
      "cof:pageNumber": 263,
      "values:originalText": "information or its admission in evidence\n\n(1) A person commits an offence if:\n\n(a) the person uses, records or discloses information; and\n\n(b) the information is protected information; and\n\n(c) the use, recording or disclosure of the information is not\npermitted by this Part.\nPenalty: Imprisonment for 2 years.\n\n(2) Subject to this Part, protected information must not be admitted in\nevidence in any proceedings in Australia."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-152-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "152(1) Prohibition on use, recording or disclosure of protected",
      "cml:realizedBy": {
