        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-126-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9790ea114e63a0c0a4531a9051c55a70c5625da354470a0bffe2cf2169af7c59",
      "skos:note": "Prohibition on application of Part 4 to acts outside Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-126-ss-5",
      "@type": "cof:Section",
      "cof:title": "126(5) Civil penalty provision—enforcement",
      "values:kind": "subsection",
      "cof:pageNumber": 226,
      "values:originalText": "(5) Part 4 of the Regulatory Powers (Standard Provisions) Act 2014,\nas it applies in relation to a civil penalty provision in this Part,\nextends to acts, omissions, matters and things outside Australia.\n\nInternational production orders  Schedule 1\nReporting and record-keeping requirements  Part 9\nIntroduction  Division 1\n\nClause 127\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-126-ss-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-126-ss-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-126-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits application of Part 4 to acts outside Australia",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part 4 applies only to acts within Australia",
      "cml:conclusionText": "Application of Part 4 is prohibited for acts outside Australia"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-127",
      "@type": "cml:Concept",
      "skos:prefLabel": "127 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-127"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.227",
      "values:originalText": "•\nThe chief officer of a relevant agency and the Australian\nDesignated Authority must give the Minister annual reports\nabout matters relating to international production orders.\n•\nThe Director-General of Security must give the\nAttorney-General a report on the extent to which compliance\nby a prescribed communications provider with an\ninternational production order has assisted the Organisation in\ncarrying out its functions.\n•\nThe Minister must cause to be prepared annual reports about\nmatters relating to international production orders that were\nissued in response to applications made by relevant agencies.\n•\nThe chief officer of a relevant agency, the Director-General of\nSecurity and the Australian Designated Authority must ensure\nthat records are kept of matters relating to international\nproduction orders.\n\nSchedule 1  International production orders",
      "skos:definition": "•\nThe chief officer of a relevant agency and the Australian\nDesignated Authority must give the Minister annual reports\nabout matters relating to international production orders.\n•\nThe Director-General of Security must give the\nAttorney-General a report on the extent to which compliance\nby a prescribed communications provider with an\ninternational production order has assisted the Organisation in\ncarrying out its functions.\n•\nThe Minister must cause to be prepared annual reports about\nmatters relating to international production orders that were\nissued in response to applications made by relevant agencies.\n•\nThe chief officer of a relevant agency, the Director-General of\nSecurity and the Australian Designated Authority must ensure\nthat records are kept of matters relating to international\nproduction orders.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-127-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-127-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "819d7504f4e9b921cf8871100c81885959a44daf664d3e27521e8c76dea7b375",
      "skos:note": "Annual reports must be given by certain agencies and authorities.",
      "dc:description": "annual reports"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-127",
      "@type": "cof:Section",
      "cof:title": "127 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 227,
      "values:originalText": "•\nThe chief officer of a relevant agency and the Australian\nDesignated Authority must give the Minister annual reports\nabout matters relating to international production orders.\n•\nThe Director-General of Security must give the\nAttorney-General a report on the extent to which compliance\nby a prescribed communications provider with an\ninternational production order has assisted the Organisation in\ncarrying out its functions.\n•\nThe Minister must cause to be prepared annual reports about\nmatters relating to international production orders that were\nissued in response to applications made by relevant agencies.\n•\nThe chief officer of a relevant agency, the Director-General of\nSecurity and the Australian Designated Authority must ensure\nthat records are kept of matters relating to international\nproduction orders.\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-127-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-127"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-127-logic-deontic-1",
