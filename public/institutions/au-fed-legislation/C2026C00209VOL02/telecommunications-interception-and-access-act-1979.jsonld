    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.153",
      "values:originalText": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 60 in response to an application made by a Part 5.3\nIPO agency.\n\nSchedule 1  International production orders",
      "skos:definition": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 60 in response to an application made by a Part 5.3\nIPO agency.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-61-norm"
        }
      ],
      "cml:integrityHash": "43608f1dc0ef0a227fc05968793fd5d138e2fc2234cc06ecf615e17fa5b5e8c2",
      "skos:note": "Scope of international production order"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-61",
      "@type": "cof:Section",
      "cof:title": "61 Content of international production order",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 60 in response to an application made by a Part 5.3\nIPO agency.\n\nSchedule 1  International production orders"
    },
    {
