        }
      ],
      "cml:integrityHash": "8651a69a1a8411e8f23465a88294692b371a4a555eddc3a3157f8048c1285b84",
      "skos:note": "Report to Minister on inspections results",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-150-ss-1",
      "@type": "cof:Section",
      "cof:title": "150(1) Reports",
      "values:kind": "subsection",
      "cof:pageNumber": 261,
      "values:originalText": "(1) The Ombudsman must report to the Minister, in writing, about the\nresults of:\n\n(a) inspections under clause 142 of the records of relevant\nagencies during a financial year; and\n\n(b) inspections under clause 143 of the records of the Australian\nDesignated Authority during a financial year."
    },
