      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.121",
      "values:originalText": "criminal law\nScope\n\n(1) This clause applies if a criminal law-enforcement agency applies,\nunder clause 33, to an issuing authority for an international\nproduction order that:\n\nSchedule 1  International production orders",
      "skos:definition": "criminal law\nScope\n\n(1) This clause applies if a criminal law-enforcement agency applies,\nunder clause 33, to an issuing authority for an international\nproduction order that:\n\nSchedule 1  International production orders",
      "cml:asserts": [
