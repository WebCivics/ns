        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-188-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d7a166b8e86cad0c97d131daa2c64f975fca05f94e0c7d42bc73c88ed4f87453",
      "skos:note": "Carrier must nominate a location for transmission of intercepted information.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-188",
