    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-198",
      "@type": "cml:Concept",
      "skos:prefLabel": "198 Consideration of IC plans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-198"
      },
      "cml:curationStatus": {
