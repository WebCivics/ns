          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-139-ss-3"
        }
      ],
      "cml:integrityHash": "a238260085948a5ac21996528fb6febce737d4f40d03a2d79a85878473432786"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-139",
