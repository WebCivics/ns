    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-182",
      "@type": "cml:Concept",
      "skos:prefLabel": "182 Specification of international agreements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-182"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.307",
      "values:originalText": "(1) If:\n\n(a) there is an agreement between Australia and one or more\nforeign countries; and\n\n(b) the name of the agreement is specified in:\n\n(i) regulations made for the purposes of this Schedule; or\n\n(ii) an application made under this Schedule; or\n\n(iii) an international production order; or\n\n(iv) any other instrument made under this Schedule;\na reference in the regulations, application, order or other\ninstrument (as the case may be) to the agreement is a reference to\nthe agreement as amended and in force for Australia from time to\ntime.\n\nSchedule 1  International production orders",
      "skos:definition": "(1) If:\n\n(a) there is an agreement between Australia and one or more\nforeign countries; and\n\n(b) the name of the agreement is specified in:\n\n(i) regulations made for the purposes of this Schedule; or\n\n(ii) an application made under this Schedule; or\n\n(iii) an international production order; or\n\n(iv) any other instrument made under this Schedule;\na reference in the regulations, application, order or other\ninstrument (as the case may be) to the agreement is a reference to\nthe agreement as amended and in force for Australia from time to\ntime.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-182-norm"
        }
      ],
      "cml:integrityHash": "5a2945619b8f95d55f116b24f057a39326ed6dfb1203249e8aeaf58076416da3",
      "skos:note": "Reference to international agreements is a reference to the agreement as amended and in force for Australia from time to time."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-182",
      "@type": "cof:Section",
      "cof:title": "182 Specification of international agreements",
      "values:kind": "section",
      "cof:pageNumber": 307,
      "values:originalText": "(1) If:\n\n(a) there is an agreement between Australia and one or more\nforeign countries; and\n\n(b) the name of the agreement is specified in:\n\n(i) regulations made for the purposes of this Schedule; or\n\n(ii) an application made under this Schedule; or\n\n(iii) an international production order; or\n\n(iv) any other instrument made under this Schedule;\na reference in the regulations, application, order or other\ninstrument (as the case may be) to the agreement is a reference to\nthe agreement as amended and in force for Australia from time to\ntime.\n\nSchedule 1  International production orders"
    },
