    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187d",
      "@type": "cml:Concept",
      "skos:prefLabel": "187D Effect of data retention implementation plans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-187d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.25",
      "values:originalText": "While there is in force a data retention implementation plan for a\nrelevant service operated by a service provider:\n\n(a) the service provider must comply with the plan in relation to\ncommunications carried by means of that service; but\n\n(b) the service provider is not required to comply with\nsubsection 187A(1) (or section 187BA or 187C) in relation to\nthose communications.",
      "skos:definition": "While there is in force a data retention implementation plan for a\nrelevant service operated by a service provider:\n\n(a) the service provider must comply with the plan in relation to\ncommunications carried by means of that service; but\n\n(b) the service provider is not required to comply with\nsubsection 187A(1) (or section 187BA or 187C) in relation to\nthose communications.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187d-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187d-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187d-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "62ce03ef14c399f33032664537249342d8f26309e8019134bdb776916471e10a",
      "skos:note": "Comply with data retention implementation plan for communications carried by a service."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-187d",
      "@type": "cof:Section",
      "cof:title": "187D Effect of data retention implementation plans",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "While there is in force a data retention implementation plan for a\nrelevant service operated by a service provider:\n\n(a) the service provider must comply with the plan in relation to\ncommunications carried by means of that service; but\n\n(b) the service provider is not required to comply with\nsubsection 187A(1) (or section 187BA or 187C) in relation to\nthose communications."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-187d-norm",
