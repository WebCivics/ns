    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.121",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 33 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the criminal\nlaw-enforcement agency’s behalf thinks it necessary to make\nthe application by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 35 or 36 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 33 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the criminal\nlaw-enforcement agency’s behalf thinks it necessary to make\nthe application by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 35 or 36 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-37-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9e561dde673dca14d4e3622a2f3e7f55fd451fd1010aa0b84df75ef786afdeec",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-37",
      "@type": "cof:Section",
      "cof:title": "37 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 33 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the criminal\nlaw-enforcement agency’s behalf thinks it necessary to make\nthe application by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 35 or 36 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-37-norm",
      "@type": "values:Obligation",
