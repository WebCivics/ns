    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-141",
      "@type": "cml:Concept",
      "skos:prefLabel": "141 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-141"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.253",
      "values:originalText": "•\nThe Ombudsman may inspect records of a relevant agency,\nexcept the ACC or certain agencies, or parts of agencies,\nprescribed by regulations made under the Ombudsman Act\n1976, to determine the extent of compliance with this\nSchedule by the relevant agency and its officers.\n•\nThe Ombudsman may inspect records of the Australian\nDesignated Authority to determine the extent of compliance\nwith this Schedule by the Australian Designated Authority.\n•\nThe Ombudsman must give the Minister an annual report\nabout the results of those inspections.",
      "skos:definition": "•\nThe Ombudsman may inspect records of a relevant agency,\nexcept the ACC or certain agencies, or parts of agencies,\nprescribed by regulations made under the Ombudsman Act\n1976, to determine the extent of compliance with this\nSchedule by the relevant agency and its officers.\n•\nThe Ombudsman may inspect records of the Australian\nDesignated Authority to determine the extent of compliance\nwith this Schedule by the Australian Designated Authority.\n•\nThe Ombudsman must give the Minister an annual report\nabout the results of those inspections.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-141-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-141-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ac7e75dc920919bf063fddd2fbd30a69961445ee2a9eb4dbeff032def9a1d470",
      "skos:note": "Inspect records of relevant agencies to determine compliance with the Schedule."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-141",
      "@type": "cof:Section",
      "cof:title": "141 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 253,
      "values:originalText": "•\nThe Ombudsman may inspect records of a relevant agency,\nexcept the ACC or certain agencies, or parts of agencies,\nprescribed by regulations made under the Ombudsman Act\n1976, to determine the extent of compliance with this\nSchedule by the relevant agency and its officers.\n•\nThe Ombudsman may inspect records of the Australian\nDesignated Authority to determine the extent of compliance\nwith this Schedule by the Australian Designated Authority.\n•\nThe Ombudsman must give the Minister an annual report\nabout the results of those inspections."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-141-norm",
