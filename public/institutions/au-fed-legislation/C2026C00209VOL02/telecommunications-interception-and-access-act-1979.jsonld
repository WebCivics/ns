    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-140-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "140(4) Destruction of records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-140-ss-4"
      },
