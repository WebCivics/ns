    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-202a",
      "@type": "cml:Concept",
      "skos:prefLabel": "202A Purpose of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-202a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.54",
      "values:originalText": "The purpose of this Part is:\n\n(a) to require carriers and nominated carriage service providers\nto give notice of the particulars of any change that is\nproposed in relation to a telecommunications service or a\ntelecommunications system, whose implementation may\naffect the capacity of the carrier or provider to comply with\nits obligations under:\n\n(i) this Act; or\n\n(ii) section 313 of the Telecommunications Act 1997; and\n\n(b) to allow a Communications Access Coordinator to notify\nagencies of such proposed changes.",
      "skos:definition": "The purpose of this Part is:\n\n(a) to require carriers and nominated carriage service providers\nto give notice of the particulars of any change that is\nproposed in relation to a telecommunications service or a\ntelecommunications system, whose implementation may\naffect the capacity of the carrier or provider to comply with\nits obligations under:\n\n(i) this Act; or\n\n(ii) section 313 of the Telecommunications Act 1997; and\n\n(b) to allow a Communications Access Coordinator to notify\nagencies of such proposed changes.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-202a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-202a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9a0846439871db1208739625846a42fc2102ba055761ace91dc1a7c61b4be1db",
      "skos:note": "Require carriers and providers to give notice of proposed changes in telecommunications services."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-202a",
      "@type": "cof:Section",
      "cof:title": "202A Purpose of Part",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "The purpose of this Part is:\n\n(a) to require carriers and nominated carriage service providers\nto give notice of the particulars of any change that is\nproposed in relation to a telecommunications service or a\ntelecommunications system, whose implementation may\naffect the capacity of the carrier or provider to comply with\nits obligations under:\n\n(i) this Act; or\n\n(ii) section 313 of the Telecommunications Act 1997; and\n\n(b) to allow a Communications Access Coordinator to notify\nagencies of such proposed changes."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-202a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
