    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-46"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.129",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 42 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nenforcement agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 44 or 45 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nSchedule 1  International production orders",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 42 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nenforcement agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 44 or 45 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-46-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-46-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4dbe7461e9dd3e31d9bd6bc26f4d878310fcf0e032bb66d95f04b745328535ee",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-46",
      "@type": "cof:Section",
      "cof:title": "46 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 129,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 42 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nenforcement agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 44 or 45 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-46-norm",
      "@type": "values:Obligation",
      "cml:modality": {
