    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "96 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.196",
      "values:originalText": "The information given to a nominated ART Intelligence and\nSecurity member in connection with a telephone application under\nclause 92 to the nominated ART Intelligence and Security member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 94 or 95 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated ART\nIntelligence and Security member directs.",
      "skos:definition": "The information given to a nominated ART Intelligence and\nSecurity member in connection with a telephone application under\nclause 92 to the nominated ART Intelligence and Security member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 94 or 95 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated ART\nIntelligence and Security member directs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-96-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-96-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ee5b4a9c0989d61c18351dc7dddd21f75968ccfd6a4869e57da61bcf3efe02bd",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-96",
      "@type": "cof:Section",
      "cof:title": "96 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 196,
      "values:originalText": "The information given to a nominated ART Intelligence and\nSecurity member in connection with a telephone application under\nclause 92 to the nominated ART Intelligence and Security member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 94 or 95 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated ART\nIntelligence and Security member directs."
    },
    {
