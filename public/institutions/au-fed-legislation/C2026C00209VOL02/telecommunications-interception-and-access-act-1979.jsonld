    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-153",
      "@type": "cml:Concept",
      "skos:prefLabel": "153 Exceptions—general",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-153"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.263",
      "values:originalText": "(1) Protected information may be used, recorded or disclosed, or may\nbe admitted in evidence, for any of the following purposes:\n\n(a) the investigation of a serious category 1 offence or a serious\ncategory 2 offence or the making of a report on the outcome\nof such an investigation;\n\n(b) the making of a decision whether or not to bring a\nprosecution for a serious category 1 offence or a serious\ncategory 2 offence (other than an offence referred to in\nparagraph (r));\n\nSchedule 1  International production orders",
      "skos:definition": "(1) Protected information may be used, recorded or disclosed, or may\nbe admitted in evidence, for any of the following purposes:\n\n(a) the investigation of a serious category 1 offence or a serious\ncategory 2 offence or the making of a report on the outcome\nof such an investigation;\n\n(b) the making of a decision whether or not to bring a\nprosecution for a serious category 1 offence or a serious\ncategory 2 offence (other than an offence referred to in\nparagraph (r));\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-153-norm"
        }
      ],
      "cml:integrityHash": "706a02a8e905c29448257647e5e127d8cecc54cf19e9272f986caeddb1ef7df4",
      "skos:note": "Protected information may be used for specific purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-153",
      "@type": "cof:Section",
      "cof:title": "153 Exceptions—general",
      "values:kind": "section",
      "cof:pageNumber": 263,
      "values:originalText": "(1) Protected information may be used, recorded or disclosed, or may\nbe admitted in evidence, for any of the following purposes:\n\n(a) the investigation of a serious category 1 offence or a serious\ncategory 2 offence or the making of a report on the outcome\nof such an investigation;\n\n(b) the making of a decision whether or not to bring a\nprosecution for a serious category 1 offence or a serious\ncategory 2 offence (other than an offence referred to in\nparagraph (r));\n\nSchedule 1  International production orders"
    },
