        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.159",
      "values:originalText": "order\nScope\n\n(1) This clause applies if a Part 5.3 IPO agency applies, under\nclause 63, to an issuing authority for an international production\norder that:\n\nSchedule 1  International production orders",
      "skos:definition": "order\nScope\n\n(1) This clause applies if a Part 5.3 IPO agency applies, under\nclause 63, to an issuing authority for an international production\norder that:\n\nSchedule 1  International production orders",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-69-norm"
        }
      ],
      "cml:integrityHash": "9c1f3ef12815bb125479f20037043635c65f862d481ec3d17128c7a5c1c03157",
      "skos:note": "Scope of Part 5.3 IPO agency's application to an international production order"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-69",
      "@type": "cof:Section",
      "cof:title": "69 Issue of international production order—Part 5.3 supervisory",
      "values:kind": "section",
      "cof:pageNumber": 159,
      "values:originalText": "order\nScope\n\n(1) This clause applies if a Part 5.3 IPO agency applies, under\nclause 63, to an issuing authority for an international production\norder that:\n\nSchedule 1  International production orders"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-69-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
