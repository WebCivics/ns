        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-161-ss-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "c13be41525f3cc4e5406e2fd494c19794e080247a18a1d87baf4905134e8d8fa",
      "skos:note": "Conclusive evidence of matters stated in the document"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-161-ss-3",
      "@type": "cof:Section",
      "cof:title": "161(3) Evidentiary certificates—compliance with international",
      "values:kind": "subsection",
      "cof:pageNumber": 282,
      "values:originalText": "(3) A document purporting to be a certificate issued under\nsubclause (1) or (2):\n\n(a) is to be received in evidence in a proceeding in Australia\nwithout further proof; and\n\n(b) in a proceeding in Australia, is conclusive evidence of the\nmatters stated in the document.\n\nInternational production orders  Schedule 1\nEvidentiary certificates  Part 12\n\nClause 162\n\nTelecommunications (Interception and Access) Act 1979\n\nCompilation date: 04/06/2026"
    },
