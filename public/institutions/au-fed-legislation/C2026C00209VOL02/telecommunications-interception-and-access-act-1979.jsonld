      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide information to the issuing authority.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
