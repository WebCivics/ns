    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110",
      "@type": "cml:Concept",
      "skos:prefLabel": "110 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-110"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.211",
      "values:originalText": "•\nBefore an international production order is given to a\nprescribed communications provider, the Australian\nDesignated Authority must consider whether the order\ncomplies with the designated international agreement\nnominated in the application for the order.\n•\nIf the Australian Designated Authority is satisfied that the\norder complies with the designated international agreement\nnominated in the application for the order, the Australian\nDesignated Authority must give the order to the prescribed\ncommunications provider. The order comes in force when it is\ngiven to the provider.\n•\nIf the Australian Designated Authority is not satisfied that the\norder complies with the designated international agreement\nnominated in the application for the order, the Australian\nDesignated Authority must cancel the order.",
      "skos:definition": "•\nBefore an international production order is given to a\nprescribed communications provider, the Australian\nDesignated Authority must consider whether the order\ncomplies with the designated international agreement\nnominated in the application for the order.\n•\nIf the Australian Designated Authority is satisfied that the\norder complies with the designated international agreement\nnominated in the application for the order, the Australian\nDesignated Authority must give the order to the prescribed\ncommunications provider. The order comes in force when it is\ngiven to the provider.\n•\nIf the Australian Designated Authority is not satisfied that the\norder complies with the designated international agreement\nnominated in the application for the order, the Australian\nDesignated Authority must cancel the order.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "debc59e6155c03e10e97a75f2d40ed067b45dbc1732b91cfbf3dbd931a2f426d",
      "skos:note": "Must consider if order complies with designated international agreement before giving it to the provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-110",
      "@type": "cof:Section",
      "cof:title": "110 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 211,
      "values:originalText": "•\nBefore an international production order is given to a\nprescribed communications provider, the Australian\nDesignated Authority must consider whether the order\ncomplies with the designated international agreement\nnominated in the application for the order.\n•\nIf the Australian Designated Authority is satisfied that the\norder complies with the designated international agreement\nnominated in the application for the order, the Australian\nDesignated Authority must give the order to the prescribed\ncommunications provider. The order comes in force when it is\ngiven to the provider.\n•\nIf the Australian Designated Authority is not satisfied that the\norder complies with the designated international agreement\nnominated in the application for the order, the Australian\nDesignated Authority must cancel the order."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-110-norm",
