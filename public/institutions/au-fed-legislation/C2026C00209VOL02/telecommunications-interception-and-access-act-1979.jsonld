    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-act-1979.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-act-1979.pdf, p.141",
      "values:originalText": "The information given to an eligible Judge or nominated ART\nmember in connection with a telephone application under clause 52\nto the eligible Judge or nominated ART member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 54 or 55 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the eligible Judge or\nnominated ART member directs.",
      "skos:definition": "The information given to an eligible Judge or nominated ART\nmember in connection with a telephone application under clause 52\nto the eligible Judge or nominated ART member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 54 or 55 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the eligible Judge or\nnominated ART member directs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-56-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2ec301656eda34254a1501555cd6285386a8d8048831c96f35fe26b7744c0e91",
      "skos:note": "Information must be provided to an eligible Judge or nominated ART member.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "The information given to an eligible Judge or nominated ART\nmember in connection with a telephone application under clause 52\nto the eligible Judge or nominated ART member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the Part 5.3\nIPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 54 or 55 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the eligible Judge or\nnominated ART member directs."
    },
