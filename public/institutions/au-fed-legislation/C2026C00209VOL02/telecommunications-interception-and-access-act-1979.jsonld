    {
      "@id": "concept:telecommunications-interception-and-access-act-1979-sch-1-sec-132-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "132(2) Deferral of inclusion of information in Ministerial report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-act-1979#sch-1-sec-132-ss-2"
      },
