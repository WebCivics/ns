    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj",
      "@type": "cml:Concept",
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.89",
      "skos:note": "Termination of appointment under certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "46MJ Termination of appointment"
      },
      "wasDerivedFrom": "australian-human-rights-commission-act-1986.pdf",
      "asserts": [
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-norm",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-deontic-1",
