      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Right to freedom of expression",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Separate treatment for unconvicted persons.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Accused persons shall be segregated from convicted persons.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "None"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-2-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Accused persons, convicted persons, and juvenile persons are classified.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classification of persons into different categories.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Class",
      "cml:premiseText": "None"
    },
