    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46pm-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption from obligation is valid within the specified temporal interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
