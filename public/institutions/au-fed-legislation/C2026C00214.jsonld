    {
      "@id": "concept:australian-human-rights-commission-act-1986-sec-4-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This compilation shows the text of the law as amended and in force on 4 June 2026.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies the text as a compilation of the Australian Human Rights Commission Act 1986.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The text is classified as a compilation."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sec-4-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Details of amendments made up to, but not commenced at, the compilation date are underlined in the endnotes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Provides information about amending laws and amendment history.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The notes at the end include information about amending laws."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sec-4-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Uncommenced amendments affecting the law are accessible on the Register (www.legislation.gov.au).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describes the effect of uncommenced amendments.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The effect of uncommenced amendments is not shown in the text of the compiled law."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sec-4-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Details are included in the endnotes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Provides information about applications, saving, and transitional provisions.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If the operation of a provision or amendment is affected by an application, saving, or transitional provision."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sec-4-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Presentational changes are applied to give a more consistent look and feel to legislation published on the Register.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describes presentational changes to the compilation.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The Legislation Act 2003 provides for First Parliamentary Counsel to make presentational changes."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sec-4-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compiled law operates as modified but the modification does not amend the text of the law.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describes modifications to the compiled law.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If the compiled law is modified by another law."
    },
