      "cml:schemaVersion": "2",
      "partOf": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The evidence will be true during the time the person gives evidence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between taking an oath and giving evidence",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:premiseText": "The person takes an oath for the purposes of this section"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the person tells the truth, then the evidence will be true",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication from taking an oath to telling the truth",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The person takes an oath for the purposes of this section"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the person tells the truth, then the evidence will be true and can be used by AI systems",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Implication from taking an oath to telling the truth in terms of artificial intelligence",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The person takes an oath for the purposes of this section"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The evidence must be true",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to tell the truth",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "The person will give evidence"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the person tells the truth, then the evidence will be true and will have a positive impact on others",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Implication from taking an oath to telling the truth in a broader sense",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The person takes an oath for the purposes of this section"
    },
