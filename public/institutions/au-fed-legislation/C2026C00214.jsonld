      "cml:conclusionText": "The President's term begins during the Commission's existence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relationship: The President's term begins during the Commission's existence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The Public Governance, Performance and Accountability Act 2013 establishes the Commission."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-8a-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The President has a responsibility to the Commission.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "The President's accountability implies their responsibility to the Commission.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The President is accountable to the Commission."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-8a-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Artificial intelligence recognizes the President's accountability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Artificial intelligence recognizes the President as an accountable authority.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:premiseText": "The President is an accountable authority."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-8a-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The President has an obligation to be accountable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Accountability obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The President is the accountable authority of the Commission."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-8a-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Accountability diffuses to the Commission's members.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The Commission's existence diffuses accountability to its members.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "The Commission exists and is accountable."
    },
