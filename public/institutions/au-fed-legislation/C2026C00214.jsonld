    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-2",
      "@type": "cml:Concept",
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.135",
      "skos:note": "Everyone has the right to hold opinions without interference. Accused persons shall be segregated from convicted persons and shall be subject to separate treatment.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "2 Section 2"
      },
      "wasDerivedFrom": "australian-human-rights-commission-act-1986.pdf",
      "asserts": [
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-2-norm",
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-2-logic-deontic-1",
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-2-logic-deontic-2",
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-2-logic-descriptionlogic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "a9b6eef8d612153ca5d42b5fcfc6c4a420d3b14e58f087081b72ad825109ac1d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-human-rights-commission-act-1986#sch-2-sec-2",
      "cml:schemaVersion": "2"
    },
