    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-3",
      "@type": "cml:Concept",
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.134",
      "skos:note": "No one shall be required to perform forced or compulsory labour.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3 Section 3"
      },
      "wasDerivedFrom": "australian-human-rights-commission-act-1986.pdf",
      "asserts": [
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-norm",
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-1",
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-2",
        "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "7da35810d252c57bea5122901c000d1b87e53efd42609af7400fde69e766fd43",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-human-rights-commission-act-1986#sch-2-sec-3",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No one shall be required to perform forced or compulsory labour.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The performance of hard labour in pursuance of a sentence to such punishment by a competent court is permitted.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "Paragraph 3(a) shall not be held to preclude, in countries where imprisonment with hard labour may be imposed as a punishment for a crime,"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Anyone who is arrested or detained on a criminal charge shall be brought promptly before a judge or other officer authorized by law to exercise judicial power.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Anyone arrested or detained on a criminal charge shall be brought promptly before a judge or other officer authorized by law to exercise judicial power and shall be entitled to trial within a reasonable time or to release."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-2-sec-3-norm",
      "@type": "doc:Prohibition",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:australian-human-rights-commission-act-1986-sch-2-sec-3"
    },
