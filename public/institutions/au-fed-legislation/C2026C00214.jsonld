        "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-ltl-3",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-diffusion-4",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "a5f604fa9f94470882a70b6e0ae22c3a9ce9613f141837ffd859accd02063202",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-human-rights-commission-act-1986#sch-5-sec-46mj",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The two provisions have overlapping conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The absence provision overlaps with the bankruptcy provision.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Both provisions specify a period of time during which the Commissioner's appointment can be terminated."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Governor-General has the power to make decisions about the Commissioner's appointment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The legislation implies that the Governor-General has discretion in terminating the Commissioner's appointment.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "The Governor-General is given authority to terminate the Commissioner's appointment under certain conditions."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner's appointment can only be terminated under specific circumstances.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Termination of appointment is prohibited under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "The Governor-General may not terminate the appointment without following these procedures."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Termination of appointment leads to a change in the Commissioner's status.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Termination of appointment implies a change in the Commissioner's status.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "When the Commissioner's appointment is terminated, their role and responsibilities are affected."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-46mj-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The absence provision has a repeating pattern.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The absence provision repeats every 12 months.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "The Commissioner is absent for 14 consecutive days, and this can happen again in the next 12 months."
    },
