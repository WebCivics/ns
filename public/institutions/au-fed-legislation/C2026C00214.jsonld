        "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-argumentation-3",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-diffusion-4",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "0f24ebd03281dc2a230fd6b8d5f11a8fa4b6b394f99f6f1750db304133284cd2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
