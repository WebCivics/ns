    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.24",
      "skos:note": "Appointment of Judge as member does not affect tenure.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "10(1) Appointment of Judge as member not to affect tenure etc."
      },
      "wasDerivedFrom": "australian-human-rights-commission-act-1986.pdf",
      "asserts": [
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-norm",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-deontic-1",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-alleninterval-2",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-ltl-3",
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-argumentation-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "540450b436fe66e93e9bd01c7b5bb615c825be8a60ca241e796b47b0a8b465c7",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-human-rights-commission-act-1986#sch-5-sec-10-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:australian-human-rights-commission-act-1986-sch-5-sec-10"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person’s tenure of that judicial office",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Service as a member occurs during tenure.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(1) The appointment of the holder of a judicial office as a member, or service by the holder of a judicial office as a member."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person’s rank, title, status, precedence, salary, annual or other allowances or other rights or privileges as the holder of that judicial office",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Service as a member implies no change in tenure.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(1) The appointment of the holder of a judicial office as a member, or service by the holder of a judicial office as a member."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person’s tenure of that judicial office or the person’s rank, title, status, precedence, salary, annual or other allowances or other rights or privileges as the holder of that judicial office",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Service as a member implies service as the holder of that judicial office.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(1) The appointment of the holder of a judicial office as a member, or service by the holder of a judicial office as a member."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-10-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person’s rank, title, status, precedence, salary, annual or other allowances or other rights or privileges as the holder of that judicial office",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Service as a member ends before tenure.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "(1) The appointment of the holder of a judicial office as a member, or service by the holder of a judicial office as a member."
    },
