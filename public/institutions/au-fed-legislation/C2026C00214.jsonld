    {
      "@id": "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2",
      "@type": "cml:Concept",
      "dc:description": "Evidence",
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.42",
      "skos:note": "Person must tell the truth when giving evidence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "22(2) Power to examine witnesses"
      },
      "wasDerivedFrom": "australian-human-rights-commission-act-1986.pdf",
      "asserts": [
        "concept:australian-human-rights-commission-act-1986-sch-5-sec-22-ss-2-norm",
