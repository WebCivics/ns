<https://ns.webcivics.net/concept/australian-human-rights-commission-act-1986-sch-2-sec-3> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-3>.
<https://ns.webcivics.net/concept/australian-human-rights-commission-act-1986-sch-2-sec-3-logic-deontic-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Anyone who is arrested or detained on a criminal charge shall be brought promptly before a judge or other officer authorized by law to exercise judicial power.";
    <https://ns.webcivics.net/cml/premiseText> "Anyone arrested or detained on a criminal charge shall be brought promptly before a judge or other officer authorized by law to exercise judicial power and shall be entitled to trial within a reasonable time or to release.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
