    <https://ns.webcivics.net/cml/logicSummary> "The performance of hard labour in pursuance of a sentence to such punishment by a competent court is permitted.";
    <https://ns.webcivics.net/cml/premiseText> "Paragraph 3(a) shall not be held to preclude, in countries where imprisonment with hard labour may be imposed as a punishment for a crime,";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
