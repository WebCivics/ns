doc:article-2 a cof:Section ;
    cof:title "2 Each Member for which this Convention is in force undertakes to declare" ;
    values:kind "section" ;
    values:originalText "and pursue a national policy designed to promote, by methods appropriate to national conditions and practice, equality of opportunity and treatment in respect of employment and occupation, with a view to eliminating any discrimination in respect thereof." ;
    cof:pageNumber "126"^^xsd:integer .

concept:australian-human-rights-commission-act-1986-article-3 a cml:Concept ;
    skos:prefLabel "3 Each Member for which this Convention is in force undertakes, by"@en ;
    cml:realizedBy doc:article-3 ;
    values:originalText "methods appropriate to national conditions and practice— (a) to seek the co-operation of employers’ and workers’ organisations and other appropriate bodies in promoting the acceptance and observance of this policy; (b) to enact such legislation and to promote such educational programmes as may be calculated to secure the acceptance and observance of the policy; (c) to repeal any statutory provisions and modify any administrative instructions or practices which are inconsistent with the policy; (d) to pursue the policy in respect of employment under the direct control of a national authority; (e) to ensure observance of the policy in the activities of vocational guidance, vocational training and placement services under the direction of a national authority;  Convention concerning Discrimination in respect of Employment and Occupation Schedule 1  Australian Human Rights Commission Act 1986  Compilation date: 04/06/2026  (f) to indicate in its annual reports on the application of the Convention the action taken in pursuance of the policy and the results secured by such action." ;
    skos:definition "methods appropriate to national conditions and practice— (a) to seek the co-operation of employers’ and workers’ organisations and other appropriate bodies in promoting the acceptance and observance of this policy; (b) to enact such legislation and to promote such educational programmes as may be calculated to secure the acceptance and observance of the policy; (c) to repeal any statutory provisions and modify any administrative instructions or practices which are inconsistent with the policy; (d) to pursue the policy in respect of employment under the direct control of a national authority; (e) to ensure observance of the policy in the activities of vocational guidance, vocational training and placement services under the direction of a national authority;  Convention concerning Discrimination in respect of Employment and Occupation Schedule 1  Australian Human Rights Commission Act 1986  Compilation date: 04/06/2026  (f) to indicate in its annual reports on the application of the Convention the action taken in pursuance of the policy and the results secured by such action."@en ;
    cml:integrityHash "5e3d84e15d21662aa540cbaf413df281a4b6a90668f851e22b950fb47ad6498e" ;
    cof:pageNumber "126"^^xsd:integer ;
    skos:note "Each Member undertakes to seek co-operation, enact legislation, and promote educational programmes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-human-rights-commission-act-1986.pdf> ;
    dc:source "australian-human-rights-commission-act-1986.pdf, p.126" ;
    cml:asserts concept:australian-human-rights-commission-act-1986-article-3-norm .
