doc:article-28 a cof:Section ;
    cof:title "28 1." ;
    values:kind "section" ;
    values:originalText "There shall be established a Human Rights Committee (hereafter referred to in the present Covenant as the Committee). It shall consist of eighteen members and shall carry out the functions hereinafter provided. 2. The Committee shall be composed of nationals of the States parties to the present Covenant who shall be persons of high moral character and recognized competence in the field of human rights, consideration being given to the usefulness of the participation of some persons having legal experience. 3. The members of the Committee shall be elected and shall serve in their personal capacity." ;
    cof:pageNumber "141"^^xsd:integer .

concept:australian-human-rights-commission-act-1986-article-29 a cml:Concept ;
    skos:prefLabel "29 1."@en ;
    cml:realizedBy doc:article-29 ;
    values:originalText "The members of the Committee shall be elected by secret ballot from a list of persons possessing the qualifications prescribed in article 28 and nominated for the purpose by the States Parties to the present Covenant. 2. Each State Party to the present Covenant may nominate not more than two persons. These persons shall be nationals of the nominating State. 3. A person shall be eligible for renomination." ;
    skos:definition "The members of the Committee shall be elected by secret ballot from a list of persons possessing the qualifications prescribed in article 28 and nominated for the purpose by the States Parties to the present Covenant. 2. Each State Party to the present Covenant may nominate not more than two persons. These persons shall be nationals of the nominating State. 3. A person shall be eligible for renomination."@en ;
    cml:integrityHash "7d2edbdce8438b64034df1f7194ecb150326efa6ee8c169ecc4f4cfe1ffacd72" ;
    cof:pageNumber "141"^^xsd:integer ;
    skos:note "Members of the Committee must be elected by secret ballot from a list of persons possessing certain qualifications." ;
    cml:curationStatus cml:Proposed ;
