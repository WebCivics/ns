concept:australian-human-rights-commission-act-1986-article-11-2 a cml:Concept ;
    skos:prefLabel "11 No one shall be imprisoned merely on the ground of inability to fulfil a"@en ;
    cml:realizedBy doc:article-11-2 ;
    values:originalText "contractual obligation." ;
    skos:definition "contractual obligation."@en ;
    cml:integrityHash "54fd60b74c6e3dcd53dbce4fcf5051c64cd3e1df20fd8d34e388653cef70a70b" ;
    cof:pageNumber "135"^^xsd:integer ;
    skos:note "No one shall be imprisoned solely due to inability to fulfill a contractual obligation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-human-rights-commission-act-1986.pdf> ;
    dc:source "australian-human-rights-commission-act-1986.pdf, p.135" ;
