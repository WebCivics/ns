doc:article-4 a cof:Section ;
    cof:title "4 Any measures affecting an individual who is justifiably suspected of, or" ;
    values:kind "section" ;
    values:originalText "engaged in, activities prejudicial to the security of the State shall not be deemed to be discrimination, provided that the individual concerned shall have the right to appeal to a competent body established in accordance with national practice." ;
    cof:pageNumber "127"^^xsd:integer .

concept:australian-human-rights-commission-act-1986-article-5 a cml:Concept ;
    skos:prefLabel "5 1."@en ;
    cml:realizedBy doc:article-5 ;
    values:originalText "Special measures of protection or assistance provided for in other Conventions or Recommendations adopted by the International Labour Conference shall not be deemed to be discrimination. 2. Any Member may, after consultation with representative employers’ and workers’ organisations, where such exist, determine that other special measures designed to meet the particular requirements of persons who, for reasons such as sex, age, disablement, family responsibilities or social or cultural status, are generally recognised to require special protection or assistance, shall not be deemed to be discrimination." ;
    skos:definition "Special measures of protection or assistance provided for in other Conventions or Recommendations adopted by the International Labour Conference shall not be deemed to be discrimination. 2. Any Member may, after consultation with representative employers’ and workers’ organisations, where such exist, determine that other special measures designed to meet the particular requirements of persons who, for reasons such as sex, age, disablement, family responsibilities or social or cultural status, are generally recognised to require special protection or assistance, shall not be deemed to be discrimination."@en ;
    cml:integrityHash "38e685a68ebf3ebc8cc8fa7bf8727728bd7e83b57d83c1690bf4248574f1d5fc" ;
    cof:pageNumber "127"^^xsd:integer ;
    skos:note "No discrimination for special measures of protection or assistance" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
