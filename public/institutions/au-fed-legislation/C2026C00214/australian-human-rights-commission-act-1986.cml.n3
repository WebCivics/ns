concept:australian-human-rights-commission-act-1986-article-27 a cml:Concept ;
    skos:prefLabel "27 In those States in which ethnic, religious or linguistic minorities exist,"@en ;
    cml:realizedBy doc:article-27 ;
    values:originalText "persons belonging to such minorities shall not be denied the right, in community with the other members of their group, to enjoy their own culture, to profess and practise their own religion, or to use their own language." ;
    skos:definition "persons belonging to such minorities shall not be denied the right, in community with the other members of their group, to enjoy their own culture, to profess and practise their own religion, or to use their own language."@en ;
