concept:australian-human-rights-commission-act-1986-article-11-2 cml:asserts concept:australian-human-rights-commission-act-1986-article-11-2-logic-deontic-1 .
concept:australian-human-rights-commission-act-1986-article-11-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imprisonment based on inability to fulfill contractual obligation is prohibited." ;
    cml:premiseText "Contractual obligations are binding." ;
    cml:conclusionText "No one shall be imprisoned solely due to inability to fulfill a contractual obligation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-human-rights-commission-act-1986-article-11-2 cml:asserts concept:australian-human-rights-commission-act-1986-article-11-2-logic-alleninterval-2 .
concept:australian-human-rights-commission-act-1986-article-11-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The prohibition on imprisonment based on inability to fulfill contractual obligations overlaps with the general principle of human dignity." ;
    cml:premiseText "Human dignity is a fundamental right." ;
    cml:conclusionText "Imprisonment based on inability to fulfill contractual obligations violates human dignity." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-human-rights-commission-act-1986-article-11-2 cml:asserts concept:australian-human-rights-commission-act-1986-article-11-2-logic-argumentation-3 .
concept:australian-human-rights-commission-act-1986-article-11-2-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "The prohibition on imprisonment based on inability to fulfill contractual obligations implies that individuals have the right to a fair trial." ;
    cml:premiseText "A fair trial is essential for ensuring justice." ;
    cml:conclusionText "Imprisonment based on inability to fulfill contractual obligations undermines the fairness of the trial process." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-human-rights-commission-act-1986-article-11-2 cml:asserts concept:australian-human-rights-commission-act-1986-article-11-2-logic-diffusion-4 .
concept:australian-human-rights-commission-act-1986-article-11-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Implication" ;
    cml:logicSummary "The prohibition on imprisonment based on inability to fulfill contractual obligations implies that individuals have access to social services and support." ;
    cml:premiseText "Social services and support are essential for ensuring individual well-being." ;
    cml:conclusionText "Imprisonment based on inability to fulfill contractual obligations restricts access to social services and support." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-human-rights-commission-act-1986-article-11-2 cml:asserts concept:australian-human-rights-commission-act-1986-article-11-2-logic-cogai-5 .
