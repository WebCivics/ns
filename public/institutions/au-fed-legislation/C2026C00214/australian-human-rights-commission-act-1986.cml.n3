concept:australian-human-rights-commission-act-1986-article-25 a cml:Concept ;
    skos:prefLabel "25 Every citizen shall have the right and the opportunity, without any of the"@en ;
    cml:realizedBy doc:article-25 ;
    values:originalText "distinctions mentioned in article 2 and without unreasonable restrictions: (a) To take part in the conduct of public affairs, directly or through freely chosen representatives; (b) To vote and to be elected at genuine periodic elections which shall be by universal and equal suffrage and shall be held by secret ballot, guaranteeing the free expression of the will of the electors; (c) To have access, on general terms of equality, to public service in his country." ;
    skos:definition "distinctions mentioned in article 2 and without unreasonable restrictions: (a) To take part in the conduct of public affairs, directly or through freely chosen representatives; (b) To vote and to be elected at genuine periodic elections which shall be by universal and equal suffrage and shall be held by secret ballot, guaranteeing the free expression of the will of the electors; (c) To have access, on general terms of equality, to public service in his country."@en ;
    cml:integrityHash "cf42aec1b1cfca873020b4ac394804f7f31744253b6678fe7476718362cca4ad" ;
    cof:pageNumber "140"^^xsd:integer ;
    skos:note "Every citizen has the right and opportunity to participate in public affairs, vote, and access public services." ;
    cml:curationStatus cml:Proposed ;
