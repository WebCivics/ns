  executionSurface: modalities::dl;
  curationStatus: Proposed;
  @condition: Disabled persons are entitled to have their special needs taken into consideration at all stages of economic and social planning.;
}

australian-human-rights-commission-act-1986-sch-5-sec-6-logic-93 {
  activation: 0.5000;
  type: LogicApplication;
  provision: sch-5-sec-6;
  logic: Deontic;
  operator: shall be protected;
  summary: Implies a duty or obligation.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
