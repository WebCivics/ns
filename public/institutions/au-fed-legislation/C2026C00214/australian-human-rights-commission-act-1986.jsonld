      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Discrimination is defined as distinctions, exclusions or preferences affecting equality of opportunity or treatment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
