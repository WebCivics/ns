      },
      "cml:operator": ">=",
      "cml:logicSummary": "The Secretary-General of the United Nations shall submit the list of persons nominated for membership of the Committee no later than one month before the date of each election.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-30-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "&",
      "cml:logicSummary": "The Secretary-General of the United Nations shall address a written invitation to States Parties at least four months before the date of each election.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
