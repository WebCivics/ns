      },
      "cml:conclusionText": "The Committee shall normally meet at the Headquarters of the United Nations or at the United Nations Office at Geneva."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-37-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
