    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.127",
      "values:originalText": "This Convention shall be binding only upon those Members of the\nInternational Labour Organisation whose ratifications have been registered with\nthe Director-General.\n2.\nIt shall come into force twelve months after the date on which the\nratifications of two Members have been registered with the Director-General.\n\nSchedule 1  Convention concerning Discrimination in respect of Employment and\nOccupation\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n3.\nThereafter, this Convention shall come into force for any Member\ntwelve months after the date on which its ratification has been registered.",
      "skos:definition": "This Convention shall be binding only upon those Members of the\nInternational Labour Organisation whose ratifications have been registered with\nthe Director-General.\n2.\nIt shall come into force twelve months after the date on which the\nratifications of two Members have been registered with the Director-General.\n\nSchedule 1  Convention concerning Discrimination in respect of Employment and\nOccupation\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n3.\nThereafter, this Convention shall come into force for any Member\ntwelve months after the date on which its ratification has been registered.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-8-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af73311282702a8482cbbae7266242f58f07f4a353235910b2e0fee353b8ae62",
      "skos:note": "Convention shall be binding only upon those Members whose ratifications have been registered with the Director-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-8",
      "@type": "cof:Section",
      "cof:title": "8 1.",
      "values:kind": "section",
      "cof:pageNumber": 127,
      "values:originalText": "This Convention shall be binding only upon those Members of the\nInternational Labour Organisation whose ratifications have been registered with\nthe Director-General.\n2.\nIt shall come into force twelve months after the date on which the\nratifications of two Members have been registered with the Director-General.\n\nSchedule 1  Convention concerning Discrimination in respect of Employment and\nOccupation\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n3.\nThereafter, this Convention shall come into force for any Member\ntwelve months after the date on which its ratification has been registered."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-8-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-8"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to be binding on registered Members",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Ratification registration with Director-General",
      "cml:conclusionText": "Convention shall be binding"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.128",
      "values:originalText": "A Member which has ratified this Convention may denounce it after\nthe expiration of ten years from the date on which the Convention first comes\ninto force, by an act communicated to the Director-General of the International\nLabour Office for registration.\nSuch denunciation shall not take effect until one year after the date on which it\nis registered.\n2.\nEach Member which has ratified this Convention and which does not,\nwithin the year following the expiration of the period of ten years mentioned in\nthe preceding paragraph, exercise the right of denunciation provided for in this\nArticle, will be bound for another period of ten years and, thereafter, may\ndenounce this Convention at the expiration of each period of ten years under the\nterms provided for in this Article.",
      "skos:definition": "A Member which has ratified this Convention may denounce it after\nthe expiration of ten years from the date on which the Convention first comes\ninto force, by an act communicated to the Director-General of the International\nLabour Office for registration.\nSuch denunciation shall not take effect until one year after the date on which it\nis registered.\n2.\nEach Member which has ratified this Convention and which does not,\nwithin the year following the expiration of the period of ten years mentioned in\nthe preceding paragraph, exercise the right of denunciation provided for in this\nArticle, will be bound for another period of ten years and, thereafter, may\ndenounce this Convention at the expiration of each period of ten years under the\nterms provided for in this Article.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-9-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-9-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-9-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "378f73a6d2717869f530766471a7d4c98c36efeef1f3497ce286be47a7b5f77a",
      "skos:note": "Denunciation of the Convention after 10 years from its entry into force."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-9",
      "@type": "cof:Section",
      "cof:title": "9 1.",
      "values:kind": "section",
      "cof:pageNumber": 128,
      "values:originalText": "A Member which has ratified this Convention may denounce it after\nthe expiration of ten years from the date on which the Convention first comes\ninto force, by an act communicated to the Director-General of the International\nLabour Office for registration.\nSuch denunciation shall not take effect until one year after the date on which it\nis registered.\n2.\nEach Member which has ratified this Convention and which does not,\nwithin the year following the expiration of the period of ten years mentioned in\nthe preceding paragraph, exercise the right of denunciation provided for in this\nArticle, will be bound for another period of ten years and, thereafter, may\ndenounce this Convention at the expiration of each period of ten years under the\nterms provided for in this Article."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-9-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
