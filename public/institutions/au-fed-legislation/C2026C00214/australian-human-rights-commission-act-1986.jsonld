    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-4-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Allowance",
      "cml:logicSummary": "State may derogate from Covenant obligations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
