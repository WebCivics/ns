      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.142",
      "values:originalText": "The Committee may not include more than one national of the same\nState.\n2.\nIn the election of the Committee, consideration shall be given to\nequitable geographical distribution of membership and to the representation of\nthe different forms of civilization and of the principal legal systems.",
      "skos:definition": "The Committee may not include more than one national of the same\nState.\n2.\nIn the election of the Committee, consideration shall be given to\nequitable geographical distribution of membership and to the representation of\nthe different forms of civilization and of the principal legal systems.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-31-norm"
        }
      ],
      "cml:integrityHash": "ba7935933e0cb969c9f2c5ce31f51ed765b2c8737565de59288745c2a9474ac5",
      "skos:note": "Limitation on Committee membership by nationality."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-31",
      "@type": "cof:Section",
      "cof:title": "31 1.",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "The Committee may not include more than one national of the same\nState.\n2.\nIn the election of the Committee, consideration shall be given to\nequitable geographical distribution of membership and to the representation of\nthe different forms of civilization and of the principal legal systems."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-31-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-31"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.142",
      "values:originalText": "The members of the Committee shall be elected for a term of four\nyears. They shall be eligible for re-election if renominated. However, the terms\nof nine of the members elected at the first election shall expire at the end of two\nyears; immediately after the first election, the names of these nine members\nshall be chosen by lot by the Chairman of the meeting referred to in article 30,\nparagraph 4.\n2.\nElections at the expiry of office shall be held in accordance with the\npreceding articles of this part of the present Covenant.",
      "skos:definition": "The members of the Committee shall be elected for a term of four\nyears. They shall be eligible for re-election if renominated. However, the terms\nof nine of the members elected at the first election shall expire at the end of two\nyears; immediately after the first election, the names of these nine members\nshall be chosen by lot by the Chairman of the meeting referred to in article 30,\nparagraph 4.\n2.\nElections at the expiry of office shall be held in accordance with the\npreceding articles of this part of the present Covenant.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-32-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d53238afc162c27af706f719a144afb8fd8336c9db986b95e42d65f7980683ce",
      "skos:note": "Members of the Committee must be re-elected after four years."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-32",
      "@type": "cof:Section",
      "cof:title": "32 1.",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "The members of the Committee shall be elected for a term of four\nyears. They shall be eligible for re-election if renominated. However, the terms\nof nine of the members elected at the first election shall expire at the end of two\nyears; immediately after the first election, the names of these nine members\nshall be chosen by lot by the Chairman of the meeting referred to in article 30,\nparagraph 4.\n2.\nElections at the expiry of office shall be held in accordance with the\npreceding articles of this part of the present Covenant."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-32-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-32"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-32-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Members of the Committee must be re-elected after four years.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 International Covenant on Civil and Political Rights  Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.142",
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n1.\nIf, in the unanimous opinion of the other members, a member of the\nCommittee has ceased to carry out his functions for any cause other than\nabsence of a temporary character, the Chairman of the Committee shall notify\nthe Secretary-General of the United Nations, who shall then declare the seat of\nthat member to be vacant.\n2.\nIn the event of the death or the resignation of a member of the\nCommittee, the Chairman shall immediately notify the Secretary-General of the\nUnited Nations, who shall declare the seat vacant from the date of death or the\ndate on which the resignation takes effect.",
      "skos:definition": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n1.\nIf, in the unanimous opinion of the other members, a member of the\nCommittee has ceased to carry out his functions for any cause other than\nabsence of a temporary character, the Chairman of the Committee shall notify\nthe Secretary-General of the United Nations, who shall then declare the seat of\nthat member to be vacant.\n2.\nIn the event of the death or the resignation of a member of the\nCommittee, the Chairman shall immediately notify the Secretary-General of the\nUnited Nations, who shall declare the seat vacant from the date of death or the\ndate on which the resignation takes effect.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-33-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f990d4f4b5bd6a475a125b6e4605ea8599efe76c959b1d43909253d21028ffc",
      "skos:note": "Notification of vacant seat in the Committee."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-33",
      "@type": "cof:Section",
      "cof:title": "33 International Covenant on Civil and Political Rights  Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n1.\nIf, in the unanimous opinion of the other members, a member of the\nCommittee has ceased to carry out his functions for any cause other than\nabsence of a temporary character, the Chairman of the Committee shall notify\nthe Secretary-General of the United Nations, who shall then declare the seat of\nthat member to be vacant.\n2.\nIn the event of the death or the resignation of a member of the\nCommittee, the Chairman shall immediately notify the Secretary-General of the\nUnited Nations, who shall declare the seat vacant from the date of death or the\ndate on which the resignation takes effect."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-33-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-33"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-33-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:logicSummary": "Imperative obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.143",
      "values:originalText": "When a vacancy is declared in accordance with article 33 and if the\nterm of office of the member to be replaced does not expire within six months\nof the declaration of the vacancy, the Secretary-General of the United Nations\nshall notify each of the States Parties to the present Covenant, which may\nwithin two months submit nominations in accordance with article 29 for the\npurpose of filling the vacancy.\n2.\nThe Secretary-General of the United Nations shall prepare a list in\nalphabetical order of the persons thus nominated and shall submit it to the States\nParties to the present Covenant. The election to fill the vacancy shall then take\nplace in accordance with the relevant provisions of this part of the present\nCovenant.\n3.\nA member of the Committee elected to fill a vacancy declared in\naccordance with article 33 shall hold office for the remainder of the term of the\nmember who vacated the seat on the Committee under the provisions of that\narticle.",
      "skos:definition": "When a vacancy is declared in accordance with article 33 and if the\nterm of office of the member to be replaced does not expire within six months\nof the declaration of the vacancy, the Secretary-General of the United Nations\nshall notify each of the States Parties to the present Covenant, which may\nwithin two months submit nominations in accordance with article 29 for the\npurpose of filling the vacancy.\n2.\nThe Secretary-General of the United Nations shall prepare a list in\nalphabetical order of the persons thus nominated and shall submit it to the States\nParties to the present Covenant. The election to fill the vacancy shall then take\nplace in accordance with the relevant provisions of this part of the present\nCovenant.\n3.\nA member of the Committee elected to fill a vacancy declared in\naccordance with article 33 shall hold office for the remainder of the term of the\nmember who vacated the seat on the Committee under the provisions of that\narticle.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-34-norm"
        }
      ],
      "cml:integrityHash": "5b22f68ba8c759216a6d4a9b796e2ba93f5218180bee1da98f55b923876311e1",
      "skos:note": "Procedure for filling vacancies in the Committee"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-34",
      "@type": "cof:Section",
      "cof:title": "34 1.",
      "values:kind": "section",
      "cof:pageNumber": 143,
      "values:originalText": "When a vacancy is declared in accordance with article 33 and if the\nterm of office of the member to be replaced does not expire within six months\nof the declaration of the vacancy, the Secretary-General of the United Nations\nshall notify each of the States Parties to the present Covenant, which may\nwithin two months submit nominations in accordance with article 29 for the\npurpose of filling the vacancy.\n2.\nThe Secretary-General of the United Nations shall prepare a list in\nalphabetical order of the persons thus nominated and shall submit it to the States\nParties to the present Covenant. The election to fill the vacancy shall then take\nplace in accordance with the relevant provisions of this part of the present\nCovenant.\n3.\nA member of the Committee elected to fill a vacancy declared in\naccordance with article 33 shall hold office for the remainder of the term of the\nmember who vacated the seat on the Committee under the provisions of that\narticle."
    },
