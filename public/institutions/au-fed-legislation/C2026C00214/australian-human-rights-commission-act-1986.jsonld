      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.149",
      "values:originalText": "provisions of the Charter of the United Nations and of the constitutions of the\nspecialized agencies which define the respective responsibilities of the various\norgans of the United Nations and of the specialized agencies in regard to the\nmatters dealt with in the present Covenant.",
      "skos:definition": "provisions of the Charter of the United Nations and of the constitutions of the\nspecialized agencies which define the respective responsibilities of the various\norgans of the United Nations and of the specialized agencies in regard to the\nmatters dealt with in the present Covenant.",
      "cml:asserts": [
