        }
      ],
      "cml:integrityHash": "472623ea6f8b337890a8978d12a5ac465fbdf86d0606558e98b519edfceb8653",
      "skos:note": "Member states that ratify this Convention must apply it to non-metropolitan territories."
    },
    {
