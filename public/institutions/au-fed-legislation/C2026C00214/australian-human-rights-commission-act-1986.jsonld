      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.129",
      "values:originalText": "authoritative.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026",
      "skos:definition": "authoritative.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-14-norm"
        }
      ],
      "cml:integrityHash": "5190e00ab89a074d00dd3900fcea46f295a04460407557ae6da610d6fc08828d",
      "skos:note": "The English and French versions of the text of this Convention are equally authoritative."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-14",
      "@type": "cof:Section",
      "cof:title": "14 The English and French versions of the text of this Convention are equally",
      "values:kind": "section",
      "cof:pageNumber": 129,
      "values:originalText": "authoritative.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-14-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
