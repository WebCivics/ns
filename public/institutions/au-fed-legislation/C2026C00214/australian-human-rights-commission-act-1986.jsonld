      "skos:note": "Provisions apply to all parts of federal states without limitations or exceptions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-50",
      "@type": "cof:Section",
      "cof:title": "50 The provisions of the present Covenant shall extend to all parts of federal",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "States without any limitations or exceptions."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-50-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-50"
      },
      "values:deonticStatus": {
