      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.127",
      "values:originalText": "non-metropolitan territories in accordance with the provisions of the\nConstitution of the International Labour Organisation.",
      "skos:definition": "non-metropolitan territories in accordance with the provisions of the\nConstitution of the International Labour Organisation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-6-norm"
        },
