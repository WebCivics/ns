      "cml:premiseText": "Article 9, paragraph 2",
      "cml:conclusionText": "Denunciation after 10 years from entry into force."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.128",
      "values:originalText": "The Director-General of the International Labour Office shall notify\nall Members of the International Labour Organisation of the registration of all\nratifications and denunciations communicated to him by the Members of the\nOrganisation.\n2.\nWhen notifying the members of the Organisation of the registration of\nthe second ratification communicated to him, the Director-General shall draw\nthe attention of the Members of the Organisation to the date upon which the\nConvention will come into force.",
      "skos:definition": "The Director-General of the International Labour Office shall notify\nall Members of the International Labour Organisation of the registration of all\nratifications and denunciations communicated to him by the Members of the\nOrganisation.\n2.\nWhen notifying the members of the Organisation of the registration of\nthe second ratification communicated to him, the Director-General shall draw\nthe attention of the Members of the Organisation to the date upon which the\nConvention will come into force.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-10-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ee82f5cb79d036b80dcfa5e7cf0a7233dec38696b38954ad8891c983bd01f2ed",
      "skos:note": "Notification of ratifications and denunciations to International Labour Organisation Members"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-10",
      "@type": "cof:Section",
      "cof:title": "10 1.",
      "values:kind": "section",
      "cof:pageNumber": 128,
      "values:originalText": "The Director-General of the International Labour Office shall notify\nall Members of the International Labour Organisation of the registration of all\nratifications and denunciations communicated to him by the Members of the\nOrganisation.\n2.\nWhen notifying the members of the Organisation of the registration of\nthe second ratification communicated to him, the Director-General shall draw\nthe attention of the Members of the Organisation to the date upon which the\nConvention will come into force."
    },
