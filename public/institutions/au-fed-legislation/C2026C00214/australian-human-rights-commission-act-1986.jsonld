    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Every citizen shall have the right and the opportunity, without any of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.140",
      "values:originalText": "distinctions mentioned in article 2 and without unreasonable restrictions:\n(a) To take part in the conduct of public affairs, directly or through freely\nchosen representatives;\n(b) To vote and to be elected at genuine periodic elections which shall be\nby universal and equal suffrage and shall be held by secret ballot, guaranteeing\nthe free expression of the will of the electors;\n(c) To have access, on general terms of equality, to public service in his\ncountry.",
      "skos:definition": "distinctions mentioned in article 2 and without unreasonable restrictions:\n(a) To take part in the conduct of public affairs, directly or through freely\nchosen representatives;\n(b) To vote and to be elected at genuine periodic elections which shall be\nby universal and equal suffrage and shall be held by secret ballot, guaranteeing\nthe free expression of the will of the electors;\n(c) To have access, on general terms of equality, to public service in his\ncountry.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-25-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cf42aec1b1cfca873020b4ac394804f7f31744253b6678fe7476718362cca4ad",
      "skos:note": "Every citizen has the right and opportunity to participate in public affairs, vote, and access public services."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-25",
      "@type": "cof:Section",
      "cof:title": "25 Every citizen shall have the right and the opportunity, without any of the",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "distinctions mentioned in article 2 and without unreasonable restrictions:\n(a) To take part in the conduct of public affairs, directly or through freely\nchosen representatives;\n(b) To vote and to be elected at genuine periodic elections which shall be\nby universal and equal suffrage and shall be held by secret ballot, guaranteeing\nthe free expression of the will of the electors;\n(c) To have access, on general terms of equality, to public service in his\ncountry."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-25-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-25"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "held by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-25-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRight",
      "cml:logicSummary": "Article 25 defines a right for citizens.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 All persons are equal before the law and are entitled without any",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.140",
      "values:originalText": "discrimination to the equal protection of the law. In this respect, the law shall\nprohibit any discrimination and guarantee to all persons equal and effective\n\nInternational Covenant on Civil and Political Rights  Schedule 2\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nprotection against discrimination on any ground such as race, colour, sex,\nlanguage, religion, political or other opinion, national or social origin, property,\nbirth or other status.",
      "skos:definition": "discrimination to the equal protection of the law. In this respect, the law shall\nprohibit any discrimination and guarantee to all persons equal and effective\n\nInternational Covenant on Civil and Political Rights  Schedule 2\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nprotection against discrimination on any ground such as race, colour, sex,\nlanguage, religion, political or other opinion, national or social origin, property,\nbirth or other status.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-26-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0cd418aa8578f14bc5f281941940e40608c2059f6bd5b29add2bc9a307120dd4",
      "skos:note": "Prohibits discrimination on any ground"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-26",
      "@type": "cof:Section",
      "cof:title": "26 All persons are equal before the law and are entitled without any",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "discrimination to the equal protection of the law. In this respect, the law shall\nprohibit any discrimination and guarantee to all persons equal and effective\n\nInternational Covenant on Civil and Political Rights  Schedule 2\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nprotection against discrimination on any ground such as race, colour, sex,\nlanguage, religion, political or other opinion, national or social origin, property,\nbirth or other status."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-26-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-26"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-26-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No discrimination allowed",
      "cml:conclusionText": "Action forbidden"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 In those States in which ethnic, religious or linguistic minorities exist,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.141",
      "values:originalText": "persons belonging to such minorities shall not be denied the right, in community\nwith the other members of their group, to enjoy their own culture, to profess and\npractise their own religion, or to use their own language.",
      "skos:definition": "persons belonging to such minorities shall not be denied the right, in community\nwith the other members of their group, to enjoy their own culture, to profess and\npractise their own religion, or to use their own language.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-27-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-27-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3edbd0c98650b85e23a9976243a543b3fbccc895e966b601cfe84d9fa65d799e",
      "skos:note": "Right to enjoy own culture, religion, or language in community with other members of minority group."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-27",
      "@type": "cof:Section",
      "cof:title": "27 In those States in which ethnic, religious or linguistic minorities exist,",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "persons belonging to such minorities shall not be denied the right, in community\nwith the other members of their group, to enjoy their own culture, to profess and\npractise their own religion, or to use their own language."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-27-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-27"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "held by: NaturalPerson"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-27-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRight",
      "cml:logicSummary": "Right to enjoy own culture, religion, or language.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Persons belonging to minority groups shall not be denied...",
      "cml:conclusionText": "...the right to enjoy their own culture..."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.141",
      "values:originalText": "There shall be established a Human Rights Committee (hereafter\nreferred to in the present Covenant as the Committee). It shall consist of\neighteen members and shall carry out the functions hereinafter provided.\n2.\nThe Committee shall be composed of nationals of the States parties to\nthe present Covenant who shall be persons of high moral character and\nrecognized competence in the field of human rights, consideration being given\nto the usefulness of the participation of some persons having legal experience.\n3.\nThe members of the Committee shall be elected and shall serve in\ntheir personal capacity.",
      "skos:definition": "There shall be established a Human Rights Committee (hereafter\nreferred to in the present Covenant as the Committee). It shall consist of\neighteen members and shall carry out the functions hereinafter provided.\n2.\nThe Committee shall be composed of nationals of the States parties to\nthe present Covenant who shall be persons of high moral character and\nrecognized competence in the field of human rights, consideration being given\nto the usefulness of the participation of some persons having legal experience.\n3.\nThe members of the Committee shall be elected and shall serve in\ntheir personal capacity.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-28-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-28-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e49d361c97c5318185f746a200595fe72654af511c0833b6242cf4743eb4d104",
      "skos:note": "Establishment of Human Rights Committee"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-28",
      "@type": "cof:Section",
      "cof:title": "28 1.",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "There shall be established a Human Rights Committee (hereafter\nreferred to in the present Covenant as the Committee). It shall consist of\neighteen members and shall carry out the functions hereinafter provided.\n2.\nThe Committee shall be composed of nationals of the States parties to\nthe present Covenant who shall be persons of high moral character and\nrecognized competence in the field of human rights, consideration being given\nto the usefulness of the participation of some persons having legal experience.\n3.\nThe members of the Committee shall be elected and shall serve in\ntheir personal capacity."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-28-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-28"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-28-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "establishes",
      "cml:logicSummary": "Establishes the Human Rights Committee",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.141",
      "values:originalText": "The members of the Committee shall be elected by secret ballot from\na list of persons possessing the qualifications prescribed in article 28 and\nnominated for the purpose by the States Parties to the present Covenant.\n2.\nEach State Party to the present Covenant may nominate not more than\ntwo persons. These persons shall be nationals of the nominating State.\n3.\nA person shall be eligible for renomination.",
      "skos:definition": "The members of the Committee shall be elected by secret ballot from\na list of persons possessing the qualifications prescribed in article 28 and\nnominated for the purpose by the States Parties to the present Covenant.\n2.\nEach State Party to the present Covenant may nominate not more than\ntwo persons. These persons shall be nationals of the nominating State.\n3.\nA person shall be eligible for renomination.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-29-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7d2edbdce8438b64034df1f7194ecb150326efa6ee8c169ecc4f4cfe1ffacd72",
      "skos:note": "Members of the Committee must be elected by secret ballot from a list of persons possessing certain qualifications."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-29",
      "@type": "cof:Section",
      "cof:title": "29 1.",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "The members of the Committee shall be elected by secret ballot from\na list of persons possessing the qualifications prescribed in article 28 and\nnominated for the purpose by the States Parties to the present Covenant.\n2.\nEach State Party to the present Covenant may nominate not more than\ntwo persons. These persons shall be nationals of the nominating State.\n3.\nA person shall be eligible for renomination."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-29-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-29"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-29-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Members must be elected",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Article 29.1",
      "cml:conclusionText": "Member election is obligatory"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.141",
      "values:originalText": "The initial election shall be held no later than six months after the date\nof the entry into force of the present Covenant.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n2.\nAt least four months before the date of each election to the\nCommittee, other than an election to fill a vacancy declared in accordance with\narticle 34, the Secretary-General of the United Nations shall address a written\ninvitation to the States Parties to the present Covenant to submit their\nnominations for membership of the Committee within three months.\n3.\nThe Secretary-General of the United Nations shall prepare a list in\nalphabetical order of all the persons thus nominated, with an indication of the\nStates Parties which have nominated them, and shall submit it to the States\nParties to the present Covenant no later than one month before the date of each\nelection.\n4.\nElections of the members of the Committee shall be held at a meeting\nof the States Parties to the present Covenant convened by the Secretary-General\nof the United Nations at the Headquarters of the United Nations. At that\nmeeting, for which two thirds of the States Parties to the present covenant shall\nconstitute a quorum, the persons elected to the Committee shall be those\nnominees who obtain the largest number of votes and an absolute majority of\nthe votes of the representatives of States Parties present and voting.",
      "skos:definition": "The initial election shall be held no later than six months after the date\nof the entry into force of the present Covenant.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n2.\nAt least four months before the date of each election to the\nCommittee, other than an election to fill a vacancy declared in accordance with\narticle 34, the Secretary-General of the United Nations shall address a written\ninvitation to the States Parties to the present Covenant to submit their\nnominations for membership of the Committee within three months.\n3.\nThe Secretary-General of the United Nations shall prepare a list in\nalphabetical order of all the persons thus nominated, with an indication of the\nStates Parties which have nominated them, and shall submit it to the States\nParties to the present Covenant no later than one month before the date of each\nelection.\n4.\nElections of the members of the Committee shall be held at a meeting\nof the States Parties to the present Covenant convened by the Secretary-General\nof the United Nations at the Headquarters of the United Nations. At that\nmeeting, for which two thirds of the States Parties to the present covenant shall\nconstitute a quorum, the persons elected to the Committee shall be those\nnominees who obtain the largest number of votes and an absolute majority of\nthe votes of the representatives of States Parties present and voting.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-30-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-30-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-30-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-30-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "1e8fa4507983a54945d423a951fe7bd938cc06ce1c7b390ceed631a2dcddb7d7",
      "skos:note": "The Secretary-General of the United Nations shall address a written invitation to States Parties to submit their nominations for membership of the Committee within three months."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-30",
      "@type": "cof:Section",
      "cof:title": "30 1.",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "The initial election shall be held no later than six months after the date\nof the entry into force of the present Covenant.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n2.\nAt least four months before the date of each election to the\nCommittee, other than an election to fill a vacancy declared in accordance with\narticle 34, the Secretary-General of the United Nations shall address a written\ninvitation to the States Parties to the present Covenant to submit their\nnominations for membership of the Committee within three months.\n3.\nThe Secretary-General of the United Nations shall prepare a list in\nalphabetical order of all the persons thus nominated, with an indication of the\nStates Parties which have nominated them, and shall submit it to the States\nParties to the present Covenant no later than one month before the date of each\nelection.\n4.\nElections of the members of the Committee shall be held at a meeting\nof the States Parties to the present Covenant convened by the Secretary-General\nof the United Nations at the Headquarters of the United Nations. At that\nmeeting, for which two thirds of the States Parties to the present covenant shall\nconstitute a quorum, the persons elected to the Committee shall be those\nnominees who obtain the largest number of votes and an absolute majority of\nthe votes of the representatives of States Parties present and voting."
    },
