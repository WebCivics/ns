      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "The terms employment and occupation include access to vocational training, employment and particular occupations.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
