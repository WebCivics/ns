    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Any measures affecting an individual who is justifiably suspected of, or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.127",
      "values:originalText": "engaged in, activities prejudicial to the security of the State shall not be deemed\nto be discrimination, provided that the individual concerned shall have the right\nto appeal to a competent body established in accordance with national practice.",
      "skos:definition": "engaged in, activities prejudicial to the security of the State shall not be deemed\nto be discrimination, provided that the individual concerned shall have the right\nto appeal to a competent body established in accordance with national practice.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-4-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a7d92167e67dd04ba4ed79ca7e8873e869c6cbd09ee360de66a50977cc013f6f",
      "skos:note": "Right to appeal in case of suspicion"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-4",
      "@type": "cof:Section",
      "cof:title": "4 Any measures affecting an individual who is justifiably suspected of, or",
      "values:kind": "section",
      "cof:pageNumber": 127,
      "values:originalText": "engaged in, activities prejudicial to the security of the State shall not be deemed\nto be discrimination, provided that the individual concerned shall have the right\nto appeal to a competent body established in accordance with national practice."
    },
