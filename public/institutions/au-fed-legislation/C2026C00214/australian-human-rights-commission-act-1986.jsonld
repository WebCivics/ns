      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Irrespective of the notifications made under article 48, paragraph 5, the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.151",
      "values:originalText": "Secretary-General of the United Nations shall inform all States referred to in\nparagraph 1 of the same article of the following particulars:\n(a) Signatures, ratifications and accessions under article 48;\n(b) The date of the entry into force of the present Covenant under article\n49 and the date of the entry into force of any amendments under article 51.",
      "skos:definition": "Secretary-General of the United Nations shall inform all States referred to in\nparagraph 1 of the same article of the following particulars:\n(a) Signatures, ratifications and accessions under article 48;\n(b) The date of the entry into force of the present Covenant under article\n49 and the date of the entry into force of any amendments under article 51.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-52-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-52-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bafd110299306504000a40f1b5cd520e5dc1a9f902c417a659623eda40cc8724",
      "skos:note": "States must be informed of certain particulars by the Secretary-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-52",
      "@type": "cof:Section",
      "cof:title": "52 Irrespective of the notifications made under article 48, paragraph 5, the",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "Secretary-General of the United Nations shall inform all States referred to in\nparagraph 1 of the same article of the following particulars:\n(a) Signatures, ratifications and accessions under article 48;\n(b) The date of the entry into force of the present Covenant under article\n49 and the date of the entry into force of any amendments under article 51."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-52-norm",
