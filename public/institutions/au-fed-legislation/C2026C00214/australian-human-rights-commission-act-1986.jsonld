    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.149",
      "values:originalText": "The present Covenant is open for signature by any State Member of\nthe United Nations or member of any of its specialized agencies, by any State\nParty to the Statute of the International Court of Justice, and by any other State\nwhich has been invited by the General Assembly of the United Nations to\nbecome a party to the present Covenant.\n2.\nThe present Covenant is subject to ratification. Instruments of\nratification shall be deposited with the Secretary-General of the United Nations.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n3.\nThe present Covenant shall be open to accession by any State referred\nto in paragraph 1 of this article.\n4.\nAccession shall be effected by the deposit of an instrument of\naccession with the Secretary-General of the United Nations.\n5.\nThe Secretary-General of the United Nations shall inform all States\nwhich have signed this Covenant or acceded to it of the deposit of each\ninstrument of ratification or accession.",
      "skos:definition": "The present Covenant is open for signature by any State Member of\nthe United Nations or member of any of its specialized agencies, by any State\nParty to the Statute of the International Court of Justice, and by any other State\nwhich has been invited by the General Assembly of the United Nations to\nbecome a party to the present Covenant.\n2.\nThe present Covenant is subject to ratification. Instruments of\nratification shall be deposited with the Secretary-General of the United Nations.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n3.\nThe present Covenant shall be open to accession by any State referred\nto in paragraph 1 of this article.\n4.\nAccession shall be effected by the deposit of an instrument of\naccession with the Secretary-General of the United Nations.\n5.\nThe Secretary-General of the United Nations shall inform all States\nwhich have signed this Covenant or acceded to it of the deposit of each\ninstrument of ratification or accession.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-48-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-48-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "48258a214c825d3278e3bda2f70eacec6c9ed432469e38e4824739a053b96920",
      "skos:note": "States can sign or accede to the Covenant."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-48",
      "@type": "cof:Section",
      "cof:title": "48 1.",
      "values:kind": "section",
      "cof:pageNumber": 149,
      "values:originalText": "The present Covenant is open for signature by any State Member of\nthe United Nations or member of any of its specialized agencies, by any State\nParty to the Statute of the International Court of Justice, and by any other State\nwhich has been invited by the General Assembly of the United Nations to\nbecome a party to the present Covenant.\n2.\nThe present Covenant is subject to ratification. Instruments of\nratification shall be deposited with the Secretary-General of the United Nations.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n3.\nThe present Covenant shall be open to accession by any State referred\nto in paragraph 1 of this article.\n4.\nAccession shall be effected by the deposit of an instrument of\naccession with the Secretary-General of the United Nations.\n5.\nThe Secretary-General of the United Nations shall inform all States\nwhich have signed this Covenant or acceded to it of the deposit of each\ninstrument of ratification or accession."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-48-norm",
      "@type": "values:Obligation",
