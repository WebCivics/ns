    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 No one shall be imprisoned merely on the ground of inability to fulfil a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-11-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.135",
      "values:originalText": "contractual obligation.",
      "skos:definition": "contractual obligation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-argumentation-3"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "54fd60b74c6e3dcd53dbce4fcf5051c64cd3e1df20fd8d34e388653cef70a70b",
      "skos:note": "No one shall be imprisoned solely due to inability to fulfill a contractual obligation."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-11-2",
      "@type": "cof:Section",
      "cof:title": "11 No one shall be imprisoned merely on the ground of inability to fulfil a",
      "values:kind": "section",
      "cof:pageNumber": 135,
      "values:originalText": "contractual obligation."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-11-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imprisonment based on inability to fulfill contractual obligation is prohibited.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Contractual obligations are binding.",
      "cml:conclusionText": "No one shall be imprisoned solely due to inability to fulfill a contractual obligation."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The prohibition on imprisonment based on inability to fulfill contractual obligations overlaps with the general principle of human dignity.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Human dignity is a fundamental right.",
      "cml:conclusionText": "Imprisonment based on inability to fulfill contractual obligations violates human dignity."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "The prohibition on imprisonment based on inability to fulfill contractual obligations implies that individuals have the right to a fair trial.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A fair trial is essential for ensuring justice.",
      "cml:conclusionText": "Imprisonment based on inability to fulfill contractual obligations undermines the fairness of the trial process."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "The prohibition on imprisonment based on inability to fulfill contractual obligations implies that individuals have access to social services and support.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Social services and support are essential for ensuring individual well-being.",
      "cml:conclusionText": "Imprisonment based on inability to fulfill contractual obligations restricts access to social services and support."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-11-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "The prohibition on imprisonment based on inability to fulfill contractual obligations implies that individuals have the right to autonomy and self-determination.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Autonomy and self-determination are essential for individual flourishing.",
      "cml:conclusionText": "Imprisonment based on inability to fulfill contractual obligations undermines autonomy and self-determination."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-12-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-12-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.135",
      "values:originalText": "Everyone lawfully within the territory of a State shall, within that\nterritory, have the right to liberty of movement and freedom to choose his\nresidence.\n2.\nEveryone shall be free to leave any country, including his own.\n3.\nThe above-mentioned rights shall not be subject to any restrictions\nexcept those which are provided by law, are necessary to protect national\nsecurity, public order (ordre public), public health or morals or the rights and\nfreedoms of others, and are consistent with the other rights recognized in the\npresent Covenant.\n4.\nNo one shall be arbitrarily deprived of the right to enter his own\ncountry.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026",
      "skos:definition": "Everyone lawfully within the territory of a State shall, within that\nterritory, have the right to liberty of movement and freedom to choose his\nresidence.\n2.\nEveryone shall be free to leave any country, including his own.\n3.\nThe above-mentioned rights shall not be subject to any restrictions\nexcept those which are provided by law, are necessary to protect national\nsecurity, public order (ordre public), public health or morals or the rights and\nfreedoms of others, and are consistent with the other rights recognized in the\npresent Covenant.\n4.\nNo one shall be arbitrarily deprived of the right to enter his own\ncountry.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-deontic-2"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-deontic-3"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-alleninterval-4"
        }
      ],
      "cml:integrityHash": "5d5ae7af6a48ef420f13019d3ad6bc31b7cc1c81cec0723e6df7cc792f59e14f",
      "skos:note": "Right to liberty of movement and freedom to choose residence."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-12-2",
      "@type": "cof:Section",
      "cof:title": "12 1.",
      "values:kind": "section",
      "cof:pageNumber": 135,
      "values:originalText": "Everyone lawfully within the territory of a State shall, within that\nterritory, have the right to liberty of movement and freedom to choose his\nresidence.\n2.\nEveryone shall be free to leave any country, including his own.\n3.\nThe above-mentioned rights shall not be subject to any restrictions\nexcept those which are provided by law, are necessary to protect national\nsecurity, public order (ordre public), public health or morals or the rights and\nfreedoms of others, and are consistent with the other rights recognized in the\npresent Covenant.\n4.\nNo one shall be arbitrarily deprived of the right to enter his own\ncountry.\n\nSchedule 2  International Covenant on Civil and Political Rights\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-norm",
