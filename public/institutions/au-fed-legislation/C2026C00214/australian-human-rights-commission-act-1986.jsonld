    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.127",
      "values:originalText": "Special measures of protection or assistance provided for in other\nConventions or Recommendations adopted by the International Labour\nConference shall not be deemed to be discrimination.\n2.\nAny Member may, after consultation with representative employers’\nand workers’ organisations, where such exist, determine that other special\nmeasures designed to meet the particular requirements of persons who, for\nreasons such as sex, age, disablement, family responsibilities or social or\ncultural status, are generally recognised to require special protection or\nassistance, shall not be deemed to be discrimination.",
      "skos:definition": "Special measures of protection or assistance provided for in other\nConventions or Recommendations adopted by the International Labour\nConference shall not be deemed to be discrimination.\n2.\nAny Member may, after consultation with representative employers’\nand workers’ organisations, where such exist, determine that other special\nmeasures designed to meet the particular requirements of persons who, for\nreasons such as sex, age, disablement, family responsibilities or social or\ncultural status, are generally recognised to require special protection or\nassistance, shall not be deemed to be discrimination.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-5-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "38e685a68ebf3ebc8cc8fa7bf8727728bd7e83b57d83c1690bf4248574f1d5fc",
      "skos:note": "No discrimination for special measures of protection or assistance"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-5",
      "@type": "cof:Section",
      "cof:title": "5 1.",
      "values:kind": "section",
      "cof:pageNumber": 127,
      "values:originalText": "Special measures of protection or assistance provided for in other\nConventions or Recommendations adopted by the International Labour\nConference shall not be deemed to be discrimination.\n2.\nAny Member may, after consultation with representative employers’\nand workers’ organisations, where such exist, determine that other special\nmeasures designed to meet the particular requirements of persons who, for\nreasons such as sex, age, disablement, family responsibilities or social or\ncultural status, are generally recognised to require special protection or\nassistance, shall not be deemed to be discrimination."
    },
