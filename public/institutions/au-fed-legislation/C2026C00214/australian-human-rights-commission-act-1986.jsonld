    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.139",
      "values:originalText": "Everyone shall have the right to freedom of association with others,\nincluding the right to form and join trade unions for the protection of his\ninterests.\n2.\nNo restrictions may be placed on the exercise of this right other than\nthose which are prescribed by law and which are necessary in a democratic\nsociety in the interests of national security or public safety, public order (ordre\npublic), the protection of public health or morals or the protection of the rights\nand freedoms of others. This article shall not prevent the imposition of lawful\nrestrictions on members of the armed forces and of the police in their exercise\nof this right.\n3.\nNothing in this article shall authorize States Parties to the International\nLabour Organisation Convention of 1948 concerning Freedom of Association\nand Protection of the Right to Organize to take legislative measures which\nwould prejudice, or to apply the law in such a manner as to prejudice, the\nguarantees provided for in that Convention.",
      "skos:definition": "Everyone shall have the right to freedom of association with others,\nincluding the right to form and join trade unions for the protection of his\ninterests.\n2.\nNo restrictions may be placed on the exercise of this right other than\nthose which are prescribed by law and which are necessary in a democratic\nsociety in the interests of national security or public safety, public order (ordre\npublic), the protection of public health or morals or the protection of the rights\nand freedoms of others. This article shall not prevent the imposition of lawful\nrestrictions on members of the armed forces and of the police in their exercise\nof this right.\n3.\nNothing in this article shall authorize States Parties to the International\nLabour Organisation Convention of 1948 concerning Freedom of Association\nand Protection of the Right to Organize to take legislative measures which\nwould prejudice, or to apply the law in such a manner as to prejudice, the\nguarantees provided for in that Convention.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-22-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa413d2616e26ffaf1aebf25d5ebf091bf7dc1bbf9fdd9a158dc70ef07e22e85",
      "skos:note": "Right to freedom of association with others"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-22",
      "@type": "cof:Section",
      "cof:title": "22 1.",
      "values:kind": "section",
      "cof:pageNumber": 139,
      "values:originalText": "Everyone shall have the right to freedom of association with others,\nincluding the right to form and join trade unions for the protection of his\ninterests.\n2.\nNo restrictions may be placed on the exercise of this right other than\nthose which are prescribed by law and which are necessary in a democratic\nsociety in the interests of national security or public safety, public order (ordre\npublic), the protection of public health or morals or the protection of the rights\nand freedoms of others. This article shall not prevent the imposition of lawful\nrestrictions on members of the armed forces and of the police in their exercise\nof this right.\n3.\nNothing in this article shall authorize States Parties to the International\nLabour Organisation Convention of 1948 concerning Freedom of Association\nand Protection of the Right to Organize to take legislative measures which\nwould prejudice, or to apply the law in such a manner as to prejudice, the\nguarantees provided for in that Convention."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-22-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-22"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      }
    },
    {
