        }
      ],
      "cml:integrityHash": "7db6555043d5a42b4d7b6429a7225b82c7405a47938c861120d53ce9aa7938de",
      "skos:note": "Member must make solemn declaration before taking duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-38",
      "@type": "cof:Section",
      "cof:title": "38 Every member of the Committee shall, before taking up his duties, make a",
      "values:kind": "section",
      "cof:pageNumber": 144,
      "values:originalText": "solemn declaration in open committee that he will perform his functions\nimpartially and conscientiously."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-38-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
