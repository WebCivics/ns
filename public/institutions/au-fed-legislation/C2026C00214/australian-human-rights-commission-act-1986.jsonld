      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-3-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to ensure equal right",
      "cml:executionSurface": "modalities::logic::deontic",
