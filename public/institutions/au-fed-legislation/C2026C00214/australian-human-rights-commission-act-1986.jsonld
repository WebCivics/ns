      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-4-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.132",
      "values:originalText": "In time of public emergency which threatens the life of the nation and\nthe existence of which is officially proclaimed, the States Parties to the present\nCovenant may take measures derogating from their obligations under the\npresent Covenant to the extent strictly required by the exigencies of the\nsituation, provided that such measures are not inconsistent with their other\nobligations under international law and do not involve discrimination solely on\nthe ground of race, colour, sex, language, religion or social origin.\n2.\nNo derogation from articles 6, 7, 8 (paragraphs 1 and 2), 11, 15, 16\nand 18 may be made under this provision.\n3.\nAny State Party to the present Covenant availing itself of the right of\nderogation shall immediately inform the other States Parties to the present\nCovenant, through the intermediary of the Secretary-General of the United\nNations, of the provisions from which it has derogated and of the reasons by\nwhich it was actuated. A further communication shall be made, through the\nsame intermediary, on the date on which it terminates such derogation.",
      "skos:definition": "In time of public emergency which threatens the life of the nation and\nthe existence of which is officially proclaimed, the States Parties to the present\nCovenant may take measures derogating from their obligations under the\npresent Covenant to the extent strictly required by the exigencies of the\nsituation, provided that such measures are not inconsistent with their other\nobligations under international law and do not involve discrimination solely on\nthe ground of race, colour, sex, language, religion or social origin.\n2.\nNo derogation from articles 6, 7, 8 (paragraphs 1 and 2), 11, 15, 16\nand 18 may be made under this provision.\n3.\nAny State Party to the present Covenant availing itself of the right of\nderogation shall immediately inform the other States Parties to the present\nCovenant, through the intermediary of the Secretary-General of the United\nNations, of the provisions from which it has derogated and of the reasons by\nwhich it was actuated. A further communication shall be made, through the\nsame intermediary, on the date on which it terminates such derogation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-4-2-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-4-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "441974cba71990623ffdd095957c1f13b252923ed08fa370282fb3360aff22b5",
      "skos:note": "Derogation from Covenant obligations in public emergency"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-4-2",
      "@type": "cof:Section",
      "cof:title": "4 1.",
      "values:kind": "section",
      "cof:pageNumber": 132,
      "values:originalText": "In time of public emergency which threatens the life of the nation and\nthe existence of which is officially proclaimed, the States Parties to the present\nCovenant may take measures derogating from their obligations under the\npresent Covenant to the extent strictly required by the exigencies of the\nsituation, provided that such measures are not inconsistent with their other\nobligations under international law and do not involve discrimination solely on\nthe ground of race, colour, sex, language, religion or social origin.\n2.\nNo derogation from articles 6, 7, 8 (paragraphs 1 and 2), 11, 15, 16\nand 18 may be made under this provision.\n3.\nAny State Party to the present Covenant availing itself of the right of\nderogation shall immediately inform the other States Parties to the present\nCovenant, through the intermediary of the Secretary-General of the United\nNations, of the provisions from which it has derogated and of the reasons by\nwhich it was actuated. A further communication shall be made, through the\nsame intermediary, on the date on which it terminates such derogation."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-4-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
