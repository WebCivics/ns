    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.150",
      "values:originalText": "The present Covenant shall enter into force three months after the date\nof the deposit with the Secretary-General of the United Nations of the\nthirty-fifth instrument of ratification or instrument of accession.\n2.\nFor each State ratifying the present Covenant or acceding to it after\nthe deposit of the thirty-fifth instrument of ratification or instrument of\naccession, the present Covenant shall enter into force three months after the date\nof the deposit of its own instrument of ratification or instrument of accession.",
      "skos:definition": "The present Covenant shall enter into force three months after the date\nof the deposit with the Secretary-General of the United Nations of the\nthirty-fifth instrument of ratification or instrument of accession.\n2.\nFor each State ratifying the present Covenant or acceding to it after\nthe deposit of the thirty-fifth instrument of ratification or instrument of\naccession, the present Covenant shall enter into force three months after the date\nof the deposit of its own instrument of ratification or instrument of accession.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-49-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4b2be30c9690c939e05be696978f0c941f25052025038df65384aaf4708a0460",
      "skos:note": "Covenant enters into force after deposit of ratification or accession instrument."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-49",
      "@type": "cof:Section",
      "cof:title": "49 1.",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "The present Covenant shall enter into force three months after the date\nof the deposit with the Secretary-General of the United Nations of the\nthirty-fifth instrument of ratification or instrument of accession.\n2.\nFor each State ratifying the present Covenant or acceding to it after\nthe deposit of the thirty-fifth instrument of ratification or instrument of\naccession, the present Covenant shall enter into force three months after the date\nof the deposit of its own instrument of ratification or instrument of accession."
    },
