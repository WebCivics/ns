    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.137",
      "values:originalText": "No one shall be held guilty of any criminal offence on account of any\nact or omission which did not constitute a criminal offence, under national or\ninternational law, at the time when it was committed. Nor shall a heavier\npenalty be imposed than the one that was applicable at the time when the\ncriminal offence was committed. If, subsequent to the commission of the\noffence, provision is made by law for the imposition of a lighter penalty, the\noffender shall benefit thereby.\n2.\nNothing in this article shall prejudice the trial and punishment of any\nperson for any act or omission which, at the time when it was committed, was\ncriminal according to the general principles of law recognized by the\ncommunity of nations.",
      "skos:definition": "No one shall be held guilty of any criminal offence on account of any\nact or omission which did not constitute a criminal offence, under national or\ninternational law, at the time when it was committed. Nor shall a heavier\npenalty be imposed than the one that was applicable at the time when the\ncriminal offence was committed. If, subsequent to the commission of the\noffence, provision is made by law for the imposition of a lighter penalty, the\noffender shall benefit thereby.\n2.\nNothing in this article shall prejudice the trial and punishment of any\nperson for any act or omission which, at the time when it was committed, was\ncriminal according to the general principles of law recognized by the\ncommunity of nations.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-15-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-15-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-15-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "03a874616512d2257dbbc8c53c5f7cddedd3cb95e21d1bcdf29557ac4450a8e2",
      "skos:note": "No one shall be held guilty of any criminal offence on account of any act or omission which did not constitute a criminal offence, under national or international law, at the time when it was committed."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-15",
      "@type": "cof:Section",
      "cof:title": "15 1.",
      "values:kind": "section",
      "cof:pageNumber": 137,
      "values:originalText": "No one shall be held guilty of any criminal offence on account of any\nact or omission which did not constitute a criminal offence, under national or\ninternational law, at the time when it was committed. Nor shall a heavier\npenalty be imposed than the one that was applicable at the time when the\ncriminal offence was committed. If, subsequent to the commission of the\noffence, provision is made by law for the imposition of a lighter penalty, the\noffender shall benefit thereby.\n2.\nNothing in this article shall prejudice the trial and punishment of any\nperson for any act or omission which, at the time when it was committed, was\ncriminal according to the general principles of law recognized by the\ncommunity of nations."
    },
