    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 At such times as it may consider necessary the Governing Body of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.129",
      "values:originalText": "International Labour Office shall present to the General Conference a report on\nthe working of this Convention and shall examine the desirability of placing on\nthe agenda of the Conference the question of its revision in whole or in part.",
      "skos:definition": "International Labour Office shall present to the General Conference a report on\nthe working of this Convention and shall examine the desirability of placing on\nthe agenda of the Conference the question of its revision in whole or in part.",
      "cml:asserts": [
