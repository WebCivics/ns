    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Schedule 2  International Covenant on Civil and Political Rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
