      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.133",
      "values:originalText": "treatment or punishment. In particular, no one shall be subjected without his\nfree consent to medical or scientific experimentation.",
      "skos:definition": "treatment or punishment. In particular, no one shall be subjected without his\nfree consent to medical or scientific experimentation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-7-2-norm"
