      },
      "cml:premiseText": "Everyone lawfully within the territory...",
      "cml:conclusionText": "has right to liberty of movement and freedom to choose residence."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
