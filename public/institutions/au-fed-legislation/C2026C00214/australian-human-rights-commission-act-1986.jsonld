      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.150",
      "values:originalText": "States without any limitations or exceptions.",
      "skos:definition": "States without any limitations or exceptions.",
      "cml:asserts": [
