      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.143",
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nThe Secretary-General of the United Nations shall provide the necessary\nstaff and facilities for the effective performance of the functions of the\nCommittee under the present Covenant.",
      "skos:definition": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nThe Secretary-General of the United Nations shall provide the necessary\nstaff and facilities for the effective performance of the functions of the\nCommittee under the present Covenant.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-36-norm"
        }
      ],
      "cml:integrityHash": "694851940ce5aca4128b6e6e03f972ef0e303dc3760d830b15b9f8acd5090a60",
      "skos:note": "The Secretary-General of the United Nations shall provide necessary staff and facilities."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-36",
      "@type": "cof:Section",
      "cof:title": "36 Schedule 2  International Covenant on Civil and Political Rights",
      "values:kind": "section",
      "cof:pageNumber": 143,
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nThe Secretary-General of the United Nations shall provide the necessary\nstaff and facilities for the effective performance of the functions of the\nCommittee under the present Covenant."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-36-norm",
