      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-38-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to perform functions impartially and conscientiously.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-39"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.144",
      "values:originalText": "The Committee shall elect its officers for a term of two years. They\nmay be re-elected.\n2.\nThe Committee shall establish its own rules of procedure, but these\nrules shall provide, inter alia, that:\n(a) Twelve members shall constitute a quorum;\n(b) Decisions of the Committee shall be made by a majority vote of the\nmembers present.",
      "skos:definition": "The Committee shall elect its officers for a term of two years. They\nmay be re-elected.\n2.\nThe Committee shall establish its own rules of procedure, but these\nrules shall provide, inter alia, that:\n(a) Twelve members shall constitute a quorum;\n(b) Decisions of the Committee shall be made by a majority vote of the\nmembers present.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-39-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-39-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "499c4d947fbebdf125e618e41499d1492204dd7ee6c82a4051e4646b719e1fdb",
      "skos:note": "Committee must elect officers and establish rules of procedure."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-39",
      "@type": "cof:Section",
      "cof:title": "39 1.",
      "values:kind": "section",
      "cof:pageNumber": 144,
      "values:originalText": "The Committee shall elect its officers for a term of two years. They\nmay be re-elected.\n2.\nThe Committee shall establish its own rules of procedure, but these\nrules shall provide, inter alia, that:\n(a) Twelve members shall constitute a quorum;\n(b) Decisions of the Committee shall be made by a majority vote of the\nmembers present."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-39-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-39"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-39-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Committee shall elect its officers for a term of two years.",
      "cml:conclusionText": "The Committee must elect its officers."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.144",
      "values:originalText": "The States Parties to the present Covenant undertake to submit reports\non the measures they have adopted which give effect to the rights recognized\nherein and on the progress made in the enjoyment of those rights:\n(a) Within one year of the entry into force of the present Covenant for the\nStates Parties concerned;\n(b) Thereafter whenever the Committee so requests.\n2.\nAll reports shall be submitted to the Secretary-General of the United\nNations, who shall transmit them to the Committee for consideration. Reports\n\nInternational Covenant on Civil and Political Rights  Schedule 2\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nshall indicate the factors and difficulties, if any, affecting the implementation of\nthe present Covenant.\n3.\nThe Secretary-General of the United Nations may, after consultation\nwith the Committee, transmit to the specialized agencies concerned copies of\nsuch parts of the reports as may fall within their field of competence.\n4.\nThe Committee shall study the reports submitted by the States Parties\nto the present Covenant. It shall transmit its reports, and such general comments\nas it may consider appropriate, to the States Parties. The Committee may also\ntransmit to the Economic and Social Council these comments along with the\ncopies of the reports it has received from States Parties to the present Covenant.\n5.\nThe States Parties to the present Covenant may submit to the\nCommittee observations on any comments that may be made in accordance with\nparagraph 4 of this article.",
      "skos:definition": "The States Parties to the present Covenant undertake to submit reports\non the measures they have adopted which give effect to the rights recognized\nherein and on the progress made in the enjoyment of those rights:\n(a) Within one year of the entry into force of the present Covenant for the\nStates Parties concerned;\n(b) Thereafter whenever the Committee so requests.\n2.\nAll reports shall be submitted to the Secretary-General of the United\nNations, who shall transmit them to the Committee for consideration. Reports\n\nInternational Covenant on Civil and Political Rights  Schedule 2\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nshall indicate the factors and difficulties, if any, affecting the implementation of\nthe present Covenant.\n3.\nThe Secretary-General of the United Nations may, after consultation\nwith the Committee, transmit to the specialized agencies concerned copies of\nsuch parts of the reports as may fall within their field of competence.\n4.\nThe Committee shall study the reports submitted by the States Parties\nto the present Covenant. It shall transmit its reports, and such general comments\nas it may consider appropriate, to the States Parties. The Committee may also\ntransmit to the Economic and Social Council these comments along with the\ncopies of the reports it has received from States Parties to the present Covenant.\n5.\nThe States Parties to the present Covenant may submit to the\nCommittee observations on any comments that may be made in accordance with\nparagraph 4 of this article.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-40-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-40-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-40-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "b85317548406676e165b49adeb249cd33f4d057996e5546c1c762a51d791e623",
      "skos:note": "States Parties must submit reports on measures adopted to give effect to Covenant rights.",
      "dc:description": "Reports on measures adopted to give effect to Covenant rights"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-40",
      "@type": "cof:Section",
      "cof:title": "40 1.",
      "values:kind": "section",
      "cof:pageNumber": 144,
      "values:originalText": "The States Parties to the present Covenant undertake to submit reports\non the measures they have adopted which give effect to the rights recognized\nherein and on the progress made in the enjoyment of those rights:\n(a) Within one year of the entry into force of the present Covenant for the\nStates Parties concerned;\n(b) Thereafter whenever the Committee so requests.\n2.\nAll reports shall be submitted to the Secretary-General of the United\nNations, who shall transmit them to the Committee for consideration. Reports\n\nInternational Covenant on Civil and Political Rights  Schedule 2\n\nAustralian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nshall indicate the factors and difficulties, if any, affecting the implementation of\nthe present Covenant.\n3.\nThe Secretary-General of the United Nations may, after consultation\nwith the Committee, transmit to the specialized agencies concerned copies of\nsuch parts of the reports as may fall within their field of competence.\n4.\nThe Committee shall study the reports submitted by the States Parties\nto the present Covenant. It shall transmit its reports, and such general comments\nas it may consider appropriate, to the States Parties. The Committee may also\ntransmit to the Economic and Social Council these comments along with the\ncopies of the reports it has received from States Parties to the present Covenant.\n5.\nThe States Parties to the present Covenant may submit to the\nCommittee observations on any comments that may be made in accordance with\nparagraph 4 of this article."
    },
