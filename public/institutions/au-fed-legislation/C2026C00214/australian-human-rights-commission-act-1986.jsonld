      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Schedule 2  International Covenant on Civil and Political Rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.139",
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n1.\nThe family is the natural and fundamental group unit of society and is\nentitled to protection by society and the State.\n2.\nThe right of men and women of marriageable age to marry and to\nfound a family shall be recognized.\n3.\nNo marriage shall be entered into without the free and full consent of\nthe intending spouses.\n4.\nStates Parties to the present Covenant shall take appropriate steps to\nensure equality of rights and responsibilities of spouses as to marriage, during\nmarriage and at its dissolution. In the case of dissolution, provision shall be\nmade for the necessary protection of any children.",
      "skos:definition": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n1.\nThe family is the natural and fundamental group unit of society and is\nentitled to protection by society and the State.\n2.\nThe right of men and women of marriageable age to marry and to\nfound a family shall be recognized.\n3.\nNo marriage shall be entered into without the free and full consent of\nthe intending spouses.\n4.\nStates Parties to the present Covenant shall take appropriate steps to\nensure equality of rights and responsibilities of spouses as to marriage, during\nmarriage and at its dissolution. In the case of dissolution, provision shall be\nmade for the necessary protection of any children.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-23-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b3358cc866f12cc0ae1e0db6d8b453faa7debceda3f7bee2f26a3e2ff21e7893",
      "skos:note": "Marriage requires free and full consent of intending spouses."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-23",
      "@type": "cof:Section",
      "cof:title": "23 Schedule 2  International Covenant on Civil and Political Rights",
      "values:kind": "section",
      "cof:pageNumber": 139,
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\n1.\nThe family is the natural and fundamental group unit of society and is\nentitled to protection by society and the State.\n2.\nThe right of men and women of marriageable age to marry and to\nfound a family shall be recognized.\n3.\nNo marriage shall be entered into without the free and full consent of\nthe intending spouses.\n4.\nStates Parties to the present Covenant shall take appropriate steps to\nensure equality of rights and responsibilities of spouses as to marriage, during\nmarriage and at its dissolution. In the case of dissolution, provision shall be\nmade for the necessary protection of any children."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-23-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-human-rights-commission-act-1986-article-23"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
