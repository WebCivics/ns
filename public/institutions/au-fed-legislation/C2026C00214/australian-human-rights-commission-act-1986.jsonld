    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.144",
      "values:originalText": "The Secretary-General of the United Nations shall convene the initial\nmeeting of the Committee at the Headquarters of the United Nations.\n2.\nAfter its initial meeting, the Committee shall meet at such times as\nshall be provided in its rules of procedure.\n3.\nThe Committee shall normally meet at the Headquarters of the United\nNations or at the United Nations Office at Geneva.",
      "skos:definition": "The Secretary-General of the United Nations shall convene the initial\nmeeting of the Committee at the Headquarters of the United Nations.\n2.\nAfter its initial meeting, the Committee shall meet at such times as\nshall be provided in its rules of procedure.\n3.\nThe Committee shall normally meet at the Headquarters of the United\nNations or at the United Nations Office at Geneva.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-37-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-37-logic-alleninterval-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-37-logic-ltl-2"
        }
      ],
      "cml:integrityHash": "e573256ba510db7e6c80597e6466865b1072a8ad4f151d97d81b4a90a226ec28",
      "skos:note": "Committee meeting times and location"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-37",
      "@type": "cof:Section",
      "cof:title": "37 1.",
      "values:kind": "section",
      "cof:pageNumber": 144,
      "values:originalText": "The Secretary-General of the United Nations shall convene the initial\nmeeting of the Committee at the Headquarters of the United Nations.\n2.\nAfter its initial meeting, the Committee shall meet at such times as\nshall be provided in its rules of procedure.\n3.\nThe Committee shall normally meet at the Headquarters of the United\nNations or at the United Nations Office at Geneva."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-37-norm",
