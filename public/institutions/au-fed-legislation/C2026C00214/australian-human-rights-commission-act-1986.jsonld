    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.138",
      "values:originalText": "No one shall be subjected to arbitrary or unlawful interference with\nhis privacy, family, home or correspondence, nor to unlawful attacks on his\nhonour and reputation.\n2.\nEveryone has the right to the protection of the law against such\ninterference or attacks.",
      "skos:definition": "No one shall be subjected to arbitrary or unlawful interference with\nhis privacy, family, home or correspondence, nor to unlawful attacks on his\nhonour and reputation.\n2.\nEveryone has the right to the protection of the law against such\ninterference or attacks.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-17-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "46afefbfb2c02abc98b094945ddac1ff0749255d63e1ffb9104e0e76adafc056",
      "skos:note": "Protection against arbitrary or unlawful interference with privacy, family, home, or correspondence."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-17",
      "@type": "cof:Section",
      "cof:title": "17 1.",
      "values:kind": "section",
      "cof:pageNumber": 138,
      "values:originalText": "No one shall be subjected to arbitrary or unlawful interference with\nhis privacy, family, home or correspondence, nor to unlawful attacks on his\nhonour and reputation.\n2.\nEveryone has the right to the protection of the law against such\ninterference or attacks."
    },
    {
