      },
      "cml:operator": "hasPermission",
      "cml:logicSummary": "Right to leave any country, including one's own.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Everyone shall be free to leave any country...",
      "cml:conclusionText": "has right to enter his own country."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:logicSummary": "No one shall be arbitrarily deprived of the right to enter their own country.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No one shall be arbitrarily deprived of the right to enter his own country.",
      "cml:conclusionText": "has obligation not to deprive of right to enter own country."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-12-2-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Right applies during certain conditions.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The above-mentioned rights shall not be subject to any restrictions...",
      "cml:conclusionText": "rights apply during certain conditions."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-13-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 An alien lawfully in the territory of a State Party to the present Covenant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-13-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.136",
      "values:originalText": "may be expelled therefrom only in pursuance of a decision reached in\naccordance with law and shall, except where compelling reasons of national\nsecurity otherwise require, be allowed to submit the reasons against his\nexpulsion and to have his case reviewed by, and be represented for the purpose\nbefore, the competent authority or a person or persons especially designated by\nthe competent authority.",
      "skos:definition": "may be expelled therefrom only in pursuance of a decision reached in\naccordance with law and shall, except where compelling reasons of national\nsecurity otherwise require, be allowed to submit the reasons against his\nexpulsion and to have his case reviewed by, and be represented for the purpose\nbefore, the competent authority or a person or persons especially designated by\nthe competent authority.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-13-2-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-13-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a5ecaeb3deefe6c1d116b65a1b0d500b3a29a78065febe81a4d15f686d4c35f0",
      "skos:note": "An alien lawfully in the territory of a State Party to the present Covenant may be expelled only in pursuance of a decision reached in accordance with law."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-13-2",
      "@type": "cof:Section",
      "cof:title": "13 An alien lawfully in the territory of a State Party to the present Covenant",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "may be expelled therefrom only in pursuance of a decision reached in\naccordance with law and shall, except where compelling reasons of national\nsecurity otherwise require, be allowed to submit the reasons against his\nexpulsion and to have his case reviewed by, and be represented for the purpose\nbefore, the competent authority or a person or persons especially designated by\nthe competent authority."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-13-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
