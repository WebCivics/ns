        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-52-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "States must be informed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
