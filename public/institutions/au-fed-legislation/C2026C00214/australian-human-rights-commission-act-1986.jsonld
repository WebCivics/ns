      "skos:prefLabel": "7 No one shall be subjected to torture or to cruel, inhuman or degrading",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-7-2"
      },
      "cml:curationStatus": {
