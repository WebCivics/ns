      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.139",
      "values:originalText": "placed on the exercise of this right other than those imposed in conformity with\nthe law and which are necessary in a democratic society in the interests of\nnational security or public safety, public order (ordre public), the protection of\npublic health or morals or the protection of the rights and freedoms of others.",
      "skos:definition": "placed on the exercise of this right other than those imposed in conformity with\nthe law and which are necessary in a democratic society in the interests of\nnational security or public safety, public order (ordre public), the protection of\npublic health or morals or the protection of the rights and freedoms of others.",
      "cml:asserts": [
