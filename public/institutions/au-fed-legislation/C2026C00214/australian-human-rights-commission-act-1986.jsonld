        }
      ],
      "cml:integrityHash": "98de2b3cc7d8336a41f95815a085cffca2a9e302dc465de46cc2f2b01f5c92cd",
      "skos:note": "Prohibition of propaganda for war and advocacy of national, racial or religious hatred."
    },
    {
