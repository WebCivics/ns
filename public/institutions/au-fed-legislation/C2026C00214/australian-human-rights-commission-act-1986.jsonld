        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-7-2-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "f7bbee7e850b17cf88d5ec8d756d47917ca816c2c92641fd443d9505d2918e1f",
      "skos:note": "No one shall be subjected to torture or cruel, inhuman or degrading treatment."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-7-2",
      "@type": "cof:Section",
