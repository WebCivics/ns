        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "After its initial meeting, the Committee shall meet at such times as shall be provided in its rules of procedure."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Every member of the Committee shall, before taking up his duties, make a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
