        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.140",
      "values:originalText": "Every child shall have, without any discrimination as to race, colour,\nsex, language, religion, national or social origin, property or birth, the right to\nsuch measures of protection as are required by his status as a minor, on the part\nof his family, society and the State.\n2.\nEvery child shall be registered immediately after birth and shall have a\nname.\n3.\nEvery child has the right to acquire a nationality.",
      "skos:definition": "Every child shall have, without any discrimination as to race, colour,\nsex, language, religion, national or social origin, property or birth, the right to\nsuch measures of protection as are required by his status as a minor, on the part\nof his family, society and the State.\n2.\nEvery child shall be registered immediately after birth and shall have a\nname.\n3.\nEvery child has the right to acquire a nationality.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-24-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-24-logic-deontic-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-24-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "3087e3a62ce7f667d25b90af57c8b078ea5eeac3269eac009197ae3ad5a66e0c",
      "skos:note": "Every child has a right to protection and registration."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-24",
      "@type": "cof:Section",
      "cof:title": "24 1.",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "Every child shall have, without any discrimination as to race, colour,\nsex, language, religion, national or social origin, property or birth, the right to\nsuch measures of protection as are required by his status as a minor, on the part\nof his family, society and the State.\n2.\nEvery child shall be registered immediately after birth and shall have a\nname.\n3.\nEvery child has the right to acquire a nationality."
    },
    {
