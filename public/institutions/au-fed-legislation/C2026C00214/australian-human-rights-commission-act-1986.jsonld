    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule 2  International Covenant on Civil and Political Rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-act-1986.pdf"
      },
      "dc:source": "australian-human-rights-commission-act-1986.pdf, p.131",
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nThe States Parties to the present Covenant undertake to ensure the equal\nright of men and women to the enjoyment of all civil and political rights set\nforth in the present Covenant.",
      "skos:definition": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nThe States Parties to the present Covenant undertake to ensure the equal\nright of men and women to the enjoyment of all civil and political rights set\nforth in the present Covenant.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-3-2-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-act-1986-article-3-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "914ec2dcc2c2ae845239a429b2fba5d56d1b77b1f27a0526c86cdf8dec7c415b",
      "skos:note": "Undertaking to ensure equal right of men and women to civil and political rights"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-act-1986#article-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule 2  International Covenant on Civil and Political Rights",
      "values:kind": "section",
      "cof:pageNumber": 131,
      "values:originalText": "Australian Human Rights Commission Act 1986\n\nCompilation date: 04/06/2026\n\nThe States Parties to the present Covenant undertake to ensure the equal\nright of men and women to the enjoyment of all civil and political rights set\nforth in the present Covenant."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-3-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
