        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-13-2-logic-deontic-1",
