      },
      "cml:premiseText": "No one shall be subjected to torture or cruel, inhuman or degrading treatment.",
      "cml:conclusionText": "It is prohibited to subject anyone to torture or cruel, inhuman or degrading treatment."
    },
    {
      "@id": "concept:australian-human-rights-commission-act-1986-article-7-2-logic-deontic-2",
