      "partOf": "concept:crimes-act-1914-sec-3zo"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a-logic-alleninterval-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "These two events are temporally related.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Consider temporal relationship between events.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The commission of the offence and the time of the identification are related in time."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the suspect fails to cooperate, then reasons for failure must be provided.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consider certain factors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The suspect must cooperate in the conduct of the parade."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the evidence of identification is likely important, then it must be considered.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consider the likelihood of identification.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The evidence of identification is likely important in the circumstances."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the practicality is not considered, then it must be taken into account.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consider practicality.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The practicality of holding an identification parade must be considered."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the relationship is not considered, then it must be taken into account.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consider relationship between suspect and potential identifier.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The relationship between the suspect and the person who may make an identification at the parade must be considered."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "These are the factors that must be considered when deciding whether to hold an identification parade.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Identify relevant factors for consideration.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS-A",
      "cml:premiseText": "The following must be taken into account:"
    },
