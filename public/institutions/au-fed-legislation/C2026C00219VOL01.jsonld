    {
      "@id": "concept:crimes-act-1914-sec-3ub-ss-1-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal relation between the police officer's suspicion and the person's actions is relevant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Police officer may exercise powers in relation to a specific temporal interval.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "The police officer suspects on reasonable grounds that the person might have just committed, might be committing or might be about to commit a terrorist act."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ub-ss-1-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The justification for the suspicion is reasonable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Police officer must justify their suspicion on reasonable grounds.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Justification",
      "cml:premiseText": "The police officer suspects on reasonable grounds that the person might have just committed, might be committing or might be about to commit a terrorist act."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ub-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person may be subject to the powers of the police officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Police officer has the power to exercise powers.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:premiseText": "The police officer is authorized to exercise powers under this Subdivision."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ub-ss-1-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is suspected of committing a terrorist act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Police officer must suspect on reasonable grounds that the person has committed a terrorist act.",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Suspicion",
      "cml:premiseText": "The police officer suspects on reasonable grounds that the person might have just committed, might be committing or might be about to commit a terrorist act."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ub-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is subject to the powers of the police officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Police officer may exercise powers in relation to a recurring threat.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "The police officer suspects on reasonable grounds that the person might be committing or might be about to commit a terrorist act."
    },
