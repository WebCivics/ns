      "@id": "concept:crimes-act-1914-sec-3zl-ss-3b-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual's conduct must occur after the order is issued.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Establishes a temporal relation between the order and the individual's conduct.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "The person is subject to an order under subsection (3A)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zl-ss-3b-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the person engages in conduct, they commit an offence if it contravenes the order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Establishes a logical implication between the order and the individual's conduct.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The person is subject to an order under subsection (3A)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zl-ss-3b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if they engage in conduct that contravenes the order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits refusing to allow identification material to be taken.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "The person is subject to an order under subsection (3A)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zl-ss-3b-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must comply with the order if they are subject to it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on individuals to comply with the order.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The person is subject to an order under subsection (3A)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zl-ss-3b-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Refusing to allow identification material to be taken spreads to individuals who engage in such conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
