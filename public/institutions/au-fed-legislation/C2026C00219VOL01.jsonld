    {
      "@id": "concept:crimes-act-1914-sec-3ja-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the constables assisting will not be able to return to the premises within the 12 hour period mentioned in paragraph 3J(2)(aa);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Time period within which returning to premises is not possible",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "(c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the constables assisting will not be able to return to the premises within the 12 hour period mentioned in paragraph 3J(2)(aa);"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ja-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) If:  (a) a warrant in relation to premises is being executed; and  (b) there is an emergency situation; and  (c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the constables assisting will not be able to return to the premises within the 12 hour period mentioned in paragraph 3J(2)(aa); he or she may apply to an issuing officer for an extension of that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission to extend time period",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:premiseText": "(1) If:  (a) a warrant in relation to premises is being executed; and  (b) there is an emergency situation; and  (c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the constables assisting will not be able to return to the premises within the 12 hour period mentioned in paragraph 3J(2)(aa); he or she may apply to an issuing officer for an extension of that period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ja-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(b) there is an emergency situation; and (c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the constables assisting will not be able to return to the premises within the 12 hour period mentioned in paragraph 3J(2)(aa);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Emergency situation recurring within time period",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(b) there is an emergency situation; and (c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the constables assisting will not be able to return to the premises within the 12 hour period mentioned in paragraph 3J(2)(aa);"
    },
