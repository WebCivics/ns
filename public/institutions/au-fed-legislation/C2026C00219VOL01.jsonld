        "concept:crimes-act-1914-sec-3zo-ss-1a-logic-deontic-3",
        "concept:crimes-act-1914-sec-3zo-ss-1a-logic-deontic-4",
        "concept:crimes-act-1914-sec-3zo-ss-1a-logic-descriptionlogic-5",
        "concept:crimes-act-1914-sec-3zo-ss-1a-logic-alleninterval-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "1100e43d7ca739e53e33f958c0d95c3fa9726a5e1ce26e2afe40be2ab82e687c",
      "cml:proposedBy": {
