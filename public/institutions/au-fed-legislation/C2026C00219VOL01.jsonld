      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.115",
      "skos:note": "Constable must not use force to cause death or grievous bodily harm unless necessary to protect life.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3ZC(2) Use of force in making arrest"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
