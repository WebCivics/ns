    {
      "@id": "concept:crimes-act-1914-sec-3zo-ss-1a",
      "@type": "cml:Concept",
      "dc:description": "Reasons for failure to cooperate in the conduct of the parade, and reasons for not making an identification.",
      "dc:source": "crimes-act-1914.pdf, p.130",
      "skos:note": "Must consider certain factors when deciding whether to hold an identification parade.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3ZO(1A) Identification by means of photographs"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
