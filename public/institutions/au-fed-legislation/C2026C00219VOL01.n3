    cml:conclusionText "Refusing to allow identification material to be taken is prohibited and must diffuse throughout the relevant domain." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

