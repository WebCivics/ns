    cml:modality cml:Deontic ;
    cml:operator "has" ;
    cml:logicSummary "Has the same protection and immunity as a court member." ;
    cml:premiseText "(3) A magistrate performing a function of, or connected with, making an order under section 3ZI, 3ZJ, 3ZK, 3ZN or 3ZQZB has the same protection and immunity..." ;
    cml:conclusionText "...as if he or she were performing that function as, or as a member of, a court." ;
