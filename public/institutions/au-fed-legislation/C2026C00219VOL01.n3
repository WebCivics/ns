concept:crimes-act-1914-sec-4c-ss-1 a cml:Concept ;
    skos:prefLabel "4C(1) Offences under 2 or more laws"@en ;
    cml:realizedBy doc:sec-4c-ss-1 ;
    cml:integrityHash "c1ef6e33e82a2c4e03a6939c551f260faf7f62a5363f90d1906a17f4697ebf6a" ;
    values:partOf concept:crimes-act-1914-sec-4c ;
    skos:note "Offences under 2 or more laws" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.331" ;
    cml:asserts concept:crimes-act-1914-sec-4c-ss-1-norm .
concept:crimes-act-1914-sec-4c-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-4c-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-4c-ss-1 cml:asserts concept:crimes-act-1914-sec-4c-ss-1-logic-deontic-1 .
concept:crimes-act-1914-sec-4c-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits prosecution for the same act or omission under multiple laws" ;
    cml:premiseText "(1) Where an act or omission constitutes an offence:  (a) under 2 or more laws of the Commonwealth; or  (b) both under a law of the Commonwealth and at common law; the offender shall, unless the contrary intention appears, be liable to be prosecuted and punished under either or any of those laws of the Commonwealth or at common law, but shall not be liable to be punished twice for the same act or omission." ;
    cml:conclusionText "(offender) shall not be liable to be punished twice" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-1 cml:asserts concept:crimes-act-1914-sec-4c-ss-1-logic-alleninterval-2 .
concept:crimes-act-1914-sec-4c-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines the temporal scope of the offence" ;
    cml:premiseText "(1) Where an act or omission constitutes an offence:  (a) under 2 or more laws of the Commonwealth; or  (b) both under a law of the Commonwealth and at common law; the offender shall, unless the contrary intention appears, be liable to be prosecuted and punished under either or any of those laws of the Commonwealth or at common law" ;
    cml:conclusionText "(offender) is liable to prosecution within the defined temporal scope" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-1 cml:asserts concept:crimes-act-1914-sec-4c-ss-1-logic-ltl-3 .
concept:crimes-act-1914-sec-4c-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurrently" ;
    cml:logicSummary "Defines the recurrence of the offence" ;
    cml:premiseText "(1) Where an act or omission constitutes an offence:  (a) under 2 or more laws of the Commonwealth; or  (b) both under a law of the Commonwealth and at common law; the offender shall, unless the contrary intention appears, be liable to be prosecuted and punished under either or any of those laws of the Commonwealth or at common law" ;
    cml:conclusionText "(offender) is subject to recurrent prosecution" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-1 cml:asserts concept:crimes-act-1914-sec-4c-ss-1-logic-deontic-4 .
concept:crimes-act-1914-sec-4c-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes an obligation on the state to prosecute" ;
    cml:premiseText "(1) Where an act or omission constitutes an offence:  (a) under 2 or more laws of the Commonwealth; or  (b) both under a law of the Commonwealth and at common law; the offender shall, unless the contrary intention appears, be liable to be prosecuted and punished under either or any of those laws of the Commonwealth or at common law" ;
    cml:conclusionText "(state) is obligated to prosecute (offender)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-1 cml:asserts concept:crimes-act-1914-sec-4c-ss-1-logic-argumentation-5 .
concept:crimes-act-1914-sec-4c-ss-1-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "Establishes the implication between prosecution and punishment" ;
    cml:premiseText "(1) Where an act or omission constitutes an offence:  (a) under 2 or more laws of the Commonwealth; or  (b) both under a law of the Commonwealth and at common law; the offender shall, unless the contrary intention appears, be liable to be prosecuted and punished under either or any of those laws of the Commonwealth or at common law" ;
    cml:conclusionText "(prosecution) implies (punishment)" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


concept:crimes-act-1914-sec-4c-ss-2 a cml:Concept ;
    skos:prefLabel "4C(2) Offences under 2 or more laws"@en ;
    cml:realizedBy doc:sec-4c-ss-2 ;
    cml:integrityHash "9bf92fe0a229c7cef08d583262bb65ced0d9507f102b95c8a14d8fa9bfe7d135" ;
    values:partOf concept:crimes-act-1914-sec-4c ;
    skos:note "Offender not liable for Commonwealth offence if already punished under State or Territory law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.331" ;
    cml:asserts concept:crimes-act-1914-sec-4c-ss-2-norm .
concept:crimes-act-1914-sec-4c-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-4c-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-deontic-1 .
concept:crimes-act-1914-sec-4c-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If offender not liable, then Commonwealth offence cannot be committed." ;
    cml:premiseText "(not (offender liable to Commonwealth law)) -> (not (Commonwealth offence committed))" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-alleninterval-2 .
concept:crimes-act-1914-sec-4c-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Offence under multiple laws overlaps in time." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (Commonwealth offence) ∩ (Territory offence) ≠ ∅" ;
    cml:conclusionText "(offender not punished for Commonwealth offence) -> (offender not liable to Commonwealth law)" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-ltl-3 .
concept:crimes-act-1914-sec-4c-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Offence under multiple laws occurs until offender is punished." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (offender not punished for Commonwealth offence)" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-diffusion-4 .
concept:crimes-act-1914-sec-4c-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Offence under multiple laws diffuses through time." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (offender not punished for Commonwealth offence)" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-cogai-5 .
concept:crimes-act-1914-sec-4c-ss-2-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "Offence under multiple laws recognized by AI." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (offender not punished for Commonwealth offence)" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


