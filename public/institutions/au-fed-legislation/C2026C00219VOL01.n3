concept:crimes-act-1914-sec-3aa-ss-1a a cml:Concept ;
    skos:prefLabel "3AA(1A) State offences that have a federal aspect"@en ;
    cml:realizedBy doc:sec-3aa-ss-1a ;
    cml:integrityHash "7778a29790ec5ecc02634d4f5ed1787e6e91f292188443184904cebaed09b59d" ;
    values:partOf concept:crimes-act-1914-sec-3aa ;
    skos:note "Identify State offences with a federal aspect" ;
    cml:curationStatus cml:Proposed ;
