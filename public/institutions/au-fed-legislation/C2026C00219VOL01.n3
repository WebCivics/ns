concept:crimes-act-1914-sec-3d-ss-2 cml:asserts concept:crimes-act-1914-sec-3d-ss-2-logic-deontic-1 .
concept:crimes-act-1914-sec-3d-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Preclusion" ;
    cml:logicSummary "Precludes other laws from limiting the power of this Part." ;
    cml:premiseText "(2) To avoid any doubt, it is declared that even though another law of the Commonwealth (including other provisions of this Act) provides power to do one or more of the things referred to in subsection (1)," ;
    cml:conclusionText "a similar power conferred by this Part may be used despite the existence of the power under the other law." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

