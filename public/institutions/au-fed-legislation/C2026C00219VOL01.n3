    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-3aa-ss-1a ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-3aa-ss-1a cml:asserts concept:crimes-act-1914-sec-3aa-ss-1a-logic-deontic-1 .
concept:crimes-act-1914-sec-3aa-ss-1a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "is" ;
    cml:logicSummary "State offence has a federal aspect" ;
    cml:premiseText "(1A) The object of this section is to identify State offences that have a federal aspect because:  (a) they potentially fall within Commonwealth legislative power because of the elements of the State offence; or  (b) they potentially fall within Commonwealth legislative power because of the circumstances in which the State offence was committed (whether or not those circumstances are expressed to be acts or omissions involved in committing the offence); or  (c) the Australian Federal Police investigating them is incidental to the Australian Federal Police investigating an offence against a law of the Commonwealth or a Territory." ;
    cml:conclusionText "(State offence has a federal aspect)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


