concept:crimes-act-1914-sec-3uk a cml:Concept ;
    skos:prefLabel "3UK Sunset provision"@en ;
    cml:realizedBy doc:sec-3uk ;
    values:originalText "(1) A police officer must not exercise powers or perform duties under this Division (other than under section 3UEB or 3UF) after" ;
    skos:definition "(1) A police officer must not exercise powers or perform duties under this Division (other than under section 3UEB or 3UF) after"@en ;
