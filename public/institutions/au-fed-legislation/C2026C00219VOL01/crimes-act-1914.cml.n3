doc:sec-4d-ss-1a a cof:Section ;
    cof:title "4D(1A) Penalties" ;
    values:kind "subsection" ;
    values:originalText "(1A) Subsection (1) applies to a penalty set out:  (a) at the foot of a section of an Act; or  (b) at the foot of a subsection of an Act, but not at the foot of the section containing the subsection; or  (c) at the foot of a clause of any Schedule to an Act; or  (d) at the foot of a subclause of any Schedule to an Act, but not at the foot of the clause containing the subclause." ;
    cof:pageNumber "332"^^xsd:integer .

