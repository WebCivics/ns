concept:crimes-act-1914-sec-3ue-ss-1 a cml:Concept ;
    skos:prefLabel "3UE(1) Seizure of terrorism related items and serious offence related"@en ;
    cml:realizedBy doc:sec-3ue-ss-1 ;
    values:originalText "(1) A police officer who has entered premises under, or purportedly under, subsection 3UEA(1) must:   Part IAA  Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)" ;
    skos:definition "(1) A police officer who has entered premises under, or purportedly under, subsection 3UEA(1) must:   Part IAA  Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)"@en ;
    cml:integrityHash "994a399da1f116c26f796fcc240780a7f5038ea96afcb76e7a78236aeb0f70bc" ;
    values:partOf concept:crimes-act-1914-sec-3ue ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Police officers may enter premises under certain conditions. Police officer must perform search, information gathering, arrest and related powers upon entering premises." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
