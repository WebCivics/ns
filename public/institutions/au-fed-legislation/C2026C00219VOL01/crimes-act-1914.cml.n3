concept:crimes-act-1914-sec-3x-ss-3 a cml:Concept ;
    skos:prefLabel "3X(3) Arrest of prisoner unlawfully at large"@en ;
    cml:realizedBy doc:sec-3x-ss-3 ;
    values:originalText "(3) If the Magistrate is satisfied that the person is a prisoner unlawfully at large, the Magistrate may issue a warrant:  (a) authorising any constable to convey the person to a prison or other place of detention specified in the warrant; and  (b) directing that the person, having been conveyed to that place in accordance with the warrant, be detained there to undergo the term of imprisonment or other detention that the person is required by law to undergo." ;
    skos:definition "(3) If the Magistrate is satisfied that the person is a prisoner unlawfully at large, the Magistrate may issue a warrant:  (a) authorising any constable to convey the person to a prison or other place of detention specified in the warrant; and  (b) directing that the person, having been conveyed to that place in accordance with the warrant, be detained there to undergo the term of imprisonment or other detention that the person is required by law to undergo."@en ;
    cml:integrityHash "6ab7c599ab7b1cfec43f21e05f5a0a3c57acc6973de64463d45737fe2009d9dd" ;
    values:partOf concept:crimes-act-1914-sec-3x ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "Magistrate must issue a warrant for unlawful prisoner arrest." ;
    cml:curationStatus cml:Proposed ;
