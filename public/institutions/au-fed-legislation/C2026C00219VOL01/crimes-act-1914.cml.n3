concept:crimes-act-1914-sec-3zl-ss-4 a cml:Concept ;
    skos:prefLabel "3ZL(4) Offence of refusing to allow identification material to be taken"@en ;
    cml:realizedBy doc:sec-3zl-ss-4 ;
    values:originalText "(4) Nothing in this section derogates from the right to use the provisions of Part ID as authority for the taking of fingerprints from a prescribed offender or a serious offender." ;
    skos:definition "(4) Nothing in this section derogates from the right to use the provisions of Part ID as authority for the taking of fingerprints from a prescribed offender or a serious offender."@en ;
