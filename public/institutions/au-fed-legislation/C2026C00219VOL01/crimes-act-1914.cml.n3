doc:sec-3z-ss-1 a cof:Section ;
    cof:title "3Z(1) Power of arrest without warrant by other persons" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who is not a constable may, without warrant, arrest another person if he or she believes on reasonable grounds that:  (a) the other person is committing or has just committed an indictable offence; and  (b) proceedings by summons against the other person would not achieve one or more of the purposes referred to in paragraph 3W(1)(b).   Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)  Part IAA Arrest and related matters  Division 4  Section 3ZA  Crimes Act 1914  Compilation date: 04/06/2026" ;
    cof:pageNumber "112"^^xsd:integer .

concept:crimes-act-1914-sec-3z-ss-2 a cml:Concept ;
    skos:prefLabel "3Z(2) Power of arrest without warrant by other persons"@en ;
    cml:realizedBy doc:sec-3z-ss-2 ;
    values:originalText "(2) A person who arrests another person under subsection (1) must, as soon as practicable after the arrest, arrange for the other person, and any property found on the other person, to be delivered into the custody of a constable." ;
    skos:definition "(2) A person who arrests another person under subsection (1) must, as soon as practicable after the arrest, arrange for the other person, and any property found on the other person, to be delivered into the custody of a constable."@en ;
    cml:integrityHash "cb62219f3e7eefecfb317e38dff84dffbd5673d6eb9b4e253ad8be4b48543327" ;
    values:partOf concept:crimes-act-1914-sec-3z ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "Must arrange for delivery of arrested person and property into custody of a constable." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
