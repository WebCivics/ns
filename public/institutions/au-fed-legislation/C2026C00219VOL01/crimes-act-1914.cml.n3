concept:crimes-act-1914-sec-3zg a cml:Concept ;
    skos:prefLabel "3ZG Power to conduct search of arrested person’s premises"@en ;
    cml:realizedBy doc:sec-3zg ;
    values:originalText "A constable who arrests a person at premises for an offence, or who is present at such an arrest, may seize things in plain view at those premises that the constable believes on reasonable grounds to be:  (a) evidential material in relation to that or another offence; or  (b) seizable items.   Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)  Part IAA Arrest and related matters  Division 4  Section 3ZH  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "A constable who arrests a person at premises for an offence, or who is present at such an arrest, may seize things in plain view at those premises that the constable believes on reasonable grounds to be:  (a) evidential material in relation to that or another offence; or  (b) seizable items.   Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)  Part IAA Arrest and related matters  Division 4  Section 3ZH  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "757c80ac26cd78fa31a6bdfff993a95a3a742b0726fd2713c023cd1d90d28764" ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "Constable may seize items in plain view at premises during arrest." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
