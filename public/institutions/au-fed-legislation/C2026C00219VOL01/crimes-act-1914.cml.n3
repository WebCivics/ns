concept:crimes-act-1914-sec-15f a cml:Concept ;
    skos:prefLabel "15F Civil rights not affected"@en ;
    cml:realizedBy doc:sec-15f ;
    values:originalText "Nothing in this Act shall affect the right of any person aggrieved by any act or omission which is punishable as an offence against this Act to institute civil proceedings in any court in respect of such act or omission." ;
