concept:crimes-act-1914-sec-3s a cml:Concept ;
    skos:prefLabel "3S Restrictions on personal searches"@en ;
    cml:realizedBy doc:sec-3s ;
    values:originalText "A warrant cannot authorise a strip search or a search of a person’s body cavities.   Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)  Part IAA Search warrants  Division 2  Section 3SA  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "A warrant cannot authorise a strip search or a search of a person’s body cavities.   Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)  Part IAA Search warrants  Division 2  Section 3SA  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "a603e4eba6a352634eaddd2cab38d221278207d9a56e9f8045bca004b372affe" ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Restrictions on personal searches" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
