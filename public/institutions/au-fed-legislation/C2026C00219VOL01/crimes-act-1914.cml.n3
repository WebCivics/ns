concept:crimes-act-1914-sec-4l a cml:Concept ;
    skos:prefLabel "4L Specified defences not to preclude other defences"@en ;
    cml:realizedBy doc:sec-4l ;
    values:originalText "Where a provision of a law of the Commonwealth provides a defence to a particular offence, the provision does not, unless the contrary intention appears, prevent the use of any defence that is otherwise available.   General  Part IA  Section 4M  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "Where a provision of a law of the Commonwealth provides a defence to a particular offence, the provision does not, unless the contrary intention appears, prevent the use of any defence that is otherwise available.   General  Part IA  Section 4M  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "309d0ec4b66ab83d4b5a85f39e9de07ec25b99feb5c7727d2610d12923e5ce2a" ;
    cof:pageNumber "336"^^xsd:integer ;
    skos:note "No defence is prevented by another available defence unless otherwise intended." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.336" ;
