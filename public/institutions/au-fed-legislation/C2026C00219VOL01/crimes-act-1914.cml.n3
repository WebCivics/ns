concept:crimes-act-1914-sec-3zj-ss-8 a cml:Concept ;
    skos:prefLabel "3ZJ(8) Taking fingerprints, recordings, samples of handwriting or"@en ;
    cml:realizedBy doc:sec-3zj-ss-8 ;
    values:originalText "(8) The taking of identification material from a person who:  (a) is under 18; or   Part IAA  Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)" ;
    skos:definition "(8) The taking of identification material from a person who:  (a) is under 18; or   Part IAA  Search, information gathering, arrest and related powers (other than powers under delayed notification search warrants)"@en ;
    cml:integrityHash "3c5bfb95edd48ff0870fa9b9cefd38b4fef312b9ebf9d80bb85a56090af47be7" ;
    values:partOf concept:crimes-act-1914-sec-3zj ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Taking identification material from a person under 18 is an obligation of the State." ;
    cml:curationStatus cml:Proposed ;
