doc:sec-15b-ss-1 a cof:Section ;
    cof:title "15B(1) Time for commencement of prosecutions" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to subsection (1B), a prosecution of an individual for an offence against any law of the Commonwealth may be commenced as follows:  (a) if the maximum penalty which may be imposed for the offence in respect of an individual is, or includes, a term of imprisonment of more than 6 months in the case of a first conviction—at any time;  (b) in any other case—at any time within one year after the commission of the offence." ;
    cof:pageNumber "351"^^xsd:integer .

concept:crimes-act-1914-sec-15b-ss-1a a cml:Concept ;
    skos:prefLabel "15B(1A) Time for commencement of prosecutions"@en ;
    cml:realizedBy doc:sec-15b-ss-1a ;
    values:originalText "(1A) A prosecution of a body corporate for an offence against any law of the Commonwealth may be commenced as follows:  (a) if the maximum penalty which may be imposed for the offence in respect of a body corporate is, or includes, a fine of more than 150 penalty units in the case of a first conviction—at any time;  (b) in any other case—at any time within one year after the commission of the offence." ;
    skos:definition "(1A) A prosecution of a body corporate for an offence against any law of the Commonwealth may be commenced as follows:  (a) if the maximum penalty which may be imposed for the offence in respect of a body corporate is, or includes, a fine of more than 150 penalty units in the case of a first conviction—at any time;  (b) in any other case—at any time within one year after the commission of the offence."@en ;
    cml:integrityHash "ac53c0627e580805b97b7efba807c4338ec26d6b4fc8f804dac2adca2802baa3" ;
    values:partOf concept:crimes-act-1914-sec-15b ;
    cof:pageNumber "351"^^xsd:integer ;
    skos:note "Prosecution of a body corporate for an offence against any law of the Commonwealth may be commenced at any time within one year after commission of the offence, except in cases where maximum penalty is more than 150 penalty units." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.351" ;
