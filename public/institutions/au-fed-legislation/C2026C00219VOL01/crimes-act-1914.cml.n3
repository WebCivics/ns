doc:sec-15e a cof:Section ;
    cof:title "15E Privilege of Parliament not affected" ;
    values:kind "section" ;
    values:originalText "Nothing in this Act shall derogate from any power or privilege of either House of the Parliament or of the members or committees of either House of Parliament as existing at the commencement of this Act." ;
