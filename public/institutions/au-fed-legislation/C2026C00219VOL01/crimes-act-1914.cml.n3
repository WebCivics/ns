concept:crimes-act-1914-sec-4g a cml:Concept ;
    skos:prefLabel "4G Indictable offences"@en ;
    cml:realizedBy doc:sec-4g ;
    values:originalText "Offences against a law of the Commonwealth punishable by imprisonment for a period exceeding 12 months are indictable offences, unless the contrary intention appears." ;
    skos:definition "Offences against a law of the Commonwealth punishable by imprisonment for a period exceeding 12 months are indictable offences, unless the contrary intention appears."@en ;
