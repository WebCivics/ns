doc:sec-15b-ss-1b a cof:Section ;
    cof:title "15B(1B) Time for commencement of prosecutions" ;
    values:kind "subsection" ;
    values:originalText "(1B) A prosecution of an individual for an offence that is taken to have been committed because of section 11.2 or 11.2A of the Criminal Code, or against another law of the Commonwealth dealing with aiding and abetting, in relation to an offence committed by a body corporate may be commenced as follows:  (a) if the maximum penalty which may be imposed for the principal offence in respect of a body corporate is, or includes, a fine of more than 150 penalty units in the case of a first conviction—at any time;  (b) in any other case—at any time within one year after the commission of the offence by the individual." ;
    cof:pageNumber "351"^^xsd:integer .

concept:crimes-act-1914-sec-15b-ss-2 a cml:Concept ;
    skos:prefLabel "15B(2) Time for commencement of prosecutions"@en ;
    cml:realizedBy doc:sec-15b-ss-2 ;
    values:originalText "(2) Notwithstanding any provision in any law of the Commonwealth passed before the commencement of this Act and providing any shorter time for the commencement of the prosecution, any prosecution for an offence against the law may be commenced at any time within one year after the commission of the offence." ;
    skos:definition "(2) Notwithstanding any provision in any law of the Commonwealth passed before the commencement of this Act and providing any shorter time for the commencement of the prosecution, any prosecution for an offence against the law may be commenced at any time within one year after the commission of the offence."@en ;
    cml:integrityHash "0c3ad01924de2f924ed3a9e78455d62963669d50f74cc16f1c454e8bdb29b912" ;
    values:partOf concept:crimes-act-1914-sec-15b ;
    cof:pageNumber "351"^^xsd:integer ;
    skos:note "Prosecution can be commenced within one year after commission of offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
