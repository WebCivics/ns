concept:crimes-act-1914-sec-4e a cml:Concept ;
    skos:prefLabel "4E Pecuniary penalties"@en ;
    cml:realizedBy doc:sec-4e ;
    values:originalText "A pecuniary penalty for an offence against a law of the Commonwealth may, unless the contrary intention appears, be recovered in any court of summary jurisdiction." ;
    skos:definition "A pecuniary penalty for an offence against a law of the Commonwealth may, unless the contrary intention appears, be recovered in any court of summary jurisdiction."@en ;
