doc:sec-3x-ss-3 a cof:Section ;
    cof:title "3X(3) Arrest of prisoner unlawfully at large" ;
    values:kind "subsection" ;
    values:originalText "(3) If the Magistrate is satisfied that the person is a prisoner unlawfully at large, the Magistrate may issue a warrant:  (a) authorising any constable to convey the person to a prison or other place of detention specified in the warrant; and  (b) directing that the person, having been conveyed to that place in accordance with the warrant, be detained there to undergo the term of imprisonment or other detention that the person is required by law to undergo." ;
    cof:pageNumber "111"^^xsd:integer .

concept:crimes-act-1914-sec-3x-ss-4 a cml:Concept ;
    skos:prefLabel "3X(4) Arrest of prisoner unlawfully at large"@en ;
    cml:realizedBy doc:sec-3x-ss-4 ;
    values:originalText "(4) In this section: prisoner unlawfully at large means a person who is at large (otherwise than because the person has escaped from lawful custody) at a time when the person is required by law to be detained under a provision of a law of the Commonwealth, including Divisions 6 to 9, inclusive, of Part IB." ;
    skos:definition "(4) In this section: prisoner unlawfully at large means a person who is at large (otherwise than because the person has escaped from lawful custody) at a time when the person is required by law to be detained under a provision of a law of the Commonwealth, including Divisions 6 to 9, inclusive, of Part IB."@en ;
    cml:integrityHash "e45f2b8603546ce221ab5f4da54719ecd8df5cd84ed70c0816e62019a89aa782" ;
    values:partOf concept:crimes-act-1914-sec-3x ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "Definition of prisoner unlawfully at large" ;
    cml:curationStatus cml:Proposed ;
