    values:partOf concept:crimes-act-1914-sec-3zj ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Consider seriousness of offence and person's age/disability when deciding to make an order." ;
    cml:curationStatus cml:Proposed ;
