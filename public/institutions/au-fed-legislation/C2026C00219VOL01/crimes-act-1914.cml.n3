concept:crimes-act-1914-sec-3ue-ss-7 a cml:Concept ;
    skos:prefLabel "3UE(7) Seizure of terrorism related items and serious offence related"@en ;
    cml:realizedBy doc:sec-3ue-ss-7 ;
    values:originalText "(7) If one or more police officers have entered premises in accordance with this section, a police officer must, within 24 hours after the entry:  (a) notify the occupier of the premises that the entry has taken place; or  (b) if it is not practicable so to notify the occupier—leave a written notice of the entry at the premises. 3UEB  Emergency entry to premises without warrant—post-entry warrants Requirement to apply for post-entry warrant" ;
    skos:definition "(7) If one or more police officers have entered premises in accordance with this section, a police officer must, within 24 hours after the entry:  (a) notify the occupier of the premises that the entry has taken place; or  (b) if it is not practicable so to notify the occupier—leave a written notice of the entry at the premises. 3UEB  Emergency entry to premises without warrant—post-entry warrants Requirement to apply for post-entry warrant"@en ;
    cml:integrityHash "8c91add0947ffb3e1799bf620505e56a644efee7a3ca939e9d6032ecbedfe772" ;
    values:partOf concept:crimes-act-1914-sec-3ue ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Police officer must notify occupier of premises within 24 hours after entry." ;
    dc:description "Notification to occupier" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
