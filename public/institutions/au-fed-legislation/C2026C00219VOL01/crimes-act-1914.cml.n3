concept:crimes-act-1914-sec-13 a cml:Concept ;
    skos:prefLabel "13 Institution of proceedings in respect of offences"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "Unless the contrary intention appears in the Act or regulation creating the offence, any person may:  (a) institute proceedings for the commitment for trial of any person in respect of any indictable offence against the law of the Commonwealth; or  (b) institute proceedings for the summary conviction of any person in respect of any offence against the law of the Commonwealth punishable on summary conviction." ;
    skos:definition "Unless the contrary intention appears in the Act or regulation creating the offence, any person may:  (a) institute proceedings for the commitment for trial of any person in respect of any indictable offence against the law of the Commonwealth; or  (b) institute proceedings for the summary conviction of any person in respect of any offence against the law of the Commonwealth punishable on summary conviction."@en ;
    cml:integrityHash "c13ea69f781ded38f0580d366381237dd79abc62d07e51b17004908c2df6f5bc" ;
    cof:pageNumber "339"^^xsd:integer ;
    skos:note "Any person may institute proceedings for trial or summary conviction." ;
    cml:curationStatus cml:Proposed ;
