doc:sec-3ca-ss-3 a cof:Section ;
    cof:title "3CA(3) Nature of functions of magistrate" ;
    values:kind "subsection" ;
    values:originalText "(3) A magistrate performing a function of, or connected with, making an order under section 3ZI, 3ZJ, 3ZK, 3ZN or 3ZQZB has the same protection and immunity as if he or she were performing that function as, or as a member of, a court (being the court of which the magistrate is a member)." ;
    cof:pageNumber "38"^^xsd:integer .

concept:crimes-act-1914-sec-3ca-ss-4 a cml:Concept ;
    skos:prefLabel "3CA(4) Nature of functions of magistrate"@en ;
    cml:realizedBy doc:sec-3ca-ss-4 ;
    values:originalText "(4) The Governor-General may make arrangements with the Governor of a State, the Chief Minister of the Australian Capital Territory or the Administrator of the Northern Territory for the performance, by all or any of the persons who from time to time hold office as magistrates in that State or Territory, of the function of making orders under sections 3ZI, 3ZJ, 3ZK, 3ZN and 3ZQZB." ;
    skos:definition "(4) The Governor-General may make arrangements with the Governor of a State, the Chief Minister of the Australian Capital Territory or the Administrator of the Northern Territory for the performance, by all or any of the persons who from time to time hold office as magistrates in that State or Territory, of the function of making orders under sections 3ZI, 3ZJ, 3ZK, 3ZN and 3ZQZB."@en ;
    cml:integrityHash "a04f7b52e78d8194d0dd743dda9b0461c458d9557e0ec79251749533753038ba" ;
    values:partOf concept:crimes-act-1914-sec-3ca ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Governor-General may make arrangements with other officials for magistrate performance" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.38" ;
