concept:crimes-act-1914-sec-3ze a cml:Concept ;
    skos:prefLabel "3ZE Power to conduct a frisk search of an arrested person"@en ;
    cml:realizedBy doc:sec-3ze ;
    values:originalText "A constable who arrests a person for an offence, or who is present at such an arrest, may, if the constable suspects on reasonable grounds that it is prudent to do so in order to ascertain whether the person is carrying any seizable items:  (a) conduct a frisk search of the person at or soon after the time of arrest; and  (b) seize any seizable items found as a result of the search." ;
    skos:definition "A constable who arrests a person for an offence, or who is present at such an arrest, may, if the constable suspects on reasonable grounds that it is prudent to do so in order to ascertain whether the person is carrying any seizable items:  (a) conduct a frisk search of the person at or soon after the time of arrest; and  (b) seize any seizable items found as a result of the search."@en ;
    cml:integrityHash "19db13b27fa1e27a074664b0924fb1786b0fce873c7f6dc405006d018bc4534a" ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "Constable may conduct frisk search of arrested person on reasonable grounds." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
