doc:sec-3x-ss-1 a cof:Section ;
    cof:title "3X(1) Arrest of prisoner unlawfully at large" ;
    values:kind "subsection" ;
    values:originalText "(1) A constable may, without warrant, arrest a person whom the constable believes on reasonable grounds to be a prisoner unlawfully at large." ;
    cof:pageNumber "111"^^xsd:integer .

