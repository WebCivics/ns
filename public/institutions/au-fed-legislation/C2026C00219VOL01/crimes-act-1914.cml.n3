concept:crimes-act-1914-sec-15e a cml:Concept ;
    skos:prefLabel "15E Privilege of Parliament not affected"@en ;
    cml:realizedBy doc:sec-15e ;
    values:originalText "Nothing in this Act shall derogate from any power or privilege of either House of the Parliament or of the members or committees of either House of Parliament as existing at the commencement of this Act." ;
    skos:definition "Nothing in this Act shall derogate from any power or privilege of either House of the Parliament or of the members or committees of either House of Parliament as existing at the commencement of this Act."@en ;
