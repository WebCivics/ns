concept:crimes-act-1914-sec-3ud-ss-2 a cml:Concept ;
    skos:prefLabel "3UD(2) Stopping and searching"@en ;
    cml:realizedBy doc:sec-3ud-ss-2 ;
    values:originalText "(2) A police officer who conducts a search of a person under this section must not use more force, or subject the person to greater indignity, than is reasonable and necessary in order to conduct the search." ;
    skos:definition "(2) A police officer who conducts a search of a person under this section must not use more force, or subject the person to greater indignity, than is reasonable and necessary in order to conduct the search."@en ;
