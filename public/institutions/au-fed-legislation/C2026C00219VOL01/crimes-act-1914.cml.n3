concept:crimes-act-1914-sec-3zr a cml:Concept ;
    skos:prefLabel "3ZR Conduct of ordinary searches and frisk searches"@en ;
    cml:realizedBy doc:sec-3zr ;
    values:originalText "An ordinary search or a frisk search of a person under this Part must, if practicable, be conducted by a person of the same sex as the person being searched." ;
    skos:definition "An ordinary search or a frisk search of a person under this Part must, if practicable, be conducted by a person of the same sex as the person being searched."@en ;
    cml:integrityHash "78d11cef36cd835e8e85491513271f50a30711713c29e4bdbbfbb6607df1ceb2" ;
