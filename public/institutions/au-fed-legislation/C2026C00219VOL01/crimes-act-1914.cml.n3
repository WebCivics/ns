concept:crimes-act-1914-sec-3zt a cml:Concept ;
    skos:prefLabel "3ZT Offence for making false statements in warrants"@en ;
    cml:realizedBy doc:sec-3zt ;
    values:originalText "A person must not make, in an application for a warrant, a statement that the person knows to be false or misleading in a material particular. Penalty: Imprisonment for 2 years." ;
    skos:definition "A person must not make, in an application for a warrant, a statement that the person knows to be false or misleading in a material particular. Penalty: Imprisonment for 2 years."@en ;
    cml:integrityHash "b0f2454d782d29b0b96c6f6c1f92107bb9eba9055c76d011a49e379350760598" ;
    cof:pageNumber "164"^^xsd:integer ;
    skos:note "Making false statements in warrant applications is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
