doc:sec-4c-ss-1 a cof:Section ;
    cof:title "4C(1) Offences under 2 or more laws" ;
    values:kind "subsection" ;
    values:originalText "(1) Where an act or omission constitutes an offence:  (a) under 2 or more laws of the Commonwealth; or  (b) both under a law of the Commonwealth and at common law; the offender shall, unless the contrary intention appears, be liable to be prosecuted and punished under either or any of those laws of the Commonwealth or at common law, but shall not be liable to be punished twice for the same act or omission." ;
    cof:pageNumber "331"^^xsd:integer .

concept:crimes-act-1914-sec-4c-ss-2 a cml:Concept ;
    skos:prefLabel "4C(2) Offences under 2 or more laws"@en ;
    cml:realizedBy doc:sec-4c-ss-2 ;
    values:originalText "(2) Where an act or omission constitutes an offence under both:  (a) a law of the Commonwealth and a law of a State; or  (b) a law of the Commonwealth and a law of a Territory; and the offender has been punished for that offence under the law of the State or the law of the Territory, as the case may be, the offender shall not be liable to be punished for the offence under the law of the Commonwealth." ;
    skos:definition "(2) Where an act or omission constitutes an offence under both:  (a) a law of the Commonwealth and a law of a State; or  (b) a law of the Commonwealth and a law of a Territory; and the offender has been punished for that offence under the law of the State or the law of the Territory, as the case may be, the offender shall not be liable to be punished for the offence under the law of the Commonwealth."@en ;
    cml:integrityHash "9bf92fe0a229c7cef08d583262bb65ced0d9507f102b95c8a14d8fa9bfe7d135" ;
    values:partOf concept:crimes-act-1914-sec-4c ;
    cof:pageNumber "331"^^xsd:integer ;
    skos:note "Offender not liable for Commonwealth offence if already punished under State or Territory law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.331" ;
    cml:asserts concept:crimes-act-1914-sec-4c-ss-2-norm .
concept:crimes-act-1914-sec-4c-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-4c-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-deontic-1 .
concept:crimes-act-1914-sec-4c-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If offender not liable, then Commonwealth offence cannot be committed." ;
    cml:premiseText "(not (offender liable to Commonwealth law)) -> (not (Commonwealth offence committed))" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-alleninterval-2 .
concept:crimes-act-1914-sec-4c-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Offence under multiple laws overlaps in time." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (Commonwealth offence) ∩ (Territory offence) ≠ ∅" ;
    cml:conclusionText "(offender not punished for Commonwealth offence) -> (offender not liable to Commonwealth law)" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-ltl-3 .
concept:crimes-act-1914-sec-4c-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Offence under multiple laws occurs until offender is punished." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (offender not punished for Commonwealth offence)" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-diffusion-4 .
concept:crimes-act-1914-sec-4c-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Offence under multiple laws diffuses through time." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (offender not punished for Commonwealth offence)" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-4c-ss-2 cml:asserts concept:crimes-act-1914-sec-4c-ss-2-logic-cogai-5 .
concept:crimes-act-1914-sec-4c-ss-2-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "Offence under multiple laws recognized by AI." ;
    cml:premiseText "(Commonwealth offence) ∩ (State offence) ≠ ∅ ∧ (offender not punished for Commonwealth offence)" ;
    cml:conclusionText "(offender not liable to Commonwealth law) -> (offender not punished for Commonwealth offence)" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-4c-ss-2 a cof:Section ;
    cof:title "4C(2) Offences under 2 or more laws" ;
    values:kind "subsection" ;
    values:originalText "(2) Where an act or omission constitutes an offence under both:  (a) a law of the Commonwealth and a law of a State; or  (b) a law of the Commonwealth and a law of a Territory; and the offender has been punished for that offence under the law of the State or the law of the Territory, as the case may be, the offender shall not be liable to be punished for the offence under the law of the Commonwealth." ;
    cof:pageNumber "331"^^xsd:integer .

concept:crimes-act-1914-sec-4c-ss-3 a cml:Concept ;
    skos:prefLabel "4C(3) Offences under 2 or more laws"@en ;
    cml:realizedBy doc:sec-4c-ss-3 ;
    values:originalText "(3) Where an act or omission constitutes an offence against a law of a Territory, the validity of that law is not affected merely because the act or omission also constitutes an offence against a law of the Commonwealth." ;
    skos:definition "(3) Where an act or omission constitutes an offence against a law of a Territory, the validity of that law is not affected merely because the act or omission also constitutes an offence against a law of the Commonwealth."@en ;
    cml:integrityHash "d6c9e44b3aaa6a9aba67ce9de74ef1475d49e7e01e66068f5d3b1504636f8a94" ;
    values:partOf concept:crimes-act-1914-sec-4c ;
    cof:pageNumber "331"^^xsd:integer ;
    skos:note "Validity of a law is not affected by concurrent offences against other laws." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.331" ;
    cml:asserts concept:crimes-act-1914-sec-4c-ss-3-norm .
concept:crimes-act-1914-sec-4c-ss-3-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-4c-ss-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-4c-ss-3 cml:asserts concept:crimes-act-1914-sec-4c-ss-3-logic-deontic-1 .
concept:crimes-act-1914-sec-4c-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to uphold the law" ;
    cml:premiseText "The validity of a law is not affected." ;
    cml:conclusionText "Therefore, it is an obligation to uphold the law." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-4c-ss-3 a cof:Section ;
    cof:title "4C(3) Offences under 2 or more laws" ;
    values:kind "subsection" ;
    values:originalText "(3) Where an act or omission constitutes an offence against a law of a Territory, the validity of that law is not affected merely because the act or omission also constitutes an offence against a law of the Commonwealth." ;
    cof:pageNumber "331"^^xsd:integer .

concept:crimes-act-1914-sec-4d a cml:Concept ;
    skos:prefLabel "4D Penalties"@en ;
    cml:realizedBy doc:sec-4d ;
    values:originalText "(1) Except so far as the contrary intention appears, a penalty, whether pecuniary or otherwise, set out at the foot of any provision of an Act as described in a paragraph of subsection (1A) indicates:  (a) if the provision expressly creates an offence—that the offence is punishable on conviction by a penalty not exceeding the penalty so set out; or  (b) in any other case—that contravention of the provision is an offence against the provision, punishable on conviction by a penalty not exceeding the penalty so set out.  (1A) Subsection (1) applies to a penalty set out:  (a) at the foot of a section of an Act; or  (b) at the foot of a subsection of an Act, but not at the foot of the section containing the subsection; or  (c) at the foot of a clause of any Schedule to an Act; or  (d) at the foot of a subclause of any Schedule to an Act, but not at the foot of the clause containing the subclause.  (1B) Subsection (1) does not affect the operation of subsection 4B(2), (2A) or (3).  (2) Subsection (1) applies to any instrument made under an Act (including rules, regulations or by-laws but not including a law of a Territory) as if the instrument were an Act and as if each such rule, regulation or by-law were a section of an Act." ;
    skos:definition "(1) Except so far as the contrary intention appears, a penalty, whether pecuniary or otherwise, set out at the foot of any provision of an Act as described in a paragraph of subsection (1A) indicates:  (a) if the provision expressly creates an offence—that the offence is punishable on conviction by a penalty not exceeding the penalty so set out; or  (b) in any other case—that contravention of the provision is an offence against the provision, punishable on conviction by a penalty not exceeding the penalty so set out.  (1A) Subsection (1) applies to a penalty set out:  (a) at the foot of a section of an Act; or  (b) at the foot of a subsection of an Act, but not at the foot of the section containing the subsection; or  (c) at the foot of a clause of any Schedule to an Act; or  (d) at the foot of a subclause of any Schedule to an Act, but not at the foot of the clause containing the subclause.  (1B) Subsection (1) does not affect the operation of subsection 4B(2), (2A) or (3).  (2) Subsection (1) applies to any instrument made under an Act (including rules, regulations or by-laws but not including a law of a Territory) as if the instrument were an Act and as if each such rule, regulation or by-law were a section of an Act."@en ;
    cml:integrityHash "6cd13586ddc1f3fcde60d0d0e98dd5f7151029281e18dc4f1e4a056a28bd126b" ;
    cof:pageNumber "332"^^xsd:integer ;
    cml:hasPart concept:crimes-act-1914-sec-4d-ss-1 ;
    cml:hasPart concept:crimes-act-1914-sec-4d-ss-1a ;
    cml:hasPart concept:crimes-act-1914-sec-4d-ss-1b ;
    cml:hasPart concept:crimes-act-1914-sec-4d-ss-2a ;
    cml:hasPart concept:crimes-act-1914-sec-4d-ss-2 ;
