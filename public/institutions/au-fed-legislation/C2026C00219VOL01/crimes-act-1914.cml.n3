concept:crimes-act-1914-sec-4m a cml:Concept ;
    skos:prefLabel "4M Children under 10"@en ;
    cml:realizedBy doc:sec-4m ;
    values:originalText "A child under 10 years old cannot be liable for an offence against a law of the Commonwealth." ;
    skos:definition "A child under 10 years old cannot be liable for an offence against a law of the Commonwealth."@en ;
    cml:integrityHash "353a0c2f835a4f204c58b05d35a251a6cd301d958e5f952743daa9dc9d24c44d" ;
    cof:pageNumber "337"^^xsd:integer ;
    skos:note "No liability for children under 10" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.337" ;
