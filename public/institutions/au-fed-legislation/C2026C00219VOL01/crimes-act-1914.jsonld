    {
      "@id": "concept:crimes-act-1914-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 January or 1 July the Ombudsman must give a written report to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-1-2"
      },
      "cml:curationStatus": {
