      },
      "dc:source": "crimes-act-1914.pdf, p.70",
      "values:originalText": "(6) For the purposes of subsection (1):\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "skos:definition": "(6) For the purposes of subsection (1):\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "values:partOf": {
