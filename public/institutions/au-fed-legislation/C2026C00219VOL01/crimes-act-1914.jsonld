      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.113",
      "values:originalText": "(1) Subject to subsection (3), if:\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "skos:definition": "(1) Subject to subsection (3), if:\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "cml:asserts": [
        {
