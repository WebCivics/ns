    {
      "@id": "concept:crimes-act-1914-sec-3ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "3BA Application of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ba"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.32",
      "values:originalText": "Chapter 2 of the Criminal Code applies to all offences against this\nAct.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nPreliminary  Division 1\n\nSection 3C\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\nPart IAA—Search, information gathering, arrest\nand related powers (other than powers\nunder delayed notification search\nwarrants)",
      "skos:definition": "Chapter 2 of the Criminal Code applies to all offences against this\nAct.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nPreliminary  Division 1\n\nSection 3C\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\nPart IAA—Search, information gathering, arrest\nand related powers (other than powers\nunder delayed notification search\nwarrants)",
