    {
      "@id": "concept:crimes-act-1914-sec-15f",
      "@type": "cml:Concept",
      "skos:prefLabel": "15F Civil rights not affected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
