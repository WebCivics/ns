    {
      "@id": "concept:crimes-act-1914-sec-3zf",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZF Power to conduct an ordinary search of an arrested person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zf"
