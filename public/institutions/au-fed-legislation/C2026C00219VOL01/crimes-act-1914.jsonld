        }
      ],
      "cml:integrityHash": "6aacec0a9067f2367621af7b44c3724c665129c1090b8f37c9031c307462199d",
      "skos:note": "Must provide a receipt for things seized under warrant or moved.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3q-ss-1",
      "@type": "cof:Section",
      "cof:title": "3Q(1) Receipts for things seized under warrant or moved",
      "values:kind": "subsection",
      "cof:pageNumber": 73,
      "values:originalText": "(1) If a thing is seized under a warrant or moved under\nsubsection 3K(2), the executing officer or a constable assisting\nmust provide a receipt for the thing."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3q-ss-1-norm",
