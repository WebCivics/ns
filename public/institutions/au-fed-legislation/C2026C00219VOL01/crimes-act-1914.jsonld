    {
      "@id": "concept:crimes-act-1914-sec-4l",
      "@type": "cml:Concept",
      "skos:prefLabel": "4L Specified defences not to preclude other defences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.336",
      "values:originalText": "Where a provision of a law of the Commonwealth provides a\ndefence to a particular offence, the provision does not, unless the\ncontrary intention appears, prevent the use of any defence that is\notherwise available.\n\n\nGeneral  Part IA\n\nSection 4M\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "Where a provision of a law of the Commonwealth provides a\ndefence to a particular offence, the provision does not, unless the\ncontrary intention appears, prevent the use of any defence that is\notherwise available.\n\n\nGeneral  Part IA\n\nSection 4M\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-4l-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-4l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "309d0ec4b66ab83d4b5a85f39e9de07ec25b99feb5c7727d2610d12923e5ce2a",
      "skos:note": "No defence is prevented by another available defence unless otherwise intended."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4l",
      "@type": "cof:Section",
      "cof:title": "4L Specified defences not to preclude other defences",
      "values:kind": "section",
      "cof:pageNumber": 336,
      "values:originalText": "Where a provision of a law of the Commonwealth provides a\ndefence to a particular offence, the provision does not, unless the\ncontrary intention appears, prevent the use of any defence that is\notherwise available.\n\n\nGeneral  Part IA\n\nSection 4M\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
