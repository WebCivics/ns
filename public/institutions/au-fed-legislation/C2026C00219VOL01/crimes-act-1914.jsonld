        },
        {
          "@id": "concept:crimes-act-1914-sec-3ue-ss-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "0e17a1627630392889ead13e5f06a817b4f29039492c3ee368dfc55611d6e666",
      "skos:note": "Police may secure premises pending warrant for indictable or summary offence."
    },
    {
