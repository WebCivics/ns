      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.123",
      "values:originalText": "(1) If:\n\n(a) identification material has been taken from a person under\nsection 3ZJ; and\n\n(b) a period of 12 months has elapsed since the identification\nmaterial was taken; and\n\n(c) proceedings in respect of an offence to which the\ninvestigation material relates have not been instituted or have\nbeen discontinued;\nthe identification material must be destroyed as soon as practicable.",
      "skos:definition": "(1) If:\n\n(a) identification material has been taken from a person under\nsection 3ZJ; and\n\n(b) a period of 12 months has elapsed since the identification\nmaterial was taken; and\n\n(c) proceedings in respect of an offence to which the\ninvestigation material relates have not been instituted or have\nbeen discontinued;\nthe identification material must be destroyed as soon as practicable.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3zk"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3zk-ss-1-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3zk-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "39ea76e7ee226e4a1c951b174c0a688d8b9989af9618dd1571afa49e083eb4a7",
      "skos:note": "Destruction of identification material after 12 months without proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zk-ss-1",
      "@type": "cof:Section",
      "cof:title": "3ZK(1) Destruction of identification material",
      "values:kind": "subsection",
      "cof:pageNumber": 123,
      "values:originalText": "(1) If:\n\n(a) identification material has been taken from a person under\nsection 3ZJ; and\n\n(b) a period of 12 months has elapsed since the identification\nmaterial was taken; and\n\n(c) proceedings in respect of an offence to which the\ninvestigation material relates have not been instituted or have\nbeen discontinued;\nthe identification material must be destroyed as soon as practicable."
    },
    {
