    {
      "@id": "concept:crimes-act-1914-sec-3zt",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZT Offence for making false statements in warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zt"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.164",
      "values:originalText": "A person must not make, in an application for a warrant, a\nstatement that the person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "A person must not make, in an application for a warrant, a\nstatement that the person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 2 years.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3zt-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3zt-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b0f2454d782d29b0b96c6f6c1f92107bb9eba9055c76d011a49e379350760598",
      "skos:note": "Making false statements in warrant applications is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zt",
      "@type": "cof:Section",
      "cof:title": "3ZT Offence for making false statements in warrants",
      "values:kind": "section",
      "cof:pageNumber": 164,
      "values:originalText": "A person must not make, in an application for a warrant, a\nstatement that the person knows to be false or misleading in a\nmaterial particular.\nPenalty: Imprisonment for 2 years."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zt-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
