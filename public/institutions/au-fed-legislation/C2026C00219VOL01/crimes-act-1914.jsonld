    {
      "@id": "concept:crimes-act-1914-sec-3wa",
      "@type": "cml:Concept",
      "skos:prefLabel": "3WA Constables’ power of arrest without warrant for a terrorism",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3wa"
