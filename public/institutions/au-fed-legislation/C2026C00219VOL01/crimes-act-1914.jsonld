          "@id": "concept:crimes-act-1914-sec-3zi-ss-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3zi-ss-5"
        }
      ],
      "cml:integrityHash": "cacd572e620abdb9e94360c363cdcc5cc9b572cb83dfd5ed99e9c6eb70dcb444"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zi",
