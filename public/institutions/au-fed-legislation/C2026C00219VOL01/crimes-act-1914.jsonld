        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Issuing officer has an obligation to issue warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Application information is considered.",
      "cml:conclusionText": "Warrant should be issued."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3s",
      "@type": "cml:Concept",
      "skos:prefLabel": "3S Restrictions on personal searches",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.74",
      "values:originalText": "A warrant cannot authorise a strip search or a search of a person’s\nbody cavities.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nSearch warrants  Division 2\n\nSection 3SA\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "A warrant cannot authorise a strip search or a search of a person’s\nbody cavities.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nSearch warrants  Division 2\n\nSection 3SA\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3s-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3s-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a603e4eba6a352634eaddd2cab38d221278207d9a56e9f8045bca004b372affe",
      "skos:note": "Restrictions on personal searches"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3s",
      "@type": "cof:Section",
      "cof:title": "3S Restrictions on personal searches",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "A warrant cannot authorise a strip search or a search of a person’s\nbody cavities.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nSearch warrants  Division 2\n\nSection 3SA\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
