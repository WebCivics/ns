    {
      "@id": "concept:crimes-act-1914-sec-4e",
      "@type": "cml:Concept",
      "skos:prefLabel": "4E Pecuniary penalties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.332",
      "values:originalText": "A pecuniary penalty for an offence against a law of the\nCommonwealth may, unless the contrary intention appears, be\nrecovered in any court of summary jurisdiction.",
      "skos:definition": "A pecuniary penalty for an offence against a law of the\nCommonwealth may, unless the contrary intention appears, be\nrecovered in any court of summary jurisdiction.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-4e-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-4e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c90e88ffdfadc2dc4156df09cbdc51635aed6c7bedb79d3d35ecdaa3956585b3",
      "skos:note": "Recovery of pecuniary penalties in summary jurisdiction courts."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4e",
      "@type": "cof:Section",
      "cof:title": "4E Pecuniary penalties",
      "values:kind": "section",
      "cof:pageNumber": 332,
      "values:originalText": "A pecuniary penalty for an offence against a law of the\nCommonwealth may, unless the contrary intention appears, be\nrecovered in any court of summary jurisdiction."
    },
    {
      "@id": "concept:crimes-act-1914-sec-4e-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
