    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UE(4) Seizure of terrorism related items and serious offence related",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ue-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.82",
      "values:originalText": "(4) Premises must not be secured under subsection (3) for longer than\nis reasonably necessary to obtain the warrant.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nPowers in relation to terrorist acts and terrorism offences  Division 3A\n\nSection 3UEB\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "(4) Premises must not be secured under subsection (3) for longer than\nis reasonably necessary to obtain the warrant.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nPowers in relation to terrorist acts and terrorism offences  Division 3A\n\nSection 3UEB\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3ue"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3ue-ss-4-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3ue-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d195f42bb99c8d635d6f471fbff68118a30fdf670c5986e31ecb83d02384fcf5",
      "skos:note": "Securing premises for longer than reasonably necessary without a warrant is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ue-ss-4",
      "@type": "cof:Section",
      "cof:title": "3UE(4) Seizure of terrorism related items and serious offence related",
      "values:kind": "subsection",
      "cof:pageNumber": 82,
      "values:originalText": "(4) Premises must not be secured under subsection (3) for longer than\nis reasonably necessary to obtain the warrant.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nPowers in relation to terrorist acts and terrorism offences  Division 3A\n\nSection 3UEB\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-4-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
