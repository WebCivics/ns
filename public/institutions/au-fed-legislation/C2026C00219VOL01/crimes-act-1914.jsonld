    {
      "@id": "concept:crimes-act-1914-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Accessory after the fact",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.337",
      "values:originalText": "Any person who receives or assists another person, who has, to his\nor her knowledge, committed any offence against a law of the\nCommonwealth, in order to enable him or her to escape\npunishment or to dispose of the proceeds of the offence commits\nan offence.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "Any person who receives or assists another person, who has, to his\nor her knowledge, committed any offence against a law of the\nCommonwealth, in order to enable him or her to escape\npunishment or to dispose of the proceeds of the offence commits\nan offence.\nPenalty: Imprisonment for 2 years.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-6-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4704c41a1046041c4b15a297c9e8ac6c2ae5780b2de8af91f6acfdb669c414ca",
      "skos:note": "Receiving or assisting someone who has committed an offence to escape punishment is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Accessory after the fact",
      "values:kind": "section",
      "cof:pageNumber": 337,
      "values:originalText": "Any person who receives or assists another person, who has, to his\nor her knowledge, committed any offence against a law of the\nCommonwealth, in order to enable him or her to escape\npunishment or to dispose of the proceeds of the offence commits\nan offence.\nPenalty: Imprisonment for 2 years."
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-6"
      },
