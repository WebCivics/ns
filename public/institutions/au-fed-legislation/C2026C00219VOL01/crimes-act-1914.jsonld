    {
      "@id": "concept:crimes-act-1914-sec-3zk-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZK(3) Destruction of identification material",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zk-ss-3"
      },
      "cml:curationStatus": {
