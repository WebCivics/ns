        }
      ],
      "cml:integrityHash": "15178cded94d170ed0ad5dfe396a8b90bfb85e594790652af32bbd83f6d9a78b",
      "skos:note": "Must provide a reasonable excuse for refusing identification material.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zl-ss-3",
      "@type": "cof:Section",
      "cof:title": "3ZL(3) Offence of refusing to allow identification material to be taken",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(3) Subsection (2) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (3) (see subsection 13.3(3) of the Criminal Code)."
    },
