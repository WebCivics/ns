      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) In the course of searching for the thing, the police officer may also seize any other thing...",
      "cml:conclusionText": "Police may seize other items or take actions to make premises safe without a warrant if necessary for protecting life, health, or safety."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Describes the timing of the action.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) In the course of searching for the thing...",
      "cml:conclusionText": "The police officer may seize other items or take actions to make premises safe at any time during the search."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Describes the temporal relationship between the action and its justification.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) In the course of searching for the thing...",
      "cml:conclusionText": "The police officer may seize other items or take actions to make premises safe until the search is complete."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-5-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Describes how the action affects others.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) In the course of searching for the thing...",
      "cml:conclusionText": "The police officer's actions may affect the safety of others in the premises."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-5-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
