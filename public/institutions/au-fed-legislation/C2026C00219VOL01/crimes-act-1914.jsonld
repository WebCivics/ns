      },
      "cml:premiseText": "(b) there is an emergency situation; and\n(c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the\nconstables assisting will not be able to return to the premises\nwithin the 12 hour period mentioned in paragraph 3J(2)(aa);",
      "cml:conclusionText": "(b) there is an emergency situation; and\n(c) the executing officer or a constable assisting believes on reasonable grounds that the executing officer and the\nconstables assisting will not be able to return to the premises\nwithin the 12 hour period mentioned in paragraph 3J(2)(aa);"
    },
