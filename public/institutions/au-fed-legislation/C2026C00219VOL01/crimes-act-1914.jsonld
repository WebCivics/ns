    {
      "@id": "concept:crimes-act-1914-sec-3zr",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZR Conduct of ordinary searches and frisk searches",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.164",
      "values:originalText": "An ordinary search or a frisk search of a person under this Part\nmust, if practicable, be conducted by a person of the same sex as\nthe person being searched.",
      "skos:definition": "An ordinary search or a frisk search of a person under this Part\nmust, if practicable, be conducted by a person of the same sex as\nthe person being searched.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3zr-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3zr-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "78d11cef36cd835e8e85491513271f50a30711713c29e4bdbbfbb6607df1ceb2",
      "skos:note": "Must conduct search by person of same sex as the person being searched."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zr",
      "@type": "cof:Section",
      "cof:title": "3ZR Conduct of ordinary searches and frisk searches",
      "values:kind": "section",
      "cof:pageNumber": 164,
      "values:originalText": "An ordinary search or a frisk search of a person under this Part\nmust, if practicable, be conducted by a person of the same sex as\nthe person being searched."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zr-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3zr"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zr-logic-deontic-1",
