      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15b-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Permits prosecution at any time within one year.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Notwithstanding...",
      "cml:conclusionText": "...prosecution for an offence..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15c",
      "@type": "cml:Concept",
      "skos:prefLabel": "15C Form of indictments, information and summonses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.352",
      "values:originalText": "(1) At the hearing of any indictment, information or summons, the\ncourt may make such amendment in the indictment, information or\nsummons as appears to it to be desirable or to be necessary to\nenable the real question in dispute to be determined.\n\n(2) If in any such case the court considers that the defendant has been\nmisled by the form in which the indictment, information or\nsummons has been made out, it may adjourn the hearing of the\ncase for such period as it thinks fit and may make such order as to\nthe costs of the adjournment as it thinks proper.\n\n(3) The power of the court under subsection (1) shall not be exercised\nin cases where the court considers that the required amendments\ncannot be made without injustice to the defendant.",
      "skos:definition": "(1) At the hearing of any indictment, information or summons, the\ncourt may make such amendment in the indictment, information or\nsummons as appears to it to be desirable or to be necessary to\nenable the real question in dispute to be determined.\n\n(2) If in any such case the court considers that the defendant has been\nmisled by the form in which the indictment, information or\nsummons has been made out, it may adjourn the hearing of the\ncase for such period as it thinks fit and may make such order as to\nthe costs of the adjournment as it thinks proper.\n\n(3) The power of the court under subsection (1) shall not be exercised\nin cases where the court considers that the required amendments\ncannot be made without injustice to the defendant.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-15c-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15c-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15c-ss-3"
        }
      ],
      "cml:integrityHash": "70b36664d78fc0548d11d7e48772bd2e5144356ce12c7c22ca704edae710b261"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15c",
      "@type": "cof:Section",
      "cof:title": "15C Form of indictments, information and summonses",
      "values:kind": "section",
      "cof:pageNumber": 352,
      "values:originalText": "(1) At the hearing of any indictment, information or summons, the\ncourt may make such amendment in the indictment, information or\nsummons as appears to it to be desirable or to be necessary to\nenable the real question in dispute to be determined.\n\n(2) If in any such case the court considers that the defendant has been\nmisled by the form in which the indictment, information or\nsummons has been made out, it may adjourn the hearing of the\ncase for such period as it thinks fit and may make such order as to\nthe costs of the adjournment as it thinks proper.\n\n(3) The power of the court under subsection (1) shall not be exercised\nin cases where the court considers that the required amendments\ncannot be made without injustice to the defendant."
    },
