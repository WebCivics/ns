    {
      "@id": "concept:crimes-act-1914-sec-3ur",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UR Move-on directions at airports—alternative constitutional",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ur"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
