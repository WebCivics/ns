      },
      "cml:premiseText": "(b) the notice specifies that information about the notice must not be disclosed;",
      "cml:conclusionText": "Disclosing the existence or nature of the notice."
    },
    {
      "@id": "concept:crimes-act-1914-sec-149-ss-1-logic-deontic-3",
