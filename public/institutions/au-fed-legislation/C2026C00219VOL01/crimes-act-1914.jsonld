    {
      "@id": "concept:crimes-act-1914-sec-3uh",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UH Relationship of Subdivision to other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3uh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.89",
      "values:originalText": "(1) The powers conferred, and duties imposed, by this Subdivision on\npolice officers are in addition to, and not in derogation of, any\nother powers conferred, or duties imposed, by any other law of the\nCommonwealth or the law of a State or Territory.\n\n(2) This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or the law of a State or\nTerritory in so far as it is capable of operating concurrently with\nthis Subdivision.\nSubdivision C—Prescribed security zones",
      "skos:definition": "(1) The powers conferred, and duties imposed, by this Subdivision on\npolice officers are in addition to, and not in derogation of, any\nother powers conferred, or duties imposed, by any other law of the\nCommonwealth or the law of a State or Territory.\n\n(2) This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or the law of a State or\nTerritory in so far as it is capable of operating concurrently with\nthis Subdivision.\nSubdivision C—Prescribed security zones",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-3uh-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3uh-ss-2"
        }
      ],
      "cml:integrityHash": "80a75284eff20de4f627c7336d499ebb62da16a7436ec3d25194d250205829d8"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3uh",
      "@type": "cof:Section",
      "cof:title": "3UH Relationship of Subdivision to other laws",
      "values:kind": "section",
      "cof:pageNumber": 89,
