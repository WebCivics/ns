      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-9b"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-9b-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-9b-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a47ff5a4de38d9e194482e974ecd87e26c880409d288053e4d15842cfd102741",
      "skos:note": "Applicable regulations from Proceeds of Crime Act 2002"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-9b-ss-3",
      "@type": "cof:Section",
      "cof:title": "9B(3) Costs etc. payable to Official Trustee",
      "values:kind": "subsection",
      "cof:pageNumber": 338,
      "values:originalText": "(3) Where there are no regulations in relation to a matter referred to in\nsubsection (1):\n\n(a) the regulations referred to in section 288 of the Proceeds of\nCrime Act 2002 apply, so far as they are applicable, and with\nappropriate changes, in relation to the matter; and\n\n(b) a reference in subsection (1) or (2) to regulations is taken to\nbe a reference to the regulations referred to in section 288 of\nthe Proceeds of Crime Act 2002."
    },
    {
      "@id": "concept:crimes-act-1914-sec-9b-ss-3-norm",
      "@type": "values:Obligation",
