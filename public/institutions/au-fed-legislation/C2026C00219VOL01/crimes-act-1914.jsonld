        },
        {
          "@id": "concept:crimes-act-1914-sec-3zm-ss-2a-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "faa5c60c98f6e76795d8326651335ae42e930dfda72ec32b82337252b7468dcd",
      "skos:note": "Consideration for holding an identification parade"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zm-ss-2a",
