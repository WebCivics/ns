    {
      "@id": "concept:crimes-act-1914-sec-4g",
      "@type": "cml:Concept",
      "skos:prefLabel": "4G Indictable offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
