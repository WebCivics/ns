    {
      "@id": "concept:crimes-act-1914-sec-3zg",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZG Power to conduct search of arrested person’s premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.116",
      "values:originalText": "A constable who arrests a person at premises for an offence, or\nwho is present at such an arrest, may seize things in plain view at\nthose premises that the constable believes on reasonable grounds to\nbe:\n\n(a) evidential material in relation to that or another offence; or\n\n(b) seizable items.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nArrest and related matters  Division 4\n\nSection 3ZH\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "A constable who arrests a person at premises for an offence, or\nwho is present at such an arrest, may seize things in plain view at\nthose premises that the constable believes on reasonable grounds to\nbe:\n\n(a) evidential material in relation to that or another offence; or\n\n(b) seizable items.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nArrest and related matters  Division 4\n\nSection 3ZH\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3zg-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3zg-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "757c80ac26cd78fa31a6bdfff993a95a3a742b0726fd2713c023cd1d90d28764",
      "skos:note": "Constable may seize items in plain view at premises during arrest."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zg",
      "@type": "cof:Section",
      "cof:title": "3ZG Power to conduct search of arrested person’s premises",
      "values:kind": "section",
      "cof:pageNumber": 116,
      "values:originalText": "A constable who arrests a person at premises for an offence, or\nwho is present at such an arrest, may seize things in plain view at\nthose premises that the constable believes on reasonable grounds to\nbe:\n\n(a) evidential material in relation to that or another offence; or\n\n(b) seizable items.\n\n\nSearch, information gathering, arrest and related powers (other than powers under\ndelayed notification search warrants)  Part IAA\nArrest and related matters  Division 4\n\nSection 3ZH\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zg-norm",
