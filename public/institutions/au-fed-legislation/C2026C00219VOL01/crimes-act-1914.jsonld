    },
    {
      "@id": "concept:crimes-act-1914-sec-3zd",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZD Persons to be informed of grounds of arrest",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.115",
      "values:originalText": "(1) A person who arrests another person for an offence must inform\nthe other person, at the time of the arrest, of the offence for which\nthe other person is being arrested.\n\n(2) It is sufficient if the other person is informed of the substance of\nthe offence, and it is not necessary that this be done in language of\na precise or technical nature.\n\n(3) Subsection (1) does not apply to the arrest of the other person if:\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "skos:definition": "(1) A person who arrests another person for an offence must inform\nthe other person, at the time of the arrest, of the offence for which\nthe other person is being arrested.\n\n(2) It is sufficient if the other person is informed of the substance of\nthe offence, and it is not necessary that this be done in language of\na precise or technical nature.\n\n(3) Subsection (1) does not apply to the arrest of the other person if:\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-3zd-ss-1"
        },
