        }
      ],
      "cml:integrityHash": "deb5b16a6b53c4d889ae5ac3a48b62f9fc7099a64b74d5505d8e7bf1523f6156",
      "skos:note": "Equipment may be brought to premises for examination or processing."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3k-ss-1",
      "@type": "cof:Section",
      "cof:title": "3K(1) Use of equipment to examine or process things",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(1) The executing officer of a warrant in relation to premises, or\nconstable assisting, may bring to the warrant premises any\nequipment reasonably necessary for the examination or processing\nof a thing found at the premises in order to determine whether it is\na thing that may be seized under the warrant or a thing that\nsuggests the existence of a digital asset that may be seized under\nthe warrant.\nThing may be moved for examination or processing"
    },
