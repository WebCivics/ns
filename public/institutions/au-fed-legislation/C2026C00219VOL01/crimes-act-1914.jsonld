        }
      ],
      "cml:integrityHash": "ce8fea592d9dc0da0f0757167a47461c5283998de5147926038fefd00694a08e",
      "skos:note": "Constable may conduct ordinary search of arrested person if reasonable grounds suspected"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zf",
      "@type": "cof:Section",
