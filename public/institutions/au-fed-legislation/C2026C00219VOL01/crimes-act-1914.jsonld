        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zw",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZW Delegation by Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zw"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.165",
      "values:originalText": "(1) The Commissioner may delegate to a constable any or all of the\nCommissioner’s powers, functions or duties under this Part.\n\n(2) The Commissioner may delegate to a Commonwealth officer any\nor all of the Commissioner’s powers, functions or duties under\nDivision 4C of this Part if the Commissioner is satisfied on\nreasonable grounds that the officer is able to properly exercise\nthose powers, functions or duties.",
      "skos:definition": "(1) The Commissioner may delegate to a constable any or all of the\nCommissioner’s powers, functions or duties under this Part.\n\n(2) The Commissioner may delegate to a Commonwealth officer any\nor all of the Commissioner’s powers, functions or duties under\nDivision 4C of this Part if the Commissioner is satisfied on\nreasonable grounds that the officer is able to properly exercise\nthose powers, functions or duties.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-3zw-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3zw-ss-2"
        }
      ],
      "cml:integrityHash": "7f032d4fd057b5a5bd943659aedf78d39cd41ea516d21a19be20d889ac923302"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zw",
      "@type": "cof:Section",
      "cof:title": "3ZW Delegation by Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 165,
      "values:originalText": "(1) The Commissioner may delegate to a constable any or all of the\nCommissioner’s powers, functions or duties under this Part.\n\n(2) The Commissioner may delegate to a Commonwealth officer any\nor all of the Commissioner’s powers, functions or duties under\nDivision 4C of this Part if the Commissioner is satisfied on\nreasonable grounds that the officer is able to properly exercise\nthose powers, functions or duties."
    },
