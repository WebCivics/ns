      "cml:integrityHash": "b6b3b1d3a3fad96a65327f85acc0bd6b55f014c166b026f0da4d1c8f429efb14",
      "skos:note": "Court power not exercised in cases where amendments cannot be made without injustice to the defendant."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15c-ss-3",
      "@type": "cof:Section",
      "cof:title": "15C(3) Form of indictments, information and summonses",
      "values:kind": "subsection",
      "cof:pageNumber": 352,
      "values:originalText": "(3) The power of the court under subsection (1) shall not be exercised\nin cases where the court considers that the required amendments\ncannot be made without injustice to the defendant."
    },
