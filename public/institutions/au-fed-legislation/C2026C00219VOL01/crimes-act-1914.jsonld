          "@id": "concept:crimes-act-1914-sec-3q-ss-2-norm"
        }
      ],
      "cml:integrityHash": "4db106c9953a77eedad4f540d815ec254884e8fab22ce48794504fe6caac2a31",
      "skos:note": "Things seized or moved may be covered in one receipt."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3q-ss-2",
      "@type": "cof:Section",
      "cof:title": "3Q(2) Receipts for things seized under warrant or moved",
