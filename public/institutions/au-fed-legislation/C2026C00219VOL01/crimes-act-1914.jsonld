    {
      "@id": "concept:crimes-act-1914-sec-3ui",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UI Applications for declarations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ui"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.89",
      "values:originalText": "A police officer may apply to the Minister for a declaration that a\nCommonwealth place be declared as a prescribed security zone.\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "skos:definition": "A police officer may apply to the Minister for a declaration that a\nCommonwealth place be declared as a prescribed security zone.\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3ui-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3ui-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6ddbe443468d144bfd35c4f842917a41e25fc1732477618bf6210125172e2ccb",
      "skos:note": "Police officer may apply for declaration of security zone."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ui",
      "@type": "cof:Section",
      "cof:title": "3UI Applications for declarations",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "A police officer may apply to the Minister for a declaration that a\nCommonwealth place be declared as a prescribed security zone.\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3ui-norm",
