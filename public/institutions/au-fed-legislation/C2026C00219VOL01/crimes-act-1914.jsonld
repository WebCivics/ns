    {
      "@id": "concept:crimes-act-1914-sec-3zl-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZL(3) Offence of refusing to allow identification material to be taken",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zl-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
