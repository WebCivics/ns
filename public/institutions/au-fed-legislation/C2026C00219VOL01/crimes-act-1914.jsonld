    {
      "@id": "concept:crimes-act-1914-sec-3ue-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UE(3) Seizure of terrorism related items and serious offence related",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ue-ss-3"
