          "@id": "concept:crimes-act-1914-sec-149-ss-1-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "426601d0369f3bbc952e870b0a6b4985d79a494945a8d1bfe25650696cfd8424",
      "skos:note": "Disclosing notice information without permission is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-149-ss-1",
      "@type": "cof:Section",
      "cof:title": "149(1) Section 149",
      "values:kind": "subsection",
      "cof:pageNumber": 150,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person is given a notice under section 3ZQN or 3ZQO;\nand\n\n(b) the notice specifies that information about the notice must\nnot be disclosed; and\n\n(c) the person discloses the existence or nature of the notice.\nPenalty: 120 penalty units or imprisonment for 2 years, or both."
    },
