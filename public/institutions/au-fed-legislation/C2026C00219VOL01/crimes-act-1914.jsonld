    },
    {
      "@id": "concept:crimes-act-1914-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Institution of proceedings in respect of offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.339",
      "values:originalText": "Unless the contrary intention appears in the Act or regulation\ncreating the offence, any person may:\n\n(a) institute proceedings for the commitment for trial of any\nperson in respect of any indictable offence against the law of\nthe Commonwealth; or\n\n(b) institute proceedings for the summary conviction of any\nperson in respect of any offence against the law of the\nCommonwealth punishable on summary conviction.",
      "skos:definition": "Unless the contrary intention appears in the Act or regulation\ncreating the offence, any person may:\n\n(a) institute proceedings for the commitment for trial of any\nperson in respect of any indictable offence against the law of\nthe Commonwealth; or\n\n(b) institute proceedings for the summary conviction of any\nperson in respect of any offence against the law of the\nCommonwealth punishable on summary conviction.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-13-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c13ea69f781ded38f0580d366381237dd79abc62d07e51b17004908c2df6f5bc",
      "skos:note": "Any person may institute proceedings for trial or summary conviction."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Institution of proceedings in respect of offences",
      "values:kind": "section",
      "cof:pageNumber": 339,
      "values:originalText": "Unless the contrary intention appears in the Act or regulation\ncreating the offence, any person may:\n\n(a) institute proceedings for the commitment for trial of any\nperson in respect of any indictable offence against the law of\nthe Commonwealth; or\n\n(b) institute proceedings for the summary conviction of any\nperson in respect of any offence against the law of the\nCommonwealth punishable on summary conviction."
    },
    {
      "@id": "concept:crimes-act-1914-sec-13-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
