          "@id": "concept:crimes-act-1914-sec-3ud-ss-4"
        }
      ],
      "cml:integrityHash": "1d48b630fcf439f024f7390dc686c037e1b35ecc874347646971420c37c6f558"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ud",
