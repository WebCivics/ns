    },
    {
      "@id": "concept:crimes-act-1914-sec-3k-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "3K(3A) Use of equipment to examine or process things",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3k-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.58",
      "values:originalText": "(3A) The thing may be moved to another place for examination or\nprocessing for no longer than whichever of the following is\napplicable:\n\n(a) if the thing is a computer or data storage device—30 days;\n\n(b) otherwise—14 days.",
      "skos:definition": "(3A) The thing may be moved to another place for examination or\nprocessing for no longer than whichever of the following is\napplicable:\n\n(a) if the thing is a computer or data storage device—30 days;\n\n(b) otherwise—14 days.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3k"
      },
      "cml:asserts": [
