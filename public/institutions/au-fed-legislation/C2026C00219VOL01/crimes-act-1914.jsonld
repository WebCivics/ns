          "@id": "concept:crimes-act-1914-sec-3ud-ss-1b"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3ud-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3ud-ss-3"
        },
