    },
    {
      "@id": "concept:crimes-act-1914-sec-15b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "15B(2) Time for commencement of prosecutions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15b-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.351",
      "values:originalText": "(2) Notwithstanding any provision in any law of the Commonwealth\npassed before the commencement of this Act and providing any\nshorter time for the commencement of the prosecution, any\nprosecution for an offence against the law may be commenced at\nany time within one year after the commission of the offence.",
      "skos:definition": "(2) Notwithstanding any provision in any law of the Commonwealth\npassed before the commencement of this Act and providing any\nshorter time for the commencement of the prosecution, any\nprosecution for an offence against the law may be commenced at\nany time within one year after the commission of the offence.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15b"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15b-ss-2-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15b-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0c3ad01924de2f924ed3a9e78455d62963669d50f74cc16f1c454e8bdb29b912",
      "skos:note": "Prosecution can be commenced within one year after commission of offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15b-ss-2",
      "@type": "cof:Section",
      "cof:title": "15B(2) Time for commencement of prosecutions",
      "values:kind": "subsection",
      "cof:pageNumber": 351,
      "values:originalText": "(2) Notwithstanding any provision in any law of the Commonwealth\npassed before the commencement of this Act and providing any\nshorter time for the commencement of the prosecution, any\nprosecution for an offence against the law may be commenced at\nany time within one year after the commission of the offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15b-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15b-ss-2"
