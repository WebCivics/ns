      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.352",
      "values:originalText": "Nothing in this Act shall affect the right of any person aggrieved\nby any act or omission which is punishable as an offence against\nthis Act to institute civil proceedings in any court in respect of such\nact or omission.",
