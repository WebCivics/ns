    {
      "@id": "concept:crimes-act-1914-sec-3q",
      "@type": "cml:Concept",
      "skos:prefLabel": "3Q Receipts for things seized under warrant or moved",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.73",
      "values:originalText": "(1) If a thing is seized under a warrant or moved under\nsubsection 3K(2), the executing officer or a constable assisting\nmust provide a receipt for the thing.\n\n(2) If 2 or more things are seized or moved, they may be covered in\nthe one receipt.",
      "skos:definition": "(1) If a thing is seized under a warrant or moved under\nsubsection 3K(2), the executing officer or a constable assisting\nmust provide a receipt for the thing.\n\n(2) If 2 or more things are seized or moved, they may be covered in\nthe one receipt.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-3q-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3q-ss-2"
        }
      ],
      "cml:integrityHash": "a3d02b246d645dd42c2bbef9b1caedaa495a94350e0bbf4a76fd16d2fd7f14b3"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3q",
      "@type": "cof:Section",
      "cof:title": "3Q Receipts for things seized under warrant or moved",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "(1) If a thing is seized under a warrant or moved under\nsubsection 3K(2), the executing officer or a constable assisting\nmust provide a receipt for the thing.\n\n(2) If 2 or more things are seized or moved, they may be covered in\nthe one receipt."
    },
