        }
      ],
      "cml:integrityHash": "08b647506aac92385a7892f21e7ac61bc30c856a830af8c105056ded776026a4",
      "skos:note": "Provide adequate clothing after seizure of garments during strip search.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zi-ss-5",
