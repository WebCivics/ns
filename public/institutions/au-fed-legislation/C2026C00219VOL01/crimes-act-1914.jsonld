    },
    {
      "@id": "concept:crimes-act-1914-sec-3uf-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UF(2) Seizure notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3uf-ss-2"
      },
