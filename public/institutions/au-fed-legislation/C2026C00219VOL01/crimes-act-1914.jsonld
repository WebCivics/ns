        }
      ],
      "cml:integrityHash": "b706f8de304f7fa9d873e36682bea6e97c5789e709a07d1b7c100756d936174f",
      "skos:note": "Police officer must serve seizure notice within 7 days after seizure.",
      "dc:description": "seizure notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3uf-ss-1",
      "@type": "cof:Section",
      "cof:title": "3UF(1) Seizure notices",
      "values:kind": "subsection",
      "cof:pageNumber": 88,
      "values:originalText": "(1) A police officer who is for the time being responsible for a thing\nseized under section 3UE or 3UEA must, within 7 days after the\nday on which the thing was seized, serve a seizure notice on:\n\n(a) the owner of the thing; or\n\n(b) if the owner of the thing cannot be identified after reasonable\ninquiries—the person from whom the thing was seized."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3uf-ss-1-norm",
