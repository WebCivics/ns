    {
      "@id": "concept:crimes-act-1914-sec-4a",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A Meaning of certain words",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.327",
      "values:originalText": "In a law of the Commonwealth, unless the contrary intention\nappears:\ncommitted for trial, in relation to a person, means committed to\nprison with a view to the person being tried before a judge and\njury, or admitted to bail upon a recognizance to appear and be so\ntried.\nindictment includes an information and a presentment.",
      "skos:definition": "In a law of the Commonwealth, unless the contrary intention\nappears:\ncommitted for trial, in relation to a person, means committed to\nprison with a view to the person being tried before a judge and\njury, or admitted to bail upon a recognizance to appear and be so\ntried.\nindictment includes an information and a presentment.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-4a-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-4a-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-4a-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "31830316832d67abcee12382c48a429148412f3f59e15922a4b40e2fdcba2c03",
      "skos:note": "Defines indictment in relation to a person."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4a",
      "@type": "cof:Section",
      "cof:title": "4A Meaning of certain words",
      "values:kind": "section",
      "cof:pageNumber": 327,
      "values:originalText": "In a law of the Commonwealth, unless the contrary intention\nappears:\ncommitted for trial, in relation to a person, means committed to\nprison with a view to the person being tried before a judge and\njury, or admitted to bail upon a recognizance to appear and be so\ntried.\nindictment includes an information and a presentment."
    },
    {
      "@id": "concept:crimes-act-1914-sec-4a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-4a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-4a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Includes certain actions in an indictment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The contrary intention appears.",
      "cml:conclusionText": "Indictment includes an information and a presentment."
    },
    {
      "@id": "concept:crimes-act-1914-sec-4a-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "subClassOf",
      "cml:logicSummary": "Defines a subclass of 'information' and 'presentment'.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A recognizance to appear is admitted to bail.",
      "cml:conclusionText": "Indictment includes an information and a presentment."
    },
    {
      "@id": "concept:crimes-act-1914-sec-4aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "4AA Penalty units",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.327",
      "values:originalText": "(1) In a law of the Commonwealth or a Territory Ordinance, unless the\ncontrary intention appears:\npenalty unit means the amount of $330 (subject to indexation\nunder subsection (3)).\n\n(1A) If the amount of a penalty unit is indexed under subsection (3), the\nMinister must, by notifiable instrument, publish the amount of a\npenalty unit. However, a failure by the Minister to do so does not\ninvalidate the indexation.\n\n(2) In this section:\nTerritory Ordinance means an ordinance that:\n\n(a) was made under an Act providing for the acceptance,\nadministration or government of a Territory; and\n\n(b) has not become an enactment of the Australian Capital\nTerritory;\nand includes a regulation made under such an ordinance.",
      "skos:definition": "(1) In a law of the Commonwealth or a Territory Ordinance, unless the\ncontrary intention appears:\npenalty unit means the amount of $330 (subject to indexation\nunder subsection (3)).\n\n(1A) If the amount of a penalty unit is indexed under subsection (3), the\nMinister must, by notifiable instrument, publish the amount of a\npenalty unit. However, a failure by the Minister to do so does not\ninvalidate the indexation.\n\n(2) In this section:\nTerritory Ordinance means an ordinance that:\n\n(a) was made under an Act providing for the acceptance,\nadministration or government of a Territory; and\n\n(b) has not become an enactment of the Australian Capital\nTerritory;\nand includes a regulation made under such an ordinance.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-4aa-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-4aa-ss-1a"
        },
        {
          "@id": "concept:crimes-act-1914-sec-4aa-ss-2"
        }
      ],
      "cml:integrityHash": "cfd891102f19896f4f2d5d05ae7c26c7e97e58d502429ba441fdfed27ea2c15b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4aa",
      "@type": "cof:Section",
      "cof:title": "4AA Penalty units",
      "values:kind": "section",
      "cof:pageNumber": 327,
      "values:originalText": "(1) In a law of the Commonwealth or a Territory Ordinance, unless the\ncontrary intention appears:\npenalty unit means the amount of $330 (subject to indexation\nunder subsection (3)).\n\n(1A) If the amount of a penalty unit is indexed under subsection (3), the\nMinister must, by notifiable instrument, publish the amount of a\npenalty unit. However, a failure by the Minister to do so does not\ninvalidate the indexation.\n\n(2) In this section:\nTerritory Ordinance means an ordinance that:\n\n(a) was made under an Act providing for the acceptance,\nadministration or government of a Territory; and\n\n(b) has not become an enactment of the Australian Capital\nTerritory;\nand includes a regulation made under such an ordinance."
    },
