          "@id": "concept:crimes-act-1914-sec-15aa-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bc6128855d75b8dd596f4404610e5dc2cb35648e540f8ab39090e792109ff4ab",
      "skos:note": "Bail not granted in certain cases"
