          "@id": "concept:crimes-act-1914-sec-15ab-ss-3a"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15ab-ss-4"
        }
      ],
      "cml:integrityHash": "dcbac2e0684c0239327af3fd178017220545c2d469a82b08f577ad2c03b6d6e0"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ab",
      "@type": "cof:Section",
