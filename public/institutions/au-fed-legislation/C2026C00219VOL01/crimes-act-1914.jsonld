    {
      "@id": "concept:crimes-act-1914-sec-3uf-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "3UF(8) Seizure notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3uf-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.88",
      "values:originalText": "(8) A thing is forfeited to the Commonwealth if the owner of the thing\ndoes not request its return:\n\n(a) before the end of the 90th day after the date of the seizure\nnotice in relation to the thing; or\n\n(b) if subsection (2) applied in relation to the thing so that a\nseizure notice was not served—before the end of the 90th day\nafter the day on which the thing was seized.",
      "skos:definition": "(8) A thing is forfeited to the Commonwealth if the owner of the thing\ndoes not request its return:\n\n(a) before the end of the 90th day after the date of the seizure\nnotice in relation to the thing; or\n\n(b) if subsection (2) applied in relation to the thing so that a\nseizure notice was not served—before the end of the 90th day\nafter the day on which the thing was seized.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3uf"
      },
      "cml:asserts": [
