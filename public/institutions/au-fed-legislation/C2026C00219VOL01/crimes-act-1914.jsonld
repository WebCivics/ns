    {
      "@id": "concept:crimes-act-1914-sec-3ze",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZE Power to conduct a frisk search of an arrested person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ze"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.116",
      "values:originalText": "A constable who arrests a person for an offence, or who is present\nat such an arrest, may, if the constable suspects on reasonable\ngrounds that it is prudent to do so in order to ascertain whether the\nperson is carrying any seizable items:\n\n(a) conduct a frisk search of the person at or soon after the time\nof arrest; and\n\n(b) seize any seizable items found as a result of the search.",
      "skos:definition": "A constable who arrests a person for an offence, or who is present\nat such an arrest, may, if the constable suspects on reasonable\ngrounds that it is prudent to do so in order to ascertain whether the\nperson is carrying any seizable items:\n\n(a) conduct a frisk search of the person at or soon after the time\nof arrest; and\n\n(b) seize any seizable items found as a result of the search.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3ze-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3ze-logic-deontic-1"
