    },
    {
      "@id": "concept:crimes-act-1914-sec-3z-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3Z(2) Power of arrest without warrant by other persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3z-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.112",
      "values:originalText": "(2) A person who arrests another person under subsection (1) must, as\nsoon as practicable after the arrest, arrange for the other person,\nand any property found on the other person, to be delivered into the\ncustody of a constable.",
      "skos:definition": "(2) A person who arrests another person under subsection (1) must, as\nsoon as practicable after the arrest, arrange for the other person,\nand any property found on the other person, to be delivered into the\ncustody of a constable.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3z"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3z-ss-2-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3z-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cb62219f3e7eefecfb317e38dff84dffbd5673d6eb9b4e253ad8be4b48543327",
      "skos:note": "Must arrange for delivery of arrested person and property into custody of a constable."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3z-ss-2",
      "@type": "cof:Section",
      "cof:title": "3Z(2) Power of arrest without warrant by other persons",
      "values:kind": "subsection",
      "cof:pageNumber": 112,
      "values:originalText": "(2) A person who arrests another person under subsection (1) must, as\nsoon as practicable after the arrest, arrange for the other person,\nand any property found on the other person, to be delivered into the\ncustody of a constable."
    },
