    {
      "@id": "concept:crimes-act-1914-sec-3zp",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZP Identification procedures where there is more than one suspect",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.133",
      "values:originalText": "If:\n\n(a) a constable is attempting to ascertain:\n\n(i) which of 2 or more suspects committed an offence; or\n\n(ii) the identities of 2 or more suspects who may have been\njointly involved in an offence; and\n\n(b) for that purpose, the constable intends to conduct an\nidentification parade or to identify a person by showing a\nphotograph or a picture of a suspect to a person;\nthe constable must undertake a separate identification process for\neach of the suspects.\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "skos:definition": "If:\n\n(a) a constable is attempting to ascertain:\n\n(i) which of 2 or more suspects committed an offence; or\n\n(ii) the identities of 2 or more suspects who may have been\njointly involved in an offence; and\n\n(b) for that purpose, the constable intends to conduct an\nidentification parade or to identify a person by showing a\nphotograph or a picture of a suspect to a person;\nthe constable must undertake a separate identification process for\neach of the suspects.\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3zp-norm"
        }
      ],
      "cml:integrityHash": "6d72f2249cc05423cfb2b313da923a97c0fe0d2665ba648c19c3a1d5ea3a00fa",
      "skos:note": "Constable must undertake separate identification process for each suspect in certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zp",
      "@type": "cof:Section",
      "cof:title": "3ZP Identification procedures where there is more than one suspect",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "If:\n\n(a) a constable is attempting to ascertain:\n\n(i) which of 2 or more suspects committed an offence; or\n\n(ii) the identities of 2 or more suspects who may have been\njointly involved in an offence; and\n\n(b) for that purpose, the constable intends to conduct an\nidentification parade or to identify a person by showing a\nphotograph or a picture of a suspect to a person;\nthe constable must undertake a separate identification process for\neach of the suspects.\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)"
    },
