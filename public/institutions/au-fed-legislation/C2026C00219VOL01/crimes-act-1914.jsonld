      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits receiving or assisting someone who has committed an offence.",
      "cml:executionSurface": "modalities::logic::deontic",
