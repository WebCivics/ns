    {
      "@id": "concept:crimes-act-1914-sec-3zb",
      "@type": "cml:Concept",
      "skos:prefLabel": "3ZB Power to enter premises to arrest offender",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zb"
      },
      "cml:curationStatus": {
