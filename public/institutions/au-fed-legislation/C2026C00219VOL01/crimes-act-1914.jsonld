    {
      "@id": "concept:crimes-act-1914-sec-4d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4D(2) Penalties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4d-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.332",
      "values:originalText": "(2) Subsection (1) applies to any instrument made under an Act\n(including rules, regulations or by-laws but not including a law of a\nTerritory) as if the instrument were an Act and as if each such rule,\nregulation or by-law were a section of an Act.",
      "skos:definition": "(2) Subsection (1) applies to any instrument made under an Act\n(including rules, regulations or by-laws but not including a law of a\nTerritory) as if the instrument were an Act and as if each such rule,\nregulation or by-law were a section of an Act.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-4d"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-4d-ss-2-norm"
        }
      ],
      "cml:integrityHash": "0c405517562518c162b6ba54c8a34face99382414e10ee20a9d3400ba86e4c7f",
      "skos:note": "Subsection (1) applies to any instrument made under an Act as if the instrument were an Act and as if each such rule, regulation or by-law were a section of an Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4d-ss-2",
      "@type": "cof:Section",
      "cof:title": "4D(2) Penalties",
      "values:kind": "subsection",
      "cof:pageNumber": 332,
      "values:originalText": "(2) Subsection (1) applies to any instrument made under an Act\n(including rules, regulations or by-laws but not including a law of a\nTerritory) as if the instrument were an Act and as if each such rule,\nregulation or by-law were a section of an Act."
    },
