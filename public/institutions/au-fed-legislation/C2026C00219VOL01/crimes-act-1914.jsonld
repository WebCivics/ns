    {
      "@id": "concept:crimes-act-1914-sec-4h",
      "@type": "cml:Concept",
      "skos:prefLabel": "4H Summary offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.333",
      "values:originalText": "Offences against a law of the Commonwealth, being offences\nwhich:\n\n(a) are punishable by imprisonment for a period not exceeding\n12 months; or\n\n(b) are not punishable by imprisonment;\nare summary offences, unless the contrary intention appears.",
      "skos:definition": "Offences against a law of the Commonwealth, being offences\nwhich:\n\n(a) are punishable by imprisonment for a period not exceeding\n12 months; or\n\n(b) are not punishable by imprisonment;\nare summary offences, unless the contrary intention appears.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-4h-norm"
        }
      ],
      "cml:integrityHash": "de3c1ad9ba4484f1de2974655c8cc7e9f02d89ee5670c6a1832536a749956444",
      "skos:note": "Offences against a law of the Commonwealth are summary offences unless otherwise specified."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-4h",
      "@type": "cof:Section",
      "cof:title": "4H Summary offences",
      "values:kind": "section",
      "cof:pageNumber": 333,
      "values:originalText": "Offences against a law of the Commonwealth, being offences\nwhich:\n\n(a) are punishable by imprisonment for a period not exceeding\n12 months; or\n\n(b) are not punishable by imprisonment;\nare summary offences, unless the contrary intention appears."
    },
    {
