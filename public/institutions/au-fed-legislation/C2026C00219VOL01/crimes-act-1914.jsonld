        }
      ],
      "cml:integrityHash": "d376e14026b1e7b45868fd2d556d1325871e8f5445402c5f73b78e54fb60ba59",
      "skos:note": "Prohibition on destruction of identification material"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3zk-ss-3",
      "@type": "cof:Section",
      "cof:title": "3ZK(3) Destruction of identification material",
      "values:kind": "subsection",
      "cof:pageNumber": 123,
      "values:originalText": "(3) A magistrate may, on application by a constable, extend the period\nof 12 months referred to in subsection (1) or that period as\npreviously extended under this subsection in relation to particular\n\n\nPart IAA  Search, information gathering, arrest and related powers (other than powers\nunder delayed notification search warrants)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-3zk-ss-3-norm",
