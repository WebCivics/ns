      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.104",
      "values:originalText": "scope\n\nWithout limiting its effect apart from this section, section 3UQ also\nhas the effect it would have if the definition of major airport in\nsection 3UM did not include an airport determined by the Minister\nunder section 3UO.",
      "skos:definition": "scope\n\nWithout limiting its effect apart from this section, section 3UQ also\nhas the effect it would have if the definition of major airport in\nsection 3UM did not include an airport determined by the Minister\nunder section 3UO.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3ur-norm"
        }
      ],
      "cml:integrityHash": "a3bb2c4a5c0266976887350979c8d405cf98a7ead6b8c4ba41ca0e2d5f134c08",
      "skos:note": "Section 3UR has an alternative effect without limiting its scope."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3ur",
      "@type": "cof:Section",
      "cof:title": "3UR Move-on directions at airports—alternative constitutional",
      "values:kind": "section",
      "cof:pageNumber": 104,
      "values:originalText": "scope\n\nWithout limiting its effect apart from this section, section 3UQ also\nhas the effect it would have if the definition of major airport in\nsection 3UM did not include an airport determined by the Minister\nunder section 3UO."
    },
