        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Seizure and condemnation of forfeitable goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.337",
      "values:originalText": "(1) Any constable may, without warrant, seize any articles which are\nforfeited or which he or she has reasonable ground to believe are\nforfeited under any law of the Commonwealth, and take them\nbefore a court of summary jurisdiction.\n\n(2) Where articles are taken before a court of summary jurisdiction\nunder subsection (1), the court shall inquire into the matter and:\n\n(a) if the court is satisfied that the articles are forfeited—shall\norder that the articles be condemned; or\n\n(b) if the court is not so satisfied—shall order that the articles be\ndelivered to such person as the court is satisfied is entitled to\nthe articles.",
      "skos:definition": "(1) Any constable may, without warrant, seize any articles which are\nforfeited or which he or she has reasonable ground to believe are\nforfeited under any law of the Commonwealth, and take them\nbefore a court of summary jurisdiction.\n\n(2) Where articles are taken before a court of summary jurisdiction\nunder subsection (1), the court shall inquire into the matter and:\n\n(a) if the court is satisfied that the articles are forfeited—shall\norder that the articles be condemned; or\n\n(b) if the court is not so satisfied—shall order that the articles be\ndelivered to such person as the court is satisfied is entitled to\nthe articles.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-9-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-9-ss-2"
        }
      ],
      "cml:integrityHash": "a6d23416a667121ac2e986c470c05733b738fafffc9e66dbad02dbac08a3e072"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Seizure and condemnation of forfeitable goods",
      "values:kind": "section",
      "cof:pageNumber": 337,
      "values:originalText": "(1) Any constable may, without warrant, seize any articles which are\nforfeited or which he or she has reasonable ground to believe are\nforfeited under any law of the Commonwealth, and take them\nbefore a court of summary jurisdiction.\n\n(2) Where articles are taken before a court of summary jurisdiction\nunder subsection (1), the court shall inquire into the matter and:\n\n(a) if the court is satisfied that the articles are forfeited—shall\norder that the articles be condemned; or\n\n(b) if the court is not so satisfied—shall order that the articles be\ndelivered to such person as the court is satisfied is entitled to\nthe articles."
    },
    {
