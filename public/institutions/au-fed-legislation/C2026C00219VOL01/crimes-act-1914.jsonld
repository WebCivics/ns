    {
      "@id": "concept:crimes-act-1914-sec-3m-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3M(3) Compensation for damage to equipment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3m-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.70",
      "values:originalText": "(3) However, if the owner or user and the Commonwealth fail to\nagree, the owner or user may institute proceedings in a court of\ncompetent jurisdiction for such reasonable amount of\ncompensation as the court determines.",
      "skos:definition": "(3) However, if the owner or user and the Commonwealth fail to\nagree, the owner or user may institute proceedings in a court of\ncompetent jurisdiction for such reasonable amount of\ncompensation as the court determines.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-3m"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-3m-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-3m-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8ead8e6f6d5b2d57c94d1ed1c1e0797aeaf783a36ce890322cde4c0a503c5ed",
      "skos:note": "Owner/user may seek compensation from Commonwealth if agreement fails."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-3m-ss-3",
      "@type": "cof:Section",
      "cof:title": "3M(3) Compensation for damage to equipment",
      "values:kind": "subsection",
      "cof:pageNumber": 70,
      "values:originalText": "(3) However, if the owner or user and the Commonwealth fail to\nagree, the owner or user may institute proceedings in a court of\ncompetent jurisdiction for such reasonable amount of\ncompensation as the court determines."
    },
    {
      "@id": "concept:crimes-act-1914-sec-3m-ss-3-norm",
      "@type": "values:Obligation",
