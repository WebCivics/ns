      ],
      "cml:integrityHash": "eba562732639d7400cbe0459a45aa557ed2ad271360dc4061e521e88e7ad07d7",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-act-1914#sec-23dc",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23dc-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.356",
      "skos:note": "Suspension or delay of questioning may be specified during an investigation into a terrorism offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "23DC(1) Time during which suspension or delay of questioning may be"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-23dc-ss-1-norm",
        "concept:crimes-act-1914-sec-23dc-ss-1-logic-deontic-1",
        "concept:crimes-act-1914-sec-23dc-ss-1-logic-alleninterval-2",
        "concept:crimes-act-1914-sec-23dc-ss-1-logic-ltl-3",
        "concept:crimes-act-1914-sec-23dc-ss-1-logic-diffusion-4",
        "concept:crimes-act-1914-sec-23dc-ss-1-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "f370b76b1326d5dc921dfaae757c69c680f20c7b852dde6427bf5e7290f8d2b6",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-act-1914#sec-23dc-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-act-1914-sec-23dc"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23dc-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The period during which suspension or delay of questioning may be applied starts when the person is arrested and ends when the investigation is completed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Specifies the temporal interval during which suspension or delay of questioning may be applied.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:premiseText": "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23dc-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The state must specify the period during which suspension or delay of questioning may be applied because both conditions are met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Draws a conclusion based on the premises.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Therefore",
      "cml:premiseText": "(a) a person is arrested for a terrorism offence; and (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23dc-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The state must specify the period during which suspension or delay of questioning may be applied.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the state to specify the period during which suspension or delay of questioning may be applied.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23dc-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The obligation applies if both conditions are met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
