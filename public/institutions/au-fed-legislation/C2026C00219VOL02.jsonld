      "partOf": "concept:crimes-act-1914-sec-15mn"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mn-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court must consider the timing of the person's application when determining whether to allow them to join.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Specify temporal conditions for joining application",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "require",
      "cml:premiseText": "(b) the person applies to be joined to the application as a respondent; and (c) the person has sufficient interest in the subject matter of the application."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mn-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may allow a person to join the application as a respondent.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Grant permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allow",
      "cml:premiseText": "(a) the person is: (i) the operative in relation to whom the witness identity protection certificate is given; or (ii) the chief officer of the agency who gave the witness identity protection certificate;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mn-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only allow a person to join the application if they apply under these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Specify conditions for joining application",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "require",
      "cml:premiseText": "(b) the person applies to be joined to the application as a respondent; and (c) the person has sufficient interest in the subject matter of the application."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mn-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court may only allow a person to join the application if they have a sufficient interest.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Specify conditions for joining application as respondent",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allow",
      "cml:premiseText": "(c) the person has sufficient interest in the subject matter of the application."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mn-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court must consider the ongoing nature of the person's interest when determining whether to allow them to join.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Specify recurring conditions for joining application",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "require",
      "cml:premiseText": "(b) the person applies to be joined to the application as a respondent; and (c) the person has sufficient interest in the subject matter of the application."
    },
