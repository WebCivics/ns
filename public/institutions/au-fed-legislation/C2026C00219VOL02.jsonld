    {
      "@id": "concept:crimes-act-1914-sec-20bd-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.306",
      "skos:note": "Attorney-General must consider reports from psychiatrists and psychologists when deciding to release a person from detention.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "20BD(2) Review by Attorney-General"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-20bd-ss-2-norm",
        "concept:crimes-act-1914-sec-20bd-ss-2-logic-deontic-1",
