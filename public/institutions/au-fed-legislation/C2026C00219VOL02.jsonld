      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.99",
      "skos:note": "Disclosing information about integrity testing operations that endangers safety is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15JR Integrity testing operations—disclosure endangering safety"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
