    {
      "@id": "concept:crimes-act-1914-sec-23p-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...he or she may communicate with, or attempt to communicate with, that consular office; and",
      "cml:confidence": {
