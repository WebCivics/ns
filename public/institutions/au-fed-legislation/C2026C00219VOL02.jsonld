    {
      "@id": "concept:crimes-act-1914-sec-15jr-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure of information about integrity testing operations that endangers safety overlaps with the effective conduct of an integrity testing operation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Disclosing information about integrity testing operations that endangers safety overlaps with the effective conduct of an integrity testing operation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "the person intends to endanger the health or safety of any person or prejudice the effective conduct of an integrity testing operation;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15jr-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information is classified as relating to an integrity testing operation using artificial intelligence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
