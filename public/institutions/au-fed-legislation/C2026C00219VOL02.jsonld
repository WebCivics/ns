    {
      "@id": "concept:crimes-act-1914-sec-15mn-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.156",
      "skos:note": "Allow person to join application as respondent under certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15MN(2) Application for leave—joinder as respondent"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-15mn-ss-2-norm",
        "concept:crimes-act-1914-sec-15mn-ss-2-logic-deontic-1",
