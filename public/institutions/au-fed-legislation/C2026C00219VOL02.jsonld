      "cml:logicSummary": "Duty to certify acceptance of parole order conditions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "before he or she may be released."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the person must comply with the parole order conditions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to comply with parole order conditions",
