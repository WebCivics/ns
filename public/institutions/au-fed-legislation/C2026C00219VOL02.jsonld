        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Participant is recognised as a civilian participant in the operation if they act in accordance with instructions of a law enforcement officer.",
