    {
      "@id": "concept:crimes-act-1914-sec-15g",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.17",
      "skos:note": "Exempts law enforcement officers and certain other persons from criminal liability and civil liability in the course of a controlled operation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15G Objects of Part"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-15g-norm",
        "concept:crimes-act-1914-sec-15g-logic-deontic-1",
        "concept:crimes-act-1914-sec-15g-logic-alleninterval-2",
        "concept:crimes-act-1914-sec-15g-logic-argumentation-3",
        "concept:crimes-act-1914-sec-15g-logic-diffusion-4",
        "concept:crimes-act-1914-sec-15g-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "77b795c769cab3309be0a4a01dfeeb1a4cef938128620ab6e75fa033ec74689e",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-act-1914#sec-15g",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15g-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exemption overlaps with the course of this operation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The exemption applies to the course of a controlled operation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The text mentions a 'controlled operation'"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15g-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "They must be involved in the commission of an offence to be exempt from liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "The exemption implies that law enforcement officers and certain other persons are involved in the commission of an offence",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "Law enforcement officers and certain other persons take an active part in, or are otherwise involved in, the commission of a Commonwealth offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15g-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Exemption is implied by this definition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The exemption can be inferred from the definition of a controlled operation",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "The text defines a 'controlled operation'"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "They are exempt from criminal liability and civil liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exempts individuals from liability",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exemption",
      "cml:premiseText": "Law enforcement officers and certain other persons are involved in the commission of an offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15g-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "All individuals within this operation are exempt from liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The exemption propagates to all individuals within the controlled operation",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation",
      "cml:premiseText": "The text defines a 'controlled operation'"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15g-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
