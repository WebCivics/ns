      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Controlled operations are defined as those that involve the participant engaging in controlled conduct for the purposes of the controlled operation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Participant engages in controlled conduct for the purposes of the controlled operation."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ha-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Participant is recognised as a civilian participant in the operation.",
