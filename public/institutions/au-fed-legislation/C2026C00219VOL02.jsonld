        "concept:crimes-act-1914-sec-20bd-ss-2-logic-epistemic-4",
        "concept:crimes-act-1914-sec-20bd-ss-2-logic-ltl-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "634b6c6a9616eba35f3e3e020cf0b0e2c7d531c9dd876b492816cc2d0b96934e",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-act-1914#sec-20bd-ss-2",
