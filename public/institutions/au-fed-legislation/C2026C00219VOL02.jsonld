      "cml:premiseText": "(b) the certificate has not been cancelled under section 15MQ;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ms-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of disclosure",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) a witness identity protection certificate for an operative in relation to a proceeding has been given; and (b) the certificate has not been cancelled under section 15MQ;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ms-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
