      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Controlled operation diffuses to participant's engagement in controlled conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Controlled operations diffuse to other participants who engage in controlled conduct.",
