      "cml:premiseText": "the person discloses information; and the information relates to an integrity testing operation; and either the person intends to endanger the health or safety of any person or prejudice the effective conduct of an integrity testing operation;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15jr-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure of information about integrity testing operations that endangers safety repeats the action of endangering health or safety.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
