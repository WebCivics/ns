    {
      "@id": "concept:crimes-act-1914-sec-20be-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.307",
      "skos:note": "The Attorney-General must not order a person's release from detention unless satisfied the person is not a threat or danger.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "20BE(2) Attorney-General may order release"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
