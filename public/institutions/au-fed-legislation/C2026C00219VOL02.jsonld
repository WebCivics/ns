      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval is an Allen interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:premiseText": "the period of the extension must not exceed: (a) in the case of a formal variation of authority—the period that would result in the period of effect of the authority exceeding 3 months (including any previous extensions); and (b) in the case of an urgent variation of authority—the lesser of: (i) 7 days; and (ii) a period that would result in the period of effect of the authority exceeding 3 months (including any previous extensions);"
    },
