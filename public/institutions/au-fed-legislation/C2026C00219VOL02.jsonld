      "skos:note": "Transfers responsibility between authorities under the Proceeds of Crime Act 2002.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15YU(4) Proceedings to which this Part applies"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
