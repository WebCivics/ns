        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) Subject to section 23L, if a person who is under arrest or a protected suspect is not an Australian citizen..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23p-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...give the person reasonable facilities to do so; and",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
