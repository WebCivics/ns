      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Participant is not criminally responsible for offence if conduct meets conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
