    {
      "@id": "concept:crimes-act-1914-sec-23p-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...allow the person a reasonable time to, or to attempt to, communicate with that consular office.",
