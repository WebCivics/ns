      "cml:logicSummary": "Duty to release on parole",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "A person must be released from prison."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the person must certify his or her acceptance of the parole order conditions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
