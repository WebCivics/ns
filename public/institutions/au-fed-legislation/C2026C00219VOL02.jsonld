      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Participant is not criminally responsible for offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Participant is not criminally responsible for offence if they repeat the controlled operation.",
