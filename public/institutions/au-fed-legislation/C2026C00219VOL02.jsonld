    {
      "@id": "concept:crimes-act-1914-sec-15gf-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner or a Deputy Commissioner is an authorising officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the bearer of an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(1) Any of the following is an authorising officer for a controlled operation:"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15gf-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Any AFP authorising officer is an authorising officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the holder of an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(b) if the operation is not a major controlled operation, but the investigation of the offence to which the controlled operation relates is within the functions of the Australian Federal Police—any AFP authorising officer;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15gf-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Any ACC authorising officer is an authorising officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the holder of an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(c) if the investigation of the offence to which the controlled operation relates is within the functions of the ACC—any ACC authorising officer;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15gf-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Any NACC authorising officer is an authorising officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the holder of an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(d) if the controlled operation relates to the conduct of a corruption investigation (within the meaning of the National Anti-Corruption Commission Act 2022)—any NACC authorising officer;"
    },
