      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "the information relates to an integrity testing operation;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15jr-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of information about integrity testing operations that endangers safety.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The person discloses information; and the information relates to an integrity testing operation; and either the person intends to endanger the health or safety of any person or prejudice the effective conduct of an integrity testing operation;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15jr-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure of information about integrity testing operations that endangers safety spreads to other persons or entities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Disclosing information about integrity testing operations that endangers safety spreads to other persons or entities.",
