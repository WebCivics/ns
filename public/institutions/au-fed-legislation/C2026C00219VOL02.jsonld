      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...forward any written communication from the person to that consular office; and",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must forward written communication from non-Australian nationals to consular office.",
