      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Comply with conditions during parole period.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)."
    },
