      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.240",
      "skos:note": "Court must not pass sentence of imprisonment unless exceptional circumstances warrant it.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "17B(1) Restriction on imposing sentences for certain minor offences"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
