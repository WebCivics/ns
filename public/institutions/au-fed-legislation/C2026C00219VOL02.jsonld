    {
      "@id": "concept:crimes-act-1914-sec-23g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The investigating official must inform the person of their right to communicate with a friend or relative.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must inform the person of their right to communicate with a friend or relative.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Section 23G(1)(a)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23g-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The investigating official must defer questioning for a reasonable time to allow the person to make communication arrangements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must allow the person to make communication arrangements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Section 23G(1)(b)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23g-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The investigating official must allow the person to arrange for a legal practitioner to be present during questioning.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must arrange for a legal practitioner to be present during questioning.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Section 23G(1)(b)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23g-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The investigating official must allow the person to choose their own legal practitioner.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must respect the person's choice of legal practitioner.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Section 23G(1)(b)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23g-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The investigating official must allow the person to make communication arrangements within a reasonable time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide a reasonable time for communication arrangements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Section 23G(1)(b)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23g-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The investigating official must allow the person to communicate with their chosen legal practitioner.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must respect the person's right to communicate with their legal practitioner.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Section 23G(1)(b)"
    },
