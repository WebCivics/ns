    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Diffusion>;
    <https://ns.webcivics.net/cml/operator> "If";
    <https://ns.webcivics.net/cml/logicSummary> "Specifies the conditions under which the obligation applies.";
    <https://ns.webcivics.net/cml/premiseText> "(a) a person is arrested for a terrorism offence; and (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence.";
    <https://ns.webcivics.net/cml/conclusionText> "The obligation applies if both conditions are met.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::diffusion";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
