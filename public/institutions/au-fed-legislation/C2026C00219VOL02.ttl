    <http://www.w3.org/2004/02/skos/core#prefLabel> "23DC(1) Time during which suspension or delay of questioning may be"@en;
    <https://ns.webcivics.net/cml/realizedBy> <https://ns.webcivics.net/values/crimes-act-1914#sec-23dc-ss-1>;
    <https://ns.webcivics.net/cml/integrityHash> "f370b76b1326d5dc921dfaae757c69c680f20c7b852dde6427bf5e7290f8d2b6";
