concept:crimes-act-1914-sec-19az-ss-4 a cml:Concept ;
    skos:prefLabel "19AZ(4) Evidence before prescribed authority"@en ;
    cml:realizedBy doc:sec-19az-ss-4 ;
    values:originalText "(4) Subsections (1), (2) and (3) do not apply if the person has a reasonable excuse." ;
    skos:definition "(4) Subsections (1), (2) and (3) do not apply if the person has a reasonable excuse."@en ;
