doc:sec-15yo-ss-4 a cof:Section ;
    cof:title "15YO(4) Adults accompanying vulnerable persons" ;
    values:kind "subsection" ;
    values:originalText "(4) An adult accompanying the person under this section must not:  (a) prompt the person or otherwise influence the person’s answers; or  (b) disrupt the questioning of the person." ;
    cof:pageNumber "195"^^xsd:integer .

concept:crimes-act-1914-sec-15yo-ss-5 a cml:Concept ;
    skos:prefLabel "15YO(5) Adults accompanying vulnerable persons"@en ;
    cml:realizedBy doc:sec-15yo-ss-5 ;
    values:originalText "(5) Any words spoken by an adult accompanying the person under this section must be able to be heard by:  (a) the judge; and  (b) if there is a jury in the proceeding—the members of the jury.   Part IAD  Protecting vulnerable persons" ;
    skos:definition "(5) Any words spoken by an adult accompanying the person under this section must be able to be heard by:  (a) the judge; and  (b) if there is a jury in the proceeding—the members of the jury.   Part IAD  Protecting vulnerable persons"@en ;
