concept:crimes-act-1914-sec-15kp a cml:Concept ;
    skos:prefLabel "15KP Assumed identity may be acquired and used"@en ;
    cml:realizedBy doc:sec-15kp ;
    values:originalText "A person may acquire or use an assumed identity if:  (a) the person is an authorised person (other than an authorised civilian) and the acquisition or use is:  (i) in accordance with an authority; and  (ii) in the course of duty; or  (b) the person is an authorised civilian and the acquisition or use is in accordance with:  (i) an authority; and  (ii) any direction by the person’s supervisor under the authority." ;
    skos:definition "A person may acquire or use an assumed identity if:  (a) the person is an authorised person (other than an authorised civilian) and the acquisition or use is:  (i) in accordance with an authority; and  (ii) in the course of duty; or  (b) the person is an authorised civilian and the acquisition or use is in accordance with:  (i) an authority; and  (ii) any direction by the person’s supervisor under the authority."@en ;
    cml:integrityHash "982e3874023514b909151d45cac77bd534de6740dfb848d0a2afbb202cd80e0f" ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Acquiring or using an assumed identity is permitted under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.124" ;
