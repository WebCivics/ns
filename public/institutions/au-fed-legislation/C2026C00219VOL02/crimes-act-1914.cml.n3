    values:partOf concept:crimes-act-1914-sec-23c ;
    cof:pageNumber "346"^^xsd:integer ;
    skos:note "Consider complexity of matters when ascertaining time for investigation purposes." ;
    cml:curationStatus cml:Proposed ;
