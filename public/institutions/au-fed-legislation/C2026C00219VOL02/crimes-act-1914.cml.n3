concept:crimes-act-1914-sec-15h a cml:Concept ;
    skos:prefLabel "15H Defect in authority"@en ;
    cml:realizedBy doc:sec-15h ;
    values:originalText "An application for an authority or variation of an authority, and any authority or variation of an authority granted on the basis of such an application, is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material particular.   Part IAB  Controlled operations" ;
    skos:definition "An application for an authority or variation of an authority, and any authority or variation of an authority granted on the basis of such an application, is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material particular.   Part IAB  Controlled operations"@en ;
    cml:integrityHash "26bc45c927c8259ec62bc8938f4704568f9037db494679a51057ace160ca64b6" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "No defect in authority invalidates an application or granted authority." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.51" ;
