concept:crimes-act-1914-sec-19af a cml:Concept ;
    skos:prefLabel "19AF Non-parole period or pre-release periods not to exceed"@en ;
    cml:realizedBy doc:sec-19af ;
    values:originalText "sentence  (1) Where a court is required to fix a non-parole period or make a recognizance release order in respect of a federal sentence or sentences, the court must fix a non-parole period that ends, or make a recognizance release order such that the pre-release period ends, not later than the end of the sentence, or of the last to be served of the sentences.  (2) This section does not restrict the length of the non-parole period or the pre-release period in respect of a life sentence or sentences that include such a sentence." ;
    skos:definition "sentence  (1) Where a court is required to fix a non-parole period or make a recognizance release order in respect of a federal sentence or sentences, the court must fix a non-parole period that ends, or make a recognizance release order such that the pre-release period ends, not later than the end of the sentence, or of the last to be served of the sentences.  (2) This section does not restrict the length of the non-parole period or the pre-release period in respect of a life sentence or sentences that include such a sentence."@en ;
    cml:integrityHash "821119d79af8b9fcf86d782863d55861708cc4040673f905f9e3b616cfb71199" ;
    cof:pageNumber "249"^^xsd:integer ;
    cml:hasPart concept:crimes-act-1914-sec-19af-ss-1 ;
    cml:hasPart concept:crimes-act-1914-sec-19af-ss-2 ;
    cml:curationStatus cml:Proposed ;
