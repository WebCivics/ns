    cml:logicSummary "Allowing the appeal imposes an obligation." ;
    cml:premiseText "(6) If the Court of Appeal allows the appeal:" ;
    cml:conclusionText "the accused may be tried for the federal offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

