concept:crimes-act-1914-sec-23df a cml:Concept ;
    skos:prefLabel "23DF Magistrate may extend investigation period"@en ;
    cml:realizedBy doc:sec-23df ;
    values:originalText "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an application has been made under subsection 23DE(1) to a magistrate in respect of the person." ;
    skos:definition "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an application has been made under subsection 23DE(1) to a magistrate in respect of the person."@en ;
