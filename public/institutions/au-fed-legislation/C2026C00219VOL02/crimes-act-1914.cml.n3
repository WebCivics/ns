concept:crimes-act-1914-sec-15jo a cml:Concept ;
    skos:prefLabel "15JO Integrity testing operations—indemnity against civil liability"@en ;
    cml:realizedBy doc:sec-15jo ;
    values:originalText "The Commonwealth must indemnify a participant in an integrity testing operation that is authorised by an integrity testing authority against any civil liability (including reasonable costs) the participant incurs because of conduct the participant engages in if:  (a) the participant engages in the conduct in the course of, and for the purposes of, the operation in accordance with the authority; and  (b) the participant is identified in the authority; and   Part IABA  Integrity testing" ;
    skos:definition "The Commonwealth must indemnify a participant in an integrity testing operation that is authorised by an integrity testing authority against any civil liability (including reasonable costs) the participant incurs because of conduct the participant engages in if:  (a) the participant engages in the conduct in the course of, and for the purposes of, the operation in accordance with the authority; and  (b) the participant is identified in the authority; and   Part IABA  Integrity testing"@en ;
    cml:integrityHash "101c88ecd483e06591ae0dbad822cf2812a61b14ad9aacfadae43383d70e81bb" ;
    cof:pageNumber "95"^^xsd:integer ;
    skos:note "Commonwealth must indemnify participant in integrity testing operation against civil liability." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.95" ;
    cml:asserts concept:crimes-act-1914-sec-15jo-norm .
