doc:sec-15me-ss-5 a cof:Section ;
    cof:title "15ME(5) Witness identity protection certificate" ;
    values:kind "subsection" ;
    values:originalText "(5) Subsection (4) does not prevent a decision to give a witness identity protection certificate being called into question in the course of any proceedings of a disciplinary nature against the person who made the decision." ;
    cof:pageNumber "148"^^xsd:integer .

concept:crimes-act-1914-sec-15me-ss-6 a cml:Concept ;
    skos:prefLabel "15ME(6) Witness identity protection certificate"@en ;
    cml:realizedBy doc:sec-15me-ss-6 ;
    values:originalText "(6) A witness identity protection certificate purporting to be issued under subsection (1):  (a) must be taken to be such a certificate and to have been properly issued; and  (b) is prima facie evidence of the matters in the certificate." ;
    skos:definition "(6) A witness identity protection certificate purporting to be issued under subsection (1):  (a) must be taken to be such a certificate and to have been properly issued; and  (b) is prima facie evidence of the matters in the certificate."@en ;
