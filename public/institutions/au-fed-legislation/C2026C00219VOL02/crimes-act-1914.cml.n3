concept:crimes-act-1914-sec-15hp a cml:Concept ;
    skos:prefLabel "15HP Keeping documents connected with controlled operations"@en ;
    cml:realizedBy doc:sec-15hp ;
    values:originalText "The chief officer of an authorising agency must cause the following to be kept:  (a) each formal application made to an authorising officer of the agency;  (b) each written record of an urgent application made to such an authorising officer;  (c) each formal authority granted by such an authorising officer;  (d) each written record of an urgent authority issued under section 15GL;   Part IAB  Controlled operations" ;
    skos:definition "The chief officer of an authorising agency must cause the following to be kept:  (a) each formal application made to an authorising officer of the agency;  (b) each written record of an urgent application made to such an authorising officer;  (c) each formal authority granted by such an authorising officer;  (d) each written record of an urgent authority issued under section 15GL;   Part IAB  Controlled operations"@en ;
    cml:integrityHash "b85bc94fac7b3f69692108cb0f23d591b7372dd057b6efd3225946bab4408384" ;
    cof:pageNumber "71"^^xsd:integer ;
    skos:note "Must keep certain documents connected with controlled operations." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.71" ;
