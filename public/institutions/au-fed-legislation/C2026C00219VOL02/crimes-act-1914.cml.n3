concept:crimes-act-1914-sec-15gh-ss-6 a cml:Concept ;
    skos:prefLabel "15GH(6) Applications for authorities to conduct controlled operations"@en ;
    cml:realizedBy doc:sec-15gh-ss-6 ;
    values:originalText "(6) As soon as practicable after making an urgent application that was not made in writing, the applicant must make a written record of the application and give a copy of it to the authorising officer to whom the application was made." ;
    skos:definition "(6) As soon as practicable after making an urgent application that was not made in writing, the applicant must make a written record of the application and give a copy of it to the authorising officer to whom the application was made."@en ;
    cml:integrityHash "fa51f8ee8c0349ed99dd712fb65a32e4bfda80bb0d0738ab45a9bc247bdbb4ba" ;
    values:partOf concept:crimes-act-1914-sec-15gh ;
