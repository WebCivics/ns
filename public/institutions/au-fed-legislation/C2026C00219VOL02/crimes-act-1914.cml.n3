concept:crimes-act-1914-sec-15kj a cml:Concept ;
    skos:prefLabel "15KJ Government issuing agencies to comply with request"@en ;
    cml:realizedBy doc:sec-15kj ;
    values:originalText "The chief officer of a Commonwealth government issuing agency who receives a request under section 15KI must comply with the request within the reasonable period stated in the request." ;
