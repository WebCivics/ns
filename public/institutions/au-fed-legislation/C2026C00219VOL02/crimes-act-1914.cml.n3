doc:sec-15jl-ss-1 a cof:Section ;
    cof:title "15JL(1) Integrity testing authorities—cancellation" ;
    values:kind "subsection" ;
    values:originalText "(1) An appropriate authorising officer for an integrity testing operation may, by order in writing given to the responsible staff member for the operation, cancel the authority at any time and for any reason." ;
    cof:pageNumber "94"^^xsd:integer .

