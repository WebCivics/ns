doc:sec-15kt-ss-1 a cof:Section ;
    cof:title "15KT(1) Particular qualifications" ;
    values:kind "subsection" ;
    values:originalText "(1) Sections 15KQ, 15KR and 15KS do not apply to anything done by an authorised person if:  (a) a particular qualification is needed to do the thing; and  (b) the person does not have that qualification." ;
    cof:pageNumber "126"^^xsd:integer .

concept:crimes-act-1914-sec-15kt-ss-2 a cml:Concept ;
    skos:prefLabel "15KT(2) Particular qualifications"@en ;
    cml:realizedBy doc:sec-15kt-ss-2 ;
    values:originalText "(2) Subsection (1) applies whether or not the person has acquired, as evidence of an assumed identity, a document that indicates that he or she has that qualification. Example: An officer who cannot fly a plane is not authorised to fly even though he or she has acquired a pilot’s licence under an assumed identity." ;
    skos:definition "(2) Subsection (1) applies whether or not the person has acquired, as evidence of an assumed identity, a document that indicates that he or she has that qualification. Example: An officer who cannot fly a plane is not authorised to fly even though he or she has acquired a pilot’s licence under an assumed identity."@en ;
    cml:integrityHash "599615e74bda76258b34cd71cc5df5e249d04f63f7ad66566a73cf36881e9792" ;
    values:partOf concept:crimes-act-1914-sec-15kt ;
    cof:pageNumber "126"^^xsd:integer ;
    skos:note "No one authorized to fly a plane without actual qualification." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
