concept:crimes-act-1914-sec-23t a cml:Concept ;
    skos:prefLabel "23T Acts authorised under other laws"@en ;
    cml:realizedBy doc:sec-23t ;
    values:originalText "Nothing in this Part prevents an investigating official from asking or causing a person to do a particular thing that the official is authorised to ask or cause the person to do under:  (a) another law of the Commonwealth; or  (b) a provision of a law of the Australian Capital Territory." ;
    skos:definition "Nothing in this Part prevents an investigating official from asking or causing a person to do a particular thing that the official is authorised to ask or cause the person to do under:  (a) another law of the Commonwealth; or  (b) a provision of a law of the Australian Capital Territory."@en ;
    cml:integrityHash "cc45744519fe7e5e20b2ff35ffc3358d3d0067987f07bf73017ebff15d6fd263" ;
    cof:pageNumber "373"^^xsd:integer ;
    skos:note "An investigating official can ask or cause a person to do something under another law." ;
    cml:curationStatus cml:Proposed ;
