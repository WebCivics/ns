concept:crimes-act-1914-sec-20bp a cml:Concept ;
    skos:prefLabel "20BP State or Territory authorities to be notified of certain releases"@en ;
    cml:realizedBy doc:sec-20bp ;
    values:originalText "Where a person detained by authority of an order under subsection 20BJ(1) or a warrant under subsection 20BM(5) for a specified period in a State or Territory is due to be released because the period of the person’s detention has ended, the Attorney-General must notify the mental health authorities of that State or Territory of the proposed release of the person.   Sentencing, imprisonment and release of federal offenders  Part IB Summary disposition of persons suffering from mental illness or intellectual disability" ;
    skos:definition "Where a person detained by authority of an order under subsection 20BJ(1) or a warrant under subsection 20BM(5) for a specified period in a State or Territory is due to be released because the period of the person’s detention has ended, the Attorney-General must notify the mental health authorities of that State or Territory of the proposed release of the person.   Sentencing, imprisonment and release of federal offenders  Part IB Summary disposition of persons suffering from mental illness or intellectual disability"@en ;
    cml:integrityHash "ca6b2cc282971e3117f9abb18dd8be7cb2e5efc589d66056553d134201e6d1bf" ;
    cof:pageNumber "318"^^xsd:integer ;
    skos:note "Notify mental health authorities of proposed release" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
