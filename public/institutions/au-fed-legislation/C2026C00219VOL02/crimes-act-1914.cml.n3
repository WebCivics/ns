doc:sec-23w a cof:Section ;
    cof:title "23W Proof of belief" ;
    values:kind "section" ;
    values:originalText "In any proceedings, the burden lies on the prosecution to prove that an investigating official had a belief on reasonable grounds as to a matter referred to in this Part." ;
    cof:pageNumber "376"^^xsd:integer .