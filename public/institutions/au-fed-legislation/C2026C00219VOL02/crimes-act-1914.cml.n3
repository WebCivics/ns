concept:crimes-act-1914-sec-15ld-ss-3 a cml:Concept ;
    skos:prefLabel "15LD(3) Reports about authorities for assumed identities etc.—law"@en ;
    cml:realizedBy doc:sec-15ld-ss-3 ;
    values:originalText "(3) The NACC Minister must exclude information from the report if satisfied on the advice of the chief officer of any of the grounds set out in subsection (2) and must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after the day on which the NACC Minister receives the report." ;
    skos:definition "(3) The NACC Minister must exclude information from the report if satisfied on the advice of the chief officer of any of the grounds set out in subsection (2) and must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after the day on which the NACC Minister receives the report."@en ;
    cml:integrityHash "0a915c5f3a508337f3ab7da3307496e27162d8b2ddc6721685613776ba88d47f" ;
    values:partOf concept:crimes-act-1914-sec-15ld ;
    cof:pageNumber "136"^^xsd:integer ;
    skos:note "Must exclude information from report if certain grounds are met and provide a copy to Parliament within 15 days." ;
    dc:description "Report" ;
