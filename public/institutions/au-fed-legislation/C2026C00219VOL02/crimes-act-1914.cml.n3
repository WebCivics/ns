concept:crimes-act-1914-sec-19aj a cml:Concept ;
    skos:prefLabel "19AJ Court may only fix non-parole periods or make recognizance"@en ;
    cml:realizedBy doc:sec-19aj ;
    values:originalText "release orders for federal sentences of imprisonment  This Division does not authorise a court to fix a single non-parole period, or make a recognizance release order, in respect both of federal sentences of imprisonment and State or Territory sentences of imprisonment." ;
    skos:definition "release orders for federal sentences of imprisonment  This Division does not authorise a court to fix a single non-parole period, or make a recognizance release order, in respect both of federal sentences of imprisonment and State or Territory sentences of imprisonment."@en ;
    cml:integrityHash "f1f2aaa66cb59f1251768ee8be790aca386d344ab20c72184abcd2c2dc016a5d" ;
    cof:pageNumber "253"^^xsd:integer ;
    skos:note "Court cannot fix non-parole periods or make recognizance release orders for federal sentences of imprisonment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.253" ;
