concept:crimes-act-1914-sec-15yl-ss-3 a cml:Concept ;
    skos:prefLabel "15YL(3) Alternative arrangements for giving evidence"@en ;
    cml:realizedBy doc:sec-15yl-ss-3 ;
    values:originalText "(3) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section; unless that person is at least 16 and chooses not to give evidence under the arrangements. 15YLA  Recording of evidence given in person" ;
    skos:definition "(3) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section; unless that person is at least 16 and chooses not to give evidence under the arrangements. 15YLA  Recording of evidence given in person"@en ;
    cml:integrityHash "a05257f238e2ab4139ce1ab40bc79b92ad620431c3107aaefb0d81d1c6749f43" ;
    values:partOf concept:crimes-act-1914-sec-15yl ;
    cof:pageNumber "188"^^xsd:integer ;
    skos:note "Exemptions from giving evidence for certain persons Recording may be a video or audio recording." ;
