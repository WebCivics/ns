concept:crimes-act-1914-sec-15yw-ss-6 a cml:Concept ;
    skos:prefLabel "15YW(6) Observers"@en ;
    cml:realizedBy doc:sec-15yw-ss-6 ;
    values:originalText "(6) For the purposes of this section, the mere fact that a person is an Australian diplomatic officer or Australian consular officer does not mean that the person is not independent of the prosecutor. Report of observer" ;
    skos:definition "(6) For the purposes of this section, the mere fact that a person is an Australian diplomatic officer or Australian consular officer does not mean that the person is not independent of the prosecutor. Report of observer"@en ;
