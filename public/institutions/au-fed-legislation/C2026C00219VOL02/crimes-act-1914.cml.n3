concept:crimes-act-1914-sec-15yc-ss-2 cml:asserts concept:crimes-act-1914-sec-15yc-ss-2-logic-deontic-5 .
concept:crimes-act-1914-sec-15yc-ss-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permission" ;
    cml:logicSummary "Court may give leave to admit evidence if it meets certain conditions." ;
    cml:premiseText "(2) The court must not give leave unless..." ;
    cml:conclusionText "...the court may give leave." ;
