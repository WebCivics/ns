doc:sec-15yg-ss-3 a cof:Section ;
    cof:title "15YG(3) Unrepresented defendants—cross-examination of vulnerable" ;
    values:kind "subsection" ;
    values:originalText "(3) In considering whether that ability will be adversely affected, the court is to have regard to any trauma that could be caused if the defendant conducts the cross-examination." ;
    cof:pageNumber "183"^^xsd:integer .

concept:crimes-act-1914-sec-15yg-ss-4 a cml:Concept ;
    skos:prefLabel "15YG(4) Unrepresented defendants—cross-examination of vulnerable"@en ;
    cml:realizedBy doc:sec-15yg-ss-4 ;
    values:originalText "(4) An application for leave under this section:  (aa) if the vulnerable person is a vulnerable adult complainant— may be made by or on behalf of the defendant or the vulnerable person; and  (a) must be in writing; and   Part IAD  Protecting vulnerable persons" ;
    skos:definition "(4) An application for leave under this section:  (aa) if the vulnerable person is a vulnerable adult complainant— may be made by or on behalf of the defendant or the vulnerable person; and  (a) must be in writing; and   Part IAD  Protecting vulnerable persons"@en ;
    cml:integrityHash "362ff1671e3ae33369ecc86574178b88f0bc38ce8cb32e30aec5e75c585bfee8" ;
    values:partOf concept:crimes-act-1914-sec-15yg ;
    cof:pageNumber "183"^^xsd:integer ;
    skos:note "Application for leave under section 15YG(4) may be made by or on behalf of the defendant or vulnerable person." ;
