doc:sec-15ml-ss-2 a cof:Section ;
    cof:title "15ML(2) Disclosure of operative’s identity to presiding officer" ;
    values:kind "subsection" ;
    values:originalText "(2) The presiding officer in the proceeding may require the operative to do one or both of the following:  (a) to disclose the operative’s true identity to the presiding officer;  (b) to provide the presiding officer with photographic evidence of that identity." ;
    cof:pageNumber "154"^^xsd:integer .

concept:crimes-act-1914-sec-15ml-ss-3 a cml:Concept ;
    skos:prefLabel "15ML(3) Disclosure of operative’s identity to presiding officer"@en ;
    cml:realizedBy doc:sec-15ml-ss-3 ;
    values:originalText "(3) The presiding officer must not:  (a) record information disclosed to the presiding officer under subsection (2); or  (b) retain or copy a document or other thing provided to the presiding officer under that subsection." ;
    skos:definition "(3) The presiding officer must not:  (a) record information disclosed to the presiding officer under subsection (2); or  (b) retain or copy a document or other thing provided to the presiding officer under that subsection."@en ;
    cml:integrityHash "d1ae758b237e8415edacc150ae80c73b1019d41a97cc6610d49470398ba85873" ;
    values:partOf concept:crimes-act-1914-sec-15ml ;
    cof:pageNumber "154"^^xsd:integer ;
    skos:note "Presiding officer must not record or retain information disclosed under subsection (2)." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.154" ;
