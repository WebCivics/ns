concept:crimes-act-1914-sec-19al-ss-3 a cml:Concept ;
    skos:prefLabel "19AL(3) Release on parole—making of parole order"@en ;
    cml:realizedBy doc:sec-19al-ss-3 ;
    values:originalText "(3) A parole order must:  (a) be in writing; and  (b) specify whether or not the person is to be released subject to supervision; and  (c) if it is proposed that the supervision period for a person released on parole subject to supervision should end before the end of the person’s parole period—specify the day on which the supervision period ends. Note 1: For when a person is released on parole in accordance with a parole order, see section 19AM. Note 2: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)." ;
    skos:definition "(3) A parole order must:  (a) be in writing; and  (b) specify whether or not the person is to be released subject to supervision; and  (c) if it is proposed that the supervision period for a person released on parole subject to supervision should end before the end of the person’s parole period—specify the day on which the supervision period ends. Note 1: For when a person is released on parole in accordance with a parole order, see section 19AM. Note 2: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)."@en ;
    cml:integrityHash "141d48216024846bb86e62058d2fe4065d662acb8891918f7fa028c1138104f6" ;
    values:partOf concept:crimes-act-1914-sec-19al ;
    cof:pageNumber "254"^^xsd:integer ;
    skos:note "Parole order must be in writing and specify supervision conditions." ;
    dc:description "(a) A parole order must be in writing; (b) specify whether or not the person is to be released subject to supervision; (c) if it is proposed that the supervision period for a person released on parole subject to supervision should end before the end of the person’s parole period—specify the day on which the supervision period ends." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
