doc:sec-15yf-ss-1 a cof:Section ;
    cof:title "15YF(1) Unrepresented defendants—cross-examination of child" ;
    values:kind "subsection" ;
    values:originalText "(1) A defendant in a child proceeding who is not represented by counsel is not to cross-examine a child complainant. Note: A person is not to cross-examine certain persons at committal proceedings or proceedings of a similar kind—see section 15YHA." ;
    cof:pageNumber "182"^^xsd:integer .

