    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Commonwealth has an obligation to indemnify participant." ;
    cml:premiseText "The Commonwealth must indemnify..." ;
    cml:conclusionText "...against any civil liability..." ;
