doc:sec-23c-ss-4 a cof:Section ;
    cof:title "23C(4) Period of investigation if arrested for a non-terrorism offence" ;
    values:kind "subsection" ;
    values:originalText "(4) For the purposes of this section, but subject to subsections (6) and (7), the investigation period begins when the person is arrested, and ends at a time thereafter that is reasonable, having regard to all the circumstances, but does not extend beyond:  (a) if the person is or appears to be under 18, an Aboriginal person or a Torres Strait Islander—2 hours; or   Investigation of Commonwealth offences  Part IC Powers of detention  Division 2  Section 23C  Crimes Act 1914  Compilation date: 04/06/2026  (b) in any other case—4 hours; after the arrest, unless the period is extended under section 23DA." ;
    cof:pageNumber "346"^^xsd:integer .

concept:crimes-act-1914-sec-23c-ss-5 a cml:Concept ;
    skos:prefLabel "23C(5) Period of investigation if arrested for a non-terrorism offence"@en ;
    cml:realizedBy doc:sec-23c-ss-5 ;
    values:originalText "(5) In ascertaining any period of time for the purposes of this section, regard shall be had to the number and complexity of matters being investigated." ;
    skos:definition "(5) In ascertaining any period of time for the purposes of this section, regard shall be had to the number and complexity of matters being investigated."@en ;
