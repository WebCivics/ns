concept:crimes-act-1914-sec-23db-ss-7 a cml:Concept ;
    skos:prefLabel "23DB(7) Period of investigation if arrested for a terrorism offence"@en ;
    cml:realizedBy doc:sec-23db-ss-7 ;
    values:originalText "(7) If the person has been arrested more than once within any period of 48 hours, the investigation period for each arrest other than the first is reduced by so much of any of the following periods as occurred within that 48 hours:  (a) any earlier investigation period or periods under this section;  (b) any earlier investigation period or periods under section 23C." ;
    skos:definition "(7) If the person has been arrested more than once within any period of 48 hours, the investigation period for each arrest other than the first is reduced by so much of any of the following periods as occurred within that 48 hours:  (a) any earlier investigation period or periods under this section;  (b) any earlier investigation period or periods under section 23C."@en ;
    cml:integrityHash "0d356b7949b257ae6f3fcdf9d7c829d30c0375f3af2cb77af0a3bbd4d8a90200" ;
    values:partOf concept:crimes-act-1914-sec-23db ;
    cof:pageNumber "352"^^xsd:integer ;
    skos:note "Reduction of investigation period for repeated arrests within 48 hours" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
