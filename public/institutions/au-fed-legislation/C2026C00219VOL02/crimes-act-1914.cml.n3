concept:crimes-act-1914-sec-19ak a cml:Concept ;
    skos:prefLabel "19AK Possible deportation no impediment to fixing non-parole"@en ;
    cml:realizedBy doc:sec-19ak ;
    values:originalText "period  Where a person is convicted of a federal offence, a court is not precluded from fixing a non-parole period in respect of the sentence imposed for that offence merely because the person is, or may be, liable to be deported from Australia." ;
    skos:definition "period  Where a person is convicted of a federal offence, a court is not precluded from fixing a non-parole period in respect of the sentence imposed for that offence merely because the person is, or may be, liable to be deported from Australia."@en ;
    cml:integrityHash "a7c2d38642de56031961dde63291b2b5e6a0f846d129682a37c56b6d618d9041" ;
    cof:pageNumber "253"^^xsd:integer ;
    skos:note "Court may fix non-parole period despite deportation risk" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.253" ;
