concept:crimes-act-1914-sec-19an a cml:Concept ;
    skos:prefLabel "19AN Parole order is subject to conditions"@en ;
    cml:realizedBy doc:sec-19an ;
    values:originalText "A parole order:  (a) is subject to the condition that the offender must, during the parole period, be of good behaviour and not violate any law; and  (b) if the parole order specifies in accordance with subsection 19AL(3) that the person is to be released subject to supervision—is subject to the condition that the offender must, during the supervision period, be subject to the supervision of a parole officer or other person specified in the   Sentencing, imprisonment and release of federal offenders  Part IB Conditional release on parole or licence  Division 5  Section 19AP  Crimes Act 1914  Compilation date: 04/06/2026  order and obey all reasonable directions of that officer or other person; and  (c) is subject to such other conditions (if any) as the Attorney-General specifies in the order." ;
    skos:definition "A parole order:  (a) is subject to the condition that the offender must, during the parole period, be of good behaviour and not violate any law; and  (b) if the parole order specifies in accordance with subsection 19AL(3) that the person is to be released subject to supervision—is subject to the condition that the offender must, during the supervision period, be subject to the supervision of a parole officer or other person specified in the   Sentencing, imprisonment and release of federal offenders  Part IB Conditional release on parole or licence  Division 5  Section 19AP  Crimes Act 1914  Compilation date: 04/06/2026  order and obey all reasonable directions of that officer or other person; and  (c) is subject to such other conditions (if any) as the Attorney-General specifies in the order."@en ;
    cml:integrityHash "746adc0cc5a0c002b331d3842209b78e04caf993306fea3d85bff9a86a47d393" ;
    cof:pageNumber "260"^^xsd:integer ;
    skos:note "Must behave and obey directions during parole period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.260" ;
