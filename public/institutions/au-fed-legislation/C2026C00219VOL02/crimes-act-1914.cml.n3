concept:crimes-act-1914-sec-20ac-ss-4 a cml:Concept ;
    skos:prefLabel "20AC(4) Failure to comply with sentence passed, or order made, under"@en ;
    cml:realizedBy doc:sec-20ac-ss-4 ;
    values:originalText "(4) A warrant issued under subsection (2) or (3) shall authorize the apprehension of the person, the bringing of the person before the court as soon as practicable after his or her apprehension and the detention of the person in custody until he or she is released by order of the court or in accordance with subsection (5)." ;
    skos:definition "(4) A warrant issued under subsection (2) or (3) shall authorize the apprehension of the person, the bringing of the person before the court as soon as practicable after his or her apprehension and the detention of the person in custody until he or she is released by order of the court or in accordance with subsection (5)."@en ;
    cml:integrityHash "702e2340244fada948ff4abe358d9cf4cada3d79edabb87a69b6e1df5f832178" ;
    values:partOf concept:crimes-act-1914-sec-20ac ;
    cof:pageNumber "296"^^xsd:integer ;
    skos:note "Detention of person until release by court order or subsection (5) order" ;
    cml:curationStatus cml:Proposed ;
