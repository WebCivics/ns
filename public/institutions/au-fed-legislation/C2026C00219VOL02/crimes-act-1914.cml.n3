doc:sec-20b-ss-5 a cof:Section ;
    cof:title "20B(5) Consequences of preliminary finding that person unfit to be" ;
    values:kind "subsection" ;
    values:originalText "(5) Where a court finds a person, other than a person in respect of whom proceedings have been referred to it by a magistrate under subsection (1), to be unfit to be tried, the court may order the person to be detained in prison or hospital for so long only as is reasonably necessary to allow the court to determine whether it will make an order under section 20BA dismissing the charge or an order under section 20BB detaining the person in prison or hospital or granting the person bail." ;
    cof:pageNumber "300"^^xsd:integer .

concept:crimes-act-1914-sec-20b-ss-6 a cml:Concept ;
    skos:prefLabel "20B(6) Consequences of preliminary finding that person unfit to be"@en ;
    cml:realizedBy doc:sec-20b-ss-6 ;
    values:originalText "(6) For the purposes of subsection (3), a prima facie case is established if there is evidence that would (except for the circumstances by reason of which the person is unfit to be tried) provide sufficient grounds to put the person on trial in relation to the offence." ;
    skos:definition "(6) For the purposes of subsection (3), a prima facie case is established if there is evidence that would (except for the circumstances by reason of which the person is unfit to be tried) provide sufficient grounds to put the person on trial in relation to the offence."@en ;
    cml:integrityHash "1c2b25e73e0501fb458110a6c33ff3023700fbb4c89f2cb56f1a8f2d69443cc3" ;
    values:partOf concept:crimes-act-1914-sec-20b ;
    cof:pageNumber "300"^^xsd:integer ;
    skos:note "Establishes prima facie case for trial based on evidence" ;
    cml:curationStatus cml:Proposed ;
