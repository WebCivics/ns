concept:crimes-act-1914-sec-23c-ss-6 a cml:Concept ;
    skos:prefLabel "23C(6) Period of investigation if arrested for a non-terrorism offence"@en ;
    cml:realizedBy doc:sec-23c-ss-6 ;
    values:originalText "(6) If the person has been arrested more than once within any period of 48 hours, the investigation period for each arrest other than the first is reduced by so much of any of the following periods as occurred within that 48 hours:  (a) any earlier investigation period or periods under this section;  (b) any earlier investigation period or periods under section 23DB." ;
    skos:definition "(6) If the person has been arrested more than once within any period of 48 hours, the investigation period for each arrest other than the first is reduced by so much of any of the following periods as occurred within that 48 hours:  (a) any earlier investigation period or periods under this section;  (b) any earlier investigation period or periods under section 23DB."@en ;
    cml:integrityHash "8b7ff969e1212491804200aec66490931a4b9bdbdcdc0a2fc0b380fa8d948200" ;
    values:partOf concept:crimes-act-1914-sec-23c ;
    cof:pageNumber "346"^^xsd:integer ;
    skos:note "Reduction of investigation period for repeated arrests within 48 hours" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.346" ;
