doc:sec-15yh-ss-1 a cof:Section ;
    cof:title "15YH(1) Represented defendants—cross-examination of vulnerable" ;
    values:kind "subsection" ;
    values:originalText "(1) A defendant in a proceeding who is represented by counsel is not to cross-examine, except through counsel, a person to whom subsection (2) applies. Note: A person is not to cross-examine certain persons at committal proceedings or proceedings of a similar kind—see section 15YHA." ;
    cof:pageNumber "184"^^xsd:integer .

concept:crimes-act-1914-sec-15yh-ss-2 a cml:Concept ;
    skos:prefLabel "15YH(2) Represented defendants—cross-examination of vulnerable"@en ;
    cml:realizedBy doc:sec-15yh-ss-2 ;
    values:originalText "(2) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section. 15YHA  Committal proceedings—cross-examination of vulnerable persons" ;
    skos:definition "(2) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section. 15YHA  Committal proceedings—cross-examination of vulnerable persons"@en ;
    cml:integrityHash "5aced8139a3eee0e6eccc092df37875cd3539bfdd13ccec117253779268e10d3" ;
    values:partOf concept:crimes-act-1914-sec-15yh ;
    cof:pageNumber "184"^^xsd:integer ;
    skos:note "Vulnerable persons must be cross-examined in committal proceedings. Vulnerable persons must be protected during cross-examination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
