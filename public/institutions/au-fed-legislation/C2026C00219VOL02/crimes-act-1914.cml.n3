concept:crimes-act-1914-sec-15yt a cml:Concept ;
    skos:prefLabel "15YT Other video link evidence provisions are unaffected"@en ;
    cml:realizedBy doc:sec-15yt ;
    values:originalText "Nothing in this Part affects the operation of Division 279 of the Criminal Code (about video link evidence in offences against humanity).   Part IAE  Video link evidence in proceedings for terrorism and related offences etc.  Section 15YU  Crimes Act 1914  Compilation date: 04/06/2026  Part IAE—Video link evidence in proceedings for terrorism and related offences etc." ;
    skos:definition "Nothing in this Part affects the operation of Division 279 of the Criminal Code (about video link evidence in offences against humanity).   Part IAE  Video link evidence in proceedings for terrorism and related offences etc.  Section 15YU  Crimes Act 1914  Compilation date: 04/06/2026  Part IAE—Video link evidence in proceedings for terrorism and related offences etc."@en ;
    cml:integrityHash "2a15e7be7973996d834e3c85b447a25a3b34c89c574638190f883f4f0fd2f321" ;
    cof:pageNumber "201"^^xsd:integer ;
    skos:note "No effect on Division 279 of Criminal Code regarding video link evidence in offences against humanity." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
