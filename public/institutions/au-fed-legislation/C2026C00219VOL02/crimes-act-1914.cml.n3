concept:crimes-act-1914-sec-16b a cml:Concept ;
    skos:prefLabel "16B Court to have regard to other periods of imprisonment required"@en ;
    cml:realizedBy doc:sec-16b ;
    values:originalText "to be served  In sentencing a person convicted of a federal offence, a court must have regard to:  (a) any sentence already imposed on the person by the court or another court for any other federal offence or for any State or Territory offence, being a sentence that the person has not served; and  (b) any sentence that the person is liable to serve because of the revocation of a parole order made, or licence granted, under this Part or under a law of a State or Territory." ;
    skos:definition "to be served  In sentencing a person convicted of a federal offence, a court must have regard to:  (a) any sentence already imposed on the person by the court or another court for any other federal offence or for any State or Territory offence, being a sentence that the person has not served; and  (b) any sentence that the person is liable to serve because of the revocation of a parole order made, or licence granted, under this Part or under a law of a State or Territory."@en ;
    cml:integrityHash "724970d57ef8376a38488dc52a75c5d133cc9e062ef3ef02fed52df06747ca0f" ;
    cof:pageNumber "233"^^xsd:integer ;
    skos:note "Court must consider previous sentences when sentencing a person convicted of a federal offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.233" ;
