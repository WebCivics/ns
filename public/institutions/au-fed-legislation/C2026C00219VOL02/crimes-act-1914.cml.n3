concept:crimes-act-1914-sec-19av-ss-3a a cml:Concept ;
    skos:prefLabel "19AV(3A) Arrest of person whose parole order or licence revoked by"@en ;
    cml:realizedBy doc:sec-19av-ss-3a ;
    values:originalText "(3A) Before fixing a non-parole period under paragraph (1)(f) in respect of the outstanding sentence or sentences, the prescribed authority must have regard to the period of time spent by the person on parole or licence before the parole order or licence was revoked under subsection 19AU(1)." ;
    skos:definition "(3A) Before fixing a non-parole period under paragraph (1)(f) in respect of the outstanding sentence or sentences, the prescribed authority must have regard to the period of time spent by the person on parole or licence before the parole order or licence was revoked under subsection 19AU(1)."@en ;
    cml:integrityHash "4df2721958b89cd2ec9bf5087ba9c3cdb0b19ab8241361cfc5278792b6acbe41" ;
    values:partOf concept:crimes-act-1914-sec-19av ;
    cof:pageNumber "272"^^xsd:integer ;
    skos:note "Authority must consider parole period before revoking parole order or licence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
