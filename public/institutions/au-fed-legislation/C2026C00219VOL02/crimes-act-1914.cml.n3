doc:sec-15yc-ss-2 a cof:Section ;
    cof:title "15YC(2) Evidence of sexual experience—child proceedings" ;
    values:kind "subsection" ;
    values:originalText "(2) The court must not give leave unless satisfied that:  (a) the evidence is substantially relevant to facts in issue in the proceeding; and  (b) the evidence has substantial probative value; and  (c) either:  (i) the evidence is of sexual activity that is alleged to form part of a connected set of circumstances in which the alleged offence was committed; or  (ii) if the evidence is of sexual activities with a defendant in the proceeding—the evidence relates to sexual activity that occurred or was recent at the time of the commission of the alleged offence." ;
    cof:pageNumber "174"^^xsd:integer .

concept:crimes-act-1914-sec-15yc-ss-3 a cml:Concept ;
    skos:prefLabel "15YC(3) Evidence of sexual experience—child proceedings"@en ;
    cml:realizedBy doc:sec-15yc-ss-3 ;
    values:originalText "(3) For the purposes of paragraph (2)(a), the evidence is not to be treated as being substantially relevant to facts in issue merely because of inferences it may raise as to the child witness’ or child complainant’s general disposition." ;
    skos:definition "(3) For the purposes of paragraph (2)(a), the evidence is not to be treated as being substantially relevant to facts in issue merely because of inferences it may raise as to the child witness’ or child complainant’s general disposition."@en ;
    cml:integrityHash "cd4c7e1964b781850f6cecef5cb38825ff0890e7ef32769aa6b8da03975f48cc" ;
    values:partOf concept:crimes-act-1914-sec-15yc ;
    cof:pageNumber "174"^^xsd:integer ;
    skos:note "Evidence of sexual experience is not to be treated as substantially relevant to facts in issue Do not treat evidence as substantially relevant to facts in issue merely because of inferences it may raise about the child witness' or child complainant's general disposition." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
