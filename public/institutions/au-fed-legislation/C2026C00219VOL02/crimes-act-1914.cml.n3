doc:sec-19as-ss-2 a cof:Section ;
    cof:title "19AS(2) Court to issue warrant of detention where person required to" ;
    values:kind "subsection" ;
    values:originalText "(2) Where the court fails to issue a warrant under paragraph (1)(d), the Director of Public Prosecutions may apply to that court for such a warrant." ;
    cof:pageNumber "268"^^xsd:integer .

concept:crimes-act-1914-sec-19at a cml:Concept ;
    skos:prefLabel "19AT What happens when later conviction is quashed?"@en ;
    cml:realizedBy doc:sec-19at ;
    values:originalText "(1) Where:  (a) a person who is serving or is to serve a federal sentence or federal sentences is released on parole or licence under this Act; and  (b) the person is later sentenced (the new sentence or sentences) to a term of imprisonment in respect of one or more federal, State or Territory offences committed during the parole period or licence period; and  (ba) under section 19AQ:  (i) the parole order or licence is to be taken to have been revoked; and  (ii) the person becomes liable to serve a part of a sentence or sentences (the outstanding sentence or sentences); then:  (c) if the person appeals against the conviction or each conviction giving rise to a new sentence and is granted bail, pending the hearing of the appeal or appeals:  (i) this Act has effect, pending the hearing of that appeal or those appeals, as if the revoked order or licence had not been revoked and as if any warrant for the detention of" ;
    skos:definition "(1) Where:  (a) a person who is serving or is to serve a federal sentence or federal sentences is released on parole or licence under this Act; and  (b) the person is later sentenced (the new sentence or sentences) to a term of imprisonment in respect of one or more federal, State or Territory offences committed during the parole period or licence period; and  (ba) under section 19AQ:  (i) the parole order or licence is to be taken to have been revoked; and  (ii) the person becomes liable to serve a part of a sentence or sentences (the outstanding sentence or sentences); then:  (c) if the person appeals against the conviction or each conviction giving rise to a new sentence and is granted bail, pending the hearing of the appeal or appeals:  (i) this Act has effect, pending the hearing of that appeal or those appeals, as if the revoked order or licence had not been revoked and as if any warrant for the detention of"@en ;
    cml:integrityHash "ebf44565ce53d2a95d95739dad9976cb080e982592b240143990f35ff82c8ff3" ;
    cof:pageNumber "269"^^xsd:integer ;
    skos:note "Revocation of parole order or licence" ;
    cml:curationStatus cml:Proposed ;
