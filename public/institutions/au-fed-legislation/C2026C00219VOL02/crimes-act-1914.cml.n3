concept:crimes-act-1914-sec-15hy a cml:Concept ;
    skos:prefLabel "15HY Ombudsman not to be sued"@en ;
    cml:realizedBy doc:sec-15hy ;
    values:originalText "The Ombudsman, an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function or power conferred by this Division.   Part IAB  Controlled operations" ;
    skos:definition "The Ombudsman, an inspecting officer, or a person acting under an inspecting officer’s direction or authority, is not liable to an action, suit or proceeding for or in relation to an act done, or omitted to be done, in good faith in the performance or exercise, or the purported performance or exercise, of a function or power conferred by this Division.   Part IAB  Controlled operations"@en ;
    cml:integrityHash "2ad2053cb69235204c0cf04d64b5016bdef01dde844f85324c657e37a6e30626" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "No liability for acts done in good faith while performing official duties." ;
    cml:curationStatus cml:Proposed ;
