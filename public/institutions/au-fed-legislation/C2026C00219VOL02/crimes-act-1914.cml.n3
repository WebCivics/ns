concept:crimes-act-1914-sec-23de-ss-6 a cml:Concept ;
    skos:prefLabel "23DE(6) Application may be made for extension of investigation period"@en ;
    cml:realizedBy doc:sec-23de-ss-6 ;
    values:originalText "(6) If the application contains any information of a kind mentioned in subsection (4), the investigating official may remove it from the copy of the application that is provided to the person or to his or her legal representative." ;
    skos:definition "(6) If the application contains any information of a kind mentioned in subsection (4), the investigating official may remove it from the copy of the application that is provided to the person or to his or her legal representative."@en ;
