doc:sec-19al-ss-3 a cof:Section ;
    cof:title "19AL(3) Release on parole—making of parole order" ;
    values:kind "subsection" ;
    values:originalText "(3) A parole order must:  (a) be in writing; and  (b) specify whether or not the person is to be released subject to supervision; and  (c) if it is proposed that the supervision period for a person released on parole subject to supervision should end before the end of the person’s parole period—specify the day on which the supervision period ends. Note 1: For when a person is released on parole in accordance with a parole order, see section 19AM. Note 2: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)." ;
    cof:pageNumber "254"^^xsd:integer .

concept:crimes-act-1914-sec-19al-ss-3a a cml:Concept ;
    skos:prefLabel "19AL(3A) Release on parole—making of parole order"@en ;
    cml:realizedBy doc:sec-19al-ss-3a ;
    values:originalText "(3A) If the Attorney-General considers that in all the circumstances it is appropriate to do so, the Attorney-General may specify in a parole order that a person is to be released from prison on a day that is before the end of the non-parole period, but is not earlier than 30 days before the end of the non-parole period." ;
    skos:definition "(3A) If the Attorney-General considers that in all the circumstances it is appropriate to do so, the Attorney-General may specify in a parole order that a person is to be released from prison on a day that is before the end of the non-parole period, but is not earlier than 30 days before the end of the non-parole period."@en ;
    cml:integrityHash "01c62549d480aa5839181e9df2dc02a0829499d3e63b11a9d5e8c56c7f6b5714" ;
    values:partOf concept:crimes-act-1914-sec-19al ;
    cof:pageNumber "254"^^xsd:integer ;
    skos:note "Specify parole order release date within 30 days before non-parole period end" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.254" ;
    cml:asserts concept:crimes-act-1914-sec-19al-ss-3a-norm .
