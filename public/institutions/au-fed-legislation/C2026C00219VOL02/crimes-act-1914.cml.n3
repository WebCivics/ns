doc:sec-23db-ss-2 a cof:Section ;
    cof:title "23DB(2) Period of investigation if arrested for a terrorism offence" ;
    values:kind "subsection" ;
    values:originalText "(2) The person may, while arrested for the terrorism offence, be detained for the purpose of investigating either or both of the following:  (a) whether the person committed the offence;  (b) whether the person committed another Commonwealth offence that an investigating official reasonably suspects that the person has committed." ;
    cof:pageNumber "352"^^xsd:integer .

concept:crimes-act-1914-sec-23db-ss-3 a cml:Concept ;
    skos:prefLabel "23DB(3) Period of investigation if arrested for a terrorism offence"@en ;
    cml:realizedBy doc:sec-23db-ss-3 ;
    values:originalText "(3) Subsection (2) ceases to apply at the end of the investigation period, but that cessation does not affect any other power to detain the person.   Investigation of Commonwealth offences  Part IC Powers of detention  Division 2  Section 23DB  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "(3) Subsection (2) ceases to apply at the end of the investigation period, but that cessation does not affect any other power to detain the person.   Investigation of Commonwealth offences  Part IC Powers of detention  Division 2  Section 23DB  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "e0eb897cca64ba7598c2fbf06a110fb4bf60affeba751cab37d129ee599d541f" ;
    values:partOf concept:crimes-act-1914-sec-23db ;
    cof:pageNumber "352"^^xsd:integer ;
    skos:note "Cessation of subsection (2) at the end of investigation period does not affect other powers to detain." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
