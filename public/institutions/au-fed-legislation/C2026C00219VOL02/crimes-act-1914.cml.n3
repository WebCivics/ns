concept:crimes-act-1914-sec-21d a cml:Concept ;
    skos:prefLabel "21D Prerogative of mercy and other Commonwealth laws unaffected"@en ;
    cml:realizedBy doc:sec-21d ;
    values:originalText "(1) Nothing in this Part shall be construed as affecting the powers vested in the Governor-General in the exercise of the Royal prerogative of mercy.  (2) This Part does not affect the operation of any other law of the Commonwealth, or of any law in force in a Territory, relating to the release of offenders." ;
    skos:definition "(1) Nothing in this Part shall be construed as affecting the powers vested in the Governor-General in the exercise of the Royal prerogative of mercy.  (2) This Part does not affect the operation of any other law of the Commonwealth, or of any law in force in a Territory, relating to the release of offenders."@en ;
    cml:integrityHash "516c8c60152f4fe09f6983713279a04edcb949754bc2ab0540507249adb810dd" ;
    cof:pageNumber "335"^^xsd:integer ;
