concept:crimes-act-1914-sec-19av-ss-3 a cml:Concept ;
    skos:prefLabel "19AV(3) Arrest of person whose parole order or licence revoked by"@en ;
    cml:realizedBy doc:sec-19av-ss-3 ;
    values:originalText "(3) The prescribed authority is not required to fix a non-parole period under paragraph (1)(f) if:  (a) the prescribed authority considers it inappropriate to do so because of the serious nature of the breach of the conditions of the order or licence that led to its revocation; or  (b) the unserved part of the outstanding sentence or sentences is, or aggregates, 3 months or less." ;
    skos:definition "(3) The prescribed authority is not required to fix a non-parole period under paragraph (1)(f) if:  (a) the prescribed authority considers it inappropriate to do so because of the serious nature of the breach of the conditions of the order or licence that led to its revocation; or  (b) the unserved part of the outstanding sentence or sentences is, or aggregates, 3 months or less."@en ;
    cml:integrityHash "2dc4bc9d666ccc2e377679d284f742f0697bf1932f7adfce5d8eba87b2a5b714" ;
    values:partOf concept:crimes-act-1914-sec-19av ;
    cof:pageNumber "272"^^xsd:integer ;
    skos:note "Authority not required to fix non-parole period under certain conditions. Must be brought before a prescribed authority after arrest." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
