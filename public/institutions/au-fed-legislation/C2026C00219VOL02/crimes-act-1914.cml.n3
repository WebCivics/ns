concept:crimes-act-1914-sec-20bf-ss-3 a cml:Concept ;
    skos:prefLabel "20BF(3) Release order may be revoked"@en ;
    cml:realizedBy doc:sec-20bf-ss-3 ;
    values:originalText "(3) Where a release order in relation to a person is revoked:  (a) a constable may arrest the person without warrant; or  (b) the Attorney-General or the Director of Public Prosecutions may apply to a prescribed authority for a warrant for the arrest of the person." ;
    skos:definition "(3) Where a release order in relation to a person is revoked:  (a) a constable may arrest the person without warrant; or  (b) the Attorney-General or the Director of Public Prosecutions may apply to a prescribed authority for a warrant for the arrest of the person."@en ;
    cml:integrityHash "4ad3628c7aa2b145c96dc10f3ed781219593db78dd10fb22729bc23e3a92e874" ;
    values:partOf concept:crimes-act-1914-sec-20bf ;
    cof:pageNumber "308"^^xsd:integer ;
    skos:note "Revocation of release order requires arrest without warrant or warrant application." ;
    cml:curationStatus cml:Proposed ;
