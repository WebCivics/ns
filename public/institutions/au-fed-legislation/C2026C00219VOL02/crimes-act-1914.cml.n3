doc:sec-20b-ss-2 a cof:Section ;
    cof:title "20B(2) Consequences of preliminary finding that person unfit to be" ;
    values:kind "subsection" ;
    values:originalText "(2) If the court to which the proceedings have been referred finds the person charged to be fit to be tried, the court must remit the proceedings to the magistrate and proceedings for the commitment must be continued as soon as practicable." ;
    cof:pageNumber "300"^^xsd:integer .

concept:crimes-act-1914-sec-20b-ss-3 a cml:Concept ;
    skos:prefLabel "20B(3) Consequences of preliminary finding that person unfit to be"@en ;
    cml:realizedBy doc:sec-20b-ss-3 ;
    values:originalText "(3) Where a court:  (a) to which proceedings have been referred under subsection (1); or  (b) before which a person appears in proceedings for trial of a federal offence on indictment, being proceedings begun after this section commences; finds the person charged unfit to be tried, the court must determine whether there has been established a prima facie case that the person committed the offence concerned." ;
    skos:definition "(3) Where a court:  (a) to which proceedings have been referred under subsection (1); or  (b) before which a person appears in proceedings for trial of a federal offence on indictment, being proceedings begun after this section commences; finds the person charged unfit to be tried, the court must determine whether there has been established a prima facie case that the person committed the offence concerned."@en ;
    cml:integrityHash "c04ccddd706f75da73a99b7e145b5c1a2c765d8501098b5fc1ef7a98ed0ef757" ;
    values:partOf concept:crimes-act-1914-sec-20b ;
    cof:pageNumber "300"^^xsd:integer ;
    skos:note "Court must determine if prima facie case has been established for unfit person to be tried." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.300" ;
