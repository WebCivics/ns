concept:crimes-act-1914-sec-15l a cml:Concept ;
    skos:prefLabel "15L Indemnity for issuing agencies and officers"@en ;
    cml:realizedBy doc:sec-15l ;
    values:originalText "(1) This section applies if the chief officer of either a law enforcement agency or an intelligence agency makes a request to the chief officer of an issuing agency of a participating jurisdiction under section 15KX.  (2) The agency that makes the request must indemnify the issuing agency and any officer of the issuing agency, for any liability incurred by the issuing agency or the officer of the issuing agency (including reasonable costs) if:  (a) the liability is incurred because of something done in the course of duty by the issuing agency or the officer of the issuing agency to comply with the request; and  (b) any requirements prescribed under the regulations have been met." ;
    skos:definition "(1) This section applies if the chief officer of either a law enforcement agency or an intelligence agency makes a request to the chief officer of an issuing agency of a participating jurisdiction under section 15KX.  (2) The agency that makes the request must indemnify the issuing agency and any officer of the issuing agency, for any liability incurred by the issuing agency or the officer of the issuing agency (including reasonable costs) if:  (a) the liability is incurred because of something done in the course of duty by the issuing agency or the officer of the issuing agency to comply with the request; and  (b) any requirements prescribed under the regulations have been met."@en ;
    cml:integrityHash "9033779664903df7bc43c15a623b88abe766fd095353103b037be5d4e600c430" ;
    cof:pageNumber "132"^^xsd:integer ;
    cml:hasPart concept:crimes-act-1914-sec-15l-ss-1 ;
    cml:hasPart concept:crimes-act-1914-sec-15l-ss-2 ;
