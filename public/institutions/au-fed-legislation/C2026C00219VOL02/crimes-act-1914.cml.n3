doc:sec-15md-ss-1 a cof:Section ;
    cof:title "15MD(1) Application of Part" ;
    values:kind "subsection" ;
    values:originalText "(1) This Part applies to a proceeding in which an operative is, or may be, required to give evidence obtained as an operative." ;
    cof:pageNumber "148"^^xsd:integer .

concept:crimes-act-1914-sec-15md-ss-2 a cml:Concept ;
    skos:prefLabel "15MD(2) Application of Part"@en ;
    cml:realizedBy doc:sec-15md-ss-2 ;
    values:originalText "(2) To avoid doubt, this Part does not affect the operation of any law in relation to the protection of a person who gives, or intends to give, evidence in a proceeding." ;
