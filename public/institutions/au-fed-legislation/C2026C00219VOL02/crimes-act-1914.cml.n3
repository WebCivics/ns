concept:crimes-act-1914-sec-23db-ss-4 a cml:Concept ;
    skos:prefLabel "23DB(4) Period of investigation if arrested for a terrorism offence"@en ;
    cml:realizedBy doc:sec-23db-ss-4 ;
    values:originalText "(4) If the person is not released within the investigation period, the person must be brought before a bail authority within the investigation period or, if it is not practicable to do so within the investigation period, as soon as practicable after the end of the investigation period." ;
    skos:definition "(4) If the person is not released within the investigation period, the person must be brought before a bail authority within the investigation period or, if it is not practicable to do so within the investigation period, as soon as practicable after the end of the investigation period."@en ;
    cml:integrityHash "a0f1eacadb56598cb741df3ffbde6bf70726a913f486c6c5ff6bf366f28718d5" ;
    values:partOf concept:crimes-act-1914-sec-23db ;
    cof:pageNumber "352"^^xsd:integer ;
    skos:note "Must be brought before a bail authority within the investigation period or as soon as practicable after." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
