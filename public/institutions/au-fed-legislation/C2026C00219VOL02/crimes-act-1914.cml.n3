    values:partOf concept:crimes-act-1914-sec-15mj ;
    cof:pageNumber "152"^^xsd:integer ;
    skos:note "Witness identity protection certificate applies to proceedings. Court may make order to protect witness identity" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
