concept:crimes-act-1914-sec-23w a cml:Concept ;
    skos:prefLabel "23W Proof of belief"@en ;
    cml:realizedBy doc:sec-23w ;
    values:originalText "In any proceedings, the burden lies on the prosecution to prove that an investigating official had a belief on reasonable grounds as to a matter referred to in this Part." ;
    skos:definition "In any proceedings, the burden lies on the prosecution to prove that an investigating official had a belief on reasonable grounds as to a matter referred to in this Part."@en ;
    cml:integrityHash "f7c716ed41930b7d15103403f631e99027feabaaba57ecda86bc1900aa17aa5b" ;
    cof:pageNumber "376"^^xsd:integer ;
    skos:note "Prosecution must prove investigating official had reasonable grounds for belief." ;
    dc:description "Evidence of investigation and belief" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
