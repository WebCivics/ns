concept:crimes-act-1914-sec-23q a cml:Concept ;
    skos:prefLabel "23Q Treatment of persons under arrest"@en ;
    cml:realizedBy doc:sec-23q ;
    values:originalText "A person who is under arrest or a protected suspect must be treated with humanity and with respect for human dignity, and must not be subjected to cruel, inhuman or degrading treatment." ;
    skos:definition "A person who is under arrest or a protected suspect must be treated with humanity and with respect for human dignity, and must not be subjected to cruel, inhuman or degrading treatment."@en ;
