doc:sec-15gt-ss-4 a cof:Section ;
    cof:title "15GT(4) Variation of formal authority to extend period of effect" ;
    values:kind "subsection" ;
    values:originalText "(4) A nominated Tribunal member may only vary a formal authority during the period of 2 weeks before the end of the period of effect of the authority." ;
    cof:pageNumber "45"^^xsd:integer .

concept:crimes-act-1914-sec-15gu a cml:Concept ;
    skos:prefLabel "15GU Application to nominated Tribunal member"@en ;
    cml:realizedBy doc:sec-15gu ;
    values:originalText "(1) The principal law enforcement officer for a controlled operation for which there is a formal authority, or any other Australian law enforcement officer acting on behalf of the principal law enforcement officer, may apply to a nominated Tribunal member for a variation of the authority that would extend its period of effect:  (a) if the period of effect of the authority is 3 months or more (including any previous extensions); or  (b) in such a way that the period of effect of the authority will, after the variation is made, be 3 months or more (including any previous extensions).   Part IAB  Controlled operations" ;
    skos:definition "(1) The principal law enforcement officer for a controlled operation for which there is a formal authority, or any other Australian law enforcement officer acting on behalf of the principal law enforcement officer, may apply to a nominated Tribunal member for a variation of the authority that would extend its period of effect:  (a) if the period of effect of the authority is 3 months or more (including any previous extensions); or  (b) in such a way that the period of effect of the authority will, after the variation is made, be 3 months or more (including any previous extensions).   Part IAB  Controlled operations"@en ;
    cml:integrityHash "c024a6436ad1581a035ea95629309ad1268e6aeacb28875569c9152dab9befcb" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Application for variation of authority period" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.45" ;
