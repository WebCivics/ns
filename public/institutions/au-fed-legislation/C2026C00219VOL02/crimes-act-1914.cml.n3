concept:crimes-act-1914-sec-15jt a cml:Concept ;
    skos:prefLabel "15JT Evidence of integrity testing authorities"@en ;
    cml:realizedBy doc:sec-15jt ;
    values:originalText "A document purporting to be an integrity testing authority:  (a) is admissible in any legal proceedings; and  (b) in the absence of evidence to the contrary, is proof in any proceedings (not being criminal or disciplinary proceedings against a law enforcement officer) that the person granting the authority was satisfied of the facts he or she was required to be satisfied of to grant the authority.   Assumed Identities  Part IAC Preliminary  Division 1  Section 15K  Crimes Act 1914  Compilation date: 04/06/2026  Part IAC—Assumed Identities" ;
    skos:definition "A document purporting to be an integrity testing authority:  (a) is admissible in any legal proceedings; and  (b) in the absence of evidence to the contrary, is proof in any proceedings (not being criminal or disciplinary proceedings against a law enforcement officer) that the person granting the authority was satisfied of the facts he or she was required to be satisfied of to grant the authority.   Assumed Identities  Part IAC Preliminary  Division 1  Section 15K  Crimes Act 1914  Compilation date: 04/06/2026  Part IAC—Assumed Identities"@en ;
    cml:integrityHash "1b74e265bcc1673944988a2497a93020e24fc449bd819de0d50a992a568f9c53" ;
    cof:pageNumber "104"^^xsd:integer ;
    skos:note "A document purporting to be an integrity testing authority is admissible in legal proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
