doc:sec-15mu-ss-3 a cof:Section ;
    cof:title "15MU(3) Reports about witness identity protection certificates" ;
    values:kind "subsection" ;
    values:originalText "(3) A report must not include information that discloses, or may lead to the disclosure of, an operative’s identity, or where the operative lives, unless the witness identity protection certificate for the operative has been cancelled." ;
    cof:pageNumber "162"^^xsd:integer .

concept:crimes-act-1914-sec-15mu-ss-4 a cml:Concept ;
    skos:prefLabel "15MU(4) Reports about witness identity protection certificates"@en ;
    cml:realizedBy doc:sec-15mu-ss-4 ;
    values:originalText "(4) The Minister must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after the day on which the Minister receives the report.   Part IACA  Witness identity protection for operatives" ;
    skos:definition "(4) The Minister must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after the day on which the Minister receives the report.   Part IACA  Witness identity protection for operatives"@en ;
