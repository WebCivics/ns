doc:sec-15yw-ss-4 a cof:Section ;
    cof:title "15YW(4) Observers" ;
    values:kind "subsection" ;
    values:originalText "(4) A person specified for the purposes of this section may be:  (a) an Australian diplomatic officer; or  (b) an Australian consular officer; or  (c) any other person." ;
    cof:pageNumber "205"^^xsd:integer .

concept:crimes-act-1914-sec-15yw-ss-5 a cml:Concept ;
    skos:prefLabel "15YW(5) Observers"@en ;
    cml:realizedBy doc:sec-15yw-ss-5 ;
    values:originalText "(5) The court must not specify a person for the purposes of this section unless the court is satisfied that the person is:  (a) independent of the prosecutor; and  (b) independent of each defendant in the proceeding; and  (c) in a position to give a report to the court about what the person observes in relation to the giving of evidence by the witness; and  (d) reasonably available to observe the giving of evidence by the witness; and  (e) an appropriate person to be specified for the purposes of this section." ;
    skos:definition "(5) The court must not specify a person for the purposes of this section unless the court is satisfied that the person is:  (a) independent of the prosecutor; and  (b) independent of each defendant in the proceeding; and  (c) in a position to give a report to the court about what the person observes in relation to the giving of evidence by the witness; and  (d) reasonably available to observe the giving of evidence by the witness; and  (e) an appropriate person to be specified for the purposes of this section."@en ;
    cml:integrityHash "0c88294d7ae24f916961f46b0e50e6562c79fa93bdbde11bdc0df2c930de41cd" ;
    values:partOf concept:crimes-act-1914-sec-15yw ;
    cof:pageNumber "205"^^xsd:integer ;
    skos:note "Court must grant adjournment if application is made under this section. Court must ensure observer is independent of prosecutor and defendants." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
