concept:crimes-act-1914-sec-16d a cml:Concept ;
    skos:prefLabel "16D No corporal punishment"@en ;
    cml:realizedBy doc:sec-16d ;
    values:originalText "(1) A court must not impose any form of corporal punishment for a federal offence.  (2) A person serving a federal sentence must not be subjected to any form of corporal punishment." ;
    skos:definition "(1) A court must not impose any form of corporal punishment for a federal offence.  (2) A person serving a federal sentence must not be subjected to any form of corporal punishment."@en ;
    cml:integrityHash "5d975020e9f4784419875f41ca54a26f06a5c28cd907aceee952153a2053002e" ;
    cof:pageNumber "237"^^xsd:integer ;
