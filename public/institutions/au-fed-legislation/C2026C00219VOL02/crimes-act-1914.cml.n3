doc:sec-15yj-ss-1 a cof:Section ;
    cof:title "15YJ(1) Giving evidence by closed-circuit television" ;
    values:kind "subsection" ;
    values:originalText "(1) If the vulnerable person’s evidence is given by means of closed-circuit television from a location outside a courtroom:  (a) that location is taken to be part of the courtroom in which the proceeding is being held; and  (b) the court may order that a court officer be present at that location; and  (c) the court may order that another person be present with the vulnerable person:  (i) to act as an interpreter; or  (ii) to assist the vulnerable person with any difficulty in giving evidence associated with a disability; or  (iii) to provide the vulnerable person with other support." ;
    cof:pageNumber "187"^^xsd:integer .

concept:crimes-act-1914-sec-15yj-ss-2 a cml:Concept ;
    skos:prefLabel "15YJ(2) Giving evidence by closed-circuit television"@en ;
    cml:realizedBy doc:sec-15yj-ss-2 ;
    values:originalText "(2) An order under paragraph (1)(b) or (c) does not limit the operation of section 15YO (about accompanying adults)." ;
    skos:definition "(2) An order under paragraph (1)(b) or (c) does not limit the operation of section 15YO (about accompanying adults)."@en ;
    cml:integrityHash "f31de960255b9b091cbe34a124ea598c1d613695ec5b14bde849e6d88a7a0178" ;
    values:partOf concept:crimes-act-1914-sec-15yj ;
    cof:pageNumber "187"^^xsd:integer ;
    skos:note "No limitation on accompanying adults for orders under section 15YO" ;
    cml:curationStatus cml:Proposed ;
