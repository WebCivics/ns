doc:sec-23df a cof:Section ;
    cof:title "23DF Magistrate may extend investigation period" ;
    values:kind "section" ;
    values:originalText "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an application has been made under subsection 23DE(1) to a magistrate in respect of the person." ;
    cof:pageNumber "361"^^xsd:integer .

concept:crimes-act-1914-sec-23e a cml:Concept ;
    skos:prefLabel "23E Evidentiary provisions if application made by electronic means"@en ;
    cml:realizedBy doc:sec-23e ;
    values:originalText "(1) This section applies if a magistrate has, under paragraph 23DA(5)(b), 23DD(5)(b) or 23DF(5)(b), informed an investigating official of matters included in an instrument.  (2) As soon as practicable after being informed of those matters, the investigating official must:  (a) complete a form of the instrument and write on it the name of the magistrate and the particulars given by him or her; and  (b) forward it to the magistrate.  (3) If the form of the instrument completed by the investigating official does not, in all material respects, accord with the terms of the instrument signed by the magistrate, the instrument is taken to have had no effect." ;
    skos:definition "(1) This section applies if a magistrate has, under paragraph 23DA(5)(b), 23DD(5)(b) or 23DF(5)(b), informed an investigating official of matters included in an instrument.  (2) As soon as practicable after being informed of those matters, the investigating official must:  (a) complete a form of the instrument and write on it the name of the magistrate and the particulars given by him or her; and  (b) forward it to the magistrate.  (3) If the form of the instrument completed by the investigating official does not, in all material respects, accord with the terms of the instrument signed by the magistrate, the instrument is taken to have had no effect."@en ;
    cml:integrityHash "3b8abbb7794c1a629cfbe5eb9a0f888a4fd9430d808671351955b0622591f83b" ;
    cof:pageNumber "363"^^xsd:integer ;
    cml:hasPart concept:crimes-act-1914-sec-23e-ss-1 ;
    cml:hasPart concept:crimes-act-1914-sec-23e-ss-2 ;
    cml:hasPart concept:crimes-act-1914-sec-23e-ss-3 ;
    cml:curationStatus cml:Proposed ;
