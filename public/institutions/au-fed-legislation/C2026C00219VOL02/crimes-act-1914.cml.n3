concept:crimes-act-1914-sec-15ji a cml:Concept ;
    skos:prefLabel "15JI Integrity testing authorities—notice to National"@en ;
    cml:realizedBy doc:sec-15ji ;
    values:originalText "Anti-Corruption Commissioner  As soon as practicable after granting an integrity testing authority for an integrity testing operation, the authorising officer must give a copy of the authority to:  (a) the responsible staff member for the operation; and  (b) the National Anti-Corruption Commissioner (unless the authorising officer is an officer of the National Anti-Corruption Commission)." ;
    skos:definition "Anti-Corruption Commissioner  As soon as practicable after granting an integrity testing authority for an integrity testing operation, the authorising officer must give a copy of the authority to:  (a) the responsible staff member for the operation; and  (b) the National Anti-Corruption Commissioner (unless the authorising officer is an officer of the National Anti-Corruption Commission)."@en ;
    cml:integrityHash "5f99fda9c790b35ffcb96ae7d73058c7baa205478ad81f973bcfd4992c29ff3d" ;
    cof:pageNumber "93"^^xsd:integer ;
    skos:note "Must provide copy of integrity testing authority to staff member and National Anti-Corruption Commissioner" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
