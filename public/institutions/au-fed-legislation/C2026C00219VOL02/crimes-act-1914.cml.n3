concept:crimes-act-1914-sec-15gl a cml:Concept ;
    skos:prefLabel "15GL Written record of urgent authority must be issued"@en ;
    cml:realizedBy doc:sec-15gl ;
    values:originalText "If an authorising officer grants an urgent authority, the authorising officer must, within 7 days, issue a written record of the urgent authority that complies with subsection 15GK(2) to the principal law enforcement officer for the controlled operation.   Controlled operations  Part IAB Authorisation of controlled operations  Division 2  Section 15GM  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "If an authorising officer grants an urgent authority, the authorising officer must, within 7 days, issue a written record of the urgent authority that complies with subsection 15GK(2) to the principal law enforcement officer for the controlled operation.   Controlled operations  Part IAB Authorisation of controlled operations  Division 2  Section 15GM  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "3d43b3e4ee17b38bf0c0640e84588eae09ae87bf1c9b99d1f9710d8f2c9ce9ee" ;
    cof:pageNumber "36"^^xsd:integer ;
