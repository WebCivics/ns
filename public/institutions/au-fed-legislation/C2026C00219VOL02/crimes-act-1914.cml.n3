doc:sec-23db-ss-5 a cof:Section ;
    cof:title "23DB(5) Period of investigation if arrested for a terrorism offence" ;
    values:kind "subsection" ;
    values:originalText "(5) For the purposes of this section, but subject to subsections (7) and (9), the investigation period begins when the person is arrested, and ends at a later time that is reasonable, having regard to all the circumstances, but does not extend beyond:  (a) if the person is or appears to be under 18, an Aboriginal person or a Torres Strait Islander—2 hours; or  (b) in any other case—4 hours; after the arrest, unless the period is extended under section 23DF." ;
    cof:pageNumber "352"^^xsd:integer .

concept:crimes-act-1914-sec-23db-ss-6 a cml:Concept ;
    skos:prefLabel "23DB(6) Period of investigation if arrested for a terrorism offence"@en ;
    cml:realizedBy doc:sec-23db-ss-6 ;
    values:originalText "(6) In ascertaining any period of time for the purposes of this section, regard shall be had to the number and complexity of matters being investigated." ;
    skos:definition "(6) In ascertaining any period of time for the purposes of this section, regard shall be had to the number and complexity of matters being investigated."@en ;
    cml:integrityHash "74e8f9950685dece65666eeb26d7326ffc7a157da85fbc41d9cae048491f716f" ;
    values:partOf concept:crimes-act-1914-sec-23db ;
    cof:pageNumber "352"^^xsd:integer ;
    skos:note "Consider complexity of matters when ascertaining time periods." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
