concept:crimes-act-1914-sec-15jm a cml:Concept ;
    skos:prefLabel "15JM Integrity testing authorities—defects"@en ;
    cml:realizedBy doc:sec-15jm ;
    values:originalText "An application for an integrity testing authority or for the variation of an authority, and any integrity testing authority or variation granted on the basis of such an application, is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material particular.   Integrity testing  Part IABA Integrity testing operations: protection of participants  Division 3  Section 15JN  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "An application for an integrity testing authority or for the variation of an authority, and any integrity testing authority or variation granted on the basis of such an application, is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material particular.   Integrity testing  Part IABA Integrity testing operations: protection of participants  Division 3  Section 15JN  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "edcc389d79f53f232277da864f84a67c9433f2c6c21ef37d763211d362f852d6" ;
    cof:pageNumber "94"^^xsd:integer ;
    skos:note "An application for an integrity testing authority or for the variation of an authority, and any integrity testing authority or variation granted on the basis of such an application, is not invalidated by any defect." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.94" ;
    cml:asserts concept:crimes-act-1914-sec-15jm-norm .
concept:crimes-act-1914-sec-15jm-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-15jm ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
