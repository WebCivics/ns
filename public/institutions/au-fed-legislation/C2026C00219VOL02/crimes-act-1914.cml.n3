concept:crimes-act-1914-sec-17a a cml:Concept ;
    skos:prefLabel "17A Restriction on imposing sentences"@en ;
    cml:realizedBy doc:sec-17a ;
    values:originalText "(1) A court shall not pass a sentence of imprisonment on any person for a federal offence, or for an offence against the law of an external Territory that is prescribed for the purposes of this section, unless the court, after having considered all other available" ;
    skos:definition "(1) A court shall not pass a sentence of imprisonment on any person for a federal offence, or for an offence against the law of an external Territory that is prescribed for the purposes of this section, unless the court, after having considered all other available"@en ;
    cml:integrityHash "09f82c676cc900a3155cfc7d67363dbf02dea348c7b6682d3ddfcae286cf754c" ;
    cof:pageNumber "239"^^xsd:integer ;
    skos:note "Court cannot pass sentence of imprisonment for certain federal offences or external Territory offences without considering other options." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
