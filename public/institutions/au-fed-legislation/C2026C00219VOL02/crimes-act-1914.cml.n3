concept:crimes-act-1914-sec-19az-ss-3 a cml:Concept ;
    skos:prefLabel "19AZ(3) Evidence before prescribed authority"@en ;
    cml:realizedBy doc:sec-19az-ss-3 ;
    values:originalText "(3) A person who appears before a prescribed authority shall not refuse to be sworn or make an affirmation or refuse to produce documents or articles, or to answer questions, that he or she is required by the prescribed authority to produce or answer. Penalty: 10 penalty units." ;
    skos:definition "(3) A person who appears before a prescribed authority shall not refuse to be sworn or make an affirmation or refuse to produce documents or articles, or to answer questions, that he or she is required by the prescribed authority to produce or answer. Penalty: 10 penalty units."@en ;
    cml:integrityHash "518412e79dcbae9c13c85c90a62385461ee44b127093ef4040812d105e3fcab7" ;
    values:partOf concept:crimes-act-1914-sec-19az ;
    cof:pageNumber "277"^^xsd:integer ;
    skos:note "A summons under this section shall be served in the same manner as a summons to a witness to appear before a court of summary jurisdiction in the State or Territory where the summons under this section is issued. Refusal to provide evidence under prescribed authority is penalized." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
