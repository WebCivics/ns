      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-19av-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AV(4) Arrest of person whose parole order or licence revoked by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19av-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.272",
      "values:originalText": "(4) Where a prescribed authority issues a warrant, the prescribed\nauthority must specify in the warrant the particulars of the\nunserved part of each outstanding sentence and, if a non-parole\nperiod is fixed, particulars of that period.",
      "skos:definition": "(4) Where a prescribed authority issues a warrant, the prescribed\nauthority must specify in the warrant the particulars of the\nunserved part of each outstanding sentence and, if a non-parole\nperiod is fixed, particulars of that period.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19av"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-4-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3fd5349221c0f7c102371f36ce1dcae59513c74b58f5556e5a6294d9c5e9f4f4",
      "skos:note": "Authority must specify particulars of unserved sentence parts and non-parole period in warrant."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19av-ss-4",
      "@type": "cof:Section",
      "cof:title": "19AV(4) Arrest of person whose parole order or licence revoked by",
      "values:kind": "subsection",
      "cof:pageNumber": 272,
      "values:originalText": "(4) Where a prescribed authority issues a warrant, the prescribed\nauthority must specify in the warrant the particulars of the\nunserved part of each outstanding sentence and, if a non-parole\nperiod is fixed, particulars of that period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19av-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
