      },
      "cml:premiseText": "(7) Unless the court considers that the interests of justice require otherwise...",
      "cml:conclusionText": "If the court considers the interests of justice, it must be closed."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mm-ss-7-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
