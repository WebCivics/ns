    {
      "@id": "concept:crimes-act-1914-sec-20bf-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BF(3) Release order may be revoked",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bf-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.308",
      "values:originalText": "(3) Where a release order in relation to a person is revoked:\n\n(a) a constable may arrest the person without warrant; or\n\n(b) the Attorney-General or the Director of Public Prosecutions\nmay apply to a prescribed authority for a warrant for the\narrest of the person.",
      "skos:definition": "(3) Where a release order in relation to a person is revoked:\n\n(a) a constable may arrest the person without warrant; or\n\n(b) the Attorney-General or the Director of Public Prosecutions\nmay apply to a prescribed authority for a warrant for the\narrest of the person.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-20bf"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4ad3628c7aa2b145c96dc10f3ed781219593db78dd10fb22729bc23e3a92e874",
      "skos:note": "Revocation of release order requires arrest without warrant or warrant application."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bf-ss-3",
      "@type": "cof:Section",
      "cof:title": "20BF(3) Release order may be revoked",
      "values:kind": "subsection",
      "cof:pageNumber": 308,
      "values:originalText": "(3) Where a release order in relation to a person is revoked:\n\n(a) a constable may arrest the person without warrant; or\n\n(b) the Attorney-General or the Director of Public Prosecutions\nmay apply to a prescribed authority for a warrant for the\narrest of the person."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bf-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-20bf-ss-3"
