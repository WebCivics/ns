        }
      ],
      "cml:integrityHash": "9f9bc092dc342d6bbdc8a4e0306e857ebb5dcd621018f834ed80e5509800e8e3",
      "skos:note": "Commonwealth must indemnify authorised persons for liability incurred due to actions taken in accordance with authority."
    },
    {
