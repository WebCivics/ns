      },
      "cml:premiseText": "(a) the person is aware of a substantial risk...",
      "cml:conclusionText": "the person is aware of the variation or cancellation..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ku-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "trace",
      "cml:logicSummary": "Tracing the variation or cancellation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) having regard to the circumstances known to the person, it is unjustifiable to take the risk that the authority has not been varied or cancelled.",
      "cml:conclusionText": "the person takes the risk that the authority has not been varied or cancelled."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ku-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
