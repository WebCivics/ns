    {
      "@id": "concept:crimes-act-1914-sec-21f",
      "@type": "cml:Concept",
      "skos:prefLabel": "21F Prescribed authorities and parole officers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-21f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
