      "@id": "concept:crimes-act-1914-sec-23s-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "No obligation to answer questions or participate in an investigation.",
      "cml:executionSurface": "modalities::logic::deontic",
