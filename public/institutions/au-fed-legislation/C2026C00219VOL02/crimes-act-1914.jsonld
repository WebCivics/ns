      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15lh-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "delegate",
      "cml:logicSummary": "Chief officer delegates function",
      "cml:executionSurface": "modalities::logic::deontic",
