        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23q",
      "@type": "cml:Concept",
      "skos:prefLabel": "23Q Treatment of persons under arrest",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.373",
      "values:originalText": "A person who is under arrest or a protected suspect must be treated\nwith humanity and with respect for human dignity, and must not be\nsubjected to cruel, inhuman or degrading treatment.",
      "skos:definition": "A person who is under arrest or a protected suspect must be treated\nwith humanity and with respect for human dignity, and must not be\nsubjected to cruel, inhuman or degrading treatment.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23q-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23q-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "05aec357c33c22f5f5e2a27ee642c43f492e39f43a9d0c69047737d223967c7b",
      "skos:note": "Must treat persons under arrest with humanity and respect for human dignity."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23q",
      "@type": "cof:Section",
      "cof:title": "23Q Treatment of persons under arrest",
      "values:kind": "section",
      "cof:pageNumber": 373,
      "values:originalText": "A person who is under arrest or a protected suspect must be treated\nwith humanity and with respect for human dignity, and must not be\nsubjected to cruel, inhuman or degrading treatment."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23q-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23q"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
