      },
      "dc:source": "crimes-act-1914.pdf, p.277",
      "values:originalText": "(4) Subsections (1), (2) and (3) do not apply if the person has a\nreasonable excuse.",
      "skos:definition": "(4) Subsections (1), (2) and (3) do not apply if the person has a\nreasonable excuse.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19az"
      },
      "cml:asserts": [
