    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to release on parole",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person must be released from prison.",
      "cml:conclusionText": "on parole in accordance with a parole order"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Release on parole after non-parole period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "for a parole order made before the end of the non-parole period;",
      "cml:conclusionText": "the last day of the non-parole period or an earlier day specified in the parole order"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Release on parole after parole order made",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "for a parole order made after the end of the non-parole period;",
      "cml:conclusionText": "the day after the parole order is made or a later day specified in the parole order"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to certify acceptance of parole order conditions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "before he or she may be released.",
      "cml:conclusionText": "the person must certify his or her acceptance of the parole order conditions"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to comply with parole order conditions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "before he or she may be released.",
      "cml:conclusionText": "the person must comply with the parole order conditions"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19an",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AN Parole order is subject to conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19an"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.260",
      "values:originalText": "A parole order:\n\n(a) is subject to the condition that the offender must, during the\nparole period, be of good behaviour and not violate any law;\nand\n\n(b) if the parole order specifies in accordance with\nsubsection 19AL(3) that the person is to be released subject\nto supervision—is subject to the condition that the offender\nmust, during the supervision period, be subject to the\nsupervision of a parole officer or other person specified in the\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nConditional release on parole or licence  Division 5\n\nSection 19AP\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\norder and obey all reasonable directions of that officer or\nother person; and\n\n(c) is subject to such other conditions (if any) as the\nAttorney-General specifies in the order.",
      "skos:definition": "A parole order:\n\n(a) is subject to the condition that the offender must, during the\nparole period, be of good behaviour and not violate any law;\nand\n\n(b) if the parole order specifies in accordance with\nsubsection 19AL(3) that the person is to be released subject\nto supervision—is subject to the condition that the offender\nmust, during the supervision period, be subject to the\nsupervision of a parole officer or other person specified in the\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nConditional release on parole or licence  Division 5\n\nSection 19AP\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\norder and obey all reasonable directions of that officer or\nother person; and\n\n(c) is subject to such other conditions (if any) as the\nAttorney-General specifies in the order.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19an-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19an-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "746adc0cc5a0c002b331d3842209b78e04caf993306fea3d85bff9a86a47d393",
      "skos:note": "Must behave and obey directions during parole period."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19an",
      "@type": "cof:Section",
      "cof:title": "19AN Parole order is subject to conditions",
      "values:kind": "section",
      "cof:pageNumber": 260,
      "values:originalText": "A parole order:\n\n(a) is subject to the condition that the offender must, during the\nparole period, be of good behaviour and not violate any law;\nand\n\n(b) if the parole order specifies in accordance with\nsubsection 19AL(3) that the person is to be released subject\nto supervision—is subject to the condition that the offender\nmust, during the supervision period, be subject to the\nsupervision of a parole officer or other person specified in the\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nConditional release on parole or licence  Division 5\n\nSection 19AP\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\norder and obey all reasonable directions of that officer or\nother person; and\n\n(c) is subject to such other conditions (if any) as the\nAttorney-General specifies in the order."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19an-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19an"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-19an-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Moral obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Parole order is subject to conditions",
      "cml:conclusionText": "Must behave and obey directions during parole period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19ap",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AP Release on licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ap"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.261",
      "values:originalText": "(1) Where a person is serving a federal sentence (whether or not a\nnon-parole period has been fixed, or a recognizance release order\nmade, in relation to that sentence), the Attorney-General may grant\na licence under this subsection for the person to be released from\nprison.\n\n(2) A person who is serving a federal sentence of imprisonment\n(whether or not a non-parole period has been fixed, or a\nrecognizance release order made, in relation to that sentence), or\nanother person acting on that person’s behalf, may apply to the\nAttorney-General for a licence under this subsection for the\nfirst-mentioned person to be released from prison.\n\n(3) An application under subsection (2) must:\n\n(a) be in writing; and\n\n(b) specify the exceptional circumstances relied on to justify the\ngrant of the licence.\n\n(4) The Attorney-General must not grant a licence under this section\nunless he or she is satisfied that exceptional circumstances exist\nwhich justify the grant of the licence.\n\n(4A) Without limiting the matters to which the Attorney-General may\nhave regard for the purposes of subsection (4), the\nAttorney-General may have regard to:\n\n(a) any extensive cooperation by the person with law\nenforcement agencies before sentencing that the sentencing\ncourt did not take into account; or\n\n(b) any extensive cooperation by the person with law\nenforcement agencies after sentencing; or",
      "skos:definition": "(1) Where a person is serving a federal sentence (whether or not a\nnon-parole period has been fixed, or a recognizance release order\nmade, in relation to that sentence), the Attorney-General may grant\na licence under this subsection for the person to be released from\nprison.\n\n(2) A person who is serving a federal sentence of imprisonment\n(whether or not a non-parole period has been fixed, or a\nrecognizance release order made, in relation to that sentence), or\nanother person acting on that person’s behalf, may apply to the\nAttorney-General for a licence under this subsection for the\nfirst-mentioned person to be released from prison.\n\n(3) An application under subsection (2) must:\n\n(a) be in writing; and\n\n(b) specify the exceptional circumstances relied on to justify the\ngrant of the licence.\n\n(4) The Attorney-General must not grant a licence under this section\nunless he or she is satisfied that exceptional circumstances exist\nwhich justify the grant of the licence.\n\n(4A) Without limiting the matters to which the Attorney-General may\nhave regard for the purposes of subsection (4), the\nAttorney-General may have regard to:\n\n(a) any extensive cooperation by the person with law\nenforcement agencies before sentencing that the sentencing\ncourt did not take into account; or\n\n(b) any extensive cooperation by the person with law\nenforcement agencies after sentencing; or",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-19ap-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ap-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ap-ss-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ap-ss-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ap-ss-4a"
        }
      ],
      "cml:integrityHash": "e16d903d13a1c182394d0a3b5e1419b1ae3ed2c0fd0ceacf70cddf1b4034be47"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ap",
      "@type": "cof:Section",
      "cof:title": "19AP Release on licence",
      "values:kind": "section",
      "cof:pageNumber": 261,
      "values:originalText": "(1) Where a person is serving a federal sentence (whether or not a\nnon-parole period has been fixed, or a recognizance release order\nmade, in relation to that sentence), the Attorney-General may grant\na licence under this subsection for the person to be released from\nprison.\n\n(2) A person who is serving a federal sentence of imprisonment\n(whether or not a non-parole period has been fixed, or a\nrecognizance release order made, in relation to that sentence), or\nanother person acting on that person’s behalf, may apply to the\nAttorney-General for a licence under this subsection for the\nfirst-mentioned person to be released from prison.\n\n(3) An application under subsection (2) must:\n\n(a) be in writing; and\n\n(b) specify the exceptional circumstances relied on to justify the\ngrant of the licence.\n\n(4) The Attorney-General must not grant a licence under this section\nunless he or she is satisfied that exceptional circumstances exist\nwhich justify the grant of the licence.\n\n(4A) Without limiting the matters to which the Attorney-General may\nhave regard for the purposes of subsection (4), the\nAttorney-General may have regard to:\n\n(a) any extensive cooperation by the person with law\nenforcement agencies before sentencing that the sentencing\ncourt did not take into account; or\n\n(b) any extensive cooperation by the person with law\nenforcement agencies after sentencing; or"
    },
