    {
      "@id": "concept:crimes-act-1914-sec-15kz",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KZ Directions from a participating jurisdiction to cancel evidence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15kz"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
