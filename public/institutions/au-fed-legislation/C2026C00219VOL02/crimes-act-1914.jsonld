    },
    {
      "@id": "concept:crimes-act-1914-sec-15yz-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Defendant has a right to appeal.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yz-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide equal weight",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a proceeding involves a jury; (b) a witness gives evidence under a section 15YV direction or order; (c) the evidence is admissible in the proceeding;",
      "cml:conclusionText": "the judge must give the jury such direction as the judge thinks necessary to ensure that the jury gives the same weight to the evidence..."
    },
