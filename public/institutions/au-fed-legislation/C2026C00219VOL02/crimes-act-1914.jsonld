    {
      "@id": "concept:crimes-act-1914-sec-16c-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "16C(2) Fines",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-16c-ss-2"
      },
