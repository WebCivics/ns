      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15jj",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JJ Integrity testing authorities—duration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.93",
      "values:originalText": "(1) An integrity testing authority comes into force when the authority\nis granted (see section 15JG).\n\n(2) The authority has effect for the period stated in the authority, as\nextended by any variation under section 15JK, unless earlier\ncancelled (see section 15JL).\nNote:\nThe maximum period of effect for an integrity testing authority\n(taking into account any extension) is 24 months after it is granted\n(see paragraph 15JH(1)(g) and subsection 15JK(2)).",
      "skos:definition": "(1) An integrity testing authority comes into force when the authority\nis granted (see section 15JG).\n\n(2) The authority has effect for the period stated in the authority, as\nextended by any variation under section 15JK, unless earlier\ncancelled (see section 15JL).\nNote:\nThe maximum period of effect for an integrity testing authority\n(taking into account any extension) is 24 months after it is granted\n(see paragraph 15JH(1)(g) and subsection 15JK(2)).",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-15jj-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jj-ss-2"
        }
      ],
      "cml:integrityHash": "56ad04cfa0b92622985274856aa9e9bedf1cf95783629fd55f7ac390fffddb85"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jj",
      "@type": "cof:Section",
      "cof:title": "15JJ Integrity testing authorities—duration",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "(1) An integrity testing authority comes into force when the authority\nis granted (see section 15JG).\n\n(2) The authority has effect for the period stated in the authority, as\nextended by any variation under section 15JK, unless earlier\ncancelled (see section 15JL).\nNote:\nThe maximum period of effect for an integrity testing authority\n(taking into account any extension) is 24 months after it is granted\n(see paragraph 15JH(1)(g) and subsection 15JK(2))."
    },
