    {
      "@id": "concept:crimes-act-1914-sec-20be-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BE(3) Attorney-General may order release",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20be-ss-3"
