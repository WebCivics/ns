    {
      "@id": "concept:crimes-act-1914-sec-17a",
      "@type": "cml:Concept",
      "skos:prefLabel": "17A Restriction on imposing sentences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-17a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.239",
      "values:originalText": "(1) A court shall not pass a sentence of imprisonment on any person\nfor a federal offence, or for an offence against the law of an\nexternal Territory that is prescribed for the purposes of this section,\nunless the court, after having considered all other available",
      "skos:definition": "(1) A court shall not pass a sentence of imprisonment on any person\nfor a federal offence, or for an offence against the law of an\nexternal Territory that is prescribed for the purposes of this section,\nunless the court, after having considered all other available",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-17a-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-17a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "09f82c676cc900a3155cfc7d67363dbf02dea348c7b6682d3ddfcae286cf754c",
      "skos:note": "Court cannot pass sentence of imprisonment for certain federal offences or external Territory offences without considering other options."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-17a",
      "@type": "cof:Section",
      "cof:title": "17A Restriction on imposing sentences",
      "values:kind": "section",
      "cof:pageNumber": 239,
      "values:originalText": "(1) A court shall not pass a sentence of imprisonment on any person\nfor a federal offence, or for an offence against the law of an\nexternal Territory that is prescribed for the purposes of this section,\nunless the court, after having considered all other available"
    },
    {
      "@id": "concept:crimes-act-1914-sec-17a-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
