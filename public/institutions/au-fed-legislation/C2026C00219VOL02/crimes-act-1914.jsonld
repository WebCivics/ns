    },
    {
      "@id": "concept:crimes-act-1914-sec-15kv-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KV(3) Transfer of control of authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15kv-ss-3"
      },
      "cml:curationStatus": {
