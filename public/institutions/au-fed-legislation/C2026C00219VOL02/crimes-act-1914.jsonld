      },
      "cml:operator": "During",
      "cml:logicSummary": "Specifies the temporal interval during which suspension or delay of questioning may be applied.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) This section applies if:\n\n(a) a person is arrested for a terrorism offence; and\n\n(b) an investigation is being conducted into whether the person\ncommitted that terrorism offence or another terrorism\noffence.",
      "cml:conclusionText": "The period during which suspension or delay of questioning may be applied starts when the person is arrested and ends when the investigation is completed."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23dc-ss-1-logic-ltl-3",
