    {
      "@id": "concept:crimes-act-1914-sec-15ji",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JI Integrity testing authorities—notice to National",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ji"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.93",
      "values:originalText": "Anti-Corruption Commissioner\n\nAs soon as practicable after granting an integrity testing authority\nfor an integrity testing operation, the authorising officer must give\na copy of the authority to:\n\n(a) the responsible staff member for the operation; and\n\n(b) the National Anti-Corruption Commissioner (unless the\nauthorising officer is an officer of the National\nAnti-Corruption Commission).",
      "skos:definition": "Anti-Corruption Commissioner\n\nAs soon as practicable after granting an integrity testing authority\nfor an integrity testing operation, the authorising officer must give\na copy of the authority to:\n\n(a) the responsible staff member for the operation; and\n\n(b) the National Anti-Corruption Commissioner (unless the\nauthorising officer is an officer of the National\nAnti-Corruption Commission).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15ji-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15ji-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5f99fda9c790b35ffcb96ae7d73058c7baa205478ad81f973bcfd4992c29ff3d",
      "skos:note": "Must provide copy of integrity testing authority to staff member and National Anti-Corruption Commissioner",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ji",
      "@type": "cof:Section",
      "cof:title": "15JI Integrity testing authorities—notice to National",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "Anti-Corruption Commissioner\n\nAs soon as practicable after granting an integrity testing authority\nfor an integrity testing operation, the authorising officer must give\na copy of the authority to:\n\n(a) the responsible staff member for the operation; and\n\n(b) the National Anti-Corruption Commissioner (unless the\nauthorising officer is an officer of the National\nAnti-Corruption Commission)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ji-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
