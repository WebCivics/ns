      ],
      "cml:integrityHash": "fa183c964b2045e20c871015056e9c634e505c91fbc5c1fac58426a55a43f8e7",
      "skos:note": "Defines parole period for a person for whom a parole order has been made. A person must be released from prison on parole in accordance with a parole order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19am-ss-1",
      "@type": "cof:Section",
      "cof:title": "19AM(1) Release on parole—when is a person released",
      "values:kind": "subsection",
      "cof:pageNumber": 258,
      "values:originalText": "(1) For the purposes of this Part, the parole period for a person for\nwhom a parole order has been made is the period starting in"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19am-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
