      "dc:source": "crimes-act-1914.pdf, p.50",
      "values:originalText": "(3) Cancellation of an authority takes effect at the time the order is\nmade or at the later time specified in the order.",
      "skos:definition": "(3) Cancellation of an authority takes effect at the time the order is\nmade or at the later time specified in the order.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15gy"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15gy-ss-3-norm"
        }
      ],
      "cml:integrityHash": "ed86ef13ac7dbd6a7720367554146c091349b0e1cea11310f4af0fabe51a1f6d",
      "skos:note": "Cancellation of authority takes effect at specified time."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15gy-ss-3",
      "@type": "cof:Section",
      "cof:title": "15GY(3) Cancellation of authorities",
