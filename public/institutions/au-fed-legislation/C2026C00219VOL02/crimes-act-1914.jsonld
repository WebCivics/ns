    {
      "@id": "concept:crimes-act-1914-sec-23w",
      "@type": "cml:Concept",
      "skos:prefLabel": "23W Proof of belief",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.376",
      "values:originalText": "In any proceedings, the burden lies on the prosecution to prove that\nan investigating official had a belief on reasonable grounds as to a\nmatter referred to in this Part.",
      "skos:definition": "In any proceedings, the burden lies on the prosecution to prove that\nan investigating official had a belief on reasonable grounds as to a\nmatter referred to in this Part.",
