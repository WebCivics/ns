      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15ka-ss-3a-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15ka-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "04c75345da2ec27f567376c1998952e50bce67df37f73cf93d14b8d0a972e18a",
      "skos:note": "Application for authority to acquire or use assumed identity is restricted to ONI intelligence officers."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ka-ss-3a",
      "@type": "cof:Section",
      "cof:title": "15KA(3A) Application for authority to acquire or use assumed identity",
      "values:kind": "subsection",
      "cof:pageNumber": 111,
      "values:originalText": "(3A) An application may only be made under subsection (3) by an\nintelligence officer of the Office of National Intelligence (ONI) for\nthe purpose of ONI carrying out its function under\nparagraph 7(1)(g) of the Office of National Intelligence Act 2018."
    },
    {
