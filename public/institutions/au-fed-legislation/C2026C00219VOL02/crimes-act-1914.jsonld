      "dc:source": "crimes-act-1914.pdf, p.191",
      "values:originalText": "(3) The court may refuse to admit the whole or part of the contents of a\nrecording adduced as evidence under section 15YM.\n\n\nPart IAD  Protecting vulnerable persons",
      "skos:definition": "(3) The court may refuse to admit the whole or part of the contents of a\nrecording adduced as evidence under section 15YM.\n\n\nPart IAD  Protecting vulnerable persons",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15yn"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15yn-ss-3-norm"
        }
      ],
      "cml:integrityHash": "5c52c2f99f4a424ffd88933e907eb340f741ecb1d824703163de86909cbeb49e",
      "skos:note": "Court may refuse to admit part of recording as evidence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yn-ss-3",
      "@type": "cof:Section",
      "cof:title": "15YN(3) Admissibility of evidence given using video or audio",
      "values:kind": "subsection",
      "cof:pageNumber": 191,
      "values:originalText": "(3) The court may refuse to admit the whole or part of the contents of a\nrecording adduced as evidence under section 15YM.\n\n\nPart IAD  Protecting vulnerable persons"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yn-ss-3-norm",
