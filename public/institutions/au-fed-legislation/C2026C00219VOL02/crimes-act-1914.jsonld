    {
      "@id": "concept:crimes-act-1914-sec-15go-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GO(4) Variation of authority by appropriate authorising officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15go-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
