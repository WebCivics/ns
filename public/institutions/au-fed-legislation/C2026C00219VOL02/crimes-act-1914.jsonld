    {
      "@id": "concept:crimes-act-1914-sec-19at",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AT What happens when later conviction is quashed?",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19at"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.269",
      "values:originalText": "(1) Where:\n\n(a) a person who is serving or is to serve a federal sentence or\nfederal sentences is released on parole or licence under this\nAct; and\n\n(b) the person is later sentenced (the new sentence or sentences)\nto a term of imprisonment in respect of one or more federal,\nState or Territory offences committed during the parole\nperiod or licence period; and\n\n(ba) under section 19AQ:\n\n(i) the parole order or licence is to be taken to have been\nrevoked; and\n\n(ii) the person becomes liable to serve a part of a sentence\nor sentences (the outstanding sentence or sentences);\nthen:\n\n(c) if the person appeals against the conviction or each\nconviction giving rise to a new sentence and is granted bail,\npending the hearing of the appeal or appeals:\n\n(i) this Act has effect, pending the hearing of that appeal or\nthose appeals, as if the revoked order or licence had not\nbeen revoked and as if any warrant for the detention of",
      "skos:definition": "(1) Where:\n\n(a) a person who is serving or is to serve a federal sentence or\nfederal sentences is released on parole or licence under this\nAct; and\n\n(b) the person is later sentenced (the new sentence or sentences)\nto a term of imprisonment in respect of one or more federal,\nState or Territory offences committed during the parole\nperiod or licence period; and\n\n(ba) under section 19AQ:\n\n(i) the parole order or licence is to be taken to have been\nrevoked; and\n\n(ii) the person becomes liable to serve a part of a sentence\nor sentences (the outstanding sentence or sentences);\nthen:\n\n(c) if the person appeals against the conviction or each\nconviction giving rise to a new sentence and is granted bail,\npending the hearing of the appeal or appeals:\n\n(i) this Act has effect, pending the hearing of that appeal or\nthose appeals, as if the revoked order or licence had not\nbeen revoked and as if any warrant for the detention of",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19at-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19at-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ebf44565ce53d2a95d95739dad9976cb080e982592b240143990f35ff82c8ff3",
      "skos:note": "Revocation of parole order or licence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19at",
      "@type": "cof:Section",
      "cof:title": "19AT What happens when later conviction is quashed?",
      "values:kind": "section",
      "cof:pageNumber": 269,
      "values:originalText": "(1) Where:\n\n(a) a person who is serving or is to serve a federal sentence or\nfederal sentences is released on parole or licence under this\nAct; and\n\n(b) the person is later sentenced (the new sentence or sentences)\nto a term of imprisonment in respect of one or more federal,\nState or Territory offences committed during the parole\nperiod or licence period; and\n\n(ba) under section 19AQ:\n\n(i) the parole order or licence is to be taken to have been\nrevoked; and\n\n(ii) the person becomes liable to serve a part of a sentence\nor sentences (the outstanding sentence or sentences);\nthen:\n\n(c) if the person appeals against the conviction or each\nconviction giving rise to a new sentence and is granted bail,\npending the hearing of the appeal or appeals:\n\n(i) this Act has effect, pending the hearing of that appeal or\nthose appeals, as if the revoked order or licence had not\nbeen revoked and as if any warrant for the detention of"
    },
