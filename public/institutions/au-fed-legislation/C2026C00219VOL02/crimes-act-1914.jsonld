        },
        {
          "@id": "concept:crimes-act-1914-sec-15mt-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3fb0e39ca8ae0cd81f7f1d5017063ddaeb0fb09b9b6b76e1a1db27efc03377e3",
      "skos:note": "Chief officer may sign certificate stating witness identity protection for operatives"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15mt",
      "@type": "cof:Section",
      "cof:title": "15MT Evidentiary certificates",
      "values:kind": "section",
      "cof:pageNumber": 161,
      "values:originalText": "(1) A chief officer of a law enforcement agency may sign a certificate\nstating any of the following:\n\n\nPart IACA  Witness identity protection for operatives"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mt-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
