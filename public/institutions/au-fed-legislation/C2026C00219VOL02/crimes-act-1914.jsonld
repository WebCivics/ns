      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hu",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HU Offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hu"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.77",
      "values:originalText": "A person commits an offence if:\n\n(a) the person is required under section 15HT to attend before an\ninspecting officer, to give information or to answer\nquestions; and\n\n(b) the person refuses or fails to do so.\nPenalty: Imprisonment for 6 months.",
      "skos:definition": "A person commits an offence if:\n\n(a) the person is required under section 15HT to attend before an\ninspecting officer, to give information or to answer\nquestions; and\n\n(b) the person refuses or fails to do so.\nPenalty: Imprisonment for 6 months.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15hu-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hu-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hu-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hu-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hu-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "d0fb89dc9d677a3e54b913a428602bf9776e15bc4ef710173b799adcc29e03f3",
      "skos:note": "Refusal to attend before an inspecting officer is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hu",
      "@type": "cof:Section",
      "cof:title": "15HU Offence",
      "values:kind": "section",
      "cof:pageNumber": 77,
      "values:originalText": "A person commits an offence if:\n\n(a) the person is required under section 15HT to attend before an\ninspecting officer, to give information or to answer\nquestions; and\n\n(b) the person refuses or fails to do so.\nPenalty: Imprisonment for 6 months."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hu-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15hu"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hu-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of refusal to attend before an inspecting officer.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 15HT requires attendance before an inspecting officer.",
      "cml:conclusionText": "Refusal to attend is prohibited."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hu-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "There is an obligation on a person to attend before an inspecting officer.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 15HT requires attendance before an inspecting officer.",
      "cml:conclusionText": "A person has an obligation to attend before an inspecting officer."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hu-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RecurringTrace",
      "cml:logicSummary": "The provision creates a recurring trace of refusal or failure to attend.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Refusal or failure to attend is prohibited.",
      "cml:conclusionText": "There is a recurring trace of refusal or failure to attend."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hu-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "The provision prohibits imprisonment for 6 months as a penalty.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Imprisonment for 6 months is the penalty for an offence.",
      "cml:conclusionText": "Imprisonment for 6 months is prohibited as a penalty."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hv",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HV Ombudsman to be given information and access despite other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hv"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.77",
      "values:originalText": "laws\n\n(1) Despite any other law, a person is not excused from giving\ninformation, answering a question, or giving access to a document,\nas and when required under this Division, on the ground that giving\nthe information, answering the question, or giving access to the\ndocument, as the case may be:\n\n(a) would contravene a law; or\n\n(b) would be contrary to the public interest; or\n\n(c) might tend to incriminate the person or make the person\nliable to a penalty; or\n\n(d) would disclose one of the following:\n\n\nPart IAB  Controlled operations",
      "skos:definition": "laws\n\n(1) Despite any other law, a person is not excused from giving\ninformation, answering a question, or giving access to a document,\nas and when required under this Division, on the ground that giving\nthe information, answering the question, or giving access to the\ndocument, as the case may be:\n\n(a) would contravene a law; or\n\n(b) would be contrary to the public interest; or\n\n(c) might tend to incriminate the person or make the person\nliable to a penalty; or\n\n(d) would disclose one of the following:\n\n\nPart IAB  Controlled operations",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15hv-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hv-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7d36bb6daff8a22c5a7970fce97382d87be35f9605f265f303dc8cc984457bc",
      "skos:note": "Must provide information, answer questions, or give access to documents despite other laws.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hv",
      "@type": "cof:Section",
      "cof:title": "15HV Ombudsman to be given information and access despite other",
      "values:kind": "section",
      "cof:pageNumber": 77,
      "values:originalText": "laws\n\n(1) Despite any other law, a person is not excused from giving\ninformation, answering a question, or giving access to a document,\nas and when required under this Division, on the ground that giving\nthe information, answering the question, or giving access to the\ndocument, as the case may be:\n\n(a) would contravene a law; or\n\n(b) would be contrary to the public interest; or\n\n(c) might tend to incriminate the person or make the person\nliable to a penalty; or\n\n(d) would disclose one of the following:\n\n\nPart IAB  Controlled operations"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hv-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
