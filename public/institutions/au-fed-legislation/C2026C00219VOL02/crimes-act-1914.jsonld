      },
      "cml:premiseText": "(4) If the person is not released within the investigation period...",
      "cml:conclusionText": "The person must be brought before a bail authority."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23db-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must be brought as soon as practicable after the end of the investigation period",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If it is not practicable to do so within the investigation period...",
      "cml:conclusionText": "The person must be brought as soon as practicable after the end of the investigation period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23db-ss-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval between release and investigation end",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If it is not practicable to do so within the investigation period...",
      "cml:conclusionText": "The temporal interval between release and investigation end is between 0 and the investigation period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23db-ss-4-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval between release and investigation end",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If it is not practicable to do so within the investigation period...",
      "cml:conclusionText": "The temporal interval between release and investigation end is between 0 and the investigation period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23db-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must be brought before a bail authority or as soon as practicable after",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
