    {
      "@id": "concept:crimes-act-1914-sec-15jl",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JL Integrity testing authorities—cancellation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.94",
      "values:originalText": "(1) An appropriate authorising officer for an integrity testing operation\nmay, by order in writing given to the responsible staff member for\nthe operation, cancel the authority at any time and for any reason.\n\n(2) The reasons for cancelling an integrity testing authority under\nsubsection (1) include (but are not limited to) cancellation at the\nrequest of the responsible staff member.\n\n(3) Cancellation of an integrity testing authority takes effect at the time\nthe order is made or at a later time stated in the order.",
      "skos:definition": "(1) An appropriate authorising officer for an integrity testing operation\nmay, by order in writing given to the responsible staff member for\nthe operation, cancel the authority at any time and for any reason.\n\n(2) The reasons for cancelling an integrity testing authority under\nsubsection (1) include (but are not limited to) cancellation at the\nrequest of the responsible staff member.\n\n(3) Cancellation of an integrity testing authority takes effect at the time\nthe order is made or at a later time stated in the order.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-15jl-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jl-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jl-ss-3"
        }
      ],
      "cml:integrityHash": "84240536b3cb7325b4305728eb2e932d59a6913e2000a771b1f52d4e1e97cfc3"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jl",
      "@type": "cof:Section",
      "cof:title": "15JL Integrity testing authorities—cancellation",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "(1) An appropriate authorising officer for an integrity testing operation\nmay, by order in writing given to the responsible staff member for\nthe operation, cancel the authority at any time and for any reason.\n\n(2) The reasons for cancelling an integrity testing authority under\nsubsection (1) include (but are not limited to) cancellation at the\nrequest of the responsible staff member.\n\n(3) Cancellation of an integrity testing authority takes effect at the time\nthe order is made or at a later time stated in the order."
    },
