    {
      "@id": "concept:crimes-act-1914-sec-15me-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "15ME(6) Witness identity protection certificate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15me-ss-6"
      },
      "cml:curationStatus": {
