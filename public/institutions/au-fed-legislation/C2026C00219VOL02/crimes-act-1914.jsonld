    },
    {
      "@id": "concept:crimes-act-1914-sec-19az-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AZ(4) Evidence before prescribed authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19az-ss-4"
      },
      "cml:curationStatus": {
