      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Constable must take person to prison.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) directing that the person be detained in...",
      "cml:conclusionText": "...directing that the person be detained in prison in that State or Territory..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19av-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Person must undergo imprisonment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
