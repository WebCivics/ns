    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-22a-ss-2",
      "@type": "cof:Section",
      "cof:title": "22A(2) State orders relating to Australian travel documents",
      "values:kind": "subsection",
      "cof:pageNumber": 338,
      "values:originalText": "(2) In this section:\nserious drug offence has the same meaning as in section 22.\n\n\nInvestigation of Commonwealth offences  Part IC\nIntroduction  Division 1\n\nSection 23\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
