    },
    {
      "@id": "concept:crimes-act-1914-sec-19ay",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AY Appeals in respect of warrants issued under",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ay"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.275",
      "values:originalText": "subsection 19AW(1) or that subsection as applied\n\n(1) Where a prescribed authority issues a warrant in respect of a\nperson under subsection 19AW(1), or under that subsection as\napplied by section 19AX, the person may appeal to the Supreme\nCourt of the State or Territory in which the person was arrested\nagainst:\n\n(a) the issue of the warrant; or\n\n(b) the calculation, for the purposes of the warrant, of the\nunserved part of any outstanding sentence; or\n\n(c) the fixing, for the purposes of the warrant, of a non-parole\nperiod or the refusal to fix such a period.",
      "skos:definition": "subsection 19AW(1) or that subsection as applied\n\n(1) Where a prescribed authority issues a warrant in respect of a\nperson under subsection 19AW(1), or under that subsection as\napplied by section 19AX, the person may appeal to the Supreme\nCourt of the State or Territory in which the person was arrested\nagainst:\n\n(a) the issue of the warrant; or\n\n(b) the calculation, for the purposes of the warrant, of the\nunserved part of any outstanding sentence; or\n\n(c) the fixing, for the purposes of the warrant, of a non-parole\nperiod or the refusal to fix such a period.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19ay-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ay-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "572d29b8c88a83008a9e4cf4df57b85bf3d6f81d31d09b21fb6bdbb538ae98bc",
      "skos:note": "Right to appeal against warrant issuance, calculation of unserved sentence, or fixing of non-parole period."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ay",
      "@type": "cof:Section",
      "cof:title": "19AY Appeals in respect of warrants issued under",
      "values:kind": "section",
      "cof:pageNumber": 275,
      "values:originalText": "subsection 19AW(1) or that subsection as applied\n\n(1) Where a prescribed authority issues a warrant in respect of a\nperson under subsection 19AW(1), or under that subsection as\napplied by section 19AX, the person may appeal to the Supreme\nCourt of the State or Territory in which the person was arrested\nagainst:\n\n(a) the issue of the warrant; or\n\n(b) the calculation, for the purposes of the warrant, of the\nunserved part of any outstanding sentence; or\n\n(c) the fixing, for the purposes of the warrant, of a non-parole\nperiod or the refusal to fix such a period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19ay-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19ay"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "held by: NaturalPerson"
    },
    {
