      },
      "cml:operator": "Obligate",
      "cml:logicSummary": "Obliges Attorney-General to revoke parole order or licence under specified conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may, by instrument in writing, revoke a parole order or licence at any time before the end of the parole period or licence period:"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19au-ss-1-logic-alleninterval-3",
