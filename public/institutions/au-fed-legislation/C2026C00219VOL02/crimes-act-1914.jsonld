        }
      ],
      "cml:integrityHash": "fa51f8ee8c0349ed99dd712fb65a32e4bfda80bb0d0738ab45a9bc247bdbb4ba",
      "skos:note": "Applicant must make a written record of the application and give a copy to the authorising officer."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15gh-ss-6",
      "@type": "cof:Section",
      "cof:title": "15GH(6) Applications for authorities to conduct controlled operations",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(6) As soon as practicable after making an urgent application that was\nnot made in writing, the applicant must make a written record of\nthe application and give a copy of it to the authorising officer to\nwhom the application was made."
    },
    {
