    },
    {
      "@id": "concept:crimes-act-1914-sec-15jd",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JD Integrity testing—meaning of integrity testing operation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.87",
      "values:originalText": "(1) An integrity testing operation is an operation conducted in relation\nto a target agency using controlled or simulated situations to test\nthe integrity of a staff member of the agency.\n\n(2) An integrity testing operation includes an operation that offers the\nstaff member an opportunity to engage in conduct, whether lawful\nor unlawful, so as to contravene principles of behaviour required\n(by law or otherwise) of persons occupying the position of such a\nstaff member.\nNote 1:\nFor target agency, see section 15JC.\nNote 2:\nReferences to a staff member include references to more than one staff\nmember (see section 23 of the Acts Interpretation Act 1901).\n\n\nPart IABA  Integrity testing",
      "skos:definition": "(1) An integrity testing operation is an operation conducted in relation\nto a target agency using controlled or simulated situations to test\nthe integrity of a staff member of the agency.\n\n(2) An integrity testing operation includes an operation that offers the\nstaff member an opportunity to engage in conduct, whether lawful\nor unlawful, so as to contravene principles of behaviour required\n(by law or otherwise) of persons occupying the position of such a\nstaff member.\nNote 1:\nFor target agency, see section 15JC.\nNote 2:\nReferences to a staff member include references to more than one staff\nmember (see section 23 of the Acts Interpretation Act 1901).\n\n\nPart IABA  Integrity testing",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-15jd-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jd-ss-2"
        }
      ],
      "cml:integrityHash": "8c7d7d78b82f2e465284654e6fae160855d4003e6476a87a281626d1ccc6fcd4"
    },
