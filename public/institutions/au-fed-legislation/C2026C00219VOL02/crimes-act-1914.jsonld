      "cml:integrityHash": "ab939c48b5d2f1fa40f3344c92f86177c21bfd2833d4a37fee1ffe869c587e14",
      "skos:note": "Court must fix non-parole period or make recognizance release order not later than the end of the sentence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19af-ss-1",
      "@type": "cof:Section",
