      },
      "cml:operator": "justifiability",
      "cml:logicSummary": "Justifiability of taking the risk",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) having regard to the circumstances known to the person, it is unjustifiable to take the risk that the authority has not been varied or cancelled.",
      "cml:conclusionText": "it is unjustifiable to take the risk that the authority has not been varied or cancelled."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ku-ss-3-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "risk assessment",
      "cml:logicSummary": "Assessing the risk",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
