    {
      "@id": "concept:crimes-act-1914-sec-15ki-ss-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasPart",
      "cml:logicSummary": "Definition of the scope of persons who may make a request.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the chief officer of a law enforcement agency who granted\nthe authority; or\n(b) the chief officer of an intelligence agency (other than the\nOffice of National Intelligence or the Australian Signals\nDirectorate) who granted the authority; or",
      "cml:conclusionText": "or (c) if the chief officer of the Office of National Intelligence\ngranted the authority—the chief officer of the Australian\nSecurity Intelligence Organisation or the Australian Secret\nIntelligence Service; or"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ki-ss-2a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
