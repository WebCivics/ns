    {
      "@id": "concept:crimes-act-1914-sec-19ap-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AP(4) Release on licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ap-ss-4"
      },
      "cml:curationStatus": {
