      "skos:note": "Specifies persons subject to disallowing inappropriate or aggressive cross-examination"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ye-ss-3",
      "@type": "cof:Section",
      "cof:title": "15YE(3) Disallowing inappropriate or aggressive cross-examination",
      "values:kind": "subsection",
      "cof:pageNumber": 182,
      "values:originalText": "(3) This subsection applies to the following persons:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness."
    },
