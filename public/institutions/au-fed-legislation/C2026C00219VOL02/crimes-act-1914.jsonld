      },
      "cml:premiseText": "Evidence provides sufficient grounds for trial",
      "cml:conclusionText": "Obligation to put person on trial"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20b-ss-6-logic-alleninterval-2",
