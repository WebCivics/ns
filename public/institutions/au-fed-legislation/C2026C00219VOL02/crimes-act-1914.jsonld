        }
      ],
      "cml:integrityHash": "60b882a946a2f16e5e5c32a3f5b2914aa84e0d35b65b1f11e15e194565c7012b",
      "skos:note": "An integrity testing authority must state the name and rank or position of the appropriate authorising officer."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jh",
