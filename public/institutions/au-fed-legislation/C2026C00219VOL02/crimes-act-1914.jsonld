    {
      "@id": "concept:crimes-act-1914-sec-15h",
      "@type": "cml:Concept",
      "skos:prefLabel": "15H Defect in authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.51",
      "values:originalText": "An application for an authority or variation of an authority, and any\nauthority or variation of an authority granted on the basis of such\nan application, is not invalidated by any defect, other than a defect\nthat affects the application, authority or variation in a material\nparticular.\n\n\nPart IAB  Controlled operations",
      "skos:definition": "An application for an authority or variation of an authority, and any\nauthority or variation of an authority granted on the basis of such\nan application, is not invalidated by any defect, other than a defect\nthat affects the application, authority or variation in a material\nparticular.\n\n\nPart IAB  Controlled operations",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15h-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15h-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "26bc45c927c8259ec62bc8938f4704568f9037db494679a51057ace160ca64b6",
      "skos:note": "No defect in authority invalidates an application or granted authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15h",
      "@type": "cof:Section",
      "cof:title": "15H Defect in authority",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "An application for an authority or variation of an authority, and any\nauthority or variation of an authority granted on the basis of such\nan application, is not invalidated by any defect, other than a defect\nthat affects the application, authority or variation in a material\nparticular.\n\n\nPart IAB  Controlled operations"
    },
    {
