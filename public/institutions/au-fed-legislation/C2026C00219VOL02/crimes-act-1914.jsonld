      "skos:note": "Same meanings as in corresponding State controlled operations law"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hh-ss-3",
      "@type": "cof:Section",
      "cof:title": "15HH(3) Protection from criminal responsibility for conduct under a",
