        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23aa-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
