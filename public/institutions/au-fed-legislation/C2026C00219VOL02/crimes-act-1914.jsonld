    {
      "@id": "concept:crimes-act-1914-sec-20aa-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "20AA(5) Power to discharge or vary conditions of recognizance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20aa-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
