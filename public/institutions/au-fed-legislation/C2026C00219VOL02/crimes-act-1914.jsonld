      },
      "cml:premiseText": "Authority to conduct a controlled operation is varied.",
      "cml:conclusionText": "This Part continues to apply."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hd-ss-1-logic-epistemic-2",
