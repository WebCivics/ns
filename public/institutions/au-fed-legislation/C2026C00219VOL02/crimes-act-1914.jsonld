        }
      ],
      "cml:integrityHash": "32c2eff3d0c7866d312f4440817dc6e0132806f15df156b621a3e72ce0300760",
      "skos:note": "Attorney-General must order release in writing with specified conditions and duration."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20be-ss-3",
      "@type": "cof:Section",
      "cof:title": "20BE(3) Attorney-General may order release",
      "values:kind": "subsection",
      "cof:pageNumber": 307,
      "values:originalText": "(3) An order:\n\n(a) must be in writing; and\n\n(b) remains in force for such period as is specified in the order\n(being a period equal to the balance of the period fixed by the\ncourt for detention under subsection 20BC(2)) or for a period\nof 5 years, whichever is the lesser; and\n\n(c) is subject to such conditions (if any) as are specified in the\norder."
    },
