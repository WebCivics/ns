        {
          "@id": "concept:crimes-act-1914-sec-20aa-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6ea259d2fde2afc7817758fb8d80d207364fa416a6a071c385b9375ee2471295",
      "skos:note": "Authorized person must serve notice on surety or probation officer."
    },
    {
