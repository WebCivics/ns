      },
      "skos:scopeNote": "held by: NaturalPerson"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23h-ss-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:logicSummary": "Right to choose an interview friend",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State grants this right",
      "cml:conclusionText": "NaturalPerson can exercise this right"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23h-ss-2a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Exercise of the right must occur within a reasonable period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has a reasonable period to exercise the right",
      "cml:conclusionText": "Exercise of the right occurs within this interval"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23h-ss-2a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Chosen interview friend must arrive within 2 hours",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has a reasonable period to exercise the right",
      "cml:conclusionText": "Arrival of the chosen interview friend occurs within this interval"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23h-ss-2a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Waiver of the right is not allowed",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must exercise the right if they choose to do so",
      "cml:conclusionText": "Waiver of the right is not permitted"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23h-ss-2a-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State has an obligation to ensure the chosen interview friend arrives on time",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The state is responsible for ensuring the person's rights are respected",
      "cml:conclusionText": "State must ensure the chosen interview friend arrives within 2 hours"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23k",
      "@type": "cml:Concept",
      "skos:prefLabel": "23K Persons under 18",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.369",
      "values:originalText": "(1) Subject to section 23L, if an investigating official:\n\n(a) interviews a person as a suspect (whether under arrest or not)\nfor a Commonwealth offence, and believes on reasonable\ngrounds that the person is under 18; or\n\n(b) believes on reasonable grounds that a person who is under\narrest or a protected suspect is under 18;\nthe official must not question the person unless an interview friend\nis present while the person is being questioned and, before the start\nof the questioning, the official has allowed the person to\ncommunicate with the interview friend in circumstances in which,\nas far as practicable, the communication will not be overheard.\n\n(2) An interview friend may be excluded from the questioning if he or\nshe unreasonably interferes with it.\n\n(3) In this section:\ninterview friend, in relation to a person to whom subsection (1)\napplies, means:\n\n(a) a parent or guardian of the person or a legal practitioner\nacting for the person; or\n\n(b) if none of the previously mentioned persons is available—a\nrelative or friend of the person who is acceptable to the\nperson; or\n\n(c) if the person is an Aboriginal person or a Torres Strait\nIslander and none of the previously mentioned persons is",
      "skos:definition": "(1) Subject to section 23L, if an investigating official:\n\n(a) interviews a person as a suspect (whether under arrest or not)\nfor a Commonwealth offence, and believes on reasonable\ngrounds that the person is under 18; or\n\n(b) believes on reasonable grounds that a person who is under\narrest or a protected suspect is under 18;\nthe official must not question the person unless an interview friend\nis present while the person is being questioned and, before the start\nof the questioning, the official has allowed the person to\ncommunicate with the interview friend in circumstances in which,\nas far as practicable, the communication will not be overheard.\n\n(2) An interview friend may be excluded from the questioning if he or\nshe unreasonably interferes with it.\n\n(3) In this section:\ninterview friend, in relation to a person to whom subsection (1)\napplies, means:\n\n(a) a parent or guardian of the person or a legal practitioner\nacting for the person; or\n\n(b) if none of the previously mentioned persons is available—a\nrelative or friend of the person who is acceptable to the\nperson; or\n\n(c) if the person is an Aboriginal person or a Torres Strait\nIslander and none of the previously mentioned persons is",
      "cml:hasPart": [
