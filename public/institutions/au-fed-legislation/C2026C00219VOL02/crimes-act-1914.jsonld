      "cml:integrityHash": "03bf6c6755c74063d43f61528d4d4db591242971bb81e4d7841374e0b7abbc82",
      "skos:note": "A court may make a psychiatric probation order for a person convicted of a federal offence if they are suffering from a mental illness and consent to the treatment."
    },
