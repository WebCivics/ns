    {
      "@id": "concept:crimes-act-1914-sec-16ab-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "16AB(5) Matters relating to victim impact statements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-16ab-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
