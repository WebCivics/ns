      },
      "cml:premiseText": "The Attorney-General is responsible for making decisions about custody releases.",
      "cml:conclusionText": "The Attorney-General must consider reports from a duly qualified psychiatrist or psychologist, but also other reports as necessary."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bk-ss-2-logic-deontic-5",
