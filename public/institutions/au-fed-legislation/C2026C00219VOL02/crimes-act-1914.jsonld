    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ad-ss-4",
      "@type": "cof:Section",
      "cof:title": "19AD(4) Persons already subject to a non-parole period",
      "values:kind": "subsection",
