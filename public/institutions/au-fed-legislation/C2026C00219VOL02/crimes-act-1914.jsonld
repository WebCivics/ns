      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bf-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits revocation of release order without arrest warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) Where a release order in relation to a person is revoked:"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bf-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BF(4) Release order may be revoked",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bf-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.308",
      "values:originalText": "(4) A person who is arrested under subsection (3) must, as soon as\npracticable after that arrest, be brought before a prescribed\nauthority in the State or Territory in which the person is arrested.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nUnfitness to be tried  Division 6\n\nSection 20BF\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "(4) A person who is arrested under subsection (3) must, as soon as\npracticable after that arrest, be brought before a prescribed\nauthority in the State or Territory in which the person is arrested.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nUnfitness to be tried  Division 6\n\nSection 20BF\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-20bf"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-4-norm"
        },
