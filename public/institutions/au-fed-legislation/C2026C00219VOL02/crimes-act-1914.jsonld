    },
    {
      "@id": "concept:crimes-act-1914-sec-21d",
      "@type": "cml:Concept",
      "skos:prefLabel": "21D Prerogative of mercy and other Commonwealth laws unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-21d"
      },
      "cml:curationStatus": {
