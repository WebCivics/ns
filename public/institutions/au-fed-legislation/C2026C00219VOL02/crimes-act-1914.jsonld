    {
      "@id": "concept:crimes-act-1914-sec-15hr",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HR Appointment of inspecting officers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.75",
      "values:originalText": "(1) The Ombudsman may appoint members of the Ombudsman’s staff\nto be inspecting officers for the purposes of this Part.\n\n(2) An appointment under subsection (1) must be in writing.\nNote:\nInspections of ACC, including inspections relating to controlled\noperations by ACC under this Part, are undertaken by the\nInspector-General of Intelligence and Security under the\nInspector-General of Intelligence and Security Act 1986.",
      "skos:definition": "(1) The Ombudsman may appoint members of the Ombudsman’s staff\nto be inspecting officers for the purposes of this Part.\n\n(2) An appointment under subsection (1) must be in writing.\nNote:\nInspections of ACC, including inspections relating to controlled\noperations by ACC under this Part, are undertaken by the\nInspector-General of Intelligence and Security under the\nInspector-General of Intelligence and Security Act 1986.",
