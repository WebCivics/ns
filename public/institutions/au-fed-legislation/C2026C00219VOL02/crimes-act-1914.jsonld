      "skos:note": "Preserves competence of persons to give evidence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yi-ss-3",
      "@type": "cof:Section",
      "cof:title": "15YI(3) Closed-circuit television",
      "values:kind": "subsection",
      "cof:pageNumber": 186,
      "values:originalText": "(3) This section does not affect the operation of any law in relation to\nthe competence of a person to give evidence.\n\n\nProtecting vulnerable persons  Part IAD\nSpecial facilities for vulnerable persons to give evidence  Division 4\n\nSection 15YJ\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yi-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
