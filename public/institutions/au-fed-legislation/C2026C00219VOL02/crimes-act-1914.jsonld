      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST PROVIDE",
      "cml:logicSummary": "Must provide copy of integrity testing authority",
      "cml:executionSurface": "modalities::logic::deontic",
