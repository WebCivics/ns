    },
    {
      "@id": "concept:crimes-act-1914-sec-15kf-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KF(6) Yearly review of authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15kf-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.118",
      "values:originalText": "(6) Failure to comply with the requirements of this section does not\ninvalidate an authority or anything lawfully done under the\nauthority.\n\n\nAssumed Identities  Part IAC\nAuthority for Assumed Identity  Division 2\n\nSection 15KG\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "(6) Failure to comply with the requirements of this section does not\ninvalidate an authority or anything lawfully done under the\nauthority.\n\n\nAssumed Identities  Part IAC\nAuthority for Assumed Identity  Division 2\n\nSection 15KG\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15kf"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15kf-ss-6-norm"
        },
