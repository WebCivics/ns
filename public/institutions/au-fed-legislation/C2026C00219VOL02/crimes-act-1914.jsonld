      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-20br",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BR Means by which court may be informed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20br"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.320",
      "values:originalText": "For the purposes of this Division, a court of summary jurisdiction\nmay inform itself as the court thinks fit, but not so as to require the\nperson charged to incriminate himself or herself.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nSentencing alternatives for persons suffering from mental illness or intellectual\ndisability  Division 9\n\nSection 20BS\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "For the purposes of this Division, a court of summary jurisdiction\nmay inform itself as the court thinks fit, but not so as to require the\nperson charged to incriminate himself or herself.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nSentencing alternatives for persons suffering from mental illness or intellectual\ndisability  Division 9\n\nSection 20BS\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20br-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20br-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20br-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "285fff59d4f27d03ada015311be676eb197d204ef40e4566b287f980e64a73a8",
      "skos:note": "Court may inform itself as it thinks fit, but not to require self-incrimination."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20br",
      "@type": "cof:Section",
      "cof:title": "20BR Means by which court may be informed",
      "values:kind": "section",
      "cof:pageNumber": 320,
      "values:originalText": "For the purposes of this Division, a court of summary jurisdiction\nmay inform itself as the court thinks fit, but not so as to require the\nperson charged to incriminate himself or herself.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nSentencing alternatives for persons suffering from mental illness or intellectual\ndisability  Division 9\n\nSection 20BS\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20br-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-20br"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-20br-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Court may inform itself",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-20br-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Can",
      "cml:logicSummary": "Informing itself is permissible",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
