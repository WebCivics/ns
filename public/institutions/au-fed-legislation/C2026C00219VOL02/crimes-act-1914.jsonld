    {
      "@id": "concept:crimes-act-1914-sec-19az-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AZ(3) Evidence before prescribed authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19az-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.277",
      "values:originalText": "(3) A person who appears before a prescribed authority shall not refuse\nto be sworn or make an affirmation or refuse to produce documents\nor articles, or to answer questions, that he or she is required by the\nprescribed authority to produce or answer.\nPenalty: 10 penalty units.",
      "skos:definition": "(3) A person who appears before a prescribed authority shall not refuse\nto be sworn or make an affirmation or refuse to produce documents\nor articles, or to answer questions, that he or she is required by the\nprescribed authority to produce or answer.\nPenalty: 10 penalty units.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19az"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19az-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19az-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "518412e79dcbae9c13c85c90a62385461ee44b127093ef4040812d105e3fcab7",
      "skos:note": "A summons under this section shall be served in the same manner as a summons to a witness to appear before a court of summary jurisdiction in the State or Territory where the summons under this section is issued. Refusal to provide evidence under prescribed authority is penalized.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19az-ss-3",
      "@type": "cof:Section",
      "cof:title": "19AZ(3) Evidence before prescribed authority",
      "values:kind": "subsection",
      "cof:pageNumber": 277,
      "values:originalText": "(3) A person who appears before a prescribed authority shall not refuse\nto be sworn or make an affirmation or refuse to produce documents\nor articles, or to answer questions, that he or she is required by the\nprescribed authority to produce or answer.\nPenalty: 10 penalty units."
    },
