    },
    {
      "@id": "concept:crimes-act-1914-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Cumulative, partly cumulative or concurrent sentences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.241",
      "values:originalText": "General requirements\n\n(1) Where a person who is convicted of a federal offence or federal\noffences is at the time of that conviction or those convictions,\nserving, or subject to, one or more federal, State or Territory\nsentences, the court must, when imposing a federal sentence for\nthat federal offence, or for each of those federal offences, by order\ndirect when the federal sentence commences, but so that:\n\n(a) no federal sentence commences later than the end of the\nsentences the commencement of which has already been\nfixed or the last to end of those sentences; and\n\n(b) if a non-parole period applies in respect of any State or\nTerritory sentences—the first federal sentence to commence\nafter the end of that non-parole period commences\nimmediately after the end of the period.",
      "skos:definition": "General requirements\n\n(1) Where a person who is convicted of a federal offence or federal\noffences is at the time of that conviction or those convictions,\nserving, or subject to, one or more federal, State or Territory\nsentences, the court must, when imposing a federal sentence for\nthat federal offence, or for each of those federal offences, by order\ndirect when the federal sentence commences, but so that:\n\n(a) no federal sentence commences later than the end of the\nsentences the commencement of which has already been\nfixed or the last to end of those sentences; and\n\n(b) if a non-parole period applies in respect of any State or\nTerritory sentences—the first federal sentence to commence\nafter the end of that non-parole period commences\nimmediately after the end of the period.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9aa4a1eaaa6db2796728b2a2464977f87a46874fe47666abfc866426c21589d8",
      "skos:note": "Court must direct when federal sentence commences, ensuring it does not later than the end of other sentences."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Cumulative, partly cumulative or concurrent sentences",
      "values:kind": "section",
      "cof:pageNumber": 241,
      "values:originalText": "General requirements\n\n(1) Where a person who is convicted of a federal offence or federal\noffences is at the time of that conviction or those convictions,\nserving, or subject to, one or more federal, State or Territory\nsentences, the court must, when imposing a federal sentence for\nthat federal offence, or for each of those federal offences, by order\ndirect when the federal sentence commences, but so that:\n\n(a) no federal sentence commences later than the end of the\nsentences the commencement of which has already been\nfixed or the last to end of those sentences; and\n\n(b) if a non-parole period applies in respect of any State or\nTerritory sentences—the first federal sentence to commence\nafter the end of that non-parole period commences\nimmediately after the end of the period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
