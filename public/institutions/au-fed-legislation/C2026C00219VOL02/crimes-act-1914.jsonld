    {
      "@id": "concept:crimes-act-1914-sec-15jh",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JH Integrity testing authorities—form",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jh"
      },
      "cml:curationStatus": {
