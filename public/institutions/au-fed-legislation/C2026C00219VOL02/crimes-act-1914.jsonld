    {
      "@id": "concept:crimes-act-1914-sec-15gh-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GH(6) Applications for authorities to conduct controlled operations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15gh-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.30",
      "values:originalText": "(6) As soon as practicable after making an urgent application that was\nnot made in writing, the applicant must make a written record of\nthe application and give a copy of it to the authorising officer to\nwhom the application was made.",
      "skos:definition": "(6) As soon as practicable after making an urgent application that was\nnot made in writing, the applicant must make a written record of\nthe application and give a copy of it to the authorising officer to\nwhom the application was made.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15gh"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15gh-ss-6-norm"
        },
        {
