        },
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-4-logic-argumentation-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-4-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bf-ss-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "504f397da88acd020fa2027ceafb9a4c104cf0be37fe405d7b98d6e0f523d3bb",
      "skos:note": "A person arrested must be brought before a prescribed authority as soon as practicable."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bf-ss-4",
      "@type": "cof:Section",
      "cof:title": "20BF(4) Release order may be revoked",
      "values:kind": "subsection",
      "cof:pageNumber": 308,
      "values:originalText": "(4) A person who is arrested under subsection (3) must, as soon as\npracticable after that arrest, be brought before a prescribed\nauthority in the State or Territory in which the person is arrested.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nUnfitness to be tried  Division 6\n\nSection 20BF\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
