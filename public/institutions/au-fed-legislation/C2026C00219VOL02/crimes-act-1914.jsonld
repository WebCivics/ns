    {
      "@id": "concept:crimes-act-1914-sec-20bs-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BS(3) Hospital orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bs-ss-3"
      },
      "cml:curationStatus": {
