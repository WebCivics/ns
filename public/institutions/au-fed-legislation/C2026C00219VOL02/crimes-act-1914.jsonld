      },
      "cml:premiseText": "Subsection (3) applies to this context",
      "cml:conclusionText": "Evidence provides sufficient grounds within the scope of subsection (3)"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20b-ss-6-logic-argumentation-3",
