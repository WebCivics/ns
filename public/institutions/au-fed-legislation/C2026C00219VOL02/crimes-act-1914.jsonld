      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ld-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prevents disclosure of sensitive information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) endanger a person’s safety; or (b) prejudice an investigation or prosecution;",
      "cml:conclusionText": "The chief officer must not include this information in the report."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ld-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between exclusion and reporting requirements.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The report must be laid before Parliament within a certain timeframe;",
      "cml:conclusionText": "Exclusion of information may occur before the report is laid before Parliament."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ld-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Eventually",
      "cml:logicSummary": "Conditional commencement of exclusion based on investigation outcomes.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The chief officer must advise the NACC Minister about potential exclusions;",
      "cml:conclusionText": "Exclusion may occur eventually, after investigation outcomes are determined."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ld-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Spreads exclusion requirements to related entities.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The report must be laid before Parliament and the NACC Minister;",
      "cml:conclusionText": "Exclusion requirements diffuse to other relevant parties."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ld-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "Artificial intelligence recognizes exclusion patterns in reports.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The chief officer uses AI to analyze the report;",
      "cml:conclusionText": "Exclusion patterns are recognized by AI systems."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ld-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15LD(3) Reports about authorities for assumed identities etc.—law",
