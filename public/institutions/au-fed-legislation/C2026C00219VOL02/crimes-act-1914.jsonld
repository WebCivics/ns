      ],
      "cml:integrityHash": "0f58219b7373235100d0e7a184bb7a313d5422dabe50f8c06675e37b7ac88d0d",
      "skos:note": "Court may impose pecuniary penalty, discharge order, revoke order, or take no action if person fails to comply with condition of psychiatric probation order."
    },
