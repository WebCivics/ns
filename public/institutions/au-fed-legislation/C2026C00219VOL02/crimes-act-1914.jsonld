      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hy",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HY Ombudsman not to be sued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hy"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.81",
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nDivision.\n\n\nPart IAB  Controlled operations",
      "skos:definition": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nDivision.\n\n\nPart IAB  Controlled operations",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15hy-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hy-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hy-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hy-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "2ad2053cb69235204c0cf04d64b5016bdef01dde844f85324c657e37a6e30626",
      "skos:note": "No liability for acts done in good faith while performing official duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hy",
      "@type": "cof:Section",
      "cof:title": "15HY Ombudsman not to be sued",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nDivision.\n\n\nPart IAB  Controlled operations"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hy-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15hy"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hy-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "No liability implies duty to act in good faith.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman is not liable for acts done in good faith.",
      "cml:conclusionText": "Therefore, the Ombudsman must act in good faith."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hy-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Entails",
      "cml:logicSummary": "Good faith entails official duties.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman acts in good faith.",
      "cml:conclusionText": "Therefore, the Ombudsman performs official duties."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hy-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "Official duties imply no liability.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Ombudsman performs official duties.",
      "cml:conclusionText": "Therefore, the Ombudsman is not liable."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hz",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HZ Evidence of authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hz"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.82",
      "values:originalText": "A document purporting to be an authority granted under\nsection 15GI or under a corresponding State controlled operations\nlaw:\n\n(a) is admissible in any legal proceedings; and\n\n(b) in the absence of evidence to the contrary, is proof in any\nproceedings (not being criminal or disciplinary proceedings\nagainst a law enforcement officer) that the person granting\nthe authority was satisfied of the facts he or she was required\nto be satisfied of to grant the authority.",
      "skos:definition": "A document purporting to be an authority granted under\nsection 15GI or under a corresponding State controlled operations\nlaw:\n\n(a) is admissible in any legal proceedings; and\n\n(b) in the absence of evidence to the contrary, is proof in any\nproceedings (not being criminal or disciplinary proceedings\nagainst a law enforcement officer) that the person granting\nthe authority was satisfied of the facts he or she was required\nto be satisfied of to grant the authority.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15hz-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15hz-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f9642839431304f26c452ef72a8258b3e9dff5803a871c0e6e346ccf6fba81cd",
      "skos:note": "A document purporting to be an authority granted under section 15GI is admissible in legal proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hz",
      "@type": "cof:Section",
      "cof:title": "15HZ Evidence of authorities",
      "values:kind": "section",
      "cof:pageNumber": 82,
      "values:originalText": "A document purporting to be an authority granted under\nsection 15GI or under a corresponding State controlled operations\nlaw:\n\n(a) is admissible in any legal proceedings; and\n\n(b) in the absence of evidence to the contrary, is proof in any\nproceedings (not being criminal or disciplinary proceedings\nagainst a law enforcement officer) that the person granting\nthe authority was satisfied of the facts he or she was required\nto be satisfied of to grant the authority."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hz-norm",
