        }
      ],
      "cml:integrityHash": "82c2a361cddcc0d071e3042ccadb5c812bdbd75dc615bdd544b12ec62f309fdf",
      "skos:note": "Evidence of sexual reputation is inadmissible in child proceedings."
    },
    {
