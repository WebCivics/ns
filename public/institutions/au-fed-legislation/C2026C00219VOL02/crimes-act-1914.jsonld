      "@id": "concept:crimes-act-1914-sec-15gh-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission to make an application.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15gh-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "HasPart",
      "cml:logicSummary": "Application is a formal or urgent application.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) An application for an authority may be made:\n\n(a) by means of a written document signed by the applicant (such an application is a formal application); or\n\n(b) if the applicant has reason to believe that the delay caused by making a formal application may affect the success of the controlled operation—orally in person, or by telephone or any other means of communication (such an application is an urgent application)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15gh-ss-2-logic-alleninterval-3",
