        }
      ],
      "cml:integrityHash": "fbd5cd53472030c77538d38c39e06aeadc881f6fc5e261735f725259e775c8f0",
      "skos:note": "Court jurisdiction for appeals under this section"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yz-ss-5",
      "@type": "cof:Section",
