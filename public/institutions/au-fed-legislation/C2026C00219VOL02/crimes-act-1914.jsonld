      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15gj-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Authority to conduct controlled operation may be granted.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
