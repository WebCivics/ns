      "cml:integrityHash": "83ccbb02bd11196e2cee39649f9906cba25fd05a00b5b42e833fdcf1193592e6",
      "skos:note": "Application must be in writing and specify exceptional circumstances.",
      "dc:description": "exceptional circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ap-ss-3",
      "@type": "cof:Section",
      "cof:title": "19AP(3) Release on licence",
      "values:kind": "subsection",
      "cof:pageNumber": 261,
      "values:originalText": "(3) An application under subsection (2) must:\n\n(a) be in writing; and\n\n(b) specify the exceptional circumstances relied on to justify the\ngrant of the licence."
    },
