    {
      "@id": "concept:crimes-act-1914-sec-15jr",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JR Integrity testing operations—disclosure endangering safety",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.99",
      "values:originalText": "etc.\nOffence—disclosure endangering safety etc.\n\n(1) A person commits an offence if:\n\n(a) the person discloses information; and\n\n(b) the information relates to an integrity testing operation; and\n\n(c) either:\n\n(i) the person intends to endanger the health or safety of\nany person or prejudice the effective conduct of an\nintegrity testing operation; or\n\n\nPart IABA  Integrity testing",
      "skos:definition": "etc.\nOffence—disclosure endangering safety etc.\n\n(1) A person commits an offence if:\n\n(a) the person discloses information; and\n\n(b) the information relates to an integrity testing operation; and\n\n(c) either:\n\n(i) the person intends to endanger the health or safety of\nany person or prejudice the effective conduct of an\nintegrity testing operation; or\n\n\nPart IABA  Integrity testing",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15jr-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jr-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jr-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jr-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jr-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jr-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "efde0f3128bd2261856f8d298350af6369369c05b597c9597f0e0fef935ce971",
      "skos:note": "Disclosing information about integrity testing operations that endangers safety is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jr",
