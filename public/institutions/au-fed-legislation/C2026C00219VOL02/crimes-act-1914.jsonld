        }
      ],
      "cml:integrityHash": "7dea239bdc41f2d8829a14f2ef80f0f0dd6e116e61691b4d3799c3459a8dd4da",
      "skos:note": "Court must not make a recognizance release order when imposing new sentence."
    },
    {
