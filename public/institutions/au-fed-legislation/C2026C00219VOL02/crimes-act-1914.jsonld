    {
      "@id": "concept:crimes-act-1914-sec-15yb",
      "@type": "cml:Concept",
      "skos:prefLabel": "15YB Evidence of sexual reputation—child proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yb"
      },
      "cml:curationStatus": {
