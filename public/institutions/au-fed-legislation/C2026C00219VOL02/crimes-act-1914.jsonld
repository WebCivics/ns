      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23s",
      "@type": "cml:Concept",
      "skos:prefLabel": "23S Right to remain silent etc. not affected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.373",
      "values:originalText": "Nothing in this Part affects:\n\n(a) the right of a person to refuse to answer questions or to\nparticipate in an investigation except where required to do so\nby or under an Act; or\n\n(b) any burden on the prosecution to prove the voluntariness of\nan admission or confession made by a person; or\n\n(ba) any burden on the prosecution to prove that an admission or\nconfession was made in such circumstances as to make it\nunlikely that the truth of the admission or confession was\nadversely affected; or\n\n(c) the discretion of a court to exclude unfairly obtained\nevidence; or\n\n(d) the discretion of a court to exclude illegally or improperly\nobtained evidence.",
      "skos:definition": "Nothing in this Part affects:\n\n(a) the right of a person to refuse to answer questions or to\nparticipate in an investigation except where required to do so\nby or under an Act; or\n\n(b) any burden on the prosecution to prove the voluntariness of\nan admission or confession made by a person; or\n\n(ba) any burden on the prosecution to prove that an admission or\nconfession was made in such circumstances as to make it\nunlikely that the truth of the admission or confession was\nadversely affected; or\n\n(c) the discretion of a court to exclude unfairly obtained\nevidence; or\n\n(d) the discretion of a court to exclude illegally or improperly\nobtained evidence.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23s-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23s-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3491e86b95d4cb110d5b85f9625c619597676f3f2981a2a613185809a81d9ee2",
      "skos:note": "Right to remain silent not affected by this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23s",
      "@type": "cof:Section",
      "cof:title": "23S Right to remain silent etc. not affected",
      "values:kind": "section",
      "cof:pageNumber": 373,
      "values:originalText": "Nothing in this Part affects:\n\n(a) the right of a person to refuse to answer questions or to\nparticipate in an investigation except where required to do so\nby or under an Act; or\n\n(b) any burden on the prosecution to prove the voluntariness of\nan admission or confession made by a person; or\n\n(ba) any burden on the prosecution to prove that an admission or\nconfession was made in such circumstances as to make it\nunlikely that the truth of the admission or confession was\nadversely affected; or\n\n(c) the discretion of a court to exclude unfairly obtained\nevidence; or\n\n(d) the discretion of a court to exclude illegally or improperly\nobtained evidence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23s-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23s"
      },
