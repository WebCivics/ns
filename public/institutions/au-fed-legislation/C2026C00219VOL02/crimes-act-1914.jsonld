        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "...for the purpose of deciding whether...",
      "cml:conclusionText": "...the court considers appropriate..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yw-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "15YW(8) Observers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yw-ss-8"
      },
      "cml:curationStatus": {
