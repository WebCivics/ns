    {
      "@id": "concept:crimes-act-1914-sec-20bi-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BI(3) Appeals against some Victorian jury findings of unfitness to be",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bi-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
