    {
      "@id": "concept:crimes-act-1914-sec-23a",
      "@type": "cml:Concept",
      "skos:prefLabel": "23A Application of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.339",
      "values:originalText": "(1) Any law of the Commonwealth in force immediately before the\ncommencement of this Part, and any rule of the common law, has\nno effect so far as it is inconsistent with this Part.\n\n(2) This Part does not exclude or limit the operation of a law of a State\nor Territory so far as it can operate concurrently with this Part.\n\n(3) In subsection (2):\nlaw of a State or Territory includes such a law that is given a\nparticular application by a law of the Commonwealth.\n\n(4) Where a law of a State or Territory would, apart from this\nsubsection, require the electronic recording of confessional",
      "skos:definition": "(1) Any law of the Commonwealth in force immediately before the\ncommencement of this Part, and any rule of the common law, has\nno effect so far as it is inconsistent with this Part.\n\n(2) This Part does not exclude or limit the operation of a law of a State\nor Territory so far as it can operate concurrently with this Part.\n\n(3) In subsection (2):\nlaw of a State or Territory includes such a law that is given a\nparticular application by a law of the Commonwealth.\n\n(4) Where a law of a State or Territory would, apart from this\nsubsection, require the electronic recording of confessional",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-23a-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23a-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23a-ss-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23a-ss-4"
        }
      ],
      "cml:integrityHash": "8125aa2a49cb1b4c3c7fe413f7c82a2d6859039c0cfba8bf135cd1f949278189"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23a",
      "@type": "cof:Section",
      "cof:title": "23A Application of Part",
      "values:kind": "section",
      "cof:pageNumber": 339,
      "values:originalText": "(1) Any law of the Commonwealth in force immediately before the\ncommencement of this Part, and any rule of the common law, has\nno effect so far as it is inconsistent with this Part.\n\n(2) This Part does not exclude or limit the operation of a law of a State\nor Territory so far as it can operate concurrently with this Part.\n\n(3) In subsection (2):\nlaw of a State or Territory includes such a law that is given a\nparticular application by a law of the Commonwealth.\n\n(4) Where a law of a State or Territory would, apart from this\nsubsection, require the electronic recording of confessional"
    },
