        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the parole order or licence relating to a person is taken to have been revoked under subsection (1) or (2),",
      "cml:conclusionText": "the person becomes liable to serve"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19aq-ss-4-logic-linearlogic-2",
