      "cml:integrityHash": "9110aee58787e842b59dbdd3329b8002f68c3b2d12d2c3c1ae8f69bfd7f97a3d",
      "skos:note": "Separate application must be made for each assumed identity."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ka-ss-4",
      "@type": "cof:Section",
      "cof:title": "15KA(4) Application for authority to acquire or use assumed identity",
      "values:kind": "subsection",
      "cof:pageNumber": 111,
      "values:originalText": "(4) A separate application must be made in respect of each assumed\nidentity to be acquired or used.\n\n\nPart IAC  Assumed Identities"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ka-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
