      "cof:pageNumber": 371,
      "values:originalText": "Where an investigating official believes on reasonable grounds that\na person who is under arrest or a protected suspect is unable,\nbecause of inadequate knowledge of the English language or a"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23n-norm",
      "@type": "values:Right",
      "cml:modality": {
