      "cml:integrityHash": "a97625090aed105b1ae97c25f1d329bf3bfed4ae0ebb6614eabbb2aaf05e55fa",
      "skos:note": "Court must be satisfied before discharging a hospital order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bu-ss-2",
      "@type": "cof:Section",
      "cof:title": "20BU(2) Discharge of hospital orders",
      "values:kind": "subsection",
      "cof:pageNumber": 323,
      "values:originalText": "(2) The court must not discharge a hospital order unless the court is\nsatisfied:"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bu-ss-2-norm",
