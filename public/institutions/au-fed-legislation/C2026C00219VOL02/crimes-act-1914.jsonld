    {
      "@id": "concept:crimes-act-1914-sec-20a",
      "@type": "cml:Concept",
      "skos:prefLabel": "20A Failure to comply with condition of discharge or release",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.285",
      "values:originalText": "(1) Where a person has been discharged in pursuance of an order made\nunder subsection 19B(1), or released in pursuance of an order\nmade under subsection 20(1), and information is laid before a\nmagistrate alleging that the person has, without reasonable cause or\nexcuse, failed to comply with a condition of the order, the\nmagistrate may:\n\n(a) issue a summons directing the person to appear, on a date, at\na time and at a place fixed in the summons, before the court\nby which the order was made; or\n\n(b) if the information is laid on oath and the magistrate is of the\nopinion that proceedings against the person by summons",
      "skos:definition": "(1) Where a person has been discharged in pursuance of an order made\nunder subsection 19B(1), or released in pursuance of an order\nmade under subsection 20(1), and information is laid before a\nmagistrate alleging that the person has, without reasonable cause or\nexcuse, failed to comply with a condition of the order, the\nmagistrate may:\n\n(a) issue a summons directing the person to appear, on a date, at\na time and at a place fixed in the summons, before the court\nby which the order was made; or\n\n(b) if the information is laid on oath and the magistrate is of the\nopinion that proceedings against the person by summons",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20a-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20a-logic-deontic-1"
