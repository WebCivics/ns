      ],
      "cml:integrityHash": "5cd1d011c6f5941f8c6fa2459eae1c0ff81fb0ddd7185fc2b9fcc7c7f999af0d",
      "skos:note": "Ignore judge directions and weight given to video link evidence in proceedings not covered by this Part. Prosecutor may appeal against a section 15YV direction or order. Subsection (1) has effect for the purposes of laws relating to evidence, procedure, contempt of court and perjury."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yz-ss-2",
      "@type": "cof:Section",
      "cof:title": "15YZ(2) Direction to jury",
      "values:kind": "subsection",
      "cof:pageNumber": 209,
      "values:originalText": "(2) Disregard subsection (1) in determining:\n\n(a) the directions (if any) that should be given by a judge in\nproceedings to which this Part does not apply; and\n\n(b) the weight that should be given to evidence given by video\nlink in proceedings to which this Part does not apply.\n\n\nPart IAE  Video link evidence in proceedings for terrorism and related offences etc.\n\nSection 15YZA\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\n15YZA  Application of laws about witnesses"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yz-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
