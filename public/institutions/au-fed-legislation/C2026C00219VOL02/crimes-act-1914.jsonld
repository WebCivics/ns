      },
      "cml:premiseText": "The person is acting in accordance with authority.",
      "cml:conclusionText": "They are not criminally responsible for the offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15kq-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
