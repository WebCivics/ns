    {
      "@id": "concept:crimes-act-1914-sec-15ms-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MS(3) Disclosure offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ms-ss-3"
