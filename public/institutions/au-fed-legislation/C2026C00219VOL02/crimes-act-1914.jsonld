      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General is responsible for making decisions about custody releases.",
      "cml:conclusionText": "The Attorney-General must obtain and consider reports from a duly qualified psychiatrist or psychologist within a certain timeframe."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bk-ss-2-logic-ltl-4",
