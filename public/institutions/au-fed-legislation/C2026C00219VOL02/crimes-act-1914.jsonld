      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) if the chief officer of the Australian Signals Directorate\ngranted the authority—the chief officer of the Australian\nSecurity Intelligence Organisation or the Australian Secret\nIntelligence Service."
    },
