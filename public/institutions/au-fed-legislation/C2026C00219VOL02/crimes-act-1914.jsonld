      "cml:integrityHash": "d4db0e13169a6fc3024f2b2f055b901da26cb869803f5a907268ea2ace768659",
      "skos:note": "Court must notify Secretary of Department administered by Minister administering Australian Passports Act 2005 of order",
      "dc:description": "copy of the order"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-22-ss-4",
      "@type": "cof:Section",
      "cof:title": "22(4) Conditions etc. that a court may impose on certain offenders",
      "values:kind": "subsection",
      "cof:pageNumber": 336,
      "values:originalText": "(4) If the court makes an order under subsection (1) or (3), the\nRegistrar or other appropriate officer of the court, as the case\nrequires, must, as soon as practicable, give to the Secretary of the\nDepartment administered by the Minister administering the\nAustralian Passports Act 2005 a copy of the order."
    },
    {
      "@id": "concept:crimes-act-1914-sec-22-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-22-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-22-ss-4-logic-deontic-1",
