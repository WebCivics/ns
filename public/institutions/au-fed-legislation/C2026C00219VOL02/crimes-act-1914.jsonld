      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(f) subject to subsections (3) and (3A), fixing a non-parole period...",
      "cml:conclusionText": "...fixing a non-parole period in respect of the outstanding sentence or sentences."
    },
