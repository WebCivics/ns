    },
    {
      "@id": "concept:crimes-act-1914-sec-19ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AK Possible deportation no impediment to fixing non-parole",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ak"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.253",
      "values:originalText": "period\n\nWhere a person is convicted of a federal offence, a court is not\nprecluded from fixing a non-parole period in respect of the\nsentence imposed for that offence merely because the person is, or\nmay be, liable to be deported from Australia.",
      "skos:definition": "period\n\nWhere a person is convicted of a federal offence, a court is not\nprecluded from fixing a non-parole period in respect of the\nsentence imposed for that offence merely because the person is, or\nmay be, liable to be deported from Australia.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19ak-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ak-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a7c2d38642de56031961dde63291b2b5e6a0f846d129682a37c56b6d618d9041",
      "skos:note": "Court may fix non-parole period despite deportation risk"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ak",
      "@type": "cof:Section",
      "cof:title": "19AK Possible deportation no impediment to fixing non-parole",
      "values:kind": "section",
      "cof:pageNumber": 253,
      "values:originalText": "period\n\nWhere a person is convicted of a federal offence, a court is not\nprecluded from fixing a non-parole period in respect of the\nsentence imposed for that offence merely because the person is, or\nmay be, liable to be deported from Australia."
    },
