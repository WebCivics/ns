        }
      ],
      "cml:integrityHash": "5e0b1fb50b2d275bad5186fe94d2e430aa5a6feffa8df32939e83583a7301974",
      "skos:note": "Investigating official must complete a form and forward it to the magistrate.",
      "dc:description": "a form of the instrument with the name of the magistrate and particulars given by him or her"
    },
