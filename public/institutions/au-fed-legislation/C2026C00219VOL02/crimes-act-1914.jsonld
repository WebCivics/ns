      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal interval for court closure",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(7) Unless the court considers that the interests of justice require otherwise...",
