    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19aq-ss-4",
      "@type": "cof:Section",
      "cof:title": "19AQ(4) Parole order or licence revoked following further offence",
      "values:kind": "subsection",
      "cof:pageNumber": 265,
      "values:originalText": "(4) If the parole order or licence relating to a person is taken to have\nbeen revoked under subsection (1) or (2), the person becomes\nliable to serve:"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19aq-ss-4-norm",
      "@type": "values:Obligation",
