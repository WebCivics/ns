      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to review detention",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
