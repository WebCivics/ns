      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bt-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to order release on conditions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Reports recommend continued hospital treatment or a federal sentence remains.",
      "cml:conclusionText": "The Attorney-General must order release on conditions."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bt-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BT(3) Lesser periods of imprisonment fixed under hospital orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bt-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.322",
      "values:originalText": "(3) Sections 20BM and 20BN apply in relation to a person released\nfrom involuntary hospitalisation by order under subsection (2) as\nif:\n\n(a) the order under that subsection were a release order made\nunder subsection 20BL(1); and\n\n(b) the references in each of those sections to detention in a\nprison or a hospital were references only to detention in a\nhospital; and\n\n(c) the reference in subsection 20BM(5) to the period of\ndetention in safe custody under subsection 20BJ(1) were a\nreference to the period of detention in a hospital specified in\nthe order under subsection 20BS(1).",
      "skos:definition": "(3) Sections 20BM and 20BN apply in relation to a person released\nfrom involuntary hospitalisation by order under subsection (2) as\nif:\n\n(a) the order under that subsection were a release order made\nunder subsection 20BL(1); and\n\n(b) the references in each of those sections to detention in a\nprison or a hospital were references only to detention in a\nhospital; and\n\n(c) the reference in subsection 20BM(5) to the period of\ndetention in safe custody under subsection 20BJ(1) were a\nreference to the period of detention in a hospital specified in\nthe order under subsection 20BS(1).",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-20bt"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20bt-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-deontic-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "bc9902e4c6702de7ac2fd3b2ba059c303ed5376de8d77d4f86278e6791cf136a",
      "skos:note": "Sections 20BM and 20BN apply in relation to a person released from involuntary hospitalisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bt-ss-3",
      "@type": "cof:Section",
      "cof:title": "20BT(3) Lesser periods of imprisonment fixed under hospital orders",
      "values:kind": "subsection",
      "cof:pageNumber": 322,
      "values:originalText": "(3) Sections 20BM and 20BN apply in relation to a person released\nfrom involuntary hospitalisation by order under subsection (2) as\nif:\n\n(a) the order under that subsection were a release order made\nunder subsection 20BL(1); and\n\n(b) the references in each of those sections to detention in a\nprison or a hospital were references only to detention in a\nhospital; and\n\n(c) the reference in subsection 20BM(5) to the period of\ndetention in safe custody under subsection 20BJ(1) were a\nreference to the period of detention in a hospital specified in\nthe order under subsection 20BS(1)."
    },
