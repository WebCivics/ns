    {
      "@id": "concept:crimes-act-1914-sec-23e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23E(2) Evidentiary provisions if application made by electronic means",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23e-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
