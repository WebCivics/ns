      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Court must allow witness to give evidence by video link.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
