    {
      "@id": "concept:crimes-act-1914-sec-15jq-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "15JQ(4) Integrity testing operations—disclosure",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jq-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.98",
      "values:originalText": "(4) Subsection (1) does not apply if the person discloses the\ninformation to an IGIS official for the purpose of the IGIS official\nexercising a power, or performing a function or duty, as an IGIS\nofficial.\nNote:\nA defendant, except for an IGIS official, bears an evidential burden in\nrelation to a matter in this subsection (see subsection 13.3(3) of the\nCriminal Code). For IGIS officials, see section 34C of the\nInspector-General of Intelligence and Security Act 1986.",
      "skos:definition": "(4) Subsection (1) does not apply if the person discloses the\ninformation to an IGIS official for the purpose of the IGIS official\nexercising a power, or performing a function or duty, as an IGIS\nofficial.\nNote:\nA defendant, except for an IGIS official, bears an evidential burden in\nrelation to a matter in this subsection (see subsection 13.3(3) of the\nCriminal Code). For IGIS officials, see section 34C of the\nInspector-General of Intelligence and Security Act 1986.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15jq"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15jq-ss-4-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jq-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15jq-ss-4-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "672a70ed045550909e0fb1e5c7766f4564f086bbbea3917dd9bbf7d5bfcfd263",
      "skos:note": "Disclosure of information to IGIS official for exercising power or performing duty is exempt from subsection (1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jq-ss-4",
      "@type": "cof:Section",
      "cof:title": "15JQ(4) Integrity testing operations—disclosure",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(4) Subsection (1) does not apply if the person discloses the\ninformation to an IGIS official for the purpose of the IGIS official\nexercising a power, or performing a function or duty, as an IGIS\nofficial.\nNote:\nA defendant, except for an IGIS official, bears an evidential burden in\nrelation to a matter in this subsection (see subsection 13.3(3) of the\nCriminal Code). For IGIS officials, see section 34C of the\nInspector-General of Intelligence and Security Act 1986."
    },
