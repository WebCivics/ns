          "@id": "concept:crimes-act-1914-sec-19ar-ss-4"
        }
      ],
      "cml:integrityHash": "14e36d89762fdd829b2a68152550cc2b330f917dbf417de7058016b10d4334f8"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ar",
