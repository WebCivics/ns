          "@id": "concept:crimes-act-1914-sec-15hq-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5e71f743956c87c39548a68fd69fcdad81c16ec49339c9628f6c1b8aebd39855",
      "skos:note": "Chief officer must cause a general register to be kept."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15hq-ss-1",
      "@type": "cof:Section",
      "cof:title": "15HQ(1) General register",
      "values:kind": "subsection",
      "cof:pageNumber": 72,
      "values:originalText": "(1) The chief officer of each authorising agency must cause a general\nregister to be kept."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hq-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
