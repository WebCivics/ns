          "@id": "concept:crimes-act-1914-sec-16c-ss-2-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "8014ea533b59f647ab484c84162d4e5f0851337f20c66bd1d59b72a11b2ecad2",
      "skos:note": "Court may impose fine regardless of offender's financial circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-16c-ss-2",
      "@type": "cof:Section",
      "cof:title": "16C(2) Fines",
      "values:kind": "subsection",
