    {
      "@id": "concept:crimes-act-1914-sec-15ka-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KA(4) Application for authority to acquire or use assumed identity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ka-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
