      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mb-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:logicSummary": "Holds true",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a charge against a person for an offence is outstanding until the charge is finally dealt with in any of the following ways:",
      "cml:conclusionText": "The charge is outstanding."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mb-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:logicSummary": "Holds true",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) a charge against a person for an offence is pending if the person has not yet been charged with the offence, but:",
      "cml:conclusionText": "The charge is pending."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mb-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:logicSummary": "Holds true",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) an allegation of professional misconduct against a person is outstanding if the allegation has not been finally dealt with in accordance with the procedures that apply for the purposes of dealing with an allegation of that kind.",
      "cml:conclusionText": "The allegation is outstanding."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mb-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "Defines a term with a specific meaning.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) In this Part, civil proceeding means any proceeding in a court of the Commonwealth, a State or Territory, other than a criminal proceeding.",
      "cml:conclusionText": "civil proceeding"
    },
