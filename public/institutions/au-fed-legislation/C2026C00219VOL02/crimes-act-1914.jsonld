    {
      "@id": "concept:crimes-act-1914-sec-15mj-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MJ(6) Effect of witness identity protection certificate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15mj-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.152",
      "values:originalText": "(6) A person commits an offence if:\n\n(a) an order has been made under subsection (1), (4) or (5); and\n\n(b) the person engages in conduct; and\n\n\nPart IACA  Witness identity protection for operatives",
      "skos:definition": "(6) A person commits an offence if:\n\n(a) an order has been made under subsection (1), (4) or (5); and\n\n(b) the person engages in conduct; and\n\n\nPart IACA  Witness identity protection for operatives",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15mj"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15mj-ss-6-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15mj-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c507ded8c7716c8262d2270e5b5362536f08d79eb5a968a58bd3740ebae1ae77",
      "skos:note": "Engaging in conduct after an order is made under subsection (1), (4) or (5)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15mj-ss-6",
      "@type": "cof:Section",
      "cof:title": "15MJ(6) Effect of witness identity protection certificate",
      "values:kind": "subsection",
      "cof:pageNumber": 152,
      "values:originalText": "(6) A person commits an offence if:\n\n(a) an order has been made under subsection (1), (4) or (5); and\n\n(b) the person engages in conduct; and\n\n\nPart IACA  Witness identity protection for operatives"
    },
    {
