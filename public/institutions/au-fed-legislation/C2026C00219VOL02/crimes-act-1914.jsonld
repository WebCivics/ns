      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23t",
      "@type": "cml:Concept",
      "skos:prefLabel": "23T Acts authorised under other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.373",
      "values:originalText": "Nothing in this Part prevents an investigating official from asking\nor causing a person to do a particular thing that the official is\nauthorised to ask or cause the person to do under:\n\n(a) another law of the Commonwealth; or\n\n(b) a provision of a law of the Australian Capital Territory.",
      "skos:definition": "Nothing in this Part prevents an investigating official from asking\nor causing a person to do a particular thing that the official is\nauthorised to ask or cause the person to do under:\n\n(a) another law of the Commonwealth; or\n\n(b) a provision of a law of the Australian Capital Territory.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23t-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23t-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cc45744519fe7e5e20b2ff35ffc3358d3d0067987f07bf73017ebff15d6fd263",
      "skos:note": "An investigating official can ask or cause a person to do something under another law."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23t",
      "@type": "cof:Section",
      "cof:title": "23T Acts authorised under other laws",
      "values:kind": "section",
      "cof:pageNumber": 373,
      "values:originalText": "Nothing in this Part prevents an investigating official from asking\nor causing a person to do a particular thing that the official is\nauthorised to ask or cause the person to do under:\n\n(a) another law of the Commonwealth; or\n\n(b) a provision of a law of the Australian Capital Territory."
    },
