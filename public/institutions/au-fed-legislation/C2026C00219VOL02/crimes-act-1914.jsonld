    },
    {
      "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "apply",
      "cml:logicSummary": "Application of sections 20BM and 20BN to a person released from involuntary hospitalisation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
