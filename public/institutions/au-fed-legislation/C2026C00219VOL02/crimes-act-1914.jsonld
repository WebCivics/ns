      ],
      "cml:integrityHash": "9a4c550d2d304502f08b7378437d2d77214857dd4907b2c9cb18ec293df91acd",
      "skos:note": "Witness must provide evidence if operative gives testimony and there is a jury in the proceeding.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15mo-ss-1",
      "@type": "cof:Section",
      "cof:title": "15MO(1) Directions to jury",
      "values:kind": "subsection",
      "cof:pageNumber": 157,
      "values:originalText": "(1) This section applies if:\n\n(a) a witness identity protection certificate for an operative in\nrelation to a proceeding is filed in a court; and\n\n(b) there is a jury in the proceeding; and\n\n(c) the operative gives evidence."
    },
