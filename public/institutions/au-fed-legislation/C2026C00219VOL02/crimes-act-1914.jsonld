      "cof:title": "15HX(2) Delegation by Ombudsman",
      "values:kind": "subsection",
      "cof:pageNumber": 80,
      "values:originalText": "(2) A delegate must, upon request by a person affected by the exercise\nof any power delegated to the delegate, produce the instrument of\ndelegation, or a copy of the instrument, for inspection by the\nperson."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15hx-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
