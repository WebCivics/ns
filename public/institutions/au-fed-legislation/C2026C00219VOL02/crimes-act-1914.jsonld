      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bp",
      "@type": "cml:Concept",
      "skos:prefLabel": "20BP State or Territory authorities to be notified of certain releases",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.318",
      "values:originalText": "Where a person detained by authority of an order under\nsubsection 20BJ(1) or a warrant under subsection 20BM(5) for a\nspecified period in a State or Territory is due to be released\nbecause the period of the person’s detention has ended, the\nAttorney-General must notify the mental health authorities of that\nState or Territory of the proposed release of the person.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nSummary disposition of persons suffering from mental illness or intellectual disability",
      "skos:definition": "Where a person detained by authority of an order under\nsubsection 20BJ(1) or a warrant under subsection 20BM(5) for a\nspecified period in a State or Territory is due to be released\nbecause the period of the person’s detention has ended, the\nAttorney-General must notify the mental health authorities of that\nState or Territory of the proposed release of the person.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nSummary disposition of persons suffering from mental illness or intellectual disability",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20bp-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20bp-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ca6b2cc282971e3117f9abb18dd8be7cb2e5efc589d66056553d134201e6d1bf",
      "skos:note": "Notify mental health authorities of proposed release"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bp",
      "@type": "cof:Section",
      "cof:title": "20BP State or Territory authorities to be notified of certain releases",
      "values:kind": "section",
      "cof:pageNumber": 318,
      "values:originalText": "Where a person detained by authority of an order under\nsubsection 20BJ(1) or a warrant under subsection 20BM(5) for a\nspecified period in a State or Territory is due to be released\nbecause the period of the person’s detention has ended, the\nAttorney-General must notify the mental health authorities of that\nState or Territory of the proposed release of the person.\n\n\nSentencing, imprisonment and release of federal offenders  Part IB\nSummary disposition of persons suffering from mental illness or intellectual disability"
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bp-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
