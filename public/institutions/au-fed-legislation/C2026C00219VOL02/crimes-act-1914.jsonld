    {
      "@id": "concept:crimes-act-1914-sec-20c",
      "@type": "cml:Concept",
      "skos:prefLabel": "20C Offences by children and young persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.334",
      "values:originalText": "A child or young person who, in a State or Territory, is charged\nwith or convicted of an offence against a law of the\nCommonwealth may be tried, punished or otherwise dealt with as\nif the offence were an offence against a law of the State or\nTerritory.",
      "skos:definition": "A child or young person who, in a State or Territory, is charged\nwith or convicted of an offence against a law of the\nCommonwealth may be tried, punished or otherwise dealt with as\nif the offence were an offence against a law of the State or\nTerritory.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-20c-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-20c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d8c71f585533ae861aa4bc6b20305f6345c722c0c11bd1f3b50bfc4d84ca3f73",
      "skos:note": "Child or young person charged with an offence may be tried and punished as if the offence were against a law of the State or Territory."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20c",
      "@type": "cof:Section",
      "cof:title": "20C Offences by children and young persons",
      "values:kind": "section",
      "cof:pageNumber": 334,
      "values:originalText": "A child or young person who, in a State or Territory, is charged\nwith or convicted of an offence against a law of the\nCommonwealth may be tried, punished or otherwise dealt with as\nif the offence were an offence against a law of the State or\nTerritory."
    },
    {
