      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.174",
      "values:originalText": "Evidence of a child witness’ or child complainant’s reputation with\nrespect to sexual activities is inadmissible in a child proceeding.",
      "skos:definition": "Evidence of a child witness’ or child complainant’s reputation with\nrespect to sexual activities is inadmissible in a child proceeding.",
