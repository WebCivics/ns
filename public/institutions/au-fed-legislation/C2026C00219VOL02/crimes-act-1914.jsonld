    {
      "@id": "concept:crimes-act-1914-sec-19av-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AV(3) Arrest of person whose parole order or licence revoked by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19av-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.272",
      "values:originalText": "(3) A person who is arrested under subsection (1) or (2), must, as soon\nas practicable after that arrest, be brought before a prescribed\nauthority in the State or Territory in which the person is arrested.\n19AW  Where person on parole or licence notified of revocation",
      "skos:definition": "(3) A person who is arrested under subsection (1) or (2), must, as soon\nas practicable after that arrest, be brought before a prescribed\nauthority in the State or Territory in which the person is arrested.\n19AW  Where person on parole or licence notified of revocation",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19av"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-3-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-3-logic-alleninterval-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-3-logic-ltl-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19av-ss-3-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "ae89e2eec77ae70abab389352e6f8f3d2cafbe7900395a521375f8cd10311b48",
      "skos:note": "Authority not required to fix non-parole period under certain conditions. Must be brought before a prescribed authority after arrest."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19av-ss-3",
      "@type": "cof:Section",
      "cof:title": "19AV(3) Arrest of person whose parole order or licence revoked by",
      "values:kind": "subsection",
      "cof:pageNumber": 272,
      "values:originalText": "(3) A person who is arrested under subsection (1) or (2), must, as soon\nas practicable after that arrest, be brought before a prescribed\nauthority in the State or Territory in which the person is arrested.\n19AW  Where person on parole or licence notified of revocation"
    },
    {
      "@id": "concept:crimes-act-1914-sec-19av-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-19av-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
