    {
      "@id": "concept:crimes-act-1914-sec-15yl-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15YL(3) Alternative arrangements for giving evidence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yl-ss-3"
      },
      "cml:curationStatus": {
