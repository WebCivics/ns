      ],
      "cml:integrityHash": "1a0efd35a78bd032602d1405fe0d359a1719ad6770c881722219a6be6c4620b7",
      "skos:note": "The operative must disclose their true identity to the presiding officer.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ml-ss-2",
      "@type": "cof:Section",
      "cof:title": "15ML(2) Disclosure of operative’s identity to presiding officer",
      "values:kind": "subsection",
      "cof:pageNumber": 154,
      "values:originalText": "(2) The presiding officer in the proceeding may require the operative\nto do one or both of the following:\n\n(a) to disclose the operative’s true identity to the presiding\nofficer;\n\n(b) to provide the presiding officer with photographic evidence\nof that identity."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ml-ss-2-norm",
