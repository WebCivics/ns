    },
    {
      "@id": "concept:crimes-act-1914-sec-15mo-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide evidence",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a witness identity protection certificate for an operative in relation to a proceeding is filed in a court; and (b) there is a jury in the proceeding; and (c) the operative gives evidence.",
      "cml:conclusionText": "The witness must provide evidence if the conditions are met."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mo-ss-1-logic-alleninterval-2",
