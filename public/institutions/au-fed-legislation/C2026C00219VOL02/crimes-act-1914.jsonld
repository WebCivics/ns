      "@type": "cml:Concept",
      "skos:prefLabel": "15MJ(1) Effect of witness identity protection certificate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15mj-ss-1"
      },
      "cml:curationStatus": {
