    {
      "@id": "concept:crimes-act-1914-sec-15mt",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MT Evidentiary certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15mt"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
