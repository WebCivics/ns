    {
      "@id": "concept:crimes-act-1914-sec-19aj",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AJ Court may only fix non-parole periods or make recognizance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19aj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.253",
      "values:originalText": "release orders for federal sentences of imprisonment\n\nThis Division does not authorise a court to fix a single non-parole\nperiod, or make a recognizance release order, in respect both of\nfederal sentences of imprisonment and State or Territory sentences\nof imprisonment.",
      "skos:definition": "release orders for federal sentences of imprisonment\n\nThis Division does not authorise a court to fix a single non-parole\nperiod, or make a recognizance release order, in respect both of\nfederal sentences of imprisonment and State or Territory sentences\nof imprisonment.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19aj-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19aj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f1f2aaa66cb59f1251768ee8be790aca386d344ab20c72184abcd2c2dc016a5d",
      "skos:note": "Court cannot fix non-parole periods or make recognizance release orders for federal sentences of imprisonment."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19aj",
      "@type": "cof:Section",
      "cof:title": "19AJ Court may only fix non-parole periods or make recognizance",
      "values:kind": "section",
      "cof:pageNumber": 253,
      "values:originalText": "release orders for federal sentences of imprisonment\n\nThis Division does not authorise a court to fix a single non-parole\nperiod, or make a recognizance release order, in respect both of\nfederal sentences of imprisonment and State or Territory sentences\nof imprisonment."
    },
    {
      "@id": "concept:crimes-act-1914-sec-19aj-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
