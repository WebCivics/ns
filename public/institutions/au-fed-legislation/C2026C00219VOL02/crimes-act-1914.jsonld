          "@id": "concept:crimes-act-1914-sec-15go-ss-5-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15go-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2395a7c8997e477e8229212dc692b41f5bc27fa6d12a9547c986290d0654abbd",
      "skos:note": "Authority variation must be justified by the authorising officer."
    },
    {
