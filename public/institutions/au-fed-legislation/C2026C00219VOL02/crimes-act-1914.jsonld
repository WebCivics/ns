      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yu-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Court must consider application",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yu-ss-5-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "SUBCLASS_OF",
      "cml:logicSummary": "Part IAE applies to proceedings for terrorism and related offences etc.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part IAE",
      "cml:conclusionText": "Proceedings for terrorism and related offences etc."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yu-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "15YU(1) Proceedings to which this Part applies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yu-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.202",
      "values:originalText": "(1) In a proceeding, the court must:\n\n(a) direct; or\n\n(b) by order, allow;\na witness to give evidence by video link if:\n\n(c) both:\n\n(i) the prosecutor applies for the direction or order; and\n\n(ii) the court is satisfied that the prosecutor gave the court\nreasonable notice of his or her intention to make the\napplication; and\n\n(d) the witness is not a defendant in the proceeding; and\n\n(e) the witness is available, or will reasonably be available, to\ngive evidence by video link; and\n\n(f) the facilities required by section 15YY are available or can\nreasonably be made available;\nunless the court is satisfied that giving the direction or making the\norder would have a substantial adverse effect on the right of a\ndefendant in the proceeding to receive a fair hearing.\nApplication by defendant",
      "skos:definition": "(1) In a proceeding, the court must:\n\n(a) direct; or\n\n(b) by order, allow;\na witness to give evidence by video link if:\n\n(c) both:\n\n(i) the prosecutor applies for the direction or order; and\n\n(ii) the court is satisfied that the prosecutor gave the court\nreasonable notice of his or her intention to make the\napplication; and\n\n(d) the witness is not a defendant in the proceeding; and\n\n(e) the witness is available, or will reasonably be available, to\ngive evidence by video link; and\n\n(f) the facilities required by section 15YY are available or can\nreasonably be made available;\nunless the court is satisfied that giving the direction or making the\norder would have a substantial adverse effect on the right of a\ndefendant in the proceeding to receive a fair hearing.\nApplication by defendant",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15yu"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15yu-ss-1-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15yu-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15yu-ss-1-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "62780883560f883efee960534844eeb45707af9543e5e9857dd9db0474e1d64c",
      "skos:note": "Court must allow witness to give evidence by video link under certain conditions. Proceedings for specified offences apply to this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yu-ss-1",
      "@type": "cof:Section",
      "cof:title": "15YU(1) Proceedings to which this Part applies",
      "values:kind": "subsection",
      "cof:pageNumber": 202,
      "values:originalText": "(1) In a proceeding, the court must:\n\n(a) direct; or\n\n(b) by order, allow;\na witness to give evidence by video link if:\n\n(c) both:\n\n(i) the prosecutor applies for the direction or order; and\n\n(ii) the court is satisfied that the prosecutor gave the court\nreasonable notice of his or her intention to make the\napplication; and\n\n(d) the witness is not a defendant in the proceeding; and\n\n(e) the witness is available, or will reasonably be available, to\ngive evidence by video link; and\n\n(f) the facilities required by section 15YY are available or can\nreasonably be made available;\nunless the court is satisfied that giving the direction or making the\norder would have a substantial adverse effect on the right of a\ndefendant in the proceeding to receive a fair hearing.\nApplication by defendant"
    },
