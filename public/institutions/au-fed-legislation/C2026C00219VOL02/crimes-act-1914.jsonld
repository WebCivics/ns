    {
      "@id": "concept:crimes-act-1914-sec-19ah",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AH Failure to fix non-parole period or make recognizance release",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ah"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.251",
      "values:originalText": "order\n\n(1) Where a court fails to fix, or properly to fix, a non-parole period, or\nto make, or properly to make, a recognizance release order, under\nthis Act:\n\n(a) that failure does not affect the validity of any sentence\nimposed on a person; and",
      "skos:definition": "order\n\n(1) Where a court fails to fix, or properly to fix, a non-parole period, or\nto make, or properly to make, a recognizance release order, under\nthis Act:\n\n(a) that failure does not affect the validity of any sentence\nimposed on a person; and",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-19ah-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-19ah-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9a2491bacbbb0f53d31b738f82a5cde3ccd37dce9c7f02a8e95d102fbde96edd",
      "skos:note": "Court must fix non-parole period or make recognizance release order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ah",
      "@type": "cof:Section",
      "cof:title": "19AH Failure to fix non-parole period or make recognizance release",
      "values:kind": "section",
      "cof:pageNumber": 251,
      "values:originalText": "order\n\n(1) Where a court fails to fix, or properly to fix, a non-parole period, or\nto make, or properly to make, a recognizance release order, under\nthis Act:\n\n(a) that failure does not affect the validity of any sentence\nimposed on a person; and"
    },
    {
