      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Constable must take person to prison.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
