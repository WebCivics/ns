      "cml:integrityHash": "37fcd95ea676d04866648cfbfc95fe945d22d85433b1c6ca96d3afeef06904a1",
      "skos:note": "Court must consider order made when dealing with person"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-20bx-ss-2",
