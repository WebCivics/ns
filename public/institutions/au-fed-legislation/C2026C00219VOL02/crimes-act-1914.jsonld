      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ml-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15ML(3) Disclosure of operative’s identity to presiding officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ml-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.154",
      "values:originalText": "(3) The presiding officer must not:\n\n(a) record information disclosed to the presiding officer under\nsubsection (2); or\n\n(b) retain or copy a document or other thing provided to the\npresiding officer under that subsection.",
      "skos:definition": "(3) The presiding officer must not:\n\n(a) record information disclosed to the presiding officer under\nsubsection (2); or\n\n(b) retain or copy a document or other thing provided to the\npresiding officer under that subsection.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-15ml"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15ml-ss-3-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15ml-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d1ae758b237e8415edacc150ae80c73b1019d41a97cc6610d49470398ba85873",
      "skos:note": "Presiding officer must not record or retain information disclosed under subsection (2)."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ml-ss-3",
      "@type": "cof:Section",
      "cof:title": "15ML(3) Disclosure of operative’s identity to presiding officer",
      "values:kind": "subsection",
      "cof:pageNumber": 154,
      "values:originalText": "(3) The presiding officer must not:\n\n(a) record information disclosed to the presiding officer under\nsubsection (2); or\n\n(b) retain or copy a document or other thing provided to the\npresiding officer under that subsection."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15ml-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
