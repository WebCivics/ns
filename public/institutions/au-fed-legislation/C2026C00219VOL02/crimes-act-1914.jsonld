      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-15mm-ss-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
