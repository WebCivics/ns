        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The references in each of those sections to detention in a prison or a hospital were references only to detention in a hospital.",
      "cml:conclusionText": "Sections 20BM and 20BN apply to the person."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bt-ss-3-logic-deontic-5",
