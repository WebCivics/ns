      "skos:note": "Supersedes recognizance release order if non-parole period applies"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19ag-ss-4",
      "@type": "cof:Section",
      "cof:title": "19AG(4) Non-parole periods for sentences for certain offences",
