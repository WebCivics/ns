    {
      "@id": "concept:crimes-act-1914-sec-20bk-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Attorney-General has an obligation to consider reports and representations.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General is responsible for making decisions about custody releases.",
      "cml:conclusionText": "The Attorney-General must obtain and consider relevant reports."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bk-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Attorney-General has an obligation to take into account representations made by the person or on their behalf.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General is responsible for making decisions about custody releases.",
      "cml:conclusionText": "The Attorney-General must consider any representations made to them."
    },
    {
      "@id": "concept:crimes-act-1914-sec-20bk-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Attorney-General must consider reports within a certain timeframe.",
