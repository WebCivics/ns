    {
      "@id": "concept:crimes-act-1914-sec-15ka-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KA(3A) Application for authority to acquire or use assumed identity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ka-ss-3a"
      },
      "cml:curationStatus": {
