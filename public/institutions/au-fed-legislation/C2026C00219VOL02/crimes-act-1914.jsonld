      "skos:note": "Request for evidence of assumed identity must include specific details.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15ki-ss-4",
      "@type": "cof:Section",
      "cof:title": "15KI(4) Request for evidence of assumed identity",
      "values:kind": "subsection",
