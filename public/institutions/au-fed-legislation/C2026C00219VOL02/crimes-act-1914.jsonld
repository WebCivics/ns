    {
      "@id": "concept:crimes-act-1914-sec-19aq-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "19AQ(3) Parole order or licence revoked following further offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-19aq-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
