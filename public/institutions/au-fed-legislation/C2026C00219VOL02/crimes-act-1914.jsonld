    },
    {
      "@id": "concept:crimes-act-1914-sec-15kp",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KP Assumed identity may be acquired and used",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15kp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.124",
      "values:originalText": "A person may acquire or use an assumed identity if:\n\n(a) the person is an authorised person (other than an authorised\ncivilian) and the acquisition or use is:\n\n(i) in accordance with an authority; and\n\n(ii) in the course of duty; or\n\n(b) the person is an authorised civilian and the acquisition or use\nis in accordance with:\n\n(i) an authority; and\n\n(ii) any direction by the person’s supervisor under the\nauthority.",
      "skos:definition": "A person may acquire or use an assumed identity if:\n\n(a) the person is an authorised person (other than an authorised\ncivilian) and the acquisition or use is:\n\n(i) in accordance with an authority; and\n\n(ii) in the course of duty; or\n\n(b) the person is an authorised civilian and the acquisition or use\nis in accordance with:\n\n(i) an authority; and\n\n(ii) any direction by the person’s supervisor under the\nauthority.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-15kp-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15kp-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15kp-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-15kp-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "982e3874023514b909151d45cac77bd534de6740dfb848d0a2afbb202cd80e0f",
      "skos:note": "Acquiring or using an assumed identity is permitted under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15kp",
      "@type": "cof:Section",
      "cof:title": "15KP Assumed identity may be acquired and used",
      "values:kind": "section",
      "cof:pageNumber": 124,
      "values:originalText": "A person may acquire or use an assumed identity if:\n\n(a) the person is an authorised person (other than an authorised\ncivilian) and the acquisition or use is:\n\n(i) in accordance with an authority; and\n\n(ii) in the course of duty; or\n\n(b) the person is an authorised civilian and the acquisition or use\nis in accordance with:\n\n(i) an authority; and\n\n(ii) any direction by the person’s supervisor under the\nauthority."
    },
    {
