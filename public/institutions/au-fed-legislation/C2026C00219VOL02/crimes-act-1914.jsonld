    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15yc-ss-1",
      "@type": "cof:Section",
      "cof:title": "15YC(1) Evidence of sexual experience—child proceedings",
      "values:kind": "subsection",
      "cof:pageNumber": 174,
      "values:originalText": "(1) Evidence of a vulnerable adult complainant’s experience with\nrespect to sexual activities is inadmissible in a vulnerable adult\nproceeding, unless the court gives leave."
    },
    {
      "@id": "concept:crimes-act-1914-sec-15yc-ss-1-norm",
