      "skos:note": "Cancellation of integrity testing authority takes effect at specified time."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-15jl-ss-3",
      "@type": "cof:Section",
      "cof:title": "15JL(3) Integrity testing authorities—cancellation",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(3) Cancellation of an integrity testing authority takes effect at the time\nthe order is made or at a later time stated in the order."
    },
    {
