    {
      "@id": "concept:crimes-act-1914-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Sentence of imprisonment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.241",
      "values:originalText": "(1) Where imprisonment is imposed in respect of any offence against\nany law of the Commonwealth it may (unless the contrary intention\nappears in the law) be imposed either with or without hard labour.\n\n(2) Where under the law of a State or Territory a convicted person may\nin particular cases be imprisoned in a particular kind or class of\nprison, a person convicted of an offence against the law of the\nCommonwealth may, in corresponding cases, be imprisoned in the\nkind or class of prison appropriate to the circumstances.",
      "skos:definition": "(1) Where imprisonment is imposed in respect of any offence against\nany law of the Commonwealth it may (unless the contrary intention\nappears in the law) be imposed either with or without hard labour.\n\n(2) Where under the law of a State or Territory a convicted person may\nin particular cases be imprisoned in a particular kind or class of\nprison, a person convicted of an offence against the law of the\nCommonwealth may, in corresponding cases, be imprisoned in the\nkind or class of prison appropriate to the circumstances.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-18-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-18-ss-2"
        }
      ],
      "cml:integrityHash": "ef1c3383f0c6025b78435a6ec3bd8528468ed25d430824156416dc2c45094b91"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Sentence of imprisonment",
      "values:kind": "section",
      "cof:pageNumber": 241,
      "values:originalText": "(1) Where imprisonment is imposed in respect of any offence against\nany law of the Commonwealth it may (unless the contrary intention\nappears in the law) be imposed either with or without hard labour.\n\n(2) Where under the law of a State or Territory a convicted person may\nin particular cases be imprisoned in a particular kind or class of\nprison, a person convicted of an offence against the law of the\nCommonwealth may, in corresponding cases, be imprisoned in the\nkind or class of prison appropriate to the circumstances."
    },
