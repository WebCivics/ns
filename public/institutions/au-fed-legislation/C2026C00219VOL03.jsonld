      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.68",
      "skos:note": "Forensic procedures must be carried out by a person of the same sex as the suspect.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "23XN(1) Certain forensic procedures generally to be carried out by"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-23xn-ss-1-norm",
        "concept:crimes-act-1914-sec-23xn-ss-1-logic-deontic-1"
