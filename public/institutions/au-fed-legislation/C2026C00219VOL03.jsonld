      },
      "realizedBy": "doc:crimes-act-1914#sec-23wm-ss-2a",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-act-1914-sec-23wm"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wm-ss-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of carrying out forensic procedure on suspect from foreign country or international tribunal.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(2A) This Division does not authorise the carrying out of a forensic procedure on a suspect if the procedure has been requested by:  (a) a foreign country or international tribunal; or  (b) a foreign law enforcement agency."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wm-ss-2a-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Prohibition of carrying out forensic procedure on suspect from foreign country or international tribunal is absolute and unconditional.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(2A) This Division does not authorise the carrying out of a forensic procedure on a suspect if the procedure has been requested by:  (a) a foreign country or international tribunal; or  (b) a foreign law enforcement agency."
    },
