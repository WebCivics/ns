    {
      "@id": "concept:crimes-act-1914-sec-23zf-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is entitled to compensation for the forfeited electronic equipment during the period of ownership.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "During the period of ownership",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(b) the person owned, had a right to possess or had other property in the thing immediately before the forfeiture."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zf-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person owned, had a right to possess or had other property in the thing immediately before the forfeiture.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has right to compensation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRightTo",
      "cml:premiseText": "(a) a thing that is a computer, data storage device or other electronic equipment is forfeited under this Part;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zf-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The state has a duty to provide compensation to the person for the forfeited electronic equipment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has duty to provide compensation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasDutyTo",
      "cml:premiseText": "(b) the person owned, had a right to possess or had other property in the thing immediately before the forfeiture."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zf-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The state has permission to provide compensation to the person for the forfeited electronic equipment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has permission to provide compensation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasPermissionTo",
      "cml:premiseText": "(b) the person owned, had a right to possess or had other property in the thing immediately before the forfeiture."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zf-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is entitled to compensation for the forfeited electronic equipment everywhere they own or had a right to possess it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Everywhere the person owns or had a right to possess the thing",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "(a) a thing that is a computer, data storage device or other electronic equipment is forfeited under this Part;"
