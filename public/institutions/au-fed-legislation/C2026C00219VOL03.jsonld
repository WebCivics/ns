        "concept:crimes-act-1914-sec-23wt-ss-1-logic-deontic-4",
        "concept:crimes-act-1914-sec-23wt-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
