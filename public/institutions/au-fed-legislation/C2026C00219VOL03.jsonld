      "cml:logicSummary": "Identifies overlapping intervals",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(3) An interview friend unreasonably interferes with or obstructs the carrying out of the procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exclusion of an interview friend is prohibited.",
