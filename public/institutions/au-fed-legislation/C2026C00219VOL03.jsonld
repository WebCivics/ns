      "cml:premiseText": "employee includes any person whose usual occupation is as an employee"
    },
    {
      "@id": "concept:crimes-act-1914-sec-30j-ss-3-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "lock-out includes the total or partial refusal of employers, acting in combination, to give work, if the refusal is unreasonable",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
