    {
      "@id": "concept:crimes-act-1914-sec-37-ss-3",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.157",
      "skos:note": "Committing an offence if inducing false testimony in a judicial proceeding.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "37(3) Corruption of witnesses"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
