    {
      "@id": "concept:crimes-act-1914-sec-37-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.157",
      "skos:note": "Giving or receiving property to influence a witness in a judicial proceeding is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "37(1) Corruption of witnesses"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-37-ss-1-norm",
        "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-1",
        "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-2",
        "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-3",
        "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-4",
        "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "6d1fa49c4bf279cc54e7a4aa01672d242c1a2cb13e9f17a2e943738bb25ce053",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-act-1914#sec-37-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-act-1914-sec-37"
    },
    {
      "@id": "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of influencing a witness in a judicial proceeding.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the first person does so upon an agreement or understanding that any person called, or to be called, as a witness in a judicial proceeding will: (i) give false testimony; or (ii) withhold true testimony;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of receiving property to influence a witness in a judicial proceeding.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(iii) asks for, receives or obtains any property, or benefit, of any kind for himself or herself or another person;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of promising to give or confer property to influence a witness in a judicial proceeding.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(ii) promises or offers to give, to confer, to procure or to attempt to procure any property, or benefit, of any kind to, upon or for another person;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of agreeing to receive property to influence a witness in a judicial proceeding.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(iv) agrees to receive or to obtain any property, or benefit, of any kind for himself or herself or another person;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-37-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of giving property to influence a witness in a judicial proceeding.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(i) gives, confers or procures any property, or benefit, of any kind to, upon or for another person;"
    },
