    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval for presence is during the forensic procedure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for presence requirement.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:premiseText": "(2) Either an interview friend or a legal representative (if he or she is not the interview friend) of the suspect must be present while the forensic procedure is carried out."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The presence of an individual is justified by their role in the forensic procedure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Rational justification for presence requirement.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(2) Either an interview friend or a legal representative (if he or she is not the interview friend) of the suspect must be present while the forensic procedure is carried out."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-2-logic-deontic-1",
