    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.112",
      "skos:note": "Offence of recording or retaining identifying information from forensic material without destruction.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "6(1) Section 6"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-6-2-ss-1-norm",
        "concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-1",
        "concept:crimes-act-1914-sec-6-2-ss-1-logic-alleninterval-2",
        "concept:crimes-act-1914-sec-6-2-ss-1-logic-ltl-3",
        "concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "44323b9e730c9ae6786c8e4996b366ea2d8842df71b83a5687738342b009c0c4",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-act-1914#sec-6-2-ss-1",
