      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "lock-out includes the closing of a place or part of a place of employment, if the closing is unreasonable"
    },
    {
      "@id": "concept:crimes-act-1914-sec-30j-ss-3-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "lock-out includes the total or partial suspension of work by an employer, if the suspension is unreasonable",
