    },
    {
      "@id": "concept:crimes-act-1914-sec-46-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Aiding prisoner to escape is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits aiding prisoner to escape.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person aids the prisoner:  (i) to escape from that detention; or  (ii) to attempt to escape from that detention; and  (c) the prisoner escapes, or attempts to escape, from that detention;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-46-norm",
      "@type": "doc:Prohibition",
      "skos:scopeNote": "borne by: State",
