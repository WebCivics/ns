      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the person must have entered into an agreement with one or more other persons;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
