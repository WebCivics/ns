      "cml:logicSummary": "Prohibits excluding an interview friend from a forensic procedure.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(4) An interview friend (other than a legal representative) of the suspect may be excluded..."
    },
