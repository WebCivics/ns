      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the person and at least one other party to the agreement must have intended that a person be charged falsely with an offence pursuant to the agreement;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
