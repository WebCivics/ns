    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The interval of interference overlaps with the procedure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
