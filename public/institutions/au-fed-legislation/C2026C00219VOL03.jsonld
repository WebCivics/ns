      "partOf": "concept:crimes-act-1914-sec-6-2"
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The destruction of forensic material overlaps with the recording or retention of identifying information.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits recording or retaining identifying information from forensic material without destruction.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "There is an obligation to destroy forensic material before recording or retaining identifying information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The destruction of forensic material is a prerequisite for recording or retention of identifying information.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;"
    },
