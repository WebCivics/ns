      "@id": "concept:crimes-act-1914-sec-46",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.165",
      "skos:note": "Aiding prisoner to escape is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "46 Aiding prisoner to escape"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
        "concept:crimes-act-1914-sec-46-norm",
        "concept:crimes-act-1914-sec-46-logic-deontic-1"
