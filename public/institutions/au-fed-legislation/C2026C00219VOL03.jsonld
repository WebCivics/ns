    {
      "@id": "concept:crimes-act-1914-sec-23wt-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.48",
      "skos:note": "Magistrate must be satisfied on the balance of probabilities that certain conditions are met before ordering a forensic procedure.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "23WT(1) Matters to be considered by magistrate before ordering"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
