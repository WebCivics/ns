    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits reckless matching of DNA profiles.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person’s conduct causes the matching that is not permitted by this Part of a DNA profile..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits reckless conduct.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) the person is reckless as to any such matching of profiles."
    },
    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Offence if not removed",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must ensure removal",
