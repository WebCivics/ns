      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.44",
      "skos:note": "Carrying out of forensic procedure on suspect from foreign country or international tribunal is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "23WM(2A) Non-intimate forensic procedure may be carried out by"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
