    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.191",
      "skos:note": "A person wrongly convicted of a Commonwealth offence is taken for all purposes as never having been convicted.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "85ZR(1) Pardons for persons wrongly convicted"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
