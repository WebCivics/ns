      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.163",
      "skos:note": "Attempting to obstruct or pervert justice is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "43(1) Attempting to pervert justice"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
