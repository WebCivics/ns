    {
      "@id": "concept:crimes-act-1914-sec-89-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Trespassing is prohibited",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits trespassing",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(1) A person who, without lawful excuse (proof whereof shall lie upon him or her), trespasses or goes upon any prohibited Commonwealth land commits an offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-89-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to not trespass",
