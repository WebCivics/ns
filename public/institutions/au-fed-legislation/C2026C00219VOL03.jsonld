      },
      "cml:operator": "requires",
      "cml:premiseText": "(2) For a person to be guilty of an offence against subsection (1):"
    },
    {
      "@id": "concept:crimes-act-1914-sec-41-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the person or at least one other party to the agreement must have committed an overt act pursuant to the agreement;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
