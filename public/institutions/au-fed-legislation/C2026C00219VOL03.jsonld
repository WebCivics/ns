      "cml:logicSummary": "Prohibits excluding interview friends",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(3) An interview friend (other than a legal representative) of the suspect may be excluded from the place where the forensic procedure is being carried out..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The interference or obstruction is prohibited.",
      "cml:confidence": {
