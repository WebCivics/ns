        "concept:crimes-act-1914-sec-6-2-ss-2-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": [
        "17b89d565100303192055c39266f05eb7af22a659cf929284c02e9f43f27ea92",
