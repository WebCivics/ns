      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the overt act must have occurred during the time the agreement was in effect;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
