      "cml:logicSummary": "Defendant bears evidential burden.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Subsection (1) does not apply if the judge or magistrate has a reasonable excuse."
    },
    {
      "@id": "concept:crimes-act-1914-sec-34-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The judge or magistrate must provide a reasonable excuse for not applying subsection (1).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Judge or magistrate must provide reason for not applying subsection (1).",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(2) Subsection (1) does not apply if the judge or magistrate has a reasonable excuse."
    },
    {
      "@id": "concept:crimes-act-1914-sec-34-ss-2-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The judge or magistrate believes that they have a reasonable excuse for not applying subsection (1).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Judge or magistrate believes in reasonable excuse.",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Belief",
      "cml:premiseText": "(2) Subsection (1) does not apply if the judge or magistrate has a reasonable excuse."
    },
    {
      "@id": "concept:crimes-act-1914-sec-34-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The reasonable excuse is an interval of time during which the judge or magistrate believes that they have a valid reason for not applying subsection (1).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Reasonable excuse is an interval of belief.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Interval",
      "cml:premiseText": "(2) Subsection (1) does not apply if the judge or magistrate has a reasonable excuse."
    },
