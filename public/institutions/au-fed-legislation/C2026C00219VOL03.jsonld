      "cml:logicSummary": "Prohibits carrying out forensic procedures in certain circumstances.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Forensic procedure must be carried out in circumstances affording reasonable privacy to the suspect."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xi-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Must not be carried out while the suspect is being questioned as defined in subsection 23B(6).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
