        "concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-4",
        "concept:crimes-act-1914-sec-85zr-ss-1-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "c906a22f58b520f675dd2a7756be8b90fbf486c9e95cf9c0ce95aed690959006",
