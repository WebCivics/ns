    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Despite any other Commonwealth law or State law, where a person has been granted a free and absolute pardon for a Commonwealth offence...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Specifies the temporal interval during which the person is treated as never having been convicted.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The pardon is granted despite any other Commonwealth law or State law."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the person shall be taken for all purposes as never having been convicted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Supports the argument that the person should be treated as never having been convicted.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The pardon is granted despite any other Commonwealth law or State law."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person shall be taken for all purposes as never having been convicted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the State to treat the person as never having been convicted.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The State is required to grant pardons for wrongful convictions."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Despite any other Commonwealth law or State law, where a person has been granted a free and absolute pardon...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Grants permission to treat the person as never having been convicted.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "The State is required to grant pardons for wrongful convictions."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Indicates that the person is treated as never having been convicted repeatedly.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:premiseText": "The person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence."
    },
