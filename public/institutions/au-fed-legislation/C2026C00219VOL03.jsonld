      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Presence of interview friend or legal representative is required.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(2) Either an interview friend or a legal representative (if he or she is not the interview friend) of the suspect must be present while the forensic procedure is carried out."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The spread of the presence requirement is to all individuals involved in the forensic procedure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
