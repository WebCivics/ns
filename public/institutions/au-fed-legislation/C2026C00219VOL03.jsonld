      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A person who, without lawful excuse (proof whereof shall lie upon him or her), trespasses or goes upon any prohibited Commonwealth land commits an offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-89-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The penalty is a consequence of trespassing",
