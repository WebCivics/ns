    {
      "@id": "concept:crimes-act-1914-sec-6-2-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-act-1914.pdf, p.112",
      "skos:note": "Reckless matching of DNA profiles is prohibited. Ensure removal of identifying information from DNA database system after end of identifying period.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "6(2) Section 6"
      },
      "wasDerivedFrom": "crimes-act-1914.pdf",
      "asserts": [
