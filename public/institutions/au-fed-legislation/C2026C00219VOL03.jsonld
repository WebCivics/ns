      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Australia Post means the Australian Postal Corporation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "article in the course of post means an article that is being carried by post, and includes an article that has been collected or received by Australia Post for carriage by post"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "employee means a person who performs services for or on behalf of Australia Post.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "employee, in relation to Australia Post, includes a person who performs services for or on behalf of Australia Post and an employee of such a person"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "postal message means a material record of an unwritten communication.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "mail-bag includes a package, parcel, container or wrapper belonging to Australia Post in which articles in the course of post are customarily contained"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "postal message is a material record of an unwritten communication.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "postal message means:  (a) a material record of an unwritten communication:  (i) carried by post; or  (ii) collected or received by Australia Post for carriage by post;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "postal message is a material record issued by Australia Post.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "postal message means:  (b) a material record issued by Australia Post as a record of an unwritten communication:  (i) carried by post; or  (ii) collected or received by Australia Post for carriage by post."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-7",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Australia Post means the Australian Postal Corporation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "carried by post means carried by or through Australia Post."
    },
