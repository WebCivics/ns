    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits carrying out forensic procedures in certain circumstances." ;
    cml:premiseText "Forensic procedure must be carried out in circumstances affording reasonable privacy to the suspect." ;
    cml:conclusionText "Must not be carried out in the presence or view of a person who is of the opposite sex to the suspect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

