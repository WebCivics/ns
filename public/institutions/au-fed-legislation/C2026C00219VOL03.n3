concept:crimes-act-1914-sec-23xq-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Presence of interview friend or legal representative is required." ;
    cml:premiseText "(2) Either an interview friend or a legal representative (if he or she is not the interview friend) of the suspect must be present while the forensic procedure is carried out." ;
    cml:conclusionText "Either an interview friend or a legal representative must be present." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

