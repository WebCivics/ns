    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-85zr-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-85zr-ss-1 cml:asserts concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-1 .
concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes a duty on the State to treat the person as never having been convicted." ;
    cml:premiseText "The State is required to grant pardons for wrongful convictions." ;
    cml:conclusionText "The person shall be taken for all purposes as never having been convicted." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-85zr-ss-1 cml:asserts concept:crimes-act-1914-sec-85zr-ss-1-logic-alleninterval-2 .
