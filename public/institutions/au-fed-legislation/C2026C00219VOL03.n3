    cml:asserts concept:crimes-act-1914-sec-6-2-ss-1-norm .
concept:crimes-act-1914-sec-6-2-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-6-2-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-6-2-ss-1 cml:asserts concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-1 .
concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits recording or retaining identifying information from forensic material without destruction." ;
    cml:premiseText "(a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;" ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-6-2-ss-1 cml:asserts concept:crimes-act-1914-sec-6-2-ss-1-logic-alleninterval-2 .
concept:crimes-act-1914-sec-6-2-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The destruction of forensic material overlaps with the recording or retention of identifying information." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;" ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-6-2-ss-1 cml:asserts concept:crimes-act-1914-sec-6-2-ss-1-logic-ltl-3 .
concept:crimes-act-1914-sec-6-2-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "The destruction of forensic material is a prerequisite for recording or retention of identifying information." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;" ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-6-2-ss-1 cml:asserts concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-4 .
concept:crimes-act-1914-sec-6-2-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "There is an obligation to destroy forensic material before recording or retaining identifying information." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person’s conduct causes any identifying information about a person obtained from forensic material taken from the person under this Part to be recorded or retained in the Commonwealth DNA database system at any time after this Part requires the forensic material to be destroyed;" ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


