concept:crimes-act-1914-sec-6-2-ss-1 a cml:Concept ;
    skos:prefLabel "6(1) Section 6"@en ;
    cml:realizedBy doc:sec-6-2-ss-1 ;
    cml:integrityHash "44323b9e730c9ae6786c8e4996b366ea2d8842df71b83a5687738342b009c0c4" ;
    values:partOf concept:crimes-act-1914-sec-6-2 ;
    skos:note "Offence of recording or retaining identifying information from forensic material without destruction." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
