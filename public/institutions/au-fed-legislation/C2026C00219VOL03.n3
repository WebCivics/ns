    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy for definitions" ;
    cml:premiseText "article in the course of post means an article that is being carried by post, and includes an article that has been collected or received by Australia Post for carriage by post" ;
    cml:conclusionText "Australia Post means the Australian Postal Corporation." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

