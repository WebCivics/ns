    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits carrying out forensic procedures in certain circumstances." ;
    cml:premiseText "Forensic procedure must be carried out while the suspect is not being questioned as defined in subsection 23B(6)." ;
    cml:conclusionText "Must not be carried out while the suspect is being questioned as defined in subsection 23B(6)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

