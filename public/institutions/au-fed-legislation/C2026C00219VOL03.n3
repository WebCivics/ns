    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy for definitions" ;
    cml:premiseText "postal message means:  (a) a material record of an unwritten communication:  (i) carried by post; or  (ii) collected or received by Australia Post for carriage by post;" ;
    cml:conclusionText "postal message is a material record of an unwritten communication." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
