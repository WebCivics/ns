    cml:premiseText "(b) the person is reckless as to any such matching of profiles." ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

