    <https://ns.webcivics.net/cml/operator> "Prohibit";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibition of receiving property to influence a witness in a judicial proceeding.";
    <https://ns.webcivics.net/cml/premiseText> "(iii) asks for, receives or obtains any property, or benefit, of any kind for himself or herself or another person;";
    <https://ns.webcivics.net/cml/conclusionText> "The first person commits an offence if...";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
