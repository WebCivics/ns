concept:crimes-act-1914-sec-23zc-ss-4 a cml:Concept ;
    skos:prefLabel "23ZC(4) Providing copies of innocuous parts of material to be forfeited"@en ;
    cml:realizedBy doc:sec-23zc-ss-4 ;
    values:originalText "(4) If:  (a) the head of the police force complies with the request; and   Forfeiture of child abuse material  Part IE Forfeiture by operation of law after notice is given  Division 2  Section 23ZC  Crimes Act 1914  Compilation date: 04/06/2026  (b) a court convicts the person of a Commonwealth child sex offence and is satisfied on the balance of probabilities that the forfeitable thing is derived from, or was used in connection with, the commission of the offence; the court may order the person to pay the Commonwealth, State or Territory whose police force incurred costs in complying with the request those costs." ;
    skos:definition "(4) If:  (a) the head of the police force complies with the request; and   Forfeiture of child abuse material  Part IE Forfeiture by operation of law after notice is given  Division 2  Section 23ZC  Crimes Act 1914  Compilation date: 04/06/2026  (b) a court convicts the person of a Commonwealth child sex offence and is satisfied on the balance of probabilities that the forfeitable thing is derived from, or was used in connection with, the commission of the offence; the court may order the person to pay the Commonwealth, State or Territory whose police force incurred costs in complying with the request those costs."@en ;
    cml:integrityHash "1e53f408a76ac27e9be3c3b9d3bdbd5b8e30bfb2317046a0abbbe5d69a06555f" ;
    values:partOf concept:crimes-act-1914-sec-23zc ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "The court may order the person to pay costs incurred by the police force in complying with a request." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
