concept:crimes-act-1914-sec-23zb-ss-5 a cml:Concept ;
    skos:prefLabel "23ZB(5) Forfeiture of material by operation of law"@en ;
    cml:realizedBy doc:sec-23zb-ss-5 ;
    values:originalText "(5) If there is not an objection described in paragraph (3)(c), the forfeitable thing is forfeited to the Commonwealth (by force of this subsection) at the end of the period described in that paragraph." ;
    skos:definition "(5) If there is not an objection described in paragraph (3)(c), the forfeitable thing is forfeited to the Commonwealth (by force of this subsection) at the end of the period described in that paragraph."@en ;
