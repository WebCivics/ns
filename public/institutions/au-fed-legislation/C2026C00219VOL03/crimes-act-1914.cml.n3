doc:sec-23zb-ss-5 a cof:Section ;
    cof:title "23ZB(5) Forfeiture of material by operation of law" ;
    values:kind "subsection" ;
    values:originalText "(5) If there is not an objection described in paragraph (3)(c), the forfeitable thing is forfeited to the Commonwealth (by force of this subsection) at the end of the period described in that paragraph." ;
    cof:pageNumber "140"^^xsd:integer .

concept:crimes-act-1914-sec-23zb-ss-6 a cml:Concept ;
    skos:prefLabel "23ZB(6) Forfeiture of material by operation of law"@en ;
    cml:realizedBy doc:sec-23zb-ss-6 ;
    values:originalText "(6) If there is an objection described in paragraph (3)(c) but the head of the police force that includes the constable considers that the forfeitable thing should be forfeited to the Commonwealth despite the objection:  (a) the head of the police force must instruct the Director of Public Prosecutions to apply for an order under section 23ZD for the forfeiture of the thing; and  (b) the Director must make the application." ;
    skos:definition "(6) If there is an objection described in paragraph (3)(c) but the head of the police force that includes the constable considers that the forfeitable thing should be forfeited to the Commonwealth despite the objection:  (a) the head of the police force must instruct the Director of Public Prosecutions to apply for an order under section 23ZD for the forfeiture of the thing; and  (b) the Director must make the application."@en ;
    cml:integrityHash "b80e4784025aa51dc4b177810cc6b2c8009cb5dc9cf15a06dbc9a39b3f9bdc0c" ;
    values:partOf concept:crimes-act-1914-sec-23zb ;
    cof:pageNumber "140"^^xsd:integer ;
    skos:note "Head of police force must instruct Director to apply for forfeiture order." ;
