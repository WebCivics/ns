doc:sec-23wg-ss-4 a cof:Section ;
    cof:title "23WG(4) Informed consent to forensic procedures—Aboriginal" ;
    values:kind "subsection" ;
    values:originalText "(4) Before asking the suspect to consent to a forensic procedure, the constable must:  (a) inform the suspect that a representative of an Aboriginal legal assistance organisation will be notified that the suspect is to be asked to consent to a forensic procedure; and  (b) notify such a representative that the suspect is to be asked to consent to a forensic procedure." ;
    cof:pageNumber "34"^^xsd:integer .

concept:crimes-act-1914-sec-23wg-ss-5 a cml:Concept ;
    skos:prefLabel "23WG(5) Informed consent to forensic procedures—Aboriginal"@en ;
    cml:realizedBy doc:sec-23wg-ss-5 ;
    values:originalText "(5) The constable is not required to comply with subsection (4) if:  (a) he or she is aware that the suspect has arranged for a legal practitioner to be present while the suspect is asked to consent to the forensic procedure; or  (b) paragraph (3)(b) or (c) applies." ;
    skos:definition "(5) The constable is not required to comply with subsection (4) if:  (a) he or she is aware that the suspect has arranged for a legal practitioner to be present while the suspect is asked to consent to the forensic procedure; or  (b) paragraph (3)(b) or (c) applies."@en ;
    cml:integrityHash "e2402e5527820ec2f60a79ce0f19bb7a673fcfbe07e1e8f60b0384d85c487b89" ;
    values:partOf concept:crimes-act-1914-sec-23wg ;
