doc:sec-53-ss-1 a cof:Section ;
    cof:title "53(1) Operating a pirate-controlled ship or aircraft" ;
    values:kind "subsection" ;
    values:originalText "(1) A person must not voluntarily participate in the operation of a pirate-controlled ship or aircraft knowing that it is such a ship or aircraft. Penalty: Imprisonment for 15 years." ;
    cof:pageNumber "172"^^xsd:integer .

concept:crimes-act-1914-sec-53-ss-2 a cml:Concept ;
    skos:prefLabel "53(2) Operating a pirate-controlled ship or aircraft"@en ;
    cml:realizedBy doc:sec-53-ss-2 ;
    values:originalText "(2) This section applies to acts performed on the high seas, in places beyond the jurisdiction of any country or in Australia.   Piracy  Part IV  Section 54  Crimes Act 1914  Compilation date: 04/06/2026  54  Seizure of pirate ships and aircraft etc." ;
