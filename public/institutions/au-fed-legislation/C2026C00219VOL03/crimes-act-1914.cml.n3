concept:crimes-act-1914-sec-23xh a cml:Concept ;
    skos:prefLabel "23XH Restrictions on publication"@en ;
    cml:realizedBy doc:sec-23xh ;
    values:originalText "A person must not intentionally, in any report of a proceeding under this Division, publish:  (a) the name of the suspect; or  (b) any information likely to enable the identification of the suspect; unless the suspect has been charged with a relevant offence or the magistrate, by order, has authorised such publication. Penalty: Imprisonment for 12 months." ;
    skos:definition "A person must not intentionally, in any report of a proceeding under this Division, publish:  (a) the name of the suspect; or  (b) any information likely to enable the identification of the suspect; unless the suspect has been charged with a relevant offence or the magistrate, by order, has authorised such publication. Penalty: Imprisonment for 12 months."@en ;
    cml:integrityHash "3eb3765a66e717d287071243dee8b3c467a528121ab8ba38a249e6700a04d742" ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "Restrictions on publication of suspect information" ;
    cml:curationStatus cml:Proposed ;
