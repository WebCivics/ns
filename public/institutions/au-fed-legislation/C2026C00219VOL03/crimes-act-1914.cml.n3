doc:sec-85zq a cof:Section ;
    cof:title "85ZQ Part binds the Crown" ;
    values:kind "section" ;
    values:originalText "This Part binds the Crown in right of the Commonwealth, of each of the States, of the Australian Capital Territory and of the Northern Territory.   Pardons, quashed convictions and spent convictions  Part VIIC Pardons for persons wrongly convicted, and quashed convictions  Division 2  Section 85ZR  Crimes Act 1914  Compilation date: 04/06/2026" ;
    cof:pageNumber "190"^^xsd:integer .

concept:crimes-act-1914-sec-85zr a cml:Concept ;
    skos:prefLabel "85ZR Pardons for persons wrongly convicted"@en ;
    cml:realizedBy doc:sec-85zr ;
    values:originalText "(1) Despite any other Commonwealth law or any State law or Territory law, where a person has been granted a free and absolute pardon for a Commonwealth offence or a Territory offence because the person was wrongly convicted of the offence:  (a) the person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence; and  (b) the person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence.  (2) Despite any other Commonwealth law or any Territory law, where, under a State law or a foreign law a person is, in particular circumstances or for a particular purpose, to be taken never to have been convicted of an offence under a law of that State or foreign country:  (a) the person shall be taken, in any Territory, in corresponding circumstances or for a corresponding purpose, never to have been convicted of that offence; and  (b) the person shall be taken, in any State or foreign country, in corresponding circumstances or for a corresponding purpose, by any Commonwealth authority in that State or country, never to have been convicted of that offence." ;
    skos:definition "(1) Despite any other Commonwealth law or any State law or Territory law, where a person has been granted a free and absolute pardon for a Commonwealth offence or a Territory offence because the person was wrongly convicted of the offence:  (a) the person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence; and  (b) the person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence.  (2) Despite any other Commonwealth law or any Territory law, where, under a State law or a foreign law a person is, in particular circumstances or for a particular purpose, to be taken never to have been convicted of an offence under a law of that State or foreign country:  (a) the person shall be taken, in any Territory, in corresponding circumstances or for a corresponding purpose, never to have been convicted of that offence; and  (b) the person shall be taken, in any State or foreign country, in corresponding circumstances or for a corresponding purpose, by any Commonwealth authority in that State or country, never to have been convicted of that offence."@en ;
    cml:integrityHash "2c731e80acf22c5cb98e9fa317682b1ba9d42f0d239d1db8c0780d9b0bda03f6" ;
    cof:pageNumber "191"^^xsd:integer ;
    cml:hasPart concept:crimes-act-1914-sec-85zr-ss-1 ;
    cml:hasPart concept:crimes-act-1914-sec-85zr-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.191" .
doc:sec-85zr a cof:Section ;
    cof:title "85ZR Pardons for persons wrongly convicted" ;
    values:kind "section" ;
    values:originalText "(1) Despite any other Commonwealth law or any State law or Territory law, where a person has been granted a free and absolute pardon for a Commonwealth offence or a Territory offence because the person was wrongly convicted of the offence:  (a) the person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence; and  (b) the person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence.  (2) Despite any other Commonwealth law or any Territory law, where, under a State law or a foreign law a person is, in particular circumstances or for a particular purpose, to be taken never to have been convicted of an offence under a law of that State or foreign country:  (a) the person shall be taken, in any Territory, in corresponding circumstances or for a corresponding purpose, never to have been convicted of that offence; and  (b) the person shall be taken, in any State or foreign country, in corresponding circumstances or for a corresponding purpose, by any Commonwealth authority in that State or country, never to have been convicted of that offence." ;
    cof:pageNumber "191"^^xsd:integer .

concept:crimes-act-1914-sec-85zr-ss-1 a cml:Concept ;
    skos:prefLabel "85ZR(1) Pardons for persons wrongly convicted"@en ;
    cml:realizedBy doc:sec-85zr-ss-1 ;
    values:originalText "(1) Despite any other Commonwealth law or any State law or Territory law, where a person has been granted a free and absolute pardon for a Commonwealth offence or a Territory offence because the person was wrongly convicted of the offence:  (a) the person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence; and  (b) the person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence." ;
    skos:definition "(1) Despite any other Commonwealth law or any State law or Territory law, where a person has been granted a free and absolute pardon for a Commonwealth offence or a Territory offence because the person was wrongly convicted of the offence:  (a) the person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence; and  (b) the person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence."@en ;
    cml:integrityHash "c906a22f58b520f675dd2a7756be8b90fbf486c9e95cf9c0ce95aed690959006" ;
    values:partOf concept:crimes-act-1914-sec-85zr ;
    cof:pageNumber "191"^^xsd:integer ;
    skos:note "A person wrongly convicted of a Commonwealth offence is taken for all purposes as never having been convicted." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
