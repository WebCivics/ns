doc:sec-85zz-ss-3 a cof:Section ;
    cof:title "85ZZ(3) Information Commissioner’s functions" ;
    values:kind "subsection" ;
    values:originalText "(3) It is the duty of members of the Information Commissioner’s staff to give appropriate help to a person who wishes to make a complaint and wants help to formulate the complaint." ;
    cof:pageNumber "198"^^xsd:integer .

