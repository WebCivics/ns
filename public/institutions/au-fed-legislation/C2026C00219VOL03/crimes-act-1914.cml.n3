concept:crimes-act-1914-sec-23xv a cml:Concept ;
    skos:prefLabel "23XV Photographs"@en ;
    cml:realizedBy doc:sec-23xv ;
    values:originalText "Where a forensic procedure involves the taking of a photograph of a part of a suspect’s body, the investigating constable must ensure that a copy of the photograph is made available to the suspect. Note: Division 9 contains provisions about making copies of material available to the suspect." ;
    skos:definition "Where a forensic procedure involves the taking of a photograph of a part of a suspect’s body, the investigating constable must ensure that a copy of the photograph is made available to the suspect. Note: Division 9 contains provisions about making copies of material available to the suspect."@en ;
    cml:integrityHash "53dd23cd7107c70f349a8484c261d1c869b69d809ff925fedbaf57b8d31f5fd2" ;
    cof:pageNumber "75"^^xsd:integer ;
    skos:note "Suspect must be provided with a copy of the photograph taken during forensic procedure." ;
    dc:description "True" ;
