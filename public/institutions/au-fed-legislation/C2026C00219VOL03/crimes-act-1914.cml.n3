    values:partOf concept:crimes-act-1914-sec-23xt ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Forensic procedure must be carried out in the presence of an independent person." ;
    cml:curationStatus cml:Proposed ;
