concept:crimes-act-1914-sec-23wx a cml:Concept ;
    skos:prefLabel "23WX Procedure at hearing of application for order"@en ;
    cml:realizedBy doc:sec-23wx ;
    values:originalText "(1) An order may only be made in the presence of the suspect concerned, subject to any contrary order made by the magistrate." ;
