concept:crimes-act-1914-sec-23xl cml:asserts concept:crimes-act-1914-sec-23xl-logic-deontic-2 .
concept:crimes-act-1914-sec-23xl-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposing an obligation on the person taking the sample." ;
    cml:premiseText "The sample is taken using the least painful technique known and available to the person." ;
    cml:conclusionText "The person must use the least painful technique." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23xl cml:asserts concept:crimes-act-1914-sec-23xl-logic-deontic-3 .
concept:crimes-act-1914-sec-23xl-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibiting certain actions for taking hair samples." ;
    cml:premiseText "The sample is not taken using a technique that causes unnecessary pain or discomfort." ;
    cml:conclusionText "This action must not cause unnecessary pain or discomfort." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23xl cml:asserts concept:crimes-act-1914-sec-23xl-logic-deontic-4 .
