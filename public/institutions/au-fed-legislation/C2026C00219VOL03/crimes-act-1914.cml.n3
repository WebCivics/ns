concept:crimes-act-1914-sec-23wh a cml:Concept ;
    skos:prefLabel "23WH Constable may request suspect to consent to forensic"@en ;
    cml:realizedBy doc:sec-23wh ;
    values:originalText "procedure  A constable may ask a suspect to undergo a forensic procedure if the constable is satisfied as required by section 23WI." ;
    skos:definition "procedure  A constable may ask a suspect to undergo a forensic procedure if the constable is satisfied as required by section 23WI."@en ;
