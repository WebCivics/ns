concept:crimes-act-1914-sec-23ym a cml:Concept ;
    skos:prefLabel "23YM Experts not obliged to carry out forensic procedures"@en ;
    cml:realizedBy doc:sec-23ym ;
    values:originalText "Nothing in this Part requires a medical practitioner, nurse, dentist, dental technician or appropriately qualified person to carry out a forensic procedure." ;
