concept:crimes-act-1914-sec-41-ss-5 a cml:Concept ;
    skos:prefLabel "41(5) Conspiracy to bring false accusation"@en ;
    cml:realizedBy doc:sec-41-ss-5 ;
    values:originalText "(5) A person cannot be found guilty of an offence against subsection (1) if, before the commission of an overt act pursuant to the agreement, the person:  (a) withdrew from the agreement; and  (b) took all reasonable steps to prevent the false charging." ;
    skos:definition "(5) A person cannot be found guilty of an offence against subsection (1) if, before the commission of an overt act pursuant to the agreement, the person:  (a) withdrew from the agreement; and  (b) took all reasonable steps to prevent the false charging."@en ;
    cml:integrityHash "c9f0cf026a4aa5b514159d4a7bdcefa4dcf8feec3cbd37049696b2af37124bc2" ;
    values:partOf concept:crimes-act-1914-sec-41 ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "Must take reasonable steps to prevent false charging before committing an overt act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
