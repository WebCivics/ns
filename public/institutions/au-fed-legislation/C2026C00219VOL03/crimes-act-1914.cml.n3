concept:crimes-act-1914-sec-45 a cml:Concept ;
    skos:prefLabel "45 Inserting advertisements without authority of court"@en ;
    cml:realizedBy doc:sec-45 ;
    values:originalText "(1) A person commits an offence if:  (a) the person inserts in the Gazette, or in a newspaper, an advertisement purporting to be published under the authority of a court; and  (b) the person does so:  (i) without authority; or  (ii) knowing the advertisement to be false in any material particular; and  (c) the advertisement purports to be published under the authority of:  (i) a federal court; or  (ii) a court exercising federal jurisdiction; or  (iii) a court of a Territory. Penalty: Imprisonment for 2 years.  (2) Absolute liability applies to the paragraph (1)(c) element of the offence. Note: For absolute liability, see section 6.2 of the Criminal Code.   Offences relating to the administration of justice  Part III Escape from criminal detention  Division 5  Section 45A  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "(1) A person commits an offence if:  (a) the person inserts in the Gazette, or in a newspaper, an advertisement purporting to be published under the authority of a court; and  (b) the person does so:  (i) without authority; or  (ii) knowing the advertisement to be false in any material particular; and  (c) the advertisement purports to be published under the authority of:  (i) a federal court; or  (ii) a court exercising federal jurisdiction; or  (iii) a court of a Territory. Penalty: Imprisonment for 2 years.  (2) Absolute liability applies to the paragraph (1)(c) element of the offence. Note: For absolute liability, see section 6.2 of the Criminal Code.   Offences relating to the administration of justice  Part III Escape from criminal detention  Division 5  Section 45A  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "d63a960f1b60ac51b99138e8a6d7b6fd9e43b2c6ae0a938753019bed2673c90c" ;
    cof:pageNumber "164"^^xsd:integer ;
    cml:hasPart concept:crimes-act-1914-sec-45-ss-1 ;
    cml:hasPart concept:crimes-act-1914-sec-45-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
