    cml:premiseText "(1) An order may only be made in the presence of the suspect concerned, subject to any contrary order made by the magistrate." ;
    cml:conclusionText "The presence is required for the order" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-23wx a cof:Section ;
