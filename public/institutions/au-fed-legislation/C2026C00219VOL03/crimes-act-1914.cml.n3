doc:sec-53-ss-3 a cof:Section ;
    cof:title "53(3) Operating a pirate-controlled ship or aircraft" ;
    values:kind "subsection" ;
    values:originalText "(3) The Supreme Court of a State or Territory may:  (a) on the application by the custodian of, or a person with an interest in, a ship, aircraft or thing seized under this section, order that the ship, aircraft or thing be returned to its lawful owner; or  (b) on its own motion, or on application:  (i) if:  (A) a person has been convicted of an offence against this Part; and  (B) the ship, aircraft or thing was used in, or was otherwise involved in the commission of, the offence;  order that the ship, aircraft or thing be forfeited to the Commonwealth; or  (ii) make any order relating to the seizure, detention or disposal of the ship, aircraft or thing." ;
    cof:pageNumber "172"^^xsd:integer .

concept:crimes-act-1914-sec-53-ss-4 a cml:Concept ;
    skos:prefLabel "53(4) Operating a pirate-controlled ship or aircraft"@en ;
    cml:realizedBy doc:sec-53-ss-4 ;
    values:originalText "(4) An order to return a ship, aircraft or thing may be made subject to conditions, including conditions as to the payment to the Commonwealth of reasonable costs of seizure and detention and conditions as to the giving of security for payment of its value should it be forfeited." ;
    skos:definition "(4) An order to return a ship, aircraft or thing may be made subject to conditions, including conditions as to the payment to the Commonwealth of reasonable costs of seizure and detention and conditions as to the giving of security for payment of its value should it be forfeited."@en ;
    cml:integrityHash "261ac3776dd32a305c267910ec22ff2b5d35e6349101816439d184dbbbb9d4ce" ;
    values:partOf concept:crimes-act-1914-sec-53 ;
    cof:pageNumber "172"^^xsd:integer ;
    skos:note "Conditions for returning a ship, aircraft or thing" ;
    cml:curationStatus cml:Proposed ;
