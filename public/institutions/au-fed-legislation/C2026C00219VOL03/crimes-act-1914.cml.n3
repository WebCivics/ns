doc:sec-23wf-ss-1 a cof:Section ;
    cof:title "23WF(1) Informed consent to forensic procedures—general" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies where:  (a) a constable intends to ask a suspect to consent to a forensic procedure; and  (b) the constable does not believe on reasonable grounds that the suspect is an Aboriginal person or a Torres Strait Islander." ;
