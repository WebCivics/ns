doc:sec-85zr-ss-1 a cof:Section ;
    cof:title "85ZR(1) Pardons for persons wrongly convicted" ;
    values:kind "subsection" ;
    values:originalText "(1) Despite any other Commonwealth law or any State law or Territory law, where a person has been granted a free and absolute pardon for a Commonwealth offence or a Territory offence because the person was wrongly convicted of the offence:  (a) the person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence; and  (b) the person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence." ;
    cof:pageNumber "191"^^xsd:integer .

concept:crimes-act-1914-sec-85zr-ss-2 a cml:Concept ;
    skos:prefLabel "85ZR(2) Pardons for persons wrongly convicted"@en ;
    cml:realizedBy doc:sec-85zr-ss-2 ;
    values:originalText "(2) Despite any other Commonwealth law or any Territory law, where, under a State law or a foreign law a person is, in particular circumstances or for a particular purpose, to be taken never to have been convicted of an offence under a law of that State or foreign country:  (a) the person shall be taken, in any Territory, in corresponding circumstances or for a corresponding purpose, never to have been convicted of that offence; and  (b) the person shall be taken, in any State or foreign country, in corresponding circumstances or for a corresponding purpose, by any Commonwealth authority in that State or country, never to have been convicted of that offence." ;
    skos:definition "(2) Despite any other Commonwealth law or any Territory law, where, under a State law or a foreign law a person is, in particular circumstances or for a particular purpose, to be taken never to have been convicted of an offence under a law of that State or foreign country:  (a) the person shall be taken, in any Territory, in corresponding circumstances or for a corresponding purpose, never to have been convicted of that offence; and  (b) the person shall be taken, in any State or foreign country, in corresponding circumstances or for a corresponding purpose, by any Commonwealth authority in that State or country, never to have been convicted of that offence."@en ;
    cml:integrityHash "3c0d734066198818b6d1e0593601a51a6f403793a800038a5ff18eef85ba3614" ;
    values:partOf concept:crimes-act-1914-sec-85zr ;
    cof:pageNumber "191"^^xsd:integer ;
    skos:note "A person wrongly convicted under a State or foreign law is taken never to have been convicted of an offence in corresponding circumstances or for a corresponding purpose." ;
