doc:sec-35-ss-1 a cof:Section ;
    cof:title "35(1) Giving false testimony" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if:  (a) the person gives false testimony touching a matter; and  (b) the person does so:  (i) in a judicial proceeding; or  (ii) with the intention of instituting a judicial proceeding; and  (c) the matter is material in the judicial proceeding; and  (d) the judicial proceeding is a federal judicial proceeding. Penalty: Imprisonment for 5 years." ;
    cof:pageNumber "155"^^xsd:integer .

