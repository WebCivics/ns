concept:crimes-act-1914-sec-23xb-ss-9 a cml:Concept ;
    skos:prefLabel "23XB(9) Application for interim order"@en ;
    cml:realizedBy doc:sec-23xb-ss-9 ;
    values:originalText "(9) In spite of subsection (5) or (6), the suspect’s interview friend may be excluded from the presence of the authorised applicant if the interview friend unreasonably interferes with or obstructs the making of the application." ;
    skos:definition "(9) In spite of subsection (5) or (6), the suspect’s interview friend may be excluded from the presence of the authorised applicant if the interview friend unreasonably interferes with or obstructs the making of the application."@en ;
