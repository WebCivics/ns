concept:crimes-act-1914-sec-90 a cml:Concept ;
    skos:prefLabel "90 Trespass by cattle or live stock"@en ;
    cml:realizedBy doc:sec-90 ;
    values:originalText "Any person who, without lawful excuse (proof whereof shall lie upon him or her), suffers or permits any cattle or other live stock in his or her possession, custody, or control, to trespass or stray upon any land belonging to, or in the occupation of, the Commonwealth, commits an offence. Penalty: 1 penalty unit." ;
    skos:definition "Any person who, without lawful excuse (proof whereof shall lie upon him or her), suffers or permits any cattle or other live stock in his or her possession, custody, or control, to trespass or stray upon any land belonging to, or in the occupation of, the Commonwealth, commits an offence. Penalty: 1 penalty unit."@en ;
    cml:integrityHash "a85aaab9e375bbdf84a44ec8b885fbcc7a286b97a604433497f5d701e4bbac1b" ;
    cof:pageNumber "226"^^xsd:integer ;
