doc:sec-47c-ss-2 a cof:Section ;
    cof:title "47C(2) Permitting escape" ;
    values:kind "subsection" ;
    values:originalText "(2) Absolute liability applies to the paragraph (1)(d) element of the offence. Note: For absolute liability, see section 6.2 of the Criminal Code." ;
