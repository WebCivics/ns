concept:crimes-act-1914-sec-90b a cml:Concept ;
    skos:prefLabel "90B False statements in documents filed etc. under laws of a"@en ;
    cml:realizedBy doc:sec-90b ;
    values:originalText "Territory  A person who:  (a) in a document that, under a law of a Territory, is, or is required to be, produced or furnished to, or filed or lodged with, a Commonwealth officer; or   Miscellaneous  Part VIII  Section 91  Crimes Act 1914  Compilation date: 04/06/2026  (b) in a document that is required to be registered under, or to be prepared for the purposes of, a law of a Territory; intentionally makes a statement that the person knows is false commits an offence. Penalty: Imprisonment for 2 years." ;
    skos:definition "Territory  A person who:  (a) in a document that, under a law of a Territory, is, or is required to be, produced or furnished to, or filed or lodged with, a Commonwealth officer; or   Miscellaneous  Part VIII  Section 91  Crimes Act 1914  Compilation date: 04/06/2026  (b) in a document that is required to be registered under, or to be prepared for the purposes of, a law of a Territory; intentionally makes a statement that the person knows is false commits an offence. Penalty: Imprisonment for 2 years."@en ;
    cml:integrityHash "24db88efb45a1043528afd8d950b6ab76204f39dba921ba91b8d7382a409b884" ;
    cof:pageNumber "226"^^xsd:integer ;
    skos:note "Intentionally making false statements in documents filed or lodged with a Commonwealth officer is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
