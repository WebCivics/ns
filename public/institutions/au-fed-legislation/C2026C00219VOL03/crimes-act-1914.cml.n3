    cml:modality cml:CogAI ;
    cml:operator "Inference" ;
    cml:logicSummary "Requires inference from the destruction of forensic material to its use in evidence" ;
    cml:premiseText "(c) any results of the analysis of the forensic material; and (d) any other evidence made or obtained as a result of or in connection with the carrying out of the forensic procedure" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-23xy-ss-1 a cof:Section ;
    cof:title "23XY(1) Inadmissibility of evidence where forensic material required" ;
    values:kind "subsection" ;
    values:originalText "(1) If a provision of this Part requires forensic material taken from a person by a forensic procedure to be destroyed, subsection (2) applies to:  (a) evidence of the forensic material; and  (b) if the material has not been destroyed—evidence consisting of the forensic material; and  (c) any results of the analysis of the forensic material; and  (d) any other evidence made or obtained as a result of or in connection with the carrying out of the forensic procedure." ;
    cof:pageNumber "99"^^xsd:integer .

concept:crimes-act-1914-sec-23xy-ss-2 a cml:Concept ;
    skos:prefLabel "23XY(2) Inadmissibility of evidence where forensic material required"@en ;
    cml:realizedBy doc:sec-23xy-ss-2 ;
    values:originalText "(2) The results of the analysis, and the other evidence, are not admissible if adduced by the prosecution in any proceedings against the person, but may be admissible if adduced in such proceedings by the person. Subdivision B—Other evidence" ;
    skos:definition "(2) The results of the analysis, and the other evidence, are not admissible if adduced by the prosecution in any proceedings against the person, but may be admissible if adduced in such proceedings by the person. Subdivision B—Other evidence"@en ;
    cml:integrityHash "1dfbbdff780cbfc338b44201804d225bb2306ebb56f19d78c9fc1987eadfcc76" ;
    values:partOf concept:crimes-act-1914-sec-23xy ;
    cof:pageNumber "99"^^xsd:integer ;
    skos:note "Evidence from forensic material is not admissible in proceedings against the person, but may be admissible if adduced by the person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
