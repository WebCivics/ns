concept:crimes-act-1914-sec-23za a cml:Concept ;
    skos:prefLabel "23ZA Application"@en ;
    cml:realizedBy doc:sec-23za ;
    values:originalText "This Part applies to a thing (the forfeitable thing) that is:  (a) child abuse material; or  (c) any of the following that contains child abuse material:  (i) a computer;  (ii) a data storage device;  (iii) another piece of electronic equipment." ;
    skos:definition "This Part applies to a thing (the forfeitable thing) that is:  (a) child abuse material; or  (c) any of the following that contains child abuse material:  (i) a computer;  (ii) a data storage device;  (iii) another piece of electronic equipment."@en ;
    cml:integrityHash "b075e245d0ef0d814db0c952b5e1ef590ea3cdecb1433b6b3a48a18e04fbcda6" ;
    cof:pageNumber "139"^^xsd:integer ;
    skos:note "This Part applies to a thing that is child abuse material or contains child abuse material." ;
