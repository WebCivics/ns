concept:crimes-act-1914-sec-90a a cml:Concept ;
    skos:prefLabel "90A Destroying etc. posters etc. relating to Commonwealth loans"@en ;
    cml:realizedBy doc:sec-90a ;
    values:originalText "A person shall not, without lawful authority, destroy, injure, disfigure or remove a poster, advertisement or notice relating to a Commonwealth loan. Penalty: Imprisonment for 1 year." ;
    skos:definition "A person shall not, without lawful authority, destroy, injure, disfigure or remove a poster, advertisement or notice relating to a Commonwealth loan. Penalty: Imprisonment for 1 year."@en ;
