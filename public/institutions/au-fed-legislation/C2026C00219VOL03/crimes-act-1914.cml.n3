concept:crimes-act-1914-sec-52 a cml:Concept ;
    skos:prefLabel "52 Piracy"@en ;
    cml:realizedBy doc:sec-52 ;
    values:originalText "A person must not perform an act of piracy. Penalty: Imprisonment for life." ;
