    cml:logicSummary "Granting permission for the person to take hair samples under certain conditions." ;
    cml:premiseText "The sample is taken using the least painful technique known and available to the person." ;
    cml:conclusionText "Permission granted to take a sample of hair." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23xl cml:asserts concept:crimes-act-1914-sec-23xl-logic-deontic-5 .
concept:crimes-act-1914-sec-23xl-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Right" ;
    cml:logicSummary "Granting a right to the suspect to refuse taking a hair sample." ;
    cml:premiseText "The person must inform the suspect that they have the right to refuse taking a sample of hair." ;
    cml:conclusionText "This action is not mandatory." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
