concept:crimes-act-1914-sec-85f-ss-6 a cml:Concept ;
    skos:prefLabel "85F(6) Interpretation—expressions used in Australian Postal"@en ;
    cml:realizedBy doc:sec-85f-ss-6 ;
    values:originalText "(6) A person shall be taken to utter a forged postage stamp if the person:  (a) tenders it or puts it off; or  (c) uses or deals with it; or  (e) attempts to induce any person to use, deal with, act on or accept it." ;
    skos:definition "(6) A person shall be taken to utter a forged postage stamp if the person:  (a) tenders it or puts it off; or  (c) uses or deals with it; or  (e) attempts to induce any person to use, deal with, act on or accept it."@en ;
    cml:integrityHash "96531aa3a3e7a3496575ec89bb86a26242124043ad43abe1414bc78147367892" ;
    values:partOf concept:crimes-act-1914-sec-85f ;
    cof:pageNumber "176"^^xsd:integer ;
    skos:note "Uttering a forged postage stamp is prohibited." ;
    cml:curationStatus cml:Proposed ;
