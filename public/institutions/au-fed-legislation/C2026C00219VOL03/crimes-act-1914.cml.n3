concept:crimes-act-1914-sec-23yh a cml:Concept ;
    skos:prefLabel "23YH No charge to be made for giving material etc. to suspects,"@en ;
    cml:realizedBy doc:sec-23yh ;
    values:originalText "offenders and volunteers  If a provision of this Part requires material of any kind to be given to a suspect, offender or volunteer, or an opportunity to view a video recording to be given to a suspect, offender or volunteer, the material or the opportunity to view the video must be given without charge.   Forensic procedures  Part ID General provisions relating to operation of this Part  Division 9  Section 23YI  Crimes Act 1914  Compilation date: 04/06/2026" ;
    skos:definition "offenders and volunteers  If a provision of this Part requires material of any kind to be given to a suspect, offender or volunteer, or an opportunity to view a video recording to be given to a suspect, offender or volunteer, the material or the opportunity to view the video must be given without charge.   Forensic procedures  Part ID General provisions relating to operation of this Part  Division 9  Section 23YI  Crimes Act 1914  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "02fe555b85e1148d661a62eda6841f6545191c18fc9df6f2523b6442a85c1ee0" ;
    cof:pageNumber "118"^^xsd:integer ;
    skos:note "No charge for providing material or video recording to suspects, offenders, or volunteers." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
