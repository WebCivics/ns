    cml:modality cml:LTL ;
    cml:operator "Recurrently" ;
    cml:logicSummary "Indicates that the person is treated as never having been convicted repeatedly." ;
    cml:premiseText "The person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence." ;
    cml:conclusionText "The person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-85zr-ss-1 cml:asserts concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-4 .
