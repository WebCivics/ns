concept:crimes-act-1914-sec-23yb-ss-4 a cml:Concept ;
    skos:prefLabel "23YB(4) Obstructing the carrying out of forensic procedure"@en ;
    cml:realizedBy doc:sec-23yb-ss-4 ;
    values:originalText "(4) Evidence described in subsection (2) is not admissible unless it is established that the suspect:  (a) had been informed by a constable as described in subsection 23WA(4); or  (b) otherwise knew;   Forensic procedures  Part ID Admissibility of evidence  Division 7  Section 23YBA  Crimes Act 1914  Compilation date: 04/06/2026  that the fact of refusing to comply with the direction, or obstructing, resisting, hindering, using violence against, threatening or intimidating the person, in connection with the carrying out of the forensic procedure might be used in evidence against the suspect." ;
    skos:definition "(4) Evidence described in subsection (2) is not admissible unless it is established that the suspect:  (a) had been informed by a constable as described in subsection 23WA(4); or  (b) otherwise knew;   Forensic procedures  Part ID Admissibility of evidence  Division 7  Section 23YBA  Crimes Act 1914  Compilation date: 04/06/2026  that the fact of refusing to comply with the direction, or obstructing, resisting, hindering, using violence against, threatening or intimidating the person, in connection with the carrying out of the forensic procedure might be used in evidence against the suspect."@en ;
    cml:integrityHash "f7987aade7b2c8cedb737839fed70b547d611d1086f1b77b89fb3000172d9cb9" ;
    values:partOf concept:crimes-act-1914-sec-23yb ;
    cof:pageNumber "100"^^xsd:integer ;
    skos:note "Refusing to comply with direction or obstructing forensic procedure is not admissible as evidence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
