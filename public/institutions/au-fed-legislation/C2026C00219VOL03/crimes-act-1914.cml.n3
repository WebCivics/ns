doc:sec-23yf-ss-2 a cof:Section ;
    cof:title "23YF(2) Obligation of investigating constables relating to tape" ;
    values:kind "subsection" ;
    values:originalText "(2) Where an investigating constable is required to ensure that a suspect, offender or volunteer is given an opportunity to view a video recording made under this Part, the investigating constable must ensure that the same opportunity is given to:  (a) in any case—the suspect’s, offender’s or volunteer’s legal representative; and  (b) if the suspect, offender or volunteer is a child or an incapable person—an interview friend of the suspect, offender or volunteer; and  (c) if the investigating constable believes on reasonable grounds that the suspect, offender or volunteer is an Aboriginal person or a Torres Strait Islander—an interview friend of the suspect, offender or volunteer." ;
    cof:pageNumber "116"^^xsd:integer .

concept:crimes-act-1914-sec-23yf-ss-3 a cml:Concept ;
    skos:prefLabel "23YF(3) Obligation of investigating constables relating to tape"@en ;
    cml:realizedBy doc:sec-23yf-ss-3 ;
    values:originalText "(3) If section 23YD requires forensic material taken from a suspect, offender or volunteer by a forensic procedure to be destroyed, the investigating constable must ensure that any video recording of the carrying out of the forensic procedure is also destroyed." ;
    skos:definition "(3) If section 23YD requires forensic material taken from a suspect, offender or volunteer by a forensic procedure to be destroyed, the investigating constable must ensure that any video recording of the carrying out of the forensic procedure is also destroyed."@en ;
    cml:integrityHash "449e82de838d8c762bfad43032feb7f7c0f50bbe14e0edd0af37910de0a64db3" ;
    values:partOf concept:crimes-act-1914-sec-23yf ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "Destroy video recording of forensic procedure if section 23YD requires destruction of material." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
