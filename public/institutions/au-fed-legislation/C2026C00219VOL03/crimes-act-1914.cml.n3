concept:crimes-act-1914-sec-23yb-ss-2 cml:asserts concept:crimes-act-1914-sec-23yb-ss-2-logic-cogai-5 .
concept:crimes-act-1914-sec-23yb-ss-2-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Recognize" ;
    cml:logicSummary "Recognition of obstructive behavior by AI system" ;
    cml:premiseText "(2) Subject to subsections (3) and (4)" ;
    cml:conclusionText "evidence that the suspect refused to comply with any reasonable direction in connection with the carrying out of the forensic procedure; or evidence that the suspect obstructed, resisted, hindered, used violence against, threatened or intimidated a person in connection with the carrying out of the forensic procedure;" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-23yb-ss-2 a cof:Section ;
    cof:title "23YB(2) Obstructing the carrying out of forensic procedure" ;
    values:kind "subsection" ;
    values:originalText "(2) Subject to subsections (3) and (4), evidence that the suspect:  (a) refused to comply with any reasonable direction in connection with the carrying out of the forensic procedure; or  (b) obstructed, resisted, hindered, used violence against, threatened or intimidated a person in connection with the carrying out of the forensic procedure; is admissible in any proceedings against the suspect in respect of a relevant offence." ;
    cof:pageNumber "100"^^xsd:integer .

concept:crimes-act-1914-sec-23yb-ss-3 a cml:Concept ;
    skos:prefLabel "23YB(3) Obstructing the carrying out of forensic procedure"@en ;
    cml:realizedBy doc:sec-23yb-ss-3 ;
    values:originalText "(3) Evidence described in subsection (2) is not admissible if the forensic procedure was in fact carried out satisfactorily." ;
    skos:definition "(3) Evidence described in subsection (2) is not admissible if the forensic procedure was in fact carried out satisfactorily."@en ;
