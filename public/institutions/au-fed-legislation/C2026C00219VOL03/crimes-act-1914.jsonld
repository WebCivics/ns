        }
      ],
      "cml:integrityHash": "22bc8510c584ec7340350d661beebfab2290df0563c7f97a3f9020a8e4fc451b",
      "skos:note": "Taking, retention and use of forensic material is authorized by law."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yp-ss-1",
      "@type": "cof:Section",
      "cof:title": "23YP(1) Taking, retention and use of forensic material",
      "values:kind": "subsection",
      "cof:pageNumber": 123,
      "values:originalText": "(1) Nothing in this Part affects the taking, retention or use of forensic\nmaterial, or information obtained from forensic material, if the\ntaking, retention or use of the material is authorised by or under a\nlaw of a State or a Territory."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yp-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yp-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yp-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YP(2) Taking, retention and use of forensic material",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yp-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.123",
      "values:originalText": "(2) Forensic material, or information obtained from it, that was taken\nin accordance with a law of a State or a Territory may be retained\nor used for investigative, evidentiary or statistical purposes of the\nCommonwealth. The material or information may be retained or\nused even if its retention or use would, but for this subsection,\nconstitute a breach of, or failure to comply with, any provision of\nthis Part relating to the carrying out of forensic procedures.\nUse and retention of forensic material taken before commencement\nof subsection",
      "skos:definition": "(2) Forensic material, or information obtained from it, that was taken\nin accordance with a law of a State or a Territory may be retained\nor used for investigative, evidentiary or statistical purposes of the\nCommonwealth. The material or information may be retained or\nused even if its retention or use would, but for this subsection,\nconstitute a breach of, or failure to comply with, any provision of\nthis Part relating to the carrying out of forensic procedures.\nUse and retention of forensic material taken before commencement\nof subsection",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yp"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yp-ss-2-norm"
        },
