        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wt-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Obligation to consider religious beliefs",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Without limiting the matters that the magistrate may take into account...",
      "cml:conclusionText": "The magistrate must consider the religious beliefs of the suspect."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wt-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:logicSummary": "Temporal relationship between consideration and procedure",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Without limiting the matters that the magistrate may take into account...",
      "cml:conclusionText": "The magistrate must consider the religious beliefs of the suspect during the forensic procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wt-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal relationship between consideration and procedure",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Without limiting the matters that the magistrate may take into account...",
      "cml:conclusionText": "The magistrate must consider the religious beliefs of the suspect until the forensic procedure is completed."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wt-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Through",
      "cml:logicSummary": "Spread of consideration to other procedures",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Without limiting the matters that the magistrate may take into account...",
      "cml:conclusionText": "The consideration of the religious beliefs of the suspect will be spread through the forensic procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wt-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Through",
      "cml:logicSummary": "Artificial intelligence application",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Without limiting the matters that the magistrate may take into account...",
      "cml:conclusionText": "The consideration of the religious beliefs of the suspect will be processed through artificial intelligence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wu",
      "@type": "cml:Concept",
      "skos:prefLabel": "23WU Application for order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wu"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.50",
      "values:originalText": "(1) An authorised applicant (but no other person) may apply to a\nmagistrate for an order under section 23WS authorising him or her\nto arrange the carrying out of a forensic procedure on a suspect.\n\n(2) An application for an order must:\n\n(a) be made in writing; and\n\n(b) be supported by evidence on oath or by affidavit dealing with\nthe matters referred to in paragraphs 23WT(1)(a), (b), (c),\n(ca) and (d); and\n\n(c) specify the type of forensic procedure sought to be carried\nout; and\n\n(d) be made in the presence of the suspect (subject to any\ncontrary order made by the magistrate).",
      "skos:definition": "(1) An authorised applicant (but no other person) may apply to a\nmagistrate for an order under section 23WS authorising him or her\nto arrange the carrying out of a forensic procedure on a suspect.\n\n(2) An application for an order must:\n\n(a) be made in writing; and\n\n(b) be supported by evidence on oath or by affidavit dealing with\nthe matters referred to in paragraphs 23WT(1)(a), (b), (c),\n(ca) and (d); and\n\n(c) specify the type of forensic procedure sought to be carried\nout; and\n\n(d) be made in the presence of the suspect (subject to any\ncontrary order made by the magistrate).",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-23wu-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23wu-ss-2"
        }
      ],
      "cml:integrityHash": "bfed0023e9fc964a98748548f9a412ec7cd24532bf145c668fe15b7bec949fd4"
