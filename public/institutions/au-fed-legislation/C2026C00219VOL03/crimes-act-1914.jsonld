        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A person commits an offence if...",
      "cml:conclusionText": "Penalty: Imprisonment for 10 years."
    },
    {
      "@id": "concept:crimes-act-1914-sec-41-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "41(1A) Conspiracy to bring false accusation",
      "cml:realizedBy": {
