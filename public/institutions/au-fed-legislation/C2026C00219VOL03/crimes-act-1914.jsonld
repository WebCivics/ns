      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to satisfy conditions before proceeding.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The senior police officer must be satisfied on the balance of probabilities...",
      "cml:conclusionText": "The senior police officer MUST be satisfied..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wo-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Forensic procedure must be justified in all circumstances before proceeding.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the carrying out of the forensic procedure without consent is justified in all the circumstances.",
      "cml:conclusionText": "...the carrying out of the forensic procedure without consent is justified."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wo-ss-1-logic-deontic-3",
