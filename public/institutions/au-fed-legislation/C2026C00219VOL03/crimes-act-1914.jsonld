      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.102",
      "values:originalText": "(6) A magistrate to whom an application is made under subsection (5)\nis not to extend the period unless:\n\n(a) the person from whom the forensic material was taken has\nbeen notified by the applicant for the extension that the\napplication has been made; and",
      "skos:definition": "(6) A magistrate to whom an application is made under subsection (5)\nis not to extend the period unless:\n\n(a) the person from whom the forensic material was taken has\nbeen notified by the applicant for the extension that the\napplication has been made; and",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yd"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yd-ss-6-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yd-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f717de472e1bfecbc87418d4546f4dfd4c8973c15b9775a49618e53f38b2c2ec",
      "skos:note": "Magistrate must notify person from whom forensic material was taken before extending period."
    },
    {
