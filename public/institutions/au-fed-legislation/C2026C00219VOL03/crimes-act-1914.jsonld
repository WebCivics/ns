      },
      "cml:premiseText": "subsection 23WR(1) applies",
      "cml:conclusionText": "magistrate is required to order carrying out of forensic procedure"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23ws-logic-deontic-2",
