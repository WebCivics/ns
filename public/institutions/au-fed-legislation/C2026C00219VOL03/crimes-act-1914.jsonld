    },
    {
      "@id": "concept:crimes-act-1914-sec-23xw",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XW Results of analysis",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xw"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.75",
      "values:originalText": "If:\n\n(a) material from a sample taken from a suspect is analysed in\nthe investigation of the offence; and\n\n(b) before or after the analysis, the suspect has requested the\ninvestigating constable that a copy of the results of any\nanalysis be provided to the suspect;",
      "skos:definition": "If:\n\n(a) material from a sample taken from a suspect is analysed in\nthe investigation of the offence; and\n\n(b) before or after the analysis, the suspect has requested the\ninvestigating constable that a copy of the results of any\nanalysis be provided to the suspect;",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23xw-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xw-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xw-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "c1ef324e3bcced7e88aade1c4a1f7e037c329822470086f053e5fa10002d4830",
      "skos:note": "Must provide analysis results to suspect upon request.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xw",
      "@type": "cof:Section",
      "cof:title": "23XW Results of analysis",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "If:\n\n(a) material from a sample taken from a suspect is analysed in\nthe investigation of the offence; and\n\n(b) before or after the analysis, the suspect has requested the\ninvestigating constable that a copy of the results of any\nanalysis be provided to the suspect;"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xw-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
