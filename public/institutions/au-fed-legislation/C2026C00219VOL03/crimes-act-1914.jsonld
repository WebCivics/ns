      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.147",
      "values:originalText": "(1) This section applies to a person if:\n\n(a) a thing that is a computer, data storage device or other\nelectronic equipment is forfeited under this Part; and\n\n(b) the person owned, had a right to possess or had other\nproperty in the thing immediately before the forfeiture.",
      "skos:definition": "(1) This section applies to a person if:\n\n(a) a thing that is a computer, data storage device or other\nelectronic equipment is forfeited under this Part; and\n\n(b) the person owned, had a right to possess or had other\nproperty in the thing immediately before the forfeiture.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23ze"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23ze-ss-1-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23ze-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23ze-ss-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23ze-ss-1-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23ze-ss-1-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "a2cfff23741f054ea8e8692fcbba7dd23fe9ba7db0f91ba5c175e420b6f63d8d",
      "skos:note": "Person obligated to provide property if thing forfeited under Part This section applies if a thing is forfeited to the Commonwealth under this Part.",
      "dc:description": "property"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23ze-ss-1",
      "@type": "cof:Section",
      "cof:title": "23ZE(1) Effect of forfeiture under this Part",
      "values:kind": "subsection",
      "cof:pageNumber": 147,
      "values:originalText": "(1) This section applies to a person if:\n\n(a) a thing that is a computer, data storage device or other\nelectronic equipment is forfeited under this Part; and\n\n(b) the person owned, had a right to possess or had other\nproperty in the thing immediately before the forfeiture."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23ze-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
