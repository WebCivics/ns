      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must notify representative",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) inform the suspect that a representative of an Aboriginal legal assistance organisation will be notified...",
      "cml:conclusionText": "...the suspect is to be asked to consent to a forensic procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must notify representative",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) notify such a representative that the suspect is to be asked to consent to a forensic procedure.",
      "cml:conclusionText": "...the suspect is to be asked to consent to a forensic procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEGINS",
      "cml:logicSummary": "Notify representative before request",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) notify such a representative that the suspect is to be asked to consent to a forensic procedure.",
      "cml:conclusionText": "...the suspect is to be asked to consent to a forensic procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "23WG(5) Informed consent to forensic procedures—Aboriginal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wg-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.34",
      "values:originalText": "(5) The constable is not required to comply with subsection (4) if:\n\n(a) he or she is aware that the suspect has arranged for a legal\npractitioner to be present while the suspect is asked to\nconsent to the forensic procedure; or\n\n(b) paragraph (3)(b) or (c) applies.",
      "skos:definition": "(5) The constable is not required to comply with subsection (4) if:\n\n(a) he or she is aware that the suspect has arranged for a legal\npractitioner to be present while the suspect is asked to\nconsent to the forensic procedure; or\n\n(b) paragraph (3)(b) or (c) applies.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23wg"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23wg-ss-5-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23wg-ss-5-logic-deontic-1"
        },
        {
