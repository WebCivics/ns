    {
      "@id": "concept:crimes-act-1914-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Evidence of certain matters",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
