    {
      "@id": "concept:crimes-act-1914-sec-23xb-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XB(9) Application for interim order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xb-ss-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
