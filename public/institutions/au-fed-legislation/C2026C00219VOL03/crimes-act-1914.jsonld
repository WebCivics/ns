      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Informed consent is required.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
