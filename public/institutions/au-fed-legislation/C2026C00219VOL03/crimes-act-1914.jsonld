      "@type": "cof:Section",
      "cof:title": "85U Obstructing carriage of articles by post",
      "values:kind": "section",
      "cof:pageNumber": 179,
      "values:originalText": "A person shall not intentionally obstruct or hinder the carriage by\npost of any article.\nPenalty: Imprisonment for 2 years."
    },
