    {
      "@id": "concept:crimes-act-1914-sec-86d",
      "@type": "cml:Concept",
      "skos:prefLabel": "86D Target entity may use personal information for integrity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-86d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
