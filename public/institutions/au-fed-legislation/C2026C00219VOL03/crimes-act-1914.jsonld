    {
      "@id": "concept:crimes-act-1914-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Preventing witnesses from attending Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.159",
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) another person has been subpoenaed or summoned to attend\nas a witness in a judicial proceeding; and\n\n(b) the first person prevents the other person from attending as a\nwitness, or from producing anything in evidence, pursuant to\nthe subpoena or summons; and\n\n(c) the judicial proceeding is a federal judicial proceeding.\nPenalty: Imprisonment for 1 year.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "skos:definition": "(1) A person (the first person) commits an offence if:\n\n(a) another person has been subpoenaed or summoned to attend\nas a witness in a judicial proceeding; and\n\n(b) the first person prevents the other person from attending as a\nwitness, or from producing anything in evidence, pursuant to\nthe subpoena or summons; and\n\n(c) the judicial proceeding is a federal judicial proceeding.\nPenalty: Imprisonment for 1 year.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-40-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-40-ss-2"
        }
      ],
      "cml:integrityHash": "e0cee2f9fec644b2ed1deee021eb5b8a2b332880f21f63a91c9d7b03bfb3744b"
    },
