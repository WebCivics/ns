          "@id": "concept:crimes-act-1914-sec-85w-ss-4"
        }
      ],
      "cml:integrityHash": "72231043bc1807e6f740b235eb7511ecb33255a6a375435631196de8a9750d4b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85w",
