    {
      "@id": "concept:crimes-act-1914-sec-23wm-ss-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "23WM(2A) Non-intimate forensic procedure may be carried out by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wm-ss-2a"
      },
      "cml:curationStatus": {
