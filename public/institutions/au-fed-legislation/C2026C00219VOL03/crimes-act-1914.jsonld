      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Forensic procedure must be carried out while the suspect is not being questioned as defined in subsection 23B(6).",
      "cml:conclusionText": "Must not be carried out while the suspect is being questioned as defined in subsection 23B(6)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xi-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits carrying out forensic procedures in certain circumstances.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Forensic procedure must be carried out in circumstances affording reasonable privacy to the suspect.",
      "cml:conclusionText": "Must not involve more visual inspection than is necessary for the carrying out of the procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xj",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XJ Use of force in carrying out forensic procedures",
      "cml:realizedBy": {
