      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the first person intentionally or negligently permits the prisoner to escape from the detention; and...",
      "cml:conclusionText": "...the detention is lawful federal criminal detention."
    },
    {
      "@id": "concept:crimes-act-1914-sec-47c-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of actions that facilitate escape from detention.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the detention is lawful federal criminal detention.",
      "cml:conclusionText": "...the first person intentionally or negligently permits the prisoner to escape..."
    },
