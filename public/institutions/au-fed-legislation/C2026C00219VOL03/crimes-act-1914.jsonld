          "@id": "concept:crimes-act-1914-sec-53-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "261ac3776dd32a305c267910ec22ff2b5d35e6349101816439d184dbbbb9d4ce",
      "skos:note": "Conditions for returning a ship, aircraft or thing"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-53-ss-4",
      "@type": "cof:Section",
      "cof:title": "53(4) Operating a pirate-controlled ship or aircraft",
      "values:kind": "subsection",
      "cof:pageNumber": 172,
      "values:originalText": "(4) An order to return a ship, aircraft or thing may be made subject to\nconditions, including conditions as to the payment to the\nCommonwealth of reasonable costs of seizure and detention and\nconditions as to the giving of security for payment of its value\nshould it be forfeited."
    },
