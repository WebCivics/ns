      },
      "dc:source": "crimes-act-1914.pdf, p.48",
      "values:originalText": "A magistrate may order the carrying out of a forensic procedure on\na suspect if:\n\n(a) subsection 23WR(1) applies; and\n\n(b) the magistrate is satisfied as required by section 23WT.",
      "skos:definition": "A magistrate may order the carrying out of a forensic procedure on\na suspect if:\n\n(a) subsection 23WR(1) applies; and\n\n(b) the magistrate is satisfied as required by section 23WT.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23ws-norm"
        },
