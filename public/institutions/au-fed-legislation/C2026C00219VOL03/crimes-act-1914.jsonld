    },
    {
      "@id": "concept:crimes-act-1914-sec-23yl",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YL Liability for forensic procedures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.120",
      "values:originalText": "No civil or criminal liability is incurred by any person (including a\nconstable) who carries out, or helps to carry out, a forensic\nprocedure under this Part in respect of anything properly and\nnecessarily done in good faith by the person in carrying out or\nhelping to carry out the forensic procedure if the person believed\non reasonable grounds that:\n\n(a) informed consent had been given to the carrying out of the\nforensic procedure; or\n\n(b) the carrying out of the forensic procedure without informed\nconsent had been duly ordered by a constable or magistrate\nunder this Part.\nNote:\nThis section does not provide any protection in respect of action taken\nmaliciously.",
      "skos:definition": "No civil or criminal liability is incurred by any person (including a\nconstable) who carries out, or helps to carry out, a forensic\nprocedure under this Part in respect of anything properly and\nnecessarily done in good faith by the person in carrying out or\nhelping to carry out the forensic procedure if the person believed\non reasonable grounds that:\n\n(a) informed consent had been given to the carrying out of the\nforensic procedure; or\n\n(b) the carrying out of the forensic procedure without informed\nconsent had been duly ordered by a constable or magistrate\nunder this Part.\nNote:\nThis section does not provide any protection in respect of action taken\nmaliciously.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yl-norm"
        }
      ],
      "cml:integrityHash": "33f2a1a35d6f208aaf02431f23c255d25e01d686e003215d10618e95396c00bb",
      "skos:note": "No liability for civil or criminal actions in good faith during forensic procedures."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yl",
      "@type": "cof:Section",
      "cof:title": "23YL Liability for forensic procedures",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "No civil or criminal liability is incurred by any person (including a\nconstable) who carries out, or helps to carry out, a forensic\nprocedure under this Part in respect of anything properly and\nnecessarily done in good faith by the person in carrying out or\nhelping to carry out the forensic procedure if the person believed\non reasonable grounds that:\n\n(a) informed consent had been given to the carrying out of the\nforensic procedure; or\n\n(b) the carrying out of the forensic procedure without informed\nconsent had been duly ordered by a constable or magistrate\nunder this Part.\nNote:\nThis section does not provide any protection in respect of action taken\nmaliciously."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yl-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
