      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffuses the seizure operation to multiple jurisdictions.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
