    },
    {
      "@id": "concept:crimes-act-1914-sec-23zb-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "23ZB(5) Forfeiture of material by operation of law",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23zb-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.140",
      "values:originalText": "(5) If there is not an objection described in paragraph (3)(c), the\nforfeitable thing is forfeited to the Commonwealth (by force of this\nsubsection) at the end of the period described in that paragraph.",
      "skos:definition": "(5) If there is not an objection described in paragraph (3)(c), the\nforfeitable thing is forfeited to the Commonwealth (by force of this\nsubsection) at the end of the period described in that paragraph.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23zb"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23zb-ss-5-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23zb-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "798cccaeab96a57a1494b1049acc6ce0e8902941c3c08ccccc90657c4ad2c480",
      "skos:note": "Forfeiture of material to Commonwealth at end of period if no objection"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23zb-ss-5",
      "@type": "cof:Section",
      "cof:title": "23ZB(5) Forfeiture of material by operation of law",
      "values:kind": "subsection",
      "cof:pageNumber": 140,
      "values:originalText": "(5) If there is not an objection described in paragraph (3)(c), the\nforfeitable thing is forfeited to the Commonwealth (by force of this\nsubsection) at the end of the period described in that paragraph."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zb-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23zb-ss-5"
      },
