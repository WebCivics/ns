    {
      "@id": "concept:crimes-act-1914-sec-86b",
      "@type": "cml:Concept",
      "skos:prefLabel": "86B Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-86b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.221",
      "values:originalText": "This Part authorises collection, use and disclosure of personal\ninformation for preventing, detecting, investigating or dealing\nwith:\n\n(a)\nserious misconduct by persons working for\nCommonwealth bodies; or\n\n(b)\nfraud affecting Commonwealth bodies; or\n\n(c)\noffences against Chapter 7 of the Criminal Code (which\nis about the proper administration of Government).\nThe authorisation is relevant to laws (such as privacy laws) that\nlimit the collection, use and disclosure of personal information\nunless authorised by law.",
      "skos:definition": "This Part authorises collection, use and disclosure of personal\ninformation for preventing, detecting, investigating or dealing\nwith:\n\n(a)\nserious misconduct by persons working for\nCommonwealth bodies; or\n\n(b)\nfraud affecting Commonwealth bodies; or\n\n(c)\noffences against Chapter 7 of the Criminal Code (which\nis about the proper administration of Government).\nThe authorisation is relevant to laws (such as privacy laws) that\nlimit the collection, use and disclosure of personal information\nunless authorised by law.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-86b-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-86b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e590452085c11c538d72d3a6ee64c401d457dbe55e4129e32c27b490c66bd8f9",
      "skos:note": "Authorization for collection, use and disclosure of personal information"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-86b",
      "@type": "cof:Section",
      "cof:title": "86B Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 221,
      "values:originalText": "This Part authorises collection, use and disclosure of personal\ninformation for preventing, detecting, investigating or dealing\nwith:\n\n(a)\nserious misconduct by persons working for\nCommonwealth bodies; or\n\n(b)\nfraud affecting Commonwealth bodies; or\n\n(c)\noffences against Chapter 7 of the Criminal Code (which\nis about the proper administration of Government).\nThe authorisation is relevant to laws (such as privacy laws) that\nlimit the collection, use and disclosure of personal information\nunless authorised by law."
    },
    {
      "@id": "concept:crimes-act-1914-sec-86b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-86b"
