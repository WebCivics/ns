        },
        {
          "@id": "concept:crimes-act-1914-sec-23ws-logic-ltl-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23ws-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "c0728a3e9da8cfa1086cc17452bf2497fb04809e747c9b8c03912cb54972bca4",
      "skos:note": "Magistrate must order carrying out of forensic procedure under specified conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23ws",
      "@type": "cof:Section",
      "cof:title": "23WS Final order for carrying out of forensic procedure",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "A magistrate may order the carrying out of a forensic procedure on\na suspect if:\n\n(a) subsection 23WR(1) applies; and\n\n(b) the magistrate is satisfied as required by section 23WT."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23ws-norm",
