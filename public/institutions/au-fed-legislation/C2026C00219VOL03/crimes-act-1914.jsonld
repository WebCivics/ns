        }
      ],
      "cml:integrityHash": "d3ad77d72f5907557c0148e223a21cf2e8fc1a901b779c0be4621da33f0bbeae",
      "skos:note": "A person is authorised to carry out a forensic procedure on a suspect by order of a magistrate."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wq",
      "@type": "cof:Section",
      "cof:title": "23WQ Forensic procedure may be carried out by order of",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "magistrate\n\nA person is authorised to carry out a forensic procedure on a\nsuspect by order of a magistrate under section 23WS or 23XA. The\nperson is authorised to carry out the procedure in accordance with\nDivision 6 and not otherwise."
    },
