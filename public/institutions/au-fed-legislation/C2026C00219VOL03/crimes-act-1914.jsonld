    {
      "@id": "concept:crimes-act-1914-sec-85u",
      "@type": "cml:Concept",
      "skos:prefLabel": "85U Obstructing carriage of articles by post",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.179",
      "values:originalText": "A person shall not intentionally obstruct or hinder the carriage by\npost of any article.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "A person shall not intentionally obstruct or hinder the carriage by\npost of any article.\nPenalty: Imprisonment for 2 years.",
