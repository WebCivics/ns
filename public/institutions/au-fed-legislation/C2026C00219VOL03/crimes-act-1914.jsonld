      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Spread of presence requirement to related individuals.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Either an interview friend or a legal representative (if he or she is not the interview friend) of the suspect must be present while the forensic procedure is carried out.",
      "cml:conclusionText": "The presence requirement spreads to related individuals."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Rationale for requiring presence of interview friend or legal representative.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Either an interview friend or a legal representative (if he or she is not the interview friend) of the suspect must be present while the forensic procedure is carried out.",
      "cml:conclusionText": "The rationale is that either an interview friend or a legal representative must be present."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XR(3) Presence of interview friend or legal representative—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xr-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
