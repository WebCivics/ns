      "cml:integrityHash": "fb75fe3c14d292ee6b6f17c390643e589d93e918f69430e28d1e33f1c7f02b97",
      "skos:note": "Sharing of sample material with suspect"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xu-ss-1",
      "@type": "cof:Section",
      "cof:title": "23XU(1) Samples—sufficient material to share",
      "values:kind": "subsection",
      "cof:pageNumber": 73,
      "values:originalText": "(1) This section applies if:\n\n(a) a sample is taken from a suspect under this Part; and\n\n(b) the suspect requests the investigating constable that the\nsample be shared; and\n\n(c) there is sufficient material to be analysed both in the\ninvestigation of the offence and on behalf of the suspect."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xu-ss-1-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
