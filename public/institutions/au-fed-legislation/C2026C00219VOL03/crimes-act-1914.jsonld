        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.222",
      "values:originalText": "purpose\n\nA target entity may use personal information for an integrity\npurpose relating to the entity.",
      "skos:definition": "purpose\n\nA target entity may use personal information for an integrity\npurpose relating to the entity.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-86d-norm"
        }
      ],
      "cml:integrityHash": "511f9be102bb44b13498c9b2c9e496ba9eca9cabbd3228531a426899b40840f3",
      "skos:note": "Target entity may use personal information for integrity purpose relating to the entity."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-86d",
      "@type": "cof:Section",
      "cof:title": "86D Target entity may use personal information for integrity",
      "values:kind": "section",
      "cof:pageNumber": 222,
      "values:originalText": "purpose\n\nA target entity may use personal information for an integrity\npurpose relating to the entity."
    },
    {
      "@id": "concept:crimes-act-1914-sec-86d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-86d"
