      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The constable is not required to comply with subsection (4) if...",
      "cml:conclusionText": "The exemption applies during this time period."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-5-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Justification",
      "cml:logicSummary": "The exemption is justified by the presence of a legal practitioner.",
