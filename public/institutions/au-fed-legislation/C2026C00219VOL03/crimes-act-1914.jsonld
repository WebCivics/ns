      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xu-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Granting permission to share sample material",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared;",
      "cml:conclusionText": "There is sufficient material to be analysed both in the investigation of the offence and on behalf of the suspect."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xu-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Temporal overlap between request and analysis",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) This section applies if: (a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared;",
      "cml:conclusionText": "The request to share the sample material overlaps with the analysis."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xu-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal relationship between request and analysis",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) This section applies if: (a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared;",
      "cml:conclusionText": "The request to share the sample material occurs before or at the same time as the analysis."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xu-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Propagation of request through investigation",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) This section applies if: (a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared;",
      "cml:conclusionText": "The request to share the sample material spreads through the investigation."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xu-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Inference of sufficiency from conditions",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) This section applies if: (a) a sample is taken from a suspect under this Part; and (b) the suspect requests the investigating constable that the sample be shared;",
      "cml:conclusionText": "If the conditions are met, then there is sufficient material to share."
    },
