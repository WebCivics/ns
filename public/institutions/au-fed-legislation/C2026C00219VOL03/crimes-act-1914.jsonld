    {
      "@id": "concept:crimes-act-1914-sec-23ys",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YS Relationship with Part IC",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23ys"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
