    {
      "@id": "concept:crimes-act-1914-sec-85r",
      "@type": "cml:Concept",
      "skos:prefLabel": "85R Wrongful delivery of postal messages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85r"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.178",
      "values:originalText": "A person shall not intentionally cause a postal message to be\ndelivered to or received by a person other than the person to whom\nit is directed or that person’s authorised agent.\n\n\nOffences relating to postal services  Part VIIA\n\nSection 85T\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\nPenalty: Imprisonment for 1 year.",
      "skos:definition": "A person shall not intentionally cause a postal message to be\ndelivered to or received by a person other than the person to whom\nit is directed or that person’s authorised agent.\n\n\nOffences relating to postal services  Part VIIA\n\nSection 85T\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\nPenalty: Imprisonment for 1 year.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-85r-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85r-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "790be4e69b2ce746bd5f5a5eed1886d313907cd6c34896f2375466ec57b87cd3",
      "skos:note": "Prohibits intentionally delivering postal messages to unauthorized recipients."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85r",
      "@type": "cof:Section",
      "cof:title": "85R Wrongful delivery of postal messages",
      "values:kind": "section",
      "cof:pageNumber": 178,
      "values:originalText": "A person shall not intentionally cause a postal message to be\ndelivered to or received by a person other than the person to whom\nit is directed or that person’s authorised agent.\n\n\nOffences relating to postal services  Part VIIA\n\nSection 85T\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\nPenalty: Imprisonment for 1 year."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85r-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
