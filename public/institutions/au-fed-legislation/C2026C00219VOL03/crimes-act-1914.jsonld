    {
      "@id": "concept:crimes-act-1914-sec-23yn",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YN Retention of electronic recordings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.120",
      "values:originalText": "(1) A tape recording made by a constable in accordance with this Part\nthat is no longer required for investigative or evidentiary purposes\nmay be retained for such other purposes, and for such period, as the\nCommissioner directs.\n\n(2) A recording that is retained under this section is to be stored so as\nto protect it against unauthorised access or use by any person.",
      "skos:definition": "(1) A tape recording made by a constable in accordance with this Part\nthat is no longer required for investigative or evidentiary purposes\nmay be retained for such other purposes, and for such period, as the\nCommissioner directs.\n\n(2) A recording that is retained under this section is to be stored so as\nto protect it against unauthorised access or use by any person.",
      "cml:hasPart": [
