        },
        {
          "@id": "concept:crimes-act-1914-sec-41-ss-2-logic-deontic-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-41-ss-2-logic-alleninterval-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-41-ss-2-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "f20d6c16921d3fac62c8c55840cbc6c54a8ee077a74c0f8019a0897ba228494a",
      "skos:note": "Agreement required for conspiracy to bring false accusation"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-41-ss-2",
      "@type": "cof:Section",
      "cof:title": "41(2) Conspiracy to bring false accusation",
      "values:kind": "subsection",
      "cof:pageNumber": 160,
      "values:originalText": "(2) For a person to be guilty of an offence against subsection (1):\n\n(a) the person must have entered into an agreement with one or\nmore other persons; and\n\n(b) the person and at least one other party to the agreement must\nhave intended that a person be charged falsely with an\noffence pursuant to the agreement; and\n\n(c) the person or at least one other party to the agreement must\nhave committed an overt act pursuant to the agreement."
    },
