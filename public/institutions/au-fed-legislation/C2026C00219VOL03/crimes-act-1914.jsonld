    {
      "@id": "concept:crimes-act-1914-sec-23yd-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YD(5) Destruction of forensic material after 12 months",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yd-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.102",
      "values:originalText": "(5) A magistrate may, on application by a constable or the Director of\nPublic Prosecutions, extend for a period not exceeding 12 months\nthe period for which forensic material may be retained under this\nsection, if the magistrate is satisfied there are special reasons for\ndoing so.",
      "skos:definition": "(5) A magistrate may, on application by a constable or the Director of\nPublic Prosecutions, extend for a period not exceeding 12 months\nthe period for which forensic material may be retained under this\nsection, if the magistrate is satisfied there are special reasons for\ndoing so.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yd"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yd-ss-5-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yd-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5c5544e9bd50684ed800c278a48554aaecdf53885bb5dfc0d35da4d3ddccb87a",
      "skos:note": "Magistrate may extend retention period for forensic material under special reasons."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yd-ss-5",
      "@type": "cof:Section",
      "cof:title": "23YD(5) Destruction of forensic material after 12 months",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(5) A magistrate may, on application by a constable or the Director of\nPublic Prosecutions, extend for a period not exceeding 12 months\nthe period for which forensic material may be retained under this\nsection, if the magistrate is satisfied there are special reasons for\ndoing so."
    },
