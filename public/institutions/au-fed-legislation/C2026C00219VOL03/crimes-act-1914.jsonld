    {
      "@id": "concept:crimes-act-1914-sec-23wb-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23WB(2) Interview friends",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wb-ss-2"
      },
