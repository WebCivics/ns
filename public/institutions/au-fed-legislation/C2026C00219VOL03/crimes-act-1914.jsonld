      },
      "cml:premiseText": "(2) A suspect not covered by section 23WE gives informed consent to a forensic procedure...",
      "cml:conclusionText": "The suspect must give informed consent"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-2-logic-deontic-2",
