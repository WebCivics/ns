    {
      "@id": "concept:crimes-act-1914-sec-23yh",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YH No charge to be made for giving material etc. to suspects,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.118",
      "values:originalText": "offenders and volunteers\n\nIf a provision of this Part requires material of any kind to be given\nto a suspect, offender or volunteer, or an opportunity to view a\nvideo recording to be given to a suspect, offender or volunteer, the\nmaterial or the opportunity to view the video must be given\nwithout charge.\n\n\nForensic procedures  Part ID\nGeneral provisions relating to operation of this Part  Division 9\n\nSection 23YI\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "offenders and volunteers\n\nIf a provision of this Part requires material of any kind to be given\nto a suspect, offender or volunteer, or an opportunity to view a\nvideo recording to be given to a suspect, offender or volunteer, the\nmaterial or the opportunity to view the video must be given\nwithout charge.\n\n\nForensic procedures  Part ID\nGeneral provisions relating to operation of this Part  Division 9\n\nSection 23YI\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yh-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "02fe555b85e1148d661a62eda6841f6545191c18fc9df6f2523b6442a85c1ee0",
      "skos:note": "No charge for providing material or video recording to suspects, offenders, or volunteers.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yh",
      "@type": "cof:Section",
      "cof:title": "23YH No charge to be made for giving material etc. to suspects,",
      "values:kind": "section",
      "cof:pageNumber": 118,
      "values:originalText": "offenders and volunteers\n\nIf a provision of this Part requires material of any kind to be given\nto a suspect, offender or volunteer, or an opportunity to view a\nvideo recording to be given to a suspect, offender or volunteer, the\nmaterial or the opportunity to view the video must be given\nwithout charge.\n\n\nForensic procedures  Part ID\nGeneral provisions relating to operation of this Part  Division 9\n\nSection 23YI\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yh-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
