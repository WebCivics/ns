    },
    {
      "@id": "concept:crimes-act-1914-sec-53-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "53(4) Operating a pirate-controlled ship or aircraft",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-53-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
