        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Head of police force has authority",
      "cml:conclusionText": "Must instruct Director"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zb-ss-6-logic-descriptionlogic-2",
