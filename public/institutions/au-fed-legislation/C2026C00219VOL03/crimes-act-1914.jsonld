    {
      "@id": "concept:crimes-act-1914-sec-23ze-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "23ZE(1) Effect of forfeiture under this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23ze-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
