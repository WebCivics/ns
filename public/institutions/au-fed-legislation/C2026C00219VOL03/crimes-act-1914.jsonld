      ],
      "cml:integrityHash": "ac5427f25c9e99ff62766edd1a0c6a0e4c1682d420d8d54519d70ddea7e2c3df",
      "skos:note": "Absolute liability applies to the paragraph (1)(b) element of the offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-49-ss-2",
      "@type": "cof:Section",
      "cof:title": "49(2) Removing property under seizure",
      "values:kind": "subsection",
      "cof:pageNumber": 170,
      "values:originalText": "(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.\n\n\nPiracy  Part IV\n\nSection 51\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-49-ss-2-norm",
