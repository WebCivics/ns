      "skos:note": "No act of piracy is allowed."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Piracy",
      "values:kind": "section",
      "cof:pageNumber": 172,
