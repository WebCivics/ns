        },
        {
          "@id": "concept:crimes-act-1914-sec-23wg-ss-5-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "e2402e5527820ec2f60a79ce0f19bb7a673fcfbe07e1e8f60b0384d85c487b89",
      "skos:note": "Exemption from compliance with subsection (4) under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wg-ss-5",
      "@type": "cof:Section",
      "cof:title": "23WG(5) Informed consent to forensic procedures—Aboriginal",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(5) The constable is not required to comply with subsection (4) if:\n\n(a) he or she is aware that the suspect has arranged for a legal\npractitioner to be present while the suspect is asked to\nconsent to the forensic procedure; or\n\n(b) paragraph (3)(b) or (c) applies."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wg-ss-5-norm",
