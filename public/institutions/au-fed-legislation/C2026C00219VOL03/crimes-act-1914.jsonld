    {
      "@id": "concept:crimes-act-1914-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Conspiracy to defeat justice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.161",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person conspires with another person to obstruct, to\nprevent, to pervert or to defeat the course of justice in\nrelation to a judicial power; and\n\n(b) the judicial power is the judicial power of the\nCommonwealth.\nPenalty: Imprisonment for 10 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.\n\n(3) For a person to be guilty of an offence against subsection (1):",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person conspires with another person to obstruct, to\nprevent, to pervert or to defeat the course of justice in\nrelation to a judicial power; and\n\n(b) the judicial power is the judicial power of the\nCommonwealth.\nPenalty: Imprisonment for 10 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.\n\n(3) For a person to be guilty of an offence against subsection (1):",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-42-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-42-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-42-ss-3"
        }
      ],
      "cml:integrityHash": "bb5c7e8800792558921f78775d8bdffd30b9461ea5504002e205de56d7fe475e"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Conspiracy to defeat justice",
