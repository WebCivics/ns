      "cml:logicSummary": "Forensic procedure may be carried out before subsection 23WR(1) applies.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
