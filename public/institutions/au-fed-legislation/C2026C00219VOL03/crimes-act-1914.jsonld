    },
    {
      "@id": "concept:crimes-act-1914-sec-23xv",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XV Photographs",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xv"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.75",
      "values:originalText": "Where a forensic procedure involves the taking of a photograph of\na part of a suspect’s body, the investigating constable must ensure\nthat a copy of the photograph is made available to the suspect.\nNote:\nDivision 9 contains provisions about making copies of material\navailable to the suspect.",
      "skos:definition": "Where a forensic procedure involves the taking of a photograph of\na part of a suspect’s body, the investigating constable must ensure\nthat a copy of the photograph is made available to the suspect.\nNote:\nDivision 9 contains provisions about making copies of material\navailable to the suspect.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23xv-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xv-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "53dd23cd7107c70f349a8484c261d1c869b69d809ff925fedbaf57b8d31f5fd2",
      "skos:note": "Suspect must be provided with a copy of the photograph taken during forensic procedure.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xv",
      "@type": "cof:Section",
      "cof:title": "23XV Photographs",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "Where a forensic procedure involves the taking of a photograph of\na part of a suspect’s body, the investigating constable must ensure\nthat a copy of the photograph is made available to the suspect.\nNote:\nDivision 9 contains provisions about making copies of material\navailable to the suspect."
    },
    {
