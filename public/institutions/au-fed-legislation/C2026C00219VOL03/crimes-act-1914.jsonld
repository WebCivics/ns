      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Forensic procedure must be carried out after subsection 23WR(1) applies.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "subsection 23WR(1) applies",
      "cml:conclusionText": "forensic procedure is carried out at some point after subsection 23WR(1) applies"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23ws-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
