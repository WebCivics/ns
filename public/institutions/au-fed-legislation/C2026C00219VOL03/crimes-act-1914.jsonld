    {
      "@id": "concept:crimes-act-1914-sec-90a",
      "@type": "cml:Concept",
      "skos:prefLabel": "90A Destroying etc. posters etc. relating to Commonwealth loans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-90a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.226",
      "values:originalText": "A person shall not, without lawful authority, destroy, injure,\ndisfigure or remove a poster, advertisement or notice relating to a\nCommonwealth loan.\nPenalty: Imprisonment for 1 year.",
      "skos:definition": "A person shall not, without lawful authority, destroy, injure,\ndisfigure or remove a poster, advertisement or notice relating to a\nCommonwealth loan.\nPenalty: Imprisonment for 1 year.",
      "cml:asserts": [
