    {
      "@id": "concept:crimes-act-1914-sec-23xh",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XH Restrictions on publication",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.61",
      "values:originalText": "A person must not intentionally, in any report of a proceeding\nunder this Division, publish:\n\n(a) the name of the suspect; or\n\n(b) any information likely to enable the identification of the\nsuspect;\nunless the suspect has been charged with a relevant offence or the\nmagistrate, by order, has authorised such publication.\nPenalty: Imprisonment for 12 months.",
      "skos:definition": "A person must not intentionally, in any report of a proceeding\nunder this Division, publish:\n\n(a) the name of the suspect; or\n\n(b) any information likely to enable the identification of the\nsuspect;\nunless the suspect has been charged with a relevant offence or the\nmagistrate, by order, has authorised such publication.\nPenalty: Imprisonment for 12 months.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23xh-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xh-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3eb3765a66e717d287071243dee8b3c467a528121ab8ba38a249e6700a04d742",
      "skos:note": "Restrictions on publication of suspect information"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xh",
      "@type": "cof:Section",
      "cof:title": "23XH Restrictions on publication",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "A person must not intentionally, in any report of a proceeding\nunder this Division, publish:\n\n(a) the name of the suspect; or\n\n(b) any information likely to enable the identification of the\nsuspect;\nunless the suspect has been charged with a relevant offence or the\nmagistrate, by order, has authorised such publication.\nPenalty: Imprisonment for 12 months."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xh-norm",
