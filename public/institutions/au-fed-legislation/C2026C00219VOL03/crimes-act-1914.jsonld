    {
      "@id": "concept:crimes-act-1914-sec-87",
      "@type": "cml:Concept",
      "skos:prefLabel": "87 False certificates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-87"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.224",
      "values:originalText": "Any person who, being authorized or required by a law of the\nCommonwealth to give any certificate touching any matter by\nvirtue whereof the rights of any person may be harmfully affected,\ngives a certificate which is, to his or her knowledge, false in any\nmaterial particular, commits an offence.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "Any person who, being authorized or required by a law of the\nCommonwealth to give any certificate touching any matter by\nvirtue whereof the rights of any person may be harmfully affected,\ngives a certificate which is, to his or her knowledge, false in any\nmaterial particular, commits an offence.\nPenalty: Imprisonment for 2 years.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-87-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-87-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5f1d401ab06d53e1ba5da0a4cde919c6b256a289360bde70a74662d87cb85dec",
      "skos:note": "Giving false certificates is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-87",
      "@type": "cof:Section",
      "cof:title": "87 False certificates",
      "values:kind": "section",
      "cof:pageNumber": 224,
      "values:originalText": "Any person who, being authorized or required by a law of the\nCommonwealth to give any certificate touching any matter by\nvirtue whereof the rights of any person may be harmfully affected,\ngives a certificate which is, to his or her knowledge, false in any\nmaterial particular, commits an offence.\nPenalty: Imprisonment for 2 years."
    },
    {
      "@id": "concept:crimes-act-1914-sec-87-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
