    {
      "@id": "concept:crimes-act-1914-sec-23yr",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YR Relationship with Part IAA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.128",
      "values:originalText": "This Part does not apply to the taking of hand prints, finger prints,\nfoot prints or toe prints:\n\n(a) from a suspect who is under 18 years of age or is incapable\nof managing his or her affairs, if the suspect has been\narrested and charged as mentioned in section 3ZJ; or\n\n(b) from a suspect who is at least 18 years of age and is capable\nof managing his or her affairs, if the suspect is in lawful\ncustody in respect of an offence as mentioned in section 3ZJ.\nNote:\nPart IAA deals with the taking of identification material as defined in\nsubsection 3ZJ(1) (which includes prints) from suspects described in\nparagraphs 23YR(a) and (b).",
      "skos:definition": "This Part does not apply to the taking of hand prints, finger prints,\nfoot prints or toe prints:\n\n(a) from a suspect who is under 18 years of age or is incapable\nof managing his or her affairs, if the suspect has been\narrested and charged as mentioned in section 3ZJ; or\n\n(b) from a suspect who is at least 18 years of age and is capable\nof managing his or her affairs, if the suspect is in lawful\ncustody in respect of an offence as mentioned in section 3ZJ.\nNote:\nPart IAA deals with the taking of identification material as defined in\nsubsection 3ZJ(1) (which includes prints) from suspects described in\nparagraphs 23YR(a) and (b).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yr-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yr-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yr-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "67420ba02b9c6cea83c759d8e00bd0a54767135c97b9246ee112ddd2146d7c15",
      "skos:note": "Exemptions from taking identification material from suspects under 18 or in lawful custody"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yr",
      "@type": "cof:Section",
      "cof:title": "23YR Relationship with Part IAA",
      "values:kind": "section",
      "cof:pageNumber": 128,
      "values:originalText": "This Part does not apply to the taking of hand prints, finger prints,\nfoot prints or toe prints:\n\n(a) from a suspect who is under 18 years of age or is incapable\nof managing his or her affairs, if the suspect has been\narrested and charged as mentioned in section 3ZJ; or\n\n(b) from a suspect who is at least 18 years of age and is capable\nof managing his or her affairs, if the suspect is in lawful\ncustody in respect of an offence as mentioned in section 3ZJ.\nNote:\nPart IAA deals with the taking of identification material as defined in\nsubsection 3ZJ(1) (which includes prints) from suspects described in\nparagraphs 23YR(a) and (b)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yr-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yr"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yr-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits taking identification material from specified suspects",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
