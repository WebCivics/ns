      },
      "cml:operator": "MUST PROVIDE",
      "cml:logicSummary": "Must provide analysis results to suspect upon request.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
