    },
    {
      "@id": "concept:crimes-act-1914-sec-85zn-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "If the conviction has been quashed or set aside, then the person's conviction of the offence shall be taken to have been quashed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "conviction has been quashed or set aside",
      "cml:conclusionText": "person's conviction of the offence shall be taken to have been quashed"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zn-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "The finding of guilt has been quashed or set aside during the period when the court's decision to take the offence into account was made.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "finding of guilt has been quashed or set aside",
      "cml:conclusionText": "court's decision to take the offence into account was made"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zn-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "during",
      "cml:logicSummary": "The person's conviction of the other offence has been quashed or set aside during the period when the court's decision to take the offence into account was made.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "person's conviction of the other offence",
      "cml:conclusionText": "court's decision to take the offence into account was made"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zn-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "If the court's decision to take the offence into account has been set aside, then the person's conviction of the offence shall be taken to have been quashed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "court's decision to take the offence into account has been set aside",
      "cml:conclusionText": "person's conviction of the offence shall be taken to have been quashed"
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zp",
      "@type": "cml:Concept",
      "skos:prefLabel": "85ZP Application of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.190",
      "values:originalText": "(1) This Part applies in relation to a person convicted of an offence\nwhether the person was convicted before or after the\ncommencement of this Part.\n\n(2) A reference in this Part to a person convicted of an offence does\nnot include a reference to a body corporate.\n\n(3) Nothing in this Part authorises a person or body to disclose or take\ninto account a conviction of an offence if to do so would\ncontravene any Commonwealth law, State law, Territory law or\nforeign law.\nNote:\nThere are exceptions in sections 85ZZJC (use and disclosure of spent\nconviction etc. information by ASIO, ACC and other intelligence or\nsecurity agencies) and 85ZZL (criminal proceedings before the\nFederal Court of Australia).\n\n(4) Nothing in this Part affects anything lawfully done before a pardon\nis granted or a conviction is quashed or spent.",
      "skos:definition": "(1) This Part applies in relation to a person convicted of an offence\nwhether the person was convicted before or after the\ncommencement of this Part.\n\n(2) A reference in this Part to a person convicted of an offence does\nnot include a reference to a body corporate.\n\n(3) Nothing in this Part authorises a person or body to disclose or take\ninto account a conviction of an offence if to do so would\ncontravene any Commonwealth law, State law, Territory law or\nforeign law.\nNote:\nThere are exceptions in sections 85ZZJC (use and disclosure of spent\nconviction etc. information by ASIO, ACC and other intelligence or\nsecurity agencies) and 85ZZL (criminal proceedings before the\nFederal Court of Australia).\n\n(4) Nothing in this Part affects anything lawfully done before a pardon\nis granted or a conviction is quashed or spent.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-85zp-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zp-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zp-ss-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zp-ss-4"
        }
      ],
      "cml:integrityHash": "c7c235c4e79dfbfaefe639f16b85ffc1893528fe51cf8fe040486cbb1fd67f7b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zp",
      "@type": "cof:Section",
      "cof:title": "85ZP Application of Part",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "(1) This Part applies in relation to a person convicted of an offence\nwhether the person was convicted before or after the\ncommencement of this Part.\n\n(2) A reference in this Part to a person convicted of an offence does\nnot include a reference to a body corporate.\n\n(3) Nothing in this Part authorises a person or body to disclose or take\ninto account a conviction of an offence if to do so would\ncontravene any Commonwealth law, State law, Territory law or\nforeign law.\nNote:\nThere are exceptions in sections 85ZZJC (use and disclosure of spent\nconviction etc. information by ASIO, ACC and other intelligence or\nsecurity agencies) and 85ZZL (criminal proceedings before the\nFederal Court of Australia).\n\n(4) Nothing in this Part affects anything lawfully done before a pardon\nis granted or a conviction is quashed or spent."
    },
