    {
      "@id": "concept:crimes-act-1914-sec-23xo",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XO Person may get help to carry out forensic procedures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xo"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.69",
      "values:originalText": "(1) A person who is authorised to carry out a forensic procedure under\nthe table in section 23XM is authorised to ask another person to\nhelp him or her to carry out the procedure, and the other person is\nauthorised to give that help.\n\n(2) A person who is asked to help carry out a forensic procedure need\nnot be a person mentioned in the table in section 23XM.\n\n(3) A person who is asked to help carry out a forensic procedure may\nuse reasonable force to enable the forensic procedure to be carried\nout.",
      "skos:definition": "(1) A person who is authorised to carry out a forensic procedure under\nthe table in section 23XM is authorised to ask another person to\nhelp him or her to carry out the procedure, and the other person is\nauthorised to give that help.\n\n(2) A person who is asked to help carry out a forensic procedure need\nnot be a person mentioned in the table in section 23XM.\n\n(3) A person who is asked to help carry out a forensic procedure may\nuse reasonable force to enable the forensic procedure to be carried\nout.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-23xo-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xo-ss-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xo-ss-3"
        }
      ],
      "cml:integrityHash": "13b74abd122dea7d429e12c1839cf6561090e9b87f8cca5d4c62d26cd5f04ae9"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xo",
      "@type": "cof:Section",
      "cof:title": "23XO Person may get help to carry out forensic procedures",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "(1) A person who is authorised to carry out a forensic procedure under\nthe table in section 23XM is authorised to ask another person to\nhelp him or her to carry out the procedure, and the other person is\nauthorised to give that help.\n\n(2) A person who is asked to help carry out a forensic procedure need\nnot be a person mentioned in the table in section 23XM.\n\n(3) A person who is asked to help carry out a forensic procedure may\nuse reasonable force to enable the forensic procedure to be carried\nout."
    },
