        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a complaint is about an act or practice of a Commonwealth Department or a State Department, the Secretary or head of the Department is the respondent to the complaint.",
