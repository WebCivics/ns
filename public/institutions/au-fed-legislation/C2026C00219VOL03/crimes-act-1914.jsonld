      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An interview friend unreasonably interferes with or obstructs the carrying out of the procedure.",
      "cml:conclusionText": "The interval of interference overlaps with the procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-3-logic-deontic-4",
