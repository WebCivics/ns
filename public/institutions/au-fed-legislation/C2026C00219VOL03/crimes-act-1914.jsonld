    {
      "@id": "concept:crimes-act-1914-sec-23yg-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YG(3) Material required to be made available to suspect, offender or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yg-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.118",
      "values:originalText": "(3) Subsection (2) does not apply to:\n\n(a) copies of records required to be made available under\nsubsection 23XE(5); and\n\n(b) material required to be provided under section 23XU; and\n\n(c) copies of results of analysis and other information required to\nbe provided under section 23XW.",
      "skos:definition": "(3) Subsection (2) does not apply to:\n\n(a) copies of records required to be made available under\nsubsection 23XE(5); and\n\n(b) material required to be provided under section 23XU; and\n\n(c) copies of results of analysis and other information required to\nbe provided under section 23XW.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yg"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yg-ss-3-norm"
