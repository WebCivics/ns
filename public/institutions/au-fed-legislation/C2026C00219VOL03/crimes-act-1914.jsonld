    {
      "@id": "concept:crimes-act-1914-sec-23yd-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YD(6) Destruction of forensic material after 12 months",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yd-ss-6"
      },
      "cml:curationStatus": {
