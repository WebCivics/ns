          "@id": "concept:crimes-act-1914-sec-23xb-ss-7-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xb-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c1915d6b520142de372c57e63664182935119d1793f9a84d651b48676416768",
      "skos:note": "Exemption from subsection (6) for applicants with reasonable grounds"
    },
    {
