    {
      "@id": "concept:crimes-act-1914-sec-30k",
      "@type": "cml:Concept",
      "skos:prefLabel": "30K Obstructing or hindering the performance of services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-30k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.150",
      "values:originalText": "Whoever, by violence to the person or property of another person,\nor by spoken or written threat or intimidation of any kind to\nwhomsoever directed, or, without reasonable cause or excuse, by\nboycott or threat of boycott of person or property:\n\n(b) compels or induces any person employed in or in connexion\nwith the provision of any public service by the\nCommonwealth or by any Department or public authority\nunder the Commonwealth to surrender or depart from his or\nher employment;\n\n(c) prevents any person from offering or accepting employment\nin or in connexion with the provision of any public service by\nthe Commonwealth or by any Department or public authority\nunder the Commonwealth;\n\n(d) obstructs or hinders the transport of goods or the conveyance\nof passengers in trade or commerce with other countries or\namong the States;\n\n(e) compels or induces any person employed in or in connexion\nwith the transport of goods or the conveyance of passengers\nin trade or commerce with other countries or among the\nStates to surrender or depart from his or her employment; or\n\n(f) prevents any person from offering or accepting employment\nin or in connexion with the transport of goods or the\nconveyance of passengers in trade or commerce with other\ncountries or among the States;\n\n\nProtection of public and other services  Part IIA\n\nSection 30K\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\ncommits an offence.\nPenalty: Imprisonment for 1 year.",
      "skos:definition": "Whoever, by violence to the person or property of another person,\nor by spoken or written threat or intimidation of any kind to\nwhomsoever directed, or, without reasonable cause or excuse, by\nboycott or threat of boycott of person or property:\n\n(b) compels or induces any person employed in or in connexion\nwith the provision of any public service by the\nCommonwealth or by any Department or public authority\nunder the Commonwealth to surrender or depart from his or\nher employment;\n\n(c) prevents any person from offering or accepting employment\nin or in connexion with the provision of any public service by\nthe Commonwealth or by any Department or public authority\nunder the Commonwealth;\n\n(d) obstructs or hinders the transport of goods or the conveyance\nof passengers in trade or commerce with other countries or\namong the States;\n\n(e) compels or induces any person employed in or in connexion\nwith the transport of goods or the conveyance of passengers\nin trade or commerce with other countries or among the\nStates to surrender or depart from his or her employment; or\n\n(f) prevents any person from offering or accepting employment\nin or in connexion with the transport of goods or the\nconveyance of passengers in trade or commerce with other\ncountries or among the States;\n\n\nProtection of public and other services  Part IIA\n\nSection 30K\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\ncommits an offence.\nPenalty: Imprisonment for 1 year.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-30k-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-30k-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-30k-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-30k-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "49e2342882b4d173528cd3be34006cee36f527e4e270cee029ddfed1ad6d1cc6",
      "skos:note": "Obstructing or hindering public service performance"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-30k",
      "@type": "cof:Section",
      "cof:title": "30K Obstructing or hindering the performance of services",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "Whoever, by violence to the person or property of another person,\nor by spoken or written threat or intimidation of any kind to\nwhomsoever directed, or, without reasonable cause or excuse, by\nboycott or threat of boycott of person or property:\n\n(b) compels or induces any person employed in or in connexion\nwith the provision of any public service by the\nCommonwealth or by any Department or public authority\nunder the Commonwealth to surrender or depart from his or\nher employment;\n\n(c) prevents any person from offering or accepting employment\nin or in connexion with the provision of any public service by\nthe Commonwealth or by any Department or public authority\nunder the Commonwealth;\n\n(d) obstructs or hinders the transport of goods or the conveyance\nof passengers in trade or commerce with other countries or\namong the States;\n\n(e) compels or induces any person employed in or in connexion\nwith the transport of goods or the conveyance of passengers\nin trade or commerce with other countries or among the\nStates to surrender or depart from his or her employment; or\n\n(f) prevents any person from offering or accepting employment\nin or in connexion with the transport of goods or the\nconveyance of passengers in trade or commerce with other\ncountries or among the States;\n\n\nProtection of public and other services  Part IIA\n\nSection 30K\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026\n\ncommits an offence.\nPenalty: Imprisonment for 1 year."
    },
