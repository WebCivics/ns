    {
      "@id": "concept:crimes-act-1914-sec-23yg-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YG(2) Material required to be made available to suspect, offender or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yg-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.118",
      "values:originalText": "(2) Subject to subsection (3), material of any kind that is required by\nthis Part to be made available to a suspect, offender or volunteer\nmust be made available in accordance with subsection (1):\n\n(a) within 14 days after the material comes into existence; or\n\n(b) if the material is requested by the suspect, offender or\nvolunteer or the suspect’s, offender’s or volunteer’s interview\nfriend or legal representative, within 14 days of the request.",
      "skos:definition": "(2) Subject to subsection (3), material of any kind that is required by\nthis Part to be made available to a suspect, offender or volunteer\nmust be made available in accordance with subsection (1):\n\n(a) within 14 days after the material comes into existence; or\n\n(b) if the material is requested by the suspect, offender or\nvolunteer or the suspect’s, offender’s or volunteer’s interview\nfriend or legal representative, within 14 days of the request.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yg"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yg-ss-2-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yg-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a92b6592aa2a1163a91d60593ff90d38e61418e48b669b1fbf47601f321c6cc7",
      "skos:note": "Material must be made available within 14 days after creation or request.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yg-ss-2",
      "@type": "cof:Section",
      "cof:title": "23YG(2) Material required to be made available to suspect, offender or",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(2) Subject to subsection (3), material of any kind that is required by\nthis Part to be made available to a suspect, offender or volunteer\nmust be made available in accordance with subsection (1):\n\n(a) within 14 days after the material comes into existence; or\n\n(b) if the material is requested by the suspect, offender or\nvolunteer or the suspect’s, offender’s or volunteer’s interview\nfriend or legal representative, within 14 days of the request."
    },
