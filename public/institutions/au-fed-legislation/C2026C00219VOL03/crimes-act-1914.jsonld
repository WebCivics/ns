      },
      "cml:premiseText": "Secretary or head of Department is respondent to complaint.",
      "cml:conclusionText": "Department head is respondent to complaint."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zz-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Secretary or head of Department is respondent to complaint.",
      "cml:executionSurface": "modalities::logic::deontic",
