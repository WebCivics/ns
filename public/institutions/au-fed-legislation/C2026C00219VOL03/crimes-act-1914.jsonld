        }
      ],
      "cml:integrityHash": "6f2a21135fc71cdec758f8c0f2db8fbee14e272cfd93b1bafeabe769baa4702d",
      "skos:note": "Making, using, or selling a die capable of making a mark resembling a postage stamp is prohibited."
    },
