      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Forfeiture order is a legal action",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 23ZD applies to forfeitable things",
      "cml:conclusionText": "Forfeiture order is a legal action"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zb-ss-6-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Timeframe for instruction must be before forfeiture application",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Application must be made within timeframe",
      "cml:conclusionText": "Instruction must be before forfeiture application"
    },
