    {
      "@id": "concept:crimes-act-1914-sec-47b",
      "@type": "cml:Concept",
      "skos:prefLabel": "47B Person unlawfully at large",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-47b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.167",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person was in criminal detention in a prison, lock-up or\nother place of criminal detention; and\n\n(b) the detention was lawful federal criminal detention; and\n\n(c) in accordance with a permission given under a law of a State\nor Territory (other than the Australian Capital Territory), the\nperson leaves the prison, lock-up or other place; and",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person was in criminal detention in a prison, lock-up or\nother place of criminal detention; and\n\n(b) the detention was lawful federal criminal detention; and\n\n(c) in accordance with a permission given under a law of a State\nor Territory (other than the Australian Capital Territory), the\nperson leaves the prison, lock-up or other place; and",
      "cml:asserts": [
