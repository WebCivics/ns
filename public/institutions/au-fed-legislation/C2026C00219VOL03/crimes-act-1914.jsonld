      },
      "cml:premiseText": "The obligation to comply with subsection (1) is defined in section Z.",
      "cml:conclusionText": "Subsection (1) imposes an obligation on individuals to comply with its requirements."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85w-ss-3-logic-deontic-4",
