        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The pardon is granted despite any other Commonwealth law or State law.",
      "cml:conclusionText": "Despite any other Commonwealth law or State law, where a person has been granted a free and absolute pardon for a Commonwealth offence..."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
