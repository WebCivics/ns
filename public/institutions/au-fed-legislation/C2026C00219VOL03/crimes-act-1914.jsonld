    {
      "@id": "concept:crimes-act-1914-sec-89-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "89(3) Trespassing on Commonwealth land",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-89-ss-3"
      },
