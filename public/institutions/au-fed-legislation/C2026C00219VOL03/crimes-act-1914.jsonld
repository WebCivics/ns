    },
    {
      "@id": "concept:crimes-act-1914-sec-23xi",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XI General rules for carrying out forensic procedures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.62",
      "values:originalText": "A forensic procedure:\n\n(a) must be carried out in circumstances affording reasonable\nprivacy to the suspect; and\n\n(b) except as permitted (expressly or impliedly) by other\nprovisions of this Part, must not be carried out in the\npresence or view of a person who is of the opposite sex to the\nsuspect; and\n\n(c) must not be carried out in the presence or view of a person\nwhose presence is not necessary for the purposes of the\nforensic procedure or required or permitted by another\nprovision of this Part; and\n\n(d) must not involve the removal of more clothing than is\nnecessary for the carrying out of the procedure; and\n\n(e) must not involve more visual inspection than is necessary for\nthe carrying out of the procedure.\n23XIA  No questioning during forensic procedure\n\nA forensic procedure must not be carried out while the suspect is\nbeing questioned as defined in subsection 23B(6). If questioning\nhas not been completed before the forensic procedure is to be\ncarried out, it must be suspended while the forensic procedure is\ncarried out.\n23XIB  Suspect must be cautioned before forensic procedure starts\n\nBefore anyone starts to carry out a forensic procedure on a suspect,\na constable must caution the suspect that he or she does not have to\nsay anything while the procedure is carried out but that anything\nthe person does say may be used in evidence.\n\n\nForensic procedures  Part ID\nCarrying out forensic procedures on suspects  Division 6\n\nSection 23XJ\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "A forensic procedure:\n\n(a) must be carried out in circumstances affording reasonable\nprivacy to the suspect; and\n\n(b) except as permitted (expressly or impliedly) by other\nprovisions of this Part, must not be carried out in the\npresence or view of a person who is of the opposite sex to the\nsuspect; and\n\n(c) must not be carried out in the presence or view of a person\nwhose presence is not necessary for the purposes of the\nforensic procedure or required or permitted by another\nprovision of this Part; and\n\n(d) must not involve the removal of more clothing than is\nnecessary for the carrying out of the procedure; and\n\n(e) must not involve more visual inspection than is necessary for\nthe carrying out of the procedure.\n23XIA  No questioning during forensic procedure\n\nA forensic procedure must not be carried out while the suspect is\nbeing questioned as defined in subsection 23B(6). If questioning\nhas not been completed before the forensic procedure is to be\ncarried out, it must be suspended while the forensic procedure is\ncarried out.\n23XIB  Suspect must be cautioned before forensic procedure starts\n\nBefore anyone starts to carry out a forensic procedure on a suspect,\na constable must caution the suspect that he or she does not have to\nsay anything while the procedure is carried out but that anything\nthe person does say may be used in evidence.\n\n\nForensic procedures  Part ID\nCarrying out forensic procedures on suspects  Division 6\n\nSection 23XJ\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23xi-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xi-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xi-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xi-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "5dd10dd69ae977e635a50086a30f775f76fdd899f6ca11c0c156e9b3b91edba8",
      "skos:note": "Forensic procedures must be carried out under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xi",
      "@type": "cof:Section",
      "cof:title": "23XI General rules for carrying out forensic procedures",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "A forensic procedure:\n\n(a) must be carried out in circumstances affording reasonable\nprivacy to the suspect; and\n\n(b) except as permitted (expressly or impliedly) by other\nprovisions of this Part, must not be carried out in the\npresence or view of a person who is of the opposite sex to the\nsuspect; and\n\n(c) must not be carried out in the presence or view of a person\nwhose presence is not necessary for the purposes of the\nforensic procedure or required or permitted by another\nprovision of this Part; and\n\n(d) must not involve the removal of more clothing than is\nnecessary for the carrying out of the procedure; and\n\n(e) must not involve more visual inspection than is necessary for\nthe carrying out of the procedure.\n23XIA  No questioning during forensic procedure\n\nA forensic procedure must not be carried out while the suspect is\nbeing questioned as defined in subsection 23B(6). If questioning\nhas not been completed before the forensic procedure is to be\ncarried out, it must be suspended while the forensic procedure is\ncarried out.\n23XIB  Suspect must be cautioned before forensic procedure starts\n\nBefore anyone starts to carry out a forensic procedure on a suspect,\na constable must caution the suspect that he or she does not have to\nsay anything while the procedure is carried out but that anything\nthe person does say may be used in evidence.\n\n\nForensic procedures  Part ID\nCarrying out forensic procedures on suspects  Division 6\n\nSection 23XJ\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xi-norm",
