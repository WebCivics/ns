    },
    {
      "@id": "concept:crimes-act-1914-sec-85t",
      "@type": "cml:Concept",
      "skos:prefLabel": "85T Sending false postal messages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.179",
      "values:originalText": "A person shall not:\n\n(a) intentionally and without a person’s authority, submit, or\ncause to be submitted, to Australia Post as a postal message\nsigned or to be sent by the person, a postal message that was\nnot so signed or to be sent;\n\n(b) intentionally submit, or cause to be submitted, to Australia\nPost a postal message signed with the name of a fictitious\nperson;\n\n(c) intentionally and without the authority of the person sending\na postal message, alter the postal message; or\n\n(d) intentionally write, issue or deliver a document purporting to\nbe a postal message that has been carried by post knowing\nthat it is not such a message.\nPenalty: Imprisonment for 1 year.",
      "skos:definition": "A person shall not:\n\n(a) intentionally and without a person’s authority, submit, or\ncause to be submitted, to Australia Post as a postal message\nsigned or to be sent by the person, a postal message that was\nnot so signed or to be sent;\n\n(b) intentionally submit, or cause to be submitted, to Australia\nPost a postal message signed with the name of a fictitious\nperson;\n\n(c) intentionally and without the authority of the person sending\na postal message, alter the postal message; or\n\n(d) intentionally write, issue or deliver a document purporting to\nbe a postal message that has been carried by post knowing\nthat it is not such a message.\nPenalty: Imprisonment for 1 year.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-85t-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85t-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d96d06a7e4931b48d28f8d58de2de020cd3db15297611c07257133b2bcf592c2",
      "skos:note": "Sending false postal messages is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85t",
      "@type": "cof:Section",
      "cof:title": "85T Sending false postal messages",
      "values:kind": "section",
      "cof:pageNumber": 179,
      "values:originalText": "A person shall not:\n\n(a) intentionally and without a person’s authority, submit, or\ncause to be submitted, to Australia Post as a postal message\nsigned or to be sent by the person, a postal message that was\nnot so signed or to be sent;\n\n(b) intentionally submit, or cause to be submitted, to Australia\nPost a postal message signed with the name of a fictitious\nperson;\n\n(c) intentionally and without the authority of the person sending\na postal message, alter the postal message; or\n\n(d) intentionally write, issue or deliver a document purporting to\nbe a postal message that has been carried by post knowing\nthat it is not such a message.\nPenalty: Imprisonment for 1 year."
    },
