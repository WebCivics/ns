        },
        {
          "@id": "concept:crimes-act-1914-sec-85f-ss-6-logic-ltl-5"
        }
      ],
      "cml:integrityHash": "96531aa3a3e7a3496575ec89bb86a26242124043ad43abe1414bc78147367892",
      "skos:note": "Uttering a forged postage stamp is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85f-ss-6",
      "@type": "cof:Section",
      "cof:title": "85F(6) Interpretation—expressions used in Australian Postal",
      "values:kind": "subsection",
      "cof:pageNumber": 176,
      "values:originalText": "(6) A person shall be taken to utter a forged postage stamp if the\nperson:\n\n(a) tenders it or puts it off; or\n\n(c) uses or deals with it; or\n\n(e) attempts to induce any person to use, deal with, act on or\naccept it."
    },
