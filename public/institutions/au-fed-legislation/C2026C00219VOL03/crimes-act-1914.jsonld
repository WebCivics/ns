      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits excluding an interview friend from a forensic procedure.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) An interview friend (other than a legal representative) of the suspect may be excluded...",
      "cml:conclusionText": "An interview friend may not be excluded if they unreasonably interfere."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Trace",
      "cml:logicSummary": "Traces the temporal interval of the prohibition.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) An interview friend (other than a legal representative)...",
      "cml:conclusionText": "The prohibition applies during the time the interview friend unreasonably interferes."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on excluding an interview friend if they unreasonably interfere.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) An interview friend (other than a legal representative)...",
      "cml:conclusionText": "There is an obligation to exclude the interview friend if they unreasonably interfere."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Reiterates the prohibition on excluding an interview friend.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) An interview friend (other than a legal representative)...",
      "cml:conclusionText": "The exclusion is prohibited if it involves unreasonably interfering with the procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xs",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XS Presence of constables",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xs"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.71",
      "values:originalText": "(1) The number of constables that may be present during the carrying\nout of a forensic procedure must not exceed that which is\nreasonably necessary to ensure that the procedure is carried out\neffectively and in accordance with this Part.\n\n(2) Where the presence of a constable (other than a constable who is\ncarrying out or helping to carry out the procedure) is reasonably\nnecessary to ensure that a forensic procedure is carried out\neffectively and in accordance with this Part, the constable is:",
      "skos:definition": "(1) The number of constables that may be present during the carrying\nout of a forensic procedure must not exceed that which is\nreasonably necessary to ensure that the procedure is carried out\neffectively and in accordance with this Part.\n\n(2) Where the presence of a constable (other than a constable who is\ncarrying out or helping to carry out the procedure) is reasonably\nnecessary to ensure that a forensic procedure is carried out\neffectively and in accordance with this Part, the constable is:",
