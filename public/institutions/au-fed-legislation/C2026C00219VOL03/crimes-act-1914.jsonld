      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yj",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YJ Proof of impracticability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.119",
      "values:originalText": "In any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that it was not practicable to do\nsomething required by this Part to be done if practicable.\n23YJA  Proof that time should be disregarded\n\nIn any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that any particular time was covered by\na provision of subsection 23WLA(2), 23XGB(2) or 23XGD(2).",
      "skos:definition": "In any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that it was not practicable to do\nsomething required by this Part to be done if practicable.\n23YJA  Proof that time should be disregarded\n\nIn any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that any particular time was covered by\na provision of subsection 23WLA(2), 23XGB(2) or 23XGD(2).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yj-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "43de45d75c6964c4dbb6688986481d20d47ce79233cd24fd5de01516ae46e9f4",
      "skos:note": "Prosecution must prove impracticability on balance of probabilities.",
      "dc:description": "Evidence of impracticability"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yj",
      "@type": "cof:Section",
      "cof:title": "23YJ Proof of impracticability",
      "values:kind": "section",
      "cof:pageNumber": 119,
      "values:originalText": "In any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that it was not practicable to do\nsomething required by this Part to be done if practicable.\n23YJA  Proof that time should be disregarded\n\nIn any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that any particular time was covered by\na provision of subsection 23WLA(2), 23XGB(2) or 23XGD(2)."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yj-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
