      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yk",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YK Proof of voluntary waiver of certain rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.119",
      "values:originalText": "In any proceedings:\n\n(a) the burden lies on the prosecution to prove that an Aboriginal\nperson or Torres Strait Islander has waived a right as\nmentioned in subsection 23WG(3) or subsection 23XR(3);\nand\n\n(b) the burden is not discharged unless the court is satisfied on\nthe balance of probabilities that the person voluntarily\nwaived that right, and did so with full knowledge and\nunderstanding of what he or she was doing.\n23YKA  Application of sections 23YI to 23YK\n\nTo avoid doubt, sections 23YI to 23YK do not apply in relation to\na proceeding in a foreign country or international tribunal in which\nforensic evidence is provided in response to a request by:\n\n(a) a foreign country; or\n\n(b) an international tribunal; or",
      "skos:definition": "In any proceedings:\n\n(a) the burden lies on the prosecution to prove that an Aboriginal\nperson or Torres Strait Islander has waived a right as\nmentioned in subsection 23WG(3) or subsection 23XR(3);\nand\n\n(b) the burden is not discharged unless the court is satisfied on\nthe balance of probabilities that the person voluntarily\nwaived that right, and did so with full knowledge and\nunderstanding of what he or she was doing.\n23YKA  Application of sections 23YI to 23YK\n\nTo avoid doubt, sections 23YI to 23YK do not apply in relation to\na proceeding in a foreign country or international tribunal in which\nforensic evidence is provided in response to a request by:\n\n(a) a foreign country; or\n\n(b) an international tribunal; or",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yk-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yk-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cffd736a0c248591da46771c7bf7d6288dc7baa0dab2e69b6ba52f749d38d41e",
      "skos:note": "Prosecution must prove Aboriginal person or Torres Strait Islander waived a right.",
      "dc:description": "Proof of voluntary waiver"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yk",
      "@type": "cof:Section",
      "cof:title": "23YK Proof of voluntary waiver of certain rights",
      "values:kind": "section",
      "cof:pageNumber": 119,
      "values:originalText": "In any proceedings:\n\n(a) the burden lies on the prosecution to prove that an Aboriginal\nperson or Torres Strait Islander has waived a right as\nmentioned in subsection 23WG(3) or subsection 23XR(3);\nand\n\n(b) the burden is not discharged unless the court is satisfied on\nthe balance of probabilities that the person voluntarily\nwaived that right, and did so with full knowledge and\nunderstanding of what he or she was doing.\n23YKA  Application of sections 23YI to 23YK\n\nTo avoid doubt, sections 23YI to 23YK do not apply in relation to\na proceeding in a foreign country or international tribunal in which\nforensic evidence is provided in response to a request by:\n\n(a) a foreign country; or\n\n(b) an international tribunal; or"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yk-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23yk"
