    {
      "@id": "concept:crimes-act-1914-sec-85f-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "85F(6) Interpretation—expressions used in Australian Postal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85f-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
