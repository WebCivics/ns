      },
      "cml:premiseText": "(3) An interview friend unreasonably interferes with or obstructs the carrying out of the procedure.",
      "cml:conclusionText": "The interference or obstruction is prohibited."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xq-ss-3-logic-alleninterval-3",
