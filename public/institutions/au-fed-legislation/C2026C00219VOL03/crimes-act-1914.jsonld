    {
      "@id": "concept:crimes-act-1914-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Trespass by cattle or live stock",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.226",
      "values:originalText": "Any person who, without lawful excuse (proof whereof shall lie\nupon him or her), suffers or permits any cattle or other live stock in\nhis or her possession, custody, or control, to trespass or stray upon\nany land belonging to, or in the occupation of, the Commonwealth,\ncommits an offence.\nPenalty: 1 penalty unit.",
      "skos:definition": "Any person who, without lawful excuse (proof whereof shall lie\nupon him or her), suffers or permits any cattle or other live stock in\nhis or her possession, custody, or control, to trespass or stray upon\nany land belonging to, or in the occupation of, the Commonwealth,\ncommits an offence.\nPenalty: 1 penalty unit.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-90-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-90-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a85aaab9e375bbdf84a44ec8b885fbcc7a286b97a604433497f5d701e4bbac1b",
      "skos:note": "Trespass by cattle or live stock is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-90",
      "@type": "cof:Section",
      "cof:title": "90 Trespass by cattle or live stock",
      "values:kind": "section",
      "cof:pageNumber": 226,
      "values:originalText": "Any person who, without lawful excuse (proof whereof shall lie\nupon him or her), suffers or permits any cattle or other live stock in\nhis or her possession, custody, or control, to trespass or stray upon\nany land belonging to, or in the occupation of, the Commonwealth,\ncommits an offence.\nPenalty: 1 penalty unit."
    },
