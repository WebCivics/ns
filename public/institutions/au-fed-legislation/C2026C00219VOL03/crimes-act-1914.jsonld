      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval for the requirement to have an interview friend or legal representative present.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) If the applicant believes on reasonable grounds that the suspect is an Aboriginal person or a Torres Strait Islander not covered by subsection (5),",
      "cml:conclusionText": "an interview friend or legal representative of the suspect must also be in the presence of the authorised applicant."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xb-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XB(7) Application for interim order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xb-ss-7"
      },
