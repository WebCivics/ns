      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23ym",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YM Experts not obliged to carry out forensic procedures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23ym"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.120",
      "values:originalText": "Nothing in this Part requires a medical practitioner, nurse, dentist,\ndental technician or appropriately qualified person to carry out a\nforensic procedure.",
      "skos:definition": "Nothing in this Part requires a medical practitioner, nurse, dentist,\ndental technician or appropriately qualified person to carry out a\nforensic procedure.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23ym-norm"
        }
      ],
      "cml:integrityHash": "be074c0a4d0d29d4dda1e6cfa7e6727ea652519a0267a6e4ce18d2229628f7cf",
      "skos:note": "No obligation on experts to carry out forensic procedures."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23ym",
      "@type": "cof:Section",
      "cof:title": "23YM Experts not obliged to carry out forensic procedures",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "Nothing in this Part requires a medical practitioner, nurse, dentist,\ndental technician or appropriately qualified person to carry out a\nforensic procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23ym-norm",
