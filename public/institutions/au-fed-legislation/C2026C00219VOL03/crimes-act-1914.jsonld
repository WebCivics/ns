    {
      "@id": "concept:crimes-act-1914-sec-85v",
      "@type": "cml:Concept",
      "skos:prefLabel": "85V Interference with property of Australia Post",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85v"
      },
      "cml:curationStatus": {
