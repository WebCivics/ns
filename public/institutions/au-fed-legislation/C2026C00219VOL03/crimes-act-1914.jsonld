      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.139",
      "values:originalText": "This Part applies to a thing (the forfeitable thing) that is:\n\n(a) child abuse material; or\n\n(c) any of the following that contains child abuse material:\n\n(i) a computer;\n\n(ii) a data storage device;\n\n(iii) another piece of electronic equipment.",
      "skos:definition": "This Part applies to a thing (the forfeitable thing) that is:\n\n(a) child abuse material; or\n\n(c) any of the following that contains child abuse material:\n\n(i) a computer;\n\n(ii) a data storage device;\n\n(iii) another piece of electronic equipment.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23za-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23za-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b075e245d0ef0d814db0c952b5e1ef590ea3cdecb1433b6b3a48a18e04fbcda6",
      "skos:note": "This Part applies to a thing that is child abuse material or contains child abuse material."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23za",
      "@type": "cof:Section",
      "cof:title": "23ZA Application",
      "values:kind": "section",
      "cof:pageNumber": 139,
      "values:originalText": "This Part applies to a thing (the forfeitable thing) that is:\n\n(a) child abuse material; or\n\n(c) any of the following that contains child abuse material:\n\n(i) a computer;\n\n(ii) a data storage device;\n\n(iii) another piece of electronic equipment."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23za-norm",
