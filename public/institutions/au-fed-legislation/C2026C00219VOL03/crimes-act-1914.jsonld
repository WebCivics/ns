      "cml:logicSummary": "Mandatory provision without charge.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23yi",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YI Proof of belief or suspicion",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.119",
      "values:originalText": "In any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that a constable had a belief on\nreasonable grounds, or suspected on reasonable grounds, as to a\nmatter referred to in this Part.",
      "skos:definition": "In any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that a constable had a belief on\nreasonable grounds, or suspected on reasonable grounds, as to a\nmatter referred to in this Part.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23yi-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yi-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23yi-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "9a2dac302da652128d0a88e76d44c73072f55f8df1d5dd262c431cb188de66d1",
      "skos:note": "Prosecution must prove belief or suspicion on reasonable grounds.",
      "dc:description": "Evidence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yi",
      "@type": "cof:Section",
      "cof:title": "23YI Proof of belief or suspicion",
      "values:kind": "section",
      "cof:pageNumber": 119,
      "values:originalText": "In any proceedings, the burden lies on the prosecution to prove on\nthe balance of probabilities that a constable had a belief on\nreasonable grounds, or suspected on reasonable grounds, as to a\nmatter referred to in this Part."
    },
    {
