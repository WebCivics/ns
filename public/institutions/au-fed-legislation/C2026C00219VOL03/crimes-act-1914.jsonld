    },
    {
      "@id": "concept:crimes-act-1914-sec-85zn",
      "@type": "cml:Concept",
      "skos:prefLabel": "85ZN Meaning of quash",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.189",
      "values:originalText": "For the purposes of this Part, a person’s conviction of an offence\nshall be taken to have been quashed:\n\n(a) where the person was convicted of the offence—if the\nconviction has been quashed or set aside;\n\n(b) where the person was found guilty of the offence, but\ndischarged without conviction—if the finding of guilt has\nbeen quashed or set aside; or\n\n(c) where the person was not found guilty of the offence, but a\ncourt has taken it into account in passing sentence on the\nperson for another offence:\n\n(i) if the person’s conviction of the other offence has been\nquashed or set aside; or\n\n(ii) if the court’s decision to take the offence into account\nhas been set aside.",
      "skos:definition": "For the purposes of this Part, a person’s conviction of an offence\nshall be taken to have been quashed:\n\n(a) where the person was convicted of the offence—if the\nconviction has been quashed or set aside;\n\n(b) where the person was found guilty of the offence, but\ndischarged without conviction—if the finding of guilt has\nbeen quashed or set aside; or\n\n(c) where the person was not found guilty of the offence, but a\ncourt has taken it into account in passing sentence on the\nperson for another offence:\n\n(i) if the person’s conviction of the other offence has been\nquashed or set aside; or\n\n(ii) if the court’s decision to take the offence into account\nhas been set aside.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-85zn-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zn-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zn-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zn-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zn-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "f9c7ee9ec4823a12b61734115c30ea9c199defaffcdae699a707c309a658e79d",
      "skos:note": "A person's conviction of an offence shall be taken to have been quashed under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zn",
      "@type": "cof:Section",
      "cof:title": "85ZN Meaning of quash",
      "values:kind": "section",
      "cof:pageNumber": 189,
      "values:originalText": "For the purposes of this Part, a person’s conviction of an offence\nshall be taken to have been quashed:\n\n(a) where the person was convicted of the offence—if the\nconviction has been quashed or set aside;\n\n(b) where the person was found guilty of the offence, but\ndischarged without conviction—if the finding of guilt has\nbeen quashed or set aside; or\n\n(c) where the person was not found guilty of the offence, but a\ncourt has taken it into account in passing sentence on the\nperson for another offence:\n\n(i) if the person’s conviction of the other offence has been\nquashed or set aside; or\n\n(ii) if the court’s decision to take the offence into account\nhas been set aside."
    },
    {
