    },
    {
      "@id": "concept:crimes-act-1914-sec-85zx",
      "@type": "cml:Concept",
      "skos:prefLabel": "85ZX Convictions of further Commonwealth or Territory offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zx"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.196",
      "values:originalText": "(1) Where:\n\n(a) Division 3 applies to a person in relation to an offence of\nwhich the person was convicted, or would (unless an order is\nmade under this section) so apply to the person if the waiting\nperiod for the offence had ended; and\n\n(b) before or after the end of the waiting period for the offence,\nthe person is convicted summarily, by a court exercising\nfederal jurisdiction or a court of a Territory, of another\noffence, being an offence committed during that waiting\nperiod;\nthe court may order that Division 3 ceases to apply or does not\napply to the person, as the case requires, in relation to the earlier\noffence until the waiting period for the later offence has ended.\n\n(2) Where:\n\n(a) Division 3 applies to a person in relation to an offence of\nwhich the person was convicted, or would (but for this\nsubsection) so apply to the person if the waiting period for\nthe offence had ended; and\n\n(b) before or after the end of the waiting period for the offence,\nthe person is convicted on indictment, by a court exercising\nfederal jurisdiction or a court of a Territory, of another\noffence, being an offence committed during that waiting\nperiod;\nDivision 3 ceases to apply or does not apply to the person, as the\ncase requires, in relation to the earlier offence until the waiting\nperiod for the later offence has ended.",
      "skos:definition": "(1) Where:\n\n(a) Division 3 applies to a person in relation to an offence of\nwhich the person was convicted, or would (unless an order is\nmade under this section) so apply to the person if the waiting\nperiod for the offence had ended; and\n\n(b) before or after the end of the waiting period for the offence,\nthe person is convicted summarily, by a court exercising\nfederal jurisdiction or a court of a Territory, of another\noffence, being an offence committed during that waiting\nperiod;\nthe court may order that Division 3 ceases to apply or does not\napply to the person, as the case requires, in relation to the earlier\noffence until the waiting period for the later offence has ended.\n\n(2) Where:\n\n(a) Division 3 applies to a person in relation to an offence of\nwhich the person was convicted, or would (but for this\nsubsection) so apply to the person if the waiting period for\nthe offence had ended; and\n\n(b) before or after the end of the waiting period for the offence,\nthe person is convicted on indictment, by a court exercising\nfederal jurisdiction or a court of a Territory, of another\noffence, being an offence committed during that waiting\nperiod;\nDivision 3 ceases to apply or does not apply to the person, as the\ncase requires, in relation to the earlier offence until the waiting\nperiod for the later offence has ended.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-85zx-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zx-ss-2"
        }
      ],
      "cml:integrityHash": "aa81384e089cbe7aad6224a0b7185b4a7a28110534c277008e64de16ecdcf07c"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zx",
      "@type": "cof:Section",
      "cof:title": "85ZX Convictions of further Commonwealth or Territory offences",
      "values:kind": "section",
      "cof:pageNumber": 196,
      "values:originalText": "(1) Where:\n\n(a) Division 3 applies to a person in relation to an offence of\nwhich the person was convicted, or would (unless an order is\nmade under this section) so apply to the person if the waiting\nperiod for the offence had ended; and\n\n(b) before or after the end of the waiting period for the offence,\nthe person is convicted summarily, by a court exercising\nfederal jurisdiction or a court of a Territory, of another\noffence, being an offence committed during that waiting\nperiod;\nthe court may order that Division 3 ceases to apply or does not\napply to the person, as the case requires, in relation to the earlier\noffence until the waiting period for the later offence has ended.\n\n(2) Where:\n\n(a) Division 3 applies to a person in relation to an offence of\nwhich the person was convicted, or would (but for this\nsubsection) so apply to the person if the waiting period for\nthe offence had ended; and\n\n(b) before or after the end of the waiting period for the offence,\nthe person is convicted on indictment, by a court exercising\nfederal jurisdiction or a court of a Territory, of another\noffence, being an offence committed during that waiting\nperiod;\nDivision 3 ceases to apply or does not apply to the person, as the\ncase requires, in relation to the earlier offence until the waiting\nperiod for the later offence has ended."
    },
