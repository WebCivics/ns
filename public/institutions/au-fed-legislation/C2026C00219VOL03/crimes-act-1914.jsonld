      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A constable may, without warrant, seize the thing.",
      "cml:conclusionText": "Seizure without warrant is prohibited."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zg",
      "@type": "cml:Concept",
      "skos:prefLabel": "23ZG Delegation by head of police force",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23zg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.148",
      "values:originalText": "The head of a police force (including the Commissioner) may, by\nwriting, delegate to a constable who is a member of the force all or\nany of the head’s powers, functions and duties under this Part.\n\n\nProtection of public and other services  Part IIA\n\nSection 30J\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "The head of a police force (including the Commissioner) may, by\nwriting, delegate to a constable who is a member of the force all or\nany of the head’s powers, functions and duties under this Part.\n\n\nProtection of public and other services  Part IIA\n\nSection 30J\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23zg-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23zg-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4058516e79f9507fabd8566d5110d4e8bd5a5d909510b355398252e4b9be1ba9",
      "skos:note": "Head of police force may delegate powers to a constable."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23zg",
      "@type": "cof:Section",
      "cof:title": "23ZG Delegation by head of police force",
      "values:kind": "section",
      "cof:pageNumber": 148,
      "values:originalText": "The head of a police force (including the Commissioner) may, by\nwriting, delegate to a constable who is a member of the force all or\nany of the head’s powers, functions and duties under this Part.\n\n\nProtection of public and other services  Part IIA\n\nSection 30J\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23zg-norm",
