      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes duty on Commonwealth to forfeit material",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
