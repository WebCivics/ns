        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If a warrant for the apprehension of the suspect is issued during the period of 12 months after forensic material is taken...",
      "cml:conclusionText": "The forensic material must be destroyed as soon as practicable after (a) the warrant lapses; or (b) a period of 12 months elapses after the suspect is apprehended."
    },
