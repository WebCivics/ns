          "@id": "concept:crimes-act-1914-sec-89-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35e3a139c0a485e008949aa9740cdf666237dc9fa5cb172145968b1ec8cc80e2",
      "skos:note": "Authorized Commonwealth officer must produce identification before apprehending a person."
    },
    {
