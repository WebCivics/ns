    {
      "@id": "concept:crimes-act-1914-sec-85zs",
      "@type": "cml:Concept",
      "skos:prefLabel": "85ZS Effect of pardons for persons wrongly convicted",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zs"
      },
