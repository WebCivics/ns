      },
      "cml:premiseText": "employee, in relation to Australia Post, includes a person who performs services for or on behalf of Australia Post and an employee of such a person",
      "cml:conclusionText": "employee means a person who performs services for or on behalf of Australia Post."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
