        }
      ],
      "cml:integrityHash": "8c9a478e471d1a3eb27e359da605d72ab8cd75dbc140eff5869ba140944dfa7d",
      "skos:note": "Exemptions from subsection (2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23yg-ss-3",
      "@type": "cof:Section",
      "cof:title": "23YG(3) Material required to be made available to suspect, offender or",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(3) Subsection (2) does not apply to:\n\n(a) copies of records required to be made available under\nsubsection 23XE(5); and\n\n(b) material required to be provided under section 23XU; and\n\n(c) copies of results of analysis and other information required to\nbe provided under section 23XW."
    },
    {
