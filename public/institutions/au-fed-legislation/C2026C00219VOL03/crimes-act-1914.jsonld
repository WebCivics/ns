        },
        {
          "@id": "concept:crimes-act-1914-sec-23wo-ss-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "8b67df37aa594e02039d551f4b838d35913077601236dc8ee6f339c6a8d298a5",
      "skos:note": "Senior police officer must balance public interests when deciding to carry out forensic procedure without consent."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wo-ss-2",
      "@type": "cof:Section",
      "cof:title": "23WO(2) Matters to be considered by senior police officer before",
      "values:kind": "subsection",
