    {
      "@id": "concept:crimes-act-1914-sec-23wc",
      "@type": "cml:Concept",
      "skos:prefLabel": "23WC How forensic procedures may be authorised in different",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
