      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A seizure may be effected:\n\n(a) in Australia; or\n\n(b) on the high seas; or\n\n(c) in a place beyond the jurisdiction of any country."
    },
    {
      "@id": "concept:crimes-act-1914-sec-53-ss-2-logic-diffusion-4",
