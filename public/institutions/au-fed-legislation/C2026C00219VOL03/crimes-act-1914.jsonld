      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person shall be taken, in any State or Territory, for all purposes, never to have been convicted of the offence.",
      "cml:conclusionText": "The person shall be taken, in a foreign country, by any Commonwealth authority or State authority in that country, for all purposes, never to have been convicted of the offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1-logic-deontic-4",
