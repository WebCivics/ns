      },
      "cml:premiseText": "The constable is not required to comply with subsection (4) if...",
      "cml:conclusionText": "The exemption is justified under this condition."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wh",
      "@type": "cml:Concept",
