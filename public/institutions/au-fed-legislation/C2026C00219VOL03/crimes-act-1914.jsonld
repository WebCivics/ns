      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.176",
      "values:originalText": "(6) A person shall be taken to utter a forged postage stamp if the\nperson:\n\n(a) tenders it or puts it off; or\n\n(c) uses or deals with it; or\n\n(e) attempts to induce any person to use, deal with, act on or\naccept it.",
      "skos:definition": "(6) A person shall be taken to utter a forged postage stamp if the\nperson:\n\n(a) tenders it or puts it off; or\n\n(c) uses or deals with it; or\n\n(e) attempts to induce any person to use, deal with, act on or\naccept it.",
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-85f"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-85f-ss-6-norm"
