    {
      "@id": "concept:crimes-act-1914-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Piracy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
