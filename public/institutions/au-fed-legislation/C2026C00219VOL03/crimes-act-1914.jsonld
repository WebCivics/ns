    {
      "@id": "concept:crimes-act-1914-sec-85w-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "85W(4) Causing controlled drugs or controlled plants to be carried by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85w-ss-4"
      },
      "cml:curationStatus": {
