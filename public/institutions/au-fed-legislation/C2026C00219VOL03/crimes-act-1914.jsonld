        },
        {
          "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-ltl-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-deontic-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xr-ss-4-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "d047d2e1fb80b457d07aa0e3451195673c789c16809942fb162d681b80540f5a",
      "skos:note": "Excluding an interview friend from a forensic procedure if they unreasonably interfere."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xr-ss-4",
      "@type": "cof:Section",
      "cof:title": "23XR(4) Presence of interview friend or legal representative—",
      "values:kind": "subsection",
      "cof:pageNumber": 71,
      "values:originalText": "(4) An interview friend (other than a legal representative) of the\nsuspect may be excluded from the place where the forensic\nprocedure is being carried out if the interview friend unreasonably\ninterferes with or obstructs the carrying out of the procedure."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xr-ss-4-norm",
