      ],
      "cml:integrityHash": "4ca83160291247cf34407512841e4fa8450f514048bcdefa9da5fefa579a1021",
      "skos:note": "Senior police officer must be satisfied about suspect's custody and offence relevance before proceeding with forensic procedure."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23wo-ss-1",
      "@type": "cof:Section",
      "cof:title": "23WO(1) Matters to be considered by senior police officer before",
      "values:kind": "subsection",
      "cof:pageNumber": 45,
      "values:originalText": "(1) The senior police officer must be satisfied on the balance of\nprobabilities that:\n\n(a) the suspect is in the lawful custody of a constable; and\n\n(b) there are reasonable grounds to believe that the suspect\ncommitted a relevant offence; and\n\n(c) there are reasonable grounds to believe that the forensic\nprocedure is likely to produce evidence tending to confirm or\ndisprove that the suspect committed a relevant offence; and\n\n(d) the carrying out of the forensic procedure without consent is\njustified in all the circumstances."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23wo-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
