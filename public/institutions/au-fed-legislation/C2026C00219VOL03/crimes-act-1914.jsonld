    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr",
      "@type": "cml:Concept",
      "skos:prefLabel": "85ZR Pardons for persons wrongly convicted",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.191",
      "values:originalText": "(1) Despite any other Commonwealth law or any State law or Territory\nlaw, where a person has been granted a free and absolute pardon\nfor a Commonwealth offence or a Territory offence because the\nperson was wrongly convicted of the offence:\n\n(a) the person shall be taken, in any State or Territory, for all\npurposes, never to have been convicted of the offence; and\n\n(b) the person shall be taken, in a foreign country, by any\nCommonwealth authority or State authority in that country,\nfor all purposes, never to have been convicted of the offence.\n\n(2) Despite any other Commonwealth law or any Territory law, where,\nunder a State law or a foreign law a person is, in particular\ncircumstances or for a particular purpose, to be taken never to have\nbeen convicted of an offence under a law of that State or foreign\ncountry:\n\n(a) the person shall be taken, in any Territory, in corresponding\ncircumstances or for a corresponding purpose, never to have\nbeen convicted of that offence; and\n\n(b) the person shall be taken, in any State or foreign country, in\ncorresponding circumstances or for a corresponding purpose,\nby any Commonwealth authority in that State or country,\nnever to have been convicted of that offence.",
      "skos:definition": "(1) Despite any other Commonwealth law or any State law or Territory\nlaw, where a person has been granted a free and absolute pardon\nfor a Commonwealth offence or a Territory offence because the\nperson was wrongly convicted of the offence:\n\n(a) the person shall be taken, in any State or Territory, for all\npurposes, never to have been convicted of the offence; and\n\n(b) the person shall be taken, in a foreign country, by any\nCommonwealth authority or State authority in that country,\nfor all purposes, never to have been convicted of the offence.\n\n(2) Despite any other Commonwealth law or any Territory law, where,\nunder a State law or a foreign law a person is, in particular\ncircumstances or for a particular purpose, to be taken never to have\nbeen convicted of an offence under a law of that State or foreign\ncountry:\n\n(a) the person shall be taken, in any Territory, in corresponding\ncircumstances or for a corresponding purpose, never to have\nbeen convicted of that offence; and\n\n(b) the person shall be taken, in any State or foreign country, in\ncorresponding circumstances or for a corresponding purpose,\nby any Commonwealth authority in that State or country,\nnever to have been convicted of that offence.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-act-1914-sec-85zr-ss-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85zr-ss-2"
        }
      ],
      "cml:integrityHash": "2c731e80acf22c5cb98e9fa317682b1ba9d42f0d239d1db8c0780d9b0bda03f6"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zr",
      "@type": "cof:Section",
      "cof:title": "85ZR Pardons for persons wrongly convicted",
      "values:kind": "section",
      "cof:pageNumber": 191,
      "values:originalText": "(1) Despite any other Commonwealth law or any State law or Territory\nlaw, where a person has been granted a free and absolute pardon\nfor a Commonwealth offence or a Territory offence because the\nperson was wrongly convicted of the offence:\n\n(a) the person shall be taken, in any State or Territory, for all\npurposes, never to have been convicted of the offence; and\n\n(b) the person shall be taken, in a foreign country, by any\nCommonwealth authority or State authority in that country,\nfor all purposes, never to have been convicted of the offence.\n\n(2) Despite any other Commonwealth law or any Territory law, where,\nunder a State law or a foreign law a person is, in particular\ncircumstances or for a particular purpose, to be taken never to have\nbeen convicted of an offence under a law of that State or foreign\ncountry:\n\n(a) the person shall be taken, in any Territory, in corresponding\ncircumstances or for a corresponding purpose, never to have\nbeen convicted of that offence; and\n\n(b) the person shall be taken, in any State or foreign country, in\ncorresponding circumstances or for a corresponding purpose,\nby any Commonwealth authority in that State or country,\nnever to have been convicted of that offence."
    },
    {
      "@id": "concept:crimes-act-1914-sec-85zr-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "85ZR(1) Pardons for persons wrongly convicted",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zr-ss-1"
      },
      "cml:curationStatus": {
