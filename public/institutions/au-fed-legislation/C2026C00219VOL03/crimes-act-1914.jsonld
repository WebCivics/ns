    {
      "@id": "concept:crimes-act-1914-sec-85e",
      "@type": "cml:Concept",
      "skos:prefLabel": "85E Interpretation—definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.175",
      "values:originalText": "In this Part, unless the contrary intention appears:\narticle in the course of post means an article that is being carried\nby post, and includes an article that has been collected or received\nby Australia Post for carriage by post, but has not been delivered\nby Australia Post.\nAustralia Post means the Australian Postal Corporation.\ncarried by post means carried by or through Australia Post.\nemployee, in relation to Australia Post, includes a person who\nperforms services for or on behalf of Australia Post and an\nemployee of such a person.\nmail-bag includes a package, parcel, container or wrapper\nbelonging to Australia Post in which articles in the course of post\nare customarily contained, whether or not it actually contains such\narticles.\npostal message means:\n\n(a) a material record of an unwritten communication:\n\n(i) carried by post; or\n\n(ii) collected or received by Australia Post for carriage by\npost; or\n\n(b) a material record issued by Australia Post as a record of an\nunwritten communication:\n\n(i) carried by post; or\n\n(ii) collected or received by Australia Post for carriage by\npost.",
      "skos:definition": "In this Part, unless the contrary intention appears:\narticle in the course of post means an article that is being carried\nby post, and includes an article that has been collected or received\nby Australia Post for carriage by post, but has not been delivered\nby Australia Post.\nAustralia Post means the Australian Postal Corporation.\ncarried by post means carried by or through Australia Post.\nemployee, in relation to Australia Post, includes a person who\nperforms services for or on behalf of Australia Post and an\nemployee of such a person.\nmail-bag includes a package, parcel, container or wrapper\nbelonging to Australia Post in which articles in the course of post\nare customarily contained, whether or not it actually contains such\narticles.\npostal message means:\n\n(a) a material record of an unwritten communication:\n\n(i) carried by post; or\n\n(ii) collected or received by Australia Post for carriage by\npost; or\n\n(b) a material record issued by Australia Post as a record of an\nunwritten communication:\n\n(i) carried by post; or\n\n(ii) collected or received by Australia Post for carriage by\npost.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-85e-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-5"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-6"
        },
        {
          "@id": "concept:crimes-act-1914-sec-85e-logic-descriptionlogic-7"
        }
      ],
      "cml:integrityHash": "f1821bb4c895ea87d7a2a9349e8a036426dbac65ec5d26a938716e36999c906d",
      "skos:note": "Definitions for postal terms"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85e",
      "@type": "cof:Section",
      "cof:title": "85E Interpretation—definitions",
      "values:kind": "section",
      "cof:pageNumber": 175,
      "values:originalText": "In this Part, unless the contrary intention appears:\narticle in the course of post means an article that is being carried\nby post, and includes an article that has been collected or received\nby Australia Post for carriage by post, but has not been delivered\nby Australia Post.\nAustralia Post means the Australian Postal Corporation.\ncarried by post means carried by or through Australia Post.\nemployee, in relation to Australia Post, includes a person who\nperforms services for or on behalf of Australia Post and an\nemployee of such a person.\nmail-bag includes a package, parcel, container or wrapper\nbelonging to Australia Post in which articles in the course of post\nare customarily contained, whether or not it actually contains such\narticles.\npostal message means:\n\n(a) a material record of an unwritten communication:\n\n(i) carried by post; or\n\n(ii) collected or received by Australia Post for carriage by\npost; or\n\n(b) a material record issued by Australia Post as a record of an\nunwritten communication:\n\n(i) carried by post; or\n\n(ii) collected or received by Australia Post for carriage by\npost."
    },
