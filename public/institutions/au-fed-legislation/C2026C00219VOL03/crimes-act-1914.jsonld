    },
    {
      "@id": "concept:crimes-act-1914-sec-30k-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits compelling or inducing surrender or departure from employment",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) compels or induces any person employed in or in connexion with the provision of any public service by the Commonwealth or by any Department or public authority under the Commonwealth to surrender or depart from his or her employment;",
      "cml:conclusionText": "Compelling or inducing surrender or departure from employment is prohibited."
    },
    {
      "@id": "concept:crimes-act-1914-sec-30k-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits preventing offering or accepting employment",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) prevents any person from offering or accepting employment in or in connexion with the provision of any public service by the Commonwealth or by any Department or public authority under the Commonwealth;",
      "cml:conclusionText": "Preventing offering or accepting employment is prohibited."
    },
    {
      "@id": "concept:crimes-act-1914-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Judicial proceeding and tribunal definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.152",
      "values:originalText": "In this Act:\nfederal judicial proceeding means:\n\n(a) a judicial proceeding in or before:\n\n(i) a federal court; or\n\n(ii) a court exercising federal jurisdiction; or\n\n(iii) a court of a Territory; or\n\n(b) a judicial proceeding before a body or person acting under a\nlaw of:\n\n(i) the Commonwealth; or\n\n(ii) a Territory.\njudicial proceeding means (other than in section 3L):\n\n(a) a proceeding in or before a court; or\n\n(b) a proceeding:\n\n(i) before a body, or a person, acting under a law of the\nCommonwealth, of a State or of a Territory; and\n\n(ii) in which evidence may be taken on oath.\njudicial tribunal means a body or person (other than a court)\nbefore whom a judicial proceeding is conducted.\n\n\nOffences relating to the administration of justice  Part III\nJudges and magistrates  Division 2\n\nSection 34\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "skos:definition": "In this Act:\nfederal judicial proceeding means:\n\n(a) a judicial proceeding in or before:\n\n(i) a federal court; or\n\n(ii) a court exercising federal jurisdiction; or\n\n(iii) a court of a Territory; or\n\n(b) a judicial proceeding before a body or person acting under a\nlaw of:\n\n(i) the Commonwealth; or\n\n(ii) a Territory.\njudicial proceeding means (other than in section 3L):\n\n(a) a proceeding in or before a court; or\n\n(b) a proceeding:\n\n(i) before a body, or a person, acting under a law of the\nCommonwealth, of a State or of a Territory; and\n\n(ii) in which evidence may be taken on oath.\njudicial tribunal means a body or person (other than a court)\nbefore whom a judicial proceeding is conducted.\n\n\nOffences relating to the administration of justice  Part III\nJudges and magistrates  Division 2\n\nSection 34\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-31-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-31-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-31-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "7146e142f9b4b2debc90e247080026fdbb49778dae051d203c2f25b7ea8d1669",
      "skos:note": "Defines judicial proceeding and tribunal."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Judicial proceeding and tribunal definitions",
      "values:kind": "section",
      "cof:pageNumber": 152,
      "values:originalText": "In this Act:\nfederal judicial proceeding means:\n\n(a) a judicial proceeding in or before:\n\n(i) a federal court; or\n\n(ii) a court exercising federal jurisdiction; or\n\n(iii) a court of a Territory; or\n\n(b) a judicial proceeding before a body or person acting under a\nlaw of:\n\n(i) the Commonwealth; or\n\n(ii) a Territory.\njudicial proceeding means (other than in section 3L):\n\n(a) a proceeding in or before a court; or\n\n(b) a proceeding:\n\n(i) before a body, or a person, acting under a law of the\nCommonwealth, of a State or of a Territory; and\n\n(ii) in which evidence may be taken on oath.\njudicial tribunal means a body or person (other than a court)\nbefore whom a judicial proceeding is conducted.\n\n\nOffences relating to the administration of justice  Part III\nJudges and magistrates  Division 2\n\nSection 34\n\nCrimes Act 1914\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:crimes-act-1914-sec-31-norm",
