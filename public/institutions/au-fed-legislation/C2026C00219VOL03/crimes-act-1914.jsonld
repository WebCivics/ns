        }
      ],
      "cml:integrityHash": "7d6888f91b59770b7cc46f4f710595bcc3dfa7916b16a11fbaa85987eb71332e",
      "skos:note": "Obligation on States to consider pardons for persons wrongly convicted"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-85zs",
      "@type": "cof:Section",
