          "@id": "concept:crimes-act-1914-sec-90a-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-90a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "629adb85c183497deb28b7b88f563014be03bfda9ff062c30cda438206ff7c04",
      "skos:note": "Destroying or damaging Commonwealth loan posters is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-90a",
      "@type": "cof:Section",
      "cof:title": "90A Destroying etc. posters etc. relating to Commonwealth loans",
      "values:kind": "section",
      "cof:pageNumber": 226,
      "values:originalText": "A person shall not, without lawful authority, destroy, injure,\ndisfigure or remove a poster, advertisement or notice relating to a\nCommonwealth loan.\nPenalty: Imprisonment for 1 year."
    },
