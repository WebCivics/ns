      "cml:premiseText": "(3) A person commits an offence if:\n\n(a) the person does an act; and\n\n(b) the person does so with the intention of inducing a person\ncalled, or to be called, as a witness in a judicial proceeding:",
      "cml:conclusionText": "The act overlaps with the judicial proceeding."
    },
    {
      "@id": "concept:crimes-act-1914-sec-37-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal until: The act occurs before the judicial proceeding.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person commits an offence if:\n\n(a) the person does an act; and\n\n(b) the person does so with the intention of inducing a person\ncalled, or to be called, as a witness in a judicial proceeding:",
      "cml:conclusionText": "The act occurs before the judicial proceeding."
    },
    {
      "@id": "concept:crimes-act-1914-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Deceiving witnesses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-38"
      },
      "cml:curationStatus": {
