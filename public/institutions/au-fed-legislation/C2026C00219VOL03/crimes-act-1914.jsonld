      }
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XL Taking of hair samples",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-1914.pdf"
      },
      "dc:source": "crimes-act-1914.pdf, p.63",
      "values:originalText": "A person is authorised to take a sample of hair of a suspect by\nremoving the root of the hair only if:\n\n(a) the person takes only so much hair as the person believes is\nnecessary for analysis of the sample, or other examination of\nthe hair, to be carried out for the purpose of investigating the\noffence; and\n\n(b) the sample is taken using the least painful technique known\nand available to the person.\nSubdivision B—Persons involved in forensic procedures",
      "skos:definition": "A person is authorised to take a sample of hair of a suspect by\nremoving the root of the hair only if:\n\n(a) the person takes only so much hair as the person believes is\nnecessary for analysis of the sample, or other examination of\nthe hair, to be carried out for the purpose of investigating the\noffence; and\n\n(b) the sample is taken using the least painful technique known\nand available to the person.\nSubdivision B—Persons involved in forensic procedures",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-1914-sec-23xl-norm"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-3"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-4"
        },
        {
          "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "928de6550d757e6c518fd04cf9ba0efd914bf4d83e536757f9239f4402e62842",
      "skos:note": "Authorisation for taking hair samples under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-1914#sec-23xl",
      "@type": "cof:Section",
      "cof:title": "23XL Taking of hair samples",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "A person is authorised to take a sample of hair of a suspect by\nremoving the root of the hair only if:\n\n(a) the person takes only so much hair as the person believes is\nnecessary for analysis of the sample, or other examination of\nthe hair, to be carried out for the purpose of investigating the\noffence; and\n\n(b) the sample is taken using the least painful technique known\nand available to the person.\nSubdivision B—Persons involved in forensic procedures"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-act-1914-sec-23xl"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Granting permission for a specific action.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person takes only so much hair as the person believes is necessary",
      "cml:conclusionText": "Permission granted to take a sample of hair."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposing an obligation on the person taking the sample.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The sample is taken using the least painful technique known and available to the person.",
      "cml:conclusionText": "The person must use the least painful technique."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibiting certain actions for taking hair samples.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The sample is not taken using a technique that causes unnecessary pain or discomfort.",
      "cml:conclusionText": "This action must not cause unnecessary pain or discomfort."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Granting permission for the person to take hair samples under certain conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The sample is taken using the least painful technique known and available to the person.",
      "cml:conclusionText": "Permission granted to take a sample of hair."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xl-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:logicSummary": "Granting a right to the suspect to refuse taking a hair sample.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must inform the suspect that they have the right to refuse taking a sample of hair.",
      "cml:conclusionText": "This action is not mandatory."
    },
    {
      "@id": "concept:crimes-act-1914-sec-23xm",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XM Persons who may carry out forensic procedures",
      "cml:realizedBy": {
