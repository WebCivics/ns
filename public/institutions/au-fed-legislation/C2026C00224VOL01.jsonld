    {
      "@id": "concept:telecommunications-act-1997-sec-37-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is no temporal interval between an area of land being considered a property and it not being considered a property unless provided in this section.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
