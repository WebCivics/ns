    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.91",
      "skos:note": "Grant of carrier licence to a particular person would be prejudicial to security.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "58A(1) Refusal of carrier licence—security"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sec-58a-ss-1-norm",
        "concept:telecommunications-act-1997-sec-58a-ss-1-logic-deontic-1",
        "concept:telecommunications-act-1997-sec-58a-ss-1-logic-alleninterval-2",
        "concept:telecommunications-act-1997-sec-58a-ss-1-logic-ltl-3",
        "concept:telecommunications-act-1997-sec-58a-ss-1-logic-diffusion-4",
        "concept:telecommunications-act-1997-sec-58a-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d09939e30b1fdab013a481cc245405edeaf41b798a0499112d29eece25da2eec",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-act-1997#sec-58a-ss-1",
