      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Knowledge graph of permitted and prohibited information.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge Graph",
      "cml:premiseText": "(a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use or disclosure referred to in paragraph (b) of this subsection is not for a purpose connected with persons being alerted to the emergency or likely emergency concerned.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of disclosing or using information without permission.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and (b) the person uses or discloses the information;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information spreads from the person to others through their actions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spread of information through use or disclosure.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:premiseText": "(b) the person uses or discloses the information;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The recurring trace is from the time the person receives the information to the present.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of when the person uses or discloses the information.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "(b) the person uses or discloses the information;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-1-norm",
      "@type": "doc:Prohibition",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:telecommunications-act-1997-sec-295za-ss-1"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.328",
      "skos:note": "Disclosing or using information without permission is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "295ZA(2) Offence—use or disclosure of information by other persons"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sec-295za-ss-2-norm",
        "concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-1",
        "concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-2",
        "concept:telecommunications-act-1997-sec-295za-ss-2-logic-alleninterval-3",
        "concept:telecommunications-act-1997-sec-295za-ss-2-logic-ltl-4",
        "concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "003197d2e74a2f897d1e267477c7a9d91ca09389dfa63fcc391fc4b954f95890",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-act-1997#sec-295za-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-act-1997-sec-295za"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal relation between information disclosure and use is that the use occurs after the disclosure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between information disclosure and use.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(2) A person commits an offence if:  (a) information is disclosed to the person as permitted by subsection 295V(3) or 295W(2); and  (b) the person uses or discloses the information;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of disclosing or using information without permission.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Information is disclosed to the person as permitted by subsection 295V(3) or 295W(2);"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of using or disclosing information for testing purposes.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) the person uses or discloses the information;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of using or disclosing information for emergency purposes.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) the use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The recurring trace of information disclosure and use indicates that the person has committed an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of information disclosure and use.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:premiseText": "(2) A person commits an offence if:  (a) information is disclosed to the person as permitted by subsection 295V(3) or 295W(2); and  (b) the person uses or discloses the information;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-295za-ss-2-norm",
      "@type": "doc:Prohibition",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
