    {
      "@id": "concept:telecommunications-act-1997-sec-76-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This is a temporal interval during which the Commonwealth is not liable to charge.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The section defines a temporal interval during which the Commonwealth is not liable to charge.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(2) A reference in this section to the Commonwealth includes a reference to an authority of the Commonwealth that cannot, by law of the Commonwealth, be made liable to taxation by the Commonwealth."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-76-ss-2-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This recognizes a pattern of non-liability for taxation in the Commonwealth.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The section recognizes a pattern of non-liability for taxation in the Commonwealth.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "(2) A reference in this section to the Commonwealth includes a reference to an authority of the Commonwealth that cannot, by law of the Commonwealth, be made liable to taxation by the Commonwealth."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-76-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth is not liable to charge for certain authorities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the Commonwealth is not liable to charge, then it cannot be taxed.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(2) A reference in this section to the Commonwealth includes a reference to an authority of the Commonwealth that cannot, by law of the Commonwealth, be made liable to taxation by the Commonwealth."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-76-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This is an authority that cannot be taxed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "This section defines a subclass of 'authority' that cannot be taxed.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "SubClassOf",
      "cml:premiseText": "(2) A reference in this section to the Commonwealth includes a reference to an authority of the Commonwealth that cannot, by law of the Commonwealth, be made liable to taxation by the Commonwealth."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-76-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This spreads knowledge about the Commonwealth's non-liability to charge.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The section spreads knowledge about the Commonwealth's non-liability to charge.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "(2) A reference in this section to the Commonwealth includes a reference to an authority of the Commonwealth that cannot, by law of the Commonwealth, be made liable to taxation by the Commonwealth."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-76-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "This is a recurring pattern of non-liability for taxation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The section defines a recurring pattern of non-liability for taxation.",
