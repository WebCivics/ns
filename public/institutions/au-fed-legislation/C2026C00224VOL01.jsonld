    },
    {
      "@id": "concept:telecommunications-act-1997-sec-37-ss-2",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.66",
      "skos:note": "A property is a single freehold or leasehold title in relation to an area of land, unless it is only part of another such area.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "37(2) Properties"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": "concept:telecommunications-act-1997-sec-37-ss-2-norm",
