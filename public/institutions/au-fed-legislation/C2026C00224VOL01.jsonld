      "partOf": "concept:telecommunications-act-1997-sec-58a"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The grant of a carrier licence occurs during the period where national security is at risk.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Identifies temporal intervals where the grant of a carrier licence would be prejudicial to security.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The CogAI system recognises the Home Affairs Minister's expertise in national security.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognises the Home Affairs Minister's authority in determining who can be granted a carrier licence.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognises",
      "cml:premiseText": "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The grant of a carrier licence to the person would be prejudicial to security.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits granting a carrier licence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information spreads that granting a carrier licence to the individual would be prejudicial to security.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffuses information about individuals who would be granted a carrier licence if it were not for the Home Affairs Minister's direction.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spreads",
      "cml:premiseText": "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The pattern of granting carrier licences to individuals with potential threats to national security recurs.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Identifies recurring patterns in the grant of carrier licences that would be prejudicial to security.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-58a-ss-1-norm",
      "@type": "doc:Prohibition",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
