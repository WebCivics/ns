      "cml:logicSummary": "Class hierarchy",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Facility or combination is used in connection with supply of carriage service"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-35-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Facility or combination has double-ended interconnection",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Some or all communications carried by facility or combination have characteristic of double-ended interconnection"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-35-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Facility or combination has recurring double-ended interconnection",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace",
