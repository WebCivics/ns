      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies entities into types",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "ACNC type of entity means an entity that meets the description of a type of entity in column 1 of the table in subsection 25-5(5) of the Australian Charities and Not-for-profits Commission Act 2012."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-7-logic-descriptionlogic-3",
