      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:premiseText": "An area of land is not a property except as provided in this section."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-37-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is no cognitive agent that considers an area of land to be a property unless provided in this section.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
