      "skos:prefLabel": {
        "@language": "en",
        "@value": "143F(2) Exemptions—lines installed in close proximity to other lines"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sec-143f-ss-2-norm",
        "concept:telecommunications-act-1997-sec-143f-ss-2-logic-alleninterval-1",
