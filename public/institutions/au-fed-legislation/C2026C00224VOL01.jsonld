    {
      "@id": "concept:telecommunications-act-1997-sec-37-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) An area of land is a property if:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires a single freehold or leasehold title, no part subject to a lease, and defined by geographical coordinates.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "(a) there is a single freehold or leasehold title in relation to that area (whether or not that title is registered under a law of a State or Territory relating to the registration of interests in land);"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-37-ss-1-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
