      "cml:logicSummary": "Describes the temporal relationship between occupation and use",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(a) occupies the property; or (b) uses the property for the purpose that is the sole or principal purpose for which the property is used."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-39-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If a person occupies the property or uses it for its sole or principal purpose, then they are the principal user of the property.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Describes the logical implication of occupation and use",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(a) occupies the property; or (b) uses the property for the purpose that is the sole or principal purpose for which the property is used."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-39-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person who occupies the property or uses it for its sole or principal purpose is the principal user.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the principal user",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(a) occupies the property; or (b) uses the property for the purpose that is the sole or principal purpose for which the property is used."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-39-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person who occupies the property and uses it for its sole or principal purpose also has a certain relationship with the property.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Describes the relationship between occupation and use",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "and",
      "cml:premiseText": "(a) occupies the property; or (b) uses the property for the purpose that is the sole or principal purpose for which the property is used."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-39-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person who occupies the property until a certain point in time also uses it for its sole or principal purpose.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes the temporal relationship between occupation and use",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "(a) occupies the property; or (b) uses the property for the purpose that is the sole or principal purpose for which the property is used."
