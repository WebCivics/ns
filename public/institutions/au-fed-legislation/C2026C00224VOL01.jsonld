    {
      "@id": "concept:telecommunications-act-1997-sec-81-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.115",
      "skos:note": "The ACMA may declare the applicant as the nominated carrier if they can comply with obligations and will not impede administration.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "81(1) Making a nominated carrier declaration"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
