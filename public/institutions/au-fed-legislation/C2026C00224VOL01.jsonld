    {
      "@id": "concept:telecommunications-act-1997-sec-284-ss-1a-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure is permitted if it occurs during the eSafety Commissioner's functions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relationship between disclosure and assistance",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The disclosure must be made during the eSafety Commissioner's functions."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-284-ss-1a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure is permitted under certain conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permissive language",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:premiseText": "The disclosure is not required but permitted."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-284-ss-1a-logic-epistemic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure is permitted if it assists the eSafety Commissioner.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Conditional relationship between disclosure and assistance",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "If the information or document assists the eSafety Commissioner, then it can be disclosed."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-284-ss-1a-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The disclosure is permitted if it occurs before that point.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal relationship between disclosure and assistance",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "The information or document may assist the eSafety Commissioner until a certain point."
    },
