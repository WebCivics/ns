      "cml:logicSummary": "Temporal relationship with units",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "in relation to",
      "cml:premiseText": "...the network units if the ACMA is satisfied that:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-81-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The applicant can comply with obligations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Ability to comply with obligations",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:premiseText": "(a) if the declaration were made, the applicant would be in a position to comply with all of the obligations imposed on the applicant..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-81-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The declaration must not impede administration.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No impediment to administration",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must not impede",
      "cml:premiseText": "(b) the making of the declaration will not impede the efficient administration of this Act."
    },
    {
