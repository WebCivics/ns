    {
      "@id": "concept:telecommunications-act-1997-sec-158a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.288",
      "skos:note": "Local access line deemed to have come into existence on or after the designated commencement date if it was in existence immediately before and is extended on or after that date.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "158A(1) Deemed local access lines"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sec-158a-ss-1-norm",
        "concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-1",
        "concept:telecommunications-act-1997-sec-158a-ss-1-logic-alleninterval-2",
        "concept:telecommunications-act-1997-sec-158a-ss-1-logic-ltl-3",
        "concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "6c04cd9983fc55475831f951291a6c2dd6c9ec2398c7427b80ed99754eccbb4d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-act-1997#sec-158a-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-act-1997-sec-158a"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-158a-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the extension is taken to be a local access line in its own right;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes a temporal relationship between the designated commencement date and the date when the local access line was in existence immediately before.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(a) a local access line was in existence immediately before the designated commencement date;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the extension is taken to be a local access line in its own right;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the state to treat the local access line as having come into existence on or after the designated commencement date.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(a) a local access line was in existence immediately before the designated commencement date;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the extension is taken to be a local access line in its own right;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the state to treat the local access line as having come into existence on or after the designated commencement date.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(d) the local access line referred to in paragraph (c) is taken to have come into existence on or after the designated commencement date."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-158a-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the extension is taken to be a local access line in its own right;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes a temporal relationship between the designated commencement date and the date when the local access line was extended.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(b) the line is extended on or after the designated commencement date;"
    },
