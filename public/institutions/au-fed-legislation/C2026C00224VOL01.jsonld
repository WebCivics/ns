    {
      "@id": "concept:telecommunications-act-1997-sec-35-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Facility or combination has been used in connection with supply of carriage service for some time",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "Facility or combination is used in connection with supply of carriage service between 2 or more fixed points"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-35-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Facility or combination is not part of a terrestrial radiocommunications customer access network",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "!=",
      "cml:premiseText": "Facility or combination does not consist of one or more base stations that are part of a terrestrial radiocommunications customer access network"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-35-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Facility or combination is not affected by paragraph 34(1)(h)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "!=",
      "cml:premiseText": "Facility or combination does not consist of one or more base stations that would be part of such a network if paragraph 34(1)(h) had not been enacted"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-35-ss-1-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Facility or combination is a fixed radiocommunications link",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
