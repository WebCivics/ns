    {
      "@id": "concept:telecommunications-act-1997-sec-155",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.279",
      "skos:note": "A person is in a position to exercise control of a telecommunications network if they meet certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "155 When a person is in a position to exercise control of a network"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sec-155-norm",
        "concept:telecommunications-act-1997-sec-155-logic-deontic-1",
        "concept:telecommunications-act-1997-sec-155-logic-alleninterval-2",
        "concept:telecommunications-act-1997-sec-155-logic-argumentation-3",
        "concept:telecommunications-act-1997-sec-155-logic-diffusion-4",
        "concept:telecommunications-act-1997-sec-155-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9f19af02888ee9bbdb7ef961196b9490db534edf7591fd854a175adf1211599b",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-act-1997#sec-155",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller has control during this time period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "During what time period does the controller have control?",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(i) to exercise control of the operation of all or part of the network..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller has control if they own the network.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If the controller meets these conditions, then they have control.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(a) the controller legally or beneficially owns the network..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Others recognize the controller's control.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The controller is recognized as having control by others.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:premiseText": "(ii) the controller, either alone or together with an associate of the controller, is in a position to veto any action taken by the board of directors of the company..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller has control over the network.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has control over a telecommunications network.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasControl",
      "cml:premiseText": "(a) the controller legally or beneficially owns the network..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller's control diffuses to other parts of the network.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The controller's control spreads to other parts of the network.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "(ii) to exercise control of the selection of the kinds of services that are supplied using the network..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:telecommunications-act-1997-sec-155"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155a",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.281",
      "skos:note": "A person is in a position to exercise control of a line if they own it or have significant influence over its management.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "155A When a person is in a position to exercise control of a line"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sec-155a-norm",
        "concept:telecommunications-act-1997-sec-155a-logic-deontic-1",
        "concept:telecommunications-act-1997-sec-155a-logic-deontic-2",
        "concept:telecommunications-act-1997-sec-155a-logic-deontic-3",
        "concept:telecommunications-act-1997-sec-155a-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "f9b9a694b0948f60531e1262c497ce229385daf320a08c8acb13a020ac307287",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-act-1997#sec-155a",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person has control over the line.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has control",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasControl",
      "cml:premiseText": "The controller is in a position to exercise control of the operation of all or part of the line."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person has veto power over company actions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has veto power over company actions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasVetoPower",
      "cml:premiseText": "(ii) The controller, either alone or together with an associate of the controller, is in a position to veto any action taken by the board of directors of the company."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person has appointment power over company directors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has appointment power over company directors",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasAppointmentPower",
      "cml:premiseText": "(iii) The controller, either alone or together with an associate of the controller, is in a position to appoint or secure the appointment of, or veto the appointment of, at least half of the board of directors of the company."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person has direction power over company management.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has direction power over company management",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasDirectionPower",
      "cml:premiseText": "(iv) The controller, either alone or together with an associate of the controller, is in a position to exercise, in any other manner, whether directly or indirectly, direction or restraint over any substantial issue affecting the management or affairs of the company."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-155a-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:telecommunications-act-1997-sec-155a"
    },
