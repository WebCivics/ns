<https://ns.webcivics.net/concept/telecommunications-act-1997-sec-32-ss-2-logic-deontic-5> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "permission";
    <https://ns.webcivics.net/cml/logicSummary> "Permits primary network to supply services between customer equipment and other such equipment for exemption purposes.";
    <https://ns.webcivics.net/cml/premiseText> "(c) the supply of carriage services between such equipment and equipment connected to the network units is, at most, an ancillary function of the primary network;";
    <https://ns.webcivics.net/cml/conclusionText> "The primary network may supply services between customer equipment and other such equipment as an ancillary function for exemption purposes.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 0.5000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
