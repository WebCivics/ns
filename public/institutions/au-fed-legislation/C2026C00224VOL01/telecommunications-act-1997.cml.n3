concept:telecommunications-act-1997-sec-46 a cml:Concept ;
    skos:prefLabel "46 Exemption—intelligence operations"@en ;
    cml:realizedBy doc:sec-46 ;
    values:originalText "Section 42 does not apply to a network unit that is used wholly or principally:  (a) by the Australian Secret Intelligence Service; or  (b) by the Australian Security Intelligence Organisation; or  (c) by the Australian Signals Directorate." ;
    skos:definition "Section 42 does not apply to a network unit that is used wholly or principally:  (a) by the Australian Secret Intelligence Service; or  (b) by the Australian Security Intelligence Organisation; or  (c) by the Australian Signals Directorate."@en ;
    cml:integrityHash "afd9f017a40e0c37621cbb311f69551b414b61253c0e9254109ba8f9c6ed0c39" ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Exempts certain intelligence operations from Section 42." ;
