concept:telecommunications-act-1997-sec-47-ss-9 a cml:Concept ;
    skos:prefLabel "47(9) Exemption—transport authorities"@en ;
    cml:realizedBy doc:sec-47-ss-9 ;
    values:originalText "(9) In this section: rail corporation means a body corporate that manages or operates either or both of the following:  (a) rail transport services;  (b) rail transport infrastructure." ;
