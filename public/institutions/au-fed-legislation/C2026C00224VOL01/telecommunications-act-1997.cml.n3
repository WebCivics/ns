    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval of consultation" ;
    cml:premiseText "ACMA must consult States and Territories within a certain time frame" ;
    cml:conclusionText "Consultation period is a necessary condition for industry standard determination or variation" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-135a cml:asserts concept:telecommunications-act-1997-sec-135a-logic-argumentation-3 .
