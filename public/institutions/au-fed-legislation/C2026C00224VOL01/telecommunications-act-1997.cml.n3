doc:sec-151s-ss-4 a cof:Section ;
    cof:title "151S(4) Withdrawal of variation that is under consideration" ;
    values:kind "subsection" ;
    values:originalText "(4) If:  (a) the person or persons withdraw the variation; and  (b) the person or persons have paid a fee in relation to the variation; the ACCC may, on behalf of the Commonwealth, refund the whole or a part of the fee." ;
    cof:pageNumber "249"^^xsd:integer .

