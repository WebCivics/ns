    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Identifies recurring patterns in the grant of carrier licences that would be prejudicial to security." ;
    cml:premiseText "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..." ;
    cml:conclusionText "The pattern of granting carrier licences to individuals with potential threats to national security recurs." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

