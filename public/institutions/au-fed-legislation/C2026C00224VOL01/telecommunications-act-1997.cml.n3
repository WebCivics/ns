concept:telecommunications-act-1997-sec-274 a cml:Concept ;
    skos:prefLabel "274 Telecommunications contractor"@en ;
    cml:realizedBy doc:sec-274 ;
    values:originalText "A reference in this Part to a telecommunications contractor is a reference to a person who performs services for or on behalf of:  (a) a carrier; or  (b) a carriage service provider; but does not include a reference to a person who performs such services in the capacity of an employee of the carrier or provider." ;
    skos:definition "A reference in this Part to a telecommunications contractor is a reference to a person who performs services for or on behalf of:  (a) a carrier; or  (b) a carriage service provider; but does not include a reference to a person who performs such services in the capacity of an employee of the carrier or provider."@en ;
    cml:integrityHash "98d4e4683572812dd2cd079807d3c6f6ca8413c18b9019563ca4ae4f98069575" ;
    cof:pageNumber "293"^^xsd:integer ;
    skos:note "Definition of telecommunications contractor" ;
