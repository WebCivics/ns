concept:telecommunications-act-1997-sec-11a a cml:Concept ;
    skos:prefLabel "11A Application of the Criminal Code"@en ;
    cml:realizedBy doc:sec-11a ;
    values:originalText "Chapter 2 of the Criminal Code (except Part 2.5) applies to all offences against this Act. Note: Chapter 2 of the Criminal Code sets out the general principles of criminal responsibility." ;
