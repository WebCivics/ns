    skos:note "Exemption from Part 1 for constitutional doctrine of implied freedom of political communication." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
