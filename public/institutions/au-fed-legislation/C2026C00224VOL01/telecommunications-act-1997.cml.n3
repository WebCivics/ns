concept:telecommunications-act-1997-sec-151w-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits revocation of undertaking if breach or contravention occurs." ;
    cml:premiseText "(a) a standard functional separation undertaking given by a person is in force; and (b) the person has breached a fundamental provision of the undertaking or contravened section 151ZF or 151ZG;" ;
    cml:conclusionText "The ACCC may not revoke the undertaking if breach or contravention occurs." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-151w-ss-1 cml:asserts concept:telecommunications-act-1997-sec-151w-ss-1-logic-alleninterval-2 .
concept:telecommunications-act-1997-sec-151w-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines the temporal interval for which the undertaking is in force." ;
    cml:premiseText "(a) a standard functional separation undertaking given by a person is in force;" ;
    cml:conclusionText "The undertaking is in force from the time it was given to the present." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

