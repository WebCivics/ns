concept:telecommunications-act-1997-sec-142bb a cml:Concept ;
    skos:prefLabel "142BB Terms and conditions"@en ;
    cml:realizedBy doc:sec-142bb ;
    values:originalText "For the purposes of this Part:  (a) a notional contract (however described) between a corporation’s business units is to be treated as if it were an actual contract; and  (b) any terms and conditions (whether or not relating to price or a method of ascertaining price) in such a notional contract are to be treated as if they were actual terms and conditions." ;
    skos:definition "For the purposes of this Part:  (a) a notional contract (however described) between a corporation’s business units is to be treated as if it were an actual contract; and  (b) any terms and conditions (whether or not relating to price or a method of ascertaining price) in such a notional contract are to be treated as if they were actual terms and conditions."@en ;
    cml:integrityHash "28d159d3188a72eebdd95756b473e9e6beb34182c044cb2d755117fa0469879b" ;
    cof:pageNumber "199"^^xsd:integer ;
    skos:note "Treats notional contracts as actual contracts for terms and conditions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.199" ;
