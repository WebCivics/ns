    cml:hasPart concept:telecommunications-act-1997-sec-56a-ss-7 ;
    cml:hasPart concept:telecommunications-act-1997-sec-56a-ss-8 ;
    cml:hasPart concept:telecommunications-act-1997-sec-56a-ss-9 ;
