doc:sec-151w-ss-3 a cof:Section ;
    cof:title "151W(3) Revocation of functional separation undertaking" ;
    values:kind "subsection" ;
    values:originalText "(3) If:  (a) a standard functional separation undertaking given by a person is in force; and  (b) the person requests the ACCC, in writing, to revoke the undertaking; the ACCC must, by written notice given to the person, revoke the undertaking." ;
    cof:pageNumber "252"^^xsd:integer .

concept:telecommunications-act-1997-sec-151w-ss-4 a cml:Concept ;
    skos:prefLabel "151W(4) Revocation of functional separation undertaking"@en ;
    cml:realizedBy doc:sec-151w-ss-4 ;
    values:originalText "(4) A revocation under subsection (1), (2) or (3) takes effect at the time specified in the notice of revocation. The specified time:  (a) must not be earlier than the time the notice is given; and  (b) must not be later than 12 months after the notice is given." ;
    skos:definition "(4) A revocation under subsection (1), (2) or (3) takes effect at the time specified in the notice of revocation. The specified time:  (a) must not be earlier than the time the notice is given; and  (b) must not be later than 12 months after the notice is given."@en ;
    cml:integrityHash "667b005f3af99c40cfa452ba572dfbd1e11302b875b370ba6e6102b7d57ecda4" ;
    values:partOf concept:telecommunications-act-1997-sec-151w ;
    cof:pageNumber "252"^^xsd:integer ;
    skos:note "Revocation takes effect within a specified time frame after notice is given." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
