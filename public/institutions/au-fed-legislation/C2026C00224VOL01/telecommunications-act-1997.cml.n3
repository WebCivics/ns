concept:telecommunications-act-1997-sec-43 a cml:Concept ;
    skos:prefLabel "43 Continuing offences"@en ;
    cml:realizedBy doc:sec-43 ;
    values:originalText "A person who contravenes section 42 commits a separate offence in respect of each day (including a day of a conviction under this section or any later day) during which the contravention continues." ;
    skos:definition "A person who contravenes section 42 commits a separate offence in respect of each day (including a day of a conviction under this section or any later day) during which the contravention continues."@en ;
    cml:integrityHash "d392efe6a9107de4a0286e915e09f8b4fd02abb1df48beaef854dde27b01dd8b" ;
    cof:pageNumber "71"^^xsd:integer ;
    skos:note "Continuing contravention of section 42 is a separate offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
