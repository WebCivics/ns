    cml:hasPart concept:telecommunications-act-1997-sec-142bd-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sec-142bd-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
