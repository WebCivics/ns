doc:sec-83-ss-6 a cof:Section ;
    cof:title "83(6) Revocation of nominated carrier declaration" ;
    values:kind "subsection" ;
    values:originalText "(6) The ACMA must not revoke a nominated carrier declaration under subsection (1) unless the ACMA has first:  (a) given the nominated carrier a written notice:  (i) setting out a proposal to revoke the declaration; and  (ii) inviting the nominated carrier to make a submission to the ACMA on the proposal; and  (b) considered any submission that was received within the time limit specified in the notice." ;
    cof:pageNumber "116"^^xsd:integer .

concept:telecommunications-act-1997-sec-83-ss-7 a cml:Concept ;
    skos:prefLabel "83(7) Revocation of nominated carrier declaration"@en ;
    cml:realizedBy doc:sec-83-ss-7 ;
    values:originalText "(7) A time limit specified in a notice under subsection (6) must run for at least 7 days." ;
    skos:definition "(7) A time limit specified in a notice under subsection (6) must run for at least 7 days."@en ;
    cml:integrityHash "c0c813c8eb735c7514c8994835d36b947bef69266177394e1617fd070e0303ff" ;
    values:partOf concept:telecommunications-act-1997-sec-83 ;
