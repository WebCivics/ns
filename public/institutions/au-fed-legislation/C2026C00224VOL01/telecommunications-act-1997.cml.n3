concept:telecommunications-act-1997-sec-151zk a cml:Concept ;
    skos:prefLabel "151ZK Delegation"@en ;
    cml:realizedBy doc:sec-151zk ;
    values:originalText "The ACCC may, by writing, delegate to a person who is:  (a) a member of the staff of the ACCC; and  (b) an SES employee or acting SES employee; the ACCC’s powers under any of the following provisions:  (c) subsection 103(4F) (formal warning);  (d) section 151D (further information);  (e) subsection 151F(7) (extension of decision-making period);   Local access lines  Part 8 Other provisions  Division 3  Section 151ZL  Telecommunications Act 1997  Compilation date: 04/06/2026  (f) section 151H (serial undertakings);  (g) section 151R (further information);  (h) subsection 151T(7) (extension of decision-making period)." ;
    skos:definition "The ACCC may, by writing, delegate to a person who is:  (a) a member of the staff of the ACCC; and  (b) an SES employee or acting SES employee; the ACCC’s powers under any of the following provisions:  (c) subsection 103(4F) (formal warning);  (d) section 151D (further information);  (e) subsection 151F(7) (extension of decision-making period);   Local access lines  Part 8 Other provisions  Division 3  Section 151ZL  Telecommunications Act 1997  Compilation date: 04/06/2026  (f) section 151H (serial undertakings);  (g) section 151R (further information);  (h) subsection 151T(7) (extension of decision-making period)."@en ;
    cml:integrityHash "32386669b3eb268b20acd91b7316b656f7d81b92925479b1d9ccac493f0c9b02" ;
    cof:pageNumber "274"^^xsd:integer ;
