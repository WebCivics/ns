doc:sec-275d a cof:Section ;
    cof:title "275D Emergency law" ;
    values:kind "section" ;
    values:originalText "(1) In this Part: emergency law means a law specified under subsection (2).  (2) The AFP Minister may, by legislative instrument, specify a law of a State or a Territory for the purposes of the definition of emergency law in subsection (1) of this section." ;
    cof:pageNumber "295"^^xsd:integer .

