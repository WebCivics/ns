concept:telecommunications-act-1997-sec-38 a cml:Concept ;
    skos:prefLabel "38 Combined areas"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "(1) 2 contiguous properties form a combined area.  (2) If:  (a) a property is contiguous with another property; and  (b) the other property forms part of a combined area; the first-mentioned property, and the combined area referred to in paragraph (b), together form a combined area." ;
    skos:definition "(1) 2 contiguous properties form a combined area.  (2) If:  (a) a property is contiguous with another property; and  (b) the other property forms part of a combined area; the first-mentioned property, and the combined area referred to in paragraph (b), together form a combined area."@en ;
    cml:integrityHash "a815c04c327ddf9de7fb76cbdd55816439ab5152dc0c32e5c40f3f18bceeceee" ;
    cof:pageNumber "67"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-38-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-38-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.67" .
