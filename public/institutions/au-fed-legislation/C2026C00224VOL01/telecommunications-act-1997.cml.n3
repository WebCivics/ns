    cml:modality cml:Diffusion ;
    cml:operator "Spread" ;
    cml:logicSummary "Spread of information through use or disclosure." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The information spreads from the person to others through their actions." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-cogai-5 .
