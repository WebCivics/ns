concept:telecommunications-act-1997-sec-58 a cml:Concept ;
    skos:prefLabel "58 Refusal of carrier licence—disqualified applicant"@en ;
    cml:realizedBy doc:sec-58 ;
    values:originalText "(1) The ACMA may refuse to grant a carrier licence to an applicant if, immediately before the ACMA makes its decision on the application, the applicant is disqualified." ;
    skos:definition "(1) The ACMA may refuse to grant a carrier licence to an applicant if, immediately before the ACMA makes its decision on the application, the applicant is disqualified."@en ;
