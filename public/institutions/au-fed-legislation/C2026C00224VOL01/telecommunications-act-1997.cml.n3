concept:telecommunications-act-1997-sec-40 a cml:Concept ;
    skos:prefLabel "40 Eligible combined areas"@en ;
    cml:realizedBy doc:sec-40 ;
    values:originalText "The Minister may, by legislative instrument, determine that specified combined areas are eligible combined areas for the purposes of paragraph 36(3)(b).   Carriers  Part 3 Simplified outline  Division 1  Section 41  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "The Minister may, by legislative instrument, determine that specified combined areas are eligible combined areas for the purposes of paragraph 36(3)(b).   Carriers  Part 3 Simplified outline  Division 1  Section 41  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "ff7591733cc1cef16a8984fda4f12457abb23bca565e043e712593789430749e" ;
    cof:pageNumber "68"^^xsd:integer ;
    skos:note "Determine eligibility of combined areas" ;
    cml:curationStatus cml:Proposed ;
