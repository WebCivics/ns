doc:sec-91 a cof:Section ;
    cof:title "91 Exemption from definition—intelligence operations" ;
    values:kind "section" ;
    values:originalText "Subsections 87(1) and (2) do not apply to a carriage service that is used wholly or principally:  (a) by the Australian Secret Intelligence Service; or  (b) by the Australian Security Intelligence Organisation; or  (c) by the Australian Signals Directorate." ;
    cof:pageNumber "125"^^xsd:integer .

concept:telecommunications-act-1997-sec-92 a cml:Concept ;
    skos:prefLabel "92 Exemption from definition—transport authorities"@en ;
    cml:realizedBy doc:sec-92 ;
    values:originalText "(1) Subsections 87(1) and (2) do not apply to a carriage service if the sole or principal use of the carriage service is use by Airservices Australia to carry communications necessary or desirable for the workings of aviation services.  (3) Subsections 87(1) and (2) do not apply to a carriage service if the sole or principal use of the unit is use by a State or Territory transport authority to carry communications necessary or desirable for the workings of the following services:  (a) train services of a kind provided by the authority;  (b) bus or other road services of a kind provided by the authority;  (c) tram services of a kind provided by the authority." ;
    skos:definition "(1) Subsections 87(1) and (2) do not apply to a carriage service if the sole or principal use of the carriage service is use by Airservices Australia to carry communications necessary or desirable for the workings of aviation services.  (3) Subsections 87(1) and (2) do not apply to a carriage service if the sole or principal use of the unit is use by a State or Territory transport authority to carry communications necessary or desirable for the workings of the following services:  (a) train services of a kind provided by the authority;  (b) bus or other road services of a kind provided by the authority;  (c) tram services of a kind provided by the authority."@en ;
    cml:integrityHash "2bbcb11cdba5272652f366af08d4b1aea9dcd6dca8eecb92babceacfc20607cc" ;
    cof:pageNumber "125"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-92-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-92-ss-3 ;
