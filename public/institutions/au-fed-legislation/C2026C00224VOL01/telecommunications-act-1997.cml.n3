    cml:logicSummary "Exclude from this Act's application" ;
    cml:premiseText "(1) does not affect" ;
    cml:conclusionText "other persons" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-81a-ss-2 a cof:Section ;
    cof:title "81A(2) Obligations of nominated carrier" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not affect the application of this Act in relation to any other person who owns or operates the network units." ;
    cof:pageNumber "115"^^xsd:integer .

concept:telecommunications-act-1997-sec-82 a cml:Concept ;
    skos:prefLabel "82 Notification of refusal of application"@en ;
    cml:realizedBy doc:sec-82 ;
    values:originalText "If the ACMA refuses to make a nominated carrier declaration, the ACMA must give written notice of the refusal to:  (a) the applicant; and  (b) the owner, or each of the owners, of the network units." ;
    skos:definition "If the ACMA refuses to make a nominated carrier declaration, the ACMA must give written notice of the refusal to:  (a) the applicant; and  (b) the owner, or each of the owners, of the network units."@en ;
    cml:integrityHash "d7308028c21b6b8ea84cb1d4f5490272c57c7c895e3e9850f8a9c8b407ad5888" ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "ACMA must give written notice of refusal to applicant and owners of network units." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
