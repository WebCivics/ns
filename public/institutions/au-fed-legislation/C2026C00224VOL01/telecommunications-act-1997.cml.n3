concept:telecommunications-act-1997-sec-91 a cml:Concept ;
    skos:prefLabel "91 Exemption from definition—intelligence operations"@en ;
    cml:realizedBy doc:sec-91 ;
    values:originalText "Subsections 87(1) and (2) do not apply to a carriage service that is used wholly or principally:  (a) by the Australian Secret Intelligence Service; or  (b) by the Australian Security Intelligence Organisation; or  (c) by the Australian Signals Directorate." ;
    skos:definition "Subsections 87(1) and (2) do not apply to a carriage service that is used wholly or principally:  (a) by the Australian Secret Intelligence Service; or  (b) by the Australian Security Intelligence Organisation; or  (c) by the Australian Signals Directorate."@en ;
    cml:integrityHash "7564ee7537c103b12d258a3da5bf90fbae281a57653620a0088340f9918ff842" ;
    cof:pageNumber "125"^^xsd:integer ;
    skos:note "Exempts certain intelligence services from definition." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.125" ;
