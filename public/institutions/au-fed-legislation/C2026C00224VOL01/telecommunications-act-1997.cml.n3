doc:sec-97-ss-1 a cof:Section ;
    cof:title "97(1) Content service providers" ;
    values:kind "subsection" ;
    values:originalText "(1) For the purposes of this Act, if a person uses, or proposes to use, a listed carriage service to supply a content service to the public, the person is a content service provider." ;
    cof:pageNumber "129"^^xsd:integer .

concept:telecommunications-act-1997-sec-97-ss-2 a cml:Concept ;
    skos:prefLabel "97(2) Content service providers"@en ;
    cml:realizedBy doc:sec-97-ss-2 ;
    values:originalText "(2) For the purposes of subsection (1), a content service is supplied to the public if, and only if, at least one end-user of the content service is outside the immediate circle of the supplier of the content service." ;
    skos:definition "(2) For the purposes of subsection (1), a content service is supplied to the public if, and only if, at least one end-user of the content service is outside the immediate circle of the supplier of the content service."@en ;
    cml:integrityHash "68fde16ff087e3e2378f3ee4b6b14db21a306cb84cdda81e3e12802295573906" ;
    values:partOf concept:telecommunications-act-1997-sec-97 ;
    cof:pageNumber "129"^^xsd:integer ;
    skos:note "Content service providers must supply content to end-users outside their immediate circle." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.129" ;
    cml:asserts concept:telecommunications-act-1997-sec-97-ss-2-norm .
