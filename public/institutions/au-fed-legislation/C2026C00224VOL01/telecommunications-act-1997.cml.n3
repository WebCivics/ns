concept:telecommunications-act-1997-sec-120 a cml:Concept ;
    skos:prefLabel "120 Replacement of industry codes"@en ;
    cml:realizedBy doc:sec-120 ;
    values:originalText "Changes to an industry code may be achieved by replacing the code instead of varying the code. However, this does not prevent the ACMA from removing under section 122A an industry code, or a provision of an industry code, from the Register of industry codes kept under this Part." ;
    skos:definition "Changes to an industry code may be achieved by replacing the code instead of varying the code. However, this does not prevent the ACMA from removing under section 122A an industry code, or a provision of an industry code, from the Register of industry codes kept under this Part."@en ;
    cml:integrityHash "f4cb86e4774183969b461075427b50b4f32fcd6678c693bc14de53bfe345fa27" ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Changes to an industry code may be achieved by replacing the code instead of varying it." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.170" ;
    cml:asserts concept:telecommunications-act-1997-sec-120-norm .
