    cml:modality cml:Argumentation ;
    cml:operator "IMPLIES" ;
    cml:logicSummary "Consequence of consultation" ;
    cml:premiseText "ACMA's decision is influenced by consultation with States and Territories" ;
    cml:conclusionText "Industry standard determination or variation without consultation may lead to unintended consequences" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-135a cml:asserts concept:telecommunications-act-1997-sec-135a-logic-diffusion-4 .
