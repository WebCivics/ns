concept:telecommunications-act-1997-sec-288 a cml:Concept ;
    skos:prefLabel "288 Communications for maritime purposes"@en ;
    cml:realizedBy doc:sec-288 ;
    values:originalText "Division 2 does not prohibit a disclosure or use of information or a document if:  (a) the disclosure or use is reasonably necessary for the purpose of the preservation of human life at sea; or  (b) the disclosure or use:  (i) relates to the location of a vessel at sea; and  (ii) is made for maritime communications purposes." ;
    skos:definition "Division 2 does not prohibit a disclosure or use of information or a document if:  (a) the disclosure or use is reasonably necessary for the purpose of the preservation of human life at sea; or  (b) the disclosure or use:  (i) relates to the location of a vessel at sea; and  (ii) is made for maritime communications purposes."@en ;
    cml:integrityHash "9dfd7537cc313b9c5c69e4e73966999121cc1193654874a70275ba9c4c4c43db" ;
    cof:pageNumber "313"^^xsd:integer ;
    skos:note "Disclosure or use of information is permitted if reasonably necessary for preservation of human life at sea or maritime communications purposes." ;
    cml:curationStatus cml:Proposed ;
