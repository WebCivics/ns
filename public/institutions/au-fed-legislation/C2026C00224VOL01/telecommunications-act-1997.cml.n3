    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Duty to consult" ;
    cml:premiseText "ACMA must consult States and Territories" ;
    cml:conclusionText "Industry standard determination or variation is prohibited without consultation" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-135a cml:asserts concept:telecommunications-act-1997-sec-135a-logic-alleninterval-2 .
