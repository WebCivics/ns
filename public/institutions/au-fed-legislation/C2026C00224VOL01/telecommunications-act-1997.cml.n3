concept:telecommunications-act-1997-sec-63-ss-7 a cml:Concept ;
    skos:prefLabel "63(7) Conditions of carrier licence declared by Minister"@en ;
    cml:realizedBy doc:sec-63-ss-7 ;
    values:originalText "(7) As soon as practicable after the Minister makes an instrument under subsection (1), (2), (5) or (6) that relates to a licence, the Minister must give the holder of the licence a copy of the instrument." ;
