doc:sec-111ab a cof:Section ;
    cof:title "111AB Participants in a section of the fax marketing industry" ;
    values:kind "section" ;
    values:originalText "For the purposes of this Part, if a person is a member of a group that constitutes a section of the fax marketing industry, the person is a participant in that section of the fax marketing industry." ;
    cof:pageNumber "150"^^xsd:integer .

concept:telecommunications-act-1997-sec-111b a cml:Concept ;
    skos:prefLabel "111B Unsolicited commercial electronic messages"@en ;
    cml:realizedBy doc:sec-111b ;
    values:originalText "(1) For the purposes of this Part, an unsolicited commercial electronic message is a commercial electronic message that is sent:  (a) without the consent of the relevant electronic account-holder; or  (b) to a non-existent electronic address.  (2) An expression used in this section and in the Spam Act 2003 has the same meaning in this section as it has in that Act.   Industry codes and industry standards  Part 6 General principles relating to industry codes and industry standards  Division 3  Section 112  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
