concept:telecommunications-act-1997-sec-15 a cml:Concept ;
    skos:prefLabel "15 Content service"@en ;
    cml:realizedBy doc:sec-15 ;
    values:originalText "(1) For the purposes of this Act, a content service is:  (a) a broadcasting service; or  (b) an on-line information service (for example, a dial-up information service); or" ;
    skos:definition "(1) For the purposes of this Act, a content service is:  (a) a broadcasting service; or  (b) an on-line information service (for example, a dial-up information service); or"@en ;
