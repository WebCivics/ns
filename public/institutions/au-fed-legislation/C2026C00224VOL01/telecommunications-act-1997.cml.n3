concept:telecommunications-act-1997-sec-110c-ss-6 a cml:Concept ;
    skos:prefLabel "110C(6) Sections of the fax marketing industry"@en ;
    cml:realizedBy doc:sec-110c-ss-6 ;
    values:originalText "(6) Sections of the fax marketing industry determined under subsection (3):  (a) need not be mutually exclusive; and  (b) may consist of the aggregate of any 2 or more sections of the fax marketing industry mentioned in subsection (2) or determined under subsection (3); and  (c) may be subsets of a section of the fax marketing industry mentioned in subsection (2) or determined under subsection (3)." ;
    skos:definition "(6) Sections of the fax marketing industry determined under subsection (3):  (a) need not be mutually exclusive; and  (b) may consist of the aggregate of any 2 or more sections of the fax marketing industry mentioned in subsection (2) or determined under subsection (3); and  (c) may be subsets of a section of the fax marketing industry mentioned in subsection (2) or determined under subsection (3)."@en ;
    cml:integrityHash "728156f1e9123d028819da9fe9457c160a91545187c07f81328402ad9d1f713b" ;
    values:partOf concept:telecommunications-act-1997-sec-110c ;
    cof:pageNumber "148"^^xsd:integer ;
    skos:note "Definitions of fax marketing industry sections are not mutually exclusive." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
