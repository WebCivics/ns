concept:telecommunications-act-1997-sec-295ze a cml:Concept ;
    skos:prefLabel "295ZE Commonwealth immunity"@en ;
    cml:realizedBy doc:sec-295ze ;
    values:originalText "No action, suit or proceeding lies against the Commonwealth in relation to loss, damage or injury to any person or property as a result of the use or disclosure of relevant information:  (a) for a purpose connected with persons being alerted to an emergency or a likely emergency; or  (b) for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency.   Protection of communications  Part 13 Secondary disclosure/use offences  Division 4  Section 296  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "No action, suit or proceeding lies against the Commonwealth in relation to loss, damage or injury to any person or property as a result of the use or disclosure of relevant information:  (a) for a purpose connected with persons being alerted to an emergency or a likely emergency; or  (b) for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency.   Protection of communications  Part 13 Secondary disclosure/use offences  Division 4  Section 296  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "e5be9506f2f48429d60d67e6b04abd762d828169c718652056858dab02e1c686" ;
    cof:pageNumber "330"^^xsd:integer ;
    skos:note "No action lies against the Commonwealth in relation to loss, damage or injury resulting from use or disclosure of relevant information for emergency purposes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.330" ;
