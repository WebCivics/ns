concept:telecommunications-act-1997-sec-153 a cml:Concept ;
    skos:prefLabel "153 Control"@en ;
    cml:realizedBy doc:sec-153 ;
    values:originalText "In this Part, control includes control as a result of, or by means of, trusts, agreements, arrangements, understandings and practices, whether or not having legal or equitable force and whether or not based on legal or equitable rights.   Local access lines  Part 8 Other provisions  Division 3  Section 154  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "In this Part, control includes control as a result of, or by means of, trusts, agreements, arrangements, understandings and practices, whether or not having legal or equitable force and whether or not based on legal or equitable rights.   Local access lines  Part 8 Other provisions  Division 3  Section 154  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "1bf4fd14f9177e3da20a9ac64a0bddc9f94a16a2a14343ce18a66f65b2b1049b" ;
    cof:pageNumber "278"^^xsd:integer ;
    skos:note "Control includes control as a result of, or by means of, trusts, agreements, arrangements, understandings and practices." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
