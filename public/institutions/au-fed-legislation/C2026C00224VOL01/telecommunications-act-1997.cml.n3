    cml:modality cml:Diffusion ;
    cml:operator "SPREADS_TO" ;
    cml:logicSummary "Propagation of consultation requirements" ;
    cml:premiseText "Consultation with States and Territories is necessary for industry standard determination or variation in a particular sector" ;
    cml:conclusionText "Industry standard determination or variation without consultation may spread to other sectors" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

