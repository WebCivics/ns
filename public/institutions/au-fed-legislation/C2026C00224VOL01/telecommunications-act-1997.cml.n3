    cml:modality cml:Diffusion ;
    cml:operator "to" ;
    cml:logicSummary "Transmission of information" ;
    cml:premiseText "(ii) the first person believes on reasonable grounds that the disclosure or use is reasonably necessary to prevent or lessen a serious threat to the life or health of a person." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-300-ss-2 a cof:Section ;
    cof:title "300(2) Threat to person’s life or health" ;
    values:kind "subsection" ;
    values:originalText "(2) The first person must not disclose or use the information or document unless:  (a) it is unreasonable or impracticable to obtain the other person’s consent to the disclosure or use; and  (b) either of the following apply:  (i) the disclosure or use is for the purpose of, or in connection with, preventing or lessening a serious threat to the life or health of a person;  (ii) the first person believes on reasonable grounds that the disclosure or use is reasonably necessary to prevent or lessen a serious threat to the life or health of a person." ;
    cof:pageNumber "333"^^xsd:integer .

concept:telecommunications-act-1997-sec-301 a cml:Concept ;
    skos:prefLabel "301 Communications for maritime purposes"@en ;
    cml:realizedBy doc:sec-301 ;
    values:originalText "If information or a document is disclosed to a person as permitted by section 288 or this section, the person must not disclose or use the information or document unless:  (a) the disclosure or use is reasonably necessary for the purpose of the preservation of human life at sea; or  (b) the disclosure or use:  (i) relates to the location of a vessel at sea; and  (ii) is made for maritime communications purposes. Note: Section 288 deals with the disclosure or use of information or documents where the disclosure or use is made for certain maritime purposes." ;
    skos:definition "If information or a document is disclosed to a person as permitted by section 288 or this section, the person must not disclose or use the information or document unless:  (a) the disclosure or use is reasonably necessary for the purpose of the preservation of human life at sea; or  (b) the disclosure or use:  (i) relates to the location of a vessel at sea; and  (ii) is made for maritime communications purposes. Note: Section 288 deals with the disclosure or use of information or documents where the disclosure or use is made for certain maritime purposes."@en ;
    cml:integrityHash "081d827ba9519b80d59349c1616c0eb4ceed1447611d134a391ae7f66a75e8ce" ;
    cof:pageNumber "334"^^xsd:integer ;
    skos:note "Disclosure of information or document is permitted for certain maritime purposes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.334" ;
