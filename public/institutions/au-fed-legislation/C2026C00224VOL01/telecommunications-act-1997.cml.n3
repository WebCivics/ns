doc:sec-114-ss-1 a cof:Section ;
    cof:title "114(1) Industry codes and industry standards may confer powers on" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Telecommunications Industry Ombudsman consents, an industry code or industry standard may confer functions and powers on the Telecommunications Industry Ombudsman." ;
    cof:pageNumber "156"^^xsd:integer .

concept:telecommunications-act-1997-sec-114-ss-2 a cml:Concept ;
    skos:prefLabel "114(2) Industry codes and industry standards may confer powers on"@en ;
    cml:realizedBy doc:sec-114-ss-2 ;
    values:originalText "(2) The continuity of a consent under subsection (1) is not affected by:  (a) a change in the occupancy of the position of Telecommunications Industry Ombudsman; or  (b) a vacancy in the position of Telecommunications Industry Ombudsman that does not continue for more than 4 months." ;
    skos:definition "(2) The continuity of a consent under subsection (1) is not affected by:  (a) a change in the occupancy of the position of Telecommunications Industry Ombudsman; or  (b) a vacancy in the position of Telecommunications Industry Ombudsman that does not continue for more than 4 months."@en ;
    cml:integrityHash "5a9cacfcfbd84d164dc3b26e4040a8d9968caf87c1ee830698db6364871dd90d" ;
    values:partOf concept:telecommunications-act-1997-sec-114 ;
    cof:pageNumber "156"^^xsd:integer ;
    skos:note "Continuity of consent not affected by changes in Telecommunications Industry Ombudsman position." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.156" ;
