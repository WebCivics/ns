concept:telecommunications-act-1997-sec-37-ss-6 a cml:Concept ;
    skos:prefLabel "37(6) Properties"@en ;
    cml:realizedBy doc:sec-37-ss-6 ;
    values:originalText "(6) In this section: land includes premises and a part of premises, but does not include unalienated Crown land. lease includes sublease and leasehold title has a corresponding meaning." ;
    skos:definition "(6) In this section: land includes premises and a part of premises, but does not include unalienated Crown land. lease includes sublease and leasehold title has a corresponding meaning."@en ;
