concept:telecommunications-act-1997-sec-74 a cml:Concept ;
    skos:prefLabel "74 Collection of charges on behalf of the Commonwealth"@en ;
    cml:realizedBy doc:sec-74 ;
    values:originalText "The ACMA may enter into an arrangement with a person under which the person may, on behalf of the Commonwealth, collect   Carriers  Part 3 Carrier licences  Division 3  Section 75  Telecommunications Act 1997  Compilation date: 04/06/2026  payments of charge imposed by the Telecommunications (Carrier Licence Charges) Act 1997." ;
    skos:definition "The ACMA may enter into an arrangement with a person under which the person may, on behalf of the Commonwealth, collect   Carriers  Part 3 Carrier licences  Division 3  Section 75  Telecommunications Act 1997  Compilation date: 04/06/2026  payments of charge imposed by the Telecommunications (Carrier Licence Charges) Act 1997."@en ;
    cml:integrityHash "8337c82e7a8dce38e7ec4c58a7912a8aa5f152a060874cb8c53f0e5c9fc1a57a" ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "ACMA may collect payments on behalf of the Commonwealth." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.112" ;
