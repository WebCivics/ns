concept:telecommunications-act-1997-sec-310 a cml:Concept ;
    skos:prefLabel "310 Instrument-making powers not limited"@en ;
    cml:realizedBy doc:sec-310 ;
    values:originalText "(1) This Part does not, by implication, limit a power conferred by or under this Act to make an instrument.  (2) This Part does not, by implication, limit the matters that may be dealt with by codes or standards referred to in Part 6.  (3) This section does not, by implication, limit subsection 33(3B) of the Acts Interpretation Act 1901." ;
    skos:definition "(1) This Part does not, by implication, limit a power conferred by or under this Act to make an instrument.  (2) This Part does not, by implication, limit the matters that may be dealt with by codes or standards referred to in Part 6.  (3) This section does not, by implication, limit subsection 33(3B) of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "eb780b2efffbf7b8e43a0de60f8e83980186719f16d22ac68c695df37f055748" ;
    cof:pageNumber "344"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-310-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-310-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sec-310-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.344" .
