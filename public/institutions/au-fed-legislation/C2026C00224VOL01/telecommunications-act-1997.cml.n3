concept:telecommunications-act-1997-sec-138 a cml:Concept ;
    skos:prefLabel "138 Implied freedom of political communication"@en ;
    cml:realizedBy doc:sec-138 ;
    values:originalText "This Part does not apply to the extent (if any) that it would infringe any constitutional doctrine of implied freedom of political communication." ;
    skos:definition "This Part does not apply to the extent (if any) that it would infringe any constitutional doctrine of implied freedom of political communication."@en ;
    cml:integrityHash "e70248614882ae8076217bb1fad5f720c9910c38d7d579911eae00fdc7dfde4e" ;
