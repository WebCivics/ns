    skos:prefLabel "136E(2) Refundable cost"@en ;
    cml:realizedBy doc:sec-136e-ss-2 ;
    values:originalText "(2) A determination under subsection (1) is a legislative instrument." ;
    skos:definition "(2) A determination under subsection (1) is a legislative instrument."@en ;
