doc:sec-44-ss-1 a cof:Section ;
    cof:title "44(1) Supply to the public" ;
    values:kind "subsection" ;
    values:originalText "(1) This section sets out the circumstances in which a network unit is taken, for the purposes of section 42, to be used to supply a carriage service to the public." ;
