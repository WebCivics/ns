concept:telecommunications-act-1997-sec-295y a cml:Concept ;
    skos:prefLabel "295Y Coronial and other inquiries"@en ;
    cml:realizedBy doc:sec-295y ;
    values:originalText "The disclosure of relevant information to:  (a) a coronial inquiry; or  (b) another inquiry specified by the AFP Minister, by legislative instrument, for the purposes of this paragraph; in relation to an emergency or likely emergency is taken, for the purposes of this Division, to be a disclosure for a purpose" ;
    skos:definition "The disclosure of relevant information to:  (a) a coronial inquiry; or  (b) another inquiry specified by the AFP Minister, by legislative instrument, for the purposes of this paragraph; in relation to an emergency or likely emergency is taken, for the purposes of this Division, to be a disclosure for a purpose"@en ;
    cml:integrityHash "b925061a071b123e0dcf2e5139f07a5276dab71e8bb4b9e63388f691deabf807" ;
    cof:pageNumber "327"^^xsd:integer ;
    skos:note "Disclosure of relevant information in relation to an emergency or likely emergency is taken as a disclosure for a purpose." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.327" ;
    cml:asserts concept:telecommunications-act-1997-sec-295y-norm .
