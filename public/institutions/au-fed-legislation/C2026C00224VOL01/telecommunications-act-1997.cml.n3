    cml:logicSummary "Belief of reasonable grounds for necessity" ;
    cml:premiseText "the first person believes on reasonable grounds that the disclosure or use is reasonably necessary to prevent or lessen a serious threat to the life or health of a person." ;
    cml:executionSurface "modalities::epistemic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

