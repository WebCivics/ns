concept:telecommunications-act-1997-sec-111 a cml:Concept ;
    skos:prefLabel "111 Participants in a section of the telecommunications industry"@en ;
    cml:realizedBy doc:sec-111 ;
    values:originalText "For the purposes of this Part, if a person is a member of a group that constitutes a section of the telecommunications industry, the person is a participant in that section of the telecommunications industry." ;
    skos:definition "For the purposes of this Part, if a person is a member of a group that constitutes a section of the telecommunications industry, the person is a participant in that section of the telecommunications industry."@en ;
