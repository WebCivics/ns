doc:sec-103-ss-3a a cof:Section ;
    cof:title "103(3A) Formal warnings—breach of service provider rules" ;
    values:kind "subsection" ;
    values:originalText "(3A) Subsection (1) does not apply to the rule set out in subsection 152BCP(2) of the Competition and Consumer Act 2010. Note: Subsection 152BCP(2) of the Competition and Consumer Act 2010 provides that a carriage service provider must comply with any access determinations that are applicable to the provider." ;
    cof:pageNumber "135"^^xsd:integer .

concept:telecommunications-act-1997-sec-104 a cml:Concept ;
    skos:prefLabel "104 Simplified outline"@en ;
    cml:realizedBy doc:sec-104 ;
    values:originalText "The following is a simplified outline of this Part: • The ACMA is to monitor and report each financial year on matters relating to the performance of carriers and carriage service providers. • The ACMA may be directed by the Minister to monitor, and report on, specified matters relating to the performance of carriers and carriage service providers. • The ACCC is to monitor, and report each financial year to the Minister on, breaches by a designated Telstra successor company of an undertaking about structural separation." ;
    skos:definition "The following is a simplified outline of this Part: • The ACMA is to monitor and report each financial year on matters relating to the performance of carriers and carriage service providers. • The ACMA may be directed by the Minister to monitor, and report on, specified matters relating to the performance of carriers and carriage service providers. • The ACCC is to monitor, and report each financial year to the Minister on, breaches by a designated Telstra successor company of an undertaking about structural separation."@en ;
    cml:integrityHash "758386bc78e39bb2bcfd0857df33bc060d5a29eb6dc50c839942b449d350c8f0" ;
    cof:pageNumber "138"^^xsd:integer ;
    skos:note "Monitor and report on matters relating to carrier performance." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.138" ;
    cml:asserts concept:telecommunications-act-1997-sec-104-norm .
