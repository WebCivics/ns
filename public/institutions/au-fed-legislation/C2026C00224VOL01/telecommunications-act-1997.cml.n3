concept:telecommunications-act-1997-sec-142bc a cml:Concept ;
    skos:prefLabel "142BC Unsatisfactory compliance record"@en ;
    cml:realizedBy doc:sec-142bc ;
    values:originalText "For the purposes of this Part, the question of whether a person has an unsatisfactory compliance record in relation to functional separation is to be determined having regard only to:  (a) any breaches by the person of functional separation undertakings given by the person, so long as the breaches occurred when the undertakings were in force; and  (b) any contraventions by the person of section 143B, 151ZA, 151ZB, 151ZF, 151ZG, 151ZH or 151ZI." ;
    skos:definition "For the purposes of this Part, the question of whether a person has an unsatisfactory compliance record in relation to functional separation is to be determined having regard only to:  (a) any breaches by the person of functional separation undertakings given by the person, so long as the breaches occurred when the undertakings were in force; and  (b) any contraventions by the person of section 143B, 151ZA, 151ZB, 151ZF, 151ZG, 151ZH or 151ZI."@en ;
    cml:integrityHash "d0d333266f57569260547f42ac8ff1983ea9a90428aca3ac4bd8f606ea7c6598" ;
    cof:pageNumber "199"^^xsd:integer ;
    skos:note "Determine unsatisfactory compliance record based on breaches of functional separation undertakings and contraventions of specified sections." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.199" ;
