concept:telecommunications-act-1997-sec-56 a cml:Concept ;
    skos:prefLabel "56 Grant of licence"@en ;
    cml:realizedBy doc:sec-56 ;
    values:originalText "(1) After considering an application, the ACMA may grant a carrier licence in accordance with the application.  (2) If the ACMA grants a carrier licence to a person, the ACMA must give the person a written notice stating that the licence has been granted.  (3) If the ACMA grants a carrier licence, the ACMA must cause to be published in the Gazette a notice stating that the licence has been granted." ;
    skos:definition "(1) After considering an application, the ACMA may grant a carrier licence in accordance with the application.  (2) If the ACMA grants a carrier licence to a person, the ACMA must give the person a written notice stating that the licence has been granted.  (3) If the ACMA grants a carrier licence, the ACMA must cause to be published in the Gazette a notice stating that the licence has been granted."@en ;
    cml:integrityHash "80be2dc205a49915ec35519518471253aee0da5f8f98971e8b844c46c39777fd" ;
    cof:pageNumber "83"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-56-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-56-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sec-56-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.83" .
doc:sec-56 a cof:Section ;
    cof:title "56 Grant of licence" ;
    values:kind "section" ;
    values:originalText "(1) After considering an application, the ACMA may grant a carrier licence in accordance with the application.  (2) If the ACMA grants a carrier licence to a person, the ACMA must give the person a written notice stating that the licence has been granted.  (3) If the ACMA grants a carrier licence, the ACMA must cause to be published in the Gazette a notice stating that the licence has been granted." ;
    cof:pageNumber "83"^^xsd:integer .

