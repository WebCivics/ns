    cml:modality cml:CogAI ;
    cml:operator "IS_A" ;
    cml:logicSummary "Artificial intelligence application of consultation requirements" ;
    cml:premiseText "ACMA's AI system must consult States and Territories before determining or varying an industry standard" ;
    cml:conclusionText "AI system's decision is influenced by consultation with States and Territories" ;
