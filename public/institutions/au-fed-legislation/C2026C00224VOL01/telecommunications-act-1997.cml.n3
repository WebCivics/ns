concept:telecommunications-act-1997-sec-135a a cml:Concept ;
    skos:prefLabel "135A Consultation with the States and Territories"@en ;
    cml:realizedBy doc:sec-135a ;
    values:originalText "Before determining or varying an industry standard under section 125A or 125B, the ACMA must consult:  (a) each State; and  (b) the Australian Capital Territory; and  (c) the Northern Territory." ;
    skos:definition "Before determining or varying an industry standard under section 125A or 125B, the ACMA must consult:  (a) each State; and  (b) the Australian Capital Territory; and  (c) the Northern Territory."@en ;
    cml:integrityHash "c6961f2253456c6503540267188d5d57b2abb145b01724c4c0134fdf05c82dae" ;
    cof:pageNumber "183"^^xsd:integer ;
    skos:note "Consultation with States and Territories before determining or varying an industry standard" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.183" ;
