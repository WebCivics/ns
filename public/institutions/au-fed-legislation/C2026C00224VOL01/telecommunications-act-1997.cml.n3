concept:telecommunications-act-1997-sec-309-ss-3 a cml:Concept ;
    skos:prefLabel "309(3) Monitoring by the Information Commissioner"@en ;
    cml:realizedBy doc:sec-309-ss-3 ;
    values:originalText "(3) A carrier, carriage service provider or number-database operator must give the Information Commissioner such access to the records of the carrier, provider or operator as the Information   Protection of communications  Part 13 Record-keeping requirements  Division 5  Section 309  Telecommunications Act 1997  Compilation date: 04/06/2026  Commissioner reasonably requires for the purposes of the performance of the function conferred by subsection (1)." ;
    skos:definition "(3) A carrier, carriage service provider or number-database operator must give the Information Commissioner such access to the records of the carrier, provider or operator as the Information   Protection of communications  Part 13 Record-keeping requirements  Division 5  Section 309  Telecommunications Act 1997  Compilation date: 04/06/2026  Commissioner reasonably requires for the purposes of the performance of the function conferred by subsection (1)."@en ;
    cml:integrityHash "ec29a3c9f2abe228c93fc7c7b9b45e177eb1899591909300a71de00fd336e35d" ;
    values:partOf concept:telecommunications-act-1997-sec-309 ;
    cof:pageNumber "342"^^xsd:integer ;
    skos:note "Carrier must provide access to records upon request of Information Commissioner." ;
    dc:description "true" ;
