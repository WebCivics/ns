concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-deontic-1 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of disclosing or using information without permission." ;
    cml:premiseText "(a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and (b) the person uses or discloses the information;" ;
    cml:conclusionText "The use or disclosure referred to in paragraph (b) of this subsection is not for a purpose connected with persons being alerted to the emergency or likely emergency concerned." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-alleninterval-2 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Temporal interval of when the person uses or discloses the information." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The temporal interval is from the time the person receives the information to the time they use or disclose it." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-ltl-3 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring Trace" ;
    cml:logicSummary "Recurring trace of when the person uses or discloses the information." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The recurring trace is from the time the person receives the information to the present." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-diffusion-4 .
