concept:telecommunications-act-1997-sec-109 a cml:Concept ;
    skos:prefLabel "109 Telecommunications activity"@en ;
    cml:realizedBy doc:sec-109 ;
    values:originalText "For the purposes of this Part, a telecommunications activity is an activity that consists of:  (a) carrying on business as a carrier; or  (b) carrying on business as a carriage service provider; or  (c) supplying goods or services for use in connection with the supply of a listed carriage service; or  (d) supplying a content service using a listed carriage service; or  (e) manufacturing or importing customer equipment or customer cabling; or  (f) installing, maintaining, operating or providing access to:  (i) a telecommunications network; or  (ii) a facility;  used to supply a listed carriage service; or  (g) carrying on business as an electronic messaging service provider." ;
    skos:definition "For the purposes of this Part, a telecommunications activity is an activity that consists of:  (a) carrying on business as a carrier; or  (b) carrying on business as a carriage service provider; or  (c) supplying goods or services for use in connection with the supply of a listed carriage service; or  (d) supplying a content service using a listed carriage service; or  (e) manufacturing or importing customer equipment or customer cabling; or  (f) installing, maintaining, operating or providing access to:  (i) a telecommunications network; or  (ii) a facility;  used to supply a listed carriage service; or  (g) carrying on business as an electronic messaging service provider."@en ;
    cml:integrityHash "a1f4cd51e1c374868b133447e3e57a1ab67972f2f2bf1f7a36b6bb762372f12c" ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Defines telecommunications activity for regulatory purposes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.142" ;
    cml:asserts concept:telecommunications-act-1997-sec-109-norm .
