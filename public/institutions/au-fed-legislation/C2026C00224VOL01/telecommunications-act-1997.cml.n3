    cml:modality cml:Deontic ;
    cml:operator ">" ;
    cml:logicSummary "Disclosure is allowed for emergency purposes." ;
    cml:premiseText "the information or document consists of information contained in an integrated public number database;" ;
    cml:conclusionText "the disclosure is permitted." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-285a a cof:Section ;
    cof:title "285A Data for emergency warnings" ;
    values:kind "section" ;
    values:originalText "(1) Sections 276 and 277 do not prohibit a disclosure by a person (the discloser) of information or a document if:  (a) the information is, or the document consists of, information (including unlisted telephone numbers) contained in an integrated public number database; and  (b) the disclosure is made to an emergency management person; and  (c) the emergency management person has given the discloser a written notice stating that the disclosure is for the purpose of the information, or the contents of the document, being later used or disclosed for either or both of the following:  (i) for a purpose connected with persons being alerted to an emergency or a likely emergency;" ;
    cof:pageNumber "311"^^xsd:integer .

concept:telecommunications-act-1997-sec-286 a cml:Concept ;
    skos:prefLabel "286 Calls to emergency service number"@en ;
    cml:realizedBy doc:sec-286 ;
    values:originalText "Division 2 does not prohibit a disclosure by a person of information or a document if:  (a) the information or document came to the person’s knowledge, or into the person’s possession, because of a call to an emergency service number; and  (b) the information, or the contents of the document, consists of any or all of the following:  (i) a name;  (ii) a telephone number;  (iii) an address;  (iv) a location;  (v) the matter or matters raised by the call; and  (c) the disclosure is made to:  (i) an emergency service; or  (ii) a service for despatching an emergency service; or   Protection of communications  Part 13 Exceptions to primary disclosure/use offences  Division 3  Section 287  Telecommunications Act 1997  Compilation date: 04/06/2026  (iv) an emergency call person; or  for purposes connected with dealing with the matter or matters raised by the call." ;
    skos:definition "Division 2 does not prohibit a disclosure by a person of information or a document if:  (a) the information or document came to the person’s knowledge, or into the person’s possession, because of a call to an emergency service number; and  (b) the information, or the contents of the document, consists of any or all of the following:  (i) a name;  (ii) a telephone number;  (iii) an address;  (iv) a location;  (v) the matter or matters raised by the call; and  (c) the disclosure is made to:  (i) an emergency service; or  (ii) a service for despatching an emergency service; or   Protection of communications  Part 13 Exceptions to primary disclosure/use offences  Division 3  Section 287  Telecommunications Act 1997  Compilation date: 04/06/2026  (iv) an emergency call person; or  for purposes connected with dealing with the matter or matters raised by the call."@en ;
    cml:integrityHash "eec3b0fe9b05c27446d8f73f078ee4732d9da950ebb707f5e141d3dd3c7b3367" ;
    cof:pageNumber "312"^^xsd:integer ;
    skos:note "Disclosure of certain information is permitted under specific conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.312" ;
    cml:asserts concept:telecommunications-act-1997-sec-286-norm .
