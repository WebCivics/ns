concept:telecommunications-act-1997-sec-295x a cml:Concept ;
    skos:prefLabel "295X Effect on telecommunications network"@en ;
    cml:realizedBy doc:sec-295x ;
    values:originalText "In using or disclosing information that is permitted by section 295V or 295W, a person must take reasonable steps to ensure that the use or disclosure does not adversely affect the operation of a telecommunications network." ;
    skos:definition "In using or disclosing information that is permitted by section 295V or 295W, a person must take reasonable steps to ensure that the use or disclosure does not adversely affect the operation of a telecommunications network."@en ;
    cml:integrityHash "ed1178f0d6ab9574d1c7f4e4ee92fd76cb11283e71a41042522b3c01915c3a9f" ;
    cof:pageNumber "327"^^xsd:integer ;
    skos:note "Must take reasonable steps to ensure no adverse effect on telecommunications network." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.327" ;
