concept:telecommunications-act-1997-sec-89 a cml:Concept ;
    skos:prefLabel "89 Exemption from definition—customers located on the same"@en ;
    cml:realizedBy doc:sec-89 ;
    values:originalText "premises  (1) If:  (a) the supplier of a carriage service manages a business or other activity carried on at particular premises; and  (b) that business or activity is the sole or principal use of the premises; and  (c) all of the customers of the service are physically present on the premises; subsections 87(1) and (2) do not apply to the carriage service.  (2) In this section: premises includes:  (a) land; and  (b) a group of buildings that is located in the same vicinity." ;
    skos:definition "premises  (1) If:  (a) the supplier of a carriage service manages a business or other activity carried on at particular premises; and  (b) that business or activity is the sole or principal use of the premises; and  (c) all of the customers of the service are physically present on the premises; subsections 87(1) and (2) do not apply to the carriage service.  (2) In this section: premises includes:  (a) land; and  (b) a group of buildings that is located in the same vicinity."@en ;
    cml:integrityHash "a4b52f4884cdd3a60b527cbbf7527a6082053b6dc9b7e8012d3912cec9f9bc6e" ;
    cof:pageNumber "124"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-89-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-89-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.124" .
doc:sec-89 a cof:Section ;
    cof:title "89 Exemption from definition—customers located on the same" ;
    values:kind "section" ;
    values:originalText "premises  (1) If:  (a) the supplier of a carriage service manages a business or other activity carried on at particular premises; and  (b) that business or activity is the sole or principal use of the premises; and  (c) all of the customers of the service are physically present on the premises; subsections 87(1) and (2) do not apply to the carriage service.  (2) In this section: premises includes:  (a) land; and  (b) a group of buildings that is located in the same vicinity." ;
    cof:pageNumber "124"^^xsd:integer .

