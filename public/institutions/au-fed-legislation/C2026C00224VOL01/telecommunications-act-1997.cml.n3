    skos:prefLabel "4 Regulatory policy"@en ;
    cml:realizedBy doc:sec-4-2 ;
    values:originalText "The Parliament intends that telecommunications be regulated in a manner that:  (a) promotes the greatest practicable use of industry self-regulation; and  (b) does not impose undue financial and administrative burdens on participants in the Australian telecommunications industry; but does not compromise the effectiveness of regulation in achieving the objects mentioned in section 3." ;
    skos:definition "The Parliament intends that telecommunications be regulated in a manner that:  (a) promotes the greatest practicable use of industry self-regulation; and  (b) does not impose undue financial and administrative burdens on participants in the Australian telecommunications industry; but does not compromise the effectiveness of regulation in achieving the objects mentioned in section 3."@en ;
    cml:integrityHash "16fca174cae416940249d7d88fcf598bd4a9c6f5f5f0bc2dd257e011713215de" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Promotes industry self-regulation and avoids undue financial burdens." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
