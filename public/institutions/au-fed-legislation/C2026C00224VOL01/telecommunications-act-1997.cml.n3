concept:telecommunications-act-1997-sec-296 a cml:Concept ;
    skos:prefLabel "296 Performance of person’s duties"@en ;
    cml:realizedBy doc:sec-296 ;
    values:originalText "If:  (a) information or a document is disclosed to a person for a particular purpose as permitted by section 279 or this section; and  (b) the information or the contents of the document does not relate to the person’s affairs or personal particulars; the person must not disclose or use the information or document except for that purpose." ;
    skos:definition "If:  (a) information or a document is disclosed to a person for a particular purpose as permitted by section 279 or this section; and  (b) the information or the contents of the document does not relate to the person’s affairs or personal particulars; the person must not disclose or use the information or document except for that purpose."@en ;
    cml:integrityHash "84b865ba24a450d30aae9a0247c3c023a56d0daedfa8f82111e21a2216078316" ;
    cof:pageNumber "331"^^xsd:integer ;
    skos:note "Must not disclose or use information except for permitted purpose." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.331" ;
    cml:asserts concept:telecommunications-act-1997-sec-296-norm .
