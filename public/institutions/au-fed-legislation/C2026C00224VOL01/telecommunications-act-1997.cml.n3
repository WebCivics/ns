concept:telecommunications-act-1997-sec-303 a cml:Concept ;
    skos:prefLabel "303 Secondary offence—contravening this Division"@en ;
    cml:realizedBy doc:sec-303 ;
    values:originalText "A person who contravenes this Division commits an offence punishable on conviction by imprisonment for a term not exceeding 2 years. Note: See also sections 4AA and 4B of the Crimes Act 1914." ;
