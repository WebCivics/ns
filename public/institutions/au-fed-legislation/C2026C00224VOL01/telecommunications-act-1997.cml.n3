    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-300-ss-2 cml:asserts concept:telecommunications-act-1997-sec-300-ss-2-logic-epistemic-2 .
