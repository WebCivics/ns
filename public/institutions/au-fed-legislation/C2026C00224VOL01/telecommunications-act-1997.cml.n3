concept:telecommunications-act-1997-sec-67 a cml:Concept ;
    skos:prefLabel "67 Carrier licence conditions—special provisions"@en ;
    cml:realizedBy doc:sec-67 ;
    values:originalText "(1) A condition of a carrier licence held by a carrier has effect subject to the provisions of a licence under the Radiocommunications Act 1992 under which the carrier is authorised to do something." ;
    skos:definition "(1) A condition of a carrier licence held by a carrier has effect subject to the provisions of a licence under the Radiocommunications Act 1992 under which the carrier is authorised to do something."@en ;
