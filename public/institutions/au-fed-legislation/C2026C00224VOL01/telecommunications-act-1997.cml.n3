concept:telecommunications-act-1997-sec-295zd a cml:Concept ;
    skos:prefLabel "295ZD Arrangements with States and Territories"@en ;
    cml:realizedBy doc:sec-295zd ;
    values:originalText "(1) The AFP Minister may make arrangements with a Minister of a State or a Territory with respect to the performance of functions or duties, or the exercise of powers, by an emergency management person under this Division.  (2) An instrument by which an arrangement under this section is made is not a legislative instrument." ;
    skos:definition "(1) The AFP Minister may make arrangements with a Minister of a State or a Territory with respect to the performance of functions or duties, or the exercise of powers, by an emergency management person under this Division.  (2) An instrument by which an arrangement under this section is made is not a legislative instrument."@en ;
    cml:integrityHash "dbef82ee7a2f177da7c02e6766388d36ab8864ef879389b7c3f6815b061fbe69" ;
    cof:pageNumber "330"^^xsd:integer ;
