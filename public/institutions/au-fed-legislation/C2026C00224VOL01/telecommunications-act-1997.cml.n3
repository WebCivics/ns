concept:telecommunications-act-1997-sec-143f-ss-2-logic-alleninterval-1 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "<=" ;
    cml:logicSummary "Describes temporal relationship between events" ;
    cml:premiseText "The line mentioned in paragraph (b) is used to supply a superfast carriage service; The line mentioned in paragraph (b) is exempt from section 142C." ;
    cml:conclusionText "The line must have come into existence on or after the designated commencement date for the purposes of connecting particular premises to the network." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-143f-ss-2 cml:asserts concept:telecommunications-act-1997-sec-143f-ss-2-logic-deontic-2 .
concept:telecommunications-act-1997-sec-143f-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Defines conditions under which a line is exempt from section 142C" ;
    cml:premiseText "(2) If: (a) a designated telecommunications network was in existence immediately before the designated commencement date; and (b) a line came into existence on or after the designated commencement date for the purposes of connecting particular premises to the network; and (c) the coming into existence of the line enables or enabled the occupier of the premises to become a customer in relation to carriage services supplied using the line; and (d) the premises are in close proximity to a line that forms part of the infrastructure of the network as the network stood immediately before the designated commencement date; and (e) the line mentioned in paragraph (b) is used to supply a superfast carriage service;" ;
    cml:conclusionText "The line is exempt from section 142C if the conditions are met." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-143f-ss-2 cml:asserts concept:telecommunications-act-1997-sec-143f-ss-2-logic-ltl-3 .
concept:telecommunications-act-1997-sec-143f-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "=" ;
    cml:logicSummary "Describes recurring trace of events" ;
    cml:premiseText "(2) If: (a) a designated telecommunications network was in existence immediately before the designated commencement date; and (b) a line came into existence on or after the designated commencement date for the purposes of connecting particular premises to the network; and (c) the coming into existence of the line enables or enabled the occupier of the premises to become a customer in relation to carriage services supplied using the line; and (d) the premises are in close proximity to a line that forms part of the infrastructure of the network as the network stood immediately before the designated commencement date; and (e) the line mentioned in paragraph (b) is used to supply a superfast carriage service;" ;
    cml:conclusionText "The conditions must be met for the line to be exempt from section 142C." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-143f-ss-2 cml:asserts concept:telecommunications-act-1997-sec-143f-ss-2-logic-deontic-4 .
