concept:telecommunications-act-1997-sec-25 a cml:Concept ;
    skos:prefLabel "25 Simplified outline"@en ;
    cml:realizedBy doc:sec-25 ;
    values:originalText "The following is a simplified outline of this Part: • The object of this Part is to define the expression network unit. • There are 4 types of network unit:  (a) a single line link connecting distinct places in Australia, where the line link meets certain minimum distance requirements;  (b) multiple line links connecting distinct places in Australia, where the line links meet certain minimum distance requirements;  (c) a designated radiocommunications facility;  (d) a facility specified in a Ministerial determination." ;
    skos:definition "The following is a simplified outline of this Part: • The object of this Part is to define the expression network unit. • There are 4 types of network unit:  (a) a single line link connecting distinct places in Australia, where the line link meets certain minimum distance requirements;  (b) multiple line links connecting distinct places in Australia, where the line links meet certain minimum distance requirements;  (c) a designated radiocommunications facility;  (d) a facility specified in a Ministerial determination."@en ;
    cml:integrityHash "a4a6aaeed3d55fdaab701239fbfd3e6b6cb79c79d4f8076b0d9db4953a8fbc11" ;
    cof:pageNumber "55"^^xsd:integer ;
    skos:note "Defines network unit types" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.55" ;
