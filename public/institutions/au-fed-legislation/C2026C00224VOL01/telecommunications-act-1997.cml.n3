concept:telecommunications-act-1997-sec-307 a cml:Concept ;
    skos:prefLabel "307 Incorrect records"@en ;
    cml:realizedBy doc:sec-307 ;
    values:originalText "(1) A person must not, in purported compliance with section 306 or 306A, make a record of any matter or thing in such a way that it does not correctly record the matter or thing.  (2) A person who contravenes subsection (1) commits an offence punishable on conviction by imprisonment for a term not exceeding 6 months. Note: See also sections 4AA and 4B of the Crimes Act 1914." ;
    skos:definition "(1) A person must not, in purported compliance with section 306 or 306A, make a record of any matter or thing in such a way that it does not correctly record the matter or thing.  (2) A person who contravenes subsection (1) commits an offence punishable on conviction by imprisonment for a term not exceeding 6 months. Note: See also sections 4AA and 4B of the Crimes Act 1914."@en ;
    cml:integrityHash "3dc8a4a140d7c46194761a4a3ec09408d2616fa23489c38b7ec38863e7a6de82" ;
    cof:pageNumber "341"^^xsd:integer ;
