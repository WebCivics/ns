concept:telecommunications-act-1997-sec-53 a cml:Concept ;
    skos:prefLabel "53 Form of application etc."@en ;
    cml:realizedBy doc:sec-53 ;
    values:originalText "An application must be:  (a) in writing; and  (b) in accordance with the form approved in writing by the ACMA." ;
    skos:definition "An application must be:  (a) in writing; and  (b) in accordance with the form approved in writing by the ACMA."@en ;
