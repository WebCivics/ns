concept:telecommunications-act-1997-sec-145 a cml:Concept ;
    skos:prefLabel "145 Exemption—transport authorities"@en ;
    cml:realizedBy doc:sec-145 ;
    values:originalText "(1) Subsections 142C(2) and 143(2) do not apply if:  (a) both:  (i) the eligible service is a carriage service; and  (ii) the sole use of the carriage service is use by Airservices Australia to carry communications necessary or desirable for the workings of aviation services; or  (b) the eligible service is a service that facilitates the supply of a carriage service covered by paragraph (a) of this subsection.  (2) Paragraph (1)(a) does not apply to a carriage service supplied to Airservices Australia unless the carriage service is supplied on the basis that Airservices Australia must not re-supply the carriage service.  (3) Subsections 142C(2) and 143(2) do not apply if:  (a) the eligible service is a carriage service, and the sole use of the carriage service is use by a State or Territory transport authority to carry communications necessary or desirable for the workings of the following services:" ;
    skos:definition "(1) Subsections 142C(2) and 143(2) do not apply if:  (a) both:  (i) the eligible service is a carriage service; and  (ii) the sole use of the carriage service is use by Airservices Australia to carry communications necessary or desirable for the workings of aviation services; or  (b) the eligible service is a service that facilitates the supply of a carriage service covered by paragraph (a) of this subsection.  (2) Paragraph (1)(a) does not apply to a carriage service supplied to Airservices Australia unless the carriage service is supplied on the basis that Airservices Australia must not re-supply the carriage service.  (3) Subsections 142C(2) and 143(2) do not apply if:  (a) the eligible service is a carriage service, and the sole use of the carriage service is use by a State or Territory transport authority to carry communications necessary or desirable for the workings of the following services:"@en ;
    cml:integrityHash "0d2c4577d6b473036728bb31a79cc714c10eb9d6ceebfa9d4058aeba94242a65" ;
    cof:pageNumber "219"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-145-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-145-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sec-145-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.219" .
doc:sec-145 a cof:Section ;
    cof:title "145 Exemption—transport authorities" ;
    values:kind "section" ;
    values:originalText "(1) Subsections 142C(2) and 143(2) do not apply if:  (a) both:  (i) the eligible service is a carriage service; and  (ii) the sole use of the carriage service is use by Airservices Australia to carry communications necessary or desirable for the workings of aviation services; or  (b) the eligible service is a service that facilitates the supply of a carriage service covered by paragraph (a) of this subsection.  (2) Paragraph (1)(a) does not apply to a carriage service supplied to Airservices Australia unless the carriage service is supplied on the basis that Airservices Australia must not re-supply the carriage service.  (3) Subsections 142C(2) and 143(2) do not apply if:  (a) the eligible service is a carriage service, and the sole use of the carriage service is use by a State or Territory transport authority to carry communications necessary or desirable for the workings of the following services:" ;
    cof:pageNumber "219"^^xsd:integer .

