concept:telecommunications-act-1997-sec-131 a cml:Concept ;
    skos:prefLabel "131 Revocation of industry standards"@en ;
    cml:realizedBy doc:sec-131 ;
    values:originalText "(1) The ACMA may, by legislative instrument, revoke an industry standard.  (2) If:  (a) an industry code is registered under this Part; and  (b) the code is expressed to replace an industry standard; the industry standard is revoked when the code is registered." ;
    skos:definition "(1) The ACMA may, by legislative instrument, revoke an industry standard.  (2) If:  (a) an industry code is registered under this Part; and  (b) the code is expressed to replace an industry standard; the industry standard is revoked when the code is registered."@en ;
    cml:integrityHash "68b8e76879bc2c7d6ac1246351b3070b0622448b16aab0c7d550f100a24d2639" ;
    cof:pageNumber "181"^^xsd:integer ;
