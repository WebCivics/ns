    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "is_connected";
    <https://ns.webcivics.net/cml/logicSummary> "Definition of connected thing";
    <https://ns.webcivics.net/cml/premiseText> "A thing is connected with a breach of the Spam Act if it is:  (a) a thing in respect of which the breach has happened; or  (b) a thing that may afford evidence about the breach; or  (c) a thing that was used, or is intended to be used, for the purposes of the breach.";
    <https://ns.webcivics.net/cml/conclusionText> "A thing is connected with a breach of the Spam Act if it is related to the breach.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
