doc:sec-500-ss-3 a cof:Section ;
    cof:title "500(3) Written submissions and protection from civil actions" ;
    values:kind "subsection" ;
    values:originalText "(3) Civil proceedings do not lie against a person in respect of loss, damage or injury of any kind suffered by another person because of the making in good faith of a statement, or the giving in good faith of a document or information, to the ACCC in connection with a public inquiry under this Division." ;
    cof:pageNumber "428"^^xsd:integer .

concept:telecommunications-act-1997-sec-500-ss-4 a cml:Concept ;
    skos:prefLabel "500(4) Written submissions and protection from civil actions"@en ;
    cml:realizedBy doc:sec-500-ss-4 ;
    values:originalText "(4) The rule in subsection (3) applies whether or not the statement is made, or the document or information is given, in connection with a written submission or a public hearing." ;
    skos:definition "(4) The rule in subsection (3) applies whether or not the statement is made, or the document or information is given, in connection with a written submission or a public hearing."@en ;
    cml:integrityHash "710ca2b89da46fdaf2c747157f943da2f07951d90fff3ed90ef6d4f572673828" ;
    values:partOf concept:telecommunications-act-1997-sec-500 ;
    cof:pageNumber "428"^^xsd:integer ;
    skos:note "Protection from civil actions for written submissions and public hearings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
