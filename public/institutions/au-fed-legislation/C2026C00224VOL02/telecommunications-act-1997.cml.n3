doc:sec-372e-ss-5 a cof:Section ;
    cof:title "372E(5) Installation of fibre-ready facilities—building lots" ;
    values:kind "subsection" ;
    values:originalText "(5) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (2); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (2); or  (c) be in any way, directly or indirectly, knowingly concerned in, or party to, a contravention of subsection (2); or  (d) conspire with others to effect a contravention of subsection (2). Civil penalty provisions" ;
    cof:pageNumber "280"^^xsd:integer .

concept:telecommunications-act-1997-sec-372e-ss-6 a cml:Concept ;
    skos:prefLabel "372E(6) Installation of fibre-ready facilities—building lots"@en ;
    cml:realizedBy doc:sec-372e-ss-6 ;
    values:originalText "(6) Subsections (2) and (5) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions." ;
    skos:definition "(6) Subsections (2) and (5) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions."@en ;
    cml:integrityHash "be2a2e0a94d0b5327f15fc1b897083e83e14ceba648a9b182d1d2c9a48fdbaed" ;
    values:partOf concept:telecommunications-act-1997-sec-372e ;
