doc:sec-500-ss-1 a cof:Section ;
    cof:title "500(1) Written submissions and protection from civil actions" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACCC must provide a reasonable opportunity for any member of the public to make a written submission to the ACCC about the matter to which a public inquiry relates.   Public inquiries  Part 25 Inquiries by the ACCC  Division 3  Section 501  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    cof:pageNumber "428"^^xsd:integer .

concept:telecommunications-act-1997-sec-500-ss-2 a cml:Concept ;
    skos:prefLabel "500(2) Written submissions and protection from civil actions"@en ;
    cml:realizedBy doc:sec-500-ss-2 ;
    values:originalText "(2) For the purposes of subsection (1), the ACCC is taken not to have provided a reasonable opportunity to make submissions unless there was a period of at least 28 days during which the submissions could be made." ;
    skos:definition "(2) For the purposes of subsection (1), the ACCC is taken not to have provided a reasonable opportunity to make submissions unless there was a period of at least 28 days during which the submissions could be made."@en ;
    cml:integrityHash "ffd625f3488df835a1bbfe3619a99bac6e1bfa7579e955f0e936929dbdfbd3b2" ;
    values:partOf concept:telecommunications-act-1997-sec-500 ;
    cof:pageNumber "428"^^xsd:integer ;
    skos:note "ACCC must provide a reasonable opportunity to make submissions within 28 days." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
