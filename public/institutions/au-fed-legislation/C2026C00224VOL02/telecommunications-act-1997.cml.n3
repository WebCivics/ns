    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Service on or to agent in Australia is equivalent to service on or to body corporate" ;
    cml:premiseText "(c)" ;
    cml:conclusionText "service on or to body corporate" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
