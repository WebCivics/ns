concept:telecommunications-act-1997-sec-360vd-ss-6 a cml:Concept ;
    skos:prefLabel "360VD(6) Damages for breach of a designated compensable standard"@en ;
    cml:realizedBy doc:sec-360vd-ss-6 ;
    values:originalText "(6) The liability of the statutory infrastructure provider under this section may be discharged:  (a) by giving the customer a credit in an account the customer has with the statutory infrastructure provider; or  (b) in any other manner agreed between the statutory infrastructure provider and the customer." ;
    skos:definition "(6) The liability of the statutory infrastructure provider under this section may be discharged:  (a) by giving the customer a credit in an account the customer has with the statutory infrastructure provider; or  (b) in any other manner agreed between the statutory infrastructure provider and the customer."@en ;
    cml:integrityHash "b73770188da6a5664eebdf701171eb85567628c21ae4b65b3a15b76c6545e4b2" ;
    values:partOf concept:telecommunications-act-1997-sec-360vd ;
    cof:pageNumber "246"^^xsd:integer ;
    skos:note "Discharge of liability through credit or agreement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
