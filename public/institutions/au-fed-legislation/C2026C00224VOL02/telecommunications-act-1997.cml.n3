concept:telecommunications-act-1997-sec-581z-ss-7 a cml:Concept ;
    skos:prefLabel "581Z(7) Terms and conditions of access"@en ;
    cml:realizedBy doc:sec-581z-ss-7 ;
    values:originalText "(7) If:  (a) an agreement mentioned in paragraph (1)(a) is in force; and  (b) the agreement is in writing; a determination under this section has no effect to the extent to which it is inconsistent with the agreement." ;
    skos:definition "(7) If:  (a) an agreement mentioned in paragraph (1)(a) is in force; and  (b) the agreement is in writing; a determination under this section has no effect to the extent to which it is inconsistent with the agreement."@en ;
    cml:integrityHash "aa32bcdb4bf9c46e6ab702506c7678c8870f6dba46e92f817e4e829cfa276e2c" ;
    values:partOf concept:telecommunications-act-1997-sec-581z ;
    cof:pageNumber "622"^^xsd:integer ;
    skos:note "Agreement takes precedence over legislative determination" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
