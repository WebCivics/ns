doc:sec-360p-ss-6 a cof:Section ;
    cof:title "360P(6) Obligation of statutory infrastructure provider to connect" ;
    values:kind "subsection" ;
    values:originalText "(6) A requirement may be of general application or may be limited to one or more service areas." ;
    cof:pageNumber "224"^^xsd:integer .

