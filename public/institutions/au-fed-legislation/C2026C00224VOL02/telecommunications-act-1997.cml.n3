concept:telecommunications-act-1997-sec-511 a cml:Concept ;
    skos:prefLabel "511 Preliminary inquiries"@en ;
    cml:realizedBy doc:sec-511 ;
    values:originalText "If a complaint has been made to the ACMA under section 509, the ACMA may make inquiries of the respondent for the purposes of determining:  (a) whether the ACMA has power to investigate the matter to which the complaint relates; or  (b) whether the ACMA should, in its discretion, investigate the matter." ;
    skos:definition "If a complaint has been made to the ACMA under section 509, the ACMA may make inquiries of the respondent for the purposes of determining:  (a) whether the ACMA has power to investigate the matter to which the complaint relates; or  (b) whether the ACMA should, in its discretion, investigate the matter."@en ;
    cml:integrityHash "d509a6c4b62153d324f88ce8cd4f1500a8d149ca60124c9cea9652611825ce2c" ;
    cof:pageNumber "439"^^xsd:integer ;
    skos:note "Inquiries of respondent for determining ACMA's power to investigate" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.439" ;
