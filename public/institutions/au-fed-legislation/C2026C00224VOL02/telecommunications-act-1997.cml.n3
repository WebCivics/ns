    values:partOf concept:telecommunications-act-1997-sec-493 ;
    cof:pageNumber "424"^^xsd:integer ;
    skos:note "A reasonable excuse excuses non-compliance with subsections (3) and (4)" ;
    cml:curationStatus cml:Proposed ;
