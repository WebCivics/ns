concept:telecommunications-act-1997-sec-581x a cml:Concept ;
    skos:prefLabel "581X Eligible company"@en ;
    cml:realizedBy doc:sec-581x ;
    values:originalText "For the purposes of this Part, eligible company means a body corporate that:  (a) is in a carrier company group; and  (b) is not a carrier." ;
    skos:definition "For the purposes of this Part, eligible company means a body corporate that:  (a) is in a carrier company group; and  (b) is not a carrier."@en ;
