concept:telecommunications-act-1997-sec-418 a cml:Concept ;
    skos:prefLabel "418 Cabling work"@en ;
    cml:realizedBy doc:sec-418 ;
    values:originalText "A reference in this Division to cabling work is a reference to:  (a) the installation of customer cabling for connection to a telecommunications network or to a facility; or  (b) the connection of customer cabling to a telecommunications network or to a facility; or  (c) the maintenance of customer cabling connected to a telecommunications network or to a facility." ;
    skos:definition "A reference in this Division to cabling work is a reference to:  (a) the installation of customer cabling for connection to a telecommunications network or to a facility; or  (b) the connection of customer cabling to a telecommunications network or to a facility; or  (c) the maintenance of customer cabling connected to a telecommunications network or to a facility."@en ;
    cml:integrityHash "671ac7c7fdfbd6ad1d1252981a9f41e0455c82aad6d19d44adcc49025efbdef2" ;
    cof:pageNumber "349"^^xsd:integer ;
    skos:note "Definition of cabling work" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
