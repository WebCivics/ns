    cof:title "372JA(2) Remedial notices" ;
    values:kind "subsection" ;
    values:originalText "(2) The ACMA may give the person a written notice requiring the person to:  (a) remedy the contravention; or  (b) prevent the likely contravention from occurring; or  (c) remedy the things or operations causing the contravention or likely contravention." ;
    cof:pageNumber "288"^^xsd:integer .

