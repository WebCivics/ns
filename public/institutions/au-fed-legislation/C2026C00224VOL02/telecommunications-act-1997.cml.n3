    cml:modality cml:CogAI ;
    cml:operator "recognizes" ;
    cml:logicSummary "Recognition of personal information in publication" ;
    cml:premiseText "Publication contains personal information." ;
    cml:conclusionText "Publication would involve unreasonable disclosure of personal information if it recognizes the individual's identity." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-517-ss-5 a cof:Section ;
    cof:title "517(5) Publication of reports" ;
    values:kind "subsection" ;
    values:originalText "(5) The ACMA is not required to publish a report or part of a report if the publication would involve the unreasonable disclosure of personal information about any individual (including a deceased individual)." ;
    cof:pageNumber "445"^^xsd:integer .

concept:telecommunications-act-1997-sec-518 a cml:Concept ;
    skos:prefLabel "518 Person adversely affected by report to be given opportunity to"@en ;
    cml:realizedBy doc:sec-518 ;
    values:originalText "comment  (1) This section applies if the publication of a matter in a report or a part of a report would, or would be likely to, adversely affect the interests of a person.  (2) The ACMA must not publish the report or the part of the report, as the case may be, until the ACMA has given the person a reasonable period (not exceeding 30 days) to make representations, either orally or in writing, in relation to the matter.  (3) However, the ACMA is not required to give the person a reasonable period to make representations if:  (a) the matter relates to a possible breach of:  (i) the Spam Act 2003 or regulations under that Act; or  (ii) the Do Not Call Register Act 2006 or regulations under that Act; and  (b) the ACMA has reasonable grounds to believe that giving the person a reasonable period to make representations is likely to result in the concealment, loss or destruction of a thing connected with the breach." ;
    skos:definition "comment  (1) This section applies if the publication of a matter in a report or a part of a report would, or would be likely to, adversely affect the interests of a person.  (2) The ACMA must not publish the report or the part of the report, as the case may be, until the ACMA has given the person a reasonable period (not exceeding 30 days) to make representations, either orally or in writing, in relation to the matter.  (3) However, the ACMA is not required to give the person a reasonable period to make representations if:  (a) the matter relates to a possible breach of:  (i) the Spam Act 2003 or regulations under that Act; or  (ii) the Do Not Call Register Act 2006 or regulations under that Act; and  (b) the ACMA has reasonable grounds to believe that giving the person a reasonable period to make representations is likely to result in the concealment, loss or destruction of a thing connected with the breach."@en ;
    cml:integrityHash "c44bb2fd516909dab78ae0bfedcd5672b131b996c4b7a4328ee55fba170da776" ;
    cof:pageNumber "446"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-518-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-518-ss-2 ;
