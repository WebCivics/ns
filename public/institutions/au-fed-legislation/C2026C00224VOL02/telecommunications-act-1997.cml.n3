concept:telecommunications-act-1997-sec-552 a cml:Concept ;
    skos:prefLabel "552 Forfeited goods may be sold"@en ;
    cml:realizedBy doc:sec-552 ;
    values:originalText "A thing forfeited under section 551:  (a) may be sold or otherwise disposed of in accordance with the directions of the ACMA; and  (b) pending such directions, must be kept in such custody as the ACMA directs.   Enforcement  Part 28 Future offences  Division 8  Section 553  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "A thing forfeited under section 551:  (a) may be sold or otherwise disposed of in accordance with the directions of the ACMA; and  (b) pending such directions, must be kept in such custody as the ACMA directs.   Enforcement  Part 28 Future offences  Division 8  Section 553  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "acd6431c546adb9b25da00e1101ae4ba41d2dfed07144251c2cdb3f0a66d2ff1" ;
    cof:pageNumber "484"^^xsd:integer ;
    skos:note "Goods may be sold or disposed of in accordance with ACMA directions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.484" ;
