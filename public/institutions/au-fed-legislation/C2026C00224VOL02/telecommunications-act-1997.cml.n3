concept:telecommunications-act-1997-sec-372h-ss-4 a cml:Concept ;
    skos:prefLabel "372H(4) Sale of building units—other projects"@en ;
    cml:realizedBy doc:sec-372h-ss-4 ;
    values:originalText "(4) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (2), (3) or (3A); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (2), (3) or (3A); or" ;
    skos:definition "(4) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (2), (3) or (3A); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (2), (3) or (3A); or"@en ;
    cml:integrityHash "dc12b803c6cceed4d1c85a8a424be305c81fec77cdca9b8cec66b3d4d36c8f7c" ;
    values:partOf concept:telecommunications-act-1997-sec-372h ;
    cof:pageNumber "286"^^xsd:integer ;
    skos:note "A person must not aid, abet, counsel or procure a contravention of subsection (2), (3) or (3A); or induce, whether by threats or promises or otherwise, a contravention of subsection (2), (3) or (3A);" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
