concept:telecommunications-act-1997-sec-563 a cml:Concept ;
    skos:prefLabel "563 Simplified outline"@en ;
    cml:realizedBy doc:sec-563 ;
    values:originalText "The following is a simplified outline of this Part: • The Federal Court may grant injunctions in relation to contraventions of:  (a) this Act; or  (b) the Telecommunications (Consumer Protection and Service Standards) Act 1999; or  (c) regulations under that Act." ;
    skos:definition "The following is a simplified outline of this Part: • The Federal Court may grant injunctions in relation to contraventions of:  (a) this Act; or  (b) the Telecommunications (Consumer Protection and Service Standards) Act 1999; or  (c) regulations under that Act."@en ;
    cml:integrityHash "5348a05ae79816dd07839b454466b2b326eb80ecd7b91545d51d3f16fa060bea" ;
    cof:pageNumber "490"^^xsd:integer ;
