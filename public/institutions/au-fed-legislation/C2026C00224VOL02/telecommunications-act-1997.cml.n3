concept:telecommunications-act-1997-sec-594 a cml:Concept ;
    skos:prefLabel "594 Regulations"@en ;
    cml:realizedBy doc:sec-594 ;
    values:originalText "(1) The Governor-General may make regulations prescribing matters:  (a) required or permitted by this Act to be prescribed; or  (b) necessary or convenient to be prescribed for carrying out or giving effect to this Act.  (2) The regulations may prescribe penalties, not exceeding 10 penalty units, for offences against the regulations." ;
    skos:definition "(1) The Governor-General may make regulations prescribing matters:  (a) required or permitted by this Act to be prescribed; or  (b) necessary or convenient to be prescribed for carrying out or giving effect to this Act.  (2) The regulations may prescribe penalties, not exceeding 10 penalty units, for offences against the regulations."@en ;
    cml:integrityHash "4c2667f49b81ac2ff85a8973c751228b6e1b45cdfbaad3acc52a0d2c36dff412" ;
    cof:pageNumber "642"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-594-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-594-ss-2 ;
