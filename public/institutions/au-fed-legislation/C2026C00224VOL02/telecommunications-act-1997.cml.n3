concept:telecommunications-act-1997-sec-445 a cml:Concept ;
    skos:prefLabel "445 Remedies for connection of unlabelled customer equipment or"@en ;
    cml:realizedBy doc:sec-445 ;
    values:originalText "unlabelled customer cabling  (1) This section applies if:  (a) a person:  (i) connects customer equipment, or customer cabling, to a telecommunications network or to a facility; or  (ii) has under his or her control customer equipment, or customer cabling, connected to a telecommunications network or to a facility; and  (b) the manufacturer or importer of the equipment or cabling was required by subsection 407(1) to apply a label to the equipment or cabling; and  (c) either:  (i) the manufacturer or importer did not comply with the requirement; or" ;
    skos:definition "unlabelled customer cabling  (1) This section applies if:  (a) a person:  (i) connects customer equipment, or customer cabling, to a telecommunications network or to a facility; or  (ii) has under his or her control customer equipment, or customer cabling, connected to a telecommunications network or to a facility; and  (b) the manufacturer or importer of the equipment or cabling was required by subsection 407(1) to apply a label to the equipment or cabling; and  (c) either:  (i) the manufacturer or importer did not comply with the requirement; or"@en ;
    cml:integrityHash "f945cd1e00e096b9910c3e8ab6db124371fba4e8453097faceea5ef0003d74d3" ;
    cof:pageNumber "363"^^xsd:integer ;
    skos:note "Prohibition on unlabelled customer equipment or cabling" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.363" ;
