concept:telecommunications-act-1997-sec-420 a cml:Concept ;
    skos:prefLabel "420 Prohibition of unauthorised cabling work"@en ;
    cml:realizedBy doc:sec-420 ;
    values:originalText "(1) A person must not perform a particular type of cabling work unless:  (a) the person is subject to the cabling provider rules; or  (b) the person performs the work under the supervision of another person who is subject to the cabling provider rules; or  (c) the person is the holder of a cabling licence that authorises the performance of that type of cabling work; or  (d) the person performs the work under the supervision of the holder of a cabling licence that authorises the performance of that type of cabling work." ;
    skos:definition "(1) A person must not perform a particular type of cabling work unless:  (a) the person is subject to the cabling provider rules; or  (b) the person performs the work under the supervision of another person who is subject to the cabling provider rules; or  (c) the person is the holder of a cabling licence that authorises the performance of that type of cabling work; or  (d) the person performs the work under the supervision of the holder of a cabling licence that authorises the performance of that type of cabling work."@en ;
    cml:integrityHash "9a2f2defd9527c7492449f8d66d5c20fdb613849d7451c90fab8d84515bde220" ;
    cof:pageNumber "349"^^xsd:integer ;
    skos:note "Prohibition on performing cabling work without proper authorization." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
