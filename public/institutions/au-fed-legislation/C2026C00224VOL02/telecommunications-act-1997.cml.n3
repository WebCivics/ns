concept:telecommunications-act-1997-sec-372f a cml:Concept ;
    skos:prefLabel "372F Installation of fibre-ready facilities—building units"@en ;
    cml:realizedBy doc:sec-372f ;
    values:originalText "Scope  (1) This section applies to the installation of a fixed-line facility in the project area, or any of the project areas, for a real estate development project if:  (a) the project involves the construction of one or more building units on one or more areas of land; and  (b) the installation occurs after the commencement of this section; and  (c) sewerage services, electricity or water is, are, or will be, supplied to those units." ;
    skos:definition "Scope  (1) This section applies to the installation of a fixed-line facility in the project area, or any of the project areas, for a real estate development project if:  (a) the project involves the construction of one or more building units on one or more areas of land; and  (b) the installation occurs after the commencement of this section; and  (c) sewerage services, electricity or water is, are, or will be, supplied to those units."@en ;
    cml:integrityHash "7c66fc29428b549f13af4ccc2f3ec8256e01569bd6c49e55e394b2d8697ede2c" ;
    cof:pageNumber "281"^^xsd:integer ;
    skos:note "Installation of fibre-ready facilities—building units" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
