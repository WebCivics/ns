concept:telecommunications-act-1997-sec-431 a cml:Concept ;
    skos:prefLabel "431 Duration of cabling licence"@en ;
    cml:realizedBy doc:sec-431 ;
    values:originalText "A cabling licence comes into force when it is issued and remains in force:  (a) if the licence specifies a day of expiration—until the end of that day; or  (b) otherwise—indefinitely." ;
    skos:definition "A cabling licence comes into force when it is issued and remains in force:  (a) if the licence specifies a day of expiration—until the end of that day; or  (b) otherwise—indefinitely."@en ;
    cml:integrityHash "f3e8944a7209cbe206c78a2e508740a8460e800ed0c66203375c4ec924b83372" ;
    cof:pageNumber "354"^^xsd:integer ;
    skos:note "A cabling licence remains in force until its specified expiration day or indefinitely." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.354" ;
