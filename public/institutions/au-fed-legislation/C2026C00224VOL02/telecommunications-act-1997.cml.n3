concept:telecommunications-act-1997-sec-317zp a cml:Concept ;
    skos:prefLabel "317ZP Delegation by Director-General of the Australian Secret"@en ;
    cml:realizedBy doc:sec-317zp ;
    values:originalText "Intelligence Service  (1) The Director-General of the Australian Secret Intelligence Service may, by writing, delegate any or all of the functions or powers of the Director-General of the Australian Secret Intelligence Service under Division 2 or 6 to a person who:  (a) is a staff member of the Australian Secret Intelligence Service; and  (b) holds, or is acting in, a position in the Australian Secret Intelligence Service that is equivalent to, or higher than, a position occupied by an SES employee.  (2) A delegate must comply with any written directions of the Director-General of the Australian Secret Intelligence Service." ;
    skos:definition "Intelligence Service  (1) The Director-General of the Australian Secret Intelligence Service may, by writing, delegate any or all of the functions or powers of the Director-General of the Australian Secret Intelligence Service under Division 2 or 6 to a person who:  (a) is a staff member of the Australian Secret Intelligence Service; and  (b) holds, or is acting in, a position in the Australian Secret Intelligence Service that is equivalent to, or higher than, a position occupied by an SES employee.  (2) A delegate must comply with any written directions of the Director-General of the Australian Secret Intelligence Service."@en ;
    cml:integrityHash "a482eaeb7613e36407b2d5650943f40e37566fe935cc4fd641049d6bef93571a" ;
    cof:pageNumber "150"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-317zp-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-317zp-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.150" .
doc:sec-317zp a cof:Section ;
    cof:title "317ZP Delegation by Director-General of the Australian Secret" ;
    values:kind "section" ;
    values:originalText "Intelligence Service  (1) The Director-General of the Australian Secret Intelligence Service may, by writing, delegate any or all of the functions or powers of the Director-General of the Australian Secret Intelligence Service under Division 2 or 6 to a person who:  (a) is a staff member of the Australian Secret Intelligence Service; and  (b) holds, or is acting in, a position in the Australian Secret Intelligence Service that is equivalent to, or higher than, a position occupied by an SES employee.  (2) A delegate must comply with any written directions of the Director-General of the Australian Secret Intelligence Service." ;
    cof:pageNumber "150"^^xsd:integer .

