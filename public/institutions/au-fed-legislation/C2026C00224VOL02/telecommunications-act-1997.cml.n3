concept:telecommunications-act-1997-sec-421-ss-5 a cml:Concept ;
    skos:prefLabel "421(5) Cabling provider rules"@en ;
    cml:realizedBy doc:sec-421-ss-5 ;
    values:originalText "(5) The cabling provider rules may make provision for or in relation to a particular matter by empowering the ACMA to make decisions of an administrative character.   Technical regulation  Part 21 Cabling providers  Division 9  Section 422  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "(5) The cabling provider rules may make provision for or in relation to a particular matter by empowering the ACMA to make decisions of an administrative character.   Technical regulation  Part 21 Cabling providers  Division 9  Section 422  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "b517f15fd1b11a455bca0c2df4e0adbe683d127874700cc49358c6aac004e335" ;
    values:partOf concept:telecommunications-act-1997-sec-421 ;
    cof:pageNumber "350"^^xsd:integer ;
    skos:note "Empowers ACMA to make decisions of an administrative character." ;
    cml:curationStatus cml:Proposed ;
