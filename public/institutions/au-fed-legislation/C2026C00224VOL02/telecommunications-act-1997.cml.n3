concept:telecommunications-act-1997-sec-581v a cml:Concept ;
    skos:prefLabel "581V Simplified outline of this Part"@en ;
    cml:realizedBy doc:sec-581v ;
    values:originalText "• If a group of companies includes a carrier, a company (other than a carrier) that is in the group must:  (a) provide carriers with access to facilities; and  (b) provide carriers with access to telecommunications transmission towers." ;
    skos:definition "• If a group of companies includes a carrier, a company (other than a carrier) that is in the group must:  (a) provide carriers with access to facilities; and  (b) provide carriers with access to telecommunications transmission towers."@en ;
    cml:integrityHash "464a306ea01a1e12db8d6e50445c3460486d222ec440d90dcd8684085b92a167" ;
    cof:pageNumber "617"^^xsd:integer ;
    skos:note "Company must provide carriers with access to facilities and telecommunications transmission towers." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
