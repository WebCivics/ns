concept:telecommunications-act-1997-sec-416 a cml:Concept ;
    skos:prefLabel "416 Application of labels containing false statements about"@en ;
    cml:realizedBy doc:sec-416 ;
    values:originalText "compliance with standards  (1) A person must not apply a label to customer equipment or customer cabling if:  (a) the label contains a statement to the effect that the equipment or cabling complies with a section 376 standard; and  (b) the statement is false or misleading.  (2) A person who contravenes subsection (1) commits an offence punishable on conviction by a fine not exceeding 120 penalty units. Note 1: See also sections 4AA and 4B of the Crimes Act 1914. Note 2: See also Division 13 of this Part (which deals with the payment of penalties as an alternative to prosecution).   Technical regulation  Part 21 Protected symbols  Division 8  Section 417  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "compliance with standards  (1) A person must not apply a label to customer equipment or customer cabling if:  (a) the label contains a statement to the effect that the equipment or cabling complies with a section 376 standard; and  (b) the statement is false or misleading.  (2) A person who contravenes subsection (1) commits an offence punishable on conviction by a fine not exceeding 120 penalty units. Note 1: See also sections 4AA and 4B of the Crimes Act 1914. Note 2: See also Division 13 of this Part (which deals with the payment of penalties as an alternative to prosecution).   Technical regulation  Part 21 Protected symbols  Division 8  Section 417  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "640a62f732a16eb05e4180805bcce4e9e3ed808486d02db17768e2f4c0dbeb5e" ;
    cof:pageNumber "344"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-416-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-416-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.344" .
