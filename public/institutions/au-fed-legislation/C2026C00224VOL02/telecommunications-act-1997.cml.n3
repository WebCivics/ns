concept:telecommunications-act-1997-sec-317v a cml:Concept ;
    skos:prefLabel "317V Decision-making criteria"@en ;
    cml:realizedBy doc:sec-317v ;
    values:originalText "The Attorney-General must not give a technical capability notice to a designated communications provider unless:  (a) the Attorney-General is satisfied that the requirements imposed by the notice are reasonable and proportionate; and" ;
    skos:definition "The Attorney-General must not give a technical capability notice to a designated communications provider unless:  (a) the Attorney-General is satisfied that the requirements imposed by the notice are reasonable and proportionate; and"@en ;
