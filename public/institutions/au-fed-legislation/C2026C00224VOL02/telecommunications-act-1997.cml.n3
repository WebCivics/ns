doc:sec-360vd-ss-3 a cof:Section ;
    cof:title "360VD(3) Damages for breach of a designated compensable standard" ;
    values:kind "subsection" ;
    values:originalText "(3) The amount of damages payable under subsection (1) or (2) for a particular contravention is ascertained in accordance with the compensation rules." ;
