    values:partOf concept:telecommunications-act-1997-sec-577g ;
    cof:pageNumber "576"^^xsd:integer ;
    skos:note "Notice of application must be given to certain persons or published in a certain manner." ;
    cml:curationStatus cml:Proposed ;
