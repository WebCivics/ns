concept:telecommunications-act-1997-sec-16-ss-11 a cml:Concept ;
    skos:prefLabel "16(11) August 1996, the person:"@en ;
    cml:realizedBy doc:sec-16-ss-11 ;
    values:originalText "(11) For the purposes of this section, a section 376 standard is taken to be applicable in relation to customer equipment or customer cabling if, and only if, the standard was specified in the section 407 requirement that dealt with the manufacture or importation of the equipment or cabling." ;
    skos:definition "(11) For the purposes of this section, a section 376 standard is taken to be applicable in relation to customer equipment or customer cabling if, and only if, the standard was specified in the section 407 requirement that dealt with the manufacture or importation of the equipment or cabling."@en ;
    cml:integrityHash "d3185539c932b799f2ee1ae5bbf8aa575827ad89f54302a9d252a892b14d69fa" ;
    values:partOf concept:telecommunications-act-1997-sec-16 ;
    cof:pageNumber "346"^^xsd:integer ;
    skos:note "Standard applicability in relation to customer equipment or cabling" ;
    cml:curationStatus cml:Proposed ;
