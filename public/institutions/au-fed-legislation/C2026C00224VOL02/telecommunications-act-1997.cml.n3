concept:telecommunications-act-1997-sec-372j a cml:Concept ;
    skos:prefLabel "372J Acquisition of property"@en ;
    cml:realizedBy doc:sec-372j ;
    values:originalText "This Subdivision does not apply to the extent that the operation of the Subdivision would result in an acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) from a person otherwise than on just terms (within the meaning of that paragraph). Subdivision C—Remedial notices" ;
    skos:definition "This Subdivision does not apply to the extent that the operation of the Subdivision would result in an acquisition of property (within the meaning of paragraph 51(xxxi) of the Constitution) from a person otherwise than on just terms (within the meaning of that paragraph). Subdivision C—Remedial notices"@en ;
    cml:integrityHash "ea7b92b3582bb6d637025a0c3b5f97ecd0c2dadead9d72603ab7fa6bb6e8dbe5" ;
    cof:pageNumber "288"^^xsd:integer ;
    skos:note "Acquisition of property exception" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.288" ;
    cml:asserts concept:telecommunications-act-1997-sec-372j-norm .
