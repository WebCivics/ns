doc:sec-571-ss-1 a cof:Section ;
    cof:title "571(1) Civil action for recovery of pecuniary penalties" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister, the ACMA or the ACCC may institute a proceeding in the Federal Court for the recovery on behalf of the Commonwealth of a pecuniary penalty referred to in section 570." ;
    cof:pageNumber "498"^^xsd:integer .

concept:telecommunications-act-1997-sec-571-ss-2 a cml:Concept ;
    skos:prefLabel "571(2) Civil action for recovery of pecuniary penalties"@en ;
    cml:realizedBy doc:sec-571-ss-2 ;
    values:originalText "(2) A proceeding under subsection (1) may be commenced within 6 years after the contravention.   Civil penalties  Part 31  Section 571  Telecommunications Act 1997  Compilation date: 04/06/2026  Limit on standing of the ACMA" ;
