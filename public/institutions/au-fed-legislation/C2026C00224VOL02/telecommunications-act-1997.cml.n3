concept:telecommunications-act-1997-sec-572 a cml:Concept ;
    skos:prefLabel "572 Criminal proceedings not to be brought for contravention of"@en ;
    cml:realizedBy doc:sec-572 ;
    values:originalText "civil penalty provisions  Criminal proceedings do not lie against a person only because the person has contravened a civil penalty provision." ;
    skos:definition "civil penalty provisions  Criminal proceedings do not lie against a person only because the person has contravened a civil penalty provision."@en ;
