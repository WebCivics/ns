doc:sec-474-ss-1 a cof:Section ;
    cof:title "474(1) Declared manager of electronic addressing" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACMA may, by notice in the Gazette, determine that, for the purposes of this Division, a specified person or association is a declared manager of electronic addressing in relation to a specified kind of electronic addressing and a specified kind of listed carriage service." ;
    cof:pageNumber "397"^^xsd:integer .

