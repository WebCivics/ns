concept:telecommunications-act-1997-sec-525 a cml:Concept ;
    skos:prefLabel "525 Giving false or misleading information or evidence"@en ;
    cml:realizedBy doc:sec-525 ;
    values:originalText "A person must not, under section 521 or 522, give information or evidence that is false or misleading. Penalty: Imprisonment for 12 months. Note: See also sections 4AA and 4B of the Crimes Act 1914." ;
    skos:definition "A person must not, under section 521 or 522, give information or evidence that is false or misleading. Penalty: Imprisonment for 12 months. Note: See also sections 4AA and 4B of the Crimes Act 1914."@en ;
    cml:integrityHash "d15f4a0d4e3aa23c334e488be98b7aca9dbc68e72ecea98749351f43cfea58af" ;
    cof:pageNumber "453"^^xsd:integer ;
    skos:note "Giving false or misleading information or evidence is prohibited." ;
    dc:references "sec-521" ;
    dc:references "sec-522" ;
    cml:curationStatus cml:Proposed ;
