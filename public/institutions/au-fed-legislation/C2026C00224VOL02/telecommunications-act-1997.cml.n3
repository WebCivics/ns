concept:telecommunications-act-1997-sec-340 a cml:Concept ;
    skos:prefLabel "340 Compliance with agreement"@en ;
    cml:realizedBy doc:sec-340 ;
    values:originalText "If:  (a) a carrier; or  (b) a carriage service provider; has entered into a certified agreement, the carrier or provider, as the case requires, must comply with the agreement, so long as the agreement remains in force." ;
    skos:definition "If:  (a) a carrier; or  (b) a carriage service provider; has entered into a certified agreement, the carrier or provider, as the case requires, must comply with the agreement, so long as the agreement remains in force."@en ;
    cml:integrityHash "8bfe22ec5e2b5226e4e2df85cd197ae7fa501f97acce3738aae5845776418bbb" ;
    cof:pageNumber "162"^^xsd:integer ;
    skos:note "Carrier or provider must comply with certified agreement while it remains in force." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.162" ;
