concept:telecommunications-act-1997-sec-505b a cml:Concept ;
    skos:prefLabel "505B ACCC may adopt a finding from a previous public inquiry"@en ;
    cml:realizedBy doc:sec-505b ;
    values:originalText "If:  (a) the ACCC has held a public inquiry (the original inquiry) under this Part; and  (b) the ACCC has prepared a report about the original inquiry under section 505; and  (c) the ACCC holds another public inquiry under this Part; the ACCC may, for the purposes of the other public inquiry, adopt a finding set out in the report about the original inquiry." ;
    skos:definition "If:  (a) the ACCC has held a public inquiry (the original inquiry) under this Part; and  (b) the ACCC has prepared a report about the original inquiry under section 505; and  (c) the ACCC holds another public inquiry under this Part; the ACCC may, for the purposes of the other public inquiry, adopt a finding set out in the report about the original inquiry."@en ;
    cml:integrityHash "822017795a98706b378878d2e53f86ed2d67e1d445dd2cbbf101f7abddc8a2d7" ;
    cof:pageNumber "434"^^xsd:integer ;
