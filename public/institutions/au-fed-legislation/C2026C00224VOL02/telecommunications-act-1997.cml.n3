concept:telecommunications-act-1997-sec-553-ss-2 a cml:Concept ;
    skos:prefLabel "553(2) Offences that are going to be committed"@en ;
    cml:realizedBy doc:sec-553-ss-2 ;
    values:originalText "(2) A reference in this section to an offence against this Act includes a reference to an offence created by section 6 of the Crimes Act 1914 or Part 2.4 of the Criminal Code that relates to this Act." ;
