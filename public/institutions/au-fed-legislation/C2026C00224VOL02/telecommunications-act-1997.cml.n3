concept:telecommunications-act-1997-sec-375 a cml:Concept ;
    skos:prefLabel "375 Manager of network or facility"@en ;
    cml:realizedBy doc:sec-375 ;
    values:originalText "For the purposes of this Part, the manager of:  (a) a telecommunications network; or  (b) a facility of a telecommunications network; is the carrier, or carriage service provider, who operates the network or facility, as the case may be.   Technical regulation  Part 21 Technical standards about customer equipment and customer cabling  Division 3  Section 376  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "For the purposes of this Part, the manager of:  (a) a telecommunications network; or  (b) a facility of a telecommunications network; is the carrier, or carriage service provider, who operates the network or facility, as the case may be.   Technical regulation  Part 21 Technical standards about customer equipment and customer cabling  Division 3  Section 376  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "32c1757e666b13f92ff2681214e23719e52572a3f20104e6a2073e5079d77236" ;
    cof:pageNumber "312"^^xsd:integer ;
    skos:note "Defines the manager of a telecommunications network or facility as the carrier or carriage service provider." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.312" ;
