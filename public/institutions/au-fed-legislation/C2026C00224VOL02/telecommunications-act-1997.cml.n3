doc:sec-360k-ss-1a a cof:Section ;
    cof:title "360K(1A) Statutory infrastructure provider for a nominated service area" ;
    values:kind "subsection" ;
    values:originalText "(1A) For the purposes of this Part, if:  (a) an area is a provisional nominated service area because of a declaration made by a carriage service provider under section 360HB; and  (b) the whole or a part of the provisional nominated service area is a nominated service area; the carriage service provider is the statutory infrastructure provider for the nominated service area." ;
    cof:pageNumber "213"^^xsd:integer .

concept:telecommunications-act-1997-sec-360k-ss-1b a cml:Concept ;
    skos:prefLabel "360K(1B) Statutory infrastructure provider for a nominated service area"@en ;
    cml:realizedBy doc:sec-360k-ss-1b ;
    values:originalText "(1B) The Minister may, by legislative instrument, declare that:  (a) subsection (1A) does not apply to a specified nominated service area; and  (b) a specified carriage service provider is the statutory infrastructure provider for the nominated service area for the purposes of this Part." ;
    skos:definition "(1B) The Minister may, by legislative instrument, declare that:  (a) subsection (1A) does not apply to a specified nominated service area; and  (b) a specified carriage service provider is the statutory infrastructure provider for the nominated service area for the purposes of this Part."@en ;
    cml:integrityHash "182a88c83ae999359818cbe2c4da62fb440e4e076df85f52a22173a0e530bd89" ;
    values:partOf concept:telecommunications-act-1997-sec-360k ;
    cof:pageNumber "213"^^xsd:integer ;
