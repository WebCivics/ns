doc:sec-501-ss-4 a cof:Section ;
    cof:title "501(4) Hearings" ;
    values:kind "subsection" ;
    values:originalText "(4) The Chairperson is to preside at all hearings at which he or she is present." ;
    cof:pageNumber "429"^^xsd:integer .

