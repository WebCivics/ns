concept:telecommunications-act-1997-sec-435 a cml:Concept ;
    skos:prefLabel "435 Formal warnings—breach of condition"@en ;
    cml:realizedBy doc:sec-435 ;
    values:originalText "The ACMA may issue a formal warning if the holder of a cabling licence contravenes a condition to which the licence is subject." ;
    skos:definition "The ACMA may issue a formal warning if the holder of a cabling licence contravenes a condition to which the licence is subject."@en ;
