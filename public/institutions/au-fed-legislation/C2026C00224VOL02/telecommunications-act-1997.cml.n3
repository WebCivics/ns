    cof:pageNumber "473"^^xsd:integer .

concept:telecommunications-act-1997-sec-547f a cml:Concept ;
    skos:prefLabel "547F Announcement before entry"@en ;
    cml:realizedBy doc:sec-547f ;
    values:originalText "(1) An inspector must, before entering premises under a warrant under section 547D:  (a) announce that he or she is authorised to enter the premises; and  (b) give any person at the premises an opportunity to allow entry to the premises.  (2) An inspector is not required to comply with subsection (1) if he or she believes on reasonable grounds that immediate entry to the premises is required:  (a) to ensure the safety of a person; or  (b) to ensure that the effective execution of the warrant is not frustrated." ;
    skos:definition "(1) An inspector must, before entering premises under a warrant under section 547D:  (a) announce that he or she is authorised to enter the premises; and  (b) give any person at the premises an opportunity to allow entry to the premises.  (2) An inspector is not required to comply with subsection (1) if he or she believes on reasonable grounds that immediate entry to the premises is required:  (a) to ensure the safety of a person; or  (b) to ensure that the effective execution of the warrant is not frustrated."@en ;
