concept:telecommunications-act-1997-sec-581w-ss-4 a cml:Concept ;
    skos:prefLabel "581W(4) Carrier company group"@en ;
    cml:realizedBy doc:sec-581w-ss-4 ;
    values:originalText "(4) If no determination is in force under subsection (3), then, for the purposes of this section, assume that each reference in section 46 of the Corporations Act 2001 to one-half were a reference to 15%." ;
