concept:telecommunications-act-1997-sec-450-ss-5 a cml:Concept ;
    skos:prefLabel "450(5) Declaration of prohibited customer equipment or prohibited"@en ;
    cml:realizedBy doc:sec-450-ss-5 ;
    values:originalText "(5) In this section: supply includes supply (including re-supply) by way of sale, exchange, lease, hire or hire-purchase." ;
    skos:definition "(5) In this section: supply includes supply (including re-supply) by way of sale, exchange, lease, hire or hire-purchase."@en ;
    cml:integrityHash "947c50c1f8ffe5dde6eea665e4e60dfd8d2b22d2ae850fb33574bfd09381183d" ;
    values:partOf concept:telecommunications-act-1997-sec-450 ;
    cof:pageNumber "370"^^xsd:integer ;
    skos:note "Definition of supply includes various forms of sale, exchange, lease, hire, or hire-purchase." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
