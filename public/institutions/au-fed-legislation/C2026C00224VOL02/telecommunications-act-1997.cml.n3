concept:telecommunications-act-1997-sec-482 a cml:Concept ;
    skos:prefLabel "482 Concurrent operation of State/Territory laws"@en ;
    cml:realizedBy doc:sec-482 ;
    values:originalText "This Part does not prevent or limit the operation of a law of a State or Territory that is capable of operating concurrently with this Part.   Standard agreements for the supply of carriage services  Part 23  Section 483  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
