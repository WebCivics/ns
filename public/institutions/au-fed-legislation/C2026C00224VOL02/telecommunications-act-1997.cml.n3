doc:sec-441-ss-3 a cof:Section ;
    cof:title "441(3) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(3) The delegate is, in the exercise of the delegated function or power, subject to the written directions of:  (a) the ACMA, if the delegation to the delegate was under subsection (1); or  (b) the Division that delegated the power, if the delegation to the delegate was under subsection (1A)." ;
    cof:pageNumber "359"^^xsd:integer .

concept:telecommunications-act-1997-sec-441-ss-4 a cml:Concept ;
    skos:prefLabel "441(4) Delegation"@en ;
    cml:realizedBy doc:sec-441-ss-4 ;
    values:originalText "(4) The powers conferred on the ACMA by subsection (1), and on a Division of the ACMA by subsection (1A), are in addition to the powers conferred by sections 50, 51 and 52 of the Australian Communications and Media Authority Act 2005." ;
    skos:definition "(4) The powers conferred on the ACMA by subsection (1), and on a Division of the ACMA by subsection (1A), are in addition to the powers conferred by sections 50, 51 and 52 of the Australian Communications and Media Authority Act 2005."@en ;
