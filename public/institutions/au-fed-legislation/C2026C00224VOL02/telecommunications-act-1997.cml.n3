doc:sec-529-ss-2d a cof:Section ;
    cof:title "529(2D) ACMA may make record-keeping rules" ;
    values:kind "subsection" ;
    values:originalText "(2D) The rules may provide for:  (a) the preparation of reports as and when required by the ACMA; or  (b) the preparation of periodic reports relating to such regular intervals as are specified in the rules." ;
    cof:pageNumber "455"^^xsd:integer .

concept:telecommunications-act-1997-sec-529-ss-2e a cml:Concept ;
    skos:prefLabel "529(2E) ACMA may make record-keeping rules"@en ;
    cml:realizedBy doc:sec-529-ss-2e ;
    values:originalText "(2E) The rules may require or permit a report prepared in accordance with the rules to be given to the ACMA, in accordance with specified software requirements and specified authentication requirements:  (a) on a specified kind of data processing device; or  (b) by way of a specified kind of electronic transmission." ;
    skos:definition "(2E) The rules may require or permit a report prepared in accordance with the rules to be given to the ACMA, in accordance with specified software requirements and specified authentication requirements:  (a) on a specified kind of data processing device; or  (b) by way of a specified kind of electronic transmission."@en ;
    cml:integrityHash "3e1fb63d5fba15d5236f315e1f1cd4937d1b2ebf2c485ef24f214f4aa1b0b93e" ;
    values:partOf concept:telecommunications-act-1997-sec-529 ;
    cof:pageNumber "455"^^xsd:integer ;
    skos:note "ACMA may make record-keeping rules requiring or permitting reports to be given to ACMA." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
