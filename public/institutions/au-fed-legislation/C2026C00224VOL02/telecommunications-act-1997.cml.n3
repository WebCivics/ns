concept:telecommunications-act-1997-sec-360z-ss-4 a cml:Concept ;
    skos:prefLabel "360Z(4) Register of statutory infrastructure providers and anticipatory"@en ;
    cml:realizedBy doc:sec-360z-ss-4 ;
    values:originalText "(4) If an area specified in a notice given under a provision mentioned in paragraph (1)(c) consists of, or is included in, a nominated service area, the ACMA may:  (a) annotate the copy of the notice that is included in the Register with a statement to the effect that the area specified in the notice consists of, or is included in, a specified nominated service area; or  (b) remove the notice from the Register." ;
    skos:definition "(4) If an area specified in a notice given under a provision mentioned in paragraph (1)(c) consists of, or is included in, a nominated service area, the ACMA may:  (a) annotate the copy of the notice that is included in the Register with a statement to the effect that the area specified in the notice consists of, or is included in, a specified nominated service area; or  (b) remove the notice from the Register."@en ;
    cml:integrityHash "a4ef27cce4cc17b3683fc35107740a15269a3ce6c15bd9afee1a92f85871a639" ;
    values:partOf concept:telecommunications-act-1997-sec-360z ;
    cof:pageNumber "261"^^xsd:integer ;
    skos:note "Annotate or remove notice from Register" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
