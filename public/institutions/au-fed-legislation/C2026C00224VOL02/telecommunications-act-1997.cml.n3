concept:telecommunications-act-1997-sec-360vb a cml:Concept ;
    skos:prefLabel "360VB Definitions"@en ;
    cml:realizedBy doc:sec-360vb ;
    values:originalText "In this Division: customer includes prospective customer. damages includes punitive damages." ;
