concept:telecommunications-act-1997-sec-447-ss-2 cml:asserts concept:telecommunications-act-1997-sec-447-ss-2-logic-alleninterval-3 .
concept:telecommunications-act-1997-sec-447-ss-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "ACMA's belief that no reasonable grounds for disconnection existed is between the time equipment or cabling was disconnected and the present." ;
    cml:premiseText "Equipment or cabling was disconnected." ;
    cml:conclusionText "ACMA believes no reasonable grounds for disconnection existed." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

