doc:sec-360vg-ss-3 a cof:Section ;
    cof:title "360VG(3) Savings of other laws and remedies" ;
    values:kind "subsection" ;
    values:originalText "(3) This Division does not limit, restrict or otherwise affect the operation of the Telecommunications Industry Ombudsman scheme. In particular, this Division does not affect a customer’s right to complain to the Telecommunications Industry Ombudsman." ;
    cof:pageNumber "251"^^xsd:integer .

