concept:telecommunications-act-1997-sec-317x-ss-6 a cml:Concept ;
    skos:prefLabel "317X(6) Variation of technical capability notices"@en ;
    cml:realizedBy doc:sec-317x-ss-6 ;
    values:originalText "(6) If:  (a) the Attorney-General varies a technical capability notice; and  (b) the acts or things specified in the varied notice:  (i) are directed towards ensuring that a designated communications provider is capable of giving listed help (within the meaning of section 317T) to ASIO in relation to a matter covered by paragraph 317T(2)(a); or  (ii) are by way of giving help to ASIO in relation to a matter covered by paragraph 317T(2)(b);" ;
    skos:definition "(6) If:  (a) the Attorney-General varies a technical capability notice; and  (b) the acts or things specified in the varied notice:  (i) are directed towards ensuring that a designated communications provider is capable of giving listed help (within the meaning of section 317T) to ASIO in relation to a matter covered by paragraph 317T(2)(a); or  (ii) are by way of giving help to ASIO in relation to a matter covered by paragraph 317T(2)(b);"@en ;
    cml:integrityHash "53dbd3542118bf9dbde040d7474839365710dc56d0b33d9d5f6be6f25d293456" ;
    values:partOf concept:telecommunications-act-1997-sec-317x ;
    cof:pageNumber "100"^^xsd:integer ;
