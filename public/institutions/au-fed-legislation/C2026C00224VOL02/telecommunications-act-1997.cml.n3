concept:telecommunications-act-1997-sec-553 a cml:Concept ;
    skos:prefLabel "553 Offences that are going to be committed"@en ;
    cml:realizedBy doc:sec-553 ;
    values:originalText "(1) If:  (a) there are reasonable grounds for suspecting that an offence against this Act is going to be committed; and  (b) the commission of that offence would pose a threat to the safety of human life or cause substantial loss or damage; this Part applies in relation to the offence as if there were reasonable grounds for suspecting that it had been committed.  (2) A reference in this section to an offence against this Act includes a reference to an offence created by section 6 of the Crimes Act 1914 or Part 2.4 of the Criminal Code that relates to this Act.  (3) In this section: this Act includes the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act." ;
    skos:definition "(1) If:  (a) there are reasonable grounds for suspecting that an offence against this Act is going to be committed; and  (b) the commission of that offence would pose a threat to the safety of human life or cause substantial loss or damage; this Part applies in relation to the offence as if there were reasonable grounds for suspecting that it had been committed.  (2) A reference in this section to an offence against this Act includes a reference to an offence created by section 6 of the Crimes Act 1914 or Part 2.4 of the Criminal Code that relates to this Act.  (3) In this section: this Act includes the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act."@en ;
    cml:integrityHash "ba50a9f2979ef61b7778d725aa40a5042eaf200c97fa740d927f4e336086beb1" ;
    cof:pageNumber "485"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-553-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-553-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sec-553-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.485" .
