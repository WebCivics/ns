concept:telecommunications-act-1997-sec-372jf-ss-2 a cml:Concept ;
    skos:prefLabel "372JF(2) Revocation of remedial notices"@en ;
    cml:realizedBy doc:sec-372jf-ss-2 ;
    values:originalText "(2) In this section, compliance period means the period stated in the remedial notice under section 372JB, and includes that period as extended under section 372JD." ;
    skos:definition "(2) In this section, compliance period means the period stated in the remedial notice under section 372JB, and includes that period as extended under section 372JD."@en ;
