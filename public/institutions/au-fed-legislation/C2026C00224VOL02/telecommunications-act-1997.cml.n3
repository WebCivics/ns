concept:telecommunications-act-1997-sec-317t-ss-3 a cml:Concept ;
    skos:prefLabel "317T(3) Technical capability notices"@en ;
    cml:realizedBy doc:sec-317t-ss-3 ;
    values:originalText "(3) For the purposes of this section, relevant objective means:  (a) enforcing the criminal law, so far as it relates to serious Australian offences; or  (b) assisting the enforcement of the criminal laws in force in a foreign country, so far as those laws relate to serious foreign offences; or  (c) safeguarding national security. Listed help" ;
    skos:definition "(3) For the purposes of this section, relevant objective means:  (a) enforcing the criminal law, so far as it relates to serious Australian offences; or  (b) assisting the enforcement of the criminal laws in force in a foreign country, so far as those laws relate to serious foreign offences; or  (c) safeguarding national security. Listed help"@en ;
    cml:integrityHash "24cca206958080abcd9a32bfca0e07f32a5400ce28147ad9c90e7d3c54be7248" ;
    values:partOf concept:telecommunications-act-1997-sec-317t ;
    cof:pageNumber "86"^^xsd:integer ;
    skos:note "Relevant objective means for enforcement of serious Australian and foreign offences, safeguarding national security." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
