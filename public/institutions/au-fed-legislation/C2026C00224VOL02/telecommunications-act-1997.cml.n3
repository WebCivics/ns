doc:sec-317za-ss-2 a cof:Section ;
    cof:title "317ZA(2) Compliance with notices—carriers and carriage service" ;
    values:kind "subsection" ;
    values:originalText "(2) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (1); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (1); or  (c) be in any way, directly or indirectly, knowingly concerned in, or party to, a contravention of subsection (1); or  (d) conspire with others to effect a contravention of subsection (1)." ;
    cof:pageNumber "112"^^xsd:integer .

concept:telecommunications-act-1997-sec-317za-ss-3 a cml:Concept ;
    skos:prefLabel "317ZA(3) Compliance with notices—carriers and carriage service"@en ;
    cml:realizedBy doc:sec-317za-ss-3 ;
    values:originalText "(3) Subsections (1) and (2) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions." ;
    skos:definition "(3) Subsections (1) and (2) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions."@en ;
    cml:integrityHash "b9459f66a6a6ecabb7269bfc7957b0751b49a76dde21c674d0b2966327b8b9af" ;
    values:partOf concept:telecommunications-act-1997-sec-317za ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "Civil penalty provision for non-compliance with notices." ;
