concept:telecommunications-act-1997-sec-581j a cml:Concept ;
    skos:prefLabel "581J Demerged Telstra company"@en ;
    cml:realizedBy doc:sec-581j ;
    values:originalText "For the purposes of this Act, each of the following companies is a demerged Telstra company:  (a) Telstra Group Limited (ACN 650 620 303), as the company exists from time to time (even if its name is later changed);  (b) Telstra Infraco Limited (ACN 051 775 556), as the company exists from time to time (even if its name is later changed);  (c) Amplitel Pty Ltd (ACN 648 133 073), as the company exists from time to time (even if its name is later changed);  (d) Telstra Limited (ACN 086 174 781), as the company exists from time to time (even if its name is later changed). Note: See also section 581U (transitional—references in legislation to Telstra Infraco Limited)." ;
    skos:definition "For the purposes of this Act, each of the following companies is a demerged Telstra company:  (a) Telstra Group Limited (ACN 650 620 303), as the company exists from time to time (even if its name is later changed);  (b) Telstra Infraco Limited (ACN 051 775 556), as the company exists from time to time (even if its name is later changed);  (c) Amplitel Pty Ltd (ACN 648 133 073), as the company exists from time to time (even if its name is later changed);  (d) Telstra Limited (ACN 086 174 781), as the company exists from time to time (even if its name is later changed). Note: See also section 581U (transitional—references in legislation to Telstra Infraco Limited)."@en ;
    cml:integrityHash "8cb152c6f59a55dba4bbfa95fc9d62d6c8d12d0a77e54328702e1b90844dee2f" ;
    cof:pageNumber "601"^^xsd:integer ;
    skos:note "List of demerged Telstra companies" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.601" ;
