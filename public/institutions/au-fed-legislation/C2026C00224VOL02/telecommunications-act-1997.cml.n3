doc:sec-495-ss-1 a cof:Section ;
    cof:title "495(1) Reports on inquiries" ;
    values:kind "subsection" ;
    values:originalText "(1) If the ACMA holds a public inquiry, the ACMA must prepare a report setting out its findings as a result of the inquiry." ;
    cof:pageNumber "426"^^xsd:integer .

