concept:telecommunications-act-1997-sec-581p a cml:Concept ;
    skos:prefLabel "581P Notification of transfer of telecommunications asset"@en ;
    cml:realizedBy doc:sec-581p ;
    values:originalText "(1) If:  (a) after the commencement of Schedule 2 to the Telstra Corporation and Other Legislation Amendment Act 2021, a Telstra successor company or a designated Telstra successor company transfers a telecommunications asset; and  (b) the transfer is not covered by a declaration under subsection (2); and  (c) the telecommunications asset is not covered by a declaration under subsection (3); and" ;
    skos:definition "(1) If:  (a) after the commencement of Schedule 2 to the Telstra Corporation and Other Legislation Amendment Act 2021, a Telstra successor company or a designated Telstra successor company transfers a telecommunications asset; and  (b) the transfer is not covered by a declaration under subsection (2); and  (c) the telecommunications asset is not covered by a declaration under subsection (3); and"@en ;
    cml:integrityHash "cfc76a0bcf8cf0283f48e3a8ca9c93cb839954a8f768fa9970eb2b33988fc608" ;
    cof:pageNumber "607"^^xsd:integer ;
    skos:note "Notification of transfer of telecommunications asset" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.607" ;
