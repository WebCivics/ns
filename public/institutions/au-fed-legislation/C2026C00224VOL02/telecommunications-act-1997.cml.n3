concept:telecommunications-act-1997-sec-430 a cml:Concept ;
    skos:prefLabel "430 Cabling licence has effect subject to this Act"@en ;
    cml:realizedBy doc:sec-430 ;
    values:originalText "(1) A cabling licence has effect subject to this Act.  (2) In this section: this Act includes the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act." ;
