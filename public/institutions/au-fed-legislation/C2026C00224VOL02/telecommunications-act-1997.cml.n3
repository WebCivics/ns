doc:sec-374 a cof:Section ;
    cof:title "374 Part applies to networks or facilities in Australia operated by" ;
    values:kind "section" ;
    values:originalText "carriers or carriage service providers  (1) A reference in this Part to a telecommunications network is a reference to a telecommunications network in Australia that is operated by a carrier or carriage service provider.  (2) A reference in this Part to a facility is a reference to a facility in Australia that is operated by a carrier or carriage service provider." ;
    cof:pageNumber "312"^^xsd:integer .

