doc:sec-547a-ss-2 a cof:Section ;
    cof:title "547A(2) Powers available to inspectors for monitoring compliance" ;
    values:kind "subsection" ;
    values:originalText "(2) An inspector is not authorised to enter premises under subsection (1) unless:  (a) the occupier of the premises has consented to the entry; or  (b) the entry is made under a warrant under section 547D. Consent" ;
    cof:pageNumber "471"^^xsd:integer .

concept:telecommunications-act-1997-sec-547a-ss-3 a cml:Concept ;
    skos:prefLabel "547A(3) Powers available to inspectors for monitoring compliance"@en ;
    cml:realizedBy doc:sec-547a-ss-3 ;
    values:originalText "(3) Before obtaining the consent of a person for the purposes of paragraph (2)(a), the inspector must inform the person that he or she may refuse consent." ;
    skos:definition "(3) Before obtaining the consent of a person for the purposes of paragraph (2)(a), the inspector must inform the person that he or she may refuse consent."@en ;
