concept:telecommunications-act-1997-sec-360 a cml:Concept ;
    skos:prefLabel "360 Simplified outline of this Part"@en ;
    cml:realizedBy doc:sec-360 ;
    values:originalText "• The statutory infrastructure provider for a service area must, on reasonable request by a carriage service provider on behalf of an end-user at premises in the service area, connect the premises to a qualifying telecommunications network in order that the carriage service provider can provide qualifying carriage services to the end-user at the premises. • A statutory infrastructure provider must comply with standards, benchmarks and rules determined by the Minister. • A statutory infrastructure provider must make available on its website the terms and conditions on which it offers to:  (a) connect premises; or  (b) supply related eligible services to carriage service providers." ;
    skos:definition "• The statutory infrastructure provider for a service area must, on reasonable request by a carriage service provider on behalf of an end-user at premises in the service area, connect the premises to a qualifying telecommunications network in order that the carriage service provider can provide qualifying carriage services to the end-user at the premises. • A statutory infrastructure provider must comply with standards, benchmarks and rules determined by the Minister. • A statutory infrastructure provider must make available on its website the terms and conditions on which it offers to:  (a) connect premises; or  (b) supply related eligible services to carriage service providers."@en ;
    cml:integrityHash "e127738e209cd19fe374bd7ba39c2984f267013db188186eb6ad79ec19908ba2" ;
    cof:pageNumber "182"^^xsd:integer ;
    skos:note "Must connect premises to a qualifying telecommunications network" ;
    dc:description "Qualifying carriage services to the end-user at the premises" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.182" ;
