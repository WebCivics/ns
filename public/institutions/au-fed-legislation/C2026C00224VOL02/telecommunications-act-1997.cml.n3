concept:telecommunications-act-1997-sec-436 a cml:Concept ;
    skos:prefLabel "436 Surrender of cabling licence"@en ;
    cml:realizedBy doc:sec-436 ;
    values:originalText "(1) The holder of a cabling licence may, at any time, surrender the licence by:   Technical regulation  Part 21 Cabling providers  Division 9  Section 437  Telecommunications Act 1997  Compilation date: 04/06/2026  (a) returning it to the ACMA; and  (b) giving the ACMA written notice that it is surrendered.  (2) The surrender of a cabling licence takes effect on the day on which the notice is given to the ACMA." ;
    skos:definition "(1) The holder of a cabling licence may, at any time, surrender the licence by:   Technical regulation  Part 21 Cabling providers  Division 9  Section 437  Telecommunications Act 1997  Compilation date: 04/06/2026  (a) returning it to the ACMA; and  (b) giving the ACMA written notice that it is surrendered.  (2) The surrender of a cabling licence takes effect on the day on which the notice is given to the ACMA."@en ;
    cml:integrityHash "8f61d945e164b0e065427d620ebbcb2353c827633def4ef888b2eb0284bd741f" ;
    cof:pageNumber "356"^^xsd:integer ;
