    values:partOf concept:telecommunications-act-1997-sec-474 ;
    cof:pageNumber "397"^^xsd:integer ;
    skos:note "ACMA cannot make a determination unless directed by ACCC or considers the person/association is not managing electronic addressing to ACMA's satisfaction." ;
