doc:sec-313-ss-2 a cof:Section ;
    cof:title "313(2) Obligations of carriers and carriage service providers" ;
    values:kind "subsection" ;
    values:originalText "(2) A carriage service intermediary must prevent, so far as it is reasonably practicable to do so, telecommunications networks and facilities from being used in, or in relation to, the commission of offences against the laws of the Commonwealth or of the States and Territories." ;
