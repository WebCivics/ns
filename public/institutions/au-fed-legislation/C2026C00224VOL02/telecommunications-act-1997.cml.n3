concept:telecommunications-act-1997-sec-469 a cml:Concept ;
    skos:prefLabel "469 Collection of charges on behalf of the Commonwealth"@en ;
    cml:realizedBy doc:sec-469 ;
    values:originalText "The ACMA may enter into an arrangement with a person under which the person may, on behalf of the Commonwealth, collect payments of charge imposed by the Telecommunications (Numbering Charges) Act 1997." ;
