concept:telecommunications-act-1997-sec-461 a cml:Concept ;
    skos:prefLabel "461 Consultation with ACCC"@en ;
    cml:realizedBy doc:sec-461 ;
    values:originalText "(1) Before making or varying a numbering plan, the ACMA must consult the ACCC.  (2) The numbering plan may provide that, before exercising a power conferred on the ACMA by the numbering plan, the ACMA must consult the ACCC." ;
    skos:definition "(1) Before making or varying a numbering plan, the ACMA must consult the ACCC.  (2) The numbering plan may provide that, before exercising a power conferred on the ACMA by the numbering plan, the ACMA must consult the ACCC."@en ;
    cml:integrityHash "a4b112868b3b83d98c93c3bd110d4aaaf9d611d102bfa5d37f69eb7a491cbb98" ;
    cof:pageNumber "385"^^xsd:integer ;
