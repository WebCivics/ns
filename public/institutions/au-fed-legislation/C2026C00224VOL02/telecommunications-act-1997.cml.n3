doc:sec-317w-ss-3 a cof:Section ;
    cof:title "317W(3) Consultation about a proposal to give a technical capability" ;
    values:kind "subsection" ;
    values:originalText "(3) The rule in subsection (2) does not apply to a technical capability notice given to a designated communications provider if:  (a) the Attorney-General is satisfied that the technical capability notice should be given as a matter of urgency; or  (b) compliance with subsection (2) is impracticable; or  (c) the provider waives compliance with subsection (2)." ;
    cof:pageNumber "94"^^xsd:integer .

