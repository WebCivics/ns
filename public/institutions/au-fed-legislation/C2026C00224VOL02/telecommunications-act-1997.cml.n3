concept:telecommunications-act-1997-sec-317zl-ss-4-logic-alleninterval-1 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal relation between service and body corporate" ;
    cml:premiseText "(a) and (b)" ;
    cml:conclusionText "service on or to agent in Australia" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-317zl-ss-4 cml:asserts concept:telecommunications-act-1997-sec-317zl-ss-4-logic-ltl-2 .
