doc:sec-346-ss-1 a cof:Section ;
    cof:title "346(1) Service provider determinations about designated disaster plans" ;
    values:kind "subsection" ;
    values:originalText "(1) Service provider determinations under section 99 may make provision for and in relation to compliance by one or more specified carriage service providers with one or more specified designated disaster plans." ;
    cof:pageNumber "165"^^xsd:integer .

