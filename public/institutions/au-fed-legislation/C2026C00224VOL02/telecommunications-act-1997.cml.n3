concept:telecommunications-act-1997-sec-574a a cml:Concept ;
    skos:prefLabel "574A Definition"@en ;
    cml:realizedBy doc:sec-574a ;
    values:originalText "In this Part: this Act includes:  (a) the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act; and  (b) the Spam Act 2003 and regulations under that Act; and  (c) the Do Not Call Register Act 2006 and regulations under that Act." ;
    skos:definition "In this Part: this Act includes:  (a) the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act; and  (b) the Spam Act 2003 and regulations under that Act; and  (c) the Do Not Call Register Act 2006 and regulations under that Act."@en ;
    cml:integrityHash "b084a5cc079c694031ed91f04faca5f3d27472e1bab0600ea6a42c38190f34fe" ;
