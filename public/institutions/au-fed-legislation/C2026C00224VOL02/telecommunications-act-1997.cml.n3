concept:telecommunications-act-1997-sec-550 a cml:Concept ;
    skos:prefLabel "550 Retention of documents"@en ;
    cml:realizedBy doc:sec-550 ;
    values:originalText "If:  (a) an inspector removes a document from any land, premises, vessel, aircraft or vehicle under section 542, 547 or 547B; or  (b) a person produces a document to an inspector in accordance with a requirement under subsection 549(1) or (1A); then:  (c) the inspector may retain possession of the document for such period as is necessary and reasonable for the purpose of ascertaining whether the Spam Act 2003 or Part 21 of this Act has been complied with; and  (d) during that period, the inspector must permit a person who would be entitled to inspect the document if it were not in the inspector’s possession to inspect the document at all reasonable times." ;
    skos:definition "If:  (a) an inspector removes a document from any land, premises, vessel, aircraft or vehicle under section 542, 547 or 547B; or  (b) a person produces a document to an inspector in accordance with a requirement under subsection 549(1) or (1A); then:  (c) the inspector may retain possession of the document for such period as is necessary and reasonable for the purpose of ascertaining whether the Spam Act 2003 or Part 21 of this Act has been complied with; and  (d) during that period, the inspector must permit a person who would be entitled to inspect the document if it were not in the inspector’s possession to inspect the document at all reasonable times."@en ;
    cml:integrityHash "e881b19a9b31d4a6e89987d71ef28b11cdf58b9612915f5205fd44e2fa902740" ;
    cof:pageNumber "483"^^xsd:integer ;
    skos:note "Inspector may retain possession of document for a reasonable period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.483" ;
    cml:asserts concept:telecommunications-act-1997-sec-550-norm .
