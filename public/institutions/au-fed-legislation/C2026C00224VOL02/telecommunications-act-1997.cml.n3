concept:telecommunications-act-1997-sec-372r a cml:Concept ;
    skos:prefLabel "372R Subdivision of an area of land"@en ;
    cml:realizedBy doc:sec-372r ;
    values:originalText "For the purposes of this Act, if an area of land has been subdivided into lots (however described) it is immaterial whether, after the subdivision, a part of the area of land (for example, a road) is not included in any of those lots." ;
    skos:definition "For the purposes of this Act, if an area of land has been subdivided into lots (however described) it is immaterial whether, after the subdivision, a part of the area of land (for example, a road) is not included in any of those lots."@en ;
    cml:integrityHash "ac8f580b0a4d15f33896522285c39b5d9486c8c8feeeca0a75229b9c63e1a06b" ;
    cof:pageNumber "303"^^xsd:integer ;
    skos:note "It is immaterial whether a part of the area of land is not included in any of those lots." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.303" ;
