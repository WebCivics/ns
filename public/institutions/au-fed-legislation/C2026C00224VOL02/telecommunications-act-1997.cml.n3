doc:sec-484e-ss-1 a cof:Section ;
    cof:title "484E(1) SMS Sender ID Register" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACMA must establish, or arrange for a person (a contracted service provider) to establish on behalf of the ACMA, a register to be known as the SMS Sender ID Register." ;
    cof:pageNumber "407"^^xsd:integer .

