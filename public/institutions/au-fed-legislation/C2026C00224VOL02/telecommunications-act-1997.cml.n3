concept:telecommunications-act-1997-sec-484d a cml:Concept ;
    skos:prefLabel "484D Definition of spoofing sender identification"@en ;
    cml:realizedBy doc:sec-484d ;
    values:originalText "A sender identification is a spoofing sender identification if:  (a) the sender identification is a message header that:  (i) identifies, or purportedly identifies, an entity covered by subsection 484F(2); or  (ii) identifies, or purportedly identifies, a thing or matter; and  (b) if that message header were used in a communication, that use would be likely to cause a reasonable person to believe that:  (i) if subparagraph (a)(i) applies—the entity sent the communication or authorised the sending of the communication; or  (ii) if subparagraph (a)(ii) applies—the purpose of the communication is to give information that is true in relation to the thing or matter; and  (c) that belief would be incorrect." ;
    skos:definition "A sender identification is a spoofing sender identification if:  (a) the sender identification is a message header that:  (i) identifies, or purportedly identifies, an entity covered by subsection 484F(2); or  (ii) identifies, or purportedly identifies, a thing or matter; and  (b) if that message header were used in a communication, that use would be likely to cause a reasonable person to believe that:  (i) if subparagraph (a)(i) applies—the entity sent the communication or authorised the sending of the communication; or  (ii) if subparagraph (a)(ii) applies—the purpose of the communication is to give information that is true in relation to the thing or matter; and  (c) that belief would be incorrect."@en ;
    cml:integrityHash "77067d8f9de03f6c27908de890422c79ca0ef56b622b9ae7410e9966240c1bbc" ;
    cof:pageNumber "407"^^xsd:integer ;
    skos:note "Definition of spoofing sender identification" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.407" ;
