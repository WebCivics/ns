concept:telecommunications-act-1997-sec-344 a cml:Concept ;
    skos:prefLabel "344 Designated disaster plans"@en ;
    cml:realizedBy doc:sec-344 ;
    values:originalText "For the purposes of this Division, a designated disaster plan is a plan that:  (a) is for coping with disasters and/or civil emergencies; and  (b) is prepared by the Commonwealth, a State or a Territory." ;
    skos:definition "For the purposes of this Division, a designated disaster plan is a plan that:  (a) is for coping with disasters and/or civil emergencies; and  (b) is prepared by the Commonwealth, a State or a Territory."@en ;
    cml:integrityHash "e628412ebc3385f78052a3953ee5e4b21bfb358becc3c0391ccd6ec60cf72621" ;
    cof:pageNumber "165"^^xsd:integer ;
    skos:note "Definition of designated disaster plan" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.165" ;
    cml:asserts concept:telecommunications-act-1997-sec-344-norm .
concept:telecommunications-act-1997-sec-344-norm a values:Undertaking ;
    cml:modality cml:Deontic ;
    values:partOf concept:telecommunications-act-1997-sec-344 ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
doc:sec-344 a cof:Section ;
    cof:title "344 Designated disaster plans" ;
    values:kind "section" ;
    values:originalText "For the purposes of this Division, a designated disaster plan is a plan that:  (a) is for coping with disasters and/or civil emergencies; and  (b) is prepared by the Commonwealth, a State or a Territory." ;
    cof:pageNumber "165"^^xsd:integer .

concept:telecommunications-act-1997-sec-345 a cml:Concept ;
    skos:prefLabel "345 Carrier licence conditions about designated disaster plans"@en ;
    cml:realizedBy doc:sec-345 ;
    values:originalText "(1) An instrument under section 63 imposing conditions on a carrier licence held by a carrier may make provision for and in relation to compliance by the carrier with one or more specified designated disaster plans.  (2) Subsection (1) does not, by implication, limit section 63." ;
    skos:definition "(1) An instrument under section 63 imposing conditions on a carrier licence held by a carrier may make provision for and in relation to compliance by the carrier with one or more specified designated disaster plans.  (2) Subsection (1) does not, by implication, limit section 63."@en ;
    cml:integrityHash "b21103e2a3374b6dd896a7f2684ca2a376ffebed1b3046917632ae99ffe9de76" ;
    cof:pageNumber "165"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-345-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-345-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
