concept:telecommunications-act-1997-sec-562 a cml:Concept ;
    skos:prefLabel "562 Review by the Administrative Review Tribunal"@en ;
    cml:realizedBy doc:sec-562 ;
    values:originalText "Applications may be made to the Administrative Review Tribunal to review a decision of a kind referred to in section 555 if the ACMA has affirmed or varied the decision under section 559." ;
