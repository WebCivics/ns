doc:sec-581tb-ss-7 a cof:Section ;
    cof:title "581TB(7) Facilitation of obligations imposed on a named designated" ;
    values:kind "subsection" ;
    values:originalText "(7) The period specified in the notice may be shorter than 30 days if the Minister is satisfied that the shorter period is necessary due to urgent circumstances." ;
    cof:pageNumber "614"^^xsd:integer .

concept:telecommunications-act-1997-sec-581tb-ss-8 a cml:Concept ;
    skos:prefLabel "581TB(8) Facilitation of obligations imposed on a named designated"@en ;
    cml:realizedBy doc:sec-581tb-ss-8 ;
    values:originalText "(8) If interested persons have given comments in accordance with a notice under subsection (5), the Minister must have due regard to those comments in giving or varying the direction." ;
