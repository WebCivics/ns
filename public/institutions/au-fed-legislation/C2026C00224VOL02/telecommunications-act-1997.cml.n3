doc:sec-447-ss-1 a cof:Section ;
    cof:title "447(1) Disconnection of customer equipment or customer cabling—" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a person (the first person):  (i) connects customer equipment, or customer cabling, to a telecommunications network or to a facility; or  (ii) has under his or her control customer equipment, or customer cabling, connected to a telecommunications network or to a facility; and  (b) the manager of the network or facility has an honest belief that the equipment or cabling is, or is likely to be, a threat to the integrity of a telecommunications network or a facility; the manager of the network or facility may:  (c) disconnect the equipment or cabling; and  (d) if it is necessary to disconnect other customer equipment or other customer cabling for the purposes of achieving the disconnection referred to in paragraph (c)—disconnect that other equipment or cabling." ;
    cof:pageNumber "367"^^xsd:integer .

concept:telecommunications-act-1997-sec-447-ss-2 a cml:Concept ;
    skos:prefLabel "447(2) Disconnection of customer equipment or customer cabling—"@en ;
    cml:realizedBy doc:sec-447-ss-2 ;
    values:originalText "(2) If:  (a) equipment or cabling is disconnected, or purportedly disconnected, under subsection (1); and  (b) the ACMA is satisfied that there were no reasonable grounds for the belief mentioned in paragraph (1)(b); the ACMA may, by written notice given to the manager of the network or facility, direct the manager to reconnect the equipment or cabling." ;
    skos:definition "(2) If:  (a) equipment or cabling is disconnected, or purportedly disconnected, under subsection (1); and  (b) the ACMA is satisfied that there were no reasonable grounds for the belief mentioned in paragraph (1)(b); the ACMA may, by written notice given to the manager of the network or facility, direct the manager to reconnect the equipment or cabling."@en ;
    cml:integrityHash "f2eab82c009f5bd9b62270859abc685c4f6d96618b2104ee141359dd58889cb6" ;
    values:partOf concept:telecommunications-act-1997-sec-447 ;
    cof:pageNumber "367"^^xsd:integer ;
    skos:note "Direct manager to reconnect equipment or cabling if ACMA believes no reasonable grounds for disconnection existed." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.367" ;
    cml:asserts concept:telecommunications-act-1997-sec-447-ss-2-norm .
