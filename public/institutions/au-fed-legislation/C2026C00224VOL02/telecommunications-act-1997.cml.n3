concept:telecommunications-act-1997-sec-426 a cml:Concept ;
    skos:prefLabel "426 Further information"@en ;
    cml:realizedBy doc:sec-426 ;
    values:originalText "(1) The ACMA may, within 7 days after an application is made, request the applicant to give the ACMA further information about the application.  (2) The ACMA may refuse to consider the application until the applicant gives the ACMA the information." ;
    skos:definition "(1) The ACMA may, within 7 days after an application is made, request the applicant to give the ACMA further information about the application.  (2) The ACMA may refuse to consider the application until the applicant gives the ACMA the information."@en ;
    cml:integrityHash "74d16a833451d5a12d8b1792b67d1039498f71ea6db325e58fe4cbe10d8eec40" ;
    cof:pageNumber "352"^^xsd:integer ;
