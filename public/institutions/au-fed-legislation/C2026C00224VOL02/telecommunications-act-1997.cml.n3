doc:sec-590-ss-2 a cof:Section ;
    cof:title "590(2) Arbitration—acquisition of property" ;
    values:kind "subsection" ;
    values:originalText "(2) The provision has no effect to the extent (if any) to which it purports to authorise the acquisition of property if that acquisition:  (a) is otherwise than on just terms; and  (b) would be invalid because of paragraph 51(xxxi) of the Constitution.   Miscellaneous  Part 35  Section 591  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    cof:pageNumber "638"^^xsd:integer .

