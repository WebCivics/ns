doc:sec-454d-ss-1 a cof:Section ;
    cof:title "454D(1) Revocation of determination" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may, by legislative instrument, revoke the determination of a person as the numbering scheme manager if:  (a) the Minister is not satisfied the person is managing the numbering scheme in accordance with the numbering scheme principles; or  (b) the Minister is satisfied it is in the best interests of one or more of the following:  (i) the telecommunications industry;  (ii) users of carriage services;  (iii) the general community; or  (c) the Minister is satisfied it is in the best interests of national security." ;
    cof:pageNumber "377"^^xsd:integer .

concept:telecommunications-act-1997-sec-454d-ss-2 a cml:Concept ;
    skos:prefLabel "454D(2) Revocation of determination"@en ;
    cml:realizedBy doc:sec-454d-ss-2 ;
    values:originalText "(2) Before the Minister revokes the determination of a person as the numbering scheme manager, the Minister must consult the person, the ACMA and the ACCC." ;
    skos:definition "(2) Before the Minister revokes the determination of a person as the numbering scheme manager, the Minister must consult the person, the ACMA and the ACCC."@en ;
    cml:integrityHash "57ee1cac87d0e524c849eca2008a92a7bee9d0c3b1410e7ad9dac7ee83bc8950" ;
    values:partOf concept:telecommunications-act-1997-sec-454d ;
    cof:pageNumber "377"^^xsd:integer ;
    skos:note "Consultation requirement before revoking determination" ;
    cml:curationStatus cml:Proposed ;
