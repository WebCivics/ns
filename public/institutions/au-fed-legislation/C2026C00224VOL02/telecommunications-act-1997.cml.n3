doc:sec-493-ss-2 a cof:Section ;
    cof:title "493(2) Confidential material not to be published" ;
    values:kind "subsection" ;
    values:originalText "(2) If:  (a) the hearing, or a part of the hearing, takes place in public; and  (b) the ACMA is of the opinion that:  (i) evidence or other material presented to the hearing; or  (ii) material in a written submission lodged with the ACMA;  is of a confidential nature; the ACMA may order that:  (c) the evidence or material not be published; or  (d) its disclosure be restricted." ;
    cof:pageNumber "424"^^xsd:integer .

