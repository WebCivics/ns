    cml:conclusionText "...the performance of any of the ACMA’s telecommunications functions; or (ii) the exercise of any of the ACMA’s telecommunications powers." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

