concept:telecommunications-act-1997-sec-360vd-ss-3 a cml:Concept ;
    skos:prefLabel "360VD(3) Damages for breach of a designated compensable standard"@en ;
    cml:realizedBy doc:sec-360vd-ss-3 ;
    values:originalText "(3) The amount of damages payable under subsection (1) or (2) for a particular contravention is ascertained in accordance with the compensation rules." ;
    skos:definition "(3) The amount of damages payable under subsection (1) or (2) for a particular contravention is ascertained in accordance with the compensation rules."@en ;
