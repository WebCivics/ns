doc:sec-500-ss-2 a cof:Section ;
    cof:title "500(2) Written submissions and protection from civil actions" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of subsection (1), the ACCC is taken not to have provided a reasonable opportunity to make submissions unless there was a period of at least 28 days during which the submissions could be made." ;
    cof:pageNumber "428"^^xsd:integer .

concept:telecommunications-act-1997-sec-500-ss-3 a cml:Concept ;
    skos:prefLabel "500(3) Written submissions and protection from civil actions"@en ;
    cml:realizedBy doc:sec-500-ss-3 ;
    values:originalText "(3) Civil proceedings do not lie against a person in respect of loss, damage or injury of any kind suffered by another person because of the making in good faith of a statement, or the giving in good faith of a document or information, to the ACCC in connection with a public inquiry under this Division." ;
    skos:definition "(3) Civil proceedings do not lie against a person in respect of loss, damage or injury of any kind suffered by another person because of the making in good faith of a statement, or the giving in good faith of a document or information, to the ACCC in connection with a public inquiry under this Division."@en ;
    cml:integrityHash "afc547e1b189c6d6886013d4cbbe79afa2c09154c42ba7a2d0270fc397039ce4" ;
    values:partOf concept:telecommunications-act-1997-sec-500 ;
    cof:pageNumber "428"^^xsd:integer ;
    skos:note "Protection from civil actions for making statements or giving documents in good faith to the ACCC." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.428" ;
    cml:asserts concept:telecommunications-act-1997-sec-500-ss-3-norm .
