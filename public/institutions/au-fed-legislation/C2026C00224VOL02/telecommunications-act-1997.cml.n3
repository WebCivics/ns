    values:partOf concept:telecommunications-act-1997-sec-529 ;
    cof:pageNumber "455"^^xsd:integer ;
    skos:note "Rules for preparing reports as and when required by ACMA or at specified intervals." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
