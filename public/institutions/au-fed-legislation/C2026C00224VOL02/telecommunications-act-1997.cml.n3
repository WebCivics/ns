doc:sec-360j-ss-4 a cof:Section ;
    cof:title "360J(4) Nominated service area—carrier licence conditions" ;
    values:kind "subsection" ;
    values:originalText "(4) The Minister may, by legislative instrument, declare that:  (a) a specified development area mentioned in subsection (1) is not a nominated service area for the purposes of this Part; and  (b) a specified area is a nominated service area for the purposes of this Part. Note 1: For variation and revocation, see subsection 33(3) of the Acts Interpretation Act 1901. Note 2: For the format of the description of the area, see section 360LA.   Statutory infrastructure providers  Part 19 Service areas and statutory infrastructure providers  Division 2  Section 360K  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    cof:pageNumber "212"^^xsd:integer .

concept:telecommunications-act-1997-sec-360j-ss-5 a cml:Concept ;
    skos:prefLabel "360J(5) Nominated service area—carrier licence conditions"@en ;
    cml:realizedBy doc:sec-360j-ss-5 ;
    values:originalText "(5) An area must not be specified in a declaration in accordance with paragraph (4)(b) unless at least one point in the area is also a point in the development area specified in the declaration in accordance with paragraph (4)(a)." ;
    skos:definition "(5) An area must not be specified in a declaration in accordance with paragraph (4)(b) unless at least one point in the area is also a point in the development area specified in the declaration in accordance with paragraph (4)(a)."@en ;
    cml:integrityHash "7859ef9d6f241d884c393f22058d44c84aac055f775d490a8d06a58d4204642c" ;
    values:partOf concept:telecommunications-act-1997-sec-360j ;
    cof:pageNumber "212"^^xsd:integer ;
    skos:note "Area cannot be specified in a declaration without at least one point also in the development area." ;
    cml:curationStatus cml:Proposed ;
