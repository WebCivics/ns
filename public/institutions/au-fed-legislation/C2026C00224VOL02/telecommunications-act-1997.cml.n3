concept:telecommunications-act-1997-sec-434 a cml:Concept ;
    skos:prefLabel "434 Offence in relation to contravening condition"@en ;
    cml:realizedBy doc:sec-434 ;
    values:originalText "(1) A person commits an offence if:  (a) the person is the holder of a cabling licence that authorises the performance of a particular type of cabling work; and" ;
