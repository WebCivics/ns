concept:telecommunications-act-1997-sec-577ad a cml:Concept ;
    skos:prefLabel "577AD Compliance with undertaking about structural separation"@en ;
    cml:realizedBy doc:sec-577ad ;
    values:originalText "If an undertaking is in force under section 577A and imposes obligations or prohibitions on a designated Telstra successor   Voluntary undertakings originally given by Telstra  Part 33 Structural separation  Division 2  Section 577B  Telecommunications Act 1997  Compilation date: 04/06/2026  company, the designated Telstra successor company must comply with the undertaking." ;
    skos:definition "If an undertaking is in force under section 577A and imposes obligations or prohibitions on a designated Telstra successor   Voluntary undertakings originally given by Telstra  Part 33 Structural separation  Division 2  Section 577B  Telecommunications Act 1997  Compilation date: 04/06/2026  company, the designated Telstra successor company must comply with the undertaking."@en ;
    cml:integrityHash "2a07d59e9086740c01a4aee19cd78755999bf404b6758fe6c9a7ccd8a5b958bf" ;
    cof:pageNumber "532"^^xsd:integer ;
    skos:note "Designated Telstra successor company must comply with the undertaking." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.532" ;
