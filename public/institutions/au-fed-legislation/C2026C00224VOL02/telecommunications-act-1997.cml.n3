doc:sec-409-ss-1 a cof:Section ;
    cof:title "409(1) Recognised testing authorities and competent bodies" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACMA may, by notice published in the Gazette, determine that a specified person or association is an accreditation body for the purposes of this section. The determination has effect accordingly." ;
    cof:pageNumber "338"^^xsd:integer .

