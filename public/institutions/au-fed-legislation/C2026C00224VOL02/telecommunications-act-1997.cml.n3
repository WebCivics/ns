concept:telecommunications-act-1997-sec-530 a cml:Concept ;
    skos:prefLabel "530 Compliance with record-keeping rules"@en ;
    cml:realizedBy doc:sec-530 ;
    values:originalText "A carrier or carriage service provider must comply with any record-keeping rules that are applicable to the carrier or provider." ;
