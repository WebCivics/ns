concept:telecommunications-act-1997-sec-372t a cml:Concept ;
    skos:prefLabel "372T Sale of building lots"@en ;
    cml:realizedBy doc:sec-372t ;
    values:originalText "For the purposes of this Act, a person sells a building lot if:  (a) in a case where the person holds a freehold interest in the land concerned—the person transfers the whole or a part of the freehold interest in the land; or  (b) in a case where the person holds a leasehold interest in the land concerned—the person transfers the whole or a part of the leasehold interest in the land." ;
    skos:definition "For the purposes of this Act, a person sells a building lot if:  (a) in a case where the person holds a freehold interest in the land concerned—the person transfers the whole or a part of the freehold interest in the land; or  (b) in a case where the person holds a leasehold interest in the land concerned—the person transfers the whole or a part of the leasehold interest in the land."@en ;
    cml:integrityHash "3210f7c1e2d9bf7eea1d1ce2679ca295bafbbb06c9ef5632798ca34f491e9c73" ;
    cof:pageNumber "303"^^xsd:integer ;
    skos:note "Definition of selling a building lot" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
