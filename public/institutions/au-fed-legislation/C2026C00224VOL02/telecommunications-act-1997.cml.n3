concept:telecommunications-act-1997-sec-372x a cml:Concept ;
    skos:prefLabel "372X Installation of a facility"@en ;
    cml:realizedBy doc:sec-372x ;
    values:originalText "For the purposes of this Part, install, in relation to a facility, includes:  (a) construct the facility on, over or under any land; and  (b) attach the facility to any building or other structure." ;
    skos:definition "For the purposes of this Part, install, in relation to a facility, includes:  (a) construct the facility on, over or under any land; and  (b) attach the facility to any building or other structure."@en ;
