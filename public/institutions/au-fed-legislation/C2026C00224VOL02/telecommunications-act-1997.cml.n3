concept:telecommunications-act-1997-sec-388 a cml:Concept ;
    skos:prefLabel "388 Provision of access"@en ;
    cml:realizedBy doc:sec-388 ;
    values:originalText "A reference in this Division to the provision of access is a reference to the provision of access to:  (a) service providers generally; or  (b) a particular class or classes of service providers; or  (c) a particular service provider or particular service providers; in order that the service provider or providers can provide carriage services and/or content services." ;
    skos:definition "A reference in this Division to the provision of access is a reference to the provision of access to:  (a) service providers generally; or  (b) a particular class or classes of service providers; or  (c) a particular service provider or particular service providers; in order that the service provider or providers can provide carriage services and/or content services."@en ;
    cml:integrityHash "04451bbc1204a49eaef4eff58f0bbd0e6c8ecfd89c7f6517fb840e4fed312044" ;
    cof:pageNumber "324"^^xsd:integer ;
    skos:note "Definition of provision of access" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.324" ;
    cml:asserts concept:telecommunications-act-1997-sec-388-norm .
