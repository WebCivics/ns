doc:sec-349-ss-5 a cof:Section ;
    cof:title "349(5) Requirement to provide pre-selection" ;
    values:kind "subsection" ;
    values:originalText "(5) A reference in this section to a standard telephone service does not include a reference to a service that is supplied by means of a public mobile telecommunications service." ;
    cof:pageNumber "168"^^xsd:integer .

concept:telecommunications-act-1997-sec-349-ss-5a a cml:Concept ;
    skos:prefLabel "349(5A) Requirement to provide pre-selection"@en ;
    cml:realizedBy doc:sec-349-ss-5a ;
    values:originalText "(5A) A reference in this section to a standard telephone service does not include a reference to a service that:  (a) is supplied using:  (i) a designated radiocommunications facility owned or operated by a carrier or carriage service provider; and  (ii) a line that runs directly between the facility and the premises occupied or used by an end-user; and  (b) if an instrument is in force under subsection (5B)—satisfies the conditions set out in the instrument." ;
    skos:definition "(5A) A reference in this section to a standard telephone service does not include a reference to a service that:  (a) is supplied using:  (i) a designated radiocommunications facility owned or operated by a carrier or carriage service provider; and  (ii) a line that runs directly between the facility and the premises occupied or used by an end-user; and  (b) if an instrument is in force under subsection (5B)—satisfies the conditions set out in the instrument."@en ;
    cml:integrityHash "b9b9da770e8c7029a2645cc0ed965b1d7a6d32ade275d80ddd859807c44c175f" ;
    values:partOf concept:telecommunications-act-1997-sec-349 ;
    cof:pageNumber "168"^^xsd:integer ;
    skos:note "Exclusion of certain standard telephone services from the definition." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
