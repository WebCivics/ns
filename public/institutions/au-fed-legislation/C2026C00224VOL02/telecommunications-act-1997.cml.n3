doc:sec-360la-ss-1 a cof:Section ;
    cof:title "360LA(1) Format of description of areas" ;
    values:kind "subsection" ;
    values:originalText "(1) An area declared under:  (c) subsection 360H(2); or  (d) subsection 360H(4); or  (e) subsection 360H(6); or  (f) subsection 360HB(2); or  (fa) subsection 360HB(6); or  (fb) subsection 360J(3); or  (fc) subsection 360J(4); or  (fd) subsection 360L(1); or  (fe) subsection 360L(2); must be described:  (g) using:  (i) if no coordinate system is determined under subsection (2A)—the GDA94 coordinate system; or   Statutory infrastructure providers  Part 19 Service areas and statutory infrastructure providers  Division 2  Section 360LA  Telecommunications Act 1997  Compilation date: 04/06/2026  (ii) if a coordinate system is determined under subsection (2A)—the coordinate system determined under subsection (2A); and  (h) if a format is determined under subsection (3)—in that format; and  (i) if no format is determined under subsection (3)—in a TAB vector format." ;
    cof:pageNumber "218"^^xsd:integer .

concept:telecommunications-act-1997-sec-360la-ss-2 a cml:Concept ;
    skos:prefLabel "360LA(2) Format of description of areas"@en ;
    cml:realizedBy doc:sec-360la-ss-2 ;
    values:originalText "(2) An area specified under:  (a) subsection 360HA(1); or  (b) subsection 360HA(2); or  (c) subsection 360HA(3); or  (d) subsection 360HA(4); or  (da) subsection 360HC(1); or  (db) subsection 360HC(2); must be described:  (e) using:  (i) if no coordinate system is determined under subsection (2A)—the GDA94 coordinate system; or  (ii) if a coordinate system is determined under subsection (2A)—the coordinate system determined under subsection (2A); and  (f) if a format is determined under subsection (3)—in that format; and  (g) if no format is determined under subsection (3)—in a TAB vector format." ;
    skos:definition "(2) An area specified under:  (a) subsection 360HA(1); or  (b) subsection 360HA(2); or  (c) subsection 360HA(3); or  (d) subsection 360HA(4); or  (da) subsection 360HC(1); or  (db) subsection 360HC(2); must be described:  (e) using:  (i) if no coordinate system is determined under subsection (2A)—the GDA94 coordinate system; or  (ii) if a coordinate system is determined under subsection (2A)—the coordinate system determined under subsection (2A); and  (f) if a format is determined under subsection (3)—in that format; and  (g) if no format is determined under subsection (3)—in a TAB vector format."@en ;
    cml:integrityHash "c656d3ad5812bdc7b6c3c1d6a2fefc2a9eac8a41ca8e16f0e3cf4c868ec89c0f" ;
    values:partOf concept:telecommunications-act-1997-sec-360la ;
