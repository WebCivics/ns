concept:telecommunications-act-1997-sec-581ta-ss-6 a cml:Concept ;
    skos:prefLabel "581TA(6) Facilitation of compliance with a direction given by the"@en ;
    cml:realizedBy doc:sec-581ta-ss-6 ;
    values:originalText "(6) Before giving or varying a direction under subsection (1), the ACMA must:  (a) make a copy of the draft direction or variation available on the ACMA’s website; and  (b) publish a notice on the ACMA’s website:  (i) stating that the ACMA has prepared the draft; and  (ii) inviting interested persons to give written comments about the draft to the ACMA within the period specified in the notice." ;
    skos:definition "(6) Before giving or varying a direction under subsection (1), the ACMA must:  (a) make a copy of the draft direction or variation available on the ACMA’s website; and  (b) publish a notice on the ACMA’s website:  (i) stating that the ACMA has prepared the draft; and  (ii) inviting interested persons to give written comments about the draft to the ACMA within the period specified in the notice."@en ;
    cml:integrityHash "21563c7d7bd84841346f0d8190f43868e482080c61de8ea8582b3f1c08255629" ;
    values:partOf concept:telecommunications-act-1997-sec-581ta ;
    cof:pageNumber "612"^^xsd:integer ;
