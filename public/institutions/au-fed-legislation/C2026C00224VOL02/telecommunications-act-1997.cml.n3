concept:telecommunications-act-1997-sec-494-ss-4 a cml:Concept ;
    skos:prefLabel "494(4) Direction about private hearings"@en ;
    cml:realizedBy doc:sec-494-ss-4 ;
    values:originalText "(4) A person commits an offence if:  (a) the ACMA has given a direction under paragraph (2)(a); and  (b) the person engages in conduct; and  (c) the person’s conduct contravenes the direction. Penalty: 10 penalty units." ;
    skos:definition "(4) A person commits an offence if:  (a) the ACMA has given a direction under paragraph (2)(a); and  (b) the person engages in conduct; and  (c) the person’s conduct contravenes the direction. Penalty: 10 penalty units."@en ;
    cml:integrityHash "c02cce8a947325d81e34fc3795dfa0a112875d3c8b92eb5994595f19cc32de0d" ;
    values:partOf concept:telecommunications-act-1997-sec-494 ;
    cof:pageNumber "425"^^xsd:integer ;
    skos:note "Engaging in conduct that contravenes a direction given by ACMA is an offence." ;
