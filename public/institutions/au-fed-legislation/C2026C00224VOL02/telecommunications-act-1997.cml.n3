concept:telecommunications-act-1997-sec-484j-ss-7 a cml:Concept ;
    skos:prefLabel "484J(7) Automation of administrative action"@en ;
    cml:realizedBy doc:sec-484j-ss-7 ;
    values:originalText "(7) The Chair of the ACMA may, in writing, delegate the Chair’s power under subsection (1) to a member of the ACMA staff who is an SES employee or acting SES employee." ;
    skos:definition "(7) The Chair of the ACMA may, in writing, delegate the Chair’s power under subsection (1) to a member of the ACMA staff who is an SES employee or acting SES employee."@en ;
