doc:sec-372jg a cof:Section ;
    cof:title "372JG Formal irregularities or defects in remedial notices" ;
    values:kind "section" ;
    values:originalText "A remedial notice is not invalid only because of:  (a) a formal defect or irregularity in the notice unless the defect or irregularity causes or is likely to cause substantial injustice; or  (b) a failure to use the correct name of the person to whom the notice is issued if the notice sufficiently identifies the person." ;
    cof:pageNumber "292"^^xsd:integer .

concept:telecommunications-act-1997-sec-372jh a cml:Concept ;
    skos:prefLabel "372JH Designated civil penalty provision"@en ;
    cml:realizedBy doc:sec-372jh ;
    values:originalText "For the purposes of this Subdivision, each of the following provisions is a designated civil penalty provision:  (a) subsection 372E(2);  (b) subsection 372F(2);  (c) subsection 372G(2);  (d) subsection 372G(2A);  (e) subsection 372G(3);  (f) subsection 372G(4);  (g) subsection 372G(4A);  (h) subsection 372G(5). Subdivision D—Exemptions" ;
    skos:definition "For the purposes of this Subdivision, each of the following provisions is a designated civil penalty provision:  (a) subsection 372E(2);  (b) subsection 372F(2);  (c) subsection 372G(2);  (d) subsection 372G(2A);  (e) subsection 372G(3);  (f) subsection 372G(4);  (g) subsection 372G(4A);  (h) subsection 372G(5). Subdivision D—Exemptions"@en ;
    cml:integrityHash "dc0db0cc1069689034d7d1d1efd7681e2d5951af9f4909dc101298d5c362fa3d" ;
    cof:pageNumber "292"^^xsd:integer ;
    skos:note "List of designated civil penalty provisions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.292" ;
