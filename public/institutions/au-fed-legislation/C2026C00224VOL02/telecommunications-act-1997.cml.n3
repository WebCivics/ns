doc:sec-441-ss-1a a cof:Section ;
    cof:title "441(1A) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(1A) If, under section 50 of the Australian Communications and Media Authority Act 2005, the ACMA has delegated a function or power referred to in subsection (1) to a Division of the ACMA, the following provisions have effect:  (a) the Division may delegate the function or power to a person;  (b) subsections 52(2), (3), (4), (5) and (6) of the Australian Communications and Media Authority Act 2005 have effect as if the delegation by the Division were a delegation under section 52 of that Act." ;
    cof:pageNumber "359"^^xsd:integer .

concept:telecommunications-act-1997-sec-441-ss-2 a cml:Concept ;
    skos:prefLabel "441(2) Delegation"@en ;
    cml:realizedBy doc:sec-441-ss-2 ;
    values:originalText "(2) Subsections (1) and (1A) do not apply to the following powers:  (a) the power to refuse an application for a cabling licence;  (b) the power conferred by subsection 432(3);  (c) the power to cancel or suspend a cabling licence;  (d) the power to make a declaration under section 439." ;
    skos:definition "(2) Subsections (1) and (1A) do not apply to the following powers:  (a) the power to refuse an application for a cabling licence;  (b) the power conferred by subsection 432(3);  (c) the power to cancel or suspend a cabling licence;  (d) the power to make a declaration under section 439."@en ;
    cml:integrityHash "1587941b77b9b363b6fef6b5a3dad0c2dfe26e54d2784026cfa88d715693bc54" ;
    values:partOf concept:telecommunications-act-1997-sec-441 ;
    cof:pageNumber "359"^^xsd:integer ;
    skos:note "Exemptions from subsections (1) and (1A)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
