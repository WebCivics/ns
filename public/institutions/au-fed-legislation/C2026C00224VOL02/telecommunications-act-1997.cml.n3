concept:telecommunications-act-1997-sec-454b a cml:Concept ;
    skos:prefLabel "454B No property rights in numbers"@en ;
    cml:realizedBy doc:sec-454b ;
    values:originalText "Determination of a person as the numbering scheme manager does not confer any property rights in numbers used in connection with the supply of carriage services in Australia." ;
    skos:definition "Determination of a person as the numbering scheme manager does not confer any property rights in numbers used in connection with the supply of carriage services in Australia."@en ;
    cml:integrityHash "e931731fb183b81cf65f9dc60cd6c0e1528c3a32215af2d9f2de6335783e3893" ;
    cof:pageNumber "375"^^xsd:integer ;
    skos:note "No property rights in numbers for carriage services supply" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.375" ;
