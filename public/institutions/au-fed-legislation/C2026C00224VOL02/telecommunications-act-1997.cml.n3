doc:sec-494-ss-1 a cof:Section ;
    cof:title "494(1) Direction about private hearings" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies to a hearing conducted under this Division." ;
    cof:pageNumber "425"^^xsd:integer .

concept:telecommunications-act-1997-sec-494-ss-2 a cml:Concept ;
    skos:prefLabel "494(2) Direction about private hearings"@en ;
    cml:realizedBy doc:sec-494-ss-2 ;
    values:originalText "(2) If the hearing, or a part of the hearing, takes place in private, the ACMA:  (a) must give directions as to the persons who may be present at the hearing or the part of the hearing; and  (b) may give directions restricting the disclosure of evidence or other material presented at the hearing or the part of the hearing." ;
    skos:definition "(2) If the hearing, or a part of the hearing, takes place in private, the ACMA:  (a) must give directions as to the persons who may be present at the hearing or the part of the hearing; and  (b) may give directions restricting the disclosure of evidence or other material presented at the hearing or the part of the hearing."@en ;
    cml:integrityHash "f141438fb586ae9e4addb6b392e8eca53f3a8edb594cde21f8bbfaad3656121e" ;
    values:partOf concept:telecommunications-act-1997-sec-494 ;
    cof:pageNumber "425"^^xsd:integer ;
    skos:note "Must give directions about persons present at private hearing and restrict disclosure of evidence." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
