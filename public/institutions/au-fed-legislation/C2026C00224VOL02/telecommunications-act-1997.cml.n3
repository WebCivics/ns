concept:telecommunications-act-1997-sec-372jf a cml:Concept ;
    skos:prefLabel "372JF Revocation of remedial notices"@en ;
    cml:realizedBy doc:sec-372jf ;
    values:originalText "(1) If:  (a) a person has been given a remedial notice; and  (b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required for the purposes of requiring the person to:  (i) remedy a contravention of a designated civil penalty provision; or  (ii) prevent a likely contravention of a designated civil penalty provision from occurring; or  (iii) remedy the things or operations causing a contravention, or likely contravention, of a designated civil penalty provision; the ACMA must, by written notice given to the person, revoke the notice.  (2) In this section, compliance period means the period stated in the remedial notice under section 372JB, and includes that period as extended under section 372JD." ;
    skos:definition "(1) If:  (a) a person has been given a remedial notice; and  (b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required for the purposes of requiring the person to:  (i) remedy a contravention of a designated civil penalty provision; or  (ii) prevent a likely contravention of a designated civil penalty provision from occurring; or  (iii) remedy the things or operations causing a contravention, or likely contravention, of a designated civil penalty provision; the ACMA must, by written notice given to the person, revoke the notice.  (2) In this section, compliance period means the period stated in the remedial notice under section 372JB, and includes that period as extended under section 372JD."@en ;
    cml:integrityHash "ec06498fa2d29584c8aaabea082c3dca9514ecb64398e8fc9a8e45db1ffb07b3" ;
    cof:pageNumber "291"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-372jf-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-372jf-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.291" .
