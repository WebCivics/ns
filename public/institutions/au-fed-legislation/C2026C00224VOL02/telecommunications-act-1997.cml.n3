concept:telecommunications-act-1997-sec-477 a cml:Concept ;
    skos:prefLabel "477 ACCC’s directions to prevail over the ACMA’s directions"@en ;
    cml:realizedBy doc:sec-477 ;
    values:originalText "A direction given by the ACMA under section 475 has no effect to the extent to which it is inconsistent with a direction given by the ACCC under section 476.   Standard agreements for the supply of carriage services  Part 23  Section 478  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "A direction given by the ACMA under section 475 has no effect to the extent to which it is inconsistent with a direction given by the ACCC under section 476.   Standard agreements for the supply of carriage services  Part 23  Section 478  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "e0c5adc5f5b79cb069d94e9501e9d12ea02cf06fd834201a2e2c01ff7ae66807" ;
    cof:pageNumber "400"^^xsd:integer ;
    skos:note "ACMA's directions are overridden by ACCC's directions to the same extent they are inconsistent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.400" ;
    cml:asserts concept:telecommunications-act-1997-sec-477-norm .
