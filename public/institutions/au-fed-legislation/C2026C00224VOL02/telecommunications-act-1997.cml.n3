doc:sec-525 a cof:Section ;
    cof:title "525 Giving false or misleading information or evidence" ;
    values:kind "section" ;
    values:originalText "A person must not, under section 521 or 522, give information or evidence that is false or misleading. Penalty: Imprisonment for 12 months. Note: See also sections 4AA and 4B of the Crimes Act 1914." ;
    cof:pageNumber "453"^^xsd:integer .

concept:telecommunications-act-1997-sec-527 a cml:Concept ;
    skos:prefLabel "527 Copies of documents"@en ;
    cml:realizedBy doc:sec-527 ;
    values:originalText "(1) The ACMA may inspect a document or copy produced under this Division and may make and retain copies of, or take and retain extracts from, such a document.  (2) The ACMA may retain possession of a copy of a document produced in accordance with a requirement covered by paragraph 521(2)(c) or 522(2)(c)." ;
    skos:definition "(1) The ACMA may inspect a document or copy produced under this Division and may make and retain copies of, or take and retain extracts from, such a document.  (2) The ACMA may retain possession of a copy of a document produced in accordance with a requirement covered by paragraph 521(2)(c) or 522(2)(c)."@en ;
