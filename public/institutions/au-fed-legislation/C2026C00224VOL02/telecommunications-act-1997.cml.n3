concept:telecommunications-act-1997-sec-400 a cml:Concept ;
    skos:prefLabel "400 Formal warnings—breach of condition"@en ;
    cml:realizedBy doc:sec-400 ;
    values:originalText "The ACMA may issue a formal warning to the holder of a connection permit if the holder, or a nominee of the holder, contravenes a condition to which the permit is subject." ;
    skos:definition "The ACMA may issue a formal warning to the holder of a connection permit if the holder, or a nominee of the holder, contravenes a condition to which the permit is subject."@en ;
