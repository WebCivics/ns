concept:telecommunications-act-1997-sec-581zc a cml:Concept ;
    skos:prefLabel "581ZC Extended meaning of access"@en ;
    cml:realizedBy doc:sec-581zc ;
    values:originalText "For the purposes of this Division, giving access to a tower includes replacing the tower with another tower located on the same site and giving access to the replacement tower." ;
    skos:definition "For the purposes of this Division, giving access to a tower includes replacing the tower with another tower located on the same site and giving access to the replacement tower."@en ;
