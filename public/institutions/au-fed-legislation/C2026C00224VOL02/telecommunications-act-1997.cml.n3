concept:telecommunications-act-1997-sec-360vc a cml:Concept ;
    skos:prefLabel "360VC Meaning of certain expressions"@en ;
    cml:realizedBy doc:sec-360vc ;
    values:originalText "In determining the meaning that the expressions customer and damages have when used in:  (a) a provision of this Act other than this Division; or  (b) a provision of the Telecommunications (Consumer Protection and Service Standards) Act 1999; section 360VB is to be disregarded. Subdivision B—Damages for breach of standards or rules by statutory infrastructure providers" ;
    skos:definition "In determining the meaning that the expressions customer and damages have when used in:  (a) a provision of this Act other than this Division; or  (b) a provision of the Telecommunications (Consumer Protection and Service Standards) Act 1999; section 360VB is to be disregarded. Subdivision B—Damages for breach of standards or rules by statutory infrastructure providers"@en ;
    cml:integrityHash "3969fa54e0bd13a65da7de6182b980c8ebf1790c886e5272d6dbbc05271bacb1" ;
    cof:pageNumber "246"^^xsd:integer ;
