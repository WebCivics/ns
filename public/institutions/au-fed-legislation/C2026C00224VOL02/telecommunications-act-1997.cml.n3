doc:sec-360vd-ss-1 a cof:Section ;
    cof:title "360VD(1) Damages for breach of a designated compensable standard" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a statutory infrastructure provider contravenes a designated compensable standard; and  (b) the standard is determined under subsection 360U(1); and  (c) the contravention relates to a particular customer; the statutory infrastructure provider is liable to pay damages to the customer for the contravention." ;
    cof:pageNumber "246"^^xsd:integer .

concept:telecommunications-act-1997-sec-360vd-ss-2 a cml:Concept ;
    skos:prefLabel "360VD(2) Damages for breach of a designated compensable standard"@en ;
    cml:realizedBy doc:sec-360vd-ss-2 ;
    values:originalText "(2) If:  (a) a statutory infrastructure provider contravenes a designated compensable rule; and  (b) the rule is made under subsection 360V(1); and  (c) the contravention relates to a particular customer; the statutory infrastructure provider is liable to pay damages to the customer for the contravention." ;
    skos:definition "(2) If:  (a) a statutory infrastructure provider contravenes a designated compensable rule; and  (b) the rule is made under subsection 360V(1); and  (c) the contravention relates to a particular customer; the statutory infrastructure provider is liable to pay damages to the customer for the contravention."@en ;
    cml:integrityHash "412449a9d72d9d637fd86590bad28487a266f7a4ae5f62185cfc5f8cb1316526" ;
    values:partOf concept:telecommunications-act-1997-sec-360vd ;
