concept:telecommunications-act-1997-sec-423 a cml:Concept ;
    skos:prefLabel "423 Application for cabling licence"@en ;
    cml:realizedBy doc:sec-423 ;
    values:originalText "An individual may apply to the ACMA for a cabling licence that authorises the performance of a particular type of cabling work." ;
