concept:telecommunications-act-1997-sec-406a a cml:Concept ;
    skos:prefLabel "406A Application of Division to agent of manufacturer or importer"@en ;
    cml:realizedBy doc:sec-406a ;
    values:originalText "For the purposes of this Act and to avoid doubt, a reference in this Division to a manufacturer or importer of customer equipment or customer cabling includes a reference to a person who is authorised in writing by such a manufacturer or importer to act in Australia as an agent of the manufacturer or importer (as the case may be) for the purposes of this Division." ;
    skos:definition "For the purposes of this Act and to avoid doubt, a reference in this Division to a manufacturer or importer of customer equipment or customer cabling includes a reference to a person who is authorised in writing by such a manufacturer or importer to act in Australia as an agent of the manufacturer or importer (as the case may be) for the purposes of this Division."@en ;
    cml:integrityHash "76a4dc178e8515132dfebee367f5557a7c822e0cdf51f99a88a28fc23370e892" ;
    cof:pageNumber "335"^^xsd:integer ;
    skos:note "A person authorized in writing by a manufacturer or importer to act as an agent for the purposes of this Division." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.335" ;
