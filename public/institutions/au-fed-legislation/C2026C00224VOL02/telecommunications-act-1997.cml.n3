concept:telecommunications-act-1997-sec-547a-ss-4 a cml:Concept ;
    skos:prefLabel "547A(4) Powers available to inspectors for monitoring compliance"@en ;
    cml:realizedBy doc:sec-547a-ss-4 ;
    values:originalText "(4) An entry of an inspector by virtue of the consent of a person is not lawful unless the person voluntarily consented to the entry." ;
