doc:sec-360za-ss-4 a cof:Section ;
    cof:title "360ZA(4) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(4) If the ACMA delegates to a person (the second delegate) a power that has been delegated by the Minister to the ACMA under subsection (1), then that power, when exercised by the second delegate, is taken for the purposes of this Act to have been exercised by the Minister." ;
    cof:pageNumber "262"^^xsd:integer .

concept:telecommunications-act-1997-sec-360za-ss-5 a cml:Concept ;
    skos:prefLabel "360ZA(5) Delegation"@en ;
    cml:realizedBy doc:sec-360za-ss-5 ;
    values:originalText "(5) If the ACMA is subject to directions in relation to the exercise of a power delegated by the Minister to the ACMA under subsection (1), then:  (a) the ACMA must give corresponding written directions to the second delegate; and  (b) the ACMA may give other written directions (not inconsistent with those corresponding directions) to the second delegate in relation to the exercise of that power." ;
    skos:definition "(5) If the ACMA is subject to directions in relation to the exercise of a power delegated by the Minister to the ACMA under subsection (1), then:  (a) the ACMA must give corresponding written directions to the second delegate; and  (b) the ACMA may give other written directions (not inconsistent with those corresponding directions) to the second delegate in relation to the exercise of that power."@en ;
    cml:integrityHash "56b5f04d3579c38ac20d4360db95118b4bdb84017ae0a9c4919c460fbd5013c6" ;
    values:partOf concept:telecommunications-act-1997-sec-360za ;
    cof:pageNumber "262"^^xsd:integer ;
    skos:note "ACMA must give written directions to second delegate." ;
    cml:curationStatus cml:Proposed ;
