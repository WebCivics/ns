concept:telecommunications-act-1997-sec-417-ss-4 a cml:Concept ;
    skos:prefLabel "417(4) Protected symbols"@en ;
    cml:realizedBy doc:sec-417-ss-4 ;
    values:originalText "(4) Nothing in subsection (1), so far as it applies in relation to a protected symbol, affects rights conferred by law on a person in relation to:  (a) a trade mark that is registered under the Trade Marks Act 1995; or  (b) a design that is registered under the Designs Act 2003; and was registered under the Trade Marks Act 1995 or the Designs Act 1906 immediately before 16 August 1996 in relation to the symbol." ;
    skos:definition "(4) Nothing in subsection (1), so far as it applies in relation to a protected symbol, affects rights conferred by law on a person in relation to:  (a) a trade mark that is registered under the Trade Marks Act 1995; or  (b) a design that is registered under the Designs Act 2003; and was registered under the Trade Marks Act 1995 or the Designs Act 1906 immediately before 16 August 1996 in relation to the symbol."@en ;
    cml:integrityHash "95a8b3fc21fe818bee25a80ecf5f4e8d619e833310edaac21dd9761757d0a6a7" ;
    values:partOf concept:telecommunications-act-1997-sec-417 ;
    cof:pageNumber "345"^^xsd:integer ;
    skos:note "No effect on trade mark or design rights" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.345" ;
