    skos:prefLabel "317ZT Alternative constitutional basis"@en ;
    cml:realizedBy doc:sec-317zt ;
    values:originalText "(1) Without limiting its effect apart from this section, this Part also has effect as provided by this section.  (2) This Part also has the effect it would have if each reference in this Part to a designated communications provider were, by express provision, confined to a designated communications provider that is a constitutional corporation.   Defence requirements and disaster plans  Part 16 Introduction  Division 1  Section 333  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "(1) Without limiting its effect apart from this section, this Part also has effect as provided by this section.  (2) This Part also has the effect it would have if each reference in this Part to a designated communications provider were, by express provision, confined to a designated communications provider that is a constitutional corporation.   Defence requirements and disaster plans  Part 16 Introduction  Division 1  Section 333  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "a876360bbb8efe31df78f4401027cb305cbf4b73e3c1554d7a5c7bbfbf488d67" ;
    cof:pageNumber "156"^^xsd:integer ;
