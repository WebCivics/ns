    cof:pageNumber "324"^^xsd:integer .

concept:telecommunications-act-1997-sec-389 a cml:Concept ;
    skos:prefLabel "389 Promotion of the long-term interests of end-users of carriage"@en ;
    cml:realizedBy doc:sec-389 ;
    values:originalText "services and of services supplied by means of carriage services  For the purposes of this Division, the question whether a particular thing promotes the long-term interests of end-users of carriage services or of services supplied by means of carriage services is to be determined in the same manner as it is determined for the purposes of Part XIC of the Competition and Consumer Act 2010.   Technical regulation  Part 21 Technical standards relating to Layer 2 bitstream services  Division 5A  Section 389A  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "services and of services supplied by means of carriage services  For the purposes of this Division, the question whether a particular thing promotes the long-term interests of end-users of carriage services or of services supplied by means of carriage services is to be determined in the same manner as it is determined for the purposes of Part XIC of the Competition and Consumer Act 2010.   Technical regulation  Part 21 Technical standards relating to Layer 2 bitstream services  Division 5A  Section 389A  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "009599a6088c9030d6fb721c0d246adf36e7a9d6f1e0a08496eaba05cb8c196d" ;
    cof:pageNumber "324"^^xsd:integer ;
    skos:note "Promotes long-term interests of end-users of carriage services" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.324" ;
