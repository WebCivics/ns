doc:sec-581n-ss-1 a cof:Section ;
    cof:title "581N(1) Telecommunications asset" ;
    values:kind "subsection" ;
    values:originalText "(1) For the purposes of this Part, telecommunications asset means:  (a) a telecommunications network used, or to be used, to supply a listed carriage service; or  (b) a facility used, or to be used, to supply a listed carriage service; or  (c) an asset covered by a declaration under subsection (2); but does not include an asset that is covered by a declaration under subsection (3)." ;
    cof:pageNumber "607"^^xsd:integer .

concept:telecommunications-act-1997-sec-581n-ss-2 a cml:Concept ;
    skos:prefLabel "581N(2) Telecommunications asset"@en ;
    cml:realizedBy doc:sec-581n-ss-2 ;
    values:originalText "(2) The Minister may, by legislative instrument, declare that a specified asset is a telecommunications asset for the purposes of this Part. Note: For specification by class, see subsection 13(3) of the Legislation Act 2003." ;
    skos:definition "(2) The Minister may, by legislative instrument, declare that a specified asset is a telecommunications asset for the purposes of this Part. Note: For specification by class, see subsection 13(3) of the Legislation Act 2003."@en ;
