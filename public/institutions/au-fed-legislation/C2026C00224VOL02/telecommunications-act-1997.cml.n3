doc:sec-317la-ss-3 a cof:Section ;
    cof:title "317LA(3) Approval of technical assistance notices given by the chief" ;
    values:kind "subsection" ;
    values:originalText "(3) If an approval under paragraph (1)(b) is given orally, the AFP Commissioner must:  (a) make a written record of the approval; and  (b) do so within 48 hours after the approval was given." ;
    cof:pageNumber "74"^^xsd:integer .

