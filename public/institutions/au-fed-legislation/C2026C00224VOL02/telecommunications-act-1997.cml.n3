doc:sec-581w-ss-2 a cof:Section ;
    cof:title "581W(2) Carrier company group" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of this section, the question of whether bodies corporate are related to each other is to be determined in accordance with section 50 of the Corporations Act 2001." ;
    cof:pageNumber "617"^^xsd:integer .

concept:telecommunications-act-1997-sec-581w-ss-3 a cml:Concept ;
    skos:prefLabel "581W(3) Carrier company group"@en ;
    cml:realizedBy doc:sec-581w-ss-3 ;
    values:originalText "(3) The Minister may, by legislative instrument, determine that, for the purposes of this section, each reference in section 46 of the Corporations Act 2001 to one-half is taken to be a reference to the percentage specified in the determination." ;
