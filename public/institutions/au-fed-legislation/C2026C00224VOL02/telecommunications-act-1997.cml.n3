doc:sec-572h-ss-4 a cof:Section ;
    cof:title "572H(4) Withdrawal of an infringement notice" ;
    values:kind "subsection" ;
    values:originalText "(4) If:  (a) the penalty specified in the infringement notice is paid; and  (b) the infringement notice is withdrawn after the penalty is paid; the Commonwealth is liable to refund the penalty." ;
    cof:pageNumber "510"^^xsd:integer .

concept:telecommunications-act-1997-sec-572j a cml:Concept ;
    skos:prefLabel "572J What happens if the penalty is paid"@en ;
    cml:realizedBy doc:sec-572j ;
    values:originalText "Scope  (1) This section applies if:  (a) an infringement notice relating to an alleged contravention is given to a person; and  (b) the penalty is paid in accordance with the infringement notice; and  (c) the infringement notice is not withdrawn. What happens  (2) Any liability of the person for the alleged contravention is discharged.  (3) Proceedings under Part 31 may not be brought against the person for the alleged contravention." ;
    skos:definition "Scope  (1) This section applies if:  (a) an infringement notice relating to an alleged contravention is given to a person; and  (b) the penalty is paid in accordance with the infringement notice; and  (c) the infringement notice is not withdrawn. What happens  (2) Any liability of the person for the alleged contravention is discharged.  (3) Proceedings under Part 31 may not be brought against the person for the alleged contravention."@en ;
    cml:integrityHash "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000" ;
    cof:pageNumber "511"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sec-572j-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sec-572j-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sec-572j-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
