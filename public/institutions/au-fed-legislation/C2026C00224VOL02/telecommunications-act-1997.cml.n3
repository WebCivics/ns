    values:partOf concept:telecommunications-act-1997-sec-343 ;
    cof:pageNumber "163"^^xsd:integer ;
    skos:note "ACMA must certify variation if it would certify as draft agreement" ;
    cml:curationStatus cml:Proposed ;
