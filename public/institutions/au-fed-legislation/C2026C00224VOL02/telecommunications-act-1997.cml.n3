concept:telecommunications-act-1997-sec-360vh a cml:Concept ;
    skos:prefLabel "360VH Compensation rules"@en ;
    cml:realizedBy doc:sec-360vh ;
    values:originalText "The Minister may, by legislative instrument, make rules (compensation rules) prescribing matters required or permitted by this Division to be prescribed by the compensation rules. Note: For variation and revocation, see subsection 33(3) of the Acts Interpretation Act 1901." ;
