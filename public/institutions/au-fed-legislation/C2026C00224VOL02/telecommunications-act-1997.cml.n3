doc:sec-360vd-ss-7 a cof:Section ;
    cof:title "360VD(7) Damages for breach of a designated compensable standard" ;
    values:kind "subsection" ;
    values:originalText "(7) An action under this section must be instituted within 2 years after:  (a) in the case of a contravention that continued throughout a period—the time when the contravention began; or  (b) in any other case—the time when the contravention occurred." ;
    cof:pageNumber "246"^^xsd:integer .

concept:telecommunications-act-1997-sec-360vd-ss-8 a cml:Concept ;
    skos:prefLabel "360VD(8) Damages for breach of a designated compensable standard"@en ;
    cml:realizedBy doc:sec-360vd-ss-8 ;
    values:originalText "(8) If the customer is an individual and the customer dies, a reference in this section to the customer includes a reference to the legal personal representative of the customer." ;
