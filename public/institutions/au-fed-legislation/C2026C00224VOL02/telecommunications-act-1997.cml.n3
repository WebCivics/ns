doc:sec-462-ss-1 a cof:Section ;
    cof:title "462(1) Compliance with the numbering plan" ;
    values:kind "subsection" ;
    values:originalText "(1) A person who is a carrier or a carriage service provider must comply with the numbering plan." ;
    cof:pageNumber "386"^^xsd:integer .

concept:telecommunications-act-1997-sec-462-ss-2 a cml:Concept ;
    skos:prefLabel "462(2) Compliance with the numbering plan"@en ;
    cml:realizedBy doc:sec-462-ss-2 ;
    values:originalText "(2) If:  (a) a person (the first person) is a carrier or a carriage service provider; and  (b) the plan requires the first person to provide number portability in relation to customers of a carriage service provider; the first person must comply with that requirement on such terms and conditions as are:  (c) agreed between the following parties:  (i) the first person;  (ii) the carriage service provider; or  (d) failing agreement, determined by an arbitrator appointed by the parties. If the parties fail to agree on the appointment of an arbitrator, the ACCC is to be the arbitrator." ;
    skos:definition "(2) If:  (a) a person (the first person) is a carrier or a carriage service provider; and  (b) the plan requires the first person to provide number portability in relation to customers of a carriage service provider; the first person must comply with that requirement on such terms and conditions as are:  (c) agreed between the following parties:  (i) the first person;  (ii) the carriage service provider; or  (d) failing agreement, determined by an arbitrator appointed by the parties. If the parties fail to agree on the appointment of an arbitrator, the ACCC is to be the arbitrator."@en ;
    cml:integrityHash "eb877443dc0651578e0ce0add78c8eca6a1760cb355b4555a51602d398df1ac1" ;
    values:partOf concept:telecommunications-act-1997-sec-462 ;
    cof:pageNumber "386"^^xsd:integer ;
    skos:note "Compliance with numbering plan requirements" ;
    dc:description "number portability in relation to customers of a carriage service provider" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
