concept:telecommunications-act-1997-sec-334 a cml:Concept ;
    skos:prefLabel "334 Defence authority"@en ;
    cml:realizedBy doc:sec-334 ;
    values:originalText "For the purposes of this Part, a defence authority is:  (a) the Secretary of the Defence Department; or  (b) the Chief of the Defence Force." ;
    skos:definition "For the purposes of this Part, a defence authority is:  (a) the Secretary of the Defence Department; or  (b) the Chief of the Defence Force."@en ;
