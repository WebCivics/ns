concept:telecommunications-act-1997-sec-317ta a cml:Concept ;
    skos:prefLabel "317TA Duration of technical capability notice"@en ;
    cml:realizedBy doc:sec-317ta ;
    values:originalText "(1) A technical capability notice:  (a) comes in force:  (i) when it is given; or  (ii) if a later time is specified in the notice—at that later time; and  (b) unless sooner revoked, remains in force:" ;
    skos:definition "(1) A technical capability notice:  (a) comes in force:  (i) when it is given; or  (ii) if a later time is specified in the notice—at that later time; and  (b) unless sooner revoked, remains in force:"@en ;
