concept:telecommunications-act-1997-sec-485 a cml:Concept ;
    skos:prefLabel "485 Simplified outline"@en ;
    cml:realizedBy doc:sec-485 ;
    values:originalText "The following is a simplified outline of this Part: • The ACMA and the ACCC may hold public inquiries about certain matters relating to telecommunications." ;
