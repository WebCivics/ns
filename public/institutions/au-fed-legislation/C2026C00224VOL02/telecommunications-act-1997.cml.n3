    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "The period of service must be between 5 years and the current time." ;
    cml:premiseText "(a) has served as a judge in one or more prescribed courts for a period of 5 years; and (b) no longer holds a commission as a judge of a prescribed court." ;
