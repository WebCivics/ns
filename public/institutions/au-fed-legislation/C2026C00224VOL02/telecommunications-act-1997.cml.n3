    cml:logicSummary "Temporal overlap between direction and conduct" ;
    cml:premiseText "(b) the person engages in conduct;" ;
    cml:conclusionText "...and the person’s conduct contravenes the direction." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-476-ss-7 a cof:Section ;
    cof:title "476(7) ACCC may give directions to declared manager of electronic" ;
    values:kind "subsection" ;
    values:originalText "(7) A person commits an offence if:  (a) the person has been given a direction under this section; and  (b) the person engages in conduct; and  (c) the person’s conduct contravenes the direction. Penalty: 10 penalty units." ;
    cof:pageNumber "398"^^xsd:integer .

