    {
      "@id": "concept:telecommunications-act-1997-sec-550",
      "@type": "cml:Concept",
      "skos:prefLabel": "550 Retention of documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-550"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.483",
      "values:originalText": "If:\n\n(a) an inspector removes a document from any land, premises,\nvessel, aircraft or vehicle under section 542, 547 or 547B; or\n\n(b) a person produces a document to an inspector in accordance\nwith a requirement under subsection 549(1) or (1A);\nthen:\n\n(c) the inspector may retain possession of the document for such\nperiod as is necessary and reasonable for the purpose of\nascertaining whether the Spam Act 2003 or Part 21 of this\nAct has been complied with; and\n\n(d) during that period, the inspector must permit a person who\nwould be entitled to inspect the document if it were not in the\ninspector’s possession to inspect the document at all\nreasonable times.",
      "skos:definition": "If:\n\n(a) an inspector removes a document from any land, premises,\nvessel, aircraft or vehicle under section 542, 547 or 547B; or\n\n(b) a person produces a document to an inspector in accordance\nwith a requirement under subsection 549(1) or (1A);\nthen:\n\n(c) the inspector may retain possession of the document for such\nperiod as is necessary and reasonable for the purpose of\nascertaining whether the Spam Act 2003 or Part 21 of this\nAct has been complied with; and\n\n(d) during that period, the inspector must permit a person who\nwould be entitled to inspect the document if it were not in the\ninspector’s possession to inspect the document at all\nreasonable times.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-550-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-550-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e881b19a9b31d4a6e89987d71ef28b11cdf58b9612915f5205fd44e2fa902740",
      "skos:note": "Inspector may retain possession of document for a reasonable period."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-550",
      "@type": "cof:Section",
      "cof:title": "550 Retention of documents",
      "values:kind": "section",
      "cof:pageNumber": 483,
      "values:originalText": "If:\n\n(a) an inspector removes a document from any land, premises,\nvessel, aircraft or vehicle under section 542, 547 or 547B; or\n\n(b) a person produces a document to an inspector in accordance\nwith a requirement under subsection 549(1) or (1A);\nthen:\n\n(c) the inspector may retain possession of the document for such\nperiod as is necessary and reasonable for the purpose of\nascertaining whether the Spam Act 2003 or Part 21 of this\nAct has been complied with; and\n\n(d) during that period, the inspector must permit a person who\nwould be entitled to inspect the document if it were not in the\ninspector’s possession to inspect the document at all\nreasonable times."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-550-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-550"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-550-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "retain",
      "cml:logicSummary": "Obligation to retain possession",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-551",
      "@type": "cml:Concept",
      "skos:prefLabel": "551 Court may order forfeiture",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-551"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.484",
      "values:originalText": "(1) If a court convicts a person of an offence against this Act, the court\nmay order the forfeiture to the Commonwealth of anything used or\notherwise involved in the commission of the offence.\n\n(2) A reference in this section to an offence against this Act includes a\nreference to an offence created by section 6 of the Crimes Act 1914\nor Part 2.4 of the Criminal Code that relates to this Act.\n\n(3) In this section:\nthis Act includes the Telecommunications (Consumer Protection\nand Service Standards) Act 1999 and regulations under that Act.",
      "skos:definition": "(1) If a court convicts a person of an offence against this Act, the court\nmay order the forfeiture to the Commonwealth of anything used or\notherwise involved in the commission of the offence.\n\n(2) A reference in this section to an offence against this Act includes a\nreference to an offence created by section 6 of the Crimes Act 1914\nor Part 2.4 of the Criminal Code that relates to this Act.\n\n(3) In this section:\nthis Act includes the Telecommunications (Consumer Protection\nand Service Standards) Act 1999 and regulations under that Act.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-551-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-551-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-551-ss-3"
        }
      ],
      "cml:integrityHash": "a14af26cab2dd7d80516526465515a33a3b40d61b1e556097394b03d19714fb1"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-551",
      "@type": "cof:Section",
      "cof:title": "551 Court may order forfeiture",
      "values:kind": "section",
      "cof:pageNumber": 484,
      "values:originalText": "(1) If a court convicts a person of an offence against this Act, the court\nmay order the forfeiture to the Commonwealth of anything used or\notherwise involved in the commission of the offence.\n\n(2) A reference in this section to an offence against this Act includes a\nreference to an offence created by section 6 of the Crimes Act 1914\nor Part 2.4 of the Criminal Code that relates to this Act.\n\n(3) In this section:\nthis Act includes the Telecommunications (Consumer Protection\nand Service Standards) Act 1999 and regulations under that Act."
    },
