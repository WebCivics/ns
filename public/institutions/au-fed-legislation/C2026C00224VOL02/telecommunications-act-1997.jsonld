    },
    {
      "@id": "concept:telecommunications-act-1997-sec-507",
      "@type": "cml:Concept",
      "skos:prefLabel": "507 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-507"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.435",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe ACMA may investigate certain matters relating to\ntelecommunications.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nThe ACMA may investigate certain matters relating to\ntelecommunications.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-507-norm"
        }
      ],
      "cml:integrityHash": "fb70e4a33f4920df752d0cbf5706abd565fed022c03094d6e2f2625ae17af445",
      "skos:note": "ACMA may investigate certain matters relating to telecommunications."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-507",
      "@type": "cof:Section",
      "cof:title": "507 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 435,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe ACMA may investigate certain matters relating to\ntelecommunications."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-507-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
