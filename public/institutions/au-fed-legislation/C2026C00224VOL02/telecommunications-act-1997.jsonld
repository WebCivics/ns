      "dc:source": "telecommunications-act-1997.pdf, p.388",
      "values:originalText": "(8) The ACMA may delegate any of the powers conferred on the\nACMA by an allocation system to the numbering scheme manager\nor another person.",
      "skos:definition": "(8) The ACMA may delegate any of the powers conferred on the\nACMA by an allocation system to the numbering scheme manager\nor another person.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-463"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-463-ss-8-norm"
        }
      ],
      "cml:integrityHash": "1e68526599e5fce1ba70246468a1696265f4df53b3245e508f4894fa30ffc450",
      "skos:note": "Delegation of powers by ACMA"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-463-ss-8",
      "@type": "cof:Section",
      "cof:title": "463(8) Allocation system for numbers",
      "values:kind": "subsection",
      "cof:pageNumber": 388,
      "values:originalText": "(8) The ACMA may delegate any of the powers conferred on the\nACMA by an allocation system to the numbering scheme manager\nor another person."
    },
