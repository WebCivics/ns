      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.423",
      "values:originalText": "(4) If the hearing is to be conducted in public, the ACMA must give\nreasonable public notice of the conduct of the hearing.",
      "skos:definition": "(4) If the hearing is to be conducted in public, the ACMA must give\nreasonable public notice of the conduct of the hearing.",
