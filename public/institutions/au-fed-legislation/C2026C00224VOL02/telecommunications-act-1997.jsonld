      },
      "cml:premiseText": "Inspector believes on reasonable grounds...",
      "cml:conclusionText": "Deviation from subsection (1) overlaps with the temporal interval of immediate entry"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547g",
      "@type": "cml:Concept",
      "skos:prefLabel": "547G Compensation for damage to equipment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-547g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.475",
      "values:originalText": "(1) This section applies if:\n\n(a) as a result of equipment being operated as mentioned in\nsection 547B:\n\n(i) damage is caused to the equipment; or\n\n(ii) the data recorded on the equipment is damaged; or",
      "skos:definition": "(1) This section applies if:\n\n(a) as a result of equipment being operated as mentioned in\nsection 547B:\n\n(i) damage is caused to the equipment; or\n\n(ii) the data recorded on the equipment is damaged; or",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-547g-norm"
        }
      ],
      "cml:integrityHash": "d2630499d308786081bffe5d90e648e6c9c843e341b52449b905a7587ded7100",
      "skos:note": "Condition for application of section"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-547g",
      "@type": "cof:Section",
      "cof:title": "547G Compensation for damage to equipment",
      "values:kind": "section",
      "cof:pageNumber": 475,
      "values:originalText": "(1) This section applies if:\n\n(a) as a result of equipment being operated as mentioned in\nsection 547B:\n\n(i) damage is caused to the equipment; or\n\n(ii) the data recorded on the equipment is damaged; or"
    },
