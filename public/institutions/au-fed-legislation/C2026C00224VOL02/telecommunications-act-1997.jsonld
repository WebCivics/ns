      "cml:integrityHash": "a6fa27034a2e9318052782afae4e56108f4493cb1dac627ea63b31f9f27020d5",
      "skos:note": "Does not limit matters dealt with by codes or standards"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581zf-ss-4",
      "@type": "cof:Section",
      "cof:title": "581ZF(4) Code relating to access",
      "values:kind": "subsection",
      "cof:pageNumber": 630,
      "values:originalText": "(4) This section does not, by implication, limit the matters that may be\ndealt with by codes or standards referred to in Part 6."
    },
