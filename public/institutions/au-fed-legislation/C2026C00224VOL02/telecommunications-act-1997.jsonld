      "cml:integrityHash": "08c3e82d5ad1a8d2b7b1c6d4be508bb518f96b15e5052bfb1d22af05fed0d379",
      "skos:note": "Labeling equipment or cabling meets requirements if it contains a specified symbol."
    },
