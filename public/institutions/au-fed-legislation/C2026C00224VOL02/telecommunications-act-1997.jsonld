      ],
      "cml:integrityHash": "0234cbafe5e670a3a2493e8408bf667d882f4754346ec741e3d2bde6405aec7a",
      "skos:note": "Must not give a technical assistance request unless certain conditions are met. A technical assistance request must be done in a specified manner or way that meets one or more conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317j-ss-2",
