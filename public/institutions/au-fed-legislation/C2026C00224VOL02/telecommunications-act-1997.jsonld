    {
      "@id": "concept:telecommunications-act-1997-sec-484j-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "484J(5) Automation of administrative action",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484j-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
