      "skos:note": "Definition of company"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581c",
      "@type": "cof:Section",
      "cof:title": "581C Company",
      "values:kind": "section",
      "cof:pageNumber": 595,
      "values:originalText": "For the purposes of this Part, company means a body corporate."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581c-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
