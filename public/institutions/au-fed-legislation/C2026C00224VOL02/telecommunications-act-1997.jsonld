    {
      "@id": "concept:telecommunications-act-1997-sec-317q-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "317Q(8) Variation of technical assistance notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317q-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.80",
      "values:originalText": "(8) The acts or things specified in a varied technical assistance notice\nmust be:\n\n(a) in connection with any or all of the eligible activities of the\ndesignated communications provider concerned; and\n\n(b) covered by subsection 317L(2).",
      "skos:definition": "(8) The acts or things specified in a varied technical assistance notice\nmust be:\n\n(a) in connection with any or all of the eligible activities of the\ndesignated communications provider concerned; and\n\n(b) covered by subsection 317L(2).",
      "values:partOf": {
