    },
    {
      "@id": "concept:telecommunications-act-1997-sec-386-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classify the proposed standard as a technical standard.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The ACMA must, so far as is practicable, try to ensure that:",
      "cml:conclusionText": "the proposed standard is a technical standard under section 384."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-386-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Establish temporal intervals for the representations and due consideration.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) interested persons have had an adequate opportunity to make representations about the proposed standard (either directly, or indirectly by means of a report under paragraph (2)(g));",
      "cml:conclusionText": "due consideration has been given to any representations so made within a reasonable time frame."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-386-ss-1-logic-alleninterval-4",
