      },
      "cml:premiseText": "(1) The Minister may, by legislative instrument...",
      "cml:conclusionText": "...from the scope of either or both of the following provisions:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "372D(2) Exemptions—Ministerial instrument",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372d-ss-2"
      },
