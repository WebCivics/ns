        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581x-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581x-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d0e0fba0951fa61ab110fd1dedca68266ad78083b2a85bad73c8be8d9beccf80",
      "skos:note": "Eligible company definition"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581x",
      "@type": "cof:Section",
      "cof:title": "581X Eligible company",
      "values:kind": "section",
      "cof:pageNumber": 618,
      "values:originalText": "For the purposes of this Part, eligible company means a body\ncorporate that:\n\n(a) is in a carrier company group; and\n\n(b) is not a carrier."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581x-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
