    {
      "@id": "concept:telecommunications-act-1997-sec-581zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "581ZC Extended meaning of access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581zc"
      },
      "cml:curationStatus": {
