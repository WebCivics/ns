        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Considering portability promotes end-users' interests",
      "cml:conclusionText": "Portability contains the requirement to promote end-users' interests"
    },
    {
