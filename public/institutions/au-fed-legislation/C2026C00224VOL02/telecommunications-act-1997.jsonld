      },
      "cml:premiseText": "ACMA is not required to comply",
      "cml:conclusionText": "if it is necessary to make the standard as a matter of urgency"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-379-ss-1-logic-descriptionlogic-2",
