    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-432-ss-2",
      "@type": "cof:Section",
      "cof:title": "432(2) Conditions of cabling licence",
      "values:kind": "subsection",
      "cof:pageNumber": 354,
      "values:originalText": "(2) A cabling licence is subject to such conditions as are specified in\nthe licence."
    },
