        },
        {
          "@id": "concept:telecommunications-act-1997-sec-576-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "703a37bf2e5369f2d5ead3b47ca3de6fe0a428d05da14cc6f26249e7c6139c9f",
      "skos:note": "Exemptions from liability for certain offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-576",
      "@type": "cof:Section",
      "cof:title": "576 Liability of persons other than corporations",
      "values:kind": "section",
      "cof:pageNumber": 517,
      "values:originalText": "This section does not apply to proceedings for certain offences\n\n(1) This section does not apply to proceedings for:\n\n(a) an offence against section 42; or\n\n(b) an offence created by section 6 of the Crimes Act 1914 or"
    },
    {
