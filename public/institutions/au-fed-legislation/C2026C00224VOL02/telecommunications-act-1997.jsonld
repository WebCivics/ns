      },
      "dc:source": "telecommunications-act-1997.pdf, p.218",
      "values:originalText": "(2) An area specified under:\n\n(a) subsection 360HA(1); or\n\n(b) subsection 360HA(2); or\n\n(c) subsection 360HA(3); or\n\n(d) subsection 360HA(4); or\n\n(da) subsection 360HC(1); or\n\n(db) subsection 360HC(2);\nmust be described:\n\n(e) using:\n\n(i) if no coordinate system is determined under\nsubsection (2A)—the GDA94 coordinate system; or\n\n(ii) if a coordinate system is determined under\nsubsection (2A)—the coordinate system determined\nunder subsection (2A); and\n\n(f) if a format is determined under subsection (3)—in that\nformat; and\n\n(g) if no format is determined under subsection (3)—in a TAB\nvector format.",
      "skos:definition": "(2) An area specified under:\n\n(a) subsection 360HA(1); or\n\n(b) subsection 360HA(2); or\n\n(c) subsection 360HA(3); or\n\n(d) subsection 360HA(4); or\n\n(da) subsection 360HC(1); or\n\n(db) subsection 360HC(2);\nmust be described:\n\n(e) using:\n\n(i) if no coordinate system is determined under\nsubsection (2A)—the GDA94 coordinate system; or\n\n(ii) if a coordinate system is determined under\nsubsection (2A)—the coordinate system determined\nunder subsection (2A); and\n\n(f) if a format is determined under subsection (3)—in that\nformat; and\n\n(g) if no format is determined under subsection (3)—in a TAB\nvector format.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360la"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360la-ss-2-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360la-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c656d3ad5812bdc7b6c3c1d6a2fefc2a9eac8a41ca8e16f0e3cf4c868ec89c0f",
      "skos:note": "Format of description of areas must be specified in a certain format",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360la-ss-2",
      "@type": "cof:Section",
      "cof:title": "360LA(2) Format of description of areas",
      "values:kind": "subsection",
      "cof:pageNumber": 218,
      "values:originalText": "(2) An area specified under:\n\n(a) subsection 360HA(1); or\n\n(b) subsection 360HA(2); or\n\n(c) subsection 360HA(3); or\n\n(d) subsection 360HA(4); or\n\n(da) subsection 360HC(1); or\n\n(db) subsection 360HC(2);\nmust be described:\n\n(e) using:\n\n(i) if no coordinate system is determined under\nsubsection (2A)—the GDA94 coordinate system; or\n\n(ii) if a coordinate system is determined under\nsubsection (2A)—the coordinate system determined\nunder subsection (2A); and\n\n(f) if a format is determined under subsection (3)—in that\nformat; and\n\n(g) if no format is determined under subsection (3)—in a TAB\nvector format."
    },
