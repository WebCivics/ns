        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Customer has an obligation against the statutory infrastructure provider",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the standard is determined under subsection 360U(1); and\n(c) the contravention relates to a particular customer;",
      "cml:conclusionText": "the customer owes an obligation against the statutory infrastructure provider."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-2",
      "@type": "cml:Concept",
