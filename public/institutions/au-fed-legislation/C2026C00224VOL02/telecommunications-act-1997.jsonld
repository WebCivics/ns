    {
      "@id": "concept:telecommunications-act-1997-sec-400",
      "@type": "cml:Concept",
      "skos:prefLabel": "400 Formal warnings—breach of condition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-400"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
