      },
      "cml:operator": "APPLIES",
      "cml:logicSummary": "Application of hearings being in public to specific cases",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The basic rule is that the hearing must take place in public.",
      "cml:conclusionText": "The exception for exceptional cases applies to specific cases."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-492-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
