        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes on reasonable grounds...",
      "cml:conclusionText": "Deviation from subsection (1) is part of a recurring trace"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547f-ss-2-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Inference",
      "cml:logicSummary": "Deviation from subsection (1) follows logically from the inspector's belief",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
