    {
      "@id": "concept:telecommunications-act-1997-sec-577aa-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "577AA(6) Acceptance of undertaking about structural separation may",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577aa-ss-6"
