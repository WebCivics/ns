        }
      ],
      "cml:integrityHash": "7205f3ebc3ec4d6be3cf7e3b64a4e91bf0b391d9bc742e27801ea58bda80bce4",
      "skos:note": "This Division has effect in accordance with an instrument in force under subsection (1)."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-439-ss-4",
      "@type": "cof:Section",
      "cof:title": "439(4) ACMA may limit application of Division in relation to customer",
      "values:kind": "subsection",
      "cof:pageNumber": 358,
      "values:originalText": "(4) This Division has effect in accordance with an instrument in force\nunder subsection (1)."
    },
    {
