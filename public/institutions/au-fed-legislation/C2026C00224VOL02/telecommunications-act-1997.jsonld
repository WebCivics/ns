    {
      "@id": "concept:telecommunications-act-1997-sec-16-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(9) August 1996, the person:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-16-ss-9"
