      ],
      "cml:integrityHash": "1d544052fa8190dba8634c654bb140eca39e0fa99a5ae43e14226f8945c4fb97",
      "skos:note": "Determines control of subscription television broadcasting licence under Schedule 1 to the Broadcasting Services Act 1992."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577e-ss-6",
      "@type": "cof:Section",
      "cof:title": "577E(6) Acceptance of undertaking about subscription television",
      "values:kind": "subsection",
      "cof:pageNumber": 568,
      "values:originalText": "(6) For the purposes of this section, the question of whether Telstra is\nin a position to exercise control of a subscription television\nbroadcasting licence is to be determined under Schedule 1 to the\nBroadcasting Services Act 1992."
    },
