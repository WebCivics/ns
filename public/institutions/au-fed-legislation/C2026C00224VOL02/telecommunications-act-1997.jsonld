    {
      "@id": "concept:telecommunications-act-1997-sec-424",
      "@type": "cml:Concept",
      "skos:prefLabel": "424 Form of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-424"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
