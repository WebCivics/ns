      },
      "cml:conclusionText": "Make a written record of variation within 48 hours after oral variation made by certain officials"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317ja-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "317JA(8) Variation of technical assistance requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ja-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.64",
      "values:originalText": "(8) If, under subsection (7):\n\n(a) the Director-General of Security; or\n\n(b) the Director-General of the Australian Secret Intelligence\nService; or\n\n(c) the Director-General of the Australian Signals Directorate; or\n\n(d) the chief officer of an interception agency;",
      "skos:definition": "(8) If, under subsection (7):\n\n(a) the Director-General of Security; or\n\n(b) the Director-General of the Australian Secret Intelligence\nService; or\n\n(c) the Director-General of the Australian Signals Directorate; or\n\n(d) the chief officer of an interception agency;",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-317ja"
      },
      "cml:asserts": [
        {
