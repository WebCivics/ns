    {
      "@id": "concept:telecommunications-act-1997-sec-372zb",
      "@type": "cml:Concept",
      "skos:prefLabel": "372ZB Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372zb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.308",
      "values:originalText": "This Part is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Part.",
      "skos:definition": "This Part is not intended to exclude or limit the operation of a law\nof a State or Territory that is capable of operating concurrently\nwith this Part.",
