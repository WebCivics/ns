      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "...does not require the carrier to supply qualifying carriage services within all or any part of the project area;",
      "cml:conclusionText": "No requirement for carrier to supply qualifying carriage services within all or any part of the project area."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360m-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
