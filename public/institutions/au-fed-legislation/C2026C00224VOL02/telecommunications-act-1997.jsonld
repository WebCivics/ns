      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a person (the first person):...",
      "cml:conclusionText": "...disconnect the equipment or cabling;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-447-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Defines temporal interval for disconnection.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) disconnect the equipment or cabling;",
      "cml:conclusionText": "...if it is necessary to disconnect other customer equipment or other customer cabling..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-447-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Justification",
      "cml:logicSummary": "Justifies disconnection under certain conditions.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the manager of the network or facility has an honest belief...",
      "cml:conclusionText": "...the manager of the network or facility may:..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-447-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation",
      "cml:logicSummary": "Propagates disconnection to related equipment.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) if it is necessary to disconnect other customer equipment or other customer cabling...",
      "cml:conclusionText": "...disconnect that other equipment or cabling."
    },
