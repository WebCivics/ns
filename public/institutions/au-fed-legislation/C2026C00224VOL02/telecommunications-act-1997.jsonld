    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577ed",
      "@type": "cof:Section",
      "cof:title": "577ED Compliance with undertaking about subscription television",
      "values:kind": "section",
      "cof:pageNumber": 573,
      "values:originalText": "broadcasting licences\n\nIf an undertaking given by Telstra is in force under section 577E,\nTelstra must comply with the undertaking."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577ed-norm",
