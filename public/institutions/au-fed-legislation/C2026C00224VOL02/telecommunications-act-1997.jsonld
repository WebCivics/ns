      },
      "cml:premiseText": "(a) the excluded spectrum regime applies to Telstra; and (b) a spectrum licence relates to a designated part of the spectrum;",
      "cml:conclusionText": "The prohibition is diffused to all relevant parties."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577k-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
