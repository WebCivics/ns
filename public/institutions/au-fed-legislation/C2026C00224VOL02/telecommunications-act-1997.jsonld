    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484j-ss-3",
      "@type": "cof:Section",
      "cof:title": "484J(3) Automation of administrative action",
      "values:kind": "subsection",
      "cof:pageNumber": 414,
      "values:originalText": "(3) Administrative action taken by the operation of a computer\nprogram under an arrangement under subsection (1) is treated, for\nall purposes, as administrative action taken by the ACMA.\nSubstituted decisions"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-484j-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-484j-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-484j-ss-3-logic-deontic-1",
