        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.355",
      "values:originalText": "(5) If the ACMA neither grants, nor refuses to grant, an application\nunder paragraph (1)(b) before the end of 30 days after receiving the\napplication, the ACMA is taken, at the end of that period, to have\nrefused the application.",
      "skos:definition": "(5) If the ACMA neither grants, nor refuses to grant, an application\nunder paragraph (1)(b) before the end of 30 days after receiving the\napplication, the ACMA is taken, at the end of that period, to have\nrefused the application.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-433"
      },
      "cml:asserts": [
        {
