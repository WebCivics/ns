    },
    {
      "@id": "concept:telecommunications-act-1997-sec-411-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "411(3) Connection of customer equipment or customer cabling—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-411-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.338",
      "values:originalText": "(3) A person does not contravene subsection (1) in relation to:\n\n(a) connecting customer equipment, or customer cabling, to a\ntelecommunications network, or to a facility; or\n\n(b) maintaining such a connection;\nif the connection, or the maintenance of the connection, as the case\nmay be, is in accordance with a connection permit.\nNote:\nConnection permits are issued under section 394.",
      "skos:definition": "(3) A person does not contravene subsection (1) in relation to:\n\n(a) connecting customer equipment, or customer cabling, to a\ntelecommunications network, or to a facility; or\n\n(b) maintaining such a connection;\nif the connection, or the maintenance of the connection, as the case\nmay be, is in accordance with a connection permit.\nNote:\nConnection permits are issued under section 394.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-411"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-411-ss-3-norm"
        }
      ],
      "cml:integrityHash": "749c33e337ea4cd2f84476a0e0f3703c7ff277afbbe6c2a2390054ea94c40140",
      "skos:note": "Permit required for connection or maintenance of customer equipment or cabling."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-411-ss-3",
      "@type": "cof:Section",
      "cof:title": "411(3) Connection of customer equipment or customer cabling—",
      "values:kind": "subsection",
      "cof:pageNumber": 338,
      "values:originalText": "(3) A person does not contravene subsection (1) in relation to:\n\n(a) connecting customer equipment, or customer cabling, to a\ntelecommunications network, or to a facility; or\n\n(b) maintaining such a connection;\nif the connection, or the maintenance of the connection, as the case\nmay be, is in accordance with a connection permit.\nNote:\nConnection permits are issued under section 394."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-411-ss-3-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-411-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
