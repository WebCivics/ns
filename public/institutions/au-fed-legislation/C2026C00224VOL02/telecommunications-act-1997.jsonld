        }
      ],
      "cml:integrityHash": "64fd34211eeca5a7b5eb9d213d21416f01a805d40e502bf5ee168445f1098196",
      "skos:note": "Publish report on inquiry held without Minister's direction"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-505-ss-3",
      "@type": "cof:Section",
      "cof:title": "505(3) Reports on inquiries",
      "values:kind": "subsection",
      "cof:pageNumber": 432,
