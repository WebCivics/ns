        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This section is about the liability of the Commonwealth.",
      "cml:conclusionText": "This section is about taxation."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-471-ss-5-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
