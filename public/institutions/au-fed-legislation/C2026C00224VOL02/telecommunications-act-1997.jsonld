      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.549",
      "values:originalText": "(1) This section applies if Telstra gives the ACCC a draft migration\nplan (the original plan) in accordance with an undertaking in force\nunder section 577A.\nDecision",
      "skos:definition": "(1) This section applies if Telstra gives the ACCC a draft migration\nplan (the original plan) in accordance with an undertaking in force\nunder section 577A.\nDecision",
