        }
      ],
      "cml:integrityHash": "e4b4c6081ad9d10fffff73c369c5c776ac6089874d01ea66448c74b5394b2c0b",
      "skos:note": "References to the Spam Act 2003"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-532a",
      "@type": "cof:Section",
