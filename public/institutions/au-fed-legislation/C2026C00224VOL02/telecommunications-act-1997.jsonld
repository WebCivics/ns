      },
      "cml:premiseText": "Publication of reports is required.",
      "cml:conclusionText": "Publication of reports is not required if..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-517-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:logicSummary": "Temporal overlap between publication and disclosure",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Publication occurs at a specific time.",
      "cml:conclusionText": "Publication would involve unreasonable disclosure of personal information if it overlaps with the individual's lifetime."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-517-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
