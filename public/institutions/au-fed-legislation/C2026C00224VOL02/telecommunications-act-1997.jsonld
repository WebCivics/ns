        },
        {
          "@id": "concept:telecommunications-act-1997-sec-510-ss-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "ded467854cd1610b941b79cb0d96bf99e5d8dfada1a88d80dd8690edc53e18ac",
      "skos:note": "The ACMA must investigate a matter requested by the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-510-ss-3",
      "@type": "cof:Section",
      "cof:title": "510(3) Investigations by the ACMA",
      "values:kind": "subsection",
      "cof:pageNumber": 438,
      "values:originalText": "(3) The ACMA must investigate:\n\n(a) a matter of a kind referred to in section 508; or\n\n(b) any other matter concerning carriage services or the\ntelecommunications industry;\nif the Minister requests the ACMA so to investigate."
    },
