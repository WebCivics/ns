    {
      "@id": "concept:telecommunications-act-1997-sec-575-ss-3-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusion operator for descriptions.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A description includes its parts.",
      "cml:conclusionText": "The reference to the state of mind includes the person's reasons for their intention, opinion, belief or purpose."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-575-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
