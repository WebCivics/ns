    {
      "@id": "concept:telecommunications-act-1997-sec-592",
      "@type": "cml:Concept",
      "skos:prefLabel": "592 Act not to affect performance of State or Territory functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-592"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.640",
      "values:originalText": "(1) A power conferred by this Act must not be exercised in such a way\nas to prevent the exercise of the powers, or the performance of the\nfunctions, of government of a State, the Northern Territory or the\nAustralian Capital Territory.\n\n(2) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999 and regulations under that Act; and\n\n(b) the Spam Act 2003 and regulations under that Act; and\n\n(c) the Do Not Call Register Act 2006 and regulations under that\nAct.",
      "skos:definition": "(1) A power conferred by this Act must not be exercised in such a way\nas to prevent the exercise of the powers, or the performance of the\nfunctions, of government of a State, the Northern Territory or the\nAustralian Capital Territory.\n\n(2) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999 and regulations under that Act; and\n\n(b) the Spam Act 2003 and regulations under that Act; and\n\n(c) the Do Not Call Register Act 2006 and regulations under that\nAct.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-592-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-592-ss-2"
        }
      ],
      "cml:integrityHash": "1fb67ee27572dfd1d28aaf51fe3845d320d3f67d01792e99ecb7d013929d0d20"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-592",
      "@type": "cof:Section",
      "cof:title": "592 Act not to affect performance of State or Territory functions",
      "values:kind": "section",
