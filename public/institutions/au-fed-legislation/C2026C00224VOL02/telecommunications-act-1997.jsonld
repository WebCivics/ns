    {
      "@id": "concept:telecommunications-act-1997-sec-534",
      "@type": "cml:Concept",
      "skos:prefLabel": "534 Identity cards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-534"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.460",
      "values:originalText": "(1) The ACMA may issue an identity card to an inspector, other than a\nmember of a police force, in a form approved, in writing, by the\nACMA.\n\n(2) A person who ceases to be an inspector must, as soon as\npracticable, return his or her identity card to the ACMA.\n\n(3) A person must not contravene subsection (2).\nPenalty: 5 penalty units.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\n(4) Subsection (3) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (4) (see subsection 13.3(3) of the Criminal Code).\n\n(5) Subsection (3) is an offence of strict liability.\nNote:\nFor strict liability, see section 6.1 of the Criminal Code.\n\n\nEnforcement  Part 28\nSearch warrants relating to breaches of the Spam Act 2003 or Part 21 of this Act",
      "skos:definition": "(1) The ACMA may issue an identity card to an inspector, other than a\nmember of a police force, in a form approved, in writing, by the\nACMA.\n\n(2) A person who ceases to be an inspector must, as soon as\npracticable, return his or her identity card to the ACMA.\n\n(3) A person must not contravene subsection (2).\nPenalty: 5 penalty units.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\n(4) Subsection (3) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (4) (see subsection 13.3(3) of the Criminal Code).\n\n(5) Subsection (3) is an offence of strict liability.\nNote:\nFor strict liability, see section 6.1 of the Criminal Code.\n\n\nEnforcement  Part 28\nSearch warrants relating to breaches of the Spam Act 2003 or Part 21 of this Act",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-534-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-534-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-534-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-534-ss-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-534-ss-5"
        }
      ],
      "cml:integrityHash": "8915434a4b96008259acbdd346917f0f240fb6b68f47744096262d5f56922212"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-534",
      "@type": "cof:Section",
      "cof:title": "534 Identity cards",
      "values:kind": "section",
      "cof:pageNumber": 460,
      "values:originalText": "(1) The ACMA may issue an identity card to an inspector, other than a\nmember of a police force, in a form approved, in writing, by the\nACMA.\n\n(2) A person who ceases to be an inspector must, as soon as\npracticable, return his or her identity card to the ACMA.\n\n(3) A person must not contravene subsection (2).\nPenalty: 5 penalty units.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\n(4) Subsection (3) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (4) (see subsection 13.3(3) of the Criminal Code).\n\n(5) Subsection (3) is an offence of strict liability.\nNote:\nFor strict liability, see section 6.1 of the Criminal Code.\n\n\nEnforcement  Part 28\nSearch warrants relating to breaches of the Spam Act 2003 or Part 21 of this Act"
    },
