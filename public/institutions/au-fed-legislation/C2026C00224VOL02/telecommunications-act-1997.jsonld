      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission to nominate an address.",
      "cml:executionSurface": "modalities::logic::deontic",
