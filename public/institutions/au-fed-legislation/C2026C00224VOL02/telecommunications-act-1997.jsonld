    {
      "@id": "concept:telecommunications-act-1997-sec-317w-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "317W(7) Consultation about a proposal to give a technical capability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317w-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.94",
      "values:originalText": "(7) Subsection (1) does not apply to a technical capability notice\nproposed to be given to a designated communications provider if:\n\n(a) the requirements imposed by the proposed technical\ncapability notice are the same, or substantially the same, as\nthe requirements imposed by another technical capability\nnotice that has previously been given to the provider; and\n\n(b) the proposed technical capability notice is to come into force\nimmediately after the expiry of the other technical capability\nnotice.\nSpecial consultation requirements for replacement technical\ncapability notices",
      "skos:definition": "(7) Subsection (1) does not apply to a technical capability notice\nproposed to be given to a designated communications provider if:\n\n(a) the requirements imposed by the proposed technical\ncapability notice are the same, or substantially the same, as\nthe requirements imposed by another technical capability\nnotice that has previously been given to the provider; and\n\n(b) the proposed technical capability notice is to come into force\nimmediately after the expiry of the other technical capability\nnotice.\nSpecial consultation requirements for replacement technical\ncapability notices",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-317w"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317w-ss-7-norm"
        }
      ],
      "cml:integrityHash": "2958e873549aa03a2d68c752586163b820527cf62a1b68cc3870911f4c1a77bb",
      "skos:note": "Consultation about a proposal to give a technical capability"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317w-ss-7",
      "@type": "cof:Section",
      "cof:title": "317W(7) Consultation about a proposal to give a technical capability",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(7) Subsection (1) does not apply to a technical capability notice\nproposed to be given to a designated communications provider if:\n\n(a) the requirements imposed by the proposed technical\ncapability notice are the same, or substantially the same, as\nthe requirements imposed by another technical capability\nnotice that has previously been given to the provider; and\n\n(b) the proposed technical capability notice is to come into force\nimmediately after the expiry of the other technical capability\nnotice.\nSpecial consultation requirements for replacement technical\ncapability notices"
    },
