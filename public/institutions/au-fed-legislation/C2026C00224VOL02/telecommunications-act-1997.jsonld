      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
