    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-338-ss-4",
      "@type": "cof:Section",
      "cof:title": "338(4) ACMA’s certification of draft agreement",
      "values:kind": "subsection",
      "cof:pageNumber": 161,
      "values:originalText": "(4) For the purposes of this section, in determining whether a\nparticular matter is reasonable, the ACMA must have regard to:\n\n(a) the needs of the Defence Department and of the Defence\nForce; and\n\n(b) the interests of the carrier or carriage service provider\nconcerned.\nThis subsection does not, by implication, limit the meaning of the\nexpression “reasonable”."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-338-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "ACMA must consider certain factors",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has a duty to consider the needs of Defence Department and carrier/carriage service provider",
      "cml:conclusionText": "The ACMA must consider these factors when determining reasonableness"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within a temporal interval",
      "cml:logicSummary": "ACMA's consideration of factors is within a certain time frame",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There is a temporal interval during which ACMA must consider the needs of Defence Department and carrier/carriage service provider",
      "cml:conclusionText": "The ACMA must consider these factors within this time frame when determining reasonableness"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "ACMA's consideration of factors is part of a recurring pattern",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There is a recurring pattern of ACMA considering the needs of Defence Department and carrier/carriage service provider",
      "cml:conclusionText": "The ACMA must consider these factors as part of this pattern when determining reasonableness"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses to other entities",
      "cml:logicSummary": "ACMA's consideration of factors diffuses to other entities",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The ACMA's consideration of the needs of Defence Department and carrier/carriage service provider diffuses to other entities",
      "cml:conclusionText": "These entities must consider these factors when making decisions"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Involves cognitive processes",
      "cml:logicSummary": "ACMA's consideration of factors involves cognitive processes",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The ACMA's consideration of the needs of Defence Department and carrier/carriage service provider involves cognitive processes",
      "cml:conclusionText": "These cognitive processes are involved in determining reasonableness"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-338-ss-5",
