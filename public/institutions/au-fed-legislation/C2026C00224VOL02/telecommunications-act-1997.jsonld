      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.562",
      "values:originalText": "(7) If:\n\n(a) a decision to accept an undertaking under section 577C is\nexpressed to be subject to the occurrence of a single specified\nevent within a specified period; and",
      "skos:definition": "(7) If:\n\n(a) a decision to accept an undertaking under section 577C is\nexpressed to be subject to the occurrence of a single specified\nevent within a specified period; and",
      "values:partOf": {
