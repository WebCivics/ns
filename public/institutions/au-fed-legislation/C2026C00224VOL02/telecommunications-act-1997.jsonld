      },
      "cml:premiseText": "Compliance with request will promote long-term interests of end-users or services supplied by means of carriage services.",
      "cml:conclusionText": "Request is reasonable if it promotes long-term interests in a recurring manner"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581y-ss-6-logic-cogai-5",
      "@type": "cml:LogicApplication",
