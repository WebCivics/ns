      },
      "cml:premiseText": "(b) and (i) and (ii)",
      "cml:conclusionText": "the amount of damages payable for the contravention is to be reduced"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "-",
      "cml:logicSummary": "Reduction applies when credit or payment was made as a result of a right or remedy",
      "cml:executionSurface": "modalities::diffusion",
