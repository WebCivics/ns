          "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-alleninterval-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-argumentation-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-diffusion-5"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-cogai-6"
        }
      ],
      "cml:integrityHash": "a4e4bedb5e747fdef676f709852e9395bf7b71d1bbf1e7e03ed5787cc493d140",
      "skos:note": "Must consider portability of allocated numbers to promote end-users' interests"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-458-ss-5",
      "@type": "cof:Section",
      "cof:title": "458(5) Numbering plan—rules about portability of allocated numbers",
      "values:kind": "subsection",
      "cof:pageNumber": 382,
      "values:originalText": "(5) In exercising the power conferred by subsection (2), the ACCC\nmust have regard to whether portability of particular allocated\nnumbers is required in order to promote the long-term interests of\nend-users of carriage services or of services supplied by means of\ncarriage services."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-458-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
