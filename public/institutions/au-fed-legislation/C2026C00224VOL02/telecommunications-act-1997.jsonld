    },
    {
      "@id": "concept:telecommunications-act-1997-sec-525",
      "@type": "cml:Concept",
      "skos:prefLabel": "525 Giving false or misleading information or evidence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-525"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.453",
      "values:originalText": "A person must not, under section 521 or 522, give information or\nevidence that is false or misleading.\nPenalty: Imprisonment for 12 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.",
      "skos:definition": "A person must not, under section 521 or 522, give information or\nevidence that is false or misleading.\nPenalty: Imprisonment for 12 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-525-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-525-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d15f4a0d4e3aa23c334e488be98b7aca9dbc68e72ecea98749351f43cfea58af",
      "skos:note": "Giving false or misleading information or evidence is prohibited.",
      "dc:references": [
        "sec-521",
        "sec-522"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-525",
      "@type": "cof:Section",
      "cof:title": "525 Giving false or misleading information or evidence",
      "values:kind": "section",
      "cof:pageNumber": 453,
      "values:originalText": "A person must not, under section 521 or 522, give information or\nevidence that is false or misleading.\nPenalty: Imprisonment for 12 months.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-525-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-525"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-525-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits giving false or misleading information or evidence.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
