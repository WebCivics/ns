      },
      "cml:premiseText": "this Act includes",
      "cml:conclusionText": "the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-592-ss-2-logic-deontic-2",
