        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "Defines the scope of a defence authority",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary of the Defence Department is a defence authority.",
      "cml:conclusionText": "The Chief of the Defence Force is also a defence authority."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "Defines the temporal scope of a defence authority",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary of the Defence Department takes office on January 1st, 2022.",
      "cml:conclusionText": "The Chief of the Defence Force takes office on January 1st, 2023."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "Defines the scope of a defence authority through argumentation",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary of the Defence Department is appointed by the Prime Minister.",
      "cml:conclusionText": "The Chief of the Defence Force is also appointed by the Prime Minister."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "Defines the scope of a defence authority through diffusion",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary of the Defence Department has access to classified information.",
      "cml:conclusionText": "The Chief of the Defence Force also has access to classified information."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "Defines the scope of a defence authority through cognitive AI",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Secretary of the Defence Department uses machine learning algorithms.",
      "cml:conclusionText": "The Chief of the Defence Force also uses machine learning algorithms."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-335",
      "@type": "cml:Concept",
      "skos:prefLabel": "335 Requirement to supply carriage services for defence purposes or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-335"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.158",
      "values:originalText": "for the management of natural disasters\n\n(1) A defence authority may give a carriage service provider a written\nnotice requiring the provider to supply a specified carriage service\nfor the use of:\n\n(a) the Defence Department; or\n\n(b) the Defence Force.\n\n(2) A defence authority must not issue a notice about a carriage service\nunless the service is required for:\n\n(a) defence purposes; or\n\n(b) for the purposes of the management of natural disasters;\nor both.\n\n(3) A notice issued by a defence authority requiring a carriage service\nprovider to supply a carriage service in particular circumstances is\nof no effect if there is in force a written certificate issued by the\nACMA stating that, in the ACMA’s opinion, it would be\nunreasonable for the provider to be required to supply the service\nin those circumstances.\n\n(4) If a requirement is in force, the provider must supply the carriage\nservice in accordance with the requirement and on such terms and\nconditions as are:\n\n(a) agreed between the provider and the defence authority; or\n\n(b) failing agreement, determined by an arbitrator appointed by\nthe parties.\nIf the parties cannot agree on the appointment of an arbitrator, the\nACCC is to be the arbitrator.\n\n(5) The regulations may make provision for and in relation to the\nconduct of an arbitration under this section.\n\n\nDefence requirements and disaster plans  Part 16\nSupply of carriage services  Division 2\n\nSection 335\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\n(6) The regulations may provide that, for the purposes of a particular\narbitration conducted by the ACCC under this section, the ACCC\nmay be constituted by a single member, or a specified number of\nmembers, of the ACCC. For each such arbitration, that member or\nthose members are to be nominated in writing by the Chairperson\nof the ACCC.\n\n(7) Subsection (6) does not, by implication, limit subsection (5).",
      "skos:definition": "for the management of natural disasters\n\n(1) A defence authority may give a carriage service provider a written\nnotice requiring the provider to supply a specified carriage service\nfor the use of:\n\n(a) the Defence Department; or\n\n(b) the Defence Force.\n\n(2) A defence authority must not issue a notice about a carriage service\nunless the service is required for:\n\n(a) defence purposes; or\n\n(b) for the purposes of the management of natural disasters;\nor both.\n\n(3) A notice issued by a defence authority requiring a carriage service\nprovider to supply a carriage service in particular circumstances is\nof no effect if there is in force a written certificate issued by the\nACMA stating that, in the ACMA’s opinion, it would be\nunreasonable for the provider to be required to supply the service\nin those circumstances.\n\n(4) If a requirement is in force, the provider must supply the carriage\nservice in accordance with the requirement and on such terms and\nconditions as are:\n\n(a) agreed between the provider and the defence authority; or\n\n(b) failing agreement, determined by an arbitrator appointed by\nthe parties.\nIf the parties cannot agree on the appointment of an arbitrator, the\nACCC is to be the arbitrator.\n\n(5) The regulations may make provision for and in relation to the\nconduct of an arbitration under this section.\n\n\nDefence requirements and disaster plans  Part 16\nSupply of carriage services  Division 2\n\nSection 335\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\n(6) The regulations may provide that, for the purposes of a particular\narbitration conducted by the ACCC under this section, the ACCC\nmay be constituted by a single member, or a specified number of\nmembers, of the ACCC. For each such arbitration, that member or\nthose members are to be nominated in writing by the Chairperson\nof the ACCC.\n\n(7) Subsection (6) does not, by implication, limit subsection (5).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-5"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-6"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-335-ss-7"
        }
      ],
      "cml:integrityHash": "91b395bf983b8ac150f7d17fc6557f3a07b985c3cdc71ee1c705ccb93bc7d500"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-335",
      "@type": "cof:Section",
      "cof:title": "335 Requirement to supply carriage services for defence purposes or",
      "values:kind": "section",
      "cof:pageNumber": 158,
      "values:originalText": "for the management of natural disasters\n\n(1) A defence authority may give a carriage service provider a written\nnotice requiring the provider to supply a specified carriage service\nfor the use of:\n\n(a) the Defence Department; or\n\n(b) the Defence Force.\n\n(2) A defence authority must not issue a notice about a carriage service\nunless the service is required for:\n\n(a) defence purposes; or\n\n(b) for the purposes of the management of natural disasters;\nor both.\n\n(3) A notice issued by a defence authority requiring a carriage service\nprovider to supply a carriage service in particular circumstances is\nof no effect if there is in force a written certificate issued by the\nACMA stating that, in the ACMA’s opinion, it would be\nunreasonable for the provider to be required to supply the service\nin those circumstances.\n\n(4) If a requirement is in force, the provider must supply the carriage\nservice in accordance with the requirement and on such terms and\nconditions as are:\n\n(a) agreed between the provider and the defence authority; or\n\n(b) failing agreement, determined by an arbitrator appointed by\nthe parties.\nIf the parties cannot agree on the appointment of an arbitrator, the\nACCC is to be the arbitrator.\n\n(5) The regulations may make provision for and in relation to the\nconduct of an arbitration under this section.\n\n\nDefence requirements and disaster plans  Part 16\nSupply of carriage services  Division 2\n\nSection 335\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\n(6) The regulations may provide that, for the purposes of a particular\narbitration conducted by the ACCC under this section, the ACCC\nmay be constituted by a single member, or a specified number of\nmembers, of the ACCC. For each such arbitration, that member or\nthose members are to be nominated in writing by the Chairperson\nof the ACCC.\n\n(7) Subsection (6) does not, by implication, limit subsection (5)."
    },
