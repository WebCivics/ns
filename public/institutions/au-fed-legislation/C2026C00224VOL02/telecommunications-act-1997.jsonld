      },
      "cml:premiseText": "(5) The ACMA must exercise its powers under subsection (1) in a manner consistent with directions given by the ACCC under subsection (4)",
      "cml:conclusionText": "by providing AI systems with information about the exercise of powers under this section"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-474-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(6) Declared manager of electronic addressing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-474-ss-6"
      },
      "cml:curationStatus": {
