      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person's knowledge, intention, opinion, belief or purpose is included in a reference to the state of mind.",
      "cml:conclusionText": "The reference to the state of mind includes the person's knowledge, intention, opinion, belief or purpose."
    },
    {
