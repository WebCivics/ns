    {
      "@id": "concept:telecommunications-act-1997-sec-577b-ss-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "577B(5A) Variation of undertaking about structural separation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577b-ss-5a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.533",
      "values:originalText": "(5A) Before making or varying an instrument under subsection (5), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and\n\n(b) consider any submissions received within the 14-day period\nmentioned in paragraph (a).",
      "skos:definition": "(5A) Before making or varying an instrument under subsection (5), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and\n\n(b) consider any submissions received within the 14-day period\nmentioned in paragraph (a).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-577b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-577b-ss-5a-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577b-ss-5a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "01d25b6ed17e186efce44a2295f23760d823fbe89af7e0dddfd1773a24ef0d42",
      "skos:note": "Publish notice and invite submissions before making or varying an instrument.",
      "dc:description": "Notice and submissions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577b-ss-5a",
      "@type": "cof:Section",
      "cof:title": "577B(5A) Variation of undertaking about structural separation",
      "values:kind": "subsection",
      "cof:pageNumber": 533,
      "values:originalText": "(5A) Before making or varying an instrument under subsection (5), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and\n\n(b) consider any submissions received within the 14-day period\nmentioned in paragraph (a)."
    },
