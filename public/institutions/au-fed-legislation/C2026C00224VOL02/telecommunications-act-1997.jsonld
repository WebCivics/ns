      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581z-ss-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Precedence",
      "cml:logicSummary": "Agreement supersedes legislative determination",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Agreement is in writing",
      "cml:conclusionText": "Determination has no effect"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581za",
      "@type": "cml:Concept",
      "skos:prefLabel": "581ZA Ministerial pricing determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581za"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.624",
      "values:originalText": "(1) The Minister may, by legislative instrument, make a determination\nsetting out principles dealing with price-related terms and\nconditions relating to the obligations imposed by\nsubsection 581Y(1). The determination is to be known as a\nMinisterial pricing determination.\n\n(2) In this section:\nprice-related terms and conditions means terms and conditions\nrelating to price or a method of ascertaining price.\n\n\nAccess to supplementary facilities and telecommunications transmission towers  Part\n34B\nAccess to telecommunications transmission towers  Division 3\n\nSection 581ZB\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "(1) The Minister may, by legislative instrument, make a determination\nsetting out principles dealing with price-related terms and\nconditions relating to the obligations imposed by\nsubsection 581Y(1). The determination is to be known as a\nMinisterial pricing determination.\n\n(2) In this section:\nprice-related terms and conditions means terms and conditions\nrelating to price or a method of ascertaining price.\n\n\nAccess to supplementary facilities and telecommunications transmission towers  Part\n34B\nAccess to telecommunications transmission towers  Division 3\n\nSection 581ZB\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581za-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581za-ss-2"
        }
      ],
      "cml:integrityHash": "09e4c73d06132f9b7eafbbf51bee1249199f3ebe657a50b983c7dff9e94ded81"
    },
    {
