    {
      "@id": "concept:telecommunications-act-1997-sec-360vg",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VG Savings of other laws and remedies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.251",
      "values:originalText": "(1) This Division is not intended to exclude or limit the concurrent\noperation of any law of a State or Territory.\n\n(2) This Division does not limit, restrict or otherwise affect any right\nor remedy a person would have if this Division had not been\nenacted.\n\n(3) This Division does not limit, restrict or otherwise affect the\noperation of the Telecommunications Industry Ombudsman\nscheme. In particular, this Division does not affect a customer’s\nright to complain to the Telecommunications Industry\nOmbudsman.\n\n(4) Subsection (3) does not, by implication, limit subsection (2).",
      "skos:definition": "(1) This Division is not intended to exclude or limit the concurrent\noperation of any law of a State or Territory.\n\n(2) This Division does not limit, restrict or otherwise affect any right\nor remedy a person would have if this Division had not been\nenacted.\n\n(3) This Division does not limit, restrict or otherwise affect the\noperation of the Telecommunications Industry Ombudsman\nscheme. In particular, this Division does not affect a customer’s\nright to complain to the Telecommunications Industry\nOmbudsman.\n\n(4) Subsection (3) does not, by implication, limit subsection (2).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360vg-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360vg-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360vg-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360vg-ss-4"
        }
      ],
      "cml:integrityHash": "bd826fc4a6f8268cae3ff74428443ebd767a4000f8aed8b7fd7c22d46ecc4b8c"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vg",
      "@type": "cof:Section",
      "cof:title": "360VG Savings of other laws and remedies",
      "values:kind": "section",
      "cof:pageNumber": 251,
      "values:originalText": "(1) This Division is not intended to exclude or limit the concurrent\noperation of any law of a State or Territory.\n\n(2) This Division does not limit, restrict or otherwise affect any right\nor remedy a person would have if this Division had not been\nenacted.\n\n(3) This Division does not limit, restrict or otherwise affect the\noperation of the Telecommunications Industry Ombudsman\nscheme. In particular, this Division does not affect a customer’s\nright to complain to the Telecommunications Industry\nOmbudsman.\n\n(4) Subsection (3) does not, by implication, limit subsection (2)."
    },
