    {
      "@id": "concept:telecommunications-act-1997-sec-562",
      "@type": "cml:Concept",
      "skos:prefLabel": "562 Review by the Administrative Review Tribunal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-562"
      },
      "cml:curationStatus": {
