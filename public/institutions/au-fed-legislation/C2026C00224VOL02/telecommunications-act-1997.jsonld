      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581v-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide carriers with access to facilities and telecommunications transmission towers.",
