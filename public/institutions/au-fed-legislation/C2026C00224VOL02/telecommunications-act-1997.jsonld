    {
      "@id": "concept:telecommunications-act-1997-sec-494-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "494(6) Direction about private hearings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-494-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
