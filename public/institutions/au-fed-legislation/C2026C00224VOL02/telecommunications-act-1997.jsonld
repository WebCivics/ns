    {
      "@id": "concept:telecommunications-act-1997-sec-376a",
      "@type": "cml:Concept",
      "skos:prefLabel": "376A ACMA must make technical standards if directed by the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-376a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.315",
      "values:originalText": "Minister\n\n(1) The Minister may, by legislative instrument, direct the ACMA to:\n\n(a) make a technical standard under section 376 that deals with\none or more specified matters; and\n\n(b) do so within a specified period.\n\n(2) The Minister must not give the ACMA a direction under section 14\nof the Australian Communications and Media Authority Act 2005\nrequiring the ACMA to make a technical standard under\nsection 376 of this Act that deals with one or more specified\nmatters.",
      "skos:definition": "Minister\n\n(1) The Minister may, by legislative instrument, direct the ACMA to:\n\n(a) make a technical standard under section 376 that deals with\none or more specified matters; and\n\n(b) do so within a specified period.\n\n(2) The Minister must not give the ACMA a direction under section 14\nof the Australian Communications and Media Authority Act 2005\nrequiring the ACMA to make a technical standard under\nsection 376 of this Act that deals with one or more specified\nmatters.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-376a-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-376a-ss-2"
        }
      ],
      "cml:integrityHash": "27e1c95e64999f594001f3b8fada27406bb96ae8adfdedf0b0b67e2e95c59347"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-376a",
      "@type": "cof:Section",
      "cof:title": "376A ACMA must make technical standards if directed by the",
      "values:kind": "section",
      "cof:pageNumber": 315,
      "values:originalText": "Minister\n\n(1) The Minister may, by legislative instrument, direct the ACMA to:\n\n(a) make a technical standard under section 376 that deals with\none or more specified matters; and\n\n(b) do so within a specified period.\n\n(2) The Minister must not give the ACMA a direction under section 14\nof the Australian Communications and Media Authority Act 2005\nrequiring the ACMA to make a technical standard under\nsection 376 of this Act that deals with one or more specified\nmatters."
    },
