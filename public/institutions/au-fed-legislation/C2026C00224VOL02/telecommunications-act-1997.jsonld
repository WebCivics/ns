    {
      "@id": "concept:telecommunications-act-1997-sec-360q-ss-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "360Q(2A) Obligation of statutory infrastructure provider to supply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360q-ss-2a"
      },
      "cml:curationStatus": {
