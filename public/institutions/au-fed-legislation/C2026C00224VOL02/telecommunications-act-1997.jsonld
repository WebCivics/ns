    {
      "@id": "concept:telecommunications-act-1997-sec-360j-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "360J(4) Nominated service area—carrier licence conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360j-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
