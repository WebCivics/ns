      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffuses information about revocation of technical assistance notices.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If a technical assistance notice has been given to a person by the chief officer of an interception agency, and the chief officer is satisfied that: (a) the requirements imposed by the notice are not reasonable and proportionate; or (b) compliance with the notice is not: (i) practicable; and (ii) technically feasible;",
      "cml:conclusionText": "(the information about revocation notices)"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317r-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Reasoning",
      "cml:logicSummary": "Applies reasoning to determine revocation of technical assistance notices.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
