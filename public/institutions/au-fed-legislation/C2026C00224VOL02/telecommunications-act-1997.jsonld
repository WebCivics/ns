    {
      "@id": "concept:telecommunications-act-1997-sec-372j",
      "@type": "cml:Concept",
      "skos:prefLabel": "372J Acquisition of property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.288",
      "values:originalText": "This Subdivision does not apply to the extent that the operation of\nthe Subdivision would result in an acquisition of property (within\nthe meaning of paragraph 51(xxxi) of the Constitution) from a\nperson otherwise than on just terms (within the meaning of that\nparagraph).\nSubdivision C—Remedial notices",
      "skos:definition": "This Subdivision does not apply to the extent that the operation of\nthe Subdivision would result in an acquisition of property (within\nthe meaning of paragraph 51(xxxi) of the Constitution) from a\nperson otherwise than on just terms (within the meaning of that\nparagraph).\nSubdivision C—Remedial notices",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372j-norm"
        }
      ],
      "cml:integrityHash": "ea7b92b3582bb6d637025a0c3b5f97ecd0c2dadead9d72603ab7fa6bb6e8dbe5",
      "skos:note": "Acquisition of property exception"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372j",
      "@type": "cof:Section",
      "cof:title": "372J Acquisition of property",
      "values:kind": "section",
      "cof:pageNumber": 288,
      "values:originalText": "This Subdivision does not apply to the extent that the operation of\nthe Subdivision would result in an acquisition of property (within\nthe meaning of paragraph 51(xxxi) of the Constitution) from a\nperson otherwise than on just terms (within the meaning of that\nparagraph).\nSubdivision C—Remedial notices"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372j-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-372j"
      },
      "values:deonticStatus": {
