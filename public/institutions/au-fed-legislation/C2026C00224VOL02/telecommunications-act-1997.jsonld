    {
      "@id": "concept:telecommunications-act-1997-sec-418",
      "@type": "cml:Concept",
      "skos:prefLabel": "418 Cabling work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-418"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.349",
      "values:originalText": "A reference in this Division to cabling work is a reference to:\n\n(a) the installation of customer cabling for connection to a\ntelecommunications network or to a facility; or\n\n(b) the connection of customer cabling to a telecommunications\nnetwork or to a facility; or\n\n(c) the maintenance of customer cabling connected to a\ntelecommunications network or to a facility.",
      "skos:definition": "A reference in this Division to cabling work is a reference to:\n\n(a) the installation of customer cabling for connection to a\ntelecommunications network or to a facility; or\n\n(b) the connection of customer cabling to a telecommunications\nnetwork or to a facility; or\n\n(c) the maintenance of customer cabling connected to a\ntelecommunications network or to a facility.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-418-norm"
        }
      ],
      "cml:integrityHash": "671ac7c7fdfbd6ad1d1252981a9f41e0455c82aad6d19d44adcc49025efbdef2",
      "skos:note": "Definition of cabling work"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-418",
      "@type": "cof:Section",
      "cof:title": "418 Cabling work",
      "values:kind": "section",
      "cof:pageNumber": 349,
      "values:originalText": "A reference in this Division to cabling work is a reference to:\n\n(a) the installation of customer cabling for connection to a\ntelecommunications network or to a facility; or\n\n(b) the connection of customer cabling to a telecommunications\nnetwork or to a facility; or\n\n(c) the maintenance of customer cabling connected to a\ntelecommunications network or to a facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-418-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
