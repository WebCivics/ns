    {
      "@id": "concept:telecommunications-act-1997-sec-369",
      "@type": "cml:Concept",
      "skos:prefLabel": "369 Rules of Conduct to bind carriers and carriage service providers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-369"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.271",
      "values:originalText": "(1) This section applies to a person who is:\n\n(a) a carrier; or\n\n(b) a carriage service provider.\n\n(2) The person must comply with Rules of Conduct in force under\nsection 367.\n\n(3) If a provision of an agreement made by the person is inconsistent\nwith Rules of Conduct in force under section 367, the provision is\nunenforceable (see section 370).",
      "skos:definition": "(1) This section applies to a person who is:\n\n(a) a carrier; or\n\n(b) a carriage service provider.\n\n(2) The person must comply with Rules of Conduct in force under\nsection 367.\n\n(3) If a provision of an agreement made by the person is inconsistent\nwith Rules of Conduct in force under section 367, the provision is\nunenforceable (see section 370).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-369-ss-1"
        },
        {
