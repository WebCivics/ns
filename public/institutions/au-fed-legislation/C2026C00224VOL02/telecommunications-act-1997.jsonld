    {
      "@id": "concept:telecommunications-act-1997-sec-409",
      "@type": "cml:Concept",
      "skos:prefLabel": "409 Recognised testing authorities and competent bodies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-409"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.338",
      "values:originalText": "(1) The ACMA may, by notice published in the Gazette, determine\nthat a specified person or association is an accreditation body for\nthe purposes of this section. The determination has effect\naccordingly.\n\n(2) An accreditation body may, by written instrument, determine that a\nspecified person is a recognised testing authority for the purposes\nof this Division. The determination has effect accordingly.\n\n(3) An accreditation body may, by written instrument, determine that a\nspecified person or association is a competent body for the\npurposes of this Division. The determination has effect\naccordingly.",
      "skos:definition": "(1) The ACMA may, by notice published in the Gazette, determine\nthat a specified person or association is an accreditation body for\nthe purposes of this section. The determination has effect\naccordingly.\n\n(2) An accreditation body may, by written instrument, determine that a\nspecified person is a recognised testing authority for the purposes\nof this Division. The determination has effect accordingly.\n\n(3) An accreditation body may, by written instrument, determine that a\nspecified person or association is a competent body for the\npurposes of this Division. The determination has effect\naccordingly.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-409-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-409-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-409-ss-3"
        }
      ],
      "cml:integrityHash": "87b1d023b834cfee56d5879cbfdb5f71a90698c5074f2c717b1e523277aced33"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-409",
      "@type": "cof:Section",
      "cof:title": "409 Recognised testing authorities and competent bodies",
      "values:kind": "section",
      "cof:pageNumber": 338,
      "values:originalText": "(1) The ACMA may, by notice published in the Gazette, determine\nthat a specified person or association is an accreditation body for\nthe purposes of this section. The determination has effect\naccordingly.\n\n(2) An accreditation body may, by written instrument, determine that a\nspecified person is a recognised testing authority for the purposes\nof this Division. The determination has effect accordingly.\n\n(3) An accreditation body may, by written instrument, determine that a\nspecified person or association is a competent body for the\npurposes of this Division. The determination has effect\naccordingly."
    },
