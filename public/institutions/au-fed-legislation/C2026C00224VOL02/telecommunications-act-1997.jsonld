      "cml:premiseText": "Variation must not extend duration of technical capability notice"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317x-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "317X(5) Variation of technical capability notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317x-ss-5"
      },
      "cml:curationStatus": {
