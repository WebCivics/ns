    },
    {
      "@id": "concept:telecommunications-act-1997-sec-572j",
      "@type": "cml:Concept",
      "skos:prefLabel": "572J What happens if the penalty is paid",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.511",
      "values:originalText": "Scope\n\n(1) This section applies if:\n\n(a) an infringement notice relating to an alleged contravention is\ngiven to a person; and\n\n(b) the penalty is paid in accordance with the infringement\nnotice; and\n\n(c) the infringement notice is not withdrawn.\nWhat happens\n\n(2) Any liability of the person for the alleged contravention is\ndischarged.\n\n(3) Proceedings under Part 31 may not be brought against the person\nfor the alleged contravention.",
      "skos:definition": "Scope\n\n(1) This section applies if:\n\n(a) an infringement notice relating to an alleged contravention is\ngiven to a person; and\n\n(b) the penalty is paid in accordance with the infringement\nnotice; and\n\n(c) the infringement notice is not withdrawn.\nWhat happens\n\n(2) Any liability of the person for the alleged contravention is\ndischarged.\n\n(3) Proceedings under Part 31 may not be brought against the person\nfor the alleged contravention.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-572j-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-572j-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-572j-ss-3"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572j",
      "@type": "cof:Section",
      "cof:title": "572J What happens if the penalty is paid",
      "values:kind": "section",
      "cof:pageNumber": 511,
      "values:originalText": "Scope\n\n(1) This section applies if:\n\n(a) an infringement notice relating to an alleged contravention is\ngiven to a person; and\n\n(b) the penalty is paid in accordance with the infringement\nnotice; and\n\n(c) the infringement notice is not withdrawn.\nWhat happens\n\n(2) Any liability of the person for the alleged contravention is\ndischarged.\n\n(3) Proceedings under Part 31 may not be brought against the person\nfor the alleged contravention."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-572j-ss-1",
