    {
      "@id": "concept:telecommunications-act-1997-sec-360",
      "@type": "cml:Concept",
      "skos:prefLabel": "360 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.182",
      "values:originalText": "•\nThe statutory infrastructure provider for a service area must,\non reasonable request by a carriage service provider on behalf\nof an end-user at premises in the service area, connect the\npremises to a qualifying telecommunications network in order\nthat the carriage service provider can provide qualifying\ncarriage services to the end-user at the premises.\n•\nA statutory infrastructure provider must comply with\nstandards, benchmarks and rules determined by the Minister.\n•\nA statutory infrastructure provider must make available on its\nwebsite the terms and conditions on which it offers to:\n\n(a)\nconnect premises; or\n\n(b)\nsupply related eligible services to carriage service\nproviders.",
      "skos:definition": "•\nThe statutory infrastructure provider for a service area must,\non reasonable request by a carriage service provider on behalf\nof an end-user at premises in the service area, connect the\npremises to a qualifying telecommunications network in order\nthat the carriage service provider can provide qualifying\ncarriage services to the end-user at the premises.\n•\nA statutory infrastructure provider must comply with\nstandards, benchmarks and rules determined by the Minister.\n•\nA statutory infrastructure provider must make available on its\nwebsite the terms and conditions on which it offers to:\n\n(a)\nconnect premises; or\n\n(b)\nsupply related eligible services to carriage service\nproviders.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e127738e209cd19fe374bd7ba39c2984f267013db188186eb6ad79ec19908ba2",
      "skos:note": "Must connect premises to a qualifying telecommunications network",
      "dc:description": "Qualifying carriage services to the end-user at the premises"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360",
      "@type": "cof:Section",
      "cof:title": "360 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "•\nThe statutory infrastructure provider for a service area must,\non reasonable request by a carriage service provider on behalf\nof an end-user at premises in the service area, connect the\npremises to a qualifying telecommunications network in order\nthat the carriage service provider can provide qualifying\ncarriage services to the end-user at the premises.\n•\nA statutory infrastructure provider must comply with\nstandards, benchmarks and rules determined by the Minister.\n•\nA statutory infrastructure provider must make available on its\nwebsite the terms and conditions on which it offers to:\n\n(a)\nconnect premises; or\n\n(b)\nsupply related eligible services to carriage service\nproviders."
    },
