        }
      ],
      "cml:integrityHash": "e5279b26ea9832a3f5c8286d7e00203284bba8be86421be787f210b99007172b",
      "skos:note": "Facility must be installed in sufficient proximity to the building unit."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372y-ss-2",
      "@type": "cof:Section",
      "cof:title": "372Y(2) Installation of a fibre-ready facility in proximity to a building",
      "values:kind": "subsection",
      "cof:pageNumber": 306,
      "values:originalText": "(2) For the purposes of this Part, a fibre-ready facility used, or for use,\nin connection with a line is installed in proximity to a building unit\nif, and only if, it is installed in sufficient proximity to the building\nunit as to enable the line to be readily connected to the building\nunit."
    },
