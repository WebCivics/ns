      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.628",
      "values:originalText": "(6) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement.",
      "skos:definition": "(6) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581ze"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581ze-ss-6-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581ze-ss-6-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581ze-ss-6-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581ze-ss-6-logic-argumentation-3"
        }
      ],
      "cml:integrityHash": "e589da6c7ae29da807bc81b02381a5023ceaedce56e7522c4dafd87c78979290",
      "skos:note": "Agreement supersedes determination under this section to the extent of inconsistency."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581ze-ss-6",
      "@type": "cof:Section",
      "cof:title": "581ZE(6) Terms and conditions of access",
      "values:kind": "subsection",
      "cof:pageNumber": 628,
      "values:originalText": "(6) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement."
    },
