    {
      "@id": "concept:telecommunications-act-1997-sec-317u",
      "@type": "cml:Concept",
      "skos:prefLabel": "317U Compliance period etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
