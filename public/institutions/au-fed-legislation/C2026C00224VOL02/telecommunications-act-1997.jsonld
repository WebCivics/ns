    {
      "@id": "concept:telecommunications-act-1997-sec-360q-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "360Q(3) Obligation of statutory infrastructure provider to supply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360q-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
