          "@id": "concept:telecommunications-act-1997-sec-360xa-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360xa-ss-4"
        }
      ],
      "cml:integrityHash": "28c12d49be4c821a4cd34595da90584a8aeffc62da235c87e05ccda38856d8ca"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360xa",
