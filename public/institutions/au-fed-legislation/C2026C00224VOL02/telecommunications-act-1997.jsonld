    {
      "@id": "concept:telecommunications-act-1997-sec-565",
      "@type": "cml:Concept",
      "skos:prefLabel": "565 Interim injunctions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-565"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.494",
      "values:originalText": "Grant of interim injunction\n\n(1) If an application is made to the court for an injunction under\nsection 564, the court may, before considering the application,\ngrant an interim injunction restraining a person from engaging in\nconduct of a kind referred to in that section.\nNo undertakings as to damages\n\n(2) The court is not to require an applicant for an injunction under\nsection 564, as a condition of granting an interim injunction, to\ngive any undertakings as to damages.",
      "skos:definition": "Grant of interim injunction\n\n(1) If an application is made to the court for an injunction under\nsection 564, the court may, before considering the application,\ngrant an interim injunction restraining a person from engaging in\nconduct of a kind referred to in that section.\nNo undertakings as to damages\n\n(2) The court is not to require an applicant for an injunction under\nsection 564, as a condition of granting an interim injunction, to\ngive any undertakings as to damages.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-565-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-565-ss-2"
        }
      ],
      "cml:integrityHash": "9beac1fdff7184e5b8dd80a9cda75431e2d97127d85d1db6a8983c0d9c1636bf"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-565",
      "@type": "cof:Section",
      "cof:title": "565 Interim injunctions",
      "values:kind": "section",
      "cof:pageNumber": 494,
      "values:originalText": "Grant of interim injunction\n\n(1) If an application is made to the court for an injunction under\nsection 564, the court may, before considering the application,\ngrant an interim injunction restraining a person from engaging in\nconduct of a kind referred to in that section.\nNo undertakings as to damages\n\n(2) The court is not to require an applicant for an injunction under\nsection 564, as a condition of granting an interim injunction, to\ngive any undertakings as to damages."
    },
