        }
      ],
      "cml:integrityHash": "18d5d3c89323d1c86b067709b565739f0a8d7894ae95e63843427f67136ce754",
      "skos:note": "Do not apply a label before satisfying requirements. Manufacturer/importer cannot contravene requirements after label application"
    },
