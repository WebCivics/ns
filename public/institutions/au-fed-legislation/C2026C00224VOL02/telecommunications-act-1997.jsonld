      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.414",
      "values:originalText": "(7) The Chair of the ACMA may, in writing, delegate the Chair’s\npower under subsection (1) to a member of the ACMA staff who is\nan SES employee or acting SES employee.",
      "skos:definition": "(7) The Chair of the ACMA may, in writing, delegate the Chair’s\npower under subsection (1) to a member of the ACMA staff who is\nan SES employee or acting SES employee.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-484j"
      },
      "cml:asserts": [
