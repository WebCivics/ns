        }
      ],
      "cml:integrityHash": "44a6a8a5721d86b252e550a77e43c8e45b82849ab548297768fb904f8dcc2650",
      "skos:note": "Defines local access network for purposes of this section End-user requirements for domestic and international calls"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-349a-ss-4",
      "@type": "cof:Section",
      "cof:title": "349A(4) Local access line",
      "values:kind": "subsection",
      "cof:pageNumber": 174,
      "values:originalText": "(4) Each of the following is an example of an end-user’s requirements:\n\n(a) the end-user’s requirements relating to domestic\nlong-distance calls;\n\n(b) the end-user’s requirements relating to international calls."
    },
