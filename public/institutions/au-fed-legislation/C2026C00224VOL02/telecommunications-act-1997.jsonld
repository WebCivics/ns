      ],
      "cml:integrityHash": "6370a88a43d16228fab36d9896f340d2d168af5c743ba8ad4c17f768560c44ba",
      "skos:note": "Court may order person to comply with undertaking or pay compensation for breach."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572c-ss-2",
