      },
      "cml:premiseText": "Subsection (2) does not apply if the person has a reasonable excuse",
      "cml:conclusionText": "The exemption is based on a reasonable excuse, no further tracing required"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-413-ss-2a-logic-argumentation-4",
