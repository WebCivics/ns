      "@id": "concept:telecommunications-act-1997-sec-490-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "490(3) Written submissions and protection from civil actions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-490-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.422",
      "values:originalText": "(3) Civil proceedings do not lie against a person in respect of loss,\ndamage or injury of any kind suffered by another person because\nof the making in good faith of a statement, or the giving in good\nfaith of a document or information, to the ACMA in connection\nwith a public inquiry under this Division.",
      "skos:definition": "(3) Civil proceedings do not lie against a person in respect of loss,\ndamage or injury of any kind suffered by another person because\nof the making in good faith of a statement, or the giving in good\nfaith of a document or information, to the ACMA in connection\nwith a public inquiry under this Division.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-490"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-490-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-490-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "41d7d21b26ddf9eabc72638c8a2866fb917ebb8a816b80175ff9b9f32376b23f",
      "skos:note": "Protection from civil actions for making statements in good faith"
    },
