    {
      "@id": "concept:telecommunications-act-1997-sec-505-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "505(3) Reports on inquiries",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-505-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
