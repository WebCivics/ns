    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VD(6) Damages for breach of a designated compensable standard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vd-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.246",
      "values:originalText": "(6) The liability of the statutory infrastructure provider under this\nsection may be discharged:\n\n(a) by giving the customer a credit in an account the customer\nhas with the statutory infrastructure provider; or\n\n(b) in any other manner agreed between the statutory\ninfrastructure provider and the customer.",
      "skos:definition": "(6) The liability of the statutory infrastructure provider under this\nsection may be discharged:\n\n(a) by giving the customer a credit in an account the customer\nhas with the statutory infrastructure provider; or\n\n(b) in any other manner agreed between the statutory\ninfrastructure provider and the customer.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360vd"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360vd-ss-6-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360vd-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b73770188da6a5664eebdf701171eb85567628c21ae4b65b3a15b76c6545e4b2",
      "skos:note": "Discharge of liability through credit or agreement"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vd-ss-6",
      "@type": "cof:Section",
      "cof:title": "360VD(6) Damages for breach of a designated compensable standard",
      "values:kind": "subsection",
      "cof:pageNumber": 246,
      "values:originalText": "(6) The liability of the statutory infrastructure provider under this\nsection may be discharged:\n\n(a) by giving the customer a credit in an account the customer\nhas with the statutory infrastructure provider; or\n\n(b) in any other manner agreed between the statutory\ninfrastructure provider and the customer."
    },
