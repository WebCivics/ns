        }
      ],
      "cml:integrityHash": "4546dac7d193b86b60a2d1aed7b3fb98e9d8ca9ea870b0139b3c87a10e1246d6",
      "skos:note": "Must consider reasonable basis for dispute of liability"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ve-ss-2",
      "@type": "cof:Section",
      "cof:title": "360VE(2) Time for payment of damages",
      "values:kind": "subsection",
      "cof:pageNumber": 248,
      "values:originalText": "(2) In making a decision under subsection (1), the statutory\ninfrastructure provider must have regard to whether there is any\nreasonable basis for the statutory infrastructure provider to dispute\nthe liability."
    },
    {
