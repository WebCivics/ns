    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577p-ss-1a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between ownership and control",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the designated Telstra successor company legally or beneficially owns the network (whether alone or together with one or more other persons);",
      "cml:conclusionText": "The designated Telstra successor company's ownership of a network overlaps with its exercise of control."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577p-ss-1a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Repetition of ownership and control",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the designated Telstra successor company legally or beneficially owns the network (whether alone or together with one or more other persons);",
      "cml:conclusionText": "The designated Telstra successor company repeats its ownership of a network to exercise control."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577p-ss-1a-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of control through ownership",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a hybrid fibre-coaxial network; or (b) another telecommunications network;",
      "cml:conclusionText": "The designated Telstra successor company's ownership of a network diffuses its exercise of control."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577p-ss-1a-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "Recognition of ownership-based control",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the designated Telstra successor company legally or beneficially owns the network (whether alone or together with one or more other persons);",
      "cml:conclusionText": "The designated Telstra successor company recognizes its ownership as a basis for exercise of control."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-579",
      "@type": "cml:Concept",
      "skos:prefLabel": "579 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-579"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.591",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe ACMA is to have regard to certain international\nobligations when performing its telecommunications functions\nand exercising its telecommunications powers.\n•\nThe ACMA may give directions to a carrier or a service\nprovider in connection with the ACMA’s performance of its\ntelecommunications functions or the exercise of its\ntelecommunications powers.\n•\nThe eSafety Commissioner may give directions to a carrier or\na service provider in connection with the Commissioner’s\nperformance of his or her functions or the exercise of his or\nher powers.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nThe ACMA is to have regard to certain international\nobligations when performing its telecommunications functions\nand exercising its telecommunications powers.\n•\nThe ACMA may give directions to a carrier or a service\nprovider in connection with the ACMA’s performance of its\ntelecommunications functions or the exercise of its\ntelecommunications powers.\n•\nThe eSafety Commissioner may give directions to a carrier or\na service provider in connection with the Commissioner’s\nperformance of his or her functions or the exercise of his or\nher powers.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-579-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-579-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d25b895223bba65f071f31b1190f0b2b07c6a9eb7179b8ec5abf5af1332068a1",
      "skos:note": "ACMA must regard certain international obligations when performing its telecommunications functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-579",
      "@type": "cof:Section",
      "cof:title": "579 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 591,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe ACMA is to have regard to certain international\nobligations when performing its telecommunications functions\nand exercising its telecommunications powers.\n•\nThe ACMA may give directions to a carrier or a service\nprovider in connection with the ACMA’s performance of its\ntelecommunications functions or the exercise of its\ntelecommunications powers.\n•\nThe eSafety Commissioner may give directions to a carrier or\na service provider in connection with the Commissioner’s\nperformance of his or her functions or the exercise of his or\nher powers."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-579-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-579"
      },
