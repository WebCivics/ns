    {
      "@id": "concept:telecommunications-act-1997-sec-375",
      "@type": "cml:Concept",
      "skos:prefLabel": "375 Manager of network or facility",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-375"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.312",
      "values:originalText": "For the purposes of this Part, the manager of:\n\n(a) a telecommunications network; or\n\n(b) a facility of a telecommunications network;\nis the carrier, or carriage service provider, who operates the\nnetwork or facility, as the case may be.\n\n\nTechnical regulation  Part 21\nTechnical standards about customer equipment and customer cabling  Division 3\n\nSection 376\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "For the purposes of this Part, the manager of:\n\n(a) a telecommunications network; or\n\n(b) a facility of a telecommunications network;\nis the carrier, or carriage service provider, who operates the\nnetwork or facility, as the case may be.\n\n\nTechnical regulation  Part 21\nTechnical standards about customer equipment and customer cabling  Division 3\n\nSection 376\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-375-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-375-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-375-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-375-logic-argumentation-3"
        }
      ],
      "cml:integrityHash": "32c1757e666b13f92ff2681214e23719e52572a3f20104e6a2073e5079d77236",
      "skos:note": "Defines the manager of a telecommunications network or facility as the carrier or carriage service provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-375",
      "@type": "cof:Section",
      "cof:title": "375 Manager of network or facility",
      "values:kind": "section",
      "cof:pageNumber": 312,
      "values:originalText": "For the purposes of this Part, the manager of:\n\n(a) a telecommunications network; or\n\n(b) a facility of a telecommunications network;\nis the carrier, or carriage service provider, who operates the\nnetwork or facility, as the case may be.\n\n\nTechnical regulation  Part 21\nTechnical standards about customer equipment and customer cabling  Division 3\n\nSection 376\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-375-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-375"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-375-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Identifies the manager as a specific entity.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The manager is defined as the carrier or carriage service provider.",
      "cml:conclusionText": "The manager has an obligation to operate the network or facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-375-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Specifies the temporal relationship between the manager and the operation of the network or facility.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The manager operates the network or facility.",
      "cml:conclusionText": "The manager has a temporal relationship with the operation of the network or facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-375-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Suggests that the manager's role implies certain responsibilities.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The manager operates the network or facility.",
      "cml:conclusionText": "The manager has certain responsibilities."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-376",
      "@type": "cml:Concept",
      "skos:prefLabel": "376 ACMA’s power to make technical standards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-376"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.313",
      "values:originalText": "(1) The ACMA may, by legislative instrument, make a technical\nstandard relating to specified customer equipment or specified\ncustomer cabling.\n\n(2) Standards under this section are to consist only of such\nrequirements as are necessary or convenient for:\n\n(a) protecting the integrity of a telecommunications network or a\nfacility; or\n\n(b) protecting the health or safety of persons who:\n\n(i) operate; or\n\n(ii) work on; or\n\n(iii) use services supplied by means of; or\n\n(iv) are otherwise reasonably likely to be affected by the\noperation of;\n\na telecommunications network or a facility; or\n\n(c) ensuring that customer equipment can be used to give access\nto an emergency call service; or\n\n(d) ensuring, for the purpose of the supply of a standard\ntelephone service, the interoperability of customer equipment\nwith a telecommunications network to which the equipment\nis, or is proposed to be, connected; or\n\n(da) ensuring, for the purpose of the supply of a carriage service\nusing:\n\n(i) the national broadband network; or\n\n(ii) any other superfast telecommunications network;\n\nthe interoperability of customer equipment with such a\nnetwork; or\n\n(db) ensuring that customer equipment or customer cabling that is,\nor is proposed to be, connected to:\n\n(i) the national broadband network; or",
      "skos:definition": "(1) The ACMA may, by legislative instrument, make a technical\nstandard relating to specified customer equipment or specified\ncustomer cabling.\n\n(2) Standards under this section are to consist only of such\nrequirements as are necessary or convenient for:\n\n(a) protecting the integrity of a telecommunications network or a\nfacility; or\n\n(b) protecting the health or safety of persons who:\n\n(i) operate; or\n\n(ii) work on; or\n\n(iii) use services supplied by means of; or\n\n(iv) are otherwise reasonably likely to be affected by the\noperation of;\n\na telecommunications network or a facility; or\n\n(c) ensuring that customer equipment can be used to give access\nto an emergency call service; or\n\n(d) ensuring, for the purpose of the supply of a standard\ntelephone service, the interoperability of customer equipment\nwith a telecommunications network to which the equipment\nis, or is proposed to be, connected; or\n\n(da) ensuring, for the purpose of the supply of a carriage service\nusing:\n\n(i) the national broadband network; or\n\n(ii) any other superfast telecommunications network;\n\nthe interoperability of customer equipment with such a\nnetwork; or\n\n(db) ensuring that customer equipment or customer cabling that is,\nor is proposed to be, connected to:\n\n(i) the national broadband network; or",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-376-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-376-ss-2"
        }
      ],
      "cml:integrityHash": "43894c0ad38ef122525207f659c17c6b77b6cb57e5aed8ca9c362c51ae74c543"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-376",
      "@type": "cof:Section",
      "cof:title": "376 ACMA’s power to make technical standards",
      "values:kind": "section",
      "cof:pageNumber": 313,
      "values:originalText": "(1) The ACMA may, by legislative instrument, make a technical\nstandard relating to specified customer equipment or specified\ncustomer cabling.\n\n(2) Standards under this section are to consist only of such\nrequirements as are necessary or convenient for:\n\n(a) protecting the integrity of a telecommunications network or a\nfacility; or\n\n(b) protecting the health or safety of persons who:\n\n(i) operate; or\n\n(ii) work on; or\n\n(iii) use services supplied by means of; or\n\n(iv) are otherwise reasonably likely to be affected by the\noperation of;\n\na telecommunications network or a facility; or\n\n(c) ensuring that customer equipment can be used to give access\nto an emergency call service; or\n\n(d) ensuring, for the purpose of the supply of a standard\ntelephone service, the interoperability of customer equipment\nwith a telecommunications network to which the equipment\nis, or is proposed to be, connected; or\n\n(da) ensuring, for the purpose of the supply of a carriage service\nusing:\n\n(i) the national broadband network; or\n\n(ii) any other superfast telecommunications network;\n\nthe interoperability of customer equipment with such a\nnetwork; or\n\n(db) ensuring that customer equipment or customer cabling that is,\nor is proposed to be, connected to:\n\n(i) the national broadband network; or"
    },
