        }
      ],
      "cml:integrityHash": "0c3e44de329c1b0330d21af8a3d6a8cbf18aafd9a741ba7127681666318e9441",
      "skos:note": "List of officials who must provide variation requests"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ja-ss-8",
      "@type": "cof:Section",
      "cof:title": "317JA(8) Variation of technical assistance requests",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(8) If, under subsection (7):\n\n(a) the Director-General of Security; or\n\n(b) the Director-General of the Australian Secret Intelligence\nService; or\n\n(c) the Director-General of the Australian Signals Directorate; or\n\n(d) the chief officer of an interception agency;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317ja-ss-8-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
