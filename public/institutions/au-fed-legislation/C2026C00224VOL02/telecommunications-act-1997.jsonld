      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.452",
      "values:originalText": "A person is entitled to be paid by the ACMA reasonable\ncompensation for complying with a requirement covered by\nparagraph 521(2)(c) or 522(2)(c).",
