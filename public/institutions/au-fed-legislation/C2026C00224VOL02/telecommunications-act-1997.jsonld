      "cml:integrityHash": "ce7301a8b57720d0e31da6cbd6ce23957470143d759022ec94e5c7dff0864182",
      "skos:note": "Agreement must be about planning for network survivability or operational requirements in times of crisis."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-337-ss-2",
      "@type": "cof:Section",
      "cof:title": "337(2) Preparation of draft agreement",
      "values:kind": "subsection",
      "cof:pageNumber": 160,
      "values:originalText": "(2) The agreement must be about:\n\n(a) planning for network survivability; or\n\n(b) operational requirements in times of crisis;\nor both."
    },
