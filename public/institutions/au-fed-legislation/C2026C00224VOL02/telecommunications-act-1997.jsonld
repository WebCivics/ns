        }
      ],
      "cml:integrityHash": "3afe7d416ef33ae8c83c78d24260388e7bed719b1c29635270825a46b0f14875",
      "skos:note": "Regard must be had when determining technical feasibility"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372l-ss-5",
      "@type": "cof:Section",
      "cof:title": "372L(5) Third party access regime",
      "values:kind": "subsection",
      "cof:pageNumber": 295,
      "values:originalText": "(5) In determining whether compliance with subsection (2) in relation\nto a facility is technically feasible, the ACCC must have regard to:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372l-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
