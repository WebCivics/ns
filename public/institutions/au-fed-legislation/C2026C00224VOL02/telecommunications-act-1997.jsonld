      "cml:conclusionText": "Telstra must notify ACCC"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577ca-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "577CA(7) Acceptance of undertaking about hybrid fibre-coaxial",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577ca-ss-7"
      },
