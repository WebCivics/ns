      "cml:integrityHash": "114234f4527c14ea6c91d6c9d92c42f2530d700036172624b62d7b2c331a4701",
      "skos:note": "Decision on variation of undertaking about hybrid fibre-coaxial networks"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577d-ss-3",
      "@type": "cof:Section",
      "cof:title": "577D(3) Variation of undertaking about hybrid fibre-coaxial networks",
      "values:kind": "subsection",
      "cof:pageNumber": 566,
      "values:originalText": "(3) After considering the variation, the ACCC must decide to:\n\n(a) accept the variation; or\n\n(b) reject the variation."
    },
