    {
      "@id": "concept:telecommunications-act-1997-sec-317w-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "317W(8) Consultation about a proposal to give a technical capability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317w-ss-8"
      },
