      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Disclosure is a specific event.",
      "cml:conclusionText": "Publication would involve unreasonable disclosure of personal information if it diffuses the individual's information."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-517-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:logicSummary": "Recognition of personal information in publication",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Publication contains personal information.",
      "cml:conclusionText": "Publication would involve unreasonable disclosure of personal information if it recognizes the individual's identity."
    },
