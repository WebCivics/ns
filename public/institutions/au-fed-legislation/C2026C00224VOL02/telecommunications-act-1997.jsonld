    {
      "@id": "concept:telecommunications-act-1997-sec-372x",
      "@type": "cml:Concept",
      "skos:prefLabel": "372X Installation of a facility",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.305",
      "values:originalText": "For the purposes of this Part, install, in relation to a facility,\nincludes:\n\n(a) construct the facility on, over or under any land; and\n\n(b) attach the facility to any building or other structure.",
      "skos:definition": "For the purposes of this Part, install, in relation to a facility,\nincludes:\n\n(a) construct the facility on, over or under any land; and\n\n(b) attach the facility to any building or other structure.",
