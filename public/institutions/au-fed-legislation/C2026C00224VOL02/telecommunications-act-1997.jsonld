    {
      "@id": "concept:telecommunications-act-1997-sec-552",
      "@type": "cml:Concept",
      "skos:prefLabel": "552 Forfeited goods may be sold",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-552"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.484",
      "values:originalText": "A thing forfeited under section 551:\n\n(a) may be sold or otherwise disposed of in accordance with the\ndirections of the ACMA; and\n\n(b) pending such directions, must be kept in such custody as the\nACMA directs.\n\n\nEnforcement  Part 28\nFuture offences  Division 8\n\nSection 553\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "A thing forfeited under section 551:\n\n(a) may be sold or otherwise disposed of in accordance with the\ndirections of the ACMA; and\n\n(b) pending such directions, must be kept in such custody as the\nACMA directs.\n\n\nEnforcement  Part 28\nFuture offences  Division 8\n\nSection 553\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-552-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-552-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "acd6431c546adb9b25da00e1101ae4ba41d2dfed07144251c2cdb3f0a66d2ff1",
      "skos:note": "Goods may be sold or disposed of in accordance with ACMA directions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-552",
      "@type": "cof:Section",
      "cof:title": "552 Forfeited goods may be sold",
      "values:kind": "section",
      "cof:pageNumber": 484,
      "values:originalText": "A thing forfeited under section 551:\n\n(a) may be sold or otherwise disposed of in accordance with the\ndirections of the ACMA; and\n\n(b) pending such directions, must be kept in such custody as the\nACMA directs.\n\n\nEnforcement  Part 28\nFuture offences  Division 8\n\nSection 553\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
    {
