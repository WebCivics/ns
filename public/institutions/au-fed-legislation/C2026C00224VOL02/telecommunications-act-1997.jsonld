      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must notify ACMA",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581b",
      "@type": "cml:Concept",
      "skos:prefLabel": "581B Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.595",
      "values:originalText": "The object of this Part, when read together with various other\nprovisions of telecommunications laws that refer to a Telstra\nsuccessor company or a designated Telstra successor company, is\nto achieve regulatory equivalence between:\n\n(a) Telstra as it stood at the end of July 2021; and\n\n(b) companies that are the successors (whether immediate or\notherwise) of Telstra.",
      "skos:definition": "The object of this Part, when read together with various other\nprovisions of telecommunications laws that refer to a Telstra\nsuccessor company or a designated Telstra successor company, is\nto achieve regulatory equivalence between:\n\n(a) Telstra as it stood at the end of July 2021; and\n\n(b) companies that are the successors (whether immediate or\notherwise) of Telstra.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581b-norm"
        }
      ],
      "cml:integrityHash": "9e7728d1e77c7668a4b5b7ab92d18785cd1579cff8467ec0379a1d339c17965e",
      "skos:note": "Achieve regulatory equivalence between Telstra and its successors."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581b",
      "@type": "cof:Section",
      "cof:title": "581B Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 595,
      "values:originalText": "The object of this Part, when read together with various other\nprovisions of telecommunications laws that refer to a Telstra\nsuccessor company or a designated Telstra successor company, is\nto achieve regulatory equivalence between:\n\n(a) Telstra as it stood at the end of July 2021; and\n\n(b) companies that are the successors (whether immediate or\notherwise) of Telstra."
    },
    {
