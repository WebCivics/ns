    {
      "@id": "concept:telecommunications-act-1997-sec-360ac",
      "@type": "cml:Concept",
      "skos:prefLabel": "360AC Control",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ac"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.187",
      "values:originalText": "In this Part, control includes control as a result of, or by means of,\ntrusts, agreements, arrangements, understandings and practices,\nwhether or not having legal or equitable force and whether or not\nbased on legal or equitable rights.",
      "skos:definition": "In this Part, control includes control as a result of, or by means of,\ntrusts, agreements, arrangements, understandings and practices,\nwhether or not having legal or equitable force and whether or not\nbased on legal or equitable rights.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360ac-norm"
        }
      ],
      "cml:integrityHash": "9e799801377f454748498f614b1b43b8f6c7b5ae7b1343dff8beb9229b64e766",
      "skos:note": "Control includes control as a result of, or by means of, trusts, agreements, arrangements, understandings and practices."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ac",
      "@type": "cof:Section",
      "cof:title": "360AC Control",
      "values:kind": "section",
      "cof:pageNumber": 187,
      "values:originalText": "In this Part, control includes control as a result of, or by means of,\ntrusts, agreements, arrangements, understandings and practices,\nwhether or not having legal or equitable force and whether or not\nbased on legal or equitable rights."
    },
