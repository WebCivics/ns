      "cml:logicSummary": "Describes the scope of prohibited equipment or facilities.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the protection of the integrity of a telecommunications\nnetwork or of a facility;",
      "cml:conclusionText": "...prohibited customer equipment or prohibited"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-450-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Identifies temporal intervals where prohibited actions are applicable.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the protection of the health or safety of persons who...",
      "cml:conclusionText": "...who operate; or work on; or use services supplied by means of;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-450-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Describes a recurring pattern of prohibited actions.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) operate; or (ii) work on; or (iii) use services supplied by means of;",
      "cml:conclusionText": "...who are otherwise reasonably likely to be affected by the operation of;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-450-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Influence",
      "cml:logicSummary": "Describes how prohibited actions affect others.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iv) are otherwise reasonably likely to be affected by the\noperation of;",
      "cml:conclusionText": "...who operate; or work on; or use services supplied by means of;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-450-ss-2-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Analyze",
      "cml:logicSummary": "Analyzes the implications of prohibited actions.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Those reasons must relate to...",
      "cml:conclusionText": "...prohibited customer equipment or prohibited facilities."
    },
