    {
      "@id": "concept:telecommunications-act-1997-sec-433-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "433(5) Procedures for changing licence conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-433-ss-5"
