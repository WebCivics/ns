    {
      "@id": "concept:telecommunications-act-1997-sec-333",
      "@type": "cml:Concept",
      "skos:prefLabel": "333 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-333"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.157",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nA carriage service provider may be required to supply a\ncarriage service for defence purposes or for the management\nof natural disasters.\n•\nA carrier or carriage service provider may be required to enter\ninto an agreement with the Commonwealth about:\n\n(a)\nplanning for network survivability; or\n\n(b)\noperational requirements in times of crisis.\n•\nA carrier licence condition or a service provider rule may deal\nwith compliance with a disaster plan.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nA carriage service provider may be required to supply a\ncarriage service for defence purposes or for the management\nof natural disasters.\n•\nA carrier or carriage service provider may be required to enter\ninto an agreement with the Commonwealth about:\n\n(a)\nplanning for network survivability; or\n\n(b)\noperational requirements in times of crisis.\n•\nA carrier licence condition or a service provider rule may deal\nwith compliance with a disaster plan.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-333-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-333-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "18f959cb58181cff0f439cbad0ebef7e0f86dd56c85c1e9eefa0d46ba2434a8e",
      "skos:note": "Carriage service provider may be required to supply a carriage service for defence purposes or natural disasters."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-333",
      "@type": "cof:Section",
      "cof:title": "333 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 157,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nA carriage service provider may be required to supply a\ncarriage service for defence purposes or for the management\nof natural disasters.\n•\nA carrier or carriage service provider may be required to enter\ninto an agreement with the Commonwealth about:\n\n(a)\nplanning for network survivability; or\n\n(b)\noperational requirements in times of crisis.\n•\nA carrier licence condition or a service provider rule may deal\nwith compliance with a disaster plan."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-333-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-333"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-333-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to supply carriage service for defence purposes or natural disasters.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334",
      "@type": "cml:Concept",
      "skos:prefLabel": "334 Defence authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-334"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.157",
      "values:originalText": "For the purposes of this Part, a defence authority is:\n\n(a) the Secretary of the Defence Department; or\n\n(b) the Chief of the Defence Force.",
      "skos:definition": "For the purposes of this Part, a defence authority is:\n\n(a) the Secretary of the Defence Department; or\n\n(b) the Chief of the Defence Force.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-334-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-334-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-334-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-334-logic-argumentation-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-334-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-334-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "13f1998c9eb565e5543b58c0220b78567d4fdff219117fc6111e1ef35ceee972",
      "skos:note": "Definition of defence authority"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-334",
      "@type": "cof:Section",
      "cof:title": "334 Defence authority",
      "values:kind": "section",
      "cof:pageNumber": 157,
      "values:originalText": "For the purposes of this Part, a defence authority is:\n\n(a) the Secretary of the Defence Department; or\n\n(b) the Chief of the Defence Force."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-334-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
