    {
      "@id": "concept:telecommunications-act-1997-sec-492-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "492(4) Hearing to be in public except in exceptional cases",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-492-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
