    {
      "@id": "concept:telecommunications-act-1997-sec-396",
      "@type": "cml:Concept",
      "skos:prefLabel": "396 Nominees of holder",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-396"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.329",
      "values:originalText": "If the ACMA issues a connection permit, the persons nominated by\nthe holder are called the holder’s nominees.",
      "skos:definition": "If the ACMA issues a connection permit, the persons nominated by\nthe holder are called the holder’s nominees.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-396-norm"
        }
      ],
      "cml:integrityHash": "76ee054c581a25a6bcb9e629e89dcaead53c21ca783665924d24932c0587c52d",
      "skos:note": "The holder's nominees are called by the ACMA if a connection permit is issued."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-396",
      "@type": "cof:Section",
      "cof:title": "396 Nominees of holder",
      "values:kind": "section",
      "cof:pageNumber": 329,
      "values:originalText": "If the ACMA issues a connection permit, the persons nominated by\nthe holder are called the holder’s nominees."
    },
