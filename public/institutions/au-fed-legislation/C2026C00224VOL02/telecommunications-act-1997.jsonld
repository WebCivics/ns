      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 68 or 101 contravention",
      "cml:conclusionText": "No infringement notice"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-572d-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "572D(4) Simplified outline",
