    {
      "@id": "concept:telecommunications-act-1997-sec-372m-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "372M(5) Terms and conditions of access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372m-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.297",
      "values:originalText": "(5) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement.",
      "skos:definition": "(5) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-372m"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372m-ss-5-norm"
        }
      ],
      "cml:integrityHash": "e99a757c75c3d2454cfb8519c761c640d1cc5062925841b23b5e718965529189",
      "skos:note": "Determination under this section has no effect to the extent it is inconsistent with an agreement in writing."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372m-ss-5",
      "@type": "cof:Section",
      "cof:title": "372M(5) Terms and conditions of access",
      "values:kind": "subsection",
      "cof:pageNumber": 297,
      "values:originalText": "(5) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement."
    },
