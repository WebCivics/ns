    {
      "@id": "concept:telecommunications-act-1997-sec-378",
      "@type": "cml:Concept",
      "skos:prefLabel": "378 Procedures for making technical standards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-378"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
