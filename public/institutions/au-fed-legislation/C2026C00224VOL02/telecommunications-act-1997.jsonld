    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581y-ss-8",
      "@type": "cof:Section",
      "cof:title": "581Y(8) Access to supplementary facilities",
      "values:kind": "subsection",
      "cof:pageNumber": 620,
      "values:originalText": "(8) For the purposes of subsection (1), if:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581y-ss-8-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
