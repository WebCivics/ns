    },
    {
      "@id": "concept:telecommunications-act-1997-sec-572b-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "572B(6) Acceptance of undertakings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572b-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.502",
      "values:originalText": "(6) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) the Do Not Call Register Act 2006.",
      "skos:definition": "(6) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) the Do Not Call Register Act 2006.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-572b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-572b-ss-6-norm"
        }
      ],
      "cml:integrityHash": "b1d3619a22400458a8b95b16e3c1bf1edbfd26d74eb7fbb3f03a4156316d522a",
      "skos:note": "Includes specified Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572b-ss-6",
      "@type": "cof:Section",
      "cof:title": "572B(6) Acceptance of undertakings",
      "values:kind": "subsection",
      "cof:pageNumber": 502,
      "values:originalText": "(6) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) the Do Not Call Register Act 2006."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-572b-ss-6-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
