    {
      "@id": "concept:telecommunications-act-1997-sec-360n",
      "@type": "cml:Concept",
      "skos:prefLabel": "360N Exempt building redevelopment projects",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.221",
      "values:originalText": "Projects to be supplied with public mobile telecommunications\nservices\n\n(1) A building redevelopment project is exempt from\nsubsection 360H(4) if:\n\n(a) there is telecommunications network infrastructure installed\nwithin any part of, or in proximity to, the project area of the\nproject that will enable the supply of eligible services to\npremises in the whole of the project area of the project; and\n\n(b) the telecommunications network infrastructure was fully\ninstalled on or after 1 July 2020; and",
      "skos:definition": "Projects to be supplied with public mobile telecommunications\nservices\n\n(1) A building redevelopment project is exempt from\nsubsection 360H(4) if:\n\n(a) there is telecommunications network infrastructure installed\nwithin any part of, or in proximity to, the project area of the\nproject that will enable the supply of eligible services to\npremises in the whole of the project area of the project; and\n\n(b) the telecommunications network infrastructure was fully\ninstalled on or after 1 July 2020; and",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360n-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360n-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360n-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "93860ccae1b1755eba378884ca0914921016db82b3272aeb02ec42640fff9f67",
      "skos:note": "Building redevelopment projects must have telecommunications network infrastructure installed to supply public mobile telecommunications services."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360n",
      "@type": "cof:Section",
      "cof:title": "360N Exempt building redevelopment projects",
      "values:kind": "section",
      "cof:pageNumber": 221,
      "values:originalText": "Projects to be supplied with public mobile telecommunications\nservices\n\n(1) A building redevelopment project is exempt from\nsubsection 360H(4) if:\n\n(a) there is telecommunications network infrastructure installed\nwithin any part of, or in proximity to, the project area of the\nproject that will enable the supply of eligible services to\npremises in the whole of the project area of the project; and\n\n(b) the telecommunications network infrastructure was fully\ninstalled on or after 1 July 2020; and"
    },
