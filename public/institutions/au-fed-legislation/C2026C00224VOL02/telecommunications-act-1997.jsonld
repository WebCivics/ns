      "cml:logicSummary": "Prohibits agency from requesting or requiring a designated communications provider to do an act or thing for which the agency would be required to have or obtain a warrant or authorisation under other laws",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the Telecommunications (Interception and Access) Act 1979; (b) the Surveillance Devices Act 2004; (c) the Crimes Act 1914; (d) the Australian Security Intelligence Organisation Act 1979"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317zh-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits agency from requesting or requiring a designated communications provider to do an act or thing for which the agency would be required to have or obtain a warrant or authorisation under other laws of a State or Territory",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
