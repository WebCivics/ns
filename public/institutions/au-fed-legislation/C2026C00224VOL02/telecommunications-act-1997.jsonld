      },
      "cml:operator": "OR",
      "cml:logicSummary": "Magistrate may grant order if specified person is reasonably suspected of having been involved in breach",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There are reasonable grounds for suspecting a breach of the Spam Act 2003",
      "cml:conclusionText": "The specified person has relevant knowledge of measures applied to protect data held in, or accessible from, the computer"
    },
