      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.228",
      "values:originalText": "(3) An obligation does not arise under subsection (1) in relation to\nsupply of an eligible service in the circumstances (if any) specified\nin a determination under subsection (4).",
      "skos:definition": "(3) An obligation does not arise under subsection (1) in relation to\nsupply of an eligible service in the circumstances (if any) specified\nin a determination under subsection (4).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360q"
