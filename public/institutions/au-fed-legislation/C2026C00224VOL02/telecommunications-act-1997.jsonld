    {
      "@id": "concept:telecommunications-act-1997-sec-484j-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "484J(7) Automation of administrative action",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484j-ss-7"
      },
      "cml:curationStatus": {
