      "skos:note": "Must provide a copy of variation to designated provider",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317q-ss-7",
      "@type": "cof:Section",
      "cof:title": "317Q(7) Variation of technical assistance notices",
