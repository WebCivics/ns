    {
      "@id": "concept:telecommunications-act-1997-sec-544",
      "@type": "cml:Concept",
      "skos:prefLabel": "544 Evidence of commission of other offences against Part 21 of this",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-544"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.467",
      "values:originalText": "Act or other breaches of the Spam Act 2003\n\n(1) If:\n\n(a) in the course of searching, in accordance with a warrant\nissued under Division 3, for a particular thing in relation to a\nparticular offence, an inspector finds a thing that the\ninspector believes on reasonable grounds to be:\n\n(i) a thing that is connected with the offence, although not\nthe thing specified in the warrant; or\n\n(ii) a thing that is connected with another offence against",
      "skos:definition": "Act or other breaches of the Spam Act 2003\n\n(1) If:\n\n(a) in the course of searching, in accordance with a warrant\nissued under Division 3, for a particular thing in relation to a\nparticular offence, an inspector finds a thing that the\ninspector believes on reasonable grounds to be:\n\n(i) a thing that is connected with the offence, although not\nthe thing specified in the warrant; or\n\n(ii) a thing that is connected with another offence against",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-544-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-544-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fe3a04791e5cf74beeaa8dc000e58a819d3a92b67df2b55cb268553cf646ec34",
      "skos:note": "Requires inspector to believe on reasonable grounds that thing is connected with the offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-544",
      "@type": "cof:Section",
      "cof:title": "544 Evidence of commission of other offences against Part 21 of this",
      "values:kind": "section",
      "cof:pageNumber": 467,
      "values:originalText": "Act or other breaches of the Spam Act 2003\n\n(1) If:\n\n(a) in the course of searching, in accordance with a warrant\nissued under Division 3, for a particular thing in relation to a\nparticular offence, an inspector finds a thing that the\ninspector believes on reasonable grounds to be:\n\n(i) a thing that is connected with the offence, although not\nthe thing specified in the warrant; or\n\n(ii) a thing that is connected with another offence against"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-544-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-544"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
