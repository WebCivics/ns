        }
      ],
      "cml:integrityHash": "23b557511ae78d6aa7cac4da4ae4636631c0c0d334074be20c410feeeb69690e",
      "skos:note": "Entitlement to reasonable compensation for complying with a requirement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-523",
      "@type": "cof:Section",
      "cof:title": "523 Copying documents—reasonable compensation",
