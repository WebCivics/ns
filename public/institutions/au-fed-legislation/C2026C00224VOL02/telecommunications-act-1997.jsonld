      "@id": "concept:telecommunications-act-1997-sec-422-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must make representations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There was a period of at least 60 days during which the representations could be made.",
      "cml:conclusionText": "Representations must be made within this timeframe."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-422-ss-5-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT",
      "cml:logicSummary": "Must not have had an adequate opportunity to make representations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There was no period of at least 60 days during which the representations could be made.",
      "cml:conclusionText": "Representations were not made within this timeframe."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-422-ss-5-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Temporal interval for representation period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A period of at least 60 days is a temporal interval within which representations can be made.",
      "cml:conclusionText": "Representation periods are contained within this temporal interval."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-422-ss-5-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "NEXT",
      "cml:logicSummary": "Temporal relationship for representation periods",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A period of at least 60 days is the next temporal interval within which representations can be made.",
      "cml:conclusionText": "Representation periods are related to this temporal interval."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-422-ss-5-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS SPREAD BY",
      "cml:logicSummary": "Spread of representation periods",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A period of at least 60 days is spread by the diffusion of representations.",
      "cml:conclusionText": "Representation periods are spread by this temporal interval."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-423",
      "@type": "cml:Concept",
      "skos:prefLabel": "423 Application for cabling licence",
