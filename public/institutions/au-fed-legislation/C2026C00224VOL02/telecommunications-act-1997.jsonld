      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-577ca-ss-7-norm"
        }
      ],
      "cml:integrityHash": "0d8b7033cf0aa111a53a090bd6814a34aae0a7988a5d833bee840dd4368d7471",
      "skos:note": "Decision to accept an undertaking is subject to a specified event within a period."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577ca-ss-7",
      "@type": "cof:Section",
      "cof:title": "577CA(7) Acceptance of undertaking about hybrid fibre-coaxial",
      "values:kind": "subsection",
      "cof:pageNumber": 562,
      "values:originalText": "(7) If:\n\n(a) a decision to accept an undertaking under section 577C is\nexpressed to be subject to the occurrence of a single specified\nevent within a specified period; and"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577ca-ss-7-norm",
