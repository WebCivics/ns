    {
      "@id": "concept:telecommunications-act-1997-sec-317zq",
      "@type": "cml:Concept",
      "skos:prefLabel": "317ZQ Delegation by Director-General of the Australian Signals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317zq"
      },
      "cml:curationStatus": {
