      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) The ACMA must exercise its powers under subsection (1) in a manner consistent with directions given by the ACCC under subsection (4)",
      "cml:conclusionText": "by disseminating information about the exercise of powers under this section"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-474-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
