    {
      "@id": "concept:telecommunications-act-1997-sec-576",
      "@type": "cml:Concept",
      "skos:prefLabel": "576 Liability of persons other than corporations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-576"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.517",
      "values:originalText": "This section does not apply to proceedings for certain offences\n\n(1) This section does not apply to proceedings for:\n\n(a) an offence against section 42; or\n\n(b) an offence created by section 6 of the Crimes Act 1914 or",
      "skos:definition": "This section does not apply to proceedings for certain offences\n\n(1) This section does not apply to proceedings for:\n\n(a) an offence against section 42; or\n\n(b) an offence created by section 6 of the Crimes Act 1914 or",
      "cml:asserts": [
