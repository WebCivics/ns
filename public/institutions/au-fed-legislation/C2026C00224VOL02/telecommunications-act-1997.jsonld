      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Corporation has an obligation to prevent conduct of director, employee or agent within scope of actual or apparent authority.",
      "cml:executionSurface": "modalities::logic::deontic",
