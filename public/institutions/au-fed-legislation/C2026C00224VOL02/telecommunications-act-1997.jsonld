      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-427-ss-2-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-427-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-427-ss-2-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-427-ss-2-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "1416aec14a07d1235d7a504ceb700edbd9bacd49144a9fce59daebf300757990",
      "skos:note": "Granting of cabling licence requires applicant to have necessary knowledge and experience.",
      "dc:description": "(a) the applicant has the necessary knowledge and experience to perform cabling work of that type; (b) cabling work of that type performed in accordance with the conditions included in the licence would comply with standards in force under section 376; (c) the issue of the licence is not contrary to directions given by the Minister under section 440."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-427-ss-2",
      "@type": "cof:Section",
      "cof:title": "427(2) Grant of cabling licence",
      "values:kind": "subsection",
      "cof:pageNumber": 352,
      "values:originalText": "(2) The ACMA must not grant a cabling licence authorising the\nperformance of a particular type of cabling work unless it is\nsatisfied that:\n\n(a) the applicant has the necessary knowledge and experience to\nperform cabling work of that type; and\n\n(b) cabling work of that type performed in accordance with the\nconditions included in the licence would comply with\nstandards in force under section 376; and\n\n(c) the issue of the licence is not contrary to directions given by\nthe Minister under section 440."
    },
