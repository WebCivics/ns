      ],
      "cml:integrityHash": "f206f7ef1463b71217c17896afe8a2642485b9da672e1f56efa2bf04de31ec48",
      "skos:note": "Consultation required before giving technical assistance notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317pa",
      "@type": "cof:Section",
      "cof:title": "317PA Consultation about a proposal to give a technical assistance",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "notice\n\n(1) Before giving a technical assistance notice to a designated\ncommunications provider, the Director-General of Security or the\nchief officer of an interception agency, as the case requires, must\nconsult the provider."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317pa-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
