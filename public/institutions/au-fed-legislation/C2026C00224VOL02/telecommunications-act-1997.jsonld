      },
      "cml:premiseText": "(i) was available to the customer otherwise than under this Division",
      "cml:conclusionText": "(but not below zero)"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-4-logic-alleninterval-2",
