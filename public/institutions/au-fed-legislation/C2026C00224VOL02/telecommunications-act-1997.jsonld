      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits giving remedial notices if notice is no longer required.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a person has been given a remedial notice; and (b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required...",
      "cml:conclusionText": "...the ACMA must, by written notice given to the person, revoke the notice."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with compliance period for remedial notices.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required...",
      "cml:conclusionText": "...the ACMA must, by written notice given to the person, revoke the notice."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Recurring trace of revocation notices.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required...",
      "cml:conclusionText": "...the ACMA must, by written notice given to the person, revoke the notice."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffuses revocation notices throughout the compliance period.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required...",
      "cml:conclusionText": "...the ACMA must, by written notice given to the person, revoke the notice."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognize",
      "cml:logicSummary": "Recognizes revocation notices as those that are no longer required.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a person has been given a remedial notice; and (b) at a time during the compliance period for the notice, the ACMA forms a reasonable belief that the notice is no longer required...",
      "cml:conclusionText": "...the ACMA must, by written notice given to the person, revoke the notice."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "372JF(2) Revocation of remedial notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372jf-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.291",
      "values:originalText": "(2) In this section, compliance period means the period stated in the\nremedial notice under section 372JB, and includes that period as\nextended under section 372JD.",
      "skos:definition": "(2) In this section, compliance period means the period stated in the\nremedial notice under section 372JB, and includes that period as\nextended under section 372JD.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-372jf"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372jf-ss-2-norm"
        }
      ],
      "cml:integrityHash": "651926bcb37663367ae0500b15827524c7957b703f23fe1968faf0df22c60705",
      "skos:note": "Defines compliance period as stated in remedial notice under section 372JB, including extended periods under section 372JD."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372jf-ss-2",
      "@type": "cof:Section",
      "cof:title": "372JF(2) Revocation of remedial notices",
      "values:kind": "subsection",
      "cof:pageNumber": 291,
      "values:originalText": "(2) In this section, compliance period means the period stated in the\nremedial notice under section 372JB, and includes that period as\nextended under section 372JD."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jf-ss-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-372jf-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jg",
      "@type": "cml:Concept",
      "skos:prefLabel": "372JG Formal irregularities or defects in remedial notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372jg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.292",
      "values:originalText": "A remedial notice is not invalid only because of:\n\n(a) a formal defect or irregularity in the notice unless the defect\nor irregularity causes or is likely to cause substantial\ninjustice; or\n\n(b) a failure to use the correct name of the person to whom the\nnotice is issued if the notice sufficiently identifies the person.",
      "skos:definition": "A remedial notice is not invalid only because of:\n\n(a) a formal defect or irregularity in the notice unless the defect\nor irregularity causes or is likely to cause substantial\ninjustice; or\n\n(b) a failure to use the correct name of the person to whom the\nnotice is issued if the notice sufficiently identifies the person.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372jg-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372jg-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1159d368e02823975bd6491c54c443cf3387f483fc9ad40140b0f2785f61f92f",
      "skos:note": "A remedial notice is not invalid due to formal defects or irregularities unless they cause substantial injustice."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372jg",
      "@type": "cof:Section",
      "cof:title": "372JG Formal irregularities or defects in remedial notices",
      "values:kind": "section",
      "cof:pageNumber": 292,
      "values:originalText": "A remedial notice is not invalid only because of:\n\n(a) a formal defect or irregularity in the notice unless the defect\nor irregularity causes or is likely to cause substantial\ninjustice; or\n\n(b) a failure to use the correct name of the person to whom the\nnotice is issued if the notice sufficiently identifies the person."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372jg-norm",
