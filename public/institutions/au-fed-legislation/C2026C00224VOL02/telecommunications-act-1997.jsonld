        },
        {
          "@id": "concept:telecommunications-act-1997-sec-474-ss-6-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-474-ss-6-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "2d56a79d69f397fd4e875c4095c276538a3518ba2cba17c99610c733f0d51fa9",
      "skos:note": "The ACCC must not give a direction unless it is likely to have a bearing on competition or consumer protection."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-474-ss-6",
      "@type": "cof:Section",
      "cof:title": "474(6) Declared manager of electronic addressing",
