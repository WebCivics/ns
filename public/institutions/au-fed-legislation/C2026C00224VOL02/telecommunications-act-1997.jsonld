      "@id": "concept:telecommunications-act-1997-sec-452-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits supply of prohibited customer equipment or customer",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) In this section:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-452-ss-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Includes supply by way of sale, exchange, lease, hire, or hire-purchase",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "supply includes supply (including re-supply) by way of sale,\nexchange, lease, hire or hire-purchase."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-452-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Prohibition applies during operation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) In this section:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-453",
      "@type": "cml:Concept",
      "skos:prefLabel": "453 Pre-commencement labels",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-453"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.372",
      "values:originalText": "(1) This section applies if:\n\n(a) before the commencement of this section, customer\nequipment was labelled in accordance with a condition of a\nkind mentioned in paragraph 258(2)(a) of the\nTelecommunications Act 1991; and\n\n(b) the label embodied the protected symbol (within the meaning\nof section 402A of that Act).\n\n(2) This Part has effect as if:\n\n(a) at the time when the equipment was manufactured or\nimported, the manufacturer or importer had been required by\nsubsection 407(1) to apply the label to the equipment; and\n\n(b) the manufacturer or importer had complied with that\nrequirement by applying the label to the equipment; and\n\n(c) the label had indicated that the equipment met the\nrequirements of each of the section 376 standards that were\napplicable to the equipment when it was manufactured or\nimported.\n\n\nTechnical regulation  Part 21\nPenalties payable instead of prosecution  Division 13\n\nSection 453A\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "(1) This section applies if:\n\n(a) before the commencement of this section, customer\nequipment was labelled in accordance with a condition of a\nkind mentioned in paragraph 258(2)(a) of the\nTelecommunications Act 1991; and\n\n(b) the label embodied the protected symbol (within the meaning\nof section 402A of that Act).\n\n(2) This Part has effect as if:\n\n(a) at the time when the equipment was manufactured or\nimported, the manufacturer or importer had been required by\nsubsection 407(1) to apply the label to the equipment; and\n\n(b) the manufacturer or importer had complied with that\nrequirement by applying the label to the equipment; and\n\n(c) the label had indicated that the equipment met the\nrequirements of each of the section 376 standards that were\napplicable to the equipment when it was manufactured or\nimported.\n\n\nTechnical regulation  Part 21\nPenalties payable instead of prosecution  Division 13\n\nSection 453A\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-453-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-453-ss-2"
        }
      ],
      "cml:integrityHash": "43e38c35f2655f347cad6eebe93a936b311ebfd783d3ef081998516a0a4526b5"
    },
