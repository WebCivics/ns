        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581zd-ss-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f27908390ad3e3f0d439624058654f50c02e1595f33c91ac2ab95400cfde7811",
      "skos:note": "Requester must provide information about contingent provisions of a contract that have not come into force."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581zd-ss-9",
      "@type": "cof:Section",
      "cof:title": "581ZD(9) Access to telecommunications transmission towers",
      "values:kind": "subsection",
      "cof:pageNumber": 626,
      "values:originalText": "(9) If, at the time the request was made:\n\n(a) one or more provisions (the contingent provisions) of a\ncontract have not come into force because:"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581zd-ss-9-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581zd-ss-9"
