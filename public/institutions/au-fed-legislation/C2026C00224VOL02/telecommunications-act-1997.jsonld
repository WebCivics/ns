    {
      "@id": "concept:telecommunications-act-1997-sec-317jb-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "317JB(4) Revocation of technical assistance requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317jb-ss-4"
      },
      "cml:curationStatus": {
