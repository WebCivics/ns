        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is a carrier or carriage service provider.",
      "cml:conclusionText": "The person must comply with the requirements for a controlled facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-355-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal interval for installation completion",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Either the completion of the installation of the system occurred on or after 1 July 1997; or immediately before 1 July 1997, the system was capable of providing calling line identification.",
      "cml:conclusionText": "The installation completion meets the temporal interval."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-355-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "OR",
      "cml:logicSummary": "Alternative conditions for a controlled facility",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) the completion of the installation of the system occurred on or after 1 July 1997; or (ii) immediately before 1 July 1997, the system was capable of providing calling line identification.",
      "cml:conclusionText": "The person's controlled facility meets one of the alternative conditions."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-355-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
