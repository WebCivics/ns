        }
      ],
      "cml:integrityHash": "0ac09a7c77e7b9f8260b4d54f8daddaa3fa645a58ece2dfa7e332513f9783d71",
      "skos:note": "No obligation to supply eligible service under certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360q-ss-3",
      "@type": "cof:Section",
      "cof:title": "360Q(3) Obligation of statutory infrastructure provider to supply",
      "values:kind": "subsection",
      "cof:pageNumber": 228,
      "values:originalText": "(3) An obligation does not arise under subsection (1) in relation to\nsupply of an eligible service in the circumstances (if any) specified\nin a determination under subsection (4)."
