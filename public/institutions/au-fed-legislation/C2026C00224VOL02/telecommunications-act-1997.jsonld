    {
      "@id": "concept:telecommunications-act-1997-sec-344",
      "@type": "cml:Concept",
      "skos:prefLabel": "344 Designated disaster plans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-344"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.165",
      "values:originalText": "For the purposes of this Division, a designated disaster plan is a\nplan that:\n\n(a) is for coping with disasters and/or civil emergencies; and\n\n(b) is prepared by the Commonwealth, a State or a Territory.",
      "skos:definition": "For the purposes of this Division, a designated disaster plan is a\nplan that:\n\n(a) is for coping with disasters and/or civil emergencies; and\n\n(b) is prepared by the Commonwealth, a State or a Territory.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-344-norm"
        }
      ],
      "cml:integrityHash": "e628412ebc3385f78052a3953ee5e4b21bfb358becc3c0391ccd6ec60cf72621",
      "skos:note": "Definition of designated disaster plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-344",
      "@type": "cof:Section",
      "cof:title": "344 Designated disaster plans",
      "values:kind": "section",
      "cof:pageNumber": 165,
      "values:originalText": "For the purposes of this Division, a designated disaster plan is a\nplan that:\n\n(a) is for coping with disasters and/or civil emergencies; and\n\n(b) is prepared by the Commonwealth, a State or a Territory."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-344-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-344"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-345",
      "@type": "cml:Concept",
      "skos:prefLabel": "345 Carrier licence conditions about designated disaster plans",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-345"
