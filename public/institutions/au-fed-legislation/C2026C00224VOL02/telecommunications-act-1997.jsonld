        }
      ],
      "cml:integrityHash": "e0906cdf2fc87ea5aedf4207b321f96cd125d81b1b93c2fa816fd1a5ccaf6535",
      "skos:note": "Penalties payable instead of prosecution"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-453a-ss-2",
      "@type": "cof:Section",
      "cof:title": "453A(2) Penalties payable instead of prosecution",
      "values:kind": "subsection",
      "cof:pageNumber": 373,
      "values:originalText": "(2) The amount of penalty payable to the Commonwealth under\nregulations made for the purposes of subsection (1) in respect of an\noffence is determined using the following table:\n\nPenalties payable\n\nItem\nAlleged offence\nPenalty for\nindividual\nPenalty for body\ncorporate\nsubsection 399(1)\n12 penalty units\n60 penalty units\nsubsection 411(2)\n12 penalty units\n60 penalty units\nsubsection 413(2)\n12 penalty units\n60 penalty units\nsubsection 414(2)\n12 penalty units\n60 penalty units\nsubsection 415(2)\n12 penalty units\n60 penalty units\nsubsection 416(2)\n12 penalty units\n60 penalty units\nsubsection 417(2)\n6 penalty units\n30 penalty units\nsubsection 420(2)\n12 penalty units\n60 penalty units\nsubsection 421(4)\n12 penalty units\n60 penalty units\nsubsection 434(1) or (2)\n12 penalty units\n60 penalty units"
    },
