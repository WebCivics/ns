    {
      "@id": "concept:telecommunications-act-1997-sec-581k",
      "@type": "cml:Concept",
      "skos:prefLabel": "581K ACMA to maintain register of Telstra successor companies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581k"
      },
      "cml:curationStatus": {
