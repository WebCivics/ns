      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547f-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permissive",
      "cml:logicSummary": "Inspector has permission to deviate from subsection (1)",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes on reasonable grounds...",
      "cml:conclusionText": "Inspector is not required to comply with subsection (1)"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547f-ss-2-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Belief",
      "cml:logicSummary": "Inspector's belief is a sufficient condition for deviating from subsection (1)",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes on reasonable grounds...",
      "cml:conclusionText": "Inspector has reason to believe that immediate entry is required"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547f-ss-2-logic-ltl-3",
