    {
      "@id": "concept:telecommunications-act-1997-sec-581a",
      "@type": "cml:Concept",
      "skos:prefLabel": "581A Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.594",
      "values:originalText": "•\nThis Part sets out a mechanism for identifying Telstra\nsuccessor companies and designated Telstra successor\ncompanies.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company transfers the whole or part of a\ntelecommunications business, the company must notify the\nACMA of the transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company proposes to transfer the whole or part of a\nprescribed business and the transferee is not a constitutional\ncorporation, the company must notify the ACMA of the\nproposed transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company transfers a telecommunications asset, the\ncompany must notify the ACMA of the transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company proposes to transfer a prescribed asset and\nthe transferee is not a constitutional corporation, the company\nmust notify the ACMA of the proposed transfer.\nNote:\nCertain telecommunications laws impose obligations on, or in relation\nto, Telstra successor companies or designated Telstra successor\ncompanies.\n\n\nTelstra successor companies and designated Telstra successor companies  Part 34A\nIntroduction  Division 1\n\nSection 581B\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "•\nThis Part sets out a mechanism for identifying Telstra\nsuccessor companies and designated Telstra successor\ncompanies.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company transfers the whole or part of a\ntelecommunications business, the company must notify the\nACMA of the transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company proposes to transfer the whole or part of a\nprescribed business and the transferee is not a constitutional\ncorporation, the company must notify the ACMA of the\nproposed transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company transfers a telecommunications asset, the\ncompany must notify the ACMA of the transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company proposes to transfer a prescribed asset and\nthe transferee is not a constitutional corporation, the company\nmust notify the ACMA of the proposed transfer.\nNote:\nCertain telecommunications laws impose obligations on, or in relation\nto, Telstra successor companies or designated Telstra successor\ncompanies.\n\n\nTelstra successor companies and designated Telstra successor companies  Part 34A\nIntroduction  Division 1\n\nSection 581B\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581a-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f51a030be9390554d3f1897a42c64bba5c0702b93557598c7d721962acbf9141",
      "skos:note": "Notify ACMA of transfer of telecommunications business, assets, or proposed transfers"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581a",
      "@type": "cof:Section",
      "cof:title": "581A Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 594,
      "values:originalText": "•\nThis Part sets out a mechanism for identifying Telstra\nsuccessor companies and designated Telstra successor\ncompanies.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company transfers the whole or part of a\ntelecommunications business, the company must notify the\nACMA of the transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company proposes to transfer the whole or part of a\nprescribed business and the transferee is not a constitutional\ncorporation, the company must notify the ACMA of the\nproposed transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company transfers a telecommunications asset, the\ncompany must notify the ACMA of the transfer.\n•\nIf a Telstra successor company or a designated Telstra\nsuccessor company proposes to transfer a prescribed asset and\nthe transferee is not a constitutional corporation, the company\nmust notify the ACMA of the proposed transfer.\nNote:\nCertain telecommunications laws impose obligations on, or in relation\nto, Telstra successor companies or designated Telstra successor\ncompanies.\n\n\nTelstra successor companies and designated Telstra successor companies  Part 34A\nIntroduction  Division 1\n\nSection 581B\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581a"
      },
