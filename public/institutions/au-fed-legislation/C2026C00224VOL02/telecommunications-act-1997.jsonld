    {
      "@id": "concept:telecommunications-act-1997-sec-577ca-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "577CA(6) Acceptance of undertaking about hybrid fibre-coaxial",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577ca-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
