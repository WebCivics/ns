    {
      "@id": "concept:telecommunications-act-1997-sec-360vh",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VH Compensation rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vh"
      },
