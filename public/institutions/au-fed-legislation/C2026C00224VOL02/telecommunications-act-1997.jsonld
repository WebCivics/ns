    {
      "@id": "concept:telecommunications-act-1997-sec-340",
      "@type": "cml:Concept",
      "skos:prefLabel": "340 Compliance with agreement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-340"
