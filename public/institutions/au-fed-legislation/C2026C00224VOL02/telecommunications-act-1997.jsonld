      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.102",
      "values:originalText": "(3) If an approval under subparagraph (1)(a)(ii) is given orally, the\nMinister must:\n\n(a) make a written record of the approval; and\n\n(b) do so within 48 hours after the approval was given.",
      "skos:definition": "(3) If an approval under subparagraph (1)(a)(ii) is given orally, the\nMinister must:\n\n(a) make a written record of the approval; and\n\n(b) do so within 48 hours after the approval was given.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-317xa"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317xa-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317xa-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2f5b46e2eed32266494a58b1498889ae1cfb5b13483edf9adbb96e031324fdd1",
      "skos:note": "Minister must make a written record of oral approval within 48 hours.",
      "dc:description": "written record"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317xa-ss-3",
      "@type": "cof:Section",
      "cof:title": "317XA(3) Approval of variation of technical capability notice",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(3) If an approval under subparagraph (1)(a)(ii) is given orally, the\nMinister must:\n\n(a) make a written record of the approval; and\n\n(b) do so within 48 hours after the approval was given."
    },
