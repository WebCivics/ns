        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes on reasonable grounds...",
      "cml:conclusionText": "Inspector deviates from subsection (1)"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547f-ss-2-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Overlap",
      "cml:logicSummary": "Deviation from subsection (1) overlaps with the temporal interval of immediate entry",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
