    {
      "@id": "concept:telecommunications-act-1997-sec-572k",
      "@type": "cml:Concept",
      "skos:prefLabel": "572K Effect of this Part on civil proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.511",
      "values:originalText": "This Part does not:\n\n(a) require an infringement notice to be given in relation to an\nalleged contravention; or\n\n(b) affect the liability of a person to have proceedings under\nPart 31 brought against the person for an alleged\ncontravention if:",
      "skos:definition": "This Part does not:\n\n(a) require an infringement notice to be given in relation to an\nalleged contravention; or\n\n(b) affect the liability of a person to have proceedings under\nPart 31 brought against the person for an alleged\ncontravention if:",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-572k-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-572k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d6f93cc21ad4979e727a74109737f9bd4d10878b66b2310fb14b47433da95aec",
      "skos:note": "No infringement notice required for alleged contravention"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572k",
      "@type": "cof:Section",
      "cof:title": "572K Effect of this Part on civil proceedings",
      "values:kind": "section",
      "cof:pageNumber": 511,
      "values:originalText": "This Part does not:\n\n(a) require an infringement notice to be given in relation to an\nalleged contravention; or\n\n(b) affect the liability of a person to have proceedings under\nPart 31 brought against the person for an alleged\ncontravention if:"
    },
