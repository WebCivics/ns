      },
      "cml:premiseText": "Determination is inconsistent with agreement",
      "cml:conclusionText": "Agreement supersedes determination"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581ze-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
