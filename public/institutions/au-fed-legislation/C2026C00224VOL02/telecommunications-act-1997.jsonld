      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A technical assistance request that relates to an agency, or a technical assistance notice that relates to an agency, or a technical capability notice that relates to an agency"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317zh-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
