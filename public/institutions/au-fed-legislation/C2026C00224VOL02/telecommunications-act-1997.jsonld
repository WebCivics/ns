    {
      "@id": "concept:telecommunications-act-1997-sec-560",
      "@type": "cml:Concept",
      "skos:prefLabel": "560 Deadlines for reconsiderations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-560"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.488",
      "values:originalText": "(1) The ACMA must make its decision on reconsideration of a\ndecision within 90 days after receiving an application for\nreconsideration.\n\n(2) The ACMA is taken, for the purposes of this Part, to have made a\ndecision affirming the original decision if it has not informed the\napplicant of its decision on the reconsideration before the end of\nthe period of 90 days.",
      "skos:definition": "(1) The ACMA must make its decision on reconsideration of a\ndecision within 90 days after receiving an application for\nreconsideration.\n\n(2) The ACMA is taken, for the purposes of this Part, to have made a\ndecision affirming the original decision if it has not informed the\napplicant of its decision on the reconsideration before the end of\nthe period of 90 days.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-560-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-560-ss-2"
        }
      ],
      "cml:integrityHash": "8d25d182e72f4a258c572eed97fa4830b31c6685d7c17b0883def209130ece07"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-560",
      "@type": "cof:Section",
      "cof:title": "560 Deadlines for reconsiderations",
      "values:kind": "section",
      "cof:pageNumber": 488,
      "values:originalText": "(1) The ACMA must make its decision on reconsideration of a\ndecision within 90 days after receiving an application for\nreconsideration.\n\n(2) The ACMA is taken, for the purposes of this Part, to have made a\ndecision affirming the original decision if it has not informed the\napplicant of its decision on the reconsideration before the end of\nthe period of 90 days."
    },
