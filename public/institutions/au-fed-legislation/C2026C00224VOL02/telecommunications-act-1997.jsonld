      ],
      "cml:integrityHash": "7da58e8d76c21aa28ea98f7b7280c3eb5cb35f3b42050575f3ff57386ebc96f2",
      "skos:note": "Describes circumstances for making numbering plan in cases of urgency"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-461a-ss-2",
      "@type": "cof:Section",
      "cof:title": "461A(2) Making numbering plan in cases of urgency",
      "values:kind": "subsection",
      "cof:pageNumber": 385,
      "values:originalText": "(2) In the circumstances described in subsection (1):"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-461a-ss-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-461a-ss-2"
      },
      "values:deonticStatus": {
