      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The basic rule is that the hearing must take place in public.",
      "cml:conclusionText": "The hearing must take place in public."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-492-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Temporal interval of hearings",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The basic rule is that the hearing must take place in public.",
      "cml:conclusionText": "The hearing takes place within a specific temporal interval."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-492-ss-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Implication of hearings being in public on their validity",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The basic rule is that the hearing must take place in public.",
      "cml:conclusionText": "If the hearing takes place in public, it is valid."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-492-ss-2-logic-diffusion-4",
