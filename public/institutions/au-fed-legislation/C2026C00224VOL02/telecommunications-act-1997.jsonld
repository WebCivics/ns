    {
      "@id": "concept:telecommunications-act-1997-sec-502",
      "@type": "cml:Concept",
      "skos:prefLabel": "502 Hearing to be in public except in exceptional cases",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-502"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.430",
      "values:originalText": "(1) This section applies to a hearing conducted under this Division.\n\n(2) The basic rule is that the hearing must take place in public.\n\n(3) However, the hearing, or a part of the hearing, may be conducted\nin private if the ACCC is satisfied that:\n\n(a) evidence that may be given, or a matter that may arise, during\nthe hearing or a part of the hearing is of a confidential nature;\nor\n\n(b) hearing a matter, or part of a matter, in public would not be\nconducive to the due administration of this Act.\n\n(4) If the hearing is to be conducted in public, the ACCC must give\nreasonable public notice of the conduct of the hearing.\n\n(5) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999 and regulations under that Act; and\n\n(b) the Spam Act 2003 and regulations under that Act; and\n\n(c) the Do Not Call Register Act 2006 and regulations under that\nAct.",
      "skos:definition": "(1) This section applies to a hearing conducted under this Division.\n\n(2) The basic rule is that the hearing must take place in public.\n\n(3) However, the hearing, or a part of the hearing, may be conducted\nin private if the ACCC is satisfied that:\n\n(a) evidence that may be given, or a matter that may arise, during\nthe hearing or a part of the hearing is of a confidential nature;\nor\n\n(b) hearing a matter, or part of a matter, in public would not be\nconducive to the due administration of this Act.\n\n(4) If the hearing is to be conducted in public, the ACCC must give\nreasonable public notice of the conduct of the hearing.\n\n(5) In this section:\nthis Act includes:\n\n(a) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999 and regulations under that Act; and\n\n(b) the Spam Act 2003 and regulations under that Act; and\n\n(c) the Do Not Call Register Act 2006 and regulations under that\nAct.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-502-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-502-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-502-ss-3"
        },
