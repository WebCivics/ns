      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-419",
      "@type": "cml:Concept",
      "skos:prefLabel": "419 Types of cabling work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-419"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.349",
      "values:originalText": "(1) The ACMA may, by legislative instrument, declare that a specified\nkind of cabling work is a type of cabling work for the purposes of\nthis Division.\n\n(2) The declaration has effect accordingly.\n\n(3) For the purposes of this Division, the type of cabling work is to be\nascertained solely by reference to the declaration.",
      "skos:definition": "(1) The ACMA may, by legislative instrument, declare that a specified\nkind of cabling work is a type of cabling work for the purposes of\nthis Division.\n\n(2) The declaration has effect accordingly.\n\n(3) For the purposes of this Division, the type of cabling work is to be\nascertained solely by reference to the declaration.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-419-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-419-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-419-ss-3"
        }
      ],
      "cml:integrityHash": "bd75c326214907a39c8a5f55c30633e3773c3933658b9c22e5f1ddec3f72cacb"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-419",
      "@type": "cof:Section",
      "cof:title": "419 Types of cabling work",
      "values:kind": "section",
      "cof:pageNumber": 349,
      "values:originalText": "(1) The ACMA may, by legislative instrument, declare that a specified\nkind of cabling work is a type of cabling work for the purposes of\nthis Division.\n\n(2) The declaration has effect accordingly.\n\n(3) For the purposes of this Division, the type of cabling work is to be\nascertained solely by reference to the declaration."
    },
