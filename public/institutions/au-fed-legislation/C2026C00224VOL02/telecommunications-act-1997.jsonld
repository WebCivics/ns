    {
      "@id": "concept:telecommunications-act-1997-sec-317ta",
      "@type": "cml:Concept",
      "skos:prefLabel": "317TA Duration of technical capability notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ta"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.91",
      "values:originalText": "(1) A technical capability notice:\n\n(a) comes in force:\n\n(i) when it is given; or\n\n(ii) if a later time is specified in the notice—at that later\ntime; and\n\n(b) unless sooner revoked, remains in force:",
      "skos:definition": "(1) A technical capability notice:\n\n(a) comes in force:\n\n(i) when it is given; or\n\n(ii) if a later time is specified in the notice—at that later\ntime; and\n\n(b) unless sooner revoked, remains in force:",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317ta-norm"
        }
      ],
      "cml:integrityHash": "af36c5e60caf1fa797b0ee6a612f2d9fe911d0849bbf1b3899765fc40cd40481",
      "skos:note": "Notice remains in force unless revoked sooner"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ta",
      "@type": "cof:Section",
      "cof:title": "317TA Duration of technical capability notice",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "(1) A technical capability notice:\n\n(a) comes in force:\n\n(i) when it is given; or\n\n(ii) if a later time is specified in the notice—at that later\ntime; and\n\n(b) unless sooner revoked, remains in force:"
    },
