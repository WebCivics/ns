    {
      "@id": "concept:telecommunications-act-1997-sec-482",
      "@type": "cml:Concept",
      "skos:prefLabel": "482 Concurrent operation of State/Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-482"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.402",
      "values:originalText": "This Part does not prevent or limit the operation of a law of a State\nor Territory that is capable of operating concurrently with this Part.\n\n\nStandard agreements for the supply of carriage services  Part 23\n\nSection 483\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "This Part does not prevent or limit the operation of a law of a State\nor Territory that is capable of operating concurrently with this Part.\n\n\nStandard agreements for the supply of carriage services  Part 23\n\nSection 483\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-482-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-482-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2f35d90defb5de483b15339ff051c378bf4ad01d0a7c82b9118c1b016f184794",
      "skos:note": "No prohibition on concurrent operation of State/Territory laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-482",
      "@type": "cof:Section",
      "cof:title": "482 Concurrent operation of State/Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 402,
      "values:originalText": "This Part does not prevent or limit the operation of a law of a State\nor Territory that is capable of operating concurrently with this Part.\n\n\nStandard agreements for the supply of carriage services  Part 23\n\nSection 483\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
