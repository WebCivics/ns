    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577j-ss-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide a draft migration plan",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The undertaking requires Telstra to give the ACCC a draft migration plan",
      "cml:conclusionText": "Telstra must give the ACCC a draft migration plan"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577j-ss-2a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must have given the ACCC a draft migration plan",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "In accordance with the undertaking, Telstra has given the ACCC a draft migration plan",
      "cml:conclusionText": "Telstra must have given the ACCC a draft migration plan"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577j-ss-2a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must be approved by the ACCC",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The ACCC has approved the draft migration plan under section 577BD, 577BDA, 577BDB or 577BDC",
      "cml:conclusionText": "The ACCC must approve the draft migration plan"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577j-ss-2a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT",
      "cml:logicSummary": "Must not require Telstra to give the ACCC a draft migration plan",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The undertaking does not require Telstra to give the ACCC a draft migration plan",
      "cml:conclusionText": "The undertaking must not require Telstra to give the ACCC a draft migration plan"
    },
