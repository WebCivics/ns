      "values:originalText": "(4) An officer, employee or agent of the ACMA is not liable to an\naction or other proceeding for damages for or in relation to an act\ndone or omitted in good faith in connection with an act done or\nomitted by the ACMA as mentioned in subsection (3).",
      "skos:definition": "(4) An officer, employee or agent of the ACMA is not liable to an\naction or other proceeding for damages for or in relation to an act\ndone or omitted in good faith in connection with an act done or\nomitted by the ACMA as mentioned in subsection (3).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-312"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-312-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-312-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-312-ss-4-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "abc8c6bebe556600d7086d1ec1fd8bf047d2130c599e5fa1ec8e1a411357763b",
      "skos:note": "Protection from liability for actions in good faith by ACMA officers, employees, or agents."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-312-ss-4",
      "@type": "cof:Section",
      "cof:title": "312(4) ACMA’s obligations",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(4) An officer, employee or agent of the ACMA is not liable to an\naction or other proceeding for damages for or in relation to an act\ndone or omitted in good faith in connection with an act done or\nomitted by the ACMA as mentioned in subsection (3)."
    },
