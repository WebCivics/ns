      },
      "cml:operator": "CLASSIFICATION",
      "cml:logicSummary": "Classification of warrant requirements",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-542",
      "@type": "cml:Concept",
      "skos:prefLabel": "542 Searches and seizures",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-542"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.465",
      "values:originalText": "(1) This section applies if an inspector suspects on reasonable grounds\nthat there is on any land, or on or in any premises, vessel, aircraft\nor vehicle anything connected with:\n\n(a) a particular offence against Part 21 of this Act; or\n\n(b) a particular breach of the Spam Act 2003.\n\n(2) The inspector may, with the consent of the owner or occupier of\nthe land, premises, vessel, aircraft or vehicle, or in accordance with\na warrant issued under Division 3:",
      "skos:definition": "(1) This section applies if an inspector suspects on reasonable grounds\nthat there is on any land, or on or in any premises, vessel, aircraft\nor vehicle anything connected with:\n\n(a) a particular offence against Part 21 of this Act; or\n\n(b) a particular breach of the Spam Act 2003.\n\n(2) The inspector may, with the consent of the owner or occupier of\nthe land, premises, vessel, aircraft or vehicle, or in accordance with\na warrant issued under Division 3:",
