      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.424",
      "values:originalText": "(5) Subsections (3) and (4) do not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (5) (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "(5) Subsections (3) and (4) do not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (5) (see subsection 13.3(3) of the Criminal Code).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-493"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-493-ss-5-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-493-ss-5-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-493-ss-5-logic-epistemic-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-493-ss-5-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-493-ss-5-logic-deontic-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-493-ss-5-logic-argumentation-5"
        }
      ],
      "cml:integrityHash": "d3840e67813ecadce0b7285537efec5212e943e90608b87cc72a4a91b379537b",
      "skos:note": "A reasonable excuse excuses non-compliance with subsections (3) and (4)"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-493-ss-5",
      "@type": "cof:Section",
      "cof:title": "493(5) Confidential material not to be published",
      "values:kind": "subsection",
      "cof:pageNumber": 424,
      "values:originalText": "(5) Subsections (3) and (4) do not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (5) (see subsection 13.3(3) of the Criminal Code)."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-493-ss-5-norm",
