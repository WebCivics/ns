      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.352",
      "values:originalText": "An application must be accompanied by the charge (if any) fixed\nby a determination under section 60 of the Australian\nCommunications and Media Authority Act 2005.",
      "skos:definition": "An application must be accompanied by the charge (if any) fixed\nby a determination under section 60 of the Australian\nCommunications and Media Authority Act 2005.",
