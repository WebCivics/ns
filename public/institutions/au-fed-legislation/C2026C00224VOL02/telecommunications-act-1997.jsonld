    {
      "@id": "concept:telecommunications-act-1997-sec-435",
      "@type": "cml:Concept",
      "skos:prefLabel": "435 Formal warnings—breach of condition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-435"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.356",
      "values:originalText": "The ACMA may issue a formal warning if the holder of a cabling\nlicence contravenes a condition to which the licence is subject.",
      "skos:definition": "The ACMA may issue a formal warning if the holder of a cabling\nlicence contravenes a condition to which the licence is subject.",
