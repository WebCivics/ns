        }
      ],
      "cml:integrityHash": "43577fcce5575ae36257ea24edcc6150e0302f574afb421d6cb58c73291a891e",
      "skos:note": "Must consult carrier or provider concerned when preparing draft agreement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-337-ss-3",
      "@type": "cof:Section",
      "cof:title": "337(3) Preparation of draft agreement",
      "values:kind": "subsection",
      "cof:pageNumber": 160,
      "values:originalText": "(3) In preparing the draft agreement, the defence authority must\nconsult the carrier or provider concerned.\n\n\nDefence requirements and disaster plans  Part 16\nDefence planning  Division 3\n\nSection 338\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-337-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
