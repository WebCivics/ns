      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-557-ss-2",
      "@type": "cof:Section",
      "cof:title": "557(2) Statements to accompany notification of decisions",
      "values:kind": "subsection",
      "cof:pageNumber": 487,
      "values:originalText": "(2) Failure to comply with this section does not affect the validity of a\ndecision."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-557-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
