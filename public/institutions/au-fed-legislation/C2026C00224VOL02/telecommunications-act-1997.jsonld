      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Eligible company is a body corporate",
      "cml:conclusionText": "Eligible company is in a carrier company group"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581x-logic-descriptionlogic-2",
