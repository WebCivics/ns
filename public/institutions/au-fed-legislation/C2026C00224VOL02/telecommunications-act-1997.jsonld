      "cml:integrityHash": "2dd3f61dd61652dbf0ff567d78d3c85348b5fc123342442413d09bbd2cbc8391"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317u",
      "@type": "cof:Section",
      "cof:title": "317U Compliance period etc.",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "(1) A technical capability notice may require a specified act or thing to\nbe done within a specified period.\n\n(2) A technical capability notice may require a specified act or thing to\nbe done:\n\n(a) in a specified manner; or\n\n(b) in a way that meets one or more specified conditions.\n\n(3) Subsections (1) and (2) of this section do not limit\nsubsections 317T(1) and (2)."
    },
