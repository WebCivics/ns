    {
      "@id": "concept:telecommunications-act-1997-sec-317q-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "317Q(5) Variation of technical assistance notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317q-ss-5"
      },
      "cml:curationStatus": {
