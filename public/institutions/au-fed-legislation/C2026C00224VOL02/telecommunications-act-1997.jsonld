        {
          "@id": "concept:telecommunications-act-1997-sec-577f-ss-3c-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577f-ss-3c-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577f-ss-3c-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "15e8e94fa72f95d5ee7e09a1e06427a52ef8e7dc681f016a18238f9e4f36dd10",
      "skos:note": "Publish notice on website and invite submissions within 14 days",
      "dc:description": "Notice and submissions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577f-ss-3c",
      "@type": "cof:Section",
      "cof:title": "577F(3C) Variation of undertaking about subscription television",
      "values:kind": "subsection",
      "cof:pageNumber": 573,
      "values:originalText": "(3C) Before making or varying an instrument under subsection (3B), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577f-ss-3c-norm",
      "@type": "values:Obligation",
      "cml:modality": {
