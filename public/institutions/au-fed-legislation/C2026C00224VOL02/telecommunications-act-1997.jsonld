      },
      "cml:operator": "Between",
      "cml:logicSummary": "The provision specifies a temporal interval for the immunity",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) An officer, employee or agent of a carrier or of a carriage service provider is not liable to an action or other proceeding for damages for or in relation to an act done or omitted in good faith.",
      "cml:conclusionText": "The immunity applies between acts done in good faith"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-346a-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "ForAll",
      "cml:logicSummary": "The provision specifies a universal quantifier for the immunity",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) An officer, employee or agent of a carrier or of a carriage service provider is not liable to an action or other proceeding for damages for or in relation to an act done or omitted in good faith.",
      "cml:conclusionText": "For all officers, employees, and agents of carriers and carriage service providers, the immunity applies"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-346a-ss-2-logic-diffusion-4",
