      "cml:integrityHash": "6763bc3c9cb5c1ce9737d73b53c0e392e4719e89dab7d147a7987a3c4a76db3c",
      "skos:note": "Court may grant injunction if person has engaged in conduct or likely to engage"
    },
    {
