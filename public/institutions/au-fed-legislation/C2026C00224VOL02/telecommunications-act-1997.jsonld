          "@id": "concept:telecommunications-act-1997-sec-372l-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "75fffb9cb86dac10b3d627fb9860fb577a9dccc735f8c685f5b93ba134882338",
      "skos:note": "Facility owner/operator must provide access to carrier upon request.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372l-ss-2",
      "@type": "cof:Section",
      "cof:title": "372L(2) Third party access regime",
      "values:kind": "subsection",
      "cof:pageNumber": 295,
      "values:originalText": "(2) The owner or operator of the facility must, if requested to do so by\na carrier, give the carrier access to the facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372l-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
