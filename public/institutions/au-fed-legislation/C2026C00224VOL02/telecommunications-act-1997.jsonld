    {
      "@id": "concept:telecommunications-act-1997-sec-471-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If the Commonwealth is not liable to charge, then it cannot be taxed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commonwealth is not liable to charge.",
      "cml:conclusionText": "The Commonwealth cannot be taxed."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-471-ss-5-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "SubClassOf",
      "cml:logicSummary": "This section is a subclass of sections related to taxation.",
      "cml:executionSurface": "modalities::dl",
