    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581zd-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "581ZD(9) Access to telecommunications transmission towers",
      "cml:realizedBy": {
