      "skos:note": "Reference to use of a thing includes its use in isolation or conjunction with other things."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317d-ss-5",
      "@type": "cof:Section",
      "cof:title": "317D(5) Electronic service",
      "values:kind": "subsection",
