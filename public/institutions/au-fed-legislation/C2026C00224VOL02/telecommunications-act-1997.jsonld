      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.626",
      "values:originalText": "(9) If, at the time the request was made:\n\n(a) one or more provisions (the contingent provisions) of a\ncontract have not come into force because:",
      "skos:definition": "(9) If, at the time the request was made:\n\n(a) one or more provisions (the contingent provisions) of a\ncontract have not come into force because:",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581zd"
