    {
      "@id": "concept:telecommunications-act-1997-sec-425",
      "@type": "cml:Concept",
      "skos:prefLabel": "425 Application to be accompanied by charge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-425"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
