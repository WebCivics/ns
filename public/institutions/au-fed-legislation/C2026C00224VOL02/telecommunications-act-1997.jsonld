      "@type": "cml:Concept",
      "skos:prefLabel": "577E(6) Acceptance of undertaking about subscription television",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577e-ss-6"
