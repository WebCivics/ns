      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317s",
      "@type": "cml:Concept",
      "skos:prefLabel": "317S Attorney-General may determine procedures and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.86",
      "values:originalText": "arrangements relating to requests for technical capability\nnotices\n\n(1) The Attorney-General may, by writing, determine procedures and\narrangements to be followed in relation to the making of requests\nfor technical capability notices.\n\n(2) A procedure or arrangement determined under subsection (1) may\nrequire that the agreement of a person or body must be obtained\nbefore a request is made for a technical capability notice.\n\n(3) A failure to comply with a determination under subsection (1) does\nnot affect the validity of a technical capability notice.\n\n(4) A determination under subsection (1) is not a legislative\ninstrument.",
      "skos:definition": "arrangements relating to requests for technical capability\nnotices\n\n(1) The Attorney-General may, by writing, determine procedures and\narrangements to be followed in relation to the making of requests\nfor technical capability notices.\n\n(2) A procedure or arrangement determined under subsection (1) may\nrequire that the agreement of a person or body must be obtained\nbefore a request is made for a technical capability notice.\n\n(3) A failure to comply with a determination under subsection (1) does\nnot affect the validity of a technical capability notice.\n\n(4) A determination under subsection (1) is not a legislative\ninstrument.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317s-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317s-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317s-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317s-ss-4"
        }
      ],
      "cml:integrityHash": "073e8d2da99daea48ec4c69e6db6749a9720068a14d5af100f3df8c523d1caa9"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317s",
      "@type": "cof:Section",
      "cof:title": "317S Attorney-General may determine procedures and",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "arrangements relating to requests for technical capability\nnotices\n\n(1) The Attorney-General may, by writing, determine procedures and\narrangements to be followed in relation to the making of requests\nfor technical capability notices.\n\n(2) A procedure or arrangement determined under subsection (1) may\nrequire that the agreement of a person or body must be obtained\nbefore a request is made for a technical capability notice.\n\n(3) A failure to comply with a determination under subsection (1) does\nnot affect the validity of a technical capability notice.\n\n(4) A determination under subsection (1) is not a legislative\ninstrument."
    },
