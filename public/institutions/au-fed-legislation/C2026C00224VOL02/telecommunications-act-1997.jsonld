      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.331",
      "values:originalText": "The ACMA may issue a formal warning to the holder of a\nconnection permit if the holder, or a nominee of the holder,\ncontravenes a condition to which the permit is subject.",
      "skos:definition": "The ACMA may issue a formal warning to the holder of a\nconnection permit if the holder, or a nominee of the holder,\ncontravenes a condition to which the permit is subject.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-400-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-400-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "664e0fff6150100c8ad165bdaf80b8ac508981f5186ca664128c7353d25074a9",
      "skos:note": "ACMA may issue a formal warning for breaching permit conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-400",
