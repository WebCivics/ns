    {
      "@id": "concept:telecommunications-act-1997-sec-346a-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "Good faith is a necessary condition for immunity",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) An officer, employee or agent of a carrier or of a carriage service provider is not liable to an action or other proceeding for damages for or in relation to an act done or omitted in good faith.",
      "cml:conclusionText": "If the act was done in good faith, then the person is immune from liability"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-346a-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
