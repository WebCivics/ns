      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.403",
      "values:originalText": "This Part has no effect to the extent (if any) to which it is\ninconsistent with the Competition and Consumer Act 2010.",
      "skos:definition": "This Part has no effect to the extent (if any) to which it is\ninconsistent with the Competition and Consumer Act 2010.",
      "cml:asserts": [
        {
