    {
      "@id": "concept:telecommunications-act-1997-sec-372z-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "372Z(3) Sewerage services, electricity or water supplied to a building",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372z-ss-3"
