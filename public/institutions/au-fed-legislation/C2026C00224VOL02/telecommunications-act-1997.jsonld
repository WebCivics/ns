    },
    {
      "@id": "concept:telecommunications-act-1997-sec-572",
      "@type": "cml:Concept",
      "skos:prefLabel": "572 Criminal proceedings not to be brought for contravention of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-572"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.501",
      "values:originalText": "civil penalty provisions\n\nCriminal proceedings do not lie against a person only because the\nperson has contravened a civil penalty provision.",
      "skos:definition": "civil penalty provisions\n\nCriminal proceedings do not lie against a person only because the\nperson has contravened a civil penalty provision.",
