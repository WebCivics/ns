        }
      ],
      "cml:integrityHash": "8fb415000f9ae11797aca1b6e87f89909424114799ce63362a42cb711f578766",
      "skos:note": "The period specified in the notice may be shorter than 30 days if necessary due to urgent circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581tb-ss-7",
      "@type": "cof:Section",
      "cof:title": "581TB(7) Facilitation of obligations imposed on a named designated",
      "values:kind": "subsection",
      "cof:pageNumber": 614,
      "values:originalText": "(7) The period specified in the notice may be shorter than 30 days if\nthe Minister is satisfied that the shorter period is necessary due to\nurgent circumstances."
    },
