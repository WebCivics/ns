    {
      "@id": "concept:telecommunications-act-1997-sec-484d",
      "@type": "cml:Concept",
      "skos:prefLabel": "484D Definition of spoofing sender identification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.407",
      "values:originalText": "A sender identification is a spoofing sender identification if:\n\n(a) the sender identification is a message header that:\n\n(i) identifies, or purportedly identifies, an entity covered by\nsubsection 484F(2); or\n\n(ii) identifies, or purportedly identifies, a thing or matter;\nand\n\n(b) if that message header were used in a communication, that\nuse would be likely to cause a reasonable person to believe\nthat:\n\n(i) if subparagraph (a)(i) applies—the entity sent the\ncommunication or authorised the sending of the\ncommunication; or\n\n(ii) if subparagraph (a)(ii) applies—the purpose of the\ncommunication is to give information that is true in\nrelation to the thing or matter; and\n\n(c) that belief would be incorrect.",
      "skos:definition": "A sender identification is a spoofing sender identification if:\n\n(a) the sender identification is a message header that:\n\n(i) identifies, or purportedly identifies, an entity covered by\nsubsection 484F(2); or\n\n(ii) identifies, or purportedly identifies, a thing or matter;\nand\n\n(b) if that message header were used in a communication, that\nuse would be likely to cause a reasonable person to believe\nthat:\n\n(i) if subparagraph (a)(i) applies—the entity sent the\ncommunication or authorised the sending of the\ncommunication; or\n\n(ii) if subparagraph (a)(ii) applies—the purpose of the\ncommunication is to give information that is true in\nrelation to the thing or matter; and\n\n(c) that belief would be incorrect.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-484d-norm"
        }
      ],
      "cml:integrityHash": "77067d8f9de03f6c27908de890422c79ca0ef56b622b9ae7410e9966240c1bbc",
      "skos:note": "Definition of spoofing sender identification"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484d",
      "@type": "cof:Section",
      "cof:title": "484D Definition of spoofing sender identification",
      "values:kind": "section",
      "cof:pageNumber": 407,
      "values:originalText": "A sender identification is a spoofing sender identification if:\n\n(a) the sender identification is a message header that:\n\n(i) identifies, or purportedly identifies, an entity covered by\nsubsection 484F(2); or\n\n(ii) identifies, or purportedly identifies, a thing or matter;\nand\n\n(b) if that message header were used in a communication, that\nuse would be likely to cause a reasonable person to believe\nthat:\n\n(i) if subparagraph (a)(i) applies—the entity sent the\ncommunication or authorised the sending of the\ncommunication; or\n\n(ii) if subparagraph (a)(ii) applies—the purpose of the\ncommunication is to give information that is true in\nrelation to the thing or matter; and\n\n(c) that belief would be incorrect."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-484d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
