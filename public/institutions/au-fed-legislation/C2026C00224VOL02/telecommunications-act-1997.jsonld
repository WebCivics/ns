          "@id": "concept:telecommunications-act-1997-sec-528-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-528-ss-4"
        }
      ],
      "cml:integrityHash": "d35cae778213b95cf381699a3b9f5252b49fcc305021e6dead3effa6709976a2"
    },
    {
