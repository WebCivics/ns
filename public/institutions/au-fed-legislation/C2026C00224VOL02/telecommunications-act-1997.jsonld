    {
      "@id": "concept:telecommunications-act-1997-sec-581j",
      "@type": "cml:Concept",
      "skos:prefLabel": "581J Demerged Telstra company",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.601",
      "values:originalText": "For the purposes of this Act, each of the following companies is a\ndemerged Telstra company:\n\n(a) Telstra Group Limited (ACN 650 620 303), as the company\nexists from time to time (even if its name is later changed);\n\n(b) Telstra Infraco Limited (ACN 051 775 556), as the company\nexists from time to time (even if its name is later changed);\n\n(c) Amplitel Pty Ltd (ACN 648 133 073), as the company exists\nfrom time to time (even if its name is later changed);\n\n(d) Telstra Limited (ACN 086 174 781), as the company exists\nfrom time to time (even if its name is later changed).\nNote:\nSee also section 581U (transitional—references in legislation to\nTelstra Infraco Limited).",
      "skos:definition": "For the purposes of this Act, each of the following companies is a\ndemerged Telstra company:\n\n(a) Telstra Group Limited (ACN 650 620 303), as the company\nexists from time to time (even if its name is later changed);\n\n(b) Telstra Infraco Limited (ACN 051 775 556), as the company\nexists from time to time (even if its name is later changed);\n\n(c) Amplitel Pty Ltd (ACN 648 133 073), as the company exists\nfrom time to time (even if its name is later changed);\n\n(d) Telstra Limited (ACN 086 174 781), as the company exists\nfrom time to time (even if its name is later changed).\nNote:\nSee also section 581U (transitional—references in legislation to\nTelstra Infraco Limited).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581j-norm"
        }
      ],
      "cml:integrityHash": "8cb152c6f59a55dba4bbfa95fc9d62d6c8d12d0a77e54328702e1b90844dee2f",
      "skos:note": "List of demerged Telstra companies"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581j",
      "@type": "cof:Section",
      "cof:title": "581J Demerged Telstra company",
      "values:kind": "section",
      "cof:pageNumber": 601,
      "values:originalText": "For the purposes of this Act, each of the following companies is a\ndemerged Telstra company:\n\n(a) Telstra Group Limited (ACN 650 620 303), as the company\nexists from time to time (even if its name is later changed);\n\n(b) Telstra Infraco Limited (ACN 051 775 556), as the company\nexists from time to time (even if its name is later changed);\n\n(c) Amplitel Pty Ltd (ACN 648 133 073), as the company exists\nfrom time to time (even if its name is later changed);\n\n(d) Telstra Limited (ACN 086 174 781), as the company exists\nfrom time to time (even if its name is later changed).\nNote:\nSee also section 581U (transitional—references in legislation to\nTelstra Infraco Limited)."
    },
