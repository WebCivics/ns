    {
      "@id": "concept:telecommunications-act-1997-sec-317ma",
      "@type": "cml:Concept",
      "skos:prefLabel": "317MA Duration of technical assistance notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ma"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.77",
      "values:originalText": "(1) A technical assistance notice:\n\n(a) comes in force:\n\n(i) when it is given; or\n\n(ii) if a later time is specified in the notice—at that later\ntime; and\n\n(b) unless sooner revoked, remains in force:",
      "skos:definition": "(1) A technical assistance notice:\n\n(a) comes in force:\n\n(i) when it is given; or\n\n(ii) if a later time is specified in the notice—at that later\ntime; and\n\n(b) unless sooner revoked, remains in force:",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317ma-norm"
        }
      ],
      "cml:integrityHash": "20b96a69c194e92fc938440f59f801fc079c3e31a765a04ece9c6937e44db45c",
      "skos:note": "Technical assistance notice remains in force unless revoked sooner."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ma",
      "@type": "cof:Section",
      "cof:title": "317MA Duration of technical assistance notice",
      "values:kind": "section",
      "cof:pageNumber": 77,
      "values:originalText": "(1) A technical assistance notice:\n\n(a) comes in force:\n\n(i) when it is given; or\n\n(ii) if a later time is specified in the notice—at that later\ntime; and\n\n(b) unless sooner revoked, remains in force:"
    },
