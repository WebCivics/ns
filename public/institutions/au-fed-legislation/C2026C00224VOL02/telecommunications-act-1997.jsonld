      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372s",
      "@type": "cml:Concept",
      "skos:prefLabel": "372S Building units",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.303",
      "values:originalText": "Scope\n\n(1) This section applies to a building that has been, is being, or is to\nbe, constructed.\nBuilding units\n\n(2) For the purposes of this Act, if the whole of the building is, or is to\nbe, for single occupation or use, the building is a building unit.\n\n(3) For the purposes of this Act, if the whole or a part of the building\nis, or is to be, held as a unit under a strata title system (or a similar\nsystem) established under a law of a State or Territory, the whole\nor the part, as the case may be, of the building is a building unit.\n\n(4) For the purposes of this Act, if a part of the building is, or is to be,\nfor separate lease, that part of the building is a building unit.",
      "skos:definition": "Scope\n\n(1) This section applies to a building that has been, is being, or is to\nbe, constructed.\nBuilding units\n\n(2) For the purposes of this Act, if the whole of the building is, or is to\nbe, for single occupation or use, the building is a building unit.\n\n(3) For the purposes of this Act, if the whole or a part of the building\nis, or is to be, held as a unit under a strata title system (or a similar\nsystem) established under a law of a State or Territory, the whole\nor the part, as the case may be, of the building is a building unit.\n\n(4) For the purposes of this Act, if a part of the building is, or is to be,\nfor separate lease, that part of the building is a building unit.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372s-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372s-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372s-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372s-ss-4"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372s",
      "@type": "cof:Section",
      "cof:title": "372S Building units",
      "values:kind": "section",
      "cof:pageNumber": 303,
      "values:originalText": "Scope\n\n(1) This section applies to a building that has been, is being, or is to\nbe, constructed.\nBuilding units\n\n(2) For the purposes of this Act, if the whole of the building is, or is to\nbe, for single occupation or use, the building is a building unit.\n\n(3) For the purposes of this Act, if the whole or a part of the building\nis, or is to be, held as a unit under a strata title system (or a similar\nsystem) established under a law of a State or Territory, the whole\nor the part, as the case may be, of the building is a building unit.\n\n(4) For the purposes of this Act, if a part of the building is, or is to be,\nfor separate lease, that part of the building is a building unit."
    },
