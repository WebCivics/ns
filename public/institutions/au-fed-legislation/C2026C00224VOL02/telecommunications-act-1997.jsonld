      "cml:premiseText": "The reduced percentage has significant implications.",
      "cml:conclusionText": "Analyze the effects on section 46."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581x",
      "@type": "cml:Concept",
      "skos:prefLabel": "581X Eligible company",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.618",
      "values:originalText": "For the purposes of this Part, eligible company means a body\ncorporate that:\n\n(a) is in a carrier company group; and\n\n(b) is not a carrier.",
      "skos:definition": "For the purposes of this Part, eligible company means a body\ncorporate that:\n\n(a) is in a carrier company group; and\n\n(b) is not a carrier.",
      "cml:asserts": [
