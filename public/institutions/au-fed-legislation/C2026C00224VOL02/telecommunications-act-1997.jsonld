        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Portability is required to promote end-users' interests",
      "cml:conclusionText": "Must consider portability"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS_REQUIRED_FOR",
      "cml:logicSummary": "Portability is a requirement for promoting end-users' interests",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "End-users' interests are promoted by considering portability",
      "cml:conclusionText": "Portability is required"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-458-ss-5-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
