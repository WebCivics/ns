    {
      "@id": "concept:telecommunications-act-1997-sec-360a",
      "@type": "cml:Concept",
      "skos:prefLabel": "360A Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
