    {
      "@id": "concept:telecommunications-act-1997-sec-342",
      "@type": "cml:Concept",
      "skos:prefLabel": "342 Duration of agreement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-342"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.163",
      "values:originalText": "(1) If a certified agreement has been entered into, it remains in force\nuntil it is revoked under this section.\n\n(2) A certified agreement is revoked if the parties enter into a fresh\ncertified agreement that is expressed to replace the original\nagreement.\n\n(3) If the ACMA withdraws its certification of a certified agreement,\nthe agreement is revoked 60 days after the withdrawal.",
      "skos:definition": "(1) If a certified agreement has been entered into, it remains in force\nuntil it is revoked under this section.\n\n(2) A certified agreement is revoked if the parties enter into a fresh\ncertified agreement that is expressed to replace the original\nagreement.\n\n(3) If the ACMA withdraws its certification of a certified agreement,\nthe agreement is revoked 60 days after the withdrawal.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-342-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-342-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-342-ss-3"
        }
      ],
      "cml:integrityHash": "9fd726ed7df734dcde0f300459f78dedc7329f16550405bdf5e889bd9b2fb91e"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-342",
      "@type": "cof:Section",
      "cof:title": "342 Duration of agreement",
      "values:kind": "section",
      "cof:pageNumber": 163,
      "values:originalText": "(1) If a certified agreement has been entered into, it remains in force\nuntil it is revoked under this section.\n\n(2) A certified agreement is revoked if the parties enter into a fresh\ncertified agreement that is expressed to replace the original\nagreement.\n\n(3) If the ACMA withdraws its certification of a certified agreement,\nthe agreement is revoked 60 days after the withdrawal."
    },
