      "skos:note": "Investigations must be conducted as ACMA thinks fit."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-512-ss-2",
      "@type": "cof:Section",
      "cof:title": "512(2) Conduct of investigations",
      "values:kind": "subsection",
      "cof:pageNumber": 439,
      "values:originalText": "(2) An investigation under this Part is to be conducted as the ACMA\nthinks fit."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-512-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
