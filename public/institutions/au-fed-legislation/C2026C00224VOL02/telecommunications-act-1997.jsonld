        }
      ],
      "cml:integrityHash": "fbb0c8236e3efafa46753dcf41842f161a947f4ff7f9f39513f5742fc732fb48",
      "skos:note": "A reasonable excuse excuses non-compliance with subsection (2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-413-ss-2a",
      "@type": "cof:Section",
      "cof:title": "413(2A) Supply of unlabelled customer equipment or unlabelled",
      "values:kind": "subsection",
      "cof:pageNumber": 342,
      "values:originalText": "(2A) Subsection (2) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2A) (see subsection 13.3(3) of the Criminal Code)."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-413-ss-2a-norm",
