        },
        {
          "@id": "concept:telecommunications-act-1997-sec-347-ss-3-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "94e0e46ec45d606bbf3489f80e5290401a6e6a82f38f2f6d8239b0ab2484c0bb",
      "skos:note": "Defines senior rank for each military branch."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-347-ss-3",
      "@type": "cof:Section",
      "cof:title": "347(3) Delegation",
      "values:kind": "subsection",
      "cof:pageNumber": 167,
      "values:originalText": "(3) In this section:\nsenior rank means a rank not lower than:\n\n(a) in the case of the Royal Australian Navy—the rank of\nCommodore; or\n\n(b) in the case of the Australian Army—the rank of Brigadier; or\n\n(c) in the case of the Royal Australian Air Force—the rank of\nAir Commodore."
    },
