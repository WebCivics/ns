      },
      "dc:source": "telecommunications-act-1997.pdf, p.224",
      "values:originalText": "(2) An obligation does not arise under subsection (1) in relation to the\nconnection of premises in the circumstances (if any) specified in a\ndetermination under subsection (3).",
      "skos:definition": "(2) An obligation does not arise under subsection (1) in relation to the\nconnection of premises in the circumstances (if any) specified in a\ndetermination under subsection (3).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360p"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360p-ss-2-norm"
        }
      ],
      "cml:integrityHash": "aa4fd812c53d75db1b4a62f0ab9e76c68e19e5d691dbda5d4b35e9d5fae42377",
      "skos:note": "No obligation arises under subsection (1) in relation to the connection of premises if a determination under subsection (3) specifies circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360p-ss-2",
