    {
      "@id": "concept:telecommunications-act-1997-sec-346a",
      "@type": "cml:Concept",
      "skos:prefLabel": "346A Carrier and carriage service provider immunity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-346a"
      },
