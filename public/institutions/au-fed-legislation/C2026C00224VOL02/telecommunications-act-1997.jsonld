    {
      "@id": "concept:telecommunications-act-1997-sec-353-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "353(3) Use of over-ride dial codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-353-ss-3"
      },
      "cml:curationStatus": {
