    {
      "@id": "concept:telecommunications-act-1997-sec-317zt",
      "@type": "cml:Concept",
      "skos:prefLabel": "317ZT Alternative constitutional basis",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317zt"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
