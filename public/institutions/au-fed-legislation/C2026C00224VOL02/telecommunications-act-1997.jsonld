      },
      "cml:operator": "IS_DIFFUSED_TO",
      "cml:logicSummary": "Portability is diffused to promote end-users' interests",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "End-users' interests are promoted by considering portability",
      "cml:conclusionText": "Portability is diffused to promote end-users' interests"
    },
