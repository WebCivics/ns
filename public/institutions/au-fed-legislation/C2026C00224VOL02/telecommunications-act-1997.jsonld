    {
      "@id": "concept:telecommunications-act-1997-sec-454b",
      "@type": "cml:Concept",
      "skos:prefLabel": "454B No property rights in numbers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-454b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.375",
      "values:originalText": "Determination of a person as the numbering scheme manager does\nnot confer any property rights in numbers used in connection with\nthe supply of carriage services in Australia.",
      "skos:definition": "Determination of a person as the numbering scheme manager does\nnot confer any property rights in numbers used in connection with\nthe supply of carriage services in Australia.",
