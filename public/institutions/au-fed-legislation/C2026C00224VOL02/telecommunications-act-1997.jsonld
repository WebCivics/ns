    {
      "@id": "concept:telecommunications-act-1997-sec-394-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "394(2) Issue of connection permits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-394-ss-2"
      },
