        }
      ],
      "cml:integrityHash": "d6382144d847d07a4a60193309545b1573cee633696e53a4b99b02358cd4aa43",
      "skos:note": "Must provide information to person affected by decision",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-557-ss-1",
