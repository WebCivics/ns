    {
      "@id": "concept:telecommunications-act-1997-sec-581q",
      "@type": "cml:Concept",
      "skos:prefLabel": "581Q Transfer of an asset",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.609",
      "values:originalText": "For the purposes of this Part, a transfer of an asset occurs if:\n\n(a) the legal ownership of the asset is transferred in whole or in\npart; or",
      "skos:definition": "For the purposes of this Part, a transfer of an asset occurs if:\n\n(a) the legal ownership of the asset is transferred in whole or in\npart; or",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581q-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581q-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "55da5ae44b7e40f57c8a8e3ea4224b264d50cdee3d9604e224a8ccaa5c72fc79",
      "skos:note": "Transfer of asset requires whole or partial transfer of legal ownership."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581q",
