    {
      "@id": "concept:telecommunications-act-1997-sec-458-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "458(5) Numbering plan—rules about portability of allocated numbers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-458-ss-5"
      },
      "cml:curationStatus": {
