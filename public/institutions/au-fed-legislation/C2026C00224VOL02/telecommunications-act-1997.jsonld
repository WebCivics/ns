    {
      "@id": "concept:telecommunications-act-1997-sec-581zd-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "581ZD(7) Access to telecommunications transmission towers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581zd-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
