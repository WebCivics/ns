      "cml:integrityHash": "8d1095b22bfb0a4be82910bf714fc5fe83c3d83e12d3b9aa400caadef9ea4b76",
      "skos:note": "Chief officer must not give technical assistance notice without approval from AFP Commissioner."
    },
