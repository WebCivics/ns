    {
      "@id": "concept:telecommunications-act-1997-sec-483",
      "@type": "cml:Concept",
      "skos:prefLabel": "483 Competition and Consumer Act not affected by this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-483"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
