      },
      "dc:source": "telecommunications-act-1997.pdf, p.162",
      "values:originalText": "If:\n\n(a) a carrier; or\n\n(b) a carriage service provider;\nhas entered into a certified agreement, the carrier or provider, as\nthe case requires, must comply with the agreement, so long as the\nagreement remains in force.",
      "skos:definition": "If:\n\n(a) a carrier; or\n\n(b) a carriage service provider;\nhas entered into a certified agreement, the carrier or provider, as\nthe case requires, must comply with the agreement, so long as the\nagreement remains in force.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-340-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-340-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8bfe22ec5e2b5226e4e2df85cd197ae7fa501f97acce3738aae5845776418bbb",
      "skos:note": "Carrier or provider must comply with certified agreement while it remains in force."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-340",
      "@type": "cof:Section",
      "cof:title": "340 Compliance with agreement",
      "values:kind": "section",
      "cof:pageNumber": 162,
      "values:originalText": "If:\n\n(a) a carrier; or\n\n(b) a carriage service provider;\nhas entered into a certified agreement, the carrier or provider, as\nthe case requires, must comply with the agreement, so long as the\nagreement remains in force."
    },
