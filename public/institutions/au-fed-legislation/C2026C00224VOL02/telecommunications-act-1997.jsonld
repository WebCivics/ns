        }
      ],
      "cml:integrityHash": "c3ab4572a33a313757d5e4ad0988c2c53d20856f07d4908f2a0f95248075c91f",
      "skos:note": "No exclusion or limitation of State/Territory laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372zb",
      "@type": "cof:Section",
      "cof:title": "372ZB Concurrent operation of State and Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 308,
