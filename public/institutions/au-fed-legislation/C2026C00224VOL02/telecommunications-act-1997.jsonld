    {
      "@id": "concept:telecommunications-act-1997-sec-531",
      "@type": "cml:Concept",
      "skos:prefLabel": "531 Incorrect records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-531"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.456",
      "values:originalText": "(1) A person must not, in purported compliance with a requirement\nimposed by the record-keeping rules, make a record of any matter\nor thing in such a way that it does not correctly record the matter or\nthing.\n\n(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by a fine not exceeding 100 penalty units.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\n\nEnforcement  Part 28\nIntroduction  Division 1\n\nSection 532\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "(1) A person must not, in purported compliance with a requirement\nimposed by the record-keeping rules, make a record of any matter\nor thing in such a way that it does not correctly record the matter or\nthing.\n\n(2) A person who contravenes subsection (1) commits an offence\npunishable on conviction by a fine not exceeding 100 penalty units.\nNote:\nSee also sections 4AA and 4B of the Crimes Act 1914.\n\n\nEnforcement  Part 28\nIntroduction  Division 1\n\nSection 532\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-531-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-531-ss-2"
        }
      ],
      "cml:integrityHash": "897ea83d50404047bac0fa5a40985756a27ce4710568a107241cc8a2a8356ec7"
    },
    {
