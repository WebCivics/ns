    {
      "@id": "concept:telecommunications-act-1997-sec-574",
      "@type": "cml:Concept",
      "skos:prefLabel": "574 Proceedings under this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-574"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.515",
      "values:originalText": "A reference in this Part to a proceeding under this Act includes a\nreference to:\n\n(a) an action under this Act; and\n\n(b) a proceeding for an offence against:\n\n(i) this Act; or\n\n(ii) an offence created by section 6 of the Crimes Act 1914\nor Part 2.4 of the Criminal Code that relates to this Act.",
      "skos:definition": "A reference in this Part to a proceeding under this Act includes a\nreference to:\n\n(a) an action under this Act; and\n\n(b) a proceeding for an offence against:\n\n(i) this Act; or\n\n(ii) an offence created by section 6 of the Crimes Act 1914\nor Part 2.4 of the Criminal Code that relates to this Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-574-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-574-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-574-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "eca3e4dcb750ac1d11af560ed877446ef083c744aec011a04319eda29ae2505d",
      "skos:note": "References proceedings under this Act, including actions and offences."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-574",
      "@type": "cof:Section",
      "cof:title": "574 Proceedings under this Act",
      "values:kind": "section",
      "cof:pageNumber": 515,
      "values:originalText": "A reference in this Part to a proceeding under this Act includes a\nreference to:\n\n(a) an action under this Act; and\n\n(b) a proceeding for an offence against:\n\n(i) this Act; or\n\n(ii) an offence created by section 6 of the Crimes Act 1914\nor Part 2.4 of the Criminal Code that relates to this Act."
    },
