    },
    {
      "@id": "concept:telecommunications-act-1997-sec-403-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "403(5) Register of connection permits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-403-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.332",
      "values:originalText": "(5) If a person requests that a copy be provided in an electronic form,\nthe ACMA may provide the relevant information:\n\n(a) on a data processing device; or\n\n(b) by way of electronic transmission.\n\n\nTechnical regulation  Part 21\nConnection permits and connection rules  Division 6\n\nSection 404\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\nSubdivision B—Connection rules",
      "skos:definition": "(5) If a person requests that a copy be provided in an electronic form,\nthe ACMA may provide the relevant information:\n\n(a) on a data processing device; or\n\n(b) by way of electronic transmission.\n\n\nTechnical regulation  Part 21\nConnection permits and connection rules  Division 6\n\nSection 404\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\nSubdivision B—Connection rules",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-403"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-403-ss-5-norm"
        }
      ],
      "cml:integrityHash": "d3fa8f1f387c22644a4ccc7537f960b9ff89fab61a52eb59b470928e13767a33",
      "skos:note": "Request for electronic form of connection permit information"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-403-ss-5",
      "@type": "cof:Section",
      "cof:title": "403(5) Register of connection permits",
      "values:kind": "subsection",
      "cof:pageNumber": 332,
      "values:originalText": "(5) If a person requests that a copy be provided in an electronic form,\nthe ACMA may provide the relevant information:\n\n(a) on a data processing device; or\n\n(b) by way of electronic transmission.\n\n\nTechnical regulation  Part 21\nConnection permits and connection rules  Division 6\n\nSection 404\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\nSubdivision B—Connection rules"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-403-ss-5-norm",
