      "dc:source": "telecommunications-act-1997.pdf, p.568",
      "values:originalText": "(6) For the purposes of this section, the question of whether Telstra is\nin a position to exercise control of a subscription television\nbroadcasting licence is to be determined under Schedule 1 to the\nBroadcasting Services Act 1992.",
      "skos:definition": "(6) For the purposes of this section, the question of whether Telstra is\nin a position to exercise control of a subscription television\nbroadcasting licence is to be determined under Schedule 1 to the\nBroadcasting Services Act 1992.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-577e"
      },
