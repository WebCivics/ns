      "cml:integrityHash": "306e4dd969a1f79cbe674242f0ab4b1efb78f1d8d694d0c91a1e430cd85e3e9a",
      "skos:note": "Telstra cannot assign or deal with a spectrum licence in certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577l-ss-1",
      "@type": "cof:Section",
      "cof:title": "577L(1) Limits on assignment of certain spectrum licences to Telstra",
