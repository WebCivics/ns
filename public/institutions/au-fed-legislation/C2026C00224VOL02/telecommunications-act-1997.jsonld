    {
      "@id": "concept:telecommunications-act-1997-sec-347-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "347(3) Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-347-ss-3"
      },
