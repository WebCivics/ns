    {
      "@id": "concept:telecommunications-act-1997-sec-406",
      "@type": "cml:Concept",
      "skos:prefLabel": "406 Application of labels",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-406"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.335",
      "values:originalText": "(1) A reference in this Division to a label includes a reference to a\nstatement.\n\n(2) For the purposes of this Division, a label is taken to be applied to a\nthing if:\n\n(a) the label is affixed to the thing; or\n\n(b) the label is woven in, impressed on, worked into or annexed\nto the thing; or\n\n(c) the label is affixed to a container, covering, package, case,\nbox or other thing in or with which the first-mentioned thing\nis supplied; or\n\n(d) the label is affixed to, or incorporated in, an instruction or\nother document that accompanies the first-mentioned thing.",
      "skos:definition": "(1) A reference in this Division to a label includes a reference to a\nstatement.\n\n(2) For the purposes of this Division, a label is taken to be applied to a\nthing if:\n\n(a) the label is affixed to the thing; or\n\n(b) the label is woven in, impressed on, worked into or annexed\nto the thing; or\n\n(c) the label is affixed to a container, covering, package, case,\nbox or other thing in or with which the first-mentioned thing\nis supplied; or\n\n(d) the label is affixed to, or incorporated in, an instruction or\nother document that accompanies the first-mentioned thing.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-406-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-406-ss-2"
        }
      ],
      "cml:integrityHash": "e2c5a8651d602d2e38b9dde0fed28611d686fcb1620a29c58e03e107c0907f8c"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-406",
      "@type": "cof:Section",
      "cof:title": "406 Application of labels",
      "values:kind": "section",
      "cof:pageNumber": 335,
      "values:originalText": "(1) A reference in this Division to a label includes a reference to a\nstatement.\n\n(2) For the purposes of this Division, a label is taken to be applied to a\nthing if:\n\n(a) the label is affixed to the thing; or\n\n(b) the label is woven in, impressed on, worked into or annexed\nto the thing; or\n\n(c) the label is affixed to a container, covering, package, case,\nbox or other thing in or with which the first-mentioned thing\nis supplied; or\n\n(d) the label is affixed to, or incorporated in, an instruction or\nother document that accompanies the first-mentioned thing."
    },
