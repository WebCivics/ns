      ],
      "cml:integrityHash": "66a08f85d59508b9995d4209e2aca1c35e557ac66391d62b725270f4dc0c0e8e",
      "skos:note": "Inspector must announce authorization to enter premises and give opportunity for entry.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-547f-ss-1",
      "@type": "cof:Section",
      "cof:title": "547F(1) Announcement before entry",
      "values:kind": "subsection",
      "cof:pageNumber": 475,
      "values:originalText": "(1) An inspector must, before entering premises under a warrant under\nsection 547D:\n\n(a) announce that he or she is authorised to enter the premises;\nand\n\n(b) give any person at the premises an opportunity to allow entry\nto the premises."
    },
