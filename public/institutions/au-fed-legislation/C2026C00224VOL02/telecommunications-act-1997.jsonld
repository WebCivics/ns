    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-438-ss-2",
      "@type": "cof:Section",
      "cof:title": "438(2) Cancellation of cabling licence",
      "values:kind": "subsection",
      "cof:pageNumber": 357,
