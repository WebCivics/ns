    {
      "@id": "concept:telecommunications-act-1997-sec-510-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "510(3) Investigations by the ACMA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-510-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.438",
      "values:originalText": "(3) The ACMA must investigate:\n\n(a) a matter of a kind referred to in section 508; or\n\n(b) any other matter concerning carriage services or the\ntelecommunications industry;\nif the Minister requests the ACMA so to investigate.",
      "skos:definition": "(3) The ACMA must investigate:\n\n(a) a matter of a kind referred to in section 508; or\n\n(b) any other matter concerning carriage services or the\ntelecommunications industry;\nif the Minister requests the ACMA so to investigate.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-510"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-510-ss-3-norm"
