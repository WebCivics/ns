      "cml:integrityHash": "31dedaf03abc90e4a84c39081cf33d0aba68bc8b6d78978aa5d2e178e686e080",
      "skos:note": "Must have due regard to comments from interested persons."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581tb-ss-8",
      "@type": "cof:Section",
      "cof:title": "581TB(8) Facilitation of obligations imposed on a named designated",
      "values:kind": "subsection",
      "cof:pageNumber": 614,
      "values:originalText": "(8) If interested persons have given comments in accordance with a\nnotice under subsection (5), the Minister must have due regard to\nthose comments in giving or varying the direction."
    },
