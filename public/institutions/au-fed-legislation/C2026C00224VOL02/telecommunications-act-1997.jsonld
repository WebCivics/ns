    {
      "@id": "concept:telecommunications-act-1997-sec-313-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "313(3) Obligations of carriers and carriage service providers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-313-ss-3"
      },
