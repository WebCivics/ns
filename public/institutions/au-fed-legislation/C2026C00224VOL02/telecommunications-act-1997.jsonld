      "cml:operator": "Diffuses",
      "cml:logicSummary": "The provision diffuses the liability to other parties",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
