        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317ya-ss-4-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "3ef30696c042e9db8be904d510965977ee587cbf8b92f05af657ae51127cf594",
      "skos:note": "One of the assessors must have knowledge and security clearance to assess proposed technical capability notices."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ya-ss-4",
      "@type": "cof:Section",
      "cof:title": "317YA(4) Assessment and report",
      "values:kind": "subsection",
      "cof:pageNumber": 105,
      "values:originalText": "(4) One of the assessors must be a person who:\n\n(a) has knowledge that would enable the person to assess\nwhether proposed technical capability notices would\ncontravene section 317ZG; and\n\n(b) is cleared for security purposes to:\n\n(i) the highest level required by staff members of ASIO; or\n\n(ii) such lower level as the Attorney-General approves."
    },
