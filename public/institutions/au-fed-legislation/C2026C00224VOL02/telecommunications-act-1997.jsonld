    {
      "@id": "concept:telecommunications-act-1997-sec-317k",
      "@type": "cml:Concept",
      "skos:prefLabel": "317K Contract etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.72",
      "values:originalText": "Any of the following persons:\n\n(a) the Director-General of Security;\n\n(b) the Director-General of the Australian Secret Intelligence\nService;\n\n(c) the Director-General of the Australian Signals Directorate;\n\n(d) the chief officer of an interception agency;\nmay enter into a contract, agreement or arrangement with a\ndesignated communications provider in relation to acts or things\ndone by the provider in accordance with a technical assistance\nrequest.\n\n\nIndustry assistance  Part 15\nTechnical assistance notices  Division 3\n\nSection 317L\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "Any of the following persons:\n\n(a) the Director-General of Security;\n\n(b) the Director-General of the Australian Secret Intelligence\nService;\n\n(c) the Director-General of the Australian Signals Directorate;\n\n(d) the chief officer of an interception agency;\nmay enter into a contract, agreement or arrangement with a\ndesignated communications provider in relation to acts or things\ndone by the provider in accordance with a technical assistance\nrequest.\n\n\nIndustry assistance  Part 15\nTechnical assistance notices  Division 3\n\nSection 317L\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317k-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e8dba05979816079dfb698adce6532f8b14bc7011be0594ff1fea1d55d71d491",
      "skos:note": "Permits designated communications providers to enter into contracts with interception agencies."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317k",
      "@type": "cof:Section",
      "cof:title": "317K Contract etc.",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "Any of the following persons:\n\n(a) the Director-General of Security;\n\n(b) the Director-General of the Australian Secret Intelligence\nService;\n\n(c) the Director-General of the Australian Signals Directorate;\n\n(d) the chief officer of an interception agency;\nmay enter into a contract, agreement or arrangement with a\ndesignated communications provider in relation to acts or things\ndone by the provider in accordance with a technical assistance\nrequest.\n\n\nIndustry assistance  Part 15\nTechnical assistance notices  Division 3\n\nSection 317L\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317k-norm",
