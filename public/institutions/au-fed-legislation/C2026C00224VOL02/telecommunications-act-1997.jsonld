      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317r-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must notify Inspector-General of Intelligence and Security",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
