      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "occursBefore",
      "cml:logicSummary": "Contravention occurs before liability is incurred",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If: a statutory infrastructure provider contravenes a designated compensable rule; and the rule is made under subsection 360V(1); and the contravention relates to a particular customer;",
      "cml:conclusionText": "the contravention occurred before liability was incurred."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "permission",
      "cml:logicSummary": "Statutory infrastructure provider has permission to provide service",
