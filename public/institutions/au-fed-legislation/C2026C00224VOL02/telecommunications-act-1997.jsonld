      "skos:note": "Offence for contravening direction given under section 476(7)"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-476-ss-7",
      "@type": "cof:Section",
      "cof:title": "476(7) ACCC may give directions to declared manager of electronic",
      "values:kind": "subsection",
      "cof:pageNumber": 398,
      "values:originalText": "(7) A person commits an offence if:\n\n(a) the person has been given a direction under this section; and\n\n(b) the person engages in conduct; and\n\n(c) the person’s conduct contravenes the direction.\nPenalty: 10 penalty units."
    },
