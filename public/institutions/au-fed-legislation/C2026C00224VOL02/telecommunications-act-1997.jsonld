      },
      "cml:premiseText": "Arbitrator must not make a determination",
      "cml:conclusionText": "Determination would have the effect of..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581z-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Check for temporal overlap",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Final migration plan is in force",
      "cml:conclusionText": "Determination would have the effect of..."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581z-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "581Z(7) Terms and conditions of access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581z-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.622",
      "values:originalText": "(7) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement.",
      "skos:definition": "(7) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581z"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581z-ss-7-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581z-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa32bcdb4bf9c46e6ab702506c7678c8870f6dba46e92f817e4e829cfa276e2c",
      "skos:note": "Agreement takes precedence over legislative determination"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581z-ss-7",
      "@type": "cof:Section",
      "cof:title": "581Z(7) Terms and conditions of access",
      "values:kind": "subsection",
      "cof:pageNumber": 622,
      "values:originalText": "(7) If:\n\n(a) an agreement mentioned in paragraph (1)(a) is in force; and\n\n(b) the agreement is in writing;\na determination under this section has no effect to the extent to\nwhich it is inconsistent with the agreement."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581z-ss-7-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581z-ss-7"
      },
      "values:deonticStatus": {
