        }
      ],
      "cml:integrityHash": "00a4497c510990dea51a509c465f03f09034dc2702bbc18c6f869206a830116c",
      "skos:note": "Switching systems must provide calling line identification.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-354",
      "@type": "cof:Section",
      "cof:title": "354 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 180,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nCertain switching systems must be capable of providing\ncalling line identification."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-354-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-354"
      },
