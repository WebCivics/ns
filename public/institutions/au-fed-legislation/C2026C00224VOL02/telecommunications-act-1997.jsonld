    {
      "@id": "concept:telecommunications-act-1997-sec-372e-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "372E(5) Installation of fibre-ready facilities—building lots",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372e-ss-5"
      },
      "cml:curationStatus": {
