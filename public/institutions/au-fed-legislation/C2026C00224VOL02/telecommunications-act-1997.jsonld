    {
      "@id": "concept:telecommunications-act-1997-sec-484k-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "484K(2) Oversight and safeguards for automation of administrative",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484k-ss-2"
      },
