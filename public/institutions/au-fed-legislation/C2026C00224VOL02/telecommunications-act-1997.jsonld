    {
      "@id": "concept:telecommunications-act-1997-sec-476-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "476(7) ACCC may give directions to declared manager of electronic",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-476-ss-7"
      },
      "cml:curationStatus": {
