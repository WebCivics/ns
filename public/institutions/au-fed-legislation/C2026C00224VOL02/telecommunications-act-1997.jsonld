      },
      "cml:premiseText": "(5) The ACMA must exercise its powers under subsection (1)",
      "cml:conclusionText": "in a manner consistent with directions given by the ACCC under subsection (4)"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-474-ss-5-logic-alleninterval-2",
