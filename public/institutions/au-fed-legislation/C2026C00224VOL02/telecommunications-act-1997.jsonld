    {
      "@id": "concept:telecommunications-act-1997-sec-431",
      "@type": "cml:Concept",
      "skos:prefLabel": "431 Duration of cabling licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-431"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.354",
      "values:originalText": "A cabling licence comes into force when it is issued and remains in\nforce:\n\n(a) if the licence specifies a day of expiration—until the end of\nthat day; or\n\n(b) otherwise—indefinitely.",
      "skos:definition": "A cabling licence comes into force when it is issued and remains in\nforce:\n\n(a) if the licence specifies a day of expiration—until the end of\nthat day; or\n\n(b) otherwise—indefinitely.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-431-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-431-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f3e8944a7209cbe206c78a2e508740a8460e800ed0c66203375c4ec924b83372",
      "skos:note": "A cabling licence remains in force until its specified expiration day or indefinitely."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-431",
      "@type": "cof:Section",
      "cof:title": "431 Duration of cabling licence",
      "values:kind": "section",
      "cof:pageNumber": 354,
      "values:originalText": "A cabling licence comes into force when it is issued and remains in\nforce:\n\n(a) if the licence specifies a day of expiration—until the end of\nthat day; or\n\n(b) otherwise—indefinitely."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-431-norm",
      "@type": "values:Obligation",
