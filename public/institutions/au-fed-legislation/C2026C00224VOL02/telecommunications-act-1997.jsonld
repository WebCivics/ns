      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360c",
      "@type": "cml:Concept",
      "skos:prefLabel": "360C Service area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.191",
      "values:originalText": "For the purposes of this Part, service area means:\n\n(a) the general service area; or\n\n(b) a nominated service area; or\n\n(c) an anticipated service area; or\n\n(d) a designated service area.",
      "skos:definition": "For the purposes of this Part, service area means:\n\n(a) the general service area; or\n\n(b) a nominated service area; or\n\n(c) an anticipated service area; or\n\n(d) a designated service area.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360c-norm"
        }
      ],
      "cml:integrityHash": "d7bb439f99ccde1a7d5846a0bb685dc7b9f49d1fd2c25942d92ee75a9fda5f2c",
      "skos:note": "Definition of service area"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360c",
      "@type": "cof:Section",
      "cof:title": "360C Service area",
      "values:kind": "section",
      "cof:pageNumber": 191,
      "values:originalText": "For the purposes of this Part, service area means:\n\n(a) the general service area; or\n\n(b) a nominated service area; or\n\n(c) an anticipated service area; or\n\n(d) a designated service area."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360c-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360c"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360f",
      "@type": "cml:Concept",
      "skos:prefLabel": "360F General service area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.192",
      "values:originalText": "(1) For the purposes of this Part, the general service area means\nAustralia, other than:\n\n(a) a nominated service area; or\n\n(aa) a pending area (see subsection (2)); or\n\n(ab) an anticipated service area; or\n\n(b) a designated service area.\n\n(2) For the purposes of this section, if:\n\n(a) an area (the notice area) is specified in a notice under\nsection 360HA or 360HC; and\n\n(b) the notice area neither consists of, nor is included in:\n\n(i) a nominated service area; or\n\n(ii) a designated service area;\nthen:\n\n(c) if NBN Co provides qualifying carriage services to end-users\nat one or more premises in the area—so much of the notice\narea as does not include those premises is a pending area; or\n\n(d) in any other case—the notice area is a pending area.\nNote:\nFor anticipated service areas, see section 360KA.",
      "skos:definition": "(1) For the purposes of this Part, the general service area means\nAustralia, other than:\n\n(a) a nominated service area; or\n\n(aa) a pending area (see subsection (2)); or\n\n(ab) an anticipated service area; or\n\n(b) a designated service area.\n\n(2) For the purposes of this section, if:\n\n(a) an area (the notice area) is specified in a notice under\nsection 360HA or 360HC; and\n\n(b) the notice area neither consists of, nor is included in:\n\n(i) a nominated service area; or\n\n(ii) a designated service area;\nthen:\n\n(c) if NBN Co provides qualifying carriage services to end-users\nat one or more premises in the area—so much of the notice\narea as does not include those premises is a pending area; or\n\n(d) in any other case—the notice area is a pending area.\nNote:\nFor anticipated service areas, see section 360KA.",
