          "@id": "concept:telecommunications-act-1997-sec-577e-ss-4"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577e-ss-5"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577e-ss-6"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577e-ss-7"
        },
