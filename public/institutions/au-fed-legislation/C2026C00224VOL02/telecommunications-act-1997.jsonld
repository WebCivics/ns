    {
      "@id": "concept:telecommunications-act-1997-sec-16-ss-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(11) August 1996, the person:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-16-ss-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.346",
      "values:originalText": "(11) For the purposes of this section, a section 376 standard is taken to\nbe applicable in relation to customer equipment or customer\ncabling if, and only if, the standard was specified in the section 407\nrequirement that dealt with the manufacture or importation of the\nequipment or cabling.",
      "skos:definition": "(11) For the purposes of this section, a section 376 standard is taken to\nbe applicable in relation to customer equipment or customer\ncabling if, and only if, the standard was specified in the section 407\nrequirement that dealt with the manufacture or importation of the\nequipment or cabling.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-16"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-16-ss-11-norm"
        }
      ],
      "cml:integrityHash": "d3185539c932b799f2ee1ae5bbf8aa575827ad89f54302a9d252a892b14d69fa",
      "skos:note": "Standard applicability in relation to customer equipment or cabling"
    },
    {
