      "cml:integrityHash": "e8958dabbb357602a75a7c0a5b072bb5177a52fdaf1ccf4d0445a5567ba7a068",
      "skos:note": "Consult parties to agreement before certification"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-338-ss-5",
      "@type": "cof:Section",
      "cof:title": "338(5) ACMA’s certification of draft agreement",
      "values:kind": "subsection",
      "cof:pageNumber": 161,
      "values:originalText": "(5) In deciding whether to certify a draft agreement, the ACMA must\nconsult the parties to the agreement."
    },
