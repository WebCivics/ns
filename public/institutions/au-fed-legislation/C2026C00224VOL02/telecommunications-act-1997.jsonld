        }
      ],
      "cml:integrityHash": "31a333da7d501a2f5dd2cb41b4269105af755320a6bd670daac1754d1e11a1b0",
      "skos:note": "This Part has no effect on the Competition and Consumer Act 2010 to the extent it is inconsistent."
    },
    {
