      },
      "dc:source": "telecommunications-act-1997.pdf, p.68",
      "values:originalText": "(4) If a technical assistance request has been given to a person by the\nchief officer of an interception agency, the chief officer may, by\nwritten notice given to the person, revoke the request.",
      "skos:definition": "(4) If a technical assistance request has been given to a person by the\nchief officer of an interception agency, the chief officer may, by\nwritten notice given to the person, revoke the request.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-317jb"
      },
      "cml:asserts": [
