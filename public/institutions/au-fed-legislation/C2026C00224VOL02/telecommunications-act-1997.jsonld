      ],
      "cml:integrityHash": "9821dbb7bb705b8bef8214830a753c7f06ad88c9dd25780c721bbcccd1691382",
      "skos:note": "Customer's legal personal representative must be referenced in case of death."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ve-ss-6",
      "@type": "cof:Section",
      "cof:title": "360VE(6) Time for payment of damages",
      "values:kind": "subsection",
      "cof:pageNumber": 248,
      "values:originalText": "(6) If the customer is an individual and the customer dies, a reference\nin this section to the customer includes a reference to the legal\npersonal representative of the customer."
    },
