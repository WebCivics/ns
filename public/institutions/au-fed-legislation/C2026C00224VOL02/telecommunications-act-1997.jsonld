    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581d",
      "@type": "cml:Concept",
      "skos:prefLabel": "581D Telecommunications law",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.595",
      "values:originalText": "For the purposes of this Part, telecommunications law means:\n\n(a) this Act; or\n\n(b) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999; or\n\n(c) Part XIB of the Competition and Consumer Act 2010; or\n\n(d) Part XIC of the Competition and Consumer Act 2010; or\n\n(e) the Telstra Corporation Act 1991; or\n\n(f) an instrument made under or for the purposes of:\n\n(i) this Act; or\n\n(ii) the Telecommunications (Consumer Protection and\nService Standards) Act 1999; or\n\n(iii) Part XIB of the Competition and Consumer Act 2010; or\n\n(iv) Part XIC of the Competition and Consumer Act 2010; or\n\n(v) the Telstra Corporation Act 1991.",
      "skos:definition": "For the purposes of this Part, telecommunications law means:\n\n(a) this Act; or\n\n(b) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999; or\n\n(c) Part XIB of the Competition and Consumer Act 2010; or\n\n(d) Part XIC of the Competition and Consumer Act 2010; or\n\n(e) the Telstra Corporation Act 1991; or\n\n(f) an instrument made under or for the purposes of:\n\n(i) this Act; or\n\n(ii) the Telecommunications (Consumer Protection and\nService Standards) Act 1999; or\n\n(iii) Part XIB of the Competition and Consumer Act 2010; or\n\n(iv) Part XIC of the Competition and Consumer Act 2010; or\n\n(v) the Telstra Corporation Act 1991.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581d-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581d-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "94ec633e88d53deab8d9eb32b796da09c7b783c5708c0f9eecbcf16cb3f3bc12",
      "skos:note": "Definition of telecommunications law"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581d",
      "@type": "cof:Section",
      "cof:title": "581D Telecommunications law",
      "values:kind": "section",
      "cof:pageNumber": 595,
      "values:originalText": "For the purposes of this Part, telecommunications law means:\n\n(a) this Act; or\n\n(b) the Telecommunications (Consumer Protection and Service\nStandards) Act 1999; or\n\n(c) Part XIB of the Competition and Consumer Act 2010; or\n\n(d) Part XIC of the Competition and Consumer Act 2010; or\n\n(e) the Telstra Corporation Act 1991; or\n\n(f) an instrument made under or for the purposes of:\n\n(i) this Act; or\n\n(ii) the Telecommunications (Consumer Protection and\nService Standards) Act 1999; or\n\n(iii) Part XIB of the Competition and Consumer Act 2010; or\n\n(iv) Part XIC of the Competition and Consumer Act 2010; or\n\n(v) the Telstra Corporation Act 1991."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581d-norm",
