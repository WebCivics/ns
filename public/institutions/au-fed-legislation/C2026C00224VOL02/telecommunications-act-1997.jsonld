      "cml:operator": "Recognise",
      "cml:logicSummary": "Recognises the applicability of the excluded spectrum regime.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the excluded spectrum regime applies to Telstra; and (b) a spectrum licence relates to a designated part of the spectrum;",
      "cml:conclusionText": "The CogAI system recognises the applicability of the excluded spectrum regime."
    },
