    {
      "@id": "concept:telecommunications-act-1997-sec-393",
      "@type": "cml:Concept",
      "skos:prefLabel": "393 Further information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-393"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
