      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-508",
      "@type": "cml:Concept",
      "skos:prefLabel": "508 Matters to which this Part applies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-508"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.435",
      "values:originalText": "This Part applies to the following matters:\n\n(a) a contravention of this Act;\n\n(aa) a contravention of the Telecommunications (Consumer\nProtection and Service Standards) Act 1999 or regulations\nunder that Act;\n\n(ab) a contravention of the Spam Act 2003 or regulations under\nthat Act;\n\n(ac) a contravention of the Do Not Call Register Act 2006 or\nregulations under that Act;\n\n(b) a contravention of a code registered under Part 6;\n\n(c) a failure by a carriage service provider to comply with an\nobligation, or discharge a liability, under Part 5 of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999;\n\n(d) a matter relating to the supply of, or a refusal or failure to\nsupply, a carriage service;\n\n(e) a matter relating to the connection of, or a refusal or failure to\nconnect, customer equipment;\n\n(f) a matter relating to the performance of the ACMA’s\ntelecommunications functions, or the exercise of the\nACMA’s telecommunications powers;\nexcept to the extent (if any) to which the matter relates to the\ncontent of a content service.",
      "skos:definition": "This Part applies to the following matters:\n\n(a) a contravention of this Act;\n\n(aa) a contravention of the Telecommunications (Consumer\nProtection and Service Standards) Act 1999 or regulations\nunder that Act;\n\n(ab) a contravention of the Spam Act 2003 or regulations under\nthat Act;\n\n(ac) a contravention of the Do Not Call Register Act 2006 or\nregulations under that Act;\n\n(b) a contravention of a code registered under Part 6;\n\n(c) a failure by a carriage service provider to comply with an\nobligation, or discharge a liability, under Part 5 of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999;\n\n(d) a matter relating to the supply of, or a refusal or failure to\nsupply, a carriage service;\n\n(e) a matter relating to the connection of, or a refusal or failure to\nconnect, customer equipment;\n\n(f) a matter relating to the performance of the ACMA’s\ntelecommunications functions, or the exercise of the\nACMA’s telecommunications powers;\nexcept to the extent (if any) to which the matter relates to the\ncontent of a content service.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-508-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-508-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "07174e2a77740b9124f5ae3fb76f78d78910fbcad825b32159962f3e34dbd99f",
      "skos:note": "Matters to which this Part applies"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-508",
      "@type": "cof:Section",
      "cof:title": "508 Matters to which this Part applies",
      "values:kind": "section",
      "cof:pageNumber": 435,
      "values:originalText": "This Part applies to the following matters:\n\n(a) a contravention of this Act;\n\n(aa) a contravention of the Telecommunications (Consumer\nProtection and Service Standards) Act 1999 or regulations\nunder that Act;\n\n(ab) a contravention of the Spam Act 2003 or regulations under\nthat Act;\n\n(ac) a contravention of the Do Not Call Register Act 2006 or\nregulations under that Act;\n\n(b) a contravention of a code registered under Part 6;\n\n(c) a failure by a carriage service provider to comply with an\nobligation, or discharge a liability, under Part 5 of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999;\n\n(d) a matter relating to the supply of, or a refusal or failure to\nsupply, a carriage service;\n\n(e) a matter relating to the connection of, or a refusal or failure to\nconnect, customer equipment;\n\n(f) a matter relating to the performance of the ACMA’s\ntelecommunications functions, or the exercise of the\nACMA’s telecommunications powers;\nexcept to the extent (if any) to which the matter relates to the\ncontent of a content service."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-508-norm",
      "@type": "values:Obligation",
      "cml:modality": {
