    },
    {
      "@id": "concept:telecommunications-act-1997-sec-529-ss-2c-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Establishes ACMA's authority to create rules",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA has the power to regulate",
      "cml:conclusionText": "ACMA may make record-keeping rules"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-529-ss-2d",
      "@type": "cml:Concept",
      "skos:prefLabel": "529(2D) ACMA may make record-keeping rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-529-ss-2d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.455",
      "values:originalText": "(2D) The rules may provide for:\n\n(a) the preparation of reports as and when required by the\nACMA; or\n\n(b) the preparation of periodic reports relating to such regular\nintervals as are specified in the rules.",
      "skos:definition": "(2D) The rules may provide for:\n\n(a) the preparation of reports as and when required by the\nACMA; or\n\n(b) the preparation of periodic reports relating to such regular\nintervals as are specified in the rules.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-529"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-529-ss-2d-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-529-ss-2d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "24af79f056ecdeb8c5735706cba64168f5e79f1873cbfe1f53ab5801a25a8d86",
      "skos:note": "Rules for preparing reports as and when required by ACMA or at specified intervals."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-529-ss-2d",
      "@type": "cof:Section",
      "cof:title": "529(2D) ACMA may make record-keeping rules",
      "values:kind": "subsection",
      "cof:pageNumber": 455,
      "values:originalText": "(2D) The rules may provide for:\n\n(a) the preparation of reports as and when required by the\nACMA; or\n\n(b) the preparation of periodic reports relating to such regular\nintervals as are specified in the rules."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-529-ss-2d-norm",
