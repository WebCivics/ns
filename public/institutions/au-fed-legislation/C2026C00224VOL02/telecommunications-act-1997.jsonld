      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "ACMA must not delay decision",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Request for licence application",
      "cml:conclusionText": "Decision within 30 days"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-429",
      "@type": "cml:Concept",
      "skos:prefLabel": "429 Notification of refusal of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-429"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.354",
      "values:originalText": "If the ACMA decides to refuse to grant a cabling licence, the\nACMA must give written notice of the decision to the applicant.",
      "skos:definition": "If the ACMA decides to refuse to grant a cabling licence, the\nACMA must give written notice of the decision to the applicant.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-429-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-429-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "46dd3509d1c943b493473713dc31bd7f5c4c7c56c8bd2481a7b27cbf874d2050",
      "skos:note": "ACMA must give written notice of refusal decision to applicant."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-429",
      "@type": "cof:Section",
      "cof:title": "429 Notification of refusal of application",
      "values:kind": "section",
      "cof:pageNumber": 354,
      "values:originalText": "If the ACMA decides to refuse to grant a cabling licence, the\nACMA must give written notice of the decision to the applicant."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-429-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-429"
      },
