      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Classification of services based on telecommunications systems.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a designated communications provider supplies a particular kind of telecommunications service;"
    },
