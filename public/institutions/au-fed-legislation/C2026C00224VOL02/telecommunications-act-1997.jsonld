    {
      "@id": "concept:telecommunications-act-1997-sec-577e-ss-1c",
      "@type": "cml:Concept",
      "skos:prefLabel": "577E(1C) Acceptance of undertaking about subscription television",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577e-ss-1c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.568",
      "values:originalText": "(1C) Before making or varying an instrument under subsection (1B), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and\n\n(b) consider any submissions received within the 14-day period\nmentioned in paragraph (a).",
      "skos:definition": "(1C) Before making or varying an instrument under subsection (1B), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and\n\n(b) consider any submissions received within the 14-day period\nmentioned in paragraph (a).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-577e"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-577e-ss-1c-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-577e-ss-1c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "188d16446450ffc61f395922d82178f33c2b4b500a162c70fe997df23f22613f",
      "skos:note": "Publish notice on website and consider submissions within 14 days.",
      "dc:description": "Notice and submissions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577e-ss-1c",
      "@type": "cof:Section",
      "cof:title": "577E(1C) Acceptance of undertaking about subscription television",
      "values:kind": "subsection",
      "cof:pageNumber": 568,
      "values:originalText": "(1C) Before making or varying an instrument under subsection (1B), the\nMinister must:\n\n(a) cause to be published on the Department’s website a notice:\n\n(i) setting out the draft instrument or variation; and\n\n(ii) inviting persons to make submissions to the Minister\nabout the draft instrument or variation within 14 days\nafter the notice is published; and\n\n(b) consider any submissions received within the 14-day period\nmentioned in paragraph (a)."
    },
