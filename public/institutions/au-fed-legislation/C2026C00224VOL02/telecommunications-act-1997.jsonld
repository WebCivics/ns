      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies to",
      "cml:logicSummary": "Scope of application",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-509",
      "@type": "cml:Concept",
      "skos:prefLabel": "509 Complaints to the ACMA",
      "cml:realizedBy": {
