        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-505b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "May adopt a finding",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-506",
      "@type": "cml:Concept",
      "skos:prefLabel": "506 ACCC’s other powers not limited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-506"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.434",
      "values:originalText": "This Division does not, by implication, limit the powers conferred\non the ACCC by the Competition and Consumer Act 2010.\n\n\nInvestigations  Part 26\n\nSection 507\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "This Division does not, by implication, limit the powers conferred\non the ACCC by the Competition and Consumer Act 2010.\n\n\nInvestigations  Part 26\n\nSection 507\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-506-norm"
        }
      ],
      "cml:integrityHash": "e6cb8e6a72e76c90e5d4c17d452b60c11159687bad332a9b22fc9c9f8cf1cf04",
      "skos:note": "Powers of ACCC not limited by this Division"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-506",
      "@type": "cof:Section",
      "cof:title": "506 ACCC’s other powers not limited",
      "values:kind": "section",
      "cof:pageNumber": 434,
      "values:originalText": "This Division does not, by implication, limit the powers conferred\non the ACCC by the Competition and Consumer Act 2010.\n\n\nInvestigations  Part 26\n\nSection 507\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-506-norm",
