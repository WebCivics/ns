      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.478",
      "values:originalText": "(6) This section does not, by implication, affect the meaning of the\nexpression data when used in any other provision of this Act or the\nTelecommunications (Consumer Protection and Service Standards)\nAct 1999.",
      "skos:definition": "(6) This section does not, by implication, affect the meaning of the\nexpression data when used in any other provision of this Act or the\nTelecommunications (Consumer Protection and Service Standards)\nAct 1999.",
      "values:partOf": {
