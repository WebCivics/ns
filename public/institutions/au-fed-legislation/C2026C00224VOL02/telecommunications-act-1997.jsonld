        }
      ],
      "cml:integrityHash": "04d12e0290dc8ba3085d848c40198dbb79f232b36135e38a898034a6dc6827b3",
      "skos:note": "Determine damages for breach of standard"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vd-ss-3",
      "@type": "cof:Section",
      "cof:title": "360VD(3) Damages for breach of a designated compensable standard",
      "values:kind": "subsection",
      "cof:pageNumber": 246,
      "values:originalText": "(3) The amount of damages payable under subsection (1) or (2) for a\nparticular contravention is ascertained in accordance with the\ncompensation rules."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-3-norm",
