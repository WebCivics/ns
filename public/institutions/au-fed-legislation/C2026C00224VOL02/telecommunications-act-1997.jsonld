    {
      "@id": "concept:telecommunications-act-1997-sec-485",
      "@type": "cml:Concept",
      "skos:prefLabel": "485 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-485"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.419",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe ACMA and the ACCC may hold public inquiries about\ncertain matters relating to telecommunications.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nThe ACMA and the ACCC may hold public inquiries about\ncertain matters relating to telecommunications.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-485-norm"
        }
      ],
      "cml:integrityHash": "94a3a803af4f1894274fb7270e89b450abaf5f1db59223179c3fc9568276adf2",
      "skos:note": "May hold public inquiries about certain matters relating to telecommunications."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-485",
      "@type": "cof:Section",
      "cof:title": "485 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 419,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe ACMA and the ACCC may hold public inquiries about\ncertain matters relating to telecommunications."
    },
