      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.383",
      "values:originalText": "The ACMA has the general administration of the numbering plan.",
      "skos:definition": "The ACMA has the general administration of the numbering plan.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-459-norm"
        }
      ],
      "cml:integrityHash": "06c5582cd2dcaaaf5353fcda40d066ca3fbc81a5e52f82d567a70a2a65010b0e",
      "skos:note": "ACMA administers numbering plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-459",
      "@type": "cof:Section",
      "cof:title": "459 ACMA to administer numbering plan",
      "values:kind": "section",
      "cof:pageNumber": 383,
      "values:originalText": "The ACMA has the general administration of the numbering plan."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-459-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-459"
      },
      "values:deonticStatus": {
