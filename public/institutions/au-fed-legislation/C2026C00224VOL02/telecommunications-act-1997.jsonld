      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:logicSummary": "Temporal interval for proximity",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Proximity is within a certain time frame from the unit.",
      "cml:conclusionText": "The sale or lease of the unit must be within a certain time frame from the facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372h-ss-3-logic-ltl-3",
