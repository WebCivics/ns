    {
      "@id": "concept:telecommunications-act-1997-sec-427-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "427(2) Grant of cabling licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-427-ss-2"
      },
      "cml:curationStatus": {
