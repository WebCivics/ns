    {
      "@id": "concept:telecommunications-act-1997-sec-349a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "349A(4) Local access line",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-349a-ss-4"
      },
