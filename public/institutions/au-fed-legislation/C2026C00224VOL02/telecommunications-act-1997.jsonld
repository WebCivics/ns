      "cml:integrityHash": "6de453929d924940ae038478ff5e6bd4d764c9fc19e19c860677f83399400dc5",
      "skos:note": "Restraining conduct from engaging in a kind referred to in section 564."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-565-ss-1",
      "@type": "cof:Section",
      "cof:title": "565(1) Interim injunctions",
      "values:kind": "subsection",
      "cof:pageNumber": 494,
      "values:originalText": "(1) If an application is made to the court for an injunction under\nsection 564, the court may, before considering the application,\ngrant an interim injunction restraining a person from engaging in\nconduct of a kind referred to in that section.\nNo undertakings as to damages"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-565-ss-1-norm",
