    {
      "@id": "concept:telecommunications-act-1997-sec-581u",
      "@type": "cml:Concept",
      "skos:prefLabel": "581U Transitional—references in legislation to Telstra Infraco",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
