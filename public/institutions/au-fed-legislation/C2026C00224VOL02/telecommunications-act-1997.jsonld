    {
      "@id": "concept:telecommunications-act-1997-sec-534-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "534(5) Identity cards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-534-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
