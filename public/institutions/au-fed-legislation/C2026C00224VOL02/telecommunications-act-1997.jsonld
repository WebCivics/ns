      "@type": "cml:Concept",
      "skos:prefLabel": "360P(2) Obligation of statutory infrastructure provider to connect",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360p-ss-2"
      },
      "cml:curationStatus": {
