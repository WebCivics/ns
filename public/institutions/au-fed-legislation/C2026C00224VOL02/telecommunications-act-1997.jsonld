      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-364",
      "@type": "cml:Concept",
      "skos:prefLabel": "364 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-364"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.265",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe Minister may give directions to the Signatories to the\nINTELSAT Agreement and the Inmarsat Convention.\n•\nCarriers and carriage service providers may be required to\ncomply with certain international conventions.\n•\nThe Minister may make Rules of Conduct about dealings with\ninternational telecommunications operators.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nThe Minister may give directions to the Signatories to the\nINTELSAT Agreement and the Inmarsat Convention.\n•\nCarriers and carriage service providers may be required to\ncomply with certain international conventions.\n•\nThe Minister may make Rules of Conduct about dealings with\ninternational telecommunications operators.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-364-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-364-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9897cbe3bcf77262f8597e3b806bf8f729b3244e7aaf2043203baf897876147b",
      "skos:note": "The Minister may give directions to Signatories."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-364",
      "@type": "cof:Section",
      "cof:title": "364 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 265,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe Minister may give directions to the Signatories to the\nINTELSAT Agreement and the Inmarsat Convention.\n•\nCarriers and carriage service providers may be required to\ncomply with certain international conventions.\n•\nThe Minister may make Rules of Conduct about dealings with\ninternational telecommunications operators."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-364-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-364"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-364-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission to direct",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-365",
      "@type": "cml:Concept",
      "skos:prefLabel": "365 INTELSAT and Inmarsat—directions to Signatories",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-365"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.266",
      "values:originalText": "(1) This section applies to a person if:\n\n(a) the person is:\n\n(i) a carrier; or\n\n(ii) a carriage service provider; and\n\n(b) either:\n\n(i) the person is a Signatory within the meaning of the\nINTELSAT Agreement because the person has been\ndesignated, by or on behalf of the Commonwealth and\nin accordance with Article II(b) of that Agreement, to\nsign the INTELSAT Operating Agreement; or\n\n(ii) the person is a Signatory within the meaning of the\nConvention on the International Maritime Satellite\nOrganisation (Inmarsat) because the person has been\ndesignated, by or on behalf of the Commonwealth and\nin accordance with Article 2(3) of that Convention, to\nsign the Operating Agreement on the International\nMaritime Satellite Organisation (Inmarsat).\n\n(2) The Minister may give the person such written directions as the\nMinister thinks necessary in relation to the person’s performance\nof the person’s functions as a Signatory within the meaning of that\nAgreement or Convention.\n\n(3) The Minister must not give a direction under subsection (2) that\nrelates to the manner in which the person is to deal with a\nparticular customer.\n\n(4) A person must comply with a direction under subsection (2).",
      "skos:definition": "(1) This section applies to a person if:\n\n(a) the person is:\n\n(i) a carrier; or\n\n(ii) a carriage service provider; and\n\n(b) either:\n\n(i) the person is a Signatory within the meaning of the\nINTELSAT Agreement because the person has been\ndesignated, by or on behalf of the Commonwealth and\nin accordance with Article II(b) of that Agreement, to\nsign the INTELSAT Operating Agreement; or\n\n(ii) the person is a Signatory within the meaning of the\nConvention on the International Maritime Satellite\nOrganisation (Inmarsat) because the person has been\ndesignated, by or on behalf of the Commonwealth and\nin accordance with Article 2(3) of that Convention, to\nsign the Operating Agreement on the International\nMaritime Satellite Organisation (Inmarsat).\n\n(2) The Minister may give the person such written directions as the\nMinister thinks necessary in relation to the person’s performance\nof the person’s functions as a Signatory within the meaning of that\nAgreement or Convention.\n\n(3) The Minister must not give a direction under subsection (2) that\nrelates to the manner in which the person is to deal with a\nparticular customer.\n\n(4) A person must comply with a direction under subsection (2).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-365-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-365-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-365-ss-3"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-365-ss-4"
