    {
      "@id": "concept:telecommunications-act-1997-sec-317zp",
      "@type": "cml:Concept",
      "skos:prefLabel": "317ZP Delegation by Director-General of the Australian Secret",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317zp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.150",
      "values:originalText": "Intelligence Service\n\n(1) The Director-General of the Australian Secret Intelligence Service\nmay, by writing, delegate any or all of the functions or powers of\nthe Director-General of the Australian Secret Intelligence Service\nunder Division 2 or 6 to a person who:\n\n(a) is a staff member of the Australian Secret Intelligence\nService; and\n\n(b) holds, or is acting in, a position in the Australian Secret\nIntelligence Service that is equivalent to, or higher than, a\nposition occupied by an SES employee.\n\n(2) A delegate must comply with any written directions of the\nDirector-General of the Australian Secret Intelligence Service.",
      "skos:definition": "Intelligence Service\n\n(1) The Director-General of the Australian Secret Intelligence Service\nmay, by writing, delegate any or all of the functions or powers of\nthe Director-General of the Australian Secret Intelligence Service\nunder Division 2 or 6 to a person who:\n\n(a) is a staff member of the Australian Secret Intelligence\nService; and\n\n(b) holds, or is acting in, a position in the Australian Secret\nIntelligence Service that is equivalent to, or higher than, a\nposition occupied by an SES employee.\n\n(2) A delegate must comply with any written directions of the\nDirector-General of the Australian Secret Intelligence Service.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317zp-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317zp-ss-2"
        }
      ],
      "cml:integrityHash": "a482eaeb7613e36407b2d5650943f40e37566fe935cc4fd641049d6bef93571a"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317zp",
      "@type": "cof:Section",
      "cof:title": "317ZP Delegation by Director-General of the Australian Secret",
      "values:kind": "section",
      "cof:pageNumber": 150,
      "values:originalText": "Intelligence Service\n\n(1) The Director-General of the Australian Secret Intelligence Service\nmay, by writing, delegate any or all of the functions or powers of\nthe Director-General of the Australian Secret Intelligence Service\nunder Division 2 or 6 to a person who:\n\n(a) is a staff member of the Australian Secret Intelligence\nService; and\n\n(b) holds, or is acting in, a position in the Australian Secret\nIntelligence Service that is equivalent to, or higher than, a\nposition occupied by an SES employee.\n\n(2) A delegate must comply with any written directions of the\nDirector-General of the Australian Secret Intelligence Service."
    },
