      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581x-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is-a",
