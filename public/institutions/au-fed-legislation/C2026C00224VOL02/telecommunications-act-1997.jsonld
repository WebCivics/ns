      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-584-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Permits joining charges for multiple offences against the same provision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-584-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "584(2) Procedure relating to certain continuing offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-584-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.634",
      "values:originalText": "(2) If a person is convicted of 2 or more offences against such a\nprovision, the court may impose one penalty in respect of both or\nall of those offences, but that penalty must not exceed the sum of\nthe maximum penalties that could be imposed if a separate penalty\nwere imposed in respect of each offence.",
      "skos:definition": "(2) If a person is convicted of 2 or more offences against such a\nprovision, the court may impose one penalty in respect of both or\nall of those offences, but that penalty must not exceed the sum of\nthe maximum penalties that could be imposed if a separate penalty\nwere imposed in respect of each offence.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-584"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-584-ss-2-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-584-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-584-ss-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a3110bca98af98d35c01c15dcb733277f067461aca5175b0eed4240b1175cea1",
      "skos:note": "Court may impose one penalty for multiple convictions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-584-ss-2",
      "@type": "cof:Section",
      "cof:title": "584(2) Procedure relating to certain continuing offences",
      "values:kind": "subsection",
      "cof:pageNumber": 634,
      "values:originalText": "(2) If a person is convicted of 2 or more offences against such a\nprovision, the court may impose one penalty in respect of both or\nall of those offences, but that penalty must not exceed the sum of\nthe maximum penalties that could be imposed if a separate penalty\nwere imposed in respect of each offence."
    },
