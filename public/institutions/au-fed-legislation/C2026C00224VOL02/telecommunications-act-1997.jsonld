    {
      "@id": "concept:telecommunications-act-1997-sec-493-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "493(5) Confidential material not to be published",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-493-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
