    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360va",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VA Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360va"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.245",
      "values:originalText": "The following is a simplified outline of this Division:\n•\nIf a statutory infrastructure provider contravenes a designated\ncompensable standard determined under subsection 360U(1),\nthe statutory infrastructure provider is liable to pay damages\nto the customer for the contravention.\n•\nIf a statutory infrastructure provider contravenes a designated\ncompensable rule made under subsection 360V(1), the\nstatutory infrastructure provider is liable to pay damages to\nthe customer for the contravention.\n•\nThe Telecommunications Industry Ombudsman may issue an\nevidentiary certificate in relation to:\n\n(a)\na contravention of a designated compensable standard\ndetermined under subsection 360U(1); or\n\n(b)\na contravention of a designated compensable rule made\nunder subsection 360V(1).",
      "skos:definition": "The following is a simplified outline of this Division:\n•\nIf a statutory infrastructure provider contravenes a designated\ncompensable standard determined under subsection 360U(1),\nthe statutory infrastructure provider is liable to pay damages\nto the customer for the contravention.\n•\nIf a statutory infrastructure provider contravenes a designated\ncompensable rule made under subsection 360V(1), the\nstatutory infrastructure provider is liable to pay damages to\nthe customer for the contravention.\n•\nThe Telecommunications Industry Ombudsman may issue an\nevidentiary certificate in relation to:\n\n(a)\na contravention of a designated compensable standard\ndetermined under subsection 360U(1); or\n\n(b)\na contravention of a designated compensable rule made\nunder subsection 360V(1).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360va-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360va-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "718f25a786fd797d77079c8e40da87c15e807cc2879ebe08a305981d032c4991",
      "skos:note": "Liability for contravention of standards and rules"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360va",
      "@type": "cof:Section",
      "cof:title": "360VA Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 245,
      "values:originalText": "The following is a simplified outline of this Division:\n•\nIf a statutory infrastructure provider contravenes a designated\ncompensable standard determined under subsection 360U(1),\nthe statutory infrastructure provider is liable to pay damages\nto the customer for the contravention.\n•\nIf a statutory infrastructure provider contravenes a designated\ncompensable rule made under subsection 360V(1), the\nstatutory infrastructure provider is liable to pay damages to\nthe customer for the contravention.\n•\nThe Telecommunications Industry Ombudsman may issue an\nevidentiary certificate in relation to:\n\n(a)\na contravention of a designated compensable standard\ndetermined under subsection 360U(1); or\n\n(b)\na contravention of a designated compensable rule made\nunder subsection 360V(1)."
    },
