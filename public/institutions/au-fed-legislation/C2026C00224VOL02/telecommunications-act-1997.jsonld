    {
      "@id": "concept:telecommunications-act-1997-sec-317ja-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "317JA(6) Variation of technical assistance requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ja-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.64",
      "values:originalText": "(6) A variation must not be made orally unless:\n\n(a) an imminent risk of serious harm to a person or substantial\ndamage to property exists; and\n\n(b) the variation is necessary for the purpose of dealing with that\nrisk; and\n\n(c) it is not practicable in the circumstances to make the\nvariation in writing.",
      "skos:definition": "(6) A variation must not be made orally unless:\n\n(a) an imminent risk of serious harm to a person or substantial\ndamage to property exists; and\n\n(b) the variation is necessary for the purpose of dealing with that\nrisk; and\n\n(c) it is not practicable in the circumstances to make the\nvariation in writing.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-317ja"
      },
      "cml:asserts": [
