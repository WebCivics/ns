    {
      "@id": "concept:telecommunications-act-1997-sec-414-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "414(1) Applying labels before satisfying requirements under",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-414-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
