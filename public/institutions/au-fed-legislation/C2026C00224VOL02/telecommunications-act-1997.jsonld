    {
      "@id": "concept:telecommunications-act-1997-sec-512-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "512(1A) Conduct of investigations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-512-ss-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
