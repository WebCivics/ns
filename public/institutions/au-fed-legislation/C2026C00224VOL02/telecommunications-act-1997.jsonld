    {
      "@id": "concept:telecommunications-act-1997-sec-528",
      "@type": "cml:Concept",
      "skos:prefLabel": "528 ACMA may retain documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-528"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.453",
      "values:originalText": "(1) The ACMA may take, and retain for as long as is necessary,\npossession of a document produced under this Division.\n\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the ACMA to be a true copy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the ACMA must, at such times\nand places as the ACMA thinks appropriate, permit the person\notherwise entitled to possession of the document, or a person",
      "skos:definition": "(1) The ACMA may take, and retain for as long as is necessary,\npossession of a document produced under this Division.\n\n(2) The person otherwise entitled to possession of the document is\nentitled to be supplied, as soon as practicable, with a copy certified\nby the ACMA to be a true copy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the ACMA must, at such times\nand places as the ACMA thinks appropriate, permit the person\notherwise entitled to possession of the document, or a person",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-528-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-528-ss-2"
