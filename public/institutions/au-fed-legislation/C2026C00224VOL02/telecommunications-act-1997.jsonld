        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the excluded spectrum regime applies to Telstra; and (b) a spectrum licence relates to a designated part of the spectrum;",
      "cml:conclusionText": "the licensee of the spectrum licence must not authorise Telstra to operate radiocommunications devices under the licence."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577k-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with the excluded spectrum regime.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) a spectrum licence relates to a designated part of the spectrum;",
      "cml:conclusionText": "The excluded spectrum regime overlaps with the spectrum licence."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577k-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Applies until the excluded spectrum regime is no longer applicable.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the excluded spectrum regime applies to Telstra; and (b) a spectrum licence relates to a designated part of the spectrum;",
      "cml:conclusionText": "The licensee of the spectrum licence must not authorise Telstra to operate radiocommunications devices under the licence until the excluded spectrum regime is no longer applicable."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577k-ss-1-logic-diffusion-4",
