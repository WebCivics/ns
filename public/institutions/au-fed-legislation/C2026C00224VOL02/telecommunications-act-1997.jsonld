    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360ad",
      "@type": "cml:Concept",
      "skos:prefLabel": "360AD Control of a company",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ad"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.187",
      "values:originalText": "(1) For the purposes of this Part, the question of whether a person is in\na position to exercise control of a company is to be determined\nunder Schedule 1 to the Broadcasting Services Act 1992.",
      "skos:definition": "(1) For the purposes of this Part, the question of whether a person is in\na position to exercise control of a company is to be determined\nunder Schedule 1 to the Broadcasting Services Act 1992.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360ad-norm"
        }
      ],
      "cml:integrityHash": "fe6065e85c73eada074996a9eb701d34d5b6f003eff589867d6a18b9df8df0d5",
      "skos:note": "Definition of control for company purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ad",
      "@type": "cof:Section",
      "cof:title": "360AD Control of a company",
      "values:kind": "section",
      "cof:pageNumber": 187,
      "values:originalText": "(1) For the purposes of this Part, the question of whether a person is in\na position to exercise control of a company is to be determined\nunder Schedule 1 to the Broadcasting Services Act 1992."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360ad-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
