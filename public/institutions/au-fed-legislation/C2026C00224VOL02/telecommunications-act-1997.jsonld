      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-355",
      "@type": "cml:Concept",
      "skos:prefLabel": "355 Calling line identification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-355"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.180",
      "values:originalText": "(1) This section applies to a person if:\n\n(a) the person is a carrier or a carriage service provider; and\n\n(b) a controlled facility of the person consists of:\n\n(i) a switching system used in connection with the supply\nof a standard telephone service; or\n\n(ii) a switching system of a kind specified in a\ndetermination under subsection (3); and\n\n(c) either:\n\n(i) the completion of the installation of the system occurred\non or after 1 July 1997; or\n\n(ii) immediately before 1 July 1997, the system was capable\nof providing calling line identification.\n\n(2) The person must take all reasonable steps to ensure that the system\nis capable of providing calling line identification.\n\n(3) The ACMA may, by legislative instrument, make a determination\nfor the purposes of subparagraph (1)(b)(ii).",
      "skos:definition": "(1) This section applies to a person if:\n\n(a) the person is a carrier or a carriage service provider; and\n\n(b) a controlled facility of the person consists of:\n\n(i) a switching system used in connection with the supply\nof a standard telephone service; or\n\n(ii) a switching system of a kind specified in a\ndetermination under subsection (3); and\n\n(c) either:\n\n(i) the completion of the installation of the system occurred\non or after 1 July 1997; or\n\n(ii) immediately before 1 July 1997, the system was capable\nof providing calling line identification.\n\n(2) The person must take all reasonable steps to ensure that the system\nis capable of providing calling line identification.\n\n(3) The ACMA may, by legislative instrument, make a determination\nfor the purposes of subparagraph (1)(b)(ii).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-355-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-355-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-355-ss-3"
        }
      ],
      "cml:integrityHash": "1c91d26fa48e8da020cc1b32844e001d17871ae4a34caa45769119c58bdc3dea"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-355",
      "@type": "cof:Section",
      "cof:title": "355 Calling line identification",
      "values:kind": "section",
      "cof:pageNumber": 180,
      "values:originalText": "(1) This section applies to a person if:\n\n(a) the person is a carrier or a carriage service provider; and\n\n(b) a controlled facility of the person consists of:\n\n(i) a switching system used in connection with the supply\nof a standard telephone service; or\n\n(ii) a switching system of a kind specified in a\ndetermination under subsection (3); and\n\n(c) either:\n\n(i) the completion of the installation of the system occurred\non or after 1 July 1997; or\n\n(ii) immediately before 1 July 1997, the system was capable\nof providing calling line identification.\n\n(2) The person must take all reasonable steps to ensure that the system\nis capable of providing calling line identification.\n\n(3) The ACMA may, by legislative instrument, make a determination\nfor the purposes of subparagraph (1)(b)(ii)."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-355-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "355(1) Calling line identification",
