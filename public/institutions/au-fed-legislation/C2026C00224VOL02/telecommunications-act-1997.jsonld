      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Granting injunctions as an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
