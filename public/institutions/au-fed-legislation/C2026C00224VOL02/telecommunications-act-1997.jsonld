    {
      "@id": "concept:telecommunications-act-1997-sec-317j-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "317J(1) Specified period etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317j-ss-1"
