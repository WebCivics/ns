      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Proximity is recurring within a certain time frame from the unit.",
      "cml:conclusionText": "The sale or lease of the unit must be recurring within a certain time frame from the facility."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372h-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Consequence of non-compliance",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the sale or lease of the unit is not in proximity to the facility, it will spread and cause harm.",
      "cml:conclusionText": "Non-compliance with the regulation will lead to negative consequences."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372h-ss-3-logic-cogai-5",
