      },
      "cml:premiseText": "Engaging in conduct is defined as doing an act or omitting to perform an act.",
      "cml:conclusionText": "Conduct is defined as doing an act or omitting to perform an act."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-399-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
