      "cml:integrityHash": "3f11cf8d9eced9168a7bd0733c3a4d9b6cc21b1942c726e207b221d5a48a21da",
      "skos:note": "Variation of technical assistance requests must not be made orally under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317ja-ss-6",
      "@type": "cof:Section",
      "cof:title": "317JA(6) Variation of technical assistance requests",
