    {
      "@id": "concept:telecommunications-act-1997-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 June, cause to be prepared a written report that sets out:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.155",
      "values:originalText": "(a) the number of technical assistance requests that were given\nduring the year ending on that 30 June by the chief officers of\ninterception agencies; and\n\n(b) the number of technical assistance notices that were given\nduring the year ending on that 30 June by the chief officers of\ninterception agencies; and\n\n(c) the number of technical capability notices that were:\n\n(i) given during the year ending on that 30 June; and\n\n(ii) directed towards ensuring that designated\ncommunications providers are capable of giving help to\ninterception agencies; and\n\n(d) if any technical assistance requests, technical assistance\nnotices or technical capability notices given during the year",
      "skos:definition": "(a) the number of technical assistance requests that were given\nduring the year ending on that 30 June by the chief officers of\ninterception agencies; and\n\n(b) the number of technical assistance notices that were given\nduring the year ending on that 30 June by the chief officers of\ninterception agencies; and\n\n(c) the number of technical capability notices that were:\n\n(i) given during the year ending on that 30 June; and\n\n(ii) directed towards ensuring that designated\ncommunications providers are capable of giving help to\ninterception agencies; and\n\n(d) if any technical assistance requests, technical assistance\nnotices or technical capability notices given during the year",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-30-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-30-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7cb8cb3e4d71f78b25a41c75adc4f47979073bde1aa7d5a83f2908a315771c63",
      "skos:note": "Report on technical assistance requests, notices, and capability notices."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-30",
      "@type": "cof:Section",
      "cof:title": "30 June, cause to be prepared a written report that sets out:",
      "values:kind": "section",
      "cof:pageNumber": 155,
      "values:originalText": "(a) the number of technical assistance requests that were given\nduring the year ending on that 30 June by the chief officers of\ninterception agencies; and\n\n(b) the number of technical assistance notices that were given\nduring the year ending on that 30 June by the chief officers of\ninterception agencies; and\n\n(c) the number of technical capability notices that were:\n\n(i) given during the year ending on that 30 June; and\n\n(ii) directed towards ensuring that designated\ncommunications providers are capable of giving help to\ninterception agencies; and\n\n(d) if any technical assistance requests, technical assistance\nnotices or technical capability notices given during the year"
    },
