      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to consult",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Minister revokes determination",
      "cml:conclusionText": "Consult person, ACMA, and ACCC"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-454e",
      "@type": "cml:Concept",
      "skos:prefLabel": "454E Directions to numbering scheme manager",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-454e"
