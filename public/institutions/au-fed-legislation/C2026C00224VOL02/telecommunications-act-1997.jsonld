        }
      ],
      "cml:integrityHash": "8cfcfc8ce168fa739897a741945929d9754e0c07e492d7dd0f17ce809db42f77",
      "skos:note": "Revocation of technical assistance requests"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317jb-ss-4",
      "@type": "cof:Section",
      "cof:title": "317JB(4) Revocation of technical assistance requests",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(4) If a technical assistance request has been given to a person by the\nchief officer of an interception agency, the chief officer may, by\nwritten notice given to the person, revoke the request."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317jb-ss-4-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
