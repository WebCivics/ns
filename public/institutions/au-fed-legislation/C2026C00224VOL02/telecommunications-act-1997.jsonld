    {
      "@id": "concept:telecommunications-act-1997-sec-372r",
      "@type": "cml:Concept",
      "skos:prefLabel": "372R Subdivision of an area of land",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372r"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.303",
      "values:originalText": "For the purposes of this Act, if an area of land has been subdivided\ninto lots (however described) it is immaterial whether, after the\nsubdivision, a part of the area of land (for example, a road) is not\nincluded in any of those lots.",
      "skos:definition": "For the purposes of this Act, if an area of land has been subdivided\ninto lots (however described) it is immaterial whether, after the\nsubdivision, a part of the area of land (for example, a road) is not\nincluded in any of those lots.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372r-norm"
        }
      ],
      "cml:integrityHash": "ac8f580b0a4d15f33896522285c39b5d9486c8c8feeeca0a75229b9c63e1a06b",
      "skos:note": "It is immaterial whether a part of the area of land is not included in any of those lots."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372r",
      "@type": "cof:Section",
      "cof:title": "372R Subdivision of an area of land",
      "values:kind": "section",
      "cof:pageNumber": 303,
      "values:originalText": "For the purposes of this Act, if an area of land has been subdivided\ninto lots (however described) it is immaterial whether, after the\nsubdivision, a part of the area of land (for example, a road) is not\nincluded in any of those lots."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372r-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
