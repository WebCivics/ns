      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.432",
      "values:originalText": "(3) If the inquiry was held otherwise than because of a direction given\nby the Minister under section 496, the ACCC must publish the\nreport.",
      "skos:definition": "(3) If the inquiry was held otherwise than because of a direction given\nby the Minister under section 496, the ACCC must publish the\nreport.",
