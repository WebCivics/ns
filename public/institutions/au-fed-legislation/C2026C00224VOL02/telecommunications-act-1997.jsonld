      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360za-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "360ZA(4) Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360za-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.262",
      "values:originalText": "(4) If the ACMA delegates to a person (the second delegate) a power\nthat has been delegated by the Minister to the ACMA under\nsubsection (1), then that power, when exercised by the second\ndelegate, is taken for the purposes of this Act to have been\nexercised by the Minister.",
      "skos:definition": "(4) If the ACMA delegates to a person (the second delegate) a power\nthat has been delegated by the Minister to the ACMA under\nsubsection (1), then that power, when exercised by the second\ndelegate, is taken for the purposes of this Act to have been\nexercised by the Minister.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360za"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360za-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360za-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a5759069e4ebd9679c7d2b07a534b09f67a37d619828f89af3ff2ea1feae7e52",
      "skos:note": "Delegation of power to a person"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360za-ss-4",
      "@type": "cof:Section",
      "cof:title": "360ZA(4) Delegation",
      "values:kind": "subsection",
      "cof:pageNumber": 262,
      "values:originalText": "(4) If the ACMA delegates to a person (the second delegate) a power\nthat has been delegated by the Minister to the ACMA under\nsubsection (1), then that power, when exercised by the second\ndelegate, is taken for the purposes of this Act to have been\nexercised by the Minister."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360za-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
