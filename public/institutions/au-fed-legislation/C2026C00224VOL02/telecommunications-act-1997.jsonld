      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Inspector can exercise monitoring powers",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The monitoring powers that an inspector may exercise under paragraph 547A(1)(b)",
      "cml:conclusionText": "The inspector has the power to search and inspect premises"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547b-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Inspector can take equipment and materials onto premises for monitoring purposes",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) to take onto the premises such equipment and materials as the inspector requires for the purpose of exercising powers in relation to the premises",
      "cml:conclusionText": "The inspector has taken equipment and materials onto the premises for at least one hour"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547b-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Inspector can inspect documents kept at premises",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) to inspect any document kept at the premises",
      "cml:conclusionText": "The inspector has inspected a document kept at the premises for less than or equal to one hour"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547b-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "⊆",
      "cml:logicSummary": "Inspector can remove or make copies of documents",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) to remove, or make copies of, any such document",
      "cml:conclusionText": "The inspector has removed or made a copy of a document"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547b-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "⊆",
      "cml:logicSummary": "Inspector can take photographs or make sketches of premises",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) to inspect and take photographs, or make sketches, of the premises or any substance or thing at the premises",
      "cml:conclusionText": "The inspector has taken a photograph or made a sketch of the premises"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547d",
      "@type": "cml:Concept",
      "skos:prefLabel": "547D Monitoring warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-547d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.473",
      "values:originalText": "(1) An inspector may apply to a magistrate for a warrant under this\nsection in relation to premises.\n\n(2) The magistrate may issue the warrant if the magistrate is satisfied,\nby information on oath or affirmation, that it is reasonably\nnecessary that one or more inspectors should have access to the\npremises for the purposes of finding out whether the Spam Act\n2003 has been complied with.\n\n(3) The magistrate must not issue the warrant unless the inspector or\nsome other person has given to the magistrate, either orally or by\naffidavit, such further information (if any) as the magistrate",
      "skos:definition": "(1) An inspector may apply to a magistrate for a warrant under this\nsection in relation to premises.\n\n(2) The magistrate may issue the warrant if the magistrate is satisfied,\nby information on oath or affirmation, that it is reasonably\nnecessary that one or more inspectors should have access to the\npremises for the purposes of finding out whether the Spam Act\n2003 has been complied with.\n\n(3) The magistrate must not issue the warrant unless the inspector or\nsome other person has given to the magistrate, either orally or by\naffidavit, such further information (if any) as the magistrate",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-547d-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-547d-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-547d-ss-3"
        }
      ],
      "cml:integrityHash": "804577b74911c0c4c935d0d1eea4735e125efa2983e170607097316bc7abb24a"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-547d",
      "@type": "cof:Section",
      "cof:title": "547D Monitoring warrants",
      "values:kind": "section",
      "cof:pageNumber": 473,
      "values:originalText": "(1) An inspector may apply to a magistrate for a warrant under this\nsection in relation to premises.\n\n(2) The magistrate may issue the warrant if the magistrate is satisfied,\nby information on oath or affirmation, that it is reasonably\nnecessary that one or more inspectors should have access to the\npremises for the purposes of finding out whether the Spam Act\n2003 has been complied with.\n\n(3) The magistrate must not issue the warrant unless the inspector or\nsome other person has given to the magistrate, either orally or by\naffidavit, such further information (if any) as the magistrate"
    },
