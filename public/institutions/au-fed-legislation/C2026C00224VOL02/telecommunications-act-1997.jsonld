    {
      "@id": "concept:telecommunications-act-1997-sec-317v",
      "@type": "cml:Concept",
      "skos:prefLabel": "317V Decision-making criteria",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.93",
      "values:originalText": "The Attorney-General must not give a technical capability notice to\na designated communications provider unless:\n\n(a) the Attorney-General is satisfied that the requirements\nimposed by the notice are reasonable and proportionate; and",
      "skos:definition": "The Attorney-General must not give a technical capability notice to\na designated communications provider unless:\n\n(a) the Attorney-General is satisfied that the requirements\nimposed by the notice are reasonable and proportionate; and",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-317v-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-317v-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0675562412d485647c1d8587902d0c32596a2d1a011241c833ef41e1cdf71ec0",
      "skos:note": "Attorney-General cannot give technical capability notice without reasonable and proportionate requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317v",
      "@type": "cof:Section",
      "cof:title": "317V Decision-making criteria",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "The Attorney-General must not give a technical capability notice to\na designated communications provider unless:\n\n(a) the Attorney-General is satisfied that the requirements\nimposed by the notice are reasonable and proportionate; and"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317v-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
