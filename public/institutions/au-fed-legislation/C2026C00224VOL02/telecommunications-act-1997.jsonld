    },
    {
      "@id": "concept:telecommunications-act-1997-sec-510-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "510(2) Investigations by the ACMA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-510-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.438",
      "values:originalText": "(2) The ACMA must not conduct such an investigation if it thinks that\nthe subject matter of the investigation would not be a matter\nrelevant to the performance of any of its functions.",
      "skos:definition": "(2) The ACMA must not conduct such an investigation if it thinks that\nthe subject matter of the investigation would not be a matter\nrelevant to the performance of any of its functions.",
