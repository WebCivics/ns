    {
      "@id": "concept:telecommunications-act-1997-sec-372p-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "372P(3) Exemption of certain projects",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372p-ss-3"
      },
      "cml:curationStatus": {
