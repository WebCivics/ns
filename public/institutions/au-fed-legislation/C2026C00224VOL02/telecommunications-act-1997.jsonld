      },
      "dc:source": "telecommunications-act-1997.pdf, p.342",
      "values:originalText": "(3) In this section:\nsupply includes supply (including re-supply) by way of sale,\nexchange, lease, hire or hire-purchase.",
      "skos:definition": "(3) In this section:\nsupply includes supply (including re-supply) by way of sale,\nexchange, lease, hire or hire-purchase.",
