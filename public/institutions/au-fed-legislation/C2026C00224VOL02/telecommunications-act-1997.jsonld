      },
      "dc:source": "telecommunications-act-1997.pdf, p.298",
      "values:originalText": "(7) Subsections (2) and (6) are civil penalty provisions.\nNote:\nPart 31 provides for pecuniary penalties for breaches of civil penalty\nprovisions.",
      "skos:definition": "(7) Subsections (2) and (6) are civil penalty provisions.\nNote:\nPart 31 provides for pecuniary penalties for breaches of civil penalty\nprovisions.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-372na"
      },
      "cml:asserts": [
