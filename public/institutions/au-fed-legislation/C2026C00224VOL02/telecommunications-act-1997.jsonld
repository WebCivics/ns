    {
      "@id": "concept:telecommunications-act-1997-sec-581ze-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "581ZE(6) Terms and conditions of access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581ze-ss-6"
      },
      "cml:curationStatus": {
