      },
      "dc:source": "telecommunications-act-1997.pdf, p.370",
      "values:originalText": "(5) In this section:\nsupply includes supply (including re-supply) by way of sale,\nexchange, lease, hire or hire-purchase.",
      "skos:definition": "(5) In this section:\nsupply includes supply (including re-supply) by way of sale,\nexchange, lease, hire or hire-purchase.",
