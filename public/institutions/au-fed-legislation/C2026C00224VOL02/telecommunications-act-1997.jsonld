    {
      "@id": "concept:telecommunications-act-1997-sec-317xa-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "317XA(3) Approval of variation of technical capability notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317xa-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
