    {
      "@id": "concept:telecommunications-act-1997-sec-420",
      "@type": "cml:Concept",
      "skos:prefLabel": "420 Prohibition of unauthorised cabling work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-420"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.349",
      "values:originalText": "(1) A person must not perform a particular type of cabling work\nunless:\n\n(a) the person is subject to the cabling provider rules; or\n\n(b) the person performs the work under the supervision of\nanother person who is subject to the cabling provider rules;\nor\n\n(c) the person is the holder of a cabling licence that authorises\nthe performance of that type of cabling work; or\n\n(d) the person performs the work under the supervision of the\nholder of a cabling licence that authorises the performance of\nthat type of cabling work.",
      "skos:definition": "(1) A person must not perform a particular type of cabling work\nunless:\n\n(a) the person is subject to the cabling provider rules; or\n\n(b) the person performs the work under the supervision of\nanother person who is subject to the cabling provider rules;\nor\n\n(c) the person is the holder of a cabling licence that authorises\nthe performance of that type of cabling work; or\n\n(d) the person performs the work under the supervision of the\nholder of a cabling licence that authorises the performance of\nthat type of cabling work.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-420-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-420-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-420-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "9a2f2defd9527c7492449f8d66d5c20fdb613849d7451c90fab8d84515bde220",
      "skos:note": "Prohibition on performing cabling work without proper authorization."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-420",
      "@type": "cof:Section",
      "cof:title": "420 Prohibition of unauthorised cabling work",
      "values:kind": "section",
      "cof:pageNumber": 349,
      "values:originalText": "(1) A person must not perform a particular type of cabling work\nunless:\n\n(a) the person is subject to the cabling provider rules; or\n\n(b) the person performs the work under the supervision of\nanother person who is subject to the cabling provider rules;\nor\n\n(c) the person is the holder of a cabling licence that authorises\nthe performance of that type of cabling work; or\n\n(d) the person performs the work under the supervision of the\nholder of a cabling licence that authorises the performance of\nthat type of cabling work."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-420-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
