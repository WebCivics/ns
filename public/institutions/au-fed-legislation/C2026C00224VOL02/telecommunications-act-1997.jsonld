    {
      "@id": "concept:telecommunications-act-1997-sec-504",
      "@type": "cml:Concept",
      "skos:prefLabel": "504 Direction about private hearings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-504"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.431",
      "values:originalText": "(1) This section applies to a hearing conducted under this Division.\n\n(2) If the hearing, or a part of the hearing, takes place in private, the\nACCC:\n\n(a) must give directions as to the persons who may be present at\nthe hearing or the part of the hearing; and\n\n(b) may give directions restricting the disclosure of evidence or\nother material presented at the hearing or the part of the\nhearing.\n\n(3) A person must not fail to comply with a direction under\nsubsection (2).",
      "skos:definition": "(1) This section applies to a hearing conducted under this Division.\n\n(2) If the hearing, or a part of the hearing, takes place in private, the\nACCC:\n\n(a) must give directions as to the persons who may be present at\nthe hearing or the part of the hearing; and\n\n(b) may give directions restricting the disclosure of evidence or\nother material presented at the hearing or the part of the\nhearing.\n\n(3) A person must not fail to comply with a direction under\nsubsection (2).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-504-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-504-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-504-ss-3"
        }
      ],
      "cml:integrityHash": "7c0e901c224bbc017fe9a8d0db05ba46a843a165cb2bc548a501190ad771970e"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-504",
      "@type": "cof:Section",
      "cof:title": "504 Direction about private hearings",
      "values:kind": "section",
      "cof:pageNumber": 431,
      "values:originalText": "(1) This section applies to a hearing conducted under this Division.\n\n(2) If the hearing, or a part of the hearing, takes place in private, the\nACCC:\n\n(a) must give directions as to the persons who may be present at\nthe hearing or the part of the hearing; and\n\n(b) may give directions restricting the disclosure of evidence or\nother material presented at the hearing or the part of the\nhearing.\n\n(3) A person must not fail to comply with a direction under\nsubsection (2)."
    },
