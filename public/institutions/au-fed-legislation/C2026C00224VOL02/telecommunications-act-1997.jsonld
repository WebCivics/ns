    },
    {
      "@id": "concept:telecommunications-act-1997-sec-347",
      "@type": "cml:Concept",
      "skos:prefLabel": "347 Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-347"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.167",
      "values:originalText": "(1) The Secretary of the Defence Department may, by writing,\ndelegate to an SES employee or acting SES employee in that\nDepartment any or all of the Secretary’s powers under this Part.\n\n(2) The Chief of the Defence Force may, by writing, delegate to a\nmember of the Defence Force holding a senior rank any or all of\nthe powers conferred on the Chief of the Defence Force by this\nPart.\n\n(3) In this section:\nsenior rank means a rank not lower than:\n\n(a) in the case of the Royal Australian Navy—the rank of\nCommodore; or\n\n(b) in the case of the Australian Army—the rank of Brigadier; or\n\n(c) in the case of the Royal Australian Air Force—the rank of\nAir Commodore.",
      "skos:definition": "(1) The Secretary of the Defence Department may, by writing,\ndelegate to an SES employee or acting SES employee in that\nDepartment any or all of the Secretary’s powers under this Part.\n\n(2) The Chief of the Defence Force may, by writing, delegate to a\nmember of the Defence Force holding a senior rank any or all of\nthe powers conferred on the Chief of the Defence Force by this\nPart.\n\n(3) In this section:\nsenior rank means a rank not lower than:\n\n(a) in the case of the Royal Australian Navy—the rank of\nCommodore; or\n\n(b) in the case of the Australian Army—the rank of Brigadier; or\n\n(c) in the case of the Royal Australian Air Force—the rank of\nAir Commodore.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-347-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-347-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-347-ss-3"
        }
      ],
      "cml:integrityHash": "d385333dca9f472a5e8b92565d32e585b7fd7e4a20e51ab123f85365e1a315c1"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-347",
      "@type": "cof:Section",
      "cof:title": "347 Delegation",
      "values:kind": "section",
      "cof:pageNumber": 167,
      "values:originalText": "(1) The Secretary of the Defence Department may, by writing,\ndelegate to an SES employee or acting SES employee in that\nDepartment any or all of the Secretary’s powers under this Part.\n\n(2) The Chief of the Defence Force may, by writing, delegate to a\nmember of the Defence Force holding a senior rank any or all of\nthe powers conferred on the Chief of the Defence Force by this\nPart.\n\n(3) In this section:\nsenior rank means a rank not lower than:\n\n(a) in the case of the Royal Australian Navy—the rank of\nCommodore; or\n\n(b) in the case of the Australian Army—the rank of Brigadier; or\n\n(c) in the case of the Royal Australian Air Force—the rank of\nAir Commodore."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-347-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "347(1) Delegation",
