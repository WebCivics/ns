    {
      "@id": "concept:telecommunications-act-1997-sec-388",
      "@type": "cml:Concept",
      "skos:prefLabel": "388 Provision of access",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-388"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.324",
      "values:originalText": "A reference in this Division to the provision of access is a\nreference to the provision of access to:\n\n(a) service providers generally; or\n\n(b) a particular class or classes of service providers; or\n\n(c) a particular service provider or particular service providers;\nin order that the service provider or providers can provide carriage\nservices and/or content services.",
      "skos:definition": "A reference in this Division to the provision of access is a\nreference to the provision of access to:\n\n(a) service providers generally; or\n\n(b) a particular class or classes of service providers; or\n\n(c) a particular service provider or particular service providers;\nin order that the service provider or providers can provide carriage\nservices and/or content services.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-388-norm"
        }
      ],
      "cml:integrityHash": "04451bbc1204a49eaef4eff58f0bbd0e6c8ecfd89c7f6517fb840e4fed312044",
      "skos:note": "Definition of provision of access"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-388",
      "@type": "cof:Section",
      "cof:title": "388 Provision of access",
      "values:kind": "section",
      "cof:pageNumber": 324,
      "values:originalText": "A reference in this Division to the provision of access is a\nreference to the provision of access to:\n\n(a) service providers generally; or\n\n(b) a particular class or classes of service providers; or\n\n(c) a particular service provider or particular service providers;\nin order that the service provider or providers can provide carriage\nservices and/or content services."
    },
    {
