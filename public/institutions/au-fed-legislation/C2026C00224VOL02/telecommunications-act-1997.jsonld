      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Defines recurring trace for revocation of technical assistance notices.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If a technical assistance notice has been given to a person by the chief officer of an interception agency, and the chief officer is satisfied that: (a) the requirements imposed by the notice are not reasonable and proportionate; or (b) compliance with the notice is not: (i) practicable; and (ii) technically feasible;",
      "cml:conclusionText": "(the recurring pattern of revocation notices)"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-317r-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
