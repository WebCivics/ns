        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Portability is considered when promoting end-users' interests",
      "cml:conclusionText": "Promoting end-users' interests implies considering portability"
    },
    {
