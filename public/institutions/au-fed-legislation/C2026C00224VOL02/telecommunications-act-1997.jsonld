        }
      ],
      "cml:integrityHash": "8b90518d23f6f25b1070a74eccbe53b71023a7c5aea9525ecdffc8ae0c741cc4",
      "skos:note": "Attorney-General must appoint persons to assess proposed technical capability notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-317wa-ss-2",
      "@type": "cof:Section",
