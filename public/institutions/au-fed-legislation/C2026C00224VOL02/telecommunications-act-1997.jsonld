      "dc:source": "telecommunications-act-1997.pdf, p.39",
      "values:originalText": "Nothing in this Part limits the generality of anything else in it.",
      "skos:definition": "Nothing in this Part limits the generality of anything else in it.",
      "cml:asserts": [
