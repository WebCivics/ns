        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360ve-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VE(2) Time for payment of damages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ve-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
