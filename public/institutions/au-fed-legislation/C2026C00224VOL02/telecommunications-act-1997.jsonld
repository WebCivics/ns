    {
      "@id": "concept:telecommunications-act-1997-sec-581tb-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "581TB(7) Facilitation of obligations imposed on a named designated",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581tb-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.614",
      "values:originalText": "(7) The period specified in the notice may be shorter than 30 days if\nthe Minister is satisfied that the shorter period is necessary due to\nurgent circumstances.",
      "skos:definition": "(7) The period specified in the notice may be shorter than 30 days if\nthe Minister is satisfied that the shorter period is necessary due to\nurgent circumstances.",
