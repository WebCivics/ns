      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372d-ss-1-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372d-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "19c4794a56be9669ef8f8954afd67bd6da14cb915ce9b4ade032771d1b8e823f",
      "skos:note": "Exemptions from scope of provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372d-ss-1",
      "@type": "cof:Section",
      "cof:title": "372D(1) Exemptions—Ministerial instrument",
      "values:kind": "subsection",
      "cof:pageNumber": 279,
      "values:originalText": "(1) The Minister may, by legislative instrument, exempt:\n\n(a) conduct specified in the instrument; or\n\n(b) conduct ascertained in accordance with the instrument;\nfrom the scope of either or both of the following provisions:\n\n(c) subsection 372B(2);\n\n(d) subsection 372C(2)."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-372d-ss-1-norm",
