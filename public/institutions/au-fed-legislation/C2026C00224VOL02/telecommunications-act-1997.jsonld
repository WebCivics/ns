    {
      "@id": "concept:telecommunications-act-1997-sec-372zd",
      "@type": "cml:Concept",
      "skos:prefLabel": "372ZD NBN Co",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372zd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.308",
      "values:originalText": "In this Part:\n\n\nDeployment of optical fibre etc.  Part 20A\nMiscellaneous  Division 6\n\nSection 372ZD\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\nNBN Co means NBN Co Limited (ACN 136 533 741), as the\ncompany exists from time to time (even if its name is later\nchanged).",
      "skos:definition": "In this Part:\n\n\nDeployment of optical fibre etc.  Part 20A\nMiscellaneous  Division 6\n\nSection 372ZD\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\nNBN Co means NBN Co Limited (ACN 136 533 741), as the\ncompany exists from time to time (even if its name is later\nchanged).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372zd-norm"
        }
      ],
      "cml:integrityHash": "b17b4b6e633a5dd0277dbfc4a52a9e7b70e0c0b1f41bf104b28f02361bab9377",
      "skos:note": "Definition of NBN Co"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372zd",
      "@type": "cof:Section",
      "cof:title": "372ZD NBN Co",
      "values:kind": "section",
      "cof:pageNumber": 308,
      "values:originalText": "In this Part:\n\n\nDeployment of optical fibre etc.  Part 20A\nMiscellaneous  Division 6\n\nSection 372ZD\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026\n\nNBN Co means NBN Co Limited (ACN 136 533 741), as the\ncompany exists from time to time (even if its name is later\nchanged)."
    },
    {
