      },
      "cml:premiseText": "(b) the ACMA is of the opinion that, if the agreement were a draft agreement at that time, the ACMA would have refused to certify it.",
      "cml:conclusionText": "the ACMA must refuse to certify it if (a) a certified agreement is in force at a particular time;"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-341-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
