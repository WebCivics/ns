    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vd-ss-7",
      "@type": "cof:Section",
      "cof:title": "360VD(7) Damages for breach of a designated compensable standard",
      "values:kind": "subsection",
