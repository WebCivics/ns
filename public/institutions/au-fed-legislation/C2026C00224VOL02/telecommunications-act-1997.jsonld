      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "Invite submissions within 14 days",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
