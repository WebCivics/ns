    {
      "@id": "concept:telecommunications-act-1997-sec-360ve-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VE(3) Time for payment of damages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ve-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.248",
      "values:originalText": "(3) If a statutory infrastructure provider makes a decision under\nsubsection (1) not to accept a liability to pay damages to a\nparticular customer, the statutory infrastructure provider must give\nthe customer written notification of the decision within 14 weeks\nafter the decision is made.\nCrediting customer account",
      "skos:definition": "(3) If a statutory infrastructure provider makes a decision under\nsubsection (1) not to accept a liability to pay damages to a\nparticular customer, the statutory infrastructure provider must give\nthe customer written notification of the decision within 14 weeks\nafter the decision is made.\nCrediting customer account",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360ve"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360ve-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360ve-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5e7b661f33b2cbe982d18de21d49b940f599b18241e341634365130f06944477",
      "skos:note": "Statutory infrastructure provider must notify customer of decision within 14 weeks",
      "dc:description": "Written notification"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360ve-ss-3",
      "@type": "cof:Section",
      "cof:title": "360VE(3) Time for payment of damages",
      "values:kind": "subsection",
      "cof:pageNumber": 248,
      "values:originalText": "(3) If a statutory infrastructure provider makes a decision under\nsubsection (1) not to accept a liability to pay damages to a\nparticular customer, the statutory infrastructure provider must give\nthe customer written notification of the decision within 14 weeks\nafter the decision is made.\nCrediting customer account"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360ve-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360ve-ss-3"
      },
