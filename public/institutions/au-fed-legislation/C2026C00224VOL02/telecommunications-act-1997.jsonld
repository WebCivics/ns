    {
      "@id": "concept:telecommunications-act-1997-sec-360j-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "360J(5) Nominated service area—carrier licence conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360j-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.212",
      "values:originalText": "(5) An area must not be specified in a declaration in accordance with\nparagraph (4)(b) unless at least one point in the area is also a point\nin the development area specified in the declaration in accordance\nwith paragraph (4)(a).",
      "skos:definition": "(5) An area must not be specified in a declaration in accordance with\nparagraph (4)(b) unless at least one point in the area is also a point\nin the development area specified in the declaration in accordance\nwith paragraph (4)(a).",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-360j"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360j-ss-5-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360j-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7859ef9d6f241d884c393f22058d44c84aac055f775d490a8d06a58d4204642c",
      "skos:note": "Area cannot be specified in a declaration without at least one point also in the development area."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360j-ss-5",
      "@type": "cof:Section",
      "cof:title": "360J(5) Nominated service area—carrier licence conditions",
      "values:kind": "subsection",
      "cof:pageNumber": 212,
      "values:originalText": "(5) An area must not be specified in a declaration in accordance with\nparagraph (4)(b) unless at least one point in the area is also a point\nin the development area specified in the declaration in accordance\nwith paragraph (4)(a)."
    },
