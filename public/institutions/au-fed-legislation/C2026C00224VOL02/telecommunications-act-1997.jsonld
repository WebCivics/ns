      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-389-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Classifies things promoting long-term interests",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part XIC of the Competition and Consumer Act 2010",
      "cml:conclusionText": "same manner as it is determined for"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-389-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": ">",
      "cml:logicSummary": "Requires consideration of long-term interests",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Promotes the long-term interests of end-users",
      "cml:conclusionText": "of carriage services or of services supplied by means of carriage services"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-389a",
      "@type": "cml:Concept",
      "skos:prefLabel": "389A ACMA’s power to determine technical standards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-389a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.325",
      "values:originalText": "The ACMA may, by legislative instrument, determine technical\nstandards relating to Layer 2 bitstream services.\nNote:\nSee section 589 (instruments under this Act may provide for matters\nby reference to other instruments).",
      "skos:definition": "The ACMA may, by legislative instrument, determine technical\nstandards relating to Layer 2 bitstream services.\nNote:\nSee section 589 (instruments under this Act may provide for matters\nby reference to other instruments).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-389a-norm"
        }
      ],
      "cml:integrityHash": "3f31ba2d99b4fe68968c5af5cc5bd283614a290610618df9f5235af61c82a6b2",
      "skos:note": "ACMA may determine technical standards by legislative instrument."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-389a",
      "@type": "cof:Section",
      "cof:title": "389A ACMA’s power to determine technical standards",
      "values:kind": "section",
      "cof:pageNumber": 325,
      "values:originalText": "The ACMA may, by legislative instrument, determine technical\nstandards relating to Layer 2 bitstream services.\nNote:\nSee section 589 (instruments under this Act may provide for matters\nby reference to other instruments)."
    },
    {
