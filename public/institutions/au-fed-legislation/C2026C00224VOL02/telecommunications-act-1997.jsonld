        }
      ],
      "cml:integrityHash": "7e43ea195dc2488d756ae1cb0c28e2cf5139295c72313b0d19fa91f0d9b347cd",
      "skos:note": "Delegate power to an SES employee or acting SES employee"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-484j-ss-7",
      "@type": "cof:Section",
      "cof:title": "484J(7) Automation of administrative action",
      "values:kind": "subsection",
      "cof:pageNumber": 414,
      "values:originalText": "(7) The Chair of the ACMA may, in writing, delegate the Chair’s\npower under subsection (1) to a member of the ACMA staff who is\nan SES employee or acting SES employee."
    },
    {
