        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360vd-ss-2-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "412449a9d72d9d637fd86590bad28487a266f7a4ae5f62185cfc5f8cb1316526",
      "skos:note": "Liability for breach of designated compensable standard"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vd-ss-2",
      "@type": "cof:Section",
      "cof:title": "360VD(2) Damages for breach of a designated compensable standard",
      "values:kind": "subsection",
      "cof:pageNumber": 246,
      "values:originalText": "(2) If:\n\n(a) a statutory infrastructure provider contravenes a designated\ncompensable rule; and\n\n(b) the rule is made under subsection 360V(1); and\n\n(c) the contravention relates to a particular customer;\nthe statutory infrastructure provider is liable to pay damages to the\ncustomer for the contravention."
    },
    {
