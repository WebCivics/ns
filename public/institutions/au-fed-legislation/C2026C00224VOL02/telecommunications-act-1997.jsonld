    {
      "@id": "concept:telecommunications-act-1997-sec-563",
      "@type": "cml:Concept",
      "skos:prefLabel": "563 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-563"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.490",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe Federal Court may grant injunctions in relation to\ncontraventions of:\n\n(a)\nthis Act; or\n\n(b)\nthe Telecommunications (Consumer Protection and\nService Standards) Act 1999; or\n\n(c)\nregulations under that Act.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nThe Federal Court may grant injunctions in relation to\ncontraventions of:\n\n(a)\nthis Act; or\n\n(b)\nthe Telecommunications (Consumer Protection and\nService Standards) Act 1999; or\n\n(c)\nregulations under that Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-563-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-563-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5348a05ae79816dd07839b454466b2b326eb80ecd7b91545d51d3f16fa060bea",
      "skos:note": "Grant injunctions in relation to contraventions of specified acts and regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-563",
      "@type": "cof:Section",
      "cof:title": "563 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 490,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nThe Federal Court may grant injunctions in relation to\ncontraventions of:\n\n(a)\nthis Act; or\n\n(b)\nthe Telecommunications (Consumer Protection and\nService Standards) Act 1999; or\n\n(c)\nregulations under that Act."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-563-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-563"
      },
