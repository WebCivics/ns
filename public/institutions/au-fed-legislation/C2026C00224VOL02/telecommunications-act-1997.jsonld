    {
      "@id": "concept:telecommunications-act-1997-sec-360vc",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VC Meaning of certain expressions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.246",
      "values:originalText": "In determining the meaning that the expressions customer and\ndamages have when used in:\n\n(a) a provision of this Act other than this Division; or\n\n(b) a provision of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999;\nsection 360VB is to be disregarded.\nSubdivision B—Damages for breach of standards or rules by\nstatutory infrastructure providers",
      "skos:definition": "In determining the meaning that the expressions customer and\ndamages have when used in:\n\n(a) a provision of this Act other than this Division; or\n\n(b) a provision of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999;\nsection 360VB is to be disregarded.\nSubdivision B—Damages for breach of standards or rules by\nstatutory infrastructure providers",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-360vc-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-360vc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3969fa54e0bd13a65da7de6182b980c8ebf1790c886e5272d6dbbc05271bacb1",
      "skos:note": "Disregard section 360VB when determining meaning of customer and damages expressions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vc",
      "@type": "cof:Section",
      "cof:title": "360VC Meaning of certain expressions",
      "values:kind": "section",
      "cof:pageNumber": 246,
      "values:originalText": "In determining the meaning that the expressions customer and\ndamages have when used in:\n\n(a) a provision of this Act other than this Division; or\n\n(b) a provision of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999;\nsection 360VB is to be disregarded.\nSubdivision B—Damages for breach of standards or rules by\nstatutory infrastructure providers"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vc-norm",
      "@type": "values:Obligation",
      "cml:modality": {
