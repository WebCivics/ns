    {
      "@id": "concept:telecommunications-act-1997-sec-372",
      "@type": "cml:Concept",
      "skos:prefLabel": "372 Reviews of the operation of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-372"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.272",
      "values:originalText": "(1) The ACCC must review, and report each financial year to the\nMinister on, the operation of this Division.\n\n(2) The ACCC must give a report under subsection (1) to the Minister\nas soon as practicable after the end of the financial year concerned.\n\n(3) The ACCC must, if directed in writing to do so by the Minister,\nreview, and report to the Minister on, specified matters relating to\nthe operation of this Division.\n\n(4) The ACCC must give a report under subsection (3) to the Minister\nbefore the end of the period specified in the direction.\n\n(5) The Minister must cause a copy of a report under this section to be\nlaid before each House of the Parliament within 15 sitting days of\nthat House after receiving the report.\n\n\nDeployment of optical fibre etc.  Part 20A\nSimplified outline  Division 1\n\nSection 372A\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "skos:definition": "(1) The ACCC must review, and report each financial year to the\nMinister on, the operation of this Division.\n\n(2) The ACCC must give a report under subsection (1) to the Minister\nas soon as practicable after the end of the financial year concerned.\n\n(3) The ACCC must, if directed in writing to do so by the Minister,\nreview, and report to the Minister on, specified matters relating to\nthe operation of this Division.\n\n(4) The ACCC must give a report under subsection (3) to the Minister\nbefore the end of the period specified in the direction.\n\n(5) The Minister must cause a copy of a report under this section to be\nlaid before each House of the Parliament within 15 sitting days of\nthat House after receiving the report.\n\n\nDeployment of optical fibre etc.  Part 20A\nSimplified outline  Division 1\n\nSection 372A\n\nTelecommunications Act 1997\n\nCompilation date: 04/06/2026",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-372-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372-ss-2"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-372-ss-3"
        },
