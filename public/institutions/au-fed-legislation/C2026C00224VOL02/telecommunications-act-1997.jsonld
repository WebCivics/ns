      },
      "cml:premiseText": "(2) If: a statutory infrastructure provider contravenes a designated compensable rule; and the rule is made under subsection 360V(1); and the contravention relates to a particular customer;",
      "cml:conclusionText": "the statutory infrastructure provider has permission to provide service."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-360vd-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VD(3) Damages for breach of a designated compensable standard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-360vd-ss-3"
      },
      "cml:curationStatus": {
