    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547j-ss-5-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "data includes information in any form and program (or part of a program)",
      "cml:conclusionText": "data is a subclass of information"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547j-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "data held in a computer includes data held in any removable data storage device for the time being held in a computer",
      "cml:conclusionText": "data is held during the time it is stored"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547j-ss-5-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusive relation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "data includes information in any form and program (or part of a program)",
      "cml:conclusionText": "information and program are included in data"
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-547j-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "547J(6) Access to computer data that is relevant to the Spam Act 2003",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-547j-ss-6"
      },
      "cml:curationStatus": {
