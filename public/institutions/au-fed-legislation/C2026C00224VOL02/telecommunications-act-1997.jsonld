    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-584-ss-1",
      "@type": "cof:Section",
      "cof:title": "584(1) Procedure relating to certain continuing offences",
      "values:kind": "subsection",
      "cof:pageNumber": 634,
      "values:originalText": "(1) If section 43 applies to an offence against a provision of this Act,\ncharges against the same person for any number of offences against\nthat provision may be joined in the same information, complaint or\nsummons if:\n\n(a) those charges are founded on the same facts; or\n\n(b) form, or are part of, a series of offences of the same or a\nsimilar character."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-584-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-584-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
