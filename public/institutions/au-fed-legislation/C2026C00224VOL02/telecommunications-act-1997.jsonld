    {
      "@id": "concept:telecommunications-act-1997-sec-426",
      "@type": "cml:Concept",
      "skos:prefLabel": "426 Further information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-426"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.352",
      "values:originalText": "(1) The ACMA may, within 7 days after an application is made,\nrequest the applicant to give the ACMA further information about\nthe application.\n\n(2) The ACMA may refuse to consider the application until the\napplicant gives the ACMA the information.",
      "skos:definition": "(1) The ACMA may, within 7 days after an application is made,\nrequest the applicant to give the ACMA further information about\nthe application.\n\n(2) The ACMA may refuse to consider the application until the\napplicant gives the ACMA the information.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-act-1997-sec-426-ss-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-426-ss-2"
        }
      ],
      "cml:integrityHash": "74d16a833451d5a12d8b1792b67d1039498f71ea6db325e58fe4cbe10d8eec40"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-426",
      "@type": "cof:Section",
      "cof:title": "426 Further information",
      "values:kind": "section",
      "cof:pageNumber": 352,
      "values:originalText": "(1) The ACMA may, within 7 days after an application is made,\nrequest the applicant to give the ACMA further information about\nthe application.\n\n(2) The ACMA may refuse to consider the application until the\napplicant gives the ACMA the information."
    },
