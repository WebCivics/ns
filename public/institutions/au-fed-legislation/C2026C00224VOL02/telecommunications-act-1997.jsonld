      "cml:integrityHash": "96f33cb8b3e2bb71c32844365881804afece257edbbcbbdaea9bcb515722fe93",
      "skos:note": "Engaging in conduct that contravenes a direction given by ACMA is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-494-ss-5",
      "@type": "cof:Section",
      "cof:title": "494(5) Direction about private hearings",
      "values:kind": "subsection",
      "cof:pageNumber": 425,
      "values:originalText": "(5) A person commits an offence if:\n\n(a) the ACMA has given a direction under paragraph (2)(b); and\n\n(b) the person engages in conduct; and\n\n(c) the person’s conduct contravenes the direction.\nPenalty: 50 penalty units."
    },
