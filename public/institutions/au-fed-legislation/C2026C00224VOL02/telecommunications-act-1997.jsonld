      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ACMA must consider exemptions if it is reasonable to impose the requirement",
      "cml:conclusionText": "exemptions are justified if they are in the public interest"
    },
    {
