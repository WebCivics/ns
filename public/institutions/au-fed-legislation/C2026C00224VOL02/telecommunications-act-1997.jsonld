      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.612",
      "values:originalText": "(1) If:\n\n(a) a designated Telstra successor company (the first designated\nTelstra successor company) is subject to a direction (the first\ndirection) given by the ACMA under this Act or the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) the ACMA is satisfied that the first designated Telstra\nsuccessor company has failed, is failing, or is likely to fail, to\ncomply with the first direction;\nthe ACMA may give:\n\n(c) another designated Telstra successor company; or\n\n(d) a body corporate that is a related body corporate (within the\nmeaning of the Corporations Act 2001) of the first\ndesignated Telstra successor company;\na written direction to take specified action.",
      "skos:definition": "(1) If:\n\n(a) a designated Telstra successor company (the first designated\nTelstra successor company) is subject to a direction (the first\ndirection) given by the ACMA under this Act or the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) the ACMA is satisfied that the first designated Telstra\nsuccessor company has failed, is failing, or is likely to fail, to\ncomply with the first direction;\nthe ACMA may give:\n\n(c) another designated Telstra successor company; or\n\n(d) a body corporate that is a related body corporate (within the\nmeaning of the Corporations Act 2001) of the first\ndesignated Telstra successor company;\na written direction to take specified action.",
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581ta"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581ta-ss-1-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581ta-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fc195ed942612e7f24885684e31934c147519e3b4de4496c712b23350945f7dc",
      "skos:note": "ACMA may give another designated Telstra successor company or a written direction to take specified action if the first designated Telstra successor company fails to comply with a direction."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581ta-ss-1",
      "@type": "cof:Section",
      "cof:title": "581TA(1) Facilitation of compliance with a direction given by the",
      "values:kind": "subsection",
      "cof:pageNumber": 612,
      "values:originalText": "(1) If:\n\n(a) a designated Telstra successor company (the first designated\nTelstra successor company) is subject to a direction (the first\ndirection) given by the ACMA under this Act or the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) the ACMA is satisfied that the first designated Telstra\nsuccessor company has failed, is failing, or is likely to fail, to\ncomply with the first direction;\nthe ACMA may give:\n\n(c) another designated Telstra successor company; or\n\n(d) a body corporate that is a related body corporate (within the\nmeaning of the Corporations Act 2001) of the first\ndesignated Telstra successor company;\na written direction to take specified action."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581ta-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-act-1997-sec-581ta-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581ta-ss-1-logic-deontic-1",
