        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Disclosure occurs before or at the same time as publication.",
      "cml:conclusionText": "Publication would involve unreasonable disclosure of personal information if it occurs until the individual's lifetime."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-517-ss-5-logic-diffusion-4",
