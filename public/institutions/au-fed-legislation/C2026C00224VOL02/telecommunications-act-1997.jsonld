    {
      "@id": "concept:telecommunications-act-1997-sec-470",
      "@type": "cml:Concept",
      "skos:prefLabel": "470 Cancellation of certain exemptions from charge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-470"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.394",
      "values:originalText": "(1) This section cancels the effect of a provision of another Act that\nwould have the effect of exempting a person from liability to pay\ncharge imposed by the Telecommunications (Numbering Charges)\nAct 1997.\n\n(2) The cancellation does not apply if the provision of the other Act is\nenacted after the commencement of this section and refers\nspecifically to charge imposed by the Telecommunications\n(Numbering Charges) Act 1997.",
      "skos:definition": "(1) This section cancels the effect of a provision of another Act that\nwould have the effect of exempting a person from liability to pay\ncharge imposed by the Telecommunications (Numbering Charges)\nAct 1997.\n\n(2) The cancellation does not apply if the provision of the other Act is\nenacted after the commencement of this section and refers\nspecifically to charge imposed by the Telecommunications\n(Numbering Charges) Act 1997.",
