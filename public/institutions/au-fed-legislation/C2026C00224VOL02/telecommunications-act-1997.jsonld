    {
      "@id": "concept:telecommunications-act-1997-sec-593-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "593(8) Funding of consumer representation, and of research, in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-593-ss-8"
