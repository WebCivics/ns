    {
      "@id": "concept:telecommunications-act-1997-sec-581v",
      "@type": "cml:Concept",
      "skos:prefLabel": "581V Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-act-1997.pdf"
      },
      "dc:source": "telecommunications-act-1997.pdf, p.617",
      "values:originalText": "•\nIf a group of companies includes a carrier, a company (other\nthan a carrier) that is in the group must:\n\n(a)\nprovide carriers with access to facilities; and\n\n(b)\nprovide carriers with access to telecommunications\ntransmission towers.",
      "skos:definition": "•\nIf a group of companies includes a carrier, a company (other\nthan a carrier) that is in the group must:\n\n(a)\nprovide carriers with access to facilities; and\n\n(b)\nprovide carriers with access to telecommunications\ntransmission towers.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-act-1997-sec-581v-norm"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581v-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-act-1997-sec-581v-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "464a306ea01a1e12db8d6e50445c3460486d222ec440d90dcd8684085b92a167",
      "skos:note": "Company must provide carriers with access to facilities and telecommunications transmission towers.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-581v",
      "@type": "cof:Section",
      "cof:title": "581V Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 617,
      "values:originalText": "•\nIf a group of companies includes a carrier, a company (other\nthan a carrier) that is in the group must:\n\n(a)\nprovide carriers with access to facilities; and\n\n(b)\nprovide carriers with access to telecommunications\ntransmission towers."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-581v-norm",
