      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Alternative condition for a controlled facility",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) the completion of the installation of the system occurred on or after 1 July 1997; or (ii) immediately before 1 July 1997, the system was capable of providing calling line identification.",
      "cml:conclusionText": "The person must comply with one of the alternative conditions."
    },
