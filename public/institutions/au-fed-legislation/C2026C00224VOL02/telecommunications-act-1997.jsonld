      },
      "dc:source": "telecommunications-act-1997.pdf, p.248",
      "values:originalText": "(6) If the customer is an individual and the customer dies, a reference\nin this section to the customer includes a reference to the legal\npersonal representative of the customer.",
      "skos:definition": "(6) If the customer is an individual and the customer dies, a reference\nin this section to the customer includes a reference to the legal\npersonal representative of the customer.",
      "values:partOf": {
