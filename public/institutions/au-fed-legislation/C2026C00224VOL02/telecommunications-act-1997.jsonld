      ],
      "cml:integrityHash": "a9d50ca89a5375f4da2dd20f712c43202782e28e92ccbbbf67538fe2b373977d",
      "skos:note": "Telstra cannot authorise operation of radiocommunications devices under the licence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-act-1997#sec-577k-ss-1",
      "@type": "cof:Section",
      "cof:title": "577K(1) Limits on use of certain spectrum licences by Telstra",
      "values:kind": "subsection",
      "cof:pageNumber": 581,
      "values:originalText": "(1) If:\n\n(a) the excluded spectrum regime applies to Telstra; and\n\n(b) a spectrum licence relates to a designated part of the\nspectrum;\nthe licensee of the spectrum licence must not authorise Telstra to\noperate radiocommunications devices under the licence.\nNote:\nFor excluded spectrum regime, see section 577GA."
    },
    {
      "@id": "concept:telecommunications-act-1997-sec-577k-ss-1-norm",
