      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "5866046e00ea9238d93721c9044c03a222efa1e0dbf19d00bfb2d8f2b5d990b1",
      "cml:proposedBy": {
