    {
      "@id": "concept:telecommunications-act-1997-sch-1-sec-47-ss-5-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister uses the ACCC’s report as a basis for their decision-making process.",
