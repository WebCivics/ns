        "concept:telecommunications-act-1997-sch-2-sec-9-logic-diffusion-4",
        "concept:telecommunications-act-1997-sch-2-sec-9-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
