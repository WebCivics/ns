      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The timeframe for making a decision is between 60 and 90 business days.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
