    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-73a-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The installation is restricted to a specific temporal interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval restriction",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "within",
      "cml:premiseText": "The relevant cable or cables must be installed within 926 metres of the route or routes specified by the ACMA in the permit."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-73a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is obligatory to install the cable or cables within that distance.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory condition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "The relevant cable or cables must be installed within 926 metres of the route or routes specified by the ACMA in the permit."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-73a-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is obligatory to obtain regulatory approvals before installing the cable or cables.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory condition for regulatory approvals",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "A person acting on behalf of the carrier must not install the relevant cable or cables unless all Commonwealth regulatory approvals have been obtained for the installation."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-73a-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is obligatory to comply with security conditions specified by the ACMA.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory condition for security",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "Such conditions (if any) in relation to security as the ACMA specifies in the permit."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-73a-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is obligatory to comply with installation conditions specified by the ACMA.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory condition for installation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "Such conditions (if any) in relation to the installation of the relevant cable or cables as the ACMA specifies in the permit."
    },
