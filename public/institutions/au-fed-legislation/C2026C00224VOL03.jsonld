    {
      "@id": "concept:telecommunications-act-1997-sch-2-sec-9",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.77",
      "skos:note": "Carriage service providers must provide information to a person or association under an obligation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "9 Simplified outline"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sch-2-sec-9-norm",
        "concept:telecommunications-act-1997-sch-2-sec-9-logic-deontic-1",
        "concept:telecommunications-act-1997-sch-2-sec-9-logic-alleninterval-2",
