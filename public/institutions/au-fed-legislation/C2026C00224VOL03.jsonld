    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-58-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.185",
      "skos:note": "Decision must be made within a specified timeframe after receiving further information.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "58(1) Timing of decision on application"
      },
