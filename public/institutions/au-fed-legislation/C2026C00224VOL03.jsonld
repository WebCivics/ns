    },
    {
      "@id": "concept:telecommunications-act-1997-sch-2-sec-9-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Information must be provided at least as soon as the obligation begins.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Information must be provided at any time after the obligation begins",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The obligation to provide information begins at some point in the future."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-2-sec-9-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Fulfilling the obligation requires providing the required information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Providing information implies fulfilling the obligation",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "Providing information is a necessary condition for fulfilling the obligation."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-2-sec-9-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "They are intelligent agents capable of providing information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Carriage service providers are intelligent agents",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS-A",
      "cml:premiseText": "Carriage service providers have the capacity for intelligent action."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-2-sec-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "They must provide the required information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Carriage service providers have an obligation to provide information."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-2-sec-9-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information is spread to all relevant parties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Information spreads to all relevant parties",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS-SPREAD-TO",
      "cml:premiseText": "The information is disseminated to all relevant individuals or organizations."
    },
