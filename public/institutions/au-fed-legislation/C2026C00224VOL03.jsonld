    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-57a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-act-1997.pdf, p.184",
      "skos:note": "Grant of protection zone installation permit to a carrier may be refused due to security concerns.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "57A(1) Refusal of permit—security"
      },
      "wasDerivedFrom": "telecommunications-act-1997.pdf",
      "asserts": [
        "concept:telecommunications-act-1997-sch-3a-sec-57a-ss-1-norm",
        "concept:telecommunications-act-1997-sch-3a-sec-57a-ss-1-logic-deontic-1",
