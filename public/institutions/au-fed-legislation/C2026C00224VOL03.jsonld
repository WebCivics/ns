    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-58-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The timeframe is between 25 business days and 35 business days.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for decision-making.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "A decision must be made within 25 business days or as specified by written notice."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-58-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The ACMA processes the further information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Processing of further information by the ACMA.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "PROCESS",
      "cml:premiseText": "The applicant gave the ACMA further information under subclause 55(1) in relation to the application."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-58-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A decision must be made within 25 business days or as specified by written notice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to make a decision within a specified timeframe.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The ACMA must take all reasonable steps to ensure that a decision is made on the application."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-3a-sec-58-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Further information influences the decision-making process.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Influence of further information on decision-making.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "INFLUENCE",
      "cml:premiseText": "The ACMA must take all reasonable steps to ensure that a decision is made on the application."
    },
    {
