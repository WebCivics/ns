    },
    {
      "@id": "concept:telecommunications-act-1997-sch-1-sec-47-ss-5-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister’s decision-making process involves diffusing information about the ACCC’s report and other relevant matters.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Minister's decision-making process is a diffusion of information.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The Minister must decide whether to make the declaration."
    },
    {
      "@id": "concept:telecommunications-act-1997-sch-1-sec-47-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister considers the ACCC’s report without any lower temporal limit.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Minister's consideration of ACCC's report is a temporal interval with no lower bound.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The Minister must have regard to the ACCC’s report."
    },
