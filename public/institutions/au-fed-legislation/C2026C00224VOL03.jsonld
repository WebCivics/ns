      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the notice serving diffuses from the carrier to the land owner.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
