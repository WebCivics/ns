concept:telecommunications-act-1997-sch-1-sec-37 a cml:Concept ;
    skos:prefLabel "37 Code relating to access"@en ;
    cml:realizedBy doc:sch-1-sec-37 ;
    values:originalText "(1) The ACCC may, by legislative instrument, make a Code setting out conditions that are to be complied with in relation to the provision of access under this Part.  (2) A carrier must comply with the Code.  (3) This clause does not, by implication, limit a power conferred by or under this Act to make an instrument.  Schedule 1  Standard carrier licence conditions" ;
    skos:definition "(1) The ACCC may, by legislative instrument, make a Code setting out conditions that are to be complied with in relation to the provision of access under this Part.  (2) A carrier must comply with the Code.  (3) This clause does not, by implication, limit a power conferred by or under this Act to make an instrument.  Schedule 1  Standard carrier licence conditions"@en ;
    cml:integrityHash "cfe63dd65cacb5548bc3a6be9efade39b741dd024f0413d88dc5cfa8c8270627" ;
    cof:pageNumber "37"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sch-1-sec-37-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sch-1-sec-37-ss-2 ;
    cml:hasPart concept:telecommunications-act-1997-sch-1-sec-37-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.37" .
