concept:telecommunications-act-1997-sch-3a-sec-24 a cml:Concept ;
    skos:prefLabel "24 Variation or revocation on ACMA’s initiative or in response to"@en ;
    cml:realizedBy doc:sch-3a-sec-24 ;
    values:originalText "request  A variation or revocation of a declaration of a protection zone may be made:  (a) on the ACMA’s own initiative; or  (b) at the request of a person." ;
    skos:definition "request  A variation or revocation of a declaration of a protection zone may be made:  (a) on the ACMA’s own initiative; or  (b) at the request of a person."@en ;
    cml:integrityHash "c18ff5008ecb27b6974b5234367d43ed4b0a4a8fd18b5b097615bffb29c9d50b" ;
    cof:pageNumber "162"^^xsd:integer ;
    skos:note "Variation or revocation of a declaration of a protection zone may be made on ACMA's own initiative or at the request of a person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
