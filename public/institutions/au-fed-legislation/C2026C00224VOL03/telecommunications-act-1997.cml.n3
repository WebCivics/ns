concept:telecommunications-act-1997-sch-4-sec-1 a cml:Concept ;
    skos:prefLabel "1 Reviewable decisions of the ACMA"@en ;
    cml:realizedBy doc:sch-4-sec-1 ;
    values:originalText "The following kinds of decisions are specified for the purposes of section 555:  (a) a decision under section 56, 58 or 59 to refuse to grant a carrier licence (other than a decision made in compliance with section 56A or 58A);  (b) a decision under section 69 to:  (i) give or vary a direction; or  (ii) refuse to revoke a direction;  (c) a decision under section 72 to cancel a carrier licence;  (d) a decision of a kind referred to in subsection 73(6) (which deals with remission of late payment penalty);  (e) a decision under section 81 to refuse to make a nominated carrier declaration;  (f) a decision under section 83 to revoke a nominated carrier declaration;  (g) a decision of a kind referred to in subsection 99(5) (which deals with decisions under service provider determinations);  (h) a decision under section 102 to:  (i) give or vary a direction; or  (ii) refuse to revoke a direction;  (i) a decision under section 117 to refuse to register a code;  (j) a decision under section 121 to:  (i) give or vary a direction; or  Schedule 4  Reviewable decisions of the ACMA" ;
    skos:definition "The following kinds of decisions are specified for the purposes of section 555:  (a) a decision under section 56, 58 or 59 to refuse to grant a carrier licence (other than a decision made in compliance with section 56A or 58A);  (b) a decision under section 69 to:  (i) give or vary a direction; or  (ii) refuse to revoke a direction;  (c) a decision under section 72 to cancel a carrier licence;  (d) a decision of a kind referred to in subsection 73(6) (which deals with remission of late payment penalty);  (e) a decision under section 81 to refuse to make a nominated carrier declaration;  (f) a decision under section 83 to revoke a nominated carrier declaration;  (g) a decision of a kind referred to in subsection 99(5) (which deals with decisions under service provider determinations);  (h) a decision under section 102 to:  (i) give or vary a direction; or  (ii) refuse to revoke a direction;  (i) a decision under section 117 to refuse to register a code;  (j) a decision under section 121 to:  (i) give or vary a direction; or  Schedule 4  Reviewable decisions of the ACMA"@en ;
    cml:integrityHash "ec9e7db87cb0ce4e5d5a59f4508a02c47ec3f526b4ac2ef65f2e7bbc1f459e13" ;
    cof:pageNumber "211"^^xsd:integer ;
    skos:note "Reviewable decisions of the ACMA" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.211" ;
