    values:partOf concept:telecommunications-act-1997-sch-1-sec-21 ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Provide reasonable access to operations support systems and traffic flow information upon request." ;
    dc:description "true" ;
