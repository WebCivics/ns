concept:telecommunications-act-1997-sch-3a-sec-55 a cml:Concept ;
    skos:prefLabel "55 Further information"@en ;
    cml:realizedBy doc:sch-3a-sec-55 ;
    values:originalText "(1) The ACMA may request the applicant to give the ACMA further information about the application.  (2) The ACMA may refuse to consider the application until the applicant gives the ACMA the information." ;
    skos:definition "(1) The ACMA may request the applicant to give the ACMA further information about the application.  (2) The ACMA may refuse to consider the application until the applicant gives the ACMA the information."@en ;
