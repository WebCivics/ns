doc:sch-3a-sec-42 a cof:Section ;
    cof:title "42 Defences to offences of engaging in prohibited or restricted" ;
    values:kind "section" ;
    values:originalText "activities  Clauses 40 and 41 do not apply if:  (a) the conduct was necessary to save a life or ship; or  (b) the conduct was necessary to prevent pollution; or  (c) the defendant took all reasonable steps to avoid engaging in the conduct. Note: The defendant bears an evidential burden in relation to the matters in this clause. See subsection 13.3(3) of the Criminal Code." ;
    cof:pageNumber "171"^^xsd:integer .

concept:telecommunications-act-1997-sch-3a-sec-43 a cml:Concept ;
    skos:prefLabel "43 Alternative verdict if aggravated offence not proven"@en ;
    cml:realizedBy doc:sch-3a-sec-43 ;
    values:originalText "If, on a trial for an offence against clause 41:  (a) the arbiter of fact is not satisfied that the defendant engaged in the activity with the intention of making a commercial gain; and  (b) the arbiter of fact is otherwise satisfied that the defendant has committed an offence against clause 40; the arbiter may find the defendant not guilty of the offence against clause 41 but guilty of an offence against clause 40, so long as the defendant has been accorded procedural fairness in relation to that finding of guilt." ;
    skos:definition "If, on a trial for an offence against clause 41:  (a) the arbiter of fact is not satisfied that the defendant engaged in the activity with the intention of making a commercial gain; and  (b) the arbiter of fact is otherwise satisfied that the defendant has committed an offence against clause 40; the arbiter may find the defendant not guilty of the offence against clause 41 but guilty of an offence against clause 40, so long as the defendant has been accorded procedural fairness in relation to that finding of guilt."@en ;
    cml:integrityHash "4e6e15451d98eec2292b8e75202cb6cb9e83392c5db9f00be934de97dff4a50b" ;
    cof:pageNumber "171"^^xsd:integer ;
    skos:note "Defendant must be accorded procedural fairness in relation to finding of guilt." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.171" ;
