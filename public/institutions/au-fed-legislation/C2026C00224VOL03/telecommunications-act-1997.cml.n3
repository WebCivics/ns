doc:sch-1-sec-30 a cof:Section ;
    cof:title "30 Simplified outline" ;
    values:kind "section" ;
    values:originalText "The following is a simplified outline of this Part: • Carriers must provide other carriers with access to:  (a) telecommunications transmission towers; and  (b) the sites of telecommunications transmission towers; and  (c) underground facilities that are designed to hold lines." ;
    cof:pageNumber "27"^^xsd:integer .

concept:telecommunications-act-1997-sch-1-sec-31 a cml:Concept ;
    skos:prefLabel "31 Definitions"@en ;
    cml:realizedBy doc:sch-1-sec-31 ;
    values:originalText "In this Part: eligible underground facility means an underground facility that is used, installed ready to be used, or intended to be used, to hold lines. NBN corporation has the same meaning as in section 577BA. site means:  (a) land; or  (b) a building on land; or  (c) a structure on land. telecommunications transmission tower means:  (a) a tower; or  (b) a pole; or  (c) a mast; or  Schedule 1  Standard carrier licence conditions" ;
    skos:definition "In this Part: eligible underground facility means an underground facility that is used, installed ready to be used, or intended to be used, to hold lines. NBN corporation has the same meaning as in section 577BA. site means:  (a) land; or  (b) a building on land; or  (c) a structure on land. telecommunications transmission tower means:  (a) a tower; or  (b) a pole; or  (c) a mast; or  Schedule 1  Standard carrier licence conditions"@en ;
    cml:integrityHash "f7c0fabd1ccb107876219a285f41fb6b9381a175d8b0103eea1e7512991e1d38" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Definitions for eligible underground facility, site, and telecommunications transmission tower." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.27" ;
    cml:asserts concept:telecommunications-act-1997-sch-1-sec-31-norm .
