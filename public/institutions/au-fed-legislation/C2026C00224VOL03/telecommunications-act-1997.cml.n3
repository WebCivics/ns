doc:sch-1-sec-26-ss-2 a cof:Section ;
    cof:title "26(2) Security procedures" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of subclause (1), security procedures are procedures designed to protect the confidentiality of information." ;
    cof:pageNumber "23"^^xsd:integer .

concept:telecommunications-act-1997-sch-1-sec-27 a cml:Concept ;
    skos:prefLabel "27 Terms and conditions of compliance"@en ;
    cml:realizedBy doc:sch-1-sec-27 ;
    values:originalText "(1) The first carrier (within the meaning of clause 21, 22, 23, 24 or 25) must comply with a requirement imposed on the first carrier by that clause on such terms and conditions as are:  (a) agreed between the following parties:  (i) the first carrier;  (ii) the second carrier (within the meaning of that clause); or  (b) failing agreement, determined by an arbitrator appointed by the parties.  Schedule 1  Standard carrier licence conditions" ;
    skos:definition "(1) The first carrier (within the meaning of clause 21, 22, 23, 24 or 25) must comply with a requirement imposed on the first carrier by that clause on such terms and conditions as are:  (a) agreed between the following parties:  (i) the first carrier;  (ii) the second carrier (within the meaning of that clause); or  (b) failing agreement, determined by an arbitrator appointed by the parties.  Schedule 1  Standard carrier licence conditions"@en ;
    cml:integrityHash "29f53782c75f1423decddc982bff2b37da5ace8d7a381d8e05d786ff782b54f3" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "First carrier must comply with requirements imposed by clause on agreed terms and conditions or determined by arbitrator." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
