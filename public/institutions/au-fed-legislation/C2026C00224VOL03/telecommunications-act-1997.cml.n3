concept:telecommunications-act-1997-sch-2-sec-3 a cml:Concept ;
    skos:prefLabel "3 Scope of Part"@en ;
    cml:realizedBy doc:sch-2-sec-3 ;
    values:originalText "This Part applies to the following operator services:  (a) services for dealing with faults and service difficulties;  (b) services of a kind specified in the regulations." ;
