    cml:hasPart concept:telecommunications-act-1997-sch-1-sec-80-ss-9 ;
    cml:hasPart concept:telecommunications-act-1997-sch-1-sec-80-ss-10 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
