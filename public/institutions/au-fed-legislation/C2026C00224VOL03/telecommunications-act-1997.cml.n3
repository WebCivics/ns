concept:telecommunications-act-1997-sch-3-sec-25 a cml:Concept ;
    skos:prefLabel "25 Issue of facility installation permit"@en ;
    cml:realizedBy doc:sch-3-sec-25 ;
    values:originalText "(1) After considering the application, the ACMA may issue a facility installation permit authorising the applicant to carry out the installation of any or all of the facilities specified in the application.  Schedule 3  Carriers’ powers and immunities" ;
    skos:definition "(1) After considering the application, the ACMA may issue a facility installation permit authorising the applicant to carry out the installation of any or all of the facilities specified in the application.  Schedule 3  Carriers’ powers and immunities"@en ;
    cml:integrityHash "119a3fd5ca060163830d1e08840e6bf86aba4c25dd3babc8f0d52f0f90c9d091" ;
    cof:pageNumber "113"^^xsd:integer ;
    skos:note "Issue facility installation permit after considering application." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
