concept:telecommunications-act-1997-sch-3a-sec-74 a cml:Concept ;
    skos:prefLabel "74 Duration of permit"@en ;
    cml:realizedBy doc:sch-3a-sec-74 ;
    values:originalText "A non-protection zone installation permit is in force for a period of 18 months from the day the permit is granted." ;
