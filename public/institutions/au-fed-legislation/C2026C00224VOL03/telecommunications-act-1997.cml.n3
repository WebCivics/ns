doc:sch-1-sec-34-ss-2 a cof:Section ;
    cof:title "34(2) Access to sites of telecommunications transmission towers" ;
    values:kind "subsection" ;
    values:originalText "(2) The first carrier is not required to comply with subclause (1) unless:  (a) the access is provided for the sole purpose of enabling the second carrier to install a facility used, or for use, in connection with the supply of a carriage service by means of radiocommunications; and  (b) the second carrier gives the first carrier reasonable notice that the second carrier requires the access." ;
    cof:pageNumber "30"^^xsd:integer .

concept:telecommunications-act-1997-sch-1-sec-34-ss-3 a cml:Concept ;
    skos:prefLabel "34(3) Access to sites of telecommunications transmission towers"@en ;
    cml:realizedBy doc:sch-1-sec-34-ss-3 ;
    values:originalText "(3) The first carrier is not required to comply with subclause (1) in relation to a particular site if there is in force a written certificate issued by the ACCC stating that, in the ACCC’s opinion, compliance with subclause (1) in relation to that site is not technically feasible." ;
    skos:definition "(3) The first carrier is not required to comply with subclause (1) in relation to a particular site if there is in force a written certificate issued by the ACCC stating that, in the ACCC’s opinion, compliance with subclause (1) in relation to that site is not technically feasible."@en ;
    cml:integrityHash "eb7ea5431a47768340575e34371687128e0cfd5c79861727ffa1444c69498de3" ;
    values:partOf concept:telecommunications-act-1997-sch-1-sec-34 ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Exempts first carrier from complying with subclause (1) if ACCC certifies technical infeasibility." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.30" ;
    cml:asserts concept:telecommunications-act-1997-sch-1-sec-34-ss-3-norm .
