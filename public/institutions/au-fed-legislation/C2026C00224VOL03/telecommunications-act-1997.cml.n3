concept:telecommunications-act-1997-sch-3-sec-29 a cml:Concept ;
    skos:prefLabel "29 Consultation with the ACCC"@en ;
    cml:realizedBy doc:sch-3-sec-29 ;
    values:originalText "Before making a decision to issue, or to refuse to issue, a facility installation permit, the ACMA must consult the ACCC." ;
