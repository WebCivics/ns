    values:originalText "In engaging in an activity under Division 2, 3 or 4, a carrier must take all reasonable steps to ensure that the carrier causes as little detriment and inconvenience, and does as little damage, as is practicable." ;
    skos:definition "In engaging in an activity under Division 2, 3 or 4, a carrier must take all reasonable steps to ensure that the carrier causes as little detriment and inconvenience, and does as little damage, as is practicable."@en ;
    cml:integrityHash "843bfa7fe4b8806069718d383f205126f9d5feb22018ecfa3e4be66bba88d5b2" ;
    cof:pageNumber "102"^^xsd:integer ;
    skos:note "Carrier must take reasonable steps to minimize damage and inconvenience." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.102" ;
