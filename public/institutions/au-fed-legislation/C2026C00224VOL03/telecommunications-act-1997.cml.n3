doc:sch-3a-sec-30-ss-1 a cof:Section ;
    cof:title "30(1) ACMA to develop a variation or revocation proposal" ;
    values:kind "subsection" ;
    values:originalText "(1) Before the ACMA varies or revokes a declaration of a protection zone, the ACMA must develop a proposal to vary or revoke the declaration." ;
    cof:pageNumber "164"^^xsd:integer .

