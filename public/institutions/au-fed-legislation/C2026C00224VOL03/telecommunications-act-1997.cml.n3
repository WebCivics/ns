doc:sch-3a-sec-6-ss-1 a cof:Section ;
    cof:title "6(1) Response to a request to declare a protection zone" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a person requests the ACMA to declare a protection zone; and  Protection of submarine cables  Schedule 3A Protection zones  Part 2 Declaration of protection zones  Division 2  Clause 7  Telecommunications Act 1997  Compilation date: 04/06/2026  (b) the ACMA decides to develop a proposal for a protection zone in response to the request; the ACMA must give the person a copy of its proposal. ACMA decides not to develop a proposal" ;
    cof:pageNumber "150"^^xsd:integer .

concept:telecommunications-act-1997-sch-3a-sec-6-ss-2 a cml:Concept ;
    skos:prefLabel "6(2) Response to a request to declare a protection zone"@en ;
    cml:realizedBy doc:sch-3a-sec-6-ss-2 ;
    values:originalText "(2) If:  (a) a person requests the ACMA to declare a protection zone; and  (b) the ACMA decides not to develop a proposal for a protection zone in response to the request; the ACMA must notify the person in writing of the ACMA’s decision and the reasons for the decision." ;
    skos:definition "(2) If:  (a) a person requests the ACMA to declare a protection zone; and  (b) the ACMA decides not to develop a proposal for a protection zone in response to the request; the ACMA must notify the person in writing of the ACMA’s decision and the reasons for the decision."@en ;
    cml:integrityHash "d40fa56fcd3260be745b2241469ecf83ee297e5ba3a2c7b7699a6021781fafcd" ;
    values:partOf concept:telecommunications-act-1997-sch-3a-sec-6 ;
    cof:pageNumber "150"^^xsd:integer ;
    skos:note "ACMA must notify person of decision not to declare protection zone" ;
    dc:description "reasons for decision" ;
    cml:curationStatus cml:Proposed ;
