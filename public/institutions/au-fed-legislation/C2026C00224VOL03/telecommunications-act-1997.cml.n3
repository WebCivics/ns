doc:sch-3a-sec-9-ss-5 a cof:Section ;
    cof:title "9(5) Area of a protection zone" ;
    values:kind "subsection" ;
    values:originalText "(5) A declaration of a protection zone in relation to more than one submarine cable has no effect to the extent that it covers an area outside the area described in subclause (4). Nominal location" ;
    cof:pageNumber "152"^^xsd:integer .

concept:telecommunications-act-1997-sch-3a-sec-9-ss-6 a cml:Concept ;
    skos:prefLabel "9(6) Area of a protection zone"@en ;
    cml:realizedBy doc:sch-3a-sec-9-ss-6 ;
    values:originalText "(6) In this clause: nominal location, of a submarine cable or cables, means the nominal location specified in the declaration of the protection zone in relation to the cable or cables." ;
