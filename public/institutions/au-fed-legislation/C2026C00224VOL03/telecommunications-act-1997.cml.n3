doc:sch-1-sec-1-ss-2 a cof:Section ;
    cof:title "1(2) Compliance with this Act" ;
    values:kind "subsection" ;
    values:originalText "(2) In this clause: this Act includes the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act and Chapter 5 of the Telecommunications (Interception and Access) Act 1979.  Schedule 1  Standard carrier licence conditions" ;
    cof:pageNumber "13"^^xsd:integer .

concept:telecommunications-act-1997-sch-1-sec-16 a cml:Concept ;
    skos:prefLabel "16 Simplified outline"@en ;
    cml:realizedBy doc:sch-1-sec-16 ;
    values:originalText "The following is a simplified outline of this Part: • Carriers must provide other carriers with access to facilities for the purpose of enabling the other carriers to:  (a) provide competitive facilities and competitive carriage services; or  (b) establish their own facilities." ;
    skos:definition "The following is a simplified outline of this Part: • Carriers must provide other carriers with access to facilities for the purpose of enabling the other carriers to:  (a) provide competitive facilities and competitive carriage services; or  (b) establish their own facilities."@en ;
