concept:telecommunications-act-1997-sch-3-sec-54-ss-1 cml:asserts concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-deontic-1 .
concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of serving notice on land owner if unable to find or serve personally/posteriously." ;
    cml:premiseText "(a) a carrier is unable, after diligent inquiry, to find out who owns particular land; or (b) a carrier is unable to serve a notice under this Part on the owner of land either personally or by post;" ;
    cml:conclusionText "the carrier may not serve a notice under this Part on the owner of the land." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sch-3-sec-54-ss-1 cml:asserts concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-alleninterval-2 .
concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlap" ;
    cml:logicSummary "Overlap between notice serving and land occupation." ;
    cml:premiseText "(c) if the land is occupied—serving a copy of the notice on the occupier;" ;
    cml:conclusionText "the notice serving and land occupation overlap when the land is occupied." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sch-3-sec-54-ss-1 cml:asserts concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-ltl-3 .
concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Recurring trace of notice serving on unoccupied land." ;
    cml:premiseText "(d) if the land is not occupied—attaching, if practicable, a copy of the notice to a conspicuous part of the land;" ;
    cml:conclusionText "the notice serving on unoccupied land recurs when attached to a conspicuous part of the land." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sch-3-sec-54-ss-1 cml:asserts concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-diffusion-4 .
concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuse" ;
    cml:logicSummary "Diffusion of notice serving from carrier to land owner." ;
    cml:premiseText "(a) a carrier is unable, after diligent inquiry, to find out who owns particular land; or (b) a carrier is unable to serve a notice under this Part on the owner of land either personally or by post;" ;
    cml:conclusionText "the notice serving diffuses from the carrier to the land owner." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sch-3-sec-54-ss-1 cml:asserts concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-argumentation-5 .
concept:telecommunications-act-1997-sch-3-sec-54-ss-1-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Imply" ;
    cml:logicSummary "Implication of notice serving on land ownership." ;
    cml:premiseText "(a) a carrier is unable, after diligent inquiry, to find out who owns particular land; or (b) a carrier is unable to serve a notice under this Part on the owner of land either personally or by post;" ;
    cml:conclusionText "the land owner is implied if the carrier is unable to find out who owns it." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-54-ss-1 a cof:Section ;
    cof:title "54(1) Service of notices" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a carrier is unable, after diligent inquiry, to find out who owns particular land; or  (b) a carrier is unable to serve a notice under this Part on the owner of land either personally or by post; the carrier may serve a notice under this Part on the owner of the land by publishing a copy of the notice in a newspaper circulating in a district in which the land is situated and:  (c) if the land is occupied—serving a copy of the notice on the occupier; or  (d) if the land is not occupied—attaching, if practicable, a copy of the notice to a conspicuous part of the land." ;
    cof:pageNumber "137"^^xsd:integer .

concept:telecommunications-act-1997-sch-3-sec-54-ss-2 a cml:Concept ;
    skos:prefLabel "54(2) Service of notices"@en ;
    cml:realizedBy doc:sch-3-sec-54-ss-2 ;
    values:originalText "(2) If a carrier is unable, after diligent inquiry, to find out:  (a) whether particular land is occupied; or  (b) who occupies particular land;  Schedule 3  Carriers’ powers and immunities" ;
    skos:definition "(2) If a carrier is unable, after diligent inquiry, to find out:  (a) whether particular land is occupied; or  (b) who occupies particular land;  Schedule 3  Carriers’ powers and immunities"@en ;
    cml:integrityHash "97ac4fb27b71ec35f2faa48a303c4f26f09a0713ecbc877fde05af9208d73bd8" ;
