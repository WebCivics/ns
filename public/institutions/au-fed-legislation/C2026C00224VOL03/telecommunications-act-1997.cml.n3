concept:telecommunications-act-1997-sch-3-sec-39 a cml:Concept ;
    skos:prefLabel "39 Liability to taxation not affected"@en ;
    cml:realizedBy doc:sch-3-sec-39 ;
    values:originalText "This Division does not affect the liability of a carrier to taxation under a law of a State or Territory.  Schedule 3  Carriers’ powers and immunities" ;
