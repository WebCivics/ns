concept:telecommunications-act-1997-sch-2-sec-18 a cml:Concept ;
    skos:prefLabel "18 Compliance with the priority assistance industry code"@en ;
    cml:realizedBy doc:sch-2-sec-18 ;
    values:originalText "A carriage service provider must comply with the priority assistance industry code to the extent (if any) to which the code is applicable to the provider." ;
    skos:definition "A carriage service provider must comply with the priority assistance industry code to the extent (if any) to which the code is applicable to the provider."@en ;
