concept:telecommunications-act-1997-sch-1-sec-70 a cml:Concept ;
    skos:prefLabel "70 Declared network services"@en ;
    cml:realizedBy doc:sch-1-sec-70 ;
    values:originalText "For the purposes of this Part, a declared network service is a service specified in a legislative instrument made by the Minister for the purposes of this clause." ;
