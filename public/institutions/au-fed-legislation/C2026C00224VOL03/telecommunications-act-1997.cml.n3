concept:telecommunications-act-1997-sch-3a-sec-64 a cml:Concept ;
    skos:prefLabel "64 Application for a permit to install an international submarine"@en ;
    cml:realizedBy doc:sch-3a-sec-64 ;
    values:originalText "cable in Australian waters (otherwise than in a protection zone or coastal waters)  A carrier may apply to the ACMA for a permit to install one or more international submarine cables in Australian waters that are not in a protection zone and that are not coastal waters of a State or the Northern Territory (a non-protection zone installation permit)." ;
    skos:definition "cable in Australian waters (otherwise than in a protection zone or coastal waters)  A carrier may apply to the ACMA for a permit to install one or more international submarine cables in Australian waters that are not in a protection zone and that are not coastal waters of a State or the Northern Territory (a non-protection zone installation permit)."@en ;
    cml:integrityHash "643fe7d612b4d0cff138cae2a316341fcb2904fe249f9f7d3644f72d306d9242" ;
    cof:pageNumber "191"^^xsd:integer ;
    skos:note "Carrier may apply for permit to install international submarine cables in non-protection zones and coastal waters." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.191" ;
