concept:telecommunications-act-1997-sch-1-sec-44 a cml:Concept ;
    skos:prefLabel "44 Remedial action"@en ;
    cml:realizedBy doc:sch-1-sec-44 ;
    values:originalText "(1) A carrier must take any remedial action that is reasonably required following an inspection under clause 42.  (2) A carrier must take any remedial action that is reasonably required following an investigation under clause 43.  (3) A carrier must comply with subclause (1) or (2) as soon as practicable after the carrier becomes aware of the need to take the remedial action concerned.  Schedule 1  Standard carrier licence conditions" ;
    skos:definition "(1) A carrier must take any remedial action that is reasonably required following an inspection under clause 42.  (2) A carrier must take any remedial action that is reasonably required following an investigation under clause 43.  (3) A carrier must comply with subclause (1) or (2) as soon as practicable after the carrier becomes aware of the need to take the remedial action concerned.  Schedule 1  Standard carrier licence conditions"@en ;
    cml:integrityHash "c4a8b6e584991903a060a8a9f51b62b8a3676a67f86f0f851ce1f0735663ffc4" ;
    cof:pageNumber "41"^^xsd:integer ;
