concept:telecommunications-act-1997-sch-1-sec-36-ss-8 a cml:Concept ;
    skos:prefLabel "36(8) Terms and conditions of access"@en ;
    cml:realizedBy doc:sch-1-sec-36-ss-8 ;
    values:originalText "(8) If:  (a) an agreement mentioned in paragraph (1)(a), (2)(a) or (3)(a) is in force; and  (b) the agreement is in writing; a determination under this clause has no effect to the extent to which it is inconsistent with the agreement." ;
    skos:definition "(8) If:  (a) an agreement mentioned in paragraph (1)(a), (2)(a) or (3)(a) is in force; and  (b) the agreement is in writing; a determination under this clause has no effect to the extent to which it is inconsistent with the agreement."@en ;
    cml:integrityHash "36598d297fb86ca5eb830e8bff1076e663ff912264d76869c8841a7021f5936b" ;
    values:partOf concept:telecommunications-act-1997-sch-1-sec-36 ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Determination under this clause has no effect to the extent it is inconsistent with an agreement in writing." ;
    cml:curationStatus cml:Proposed ;
