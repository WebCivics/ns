concept:telecommunications-act-1997-sch-2-sec-17 a cml:Concept ;
    skos:prefLabel "17 Priority assistance industry code"@en ;
    cml:realizedBy doc:sch-2-sec-17 ;
    values:originalText "For the purposes of this Part, the priority assistance industry code is:  (a) the code that is:  (i) entitled Priority Assistance for Life Threatening Medical Conditions; and  (ii) registered under Part 6; or  (b) if that code is replaced by another code registered under Part 6—the replacement code.  Standard service provider rules  Schedule 2 Priority assistance  Part 6  Clause 18  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "For the purposes of this Part, the priority assistance industry code is:  (a) the code that is:  (i) entitled Priority Assistance for Life Threatening Medical Conditions; and  (ii) registered under Part 6; or  (b) if that code is replaced by another code registered under Part 6—the replacement code.  Standard service provider rules  Schedule 2 Priority assistance  Part 6  Clause 18  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "a25c8c16488756a6340c05ccfe0c6d3510f6e9754704737129322461942c8024" ;
    cof:pageNumber "82"^^xsd:integer ;
