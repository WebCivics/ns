doc:sch-3-sec-9a-ss-2 a cof:Section ;
    cof:title "9A(2) Carrier to restore land—removal of temporary facilities" ;
    values:kind "subsection" ;
    values:originalText "(2) If:  (a) a carrier installs a facility under Division 4 on particular land; and  (b) the installation of the facility is covered by subclause 7(3A); and  (c) the carrier removes the facility; the carrier must take all reasonable steps to ensure that the land is restored to a condition that is similar to its condition before the installation began." ;
    cof:pageNumber "104"^^xsd:integer .

concept:telecommunications-act-1997-sch-3-sec-9a-ss-3 a cml:Concept ;
    skos:prefLabel "9A(3) Carrier to restore land—removal of temporary facilities"@en ;
    cml:realizedBy doc:sch-3-sec-9a-ss-3 ;
    values:originalText "(3) If the installation of the facility is covered by paragraph 6(5)(b), (c), (d), (e), (f) or (g), the carrier must take all reasonable steps to ensure that the restoration begins within 10 business days after the removal of the facility." ;
    skos:definition "(3) If the installation of the facility is covered by paragraph 6(5)(b), (c), (d), (e), (f) or (g), the carrier must take all reasonable steps to ensure that the restoration begins within 10 business days after the removal of the facility."@en ;
    cml:integrityHash "82c1b4c03a539e96bf085855999fddc3d3ad0737412caad6ea7ab3eacda816e9" ;
    values:partOf concept:telecommunications-act-1997-sch-3-sec-9a ;
    cof:pageNumber "104"^^xsd:integer ;
    skos:note "Carrier must restore land within 10 business days after removal of temporary facilities." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.104" ;
