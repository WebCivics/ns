concept:telecommunications-act-1997-sch-3-sec-17-ss-7 a cml:Concept ;
    skos:prefLabel "17(7) Notice to owner of land—general"@en ;
    cml:realizedBy doc:sch-3-sec-17-ss-7 ;
    values:originalText "(7) Subclause (1) does not apply if the carrier intends to engage in an activity under Division 2 (which deals with inspection) in relation to land that is a public place and the activity:  (a) is not inconsistent with Australia’s obligations under a listed international agreement; and  Schedule 3  Carriers’ powers and immunities" ;
    skos:definition "(7) Subclause (1) does not apply if the carrier intends to engage in an activity under Division 2 (which deals with inspection) in relation to land that is a public place and the activity:  (a) is not inconsistent with Australia’s obligations under a listed international agreement; and  Schedule 3  Carriers’ powers and immunities"@en ;
    cml:integrityHash "a57ee834fc5be175b478d42ec159f383d0975c6ab3985086574fabe59550441f" ;
    values:partOf concept:telecommunications-act-1997-sch-3-sec-17 ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Activity not inconsistent with Australia's obligations under a listed international agreement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
