concept:telecommunications-act-1997-sch-3-sec-20 a cml:Concept ;
    skos:prefLabel "20 Roads etc. to remain open for passage"@en ;
    cml:realizedBy doc:sch-3-sec-20 ;
    values:originalText "If a carrier engages in an activity covered by Division 3, the carrier must ensure that a facility installed over a road, bridge, path or navigable water is installed in a way that will allow reasonable passage by persons, vehicles and vessels.  Carriers’ powers and immunities  Schedule 3 General provisions  Part 1 Facility installation permits  Division 6  Clause 21  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "If a carrier engages in an activity covered by Division 3, the carrier must ensure that a facility installed over a road, bridge, path or navigable water is installed in a way that will allow reasonable passage by persons, vehicles and vessels.  Carriers’ powers and immunities  Schedule 3 General provisions  Part 1 Facility installation permits  Division 6  Clause 21  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "02f5e8d8cb023d888d8f88218d2d20e2dc48cde7d5b4c00bdceb0448c0f695a4" ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "Ensure facility installation allows reasonable passage." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.112" ;
