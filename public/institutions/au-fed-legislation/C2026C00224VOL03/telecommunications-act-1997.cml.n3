    values:partOf concept:telecommunications-act-1997-sch-3a-sec-30 ;
    cof:pageNumber "164"^^xsd:integer ;
    skos:note "ACMA may provide a copy of the proposal in electronic form upon request." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
