doc:sch-3a-sec-84a-ss-3 a cof:Section ;
    cof:title "84A(3) Installing a domestic submarine cable without a permit" ;
    values:kind "subsection" ;
    values:originalText "(3) Subclause (1) does not apply to a person who installs a domestic submarine cable on behalf of a carrier, if the carrier has a permit authorising the installation of the cable. Note: The defendant bears an evidential burden in relation to the matters in subclause (3). See subsection 13.3(3) of the Criminal Code." ;
    cof:pageNumber "204"^^xsd:integer .

concept:telecommunications-act-1997-sch-3a-sec-84a-ss-4 a cml:Concept ;
    skos:prefLabel "84A(4) Installing a domestic submarine cable without a permit"@en ;
    cml:realizedBy doc:sch-3a-sec-84a-ss-4 ;
    values:originalText "(4) Subclause (1) does not apply to a domestic submarine cable that a person installed, or began to install, before the commencement of this clause. Note: The defendant bears an evidential burden in relation to the matters in subclause (4). See subsection 13.3(3) of the Criminal Code." ;
    skos:definition "(4) Subclause (1) does not apply to a domestic submarine cable that a person installed, or began to install, before the commencement of this clause. Note: The defendant bears an evidential burden in relation to the matters in subclause (4). See subsection 13.3(3) of the Criminal Code."@en ;
    cml:integrityHash "75ef2d0117d94dd15d7cb9c0c440cdf02545bfb08eb7cc082c95348021b5389d" ;
    values:partOf concept:telecommunications-act-1997-sch-3a-sec-84a ;
