concept:telecommunications-act-1997-sch-3a-sec-57a-ss-3 a cml:Concept ;
    skos:prefLabel "57A(3) Refusal of permit—security"@en ;
    cml:realizedBy doc:sch-3a-sec-57a-ss-3 ;
    values:originalText "(3) While a direction is in force under this clause:  (a) the ACMA cannot reconsider a non-compulsory refusal to grant a protection zone installation permit to the carrier; and  (b) the Administrative Review Tribunal cannot consider an application for review of a non-compulsory refusal to grant a protection zone installation permit to the carrier." ;
    skos:definition "(3) While a direction is in force under this clause:  (a) the ACMA cannot reconsider a non-compulsory refusal to grant a protection zone installation permit to the carrier; and  (b) the Administrative Review Tribunal cannot consider an application for review of a non-compulsory refusal to grant a protection zone installation permit to the carrier."@en ;
    cml:integrityHash "9c3df0ed3dbb0e6e603c14f2a5d2419c91936edda960531db03f1fabf699e2ae" ;
    values:partOf concept:telecommunications-act-1997-sch-3a-sec-57a ;
    cof:pageNumber "184"^^xsd:integer ;
    skos:note "Cannot reconsider non-compulsory refusal to grant permit" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
