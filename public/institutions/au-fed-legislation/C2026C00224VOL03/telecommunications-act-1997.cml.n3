concept:telecommunications-act-1997-sch-3a-sec-30-ss-3 a cml:Concept ;
    skos:prefLabel "30(3) ACMA to develop a variation or revocation proposal"@en ;
    cml:realizedBy doc:sch-3a-sec-30-ss-3 ;
    values:originalText "(3) If a person requests the ACMA to give the person a copy of the proposal, the ACMA must give the person a copy of the proposal within 2 business days after the day on which the ACMA received the request." ;
    skos:definition "(3) If a person requests the ACMA to give the person a copy of the proposal, the ACMA must give the person a copy of the proposal within 2 business days after the day on which the ACMA received the request."@en ;
