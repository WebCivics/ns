doc:sch-1-sec-35-ss-2 a cof:Section ;
    cof:title "35(2) Access to eligible underground facilities" ;
    values:kind "subsection" ;
    values:originalText "(2) The first carrier is not required to comply with subclause (1) unless:  (a) the access is provided for the sole purpose of enabling the second carrier to install a line used, or for use, in connection with the supply of a carriage service; and  (b) the second carrier gives the first carrier reasonable notice that the second carrier requires the access." ;
    cof:pageNumber "33"^^xsd:integer .

concept:telecommunications-act-1997-sch-1-sec-35-ss-3 a cml:Concept ;
    skos:prefLabel "35(3) Access to eligible underground facilities"@en ;
    cml:realizedBy doc:sch-1-sec-35-ss-3 ;
    values:originalText "(3) The first carrier is not required to comply with subclause (1) in relation to a particular eligible underground facility if there is in force a written certificate issued by the ACCC stating that, in the  Schedule 1  Standard carrier licence conditions" ;
    skos:definition "(3) The first carrier is not required to comply with subclause (1) in relation to a particular eligible underground facility if there is in force a written certificate issued by the ACCC stating that, in the  Schedule 1  Standard carrier licence conditions"@en ;
    cml:integrityHash "00131b8e4eb8c7b8dbd8907cb0ae3cc5452ab4b13fd27f9f88d512613f8d2d5f" ;
    values:partOf concept:telecommunications-act-1997-sch-1-sec-35 ;
