    skos:prefLabel "45(2) Person may claim damages"@en ;
    cml:realizedBy doc:sch-3a-sec-45-ss-2 ;
    values:originalText "(2) An action under subclause (1) may be commenced at any time within 6 years after the day on which the cause of action that relates to the conduct accrued." ;
