concept:telecommunications-act-1997-sch-3a-sec-5 a cml:Concept ;
    skos:prefLabel "5 Declaration on ACMA’s initiative or in response to request"@en ;
    cml:realizedBy doc:sch-3a-sec-5 ;
    values:originalText "A declaration of a protection zone may be made:  (a) on the ACMA’s own initiative; or  (b) at the request of a person." ;
