    cml:logicSummary "Temporal interval for decision-making." ;
    cml:premiseText "A decision must be made within 25 business days or as specified by written notice." ;
    cml:conclusionText "The timeframe is between 25 business days and 35 business days." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sch-3a-sec-58-ss-1 cml:asserts concept:telecommunications-act-1997-sch-3a-sec-58-ss-1-logic-ltl-3 .
concept:telecommunications-act-1997-sch-3a-sec-58-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "RECURSIVE" ;
    cml:logicSummary "Recurring trace for decision-making." ;
    cml:premiseText "A decision must be made within a specified timeframe after receiving further information." ;
