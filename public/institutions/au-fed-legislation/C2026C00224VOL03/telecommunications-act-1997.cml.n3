doc:sch-3-sec-41-ss-1 a cof:Section ;
    cof:title "41(1) Guidelines" ;
    values:kind "subsection" ;
    values:originalText "(1) In performing a function, or exercising a power, conferred on the ACMA by this Part, the ACMA must have regard to:  (a) any guidelines in force under subclause (2); and  (b) such other matters as the ACMA considers relevant." ;
    cof:pageNumber "128"^^xsd:integer .

concept:telecommunications-act-1997-sch-3-sec-41-ss-2 a cml:Concept ;
    skos:prefLabel "41(2) Guidelines"@en ;
    cml:realizedBy doc:sch-3-sec-41-ss-2 ;
    values:originalText "(2) The ACMA may, by written instrument, formulate guidelines for the purposes of subclause (1)." ;
