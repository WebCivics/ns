doc:sch-3a-sec-67a-ss-3 a cof:Section ;
    cof:title "67A(3) Notification of change of circumstances" ;
    values:kind "subsection" ;
    values:originalText "(3) The ACMA must:  (a) notify the applicant in writing of the ACMA’s decision under subclause (2); and  (b) do so within 2 business days after the day on which the decision is made." ;
    cof:pageNumber "192"^^xsd:integer .

