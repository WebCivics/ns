concept:telecommunications-act-1997-sch-3-sec-12 a cml:Concept ;
    skos:prefLabel "12 Compliance with industry standards"@en ;
    cml:realizedBy doc:sch-3-sec-12 ;
    values:originalText "If a carrier engages in an activity covered by Division 2, 3 or 4, the carrier must do so in accordance with any standard that:  (a) relates to the activity; and  (b) is recognised by the ACMA as a standard for use in that industry; and  (c) is likely to reduce a risk to the safety of the public if the carrier complies with the standard." ;
    skos:definition "If a carrier engages in an activity covered by Division 2, 3 or 4, the carrier must do so in accordance with any standard that:  (a) relates to the activity; and  (b) is recognised by the ACMA as a standard for use in that industry; and  (c) is likely to reduce a risk to the safety of the public if the carrier complies with the standard."@en ;
    cml:integrityHash "9d441246d20788ad63566289e456f400448bfe86ffba414b4913305ed9c038ab" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Carrier must comply with industry standards to reduce public safety risk" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
