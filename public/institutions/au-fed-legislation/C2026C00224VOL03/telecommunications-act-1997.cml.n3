doc:sch-2-sec-11-ss-1 a cof:Section ;
    cof:title "11(1) Carriage service providers must give information to another" ;
    values:kind "subsection" ;
    values:originalText "(1) This clause applies if a person or association is obliged by section 472 to provide and maintain an integrated public number database." ;
    cof:pageNumber "78"^^xsd:integer .

concept:telecommunications-act-1997-sch-2-sec-11-ss-2 a cml:Concept ;
    skos:prefLabel "11(2) Carriage service providers must give information to another"@en ;
    cml:realizedBy doc:sch-2-sec-11-ss-2 ;
    values:originalText "(2) If:  (a) a carriage service provider supplies a carriage service to an end-user; and  (b) the end-user has a public number; the carriage service provider must give the person or association such information as the person or association reasonably requires in connection with the person’s or association’s fulfilment of that obligation." ;
    skos:definition "(2) If:  (a) a carriage service provider supplies a carriage service to an end-user; and  (b) the end-user has a public number; the carriage service provider must give the person or association such information as the person or association reasonably requires in connection with the person’s or association’s fulfilment of that obligation."@en ;
    cml:integrityHash "38a5b5867375e21992b04c2219bbd8dda7c155056914aa5528def158e68de0e7" ;
    values:partOf concept:telecommunications-act-1997-sch-2-sec-11 ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Must provide information to end-user with public number" ;
    dc:description "Yes" ;
