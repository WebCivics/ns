concept:telecommunications-act-1997-sch-3-sec-47 a cml:Concept ;
    skos:prefLabel "47 Ownership of facilities"@en ;
    cml:realizedBy doc:sch-3-sec-47 ;
    values:originalText "Unless the circumstances indicate otherwise, a facility, or a part of a facility, that is supplied, installed, maintained or operated by a carrier remains the property of its owner:  (a) in any case—whether or not it has become (either in whole or in part), a fixture; and  (b) in the case of a network unit—whether or not a nominated carrier declaration is in force in relation to the network unit." ;
    skos:definition "Unless the circumstances indicate otherwise, a facility, or a part of a facility, that is supplied, installed, maintained or operated by a carrier remains the property of its owner:  (a) in any case—whether or not it has become (either in whole or in part), a fixture; and  (b) in the case of a network unit—whether or not a nominated carrier declaration is in force in relation to the network unit."@en ;
    cml:integrityHash "2466518746ff9ff1e6e0577be1e1e0b01cb7ed262457d6bb7a1193817e2cbe6e" ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Carrier's property remains with owner, regardless of fixture status." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.132" ;
    cml:asserts concept:telecommunications-act-1997-sch-3-sec-47-norm .
