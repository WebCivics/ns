    cof:pageNumber "201"^^xsd:integer ;
    skos:note "Ensure good engineering practice, safety of persons and property, and environmental protection." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
