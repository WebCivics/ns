concept:telecommunications-act-1997-sch-3-sec-33 a cml:Concept ;
    skos:prefLabel "33 Surrender of facility installation permit"@en ;
    cml:realizedBy doc:sch-3-sec-33 ;
    values:originalText "The holder of a facility installation permit may, at any time, surrender the permit by written notice given to the ACMA." ;
