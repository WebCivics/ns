doc:sch-3a-sec-84-ss-2 a cof:Section ;
    cof:title "84(2) Installing an international submarine cable without a permit" ;
    values:kind "subsection" ;
    values:originalText "(2) Strict liability applies to paragraph (1)(b). Note: For strict liability, see section 6.1 of the Criminal Code." ;
