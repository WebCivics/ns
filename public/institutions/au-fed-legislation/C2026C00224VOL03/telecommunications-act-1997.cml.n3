concept:telecommunications-act-1997-sch-3-sec-21 a cml:Concept ;
    skos:prefLabel "21 Application for facility installation permit"@en ;
    cml:realizedBy doc:sch-3-sec-21 ;
    values:originalText "(1) A carrier may apply to the ACMA for a permit authorising the carrier to carry out the installation of one or more facilities.  (2) The permit is called a facility installation permit." ;
    skos:definition "(1) A carrier may apply to the ACMA for a permit authorising the carrier to carry out the installation of one or more facilities.  (2) The permit is called a facility installation permit."@en ;
    cml:integrityHash "41152261056a4671362a87cd61c9273ca64e81dd32ee7606fa1c6dd4c54fb325" ;
    cof:pageNumber "113"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sch-3-sec-21-ss-1 ;
