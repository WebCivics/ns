concept:telecommunications-act-1997-sch-3-sec-53 a cml:Concept ;
    skos:prefLabel "53 Subdivider to pay for necessary alterations"@en ;
    cml:realizedBy doc:sch-3-sec-53 ;
    values:originalText "If:  (a) it becomes necessary, in the opinion of a carrier, because of the subdivision of any land, to remove, or alter the position of, a facility on, over or under the land; and  (b) the carrier incurs costs in connection with anything reasonably done in connection with the removal or alteration; the person who subdivided the land is liable to pay to the carrier so much of those costs as is reasonable, and that amount may be recovered in a court of competent jurisdiction as a debt due to the carrier." ;
    skos:definition "If:  (a) it becomes necessary, in the opinion of a carrier, because of the subdivision of any land, to remove, or alter the position of, a facility on, over or under the land; and  (b) the carrier incurs costs in connection with anything reasonably done in connection with the removal or alteration; the person who subdivided the land is liable to pay to the carrier so much of those costs as is reasonable, and that amount may be recovered in a court of competent jurisdiction as a debt due to the carrier."@en ;
    cml:integrityHash "ad90e45747d5e5ac2f44c4f5593cfb34f7e4cda5886e16c002ec4541fe49c2d0" ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "Subdivider liable for costs incurred by carrier due to subdivision of land." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.137" ;
