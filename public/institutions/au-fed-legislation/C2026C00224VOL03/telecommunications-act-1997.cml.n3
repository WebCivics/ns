concept:telecommunications-act-1997-sch-3a-sec-29 a cml:Concept ;
    skos:prefLabel "29 Protection zone as varied must not exceed permitted area"@en ;
    cml:realizedBy doc:sch-3a-sec-29 ;
    values:originalText "Subclauses 9(3) and (5) (about the area of a protection zone) continue to apply in relation to a declaration of a protection zone that is varied under this Division. Subdivision B—Prerequisites to variation or revocation of declaration" ;
    skos:definition "Subclauses 9(3) and (5) (about the area of a protection zone) continue to apply in relation to a declaration of a protection zone that is varied under this Division. Subdivision B—Prerequisites to variation or revocation of declaration"@en ;
    cml:integrityHash "352a26dcc7254a8dd6ab244de42fbbccf337ab6124bf7b3933b1a0a1730e2408" ;
    cof:pageNumber "164"^^xsd:integer ;
    skos:note "Protection zone area must not exceed permitted area after variation" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.164" ;
