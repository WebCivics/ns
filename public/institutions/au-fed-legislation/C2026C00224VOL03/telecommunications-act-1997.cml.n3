doc:sch-3-sec-30-ss-2 a cof:Section ;
    cof:title "30(2) Facility installation permit has effect subject to this Act" ;
    values:kind "subsection" ;
    values:originalText "(2) In this clause: this Act includes the Telecommunications (Consumer Protection and Service Standards) Act 1999 and regulations under that Act." ;
    cof:pageNumber "123"^^xsd:integer .

concept:telecommunications-act-1997-sch-3-sec-31 a cml:Concept ;
    skos:prefLabel "31 Duration of facility installation permit"@en ;
    cml:realizedBy doc:sch-3-sec-31 ;
    values:originalText "(1) A facility installation permit comes into force when it is issued and remains in force until the end of the period specified in the permit.  (2) However, the ACMA may, by written notice given to the holder of a facility installation permit, extend the period specified in the permit if the ACMA is satisfied that the extension is warranted because of special circumstances.  Schedule 3  Carriers’ powers and immunities" ;
    skos:definition "(1) A facility installation permit comes into force when it is issued and remains in force until the end of the period specified in the permit.  (2) However, the ACMA may, by written notice given to the holder of a facility installation permit, extend the period specified in the permit if the ACMA is satisfied that the extension is warranted because of special circumstances.  Schedule 3  Carriers’ powers and immunities"@en ;
    cml:integrityHash "d4a91430dee8fcc834fe3f84b02076a62a6de8f986113afd16e03aff29314dce" ;
    cof:pageNumber "123"^^xsd:integer ;
    cml:hasPart concept:telecommunications-act-1997-sch-3-sec-31-ss-1 ;
    cml:hasPart concept:telecommunications-act-1997-sch-3-sec-31-ss-2 ;
