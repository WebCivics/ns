doc:sch-1-sec-80-ss-5 a cof:Section ;
    cof:title "80(5) Variation of final functional separation undertaking" ;
    values:kind "subsection" ;
    values:originalText "(5) Subclause (4) does not apply to a proposed variation if the variation is of a minor nature." ;
    cof:pageNumber "62"^^xsd:integer .

concept:telecommunications-act-1997-sch-1-sec-80-ss-6 a cml:Concept ;
    skos:prefLabel "80(6) Variation of final functional separation undertaking"@en ;
    cml:realizedBy doc:sch-1-sec-80-ss-6 ;
    values:originalText "(6) If the proposed variation:  (a) is of a minor nature; and  (b) is not made at the request of Telstra; then, before making the proposed variation, the Minister must:  (c) give Telstra a notice:  (i) setting out the proposed variation; and  (ii) inviting Telstra to make submissions to the Minister about the proposed variation within 14 days after the notice is given; and  (d) consider any submissions received from Telstra within that 14-day period. Advice by the ACCC" ;
    skos:definition "(6) If the proposed variation:  (a) is of a minor nature; and  (b) is not made at the request of Telstra; then, before making the proposed variation, the Minister must:  (c) give Telstra a notice:  (i) setting out the proposed variation; and  (ii) inviting Telstra to make submissions to the Minister about the proposed variation within 14 days after the notice is given; and  (d) consider any submissions received from Telstra within that 14-day period. Advice by the ACCC"@en ;
    cml:integrityHash "6c1d737b83e06173c354b8e1579a1fbc039ffea85fabbe476b39adb956cd456a" ;
    values:partOf concept:telecommunications-act-1997-sch-1-sec-80 ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Must provide notice and consider submissions from Telstra before making a proposed variation." ;
    dc:description "Notice and submissions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
