concept:telecommunications-act-1997-sch-3-sec-38 a cml:Concept ;
    skos:prefLabel "38 Concurrent operation of State and Territory laws"@en ;
    cml:realizedBy doc:sch-3-sec-38 ;
    values:originalText "It is the intention of the Parliament that, if clause 37 entitles a carrier to engage in activities despite particular laws of a State or Territory, nothing in this Division is to affect the operation of any other law of a State or Territory, so far as that other law is capable of operating concurrently with this Act." ;
    skos:definition "It is the intention of the Parliament that, if clause 37 entitles a carrier to engage in activities despite particular laws of a State or Territory, nothing in this Division is to affect the operation of any other law of a State or Territory, so far as that other law is capable of operating concurrently with this Act."@en ;
    cml:integrityHash "72afa42b4c72beb16b1ee2a0453880284fa6a02d19efc0177668092d30cd7cb7" ;
    cof:pageNumber "127"^^xsd:integer ;
    skos:note "Nothing in this Division affects the operation of other State or Territory laws." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.127" ;
