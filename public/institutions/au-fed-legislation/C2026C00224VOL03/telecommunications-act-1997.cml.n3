    values:partOf concept:telecommunications-act-1997-sch-3a-sec-30 ;
    cof:pageNumber "164"^^xsd:integer ;
    skos:note "ACMA must provide a copy of the proposal within 2 business days after receiving a request." ;
    dc:description "true" ;
