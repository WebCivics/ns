concept:telecommunications-act-1997-sch-1-sec-42 a cml:Concept ;
    skos:prefLabel "42 Regular inspection of facilities"@en ;
    cml:realizedBy doc:sch-1-sec-42 ;
    values:originalText "(1) If a facility is owned or operated by a carrier, the carrier must inspect that facility regularly.  (2) In determining the regularity of inspections required by subclause (1), regard must be had to good engineering practice." ;
    skos:definition "(1) If a facility is owned or operated by a carrier, the carrier must inspect that facility regularly.  (2) In determining the regularity of inspections required by subclause (1), regard must be had to good engineering practice."@en ;
    cml:integrityHash "5bfdc0b0c3197a07b287be4393291365b65666e379951003c6712afecf360296" ;
    cof:pageNumber "40"^^xsd:integer ;
