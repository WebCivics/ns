concept:telecommunications-act-1997-sch-1-sec-71 a cml:Concept ;
    skos:prefLabel "71 Regulated services"@en ;
    cml:realizedBy doc:sch-1-sec-71 ;
    values:originalText "(1) For the purposes of this Part, a regulated service is a declared service within the meaning of Part XIC of the Competition and Consumer Act 2010.  Schedule 1  Standard carrier licence conditions" ;
