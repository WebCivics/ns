concept:telecommunications-act-1997-sch-3-sec-50 a cml:Concept ;
    skos:prefLabel "50 Monitoring of progress in relation to placing facilities"@en ;
    cml:realizedBy doc:sch-3-sec-50 ;
    values:originalText "underground  The ACMA is to monitor, and report to the Minister on, progress in relation to the implementation of efforts to place facilities underground." ;
    skos:definition "underground  The ACMA is to monitor, and report to the Minister on, progress in relation to the implementation of efforts to place facilities underground."@en ;
