concept:telecommunications-act-1997-sch-3a-sec-53 a cml:Concept ;
    skos:prefLabel "53 Application to be accompanied by charge"@en ;
    cml:realizedBy doc:sch-3a-sec-53 ;
    values:originalText "An application must be accompanied by the charge (if any) imposed on the application by a determination under section 60 of the Australian Communications and Media Authority Act 2005." ;
