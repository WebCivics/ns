concept:telecommunications-act-1997-sch-1-sec-44a a cml:Concept ;
    skos:prefLabel "44A Simplified outline"@en ;
    cml:realizedBy doc:sch-1-sec-44a ;
    values:originalText "The following is a simplified outline of this Part: • If a carriage service provider’s telecommunications network is interconnected with a carrier’s telecommunications network, the carrier must obtain a designated interconnection service from the carriage service provider for the purpose of ensuring any-to-any connectivity." ;
    skos:definition "The following is a simplified outline of this Part: • If a carriage service provider’s telecommunications network is interconnected with a carrier’s telecommunications network, the carrier must obtain a designated interconnection service from the carriage service provider for the purpose of ensuring any-to-any connectivity."@en ;
    cml:integrityHash "916cc4d9507327b47b2c2816738afd2e1c867f4813dab8e87168ee58870afb1d" ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "Carrier must obtain designated interconnection service from carriage service provider." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.42" ;
