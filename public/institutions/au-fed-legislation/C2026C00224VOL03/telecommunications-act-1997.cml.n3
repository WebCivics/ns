concept:telecommunications-act-1997-sch-1-sec-34-ss-4a a cml:Concept ;
    skos:prefLabel "34(4A) Access to sites of telecommunications transmission towers"@en ;
    cml:realizedBy doc:sch-1-sec-34-ss-4a ;
    values:originalText "(4A) Before issuing a certificate under subclause (3), the ACCC may consult the ACMA.  Schedule 1  Standard carrier licence conditions" ;
    skos:definition "(4A) Before issuing a certificate under subclause (3), the ACCC may consult the ACMA.  Schedule 1  Standard carrier licence conditions"@en ;
    cml:integrityHash "8c45f72e99d05b968579b9ce0896afed51a76cb0f515528a74838185d0ad5ee7" ;
