concept:telecommunications-act-1997-sch-3-sec-9a-ss-5 a cml:Concept ;
    skos:prefLabel "9A(5) Carrier to restore land—removal of temporary facilities"@en ;
    cml:realizedBy doc:sch-3-sec-9a-ss-5 ;
    values:originalText "(5) The rule in subclause (3) or (4) does not apply if the carrier agrees with:  (a) the owner of the land; and  (b) if the land is occupied by a person other than the owner—the occupier; to commence restoration at a time after the end of that period of 10 business days." ;
    skos:definition "(5) The rule in subclause (3) or (4) does not apply if the carrier agrees with:  (a) the owner of the land; and  (b) if the land is occupied by a person other than the owner—the occupier; to commence restoration at a time after the end of that period of 10 business days."@en ;
    cml:integrityHash "bc2ad12304001f71736264a3839aa925a266b2aec38804de7168b95b37571e77" ;
    values:partOf concept:telecommunications-act-1997-sch-3-sec-9a ;
    cof:pageNumber "104"^^xsd:integer ;
    skos:note "Carrier may delay restoration of land after 10 business days with owner's consent or occupier's consent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
