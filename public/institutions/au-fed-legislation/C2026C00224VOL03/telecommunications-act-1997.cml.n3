concept:telecommunications-act-1997-sch-3-sec-52 a cml:Concept ;
    skos:prefLabel "52 Commonwealth laws not displaced"@en ;
    cml:realizedBy doc:sch-3-sec-52 ;
    values:originalText "Divisions 2, 3 and 4 do not authorise a carrier to engage in an activity contrary to the requirements of another law of the Commonwealth." ;
    skos:definition "Divisions 2, 3 and 4 do not authorise a carrier to engage in an activity contrary to the requirements of another law of the Commonwealth."@en ;
