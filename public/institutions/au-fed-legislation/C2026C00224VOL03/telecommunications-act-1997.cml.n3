concept:telecommunications-act-1997-sch-3-sec-13 a cml:Concept ;
    skos:prefLabel "13 Compliance with international agreements"@en ;
    cml:realizedBy doc:sch-3-sec-13 ;
    values:originalText "If a carrier engages in an activity covered by Division 2, 3 or 4, the carrier must do so in a manner that is consistent with Australia’s obligations under a listed international agreement that is relevant to the activity.  Carriers’ powers and immunities  Schedule 3 General provisions  Part 1 Conditions relating to the carrying out of authorised activities  Division 5  Clause 14  Telecommunications Act 1997  Compilation date: 04/06/2026" ;
    skos:definition "If a carrier engages in an activity covered by Division 2, 3 or 4, the carrier must do so in a manner that is consistent with Australia’s obligations under a listed international agreement that is relevant to the activity.  Carriers’ powers and immunities  Schedule 3 General provisions  Part 1 Conditions relating to the carrying out of authorised activities  Division 5  Clause 14  Telecommunications Act 1997  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "b2d2dbaba264f2e7702a4f72b502314dfb8d6afb7e58e28d024aa3c777db0e34" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Carrier must comply with Australia's obligations under a listed international agreement." ;
    cml:curationStatus cml:Proposed ;
