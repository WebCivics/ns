concept:telecommunications-act-1997-sch-3-sec-17-ss-6b a cml:Concept ;
    skos:prefLabel "17(6B) Notice to owner of land—general"@en ;
    cml:realizedBy doc:sch-3-sec-17-ss-6b ;
    values:originalText "(6B) For the purposes of this clause, a temporary defence facility is a facility of the kind that is mentioned in paragraph 6(1)(c) of this Schedule." ;
