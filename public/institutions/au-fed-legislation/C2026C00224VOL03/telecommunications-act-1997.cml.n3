concept:telecommunications-act-1997-sch-3-sec-10 a cml:Concept ;
    skos:prefLabel "10 Management of activities"@en ;
    cml:realizedBy doc:sch-3-sec-10 ;
    values:originalText "A carrier must, in connection with carrying out an activity covered by Division 2, 3 or 4, take all reasonable steps:  (a) to act in accordance with good engineering practice; and  (b) to protect the safety of persons and property; and  (c) to ensure that the activity interferes as little as practicable with:  Schedule 3  Carriers’ powers and immunities" ;
    skos:definition "A carrier must, in connection with carrying out an activity covered by Division 2, 3 or 4, take all reasonable steps:  (a) to act in accordance with good engineering practice; and  (b) to protect the safety of persons and property; and  (c) to ensure that the activity interferes as little as practicable with:  Schedule 3  Carriers’ powers and immunities"@en ;
    cml:integrityHash "be1dabbc5d28a204cb0ee9d327cc7d2348e58296491d3d05488c352633dbded3" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "A carrier must take all reasonable steps to protect the safety of persons and property." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.105" ;
