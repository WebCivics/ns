    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2",
      "@type": "cml:Concept",
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.48",
      "skos:note": "A contracted service provider for a Commonwealth contract is responsible for the provision of goods or services.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "30(2) Officers or employees of a contracted service provider"
      },
      "wasDerivedFrom": "public-interest-disclosure-act-2013.pdf",
      "asserts": [
        "concept:public-interest-disclosure-act-2013-sec-30-ss-2-norm",
        "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-deontic-1",
        "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-alleninterval-2",
        "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-ltl-3",
        "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-deontic-4",
        "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "f86bba4263c8f1ebaa20accef4e5e23c991974e7066a1aa96a14f106b359cc3a",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:public-interest-disclosure-act-2013#sec-30-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:public-interest-disclosure-act-2013-sec-30"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal scope of a contracted service provider's responsibility is during the duration of the contract.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal scope of a contracted service provider's responsibility",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "A person who is responsible for the provision of goods or services under the Commonwealth contract is also responsible during the duration of the contract."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consequence of a contracted service provider's responsibility is that they must provide goods or services.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Consequence of a contracted service provider's responsibility",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "If a person is responsible for the provision of goods or services under the Commonwealth contract, then they must provide those goods or services."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A contracted service provider is defined as someone who is responsible for the provision of goods or services.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Definition of a contracted service provider",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "A person is a contracted service provider if they are responsible for the provision of goods or services."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The mandatory nature of a contracted service provider's responsibility is to provide goods or services.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory nature of a contracted service provider's responsibility",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "A person who is responsible for the provision of goods or services under the Commonwealth contract must provide those goods or services."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The global applicability of a contracted service provider's responsibility is everywhere during the duration of the contract.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Global applicability of a contracted service provider's responsibility",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "A person who is responsible for the provision of goods or services under the Commonwealth contract is also responsible everywhere during the duration of the contract."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-2-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:public-interest-disclosure-act-2013-sec-30-ss-2"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-30-ss-3",
      "@type": "cml:Concept",
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.48",
      "skos:note": "A Commonwealth contract is a contract to which the Commonwealth or an agency is a party.",
