      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for using disclosing identifying information after a public interest disclosure is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of imprisonment for using disclosing identifying information after a public interest disclosure.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Penalty: Imprisonment for 6 months or 30 penalty units, or both."
    },
