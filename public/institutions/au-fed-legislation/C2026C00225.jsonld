      "cml:logicSummary": "Prohibition of using disclosing identifying information after a public interest disclosure.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) the disclosure is to a person other than the second person."
    },
    {
