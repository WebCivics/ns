    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-13-ss-1",
      "@type": "cml:Concept",
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.27",
      "skos:note": "Taking a reprisal against another person is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "13(1) What constitutes taking a reprisal"
      },
      "wasDerivedFrom": "public-interest-disclosure-act-2013.pdf",
      "asserts": [
        "concept:public-interest-disclosure-act-2013-sec-13-ss-1-norm",
        "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-deontic-1",
        "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-alleninterval-2",
        "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-argumentation-3",
        "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-diffusion-4",
        "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "a9b9bd394ce3b7f7709a2650a6badd1bea780549722e0159a3046a44e97202ab",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:public-interest-disclosure-act-2013#sec-13-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:public-interest-disclosure-act-2013-sec-13"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The engagement occurs before the belief or suspicion of the second person making a public interest disclosure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between engagement and reprisal",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "When the conduct is engaged in, the first person believes or suspects that the second person has made a public interest disclosure"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the first person engages in conduct resulting in detriment to another person, then taking a reprisal is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of conduct on reprisal",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "The first person engages in conduct that results in detriment to the second person"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person is a person who has engaged in conduct resulting in detriment to another person and believes or suspects that the other person has made a public interest disclosure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Classification of persons against whom reprisal may be taken based on conduct and belief",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classification",
      "cml:premiseText": "The first person engages in conduct that results in detriment to the second person and believes or suspects that the second person has made a public interest disclosure"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Taking a reprisal is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of taking a reprisal",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Engaging in conduct that results in detriment to another person"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-13-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the first person believes or suspects that the second person has made a public interest disclosure, then taking a reprisal is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Propagation of prohibition through engagement and belief",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation",
      "cml:premiseText": "The first person believes or suspects that the second person has made a public interest disclosure"
    },
