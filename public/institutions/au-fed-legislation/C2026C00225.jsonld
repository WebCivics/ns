      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:public-interest-disclosure-act-2013#sec-67-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:public-interest-disclosure-act-2013-sec-67"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-67-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years or 120 penalty units, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of disclosing legal information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person has obtained information in the person’s capacity as the recipient of a legal practitioner disclosure;"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-67-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 2 years or 120 penalty units, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of using disclosed information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) the person: (i) discloses the information to another person; or (ii) uses the information;"
    },
