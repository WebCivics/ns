    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-20-ss-1",
      "@type": "cml:Concept",
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.33",
      "skos:note": "Disclosing identifying information after a public interest disclosure is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "20(1) Disclosure or use of identifying information"
      },
      "wasDerivedFrom": "public-interest-disclosure-act-2013.pdf",
      "asserts": [
