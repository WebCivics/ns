    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2",
      "@type": "cml:Concept",
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.31",
      "skos:note": "Reckless conduct towards a person who has made or may have made a public interest disclosure.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "19(2) Reprisals in relation to disclosures—offences"
      },
      "wasDerivedFrom": "public-interest-disclosure-act-2013.pdf",
      "asserts": [
        "concept:public-interest-disclosure-act-2013-sec-19-ss-2-norm",
        "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-1",
        "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-2",
        "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-alleninterval-3",
        "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-ltl-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "580e0efe357ba75cabdc7a076c59c83687d80cccbe17acfd5c5ec1a03184ecb0",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:public-interest-disclosure-act-2013#sec-19-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:public-interest-disclosure-act-2013-sec-19"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal relation between conduct and threat is necessary for liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between conduct and threat is necessary for liability.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if they engage in reckless conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Reckless conduct is an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(a) the first person engages in conduct; and (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person's belief or suspicion of a public interest disclosure is an obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Engaging in conduct with reckless disregard is an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(d) when the conduct is engaged in, the first person believes or suspects that the second person, or any other person: (i) has made a public interest disclosure; or (ii) may have made a public interest disclosure;"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The recurring trace of conduct towards persons who have made or may make public interest disclosures is necessary for liability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of conduct towards persons who have made or may make public interest disclosures is necessary for liability.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:premiseText": "(a) the first person engages in conduct; and (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;"
    },
