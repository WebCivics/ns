concept:public-interest-disclosure-act-2013-sec-55 a cml:Concept ;
    skos:prefLabel "55 The Ombudsman and the IGIS—recommendations"@en ;
    cml:realizedBy doc:sec-55 ;
    values:originalText "Scope  (1) This section applies if the Ombudsman or the IGIS (the relevant investigative agency):  (a) under subsection 44(2)—is notified of the allocation of a disclosure to an agency; or  (b) under subsection 44A(3)—is notified of a decision not to allocate a disclosure to any agency; or  (c) under section 50A—is notified by the principal officer of an agency of a decision not to investigate a disclosure under" ;
    skos:definition "Scope  (1) This section applies if the Ombudsman or the IGIS (the relevant investigative agency):  (a) under subsection 44(2)—is notified of the allocation of a disclosure to an agency; or  (b) under subsection 44A(3)—is notified of a decision not to allocate a disclosure to any agency; or  (c) under section 50A—is notified by the principal officer of an agency of a decision not to investigate a disclosure under"@en ;
    cml:integrityHash "04247aafcd2a112373be40c7c5519cbcda2888b59bcb24b80070ef3e8acdf988" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Notification of allocation or non-allocation of disclosure to an agency" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-interest-disclosure-act-2013.pdf> ;
    dc:source "public-interest-disclosure-act-2013.pdf, p.80" ;
    cml:asserts concept:public-interest-disclosure-act-2013-sec-55-norm .
