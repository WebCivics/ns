doc:sec-11a a cof:Section ;
    cof:title "11A Designated publication restrictions" ;
    values:kind "section" ;
    values:originalText "Section 10 does not apply to civil, criminal or administrative liability (including disciplinary action) for making a disclosure that contravenes a designated publication restriction if the person making the disclosure:  (a) knows that the disclosure contravenes the designated publication restriction; and  (b) does not have a reasonable excuse for that contravention.   Protection of disclosers and witnesses  Part 2 Protections  Division 1  Section 12  Public Interest Disclosure Act 2013  Compilation date: 04/06/2026" ;
    cof:pageNumber "24"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-12 a cml:Concept ;
    skos:prefLabel "12 Discloser’s liability for own conduct not affected"@en ;
    cml:realizedBy doc:sec-12 ;
    values:originalText "To avoid doubt, whether the individual’s disclosure of his or her own conduct is a public interest disclosure does not affect his or her liability for the conduct." ;
    skos:definition "To avoid doubt, whether the individual’s disclosure of his or her own conduct is a public interest disclosure does not affect his or her liability for the conduct."@en ;
