    cml:modality cml:Deontic ;
    cml:operator "must" ;
    cml:logicSummary "Mandatory nature of a contracted service provider's responsibility" ;
    cml:premiseText "A person who is responsible for the provision of goods or services under the Commonwealth contract must provide those goods or services." ;
    cml:conclusionText "The mandatory nature of a contracted service provider's responsibility is to provide goods or services." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:public-interest-disclosure-act-2013-sec-30-ss-2 cml:asserts concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-argumentation-5 .
concept:public-interest-disclosure-act-2013-sec-30-ss-2-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "if-then" ;
    cml:logicSummary "Consequence of a contracted service provider's responsibility" ;
    cml:premiseText "If a person is responsible for the provision of goods or services under the Commonwealth contract, then they must provide those goods or services." ;
    cml:conclusionText "The consequence of a contracted service provider's responsibility is that they must provide goods or services." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-30-ss-2 a cof:Section ;
    cof:title "30(2) Officers or employees of a contracted service provider" ;
    values:kind "subsection" ;
    values:originalText "(2) A contracted service provider for a Commonwealth contract is:  (a) a person who:  (i) is a party to the Commonwealth contract; and  (ii) is responsible for the provision of goods or services under the Commonwealth contract; or  (b) a person who:  (i) is a party to a contract (the subcontract) with a person who is a contracted service provider for the Commonwealth contract under paragraph (a) (or under a previous application of this paragraph); and  (ii) is responsible under the subcontract for the provision of goods or services for the purposes (whether direct or indirect) of the Commonwealth contract." ;
    cof:pageNumber "48"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-30-ss-3 a cml:Concept ;
    skos:prefLabel "30(3) Officers or employees of a contracted service provider"@en ;
    cml:realizedBy doc:sec-30-ss-3 ;
    values:originalText "(3) A Commonwealth contract is a contract:  (a) to which the Commonwealth or an agency is a party; and   Protection of disclosers and witnesses  Part 2 Public interest disclosures  Division 2  Section 31  Public Interest Disclosure Act 2013  Compilation date: 04/06/2026  (b) under which goods or services are to be, or were to be, provided:  (i) to the Commonwealth or an agency; or  (ii) for or on behalf of the Commonwealth or an agency, and in connection with the performance of its functions or the exercise of its powers." ;
    skos:definition "(3) A Commonwealth contract is a contract:  (a) to which the Commonwealth or an agency is a party; and   Protection of disclosers and witnesses  Part 2 Public interest disclosures  Division 2  Section 31  Public Interest Disclosure Act 2013  Compilation date: 04/06/2026  (b) under which goods or services are to be, or were to be, provided:  (i) to the Commonwealth or an agency; or  (ii) for or on behalf of the Commonwealth or an agency, and in connection with the performance of its functions or the exercise of its powers."@en ;
