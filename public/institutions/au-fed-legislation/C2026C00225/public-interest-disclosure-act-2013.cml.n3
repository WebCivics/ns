concept:public-interest-disclosure-act-2013-sec-75 cml:asserts concept:public-interest-disclosure-act-2013-sec-75-logic-ltl-3 .
concept:public-interest-disclosure-act-2013-sec-75-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurrently" ;
    cml:logicSummary "Recurring trace between disclosure investigations and performance of functions/exercise of powers." ;
    cml:premiseText "(b) the disclosure, recording or use is for the purposes of the performance of the functions, or the exercise of the powers," ;
    cml:conclusionText "...or (c) the disclosure, recording or use is in connection with giving a person access to information for..." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:public-interest-disclosure-act-2013-sec-75 cml:asserts concept:public-interest-disclosure-act-2013-sec-75-logic-deontic-4 .
