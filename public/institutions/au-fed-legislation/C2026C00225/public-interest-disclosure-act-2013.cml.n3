concept:public-interest-disclosure-act-2013-sec-22a a cml:Concept ;
    skos:prefLabel "22A Interaction with remedies under the Fair Work Act 2009"@en ;
    cml:realizedBy doc:sec-22a ;
    values:originalText "(1) A person is not entitled to make an application to the Federal Court or Federal Circuit and Family Court of Australia (Division 2) for an order under section 14, 15 or 16 of this Act in relation to particular conduct if another application has been made:  (a) under section 539 of the Fair Work Act 2009 in relation to a contravention of section 340 or 772 of that Act constituted by the same conduct; or" ;
    skos:definition "(1) A person is not entitled to make an application to the Federal Court or Federal Circuit and Family Court of Australia (Division 2) for an order under section 14, 15 or 16 of this Act in relation to particular conduct if another application has been made:  (a) under section 539 of the Fair Work Act 2009 in relation to a contravention of section 340 or 772 of that Act constituted by the same conduct; or"@en ;
    cml:integrityHash "3a3ee5428e43b5bc6c0051a4892419011f5d7bddd3e65965b4e229e83233c969" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Prohibition on making applications for certain orders in Federal Court or Family Court of Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-interest-disclosure-act-2013.pdf> ;
    dc:source "public-interest-disclosure-act-2013.pdf, p.35" ;
    cml:asserts concept:public-interest-disclosure-act-2013-sec-22a-norm .
