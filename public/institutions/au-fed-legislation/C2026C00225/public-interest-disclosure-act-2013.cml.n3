doc:sec-73c-ss-1 a cof:Section ;
    cof:title "73C(1) Machinery of government changes—disclosures made before" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) before the change time, a person disclosed information to an authorised officer of an affected agency, or to a supervisor belonging to the affected agency; and  (b) the information concerns conduct that is taken to relate to the new agency under section 73B; and  (c) immediately before the change time, consideration of the disclosure under this Act had not started, or (if it had started) had not ended." ;
    cof:pageNumber "105"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-73c-ss-2 a cml:Concept ;
    skos:prefLabel "73C(2) Machinery of government changes—disclosures made before"@en ;
    cml:realizedBy doc:sec-73c-ss-2 ;
    values:originalText "(2) For the purposes of this Act:  (a) the disclosure is taken to have been made to an authorised officer of the new agency, or to a supervisor belonging to the new agency; and  (b) if the disclosure had, before the change time, been allocated to the affected agency, after that time it is taken to have been allocated to the new agency; and  (c) if an investigation under this Act had, before the change time, started in relation to the disclosure, the investigation may continue as if the disclosure had been made in relation to conduct that relates to the new agency; and" ;
    skos:definition "(2) For the purposes of this Act:  (a) the disclosure is taken to have been made to an authorised officer of the new agency, or to a supervisor belonging to the new agency; and  (b) if the disclosure had, before the change time, been allocated to the affected agency, after that time it is taken to have been allocated to the new agency; and  (c) if an investigation under this Act had, before the change time, started in relation to the disclosure, the investigation may continue as if the disclosure had been made in relation to conduct that relates to the new agency; and"@en ;
    cml:integrityHash "95bbda3019a052f9c14000f429b6a48ca5dd775a30ac3f7c2b688e3cf0cf7979" ;
    values:partOf concept:public-interest-disclosure-act-2013-sec-73c ;
    cof:pageNumber "105"^^xsd:integer ;
