concept:public-interest-disclosure-act-2013-sec-36 a cml:Concept ;
    skos:prefLabel "36 Meaning of authorised officer"@en ;
    cml:realizedBy doc:sec-36 ;
    values:originalText "An authorised officer, of an agency, is:  (a) the principal officer of the agency; or  (b) a public official who:  (i) belongs to the agency; and  (ii) is appointed, in writing, by the principal officer of the agency as an authorised officer for the purposes of this Act. Subdivision D—Intelligence information" ;
    skos:definition "An authorised officer, of an agency, is:  (a) the principal officer of the agency; or  (b) a public official who:  (i) belongs to the agency; and  (ii) is appointed, in writing, by the principal officer of the agency as an authorised officer for the purposes of this Act. Subdivision D—Intelligence information"@en ;
    cml:integrityHash "a858644570edd2d224bd29b3a474c29750f95d9cc5683572b86a62b8c3ae38f2" ;
    cof:pageNumber "54"^^xsd:integer ;
    skos:note "Defines an authorised officer for an agency." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
