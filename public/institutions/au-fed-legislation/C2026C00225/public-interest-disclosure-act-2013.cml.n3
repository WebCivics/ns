concept:public-interest-disclosure-act-2013-sec-16 a cml:Concept ;
    skos:prefLabel "16 Reinstatement"@en ;
    cml:realizedBy doc:sec-16 ;
    values:originalText "If the Federal Court or Federal Circuit and Family Court of Australia (Division 2) is satisfied, on the application of a person (the applicant), that:  (a) another person (the respondent) has taken, or is taking, a reprisal against the applicant; and  (b) the applicant is or was employed in a particular position with the respondent; and  (c) the reprisal wholly or partly consists, or consisted, of the respondent terminating, or purporting to terminate, the applicant’s employment; the Court may order that the applicant be reinstated in that position or a position at a comparable level." ;
    skos:definition "If the Federal Court or Federal Circuit and Family Court of Australia (Division 2) is satisfied, on the application of a person (the applicant), that:  (a) another person (the respondent) has taken, or is taking, a reprisal against the applicant; and  (b) the applicant is or was employed in a particular position with the respondent; and  (c) the reprisal wholly or partly consists, or consisted, of the respondent terminating, or purporting to terminate, the applicant’s employment; the Court may order that the applicant be reinstated in that position or a position at a comparable level."@en ;
    cml:integrityHash "a20c0b4f48cc32e67719c55d1e0398e66fb9c7b72886722dbce75fb285d1ab3e" ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Reinstatement obligation for applicant if respondent takes reprisal against them." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-interest-disclosure-act-2013.pdf> ;
    dc:source "public-interest-disclosure-act-2013.pdf, p.30" ;
    cml:asserts concept:public-interest-disclosure-act-2013-sec-16-norm .
