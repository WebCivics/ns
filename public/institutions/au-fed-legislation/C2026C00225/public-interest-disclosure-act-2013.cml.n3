doc:sec-82-ss-2 a cof:Section ;
    cof:title "82(2) Other investigative powers etc. not affected" ;
    values:kind "subsection" ;
    values:originalText "(2) This Act does not detract from any obligations imposed on an agency or a public official by a law of the Commonwealth other than this Act." ;
    cof:pageNumber "112"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-82a a cml:Concept ;
    skos:prefLabel "82A Review of operation of Act"@en ;
    cml:realizedBy doc:sec-82a ;
    values:originalText "(1) The Minister must cause a review to be undertaken of the operation of this Act.  (2) The review must be conducted as soon as practicable after the end of 5 years after this section commences.  (3) The Minister must cause a written report about the review to be prepared.   Miscellaneous  Part 5  Section 83  Public Interest Disclosure Act 2013  Compilation date: 04/06/2026  (4) The Minister must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after the Minister receives the report." ;
