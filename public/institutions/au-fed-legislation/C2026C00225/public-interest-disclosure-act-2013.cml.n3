doc:sec-14-ss-2 a cof:Section ;
    cof:title "14(2) Compensation" ;
    values:kind "subsection" ;
    values:originalText "(2) The Federal Court or Federal Circuit and Family Court of Australia (Division 2) must not make an order under paragraph (1)(b) if the respondent’s employer establishes that it took reasonable precautions, and exercised due diligence, to avoid the reprisal." ;
    cof:pageNumber "28"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-14-ss-3 a cml:Concept ;
    skos:prefLabel "14(3) Compensation"@en ;
    cml:realizedBy doc:sec-14-ss-3 ;
    values:originalText "(3) If the Federal Court or Federal Circuit and Family Court of Australia (Division 2) makes an order under subparagraph (1)(b)(ii), the respondent and the respondent’s employer are jointly and severally liable to pay the compensation concerned." ;
    skos:definition "(3) If the Federal Court or Federal Circuit and Family Court of Australia (Division 2) makes an order under subparagraph (1)(b)(ii), the respondent and the respondent’s employer are jointly and severally liable to pay the compensation concerned."@en ;
