    cml:operator "Obligation" ;
    cml:logicSummary "Engaging in conduct with reckless disregard is an obligation." ;
    cml:premiseText "(d) when the conduct is engaged in, the first person believes or suspects that the second person, or any other person: (i) has made a public interest disclosure; or (ii) may have made a public interest disclosure;" ;
    cml:conclusionText "The first person's belief or suspicion of a public interest disclosure is an obligation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:public-interest-disclosure-act-2013-sec-19-ss-2 cml:asserts concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-alleninterval-3 .
concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Temporal relation between conduct and threat is necessary for liability." ;
    cml:premiseText "(b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;" ;
    cml:conclusionText "The temporal relation between conduct and threat is necessary for liability." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:public-interest-disclosure-act-2013-sec-19-ss-2 cml:asserts concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-ltl-4 .
concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Recurring trace of conduct towards persons who have made or may make public interest disclosures is necessary for liability." ;
    cml:premiseText "(a) the first person engages in conduct; and (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;" ;
    cml:conclusionText "The recurring trace of conduct towards persons who have made or may make public interest disclosures is necessary for liability." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-19-ss-2 a cof:Section ;
    cof:title "19(2) Reprisals in relation to disclosures—offences" ;
    values:kind "subsection" ;
    values:originalText "(2) A person (the first person) commits an offence in relation to another person (the second person) if:  (a) the first person engages in conduct; and  (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person; and  (c) the first person is reckless as to whether the second person fears that the threat would be carried out; and  (d) when the conduct is engaged in, the first person believes or suspects that the second person, or any other person:  (i) has made a public interest disclosure; or  (ii) may have made a public interest disclosure; or" ;
    cof:pageNumber "31"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-19a a cml:Concept ;
    skos:prefLabel "19A Interaction between civil remedies and offences"@en ;
    cml:realizedBy doc:sec-19a ;
    values:originalText "To avoid doubt, a person may bring proceedings under section 14, 15 or 16 in relation to the taking of a reprisal even if a prosecution for an offence against section 19 in relation to the reprisal has not been brought, or cannot be brought. Subdivision C—Protecting the identity of disclosers" ;
    skos:definition "To avoid doubt, a person may bring proceedings under section 14, 15 or 16 in relation to the taking of a reprisal even if a prosecution for an offence against section 19 in relation to the reprisal has not been brought, or cannot be brought. Subdivision C—Protecting the identity of disclosers"@en ;
    cml:integrityHash "527f8204e19957f2013e600e35834f8643b50783e78ada170db9ce0eb9ec011a" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "A person may bring proceedings under sections 14, 15 or 16 in relation to a reprisal even if prosecution for an offence against section 19 has not been brought." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-interest-disclosure-act-2013.pdf> ;
    dc:source "public-interest-disclosure-act-2013.pdf, p.33" ;
