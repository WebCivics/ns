concept:public-interest-disclosure-act-2013-sec-43 a cml:Concept ;
    skos:prefLabel "43 Allocation of disclosure—decision by authorised officer"@en ;
    cml:realizedBy doc:sec-43 ;
    values:originalText "Scope—disclosers  (1) This section applies in relation to a person (the discloser) if:  (a) the discloser discloses information to an authorised officer of an agency (the recipient agency); or  (b) the discloser discloses information to the discloser’s supervisor, who then gives the information to an authorised" ;
    skos:definition "Scope—disclosers  (1) This section applies in relation to a person (the discloser) if:  (a) the discloser discloses information to an authorised officer of an agency (the recipient agency); or  (b) the discloser discloses information to the discloser’s supervisor, who then gives the information to an authorised"@en ;
    cml:integrityHash "4cbdc8af6ce6ef35f053eac90a2e10bf885ffa317abcf9250cde89f7c6e5f444" ;
    cof:pageNumber "57"^^xsd:integer ;
    skos:note "Discloser must disclose information to an authorised officer of an agency." ;
