doc:sec-7a-ss-1 a cof:Section ;
    cof:title "7A(1) Role of the Ombudsman under the Ombudsman Act 1976" ;
    values:kind "subsection" ;
    values:originalText "(1) A complaint may be made to the Ombudsman under the Ombudsman Act 1976 about the handling by an agency of a disclosure under this Act, including complaints about the following matters:  (a) whether the disclosure has been handled reasonably;  (b) the allocation of the disclosure (including any delay or failure to allocate the disclosure);  (c) the investigation of the disclosure (including any delay or failure to investigate the disclosure);  (d) compliance with this Act by the agency or any of its officers, including its principal officer (including any failure to comply with this Act);  (e) any other matter relating to the handling of the disclosure." ;
    cof:pageNumber "13"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-7a-ss-2 a cml:Concept ;
    skos:prefLabel "7A(2) Role of the Ombudsman under the Ombudsman Act 1976"@en ;
    cml:realizedBy doc:sec-7a-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply in relation to:  (a) the IGIS; or  (b) an intelligence agency; or  (c) AUSTRAC, the Department of Home Affairs or the Australian Federal Police if the disclosure relates to the intelligence functions of that agency." ;
    skos:definition "(2) Subsection (1) does not apply in relation to:  (a) the IGIS; or  (b) an intelligence agency; or  (c) AUSTRAC, the Department of Home Affairs or the Australian Federal Police if the disclosure relates to the intelligence functions of that agency."@en ;
    cml:integrityHash "67eed9cc5ada4f6500fcf40c5f00f6a486162e1e2c8a9d0cf3c498660a98cda1" ;
    values:partOf concept:public-interest-disclosure-act-2013-sec-7a ;
