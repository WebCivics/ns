concept:public-interest-disclosure-act-2013-sec-58 a cml:Concept ;
    skos:prefLabel "58 Simplified outline"@en ;
    cml:realizedBy doc:sec-58 ;
    values:originalText "The following is a simplified outline of this Division: This Division promotes the operation of this Act by imposing additional obligations on principal officers, authorised officers, supervisors and public officials, and by conferring additional functions on the Ombudsman and the IGIS. Note: The way the additional obligations are complied with (or non-compliance with the additional obligations) may be the subject of a complaint to the Ombudsman under the Ombudsman Act 1976, or (in the case of an intelligence agency, or AUSTRAC, the Department of Home Affairs or the Australian Federal Police in relation to that agency’s intelligence functions) to the IGIS under the Inspector-General of Intelligence and Security Act 1986." ;
    skos:definition "The following is a simplified outline of this Division: This Division promotes the operation of this Act by imposing additional obligations on principal officers, authorised officers, supervisors and public officials, and by conferring additional functions on the Ombudsman and the IGIS. Note: The way the additional obligations are complied with (or non-compliance with the additional obligations) may be the subject of a complaint to the Ombudsman under the Ombudsman Act 1976, or (in the case of an intelligence agency, or AUSTRAC, the Department of Home Affairs or the Australian Federal Police in relation to that agency’s intelligence functions) to the IGIS under the Inspector-General of Intelligence and Security Act 1986."@en ;
    cml:integrityHash "6c23e0dfce32ab8d9bb56f4ed42c0f8bfcc3ef83dcc8f8841722ee307b637db8" ;
    cof:pageNumber "85"^^xsd:integer ;
    skos:note "Additional obligations on principal officers, authorised officers, supervisors and public officials." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
