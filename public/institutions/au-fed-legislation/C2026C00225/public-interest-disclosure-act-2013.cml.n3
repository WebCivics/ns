concept:public-interest-disclosure-act-2013-sec-56-ss-3 a cml:Concept ;
    skos:prefLabel "56(3) Disclosure to a member of an Australian police force"@en ;
    cml:realizedBy doc:sec-56-ss-3 ;
    values:originalText "(3) However, if the investigator suspects on reasonable grounds that the offence is punishable by imprisonment for life or by imprisonment for a period of at least 2 years, the investigator must give the relevant information to a member of an Australian police force responsible for the investigation of the offence." ;
    skos:definition "(3) However, if the investigator suspects on reasonable grounds that the offence is punishable by imprisonment for life or by imprisonment for a period of at least 2 years, the investigator must give the relevant information to a member of an Australian police force responsible for the investigation of the offence."@en ;
    cml:integrityHash "3018572b5efc6a24564a0bcd76df4a065e283a2712512d2f2a4d90c71c5f335d" ;
    values:partOf concept:public-interest-disclosure-act-2013-sec-56 ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Investigator must disclose information to a member of an Australian police force under certain circumstances." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
