concept:public-interest-disclosure-act-2013-sec-3 a cml:Concept ;
    skos:prefLabel "3 Crown to be bound"@en ;
    cml:realizedBy doc:sec-3 ;
    values:originalText "(1) This Act binds the Crown in each of its capacities.  (2) However, this Act does not make the Crown liable to a pecuniary penalty or to be prosecuted for an offence." ;
    skos:definition "(1) This Act binds the Crown in each of its capacities.  (2) However, this Act does not make the Crown liable to a pecuniary penalty or to be prosecuted for an offence."@en ;
