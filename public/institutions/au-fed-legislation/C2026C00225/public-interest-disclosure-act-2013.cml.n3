    cml:premiseText "(2) The supervisor must:  (b) explain to the discloser the procedures under this Act for such a disclosure to be:" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:public-interest-disclosure-act-2013-sec-60a-ss-2 cml:asserts concept:public-interest-disclosure-act-2013-sec-60a-ss-2-logic-cogai-5 .
concept:public-interest-disclosure-act-2013-sec-60a-ss-2-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "must" ;
    cml:logicSummary "Supervisor's obligation to provide civil and criminal protections" ;
    cml:premiseText "(d) explain to the discloser the civil and criminal protections this Act provides to protect disclosers, and those providing assistance in relation to such disclosures, from reprisals." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-60a-ss-2 a cof:Section ;
    cof:title "60A(2) Additional obligations of supervisors" ;
    values:kind "subsection" ;
    values:originalText "(2) The supervisor must:  (a) inform the discloser that the disclosure could be treated as an internal disclosure for the purposes of this Act; and  (b) explain to the discloser the procedures under this Act for such a disclosure to be:  (i) given to an authorised officer; and  (ii) allocated to the discloser’s agency or another agency; and  (iii) investigated by the principal officer of that agency; and  (c) advise the individual about the circumstances (if any) in which a public interest disclosure must be referred to an agency, or other person or body, under another law of the Commonwealth; and  (d) explain to the discloser the civil and criminal protections this Act provides to protect disclosers, and those providing assistance in relation to such disclosures, from reprisals. Obligation to give information to an authorised officer" ;
    cof:pageNumber "88"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-60a-ss-3 a cml:Concept ;
    skos:prefLabel "60A(3) Additional obligations of supervisors"@en ;
    cml:realizedBy doc:sec-60a-ss-3 ;
    values:originalText "(3) The supervisor must, as soon as reasonably practicable after the disclosure is made, give the information to an authorised officer of the agency." ;
    skos:definition "(3) The supervisor must, as soon as reasonably practicable after the disclosure is made, give the information to an authorised officer of the agency."@en ;
