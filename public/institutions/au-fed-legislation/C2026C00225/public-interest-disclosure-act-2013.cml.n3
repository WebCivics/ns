concept:public-interest-disclosure-act-2013-sec-21 a cml:Concept ;
    skos:prefLabel "21 Identifying information not to be disclosed etc. to courts or"@en ;
    cml:realizedBy doc:sec-21 ;
    values:originalText "tribunals  A person who is, or has been, a public official is not to be required:  (a) to disclose to a court or tribunal identifying information that the person has obtained; or  (b) to produce to a court or tribunal a document containing identifying information that the person has obtained; except where it is necessary to do so for the purposes of giving effect to this Act. Subdivision D—Interaction with the Fair Work Act 2009" ;
    skos:definition "tribunals  A person who is, or has been, a public official is not to be required:  (a) to disclose to a court or tribunal identifying information that the person has obtained; or  (b) to produce to a court or tribunal a document containing identifying information that the person has obtained; except where it is necessary to do so for the purposes of giving effect to this Act. Subdivision D—Interaction with the Fair Work Act 2009"@en ;
    cml:integrityHash "84b75c0ab24598079463f423237326ff94b502f9d235af4c42fb9e28e3fc6076" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Public officials cannot disclose identifying information to courts or tribunals." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-interest-disclosure-act-2013.pdf> ;
    dc:source "public-interest-disclosure-act-2013.pdf, p.35" ;
