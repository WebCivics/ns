doc:sec-59-ss-1 a cof:Section ;
    cof:title "59(1) Additional obligations of principal officers" ;
    values:kind "subsection" ;
    values:originalText "(1) The principal officer of an agency must take reasonable steps to ensure that:  (a) the number of authorised officers of the agency is sufficient to ensure that they are readily accessible by public officials who belong to the agency; and  (b) public officials who belong to the agency are aware of the identity of each authorised officer of the agency." ;
    cof:pageNumber "85"^^xsd:integer .

concept:public-interest-disclosure-act-2013-sec-59-ss-2 a cml:Concept ;
    skos:prefLabel "59(2) Additional obligations of principal officers"@en ;
    cml:realizedBy doc:sec-59-ss-2 ;
    values:originalText "(2) The principal officer of an agency must take reasonable steps to encourage and support:  (a) public officials who make, or are considering making, public interest disclosures relating to the agency; and" ;
    skos:definition "(2) The principal officer of an agency must take reasonable steps to encourage and support:  (a) public officials who make, or are considering making, public interest disclosures relating to the agency; and"@en ;
