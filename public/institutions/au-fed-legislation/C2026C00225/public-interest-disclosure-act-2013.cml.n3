concept:public-interest-disclosure-act-2013-sec-11a a cml:Concept ;
    skos:prefLabel "11A Designated publication restrictions"@en ;
    cml:realizedBy doc:sec-11a ;
    values:originalText "Section 10 does not apply to civil, criminal or administrative liability (including disciplinary action) for making a disclosure that contravenes a designated publication restriction if the person making the disclosure:  (a) knows that the disclosure contravenes the designated publication restriction; and  (b) does not have a reasonable excuse for that contravention.   Protection of disclosers and witnesses  Part 2 Protections  Division 1  Section 12  Public Interest Disclosure Act 2013  Compilation date: 04/06/2026" ;
    skos:definition "Section 10 does not apply to civil, criminal or administrative liability (including disciplinary action) for making a disclosure that contravenes a designated publication restriction if the person making the disclosure:  (a) knows that the disclosure contravenes the designated publication restriction; and  (b) does not have a reasonable excuse for that contravention.   Protection of disclosers and witnesses  Part 2 Protections  Division 1  Section 12  Public Interest Disclosure Act 2013  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "82eabbef5823ba1e59327d56b05150c02ab42ceb828eba4e78f45abc868baf9d" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Disclosure contravening designated publication restriction is prohibited if person making disclosure knows of the contravention and lacks reasonable excuse." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-interest-disclosure-act-2013.pdf> ;
    dc:source "public-interest-disclosure-act-2013.pdf, p.24" ;
