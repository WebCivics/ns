    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-12b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "12B(5) Witnesses—exceptions to immunities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12b-ss-5"
      },
      "cml:curationStatus": {
