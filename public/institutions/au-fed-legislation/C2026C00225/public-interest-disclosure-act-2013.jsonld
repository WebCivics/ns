      "cml:premiseText": "Investigation completion starts at specified event",
      "cml:conclusionText": "Investigation completion ends 90 days after specified event"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-52-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "52(2) Time limit for investigations under this Division",
