      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the disclosure is to a person other than the second person.",
      "cml:conclusionText": "Using disclosing identifying information after a public interest disclosure is prohibited."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-20-ss-1-logic-deontic-3",
