    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Objects",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.9",
      "values:originalText": "The objects of this Act are:\n\n(a) to promote the integrity and accountability of the\nCommonwealth public sector; and\n\n(b) to encourage and facilitate the making of public interest\ndisclosures by public officials and former public officials;\nand\n\n(c) to ensure that public officials, and former public officials,\nwho make public interest disclosures are supported and are\nprotected from adverse consequences relating to the\ndisclosures; and\n\n(d) to ensure that disclosures by public officials, and former\npublic officials, are properly investigated and dealt with.",
      "skos:definition": "The objects of this Act are:\n\n(a) to promote the integrity and accountability of the\nCommonwealth public sector; and\n\n(b) to encourage and facilitate the making of public interest\ndisclosures by public officials and former public officials;\nand\n\n(c) to ensure that public officials, and former public officials,\nwho make public interest disclosures are supported and are\nprotected from adverse consequences relating to the\ndisclosures; and\n\n(d) to ensure that disclosures by public officials, and former\npublic officials, are properly investigated and dealt with.",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-6-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "21d619956dc8ffa6366aac92c3b3d654dc6aacaf672ae865a77b4f27f7121395",
      "skos:note": "Promote integrity and accountability of Commonwealth public sector."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Objects",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The objects of this Act are:\n\n(a) to promote the integrity and accountability of the\nCommonwealth public sector; and\n\n(b) to encourage and facilitate the making of public interest\ndisclosures by public officials and former public officials;\nand\n\n(c) to ensure that public officials, and former public officials,\nwho make public interest disclosures are supported and are\nprotected from adverse consequences relating to the\ndisclosures; and\n\n(d) to ensure that disclosures by public officials, and former\npublic officials, are properly investigated and dealt with."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-interest-disclosure-act-2013-sec-6"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "promote",
      "cml:logicSummary": "Obligation to promote integrity and accountability.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State has a duty to promote...",
      "cml:conclusionText": "...integrity and accountability of Commonwealth public sector."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Simplified outline of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.10",
      "values:originalText": "General\nThis Act provides a framework for current and former public\nofficials to disclose allegations of misconduct (“disclosable\nconduct”) in the Commonwealth public sector.\nAgencies are required to investigate disclosures of potential\ndisclosable conduct.\nProtection from reprisals is provided for current and former public\nofficials making disclosures, and persons providing assistance in\ndisclosure investigations and reviews.\nWhat is a public interest disclosure?\nA public interest disclosure is a disclosure of information relating\nto disclosable conduct alleged to have occurred within a\nCommonwealth agency (for relevant agencies, see sections 71 and\n72).\nThere are 5 kinds of public interest disclosure (see section 26),\nwhich are as follows:\n\n(a)\nan internal disclosure (disclosed within an agency);\n\n(b)\nan external disclosure (disclosed outside Government);\n\n(c)\nan emergency disclosure;\n\n(d)\na legal practitioner disclosure;\n\n(e)\na NACC disclosure.\nWhat is disclosable conduct?\nDisclosable conduct, broadly speaking, includes conduct that:\n\n(a)\nis illegal or corrupt; or\n\n\nIntroduction  Part 1\nOverview  Division 3\n\nSection 7\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026\n\n(b)\nresults in a wastage of money or property; or\n\n(c)\nresults in unreasonable danger or risk to health and\nsafety; or\n\n(d)\nresults in danger, or an increased risk of danger, to the\nenvironment.\nSee section 29 for more detail relating to disclosable conduct.\nPersonal work-related conduct (for example, bullying or\nharassment) is not generally disclosable conduct. However,\npersonal work-related conduct may be treated as disclosable\nconduct in some circumstances. See subsection 29(2A) and\nsection 29A for more detail relating to personal work-related\nconduct.\nInvestigation of internal disclosures\nGenerally, this Act provides for a disclosure of disclosable conduct\nto be first investigated internally, as an internal disclosure.\nInternal disclosures may be made by public officials (and former\npublic officials) to supervisors and authorised officers of\nCommonwealth agencies, including, in appropriate cases, an\nauthorised officer of the Ombudsman and the IGIS.\nPart 3 deals with the allocation of the handling of internal\ndisclosures to appropriate agencies, and their investigation by the\nprincipal officers of those agencies. Investigative agencies may\ninstead use their own investigative powers to investigate\ndisclosures.\nIf an authorised officer or principal officer of an agency considers\nthat the conduct disclosed would be more appropriately\ninvestigated under another law or power, the officer must take\nreasonable steps to refer the conduct, or to facilitate its referral, for\ninvestigation under the other law or power.\nNotice of decisions related to the allocation and investigation of\ndisclosures must be given to the relevant discloser and:",
      "skos:definition": "General\nThis Act provides a framework for current and former public\nofficials to disclose allegations of misconduct (“disclosable\nconduct”) in the Commonwealth public sector.\nAgencies are required to investigate disclosures of potential\ndisclosable conduct.\nProtection from reprisals is provided for current and former public\nofficials making disclosures, and persons providing assistance in\ndisclosure investigations and reviews.\nWhat is a public interest disclosure?\nA public interest disclosure is a disclosure of information relating\nto disclosable conduct alleged to have occurred within a\nCommonwealth agency (for relevant agencies, see sections 71 and\n72).\nThere are 5 kinds of public interest disclosure (see section 26),\nwhich are as follows:\n\n(a)\nan internal disclosure (disclosed within an agency);\n\n(b)\nan external disclosure (disclosed outside Government);\n\n(c)\nan emergency disclosure;\n\n(d)\na legal practitioner disclosure;\n\n(e)\na NACC disclosure.\nWhat is disclosable conduct?\nDisclosable conduct, broadly speaking, includes conduct that:\n\n(a)\nis illegal or corrupt; or\n\n\nIntroduction  Part 1\nOverview  Division 3\n\nSection 7\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026\n\n(b)\nresults in a wastage of money or property; or\n\n(c)\nresults in unreasonable danger or risk to health and\nsafety; or\n\n(d)\nresults in danger, or an increased risk of danger, to the\nenvironment.\nSee section 29 for more detail relating to disclosable conduct.\nPersonal work-related conduct (for example, bullying or\nharassment) is not generally disclosable conduct. However,\npersonal work-related conduct may be treated as disclosable\nconduct in some circumstances. See subsection 29(2A) and\nsection 29A for more detail relating to personal work-related\nconduct.\nInvestigation of internal disclosures\nGenerally, this Act provides for a disclosure of disclosable conduct\nto be first investigated internally, as an internal disclosure.\nInternal disclosures may be made by public officials (and fo",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-7-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-7-logic-deontic-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-7-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "a0a0193e2495f16899e6a108e5212e44e90bd2875be99f6c90e1609ad55418af",
      "skos:note": "Agencies are required to investigate disclosures of potential disclosable conduct."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Simplified outline of this Act",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "General\nThis Act provides a framework for current and former public\nofficials to disclose allegations of misconduct (“disclosable\nconduct”) in the Commonwealth public sector.\nAgencies are required to investigate disclosures of potential\ndisclosable conduct.\nProtection from reprisals is provided for current and former public\nofficials making disclosures, and persons providing assistance in\ndisclosure investigations and reviews.\nWhat is a public interest disclosure?\nA public interest disclosure is a disclosure of information relating\nto disclosable conduct alleged to have occurred within a\nCommonwealth agency (for relevant agencies, see sections 71 and\n72).\nThere are 5 kinds of public interest disclosure (see section 26),\nwhich are as follows:\n\n(a)\nan internal disclosure (disclosed within an agency);\n\n(b)\nan external disclosure (disclosed outside Government);\n\n(c)\nan emergency disclosure;\n\n(d)\na legal practitioner disclosure;\n\n(e)\na NACC disclosure.\nWhat is disclosable conduct?\nDisclosable conduct, broadly speaking, includes conduct that:\n\n(a)\nis illegal or corrupt; or\n\n\nIntroduction  Part 1\nOverview  Division 3\n\nSection 7\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026\n\n(b)\nresults in a wastage of money or property; or\n\n(c)\nresults in unreasonable danger or risk to health and\nsafety; or\n\n(d)\nresults in danger, or an increased risk of danger, to the\nenvironment.\nSee section 29 for more detail relating to disclosable conduct.\nPersonal work-related conduct (for example, bullying or\nharassment) is not generally disclosable conduct. However,\npersonal work-related conduct may be treated as disclosable\nconduct in some circumstances. See subsection 29(2A) and\nsection 29A for more detail relating to personal work-related\nconduct.\nInvestigation of internal disclosures\nGenerally, this Act provides for a disclosure of disclosable conduct\nto be first investigated internally, as an internal disclosure.\nInternal disclosures may be made by public officials (and former\npublic officials) to supervisors and authorised officers of\nCommonwealth agencies, including, in appropriate cases, an\nauthorised officer of the Ombudsman and the IGIS.\nPart 3 deals with the allocation of the handling of internal\ndisclosures to appropriate agencies, and their investigation by the\nprincipal officers of those agencies. Investigative agencies may\ninstead use their own investigative powers to investigate\ndisclosures.\nIf an authorised officer or principal officer of an agency considers\nthat the conduct disclosed would be more appropriately\ninvestigated under another law or power, the officer must take\nreasonable steps to refer the conduct, or to facilitate its referral, for\ninvestigation under the other law or power.\nNotice of decisions related to the allocation and investigation of\ndisclosures must be given to the relevant discloser and:"
    },
