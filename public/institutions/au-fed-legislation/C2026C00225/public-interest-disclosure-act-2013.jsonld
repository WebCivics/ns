        }
      ],
      "cml:integrityHash": "acb298ca16d41c034a4cbba0ba945a4efe5fcddb8d4b19f27bdb0f96cf1c8337",
      "skos:note": "Act extends to acts, omissions, matters and things outside Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Extension to things outside Australia",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "This Act extends to acts, omissions, matters and things outside\nAustralia.\n\n\nIntroduction  Part 1\nObjects  Division 2\n\nSection 6\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-5-norm",
