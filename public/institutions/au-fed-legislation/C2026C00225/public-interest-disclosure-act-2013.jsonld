    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Associated allegations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.44",
      "values:originalText": "An allegation is a public interest disclosure if:\n\n(a) it is made by a person who makes a disclosure of information\nthat is a public interest disclosure under section 26; and\n\n(b) it is made to the recipient of that disclosure in conjunction\nwith that disclosure; and\n\n(c) it is an allegation to the effect that the information disclosed\nconcerns one or more instances of disclosable conduct.",
      "skos:definition": "An allegation is a public interest disclosure if:\n\n(a) it is made by a person who makes a disclosure of information\nthat is a public interest disclosure under section 26; and\n\n(b) it is made to the recipient of that disclosure in conjunction\nwith that disclosure; and\n\n(c) it is an allegation to the effect that the information disclosed\nconcerns one or more instances of disclosable conduct.",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-27-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-27-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "20786ff521fbab10bee09b18dfb89e6ca5c5179382fb9fd5c72c01a71874ae2d",
      "skos:note": "Allegations of disclosable conduct must be made in conjunction with a public interest disclosure."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Associated allegations",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "An allegation is a public interest disclosure if:\n\n(a) it is made by a person who makes a disclosure of information\nthat is a public interest disclosure under section 26; and\n\n(b) it is made to the recipient of that disclosure in conjunction\nwith that disclosure; and\n\n(c) it is an allegation to the effect that the information disclosed\nconcerns one or more instances of disclosable conduct."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-27-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
