    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Disclosure or use of identifying information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.33",
      "values:originalText": "Disclosure of identifying information\n\n(1) A person (the first person) commits an offence if:\n\n(a) another person (the second person) has made a public\ninterest disclosure; and\n\n(b) the first person discloses information (identifying\ninformation) that:\n\n(i) was obtained by any person in that person’s capacity as\na public official; and\n\n(ii) is likely to enable the identification of the second person\nas a person who has made a public interest disclosure;\nand\n\n(c) the disclosure is to a person other than the second person.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\nUse of identifying information\n\n(2) A person commits an offence if the person uses identifying\ninformation.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.",
      "skos:definition": "Disclosure of identifying information\n\n(1) A person (the first person) commits an offence if:\n\n(a) another person (the second person) has made a public\ninterest disclosure; and\n\n(b) the first person discloses information (identifying\ninformation) that:\n\n(i) was obtained by any person in that person’s capacity as\na public official; and\n\n(ii) is likely to enable the identification of the second person\nas a person who has made a public interest disclosure;\nand\n\n(c) the disclosure is to a person other than the second person.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\nUse of identifying information\n\n(2) A person commits an offence if the person uses identifying\ninformation.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.",
      "cml:hasPart": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-20-ss-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-20-ss-2"
        }
      ],
      "cml:integrityHash": "770b00abc239ff205c9976b7a315a6dbde5c2b10192e880bfc05a48c033a953e"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Disclosure or use of identifying information",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "Disclosure of identifying information\n\n(1) A person (the first person) commits an offence if:\n\n(a) another person (the second person) has made a public\ninterest disclosure; and\n\n(b) the first person discloses information (identifying\ninformation) that:\n\n(i) was obtained by any person in that person’s capacity as\na public official; and\n\n(ii) is likely to enable the identification of the second person\nas a person who has made a public interest disclosure;\nand\n\n(c) the disclosure is to a person other than the second person.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\nUse of identifying information\n\n(2) A person commits an offence if the person uses identifying\ninformation.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-20-ss-1",
