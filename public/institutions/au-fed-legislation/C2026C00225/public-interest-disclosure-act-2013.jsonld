    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Liability for false or misleading statements etc. unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.24",
      "values:originalText": "(1) Section 10 does not apply to civil, criminal or administrative\nliability (including disciplinary action) for knowingly making a\nstatement that is false or misleading.\n\n(2) Without limiting subsection (1) of this section, section 10 does not\napply to liability for an offence against section 137.1, 137.2, 144.1\nor 145.1 of the Criminal Code.",
      "skos:definition": "(1) Section 10 does not apply to civil, criminal or administrative\nliability (including disciplinary action) for knowingly making a\nstatement that is false or misleading.\n\n(2) Without limiting subsection (1) of this section, section 10 does not\napply to liability for an offence against section 137.1, 137.2, 144.1\nor 145.1 of the Criminal Code.",
      "cml:hasPart": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11-ss-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11-ss-2"
        }
      ],
      "cml:integrityHash": "ba41d73a25fca4a8849bb1c6300bbd636e24f7ff3151aee0ac581db6a64bff96"
    },
