      "cml:logicSummary": "Authorised officer has reasonable grounds to believe disclosure is disclosable conduct",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
