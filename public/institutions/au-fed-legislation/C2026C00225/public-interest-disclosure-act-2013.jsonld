    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Meaning of authorised officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.54",
      "values:originalText": "An authorised officer, of an agency, is:\n\n(a) the principal officer of the agency; or\n\n(b) a public official who:\n\n(i) belongs to the agency; and\n\n(ii) is appointed, in writing, by the principal officer of the\nagency as an authorised officer for the purposes of this\nAct.\nSubdivision D—Intelligence information",
      "skos:definition": "An authorised officer, of an agency, is:\n\n(a) the principal officer of the agency; or\n\n(b) a public official who:\n\n(i) belongs to the agency; and\n\n(ii) is appointed, in writing, by the principal officer of the\nagency as an authorised officer for the purposes of this\nAct.\nSubdivision D—Intelligence information",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-36-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a858644570edd2d224bd29b3a474c29750f95d9cc5683572b86a62b8c3ae38f2",
      "skos:note": "Defines an authorised officer for an agency."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Meaning of authorised officer",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "An authorised officer, of an agency, is:\n\n(a) the principal officer of the agency; or\n\n(b) a public official who:\n\n(i) belongs to the agency; and\n\n(ii) is appointed, in writing, by the principal officer of the\nagency as an authorised officer for the purposes of this\nAct.\nSubdivision D—Intelligence information"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-36-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-interest-disclosure-act-2013-sec-36"
