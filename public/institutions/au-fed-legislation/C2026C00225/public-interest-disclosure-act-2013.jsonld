    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-44b-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "44B(3) Non-allocation of disclosure subject to stop action direction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-44b-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
