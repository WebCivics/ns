        }
      ],
      "cml:integrityHash": "c20fca85acca523ab2f3dc179d69c1bf0567ffaf2932fd61d97982c04a957599",
      "skos:note": "Witnesses are not subject to civil, criminal or administrative liability for assistance provided."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12a-ss-3",
      "@type": "cof:Section",
      "cof:title": "12A(3) Witnesses—immunity from liability etc.",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(3) The witness is not subject to any civil, criminal or administrative\nliability (including disciplinary action) because of the assistance\nprovided.\nImmunity from enforcement of remedies or rights"
    },
