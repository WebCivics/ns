      },
      "cml:premiseText": "The investigation relates to one or more instances of fraud.",
      "cml:conclusionText": "The principal officer must act accordingly during the investigation."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-54",
      "@type": "cml:Concept",
      "skos:prefLabel": "54 Adoption of findings of another investigation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-54"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.79",
      "values:originalText": "The principal officer conducting an investigation under this\nDivision may, for the purposes of the investigation, adopt a finding\nset out in the report of:\n\n(a) an investigation or inquiry under another law or power; or\n\n(b) another investigation under this Division.",
      "skos:definition": "The principal officer conducting an investigation under this\nDivision may, for the purposes of the investigation, adopt a finding\nset out in the report of:\n\n(a) an investigation or inquiry under another law or power; or\n\n(b) another investigation under this Division.",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-54-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-54-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b4894155f17277b5b5a3bcf2eec6e5464aa620012fbe4181495fbae9a267e195",
      "skos:note": "May adopt findings from another investigation under this Division."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-54",
      "@type": "cof:Section",
      "cof:title": "54 Adoption of findings of another investigation",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "The principal officer conducting an investigation under this\nDivision may, for the purposes of the investigation, adopt a finding\nset out in the report of:\n\n(a) an investigation or inquiry under another law or power; or\n\n(b) another investigation under this Division."
    },
