    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Extension to things outside Australia",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
