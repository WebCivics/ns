    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-82a",
      "@type": "cml:Concept",
      "skos:prefLabel": "82A Review of operation of Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-82a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.112",
      "values:originalText": "(1) The Minister must cause a review to be undertaken of the operation\nof this Act.\n\n(2) The review must be conducted as soon as practicable after the end\nof 5 years after this section commences.\n\n(3) The Minister must cause a written report about the review to be\nprepared.\n\n\nMiscellaneous  Part 5\n\nSection 83\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026\n\n(4) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives the report.",
      "skos:definition": "(1) The Minister must cause a review to be undertaken of the operation\nof this Act.\n\n(2) The review must be conducted as soon as practicable after the end\nof 5 years after this section commences.\n\n(3) The Minister must cause a written report about the review to be\nprepared.\n\n\nMiscellaneous  Part 5\n\nSection 83\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026\n\n(4) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives the report.",
      "cml:hasPart": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-82a-ss-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-82a-ss-2"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-82a-ss-3"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-82a-ss-4"
        }
      ],
      "cml:integrityHash": "d1b36968a035a58b0a6a93bae1002376332cf92b262ec65f0db9abb4f58b5c5c"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-82a",
      "@type": "cof:Section",
      "cof:title": "82A Review of operation of Act",
      "values:kind": "section",
      "cof:pageNumber": 112,
      "values:originalText": "(1) The Minister must cause a review to be undertaken of the operation\nof this Act.\n\n(2) The review must be conducted as soon as practicable after the end\nof 5 years after this section commences.\n\n(3) The Minister must cause a written report about the review to be\nprepared.\n\n\nMiscellaneous  Part 5\n\nSection 83\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026\n\n(4) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives the report."
    },
