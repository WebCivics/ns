      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-22a",
      "@type": "cml:Concept",
      "skos:prefLabel": "22A Interaction with remedies under the Fair Work Act 2009",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-22a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.35",
      "values:originalText": "(1) A person is not entitled to make an application to the Federal Court\nor Federal Circuit and Family Court of Australia (Division 2) for\nan order under section 14, 15 or 16 of this Act in relation to\nparticular conduct if another application has been made:\n\n(a) under section 539 of the Fair Work Act 2009 in relation to a\ncontravention of section 340 or 772 of that Act constituted by\nthe same conduct; or",
      "skos:definition": "(1) A person is not entitled to make an application to the Federal Court\nor Federal Circuit and Family Court of Australia (Division 2) for\nan order under section 14, 15 or 16 of this Act in relation to\nparticular conduct if another application has been made:\n\n(a) under section 539 of the Fair Work Act 2009 in relation to a\ncontravention of section 340 or 772 of that Act constituted by\nthe same conduct; or",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-22a-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-22a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3a3ee5428e43b5bc6c0051a4892419011f5d7bddd3e65965b4e229e83233c969",
      "skos:note": "Prohibition on making applications for certain orders in Federal Court or Family Court of Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-22a",
      "@type": "cof:Section",
      "cof:title": "22A Interaction with remedies under the Fair Work Act 2009",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "(1) A person is not entitled to make an application to the Federal Court\nor Federal Circuit and Family Court of Australia (Division 2) for\nan order under section 14, 15 or 16 of this Act in relation to\nparticular conduct if another application has been made:\n\n(a) under section 539 of the Fair Work Act 2009 in relation to a\ncontravention of section 340 or 772 of that Act constituted by\nthe same conduct; or"
    },
