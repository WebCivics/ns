    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "82 Other investigative powers etc. not affected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
