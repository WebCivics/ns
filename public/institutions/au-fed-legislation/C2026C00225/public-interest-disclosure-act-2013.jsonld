          "@id": "concept:public-interest-disclosure-act-2013-sec-12a-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eb78d0bd5bbfdfa35427f90c270b211068d255bbeedcfaf1c6c08af590760a6f",
      "skos:note": "No contractual remedy may be enforced against the witness."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12a-ss-4",
      "@type": "cof:Section",
      "cof:title": "12A(4) Witnesses—immunity from liability etc.",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(4) No contractual or other remedy may be enforced, and no\ncontractual or other right may be exercised, against the witness on\nthe basis of the assistance provided."
    },
    {
