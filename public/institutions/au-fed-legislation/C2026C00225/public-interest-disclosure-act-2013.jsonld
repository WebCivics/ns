      }
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of disclosure contravening designated publication restriction",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person making disclosure knows of the contravention and lacks reasonable excuse.",
      "cml:conclusionText": "Disclosure is prohibited."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Disclosure must occur within the same temporal interval as the designated publication restriction",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
