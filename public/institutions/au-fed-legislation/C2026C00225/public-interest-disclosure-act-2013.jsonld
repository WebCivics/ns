    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Conduct connected with intelligence agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.51",
      "values:originalText": "Despite section 29, conduct is not disclosable conduct if it is:\n\n(a) conduct that an intelligence agency engages in in the proper\nperformance of its functions or the proper exercise of its\npowers; or\n\n(b) conduct that a public official who belongs to an intelligence\nagency engages in for the purposes of the proper performance\nof its functions or the proper exercise of its powers.\nSubdivision C—Internal disclosures: authorised internal\nrecipients",
      "skos:definition": "Despite section 29, conduct is not disclosable conduct if it is:\n\n(a) conduct that an intelligence agency engages in in the proper\nperformance of its functions or the proper exercise of its\npowers; or\n\n(b) conduct that a public official who belongs to an intelligence\nagency engages in for the purposes of the proper performance\nof its functions or the proper exercise of its powers.\nSubdivision C—Internal disclosures: authorised internal\nrecipients",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-33-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45b87df703149c82da852508f85625e5afdfc5584817d69133d98b64468ca44e",
      "skos:note": "Conduct connected with intelligence agencies is not disclosable if it is part of proper performance or exercise of powers."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Conduct connected with intelligence agencies",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "Despite section 29, conduct is not disclosable conduct if it is:\n\n(a) conduct that an intelligence agency engages in in the proper\nperformance of its functions or the proper exercise of its\npowers; or\n\n(b) conduct that a public official who belongs to an intelligence\nagency engages in for the purposes of the proper performance\nof its functions or the proper exercise of its powers.\nSubdivision C—Internal disclosures: authorised internal\nrecipients"
    },
    {
