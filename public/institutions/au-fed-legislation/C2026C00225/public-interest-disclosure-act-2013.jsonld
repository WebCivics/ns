    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-53-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Must act in accordance with rules",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Rules relating to fraud are made for the purposes of the Public Governance, Performance and Accountability Act 2013.",
      "cml:conclusionText": "The principal officer must act accordingly."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-53-ss-4-logic-alleninterval-2",
