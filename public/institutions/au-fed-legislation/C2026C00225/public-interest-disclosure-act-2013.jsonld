    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-12a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "12A(3) Witnesses—immunity from liability etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.25",
      "values:originalText": "(3) The witness is not subject to any civil, criminal or administrative\nliability (including disciplinary action) because of the assistance\nprovided.\nImmunity from enforcement of remedies or rights",
      "skos:definition": "(3) The witness is not subject to any civil, criminal or administrative\nliability (including disciplinary action) because of the assistance\nprovided.\nImmunity from enforcement of remedies or rights",
      "values:partOf": {
