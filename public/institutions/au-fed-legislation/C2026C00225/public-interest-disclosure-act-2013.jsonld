        }
      ],
      "cml:integrityHash": "28d25fd4ce9912ab45d70dc0482480da14d6fa21277d5c0136a52cf712ea0e1c",
      "skos:note": "Exemptions from secrecy provisions for disclosure investigations and performance of functions/exercise of powers."
    },
    {
