    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Additional obligations of public officials",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.89",
      "values:originalText": "(1) A public official must use his or her best endeavours to assist the\nprincipal officer of an agency in the conduct of an investigation\nunder Division 2 of Part 3.\n\n(2) A public official must use his or her best endeavours to assist the\nOmbudsman in the performance of the Ombudsman’s functions\nunder this Act.\n\n(3) A public official must use his or her best endeavours to assist the\nIGIS in the performance of the IGIS’s functions under this Act.",
      "skos:definition": "(1) A public official must use his or her best endeavours to assist the\nprincipal officer of an agency in the conduct of an investigation\nunder Division 2 of Part 3.\n\n(2) A public official must use his or her best endeavours to assist the\nOmbudsman in the performance of the Ombudsman’s functions\nunder this Act.\n\n(3) A public official must use his or her best endeavours to assist the\nIGIS in the performance of the IGIS’s functions under this Act.",
      "cml:hasPart": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-61-ss-1"
        },
        {
