    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-69-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
