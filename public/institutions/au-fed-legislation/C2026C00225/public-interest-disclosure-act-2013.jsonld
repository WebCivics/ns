    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Simplified outline of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.93",
      "values:originalText": "This Division authorises the sharing of information about a\ndisclosure between agencies, including between investigative\nagencies. It also provides an offence for the further disclosure, or\nuse, of information that is the subject of a legal practitioner\ndisclosure, except for the purposes of providing legal advice and\nprofessional assistance.",
      "skos:definition": "This Division authorises the sharing of information about a\ndisclosure between agencies, including between investigative\nagencies. It also provides an offence for the further disclosure, or\nuse, of information that is the subject of a legal practitioner\ndisclosure, except for the purposes of providing legal advice and\nprofessional assistance.",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-64-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-64-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "51099ec0dd7e0616cfcb993f211832a3be80b143ff435c186bd1506542bbdd31",
      "skos:note": "Sharing of information about disclosure between agencies is authorized, but further disclosure or use of such information is prohibited except for providing legal advice and professional assistance."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Simplified outline of this Division",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "This Division authorises the sharing of information about a\ndisclosure between agencies, including between investigative\nagencies. It also provides an offence for the further disclosure, or\nuse, of information that is the subject of a legal practitioner\ndisclosure, except for the purposes of providing legal advice and\nprofessional assistance."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-64-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-interest-disclosure-act-2013-sec-64"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-64-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of further disclosure or use of information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Legal practitioner's duty to maintain confidentiality",
      "cml:conclusionText": "No further disclosure or use allowed"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-65",
      "@type": "cml:Concept",
      "skos:prefLabel": "65 Sharing information and documents between agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-65"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.93",
      "values:originalText": "Scope\n\n(1) This section applies to the provision of information and documents\nin relation to a disclosure that are relevant to the disclosure or the\nconduct disclosed, including (but not limited to) a copy of a report\nof an investigation into the disclosure under section 51.\n\n(2) To avoid doubt, this section does not limit the extent to which the\nprovision of information or documents may be authorised or\npermitted under this or any other law.\nAuthorised sharing\n\n(3) The principal officer of an agency (the sharing agency) mentioned\nin column 1 of the following table is authorised to provide any\nsuch information and documents to the principal officer of an\nagency (the destination agency) mentioned in column 2 of the\ntable, if the principal officer of the sharing agency considers the\ninformation or documents to be relevant to the destination agency’s\nfunctions.",
      "skos:definition": "Scope\n\n(1) This section applies to the provision of information and documents\nin relation to a disclosure that are relevant to the disclosure or the\nconduct disclosed, including (but not limited to) a copy of a report\nof an investigation into the disclosure under section 51.\n\n(2) To avoid doubt, this section does not limit the extent to which the\nprovision of information or documents may be authorised or\npermitted under this or any other law.\nAuthorised sharing\n\n(3) The principal officer of an agency (the sharing agency) mentioned\nin column 1 of the following table is authorised to provide any\nsuch information and documents to the principal officer of an\nagency (the destination agency) mentioned in column 2 of the\ntable, if the principal officer of the sharing agency considers the\ninformation or documents to be relevant to the destination agency’s\nfunctions.",
      "cml:hasPart": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-65-ss-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-65-ss-2"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-65-ss-3"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-65",
      "@type": "cof:Section",
      "cof:title": "65 Sharing information and documents between agencies",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "Scope\n\n(1) This section applies to the provision of information and documents\nin relation to a disclosure that are relevant to the disclosure or the\nconduct disclosed, including (but not limited to) a copy of a report\nof an investigation into the disclosure under section 51.\n\n(2) To avoid doubt, this section does not limit the extent to which the\nprovision of information or documents may be authorised or\npermitted under this or any other law.\nAuthorised sharing\n\n(3) The principal officer of an agency (the sharing agency) mentioned\nin column 1 of the following table is authorised to provide any\nsuch information and documents to the principal officer of an\nagency (the destination agency) mentioned in column 2 of the\ntable, if the principal officer of the sharing agency considers the\ninformation or documents to be relevant to the destination agency’s\nfunctions."
    },
