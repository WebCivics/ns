    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Protections have effect despite other Commonwealth laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.37",
      "values:originalText": "Section 10, 14, 15 or 16 has effect despite any other provision of a\nlaw of the Commonwealth, unless:\n\n(a) the provision is enacted after the commencement of this\nsection; and\n\n(b) the provision is expressed to have effect despite this Part or\nthat section.",
      "skos:definition": "Section 10, 14, 15 or 16 has effect despite any other provision of a\nlaw of the Commonwealth, unless:\n\n(a) the provision is enacted after the commencement of this\nsection; and\n\n(b) the provision is expressed to have effect despite this Part or\nthat section.",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-24-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-24-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e650e772ccb6b34be2883c0e54560146fdce4f57bb77eb63de0e8a5020e0c283",
      "skos:note": "Protections have effect despite other Commonwealth laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Protections have effect despite other Commonwealth laws",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "Section 10, 14, 15 or 16 has effect despite any other provision of a\nlaw of the Commonwealth, unless:\n\n(a) the provision is enacted after the commencement of this\nsection; and\n\n(b) the provision is expressed to have effect despite this Part or\nthat section."
    },
