    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Allocation of disclosure—decision by authorised officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-43"
      },
      "cml:curationStatus": {
