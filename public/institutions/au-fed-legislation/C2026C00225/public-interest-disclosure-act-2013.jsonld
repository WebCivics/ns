      },
      "cml:operator": "continuum",
      "cml:logicSummary": "Continuity of obligation in context of disclosure",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
