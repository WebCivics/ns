      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person making disclosure knows that the disclosure contravenes the designated publication restriction and does not have a reasonable excuse for that contravention.",
      "cml:conclusionText": "Disclosure occurs within the same temporal interval as the designated publication restriction."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "Disclosure must be recurrent if person making disclosure knows of the contravention and lacks reasonable excuse",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person making disclosure knows that the disclosure contravenes the designated publication restriction and does not have a reasonable excuse for that contravention.",
      "cml:conclusionText": "Disclosure is recurrent."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Disclosure must diffuse to all relevant parties if person making disclosure knows of the contravention and lacks reasonable excuse",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person making disclosure knows that the disclosure contravenes the designated publication restriction and does not have a reasonable excuse for that contravention.",
      "cml:conclusionText": "Disclosure diffuses to all relevant parties."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inferential",
      "cml:logicSummary": "Disclosure must be inferentially linked to the designated publication restriction if person making disclosure knows of the contravention and lacks reasonable excuse",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person making disclosure knows that the disclosure contravenes the designated publication restriction and does not have a reasonable excuse for that contravention.",
      "cml:conclusionText": "Disclosure is inferentially linked to the designated publication restriction."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Discloser’s liability for own conduct not affected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.25",
      "values:originalText": "To avoid doubt, whether the individual’s disclosure of his or her\nown conduct is a public interest disclosure does not affect his or\nher liability for the conduct.",
      "skos:definition": "To avoid doubt, whether the individual’s disclosure of his or her\nown conduct is a public interest disclosure does not affect his or\nher liability for the conduct.",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-12-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-12-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "88a4ca106e1256d4ba27a23eea2798a27b2ef869a335e23cac61090beca5d0bb",
      "skos:note": "Discloser's liability for own conduct not affected"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Discloser’s liability for own conduct not affected",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "To avoid doubt, whether the individual’s disclosure of his or her\nown conduct is a public interest disclosure does not affect his or\nher liability for the conduct."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-12-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-interest-disclosure-act-2013-sec-12"
      },
      "values:deonticStatus": {
