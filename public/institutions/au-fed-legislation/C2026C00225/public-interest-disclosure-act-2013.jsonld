    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-77-ss-1",
      "@type": "cof:Section",
      "cof:title": "77(1) Delegations",
      "values:kind": "subsection",
      "cof:pageNumber": 110,
      "values:originalText": "(1) The principal officer of an agency may, by writing, delegate any or\nall of the principal officer’s functions or powers under this Act to a\npublic official who belongs to the agency.\nExample: The Ombudsman and the IGIS are the principal officers of their\nrespective agencies. Under this subsection, the Ombudsman, or the\nIGIS, may delegate any of their respective functions or powers to a\npublic official who belongs to the relevant agency (see section 69).\n\n\nMiscellaneous  Part 5\n\nSection 78\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-77-ss-1-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-interest-disclosure-act-2013-sec-77-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-77-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to delegate",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The principal officer may, by writing, delegate any or all of their functions or powers.",
      "cml:conclusionText": "The public official may receive delegated functions or powers."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-77-ss-1-logic-alleninterval-2",
