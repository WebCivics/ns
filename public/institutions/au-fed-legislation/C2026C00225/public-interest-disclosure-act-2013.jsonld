    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-45a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "45A(3) Conduct related to intelligence agencies and agencies with",
      "cml:realizedBy": {
