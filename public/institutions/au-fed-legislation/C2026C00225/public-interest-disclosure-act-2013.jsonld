      "skos:note": "Simplified outline of Division definitions"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "The following is a simplified outline of this Division:\nThis Division defines the key concepts of public official, agency,\nprescribed authority and principal officer.\nSubdivision A—Public officials"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-68-norm",
      "@type": "values:Undertaking",
