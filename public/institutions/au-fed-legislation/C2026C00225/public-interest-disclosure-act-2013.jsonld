    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a",
      "@type": "cml:Concept",
      "skos:prefLabel": "11A Designated publication restrictions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-11a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.24",
      "values:originalText": "Section 10 does not apply to civil, criminal or administrative\nliability (including disciplinary action) for making a disclosure that\ncontravenes a designated publication restriction if the person\nmaking the disclosure:\n\n(a) knows that the disclosure contravenes the designated\npublication restriction; and\n\n(b) does not have a reasonable excuse for that contravention.\n\n\nProtection of disclosers and witnesses  Part 2\nProtections  Division 1\n\nSection 12\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026",
      "skos:definition": "Section 10 does not apply to civil, criminal or administrative\nliability (including disciplinary action) for making a disclosure that\ncontravenes a designated publication restriction if the person\nmaking the disclosure:\n\n(a) knows that the disclosure contravenes the designated\npublication restriction; and\n\n(b) does not have a reasonable excuse for that contravention.\n\n\nProtection of disclosers and witnesses  Part 2\nProtections  Division 1\n\nSection 12\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11a-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-deontic-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-alleninterval-2"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-ltl-3"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-diffusion-4"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-11a-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "82eabbef5823ba1e59327d56b05150c02ab42ceb828eba4e78f45abc868baf9d",
      "skos:note": "Disclosure contravening designated publication restriction is prohibited if person making disclosure knows of the contravention and lacks reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-11a",
      "@type": "cof:Section",
      "cof:title": "11A Designated publication restrictions",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "Section 10 does not apply to civil, criminal or administrative\nliability (including disciplinary action) for making a disclosure that\ncontravenes a designated publication restriction if the person\nmaking the disclosure:\n\n(a) knows that the disclosure contravenes the designated\npublication restriction; and\n\n(b) does not have a reasonable excuse for that contravention.\n\n\nProtection of disclosers and witnesses  Part 2\nProtections  Division 1\n\nSection 12\n\nPublic Interest Disclosure Act 2013\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-11a-norm",
