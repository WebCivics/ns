      "skos:note": "Duty to give information to police"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-56-ss-2",
      "@type": "cof:Section",
      "cof:title": "56(2) Disclosure to a member of an Australian police force",
      "values:kind": "subsection",
      "cof:pageNumber": 82,
      "values:originalText": "(2) The investigator may give the relevant information to a member of\nan Australian police force responsible for the investigation of the\noffence.\nDuty to give information to police"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-56-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
