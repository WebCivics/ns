    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-14-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "14(2) Compensation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-14-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
