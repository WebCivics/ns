      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The delegation is by writing.",
      "cml:conclusionText": "The delegation occurs during the principal officer's term."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-77-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "77(2) Delegations",
