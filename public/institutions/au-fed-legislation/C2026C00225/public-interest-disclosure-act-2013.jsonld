        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-50aa-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2a253c90f5994328deb95d88c68b960ac2572f5cfeab573826e3154e3066ffde",
      "skos:note": "Principal officer must refer conduct for investigation under other law or power."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-50aa-ss-2",
      "@type": "cof:Section",
      "cof:title": "50AA(2) Decision not to investigate—referral for investigation under",
      "values:kind": "subsection",
      "cof:pageNumber": 73,
      "values:originalText": "(2) The principal officer must, as soon as reasonably practicable, take\nreasonable steps to refer the conduct disclosed, or to facilitate its\nreferral, for investigation under the other law or power."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-50aa-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
