      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Reckless conduct is an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the first person engages in conduct; and (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;",
      "cml:conclusionText": "The first person commits an offence if they engage in reckless conduct."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Engaging in conduct with reckless disregard is an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) when the conduct is engaged in, the first person believes or suspects that the second person, or any other person: (i) has made a public interest disclosure; or (ii) may have made a public interest disclosure;",
      "cml:conclusionText": "The first person's belief or suspicion of a public interest disclosure is an obligation."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Temporal relation between conduct and threat is necessary for liability.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;",
      "cml:conclusionText": "The temporal relation between conduct and threat is necessary for liability."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Recurring trace of conduct towards persons who have made or may make public interest disclosures is necessary for liability.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the first person engages in conduct; and (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;",
      "cml:conclusionText": "The recurring trace of conduct towards persons who have made or may make public interest disclosures is necessary for liability."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-19a",
      "@type": "cml:Concept",
      "skos:prefLabel": "19A Interaction between civil remedies and offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-19a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.33",
      "values:originalText": "To avoid doubt, a person may bring proceedings under section 14,\n15 or 16 in relation to the taking of a reprisal even if a prosecution\nfor an offence against section 19 in relation to the reprisal has not\nbeen brought, or cannot be brought.\nSubdivision C—Protecting the identity of disclosers",
      "skos:definition": "To avoid doubt, a person may bring proceedings under section 14,\n15 or 16 in relation to the taking of a reprisal even if a prosecution\nfor an offence against section 19 in relation to the reprisal has not\nbeen brought, or cannot be brought.\nSubdivision C—Protecting the identity of disclosers",
      "cml:asserts": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-19a-norm"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-19a-logic-deontic-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-19a-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "527f8204e19957f2013e600e35834f8643b50783e78ada170db9ce0eb9ec011a",
      "skos:note": "A person may bring proceedings under sections 14, 15 or 16 in relation to a reprisal even if prosecution for an offence against section 19 has not been brought."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-19a",
      "@type": "cof:Section",
      "cof:title": "19A Interaction between civil remedies and offences",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "To avoid doubt, a person may bring proceedings under section 14,\n15 or 16 in relation to the taking of a reprisal even if a prosecution\nfor an offence against section 19 in relation to the reprisal has not\nbeen brought, or cannot be brought.\nSubdivision C—Protecting the identity of disclosers"
    },
