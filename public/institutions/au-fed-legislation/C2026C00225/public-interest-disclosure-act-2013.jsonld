      },
      "cml:premiseText": "(a) Conduct that contravenes a law...",
      "cml:conclusionText": "Disclosable conduct includes..."
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-29-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Includes abuse of public trust.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) Conduct that is an abuse of public trust.",
      "cml:conclusionText": "Disclosable conduct includes..."
