      },
      "cml:operator": "during",
      "cml:logicSummary": "During investigation relating to fraud",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
