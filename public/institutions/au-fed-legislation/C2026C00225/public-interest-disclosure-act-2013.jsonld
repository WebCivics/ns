      "cml:conclusionText": "Public official belongs to agency"
    },
    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-69-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "in",
      "cml:logicSummary": "Defines scope of Act",
      "cml:executionSurface": "modalities::logic::deontic",
