    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 How a public interest disclosure may be made",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.44",
      "values:originalText": "(1) A public interest disclosure may be made orally or in writing.\n\n(2) A public interest disclosure may be made anonymously.\n\n(3) A public interest disclosure may be made without the discloser\nasserting that the disclosure is made for the purposes of this Act.\n\n(4) This section does not apply to a public interest disclosure that is\nalso a NACC disclosure (see subsection 26(1A)).\nNote:\nNACC disclosures are dealt with under the National Anti-Corruption\nCommission Act 2022.\nSubdivision B—Disclosable conduct",
      "skos:definition": "(1) A public interest disclosure may be made orally or in writing.\n\n(2) A public interest disclosure may be made anonymously.\n\n(3) A public interest disclosure may be made without the discloser\nasserting that the disclosure is made for the purposes of this Act.\n\n(4) This section does not apply to a public interest disclosure that is\nalso a NACC disclosure (see subsection 26(1A)).\nNote:\nNACC disclosures are dealt with under the National Anti-Corruption\nCommission Act 2022.\nSubdivision B—Disclosable conduct",
      "cml:hasPart": [
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-28-ss-1"
        },
        {
          "@id": "concept:public-interest-disclosure-act-2013-sec-28-ss-2"
