    {
      "@id": "concept:public-interest-disclosure-act-2013-sec-12a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "12A(4) Witnesses—immunity from liability etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-interest-disclosure-act-2013#sec-12a-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-interest-disclosure-act-2013.pdf"
      },
      "dc:source": "public-interest-disclosure-act-2013.pdf, p.25",
      "values:originalText": "(4) No contractual or other remedy may be enforced, and no\ncontractual or other right may be exercised, against the witness on\nthe basis of the assistance provided.",
