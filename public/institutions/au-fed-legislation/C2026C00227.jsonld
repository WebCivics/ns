        "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-diffusion-4",
        "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "8c6925eba9c467a627352621e18ccf57964e97826112cf434b2ea772deb49187",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
