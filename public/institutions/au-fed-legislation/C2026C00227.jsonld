    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Then it has the same effect as if it were confined within Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal equivalence",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The temporal interval of a reference to collection, use or disclosure outside Australia is greater than or equal to the temporal interval of a reference to collection, use or disclosure within Australia."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Then it has the same effect as if it were confined within Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Knowledge representation",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "⊆",
      "cml:premiseText": "The knowledge representation of a reference to collection, use or disclosure outside Australia is a subset of the knowledge representation of a reference to collection, use or disclosure within Australia."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Then it has the same effect as if it were confined within Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Conditional obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "If a reference to collection, use or disclosure is made outside Australia."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Then it has the same effect as if it were confined within Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Set inclusion",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "⊆",
      "cml:premiseText": "The set of collections, uses or disclosures outside Australia is a subset of the set of collections, uses or disclosures within Australia."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Then it has the same effect as if it were confined within Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal inclusion",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "The temporal interval of a reference to collection, use or disclosure outside Australia is less than or equal to the temporal interval of a reference to collection, use or disclosure within Australia."
    },
