      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.419",
      "skos:note": "Invasion of privacy occurs on the day of first publication.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "19(2) Single publication rule"
      },
      "wasDerivedFrom": "entries-found-privacy-act-1988.pdf",
