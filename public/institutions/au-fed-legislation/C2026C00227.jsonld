    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-36a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual has a right to complain.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Individuals have a right to complain.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRight",
      "cml:premiseText": "An individual may complain to the Commissioner about an act or practice that may be an interference with the privacy of the individual."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-36a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner must investigate the complaint.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner must investigate complaints.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustInvestigate",
      "cml:premiseText": "If a complaint is made, the Commissioner is required to investigate the act or practice except in certain circumstances."
    },
