    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2",
      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.76",
      "skos:note": "Individual must pay overdue payment after notice and recovery attempts.",
      "skos:prefLabel": {
