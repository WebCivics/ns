    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-10-ss-4-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The period during which the agency was responsible for the record.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for agency's responsibility",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "contains",
      "cml:premiseText": "Agency that placed the record in care or custody."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-10-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the agency is responsible for the record, then it holds the record.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Agency's responsibility implies its holding the record",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The agency by or on behalf of which the record was placed in that care or custody."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-10-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the agency is responsible for the record, then it holds the record (cognitive AI).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Agency's responsibility implies its holding the record (cognitive AI)",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The agency by or on behalf of which the record was placed in that care or custody."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-10-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The agency that holds the record.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
