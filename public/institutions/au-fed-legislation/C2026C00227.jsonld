      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person in possession or control of a record with tax file number information is regarded as a file number recipient during the existence of the record.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
