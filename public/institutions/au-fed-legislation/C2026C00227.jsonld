    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1",
      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.248",
      "skos:note": "Disclosing personal information without consent is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "26XC(1) Disclosure of information—offence"
      },
      "wasDerivedFrom": "entries-found-privacy-act-1988.pdf",
      "asserts": [
        "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-norm",
        "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-deontic-1",
