    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-80td-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision is subject to investigation under Part 3 of the Regulatory Powers Act during the specified period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Investigation powers apply during specified periods",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Part 3 of the Regulatory Powers Act creates a framework for investigating whether a provision has been contravened."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-80td-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision is subject to investigation under Part 3 of the Regulatory Powers Act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Investigation powers apply to specified provisions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "Part 3 of the Regulatory Powers Act creates a framework for investigating whether a provision has been contravened."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-80td-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision is subject to investigation under Part 3 of the Regulatory Powers Act if it relates to an offence provision in this Act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Provisions are subject to investigation if they relate to an offence provision in this Act",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The provision is subject to investigation under Part 3 of the Regulatory Powers Act if it is an offence provision, or a civil penalty provision, in this Act."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-80td-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision is subject to investigation under Part 3 of the Regulatory Powers Act if it relates to a civil penalty provision enforceable by the Commissioner under the Digital ID Act 2024.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Provisions are subject to investigation if they relate to a civil penalty provision enforceable by the Commissioner under the Digital ID Act 2024",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The provision is subject to investigation under Part 3 of the Regulatory Powers Act if it is any of the following: (i) a civil penalty provision that is enforceable by the Commissioner under the Digital ID Act 2024;"
    },
    {
