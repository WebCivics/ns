    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual must pay the overdue payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must pay overdue payment",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) the provider has given the individual written notice of the borrower’s default that gave rise to the individual’s obligation to make the overdue payment; and (b) the notice requests that the individual pay the amount of the overdue payment;"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual must pay the overdue payment after recovery attempts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must pay overdue payment after recovery attempts",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(d) in addition to giving the notice, the provider has taken other steps to recover the amount of the overdue payment from the individual; and (e) the provider is not prevented by a statute of limitations from recovering the amount of the overdue payment."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual must pay the overdue payment after notice and recovery attempts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must pay overdue payment after notice and recovery attempts",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) the provider has given the individual written notice of the borrower’s default that gave rise to the individual’s obligation to make the overdue payment; and (b) the notice requests that the individual pay the amount of the overdue payment;"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provider can recover the overdue payment.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Can recover overdue payment",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "CAN",
      "cml:premiseText": "(e) the provider is not prevented by a statute of limitations from recovering the amount of the overdue payment."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provider takes recurring recovery attempts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring recovery attempts",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RECURSIVE",
      "cml:premiseText": "(d) in addition to giving the notice, the provider has taken other steps to recover the amount of the overdue payment from the individual;"
    },
