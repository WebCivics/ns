    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1",
      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.313",
      "skos:note": "Refusal to provide information or answer questions under the Act is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "66(1) Failure to give information etc."
      },
      "wasDerivedFrom": "entries-found-privacy-act-1988.pdf",
      "asserts": [
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-norm",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-logic-deontic-1",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-logic-deontic-2"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "681dad3ece0d13d2c0dda3f6ea82d02d29274471bf342cf0ac7b61ad839090c5",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:entries-found-privacy-act-1988#sch-2-sec-66-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:entries-found-privacy-act-1988-sch-2-sec-66"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person contravenes subsection (1) if the person refuses or fails to do so.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of refusal to provide information or answer questions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The person is required to give information, answer a question, or produce a document or record under this Act."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if the person is a corporation and engages in conduct that constitutes a system of conduct or a pattern of behaviour.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of refusal to provide information or answer questions for corporations.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1AA) A person commits an offence if: the person is a corporation; and the person engages in conduct that constitutes a system of conduct or a pattern of behaviour; and the system of conduct or pattern of behaviour results in 2 or more contraventions of subsection (1)."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-norm",
