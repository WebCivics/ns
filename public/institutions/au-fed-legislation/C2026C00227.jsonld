      "cml:integrityHash": "0a46482c824c70284be59f998f60276a0e5e5f79ee7e2477f1da32a6009b393e",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:entries-found-privacy-act-1988#sch-2-sec-26wf-ss-1",
