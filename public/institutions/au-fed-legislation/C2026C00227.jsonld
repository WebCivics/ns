      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is journalistic material during the specified conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
