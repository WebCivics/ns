      },
      "cml:operator": "Knowledge Representation",
      "cml:premiseText": "Each trustee of the trust is a legal person."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-98c-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Each trustee of a trust is liable for contravening a civil penalty provision.",
