    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6g-ss-1-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the organisation or operator carries on a business or undertaking that involves providing credit;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Specifies the temporal relationship between the provision of credit and the carrying on of a business or undertaking.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(ii) a substantial part of the business or undertaking is the provision of credit;"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6g-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "that is prescribed by the regulations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Specifies that an agency, organisation or small business operator must be prescribed by the regulations to be considered a credit provider.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(d) an agency, organisation or small business operator:  (i) that carries on a business or undertaking that involves providing credit;"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-6g-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "that, in the course of the business, issues credit cards to individuals in connection with the sale of goods, or the supply of services, by the organisation or operator (as the case may be);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
