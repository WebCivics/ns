    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a",
      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.313",
      "skos:note": "Journalist has a reasonable excuse to withhold information.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "66(1A) Failure to give information etc."
      },
      "wasDerivedFrom": "entries-found-privacy-act-1988.pdf",
      "asserts": [
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-norm",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-deontic-1",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-epistemic-2",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-ltl-3",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-argumentation-4",
        "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-alleninterval-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "b041c707be0d52224e1adfc95d1e5b05b992eedf4d170ca20b4aff9aec6fb2c8",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:entries-found-privacy-act-1988#sch-2-sec-66-ss-1a",
      "cml:schemaVersion": "2",
      "partOf": "concept:entries-found-privacy-act-1988-sch-2-sec-66"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The overlap is significant",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between information withholding and identity revelation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The temporal overlap between the two events is relevant to the journalist's excuse"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The implication holds",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of withholding information",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "Withholding information implies the journalist has a reasonable excuse"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Journalist is excused from providing information",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to provide information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "State has a duty to provide information"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Journalist's belief is justified",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "Journalist believes they have a reasonable excuse",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Belief",
      "cml:premiseText": "Journalist has reason to believe they can withhold information without revealing identities"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Information will not be provided until the identity is revealed",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Information withholding until identity revealed",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "Information will be withheld until the journalist reveals the identity of the informant"
    },
