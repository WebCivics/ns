      "cml:logicSummary": "Specifies the relationship between the provision of credit and the carrying on of a retail business.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=>",
      "cml:premiseText": "(c) an organisation or small business operator:  (i) that carries on a retail business;"
    },
