      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "4c2fdf2f3ebaacbfd31f71e0e6293bac0708f73fff90ef8a93881b1e324d5e9c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:entries-found-privacy-act-1988#sch-2-sec-26xc-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:entries-found-privacy-act-1988-sch-2-sec-26xc"
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: 60 penalty units or imprisonment for 1 year, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Discovers overlap between disclosure and subsequent disclosure.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(a) personal information that relates to an individual is disclosed to the first person because of the operation of this Division; and  (b) the first person subsequently discloses the personal information."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: 60 penalty units or imprisonment for 1 year, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of personal information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A person (the first person) commits an offence if:  (a) personal information that relates to an individual is disclosed to the first person because of the operation of this Division; and  (b) the first person subsequently discloses the personal information."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: 60 penalty units or imprisonment for 1 year, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits subsequent disclosure of personal information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) the first person subsequently discloses the personal information."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: 60 penalty units or imprisonment for 1 year, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Traces disclosure of personal information over time.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Trace",
      "cml:premiseText": "(1) A person (the first person) commits an offence if:  (a) personal information that relates to an individual is disclosed to the first person because of the operation of this Division; and  (b) the first person subsequently discloses the personal information."
    },
