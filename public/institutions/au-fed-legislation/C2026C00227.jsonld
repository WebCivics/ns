    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1",
      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.419",
      "skos:note": "Prohibits subsequent publication of substantially the same information in a materially different manner.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "19(1) Single publication rule"
      },
      "wasDerivedFrom": "entries-found-privacy-act-1988.pdf",
      "asserts": [
        "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-norm",
        "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-deontic-1",
        "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-alleninterval-2",
