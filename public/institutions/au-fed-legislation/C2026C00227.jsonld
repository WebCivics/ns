      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Relation",
      "cml:premiseText": "The trust exists before the civil penalty provision."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-98c-ss-3-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Each trustee of a trust is liable for contravening a civil penalty provision if the trust would contravene it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Trustee is liable for contravening a civil penalty provision if the trust would contravene it.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If the trust would contravene a civil penalty provision, then each trustee of the trust is liable for contravening that provision."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-98c-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The trustee is a NaturalPerson.",
