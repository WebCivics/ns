      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(1) The operation of this Part is not limited by a secrecy provision of any other Commonwealth law (whether made before or after the commencement of this Act) except to the extent that the secrecy provision expressly excludes the operation of this section."
