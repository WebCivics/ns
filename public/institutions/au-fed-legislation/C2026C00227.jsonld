    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The invasion of privacy occurs between the first and subsequent publications.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The invasion of privacy occurs between the first and subsequent publications.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:premiseText": "(2) If an invasion of the individual’s privacy consists of the first publication or the subsequent publication, the invasion of privacy is taken to occur on the day of the first publication for the purposes of this Schedule."
    },
    {
