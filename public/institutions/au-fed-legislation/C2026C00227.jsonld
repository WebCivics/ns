      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.94",
      "skos:note": "Agency responsible for record is determined by agency that placed it in care or custody.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "10(4) Agencies that are taken to hold a record"
