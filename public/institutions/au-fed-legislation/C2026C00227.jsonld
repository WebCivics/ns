    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-26n-ss-2",
      "@type": "cml:Concept",
      "dc:source": "entries-found-privacy-act-1988.pdf, p.212",
      "skos:note": "A CR code must set out how to apply Part IIIA provisions and make provision for matters required or permitted by Part IIIA.",
