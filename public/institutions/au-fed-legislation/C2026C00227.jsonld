      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the entity must take such steps as are reasonable in the circumstances to destroy the information or to ensure that the information is de-identified within a reasonable time period",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
