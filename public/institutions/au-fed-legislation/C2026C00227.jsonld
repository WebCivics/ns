    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The subsequent publication overlaps with the first publication in terms of time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for 'subsequent publication' based on the definition of 'materially different'.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "(c) the manner of the subsequent publication is not materially different from the manner of the first publication."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The CogAI recognizes that the subsequent publication is materially different from the first publication.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Defines a relationship between 'subsequent publication' and 'materially different'.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:premiseText": "(c) the manner of the subsequent publication is not materially different from the manner of the first publication."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) This clause applies if:  (a) a publisher publishes information that relates to an individual to the public (the first publication); and  (b) the publisher or an associate of the publisher subsequently publishes (whether or not to the public) information that is substantially the same (the subsequent publication); and  (c) the manner of the subsequent publication is not materially different from the manner of the first publication.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits subsequent publication of substantially the same information in a materially different manner.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:premiseText": "(a) a publisher publishes information that relates to an individual to the public (the first publication); and (b) the publisher or an associate of the publisher subsequently publishes (whether or not to the public) information that is substantially the same (the subsequent publication); and (c) the manner of the subsequent publication is not materially different from the manner of the first publication."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The subsequent publication diffuses into the first publication.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Defines a relationship between 'subsequent publication' and 'materially different'.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "(c) the manner of the subsequent publication is not materially different from the manner of the first publication."
    },
    {
      "@id": "concept:entries-found-privacy-act-1988-sch-2-sec-19-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The subsequent publication will eventually be materially different from the first publication.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines a temporal relationship for 'subsequent publication' based on the definition of 'materially different'.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "eventually",
      "cml:premiseText": "(c) the manner of the subsequent publication is not materially different from the manner of the first publication."
    },
