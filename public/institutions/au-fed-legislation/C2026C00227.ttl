    <https://ns.webcivics.net/cml/operator> "prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibition on using or disclosing credit information.";
    <https://ns.webcivics.net/cml/premiseText> "(1) If: a person holds or held credit eligibility information about an individual; and the information was disclosed to the person by a credit provider under paragraph 21G(3)(c); the person must not use or disclose the information, or any personal information about the individual derived from that information.";
    <https://ns.webcivics.net/cml/conclusionText> "(1) If: a person holds or held credit eligibility information about an individual; and the information was disclosed to the person by a credit provider under paragraph 21G(3)(c); the person must not use or disclose the information, or any personal information about the individual derived from that information.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/entries-found-privacy-act-1988-sch-2-sec-22e-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/entries-found-privacy-act-1988-sch-2-sec-22e-ss-1-logic-alleninterval-2>.
<https://ns.webcivics.net/concept/entries-found-privacy-act-1988-sch-2-sec-22e-ss-1-logic-alleninterval-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "during";
    <https://ns.webcivics.net/cml/logicSummary> "The prohibition applies to information disclosed under paragraph 21G(3)(c).";
    <https://ns.webcivics.net/cml/premiseText> "(b) the information was disclosed to the person by a credit provider under paragraph 21G(3)(c);";
    <https://ns.webcivics.net/cml/conclusionText> "(b) the information was disclosed to the person by a credit provider under paragraph 21G(3)(c);";
