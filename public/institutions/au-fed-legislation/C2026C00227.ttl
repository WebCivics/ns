    <https://ns.webcivics.net/cml/operator> ">=";
    <https://ns.webcivics.net/cml/logicSummary> "Temporal equivalence";
    <https://ns.webcivics.net/cml/premiseText> "The temporal interval of a reference to collection, use or disclosure outside Australia is greater than or equal to the temporal interval of a reference to collection, use or disclosure within Australia.";
    <https://ns.webcivics.net/cml/conclusionText> "Then it has the same effect as if it were confined within Australia.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
