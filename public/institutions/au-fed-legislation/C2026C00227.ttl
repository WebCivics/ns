<https://ns.webcivics.net/concept/entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "if-then";
    <https://ns.webcivics.net/cml/logicSummary> "Conditional obligation";
    <https://ns.webcivics.net/cml/premiseText> "If a reference to collection, use or disclosure is made outside Australia.";
    <https://ns.webcivics.net/cml/conclusionText> "Then it has the same effect as if it were confined within Australia.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
