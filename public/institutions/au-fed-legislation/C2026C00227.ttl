    <https://ns.webcivics.net/cml/operator> "MUST";
    <https://ns.webcivics.net/cml/logicSummary> "Must pay overdue payment after notice and recovery attempts";
    <https://ns.webcivics.net/cml/premiseText> "(a) the provider has given the individual written notice of the borrower’s default that gave rise to the individual’s obligation to make the overdue payment; and (b) the notice requests that the individual pay the amount of the overdue payment;";
    <https://ns.webcivics.net/cml/conclusionText> "The individual must pay the overdue payment after notice and recovery attempts.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
