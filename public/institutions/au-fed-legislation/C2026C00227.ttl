<https://ns.webcivics.net/concept/entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-ltl-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/LTL>;
    <https://ns.webcivics.net/cml/operator> "<=";
    <https://ns.webcivics.net/cml/logicSummary> "Temporal inclusion";
    <https://ns.webcivics.net/cml/premiseText> "The temporal interval of a reference to collection, use or disclosure outside Australia is less than or equal to the temporal interval of a reference to collection, use or disclosure within Australia.";
    <https://ns.webcivics.net/cml/conclusionText> "Then it has the same effect as if it were confined within Australia.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
