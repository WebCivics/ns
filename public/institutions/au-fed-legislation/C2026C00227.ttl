<https://ns.webcivics.net/concept/entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-diffusion-4> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Diffusion>;
    <https://ns.webcivics.net/cml/operator> "⊆";
    <https://ns.webcivics.net/cml/logicSummary> "Set inclusion";
    <https://ns.webcivics.net/cml/premiseText> "The set of collections, uses or disclosures outside Australia is a subset of the set of collections, uses or disclosures within Australia.";
    <https://ns.webcivics.net/cml/conclusionText> "Then it has the same effect as if it were confined within Australia.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::diffusion";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
