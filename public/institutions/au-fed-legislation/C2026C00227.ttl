    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/LTL>;
    <https://ns.webcivics.net/cml/operator> "RECURSIVE";
    <https://ns.webcivics.net/cml/logicSummary> "Recurring recovery attempts";
    <https://ns.webcivics.net/cml/premiseText> "(d) in addition to giving the notice, the provider has taken other steps to recover the amount of the overdue payment from the individual;";
    <https://ns.webcivics.net/cml/conclusionText> "The provider takes recurring recovery attempts.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
