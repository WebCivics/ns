    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Epistemic>;
    <https://ns.webcivics.net/cml/operator> "CAN";
    <https://ns.webcivics.net/cml/logicSummary> "Can recover overdue payment";
    <https://ns.webcivics.net/cml/premiseText> "(e) the provider is not prevented by a statute of limitations from recovering the amount of the overdue payment.";
    <https://ns.webcivics.net/cml/conclusionText> "The provider can recover the overdue payment.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::epistemic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
