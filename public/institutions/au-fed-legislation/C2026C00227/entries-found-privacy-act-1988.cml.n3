doc:sch-2-sec-20c a cof:Section ;
    cof:title "20C Collection of solicited credit information" ;
    values:kind "section" ;
    values:originalText "Prohibition on collection  (1) A credit reporting body must not collect credit information about an individual. Civil penalty: 2,000 penalty units." ;
