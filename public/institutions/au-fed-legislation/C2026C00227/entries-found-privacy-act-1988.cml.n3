concept:entries-found-privacy-act-1988-sch-2-sec-80uc-ss-6 a cml:Concept ;
    skos:prefLabel "80UC(6) Compliance notices"@en ;
    cml:realizedBy doc:sch-2-sec-80uc-ss-6 ;
