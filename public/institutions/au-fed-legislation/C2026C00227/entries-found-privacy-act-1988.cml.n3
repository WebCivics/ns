concept:entries-found-privacy-act-1988-sch-2-sec-21r a cml:Concept ;
    skos:prefLabel "21R False or misleading credit information or credit eligibility"@en ;
    cml:realizedBy doc:sch-2-sec-21r ;
    values:originalText "information Offences  (1) A credit provider commits an offence if:  (a) the provider discloses credit information under section 21D; and  (b) the information is false or misleading in a material particular. Penalty: 200 penalty units.  (2) A credit provider commits an offence if:  (a) the provider uses or discloses credit eligibility information under this Division; and  (b) the information is false or misleading in a material particular. Penalty: 200 penalty units. Civil penalties  (3) A credit provider must not disclose credit information under section 21D if the information is false or misleading in a material particular. Civil penalty: 2,000 penalty units.  (4) A credit provider must not use or disclose credit eligibility information under this Division if the information is false or misleading in a material particular. Civil penalty: 2,000 penalty units." ;
    skos:definition "information Offences  (1) A credit provider commits an offence if:  (a) the provider discloses credit information under section 21D; and  (b) the information is false or misleading in a material particular. Penalty: 200 penalty units.  (2) A credit provider commits an offence if:  (a) the provider uses or discloses credit eligibility information under this Division; and  (b) the information is false or misleading in a material particular. Penalty: 200 penalty units. Civil penalties  (3) A credit provider must not disclose credit information under section 21D if the information is false or misleading in a material particular. Civil penalty: 2,000 penalty units.  (4) A credit provider must not use or disclose credit eligibility information under this Division if the information is false or misleading in a material particular. Civil penalty: 2,000 penalty units."@en ;
    cml:integrityHash "2a32c4858bcefb41334c60838c90110ad14dafea734e39e626f59f3cd2884afe" ;
    cof:pageNumber "170"^^xsd:integer ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-21r-ss-1 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-21r-ss-2 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-21r-ss-3 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-21r-ss-4 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.170" .
doc:sch-2-sec-21r a cof:Section ;
