doc:sch-2-sec-6l-ss-2 a cof:Section ;
    cof:title "6L(2) Meaning of access seeker" ;
    values:kind "subsection" ;
    values:originalText "(2) An individual must not authorise a person under subparagraph (1)(b)(ii) if the person is:  (a) a credit provider; or  (b) a mortgage insurer; or  (c) a trade insurer; or  (d) a person who is prevented from being a credit provider by subsection 6G(5) or (6)." ;
    cof:pageNumber "73"^^xsd:integer .

