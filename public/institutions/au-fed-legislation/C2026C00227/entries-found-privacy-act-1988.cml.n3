    cof:pageNumber "354"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-80ud a cml:Concept ;
    skos:prefLabel "80UD Review of compliance notices"@en ;
    cml:realizedBy doc:sch-2-sec-80ud ;
    values:originalText "(1) An entity that has been given a notice under subsection 80UC(1) may apply to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) for a review of the notice on either or both of the following grounds:  (a) the entity has not committed the contravention set out in the notice;   Compliance and enforcement  Part VIB Compliance notices  Division 1B  Section 80UD  Privacy Act 1988  Compilation date: 04/06/2026  (b) the notice does not comply with subsection 80UC(2).  (2) At any time after the application has been made, the court may stay the operation of the notice on the terms and conditions that the court considers appropriate.  (3) The court may confirm, cancel or vary the notice after reviewing it." ;
    skos:definition "(1) An entity that has been given a notice under subsection 80UC(1) may apply to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) for a review of the notice on either or both of the following grounds:  (a) the entity has not committed the contravention set out in the notice;   Compliance and enforcement  Part VIB Compliance notices  Division 1B  Section 80UD  Privacy Act 1988  Compilation date: 04/06/2026  (b) the notice does not comply with subsection 80UC(2).  (2) At any time after the application has been made, the court may stay the operation of the notice on the terms and conditions that the court considers appropriate.  (3) The court may confirm, cancel or vary the notice after reviewing it."@en ;
    cml:integrityHash "f9c25c6c594018ef7e656335468a567b560f3fbdc18abb39b8e2e86dd7ee131a" ;
    cof:pageNumber "356"^^xsd:integer ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-80ud-ss-1 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-80ud-ss-2 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-80ud-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.356" .
