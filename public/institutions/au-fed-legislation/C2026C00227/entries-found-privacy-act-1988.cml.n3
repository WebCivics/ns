concept:entries-found-privacy-act-1988-sch-2-sec-26wp-ss-5 a cml:Concept ;
    skos:prefLabel "26WP(5) Exception—inconsistency with secrecy provisions"@en ;
    cml:realizedBy doc:sch-2-sec-26wp-ss-5 ;
    values:originalText "(5) For the purposes of a prescribed secrecy provision:  (a) subparagraph 26WK(2)(a)(ii); and  (b) section 26WL; are taken not to be provisions that require or authorise the use or disclosure of information." ;
    skos:definition "(5) For the purposes of a prescribed secrecy provision:  (a) subparagraph 26WK(2)(a)(ii); and  (b) section 26WL; are taken not to be provisions that require or authorise the use or disclosure of information."@en ;
    cml:integrityHash "8ed26b71a50df1e9bf70cc0adf4b4935b8166574460a3d57cd669d20e5df7761" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-26wp ;
    cof:pageNumber "233"^^xsd:integer ;
    skos:note "Exempts certain provisions from secrecy requirements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
