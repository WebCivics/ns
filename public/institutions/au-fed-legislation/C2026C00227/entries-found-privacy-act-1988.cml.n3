concept:entries-found-privacy-act-1988-sch-2-sec-12b-ss-5a a cml:Concept ;
    skos:prefLabel "12B(5A) Severability—additional effect of this Act"@en ;
    cml:realizedBy doc:sch-2-sec-12b-ss-5a ;
    values:originalText "(5A) This Act also has the effect it would have if its operation in relation to regulated entities were expressly confined to acts or practices engaged in by regulated entities in the course of:  (a) banking (other than State banking not extending beyond the limits of the State concerned); or  (b) insurance (other than State insurance not extending beyond the limits of the State concerned)." ;
    skos:definition "(5A) This Act also has the effect it would have if its operation in relation to regulated entities were expressly confined to acts or practices engaged in by regulated entities in the course of:  (a) banking (other than State banking not extending beyond the limits of the State concerned); or  (b) insurance (other than State insurance not extending beyond the limits of the State concerned)."@en ;
    cml:integrityHash "16a3894a393b95218a7cbce7d11804e82fe29cf3e8c77c9a3a1133865047929c" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-12b ;
    cof:pageNumber "96"^^xsd:integer ;
    skos:note "Regulated entities must comply with the Act's operation in relation to their acts or practices." ;
    cml:curationStatus cml:Proposed ;
