concept:entries-found-privacy-act-1988-sch-2-sec-22a-ss-6 a cml:Concept ;
    skos:prefLabel "22A(6) Open and transparent management of regulated information"@en ;
    cml:realizedBy doc:sch-2-sec-22a-ss-6 ;
    values:originalText "(6) If a person or body requests a copy, in a particular form, of the policy of an affected information recipient, the recipient must take such steps as are reasonable in the circumstances to give the person or body a copy in that form." ;
    skos:definition "(6) If a person or body requests a copy, in a particular form, of the policy of an affected information recipient, the recipient must take such steps as are reasonable in the circumstances to give the person or body a copy in that form."@en ;
    cml:integrityHash "04484781b9ffbf418f1110bfd99aa5165c97d75cce45303d977932e0b14a7d74" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-22a ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Recipient must provide a copy of requested policy in a particular form." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
