concept:entries-found-privacy-act-1988-sch-2-sec-50a-ss-3 a cml:Concept ;
    skos:prefLabel "50A(3) Substitution of respondent to complaint"@en ;
    cml:realizedBy doc:sch-2-sec-50a-ss-3 ;
    values:originalText "(3) Before amending the complaint, the Commissioner must:  (a) give the agency a notice stating that the Commissioner proposes to amend the complaint and stating the reasons for the proposal; and  (b) give the agency an opportunity to appear before the Commissioner and to make oral and/or written submissions relating to the proposed amendment." ;
    skos:definition "(3) Before amending the complaint, the Commissioner must:  (a) give the agency a notice stating that the Commissioner proposes to amend the complaint and stating the reasons for the proposal; and  (b) give the agency an opportunity to appear before the Commissioner and to make oral and/or written submissions relating to the proposed amendment."@en ;
    cml:integrityHash "58d2d77a4b784ce07cac6a8a62a67d17c9bfd9a972c4153ec6ce46e6079bc8d2" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-50a ;
    cof:pageNumber "296"^^xsd:integer ;
