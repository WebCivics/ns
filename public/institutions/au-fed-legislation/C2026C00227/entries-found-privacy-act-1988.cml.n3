concept:entries-found-privacy-act-1988-sch-1-sec-6-8 a cml:Concept ;
    skos:prefLabel "6 Section 6"@en ;
    cml:realizedBy doc:sch-1-sec-6-8 ;
    values:originalText "7 This principle does not apply to the use or disclosure by an organisation of:  (a) personal information for the purpose of direct marketing; or  (b) government related identifiers." ;
    skos:definition "7 This principle does not apply to the use or disclosure by an organisation of:  (a) personal information for the purpose of direct marketing; or  (b) government related identifiers."@en ;
