concept:entries-found-privacy-act-1988-sch-2-sec-22a-ss-3 a cml:Concept ;
    skos:prefLabel "22A(3) Open and transparent management of regulated information"@en ;
    cml:realizedBy doc:sch-2-sec-22a-ss-3 ;
    values:originalText "(3) An affected information recipient must have a clearly expressed and up-to-date policy about the recipient’s management of the regulated information of the recipient." ;
    skos:definition "(3) An affected information recipient must have a clearly expressed and up-to-date policy about the recipient’s management of the regulated information of the recipient."@en ;
