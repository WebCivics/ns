    cof:pageNumber "384"^^xsd:integer ;
    skos:note "Determine whether the entity could have collected information under Australian Privacy Principle 3 if solicited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
