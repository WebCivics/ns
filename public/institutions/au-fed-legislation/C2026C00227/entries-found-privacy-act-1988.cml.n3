concept:entries-found-privacy-act-1988-sch-2-sec-67 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-67-logic-alleninterval-2 .
concept:entries-found-privacy-act-1988-sch-2-sec-67-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Temporal overlap between good faith and civil action" ;
    cml:premiseText "Good faith acts must occur before or at the same time as the civil action" ;
    cml:conclusionText "The temporal overlap is necessary for protection from civil actions" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-67 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-67-logic-ltl-3 .
