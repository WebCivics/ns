    cml:operator "Propagation" ;
    cml:logicSummary "Describes how the obligation is propagated through the APP entity's operations." ;
    cml:premiseText "The APP entity has a duty to protect personal information." ;
    cml:conclusionText "Therefore, the APP entity must not use or disclose the information for a secondary purpose." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-1-sec-6-2 cml:asserts concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-cogai-5 .
concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Inference" ;
    cml:logicSummary "Describes how the obligation is inferred from the APP entity's knowledge." ;
    cml:premiseText "The APP entity has knowledge of its obligations regarding personal information." ;
    cml:conclusionText "Therefore, the APP entity must not use or disclose the information for a secondary purpose." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-6-2 a cof:Section ;
    cof:title "6 1 If an APP entity holds personal information about an individual" ;
    values:kind "section" ;
    values:originalText "that was collected for a particular purpose (the primary purpose), the entity must not use or disclose the information for another purpose (the secondary purpose) unless:  (a) the individual has consented to the use or disclosure of the information; or  (b) subclause 6.2 or 6.3 applies in relation to the use or disclosure of the information. Note: Australian Privacy Principle 8 sets out requirements for the disclosure of personal information to a person who is not in Australia or an external Territory." ;
    cof:pageNumber "387"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-1-sec-6-3 a cml:Concept ;
    skos:prefLabel "6 2 This subclause applies in relation to the use or disclosure of"@en ;
    cml:realizedBy doc:sch-1-sec-6-3 ;
    values:originalText "personal information about an individual if:  (a) the individual would reasonably expect the APP entity to use or disclose the information for the secondary purpose and the secondary purpose is:  (i) if the information is sensitive information—directly related to the primary purpose; or  (ii) if the information is not sensitive information—related to the primary purpose; or  (b) the use or disclosure of the information is required or authorised by or under an Australian law or a court/tribunal order; or  (c) a permitted general situation exists in relation to the use or disclosure of the information by the APP entity; or  Schedule 1  Australian Privacy Principles" ;
    skos:definition "personal information about an individual if:  (a) the individual would reasonably expect the APP entity to use or disclose the information for the secondary purpose and the secondary purpose is:  (i) if the information is sensitive information—directly related to the primary purpose; or  (ii) if the information is not sensitive information—related to the primary purpose; or  (b) the use or disclosure of the information is required or authorised by or under an Australian law or a court/tribunal order; or  (c) a permitted general situation exists in relation to the use or disclosure of the information by the APP entity; or  Schedule 1  Australian Privacy Principles"@en ;
    cml:integrityHash "2c7681ba78dbfd9f43116211be1d3f1c375bc8ce963195b436340479ac0832b5" ;
    cof:pageNumber "387"^^xsd:integer ;
    skos:note "Use or disclose personal information for secondary purpose if individual expects it, or required by law or court order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
