concept:entries-found-privacy-act-1988-sch-2-sec-95c a cml:Concept ;
    skos:prefLabel "95C Disclosure of certain provisions of Commonwealth contracts"@en ;
    cml:realizedBy doc:sch-2-sec-95c ;
    values:originalText "If a person asks a party to a Commonwealth contract to be informed of the content of provisions (if any) of the contract that are inconsistent with a registered APP code binding a party to the contract or with an Australian Privacy Principle, the party requested must inform the person in writing of that content (if any)." ;
    skos:definition "If a person asks a party to a Commonwealth contract to be informed of the content of provisions (if any) of the contract that are inconsistent with a registered APP code binding a party to the contract or with an Australian Privacy Principle, the party requested must inform the person in writing of that content (if any)."@en ;
    cml:integrityHash "c180fad365ade95e964a99df99a476b36439b33a73a70c528a442d0d0a11c11c" ;
    cof:pageNumber "369"^^xsd:integer ;
    skos:note "Party must inform person of inconsistent contract provisions." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.369" ;
