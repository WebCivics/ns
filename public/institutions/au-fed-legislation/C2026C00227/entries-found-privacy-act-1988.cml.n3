doc:sch-2-sec-65-ss-2 a cof:Section ;
    cof:title "65(2) Failure to attend etc. before Commissioner" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply if the person has a reasonable excuse. Note: A defendant bears an evidential burden in relation to the matter in subsection (2) (see subsection 13.3(3) of the Criminal Code)." ;
    cof:pageNumber "312"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-65-ss-3 a cml:Concept ;
    skos:prefLabel "65(3) Failure to attend etc. before Commissioner"@en ;
    cml:realizedBy doc:sch-2-sec-65-ss-3 ;
    values:originalText "(3) A person shall not furnish information or make a statement to the Commissioner knowing that it is false or misleading in a material particular. Penalty for a contravention of this subsection: Imprisonment for 12 months or 20 penalty units, or both.   Investigations etc.  Part V Miscellaneous  Division 5  Section 66  Privacy Act 1988  Compilation date: 04/06/2026  66  Failure to give information etc. Basic contravention" ;
    skos:definition "(3) A person shall not furnish information or make a statement to the Commissioner knowing that it is false or misleading in a material particular. Penalty for a contravention of this subsection: Imprisonment for 12 months or 20 penalty units, or both.   Investigations etc.  Part V Miscellaneous  Division 5  Section 66  Privacy Act 1988  Compilation date: 04/06/2026  66  Failure to give information etc. Basic contravention"@en ;
    cml:integrityHash "86b30539765794efc7ab7038b48ae292022a071f65a1070968b0be316ad702ed" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-65 ;
    cof:pageNumber "312"^^xsd:integer ;
    skos:note "Furnishing false or misleading information to the Commissioner is prohibited." ;
