concept:entries-found-privacy-act-1988-sch-1-sec-12-10 a cml:Concept ;
    skos:prefLabel "12 Section 12"@en ;
    cml:realizedBy doc:sch-1-sec-12-10 ;
    values:originalText "9 If the APP entity refuses to give access to the personal information because of subclause 12.2 or 12.3, or to give access in the manner requested by the individual, the entity must give the individual a written notice that sets out:  (a) the reasons for the refusal except to the extent that, having regard to the grounds for the refusal, it would be unreasonable to do so; and  (b) the mechanisms available to complain about the refusal; and  (c) any other matter prescribed by the regulations.  Australian Privacy Principles  Schedule 1 Access to, and correction of, personal information  Part 5  Clause 13  Privacy Act 1988  Compilation date: 04/06/2026" ;
    skos:definition "9 If the APP entity refuses to give access to the personal information because of subclause 12.2 or 12.3, or to give access in the manner requested by the individual, the entity must give the individual a written notice that sets out:  (a) the reasons for the refusal except to the extent that, having regard to the grounds for the refusal, it would be unreasonable to do so; and  (b) the mechanisms available to complain about the refusal; and  (c) any other matter prescribed by the regulations.  Australian Privacy Principles  Schedule 1 Access to, and correction of, personal information  Part 5  Clause 13  Privacy Act 1988  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "c1d7ee63ab385c904198f8c0d9eab32262ba8d466b978bd31ed03d263fdfb440" ;
    cof:pageNumber "400"^^xsd:integer ;
    skos:note "Entity must provide written notice to individual if access to personal information is refused" ;
    dc:description "written notice with reasons for refusal, mechanisms for complaint, and other prescribed matters" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.400" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-1-sec-12-10-norm .
