doc:sch-2-sec-80uc-ss-4 a cof:Section ;
    cof:title "80UC(4) Compliance notices" ;
    values:kind "subsection" ;
    values:originalText "(4) An entity contravenes this subsection if:  (a) the entity is given a notice under subsection (1); and  (b) the entity fails to comply with the notice." ;
    cof:pageNumber "354"^^xsd:integer .

