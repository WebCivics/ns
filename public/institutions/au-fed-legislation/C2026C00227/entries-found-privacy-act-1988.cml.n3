concept:entries-found-privacy-act-1988-sch-2-sec-96 a cml:Concept ;
    skos:prefLabel "96 Review by the Administrative Review Tribunal"@en ;
    cml:realizedBy doc:sch-2-sec-96 ;
    values:originalText "(1) An application may be made to the Administrative Review Tribunal for review of the following decisions of the Commissioner:  (a) a decision under subsection 26H(1) not to register an APP code developed by an APP code developer;" ;
    skos:definition "(1) An application may be made to the Administrative Review Tribunal for review of the following decisions of the Commissioner:  (a) a decision under subsection 26H(1) not to register an APP code developed by an APP code developer;"@en ;
