concept:entries-found-privacy-act-1988-sch-2-sec-51 a cml:Concept ;
    skos:prefLabel "51 Effect of investigation by Auditor-General"@en ;
    cml:realizedBy doc:sch-2-sec-51 ;
    values:originalText "Where the Commissioner becomes aware that a matter being investigated by the Commissioner is, or is related to, a matter that is under investigation by the Auditor-General, the Commissioner shall not, unless the Commissioner and Auditor-General agree to the contrary, continue to investigate the matter until the investigation by the Auditor-General has been completed." ;
    skos:definition "Where the Commissioner becomes aware that a matter being investigated by the Commissioner is, or is related to, a matter that is under investigation by the Auditor-General, the Commissioner shall not, unless the Commissioner and Auditor-General agree to the contrary, continue to investigate the matter until the investigation by the Auditor-General has been completed."@en ;
    cml:integrityHash "dd1f7326d88eaf85423626d9300cfb2cb6533b20687682d13ed80c84691f4cd5" ;
    cof:pageNumber "297"^^xsd:integer ;
    skos:note "Commissioner must stop investigation if Auditor-General is investigating the same matter." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.297" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-51-norm .
