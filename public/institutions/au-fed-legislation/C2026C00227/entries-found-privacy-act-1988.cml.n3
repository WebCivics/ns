concept:entries-found-privacy-act-1988-sch-1-sec-3-4 a cml:Concept ;
    skos:prefLabel "3 3 An APP entity must not collect sensitive information about an"@en ;
    cml:realizedBy doc:sch-1-sec-3-4 ;
    values:originalText "individual unless:  (a) the individual consents to the collection of the information and:  (i) if the entity is an agency—the information is reasonably necessary for, or directly related to, one or more of the entity’s functions or activities; or  (ii) if the entity is an organisation—the information is reasonably necessary for one or more of the entity’s functions or activities; or  (b) subclause 3.4 applies in relation to the information." ;
    skos:definition "individual unless:  (a) the individual consents to the collection of the information and:  (i) if the entity is an agency—the information is reasonably necessary for, or directly related to, one or more of the entity’s functions or activities; or  (ii) if the entity is an organisation—the information is reasonably necessary for one or more of the entity’s functions or activities; or  (b) subclause 3.4 applies in relation to the information."@en ;
    cml:integrityHash "1fc248666ada30192d15a084d99184873d3351eb42e1e993a770fe379998d8a4" ;
    cof:pageNumber "382"^^xsd:integer ;
    skos:note "An APP entity must not collect sensitive information about an individual unless certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
