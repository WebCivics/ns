    cml:modality cml:Deontic ;
    cml:operator "Must Not" ;
    cml:logicSummary "Prohibition of collecting sensitive information" ;
    cml:premiseText "The entity must not collect the information." ;
    cml:conclusionText "Unless certain conditions are met, the entity may collect the information." ;
