concept:entries-found-privacy-act-1988-sch-2-sec-26we cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26we-logic-deontic-3 .
concept:entries-found-privacy-act-1988-sch-2-sec-26we-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Conditional duty based on section 20Q" ;
    cml:premiseText "A credit reporting body holds credit reporting information relating to one or more individuals and is required to comply with section 20Q." ;
    cml:conclusionText "The credit reporting body must comply with section 15." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-26we cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26we-logic-deontic-4 .
