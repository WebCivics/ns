concept:entries-found-privacy-act-1988-sch-2-sec-20p a cml:Concept ;
    skos:prefLabel "20P False or misleading credit reporting information"@en ;
    cml:realizedBy doc:sch-2-sec-20p ;
    values:originalText "Offence  (1) A credit reporting body commits an offence if:  (a) the body uses or discloses credit reporting information under this Division (other than subsections 20D(2) and 20T(4)); and  (b) the information is false or misleading in a material particular. Penalty: 200 penalty units. Civil penalty  (2) A credit reporting body must not use or disclose credit reporting information under this Division (other than subsections 20D(2) and 20T(4)) if the information is false or misleading in a material particular. Civil penalty: 2,000 penalty units." ;
    skos:definition "Offence  (1) A credit reporting body commits an offence if:  (a) the body uses or discloses credit reporting information under this Division (other than subsections 20D(2) and 20T(4)); and  (b) the information is false or misleading in a material particular. Penalty: 200 penalty units. Civil penalty  (2) A credit reporting body must not use or disclose credit reporting information under this Division (other than subsections 20D(2) and 20T(4)) if the information is false or misleading in a material particular. Civil penalty: 2,000 penalty units."@en ;
    cml:integrityHash "cd25b8565d4b57e8f856cf50c696d80d49eb0c79087d2888c0de2bddefadce7e" ;
    cof:pageNumber "133"^^xsd:integer ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-20p-ss-1 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-20p-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
