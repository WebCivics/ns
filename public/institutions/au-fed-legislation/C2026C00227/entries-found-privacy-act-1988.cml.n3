doc:sch-2-sec-33a-ss-2 a cof:Section ;
    cof:title "33A(2) Commissioner may share information with other authorities" ;
    values:kind "subsection" ;
    values:originalText "(2) The following bodies are covered by this subsection:  (a) an enforcement body;  (b) an alternative complaint body;  (c) a State or Territory authority, or an authority of the government of a foreign country, that has functions to protect the privacy of individuals (whether or not the authority has other functions)." ;
    cof:pageNumber "262"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-33a-ss-3 a cml:Concept ;
    skos:prefLabel "33A(3) Commissioner may share information with other authorities"@en ;
    cml:realizedBy doc:sch-2-sec-33a-ss-3 ;
    values:originalText "(3) The Commissioner may only share information or documents with a receiving body under this section if:  (a) the information or documents were acquired by the Commissioner in the course of exercising powers, or performing functions or duties, under this Act; and  (b) the Commissioner is satisfied on reasonable grounds that the receiving body has satisfactory arrangements in place for protecting the information or documents." ;
    skos:definition "(3) The Commissioner may only share information or documents with a receiving body under this section if:  (a) the information or documents were acquired by the Commissioner in the course of exercising powers, or performing functions or duties, under this Act; and  (b) the Commissioner is satisfied on reasonable grounds that the receiving body has satisfactory arrangements in place for protecting the information or documents."@en ;
    cml:integrityHash "175b11525fe249d8aff53d0e0672fa5dc0d22dcb44b255c90d5b9b460f88578c" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-33a ;
