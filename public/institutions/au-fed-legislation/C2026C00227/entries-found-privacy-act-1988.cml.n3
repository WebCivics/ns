concept:entries-found-privacy-act-1988-sch-2-sec-91 a cml:Concept ;
    skos:prefLabel "91 Effect of Part on other laws"@en ;
    cml:realizedBy doc:sch-2-sec-91 ;
    values:originalText "This Part does not, except to the extent that it does so expressly or by necessary implication, limit or restrict the operation of any other law or of any principle or rule of the common law or of equity, being a law, principle or rule:  (a) under or by virtue of which an obligation of confidence exists; or   Obligations of confidence  Part VIII  Section 92  Privacy Act 1988  Compilation date: 04/06/2026  (b) that has the effect of restricting or prohibiting, or imposing a liability (including a criminal liability) on a person in respect of, a disclosure or use of information." ;
    skos:definition "This Part does not, except to the extent that it does so expressly or by necessary implication, limit or restrict the operation of any other law or of any principle or rule of the common law or of equity, being a law, principle or rule:  (a) under or by virtue of which an obligation of confidence exists; or   Obligations of confidence  Part VIII  Section 92  Privacy Act 1988  Compilation date: 04/06/2026  (b) that has the effect of restricting or prohibiting, or imposing a liability (including a criminal liability) on a person in respect of, a disclosure or use of information."@en ;
    cml:integrityHash "ecbbe800e9549810ac6a9d6a3ea6c20cab15cddd33bc819ea74fc2fca9240fa5" ;
    cof:pageNumber "364"^^xsd:integer ;
    skos:note "Does not limit or restrict other laws, principles, or rules." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
