doc:sch-2-sec-44-ss-1 a cof:Section ;
    cof:title "44(1) Power to obtain information and documents" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Commissioner has reason to believe that a person has information or a document relevant to an investigation under this Division, the Commissioner may give to the person a written notice requiring the person:  (a) to give the information to the Commissioner in writing signed by the person or, in the case of a body corporate, by an officer of the body corporate; or  (b) to produce the document to the Commissioner. Note: For a failure to give information etc., see section 66." ;
    cof:pageNumber "287"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-44-ss-2 a cml:Concept ;
    skos:prefLabel "44(2) Power to obtain information and documents"@en ;
    cml:realizedBy doc:sch-2-sec-44-ss-2 ;
    values:originalText "(2) A notice given by the Commissioner under subsection (1) shall state:  (a) the place at which the information or document is to be given or produced to the Commissioner; and" ;
    skos:definition "(2) A notice given by the Commissioner under subsection (1) shall state:  (a) the place at which the information or document is to be given or produced to the Commissioner; and"@en ;
    cml:integrityHash "b115ce5f06de86b706eaf0d2928ed7ad5befb7c08390b41d2eb1f3b131a5678a" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-44 ;
    cof:pageNumber "287"^^xsd:integer ;
    skos:note "Notice must state place for information or document production." ;
    dc:description "true" ;
