concept:entries-found-privacy-act-1988-sch-1-sec-12-6 a cml:Concept ;
    skos:prefLabel "12 5 If the APP entity refuses:"@en ;
    cml:realizedBy doc:sch-1-sec-12-6 ;
    values:originalText "(a) to give access to the personal information because of subclause 12.2 or 12.3; or  (b) to give access in the manner requested by the individual; the entity must take such steps (if any) as are reasonable in the circumstances to give access in a way that meets the needs of the entity and the individual." ;
    skos:definition "(a) to give access to the personal information because of subclause 12.2 or 12.3; or  (b) to give access in the manner requested by the individual; the entity must take such steps (if any) as are reasonable in the circumstances to give access in a way that meets the needs of the entity and the individual."@en ;
    cml:integrityHash "9ce954456d8335001e58e6667132abc627a7474554658841fc4e568421f86b16" ;
    cof:pageNumber "400"^^xsd:integer ;
    skos:note "Entity must take reasonable steps to provide access in a way that meets the needs of both the entity and the individual." ;
    dc:description "access to personal information" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
