    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-65 ;
    cof:pageNumber "312"^^xsd:integer ;
    skos:note "Include a record and answer to information in documents. Must provide a reasonable excuse for missing court appearance." ;
    dc:description "Yes" ;
