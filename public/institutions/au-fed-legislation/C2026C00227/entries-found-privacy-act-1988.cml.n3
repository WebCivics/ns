concept:entries-found-privacy-act-1988-sch-2-sec-39 a cml:Concept ;
    skos:prefLabel "39 Class member for representative complaint not entitled to lodge"@en ;
    cml:realizedBy doc:sch-2-sec-39 ;
    values:originalText "individual complaint  A person who is a class member for a representative complaint is not entitled to lodge a complaint in respect of the same subject matter." ;
    skos:definition "individual complaint  A person who is a class member for a representative complaint is not entitled to lodge a complaint in respect of the same subject matter."@en ;
