concept:entries-found-privacy-act-1988-sch-2-sec-29 a cml:Concept ;
    skos:prefLabel "29 Commissioner must have due regard to the objects of the Act"@en ;
    cml:realizedBy doc:sch-2-sec-29 ;
    values:originalText "The Commissioner must have due regard to the objects of this Act in performing the Commissioner’s functions, and exercising the Commissioner’s powers, conferred by this Act. Note: The objects of this Act are set out in section 2A." ;
    skos:definition "The Commissioner must have due regard to the objects of this Act in performing the Commissioner’s functions, and exercising the Commissioner’s powers, conferred by this Act. Note: The objects of this Act are set out in section 2A."@en ;
    cml:integrityHash "192883fcbfe9ed1d68a6a0080de7e9fd9000eaa8abf428e31f539c14f9c2f4f3" ;
