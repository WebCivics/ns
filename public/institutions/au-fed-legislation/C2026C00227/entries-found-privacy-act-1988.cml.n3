doc:sch-2-sec-53a-ss-1 a cof:Section ;
    cof:title "53A(1) Notice to be given to outsourcing agency" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Commissioner makes a determination that applies in relation to a contracted service provider for a Commonwealth contract, the Commissioner:  (a) must give a copy of the determination to each agency:  (i) to which services are or were to be provided under the contract; and   Investigations etc.  Part V Determinations following investigation of complaints  Division 2  Section 53B  Privacy Act 1988  Compilation date: 04/06/2026  (ii) to which the Commissioner considers it appropriate to give a copy; and  (b) may give such an agency a written recommendation of any measures that the Commissioner considers appropriate." ;
    cof:pageNumber "302"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-53a-ss-2 a cml:Concept ;
    skos:prefLabel "53A(2) Notice to be given to outsourcing agency"@en ;
    cml:realizedBy doc:sch-2-sec-53a-ss-2 ;
    values:originalText "(2) The Commissioner may give an agency a recommendation only after consulting the agency." ;
    skos:definition "(2) The Commissioner may give an agency a recommendation only after consulting the agency."@en ;
