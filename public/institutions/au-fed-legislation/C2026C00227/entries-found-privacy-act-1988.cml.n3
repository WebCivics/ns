concept:entries-found-privacy-act-1988-sch-2-sec-26wc-ss-1 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26wc-ss-1-logic-deontic-1 .
concept:entries-found-privacy-act-1988-sch-2-sec-26wc-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
