concept:entries-found-privacy-act-1988-sch-2-sec-20z-ss-3 a cml:Concept ;
    skos:prefLabel "20Z(3) Dealing with information if there is a pending correction"@en ;
    cml:realizedBy doc:sch-2-sec-20z-ss-3 ;
    values:originalText "(3) The credit reporting body must not use or disclose the information under Subdivision D of this Division. Civil penalty: 2,000 penalty units." ;
