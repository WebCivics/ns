doc:sch-2-sec-20z-ss-5 a cof:Section ;
    cof:title "20Z(5) Dealing with information if there is a pending correction" ;
    values:kind "subsection" ;
    values:originalText "(5) If the credit reporting body uses or discloses the information under subsection (4), the body must make a written note of the use or disclosure. Civil penalty: 500 penalty units. Direction to destroy information etc." ;
    cof:pageNumber "146"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-20z-ss-6 a cml:Concept ;
    skos:prefLabel "20Z(6) Dealing with information if there is a pending correction"@en ;
    cml:realizedBy doc:sch-2-sec-20z-ss-6 ;
    values:originalText "(6) The Commissioner may, by legislative instrument, direct the credit reporting body to destroy the information, or ensure that the information is de-identified, by a specified day." ;
    skos:definition "(6) The Commissioner may, by legislative instrument, direct the credit reporting body to destroy the information, or ensure that the information is de-identified, by a specified day."@en ;
