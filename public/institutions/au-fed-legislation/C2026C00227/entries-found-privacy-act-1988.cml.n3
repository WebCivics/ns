concept:entries-found-privacy-act-1988-sch-2-sec-20z-ss-5 a cml:Concept ;
    skos:prefLabel "20Z(5) Dealing with information if there is a pending correction"@en ;
    cml:realizedBy doc:sch-2-sec-20z-ss-5 ;
    values:originalText "(5) If the credit reporting body uses or discloses the information under subsection (4), the body must make a written note of the use or disclosure. Civil penalty: 500 penalty units. Direction to destroy information etc." ;
    skos:definition "(5) If the credit reporting body uses or discloses the information under subsection (4), the body must make a written note of the use or disclosure. Civil penalty: 500 penalty units. Direction to destroy information etc."@en ;
    cml:integrityHash "229b3df2db3cd8ad02c2add0ba1dde9c3e91f1987ab3b9b3d0233a040cff3340" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-20z ;
    cof:pageNumber "146"^^xsd:integer ;
    skos:note "Credit reporting body must make a written note of use or disclosure of information." ;
    dc:description "written note" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
