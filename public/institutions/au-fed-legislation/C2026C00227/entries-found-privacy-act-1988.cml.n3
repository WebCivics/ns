doc:sch-2-sec-80ub-ss-1a a cof:Section ;
    cof:title "80UB(1A) Infringement notices" ;
    values:kind "subsection" ;
    values:originalText "(1A) Despite subsection 104(2) of the Regulatory Powers Act, if an infringement notice relates to only one alleged contravention of subsection 13K(1) or (2), or 80UC(4), by a listed corporation (within the meaning of the Corporations Act 2001), the amount to be stated in the notice for the purposes of paragraph 104(1)(f) of the Regulatory Powers Act is 200 penalty units." ;
    cof:pageNumber "352"^^xsd:integer .

