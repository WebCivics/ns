concept:entries-found-privacy-act-1988-sch-2-sec-20y a cml:Concept ;
    skos:prefLabel "20Y Destruction of credit reporting information in cases of fraud"@en ;
    cml:realizedBy doc:sch-2-sec-20y ;
    values:originalText "(1) This section applies if:  (a) a credit reporting body holds credit reporting information about an individual; and  (b) the information relates to consumer credit that has been provided by a credit provider to the individual, or a person purporting to be the individual; and  (c) the body is satisfied that:  (i) the individual has been a victim of fraud (including identity fraud); and  (ii) the consumer credit was provided as a result of that fraud. Destruction of credit reporting information  (2) The credit reporting body must:  (a) destroy the credit reporting information; and  (b) within a reasonable period after the information is destroyed:  (i) give the individual a written notice that states that the information has been destroyed and sets out the effect of subsection (4); and  (ii) give the credit provider a written notice that states that the information has been destroyed. Civil penalty: 1,000 penalty units." ;
    skos:definition "(1) This section applies if:  (a) a credit reporting body holds credit reporting information about an individual; and  (b) the information relates to consumer credit that has been provided by a credit provider to the individual, or a person purporting to be the individual; and  (c) the body is satisfied that:  (i) the individual has been a victim of fraud (including identity fraud); and  (ii) the consumer credit was provided as a result of that fraud. Destruction of credit reporting information  (2) The credit reporting body must:  (a) destroy the credit reporting information; and  (b) within a reasonable period after the information is destroyed:  (i) give the individual a written notice that states that the information has been destroyed and sets out the effect of subsection (4); and  (ii) give the credit provider a written notice that states that the information has been destroyed. Civil penalty: 1,000 penalty units."@en ;
    cml:integrityHash "8af4b202bd98b54c8b09abcbfa709fd8dee0cb707e90cc355a1f21be005f4f71" ;
    cof:pageNumber "145"^^xsd:integer ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-20y-ss-1 ;
    cml:hasPart concept:entries-found-privacy-act-1988-sch-2-sec-20y-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.145" .
