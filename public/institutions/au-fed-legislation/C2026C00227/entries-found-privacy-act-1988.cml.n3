doc:sch-2-sec-93-ss-1 a cof:Section ;
    cof:title "93(1) Relief for breach etc. of certain obligations of confidence" ;
    values:kind "subsection" ;
    values:originalText "(1) A confider may recover damages from a confidant in respect of a breach of an obligation of confidence with respect to personal information." ;
    cof:pageNumber "365"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-93-ss-2 a cml:Concept ;
    skos:prefLabel "93(2) Relief for breach etc. of certain obligations of confidence"@en ;
    cml:realizedBy doc:sch-2-sec-93-ss-2 ;
