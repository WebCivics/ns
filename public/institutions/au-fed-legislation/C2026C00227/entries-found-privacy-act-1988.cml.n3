concept:entries-found-privacy-act-1988-sch-2-sec-22 a cml:Concept ;
    skos:prefLabel "22 Guide to this Division"@en ;
    cml:realizedBy doc:sch-2-sec-22 ;
    values:originalText "This Division sets out rules that apply to affected information recipients in relation to their handling of their regulated information. If an affected information recipient is an APP entity, the rules apply in relation to the regulated information of the recipient in addition to, or instead of, any relevant Australian Privacy Principles. Subdivision A—Consideration of information privacy" ;
    skos:definition "This Division sets out rules that apply to affected information recipients in relation to their handling of their regulated information. If an affected information recipient is an APP entity, the rules apply in relation to the regulated information of the recipient in addition to, or instead of, any relevant Australian Privacy Principles. Subdivision A—Consideration of information privacy"@en ;
    cml:integrityHash "c730138c22859228c56b0f25af482d4f6a990480719c38bcfefbe8f41474f767" ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Rules for handling regulated information apply to affected recipients." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.178" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-22-norm .
