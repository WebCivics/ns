    cof:pageNumber "265"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-33d a cml:Concept ;
    skos:prefLabel "33D Commissioner may direct an agency to give a privacy impact"@en ;
    cml:realizedBy doc:sch-2-sec-33d ;
    values:originalText "assessment  (1) If:  (a) an agency proposes to engage in an activity or function involving the handling of personal information about individuals; and  (b) the Commissioner considers that the activity or function might have a significant impact on the privacy of individuals; the Commissioner may, in writing, direct the agency to give the Commissioner, within a specified period, a privacy impact assessment about the activity or function.  (2) A direction under subsection (1) is not a legislative instrument." ;
    skos:definition "assessment  (1) If:  (a) an agency proposes to engage in an activity or function involving the handling of personal information about individuals; and  (b) the Commissioner considers that the activity or function might have a significant impact on the privacy of individuals; the Commissioner may, in writing, direct the agency to give the Commissioner, within a specified period, a privacy impact assessment about the activity or function.  (2) A direction under subsection (1) is not a legislative instrument."@en ;
    cml:integrityHash "89c08f7a02989db85066486407e81228ddadae03a30b293e5298cd050bd92db7" ;
    cof:pageNumber "267"^^xsd:integer ;
