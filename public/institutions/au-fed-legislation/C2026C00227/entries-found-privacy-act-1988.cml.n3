doc:sch-2-sec-22d-ss-1 a cof:Section ;
    cof:title "22D(1) Use or disclosure of information by a related body corporate" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a person holds or held credit eligibility information about an individual; and  (b) the information was disclosed to the person by a credit provider under paragraph 21G(3)(c); the person must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 1,000 penalty units. Permitted uses" ;
    cof:pageNumber "182"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-22d-ss-2 a cml:Concept ;
    skos:prefLabel "22D(2) Use or disclosure of information by a related body corporate"@en ;
    cml:realizedBy doc:sch-2-sec-22d-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to the use of the information if:  (a) the person uses the information for the purpose for which it was disclosed to the person under paragraph 21G(3)(c); or  (b) the use is required or authorised by or under an Australian law (other than the consumer data rules) or a court/tribunal order." ;
    skos:definition "(2) Subsection (1) does not apply to the use of the information if:  (a) the person uses the information for the purpose for which it was disclosed to the person under paragraph 21G(3)(c); or  (b) the use is required or authorised by or under an Australian law (other than the consumer data rules) or a court/tribunal order."@en ;
    cml:integrityHash "420900118fd38404142da0cd18cb477ab943254523b2e55294df7a08f7e26b0c" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-22d ;
    cof:pageNumber "182"^^xsd:integer ;
    skos:note "Permits use or disclosure of information by a related body corporate under certain conditions. Use of information for disclosed purpose is permitted." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
