doc:sch-2-sec-73-ss-2 a cof:Section ;
    cof:title "73(2) Application by APP entity" ;
    values:kind "subsection" ;
    values:originalText "(2) The CEO of the National Health and Medical Research Council may make an application under subsection (1) on behalf of other agencies concerned with medical research or the provision of health services." ;
    cof:pageNumber "320"^^xsd:integer .

