concept:entries-found-privacy-act-1988-sch-2-sec-80uc-ss-8 a cml:Concept ;
    skos:prefLabel "80UC(8) Compliance notices"@en ;
    cml:realizedBy doc:sch-2-sec-80uc-ss-8 ;
    values:originalText "(8) The Commissioner must not apply for an order under Part 4 of the Regulatory Powers Act in relation to a contravention of subsection 13G(1), 13H(1) or 13K(1) or (2) of this Act constituted by particular conduct engaged in by an entity, if:  (a) the entity has been given a notice under subsection (1) of this section in relation to a contravention constituted by the same conduct; and  (b) either of the following subparagraphs applies:" ;
    skos:definition "(8) The Commissioner must not apply for an order under Part 4 of the Regulatory Powers Act in relation to a contravention of subsection 13G(1), 13H(1) or 13K(1) or (2) of this Act constituted by particular conduct engaged in by an entity, if:  (a) the entity has been given a notice under subsection (1) of this section in relation to a contravention constituted by the same conduct; and  (b) either of the following subparagraphs applies:"@en ;
    cml:integrityHash "96791e9ed795da84f15656cfd562518c0a2571997dcafc5a8099f3c170182e45" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-80uc ;
    cof:pageNumber "354"^^xsd:integer ;
    skos:note "The Commissioner must not apply for an order under Part 4 of the Regulatory Powers Act in relation to a contravention of subsections 13G(1), 13H(1) or 13K(1) or (2) of this Act constituted by particular conduct engaged in by an entity, if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.354" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-80uc-ss-8-norm .
