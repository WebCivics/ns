concept:entries-found-privacy-act-1988-sch-2-sec-65-ss-2 a cml:Concept ;
    skos:prefLabel "65(2) Failure to attend etc. before Commissioner"@en ;
    cml:realizedBy doc:sch-2-sec-65-ss-2 ;
    values:originalText "(2) For the purposes of subsections (3) to (11) (inclusive): document includes a record. information includes an answer to a question." ;
    skos:definition "(2) For the purposes of subsections (3) to (11) (inclusive): document includes a record. information includes an answer to a question."@en ;
