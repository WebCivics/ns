concept:entries-found-privacy-act-1988-sch-1-sec-6-2 cml:asserts concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-alleninterval-2 .
concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Describes the temporal relationship between the primary and secondary purposes." ;
    cml:premiseText "The primary purpose was collected before the secondary purpose." ;
    cml:conclusionText "The APP entity must not use or disclose the information for a longer period than the primary purpose." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-1-sec-6-2 cml:asserts concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-argumentation-3 .
concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "Justifies the obligation based on the individual's consent." ;
    cml:premiseText "The individual has consented to the use or disclosure of the information." ;
    cml:conclusionText "Therefore, the APP entity must not use or disclose the information for a secondary purpose." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-1-sec-6-2 cml:asserts concept:entries-found-privacy-act-1988-sch-1-sec-6-2-logic-diffusion-4 .
