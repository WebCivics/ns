    cof:pageNumber "146"^^xsd:integer ;
    skos:note "Commissioner may direct credit reporting body to destroy or de-identify information by a specified day." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
