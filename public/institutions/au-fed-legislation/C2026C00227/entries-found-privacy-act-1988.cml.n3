concept:entries-found-privacy-act-1988-sch-1-sec-4-4 a cml:Concept ;
    skos:prefLabel "4 3 If:"@en ;
    cml:realizedBy doc:sch-1-sec-4-4 ;
    values:originalText "(a) the APP entity determines that the entity could not have collected the personal information; and  (b) the information is not contained in a Commonwealth record; the entity must, as soon as practicable but only if it is lawful and reasonable to do so, destroy the information or ensure that the information is de-identified." ;
    skos:definition "(a) the APP entity determines that the entity could not have collected the personal information; and  (b) the information is not contained in a Commonwealth record; the entity must, as soon as practicable but only if it is lawful and reasonable to do so, destroy the information or ensure that the information is de-identified."@en ;
    cml:integrityHash "36d8b99e70fdfcc03b9a879f1d6ec8bf70cdd3dbc5f25d39632ec2645f003c62" ;
    cof:pageNumber "384"^^xsd:integer ;
    skos:note "Destroy personal information if it cannot be collected or is not in a Commonwealth record." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
