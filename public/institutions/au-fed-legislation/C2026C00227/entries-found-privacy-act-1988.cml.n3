concept:entries-found-privacy-act-1988-sch-1-sec-11-3 a cml:Concept ;
    skos:prefLabel "11 2 If:"@en ;
    cml:realizedBy doc:sch-1-sec-11-3 ;
    values:originalText "(a) an APP entity holds personal information about an individual; and  (b) the entity no longer needs the information for any purpose for which the information may be used or disclosed by the entity under this Schedule; and  (c) the information is not contained in a Commonwealth record; and  (d) the entity is not required by or under an Australian law, or a court/tribunal order, to retain the information; the entity must take such steps as are reasonable in the circumstances to destroy the information or to ensure that the information is de-identified.  Australian Privacy Principles  Schedule 1 Integrity of personal information  Part 4  Clause 11  Privacy Act 1988  Compilation date: 04/06/2026" ;
    skos:definition "(a) an APP entity holds personal information about an individual; and  (b) the entity no longer needs the information for any purpose for which the information may be used or disclosed by the entity under this Schedule; and  (c) the information is not contained in a Commonwealth record; and  (d) the entity is not required by or under an Australian law, or a court/tribunal order, to retain the information; the entity must take such steps as are reasonable in the circumstances to destroy the information or to ensure that the information is de-identified.  Australian Privacy Principles  Schedule 1 Integrity of personal information  Part 4  Clause 11  Privacy Act 1988  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "a2f156a8810d06b54ce23cbdec959f239fbf5ad54f3f80e60a3708e9f271ec77" ;
    cof:pageNumber "396"^^xsd:integer ;
    skos:note "Destroy personal information if no longer needed and not required by law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
