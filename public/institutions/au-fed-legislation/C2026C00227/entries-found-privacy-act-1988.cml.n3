concept:entries-found-privacy-act-1988-sch-2-sec-40a-ss-5 a cml:Concept ;
    skos:prefLabel "40A(5) Conciliation of complaints"@en ;
    cml:realizedBy doc:sch-2-sec-40a-ss-5 ;
    values:originalText "(5) Evidence of anything said or done in the course of the conciliation is not admissible in any hearing before the Commissioner, or in any legal proceedings, relating to complaint or the act or practice unless:  (a) the complainant and respondent otherwise agree; or  (b) the thing was said or done in furtherance of the commission of a fraud or an offence, or the commission of an act that renders a person liable to a civil penalty.   Investigations etc.  Part V Investigation of complaints and investigations on the Commissioner’s initiative" ;
    skos:definition "(5) Evidence of anything said or done in the course of the conciliation is not admissible in any hearing before the Commissioner, or in any legal proceedings, relating to complaint or the act or practice unless:  (a) the complainant and respondent otherwise agree; or  (b) the thing was said or done in furtherance of the commission of a fraud or an offence, or the commission of an act that renders a person liable to a civil penalty.   Investigations etc.  Part V Investigation of complaints and investigations on the Commissioner’s initiative"@en ;
    cml:integrityHash "29e607878e242882f9ac594f1831946777b1b50bf67ce62877d54b03c7c042c6" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-40a ;
    cof:pageNumber "282"^^xsd:integer ;
    skos:note "Complainant and respondent must agree for evidence to be admissible in hearings or legal proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.282" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-40a-ss-5-norm .
