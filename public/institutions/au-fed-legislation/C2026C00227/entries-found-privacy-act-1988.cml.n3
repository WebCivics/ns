doc:sch-2-sec-12b-ss-8 a cof:Section ;
    cof:title "12B(8) Severability—additional effect of this Act" ;
    values:kind "subsection" ;
    values:originalText "(8) This Act also has the effect it would have if its operation in relation to regulated entities were expressly confined to acts or practices of regulated entities taking place in a place acquired by the Commonwealth for public purposes." ;
    cof:pageNumber "96"^^xsd:integer .

