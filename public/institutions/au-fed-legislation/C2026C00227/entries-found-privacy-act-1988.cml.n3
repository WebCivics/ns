concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-deontic-1 .
concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if-then" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "If a reference to collection, use or disclosure is made outside Australia." ;
    cml:conclusionText "Then it has the same effect as if it were confined within Australia." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-alleninterval-2 .
concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal equivalence" ;
    cml:premiseText "The temporal interval of a reference to collection, use or disclosure outside Australia is greater than or equal to the temporal interval of a reference to collection, use or disclosure within Australia." ;
    cml:conclusionText "Then it has the same effect as if it were confined within Australia." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-ltl-3 .
concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "<=" ;
    cml:logicSummary "Temporal inclusion" ;
    cml:premiseText "The temporal interval of a reference to collection, use or disclosure outside Australia is less than or equal to the temporal interval of a reference to collection, use or disclosure within Australia." ;
    cml:conclusionText "Then it has the same effect as if it were confined within Australia." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-diffusion-4 .
concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "⊆" ;
    cml:logicSummary "Set inclusion" ;
    cml:premiseText "The set of collections, uses or disclosures outside Australia is a subset of the set of collections, uses or disclosures within Australia." ;
    cml:conclusionText "Then it has the same effect as if it were confined within Australia." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-cogai-5 .
concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "⊆" ;
    cml:logicSummary "Knowledge representation" ;
    cml:premiseText "The knowledge representation of a reference to collection, use or disclosure outside Australia is a subset of the knowledge representation of a reference to collection, use or disclosure within Australia." ;
    cml:conclusionText "Then it has the same effect as if it were confined within Australia." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
