doc:sch-2-sec-80w-ss-1 a cof:Section ;
    cof:title "80W(1) Injunctions" ;
    values:kind "subsection" ;
    values:originalText "(1) The provisions of this Act are enforceable under Part 7 of the Regulatory Powers Act. Note: Part 7 of the Regulatory Powers Act creates a framework for using injunctions to enforce provisions. Authorised person" ;
    cof:pageNumber "359"^^xsd:integer .

