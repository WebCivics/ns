concept:entries-found-privacy-act-1988-sch-2-sec-20e-ss-4a a cml:Concept ;
    skos:prefLabel "20E(4A) Use or disclosure of credit reporting information"@en ;
    cml:realizedBy doc:sch-2-sec-20e-ss-4a ;
    values:originalText "(4A) Despite subsection (3), if the credit reporting information is, or was derived from, financial hardship information about the individual, the credit reporting body must not disclose the information under paragraph (3)(a) or (f) to a credit provider or mortgage insurer if the provider or insurer requested the information for the purpose of:" ;
    skos:definition "(4A) Despite subsection (3), if the credit reporting information is, or was derived from, financial hardship information about the individual, the credit reporting body must not disclose the information under paragraph (3)(a) or (f) to a credit provider or mortgage insurer if the provider or insurer requested the information for the purpose of:"@en ;
    cml:integrityHash "121f9ec47350e73c0d1ccd7eae3915591ba1ec069de9e32df018ba3eb391d524" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-20e ;
    cof:pageNumber "122"^^xsd:integer ;
    skos:note "Credit reporting body must not disclose financial hardship information to a credit provider or mortgage insurer under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
