concept:entries-found-privacy-act-1988-sch-2-sec-95b-ss-4 a cml:Concept ;
    skos:prefLabel "95B(4) Requirements for Commonwealth contracts"@en ;
    cml:realizedBy doc:sch-2-sec-95b-ss-4 ;
    values:originalText "(4) For the purposes of subsection (3), a subcontract is a contract under which a contracted service provider for the Commonwealth contract is engaged to provide services to:  (a) another contracted service provider for the Commonwealth contract; or  (b) any agency; for the purposes (whether direct or indirect) of the Commonwealth contract." ;
    skos:definition "(4) For the purposes of subsection (3), a subcontract is a contract under which a contracted service provider for the Commonwealth contract is engaged to provide services to:  (a) another contracted service provider for the Commonwealth contract; or  (b) any agency; for the purposes (whether direct or indirect) of the Commonwealth contract."@en ;
    cml:integrityHash "3c7f034850e38b4c11910a840f45acc15958c6da0357437d67b968137d9385be" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-95b ;
    cof:pageNumber "368"^^xsd:integer ;
    skos:note "A subcontract is a contract under which a contracted service provider for the Commonwealth contract is engaged to provide services." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
