concept:entries-found-privacy-act-1988-sch-2-sec-20 a cml:Concept ;
    skos:prefLabel "20 Guide to this Division"@en ;
    cml:realizedBy doc:sch-2-sec-20 ;
    values:originalText "This Division sets out rules that apply to credit reporting bodies in relation to their handling of the following:  (a) credit reporting information;  (b) CP derived information;  (c) credit reporting information that is de-identified;  (d) a pre-screening assessment. The rules apply in relation to that kind of information or assessment instead of the Australian Privacy Principles." ;
    skos:definition "This Division sets out rules that apply to credit reporting bodies in relation to their handling of the following:  (a) credit reporting information;  (b) CP derived information;  (c) credit reporting information that is de-identified;  (d) a pre-screening assessment. The rules apply in relation to that kind of information or assessment instead of the Australian Privacy Principles."@en ;
    cml:integrityHash "6c8e042b3ee0eebc279625b43e8cde50e4251c79844ac7dbff77f670a1dc8b26" ;
    cof:pageNumber "117"^^xsd:integer ;
    skos:note "Rules for credit reporting bodies regarding handling of specific information and assessments." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.117" ;
