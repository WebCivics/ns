concept:entries-found-privacy-act-1988-sch-1-sec-2-2 a cml:Concept ;
    skos:prefLabel "2 1 Individuals must have the option of not identifying themselves, or"@en ;
    cml:realizedBy doc:sch-1-sec-2-2 ;
