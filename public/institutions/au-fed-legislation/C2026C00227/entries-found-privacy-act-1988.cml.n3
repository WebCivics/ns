doc:sch-2-sec-1-2 a cof:Section ;
    cof:title "1 Objects of this Schedule" ;
    values:kind "section" ;
    values:originalText "The objects of this Schedule are to:  (a) establish a cause of action for serious invasions of privacy; and  (b) provide for defences, remedies and exemptions in respect of the cause of action; and  (c) recognise that there is a public interest in protecting privacy; and  (d) recognise that the public interest in protecting privacy is balanced with other public interests; and  (e) implement Australia’s international obligations in relation to privacy." ;
    cof:pageNumber "403"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-2-2 a cml:Concept ;
    skos:prefLabel "2 Simplified outline of this Schedule"@en ;
    cml:realizedBy doc:sch-2-sec-2-2 ;
    values:originalText "This Schedule establishes a cause of action in tort for serious invasions of privacy. An individual has a cause of action against another person if, among other things, the other person invaded the individual’s privacy by intruding upon their seclusion or misusing information relating to them. It is a defence to the cause of action if the other person acted with lawful authority or in certain circumstances involving consent, necessity or the defence of persons or property. If the invasion of privacy involved the publication of information, the other person  Schedule 2  Statutory Tort for Serious Invasions of Privacy" ;
    skos:definition "This Schedule establishes a cause of action in tort for serious invasions of privacy. An individual has a cause of action against another person if, among other things, the other person invaded the individual’s privacy by intruding upon their seclusion or misusing information relating to them. It is a defence to the cause of action if the other person acted with lawful authority or in certain circumstances involving consent, necessity or the defence of persons or property. If the invasion of privacy involved the publication of information, the other person  Schedule 2  Statutory Tort for Serious Invasions of Privacy"@en ;
    cml:integrityHash "9933877dafaaf56456695ab28a2a973ce527a320a35ff23d71932d53d5da003c" ;
    cof:pageNumber "403"^^xsd:integer ;
    skos:note "Establishes a cause of action in tort for serious invasions of privacy." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
