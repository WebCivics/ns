concept:entries-found-privacy-act-1988-sch-2-sec-53a-ss-3 a cml:Concept ;
    skos:prefLabel "53A(3) Notice to be given to outsourcing agency"@en ;
    cml:realizedBy doc:sch-2-sec-53a-ss-3 ;
    values:originalText "(3) An agency that receives a recommendation from the Commissioner must tell the Commissioner in writing of any action the agency proposes to take in relation to the recommendation. The agency must do so within 60 days of receiving the recommendation." ;
