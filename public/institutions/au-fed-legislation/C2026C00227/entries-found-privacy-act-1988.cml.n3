doc:sch-2-sec-65-ss-1 a cof:Section ;
    cof:title "65(1) Failure to attend etc. before Commissioner" ;
    values:kind "subsection" ;
    values:originalText "(1) A person contravenes this subsection if:  (a) the person is required to give information, answer a question or produce a document or record under this Act; and  (b) the person refuses or fails to do so. Civil penalty: 60 penalty units. Multiple contraventions  (1AA) A person commits an offence if:  (a) the person is a corporation; and  (b) the person engages in conduct that constitutes a system of conduct or a pattern of behaviour; and  (c) the system of conduct or pattern of behaviour results in 2 or more contraventions of subsection (1). Penalty: 300 penalty units." ;
    cof:pageNumber "312"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-65-ss-1a a cml:Concept ;
    skos:prefLabel "65(1A) Failure to attend etc. before Commissioner"@en ;
    cml:realizedBy doc:sch-2-sec-65-ss-1a ;
    values:originalText "(1A) For the purposes of subsection (1B), a journalist has a reasonable excuse if giving the information, answering the question or producing the document or record would tend to reveal the identity of a person who gave information or a document or record to the journalist in confidence." ;
    skos:definition "(1A) For the purposes of subsection (1B), a journalist has a reasonable excuse if giving the information, answering the question or producing the document or record would tend to reveal the identity of a person who gave information or a document or record to the journalist in confidence."@en ;
    cml:integrityHash "b041c707be0d52224e1adfc95d1e5b05b992eedf4d170ca20b4aff9aec6fb2c8" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-65 ;
    cof:pageNumber "312"^^xsd:integer ;
    skos:note "Journalist has a reasonable excuse to withhold information." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.312" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-65-ss-1a-norm .
