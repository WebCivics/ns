concept:entries-found-privacy-act-1988-sch-2-sec-21n a cml:Concept ;
    skos:prefLabel "21N Permitted CP disclosures to other recipients"@en ;
    cml:realizedBy doc:sch-2-sec-21n ;
    values:originalText "Mortgage credit assistance schemes  (1) A disclosure by a credit provider of credit eligibility information about an individual is a permitted CP disclosure in relation to the individual if:  (a) the disclosure is to a State or Territory authority; and  (b) the functions or responsibilities of the authority include:  (i) giving assistance (directly or indirectly) that facilitates the provision of mortgage credit to individuals; or  (ii) the management or supervision of schemes or arrangements under which such assistance is given; and  (c) the information is disclosed for the purpose of enabling the authority:" ;
    skos:definition "Mortgage credit assistance schemes  (1) A disclosure by a credit provider of credit eligibility information about an individual is a permitted CP disclosure in relation to the individual if:  (a) the disclosure is to a State or Territory authority; and  (b) the functions or responsibilities of the authority include:  (i) giving assistance (directly or indirectly) that facilitates the provision of mortgage credit to individuals; or  (ii) the management or supervision of schemes or arrangements under which such assistance is given; and  (c) the information is disclosed for the purpose of enabling the authority:"@en ;
    cml:integrityHash "aed2e0211579e69e6b7d4638dc429a784e4b6c82cfd6e70e6d1b2c68e2428ef5" ;
    cof:pageNumber "165"^^xsd:integer ;
    skos:note "Disclosure of credit eligibility information to State or Territory authorities is permitted under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.165" ;
