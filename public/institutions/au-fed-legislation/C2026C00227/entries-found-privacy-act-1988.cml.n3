concept:entries-found-privacy-act-1988-sch-2-sec-64 a cml:Concept ;
    skos:prefLabel "64 Commissioner etc. not to be sued"@en ;
    cml:realizedBy doc:sch-2-sec-64 ;
    values:originalText "Neither the Commissioner nor a person acting under his or her direction or authority is liable to an action, suit or proceeding in relation to an act done or omitted to be done in good faith in the exercise or purported exercise of any power or authority conferred by this Act." ;
    skos:definition "Neither the Commissioner nor a person acting under his or her direction or authority is liable to an action, suit or proceeding in relation to an act done or omitted to be done in good faith in the exercise or purported exercise of any power or authority conferred by this Act."@en ;
    cml:integrityHash "1c6d0b9db6d1e6cde1e5ddb9b2239a9eb57906a8d7496cecdc29d8be57f0daaf" ;
    cof:pageNumber "312"^^xsd:integer ;
    skos:note "Commissioner not liable for actions in good faith" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.312" ;
