concept:entries-found-privacy-act-1988-sch-2-sec-6t a cml:Concept ;
    skos:prefLabel "6T Meaning of payment information"@en ;
    cml:realizedBy doc:sch-2-sec-6t ;
    values:originalText "If:  (a) a credit provider has disclosed default information about an individual to a credit reporting body; and  (b) on a day after the default information was disclosed, the amount of the overdue payment to which the information relates is paid; then payment information about the individual is a statement that the amount of the overdue payment has been paid on that day." ;
    skos:definition "If:  (a) a credit provider has disclosed default information about an individual to a credit reporting body; and  (b) on a day after the default information was disclosed, the amount of the overdue payment to which the information relates is paid; then payment information about the individual is a statement that the amount of the overdue payment has been paid on that day."@en ;
    cml:integrityHash "743361bd1d93d3c2afcf510bcf008469d798faf489d8350b415d14e327a857f6" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Payment information is a statement that the amount of overdue payment has been paid." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.81" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-6t-norm .
