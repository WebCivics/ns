    cml:logicSummary "Permitted use conditions" ;
    cml:premiseText "(a) the relevant credit reporting information was disclosed to the provider under a provision specified in column 1 of the table for the purpose (if any) specified in that column; and (b) the provider uses the credit eligibility information for the purpose specified in column 2 of the table." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-21h cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-21h-logic-deontic-2 .
concept:entries-found-privacy-act-1988-sch-2-sec-21h-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "<" ;
    cml:logicSummary "Prohibited use conditions" ;
    cml:premiseText "(a) the relevant credit reporting information was not disclosed to the provider under a provision specified in column 1 of the table for the purpose (if any) specified in that column; or (b) the provider uses the credit eligibility information for a purpose other than the one specified in column 2 of the table." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
