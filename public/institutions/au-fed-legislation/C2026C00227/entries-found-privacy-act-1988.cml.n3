concept:entries-found-privacy-act-1988-sch-2-sec-26wt a cml:Concept ;
    skos:prefLabel "26WT Exception—inconsistency with secrecy provisions"@en ;
    cml:realizedBy doc:sch-2-sec-26wt ;
    values:originalText "Secrecy provisions  (1) For the purposes of this section, secrecy provision means a provision that:  (a) is a provision of a law of the Commonwealth (other than this Act); and  (b) prohibits or regulates the use or disclosure of information.  (2) If compliance by an entity with paragraph 26WR(1)(b) or subsection 26WR(2) in relation to a statement would, to any extent, be inconsistent with a secrecy provision (other than a prescribed secrecy provision), paragraph 26WR(1)(b) or subsection 26WR(2), as the case may be, does not apply to the entity, in relation to the statement, to the extent of the inconsistency." ;
    skos:definition "Secrecy provisions  (1) For the purposes of this section, secrecy provision means a provision that:  (a) is a provision of a law of the Commonwealth (other than this Act); and  (b) prohibits or regulates the use or disclosure of information.  (2) If compliance by an entity with paragraph 26WR(1)(b) or subsection 26WR(2) in relation to a statement would, to any extent, be inconsistent with a secrecy provision (other than a prescribed secrecy provision), paragraph 26WR(1)(b) or subsection 26WR(2), as the case may be, does not apply to the entity, in relation to the statement, to the extent of the inconsistency."@en ;
    cml:integrityHash "d8e7369e2afec497c8d6171ccbd03bbdaffb8c904dd848e6bac8a8ad976ebd67" ;
    cof:pageNumber "239"^^xsd:integer ;
