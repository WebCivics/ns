doc:sch-2-sec-26wc-ss-2 a cof:Section ;
    cof:title "26WC(2) Deemed holding of information" ;
    values:kind "subsection" ;
    values:originalText "(2) If:  (a) either:  (i) a credit provider has disclosed, under paragraph 21G(3)(b) or (c), credit eligibility information about one or more individuals to a related body corporate, or person, that does not have an Australian link; or  (ii) a credit provider has disclosed, under subsection 21M(1), credit eligibility information about one or more individuals to a body or person that does not have an Australian link; and  (b) the related body corporate, body or person holds the credit eligibility information; this Part has effect as if:  (c) the credit eligibility information were held by the credit provider; and  (d) the credit provider were required to comply with subsection 21S(1) in relation to the credit eligibility information." ;
    cof:pageNumber "221"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-26wd a cml:Concept ;
    skos:prefLabel "26WD Exception—notification under the My Health Records Act"@en ;
    cml:realizedBy doc:sch-2-sec-26wd ;
    values:originalText "If:  (a) an unauthorised access to information; or  (b) an unauthorised disclosure of information; or  (c) a loss of information; has been, or is required to be, notified under section 75 of the My Health Records Act 2012, this Part does not apply in relation to the access, disclosure or loss.   Notification of eligible data breaches  Part IIIC Eligible data breach  Division 2  Section 26WE  Privacy Act 1988  Compilation date: 04/06/2026" ;
    skos:definition "If:  (a) an unauthorised access to information; or  (b) an unauthorised disclosure of information; or  (c) a loss of information; has been, or is required to be, notified under section 75 of the My Health Records Act 2012, this Part does not apply in relation to the access, disclosure or loss.   Notification of eligible data breaches  Part IIIC Eligible data breach  Division 2  Section 26WE  Privacy Act 1988  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "142ece8f4427dca34a822c53467cb9c4ff44349136f0eeb09ddf7d7040ebdc94" ;
    cof:pageNumber "222"^^xsd:integer ;
    skos:note "Notification of eligible data breaches is exempt from this Part if notified under the My Health Records Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.222" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26wd-norm .
