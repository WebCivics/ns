    cml:logicSummary "Conditional duty based on subsection 21S(1)" ;
    cml:premiseText "A credit provider holds credit eligibility information relating to one or more individuals and is required to comply with subsection 21S(1)." ;
    cml:conclusionText "The credit provider must comply with section 15." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-26we cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26we-logic-deontic-5 .
