concept:entries-found-privacy-act-1988-sch-2-sec-21h cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-21h-logic-deontic-1 .
concept:entries-found-privacy-act-1988-sch-2-sec-21h-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
