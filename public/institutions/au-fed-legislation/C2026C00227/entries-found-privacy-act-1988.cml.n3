doc:sch-2-sec-63-ss-2 a cof:Section ;
    cof:title "63(2) Legal assistance" ;
    values:kind "subsection" ;
    values:originalText "(2) A person who:  (a) has commenced or proposes to commence proceedings in the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) under section 55; or  (b) has engaged in conduct or is alleged to have engaged in conduct in respect of which proceedings have been commenced in the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) under section 55; may apply to the Attorney-General for the provision of assistance under this section in respect of the proceedings." ;
    cof:pageNumber "311"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-63-ss-2a a cml:Concept ;
    skos:prefLabel "63(2A) Legal assistance"@en ;
    cml:realizedBy doc:sch-2-sec-63-ss-2a ;
    values:originalText "(2A) Subsection (2) does not permit an application relating to proceedings under section 55A to enforce a determination relating to a code complaint or an APP complaint." ;
    skos:definition "(2A) Subsection (2) does not permit an application relating to proceedings under section 55A to enforce a determination relating to a code complaint or an APP complaint."@en ;
    cml:integrityHash "130788649b0696bc9068a846531c1a6184d9c4d8a4df89fc52638511189d0c8e" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-63 ;
    cof:pageNumber "311"^^xsd:integer ;
    skos:note "No application can enforce a determination relating to a code complaint or an APP complaint." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
