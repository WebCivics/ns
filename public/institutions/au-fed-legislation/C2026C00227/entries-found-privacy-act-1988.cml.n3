concept:entries-found-privacy-act-1988-sch-2-sec-58 a cml:Concept ;
    skos:prefLabel "58 Obligations of agencies"@en ;
    cml:realizedBy doc:sch-2-sec-58 ;
    values:originalText "If this Division applies to a determination and the determination applies in relation to an agency, the agency:  (a) must not repeat or continue conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(i) or paragraph 52(1A)(a); and  (b) must take the steps that are specified in a declaration included in the determination under subparagraph 52(1)(b)(ia) or paragraph 52(1A)(b) within the specified period; and  (c) must perform the act or course of conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(ii) or paragraph 52(1A)(c); and  (d) must prepare and publish, or otherwise communicate, a statement in accordance with a declaration included in the determination under subparagraph 52(1)(b)(iia) or paragraph 52(1A)(ba) and section 52A." ;
    skos:definition "If this Division applies to a determination and the determination applies in relation to an agency, the agency:  (a) must not repeat or continue conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(i) or paragraph 52(1A)(a); and  (b) must take the steps that are specified in a declaration included in the determination under subparagraph 52(1)(b)(ia) or paragraph 52(1A)(b) within the specified period; and  (c) must perform the act or course of conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(ii) or paragraph 52(1A)(c); and  (d) must prepare and publish, or otherwise communicate, a statement in accordance with a declaration included in the determination under subparagraph 52(1)(b)(iia) or paragraph 52(1A)(ba) and section 52A."@en ;
    cml:integrityHash "9afb38aee1d4bd6cadd9a1849ed3bcdfeaf92f2dfee7408eb18e880739d485de" ;
    cof:pageNumber "308"^^xsd:integer ;
    skos:note "Agency must not repeat or continue conduct covered by a declaration, take specified steps, perform act or course of conduct, and prepare statement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.308" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-58-norm .
