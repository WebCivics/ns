doc:sch-2-sec-80a-ss-2 a cof:Section ;
    cof:title "80A(2) Temporary public interest determinations" ;
    values:kind "subsection" ;
    values:originalText "(2) The Commissioner may, by legislative instrument, make a determination that he or she is satisfied of the matters set out in subsection (1). The Commissioner may do so:  (a) on request by the APP entity; or  (b) on the Commissioner’s own initiative." ;
    cof:pageNumber "324"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-80a-ss-3 a cml:Concept ;
    skos:prefLabel "80A(3) Temporary public interest determinations"@en ;
    cml:realizedBy doc:sch-2-sec-80a-ss-3 ;
    values:originalText "(3) The Commissioner must specify in the determination a period of up to 12 months during which the determination is in force (subject to subsection 80D(2))." ;
