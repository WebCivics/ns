    cml:curationStatus cml:Proposed .
concept:entries-found-privacy-act-1988-sch-1-sec-12-4 cml:asserts concept:entries-found-privacy-act-1988-sch-1-sec-12-4-logic-deontic-1 .
concept:entries-found-privacy-act-1988-sch-1-sec-12-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Entity has a duty to withhold access" ;
    cml:premiseText "Entity is required to give individual access to personal information" ;
    cml:conclusionText "Entity is not required to give individual access to personal information under certain conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

