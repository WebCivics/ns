concept:entries-found-privacy-act-1988-sch-2-sec-13j a cml:Concept ;
    skos:prefLabel "13J Alternative orders"@en ;
    cml:realizedBy doc:sch-2-sec-13j ;
    values:originalText "If, in proceedings for an order in relation to a contravention of section 13G, the court:  (a) is satisfied that the entity has done an act, or engaged in a practice, that is an interference with the privacy of an individual; but  (b) is not satisfied that the interference with privacy is serious; the court may make a pecuniary penalty order against the entity for contravening section 13H, instead of section 13G." ;
    skos:definition "If, in proceedings for an order in relation to a contravention of section 13G, the court:  (a) is satisfied that the entity has done an act, or engaged in a practice, that is an interference with the privacy of an individual; but  (b) is not satisfied that the interference with privacy is serious; the court may make a pecuniary penalty order against the entity for contravening section 13H, instead of section 13G."@en ;
    cml:integrityHash "5bc0b89b1a95fc36cb9b469ed10eb5061be55417067476132ffa7f51203ebdff" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "Court may impose pecuniary penalty order instead of section 13G if interference with privacy is not serious." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.105" ;
    cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-13j-norm .
