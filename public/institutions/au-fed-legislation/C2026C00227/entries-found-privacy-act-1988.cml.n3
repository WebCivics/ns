concept:entries-found-privacy-act-1988-sch-1-sec-13-3 a cml:Concept ;
    skos:prefLabel "13 2 If:"@en ;
    cml:realizedBy doc:sch-1-sec-13-3 ;
    values:originalText "(a) the APP entity corrects personal information about an individual that the entity previously disclosed to another APP entity; and  (b) the individual requests the entity to notify the other APP entity of the correction; the entity must take such steps (if any) as are reasonable in the circumstances to give that notification unless it is impracticable or unlawful to do so.  Schedule 1  Australian Privacy Principles" ;
    skos:definition "(a) the APP entity corrects personal information about an individual that the entity previously disclosed to another APP entity; and  (b) the individual requests the entity to notify the other APP entity of the correction; the entity must take such steps (if any) as are reasonable in the circumstances to give that notification unless it is impracticable or unlawful to do so.  Schedule 1  Australian Privacy Principles"@en ;
    cml:integrityHash "ac70ffa11b11e975559a75fe89203ba5ea07cf90b3ce4ec91a0b1f6a7ba5a7d7" ;
    cof:pageNumber "401"^^xsd:integer ;
    skos:note "Entity must notify other APP entity of correction upon request." ;
    dc:description "notification" ;
    cml:curationStatus cml:Proposed ;
