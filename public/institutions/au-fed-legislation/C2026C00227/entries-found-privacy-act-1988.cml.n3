doc:sch-1-sec-4-4 a cof:Section ;
    cof:title "4 3 If:" ;
    values:kind "section" ;
    values:originalText "(a) the APP entity determines that the entity could not have collected the personal information; and  (b) the information is not contained in a Commonwealth record; the entity must, as soon as practicable but only if it is lawful and reasonable to do so, destroy the information or ensure that the information is de-identified." ;
    cof:pageNumber "384"^^xsd:integer .

