concept:entries-found-privacy-act-1988-sch-2-sec-5b a cml:Concept ;
    skos:prefLabel "5B Extra-territorial operation of Act"@en ;
    cml:realizedBy doc:sch-2-sec-5b ;
    values:originalText "Agencies  (1) This Act, a registered APP code and the registered CR code extend to an act done, or practice engaged in, outside Australia and the external Territories by an agency. Note: The act or practice overseas will not breach an Australian Privacy Principle or a registered APP code if the act or practice is required by an applicable foreign law (see sections 6A and 6B)." ;
    skos:definition "Agencies  (1) This Act, a registered APP code and the registered CR code extend to an act done, or practice engaged in, outside Australia and the external Territories by an agency. Note: The act or practice overseas will not breach an Australian Privacy Principle or a registered APP code if the act or practice is required by an applicable foreign law (see sections 6A and 6B)."@en ;
    cml:integrityHash "4a0b6a608f71907451a23d0f40fe0cff4b7a889e0f6113348ee394f0e7bcf806" ;
    cof:pageNumber "21"^^xsd:integer ;
    skos:note "Agencies can operate outside Australia and external Territories under this Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
    dc:source "entries-found-privacy-act-1988.pdf, p.21" ;
