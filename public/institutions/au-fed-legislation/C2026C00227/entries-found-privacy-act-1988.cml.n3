doc:sch-2-sec-11-ss-3 a cof:Section ;
    cof:title "11(3) File number recipients" ;
    values:kind "subsection" ;
    values:originalText "(3) Where a record that contains tax file number information is in the possession or under the control of a person for the purposes of the activities of, an unincorporated body, being a board, council, committee, sub-committee or other body established by or under a Commonwealth law, or a law of a State or Territory that applies in an external Territory, for the purpose of assisting, or performing functions connected with, an agency, that agency shall be treated, for the purposes of this Act, as the file number recipient in relation to that record." ;
    cof:pageNumber "94"^^xsd:integer .

concept:entries-found-privacy-act-1988-sch-2-sec-12a a cml:Concept ;
    skos:prefLabel "12A Act not to apply in relation to State banking or insurance"@en ;
    cml:realizedBy doc:sch-2-sec-12a ;
    values:originalText "within that State  Where, but for this section, a provision of this Act:  (a) would have a particular application; and  (b) by virtue of having that application, would be a law with respect to, or with respect to matters including:  (i) State banking not extending beyond the limits of the State concerned; or  (ii) State insurance not extending beyond the limits of the State concerned; the provision is not to have that application." ;
    skos:definition "within that State  Where, but for this section, a provision of this Act:  (a) would have a particular application; and  (b) by virtue of having that application, would be a law with respect to, or with respect to matters including:  (i) State banking not extending beyond the limits of the State concerned; or  (ii) State insurance not extending beyond the limits of the State concerned; the provision is not to have that application."@en ;
    cml:integrityHash "1f18bed77610dbc745c482d9729802c97c3065cb4a56b0e3e801378954e3407f" ;
    cof:pageNumber "95"^^xsd:integer ;
    skos:note "Prohibition on application of Act to State banking or insurance within the State concerned." ;
