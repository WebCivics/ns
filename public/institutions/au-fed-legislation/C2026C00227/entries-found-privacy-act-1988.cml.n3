concept:entries-found-privacy-act-1988-sch-2-sec-26gb-ss-8 a cml:Concept ;
    skos:prefLabel "26GB(8) Development of APP codes by the Commissioner—temporary"@en ;
    cml:realizedBy doc:sch-2-sec-26gb-ss-8 ;
    values:originalText "(8) Section 42 (disallowance) of the Legislation Act 2003 does not apply to a temporary APP code that is a registered APP code. Note: A registered APP code is a legislative instrument: see subsection 26B(2)." ;
    skos:definition "(8) Section 42 (disallowance) of the Legislation Act 2003 does not apply to a temporary APP code that is a registered APP code. Note: A registered APP code is a legislative instrument: see subsection 26B(2)."@en ;
