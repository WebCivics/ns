    {
      "@id": "concept:australian-border-force-act-2015-sec-11-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-border-force-act-2015.pdf, p.18",
      "skos:note": "The Australian Border Force Commissioner must be appointed by the Governor-General.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "11(1) Appointment"
      },
      "wasDerivedFrom": "australian-border-force-act-2015.pdf",
      "asserts": [
        "concept:australian-border-force-act-2015-sec-11-ss-1-norm",
        "concept:australian-border-force-act-2015-sec-11-ss-1-logic-deontic-1",
        "concept:australian-border-force-act-2015-sec-11-ss-1-logic-linearlogic-2",
        "concept:australian-border-force-act-2015-sec-11-ss-1-logic-alleninterval-3",
        "concept:australian-border-force-act-2015-sec-11-ss-1-logic-diffusion-4",
        "concept:australian-border-force-act-2015-sec-11-ss-1-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "11448a3eda1c941c356bce95d2bea7b465bf753d4964494a0c8bc459f216362d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-border-force-act-2015#sec-11-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:australian-border-force-act-2015-sec-11"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-11-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "THE APPOINTMENT OF THE AUSTRALIAN BORDER FORCE COMMISSIONER OCCURS BETWEEN THE TIME THE GOVERNOR-GENERAL WRITES THE INSTRUMENT AND THE TIME IT IS SIGNED.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The appointment of the Australian Border Force Commissioner occurs between the time the Governor-General writes the instrument and the time it is signed.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "(1) The Australian Border Force Commissioner is to be appointed by the Governor-General by written instrument."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-11-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "IF THE AUSTRALIAN BORDER FORCE COMMISSIONER IS APPOINTED THEN IT MUST BE KNOWN THAT IT HAS BEEN APPOINTED BY THE GOVERNOR-GENERAL.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If the Australian Border Force Commissioner is appointed, then it must be known that it has been appointed by the Governor-General.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "⇒",
      "cml:premiseText": "(1) The Australian Border Force Commissioner is to be appointed by the Governor-General by written instrument."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-11-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Australian Border Force Commissioner MUST be appointed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Australian Border Force Commissioner must be appointed.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(1) The Australian Border Force Commissioner is to be appointed by the Governor-General by written instrument."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-11-ss-1-logic-diffusion-4",
