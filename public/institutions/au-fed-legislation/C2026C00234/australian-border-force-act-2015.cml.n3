doc:sec-54-ss-4 a cof:Section ;
    cof:title "54(4) Delegation by Comptroller-General of Customs" ;
    values:kind "subsection" ;
    values:originalText "(4) An Immigration and Border Protection worker must, in performing functions or exercising powers under a delegation under subsection (3), comply with any written directions of the Secretary." ;
    cof:pageNumber "55"^^xsd:integer .

concept:australian-border-force-act-2015-sec-54-ss-5 a cml:Concept ;
    skos:prefLabel "54(5) Delegation by Comptroller-General of Customs"@en ;
    cml:realizedBy doc:sec-54-ss-5 ;
    values:originalText "(5) The Secretary must not give directions under subsection (4) in relation to particular functions or powers that are inconsistent with any directions given under subsection (2) in relation to those functions or powers." ;
    skos:definition "(5) The Secretary must not give directions under subsection (4) in relation to particular functions or powers that are inconsistent with any directions given under subsection (2) in relation to those functions or powers."@en ;
