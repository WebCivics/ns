doc:sec-25-ss-2 a cof:Section ;
    cof:title "25(2) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(2) However, subsection (1) does not apply in relation to:  (a) section 30 (resignation in anticipation of termination of employment); or  (b) section 32 (termination of employment for serious misconduct). Directions to delegates" ;
    cof:pageNumber "25"^^xsd:integer .

concept:australian-border-force-act-2015-sec-25-ss-3 a cml:Concept ;
    skos:prefLabel "25(3) Delegation"@en ;
    cml:realizedBy doc:sec-25-ss-3 ;
    values:originalText "(3) An Immigration and Border Protection worker must, in performing functions or exercising powers under a delegation under subsection (1), comply with any written directions of the Australian Border Force Commissioner. Subdelegation by Secretary" ;
