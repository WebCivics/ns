doc:sec-55-ss-3 a cof:Section ;
    cof:title "55(3) Directions by Secretary—administration and control of the" ;
    values:kind "subsection" ;
    values:originalText "(3) Without limiting subsection (2), essential qualifications may have one or more of the following components:  (a) physical or psychological health or fitness;  (b) professional or technical qualifications;  (c) learning and development requirements;  (d) security clearances. Organisational suitability assessments" ;
    cof:pageNumber "56"^^xsd:integer .

