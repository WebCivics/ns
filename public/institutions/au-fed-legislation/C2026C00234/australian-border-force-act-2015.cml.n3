concept:australian-border-force-act-2015-sec-37 a cml:Concept ;
    skos:prefLabel "37 Performing duties on board a vessel"@en ;
    cml:realizedBy doc:sec-37 ;
    values:originalText "If:  (a) an Immigration and Border Protection worker is on board a vessel throughout a period (the onboard period); and  (b) the vessel is under the command of an officer of Customs (within the meaning of the Customs Act 1901); and  (c) at any time during the onboard period, the worker performs duties as an Immigration and Border Protection worker; the worker is taken, for the purposes of this Part, to be in the course of performing his or her duties as an Immigration and Border Protection worker throughout the onboard period." ;
    skos:definition "If:  (a) an Immigration and Border Protection worker is on board a vessel throughout a period (the onboard period); and  (b) the vessel is under the command of an officer of Customs (within the meaning of the Customs Act 1901); and  (c) at any time during the onboard period, the worker performs duties as an Immigration and Border Protection worker; the worker is taken, for the purposes of this Part, to be in the course of performing his or her duties as an Immigration and Border Protection worker throughout the onboard period."@en ;
    cml:integrityHash "610e9a71a9af5956879588c3bf7df8fd7f6216bd706654dc9bd4c613722fe2f0" ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Worker performing duties on board vessel is in course of performing duties." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
