concept:australian-border-force-act-2015-sec-10 a cml:Concept ;
    skos:prefLabel "10 Powers of Australian Border Force Commissioner"@en ;
    cml:realizedBy doc:sec-10 ;
    values:originalText "The Australian Border Force Commissioner has power to do all things necessary or convenient to be done for or in connection with the performance of his or her duties." ;
