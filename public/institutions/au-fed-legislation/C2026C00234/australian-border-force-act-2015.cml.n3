concept:australian-border-force-act-2015-sec-16 a cml:Concept ;
    skos:prefLabel "16 Remuneration and allowances"@en ;
    cml:realizedBy doc:sec-16 ;
    values:originalText "(1) The Australian Border Force Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, he or she is to be paid the remuneration that is prescribed by the rules.  (2) The Australian Border Force Commissioner is to be paid the allowances that are prescribed by the rules.  (3) This section has effect subject to the Remuneration Tribunal Act 1973." ;
    skos:definition "(1) The Australian Border Force Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, he or she is to be paid the remuneration that is prescribed by the rules.  (2) The Australian Border Force Commissioner is to be paid the allowances that are prescribed by the rules.  (3) This section has effect subject to the Remuneration Tribunal Act 1973."@en ;
    cml:integrityHash "647d5dfdf0be20b7040519a6df7fe6a2d2a1cc8e932323e7e9d5082d91685f59" ;
    cof:pageNumber "20"^^xsd:integer ;
    cml:hasPart concept:australian-border-force-act-2015-sec-16-ss-1 ;
    cml:hasPart concept:australian-border-force-act-2015-sec-16-ss-2 ;
    cml:hasPart concept:australian-border-force-act-2015-sec-16-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-border-force-act-2015.pdf> ;
    dc:source "australian-border-force-act-2015.pdf, p.20" .
