concept:australian-border-force-act-2015-sec-15 a cml:Concept ;
    skos:prefLabel "15 Application of finance law"@en ;
    cml:realizedBy doc:sec-15 ;
    values:originalText "For the purposes of the finance law (within the meaning of the Public Governance, Performance and Accountability Act 2013), the Australian Border Force Commissioner (including in his or her capacity as the Comptroller-General of Customs) is an official of the Department." ;
    skos:definition "For the purposes of the finance law (within the meaning of the Public Governance, Performance and Accountability Act 2013), the Australian Border Force Commissioner (including in his or her capacity as the Comptroller-General of Customs) is an official of the Department."@en ;
