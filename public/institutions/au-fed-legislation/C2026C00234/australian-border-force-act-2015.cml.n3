doc:sec-28 a cof:Section ;
    cof:title "28 Simplified outline of this Part" ;
    values:kind "section" ;
    values:originalText "• An APS employee in the Department must give at least 14 days’ notice of his or her resignation from the Department. • If an APS employee in the Department resigns in circumstances where the employee may have engaged in serious misconduct, the Secretary or the Australian Border Force Commissioner may delay the employee’s resignation by up to 90 days to allow further investigation of that conduct." ;
    cof:pageNumber "30"^^xsd:integer .

concept:australian-border-force-act-2015-sec-29 a cml:Concept ;
    skos:prefLabel "29 Resignation—general"@en ;
    cml:realizedBy doc:sec-29 ;
    values:originalText "(1) A person may resign as an APS employee in the Department if, and only if:  (a) he or she gives written notice to the Secretary of his or her resignation; and  (b) the notice specifies, in accordance with subsection (2), the day his or her resignation is to take effect.  (2) The day specified in a notice under paragraph (1)(a) must not:  (a) be earlier than 14 days, or such shorter period as the Secretary allows; or  (b) be later than 4 months; after the day on which the notice is given to the Secretary.  (3) This section is subject to section 30." ;
    skos:definition "(1) A person may resign as an APS employee in the Department if, and only if:  (a) he or she gives written notice to the Secretary of his or her resignation; and  (b) the notice specifies, in accordance with subsection (2), the day his or her resignation is to take effect.  (2) The day specified in a notice under paragraph (1)(a) must not:  (a) be earlier than 14 days, or such shorter period as the Secretary allows; or  (b) be later than 4 months; after the day on which the notice is given to the Secretary.  (3) This section is subject to section 30."@en ;
    cml:integrityHash "af2243a567aeaca0d8df2e0ce885892a6ec6c41c416deffef59c630d79a93737" ;
    cof:pageNumber "30"^^xsd:integer ;
    cml:hasPart concept:australian-border-force-act-2015-sec-29-ss-1 ;
    cml:hasPart concept:australian-border-force-act-2015-sec-29-ss-2 ;
