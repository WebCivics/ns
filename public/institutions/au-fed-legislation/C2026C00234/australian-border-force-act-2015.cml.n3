concept:australian-border-force-act-2015-sec-55-ss-10 a cml:Concept ;
    skos:prefLabel "55(10) Directions by Secretary—administration and control of the"@en ;
    cml:realizedBy doc:sec-55-ss-10 ;
    values:originalText "(10) If an Immigration and Border Protection worker is required by a direction of the kind mentioned in subsection (5) to give information, answer a question or produce a document, the worker is not excused from:  (a) giving the information; or  (b) answering the question; or" ;
    skos:definition "(10) If an Immigration and Border Protection worker is required by a direction of the kind mentioned in subsection (5) to give information, answer a question or produce a document, the worker is not excused from:  (a) giving the information; or  (b) answering the question; or"@en ;
    cml:integrityHash "f4ccad81004e986aa191dabc53aa5c0e011475c01f747e52c63b006615a3dedb" ;
    values:partOf concept:australian-border-force-act-2015-sec-55 ;
    cof:pageNumber "56"^^xsd:integer ;
    skos:note "Must provide information, answer question, or produce document under certain conditions." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
