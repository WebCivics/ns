    cml:conclusionText "the person is also the Comptroller-General of Customs" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-11-ss-3 a cof:Section ;
    cof:title "11(3) Appointment" ;
    values:kind "subsection" ;
    values:originalText "(3) While a person holds office as the Australian Border Force Commissioner the person is also the Comptroller-General of Customs. Note: Many Commonwealth laws confer functions and powers on the Comptroller-General of Customs." ;
    cof:pageNumber "18"^^xsd:integer .

concept:australian-border-force-act-2015-sec-12 a cml:Concept ;
    skos:prefLabel "12 Term of appointment"@en ;
    cml:realizedBy doc:sec-12 ;
    values:originalText "The Australian Border Force Commissioner holds office for the period specified in the instrument of appointment. The period must not exceed 5 years. Note: The Australian Border Force Commissioner may be reappointed: see section 33AA of the Acts Interpretation Act 1901." ;
    skos:definition "The Australian Border Force Commissioner holds office for the period specified in the instrument of appointment. The period must not exceed 5 years. Note: The Australian Border Force Commissioner may be reappointed: see section 33AA of the Acts Interpretation Act 1901."@en ;
