concept:australian-border-force-act-2015-sec-33 a cml:Concept ;
    skos:prefLabel "33 Simplified outline of this Part"@en ;
    cml:realizedBy doc:sec-33 ;
    values:originalText "• Immigration and Border Protection workers may be required to undergo an alcohol screening test, an alcohol breath test, an alcohol blood test or a prohibited drug test." ;
    skos:definition "• Immigration and Border Protection workers may be required to undergo an alcohol screening test, an alcohol breath test, an alcohol blood test or a prohibited drug test."@en ;
    cml:integrityHash "f4174f545740a01825f17561d3c254dc11b9cca24a2f68052b8afcdaf70921d8" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Workers may be required to undergo alcohol screening tests" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
