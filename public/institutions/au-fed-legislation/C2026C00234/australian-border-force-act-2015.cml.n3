doc:sec-25-ss-3 a cof:Section ;
    cof:title "25(3) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(3) An Immigration and Border Protection worker must, in performing functions or exercising powers under a delegation under subsection (1), comply with any written directions of the Australian Border Force Commissioner. Subdelegation by Secretary" ;
    cof:pageNumber "25"^^xsd:integer .

concept:australian-border-force-act-2015-sec-25-ss-4 a cml:Concept ;
    skos:prefLabel "25(4) Delegation"@en ;
    cml:realizedBy doc:sec-25-ss-4 ;
    values:originalText "(4) If the Secretary is delegated functions or powers under subsection (1), the Secretary may, by writing, delegate any of those functions or powers to any Immigration and Border Protection worker." ;
    skos:definition "(4) If the Secretary is delegated functions or powers under subsection (1), the Secretary may, by writing, delegate any of those functions or powers to any Immigration and Border Protection worker."@en ;
    cml:integrityHash "050a551146427496b82d2ce3370a3ab1a3256f77cae883f15d6976f635dfd8a5" ;
