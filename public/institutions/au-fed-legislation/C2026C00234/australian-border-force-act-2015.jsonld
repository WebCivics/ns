      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-47",
      "@type": "cml:Concept",
      "skos:prefLabel": "47 Disclosure with consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-47"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.50",
      "values:originalText": "An entrusted person may disclose Immigration and Border\nProtection information that relates to the affairs of a person or body\nif:\n\n(a) the person or body has consented to the disclosure; and\n\n(b) the disclosure is in accordance with that consent.\n\n\nSecrecy and disclosure provisions  Part 6\n\nSection 48\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "skos:definition": "An entrusted person may disclose Immigration and Border\nProtection information that relates to the affairs of a person or body\nif:\n\n(a) the person or body has consented to the disclosure; and\n\n(b) the disclosure is in accordance with that consent.\n\n\nSecrecy and disclosure provisions  Part 6\n\nSection 48\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-47-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-47-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d98b5cf40cd8433b37b209e249cd931edb9991a5664c3feeee3ae0b4655280aa",
      "skos:note": "Disclosure of Immigration and Border Protection information with consent."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-47",
      "@type": "cof:Section",
      "cof:title": "47 Disclosure with consent",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "An entrusted person may disclose Immigration and Border\nProtection information that relates to the affairs of a person or body\nif:\n\n(a) the person or body has consented to the disclosure; and\n\n(b) the disclosure is in accordance with that consent.\n\n\nSecrecy and disclosure provisions  Part 6\n\nSection 48\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-47-norm",
