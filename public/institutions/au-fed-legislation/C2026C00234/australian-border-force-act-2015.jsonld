      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.43",
      "values:originalText": "•\nAn entrusted person must not make a record of or disclose\nImmigration and Border Protection information unless the\nmaking of the record or disclosure is authorised by a provision\nof this Part, is in the course of the person’s employment or\nservice as an entrusted person or is required or authorised by\nlaw or by an order or direction of a court or tribunal.",
      "skos:definition": "•\nAn entrusted person must not make a record of or disclose\nImmigration and Border Protection information unless the\nmaking of the record or disclosure is authorised by a provision\nof this Part, is in the course of the person’s employment or\nservice as an entrusted person or is required or authorised by\nlaw or by an order or direction of a court or tribunal.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-41-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-41-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d6de1a60b5b6bbe211f739cc04666e7db6302e7f662f084bc8628ed3d84f52a1",
      "skos:note": "No record of or disclosure of Immigration and Border Protection information without authorization."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "•\nAn entrusted person must not make a record of or disclose\nImmigration and Border Protection information unless the\nmaking of the record or disclosure is authorised by a provision\nof this Part, is in the course of the person’s employment or\nservice as an entrusted person or is required or authorised by\nlaw or by an order or direction of a court or tribunal."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-41-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
