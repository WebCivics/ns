    {
      "@id": "concept:australian-border-force-act-2015-sec-50a",
      "@type": "cml:Concept",
      "skos:prefLabel": "50A Information must be certified as appropriately classified before",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-50a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.51",
      "values:originalText": "proceedings can be initiated\n\nIf, an offence against section 42 relates to information that has a\nsecurity classification, proceedings for the offence must not be\ninitiated unless the Secretary has certified that it is appropriate that\nthe information had a security classification at the time of the\nconduct that is alleged to constitute the offence.",
      "skos:definition": "proceedings can be initiated\n\nIf, an offence against section 42 relates to information that has a\nsecurity classification, proceedings for the offence must not be\ninitiated unless the Secretary has certified that it is appropriate that\nthe information had a security classification at the time of the\nconduct that is alleged to constitute the offence.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-50a-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-50a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0d51c9a6d4f49a4d90848dc66da85b68cd53021a7bb5cf262d5b75bbcce0a9a8",
      "skos:note": "Certification required for proceedings related to classified information"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-50a",
      "@type": "cof:Section",
      "cof:title": "50A Information must be certified as appropriately classified before",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "proceedings can be initiated\n\nIf, an offence against section 42 relates to information that has a\nsecurity classification, proceedings for the offence must not be\ninitiated unless the Secretary has certified that it is appropriate that\nthe information had a security classification at the time of the\nconduct that is alleged to constitute the offence."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-50a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
