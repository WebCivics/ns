      },
      "cml:premiseText": "Consent is required",
      "cml:conclusionText": "Disclosure is allowed"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Disclosure to reduce threat to life or health",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.51",
      "values:originalText": "An entrusted person may disclose Immigration and Border\nProtection information if:\n\n(a) the entrusted person reasonably believes that the disclosure is\nnecessary to prevent or lessen a serious threat to the life or\nhealth of an individual; and\n\n(b) the disclosure is for the purposes of preventing or lessening\nthat threat.",
      "skos:definition": "An entrusted person may disclose Immigration and Border\nProtection information if:\n\n(a) the entrusted person reasonably believes that the disclosure is\nnecessary to prevent or lessen a serious threat to the life or\nhealth of an individual; and\n\n(b) the disclosure is for the purposes of preventing or lessening\nthat threat.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-48-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-48-logic-deontic-1"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-48-logic-deontic-2"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-48-logic-alleninterval-3"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-48-logic-ltl-4"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-48-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "2e44eed62fc00bf41659273bd90ec7de5955472298590b5215674515548f9f1d",
      "skos:note": "Disclosure of Immigration and Border Protection information under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Disclosure to reduce threat to life or health",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "An entrusted person may disclose Immigration and Border\nProtection information if:\n\n(a) the entrusted person reasonably believes that the disclosure is\nnecessary to prevent or lessen a serious threat to the life or\nhealth of an individual; and\n\n(b) the disclosure is for the purposes of preventing or lessening\nthat threat."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-48-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-48"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-48-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Duty to disclose information under certain circumstances.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Trusted person has a duty to disclose Immigration and Border Protection information if necessary to prevent or lessen a serious threat to life or health.",
      "cml:conclusionText": "Disclosure of information is obligatory."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-48-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Trusted person has permission to disclose Immigration and Border Protection information under certain circumstances.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Trusted person may disclose Immigration and Border Protection information if necessary to prevent or lessen a serious threat to life or health.",
      "cml:conclusionText": "Disclosure of information is permitted."
    },
    {
