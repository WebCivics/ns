    {
      "@id": "concept:australian-border-force-act-2015-sec-36-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "36(4) Alcohol screening, breath or blood test or prohibited drug test—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-36-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.38",
      "values:originalText": "(4) A direction under subsection (1) must be given as soon as\npracticable after the incident concerned and may be given whether\nor not the worker is still performing his or her duties as an\nImmigration and Border Protection worker.\nProvision of blood or body sample while in hospital",
      "skos:definition": "(4) A direction under subsection (1) must be given as soon as\npracticable after the incident concerned and may be given whether\nor not the worker is still performing his or her duties as an\nImmigration and Border Protection worker.\nProvision of blood or body sample while in hospital",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-36"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-36-ss-4-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-36-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f850f5008b863b5261f75dae90c0ac4e984bbefdf87de31829c4a1540d8d2af4",
      "skos:note": "Must provide direction under subsection (1) as soon as practicable after incident concerned.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-36-ss-4",
      "@type": "cof:Section",
      "cof:title": "36(4) Alcohol screening, breath or blood test or prohibited drug test—",
      "values:kind": "subsection",
      "cof:pageNumber": 38,
      "values:originalText": "(4) A direction under subsection (1) must be given as soon as\npracticable after the incident concerned and may be given whether\nor not the worker is still performing his or her duties as an\nImmigration and Border Protection worker.\nProvision of blood or body sample while in hospital"
    },
