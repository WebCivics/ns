    {
      "@id": "concept:australian-border-force-act-2015-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Powers of Australian Border Force Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-10"
      },
      "cml:curationStatus": {
