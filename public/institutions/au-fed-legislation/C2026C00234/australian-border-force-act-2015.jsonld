    {
      "@id": "concept:australian-border-force-act-2015-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.18",
      "values:originalText": "(1) The Australian Border Force Commissioner is to be appointed by\nthe Governor-General by written instrument.\n\n(2) The Australian Border Force Commissioner is to be appointed on a\nfull-time basis.\nComptroller-General of Customs\n\n(3) While a person holds office as the Australian Border Force\nCommissioner the person is also the Comptroller-General of\nCustoms.\nNote:\nMany Commonwealth laws confer functions and powers on the\nComptroller-General of Customs.",
      "skos:definition": "(1) The Australian Border Force Commissioner is to be appointed by\nthe Governor-General by written instrument.\n\n(2) The Australian Border Force Commissioner is to be appointed on a\nfull-time basis.\nComptroller-General of Customs\n\n(3) While a person holds office as the Australian Border Force\nCommissioner the person is also the Comptroller-General of\nCustoms.\nNote:\nMany Commonwealth laws confer functions and powers on the\nComptroller-General of Customs.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-11-ss-1"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-11-ss-2"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-11-ss-3"
        }
      ],
      "cml:integrityHash": "e813568701abe784eaedadf8bd570ba6b8add514d2dd467b0b737309aa55b06a"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Appointment",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "(1) The Australian Border Force Commissioner is to be appointed by\nthe Governor-General by written instrument.\n\n(2) The Australian Border Force Commissioner is to be appointed on a\nfull-time basis.\nComptroller-General of Customs\n\n(3) While a person holds office as the Australian Border Force\nCommissioner the person is also the Comptroller-General of\nCustoms.\nNote:\nMany Commonwealth laws confer functions and powers on the\nComptroller-General of Customs."
    },
