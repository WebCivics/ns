    {
      "@id": "concept:australian-border-force-act-2015-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Simplified outline of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.7",
      "values:originalText": "•\nThere is an Australian Border Force within the Department.\n•\nThere is to be an Australian Border Force Commissioner of\nthe Australian Border Force, who is to have the control of the\noperations of the Australian Border Force.\n•\nThe Australian Border Force Commissioner and APS\nemployees in the Australian Border Force are able to exercise\npowers under the Customs Act 1901, the Migration Act 1958,\nthe Maritime Powers Act 2013 and other Commonwealth\nlaws.",
      "skos:definition": "•\nThere is an Australian Border Force within the Department.\n•\nThere is to be an Australian Border Force Commissioner of\nthe Australian Border Force, who is to have the control of the\noperations of the Australian Border Force.\n•\nThe Australian Border Force Commissioner and APS\nemployees in the Australian Border Force are able to exercise\npowers under the Customs Act 1901, the Migration Act 1958,\nthe Maritime Powers Act 2013 and other Commonwealth\nlaws.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-3-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b81d2a1ed5238c1616181886c531b557459891f8e806665b073cc240a99dc9a8",
      "skos:note": "Australian Border Force Commissioner has control of operations."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Simplified outline of this Act",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "•\nThere is an Australian Border Force within the Department.\n•\nThere is to be an Australian Border Force Commissioner of\nthe Australian Border Force, who is to have the control of the\noperations of the Australian Border Force.\n•\nThe Australian Border Force Commissioner and APS\nemployees in the Australian Border Force are able to exercise\npowers under the Customs Act 1901, the Migration Act 1958,\nthe Maritime Powers Act 2013 and other Commonwealth\nlaws."
    },
