    {
      "@id": "concept:australian-border-force-act-2015-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Term of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.18",
      "values:originalText": "The Australian Border Force Commissioner holds office for the\nperiod specified in the instrument of appointment. The period must\nnot exceed 5 years.\nNote:\nThe Australian Border Force Commissioner may be reappointed: see\nsection 33AA of the Acts Interpretation Act 1901.",
      "skos:definition": "The Australian Border Force Commissioner holds office for the\nperiod specified in the instrument of appointment. The period must\nnot exceed 5 years.\nNote:\nThe Australian Border Force Commissioner may be reappointed: see\nsection 33AA of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-12-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b187d09b63009b8b350b91006922dc3daaa521cc4fa0a4514026cac514ce7ae8",
      "skos:note": "The Australian Border Force Commissioner must hold office for a period not exceeding 5 years."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Term of appointment",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "The Australian Border Force Commissioner holds office for the\nperiod specified in the instrument of appointment. The period must\nnot exceed 5 years.\nNote:\nThe Australian Border Force Commissioner may be reappointed: see\nsection 33AA of the Acts Interpretation Act 1901."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-12-norm",
