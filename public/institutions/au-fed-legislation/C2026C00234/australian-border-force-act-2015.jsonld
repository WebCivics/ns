      "cml:integrityHash": "da09ba7343b3adf38be5670c3e88d254bd530387ed020f9cc6c2ab6f55a4aaa2",
      "skos:note": "Making Immigration and Border Protection information without authorization is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-42-ss-1",
      "@type": "cof:Section",
      "cof:title": "42(1) Secrecy",
      "values:kind": "subsection",
      "cof:pageNumber": 43,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person is, or has been, an entrusted person; and\n\n(b) the person makes a record of, or discloses, information; and\n\n(c) the information is Immigration and Border Protection\ninformation.\nPenalty: Imprisonment for 2 years."
    },
