    {
      "@id": "concept:australian-border-force-act-2015-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-17"
      },
      "cml:curationStatus": {
