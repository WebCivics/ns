        }
      ],
      "cml:integrityHash": "55442bbcbd7b2ced6b1136b20c6bad3dfe517cef9454603e6d2ed717e6eb0d62",
      "skos:note": "The Secretary may delegate certain functions or powers."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-53-ss-1",
      "@type": "cof:Section",
      "cof:title": "53(1) Delegation by Secretary",
      "values:kind": "subsection",
      "cof:pageNumber": 53,
      "values:originalText": "(1) The Secretary may, by writing, delegate any of his or her functions\nor powers under a law of the Commonwealth to:\n\n(a) the Australian Border Force Commissioner; or\n\n(b) an Immigration and Border Protection worker."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-53-ss-1-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
