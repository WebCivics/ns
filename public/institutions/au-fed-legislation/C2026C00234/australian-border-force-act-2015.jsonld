      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must give notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Resignation—general",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.30",
      "values:originalText": "(1) A person may resign as an APS employee in the Department if,\nand only if:\n\n(a) he or she gives written notice to the Secretary of his or her\nresignation; and\n\n(b) the notice specifies, in accordance with subsection (2), the\nday his or her resignation is to take effect.\n\n(2) The day specified in a notice under paragraph (1)(a) must not:\n\n(a) be earlier than 14 days, or such shorter period as the\nSecretary allows; or\n\n(b) be later than 4 months;\nafter the day on which the notice is given to the Secretary.\n\n(3) This section is subject to section 30.",
      "skos:definition": "(1) A person may resign as an APS employee in the Department if,\nand only if:\n\n(a) he or she gives written notice to the Secretary of his or her\nresignation; and\n\n(b) the notice specifies, in accordance with subsection (2), the\nday his or her resignation is to take effect.\n\n(2) The day specified in a notice under paragraph (1)(a) must not:\n\n(a) be earlier than 14 days, or such shorter period as the\nSecretary allows; or\n\n(b) be later than 4 months;\nafter the day on which the notice is given to the Secretary.\n\n(3) This section is subject to section 30.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-29-ss-1"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-29-ss-2"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-29-ss-3"
        }
      ],
      "cml:integrityHash": "af2243a567aeaca0d8df2e0ce885892a6ec6c41c416deffef59c630d79a93737"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Resignation—general",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "(1) A person may resign as an APS employee in the Department if,\nand only if:\n\n(a) he or she gives written notice to the Secretary of his or her\nresignation; and\n\n(b) the notice specifies, in accordance with subsection (2), the\nday his or her resignation is to take effect.\n\n(2) The day specified in a notice under paragraph (1)(a) must not:\n\n(a) be earlier than 14 days, or such shorter period as the\nSecretary allows; or\n\n(b) be later than 4 months;\nafter the day on which the notice is given to the Secretary.\n\n(3) This section is subject to section 30."
    },
