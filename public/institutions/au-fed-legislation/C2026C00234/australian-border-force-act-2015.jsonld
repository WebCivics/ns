    {
      "@id": "concept:australian-border-force-act-2015-sec-55-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "55(5) Directions by Secretary—administration and control of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-55-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
