      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Holds",
      "cml:logicSummary": "The Commissioner holds office on terms and conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
