        }
      ],
      "cml:integrityHash": "d34b28b152c0f757dd3e467a1c619acf59d22499155673a881c7f3c3fb467252",
      "skos:note": "Delegation by Comptroller-General of Customs"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-54-ss-6",
      "@type": "cof:Section",
      "cof:title": "54(6) Delegation by Comptroller-General of Customs",
      "values:kind": "subsection",
      "cof:pageNumber": 55,
      "values:originalText": "(6) A function that is performed or a power that is exercised by an\nImmigration and Border Protection worker under a delegation\nunder subsection (3) is taken, for the purposes of the law referred\nto in subsection (1), to have been performed or exercised by the\nComptroller-General of Customs."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-54-ss-6-norm",
