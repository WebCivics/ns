      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Performing duties on board a vessel",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.40",
      "values:originalText": "If:\n\n(a) an Immigration and Border Protection worker is on board a\nvessel throughout a period (the onboard period); and\n\n(b) the vessel is under the command of an officer of Customs\n(within the meaning of the Customs Act 1901); and\n\n(c) at any time during the onboard period, the worker performs\nduties as an Immigration and Border Protection worker;\nthe worker is taken, for the purposes of this Part, to be in the course\nof performing his or her duties as an Immigration and Border\nProtection worker throughout the onboard period.",
      "skos:definition": "If:\n\n(a) an Immigration and Border Protection worker is on board a\nvessel throughout a period (the onboard period); and\n\n(b) the vessel is under the command of an officer of Customs\n(within the meaning of the Customs Act 1901); and\n\n(c) at any time during the onboard period, the worker performs\nduties as an Immigration and Border Protection worker;\nthe worker is taken, for the purposes of this Part, to be in the course\nof performing his or her duties as an Immigration and Border\nProtection worker throughout the onboard period.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-37-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "610e9a71a9af5956879588c3bf7df8fd7f6216bd706654dc9bd4c613722fe2f0",
      "skos:note": "Worker performing duties on board vessel is in course of performing duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-37",
      "@type": "cof:Section",
      "cof:title": "37 Performing duties on board a vessel",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "If:\n\n(a) an Immigration and Border Protection worker is on board a\nvessel throughout a period (the onboard period); and\n\n(b) the vessel is under the command of an officer of Customs\n(within the meaning of the Customs Act 1901); and\n\n(c) at any time during the onboard period, the worker performs\nduties as an Immigration and Border Protection worker;\nthe worker is taken, for the purposes of this Part, to be in the course\nof performing his or her duties as an Immigration and Border\nProtection worker throughout the onboard period."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-37-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-37"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-37-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Worker's status as Immigration and Border Protection worker.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "worker performs duties",
      "cml:conclusionText": "in course of performing duties"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Conduct of tests and provision of samples to be in accordance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.40",
      "values:originalText": "with the rules\nConduct of tests\n\n(1) An alcohol screening test, alcohol breath test, alcohol blood test or\nprohibited drug test under section 34, 35 or 36 is to be conducted in\naccordance with the rules.\nProvision of samples\n\n(2) A sample of blood for the purpose of an alcohol blood test under\nsection 35 or 36, or a body sample for the purpose of a prohibited\n\n\nAlcohol and drug tests  Part 5\n\nSection 39\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026\n\ndrug test under that section, is to be provided in accordance with\nthe rules.",
      "skos:definition": "with the rules\nConduct of tests\n\n(1) An alcohol screening test, alcohol breath test, alcohol blood test or\nprohibited drug test under section 34, 35 or 36 is to be conducted in\naccordance with the rules.\nProvision of samples\n\n(2) A sample of blood for the purpose of an alcohol blood test under\nsection 35 or 36, or a body sample for the purpose of a prohibited\n\n\nAlcohol and drug tests  Part 5\n\nSection 39\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026\n\ndrug test under that section, is to be provided in accordance with\nthe rules.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-38-ss-1"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-38-ss-2"
        }
      ],
      "cml:integrityHash": "abb41dd01091887ad80392e4553ca809c7e049678e1ba829416d121cdbfe27a6"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Conduct of tests and provision of samples to be in accordance",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "with the rules\nConduct of tests\n\n(1) An alcohol screening test, alcohol breath test, alcohol blood test or\nprohibited drug test under section 34, 35 or 36 is to be conducted in\naccordance with the rules.\nProvision of samples\n\n(2) A sample of blood for the purpose of an alcohol blood test under\nsection 35 or 36, or a body sample for the purpose of a prohibited\n\n\nAlcohol and drug tests  Part 5\n\nSection 39\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026\n\ndrug test under that section, is to be provided in accordance with\nthe rules."
    },
