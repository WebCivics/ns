      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-26-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "26(3) Directions—administration and control of the operations of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-26-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.26",
      "values:originalText": "(3) Without limiting subsection (2), essential qualifications may have\none or more of the following components:\n\n(a) physical or psychological health or fitness;\n\n(b) professional or technical qualifications;\n\n(c) learning and development requirements.\nReporting of serious misconduct or criminal activity",
      "skos:definition": "(3) Without limiting subsection (2), essential qualifications may have\none or more of the following components:\n\n(a) physical or psychological health or fitness;\n\n(b) professional or technical qualifications;\n\n(c) learning and development requirements.\nReporting of serious misconduct or criminal activity",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-26"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-26-ss-3-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-26-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eda303d7ce396b8131c7a9bf33b43134c58bdca987227f7f4221e9da2a153190",
      "skos:note": "Reporting of serious misconduct or criminal activity is required."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-26-ss-3",
      "@type": "cof:Section",
      "cof:title": "26(3) Directions—administration and control of the operations of the",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(3) Without limiting subsection (2), essential qualifications may have\none or more of the following components:\n\n(a) physical or psychological health or fitness;\n\n(b) professional or technical qualifications;\n\n(c) learning and development requirements.\nReporting of serious misconduct or criminal activity"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-26-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-26-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
