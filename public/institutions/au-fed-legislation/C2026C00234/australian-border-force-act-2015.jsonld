        }
      ],
      "cml:integrityHash": "233a3940cbba02109ffe723e8e8e533e4b6a432bb5e59c47a49d4ee0477a8050",
      "skos:note": "Must not engage in conduct inconsistent with oath or affirmation",
      "dc:references": [
        "sec-13(4)",
        "sec-15",
        "sec-28",
        "sec-29"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-24-ss-3",
      "@type": "cof:Section",
      "cof:title": "24(3) Oaths or affirmations by Immigration and Border Protection",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(3) An Immigration and Border Protection worker who has made and\nsubscribed an oath or affirmation under this section must not\nengage in conduct that is inconsistent with the oath or affirmation.\nNote:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (3) of this section."
    },
