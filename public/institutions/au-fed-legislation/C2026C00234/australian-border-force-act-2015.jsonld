      },
      "cml:operator": "Classifies",
      "cml:logicSummary": "Categorizes purposes for administration or enforcement",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
