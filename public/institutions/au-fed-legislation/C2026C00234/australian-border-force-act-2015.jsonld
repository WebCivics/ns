    {
      "@id": "concept:australian-border-force-act-2015-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Other terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.22",
      "values:originalText": "The Australian Border Force Commissioner holds office on the\nterms and conditions (if any) in relation to matters not covered by\nthis Act that are determined by the Minister.\n\n\nAustralian Border Force Commissioner  Part 2\nMinisterial directions  Division 5\n\nSection 23\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "skos:definition": "The Australian Border Force Commissioner holds office on the\nterms and conditions (if any) in relation to matters not covered by\nthis Act that are determined by the Minister.\n\n\nAustralian Border Force Commissioner  Part 2\nMinisterial directions  Division 5\n\nSection 23\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-22-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c0149f45bb1653ae9520e0e015150ffe3d005dc262c30b8fe90d321eec96a916",
      "skos:note": "The Australian Border Force Commissioner holds office on terms and conditions determined by the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Other terms and conditions",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "The Australian Border Force Commissioner holds office on the\nterms and conditions (if any) in relation to matters not covered by\nthis Act that are determined by the Minister.\n\n\nAustralian Border Force Commissioner  Part 2\nMinisterial directions  Division 5\n\nSection 23\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-22-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
