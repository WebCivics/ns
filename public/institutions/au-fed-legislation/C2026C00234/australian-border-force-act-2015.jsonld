      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Admissibility of test results etc. in legal proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.42",
      "values:originalText": "The following:\n\n(a) a certificate or other document recording the results of a test\nconducted under section 34, 35 or 36 in relation to an\nImmigration and Border Protection worker;\n\n(b) any other information, answer to a question or document\nrelevant to conducting such a test;\nare not admissible in evidence against the worker in any\nproceedings other than the following:\n\n(c) proceedings in relation to a decision of the Secretary to\nterminate the employment or engagement of the worker;\n\n(d) proceedings under the Safety, Rehabilitation and\nCompensation Act 1988;\n\n(e) proceedings in tort against the Commonwealth that are\ninstituted by the worker.\n\n\nSecrecy and disclosure provisions  Part 6\n\nSection 41\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "skos:definition": "The following:\n\n(a) a certificate or other document recording the results of a test\nconducted under section 34, 35 or 36 in relation to an\nImmigration and Border Protection worker;\n\n(b) any other information, answer to a question or document\nrelevant to conducting such a test;\nare not admissible in evidence against the worker in any\nproceedings other than the following:\n\n(c) proceedings in relation to a decision of the Secretary to\nterminate the employment or engagement of the worker;\n\n(d) proceedings under the Safety, Rehabilitation and\nCompensation Act 1988;\n\n(e) proceedings in tort against the Commonwealth that are\ninstituted by the worker.\n\n\nSecrecy and disclosure provisions  Part 6\n\nSection 41\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-40-norm"
        }
      ],
      "cml:integrityHash": "f945bdd36b79d82ed46982c011592f236f486e927c368ec6ca389e51ef43ea1b",
      "skos:note": "Exemptions from admissibility in certain proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-40",
      "@type": "cof:Section",
      "cof:title": "40 Admissibility of test results etc. in legal proceedings",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "The following:\n\n(a) a certificate or other document recording the results of a test\nconducted under section 34, 35 or 36 in relation to an\nImmigration and Border Protection worker;\n\n(b) any other information, answer to a question or document\nrelevant to conducting such a test;\nare not admissible in evidence against the worker in any\nproceedings other than the following:\n\n(c) proceedings in relation to a decision of the Secretary to\nterminate the employment or engagement of the worker;\n\n(d) proceedings under the Safety, Rehabilitation and\nCompensation Act 1988;\n\n(e) proceedings in tort against the Commonwealth that are\ninstituted by the worker.\n\n\nSecrecy and disclosure provisions  Part 6\n\nSection 41\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-40-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-40"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
