      "cml:premiseText": "(a) The making of the record, or disclosure, is for the purposes of this Act."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-43-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Permission to disclose Immigration and Border Protection information under other Acts",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) The making of the record, or disclosure, is for the purposes of the National Anti-Corruption Commission Act 2022."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-43-logic-deontic-5",
