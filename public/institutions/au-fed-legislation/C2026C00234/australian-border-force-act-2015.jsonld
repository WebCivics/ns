    {
      "@id": "concept:australian-border-force-act-2015-sec-24-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "24(3) Oaths or affirmations by Immigration and Border Protection",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-24-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.24",
      "values:originalText": "(3) An Immigration and Border Protection worker who has made and\nsubscribed an oath or affirmation under this section must not\nengage in conduct that is inconsistent with the oath or affirmation.\nNote:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (3) of this section.",
      "skos:definition": "(3) An Immigration and Border Protection worker who has made and\nsubscribed an oath or affirmation under this section must not\nengage in conduct that is inconsistent with the oath or affirmation.\nNote:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (3) of this section.",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-24"
      },
      "cml:asserts": [
        {
