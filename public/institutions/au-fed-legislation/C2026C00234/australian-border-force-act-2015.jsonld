      "skos:note": "Resignation takes effect on specified day or immediately upon receipt by Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-20-ss-2",
      "@type": "cof:Section",
      "cof:title": "20(2) Resignation of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 21,
      "values:originalText": "(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day."
