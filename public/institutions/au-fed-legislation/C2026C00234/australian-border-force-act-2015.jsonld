      "skos:note": "Extraterritorial application obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Extraterritorial application",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "This Act extends to acts, omissions, matters and things outside\nAustralia."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-7-norm",
