      "dc:source": "australian-border-force-act-2015.pdf, p.21",
      "values:originalText": "(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day.",
      "skos:definition": "(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day.",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-20"
      },
      "cml:asserts": [
