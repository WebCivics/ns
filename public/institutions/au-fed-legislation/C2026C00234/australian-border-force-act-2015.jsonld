    {
      "@id": "concept:australian-border-force-act-2015-sec-56-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "56(4) Directions by Secretary—performance of functions or exercise of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-56-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.58",
      "values:originalText": "(4) An Immigration and Border Protection worker must comply with a\ndirection under this section.\n\n\nOther matters  Part 7\n\nSection 57\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026\n\nNote 1:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (4) of this section.\nNote 2:\nSee section 57 of this Act for the termination of a person’s\nengagement as a consultant or contractor, or for the arranging of a\nperson to cease to perform services for the Department, if the person\ndoes not comply with subsection (4) of this section.\nDirections are not legislative instruments",
      "skos:definition": "(4) An Immigration and Border Protection worker must comply with a\ndirection under this section.\n\n\nOther matters  Part 7\n\nSection 57\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026\n\nNote 1:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (4) of this section.\nNote 2:\nSee section 57 of this Act for the termination of a person’s\nengagement as a consultant or contractor, or for the arranging of a\nperson to cease to perform services for the Department, if the person\ndoes not comply with subsection (4) of this section.\nDirections are not legislative instruments",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-56"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-56-ss-4-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-56-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3c3cdd1d9b09ebbf38766ba6561420a4289baad2204a71363bcefd94aa169084",
      "skos:note": "Must comply with a direction under this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-56-ss-4",
      "@type": "cof:Section",
      "cof:title": "56(4) Directions by Secretary—performance of functions or exercise of",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(4) An Immigration and Border Protection worker must comply with a\ndirection under this section.\n\n\nOther matters  Part 7\n\nSection 57\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026\n\nNote 1:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (4) of this section.\nNote 2:\nSee section 57 of this Act for the termination of a person’s\nengagement as a consultant or contractor, or for the arranging of a\nperson to cease to perform services for the Department, if the person\ndoes not comply with subsection (4) of this section.\nDirections are not legislative instruments"
    },
