      },
      "dc:source": "australian-border-force-act-2015.pdf, p.15",
      "values:originalText": "This Act extends to acts, omissions, matters and things outside\nAustralia.",
      "skos:definition": "This Act extends to acts, omissions, matters and things outside\nAustralia.",
