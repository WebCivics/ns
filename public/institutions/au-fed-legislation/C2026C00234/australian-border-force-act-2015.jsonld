    {
      "@id": "concept:australian-border-force-act-2015-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.33",
      "values:originalText": "•\nIf the Secretary terminates the employment of an APS\nemployee in the Department and the Secretary or the\nAustralian Border Force Commissioner reasonably believes\nthat the employee’s conduct or behaviour amounts to serious\nmisconduct, the Secretary or the Commissioner may make a\ndeclaration to that effect.\n•\nThe effect of the declaration is that provisions of the Fair\nWork Act 2009 dealing with unfair dismissal, and notice of\ntermination or payment in lieu, will not apply to the APS\nemployee.",
      "skos:definition": "•\nIf the Secretary terminates the employment of an APS\nemployee in the Department and the Secretary or the\nAustralian Border Force Commissioner reasonably believes\nthat the employee’s conduct or behaviour amounts to serious\nmisconduct, the Secretary or the Commissioner may make a\ndeclaration to that effect.\n•\nThe effect of the declaration is that provisions of the Fair\nWork Act 2009 dealing with unfair dismissal, and notice of\ntermination or payment in lieu, will not apply to the APS\nemployee.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-31-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-31-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3aa13104b363faf2ffd6452a40df062e83cdef1339a6261c6a5538e686ce299f",
      "skos:note": "No application of Fair Work Act provisions for APS employee after declaration."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "•\nIf the Secretary terminates the employment of an APS\nemployee in the Department and the Secretary or the\nAustralian Border Force Commissioner reasonably believes\nthat the employee’s conduct or behaviour amounts to serious\nmisconduct, the Secretary or the Commissioner may make a\ndeclaration to that effect.\n•\nThe effect of the declaration is that provisions of the Fair\nWork Act 2009 dealing with unfair dismissal, and notice of\ntermination or payment in lieu, will not apply to the APS\nemployee."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-31-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-31"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-31-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits application of Fair Work Act provisions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Termination of employment for serious misconduct",
