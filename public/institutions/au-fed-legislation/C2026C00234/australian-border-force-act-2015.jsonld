    {
      "@id": "concept:australian-border-force-act-2015-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Resignation of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.21",
      "values:originalText": "(1) The Australian Border Force Commissioner may resign his or her\nappointment by giving the Governor-General a written resignation.\n\n(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day.",
      "skos:definition": "(1) The Australian Border Force Commissioner may resign his or her\nappointment by giving the Governor-General a written resignation.\n\n(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-20-ss-1"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-20-ss-2"
        }
      ],
      "cml:integrityHash": "44c6301f3ed0d72507a05f30148c376c26d9a409f0a5c7056a1e33abe7e4542d"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Resignation of appointment",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "(1) The Australian Border Force Commissioner may resign his or her\nappointment by giving the Governor-General a written resignation.\n\n(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day."
    },
