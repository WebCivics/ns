    {
      "@id": "concept:australian-border-force-act-2015-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Disclosure of publicly available information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-49"
      },
      "cml:curationStatus": {
