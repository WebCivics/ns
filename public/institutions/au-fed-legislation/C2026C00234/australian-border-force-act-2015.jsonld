      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The function is performed or power is exercised under a delegation.",
      "cml:conclusionText": "Is during the period when the law referred to in subsection (1) applies."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-54-ss-6-logic-ltl-3",
