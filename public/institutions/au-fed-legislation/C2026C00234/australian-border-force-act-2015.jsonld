        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-55-ss-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f4ccad81004e986aa191dabc53aa5c0e011475c01f747e52c63b006615a3dedb",
      "skos:note": "Must provide information, answer question, or produce document under certain conditions.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-55-ss-10",
      "@type": "cof:Section",
      "cof:title": "55(10) Directions by Secretary—administration and control of the",
      "values:kind": "subsection",
      "cof:pageNumber": 56,
      "values:originalText": "(10) If an Immigration and Border Protection worker is required by a\ndirection of the kind mentioned in subsection (5) to give\ninformation, answer a question or produce a document, the worker\nis not excused from:\n\n(a) giving the information; or\n\n(b) answering the question; or"
    },
