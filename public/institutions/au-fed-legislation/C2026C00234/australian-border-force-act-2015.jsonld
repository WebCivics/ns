        }
      ],
      "cml:integrityHash": "d18110c249615624828bf12265a4112c6bd15627e2bb54d6565d573f91cd4522"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-58",
