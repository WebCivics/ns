      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-47-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
