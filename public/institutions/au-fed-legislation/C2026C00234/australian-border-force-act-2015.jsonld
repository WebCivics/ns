    {
      "@id": "concept:australian-border-force-act-2015-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Outside work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.20",
      "values:originalText": "The Australian Border Force Commissioner must not engage in\npaid work outside the duties of his or her office without the\nMinister’s approval.",
      "skos:definition": "The Australian Border Force Commissioner must not engage in\npaid work outside the duties of his or her office without the\nMinister’s approval.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-18-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa7b88d936bbf7125df040d90f14713a6875b78db78cda2cc66e8620acbcf1f2",
      "skos:note": "Must not engage in paid work outside office duties without approval."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Outside work",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "The Australian Border Force Commissioner must not engage in\npaid work outside the duties of his or her office without the\nMinister’s approval."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-18-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
