    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-55-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "55(3) Directions by Secretary—administration and control of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-55-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
