    {
      "@id": "concept:australian-border-force-act-2015-sec-24-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "24(4) Oaths or affirmations by Immigration and Border Protection",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-24-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.24",
      "values:originalText": "(4) Subsection (3) extends to an Immigration and Border Protection\nworker who has made and subscribed an oath or affirmation under\nthis section but who is no longer a person mentioned in\nparagraph (1)(a) or (b).\n\n\nAustralian Border Force Commissioner  Part 2\nDelegation and directions  Division 7\n\nSection 25\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "skos:definition": "(4) Subsection (3) extends to an Immigration and Border Protection\nworker who has made and subscribed an oath or affirmation under\nthis section but who is no longer a person mentioned in\nparagraph (1)(a) or (b).\n\n\nAustralian Border Force Commissioner  Part 2\nDelegation and directions  Division 7\n\nSection 25\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-24"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-24-ss-4-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-24-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "088bdfc963627abf7418d9a80a65dff740b778a2d8efe6a6a5477f30d17e4436",
      "skos:note": "Oath or affirmation by Immigration and Border Protection worker"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-24-ss-4",
      "@type": "cof:Section",
      "cof:title": "24(4) Oaths or affirmations by Immigration and Border Protection",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(4) Subsection (3) extends to an Immigration and Border Protection\nworker who has made and subscribed an oath or affirmation under\nthis section but who is no longer a person mentioned in\nparagraph (1)(a) or (b).\n\n\nAustralian Border Force Commissioner  Part 2\nDelegation and directions  Division 7\n\nSection 25\n\nAustralian Border Force Act 2015\n\nCompilation date: 04/06/2026"
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-24-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
