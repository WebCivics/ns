    {
      "@id": "concept:australian-border-force-act-2015-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.30",
      "values:originalText": "•\nAn APS employee in the Department must give at least 14\ndays’ notice of his or her resignation from the Department.\n•\nIf an APS employee in the Department resigns in\ncircumstances where the employee may have engaged in\nserious misconduct, the Secretary or the Australian Border\nForce Commissioner may delay the employee’s resignation by\nup to 90 days to allow further investigation of that conduct.",
      "skos:definition": "•\nAn APS employee in the Department must give at least 14\ndays’ notice of his or her resignation from the Department.\n•\nIf an APS employee in the Department resigns in\ncircumstances where the employee may have engaged in\nserious misconduct, the Secretary or the Australian Border\nForce Commissioner may delay the employee’s resignation by\nup to 90 days to allow further investigation of that conduct.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-28-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-28-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d7f5b9507f3b6d950cd39dc3ddaa571cb76233b3444dd56c48c4eeb2f14b75d0",
      "skos:note": "Must give at least 14 days' notice of resignation.",
      "dc:description": "Notice period"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "•\nAn APS employee in the Department must give at least 14\ndays’ notice of his or her resignation from the Department.\n•\nIf an APS employee in the Department resigns in\ncircumstances where the employee may have engaged in\nserious misconduct, the Secretary or the Australian Border\nForce Commissioner may delay the employee’s resignation by\nup to 90 days to allow further investigation of that conduct."
    },
