    {
      "@id": "concept:australian-border-force-act-2015-sec-26-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "26(5) Directions—administration and control of the operations of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-26-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-act-2015.pdf"
      },
      "dc:source": "australian-border-force-act-2015.pdf, p.26",
      "values:originalText": "(5) A person mentioned in paragraph (1)(a) or (b) must comply with a\ndirection under this section.\nNote 1:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (5) of this section.\nNote 2:\nSee section 57 of this Act for the termination of a person’s\nengagement as a consultant or contractor, or for the arranging of a\nperson to cease to perform services for the Department, if the person\ndoes not comply with subsection (5) of this section.\nDirections are not legislative instruments",
      "skos:definition": "(5) A person mentioned in paragraph (1)(a) or (b) must comply with a\ndirection under this section.\nNote 1:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (5) of this section.\nNote 2:\nSee section 57 of this Act for the termination of a person’s\nengagement as a consultant or contractor, or for the arranging of a\nperson to cease to perform services for the Department, if the person\ndoes not comply with subsection (5) of this section.\nDirections are not legislative instruments",
      "values:partOf": {
        "@id": "concept:australian-border-force-act-2015-sec-26"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-act-2015-sec-26-ss-5-norm"
        },
        {
          "@id": "concept:australian-border-force-act-2015-sec-26-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b87a505f2c6af03c2fa21c35c824a893ac0c5bf91670ced49db78213568287a0",
      "skos:note": "Must comply with a direction under this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-26-ss-5",
      "@type": "cof:Section",
      "cof:title": "26(5) Directions—administration and control of the operations of the",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(5) A person mentioned in paragraph (1)(a) or (b) must comply with a\ndirection under this section.\nNote 1:\nSee subsection 13(4) and sections 15, 28 and 29 of the Public Service\nAct 1999 for the consequences of an APS employee in the Department\nnot complying with subsection (5) of this section.\nNote 2:\nSee section 57 of this Act for the termination of a person’s\nengagement as a consultant or contractor, or for the arranging of a\nperson to cease to perform services for the Department, if the person\ndoes not comply with subsection (5) of this section.\nDirections are not legislative instruments"
    },
