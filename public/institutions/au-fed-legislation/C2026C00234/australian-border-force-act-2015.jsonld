        }
      ],
      "cml:integrityHash": "f4174f545740a01825f17561d3c254dc11b9cca24a2f68052b8afcdaf70921d8",
      "skos:note": "Workers may be required to undergo alcohol screening tests"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "•\nImmigration and Border Protection workers may be required\nto undergo an alcohol screening test, an alcohol breath test, an\nalcohol blood test or a prohibited drug test."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-33-norm",
