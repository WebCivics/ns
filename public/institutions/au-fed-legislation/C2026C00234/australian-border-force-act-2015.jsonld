    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-54-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "takes effect",
      "cml:logicSummary": "Effect of delegation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A function performed by an Immigration and Border Protection worker under a delegation.",
      "cml:conclusionText": "Is taken to have been performed or exercised by the Comptroller-General of Customs."
    },
    {
      "@id": "concept:australian-border-force-act-2015-sec-54-ss-6-logic-alleninterval-2",
