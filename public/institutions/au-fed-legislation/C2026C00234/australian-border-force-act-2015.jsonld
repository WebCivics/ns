    {
      "@id": "concept:australian-border-force-act-2015-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Application of finance law",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-act-2015#sec-15"
      },
      "cml:curationStatus": {
