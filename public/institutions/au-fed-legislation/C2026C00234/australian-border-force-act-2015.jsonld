          "@id": "concept:australian-border-force-act-2015-sec-55-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f5cfa1a6a148a0c05245e2ba53f5cd07764f0f7ec94cfe39abb9220777dc9d01",
      "skos:note": "Directions for reporting serious misconduct or criminal activity by Immigration and Border Protection workers"
    },
    {
