      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "The person was present in Australia for at least 480 days during the 4-year period."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-22b-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is eligible for Australian citizenship.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
