      "cml:logicSummary": "The applicant's presence in Australia overlaps with a certain time period.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The applicant was present in Australia for a total of at least 90 days during the period of 12 months immediately before the day the applicant made the application."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the applicant needs to be an Australian citizen in order to engage in that activity.",
