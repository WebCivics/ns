    {
      "@id": "concept:australian-citizenship-act-2007-sec-16-2-ss-2",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-act-2007.pdf, p.27",
      "skos:note": "Eligibility for citizenship based on parent's Australian citizenship and residency.",
      "skos:prefLabel": {
