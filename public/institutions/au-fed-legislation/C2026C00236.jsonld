    {
      "@id": "concept:australian-citizenship-act-2007-sec-44-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-act-2007.pdf, p.89",
      "skos:note": "Unauthorized modification or impairment of identifying information is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "44(1) Unauthorised modification or impairment of identifying"
      },
      "wasDerivedFrom": "australian-citizenship-act-2007.pdf",
      "asserts": [
        "concept:australian-citizenship-act-2007-sec-44-ss-1-norm",
        "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-deontic-1",
        "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-alleninterval-2",
        "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-ltl-3",
        "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-diffusion-4",
        "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9a013bdffd7dd64b4382e2725c39ef17c60a940ae3f4dc42c8a17a473d4efe0f",
      "cml:proposedBy": {
