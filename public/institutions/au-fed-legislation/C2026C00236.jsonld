      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The period of confinement in prison or psychiatric institution does not include a period during which the person has been so confined by reason only of the person serving a sentence relating to a conviction that is later quashed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
