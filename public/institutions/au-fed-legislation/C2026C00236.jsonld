      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Grants citizens reciprocal rights.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:premiseText": "Australian citizenship is a common bond involving reciprocal rights and obligations"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the Parliament recognises that Australian citizenship is a common bond, involving reciprocal rights and obligations, and that citizens may, through certain conduct incompatible with the shared values of the Australian community, demonstrate that they have severed that bond and repudiated their allegiance to Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
