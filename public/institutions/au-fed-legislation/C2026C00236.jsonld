      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Database is a discrete body of information.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "(5) For the purposes of this section, a database is a discrete body of information stored by electronic means, containing:  (a) indexes of persons who have provided personal identifiers in accordance with a request under this Division; and  (b) their identifying information."
    },
