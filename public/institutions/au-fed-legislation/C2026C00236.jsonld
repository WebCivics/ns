    {
      "@id": "concept:australian-citizenship-act-2007-sec-9-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The period during which a person is confined in a psychiatric institution by order of a court overlaps with the period during which the person is an escapee from the institution.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation between institutional confinement and being an escapee",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:premiseText": "(3) For the purposes of this Act, the period during which a person is confined in a psychiatric institution by order of a court includes a period during which the person is an escapee from the institution."
    },
