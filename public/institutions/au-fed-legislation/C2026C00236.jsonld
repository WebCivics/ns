      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision defines a temporal interval for committing the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The provision specifies a temporal interval for committing the offence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The provision states that the act or omission must occur before the Minister gives approval."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-145-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the applicant is not approved, they cannot commit the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "The provision implies a causal relationship between the Minister's approval and the commission of the offence.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "If the applicant is approved, they can commit the offence."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-145-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision defines a necessary condition for committing an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The provision describes a concept related to citizenship and approval.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The provision states that the act or omission must be connected with the Minister's approval."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-145-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The applicant cannot commit the offence until approved.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Minister has an obligation to approve the applicant.",
