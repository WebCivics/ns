    {
      "@id": "concept:australian-citizenship-act-2007-sec-42-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits accessing identifying information without authorization.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person accesses identifying information; and (b) the person is not authorised under this section to access the identifying information for the purpose for which the person accessed it."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-42-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires authorization to access identifying information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Authorization",
      "cml:premiseText": "(a) the person accesses identifying information; and (b) the person is not authorised under this section to access the identifying information for the purpose for which the person accessed it."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-42-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The penalty is Imprisonment for 2 years, or 120 penalty units, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the consequence of accessing identifying information without authorization.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Consequence",
      "cml:premiseText": "(a) the person accesses identifying information; and (b) the person is not authorised under this section to access the identifying information for the purpose for which the person accessed it."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-42-ss-1-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implies that accessing identifying information without authorization is an offence.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(a) the person accesses identifying information; and (b) the person is not authorised under this section to access the identifying information for the purpose for which the person accessed it."
    },
