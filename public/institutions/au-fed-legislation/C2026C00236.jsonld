      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person's work occurred within a specific time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
