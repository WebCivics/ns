        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The applicant must be an Australian citizen.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:premiseText": "The applicant is seeking to engage in an activity specified under subsection 22C(1)."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the applicant must have been present in Australia for at least 180 days during the period of 2 years immediately before the day the applicant made the application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The applicant must have been present in Australia for a certain period of time.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:premiseText": "The applicant was seeking to engage in an activity specified under subsection 22C(1)."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the applicant must not have been present in Australia as an unlawful non-citizen at any time during the period of 2 years immediately before the day the applicant made the application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The applicant must not be an unlawful non-citizen.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:premiseText": "The applicant was seeking to engage in an activity specified under subsection 22C(1)."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the applicant was present in Australia repeatedly during the period of 2 years immediately before the day the applicant made the application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The applicant was present in Australia repeatedly during a certain time period.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:premiseText": "The applicant was present in Australia for a total of at least 180 days during the period of 2 years immediately before the day the applicant made the application."
    },
