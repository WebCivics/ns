    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The modification of identifying information overlaps with the concept of an offence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person causes any unauthorised modification of identifying information; and  (b) the person intends to cause the modification; and  (c) the person knows that the modification is unauthorised."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
