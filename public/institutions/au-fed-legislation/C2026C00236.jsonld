      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "b93c3910071b6c500f57d6958339bf2ca45dceb39c65743280f970921d3ffdba",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-act-2007#sec-16-2-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:australian-citizenship-act-2007-sec-16-2"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The parent has been present in Australia for at least 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Parent's residency in Australia for at least 2 years.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(ii) the parent has been present in Australia (except as an unlawful non-citizen) for a total period of at least 2 years at any time before the person made the application;"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The parent is an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Parent must be an Australian citizen.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "(a) a parent of the person was an Australian citizen at the time of the birth;"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The parent has been present in Australia for at least 2 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Parent must have been present in Australia for at least 2 years.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "(ii) the parent has been present in Australia (except as an unlawful non-citizen) for a total period of at least 2 years at any time before the person made the application;"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is not a national or citizen of any country.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Person must not be a national or citizen of any country.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "(ii) the person is not a national or a citizen of any country at the time the person made the application and the person has never been such a national or citizen;"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister is satisfied that the person is of good character.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Person must be of good character.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "(c) if the person is or has ever been a national or citizen of any country, or if article 1(2)(iii) of the Stateless Persons Convention applies to the person, and the person is aged 18 or over at the time the person made the application—the Minister is satisfied that the person is of good character at the time of the Minister’s decision on the application."
    },
