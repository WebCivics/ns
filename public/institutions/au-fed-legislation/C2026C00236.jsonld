      },
      "cml:operator": "Exclusion",
      "cml:premiseText": "(2) For the purposes of this Act, the period during which a person is confined to a prison does not include a period during which the person has been so confined by reason only of the person serving a sentence relating to a conviction that is later quashed."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-9-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exclusion principle diffuses to related convictions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
