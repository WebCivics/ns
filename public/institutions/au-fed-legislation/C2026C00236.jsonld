      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The prohibition of unauthorized modification or impairment diffuses to all entities that can be modified.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person causes any unauthorised modification of identifying information; and  (b) the person intends to cause the modification; and  (c) the person knows that the modification is unauthorised."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-44-ss-1-logic-ltl-3",
