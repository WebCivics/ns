    {
      "@id": "concept:australian-citizenship-act-2007-sec-2a",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-act-2007.pdf, p.8",
      "skos:note": "You become an Australian citizen automatically if you are born in Australia and one or both of your parents are Australian citizens or permanent residents when you are born.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "2A Simplified outline"
      },
      "wasDerivedFrom": "australian-citizenship-act-2007.pdf",
      "asserts": [
        "concept:australian-citizenship-act-2007-sec-2a-norm",
        "concept:australian-citizenship-act-2007-sec-2a-logic-deontic-1",
        "concept:australian-citizenship-act-2007-sec-2a-logic-alleninterval-2",
        "concept:australian-citizenship-act-2007-sec-2a-logic-deontic-3",
        "concept:australian-citizenship-act-2007-sec-2a-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d995c7da238a2abcaa7cfa3f5786deab395959b0efb396f52b2e44b26dd3063f",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-act-2007#sec-2a",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-2a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "You are born before the commencement date.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "You must be born before the commencement date to acquire citizenship automatically.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The section commences on 04/06/2026."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "You become an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "You must be born in Australia and have one or both parents as Australian citizens or permanent residents to become a citizen automatically.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "You are born in Australia."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-2a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "You can apply for citizenship by conferral.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "You must be a permanent resident and willing to make a pledge of commitment to apply for citizenship by conferral.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "You need to be a permanent resident."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-2a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "You can apply for citizenship by conferral.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "You must successfully complete a citizenship test to apply for citizenship by conferral.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "You need to be willing to make a pledge of commitment."
    },
