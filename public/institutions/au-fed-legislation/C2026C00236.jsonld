      "skos:note": "No pledge of commitment can be made before approval by the Minister.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "26(2) Pledge of commitment must be made"
      },
      "wasDerivedFrom": "australian-citizenship-act-2007.pdf",
