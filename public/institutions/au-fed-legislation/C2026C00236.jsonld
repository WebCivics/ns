      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A pledge of commitment made by the person before that time is of no effect.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
