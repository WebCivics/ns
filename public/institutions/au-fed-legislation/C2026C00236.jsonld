    {
      "@id": "concept:australian-citizenship-act-2007-sec-17-ss-4b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(4B) A person is covered by this subsection if:  (a) at the time the person made the application under section 16, the person:  (i) is not a national of any country; and  (ii) is not a citizen of any country; and  (b) at the time of the person’s birth, the person had a parent who was an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Citizenship condition for application under section 16",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-and-only-if",
      "cml:premiseText": "(4B) A person is covered by this subsection if:  (a) at the time the person made the application under section 16, the person:  (i) is not a national of any country; and  (ii) is not a citizen of any country; and  (b) at the time of the person’s birth, the person had a parent who was an Australian citizen."
    },
