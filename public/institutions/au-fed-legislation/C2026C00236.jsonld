      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-act-2007.pdf, p.19",
      "skos:note": "Institutional confinement includes time spent as an escapee.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "9(3) Confinement in prison or psychiatric institution"
      },
