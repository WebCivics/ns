        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:premiseText": "(b) the person is ordinarily resident in Australia throughout the period of 10 years beginning on the day the person is born."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-12-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A person born in Australia is an Australian citizen if and only if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
