    cml:premiseText "(a) fingerprints or handprints of a person (including those taken using paper and ink or digital livescanning technologies);" ;
    cml:conclusionText "...(f) any other identifier prescribed by the regulations (except an identifier the obtaining of which would involve the carrying out of an intimate forensic procedure within the meaning of section 23WA of the Crimes Act 1914)." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

