concept:australian-citizenship-act-2007-sec-36b-ss-4 a cml:Concept ;
    skos:prefLabel "36B(4) Cessation of citizenship if citizenship cessation order made by"@en ;
    cml:realizedBy doc:sec-36b-ss-4 ;
    values:originalText "(4) If:  (a) a decision (the first decision) of a court overturning or quashing the order made under subsection 36C(1) in relation to the person is appealed; and  (b) the decision (the second decision) on appeal overturns or quashes the first decision; the person ceases to be an Australian citizen at the time the second decision is made." ;
    skos:definition "(4) If:  (a) a decision (the first decision) of a court overturning or quashing the order made under subsection 36C(1) in relation to the person is appealed; and  (b) the decision (the second decision) on appeal overturns or quashes the first decision; the person ceases to be an Australian citizen at the time the second decision is made."@en ;
    cml:integrityHash "f6d7c39473fd0472643435efba9daebc0d73399a30f0adf169607d458f67198d" ;
    values:partOf concept:australian-citizenship-act-2007-sec-36b ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Ceases to be an Australian citizen if decisions overturn or quash citizenship cessation order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.76" ;
