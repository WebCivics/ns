doc:sec-36d-ss-1 a cof:Section ;
    cof:title "36D(1) Application by the Minister for a citizenship cessation order" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may make an application for an order to be made by a court under subsection 36C(1) in relation to a person." ;
    cof:pageNumber "80"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-36d-ss-2 a cml:Concept ;
