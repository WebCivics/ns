doc:sec-53-ss-1 a cof:Section ;
    cof:title "53(1) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may, by writing, delegate to any person all or any of the Minister’s functions or powers under this Act or the regulations." ;
    cof:pageNumber "103"^^xsd:integer .

