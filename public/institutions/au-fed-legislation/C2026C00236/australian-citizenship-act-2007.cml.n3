concept:australian-citizenship-act-2007-sec-39 a cml:Concept ;
    skos:prefLabel "39 Altering evidentiary notice"@en ;
    cml:realizedBy doc:sec-39 ;
    values:originalText "A person commits an offence if:  (a) the person alters, or causes or permits to be altered, a notice; and  (b) the notice was given to a person under section 37. Penalty: Imprisonment for 12 months.   Australian citizenship  Part 2 Personal identifiers  Division 5  Section 40  Australian Citizenship Act 2007  Compilation date: 04/06/2026" ;
    skos:definition "A person commits an offence if:  (a) the person alters, or causes or permits to be altered, a notice; and  (b) the notice was given to a person under section 37. Penalty: Imprisonment for 12 months.   Australian citizenship  Part 2 Personal identifiers  Division 5  Section 40  Australian Citizenship Act 2007  Compilation date: 04/06/2026"@en ;
    cml:integrityHash "654bf5819ab4a65a8e383d4ca19258089aa603bda570f454d669f42cd0bfd9ed" ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Altering evidentiary notice is prohibited." ;
