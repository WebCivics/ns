doc:sec-36b-ss-3 a cof:Section ;
    cof:title "36B(3) Cessation of citizenship if citizenship cessation order made by" ;
    values:kind "subsection" ;
    values:originalText "(3) The validity of anything done in reliance on the order made under subsection 36C(1) before the order was overturned or quashed is not affected. Appeal decision" ;
