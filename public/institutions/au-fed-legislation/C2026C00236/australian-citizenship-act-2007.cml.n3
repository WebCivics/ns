doc:sec-45d-ss-1 a cof:Section ;
    cof:title "45D(1) Dealing with a document after it is condemned as forfeited" ;
    values:kind "subsection" ;
    values:originalText "(1) If, under section 45C, a document is condemned as forfeited to the Commonwealth, it must be dealt with or disposed of (including by being given to another person) in accordance with any direction given by the Minister." ;
    cof:pageNumber "94"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-45d-ss-2 a cml:Concept ;
    skos:prefLabel "45D(2) Dealing with a document after it is condemned as forfeited"@en ;
    cml:realizedBy doc:sec-45d-ss-2 ;
    values:originalText "(2) If the Minister considers that the document may be relevant to proceedings in a court or tribunal, then the Minister:  (a) must give a direction for the safe keeping of the document; and  (b) must authorise access to the document for the purposes of those proceedings." ;
    skos:definition "(2) If the Minister considers that the document may be relevant to proceedings in a court or tribunal, then the Minister:  (a) must give a direction for the safe keeping of the document; and  (b) must authorise access to the document for the purposes of those proceedings."@en ;
