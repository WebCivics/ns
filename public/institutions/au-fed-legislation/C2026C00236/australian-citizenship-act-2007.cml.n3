doc:sec-30-ss-2 a cof:Section ;
    cof:title "30(2) Minister’s decision" ;
    values:kind "subsection" ;
    values:originalText "(2) The Minister may refuse to approve the person becoming an Australian citizen again despite the person being eligible to become an Australian citizen again under subsection 29(2) or (3). Identity" ;
    cof:pageNumber "65"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-30-ss-3 a cml:Concept ;
    skos:prefLabel "30(3) Minister’s decision"@en ;
    cml:realizedBy doc:sec-30-ss-3 ;
    values:originalText "(3) The Minister must not approve the person becoming an Australian citizen again unless the Minister is satisfied of the identity of the person. Note: Division 5 contains the identity provisions." ;
    skos:definition "(3) The Minister must not approve the person becoming an Australian citizen again unless the Minister is satisfied of the identity of the person. Note: Division 5 contains the identity provisions."@en ;
