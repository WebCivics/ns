concept:australian-citizenship-act-2007-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Form of pledge no. 1"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "From this time forward, under God, I pledge my loyalty to Australia and its people, whose democratic beliefs I share, whose rights and liberties I respect, and whose laws I will uphold and obey." ;
