doc:sec-47-ss-1 a cof:Section ;
    cof:title "47(1) Notification of decisions" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Minister makes a decision under this Act in relation to a person, the Minister must give the person notice of the decision. Child" ;
    cof:pageNumber "96"^^xsd:integer .

