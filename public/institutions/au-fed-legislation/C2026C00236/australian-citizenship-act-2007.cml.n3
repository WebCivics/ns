doc:sec-9-ss-1 a cof:Section ;
    cof:title "9(1) Confinement in prison or psychiatric institution" ;
    values:kind "subsection" ;
    values:originalText "(1) For the purposes of this Act, the period during which a person is confined to a prison includes a period:  (a) during which the person is an escapee from the prison; or  (b) during which the person is undergoing a sentence of periodic detention in the prison." ;
    cof:pageNumber "19"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-9-ss-2 a cml:Concept ;
    skos:prefLabel "9(2) Confinement in prison or psychiatric institution"@en ;
    cml:realizedBy doc:sec-9-ss-2 ;
    values:originalText "(2) For the purposes of this Act, the period during which a person is confined to a prison does not include a period during which the person has been so confined by reason only of the person serving a sentence relating to a conviction that is later quashed. Confinement in psychiatric institution" ;
    skos:definition "(2) For the purposes of this Act, the period during which a person is confined to a prison does not include a period during which the person has been so confined by reason only of the person serving a sentence relating to a conviction that is later quashed. Confinement in psychiatric institution"@en ;
    cml:integrityHash "49c9f2e7cb78cd1777cc595959d56f3294e45a4f12e205fb3957b446acdc7f8f" ;
    values:partOf concept:australian-citizenship-act-2007-sec-9 ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Exclusion of quashed conviction from prison confinement period" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.19" ;
    cml:asserts concept:australian-citizenship-act-2007-sec-9-ss-2-norm .
