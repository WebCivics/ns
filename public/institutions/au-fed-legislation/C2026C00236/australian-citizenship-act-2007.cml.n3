    cml:hasPart concept:australian-citizenship-act-2007-sec-26-3-ss-4 ;
    cml:hasPart concept:australian-citizenship-act-2007-sec-26-3-ss-5 ;
    cml:hasPart concept:australian-citizenship-act-2007-sec-26-3-ss-6 ;
