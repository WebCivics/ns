concept:australian-citizenship-act-2007-sec-15a a cml:Concept ;
    skos:prefLabel "15A Simplified outline"@en ;
    cml:realizedBy doc:sec-15a ;
    values:originalText "The following is a simplified outline of this Subdivision: You may be eligible to become an Australian citizen under this Subdivision in 2 situations: • you were born outside Australia on or after 26 January 1949 and a parent of yours was an Australian citizen at the time of your birth: see subsection 16(2); or • you were born outside Australia or New Guinea before" ;
    skos:definition "The following is a simplified outline of this Subdivision: You may be eligible to become an Australian citizen under this Subdivision in 2 situations: • you were born outside Australia on or after 26 January 1949 and a parent of yours was an Australian citizen at the time of your birth: see subsection 16(2); or • you were born outside Australia or New Guinea before"@en ;
    cml:integrityHash "2716b533386238fe13bf129b95febb8a5547d4c28ecb850af7bcb85923e9498a" ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Eligibility for Australian citizenship under Subdivision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.26" ;
