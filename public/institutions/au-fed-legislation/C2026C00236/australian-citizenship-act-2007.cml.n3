    values:partOf concept:australian-citizenship-act-2007-sec-17 ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Minister cannot approve person becoming Australian citizen during specified period after ceasing citizenship." ;
    cml:curationStatus cml:Proposed ;
