doc:sec-17-ss-2 a cof:Section ;
    cof:title "17(2) Minister’s decision" ;
    values:kind "subsection" ;
    values:originalText "(2) Subject to this section, the Minister must approve the person becoming an Australian citizen if the person is eligible to become an Australian citizen under subsection 16(2) or (3). Identity" ;
    cof:pageNumber "28"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-17-ss-3 a cml:Concept ;
    skos:prefLabel "17(3) Minister’s decision"@en ;
    cml:realizedBy doc:sec-17-ss-3 ;
