doc:sec-36b-ss-2 a cof:Section ;
    cof:title "36B(2) Cessation of citizenship if citizenship cessation order made by" ;
    values:kind "subsection" ;
    values:originalText "(2) If a decision of a court overturns or quashes the order made under subsection 36C(1), the person’s citizenship is taken never to have ceased under subsection (1) of this section." ;
