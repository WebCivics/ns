doc:sec-16-2-ss-2 a cof:Section ;
    cof:title "16(2) Application and eligibility for citizenship" ;
    values:kind "subsection" ;
    values:originalText "(2) A person born outside Australia on or after 26 January 1949 is eligible to become an Australian citizen if:  (a) a parent of the person was an Australian citizen at the time of the birth; and  (b) if the parent was an Australian citizen under this Subdivision or Subdivision AA, or section 10B, 10C or 11 of the old Act (about citizenship by descent), at the time of the birth:  (i) the parent has been present in Australia (except as an unlawful non-citizen) for a total period of at least 2 years at any time before the person made the application; or  (ii) the person is not a national or a citizen of any country at the time the person made the application and the person has never been such a national or citizen; and  (c) if the person is or has ever been a national or a citizen of any country, or if article 1(2)(iii) of the Stateless Persons Convention applies to the person, and the person is aged 18 or over at the time the person made the application—the Minister is satisfied that the person is of good character at the time of the Minister’s decision on the application." ;
    cof:pageNumber "27"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-26-2 a cml:Concept ;
    skos:prefLabel "26 January 1949; and"@en ;
    cml:realizedBy doc:sec-26-2 ;
    values:originalText "(b) the parent was born in Australia or New Guinea or was naturalised in Australia before the person’s birth; and  (c) if the person is or has ever been a national or a citizen of any country, or if article 1(2)(iii) of the Stateless Persons Convention applies to the person—the Minister is satisfied that the person is of good character at the time of the Minister’s decision on the application." ;
    skos:definition "(b) the parent was born in Australia or New Guinea or was naturalised in Australia before the person’s birth; and  (c) if the person is or has ever been a national or a citizen of any country, or if article 1(2)(iii) of the Stateless Persons Convention applies to the person—the Minister is satisfied that the person is of good character at the time of the Minister’s decision on the application."@en ;
    cml:integrityHash "a95580887eb2a152843fc631b8b34ac7dadda90fc44870f32d9b22ff2ff87e1b" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Minister must be satisfied that applicant is of good character." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.28" ;
