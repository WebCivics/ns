concept:australian-citizenship-act-2007-sec-14 a cml:Concept ;
    skos:prefLabel "14 Citizenship for abandoned children"@en ;
    cml:realizedBy doc:sec-14 ;
    values:originalText "A person is an Australian citizen if the person is found abandoned in Australia as a child, unless and until the contrary is proved." ;
