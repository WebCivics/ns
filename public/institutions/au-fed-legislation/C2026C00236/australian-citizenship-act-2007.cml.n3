concept:australian-citizenship-act-2007-sec-28a a cml:Concept ;
    skos:prefLabel "28A Simplified outline"@en ;
    cml:realizedBy doc:sec-28a ;
    values:originalText "The following is a simplified outline of this Subdivision: You may be eligible to become an Australian citizen under this Subdivision if you ceased to be an Australian citizen under this Act or the old Act. You must make an application to become an Australian citizen again. The Minister must approve or refuse you becoming an Australian citizen again. You must be eligible to be an Australian citizen again to be approved. You may be refused citizenship again even if you are eligible. The Minister may be required to refuse your application on grounds relating to: • non-satisfaction of identity: see subsection 30(3); or" ;
    skos:definition "The following is a simplified outline of this Subdivision: You may be eligible to become an Australian citizen under this Subdivision if you ceased to be an Australian citizen under this Act or the old Act. You must make an application to become an Australian citizen again. The Minister must approve or refuse you becoming an Australian citizen again. You must be eligible to be an Australian citizen again to be approved. You may be refused citizenship again even if you are eligible. The Minister may be required to refuse your application on grounds relating to: • non-satisfaction of identity: see subsection 30(3); or"@en ;
    cml:integrityHash "e1d36301710de389a1aa304ec643ad2d634c0f43b9886ca126daa0eedaad7314" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Eligibility for Australian citizenship reapplication" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.63" ;
    cml:asserts concept:australian-citizenship-act-2007-sec-28a-norm .
