    values:partOf concept:australian-citizenship-act-2007-sec-28 ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Child becomes Australian citizen on first day a responsible parent becomes an Australian citizen." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
