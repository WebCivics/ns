doc:sec-28-ss-1 a cof:Section ;
    cof:title "28(1) Day citizenship begins etc." ;
    values:kind "subsection" ;
    values:originalText "(1) A person required to make a pledge of commitment becomes an Australian citizen under this Subdivision on the day on which the person makes the pledge. Persons not required to make pledge of commitment" ;
    cof:pageNumber "62"^^xsd:integer .

