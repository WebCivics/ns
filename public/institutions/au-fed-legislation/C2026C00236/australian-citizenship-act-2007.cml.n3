concept:australian-citizenship-act-2007-sec-36b-ss-3 a cml:Concept ;
    skos:prefLabel "36B(3) Cessation of citizenship if citizenship cessation order made by"@en ;
    cml:realizedBy doc:sec-36b-ss-3 ;
