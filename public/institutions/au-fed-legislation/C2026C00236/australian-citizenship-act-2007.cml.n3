doc:sec-36b-ss-1 a cof:Section ;
    cof:title "36B(1) Cessation of citizenship if citizenship cessation order made by" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to this section, if an order is made under subsection 36C(1) in relation to a person, the person ceases to be an Australian citizen at the time the order is made. Order overturned or quashed" ;
    cof:pageNumber "76"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-36b-ss-2 a cml:Concept ;
    skos:prefLabel "36B(2) Cessation of citizenship if citizenship cessation order made by"@en ;
    cml:realizedBy doc:sec-36b-ss-2 ;
    values:originalText "(2) If a decision of a court overturns or quashes the order made under subsection 36C(1), the person’s citizenship is taken never to have ceased under subsection (1) of this section." ;
    skos:definition "(2) If a decision of a court overturns or quashes the order made under subsection 36C(1), the person’s citizenship is taken never to have ceased under subsection (1) of this section."@en ;
    cml:integrityHash "39b19c242d9e3119fc333ec90f2cff674b03af25f4ae1fbab006211bf3601b72" ;
    values:partOf concept:australian-citizenship-act-2007-sec-36b ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "If a court decision overturns or quashes the order, citizenship is taken never to have ceased." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
