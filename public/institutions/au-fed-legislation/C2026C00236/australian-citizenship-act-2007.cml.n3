doc:sec-36d-ss-8 a cof:Section ;
    cof:title "36D(8) Application by the Minister for a citizenship cessation order" ;
    values:kind "subsection" ;
    values:originalText "(8) This section applies in relation to a person who is an Australian citizen regardless of how the person became an Australian citizen (including a person who became an Australian citizen upon the person’s birth)." ;
    cof:pageNumber "80"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-36l a cml:Concept ;
    skos:prefLabel "36L No resumption of citizenship if citizenship ceases under this"@en ;
    cml:realizedBy doc:sec-36l ;
    values:originalText "Subdivision  If a person ceases to be an Australian citizen under this Subdivision, Divisions 1 and 2 of this Part do not apply in relation to the person after that cessation. Note: See section 36B for when a person ceases to be an Australian citizen." ;
    skos:definition "Subdivision  If a person ceases to be an Australian citizen under this Subdivision, Divisions 1 and 2 of this Part do not apply in relation to the person after that cessation. Note: See section 36B for when a person ceases to be an Australian citizen."@en ;
    cml:integrityHash "a5cb58799cb402adf0fdaaa1da85619b5c0c3c1b686557ffe593df5e97349e4e" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "No resumption of citizenship if citizenship ceases under this subdivision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.81" ;
    cml:asserts concept:australian-citizenship-act-2007-sec-36l-norm .
