concept:australian-citizenship-act-2007-sec-17-ss-4b a cml:Concept ;
    skos:prefLabel "17(4B) Minister’s decision"@en ;
    cml:realizedBy doc:sec-17-ss-4b ;
    values:originalText "(4B) A person is covered by this subsection if:  (a) at the time the person made the application under section 16, the person:  (i) is not a national of any country; and  (ii) is not a citizen of any country; and  (b) at the time of the person’s birth, the person had a parent who was an Australian citizen. Cessation of citizenship" ;
    skos:definition "(4B) A person is covered by this subsection if:  (a) at the time the person made the application under section 16, the person:  (i) is not a national of any country; and  (ii) is not a citizen of any country; and  (b) at the time of the person’s birth, the person had a parent who was an Australian citizen. Cessation of citizenship"@en ;
    cml:integrityHash "3bd1665a3b83e2f1200e8b05d7dffba0aa936366ea4c14140dda4831a50cfd9a" ;
    values:partOf concept:australian-citizenship-act-2007-sec-17 ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Citizenship condition for application under section 16" ;
    cml:curationStatus cml:Proposed ;
