doc:sec-15-2-ss-1 a cof:Section ;
    cof:title "15(1) Citizenship by incorporation of Territory" ;
    values:kind "subsection" ;
    values:originalText "(1) A person is an Australian citizen if:  (a) any territory becomes a part of Australia; and  (b) the person is included in a class of persons specified in a determination under this section. Determination" ;
    cof:pageNumber "24"^^xsd:integer .

