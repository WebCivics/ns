concept:australian-citizenship-act-2007-sec-19f a cml:Concept ;
    skos:prefLabel "19F Day citizenship begins"@en ;
    cml:realizedBy doc:sec-19f ;
    values:originalText "A person becomes an Australian citizen under this Subdivision on the day on which the Minister approves the person becoming an Australian citizen.   Australian citizenship  Part 2 Acquisition of Australian citizenship by application  Division 2  Section 19G  Australian Citizenship Act 2007  Compilation date: 04/06/2026  Subdivision B—Citizenship by conferral" ;
    skos:definition "A person becomes an Australian citizen under this Subdivision on the day on which the Minister approves the person becoming an Australian citizen.   Australian citizenship  Part 2 Acquisition of Australian citizenship by application  Division 2  Section 19G  Australian Citizenship Act 2007  Compilation date: 04/06/2026  Subdivision B—Citizenship by conferral"@en ;
    cml:integrityHash "9e93b148862815e55b1242651fb8555b02cd3ac9e781254f1bdf30074f351ad7" ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Day on which citizenship begins" ;
