concept:australian-citizenship-act-2007-sec-13 a cml:Concept ;
    skos:prefLabel "13 Citizenship by adoption"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "A person is an Australian citizen if the person is:  (a) adopted under a law in force in a State or Territory; and  (b) adopted by a person who is an Australian citizen at the time of the adoption or by 2 persons jointly at least one of whom is an Australian citizen at that time; and  (c) present in Australia as a permanent resident at that time." ;
    skos:definition "A person is an Australian citizen if the person is:  (a) adopted under a law in force in a State or Territory; and  (b) adopted by a person who is an Australian citizen at the time of the adoption or by 2 persons jointly at least one of whom is an Australian citizen at that time; and  (c) present in Australia as a permanent resident at that time."@en ;
    cml:integrityHash "74161858a711c6e70eabab169cf2104d940874bf49d7aee28305628098dd7dd7" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Citizenship by adoption conditions" ;
    cml:curationStatus cml:Proposed ;
