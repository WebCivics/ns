doc:sec-28-ss-3 a cof:Section ;
    cof:title "28(3) Day citizenship begins etc." ;
    values:kind "subsection" ;
    values:originalText "(3) Subsection (2) does not apply to a child aged under 16 at the time the child made the application to become an Australian citizen if:  (a) 1 or more responsible parents of the child made applications under section 21 at that time; and  (b) the Minister decided under section 24 to approve the child and 1 or more of the responsible parents becoming Australian citizens." ;
    cof:pageNumber "62"^^xsd:integer .

concept:australian-citizenship-act-2007-sec-28-ss-4 a cml:Concept ;
    skos:prefLabel "28(4) Day citizenship begins etc."@en ;
    cml:realizedBy doc:sec-28-ss-4 ;
    values:originalText "(4) If 1 or more of the responsible parents become Australian citizens under this section, the child becomes an Australian citizen on the first day on which a responsible parent becomes an Australian citizen. Subdivision C—Resuming citizenship" ;
    skos:definition "(4) If 1 or more of the responsible parents become Australian citizens under this section, the child becomes an Australian citizen on the first day on which a responsible parent becomes an Australian citizen. Subdivision C—Resuming citizenship"@en ;
