concept:australian-citizenship-act-2007-sec-36d-ss-5 a cml:Concept ;
    skos:prefLabel "36D(5) Application by the Minister for a citizenship cessation order"@en ;
    cml:realizedBy doc:sec-36d-ss-5 ;
    values:originalText "(5) The application:  (a) must be made in the jury’s absence; and  (b) must not be referred to in the presence of the jury; and  (c) must only be heard after the person is convicted of one or more serious offences.   Australian citizenship  Part 2 Cessation of Australian citizenship  Division 3  Section 36L  Australian Citizenship Act 2007  Compilation date: 04/06/2026  Notice of application" ;
    skos:definition "(5) The application:  (a) must be made in the jury’s absence; and  (b) must not be referred to in the presence of the jury; and  (c) must only be heard after the person is convicted of one or more serious offences.   Australian citizenship  Part 2 Cessation of Australian citizenship  Division 3  Section 36L  Australian Citizenship Act 2007  Compilation date: 04/06/2026  Notice of application"@en ;
    cml:integrityHash "57a272496756616dcbe0fa60a89e61d9ce8bb6d67c306c845c8e8db543183a8b" ;
    values:partOf concept:australian-citizenship-act-2007-sec-36d ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Application must be made in jury's absence and not referred to in their presence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.80" ;
