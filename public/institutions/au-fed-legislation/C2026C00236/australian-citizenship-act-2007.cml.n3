concept:australian-citizenship-act-2007-sec-44-ss-2a cml:asserts concept:australian-citizenship-act-2007-sec-44-ss-2a-logic-deontic-1 .
concept:australian-citizenship-act-2007-sec-44-ss-2a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permits" ;
    cml:logicSummary "Allows modification or impairment under certain conditions" ;
    cml:premiseText "(2A) If..." ;
    cml:conclusionText "...section does not apply" ;
