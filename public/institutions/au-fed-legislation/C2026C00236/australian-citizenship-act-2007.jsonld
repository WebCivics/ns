      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.29",
      "values:originalText": "If the Minister approves the person becoming an Australian citizen,\nthe Minister must register the person in the manner prescribed by\nthe regulations.",
      "skos:definition": "If the Minister approves the person becoming an Australian citizen,\nthe Minister must register the person in the manner prescribed by\nthe regulations.",
