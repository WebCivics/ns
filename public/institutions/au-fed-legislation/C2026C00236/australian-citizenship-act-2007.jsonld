    {
      "@id": "concept:australian-citizenship-act-2007-sec-17-ss-4b",
      "@type": "cml:Concept",
      "skos:prefLabel": "17(4B) Minister’s decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-17-ss-4b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.28",
      "values:originalText": "(4B) A person is covered by this subsection if:\n\n(a) at the time the person made the application under section 16,\nthe person:\n\n(i) is not a national of any country; and\n\n(ii) is not a citizen of any country; and\n\n(b) at the time of the person’s birth, the person had a parent who\nwas an Australian citizen.\nCessation of citizenship",
      "skos:definition": "(4B) A person is covered by this subsection if:\n\n(a) at the time the person made the application under section 16,\nthe person:\n\n(i) is not a national of any country; and\n\n(ii) is not a citizen of any country; and\n\n(b) at the time of the person’s birth, the person had a parent who\nwas an Australian citizen.\nCessation of citizenship",
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-17"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-17-ss-4b-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-17-ss-4b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3bd1665a3b83e2f1200e8b05d7dffba0aa936366ea4c14140dda4831a50cfd9a",
      "skos:note": "Citizenship condition for application under section 16"
    },
    {
