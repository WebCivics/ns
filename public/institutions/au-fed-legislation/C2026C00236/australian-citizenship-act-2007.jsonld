    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-45c-ss-3",
      "@type": "cof:Section",
      "cof:title": "45C(3) Document condemned as forfeited",
      "values:kind": "subsection",
      "cof:pageNumber": 93,
      "values:originalText": "(3) If, before the end of the period specified in the seizure notice, the\nperson or owner does not institute the proceedings, the document is\ncondemned as forfeited to the Commonwealth immediately after\nthe end of that period."
    },
