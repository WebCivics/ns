      "@type": "cml:Concept",
      "skos:prefLabel": "10B(3) Providing photographs and other images of faces to the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-10b-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
