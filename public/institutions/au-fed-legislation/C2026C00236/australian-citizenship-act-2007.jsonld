    {
      "@id": "concept:australian-citizenship-act-2007-sec-22-ss-1b",
      "@type": "cml:Concept",
      "skos:prefLabel": "22(1B) General residence requirement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-22-ss-1b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.41",
      "values:originalText": "(1B) If:\n\n(a) the person was absent from Australia for a part of the period\nof 12 months immediately before the day the person made\nthe application; and\n\n(b) the total period of the absence or absences was not more than\n90 days; and\n\n(c) the person was a permanent resident during each period of\nabsence;\nthen, for the purposes of paragraph (1)(c), the person is taken to\nhave been present in Australia as a permanent resident during each\nperiod of absence.",
      "skos:definition": "(1B) If:\n\n(a) the person was absent from Australia for a part of the period\nof 12 months immediately before the day the person made\nthe application; and\n\n(b) the total period of the absence or absences was not more than\n90 days; and\n\n(c) the person was a permanent resident during each period of\nabsence;\nthen, for the purposes of paragraph (1)(c), the person is taken to\nhave been present in Australia as a permanent resident during each\nperiod of absence.",
      "values:partOf": {
