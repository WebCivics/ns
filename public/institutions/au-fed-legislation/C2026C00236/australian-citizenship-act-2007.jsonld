      "cml:integrityHash": "f68ba146358bcddf8d0cb8d41f3670e59dc43f58454f07aba0bce99462a12d5b",
      "skos:note": "A person must provide a photograph or other image of their face to the Minister if required by citizenship law.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-10b-ss-1",
