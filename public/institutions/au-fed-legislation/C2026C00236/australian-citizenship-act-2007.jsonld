    {
      "@id": "concept:australian-citizenship-act-2007-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Form of pledge no. 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
