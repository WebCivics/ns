        {
          "@id": "concept:australian-citizenship-act-2007-sec-10b-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5f9ef9861286203c656bd01931bf2967c54a774fc77e5dee861b4e45d5231969",
      "skos:note": "The person must provide a derived image to the recipient for certain purposes.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-10b-ss-3",
      "@type": "cof:Section",
      "cof:title": "10B(3) Providing photographs and other images of faces to the",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(3) For the purposes of the citizenship law, the person is taken to\nprovide the derived image to the recipient for the purposes of the\nrequirement mentioned in paragraph (1)(a) or (2)(a) of this section."
    },
