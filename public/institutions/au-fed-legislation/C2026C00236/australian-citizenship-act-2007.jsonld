    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-38-ss-4",
      "@type": "cof:Section",
      "cof:title": "38(4) Surrender of physical evidentiary notice",
      "values:kind": "subsection",
