    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a",
      "@type": "cml:Concept",
      "skos:prefLabel": "36A Purpose of this Subdivision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.75",
      "values:originalText": "This Subdivision is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.",
      "skos:definition": "This Subdivision is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36a-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-2"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-3"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-4"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "516026a6f81d1adf8d05d456210a077fe1914ea239c6939062288499d8370cb8",
      "skos:note": "Recognizes Australian citizenship as a common bond with reciprocal rights and obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36a",
      "@type": "cof:Section",
      "cof:title": "36A Purpose of this Subdivision",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "This Subdivision is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-36a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes a duty on citizens to uphold Australian values.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Australian citizenship is a common bond",
      "cml:conclusionText": "with reciprocal rights and obligations"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Forbids citizens from demonstrating severed allegiance to Australia.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "citizens may, through certain conduct incompatible with the shared values of the Australian community",
      "cml:conclusionText": "demonstrate that they have severed that bond and repudiated their allegiance to Australia"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes a duty on citizens to uphold shared values.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the Australian community",
      "cml:conclusionText": "demonstrate that they have severed that bond and repudiated their allegiance to Australia"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:logicSummary": "Grants citizens reciprocal rights.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Australian citizenship is a common bond involving reciprocal rights and obligations",
      "cml:conclusionText": "and that citizens may, through certain conduct incompatible with the shared values of the Australian community"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36a-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Undertaking",
      "cml:logicSummary": "Establishes the purpose of this subdivision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This Subdivision is enacted because",
      "cml:conclusionText": "the Parliament recognises that Australian citizenship is a common bond, involving reciprocal rights and obligations, and that citizens may, through certain conduct incompatible with the shared values of the Australian community, demonstrate that they have severed that bond and repudiated their allegiance to Australia."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36b",
      "@type": "cml:Concept",
      "skos:prefLabel": "36B Cessation of citizenship if citizenship cessation order made by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.76",
      "values:originalText": "court etc.\n\n(1) Subject to this section, if an order is made under subsection 36C(1)\nin relation to a person, the person ceases to be an Australian citizen\nat the time the order is made.\nOrder overturned or quashed\n\n(2) If a decision of a court overturns or quashes the order made under\nsubsection 36C(1), the person’s citizenship is taken never to have\nceased under subsection (1) of this section.\n\n(3) The validity of anything done in reliance on the order made under\nsubsection 36C(1) before the order was overturned or quashed is\nnot affected.\nAppeal decision\n\n(4) If:\n\n(a) a decision (the first decision) of a court overturning or\nquashing the order made under subsection 36C(1) in relation\nto the person is appealed; and\n\n(b) the decision (the second decision) on appeal overturns or\nquashes the first decision;\nthe person ceases to be an Australian citizen at the time the second\ndecision is made.",
      "skos:definition": "court etc.\n\n(1) Subject to this section, if an order is made under subsection 36C(1)\nin relation to a person, the person ceases to be an Australian citizen\nat the time the order is made.\nOrder overturned or quashed\n\n(2) If a decision of a court overturns or quashes the order made under\nsubsection 36C(1), the person’s citizenship is taken never to have\nceased under subsection (1) of this section.\n\n(3) The validity of anything done in reliance on the order made under\nsubsection 36C(1) before the order was overturned or quashed is\nnot affected.\nAppeal decision\n\n(4) If:\n\n(a) a decision (the first decision) of a court overturning or\nquashing the order made under subsection 36C(1) in relation\nto the person is appealed; and\n\n(b) the decision (the second decision) on appeal overturns or\nquashes the first decision;\nthe person ceases to be an Australian citizen at the time the second\ndecision is made.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36b-ss-1"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36b-ss-2"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36b-ss-3"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36b-ss-4"
        }
      ],
      "cml:integrityHash": "271841c098d5905fb787437234078e1acddc049b8e570094d0e1632eeaff8965"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36b",
      "@type": "cof:Section",
      "cof:title": "36B Cessation of citizenship if citizenship cessation order made by",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "court etc.\n\n(1) Subject to this section, if an order is made under subsection 36C(1)\nin relation to a person, the person ceases to be an Australian citizen\nat the time the order is made.\nOrder overturned or quashed\n\n(2) If a decision of a court overturns or quashes the order made under\nsubsection 36C(1), the person’s citizenship is taken never to have\nceased under subsection (1) of this section.\n\n(3) The validity of anything done in reliance on the order made under\nsubsection 36C(1) before the order was overturned or quashed is\nnot affected.\nAppeal decision\n\n(4) If:\n\n(a) a decision (the first decision) of a court overturning or\nquashing the order made under subsection 36C(1) in relation\nto the person is appealed; and\n\n(b) the decision (the second decision) on appeal overturns or\nquashes the first decision;\nthe person ceases to be an Australian citizen at the time the second\ndecision is made."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36b-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "36B(1) Cessation of citizenship if citizenship cessation order made by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36b-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
