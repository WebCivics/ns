    {
      "@id": "concept:australian-citizenship-act-2007-sec-22a-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "22A(1A) Special residence requirement—persons engaging in activities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-22a-ss-1a"
      },
      "cml:curationStatus": {
