    {
      "@id": "concept:australian-citizenship-act-2007-sec-7-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(2) Children born on ships or aircraft or after death of parent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-7-ss-2"
      },
      "cml:curationStatus": {
