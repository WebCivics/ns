    {
      "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "21(2A) Application and eligibility for citizenship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-21-ss-2a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.36",
      "values:originalText": "(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the following apply:\n\n(a) the person has sat a test approved in a determination under\nsection 23A;\n\n(b) the person was eligible to sit that test (worked out in\naccordance with that determination);\n\n(c) the person started that test within the period worked out in\naccordance with that determination and completed that test\nwithin the period (the relevant test period) worked out in\naccordance with that determination;\n\n(d) the person successfully completed that test (worked out in\naccordance with that determination) within the relevant test\nperiod.\nPermanent or enduring physical or mental incapacity",
      "skos:definition": "(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the following apply:\n\n(a) the person has sat a test approved in a determination under\nsection 23A;\n\n(b) the person was eligible to sit that test (worked out in\naccordance with that determination);\n\n(c) the person started that test within the period worked out in\naccordance with that determination and completed that test\nwithin the period (the relevant test period) worked out in\naccordance with that determination;\n\n(d) the person successfully completed that test (worked out in\naccordance with that determination) within the relevant test\nperiod.\nPermanent or enduring physical or mental incapacity",
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-21"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "fe4af6b2986f74af1f81122c8f5d64d5ad59a834a7fd50ba456cd7aff01d092f",
      "skos:note": "Eligibility for citizenship based on test completion and timing."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-21-ss-2a",
      "@type": "cof:Section",
      "cof:title": "21(2A) Application and eligibility for citizenship",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the following apply:\n\n(a) the person has sat a test approved in a determination under\nsection 23A;\n\n(b) the person was eligible to sit that test (worked out in\naccordance with that determination);\n\n(c) the person started that test within the period worked out in\naccordance with that determination and completed that test\nwithin the period (the relevant test period) worked out in\naccordance with that determination;\n\n(d) the person successfully completed that test (worked out in\naccordance with that determination) within the relevant test\nperiod.\nPermanent or enduring physical or mental incapacity"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-norm",
      "@type": "values:Obligation",
