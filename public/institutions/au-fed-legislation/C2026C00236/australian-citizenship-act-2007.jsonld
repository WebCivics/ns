    {
      "@id": "concept:australian-citizenship-act-2007-sec-44-ss-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "44(2A) Unauthorised modification or impairment of identifying",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-44-ss-2a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.89",
      "values:originalText": "(2A) If:\n\n(a) a disclosure of identifying information is made to a person\nwho is not an entrusted person; and\n\n(b) the disclosure is a permitted disclosure within the meaning of\nsection 43;\nthis section does not apply in relation to any modification or\nimpairment of that identifying information by a person who is not\nan entrusted person.",
      "skos:definition": "(2A) If:\n\n(a) a disclosure of identifying information is made to a person\nwho is not an entrusted person; and\n\n(b) the disclosure is a permitted disclosure within the meaning of\nsection 43;\nthis section does not apply in relation to any modification or\nimpairment of that identifying information by a person who is not\nan entrusted person.",
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-44"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-44-ss-2a-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-44-ss-2a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "30fd0716e7ab192ffd64edb5c751ff5971b97f03879c4d4c451830c5e4bd674a",
      "skos:note": "Permitted disclosure exception for modification or impairment of identifying information"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-44-ss-2a",
      "@type": "cof:Section",
      "cof:title": "44(2A) Unauthorised modification or impairment of identifying",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
      "values:originalText": "(2A) If:\n\n(a) a disclosure of identifying information is made to a person\nwho is not an entrusted person; and\n\n(b) the disclosure is a permitted disclosure within the meaning of\nsection 43;\nthis section does not apply in relation to any modification or\nimpairment of that identifying information by a person who is not\nan entrusted person."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-44-ss-2a-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
