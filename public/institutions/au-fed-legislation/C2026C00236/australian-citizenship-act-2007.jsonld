    {
      "@id": "concept:australian-citizenship-act-2007-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Citizenship by birth",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
