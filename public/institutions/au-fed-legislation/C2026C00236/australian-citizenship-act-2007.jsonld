      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.18",
      "values:originalText": "(2) For the purposes of this Act, the status of a parent of a person at the\ntime of the person’s birth is, for a parent who died before the birth,\ntaken to be the status of the parent when the parent died.",
      "skos:definition": "(2) For the purposes of this Act, the status of a parent of a person at the\ntime of the person’s birth is, for a parent who died before the birth,\ntaken to be the status of the parent when the parent died.",
