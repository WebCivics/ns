    {
      "@id": "concept:australian-citizenship-act-2007-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Day citizenship begins",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.29",
      "values:originalText": "A person becomes an Australian citizen under this Subdivision on\nthe day on which the Minister approves the person becoming an\nAustralian citizen.",
      "skos:definition": "A person becomes an Australian citizen under this Subdivision on\nthe day on which the Minister approves the person becoming an\nAustralian citizen.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19-norm"
        }
      ],
      "cml:integrityHash": "ce46a46fd0b93ecb5152147feffd758d2c90f27ee5aae8ecd91916dd982941d5",
      "skos:note": "Day citizenship begins"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Day citizenship begins",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "A person becomes an Australian citizen under this Subdivision on\nthe day on which the Minister approves the person becoming an\nAustralian citizen."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-19"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19b",
      "@type": "cml:Concept",
      "skos:prefLabel": "19B Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.30",
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia by at least one\nAustralian citizen in accordance with:\n\n(a)\nthe Hague Convention on Intercountry Adoption; or\n\n(b)\na bilateral arrangement.\nYou must make an application to become an Australian citizen.\nThe Minister must approve or refuse you becoming an Australian\ncitizen.\nYou must be eligible to be an Australian citizen to be approved.\nYou may be refused citizenship even if you are eligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:\n•\nnon-satisfaction of identity: see subsection 19D(4); or\n\n\nAustralian citizenship  Part 2\nAcquisition of Australian citizenship by application  Division 2\n\nSection 19C\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\n•\nnational security: see subsections 19D(5) to (7A); or\n•\ncessation of citizenship: see subsection 19D(8).\nYou will be registered if the Minister approves you becoming an\nAustralian citizen.",
      "skos:definition": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia by at least one\nAustralian citizen in accordance with:\n\n(a)\nthe Hague Convention on Intercountry Adoption; or\n\n(b)\na bilateral arrangement.\nYou must make an application to become an Australian citizen.\nThe Minister must approve or refuse you becoming an Australian\ncitizen.\nYou must be eligible to be an Australian citizen to be approved.\nYou may be refused citizenship even if you are eligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:\n•\nnon-satisfaction of identity: see subsection 19D(4); or\n\n\nAustralian citizenship  Part 2\nAcquisition of Australian citizenship by application  Division 2\n\nSection 19C\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\n•\nnational security: see subsections 19D(5) to (7A); or\n•\ncessation of citizenship: see subsection 19D(8).\nYou will be registered if the Minister approves you becoming an\nAustralian citizen.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19b-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e758c42ab91409478c1b3cda434fa16a03c0f752494c14085fc485b155d015ad",
      "skos:note": "Eligibility for Australian citizenship by adoption"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19b",
      "@type": "cof:Section",
      "cof:title": "19B Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia by at least one\nAustralian citizen in accordance with:\n\n(a)\nthe Hague Convention on Intercountry Adoption; or\n\n(b)\na bilateral arrangement.\nYou must make an application to become an Australian citizen.\nThe Minister must approve or refuse you becoming an Australian\ncitizen.\nYou must be eligible to be an Australian citizen to be approved.\nYou may be refused citizenship even if you are eligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:\n•\nnon-satisfaction of identity: see subsection 19D(4); or\n\n\nAustralian citizenship  Part 2\nAcquisition of Australian citizenship by application  Division 2\n\nSection 19C\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\n•\nnational security: see subsections 19D(5) to (7A); or\n•\ncessation of citizenship: see subsection 19D(8).\nYou will be registered if the Minister approves you becoming an\nAustralian citizen."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19b-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
