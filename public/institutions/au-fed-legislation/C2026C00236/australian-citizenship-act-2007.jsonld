        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister's decision to revoke citizenship must be based on accurate and reliable information.",
      "cml:conclusionText": "Citizenship revocation is represented as a knowledge-based system."
    },
