    {
      "@id": "concept:australian-citizenship-act-2007-sec-28-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "28(2) Day citizenship begins etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28-ss-2"
      },
      "cml:curationStatus": {
