    {
      "@id": "concept:australian-citizenship-act-2007-sec-36c-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "36C(3) Citizenship cessation order if person is convicted of serious",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36c-ss-3"
      },
      "cml:curationStatus": {
