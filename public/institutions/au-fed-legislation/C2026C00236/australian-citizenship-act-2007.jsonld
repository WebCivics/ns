    {
      "@id": "concept:australian-citizenship-act-2007-sec-48-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "48(2) Computerised decision-making",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-48-ss-2"
