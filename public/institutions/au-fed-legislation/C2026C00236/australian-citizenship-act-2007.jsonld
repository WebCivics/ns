    {
      "@id": "concept:australian-citizenship-act-2007-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Requirements for becoming a citizen",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.36",
      "values:originalText": "A person becomes an Australian citizen under this Subdivision if:\n\n(a) the Minister decides under subsection 24(1) to approve the\nperson becoming an Australian citizen; and\n\n(b) if the person is required to make a pledge of commitment to\nbecome an Australian citizen—the person makes that pledge.\nNote:\nSections 21 to 25 deal with the Minister approving the person\nbecoming an Australian citizen. Sections 26 and 27 deal with the\nmaking of a pledge of commitment.",
      "skos:definition": "A person becomes an Australian citizen under this Subdivision if:\n\n(a) the Minister decides under subsection 24(1) to approve the\nperson becoming an Australian citizen; and\n\n(b) if the person is required to make a pledge of commitment to\nbecome an Australian citizen—the person makes that pledge.\nNote:\nSections 21 to 25 deal with the Minister approving the person\nbecoming an Australian citizen. Sections 26 and 27 deal with the\nmaking of a pledge of commitment.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-20-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3b67f900b57c1bb107dc9f153fd824dbef729aad649312c37f1f0a89c6800203",
      "skos:note": "Must make pledge of commitment and meet Minister's approval for citizenship."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Requirements for becoming a citizen",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "A person becomes an Australian citizen under this Subdivision if:\n\n(a) the Minister decides under subsection 24(1) to approve the\nperson becoming an Australian citizen; and\n\n(b) if the person is required to make a pledge of commitment to\nbecome an Australian citizen—the person makes that pledge.\nNote:\nSections 21 to 25 deal with the Minister approving the person\nbecoming an Australian citizen. Sections 26 and 27 deal with the\nmaking of a pledge of commitment."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-20-norm",
