        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-41-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "baf5d97a03cdb32332c8a2351644a66d5e1910e1226cc166a043a85675578f28",
      "skos:note": "Regulations must prescribe procedures for personal identifier provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Provision of personal identifiers",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "The regulations may prescribe the procedures and requirements\nthat apply to the provision of a personal identifier by a person\nunder this Division."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-41-norm",
      "@type": "values:Obligation",
