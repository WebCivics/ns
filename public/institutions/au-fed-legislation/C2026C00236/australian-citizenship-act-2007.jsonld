        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The application may be made before or after the person is convicted of one or more serious offences but must be made before the person is sentenced.",
      "cml:conclusionText": "The application is part of a specific domain."
    },
