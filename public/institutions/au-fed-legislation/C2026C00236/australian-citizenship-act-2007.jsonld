    {
      "@id": "concept:australian-citizenship-act-2007-sec-145-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Minister has a duty to approve an applicant becoming an Australian citizen.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister gave approval.",
      "cml:conclusionText": "The applicant became an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-145-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "The approval is related to the offence.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The act or omission that constituted the offence was connected with the Minister approving the applicant becoming an Australian citizen.",
      "cml:conclusionText": "The approval is a condition of the offence."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-145-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "The approval must be given before the conviction can be referred to the court.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister gave approval.",
      "cml:conclusionText": "The conviction was made after the approval."
    },
