      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2A) Paragraphs (2)(d), (e) and (f)",
      "cml:conclusionText": "the Minister is satisfied that the following apply:"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-logic-alleninterval-2",
