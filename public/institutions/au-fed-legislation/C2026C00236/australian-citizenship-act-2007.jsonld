    {
      "@id": "concept:australian-citizenship-act-2007-sec-10a",
      "@type": "cml:Concept",
      "skos:prefLabel": "10A References to photograph or other image of person’s face",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-10a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.20",
      "values:originalText": "A reference in the citizenship law to a photograph or other image\nof a person’s face includes a reference to a photograph or other\nimage of:\n\n(a) the person’s face and all or part of the person’s neck; or\n\n(b) the person’s face and neck and all or part of the person’s\nshoulders.",
      "skos:definition": "A reference in the citizenship law to a photograph or other image\nof a person’s face includes a reference to a photograph or other\nimage of:\n\n(a) the person’s face and all or part of the person’s neck; or\n\n(b) the person’s face and neck and all or part of the person’s\nshoulders.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-10a-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-10a-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-10a-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "a861057ed20e86598eea661ec30622c4ae068276096aab3129e044ec4b17d51a",
      "skos:note": "Reference to photograph or image of person's face includes reference to face and neck."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-10a",
      "@type": "cof:Section",
      "cof:title": "10A References to photograph or other image of person’s face",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "A reference in the citizenship law to a photograph or other image\nof a person’s face includes a reference to a photograph or other\nimage of:\n\n(a) the person’s face and all or part of the person’s neck; or\n\n(b) the person’s face and neck and all or part of the person’s\nshoulders."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-10a-norm",
