    {
      "@id": "concept:australian-citizenship-act-2007-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Citizenship for abandoned children",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-14"
      },
      "cml:curationStatus": {
