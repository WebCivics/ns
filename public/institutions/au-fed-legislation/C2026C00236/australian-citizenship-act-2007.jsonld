      ],
      "cml:integrityHash": "ccc07a1e335d8d3dd7ec4cf191b66d125c9b14f374f5c9eaebadfaf9dbd55acf",
      "skos:note": "Australian citizenship for abandoned children"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Citizenship for abandoned children",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "A person is an Australian citizen if the person is found abandoned\nin Australia as a child, unless and until the contrary is proved."
    },
