        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-52-ss-3-logic-ltl-3"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-52-ss-3-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "7f25ef1b0c7438242cb04ff297d521c9b00734893d852794c9155f849bc8f767",
      "skos:note": "Tribunal cannot review exercise of power or failure to exercise power"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-52-ss-3",
      "@type": "cof:Section",
      "cof:title": "52(3) Review of decisions",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(3) For the purposes of the Administrative Review Tribunal reviewing\na decision of a kind referred to in paragraph (1)(b):\n\n(a) the Tribunal must not exercise the power under\nsubsection 22A(1A) or 22B(1A); and\n\n(b) the Tribunal must not review any exercise of the power or\nany failure to exercise the power."
    },
