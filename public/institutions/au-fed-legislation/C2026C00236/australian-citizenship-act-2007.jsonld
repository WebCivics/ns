    {
      "@id": "concept:australian-citizenship-act-2007-sec-22b-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "22B(1A) Special residence requirement—persons engaged in particular",
      "cml:realizedBy": {
