      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person started that test within the period worked out in accordance with that determination and completed that test within the period (the relevant test period) worked out in accordance with that determination;",
      "cml:conclusionText": "within the period (the relevant test period) worked out in accordance with that determination;"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-21-ss-2a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Test completion until condition",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the person successfully completed that test (worked out in accordance with that determination) within the relevant test period.",
      "cml:conclusionText": "within the relevant test period;"
    },
