    {
      "@id": "concept:australian-citizenship-act-2007-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Provision of personal identifiers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.85",
      "values:originalText": "The regulations may prescribe the procedures and requirements\nthat apply to the provision of a personal identifier by a person\nunder this Division.",
      "skos:definition": "The regulations may prescribe the procedures and requirements\nthat apply to the provision of a personal identifier by a person\nunder this Division.",
      "cml:asserts": [
