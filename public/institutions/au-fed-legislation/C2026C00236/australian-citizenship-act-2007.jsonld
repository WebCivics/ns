        }
      ],
      "cml:integrityHash": "c0bc2d84e6099f93c3ede026fbeec748990de2cd3cb9b5fabe222b6a14343dde",
      "skos:note": "Minister may revoke child's Australian citizenship if responsible parent ceases to be citizen."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36-ss-1",
      "@type": "cof:Section",
      "cof:title": "36(1) Children of responsible parents who cease to be citizens",
      "values:kind": "subsection",
      "cof:pageNumber": 74,
      "values:originalText": "(1) If:\n\n\nAustralian citizenship  Part 2\nCessation of Australian citizenship  Division 3\n\nSection 36A\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\n(a) a person ceases to be an Australian citizen at a particular time\n(the cessation time) under section 33, 34 or 34A; and\n\n(b) at the cessation time, the person is a responsible parent of a\nchild aged under 18;\nthen:\n\n(c) the Minister may, by writing, revoke the child’s Australian\ncitizenship; and\n\n(d) if the Minister does so—the child ceases to be an Australian\ncitizen at the time of the revocation.\nException—another responsible parent"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-36-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Minister has the power to revoke child's citizenship.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "36(2) Children of responsible parents who cease to be citizens",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
