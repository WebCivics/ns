        }
      ],
      "cml:integrityHash": "a95580887eb2a152843fc631b8b34ac7dadda90fc44870f32d9b22ff2ff87e1b",
      "skos:note": "Minister must be satisfied that applicant is of good character."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-26-2",
      "@type": "cof:Section",
      "cof:title": "26 January 1949; and",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "(b) the parent was born in Australia or New Guinea or was\nnaturalised in Australia before the person’s birth; and\n\n(c) if the person is or has ever been a national or a citizen of any\ncountry, or if article 1(2)(iii) of the Stateless Persons\nConvention applies to the person—the Minister is satisfied\nthat the person is of good character at the time of the\nMinister’s decision on the application."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-26-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-26-2"
      },
      "values:deonticStatus": {
