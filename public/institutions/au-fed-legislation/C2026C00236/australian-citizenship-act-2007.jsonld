        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-12-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "742660335b2f83df393b71cd447e07f82eed41d497c68305fc0ac87cb239ad4f",
      "skos:note": "Citizenship by birth based on parent's citizenship or residency."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Citizenship by birth",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "(1) A person born in Australia is an Australian citizen if and only if:\n\n(a) a parent of the person is an Australian citizen, or a permanent\nresident, at the time the person is born; or\n\n(b) the person is ordinarily resident in Australia throughout the\nperiod of 10 years beginning on the day the person is born."
    },
