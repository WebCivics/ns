      "@type": "cml:Concept",
      "skos:prefLabel": "2 Form of pledge no. 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sch-1-sec-2"
      },
