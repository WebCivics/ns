      "cml:integrityHash": "d2df103027b9d70a0d25420ce70c2d7a0bb13992cddcb4c0228f156e1b89de19",
      "skos:note": "Ceases Australian citizenship if convicted of serious offence with imprisonment period of at least 3 years."
