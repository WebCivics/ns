    {
      "@id": "concept:australian-citizenship-act-2007-sec-22-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "22(1A) General residence requirement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-22-ss-1a"
      },
      "cml:curationStatus": {
