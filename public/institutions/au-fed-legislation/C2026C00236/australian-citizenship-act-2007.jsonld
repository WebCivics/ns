        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-28-ss-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "8df6360106bb5016a7fb1ad36564835ca4d31a9322cca89b2f57a05ef02fc2a5",
      "skos:note": "Child becomes Australian citizen on first day a responsible parent becomes an Australian citizen."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28-ss-4",
      "@type": "cof:Section",
      "cof:title": "28(4) Day citizenship begins etc.",
      "values:kind": "subsection",
