    {
      "@id": "concept:australian-citizenship-act-2007-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Registration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
