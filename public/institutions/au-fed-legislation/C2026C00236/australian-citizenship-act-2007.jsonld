    {
      "@id": "concept:australian-citizenship-act-2007-sec-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 Altering evidentiary notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-39"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.84",
      "values:originalText": "A person commits an offence if:\n\n(a) the person alters, or causes or permits to be altered, a notice;\nand\n\n(b) the notice was given to a person under section 37.\nPenalty: Imprisonment for 12 months.\n\n\nAustralian citizenship  Part 2\nPersonal identifiers  Division 5\n\nSection 40\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026",
      "skos:definition": "A person commits an offence if:\n\n(a) the person alters, or causes or permits to be altered, a notice;\nand\n\n(b) the notice was given to a person under section 37.\nPenalty: Imprisonment for 12 months.\n\n\nAustralian citizenship  Part 2\nPersonal identifiers  Division 5\n\nSection 40\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-39-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-39-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "654bf5819ab4a65a8e383d4ca19258089aa603bda570f454d669f42cd0bfd9ed",
      "skos:note": "Altering evidentiary notice is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Altering evidentiary notice",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "A person commits an offence if:\n\n(a) the person alters, or causes or permits to be altered, a notice;\nand\n\n(b) the notice was given to a person under section 37.\nPenalty: Imprisonment for 12 months.\n\n\nAustralian citizenship  Part 2\nPersonal identifiers  Division 5\n\nSection 40\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026"
    },
    {
