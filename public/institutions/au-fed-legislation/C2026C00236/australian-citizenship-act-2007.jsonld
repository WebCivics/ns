    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28-ss-1",
      "@type": "cof:Section",
      "cof:title": "28(1) Day citizenship begins etc.",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(1) A person required to make a pledge of commitment becomes an\nAustralian citizen under this Subdivision on the day on which the\nperson makes the pledge.\nPersons not required to make pledge of commitment"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-28-ss-1-norm",
