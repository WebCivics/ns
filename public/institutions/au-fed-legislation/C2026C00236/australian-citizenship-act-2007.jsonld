    {
      "@id": "concept:australian-citizenship-act-2007-sec-36l",
      "@type": "cml:Concept",
      "skos:prefLabel": "36L No resumption of citizenship if citizenship ceases under this",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.81",
      "values:originalText": "Subdivision\n\nIf a person ceases to be an Australian citizen under this\nSubdivision, Divisions 1 and 2 of this Part do not apply in relation\nto the person after that cessation.\nNote:\nSee section 36B for when a person ceases to be an Australian citizen.",
      "skos:definition": "Subdivision\n\nIf a person ceases to be an Australian citizen under this\nSubdivision, Divisions 1 and 2 of this Part do not apply in relation\nto the person after that cessation.\nNote:\nSee section 36B for when a person ceases to be an Australian citizen.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36l-norm"
        }
      ],
      "cml:integrityHash": "a5cb58799cb402adf0fdaaa1da85619b5c0c3c1b686557ffe593df5e97349e4e",
      "skos:note": "No resumption of citizenship if citizenship ceases under this subdivision."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36l",
      "@type": "cof:Section",
      "cof:title": "36L No resumption of citizenship if citizenship ceases under this",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "Subdivision\n\nIf a person ceases to be an Australian citizen under this\nSubdivision, Divisions 1 and 2 of this Part do not apply in relation\nto the person after that cessation.\nNote:\nSee section 36B for when a person ceases to be an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-36l-norm",
