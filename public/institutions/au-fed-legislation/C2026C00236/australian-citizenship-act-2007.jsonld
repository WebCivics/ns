    {
      "@id": "concept:australian-citizenship-act-2007-sec-36b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "36B(4) Cessation of citizenship if citizenship cessation order made by",
      "cml:realizedBy": {
