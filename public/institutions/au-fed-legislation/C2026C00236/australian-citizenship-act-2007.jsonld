    {
      "@id": "concept:australian-citizenship-act-2007-sec-15a",
      "@type": "cml:Concept",
      "skos:prefLabel": "15A Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-15a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.26",
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision in 2 situations:\n•\nyou were born outside Australia on or after 26 January 1949\nand a parent of yours was an Australian citizen at the time of\nyour birth: see subsection 16(2); or\n•\nyou were born outside Australia or New Guinea before",
      "skos:definition": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision in 2 situations:\n•\nyou were born outside Australia on or after 26 January 1949\nand a parent of yours was an Australian citizen at the time of\nyour birth: see subsection 16(2); or\n•\nyou were born outside Australia or New Guinea before",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-15a-norm"
        }
      ],
      "cml:integrityHash": "2716b533386238fe13bf129b95febb8a5547d4c28ecb850af7bcb85923e9498a",
      "skos:note": "Eligibility for Australian citizenship under Subdivision"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-15a",
      "@type": "cof:Section",
      "cof:title": "15A Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision in 2 situations:\n•\nyou were born outside Australia on or after 26 January 1949\nand a parent of yours was an Australian citizen at the time of\nyour birth: see subsection 16(2); or\n•\nyou were born outside Australia or New Guinea before"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-15a-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
