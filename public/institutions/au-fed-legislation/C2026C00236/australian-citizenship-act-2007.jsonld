        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Minister is required to approve citizenship.",
      "cml:conclusionText": "Minister must verify person's identity before approving citizenship."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-17-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Cannot",
      "cml:logicSummary": "Minister cannot approve citizenship without verifying person's identity.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Minister is not allowed to approve citizenship.",
      "cml:conclusionText": "Minister must verify person's identity before approving citizenship."
    },
    {
