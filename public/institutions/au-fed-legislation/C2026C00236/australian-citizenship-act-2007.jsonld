      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.61",
      "values:originalText": "Form of pledge\n\n(1) A pledge of commitment must be made in accordance with either\nof the forms set out in Schedule 1.",
      "skos:definition": "Form of pledge\n\n(1) A pledge of commitment must be made in accordance with either\nof the forms set out in Schedule 1.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-27-norm"
