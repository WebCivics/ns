    {
      "@id": "concept:australian-citizenship-act-2007-sec-28-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "28(4) Day citizenship begins etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
