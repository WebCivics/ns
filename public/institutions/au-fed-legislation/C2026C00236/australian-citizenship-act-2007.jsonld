        }
      ],
      "cml:integrityHash": "804c1d495c77a6c75edfb175d36c12e82c4c1ce6bdc1ff4d7f60e67db801c0f1",
      "skos:note": "Pledge of loyalty to Australia and its people"
    },
    {
