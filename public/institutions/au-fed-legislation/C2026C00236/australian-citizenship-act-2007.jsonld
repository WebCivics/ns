      "cml:integrityHash": "6caa567eda5ebe05c552806263f3e510b6fbf927f5c13e6c2c57953806c60fb3",
      "skos:note": "Minister must verify identity of person renouncing citizenship"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-33-ss-4",
      "@type": "cof:Section",
      "cof:title": "33(4) Renunciation by application",
      "values:kind": "subsection",
      "cof:pageNumber": 69,
      "values:originalText": "(4) The Minister must not approve the person renouncing his or her\nAustralian citizenship unless the Minister is satisfied of the identity\nof the person.\nNote:\nDivision 5 contains the identity provisions."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-33-ss-4-norm",
