    {
      "@id": "concept:australian-citizenship-act-2007-sec-145",
      "@type": "cml:Concept",
      "skos:prefLabel": "145 2, 145.4, 145.5 or 149.1 of the Criminal Code, that the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-145"
      },
      "cml:curationStatus": {
