    {
      "@id": "concept:australian-citizenship-act-2007-sec-54",
      "@type": "cml:Concept",
      "skos:prefLabel": "54 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-54"
