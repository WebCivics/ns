      "cml:logicSummary": "Temporal relation between institutional confinement and being an escapee",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) For the purposes of this Act, the period during which a person is\nconfined in a psychiatric institution by order of a court includes a\nperiod during which the person is an escapee from the institution.",
      "cml:conclusionText": "The period during which a person is confined in a psychiatric institution by order of a court spreads to include the period during which the person is an escapee from the institution."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-9-ss-3-logic-cogai-6",
      "@type": "cml:LogicApplication",
