    {
      "@id": "concept:australian-citizenship-act-2007-sec-19e",
      "@type": "cml:Concept",
      "skos:prefLabel": "19E Registration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.34",
      "values:originalText": "If the Minister approves the person becoming an Australian citizen,\nthe Minister must register the person in the manner prescribed by\nthe regulations.",
      "skos:definition": "If the Minister approves the person becoming an Australian citizen,\nthe Minister must register the person in the manner prescribed by\nthe regulations.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19e-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9f248f6e769113a67d54cc1248b2f5970f6f1d45e808d90eb506121cece2b956",
      "skos:note": "Minister must register person upon approval of citizenship."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19e",
      "@type": "cof:Section",
      "cof:title": "19E Registration",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "If the Minister approves the person becoming an Australian citizen,\nthe Minister must register the person in the manner prescribed by\nthe regulations."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19e-norm",
      "@type": "values:Obligation",
