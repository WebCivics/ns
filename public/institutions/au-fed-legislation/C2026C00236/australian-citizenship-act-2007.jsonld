    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19f",
      "@type": "cml:Concept",
      "skos:prefLabel": "19F Day citizenship begins",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.34",
      "values:originalText": "A person becomes an Australian citizen under this Subdivision on\nthe day on which the Minister approves the person becoming an\nAustralian citizen.\n\n\nAustralian citizenship  Part 2\nAcquisition of Australian citizenship by application  Division 2\n\nSection 19G\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\nSubdivision B—Citizenship by conferral",
      "skos:definition": "A person becomes an Australian citizen under this Subdivision on\nthe day on which the Minister approves the person becoming an\nAustralian citizen.\n\n\nAustralian citizenship  Part 2\nAcquisition of Australian citizenship by application  Division 2\n\nSection 19G\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\nSubdivision B—Citizenship by conferral",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19f-norm"
        }
      ],
      "cml:integrityHash": "9e93b148862815e55b1242651fb8555b02cd3ac9e781254f1bdf30074f351ad7",
      "skos:note": "Day on which citizenship begins"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19f",
      "@type": "cof:Section",
      "cof:title": "19F Day citizenship begins",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "A person becomes an Australian citizen under this Subdivision on\nthe day on which the Minister approves the person becoming an\nAustralian citizen.\n\n\nAustralian citizenship  Part 2\nAcquisition of Australian citizenship by application  Division 2\n\nSection 19G\n\nAustralian Citizenship Act 2007\n\nCompilation date: 04/06/2026\n\nSubdivision B—Citizenship by conferral"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19f-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-19f"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19g",
      "@type": "cml:Concept",
      "skos:prefLabel": "19G Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.35",
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision in 7 situations:\n•\nyou satisfy the general eligibility criteria and have\nsuccessfully completed a citizenship test: see\nsubsections 21(2) and (2A); or\n•\nyou have a permanent or enduring physical or mental\nincapacity: see subsection 21(3); or\n•\nyou are aged 60 or over or have a hearing, speech or sight\nimpairment: see subsection 21(4); or\n•\nyou are aged under 18: see subsection 21(5); or\n•\nyou were born to a former Australian citizen: see\nsubsection 21(6); or\n•\nyou were born in Papua: see subsection 21(7); or\n•\nyou are a stateless person: see subsection 21(8).\nYou must make an application to become an Australian citizen.\nThe Minister must approve or refuse you becoming an Australian\ncitizen.\nYou must be eligible to be an Australian citizen to be approved.\nYou may be refused citizenship even if you are eligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:",
      "skos:definition": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision in 7 situations:\n•\nyou satisfy the general eligibility criteria and have\nsuccessfully completed a citizenship test: see\nsubsections 21(2) and (2A); or\n•\nyou have a permanent or enduring physical or mental\nincapacity: see subsection 21(3); or\n•\nyou are aged 60 or over or have a hearing, speech or sight\nimpairment: see subsection 21(4); or\n•\nyou are aged under 18: see subsection 21(5); or\n•\nyou were born to a former Australian citizen: see\nsubsection 21(6); or\n•\nyou were born in Papua: see subsection 21(7); or\n•\nyou are a stateless person: see subsection 21(8).\nYou must make an application to become an Australian citizen.\nThe Minister must approve or refuse you becoming an Australian\ncitizen.\nYou must be eligible to be an Australian citizen to be approved.\nYou may be refused citizenship even if you are eligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19g-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c09aa8e73bd4b4b37d522be5536fa203d8b63a18b72deec99afa46770de68ad7",
      "skos:note": "Must make an application, Minister must approve or refuse"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19g",
      "@type": "cof:Section",
      "cof:title": "19G Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision in 7 situations:\n•\nyou satisfy the general eligibility criteria and have\nsuccessfully completed a citizenship test: see\nsubsections 21(2) and (2A); or\n•\nyou have a permanent or enduring physical or mental\nincapacity: see subsection 21(3); or\n•\nyou are aged 60 or over or have a hearing, speech or sight\nimpairment: see subsection 21(4); or\n•\nyou are aged under 18: see subsection 21(5); or\n•\nyou were born to a former Australian citizen: see\nsubsection 21(6); or\n•\nyou were born in Papua: see subsection 21(7); or\n•\nyou are a stateless person: see subsection 21(8).\nYou must make an application to become an Australian citizen.\nThe Minister must approve or refuse you becoming an Australian\ncitizen.\nYou must be eligible to be an Australian citizen to be approved.\nYou may be refused citizenship even if you are eligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19g-norm",
