    {
      "@id": "concept:australian-citizenship-act-2007-sec-36-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "36(3) Children of responsible parents who cease to be citizens",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.74",
      "values:originalText": "(3) The Minister must not revoke a child’s Australian citizenship\nunder subsection (1) if the Minister is satisfied that the child would\nthen become a person who is not a national or citizen of any\ncountry.\nSubdivision C—Citizenship cessation",
      "skos:definition": "(3) The Minister must not revoke a child’s Australian citizenship\nunder subsection (1) if the Minister is satisfied that the child would\nthen become a person who is not a national or citizen of any\ncountry.\nSubdivision C—Citizenship cessation",
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-36"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36-ss-3-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-36-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "72f2026be6880dd4f8e68e13feaa0a227a26c9d8bd7a9e273da92e0507f79ee3",
      "skos:note": "Cannot revoke child's Australian citizenship under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36-ss-3",
      "@type": "cof:Section",
      "cof:title": "36(3) Children of responsible parents who cease to be citizens",
      "values:kind": "subsection",
      "cof:pageNumber": 74,
      "values:originalText": "(3) The Minister must not revoke a child’s Australian citizenship\nunder subsection (1) if the Minister is satisfied that the child would\nthen become a person who is not a national or citizen of any\ncountry.\nSubdivision C—Citizenship cessation"
    },
