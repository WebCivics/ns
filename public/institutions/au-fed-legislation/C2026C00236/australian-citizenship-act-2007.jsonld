    {
      "@id": "concept:australian-citizenship-act-2007-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 How pledge of commitment is to be made",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
