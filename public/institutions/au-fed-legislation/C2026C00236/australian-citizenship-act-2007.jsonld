        }
      ],
      "cml:integrityHash": "eb6cf32da30b1ef0261f5324f817e72b0f5396f7f09600534e73b6d3ab67beb0",
      "skos:note": "Appeal must be lodged within a period for proceedings to end."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-45c-ss-5",
      "@type": "cof:Section",
      "cof:title": "45C(5) Document condemned as forfeited",
      "values:kind": "subsection",
      "cof:pageNumber": 93,
      "values:originalText": "(5) For the purposes of subsection (4), if the proceedings go to\njudgment, they end:\n\n(a) if no appeal against the judgment is lodged within the period\nfor lodging such an appeal—at the end of that period; or"
    },
