      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission to become an Australian citizen",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "You may be eligible to become an Australian citizen under this Subdivision"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-19c",
      "@type": "cml:Concept",
      "skos:prefLabel": "19C Application and eligibility for citizenship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.31",
      "values:originalText": "(1) A person may make an application to the Minister to become an\nAustralian citizen.\nNote:\nSection 46 sets out application requirements (which may include the\npayment of a fee).\nEligibility\n\n(2) A person (the applicant) is eligible to become an Australian citizen\nif:\n\n(a) the applicant is adopted in a Convention country or a\nprescribed overseas jurisdiction by:\n\n(i) a person (the adopter) who is an Australian citizen at\ntime of the adoption; or\n\n(ii) 2 persons jointly, only one of whom (the adopter) is an\nAustralian citizen at the time of the adoption; or\n\n(iii) 2 persons jointly, both of whom (the adopters) are\nAustralian citizens at the time of the adoption; and\n\n(b) an adoption compliance certificate issued in that country is in\nforce for the adoption; and\n\n(c) under the Intercountry Adoption regulations or the Bilateral\nArrangements regulations, as applicable, the adoption is\nrecognised and effective for the laws of the Commonwealth\nand each State and Territory; and\n\n(d) the legal relationship between the applicant and the\nindividuals who were, immediately before the adoption, the\napplicant’s parents has been terminated; and\n\n(e) if subparagraph (a)(i) or (ii) applies and the adopter is an\nAustralian citizen under Subdivision A or this Subdivision at",
      "skos:definition": "(1) A person may make an application to the Minister to become an\nAustralian citizen.\nNote:\nSection 46 sets out application requirements (which may include the\npayment of a fee).\nEligibility\n\n(2) A person (the applicant) is eligible to become an Australian citizen\nif:\n\n(a) the applicant is adopted in a Convention country or a\nprescribed overseas jurisdiction by:\n\n(i) a person (the adopter) who is an Australian citizen at\ntime of the adoption; or\n\n(ii) 2 persons jointly, only one of whom (the adopter) is an\nAustralian citizen at the time of the adoption; or\n\n(iii) 2 persons jointly, both of whom (the adopters) are\nAustralian citizens at the time of the adoption; and\n\n(b) an adoption compliance certificate issued in that country is in\nforce for the adoption; and\n\n(c) under the Intercountry Adoption regulations or the Bilateral\nArrangements regulations, as applicable, the adoption is\nrecognised and effective for the laws of the Commonwealth\nand each State and Territory; and\n\n(d) the legal relationship between the applicant and the\nindividuals who were, immediately before the adoption, the\napplicant’s parents has been terminated; and\n\n(e) if subparagraph (a)(i) or (ii) applies and the adopter is an\nAustralian citizen under Subdivision A or this Subdivision at",
      "cml:hasPart": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19c-ss-1"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-19c-ss-2"
        }
      ],
      "cml:integrityHash": "e5e93ce34b55f2d3a3ff72236bbe8bdb85e4ecaff2e4609eb80fe895c110a54a"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-19c",
      "@type": "cof:Section",
      "cof:title": "19C Application and eligibility for citizenship",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "(1) A person may make an application to the Minister to become an\nAustralian citizen.\nNote:\nSection 46 sets out application requirements (which may include the\npayment of a fee).\nEligibility\n\n(2) A person (the applicant) is eligible to become an Australian citizen\nif:\n\n(a) the applicant is adopted in a Convention country or a\nprescribed overseas jurisdiction by:\n\n(i) a person (the adopter) who is an Australian citizen at\ntime of the adoption; or\n\n(ii) 2 persons jointly, only one of whom (the adopter) is an\nAustralian citizen at the time of the adoption; or\n\n(iii) 2 persons jointly, both of whom (the adopters) are\nAustralian citizens at the time of the adoption; and\n\n(b) an adoption compliance certificate issued in that country is in\nforce for the adoption; and\n\n(c) under the Intercountry Adoption regulations or the Bilateral\nArrangements regulations, as applicable, the adoption is\nrecognised and effective for the laws of the Commonwealth\nand each State and Territory; and\n\n(d) the legal relationship between the applicant and the\nindividuals who were, immediately before the adoption, the\napplicant’s parents has been terminated; and\n\n(e) if subparagraph (a)(i) or (ii) applies and the adopter is an\nAustralian citizen under Subdivision A or this Subdivision at"
    },
