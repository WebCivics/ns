    {
      "@id": "concept:australian-citizenship-act-2007-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Citizenship by adoption",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.24",
      "values:originalText": "A person is an Australian citizen if the person is:\n\n(a) adopted under a law in force in a State or Territory; and\n\n(b) adopted by a person who is an Australian citizen at the time\nof the adoption or by 2 persons jointly at least one of whom\nis an Australian citizen at that time; and\n\n(c) present in Australia as a permanent resident at that time.",
      "skos:definition": "A person is an Australian citizen if the person is:\n\n(a) adopted under a law in force in a State or Territory; and\n\n(b) adopted by a person who is an Australian citizen at the time\nof the adoption or by 2 persons jointly at least one of whom\nis an Australian citizen at that time; and\n\n(c) present in Australia as a permanent resident at that time.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-13-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "74161858a711c6e70eabab169cf2104d940874bf49d7aee28305628098dd7dd7",
      "skos:note": "Citizenship by adoption conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Citizenship by adoption",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "A person is an Australian citizen if the person is:\n\n(a) adopted under a law in force in a State or Territory; and\n\n(b) adopted by a person who is an Australian citizen at the time\nof the adoption or by 2 persons jointly at least one of whom\nis an Australian citizen at that time; and\n\n(c) present in Australia as a permanent resident at that time."
    },
