    {
      "@id": "concept:australian-citizenship-act-2007-sec-28a",
      "@type": "cml:Concept",
      "skos:prefLabel": "28A Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.63",
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you ceased to be an Australian citizen under this Act\nor the old Act.\nYou must make an application to become an Australian citizen\nagain. The Minister must approve or refuse you becoming an\nAustralian citizen again.\nYou must be eligible to be an Australian citizen again to be\napproved. You may be refused citizenship again even if you are\neligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:\n•\nnon-satisfaction of identity: see subsection 30(3); or",
      "skos:definition": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you ceased to be an Australian citizen under this Act\nor the old Act.\nYou must make an application to become an Australian citizen\nagain. The Minister must approve or refuse you becoming an\nAustralian citizen again.\nYou must be eligible to be an Australian citizen again to be\napproved. You may be refused citizenship again even if you are\neligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:\n•\nnon-satisfaction of identity: see subsection 30(3); or",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-28a-norm"
        },
        {
          "@id": "concept:australian-citizenship-act-2007-sec-28a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e1d36301710de389a1aa304ec643ad2d634c0f43b9886ca126daa0eedaad7314",
      "skos:note": "Eligibility for Australian citizenship reapplication"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28a",
      "@type": "cof:Section",
      "cof:title": "28A Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "The following is a simplified outline of this Subdivision:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you ceased to be an Australian citizen under this Act\nor the old Act.\nYou must make an application to become an Australian citizen\nagain. The Minister must approve or refuse you becoming an\nAustralian citizen again.\nYou must be eligible to be an Australian citizen again to be\napproved. You may be refused citizenship again even if you are\neligible.\nThe Minister may be required to refuse your application on\ngrounds relating to:\n•\nnon-satisfaction of identity: see subsection 30(3); or"
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-28a-norm",
