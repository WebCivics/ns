        }
      ],
      "cml:integrityHash": "79128d8cb115d54dac7fd750e9f5d220642075f0824ef416fabf48eb7389e04d",
      "skos:note": "A person becomes an Australian citizen on the day of approval by the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28-ss-2",
      "@type": "cof:Section",
