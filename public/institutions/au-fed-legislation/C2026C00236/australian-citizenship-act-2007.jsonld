        }
      ],
      "cml:integrityHash": "bf0b5d25e35254bb329c6d2c1142e5d098e406424554adc3421575fee3dc26ec",
      "skos:note": "Pledge of commitment must be made in a specific form."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 How pledge of commitment is to be made",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "Form of pledge\n\n(1) A pledge of commitment must be made in accordance with either\nof the forms set out in Schedule 1."
    },
    {
      "@id": "concept:australian-citizenship-act-2007-sec-27-norm",
      "@type": "values:Obligation",
