    {
      "@id": "concept:australian-citizenship-act-2007-sec-36d-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "36D(5) Application by the Minister for a citizenship cessation order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-36d-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
