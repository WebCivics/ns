    {
      "@id": "concept:australian-citizenship-act-2007-sec-28-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "28(3) Day citizenship begins etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-act-2007#sec-28-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-act-2007.pdf, p.62",
      "values:originalText": "(3) Subsection (2) does not apply to a child aged under 16 at the time\nthe child made the application to become an Australian citizen if:\n\n(a) 1 or more responsible parents of the child made applications\nunder section 21 at that time; and\n\n(b) the Minister decided under section 24 to approve the child\nand 1 or more of the responsible parents becoming Australian\ncitizens.",
      "skos:definition": "(3) Subsection (2) does not apply to a child aged under 16 at the time\nthe child made the application to become an Australian citizen if:\n\n(a) 1 or more responsible parents of the child made applications\nunder section 21 at that time; and\n\n(b) the Minister decided under section 24 to approve the child\nand 1 or more of the responsible parents becoming Australian\ncitizens.",
      "values:partOf": {
        "@id": "concept:australian-citizenship-act-2007-sec-28"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-act-2007-sec-28-ss-3-norm"
