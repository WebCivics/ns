concept:data-matching-program-assistance-and-tax-act-1990-sec-9-2 a cml:Concept ;
    skos:prefLabel "9 Length of data matching cycle"@en ;
    cml:realizedBy doc:sec-9-2 ;
    values:originalText "(1) A data matching cycle is to be completed no later than 2 months after it began.  (2) Step 5 in a data matching cycle is to be completed no later than 7 days after it began." ;
    skos:definition "(1) A data matching cycle is to be completed no later than 2 months after it began.  (2) Step 5 in a data matching cycle is to be completed no later than 7 days after it began."@en ;
