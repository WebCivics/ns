concept:data-matching-program-assistance-and-tax-act-1990-sec-7-2 a cml:Concept ;
    skos:prefLabel "7 Section 7"@en ;
    cml:realizedBy doc:sec-7-2 ;
    values:originalText "The tax agency uses tax data from not more than the 4 financial years immediately before the current financial year and data given to it under Step 2 to find out the following available data in respect of each person who has a tax file number:   Data-matching  Part 2  Section 7  Data-matching Program (Assistance and Tax) Act 1990  Compilation date: 01/07/2026  (a) tax file number;  (b) personal identity data;  (c) declared income;  (ca) the date of the most recent assessment under the Income Tax Assessment Act 1936 of the person’s declared income;  (cb) the amount of spouse rebate;  (d) surname and any other name or initial of any other name of a spouse in respect of whom spouse rebate is claimed;  (e) surname and any other name or initial of any other name of any spouse of the person." ;
    skos:definition "The tax agency uses tax data from not more than the 4 financial years immediately before the current financial year and data given to it under Step 2 to find out the following available data in respect of each person who has a tax file number:   Data-matching  Part 2  Section 7  Data-matching Program (Assistance and Tax) Act 1990  Compilation date: 01/07/2026  (a) tax file number;  (b) personal identity data;  (c) declared income;  (ca) the date of the most recent assessment under the Income Tax Assessment Act 1936 of the person’s declared income;  (cb) the amount of spouse rebate;  (d) surname and any other name or initial of any other name of a spouse in respect of whom spouse rebate is claimed;  (e) surname and any other name or initial of any other name of any spouse of the person."@en ;
    cml:integrityHash "d4c623598639e5b06f67ded870a4854542d176d253ad621bbad1b92d3cce611a" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Tax agency must provide specified data to find out information about each person with a tax file number." ;
    dc:description "yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-matching-program-assistance-and-tax-act-1990.pdf> ;
    dc:source "data-matching-program-assistance-and-tax-act-1990.pdf, p.14" ;
    cml:asserts concept:data-matching-program-assistance-and-tax-act-1990-sec-7-2-norm .
