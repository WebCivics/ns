concept:data-matching-program-assistance-and-tax-act-1990-sec-3a a cml:Concept ;
    skos:prefLabel "3A Directions by Secretary of the Social Services Department"@en ;
    cml:realizedBy doc:sec-3a ;
    values:originalText "(1) If:  (a) the Secretary of the Social Services Department delegates to:  (i) the Chief Executive Centrelink; or  (ii) a Departmental employee (within the meaning of the Human Services (Centrelink) Act 1997);  all or any of that Secretary’s powers under an Act; and" ;
    skos:definition "(1) If:  (a) the Secretary of the Social Services Department delegates to:  (i) the Chief Executive Centrelink; or  (ii) a Departmental employee (within the meaning of the Human Services (Centrelink) Act 1997);  all or any of that Secretary’s powers under an Act; and"@en ;
    cml:integrityHash "3c0f49540ee7419a64ec6ad0d93bfee7329ce3a5e0257a1af0e2a826beddbbe5" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Secretary of Social Services Department has power to delegate to certain persons." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
