concept:data-matching-program-assistance-and-tax-act-1990-sec-9 a cml:Concept ;
    skos:prefLabel "9 Section 9"@en ;
    cml:realizedBy doc:sec-9 ;
    values:originalText "The matching agency carries out identity matching by matching the personal identity data given under paragraph 8 with the family identity data given to it." ;
    skos:definition "The matching agency carries out identity matching by matching the personal identity data given under paragraph 8 with the family identity data given to it."@en ;
