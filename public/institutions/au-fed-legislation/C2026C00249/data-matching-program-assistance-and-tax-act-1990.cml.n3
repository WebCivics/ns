concept:data-matching-program-assistance-and-tax-act-1990-sec-8a a cml:Concept ;
    skos:prefLabel "8A Section 8A"@en ;
    cml:realizedBy doc:sec-8a ;
    values:originalText "If the tax agency gives the matching agency tax file numbers under paragraph 8, the tax agency may indicate to the matching agency which, if any, of those tax file numbers, according to the tax agency’s records, may have become known to, or used by, a person not authorised to know or use that tax file number. STEP 4" ;
    skos:definition "If the tax agency gives the matching agency tax file numbers under paragraph 8, the tax agency may indicate to the matching agency which, if any, of those tax file numbers, according to the tax agency’s records, may have become known to, or used by, a person not authorised to know or use that tax file number. STEP 4"@en ;
    cml:integrityHash "eb5eab45f259b85e48c08bb189f667a4594249796f22e0bec02a6854641d657b" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Tax agency may indicate tax file numbers used by unauthorized persons." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
