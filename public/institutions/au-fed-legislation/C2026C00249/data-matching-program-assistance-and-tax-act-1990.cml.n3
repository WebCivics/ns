concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-3 a cml:Concept ;
    skos:prefLabel "10(3) Source agencies may use results of data program"@en ;
    cml:realizedBy doc:sec-10-ss-3 ;
    values:originalText "(3) Subject to subsection (3A), a source agency must commence any action in relation to information it receives under subsection (1) within 12 months from the date that it receives the information from the matching agency." ;
    skos:definition "(3) Subject to subsection (3A), a source agency must commence any action in relation to information it receives under subsection (1) within 12 months from the date that it receives the information from the matching agency."@en ;
