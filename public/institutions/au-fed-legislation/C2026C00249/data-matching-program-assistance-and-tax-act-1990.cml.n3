concept:data-matching-program-assistance-and-tax-act-1990-sec-11-2-ss-5a a cml:Concept ;
    skos:prefLabel "11(5A) Notice of proposed action"@en ;
    cml:realizedBy doc:sec-11-2-ss-5a ;
    values:originalText "(5A) If a person responds orally to a notice, the person receiving the oral response must make a written record of the response and note on the record the date of the response." ;
