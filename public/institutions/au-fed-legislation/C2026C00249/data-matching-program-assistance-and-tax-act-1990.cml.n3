    cml:hasPart concept:data-matching-program-assistance-and-tax-act-1990-sec-12-2-ss-6 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-matching-program-assistance-and-tax-act-1990.pdf> ;
    dc:source "data-matching-program-assistance-and-tax-act-1990.pdf, p.22" .
