doc:sec-11-2-ss-4 a cof:Section ;
    cof:title "11(4) Notice of proposed action" ;
    values:kind "subsection" ;
    values:originalText "(4) The assistance agency may take action described in subsection (1) without complying with paragraphs (1)(e) and (f) if compliance would prejudice the effectiveness of an investigation into the possible commission of an offence." ;
    cof:pageNumber "20"^^xsd:integer .

