    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must not",
      "cml:logicSummary": "Prohibition on destroying information without conditions being met",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Unless certain conditions are met, the agency must destroy the information.",
      "cml:conclusionText": "The agency may not destroy the information unless certain conditions are met."
    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
