    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Section 13",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.16",
      "values:originalText": "Where the matching of family identity data given by assistance\nagencies in Step 1 cannot identify a person for the purposes of\nparagraph 12, the matching agency matches TFN data given to it in\nStep 1 with the data being matched under that paragraph.",
      "skos:definition": "Where the matching of family identity data given by assistance\nagencies in Step 1 cannot identify a person for the purposes of\nparagraph 12, the matching agency matches TFN data given to it in\nStep 1 with the data being matched under that paragraph.",
      "cml:asserts": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-13-norm"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9388644a7d0b9cc3201fbf77c7abf7101209cad94106b2aeba6924744c113880",
      "skos:note": "Matching agency must match TFN data with matching agency's data."
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Section 13",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Where the matching of family identity data given by assistance\nagencies in Step 1 cannot identify a person for the purposes of\nparagraph 12, the matching agency matches TFN data given to it in\nStep 1 with the data being matched under that paragraph."
    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-13-norm",
