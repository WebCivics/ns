      "skos:note": "Matching agency must receive basic data about persons."
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-1-3",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The assistance agencies give the matching agency the basic data\nabout persons that is held by those agencies for the purposes of\npersonal assistance."
    },
