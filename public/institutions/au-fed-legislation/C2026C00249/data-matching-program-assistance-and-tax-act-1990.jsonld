    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Section 15",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.17",
      "values:originalText": "The matching agency gives to each source agency the results of\nmatching under earlier steps that are of concern to that other\nagency and have not been given to the other agency in an earlier\nstep, being results that indicate:\n\n(a) in the case of an assistance agency:\n\n(i) that personal assistance is being, or has been, given to,\nor is being claimed by, persons who might not be, or\nmight not have been, entitled to it; and\n\n(ii) that personal assistance is not being, or has not been,\ngiven to, or claimed by, persons who might be, or might\nhave been, entitled to it; or\n\n(b) in the case of the tax agency—that a person might be\nevading, or might have evaded, tax.",
      "skos:definition": "The matching agency gives to each source agency the results of\nmatching under earlier steps that are of concern to that other\nagency and have not been given to the other agency in an earlier\nstep, being results that indicate:\n\n(a) in the case of an assistance agency:\n\n(i) that personal assistance is being, or has been, given to,\nor is being claimed by, persons who might not be, or\nmight not have been, entitled to it; and\n\n(ii) that personal assistance is not being, or has not been,\ngiven to, or claimed by, persons who might be, or might\nhave been, entitled to it; or\n\n(b) in the case of the tax agency—that a person might be\nevading, or might have evaded, tax.",
      "cml:asserts": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-15-norm"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8a7a9816a223c188f3ebcdd50a48e25d7812e78a7d38ef64e06f925c5c638313",
      "skos:note": "Tax evasion is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Section 15",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "The matching agency gives to each source agency the results of\nmatching under earlier steps that are of concern to that other\nagency and have not been given to the other agency in an earlier\nstep, being results that indicate:\n\n(a) in the case of an assistance agency:\n\n(i) that personal assistance is being, or has been, given to,\nor is being claimed by, persons who might not be, or\nmight not have been, entitled to it; and\n\n(ii) that personal assistance is not being, or has not been,\ngiven to, or claimed by, persons who might be, or might\nhave been, entitled to it; or\n\n(b) in the case of the tax agency—that a person might be\nevading, or might have evaded, tax."
    },
