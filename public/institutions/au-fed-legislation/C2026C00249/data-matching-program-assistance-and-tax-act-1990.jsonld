    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-15-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Confidentiality",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-15-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.25",
      "values:originalText": "(1) An officer of an agency who has information only because of\nperforming functions or duties under this Act, must not make a\nrecord of, or disclose, any of the information.\nPenalty: Imprisonment for 2 years.\n\n(1A) Subsection (1) does not apply if the information is recorded or\ndisclosed:\n\n(a) in the course of carrying out functions or duties under this\nAct; or",
      "skos:definition": "(1) An officer of an agency who has information only because of\nperforming functions or duties under this Act, must not make a\nrecord of, or disclose, any of the information.\nPenalty: Imprisonment for 2 years.\n\n(1A) Subsection (1) does not apply if the information is recorded or\ndisclosed:\n\n(a) in the course of carrying out functions or duties under this\nAct; or",
      "cml:hasPart": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-15-2-ss-1"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-15-2-ss-1a"
        }
      ],
