    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(3A) Source agencies may use results of data program",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-10-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.18",
      "values:originalText": "(3A) The Secretary of an assistance agency (other than the Human\nServices Department), the Chief Executive Centrelink, the\nCommissioner of Taxation or a Deputy Commissioner of Taxation\nmay grant an extension or extensions of time for up to 12 months\neach of the 12 month period referred to in subsection (3).",
      "skos:definition": "(3A) The Secretary of an assistance agency (other than the Human\nServices Department), the Chief Executive Centrelink, the\nCommissioner of Taxation or a Deputy Commissioner of Taxation\nmay grant an extension or extensions of time for up to 12 months\neach of the 12 month period referred to in subsection (3).",
      "values:partOf": {
        "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10"
      },
      "cml:asserts": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-3a-norm"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4e5bc6703aa73351a45ee9c4098ff2f99524f50ee8cb7fa1678e83c25cdc7220",
      "skos:note": "Grant extension of time for up to 12 months"
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-10-ss-3a",
      "@type": "cof:Section",
      "cof:title": "10(3A) Source agencies may use results of data program",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(3A) The Secretary of an assistance agency (other than the Human\nServices Department), the Chief Executive Centrelink, the\nCommissioner of Taxation or a Deputy Commissioner of Taxation\nmay grant an extension or extensions of time for up to 12 months\neach of the 12 month period referred to in subsection (3)."
    },
