      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-15-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "15(1) Confidentiality",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(1) An officer of an agency who has information only because of\nperforming functions or duties under this Act, must not make a\nrecord of, or disclose, any of the information.\nPenalty: Imprisonment for 2 years."
    },
