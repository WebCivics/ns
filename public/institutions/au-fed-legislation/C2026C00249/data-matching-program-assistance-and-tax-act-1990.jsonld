      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST PROVIDE",
      "cml:logicSummary": "Tax agency must provide data",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-8",
