      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Obligation is a type of cognitive action.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) While a direction under section 3A is in force, the Chief Executive",
      "cml:conclusionText": "Centrelink is to ensure that there are Departmental employees who are responsible for the matching of data under this Act."
    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Effect of other Acts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
