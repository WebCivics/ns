      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.14",
      "values:originalText": "The matching agency checks the validity of the TFN data given\nunder paragraph 1 by using any algorithm given to it for the\npurposes of this Act by the tax agency.",
      "skos:definition": "The matching agency checks the validity of the TFN data given\nunder paragraph 1 by using any algorithm given to it for the\npurposes of this Act by the tax agency.",
      "cml:asserts": [
