      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The agency has considered that particular information and made a decision to take action on the basis of that information.",
      "cml:conclusionText": "The agency must take action on the basis of the information."
    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-10-ss-2-logic-deontic-5",
