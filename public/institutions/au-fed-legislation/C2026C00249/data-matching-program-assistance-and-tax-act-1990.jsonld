    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-14-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Complaints of breaches of privacy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-14-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.25",
      "values:originalText": "(1) A breach of Part 2 of this Act or a breach of the rules referred to in\nsection 12 constitutes an act or practice involving interference with\nthe privacy of an individual for the purposes of section 13 of the\nPrivacy Act 1988.\n\n(2) An individual may complain to the Information Commissioner\nabout an act or practice in relation to the operation of this Act\nwhich may be an interference with the privacy of the individual.\n\n(3) In the event of a complaint being made by an individual, it shall be\ndealt with in accordance with the provisions of Part V of the\nPrivacy Act 1988, which shall apply mutatis mutandis to this Act.",
      "skos:definition": "(1) A breach of Part 2 of this Act or a breach of the rules referred to in\nsection 12 constitutes an act or practice involving interference with\nthe privacy of an individual for the purposes of section 13 of the\nPrivacy Act 1988.\n\n(2) An individual may complain to the Information Commissioner\nabout an act or practice in relation to the operation of this Act\nwhich may be an interference with the privacy of the individual.\n\n(3) In the event of a complaint being made by an individual, it shall be\ndealt with in accordance with the provisions of Part V of the\nPrivacy Act 1988, which shall apply mutatis mutandis to this Act.",
      "cml:hasPart": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-14-2-ss-1"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-14-2-ss-2"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-14-2-ss-3"
        }
      ],
      "cml:integrityHash": "6ccb927060b5cd085ca4cbb0dbd3137ab428ef8e86cfc4458e3d1c50ab654e27"
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-14-2",
      "@type": "cof:Section",
      "cof:title": "14 Complaints of breaches of privacy",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "(1) A breach of Part 2 of this Act or a breach of the rules referred to in\nsection 12 constitutes an act or practice involving interference with\nthe privacy of an individual for the purposes of section 13 of the\nPrivacy Act 1988.\n\n(2) An individual may complain to the Information Commissioner\nabout an act or practice in relation to the operation of this Act\nwhich may be an interference with the privacy of the individual.\n\n(3) In the event of a complaint being made by an individual, it shall be\ndealt with in accordance with the provisions of Part V of the\nPrivacy Act 1988, which shall apply mutatis mutandis to this Act."
    },
