    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-6-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
