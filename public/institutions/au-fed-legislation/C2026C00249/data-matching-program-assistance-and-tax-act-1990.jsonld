      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.14",
      "values:originalText": "The matching agency gives the tax agency the data extracted under\nparagraph 5.\nSTEP 3",
      "skos:definition": "The matching agency gives the tax agency the data extracted under\nparagraph 5.\nSTEP 3",
      "cml:asserts": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-6-2-norm"
        }
      ],
      "cml:integrityHash": "a6e088136bba08504ab201086c37403c50c1b3a953c44bb4b94ae807cfe6c706",
      "skos:note": "Agency provides data to tax agency"
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-6-2",
      "@type": "cof:Section",
