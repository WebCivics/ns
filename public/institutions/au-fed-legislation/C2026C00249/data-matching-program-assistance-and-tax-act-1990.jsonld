    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-7-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-7-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.14",
      "values:originalText": "The tax agency uses tax data from not more than the 4 financial\nyears immediately before the current financial year and data given\nto it under Step 2 to find out the following available data in respect\nof each person who has a tax file number:\n\n\nData-matching  Part 2\n\nSection 7\n\nData-matching Program (Assistance and Tax) Act 1990\n\nCompilation date: 01/07/2026\n\n(a) tax file number;\n\n(b) personal identity data;\n\n(c) declared income;\n\n(ca) the date of the most recent assessment under the Income Tax\nAssessment Act 1936 of the person’s declared income;\n\n(cb) the amount of spouse rebate;\n\n(d) surname and any other name or initial of any other name of a\nspouse in respect of whom spouse rebate is claimed;\n\n(e) surname and any other name or initial of any other name of\nany spouse of the person.",
      "skos:definition": "The tax agency uses tax data from not more than the 4 financial\nyears immediately before the current financial year and data given\nto it under Step 2 to find out the following available data in respect\nof each person who has a tax file number:\n\n\nData-matching  Part 2\n\nSection 7\n\nData-matching Program (Assistance and Tax) Act 1990\n\nCompilation date: 01/07/2026\n\n(a) tax file number;\n\n(b) personal identity data;\n\n(c) declared income;\n\n(ca) the date of the most recent assessment under the Income Tax\nAssessment Act 1936 of the person’s declared income;\n\n(cb) the amount of spouse rebate;\n\n(d) surname and any other name or initial of any other name of a\nspouse in respect of whom spouse rebate is claimed;\n\n(e) surname and any other name or initial of any other name of\nany spouse of the person.",
      "cml:asserts": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-7-2-norm"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-7-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d4c623598639e5b06f67ded870a4854542d176d253ad621bbad1b92d3cce611a",
      "skos:note": "Tax agency must provide specified data to find out information about each person with a tax file number.",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-7-2",
      "@type": "cof:Section",
      "cof:title": "7 Section 7",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The tax agency uses tax data from not more than the 4 financial\nyears immediately before the current financial year and data given\nto it under Step 2 to find out the following available data in respect\nof each person who has a tax file number:\n\n\nData-matching  Part 2\n\nSection 7\n\nData-matching Program (Assistance and Tax) Act 1990\n\nCompilation date: 01/07/2026\n\n(a) tax file number;\n\n(b) personal identity data;\n\n(c) declared income;\n\n(ca) the date of the most recent assessment under the Income Tax\nAssessment Act 1936 of the person’s declared income;\n\n(cb) the amount of spouse rebate;\n\n(d) surname and any other name or initial of any other name of a\nspouse in respect of whom spouse rebate is claimed;\n\n(e) surname and any other name or initial of any other name of\nany spouse of the person."
    },
    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-7-2-norm",
