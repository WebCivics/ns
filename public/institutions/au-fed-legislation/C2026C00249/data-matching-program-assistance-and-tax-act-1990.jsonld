    {
      "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Matching of data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-matching-program-assistance-and-tax-act-1990.pdf"
      },
      "dc:source": "data-matching-program-assistance-and-tax-act-1990.pdf, p.13",
      "values:originalText": "(1) Subject to subsections (2) and (3):\n\n(a) data about persons may be transferred between agencies; and\n\n(b) data about persons may be matched or otherwise dealt with\nby the matching agency or the tax agency; and\n\n(c) the results of the matching may be given to source agencies;",
      "skos:definition": "(1) Subject to subsections (2) and (3):\n\n(a) data about persons may be transferred between agencies; and\n\n(b) data about persons may be matched or otherwise dealt with\nby the matching agency or the tax agency; and\n\n(c) the results of the matching may be given to source agencies;",
      "cml:asserts": [
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-6-norm"
        },
        {
          "@id": "concept:data-matching-program-assistance-and-tax-act-1990-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "850b99f6a00c9ea9a59e4c30d82f3b84d2bc6b584c6a1e40e56a0858e51cd9c7",
      "skos:note": "Data about persons may be transferred and matched between agencies."
    },
    {
      "@id": "https://ns.webcivics.net/values/data-matching-program-assistance-and-tax-act-1990#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Matching of data",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) Subject to subsections (2) and (3):\n\n(a) data about persons may be transferred between agencies; and\n\n(b) data about persons may be matched or otherwise dealt with\nby the matching agency or the tax agency; and\n\n(c) the results of the matching may be given to source agencies;"
    },
