    <https://ns.webcivics.net/cml/premiseText> "The accredited data recipient gave the CDR consumer the statement referred to in paragraph 4.17(1)(b) or (c).";
    <https://ns.webcivics.net/cml/conclusionText> "The accredited data recipient MUST provide the statement.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
