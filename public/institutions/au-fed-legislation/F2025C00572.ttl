    <https://ns.webcivics.net/cml/operator> "BETWEEN";
    <https://ns.webcivics.net/cml/logicSummary> "The CDR consumer has not elected to delete redundant data between the time the statement was given and the current time.";
    <https://ns.webcivics.net/cml/premiseText> "The CDR consumer has not elected, in accordance with rule 4.16, that their redundant data should be deleted.";
    <https://ns.webcivics.net/cml/conclusionText> "The CDR consumer HAS_BETWEEN the time the statement was given and the current time NOT deleted redundant data.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 0.5000;
