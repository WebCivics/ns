doc:sch-4-sec-5-43-ss-1 a cof:Section ;
    cof:title "5(1) 2  Meeting external dispute resolution requirements—energy sector" ;
    values:kind "subsection" ;
    values:originalText "(1) For the energy sector, persons of the following kinds meet the external dispute resolution requirements in the circumstances indicated: (a) an accredited person that is not a retailer—if it is an AFCA member; (b) a retailer that is not an accredited person—if it is an EWO member; (c) an accredited person that is also a retailer, but not a limited retailer—if it is both an AFCA member and an EWO member; (d) an accredited person that is also a limited retailer—if it is an EWO member. Meaning of AFCA member" ;
    cof:pageNumber "216"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-2 a cml:Concept ;
    skos:prefLabel "5(2) 2  Meeting external dispute resolution requirements—energy sector"@en ;
    cml:realizedBy doc:sch-4-sec-5-43-ss-2 ;
    values:originalText "(2) In this clause, a retailer or an accredited person is an AFCA member if it is a member of the recognised external dispute resolution scheme operated by the Australian Financial Complaints Authority Limited for the energy sector. Meaning of EWO member" ;
    skos:definition "(2) In this clause, a retailer or an accredited person is an AFCA member if it is a member of the recognised external dispute resolution scheme operated by the Australian Financial Complaints Authority Limited for the energy sector. Meaning of EWO member"@en ;
    cml:integrityHash "308561eaed10ab0b4d05c65789998238b774855aaafb1286f341b185b14644b2" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43 ;
    cof:pageNumber "216"^^xsd:integer ;
    skos:note "Must be an AFCA member of the recognised external dispute resolution scheme for energy sector" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.216" ;
    cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-2-norm .
