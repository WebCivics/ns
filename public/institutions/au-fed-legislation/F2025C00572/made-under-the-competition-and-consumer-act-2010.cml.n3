concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-28-ss-4 a cml:Concept ;
    skos:prefLabel "4(4) 12C  Process for amending consents"@en ;
    cml:realizedBy doc:sch-4-sec-4-28-ss-4 ;
    values:originalText "(4) If the CDR consumer gave the consent as a CDR business consumer, the accredited person must take reasonable steps to re-confirm that: (a) the CDR consumer is not an individual; or (b) the CDR consumer has an active ABN. Note: See subrule 1.10A(9). Subdivision 4.3.2B—Withdrawing consents" ;
    skos:definition "(4) If the CDR consumer gave the consent as a CDR business consumer, the accredited person must take reasonable steps to re-confirm that: (a) the CDR consumer is not an individual; or (b) the CDR consumer has an active ABN. Note: See subrule 1.10A(9). Subdivision 4.3.2B—Withdrawing consents"@en ;
    cml:integrityHash "8cb18357e704a511d3aac278873b00c68c90ce78f94da6ec5be25ec2c2f8dd60" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-28 ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Must re-confirm CDR consumer's status before proceeding." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
