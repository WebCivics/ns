concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-11-ss-4 a cml:Concept ;
    skos:prefLabel "9(4) 6  Audits by the Commission and the Information Commissioner"@en ;
    cml:realizedBy doc:sch-4-sec-9-11-ss-4 ;
    values:originalText "(4) The CDR participant must comply with a request under subrule (3). Note: This subrule is a civil penalty provision (see rule 9.8)." ;
