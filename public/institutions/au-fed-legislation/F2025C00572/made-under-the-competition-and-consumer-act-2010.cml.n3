doc:sch-4-sec-4-67 a cof:Section ;
    cof:title "4 20R  Notification if collection consent or AP disclosure consent expires" ;
    values:kind "section" ;
    values:originalText "(1) This rule applies if: (a) a CDR representative principal has made a consumer data request to an accredited data recipient on behalf of a CDR representative, based on a collection consent given under this Division relating to particular CDR data and that accredited data recipient; and (b) the accredited data recipient has an AP disclosure consent relating to that CDR data; and (c) the request has not been completely resolved." ;
    cof:pageNumber "89"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-68 a cml:Concept ;
    skos:prefLabel "4 20S  Notification if collection consent is amended"@en ;
    cml:realizedBy doc:sch-4-sec-4-68 ;
    values:originalText "(1) This rule applies if: (a) a CDR representative principal has made a consumer data request to a CDR participant on behalf of a CDR representative, based on a collection consent given under this Division relating to particular CDR data and a particular CDR participant; and (b) the request has not been completely resolved; and (c) the CDR consumer amends the consent. (2) The CDR representative principal must notify: (a) if the CDR participant is a data holder―the data holder, in accordance with the data standards, that the consent has been amended; and (b) if the CDR participant is an accredited data recipient―the accredited data recipient as soon as practicable that the consent has been amended. Note: This subrule is a civil penalty provision (see rule 9.8)." ;
    skos:definition "(1) This rule applies if: (a) a CDR representative principal has made a consumer data request to a CDR participant on behalf of a CDR representative, based on a collection consent given under this Division relating to particular CDR data and a particular CDR participant; and (b) the request has not been completely resolved; and (c) the CDR consumer amends the consent. (2) The CDR representative principal must notify: (a) if the CDR participant is a data holder―the data holder, in accordance with the data standards, that the consent has been amended; and (b) if the CDR participant is an accredited data recipient―the accredited data recipient as soon as practicable that the consent has been amended. Note: This subrule is a civil penalty provision (see rule 9.8)."@en ;
    cml:integrityHash "965723d47737023e8412777000df1dd0f5e47133875ebd9cc3bdcc8a42df59fd" ;
    cof:pageNumber "90"^^xsd:integer ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-68-ss-1 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-68-ss-2 ;
