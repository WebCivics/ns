doc:sch-2-sec-1-11-ss-1 a cof:Section ;
    cof:title "1(1) 4  Step 2—Define the boundaries of the CDR data environment" ;
    values:kind "subsection" ;
    values:originalText "(1) An accredited data recipient must assess, define and document the boundaries of its CDR data environment." ;
    cof:pageNumber "168"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-2-sec-1-11-ss-2 a cml:Concept ;
    skos:prefLabel "1(2) 4  Step 2—Define the boundaries of the CDR data environment"@en ;
    cml:realizedBy doc:sch-2-sec-1-11-ss-2 ;
    values:originalText "(2) The accredited data recipient must review the boundaries of its CDR data environment for completeness and accuracy: (a) as soon as practicable when it becomes aware of material changes to the extent and nature of threats to its CDR data environment; or (b) where no such material changes occur—at least annually." ;
    skos:definition "(2) The accredited data recipient must review the boundaries of its CDR data environment for completeness and accuracy: (a) as soon as practicable when it becomes aware of material changes to the extent and nature of threats to its CDR data environment; or (b) where no such material changes occur—at least annually."@en ;
    cml:integrityHash "a8418031694008a8e4889af6706933c6e79edcce7d30862d954e725aa93ce34b" ;
