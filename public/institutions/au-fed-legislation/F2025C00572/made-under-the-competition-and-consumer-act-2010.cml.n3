doc:sch-4-sec-4-92-ss-1 a cof:Section ;
    cof:title "4(1) 1  AER and the Victorian agency may act on each other’s behalf" ;
    values:kind "subsection" ;
    values:originalText "(1) Where these rules require or permit one of the energy sector agencies to do any thing in relation to receiving or responding to product data requests (including the provision of a product data request service), the other agency may, at the first agency’s request, do the thing on behalf of the first agency." ;
    cof:pageNumber "214"^^xsd:integer .

