    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Must provide a unique accreditation number to an accredited applicant." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
