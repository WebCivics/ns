doc:sch-4-sec-4-15-ss-3 a cof:Section ;
    cof:title "4(3) 6  Disclosing consumer data in response to a consumer data request" ;
    values:kind "subsection" ;
    values:originalText "(3) It must do so: (a) through its accredited person request service; and (b) in accordance with the data standards. Note: This subrule is a civil penalty provision (see rule 9.8)." ;
