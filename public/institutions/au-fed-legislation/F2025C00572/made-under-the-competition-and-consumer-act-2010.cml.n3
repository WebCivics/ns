concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-2 a cml:Concept ;
    skos:prefLabel "4A 1  Purpose of Part"@en ;
    cml:realizedBy doc:sch-4-sec-4a-2 ;
    values:originalText "Special rules apply in relation to consumer data requests under Part 4 under which there is a request for disclosure of CDR data that relates to one or more joint accounts. This Part sets out those rules." ;
    skos:definition "Special rules apply in relation to consumer data requests under Part 4 under which there is a request for disclosure of CDR data that relates to one or more joint accounts. This Part sets out those rules."@en ;
    cml:integrityHash "e38e82e558aa324d272bb218a9fe8d5ac473bec2507be6fc9761daba5e028122" ;
    cof:pageNumber "95"^^xsd:integer ;
    skos:note "Special rules apply for joint accounts in consumer data requests." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
