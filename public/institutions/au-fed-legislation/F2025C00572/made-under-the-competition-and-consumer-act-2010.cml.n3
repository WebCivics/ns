concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-19 a cml:Concept ;
    skos:prefLabel "4A 15  Avoidance of harm"@en ;
    cml:realizedBy doc:sch-4-sec-4a-19 ;
    values:originalText "A data holder is not liable under these rules for a failure to comply with this Part if it considered that the relevant act or omission was necessary in order to prevent physical, psychological or financial harm or abuse to any person.   Rules relating to accreditation etc.  Part 5 Preliminary  Division 5.1 Section 5.1 Competition and Consumer (Consumer Data Right) Rules 2020" ;
    skos:definition "A data holder is not liable under these rules for a failure to comply with this Part if it considered that the relevant act or omission was necessary in order to prevent physical, psychological or financial harm or abuse to any person.   Rules relating to accreditation etc.  Part 5 Preliminary  Division 5.1 Section 5.1 Competition and Consumer (Consumer Data Right) Rules 2020"@en ;
    cml:integrityHash "9cf2918bad1f746fc878d6771f160442f06272476f80df06e0ddc8ebf7c08e16" ;
    cof:pageNumber "104"^^xsd:integer ;
    skos:note "Data holder not liable for failure to comply if necessary to prevent harm." ;
    cml:curationStatus cml:Proposed ;
