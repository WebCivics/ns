doc:sch-4-sec-1-34 a cof:Section ;
    cof:title "1 22  SR data request by a CDR consumer" ;
    values:kind "section" ;
    values:originalText "Note: This rule relates to Division 3.2. (1) This rule applies where a CDR consumer proposes to make an SR data request. (2) The request must be made to the primary data holder, using the primary data holder’s direct request service." ;
    cof:pageNumber "47"^^xsd:integer .

