    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15-ss-2 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15-ss-3 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15-ss-4 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15-ss-5 ;
