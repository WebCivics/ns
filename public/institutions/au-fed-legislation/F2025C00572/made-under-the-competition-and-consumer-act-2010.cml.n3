doc:sch-4-sec-4a-13 a cof:Section ;
    cof:title "4A 11  Asking relevant account holders for approval to disclose joint account" ;
    values:kind "section" ;
    values:originalText "data For the purposes of paragraph 4A.10(4)(b), the data holder must, through its ordinary means of contacting each relevant account holder: (a) indicate that an accredited person has requested disclosure of CDR data that relates to the joint account on behalf of the requester; and (b) indicate that: (i) the requester has authorised, under Division 4.4, the disclosure of the joint account data; and (ii) a co-approval option applies to the joint account; and (c) indicate the matters referred to in paragraphs 4.23(1)(a), (b), (c), (d) and (e) so far as they relate to the request; and (d) ask the relevant account holder to approve or not approve disclosure of the joint account data; and (e) specify the time by which the data holder needs to receive any approval, and inform them that if an approval is not received by that time, the joint account data will not be disclosed; and (f) inform them that any relevant account holder may, at any time, withdraw the approval using their consumer dashboard; and (g) indicate what the effect of removing the approval would be. Note: For removal of an approval, see rule 4A.12." ;
    cof:pageNumber "102"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-14 a cml:Concept ;
    skos:prefLabel "4A 12  Continuation and removal of approvals"@en ;
    cml:realizedBy doc:sch-4-sec-4a-14 ;
    values:originalText "(1) If a relevant account holder: (a) approves of the disclosure of joint account data in accordance with this Division; or (b) is taken to have approved of the disclosure under the pre-approval option; the approval is taken to apply while the authorisation referred to in paragraph" ;
    skos:definition "(1) If a relevant account holder: (a) approves of the disclosure of joint account data in accordance with this Division; or (b) is taken to have approved of the disclosure under the pre-approval option; the approval is taken to apply while the authorisation referred to in paragraph"@en ;
    cml:integrityHash "47ab0593d4c31e3f7bcfd59caa7af8d9bd54b15e1f2074831c4bda101bac0408" ;
    cof:pageNumber "102"^^xsd:integer ;
    skos:note "Approval of disclosure of joint account data is taken to apply while the authorisation referred to in paragraph 1." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
