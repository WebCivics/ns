doc:sch-4-sec-1-26-ss-6 a cof:Section ;
    cof:title "1(6) 16  Obligations relating to outsourcing arrangements" ;
    values:kind "subsection" ;
    values:originalText "(6) For this rule, a provision of a CDR outsourcing arrangement is a required provision if the arrangement would cease to be a CDR outsourcing arrangement under subrule 1.10(3) if the provision were removed." ;
    cof:pageNumber "43"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-27 a cml:Concept ;
    skos:prefLabel "1 16A  Obligations relating to CDR representative arrangements"@en ;
    cml:realizedBy doc:sch-4-sec-1-27 ;
    values:originalText "Compliance with CDR representative arrangement (1) If an accredited person is the CDR representative principal in a CDR representative arrangement, it must ensure that the CDR representative complies with its requirements under the arrangement." ;
    skos:definition "Compliance with CDR representative arrangement (1) If an accredited person is the CDR representative principal in a CDR representative arrangement, it must ensure that the CDR representative complies with its requirements under the arrangement."@en ;
