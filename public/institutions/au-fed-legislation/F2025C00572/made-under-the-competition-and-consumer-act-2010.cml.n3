concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-12 a cml:Concept ;
    skos:prefLabel "5 6  Accreditation decision—accreditation number"@en ;
    cml:realizedBy doc:sch-4-sec-5-12 ;
    values:originalText "The CDR Accreditor must, if it accredits an accreditation applicant, give the applicant a unique number by which it may be identified as an accredited person (their accreditation number)." ;
    skos:definition "The CDR Accreditor must, if it accredits an accreditation applicant, give the applicant a unique number by which it may be identified as an accredited person (their accreditation number)."@en ;
