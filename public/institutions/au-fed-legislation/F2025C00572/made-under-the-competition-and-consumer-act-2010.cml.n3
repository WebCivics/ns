concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12 a cml:Concept ;
    skos:prefLabel "8 5  Termination of appointment and resignation"@en ;
    cml:realizedBy doc:sch-4-sec-8-12 ;
    values:originalText "(1) The Data Standards Chair may, by writing, terminate an appointment to a Data Standards Advisory Committee at any time. (2) An appointee to a Committee may resign his or her appointment by giving the Chair a written resignation. (3) The resignation takes effect on the day it is received by the Chair or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) The Data Standards Chair may, by writing, terminate an appointment to a Data Standards Advisory Committee at any time. (2) An appointee to a Committee may resign his or her appointment by giving the Chair a written resignation. (3) The resignation takes effect on the day it is received by the Chair or, if a later day is specified in the resignation, on that later day."@en ;
    cml:integrityHash "a607ec43127b5c738b001b702d5d5cb90a7f6fb6928231117bd9921c1125223d" ;
    cof:pageNumber "141"^^xsd:integer ;
