concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-76 a cml:Concept ;
    skos:prefLabel "4 24  Restrictions when asking CDR consumer to authorise disclosure of CDR"@en ;
    cml:realizedBy doc:sch-4-sec-4-76 ;
    values:originalText "data When asking a CDR consumer to authorise the disclosure of CDR data or to amend a current authorisation, the data holder must not do any of the following: (a) add any requirements to the authorisation process beyond those specified in the data standards and these rules; (b) provide or request additional information during the authorisation process beyond that specified in the data standards and these rules; (c) offer additional or alternative services as part of the authorisation process; (d) include or refer to other documents." ;
    skos:definition "data When asking a CDR consumer to authorise the disclosure of CDR data or to amend a current authorisation, the data holder must not do any of the following: (a) add any requirements to the authorisation process beyond those specified in the data standards and these rules; (b) provide or request additional information during the authorisation process beyond that specified in the data standards and these rules; (c) offer additional or alternative services as part of the authorisation process; (d) include or refer to other documents."@en ;
    cml:integrityHash "9472900f58317b5568f0033f638fbcb1268695aa553c101485a15b57b6282f40" ;
    cof:pageNumber "93"^^xsd:integer ;
    skos:note "Restrictions on disclosure of CDR data" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
