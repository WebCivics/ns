concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-9 a cml:Concept ;
    skos:prefLabel "3 1A  Application of Part"@en ;
    cml:realizedBy doc:sch-4-sec-3-9 ;
    values:originalText "This Part does not apply in relation to a plan while it is a trial product. Note: If a plan ceases to be a trial product in accordance with subclause 1.5(2) of this Schedule, the data holder must comply with its obligations under this Part in relation to the plan. The obligations cover any CDR data generated while the plan was a trial product." ;
    skos:definition "This Part does not apply in relation to a plan while it is a trial product. Note: If a plan ceases to be a trial product in accordance with subclause 1.5(2) of this Schedule, the data holder must comply with its obligations under this Part in relation to the plan. The obligations cover any CDR data generated while the plan was a trial product."@en ;
    cml:integrityHash "bd45b8965ad2ff3091e9692b9a9df6ae340a512b9cc96557d56bdcb12f9d02c2" ;
    cof:pageNumber "211"^^xsd:integer ;
    skos:note "Comply with obligations under this Part if a plan ceases to be a trial product." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
