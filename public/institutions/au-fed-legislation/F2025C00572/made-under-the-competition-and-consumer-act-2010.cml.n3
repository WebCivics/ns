    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-7-ss-6 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-7-ss-7 ;
