concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-92 a cml:Concept ;
    skos:prefLabel "4 1  AER and the Victorian agency may act on each other’s behalf"@en ;
    cml:realizedBy doc:sch-4-sec-4-92 ;
    values:originalText "(1) Where these rules require or permit one of the energy sector agencies to do any thing in relation to receiving or responding to product data requests (including the provision of a product data request service), the other agency may, at the first agency’s request, do the thing on behalf of the first agency. (2) In this clause, the energy sector agencies are the AER and the Victorian agency." ;
    skos:definition "(1) Where these rules require or permit one of the energy sector agencies to do any thing in relation to receiving or responding to product data requests (including the provision of a product data request service), the other agency may, at the first agency’s request, do the thing on behalf of the first agency. (2) In this clause, the energy sector agencies are the AER and the Victorian agency."@en ;
    cml:integrityHash "988ea786e332479d05383a01618334a5ff0f00b7e919f7f501e7eb97b66a5527" ;
    cof:pageNumber "214"^^xsd:integer ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-92-ss-1 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-92-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.214" .
