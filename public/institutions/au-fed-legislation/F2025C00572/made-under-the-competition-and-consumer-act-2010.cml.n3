doc:sch-3-sec-8-2-ss-4 a cof:Section ;
    cof:title "8(4) 1  Moving from the NBL sector to the banking sector" ;
    values:kind "subsection" ;
    values:originalText "(4) Despite anything else in this Schedule, the data holder must respond to the request in accordance with Part 2 or Part 4 as the case requires. Note: If the data holder has become a restricted ADI, it will be an excluded ADI, and this provision will override clause 1.1A. If it becomes an unrestricted ADI, this provision will override the allowance of time in clause 6.9. CDR consumer must be notified of change of sector" ;
    cof:pageNumber "202"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-8-2-ss-5 a cml:Concept ;
    skos:prefLabel "8(5) 1  Moving from the NBL sector to the banking sector"@en ;
    cml:realizedBy doc:sch-3-sec-8-2-ss-5 ;
    values:originalText "(5) As soon as practicable after the transition time, the data holder must give a written notification to each CDR consumer in respect of whom a request mentioned in subclause (1) is on foot that: (a) the data holder has ceased to operate in the NBL sector; and (b) the data holder is now operating in the banking sector; and (c) the data requested is now banking sector data; and  Provisions relevant to the banking and non-bank lenders sectors  Schedule 3 Entities that move from NBL sector to banking sector  Part 8 Clause 8.1 Competition and Consumer (Consumer Data Right) Rules 2020 (d) the CDR consumer may, under rule 4.13, 4.20J or 4.25, choose to withdraw an authorisation or consent given under Part 4 in respect of the request." ;
    skos:definition "(5) As soon as practicable after the transition time, the data holder must give a written notification to each CDR consumer in respect of whom a request mentioned in subclause (1) is on foot that: (a) the data holder has ceased to operate in the NBL sector; and (b) the data holder is now operating in the banking sector; and (c) the data requested is now banking sector data; and  Provisions relevant to the banking and non-bank lenders sectors  Schedule 3 Entities that move from NBL sector to banking sector  Part 8 Clause 8.1 Competition and Consumer (Consumer Data Right) Rules 2020 (d) the CDR consumer may, under rule 4.13, 4.20J or 4.25, choose to withdraw an authorisation or consent given under Part 4 in respect of the request."@en ;
    cml:integrityHash "a9c9c606eaf455103c27f8d94c09c7db08538601c83e36562411bd0dc827af1f" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-8-2 ;
    cof:pageNumber "202"^^xsd:integer ;
    skos:note "Notify CDR consumer of data holder's transition to banking sector" ;
    dc:description "written notification" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
