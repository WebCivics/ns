    values:originalText "For paragraph 5.4(1)(c), the AER and the Essential Services Commission of Victoria are specified as authorities that the CDR Accreditor may consult with." ;
    cof:pageNumber "225"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-18 a cml:Concept ;
    skos:prefLabel "9 4  AEMO not to appear on Registrar’s database (rule 5.25)"@en ;
    cml:realizedBy doc:sch-4-sec-9-18 ;
    values:originalText "For the purposes of subrule 5.25(1), AEMO is not to be treated as a data holder. Note: The function of the database to be maintained under subrule 5.25(1) is to provide information for the making of consumer data requests to data holders. Since requests for AEMO data will be made to the relevant retailer, the database will not require details relating to AEMO." ;
    skos:definition "For the purposes of subrule 5.25(1), AEMO is not to be treated as a data holder. Note: The function of the database to be maintained under subrule 5.25(1) is to provide information for the making of consumer data requests to data holders. Since requests for AEMO data will be made to the relevant retailer, the database will not require details relating to AEMO."@en ;
    cml:integrityHash "5aa6e76264164b998e692c987ef73494ca301cfcc2b68fc49847b202cd151df9" ;
    cof:pageNumber "225"^^xsd:integer ;
    skos:note "AEMO is not to be treated as a data holder." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
