    values:kind "subsection" ;
    values:originalText "(3) However, as soon as practicable after suspending the accreditation or extending the suspension, the Accreditor must: (a) inform the accredited person of the suspension or extension; and (b) give the accredited person a reasonable opportunity to be heard in relation to whether the suspension should be removed." ;
    cof:pageNumber "116"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-28 a cml:Concept ;
    skos:prefLabel "5 22  When surrender, revocation or suspension takes effect"@en ;
    cml:realizedBy doc:sch-4-sec-5-28 ;
    values:originalText "A surrender, revocation or suspension takes effect when the fact that the accreditation has been surrendered, revoked or suspended is included in the Register of Accredited Persons." ;
    skos:definition "A surrender, revocation or suspension takes effect when the fact that the accreditation has been surrendered, revoked or suspended is included in the Register of Accredited Persons."@en ;
    cml:integrityHash "97366b2caf6c91fdedb9093ac6c4e49ac12ad950133ea8452937bcbab38edf97" ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "Surrender, revocation or suspension takes effect when included in the Register of Accredited Persons." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.116" ;
    cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-28-norm .
