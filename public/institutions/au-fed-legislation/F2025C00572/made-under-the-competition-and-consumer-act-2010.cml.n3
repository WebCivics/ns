doc:sch-4-sec-5-31-ss-2 a cof:Section ;
    cof:title "5(2) 25  Other information to be kept in association with Register of Accredited" ;
    values:kind "subsection" ;
    values:originalText "(2) The Accreditation Registrar may: (a) request a data holder or accredited person to provide the information referred to in subrule (1), or updates to that information; and (b) specify the form in which the information or updates are to be provided." ;
    cof:pageNumber "118"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-31-ss-3 a cml:Concept ;
    skos:prefLabel "5(3) 25  Other information to be kept in association with Register of Accredited"@en ;
    cml:realizedBy doc:sch-4-sec-5-31-ss-3 ;
    values:originalText "(3) The data holder or accredited person must comply with a request under subrule (2). Civil penalty: (a) for an individual―$50,000; and (b) for a body corporate―$250,000. Obligation to inform Accreditation Registrar to keep information up-to-date" ;
    skos:definition "(3) The data holder or accredited person must comply with a request under subrule (2). Civil penalty: (a) for an individual―$50,000; and (b) for a body corporate―$250,000. Obligation to inform Accreditation Registrar to keep information up-to-date"@en ;
    cml:integrityHash "94378cacd4e6201bdd1d2ab75346961c5f70f78629adc79f04aff93f62de5495" ;
