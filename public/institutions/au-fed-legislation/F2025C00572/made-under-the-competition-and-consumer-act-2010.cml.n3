doc:sch-4-sec-5-3 a cof:Section ;
    cof:title "5 1  Simplified outline of this Part" ;
    values:kind "section" ;
    values:originalText "A person may apply under this Part to be an accredited person. The CDR Accreditor may accredit a person, under section 56CA of the Act, if satisfied that the person meets the criteria for accreditation specified in this Part. This Part also deals with: • how applications are dealt with by the CDR Accreditor; and • obligations of accredited persons; and • the transfer, suspension, surrender and revocation of accreditations; and • related functions of the CDR Accreditor. This Part deals with how entries are added to the Register of Accredited Persons, and how that Register is updated, amended and corrected." ;
    cof:pageNumber "105"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-4 a cml:Concept ;
    skos:prefLabel "5 1A  Levels of accreditation"@en ;
    cml:realizedBy doc:sch-4-sec-5-4 ;
    values:originalText "Accreditation may be at either of the following levels: (a) unrestricted; (b) sponsored." ;
    skos:definition "Accreditation may be at either of the following levels: (a) unrestricted; (b) sponsored."@en ;
    cml:integrityHash "b0f946ffacae29a4e90311f939a5b25fe62fdac786af0e307ae61fe90b04d6a2" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Levels of accreditation may be unrestricted or sponsored." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.106" ;
    cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-4-norm .
