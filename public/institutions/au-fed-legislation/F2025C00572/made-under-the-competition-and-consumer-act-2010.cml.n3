concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-10 a cml:Concept ;
    skos:prefLabel "8 3  Functions of Data Standards Advisory Committee"@en ;
    cml:realizedBy doc:sch-4-sec-8-10 ;
    values:originalText "The function of a Data Standards Advisory Committee is to advise the Data Standards Chair about: (a) any matters identified in the instrument establishing the Committee; and (b) any other matter referred to the Committee by the Chair." ;
    skos:definition "The function of a Data Standards Advisory Committee is to advise the Data Standards Chair about: (a) any matters identified in the instrument establishing the Committee; and (b) any other matter referred to the Committee by the Chair."@en ;
    cml:integrityHash "e6cad64b2fc2f4cf22dcd0f20c57b92702a866461d3ba3670523e4ae1f3f3a3a" ;
    cof:pageNumber "141"^^xsd:integer ;
    skos:note "The Committee advises the Chair on matters identified in the instrument establishing the Committee and any other matter referred to the Committee by the Chair." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
