concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-3 a cml:Concept ;
    skos:prefLabel "5 1  Simplified outline of this Part"@en ;
    cml:realizedBy doc:sch-4-sec-5-3 ;
    values:originalText "A person may apply under this Part to be an accredited person. The CDR Accreditor may accredit a person, under section 56CA of the Act, if satisfied that the person meets the criteria for accreditation specified in this Part. This Part also deals with: • how applications are dealt with by the CDR Accreditor; and • obligations of accredited persons; and • the transfer, suspension, surrender and revocation of accreditations; and • related functions of the CDR Accreditor. This Part deals with how entries are added to the Register of Accredited Persons, and how that Register is updated, amended and corrected." ;
    skos:definition "A person may apply under this Part to be an accredited person. The CDR Accreditor may accredit a person, under section 56CA of the Act, if satisfied that the person meets the criteria for accreditation specified in this Part. This Part also deals with: • how applications are dealt with by the CDR Accreditor; and • obligations of accredited persons; and • the transfer, suspension, surrender and revocation of accreditations; and • related functions of the CDR Accreditor. This Part deals with how entries are added to the Register of Accredited Persons, and how that Register is updated, amended and corrected."@en ;
    cml:integrityHash "33c322e17ed3783af1bec2ebca0ed4c7e88a4d8182cb91eecc78154e823d1318" ;
    cof:pageNumber "105"^^xsd:integer ;
    skos:note "Application for accreditation under this Part" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.105" ;
