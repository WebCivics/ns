doc:sch-4-sec-4a-16-ss-3 a cof:Section ;
    cof:title "4A(3) 13  Consumer dashboard for joint account holders" ;
    values:kind "subsection" ;
    values:originalText "(3) Where the data holder does not already provide a consumer dashboard for that relevant account holder under rule 1.15, the service under subrule (1) is the data holder’s consumer dashboard for the relevant account holder." ;
    cof:pageNumber "102"^^xsd:integer .

