    cof:pageNumber "147"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-7 a cml:Concept ;
    skos:prefLabel "9 2  Review of decisions by the Administrative Appeals Tribunal"@en ;
    cml:realizedBy doc:sch-4-sec-9-7 ;
    values:originalText "Applications may be made to the Administrative Appeals Tribunal to review any of the following decisions: (a) a decision of the CDR Accreditor under rule 5.10 to: (i) impose a condition on an accreditation; or (ii) vary a condition that has been imposed; (b) a decision of the CDR Accreditor under rule 5.17 to: (i) suspend an accreditation; or (ii) extend a suspension; or (iii) revoke an accreditation.   Other matters  Part 9 Reporting, record keeping and audit  Division 9.3 Section 9.3 Competition and Consumer (Consumer Data Right) Rules 2020" ;
    skos:definition "Applications may be made to the Administrative Appeals Tribunal to review any of the following decisions: (a) a decision of the CDR Accreditor under rule 5.10 to: (i) impose a condition on an accreditation; or (ii) vary a condition that has been imposed; (b) a decision of the CDR Accreditor under rule 5.17 to: (i) suspend an accreditation; or (ii) extend a suspension; or (iii) revoke an accreditation.   Other matters  Part 9 Reporting, record keeping and audit  Division 9.3 Section 9.3 Competition and Consumer (Consumer Data Right) Rules 2020"@en ;
    cml:integrityHash "1c9ffcd83f783f0a016752a27bc88980cb780cfa4f4b3d0ae8f55103a0ac4b12" ;
    cof:pageNumber "148"^^xsd:integer ;
    skos:note "Review of decisions by the Administrative Appeals Tribunal" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.148" ;
