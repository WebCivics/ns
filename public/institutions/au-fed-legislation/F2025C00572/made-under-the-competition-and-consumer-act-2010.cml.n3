    skos:definition "(2) For subrule (1), it is irrelevant whether the action of the CDR representative in relation to the service data is in accordance with the CDR representative arrangement."@en ;
    cml:integrityHash "6f8b6ab4dbc8c4d5922d7f15f61ab8d66d06240a971d31647af136f4de83bf50" ;
