concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-94 a cml:Concept ;
    skos:prefLabel "4 3  Meaning of SR data and primary data holder—energy sector"@en ;
    cml:realizedBy doc:sch-4-sec-4-94 ;
    values:originalText "For these rules: (a) SR data, in relation to the energy sector, means AEMO data in relation to a CDR consumer; and (b) the primary data holder for the SR data is the relevant retailer. Note: Paragraph (a) also makes AEMO the secondary data holder for the SR data." ;
    skos:definition "For these rules: (a) SR data, in relation to the energy sector, means AEMO data in relation to a CDR consumer; and (b) the primary data holder for the SR data is the relevant retailer. Note: Paragraph (a) also makes AEMO the secondary data holder for the SR data."@en ;
    cml:integrityHash "2206be6212f509899182e6defe12867bf30598ce038aef7932d09c3e20a6eccb" ;
    cof:pageNumber "214"^^xsd:integer ;
    skos:note "Defines SR data and primary data holder for the energy sector." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
