concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-31 a cml:Concept ;
    skos:prefLabel "1 19  Eligible CDR consumers in relation to secondary data holders"@en ;
    cml:realizedBy doc:sch-4-sec-1-31 ;
    values:originalText "If a CDR consumer is eligible to make or initiate a consumer data request to a primary data holder for SR data, the CDR consumer is not also eligible to make or initiate a consumer data request for that data to the secondary data holder. Note: As a result of this rule, a secondary data holder that only holds SR data is not required to provide request services under rule 1.13; however, it will be required to provide a service under subrule 1.20(2)." ;
    skos:definition "If a CDR consumer is eligible to make or initiate a consumer data request to a primary data holder for SR data, the CDR consumer is not also eligible to make or initiate a consumer data request for that data to the secondary data holder. Note: As a result of this rule, a secondary data holder that only holds SR data is not required to provide request services under rule 1.13; however, it will be required to provide a service under subrule 1.20(2)."@en ;
    cml:integrityHash "c6e03817fe4d849a7cf29c1359d65ddb7964829cf74792d14e7e01bcd96994fe" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Eligible CDR consumers cannot make or initiate a consumer data request for secondary data holders." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.47" ;
    cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-31-norm .
