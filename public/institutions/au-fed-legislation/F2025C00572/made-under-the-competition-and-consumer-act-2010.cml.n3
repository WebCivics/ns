concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19 cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-descriptionlogic-2 .
concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "ClassInclusion" ;
    cml:logicSummary "The accredited person is a retailer at the time of accreditation." ;
    cml:premiseText "The accredited person was, at the time of accreditation, a retailer." ;
    cml:conclusionText "The accredited person is a retailer at the time of accreditation." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19 cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-alleninterval-3 .
concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The suspension or revocation of authorisation or licence occurs after the accreditation." ;
    cml:premiseText "If its authorisation or licence to sell electricity in the National Electricity Market has been suspended or revoked, the accredited person ceases to satisfy the condition." ;
    cml:conclusionText "The suspension or revocation of authorisation or licence occurs after the accreditation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19 cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-ltl-4 .
concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurrently" ;
    cml:logicSummary "The accredited person must cease to satisfy the condition if its authorisation or licence is suspended or revoked repeatedly." ;
    cml:premiseText "If its authorisation or licence to sell electricity in the National Electricity Market has been suspended or revoked, the accredited person ceases to satisfy the condition." ;
    cml:conclusionText "The accredited person must cease to satisfy the condition if its authorisation or licence is suspended or revoked repeatedly." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19 cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-deontic-5 .
concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "The accredited person has a duty to cease satisfying the condition if its authorisation or licence is suspended or revoked." ;
    cml:premiseText "The accredited person was, at the time of accreditation, a retailer." ;
    cml:conclusionText "The accredited person has a duty to cease satisfying the condition if its authorisation or licence is suspended or revoked." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19 cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-argumentation-6 .
concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-argumentation-6 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "If the accredited person ceases to satisfy the condition, it implies that its authorisation or licence has been suspended or revoked." ;
    cml:premiseText "The accredited person must cease to satisfy the condition if its authorisation or licence to sell electricity in the National Electricity Market has been suspended or revoked." ;
    cml:conclusionText "If the accredited person ceases to satisfy the condition, it implies that its authorisation or licence has been suspended or revoked." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
