doc:sch-4-sec-4-79 a cof:Section ;
    cof:title "4 25(1)(b)―the earlier of the following:" ;
    values:kind "section" ;
    values:originalText "(i) when the data holder gave effect to the withdrawal; (ii) 2 business days after the data holder received the communication; (b) if the authorisation was withdrawn in accordance with paragraph" ;
    cof:pageNumber "93"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80 a cml:Concept ;
    skos:prefLabel "4 25(1)(a)―when the authorisation was withdrawn;"@en ;
    cml:realizedBy doc:sch-4-sec-4-80 ;
    values:originalText "(c) if the CDR consumer ceases to be eligible in relation to the data holder; (d) if the data holder was notified, under rule 4.18AA or 4.20P, of the withdrawal of a consent to collect that CDR data―when the data holder received that notification; (e) the end of the period of 12 months after the authorisation was given;" ;
    skos:definition "(c) if the CDR consumer ceases to be eligible in relation to the data holder; (d) if the data holder was notified, under rule 4.18AA or 4.20P, of the withdrawal of a consent to collect that CDR data―when the data holder received that notification; (e) the end of the period of 12 months after the authorisation was given;"@en ;
    cml:integrityHash "e8526f2f9fbcca69218c7bffee9e9c7f35d9fec75c4bf796e3869bef5129ec7e" ;
    cof:pageNumber "93"^^xsd:integer ;
    skos:note "Cease eligibility for data collection if notified of consent withdrawal or end of authorization period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
