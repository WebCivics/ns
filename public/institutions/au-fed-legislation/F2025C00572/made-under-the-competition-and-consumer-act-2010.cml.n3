    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12-ss-2 ;
    cml:hasPart concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12-ss-3 ;
