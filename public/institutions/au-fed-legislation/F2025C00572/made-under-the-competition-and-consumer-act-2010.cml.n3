    cml:conclusionText "The data holder may disclose, to the accredited person, the voluntary consumer data it is authorised to disclose." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

