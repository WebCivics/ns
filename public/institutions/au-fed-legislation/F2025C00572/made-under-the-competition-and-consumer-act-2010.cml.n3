concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-40-ss-4-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must Not" ;
    cml:logicSummary "Prohibition of individual and body corporate actions." ;
    cml:premiseText "Civil penalty: for an individual―$50,000; and for a body corporate―$250,000." ;
    cml:conclusionText "for an individual or a body corporate making a consumer data request contrary to a direction it has received under this rule." ;
