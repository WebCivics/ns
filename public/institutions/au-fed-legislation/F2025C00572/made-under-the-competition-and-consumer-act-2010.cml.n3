concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-9-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Accredited person must use and disclose CDR data upon request." ;
    cml:premiseText "The accredited person may use and disclose the CDR data it collects as a result of the consumer data request, in accordance with the Act and these rules, to provide the requested goods and services to the CDR consumer, and as otherwise consented to by the CDR consumer." ;
    cml:conclusionText "The accredited person may use and disclose the CDR data it collects as a result of the consumer data request, in accordance with the Act and these rules, to provide the requested goods and services to the CDR consumer, and as otherwise consented to by the CDR consumer." ;
