doc:sch-4-sec-4-62-ss-2 a cof:Section ;
    cof:title "4(2) 20N  Information relating to redundant data" ;
    values:kind "subsection" ;
    values:originalText "(2) A CDR representative that gives the statement referred to in paragraph (1)(b) or (c) must also state: (a) that, if it de-identifies the redundant data: (i) it would apply the CDR data de-identification process; and (ii) it would be able to use or, if applicable, disclose (by sale or otherwise) the de-identified redundant data without seeking further consent from the CDR consumer; and (b) what de-identification of CDR data in accordance with the CDR data de-identification process means; and (c) if applicable, examples of how it could use the redundant data once de-identified. Note: For the CDR data de-identification process, see rule 1.17. Subdivision 4.3A.8—Notification requirements" ;
    cof:pageNumber "88"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-63 a cml:Concept ;
    skos:prefLabel "4 20O  CDR receipts"@en ;
    cml:realizedBy doc:sch-4-sec-4-63 ;
    values:originalText "A CDR representative must give the CDR consumer a notice that complies with the data standards as soon as practicable after: (a) the CDR consumer gives the CDR representative a collection consent, a use consent or a disclosure consent; or (b) the CDR consumer amends such a consent in accordance with this Division; or (c) the CDR consumer withdraws such a consent in accordance with rule" ;
    skos:definition "A CDR representative must give the CDR consumer a notice that complies with the data standards as soon as practicable after: (a) the CDR consumer gives the CDR representative a collection consent, a use consent or a disclosure consent; or (b) the CDR consumer amends such a consent in accordance with this Division; or (c) the CDR consumer withdraws such a consent in accordance with rule"@en ;
    cml:integrityHash "b904b4022cf3a5578d72f806beef335274f61f308b503607b47453b52b6b8d2c" ;
    cof:pageNumber "88"^^xsd:integer ;
