concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-58-ss-4 a cml:Concept ;
    skos:prefLabel "4(4) 20Q."@en ;
    cml:realizedBy doc:sch-4-sec-4-58-ss-4 ;
