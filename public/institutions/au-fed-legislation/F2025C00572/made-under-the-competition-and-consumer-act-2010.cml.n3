concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-17 a cml:Concept ;
    skos:prefLabel "8 10  Matters to have regard to when making or amending data standards"@en ;
    cml:realizedBy doc:sch-4-sec-8-17 ;
    values:originalText "When making or amending a data standard, the Data Standards Chair must have regard to the following: (a) the advice or submissions (if any) received from: (i) the Data Standards Advisory Committee; or (ii) the Commission; or (iii) the Information Commissioner; on a draft of the proposed standard or amendment (the consultation draft);" ;
    skos:definition "When making or amending a data standard, the Data Standards Chair must have regard to the following: (a) the advice or submissions (if any) received from: (i) the Data Standards Advisory Committee; or (ii) the Commission; or (iii) the Information Commissioner; on a draft of the proposed standard or amendment (the consultation draft);"@en ;
    cml:integrityHash "66ebcfeb303f4614d1ea4d71405516a2fe221dc83c7149f7bfc88b90835c127f" ;
    cof:pageNumber "143"^^xsd:integer ;
    skos:note "Must consider certain advice and submissions when making or amending data standards." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
