    values:originalText "(2) Paragraph (1)(d) does not apply in relation to a person who is an accredited person or CDR representative that is a direct or indirect OSP of an OSP chain principal. Content of a CDR outsourcing arrangement" ;
    skos:definition "(2) Paragraph (1)(d) does not apply in relation to a person who is an accredited person or CDR representative that is a direct or indirect OSP of an OSP chain principal. Content of a CDR outsourcing arrangement"@en ;
    cml:integrityHash "5705d5c1787bde4a52b75585dff9db123204306d607da1e2e3c640e0388d4b99" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15 ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Exempts accredited persons and CDR representatives from paragraph (1)(d) if they are direct or indirect OSPs of an OSP chain principal." ;
    cml:curationStatus cml:Proposed ;
