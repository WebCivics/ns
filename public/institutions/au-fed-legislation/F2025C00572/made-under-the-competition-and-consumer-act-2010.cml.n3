doc:sch-4-sec-4-65-ss-1 a cof:Section ;
    cof:title "4(1) 20P  Notification of data holder or accredited data recipient if collection" ;
    values:kind "subsection" ;
    values:originalText "(1) This rule applies if:   Consumer data requests made by accredited persons  Part 4 Giving and amending consents—CDR representatives  Division 4.3A Section 4.20Q Competition and Consumer (Consumer Data Right) Rules 2020 (a) an accredited person has made a consumer data request on behalf of a CDR representative to a CDR participant based on a collection consent given under this Division relating to particular CDR data and a particular CDR participant; and (b) the request has not been completely resolved; and (c) the consent expires for any reason." ;
    cof:pageNumber "88"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-65-ss-2 a cml:Concept ;
    skos:prefLabel "4(2) 20P  Notification of data holder or accredited data recipient if collection"@en ;
    cml:realizedBy doc:sch-4-sec-4-65-ss-2 ;
