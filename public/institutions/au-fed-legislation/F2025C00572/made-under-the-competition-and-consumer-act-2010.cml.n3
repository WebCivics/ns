    cml:operator "Diffusion" ;
    cml:logicSummary "Use or disclosure of CDR data by accredited data recipients diffuses to other permitted users or disclosures." ;
    cml:premiseText "This rule provides an authorisation for paragraph 56EI(1)(b) of the Act." ;
    cml:conclusionText "Use or disclosure diffuses to other permitted users or disclosures." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11 cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-cogai-5 .
concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "CogAI" ;
    cml:logicSummary "Use or disclosure of CDR data by accredited data recipients is a cognitive action that requires AI processing." ;
    cml:premiseText "This rule provides an authorisation for paragraph 56EI(1)(b) of the Act." ;
    cml:conclusionText "Use or disclosure is a cognitive action that requires AI processing." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-4-sec-7-11 a cof:Section ;
    cof:title "7 7  Rule relating to privacy safeguard 6—use or disclosure of CDR by" ;
    values:kind "section" ;
    values:originalText "accredited data recipients Note: Paragraph 56EI(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or disclose it unless the use or disclosure is otherwise required, or authorised, under the consumer data rules. This rule provides an authorisation for that paragraph. Section 56EI of the Act applies only in relation to CDR data for which there are one or more CDR consumers: subsection 56EB(1) of the Act. For paragraph 56EI(1)(b) of the Act, the use or disclosure of CDR data for which there is a CDR consumer by an accredited data recipient of the CDR data is authorised under these rules if it is a permitted use or disclosure, other than one that relates to direct marketing." ;
    cof:pageNumber "133"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-12 a cml:Concept ;
    skos:prefLabel "7 Section 7"@en ;
    cml:realizedBy doc:sch-4-sec-7-12 ;
    values:originalText "8  Rule relating to privacy safeguard 7—use or disclosure of CDR data for direct marketing by accredited data recipients Note: Paragraph 56EJ(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or disclose it for direct marketing unless the use or disclosure is authorised under the consumer data rules in accordance with a valid consent of a CDR consumer for the CDR data. This rule provides an authorisation for that paragraph. Section 56EJ of the Act applies only in relation to CDR data for which there are one or more CDR consumers: subsection 56EB(1) of the Act. For paragraph 56EJ(1)(b) of the Act, the use or disclosure of CDR data for which there is a CDR consumer by an accredited data recipient of the CDR data for direct marketing is authorised under these rules if it is a permitted use or disclosure that relates to direct marketing." ;
    skos:definition "8  Rule relating to privacy safeguard 7—use or disclosure of CDR data for direct marketing by accredited data recipients Note: Paragraph 56EJ(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or disclose it for direct marketing unless the use or disclosure is authorised under the consumer data rules in accordance with a valid consent of a CDR consumer for the CDR data. This rule provides an authorisation for that paragraph. Section 56EJ of the Act applies only in relation to CDR data for which there are one or more CDR consumers: subsection 56EB(1) of the Act. For paragraph 56EJ(1)(b) of the Act, the use or disclosure of CDR data for which there is a CDR consumer by an accredited data recipient of the CDR data for direct marketing is authorised under these rules if it is a permitted use or disclosure that relates to direct marketing."@en ;
    cml:integrityHash "2ee3d76c50b4bdb54d9cf0dd88ee805923ef2d8658fefbf30af64931b710962d" ;
    cof:pageNumber "133"^^xsd:integer ;
    skos:note "Authorisation for use or disclosure of CDR data for direct marketing by accredited data recipients." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.133" ;
