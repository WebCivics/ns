concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38 a cml:Concept ;
    skos:prefLabel "1 26  Dispute resolution—primary data holders and secondary data holders"@en ;
    cml:realizedBy doc:sch-4-sec-1-38 ;
    values:originalText "Where a primary data holder requests relevant information from a secondary data holder in relation to a consumer complaint or dispute with the primary data holder that relates to an SR data request, the secondary data holder must provide the information to the extent that it is reasonable to do so.   Product data requests  Part 2 Application of rules in relation to SR data  Division 1.5 Section 2.1 Competition and Consumer (Consumer Data Right) Rules 2020" ;
    skos:definition "Where a primary data holder requests relevant information from a secondary data holder in relation to a consumer complaint or dispute with the primary data holder that relates to an SR data request, the secondary data holder must provide the information to the extent that it is reasonable to do so.   Product data requests  Part 2 Application of rules in relation to SR data  Division 1.5 Section 2.1 Competition and Consumer (Consumer Data Right) Rules 2020"@en ;
    cml:integrityHash "173c7a276e2d082c6be1851ce2eb69abeb9401a42cbed9d2ab1f82c5d992dc88" ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Secondary data holder must provide information to primary data holder upon request." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
