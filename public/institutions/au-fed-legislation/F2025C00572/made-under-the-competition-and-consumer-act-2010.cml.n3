doc:sch-4-sec-2-9 a cof:Section ;
    cof:title "2 6  Use of data disclosed pursuant to product data request" ;
    values:kind "section" ;
    values:originalText "A data holder that discloses CDR data in response to a product data request must not impose conditions, restrictions or limitations of any kind on the use of the disclosed data. Note: This rule is a civil penalty provision (see rule 9.8)." ;
