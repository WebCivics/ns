concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-9 a cml:Concept ;
    skos:prefLabel "2 6  Use of data disclosed pursuant to product data request"@en ;
    cml:realizedBy doc:sch-4-sec-2-9 ;
    values:originalText "A data holder that discloses CDR data in response to a product data request must not impose conditions, restrictions or limitations of any kind on the use of the disclosed data. Note: This rule is a civil penalty provision (see rule 9.8)." ;
    skos:definition "A data holder that discloses CDR data in response to a product data request must not impose conditions, restrictions or limitations of any kind on the use of the disclosed data. Note: This rule is a civil penalty provision (see rule 9.8)."@en ;
    cml:integrityHash "9aad70f5ec9aa40b25035164befc0fdce2925323e8d0f252b690ccc0ac2a7699" ;
    cof:pageNumber "53"^^xsd:integer ;
    skos:note "No conditions or restrictions on use of disclosed data" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
