    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-4-sec-4-37-ss-1 a cof:Section ;
    cof:title "4(1) 18AA  Notification of data holder or accredited data recipient if collection" ;
    values:kind "subsection" ;
    values:originalText "(1) This rule applies if:   Consumer data requests made by accredited persons  Part 4 Giving and amending consents—accredited persons  Division 4.3 Section 4.18A Competition and Consumer (Consumer Data Right) Rules 2020 (a) an accredited person has made a consumer data request to a CDR participant, based on a collection consent given under this Division relating to particular CDR data and that CDR participant; and (b) the request has not been completely resolved; and (c) the consent expires for any reason." ;
    cof:pageNumber "76"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-37-ss-2 a cml:Concept ;
    skos:prefLabel "4(2) 18AA  Notification of data holder or accredited data recipient if collection"@en ;
    cml:realizedBy doc:sch-4-sec-4-37-ss-2 ;
    values:originalText "(2) The accredited person must notify: (a) if the CDR participant is a data holder―the data holder, in accordance with the data standards, that the consent has expired; and (b) if the CDR participant is an accredited data recipient―the accredited data recipient as soon as practicable that the consent has expired. Note: This subrule is a civil penalty provision (see rule 9.8)." ;
    skos:definition "(2) The accredited person must notify: (a) if the CDR participant is a data holder―the data holder, in accordance with the data standards, that the consent has expired; and (b) if the CDR participant is an accredited data recipient―the accredited data recipient as soon as practicable that the consent has expired. Note: This subrule is a civil penalty provision (see rule 9.8)."@en ;
    cml:integrityHash "6642051c2e851c499edc01a90b400f07d847a31058d2d692bdcf98392821e727" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-37 ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Notify data holder or accredited data recipient of expired consent." ;
    dc:description "Notification" ;
