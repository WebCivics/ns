concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-3 a cml:Concept ;
    skos:prefLabel "4(3) 13(1)(a)―when the consent was withdrawn;"@en ;
    cml:realizedBy doc:sch-4-sec-4-31-ss-3 ;
    values:originalText "(3) If: (a) an accredited person is notified by a data holder, under rule 4.26A, of the withdrawal of an authorisation to disclose CDR data that relates to a collection consent given under this Division; and (b) the collection consent has not expired in accordance with subrule (1); the collection consent expires when the accredited person receives that notification. Note: This would not result in the use consent relating to any CDR data that had already been collected expiring. However, see the notification requirement of rule 4.18A." ;
    skos:definition "(3) If: (a) an accredited person is notified by a data holder, under rule 4.26A, of the withdrawal of an authorisation to disclose CDR data that relates to a collection consent given under this Division; and (b) the collection consent has not expired in accordance with subrule (1); the collection consent expires when the accredited person receives that notification. Note: This would not result in the use consent relating to any CDR data that had already been collected expiring. However, see the notification requirement of rule 4.18A."@en ;
    cml:integrityHash "f995663cb2f0036bc76c3277470d04b839057f4bcef523f70c27dd01e0f6412e" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31 ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Collection consent expires upon notification of withdrawn consent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
