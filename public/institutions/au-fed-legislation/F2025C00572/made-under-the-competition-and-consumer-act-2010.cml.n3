concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-13 a cml:Concept ;
    skos:prefLabel "6 1  Definitions"@en ;
    cml:realizedBy doc:sch-3-sec-6-13 ;
    values:originalText "In this Part: complex request means a consumer data request that: (a) is made on behalf of a secondary user; or (b) relates to a joint account or a partnership account; or (c) is made on behalf of a CDR consumer who has a nominated representative. Note: For paragraph (c), see paragraph 1.13(1)(c) of these rules. initial provider—see clause 6.2. large provider—see clause 6.2. tranche 1 date means 13 July 2026. tranche 2 date means 9 November 2026. tranche 3 date means 10 May 2027." ;
    skos:definition "In this Part: complex request means a consumer data request that: (a) is made on behalf of a secondary user; or (b) relates to a joint account or a partnership account; or (c) is made on behalf of a CDR consumer who has a nominated representative. Note: For paragraph (c), see paragraph 1.13(1)(c) of these rules. initial provider—see clause 6.2. large provider—see clause 6.2. tranche 1 date means 13 July 2026. tranche 2 date means 9 November 2026. tranche 3 date means 10 May 2027."@en ;
    cml:integrityHash "b8439df88429af113f95cc51cc61f4fa8a11b0bc3e51f4f1834654e94861009f" ;
    cof:pageNumber "190"^^xsd:integer ;
    skos:note "Definitions for Part 1" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.190" ;
    cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-13-norm .
