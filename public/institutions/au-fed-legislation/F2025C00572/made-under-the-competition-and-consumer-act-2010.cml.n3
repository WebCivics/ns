concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-51 a cml:Concept ;
    skos:prefLabel "4 20G  Amendment of consent"@en ;
    cml:realizedBy doc:sch-4-sec-4-51 ;
    values:originalText "An amendment of a consent takes effect when the CDR consumer amends the consent. Note: It is not possible for the CDR consumer to specify a different day or time." ;
    skos:definition "An amendment of a consent takes effect when the CDR consumer amends the consent. Note: It is not possible for the CDR consumer to specify a different day or time."@en ;
    cml:integrityHash "84d5c864bc1ac678c6e9dd288645ee2a7f37c472aca57767d283d3ce4323d6ba" ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Amendment of consent takes effect when the CDR consumer amends the consent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
