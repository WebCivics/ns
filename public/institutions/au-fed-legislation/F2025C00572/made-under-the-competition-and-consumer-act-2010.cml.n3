concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-96 a cml:Concept ;
    skos:prefLabel "4 5  Civil penalties do not apply"@en ;
    cml:realizedBy doc:sch-4-sec-4-96 ;
    values:originalText "A civil penalty imposed by these rules for a breach of a provision of these rules, including one imposed by rule 9.8 by declaring the relevant provision to be a civil penalty provision, does not apply in relation to AEMO, the AER or the Victorian agency in relation to energy sector data.  Provisions relevant to the energy sector  Schedule 4 Dispute resolution—energy sector  Part 5 Clause 5.1 Competition and Consumer (Consumer Data Right) Rules 2020" ;
    skos:definition "A civil penalty imposed by these rules for a breach of a provision of these rules, including one imposed by rule 9.8 by declaring the relevant provision to be a civil penalty provision, does not apply in relation to AEMO, the AER or the Victorian agency in relation to energy sector data.  Provisions relevant to the energy sector  Schedule 4 Dispute resolution—energy sector  Part 5 Clause 5.1 Competition and Consumer (Consumer Data Right) Rules 2020"@en ;
    cml:integrityHash "db8e79d28708ccbaecd4d24f24e36d462d16eedcb2474b641869cbd9c2139cb2" ;
    cof:pageNumber "214"^^xsd:integer ;
    skos:note "Civil penalties do not apply to energy sector data" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.214" ;
    cml:asserts concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-96-norm .
