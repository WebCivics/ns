concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-508 a cml:Concept ;
    skos:prefLabel "508 Application—conditions for accredited persons to hold data holders"@en ;
    cml:realizedBy doc:sch-4-sec-508 ;
    values:originalText "The amendments of clause 7.2 of Schedule 3 to the principal rules made by the amending rules do not apply to an accredited person in relation to CDR data, and any CDR data directly or indirectly derived from that data, if the person started to hold such data before the commencement of those amendments.  Schedule 1  Default conditions on accreditations" ;
    skos:definition "The amendments of clause 7.2 of Schedule 3 to the principal rules made by the amending rules do not apply to an accredited person in relation to CDR data, and any CDR data directly or indirectly derived from that data, if the person started to hold such data before the commencement of those amendments.  Schedule 1  Default conditions on accreditations"@en ;
    cml:integrityHash "fdfbd9ca45c22ac37b88aaa7533d8e3a5ea60d3cce4718873ecf9a230645fa96" ;
