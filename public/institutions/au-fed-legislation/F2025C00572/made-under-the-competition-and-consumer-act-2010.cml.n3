concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-10-ss-4 a cml:Concept ;
    skos:prefLabel "9(4) 5  Requests from CDR consumers for copies of records"@en ;
    cml:realizedBy doc:sch-4-sec-9-10-ss-4 ;
    values:originalText "(4) A person who receives a request under this rule must provide the requested copies, in the form (if any) approved by the Commission for the purposes of this rule, as soon as practicable, but no later than 10 business days, after receiving the request. Civil penalty: (a) for an individual―$50,000; and (b) for a body corporate―$250,000." ;
    skos:definition "(4) A person who receives a request under this rule must provide the requested copies, in the form (if any) approved by the Commission for the purposes of this rule, as soon as practicable, but no later than 10 business days, after receiving the request. Civil penalty: (a) for an individual―$50,000; and (b) for a body corporate―$250,000."@en ;
    cml:integrityHash "5ad93293dc4e528a952670a8b59d8c5b5d1156293ce85fc364e5fd6a6d60d7a9" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-10 ;
    cof:pageNumber "157"^^xsd:integer ;
    skos:note "Provide copies of records within 10 business days after receiving a request." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
