concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-11 a cml:Concept ;
    skos:prefLabel "1 6A  Sector Schedules"@en ;
    cml:realizedBy doc:sch-4-sec-1-11 ;
    values:originalText "A sector Schedule may modify the operation of Parts 1 to 9 of these rules in relation to a particular designated sector or sectors and a particular matter (whether or not a provision in any of those Parts provides for the Schedule to deal with the matter). Example: A sector Schedule may provide that these rules do not apply in relation to a particular class of data holders in the designated sector or sectors." ;
    skos:definition "A sector Schedule may modify the operation of Parts 1 to 9 of these rules in relation to a particular designated sector or sectors and a particular matter (whether or not a provision in any of those Parts provides for the Schedule to deal with the matter). Example: A sector Schedule may provide that these rules do not apply in relation to a particular class of data holders in the designated sector or sectors."@en ;
    cml:integrityHash "8feaf6cc6e17f67f17c244b78182dde87d270cd9b82c29c05026096c10b15745" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Rules do not apply to a particular class of data holders in the designated sector or sectors." ;
    cml:curationStatus cml:Proposed ;
