    values:originalText "16, to have the de-identified data deleted once it becomes redundant data. Subdivision 4.3.4—Election to delete redundant data" ;
    skos:definition "16, to have the de-identified data deleted once it becomes redundant data. Subdivision 4.3.4—Election to delete redundant data"@en ;
    cml:integrityHash "79b480e20cfa4470669f406b7ff44687f114da880916bf9ec2d05c6b2f7a0749" ;
