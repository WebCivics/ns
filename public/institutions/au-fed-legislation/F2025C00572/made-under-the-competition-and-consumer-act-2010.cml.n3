concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-34 a cml:Concept ;
    skos:prefLabel "5 28  Making information available to the Commission, the Information"@en ;
    cml:realizedBy doc:sch-4-sec-5-34 ;
    values:originalText "Commissioner and the Data Recipient Accreditor The Accreditation Registrar must make available to the Commission, the Information Commissioner and the CDR Accreditor, on request: (a) all or part of the Register of Accredited Persons or the associated database; or (b) specified information in the Register or the associated database; or (c) any information held by the Registrar in relation to the Register or the associated database." ;
    skos:definition "Commissioner and the Data Recipient Accreditor The Accreditation Registrar must make available to the Commission, the Information Commissioner and the CDR Accreditor, on request: (a) all or part of the Register of Accredited Persons or the associated database; or (b) specified information in the Register or the associated database; or (c) any information held by the Registrar in relation to the Register or the associated database."@en ;
    cml:integrityHash "13d120fa57e62db5fcd7ea98ce3ead0ba9ef43be757d413eb38c77bf60bfcef7" ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Must provide information to the Commission, Information Commissioner, and CDR Accreditor on request." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
