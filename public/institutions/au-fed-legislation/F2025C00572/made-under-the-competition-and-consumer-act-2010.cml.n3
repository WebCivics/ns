doc:sch-4-sec-1-19-ss-4 a cof:Section ;
    cof:title "1(4) 10C  Trusted advisers" ;
    values:kind "subsection" ;
    values:originalText "(4) The accredited person or CDR representative must not make: (a) the nomination of a trusted adviser; or (b) the nomination of a particular person as a trusted adviser; or (c) the giving of a TA disclosure consent; a condition for supply of the goods or services requested by the CDR consumer." ;
    cof:pageNumber "36"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-19-ss-5 a cml:Concept ;
    skos:prefLabel "1(5) 10C  Trusted advisers"@en ;
    cml:realizedBy doc:sch-4-sec-1-19-ss-5 ;
    values:originalText "(5) To avoid doubt, paragraphs (4)(a) and (c) do not apply where the only good or service that is requested by the CDR consumer is for CDR data to be collected from a data holder and provided to a trusted adviser." ;
    skos:definition "(5) To avoid doubt, paragraphs (4)(a) and (c) do not apply where the only good or service that is requested by the CDR consumer is for CDR data to be collected from a data holder and provided to a trusted adviser."@en ;
    cml:integrityHash "29f9ae70b206e09683bc25b48ec03f41069f3c1141ba4b88c89c39b06442e108" ;
    values:partOf concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-19 ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Exemption for CDR data collection from trusted adviser" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
