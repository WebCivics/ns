doc:sch-4-sec-4-81 a cof:Section ;
    cof:title "4 26A  Notifications of expired authorisations" ;
    values:kind "section" ;
    values:originalText "If an authorisation to disclose particular CDR data to an accredited person is withdrawn or otherwise expires, the data holder must notify the accredited person in accordance with the data standards. Note: This rule is a civil penalty provision (see rule 9.8)." ;
    cof:pageNumber "94"^^xsd:integer .

concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-82 a cml:Concept ;
    skos:prefLabel "4 27  Updating consumer dashboard"@en ;
    cml:realizedBy doc:sch-4-sec-4-82 ;
    values:originalText "A data holder must update a CDR consumer’s consumer dashboard as soon as practicable after the information required to be contained on the dashboard changes. Note: This rule is a civil penalty provision (see rule 9.8)." ;
    skos:definition "A data holder must update a CDR consumer’s consumer dashboard as soon as practicable after the information required to be contained on the dashboard changes. Note: This rule is a civil penalty provision (see rule 9.8)."@en ;
    cml:integrityHash "8bea035bc3a6e5b6792e434adaa10dc4fbf75ca10331ca1b61b437f0dcb303a5" ;
    cof:pageNumber "94"^^xsd:integer ;
    skos:note "Update consumer dashboard upon change of required information." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
    dc:source "made-under-the-competition-and-consumer-act-2010.pdf, p.94" ;
