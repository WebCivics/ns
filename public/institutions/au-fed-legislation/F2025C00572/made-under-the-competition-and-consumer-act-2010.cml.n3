concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-8 a cml:Concept ;
    skos:prefLabel "7 1  Laws relevant to the management of CDR data—banking sector and NBL"@en ;
    cml:realizedBy doc:sch-3-sec-7-8 ;
    values:originalText "sector For paragraph (f) of the definition of “law relevant to the management of CDR data” in rule 1.7 of these rules, the Australian Securities and Investments Commission Act 2001 is a law relevant to the management of CDR data in relation to the banking sector and NBL sector." ;
    skos:definition "sector For paragraph (f) of the definition of “law relevant to the management of CDR data” in rule 1.7 of these rules, the Australian Securities and Investments Commission Act 2001 is a law relevant to the management of CDR data in relation to the banking sector and NBL sector."@en ;
    cml:integrityHash "92a9f73d581a0764f256b9e9c4f48e64b25e69487ead2ad6ba5e9772a0e1a9a2" ;
    cof:pageNumber "199"^^xsd:integer ;
    skos:note "Australian Securities and Investments Commission Act 2001 is a law relevant to the management of CDR data in relation to the banking sector and NBL sector." ;
    cml:curationStatus cml:Proposed ;
