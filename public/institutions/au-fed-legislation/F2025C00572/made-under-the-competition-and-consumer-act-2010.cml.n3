concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-10 a cml:Concept ;
    skos:prefLabel "5 5  Criteria for accreditation"@en ;
    cml:realizedBy doc:sch-4-sec-5-10 ;
    values:originalText "Note: Under subsection 56CA(1) of the Act, the CDR Accreditor may, in writing, accredit a person if the CDR Accreditor is satisfied that the person meets the criteria for accreditation specified in the consumer data rules. The criterion for accreditation is that the accreditation applicant: (a) would, if accredited, be able to comply with the obligations set out in rule" ;
    skos:definition "Note: Under subsection 56CA(1) of the Act, the CDR Accreditor may, in writing, accredit a person if the CDR Accreditor is satisfied that the person meets the criteria for accreditation specified in the consumer data rules. The criterion for accreditation is that the accreditation applicant: (a) would, if accredited, be able to comply with the obligations set out in rule"@en ;
    cml:integrityHash "0d3e70f365c5bc191669c4316d80c3c98638f0e27ced058c433be715882486c3" ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Must meet criteria for accreditation" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
