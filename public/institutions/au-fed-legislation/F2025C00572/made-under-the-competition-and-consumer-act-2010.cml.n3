concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-44 a cml:Concept ;
    skos:prefLabel "4 20B  Purpose of Division"@en ;
    cml:realizedBy doc:sch-4-sec-4-44 ;
    values:originalText "This Division deals with: (a) giving collection consents, use consents and disclosure consents to CDR representatives; and (b) amending such consents; and (c) related matters." ;
    skos:definition "This Division deals with: (a) giving collection consents, use consents and disclosure consents to CDR representatives; and (b) amending such consents; and (c) related matters."@en ;
