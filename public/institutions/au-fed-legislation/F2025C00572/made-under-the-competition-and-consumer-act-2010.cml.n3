concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-47 a cml:Concept ;
    skos:prefLabel "4 20D  Requirements relating to seeking consent"@en ;
    cml:realizedBy doc:sch-4-sec-4-47 ;
    values:originalText "A request by a CDR representative for a CDR consumer to give or amend a consent: (a) must comply with any relevant data standards; and (b) having regard to any consumer experience guidelines developed by the Data Standards Body—must be reasonably easy to understand, including by use of plain concise language and, where appropriate, visual aids; and (c) must not include or refer to the CDR representative principal’s CDR policy or other documents in a way that reduces understandability; and (d) must not be combined with other requests except for a consent under these rules (other than a request for direct marketing or de-identification consent)." ;
    skos:definition "A request by a CDR representative for a CDR consumer to give or amend a consent: (a) must comply with any relevant data standards; and (b) having regard to any consumer experience guidelines developed by the Data Standards Body—must be reasonably easy to understand, including by use of plain concise language and, where appropriate, visual aids; and (c) must not include or refer to the CDR representative principal’s CDR policy or other documents in a way that reduces understandability; and (d) must not be combined with other requests except for a consent under these rules (other than a request for direct marketing or de-identification consent)."@en ;
    cml:integrityHash "354df254df855926f530d3080e71301f93c3ced3cdbf2e5d494519441e0eaddb" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Request for consent must comply with data standards and be easy to understand." ;
    dc:description "Reasonable ease of understanding" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <made-under-the-competition-and-consumer-act-2010.pdf> ;
