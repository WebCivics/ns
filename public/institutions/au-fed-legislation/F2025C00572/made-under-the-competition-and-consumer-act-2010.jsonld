    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 7  Observers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.142",
      "values:originalText": "(1) Any of the following:\n(a) the Commission;\n(b) the Information Commissioner;\n(c) the Department of the Treasury;\nmay elect to be an observer on a Data Standards Advisory Committee.\n(2) The Data Standards Chair may invite any other person to act as an observer on a\nCommittee.\n\n\nRules relating to data standards  Part 8\nReviewing, developing and amending data standards  Division 8.3\nSection 8.8\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "(1) Any of the following:\n(a) the Commission;\n(b) the Information Commissioner;\n(c) the Department of the Treasury;\nmay elect to be an observer on a Data Standards Advisory Committee.\n(2) The Data Standards Chair may invite any other person to act as an observer on a\nCommittee.\n\n\nRules relating to data standards  Part 8\nReviewing, developing and amending data standards  Division 8.3\nSection 8.8\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "cml:hasPart": [
