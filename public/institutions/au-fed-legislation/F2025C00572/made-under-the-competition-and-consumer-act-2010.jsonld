      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.80",
      "values:originalText": "This Division deals with:\n(a) giving collection consents, use consents and disclosure consents to CDR\nrepresentatives; and\n(b) amending such consents; and\n(c) related matters.",
      "skos:definition": "This Division deals with:\n(a) giving collection consents, use consents and disclosure consents to CDR\nrepresentatives; and\n(b) amending such consents; and\n(c) related matters.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-44-norm"
        }
      ],
      "cml:integrityHash": "6031e65cd29037e5c328da04fb9dadf1f1a1854dccef71d29c7fe09e523f8539",
      "skos:note": "Purpose of Division"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-44",
      "@type": "cof:Section",
      "cof:title": "4 20B  Purpose of Division",
      "values:kind": "section",
      "cof:pageNumber": 80,
      "values:originalText": "This Division deals with:\n(a) giving collection consents, use consents and disclosure consents to CDR\nrepresentatives; and\n(b) amending such consents; and\n(c) related matters."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-44-norm",
      "@type": "values:Obligation",
