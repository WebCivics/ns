          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-10-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-10-ss-2"
        },
