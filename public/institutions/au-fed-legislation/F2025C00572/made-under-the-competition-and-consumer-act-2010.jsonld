    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-39-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(2) 18B  Notification if collection consent or AP disclosure consent expires",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-39-ss-2"
      },
      "cml:curationStatus": {
