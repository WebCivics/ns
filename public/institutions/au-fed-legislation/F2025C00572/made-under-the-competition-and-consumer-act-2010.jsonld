        }
      ],
      "cml:integrityHash": "920a5b6290fb7cf52800bf0d8272ac1c9f6211e6b40f62c81951c44e90680954",
      "skos:note": "Must inform requester of refusal in accordance with data standards.",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-2-8-ss-2",
      "@type": "cof:Section",
