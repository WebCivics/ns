    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 6  Accreditation decision—accreditation number",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.108",
      "values:originalText": "The CDR Accreditor must, if it accredits an accreditation applicant, give the\napplicant a unique number by which it may be identified as an accredited person\n(their accreditation number).",
      "skos:definition": "The CDR Accreditor must, if it accredits an accreditation applicant, give the\napplicant a unique number by which it may be identified as an accredited person\n(their accreditation number).",
      "cml:asserts": [
