    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 3  Functions of Data Standards Advisory Committee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.141",
      "values:originalText": "The function of a Data Standards Advisory Committee is to advise the Data\nStandards Chair about:\n(a) any matters identified in the instrument establishing the Committee; and\n(b) any other matter referred to the Committee by the Chair.",
      "skos:definition": "The function of a Data Standards Advisory Committee is to advise the Data\nStandards Chair about:\n(a) any matters identified in the instrument establishing the Committee; and\n(b) any other matter referred to the Committee by the Chair.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-10-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e6cad64b2fc2f4cf22dcd0f20c57b92702a866461d3ba3670523e4ae1f3f3a3a",
      "skos:note": "The Committee advises the Chair on matters identified in the instrument establishing the Committee and any other matter referred to the Committee by the Chair."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-10",
      "@type": "cof:Section",
      "cof:title": "8 3  Functions of Data Standards Advisory Committee",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "The function of a Data Standards Advisory Committee is to advise the Data\nStandards Chair about:\n(a) any matters identified in the instrument establishing the Committee; and\n(b) any other matter referred to the Committee by the Chair."
    },
