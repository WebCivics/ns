        }
      ],
      "cml:integrityHash": "1384e7189f18f3ef38e1fb3fbc5db09f4216f435761edf7254dccc7748e92a34",
      "skos:note": "A person has account privileges in relation to an account with a retailer if they are a customer authorised representative of the account holder."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-2-11-ss-2",
      "@type": "cof:Section",
      "cof:title": "2(2) 2  Meaning of account privileges—energy sector",
      "values:kind": "subsection",
      "cof:pageNumber": 210,
      "values:originalText": "(2) For the energy sector, a person has account privileges in relation to an account\nwith a retailer if the person is a customer authorised representative of the account\nholder for the purposes of:\n(a) rule 56A of the National Energy Retail Rules; or\n(b) Chapter 7 of the National Electricity Rules."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-11-ss-2-norm",
