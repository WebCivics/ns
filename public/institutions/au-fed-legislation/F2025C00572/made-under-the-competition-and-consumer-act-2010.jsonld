    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 29  Publication of specified information by the Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.120",
      "values:originalText": "The Commission may publish information made available to it by the\nAccreditation Registrar relating to the performance and availability of systems to\nrespond to requests under these rules.",
      "skos:definition": "The Commission may publish information made available to it by the\nAccreditation Registrar relating to the performance and availability of systems to\nrespond to requests under these rules.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-35-norm"
        }
      ],
      "cml:integrityHash": "d796439999d2ee518c514a52e18de8bccc9e5bedc00df7bb3b29bb1fca16e436",
      "skos:note": "Commission may publish information made available to it by Accreditation Registrar."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-35",
      "@type": "cof:Section",
      "cof:title": "5 29  Publication of specified information by the Commission",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "The Commission may publish information made available to it by the\nAccreditation Registrar relating to the performance and availability of systems to\nrespond to requests under these rules."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-35-norm",
