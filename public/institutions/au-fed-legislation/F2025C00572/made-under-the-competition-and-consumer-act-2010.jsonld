      "cml:operator": "Diffuse",
      "cml:logicSummary": "Indicates a diffusion of information from accreditation revocation/surrender to consent expiration.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
