        }
      ],
      "cml:integrityHash": "4b9811fb11cb90ec86977d444f36c52938b45312e4cae2b759fa9caf0141e04f"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-34",
      "@type": "cof:Section",
      "cof:title": "1 22  SR data request by a CDR consumer",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "Note:\nThis rule relates to Division 3.2.\n(1) This rule applies where a CDR consumer proposes to make an SR data request.\n(2) The request must be made to the primary data holder, using the primary data\nholder’s direct request service."
    },
