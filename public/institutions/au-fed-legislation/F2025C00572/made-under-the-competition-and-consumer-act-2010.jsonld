      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.87",
      "values:originalText": "data.\nSubdivision 4.3A.7—Election to delete redundant data",
      "skos:definition": "data.\nSubdivision 4.3A.7—Election to delete redundant data",
      "cml:asserts": [
