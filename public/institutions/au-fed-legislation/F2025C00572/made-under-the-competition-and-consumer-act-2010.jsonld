      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 5  Grounds for revocation, suspension and surrender of accreditation—energy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-9-19"
      },
      "cml:curationStatus": {
