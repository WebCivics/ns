      "cml:integrityHash": "77b98781938787b334d89d01e42b385a8d825bb05d864ffceb72658ff8d8c184",
      "skos:note": "Rules apply in relation to the first data holder as if it were the second data holder."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-7-7-ss-2",
      "@type": "cof:Section",
      "cof:title": "7(2) 1A  Transfer of data sharing obligations between data holders",
      "values:kind": "subsection",
      "cof:pageNumber": 199,
      "values:originalText": "(2) If an election is in effect under subclause (1), these rules apply in relation to the\nfirst data holder in relation to the covered product as if it were the second data\nholder."
    },
