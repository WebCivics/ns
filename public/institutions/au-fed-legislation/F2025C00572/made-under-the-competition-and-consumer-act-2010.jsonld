      },
      "cml:operator": "<",
      "cml:logicSummary": "Defines temporal interval for amendment invitation.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Amendment invitation must occur before a certain point in time.",
      "cml:conclusionText": "Amendment invitation has a specific temporal scope."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(4) 20H  Inviting CDR consumer to amend consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-52-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.84",
      "values:originalText": "(4) The CDR representative must not, for an invitation to amend the period referred\nto in paragraph 4.20E(1)(b):\n(a) give the invitation any earlier than a reasonable period before the current\nconsent is expected to expire; or\n(b) give more than a reasonable number of such invitations within this period.",
      "skos:definition": "(4) The CDR representative must not, for an invitation to amend the period referred\nto in paragraph 4.20E(1)(b):\n(a) give the invitation any earlier than a reasonable period before the current\nconsent is expected to expire; or\n(b) give more than a reasonable number of such invitations within this period.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-4-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-4-logic-ltl-3"
        },
