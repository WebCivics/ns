        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "cannot",
      "cml:logicSummary": "Cannot ask for consent",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "CDR representative must not ask for a consent",
      "cml:conclusionText": "Prohibition"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is in category of consents",
      "cml:logicSummary": "Consent is in a category of consents",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A CDR representative must not ask for a consent that is not in a category of consents",
      "cml:conclusionText": "True"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-3-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is the CDR consumer who made the consumer data request",
      "cml:logicSummary": "Consent is from the CDR consumer",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A CDR representative must not ask for a consent subject to subrule (4), for using the CDR data, including by aggregating the data, for the purpose of identifying; or compiling insights in relation to; or building a profile in relation to any identifiable person who is not the CDR consumer who made the consumer data request",
      "cml:conclusionText": "False"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-3-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "not before",
      "cml:logicSummary": "Cannot ask for consent before certain time",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A CDR representative must not ask for a consent that is not in a category of consents; or subject to subrule (4), for using the CDR data, including by aggregating the data, for the purpose of identifying; or compiling insights in relation to; or building a profile in relation to any identifiable person who is not the CDR consumer who made the consumer data request",
      "cml:conclusionText": "True"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-3-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Cannot ask for consent until certain time",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A CDR representative must not ask for a consent that is not in a category of consents; or subject to subrule (4), for using the CDR data, including by aggregating the data, for the purpose of identifying; or compiling insights in relation to; or building a profile in relation to any identifiable person who is not the CDR consumer who made the consumer data request",
      "cml:conclusionText": "True"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(4) 20F  Restrictions on seeking consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-50-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.83",
      "values:originalText": "(4) Paragraph (3)(b) does not apply in relation to a person whose identity is readily\napparent from the CDR data, if the CDR representative is seeking consent to:\n(a) derive, from that CDR data, CDR data about that person’s interactions with\nthe CDR consumer; and\n(b) use that derived CDR data in order to provide the requested goods or\nservices.",
      "skos:definition": "(4) Paragraph (3)(b) does not apply in relation to a person whose identity is readily\napparent from the CDR data, if the CDR representative is seeking consent to:\n(a) derive, from that CDR data, CDR data about that person’s interactions with\nthe CDR consumer; and\n(b) use that derived CDR data in order to provide the requested goods or\nservices.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-4-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6042274885c7a428d04e34f19d851bdc29be214b2966dae00c68b1aeb60798fb",
      "skos:note": "Seeking consent to derive and use CDR data for goods or services"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-50-ss-4",
      "@type": "cof:Section",
      "cof:title": "4(4) 20F  Restrictions on seeking consent",
      "values:kind": "subsection",
      "cof:pageNumber": 83,
      "values:originalText": "(4) Paragraph (3)(b) does not apply in relation to a person whose identity is readily\napparent from the CDR data, if the CDR representative is seeking consent to:\n(a) derive, from that CDR data, CDR data about that person’s interactions with\nthe CDR consumer; and\n(b) use that derived CDR data in order to provide the requested goods or\nservices."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-50-ss-4-norm",
