    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-18-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(3) 11  Rule relating to privacy safeguard 12—security of CDR data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-18-ss-3"
      },
