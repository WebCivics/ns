      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-37-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
