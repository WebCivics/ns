    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 26  Dispute resolution—primary data holders and secondary data holders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.50",
      "values:originalText": "Where a primary data holder requests relevant information from a secondary data\nholder in relation to a consumer complaint or dispute with the primary data\nholder that relates to an SR data request, the secondary data holder must provide\nthe information to the extent that it is reasonable to do so.\n\n\nProduct data requests  Part 2\nApplication of rules in relation to SR data  Division 1.5\nSection 2.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "Where a primary data holder requests relevant information from a secondary data\nholder in relation to a consumer complaint or dispute with the primary data\nholder that relates to an SR data request, the secondary data holder must provide\nthe information to the extent that it is reasonable to do so.\n\n\nProduct data requests  Part 2\nApplication of rules in relation to SR data  Division 1.5\nSection 2.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "173c7a276e2d082c6be1851ce2eb69abeb9401a42cbed9d2ab1f82c5d992dc88",
      "skos:note": "Secondary data holder must provide information to primary data holder upon request.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-38",
      "@type": "cof:Section",
      "cof:title": "1 26  Dispute resolution—primary data holders and secondary data holders",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Where a primary data holder requests relevant information from a secondary data\nholder in relation to a consumer complaint or dispute with the primary data\nholder that relates to an SR data request, the secondary data holder must provide\nthe information to the extent that it is reasonable to do so.\n\n\nProduct data requests  Part 2\nApplication of rules in relation to SR data  Division 1.5\nSection 2.1\nCompetition and Consumer (Consumer Data Right) Rules 2020"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-38-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
