      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 1  Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-2-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.51",
      "values:originalText": "This Part deals with product data requests. Such requests are made using a data\nholder’s product data request service.\nA product data request may be for required product data, voluntary product data,\nor both.\nWhen requested in accordance with this Part, a data holder:\n•\nmust, subject to an exception outlined in this Part, disclose required\nproduct data; and\n•\nmay, but is not required to, disclose voluntary product data.\nIn either case, the data is disclosed to the person who made the request, in\nmachine-readable form and in accordance with the data standards. A data holder\nmust not impose conditions, restrictions or limitations of any kind on the use of\nthe disclosed data.\nA fee cannot be charged for the disclosure of required product data, but could be\ncharged for the disclosure of voluntary product data.",
      "skos:definition": "This Part deals with product data requests. Such requests are made using a data\nholder’s product data request service.\nA product data request may be for required product data, voluntary product data,\nor both.\nWhen requested in accordance with this Part, a data holder:\n•\nmust, subject to an exception outlined in this Part, disclose required\nproduct data; and\n•\nmay, but is not required to, disclose voluntary product data.\nIn either case, the data is disclosed to the person who made the request, in\nmachine-readable form and in accordance with the data standards. A data holder\nmust not impose conditions, restrictions or limitations of any kind on the use of\nthe disclosed data.\nA fee cannot be charged for the disclosure of required product data, but could be\ncharged for the disclosure of voluntary product data.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-4-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "150b91917a319441b917637bb80cc32dc2ec4dc942918d74fe9cee082e5cf96a",
      "skos:note": "Data holder must disclose required product data and may disclose voluntary product data.",
      "dc:description": "required product data"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-2-4",
      "@type": "cof:Section",
      "cof:title": "2 1  Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "This Part deals with product data requests. Such requests are made using a data\nholder’s product data request service.\nA product data request may be for required product data, voluntary product data,\nor both.\nWhen requested in accordance with this Part, a data holder:\n•\nmust, subject to an exception outlined in this Part, disclose required\nproduct data; and\n•\nmay, but is not required to, disclose voluntary product data.\nIn either case, the data is disclosed to the person who made the request, in\nmachine-readable form and in accordance with the data standards. A data holder\nmust not impose conditions, restrictions or limitations of any kind on the use of\nthe disclosed data.\nA fee cannot be charged for the disclosure of required product data, but could be\ncharged for the disclosure of voluntary product data."
    },
    {
