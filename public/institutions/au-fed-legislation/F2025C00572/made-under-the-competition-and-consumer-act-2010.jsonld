    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-1-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 2  Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-1-9"
      },
      "cml:curationStatus": {
