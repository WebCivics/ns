      "cml:integrityHash": "bb8a15ffaa1c6ff218c89165b3addc54ed759764685122ae3ff422761a60e7e6",
      "skos:note": "Accredited data recipient must document information security practices.",
      "dc:description": "Clear documentation of practices and procedures"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-2-sec-1-10-ss-2",
      "@type": "cof:Section",
      "cof:title": "1(2) 3  Step 1—Define and implement security governance in relation to CDR data",
      "values:kind": "subsection",
      "cof:pageNumber": 167,
      "values:originalText": "(2) The accredited data recipient must clearly document its practices and procedures\nrelating to information security and management of CDR data, including the\nspecific responsibilities of senior management."
    },
