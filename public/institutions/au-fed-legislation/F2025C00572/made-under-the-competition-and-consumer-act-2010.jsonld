    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 31  Obligation to comply with Accreditation Registrar's request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.121",
      "values:originalText": "(1) The Accreditation Registrar may request a data holder or an accredited person to\ndo a specified thing in order to ensure the security, integrity and stability of the\nRegister of Accredited Persons or associated database.\n(2) The data holder or accredited person must comply with such a request.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "(1) The Accreditation Registrar may request a data holder or an accredited person to\ndo a specified thing in order to ensure the security, integrity and stability of the\nRegister of Accredited Persons or associated database.\n(2) The data holder or accredited person must comply with such a request.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-37-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-37-ss-2"
        }
      ],
      "cml:integrityHash": "3b1d1df46ddb3f1d042ae26ef2da7103a03f5d59dc5a56a28d27ed313b8b8cc7"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-37",
      "@type": "cof:Section",
      "cof:title": "5 31  Obligation to comply with Accreditation Registrar's request",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "(1) The Accreditation Registrar may request a data holder or an accredited person to\ndo a specified thing in order to ensure the security, integrity and stability of the\nRegister of Accredited Persons or associated database.\n(2) The data holder or accredited person must comply with such a request.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
