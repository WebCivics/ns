      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to comply with section 56EK of the Act",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.134",
      "values:originalText": "8B  Rule relating to privacy safeguards 8 and 9—failure by direct or indirect\nOSP to comply with safeguards\nPrivacy safeguard 8—overseas disclosure\n(1) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EK of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nPrivacy safeguard 9—government related identifiers\n(2) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EL of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "8B  Rule relating to privacy safeguards 8 and 9—failure by direct or indirect\nOSP to comply with safeguards\nPrivacy safeguard 8—overseas disclosure\n(1) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EK of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nPrivacy safeguard 9—government related identifiers\n(2) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EL of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-2"
        }
      ],
      "cml:integrityHash": "0e1043b46c8adf8c79fa407323196865e1b1f10756ea53962bcf5567a6c2d267"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-14",
      "@type": "cof:Section",
      "cof:title": "7 Section 7",
      "values:kind": "section",
      "cof:pageNumber": 134,
      "values:originalText": "8B  Rule relating to privacy safeguards 8 and 9—failure by direct or indirect\nOSP to comply with safeguards\nPrivacy safeguard 8—overseas disclosure\n(1) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EK of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nPrivacy safeguard 9—government related identifiers\n(2) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EL of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(1) Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-14-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
