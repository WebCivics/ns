    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(2) 2  Meeting external dispute resolution requirements—energy sector",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-43-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.216",
      "values:originalText": "(2) In this clause, a retailer or an accredited person is an AFCA member if it is a\nmember of the recognised external dispute resolution scheme operated by the\nAustralian Financial Complaints Authority Limited for the energy sector.\nMeaning of EWO member",
      "skos:definition": "(2) In this clause, a retailer or an accredited person is an AFCA member if it is a\nmember of the recognised external dispute resolution scheme operated by the\nAustralian Financial Complaints Authority Limited for the energy sector.\nMeaning of EWO member",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-2-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "308561eaed10ab0b4d05c65789998238b774855aaafb1286f341b185b14644b2",
      "skos:note": "Must be an AFCA member of the recognised external dispute resolution scheme for energy sector"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-43-ss-2",
      "@type": "cof:Section",
      "cof:title": "5(2) 2  Meeting external dispute resolution requirements—energy sector",
      "values:kind": "subsection",
      "cof:pageNumber": 216,
      "values:originalText": "(2) In this clause, a retailer or an accredited person is an AFCA member if it is a\nmember of the recognised external dispute resolution scheme operated by the\nAustralian Financial Complaints Authority Limited for the energy sector.\nMeaning of EWO member"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
