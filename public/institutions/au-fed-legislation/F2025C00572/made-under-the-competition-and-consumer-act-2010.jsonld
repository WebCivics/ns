    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-28-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(4) 17  CDR data de-identification process",
      "cml:realizedBy": {
