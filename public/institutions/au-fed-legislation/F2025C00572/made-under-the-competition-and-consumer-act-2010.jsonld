        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-4-logic-argumentation-5"
        }
      ],
      "cml:integrityHash": "542d629ac3859f728964c76b759df838824903c74373543aa477f872338c1708",
      "skos:note": "Cannot give invitations too early or too frequently"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-52-ss-4",
      "@type": "cof:Section",
      "cof:title": "4(4) 20H  Inviting CDR consumer to amend consent",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(4) The CDR representative must not, for an invitation to amend the period referred\nto in paragraph 4.20E(1)(b):\n(a) give the invitation any earlier than a reasonable period before the current\nconsent is expected to expire; or\n(b) give more than a reasonable number of such invitations within this period."
    },
