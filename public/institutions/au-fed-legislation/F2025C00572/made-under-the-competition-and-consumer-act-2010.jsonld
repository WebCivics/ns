    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-16-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
