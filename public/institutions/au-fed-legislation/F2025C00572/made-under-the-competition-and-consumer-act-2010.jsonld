    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 6  Application to other non-bank lenders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-6-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.194",
      "values:originalText": "These rules only apply in relation to a relevant non-bank lender that:\n(a) is an initial provider; or\n(b) is a large provider; or\n(c) has notified the Commission under clause 6.11 that it wishes Part 2 or Part\n4 of these rules to apply to it from a specified date.",
      "skos:definition": "These rules only apply in relation to a relevant non-bank lender that:\n(a) is an initial provider; or\n(b) is a large provider; or\n(c) has notified the Commission under clause 6.11 that it wishes Part 2 or Part\n4 of these rules to apply to it from a specified date.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-19-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-19-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-19-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "f951115f4c40533e41c17804d0412a0e5776f4639525af11d0b5ac2f38702141",
      "skos:note": "These rules only apply to relevant non-bank lenders under specified conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-6-19",
      "@type": "cof:Section",
      "cof:title": "6 6  Application to other non-bank lenders",
      "values:kind": "section",
      "cof:pageNumber": 194,
      "values:originalText": "These rules only apply in relation to a relevant non-bank lender that:\n(a) is an initial provider; or\n(b) is a large provider; or\n(c) has notified the Commission under clause 6.11 that it wishes Part 2 or Part\n4 of these rules to apply to it from a specified date."
    },
    {
