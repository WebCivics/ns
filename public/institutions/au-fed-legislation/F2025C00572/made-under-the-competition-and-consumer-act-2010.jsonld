    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 4  Consumer data request by accredited person to data holder",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.63",
      "values:originalText": "(1) If:\n(a) a CDR consumer has given an accredited person a request under rule 4.3 or",
      "skos:definition": "(1) If:\n(a) a CDR consumer has given an accredited person a request under rule 4.3 or",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-12-norm"
        }
      ],
      "cml:integrityHash": "b4357accb6d24d60fe0426e33ad0731b037b592bbf20048ef6167c5a1807d3fb",
      "skos:note": "Consumer data request by accredited person to data holder"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-12",
      "@type": "cof:Section",
      "cof:title": "4 4  Consumer data request by accredited person to data holder",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "(1) If:\n(a) a CDR consumer has given an accredited person a request under rule 4.3 or"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-12-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-12"
      },
