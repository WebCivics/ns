      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.72",
      "values:originalText": "An amendment of a consent takes effect when the CDR consumer amends the\nconsent.\nNote:\nIt is not possible for the CDR consumer to specify a different day or time.",
      "skos:definition": "An amendment of a consent takes effect when the CDR consumer amends the\nconsent.\nNote:\nIt is not possible for the CDR consumer to specify a different day or time.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-26-norm"
        },
        {
