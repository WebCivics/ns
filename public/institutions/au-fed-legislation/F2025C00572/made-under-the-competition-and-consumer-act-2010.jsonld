      "@type": "cml:Concept",
      "skos:prefLabel": "4A(5) 13.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-20-ss-5"
      },
