        }
      ],
      "cml:integrityHash": "d99e8225ba1ff822ef9f6492241a200ac5f274604db14c7efd90da01f318dc32",
      "skos:note": "Rules apply to data holders with specific BNPL dates and CDR data."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-6-23-ss-3",
      "@type": "cof:Section",
      "cof:title": "6(3) 10  Providers of buy now, pay later products",
      "values:kind": "subsection",
      "cof:pageNumber": 195,
      "values:originalText": "(3) These rules apply in relation to such a data holder with a BNPL date that is\nbetween 14 July 2026 and 10 May 2027, in respect of CDR data that relates to a\nBNPL product, as set out in the following table:\n\nSchedule 3  Provisions relevant to the banking and non-bank lenders sectors"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-6-23-ss-3-norm",
      "@type": "values:Obligation",
