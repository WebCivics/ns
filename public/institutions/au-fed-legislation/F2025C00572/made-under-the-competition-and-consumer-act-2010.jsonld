    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-10-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "9(4) 5  Requests from CDR consumers for copies of records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-9-10-ss-4"
