      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Retailer uses energy sector CDR data only for energy sector purposes",
      "cml:conclusionText": "Energy sector CDR data is used only for energy sector purposes"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MustNotUse",
      "cml:logicSummary": "Retailer must not use non-energy sector CDR data.",
      "cml:executionSurface": "modalities::logic::deontic",
