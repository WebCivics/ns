    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 14(2); and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.106",
      "values:originalText": "(b) the Registrar has recorded on the Register of Accredited Persons that the\nperson is an affiliate of the sponsor.\nNote:\nIf the sponsorship arrangement terminates, the sponsor is no longer a registered sponsor\nfor subrules (2) and (3), even if the Register has not yet been updated to reflect this.\n\n\nRules relating to accreditation etc.  Part 5\nRules relating to accreditation process  Division 5.2\nSection 5.2\nCompetition and Consumer (Consumer Data Right) Rules 2020\nSubdivision 5.2.1—Applying to be accredited person",
      "skos:definition": "(b) the Registrar has recorded on the Register of Accredited Persons that the\nperson is an affiliate of the sponsor.\nNote:\nIf the sponsorship arrangement terminates, the sponsor is no longer a registered sponsor\nfor subrules (2) and (3), even if the Register has not yet been updated to reflect this.\n\n\nRules relating to accreditation etc.  Part 5\nRules relating to accreditation process  Division 5.2\nSection 5.2\nCompetition and Consumer (Consumer Data Right) Rules 2020\nSubdivision 5.2.1—Applying to be accredited person",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-6-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7cb9c9c1c032d2390ed569e46711e2c7e12fc3dd0c8c75487ae9f8b02b05aee9",
      "skos:note": "The Registrar must record the person as an affiliate of the sponsor."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-6",
      "@type": "cof:Section",
      "cof:title": "5 14(2); and",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "(b) the Registrar has recorded on the Register of Accredited Persons that the\nperson is an affiliate of the sponsor.\nNote:\nIf the sponsorship arrangement terminates, the sponsor is no longer a registered sponsor\nfor subrules (2) and (3), even if the Register has not yet been updated to reflect this.\n\n\nRules relating to accreditation etc.  Part 5\nRules relating to accreditation process  Division 5.2\nSection 5.2\nCompetition and Consumer (Consumer Data Right) Rules 2020\nSubdivision 5.2.1—Applying to be accredited person"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-6-norm",
      "@type": "values:Obligation",
