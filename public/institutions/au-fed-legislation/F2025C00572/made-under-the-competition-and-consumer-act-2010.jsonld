    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-22-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "Corrected data and statement are provided within 10 business days",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
