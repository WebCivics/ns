      ],
      "cml:integrityHash": "e47d62d5e55c2fd668c3b2116d3b6ac8f517f85ca0860fda7f8f8120797931ea",
      "skos:note": "Consumer notification must be given in writing through a method other than the consumer dashboard."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-66-ss-3",
      "@type": "cof:Section",
      "cof:title": "4(3) 20Q  Notification of consumer if collection consent expires",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
      "values:originalText": "(3) The notification must be given in writing otherwise than through the CDR\nrepresentative principal’s consumer dashboard.\nNote:\nThe CDR representative principal may allow the CDR representative to provide the\nconsumer dashboard on its behalf—see subrule 1.14(5)."
    },
