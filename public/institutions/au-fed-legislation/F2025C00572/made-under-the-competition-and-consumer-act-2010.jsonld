    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-26-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(6) 16  Obligations relating to outsourcing arrangements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-26-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.43",
      "values:originalText": "(6) For this rule, a provision of a CDR outsourcing arrangement is a required\nprovision if the arrangement would cease to be a CDR outsourcing arrangement\nunder subrule 1.10(3) if the provision were removed.",
      "skos:definition": "(6) For this rule, a provision of a CDR outsourcing arrangement is a required\nprovision if the arrangement would cease to be a CDR outsourcing arrangement\nunder subrule 1.10(3) if the provision were removed.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-26"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-26-ss-6-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-26-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2375e3a1dde84d766fbf8e64ab1f7fac24e7cee8dad01e5a5a4202cd8d10202a",
      "skos:note": "A provision in a CDR outsourcing arrangement is required if removing it would cease the arrangement to be a CDR."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-26-ss-6",
      "@type": "cof:Section",
      "cof:title": "1(6) 16  Obligations relating to outsourcing arrangements",
      "values:kind": "subsection",
      "cof:pageNumber": 43,
      "values:originalText": "(6) For this rule, a provision of a CDR outsourcing arrangement is a required\nprovision if the arrangement would cease to be a CDR outsourcing arrangement\nunder subrule 1.10(3) if the provision were removed."
    },
    {
