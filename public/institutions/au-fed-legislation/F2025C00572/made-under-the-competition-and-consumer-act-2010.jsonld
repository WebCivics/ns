        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Person of kind X is an AFCA member if it is an AFCA member.",
      "cml:conclusionText": "X meets external dispute resolution requirements if it is an AFCA member."
    },
    {
