    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.133",
      "values:originalText": "8  Rule relating to privacy safeguard 7—use or disclosure of CDR data for\ndirect marketing by accredited data recipients\nNote:\nParagraph 56EJ(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or\ndisclose it for direct marketing unless the use or disclosure is authorised under the consumer data rules in\naccordance with a valid consent of a CDR consumer for the CDR data. This rule provides an\nauthorisation for that paragraph.\nSection 56EJ of the Act applies only in relation to CDR data for which there are one or more CDR\nconsumers: subsection 56EB(1) of the Act.\nFor paragraph 56EJ(1)(b) of the Act, the use or disclosure of CDR data for which\nthere is a CDR consumer by an accredited data recipient of the CDR data for\ndirect marketing is authorised under these rules if it is a permitted use or\ndisclosure that relates to direct marketing.",
      "skos:definition": "8  Rule relating to privacy safeguard 7—use or disclosure of CDR data for\ndirect marketing by accredited data recipients\nNote:\nParagraph 56EJ(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or\ndisclose it for direct marketing unless the use or disclosure is authorised under the consumer data rules in\naccordance with a valid consent of a CDR consumer for the CDR data. This rule provides an\nauthorisation for that paragraph.\nSection 56EJ of the Act applies only in relation to CDR data for which there are one or more CDR\nconsumers: subsection 56EB(1) of the Act.\nFor paragraph 56EJ(1)(b) of the Act, the use or disclosure of CDR data for which\nthere is a CDR consumer by an accredited data recipient of the CDR data for\ndirect marketing is authorised under these rules if it is a permitted use or\ndisclosure that relates to direct marketing.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-12-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2ee3d76c50b4bdb54d9cf0dd88ee805923ef2d8658fefbf30af64931b710962d",
      "skos:note": "Authorisation for use or disclosure of CDR data for direct marketing by accredited data recipients."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-12",
      "@type": "cof:Section",
      "cof:title": "7 Section 7",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "8  Rule relating to privacy safeguard 7—use or disclosure of CDR data for\ndirect marketing by accredited data recipients\nNote:\nParagraph 56EJ(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or\ndisclose it for direct marketing unless the use or disclosure is authorised under the consumer data rules in\naccordance with a valid consent of a CDR consumer for the CDR data. This rule provides an\nauthorisation for that paragraph.\nSection 56EJ of the Act applies only in relation to CDR data for which there are one or more CDR\nconsumers: subsection 56EB(1) of the Act.\nFor paragraph 56EJ(1)(b) of the Act, the use or disclosure of CDR data for which\nthere is a CDR consumer by an accredited data recipient of the CDR data for\ndirect marketing is authorised under these rules if it is a permitted use or\ndisclosure that relates to direct marketing."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-12-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
