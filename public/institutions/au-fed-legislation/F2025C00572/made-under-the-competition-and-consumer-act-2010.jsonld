    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-7-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(2) 1A  Transfer of data sharing obligations between data holders",
      "cml:realizedBy": {
