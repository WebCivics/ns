    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 4  Meaning of retailer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.208",
      "values:originalText": "For this Schedule, a data holder of energy sector data is a retailer if:\n(a) it retails electricity to connection points in the National Electricity Market;\nand\n(b) it is either:\n(i) the holder of a retailer authorisation issued under the National Energy\nRetail Law (as it applies in a State or Territory) in respect of the sale\nof electricity; or\n(ii) a retailer within the meaning of the Electricity Industry Act 2000\n(Vic).",
      "skos:definition": "For this Schedule, a data holder of energy sector data is a retailer if:\n(a) it retails electricity to connection points in the National Electricity Market;\nand\n(b) it is either:\n(i) the holder of a retailer authorisation issued under the National Energy\nRetail Law (as it applies in a State or Territory) in respect of the sale\nof electricity; or\n(ii) a retailer within the meaning of the Electricity Industry Act 2000\n(Vic).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-42-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-42-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "18c0e2bc629ff6e296b7a1d41a29eccdbb141ed6479582a0cd027aa037124745",
      "skos:note": "Retailer definition for energy sector data"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-42",
      "@type": "cof:Section",
      "cof:title": "1 4  Meaning of retailer",
      "values:kind": "section",
      "cof:pageNumber": 208,
      "values:originalText": "For this Schedule, a data holder of energy sector data is a retailer if:\n(a) it retails electricity to connection points in the National Electricity Market;\nand\n(b) it is either:\n(i) the holder of a retailer authorisation issued under the National Energy\nRetail Law (as it applies in a State or Territory) in respect of the sale\nof electricity; or\n(ii) a retailer within the meaning of the Electricity Industry Act 2000\n(Vic)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-42-norm",
      "@type": "values:Obligation",
      "cml:modality": {
