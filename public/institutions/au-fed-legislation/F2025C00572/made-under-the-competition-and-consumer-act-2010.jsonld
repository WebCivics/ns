    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 18C  Notification of data holder or accredited data recipient if collection",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.78",
      "values:originalText": "consent is amended\n(1) This rule applies if:\n(a) an accredited person has made a consumer data request to a CDR\nparticipant, based on a collection consent given under this Division relating\nto particular CDR data and that CDR participant; and\n(b) the request has not been completely resolved; and\n(c) the CDR consumer amends the consent.\n(2) The accredited person must notify:\n(a) if the CDR participant is a data holder―the data holder, in accordance with\nthe data standards, that the consent has been amended; and\n(b) if the CDR participant is an accredited data recipient―the accredited data\nrecipient as soon as practicable that the consent has been amended.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "consent is amended\n(1) This rule applies if:\n(a) an accredited person has made a consumer data request to a CDR\nparticipant, based on a collection consent given under this Division relating\nto particular CDR data and that CDR participant; and\n(b) the request has not been completely resolved; and\n(c) the CDR consumer amends the consent.\n(2) The accredited person must notify:\n(a) if the CDR participant is a data holder―the data holder, in accordance with\nthe data standards, that the consent has been amended; and\n(b) if the CDR participant is an accredited data recipient―the accredited data\nrecipient as soon as practicable that the consent has been amended.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-40-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-40-ss-2"
        }
      ],
      "cml:integrityHash": "d3b619248696160abe6fd7862f5c41b14b9558991360fbd22e713a2d3d924762"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-40",
      "@type": "cof:Section",
      "cof:title": "4 18C  Notification of data holder or accredited data recipient if collection",
      "values:kind": "section",
      "cof:pageNumber": 78,
      "values:originalText": "consent is amended\n(1) This rule applies if:\n(a) an accredited person has made a consumer data request to a CDR\nparticipant, based on a collection consent given under this Division relating\nto particular CDR data and that CDR participant; and\n(b) the request has not been completely resolved; and\n(c) the CDR consumer amends the consent.\n(2) The accredited person must notify:\n(a) if the CDR participant is a data holder―the data holder, in accordance with\nthe data standards, that the consent has been amended; and\n(b) if the CDR participant is an accredited data recipient―the accredited data\nrecipient as soon as practicable that the consent has been amended.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
