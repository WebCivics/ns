    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-37-ss-2",
      "@type": "cof:Section",
      "cof:title": "4(2) 18AA  Notification of data holder or accredited data recipient if collection",
      "values:kind": "subsection",
      "cof:pageNumber": 76,
      "values:originalText": "(2) The accredited person must notify:\n(a) if the CDR participant is a data holder―the data holder, in accordance with\nthe data standards, that the consent has expired; and\n(b) if the CDR participant is an accredited data recipient―the accredited data\nrecipient as soon as practicable that the consent has expired.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-37-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-37-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
