      "skos:note": "Exemption from rules for large non-bank lenders"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-6-18-ss-4",
      "@type": "cof:Section",
