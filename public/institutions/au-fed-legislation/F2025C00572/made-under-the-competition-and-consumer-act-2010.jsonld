    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35-ss-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(11) 23  SR data request by an accredited person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-35-ss-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.48",
      "values:originalText": "(11) Division 4.4 (authorisations to disclose CDR data) applies as if:\n(a) a reference to the data holder were a reference to the primary data holder;\nand\n(b) the following subrule were added after subrule 4.25(2) (withdrawal of\nauthorisation by CDR consumer):\n“(3) For subrule (2), giving effect to withdrawal includes cancelling any\ncurrent requests to the secondary data holder by the primary data\nholder under subrule 1.23(4).”.",
      "skos:definition": "(11) Division 4.4 (authorisations to disclose CDR data) applies as if:\n(a) a reference to the data holder were a reference to the primary data holder;\nand\n(b) the following subrule were added after subrule 4.25(2) (withdrawal of\nauthorisation by CDR consumer):\n“(3) For subrule (2), giving effect to withdrawal includes cancelling any\ncurrent requests to the secondary data holder by the primary data\nholder under subrule 1.23(4).”.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35-ss-11-norm"
        },
