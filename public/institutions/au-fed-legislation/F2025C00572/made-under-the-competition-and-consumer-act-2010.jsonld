    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 10  Matters to have regard to when making or amending data standards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.143",
      "values:originalText": "When making or amending a data standard, the Data Standards Chair must have\nregard to the following:\n(a) the advice or submissions (if any) received from:\n(i) the Data Standards Advisory Committee; or\n(ii) the Commission; or\n(iii) the Information Commissioner;\non a draft of the proposed standard or amendment (the consultation draft);",
      "skos:definition": "When making or amending a data standard, the Data Standards Chair must have\nregard to the following:\n(a) the advice or submissions (if any) received from:\n(i) the Data Standards Advisory Committee; or\n(ii) the Commission; or\n(iii) the Information Commissioner;\non a draft of the proposed standard or amendment (the consultation draft);",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-17-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "66ebcfeb303f4614d1ea4d71405516a2fe221dc83c7149f7bfc88b90835c127f",
      "skos:note": "Must consider certain advice and submissions when making or amending data standards."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-17",
      "@type": "cof:Section",
      "cof:title": "8 10  Matters to have regard to when making or amending data standards",
      "values:kind": "section",
      "cof:pageNumber": 143,
      "values:originalText": "When making or amending a data standard, the Data Standards Chair must have\nregard to the following:\n(a) the advice or submissions (if any) received from:\n(i) the Data Standards Advisory Committee; or\n(ii) the Commission; or\n(iii) the Information Commissioner;\non a draft of the proposed standard or amendment (the consultation draft);"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-17-norm",
