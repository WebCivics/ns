        }
      ],
      "cml:integrityHash": "f46d7edddaf3b6c5c195b42430f20780bf1042c857b51ce2e42e1c53da3775a5",
      "skos:note": "Disclosure of service data by a CDR representative is taken to be a disclosure by the CDR representative principal."
    },
    {
