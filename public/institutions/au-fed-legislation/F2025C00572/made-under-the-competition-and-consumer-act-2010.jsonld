    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-91-ss-5",
      "@type": "cof:Section",
      "cof:title": "4(5) 20L(b):",
      "values:kind": "subsection",
