      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.135",
      "values:originalText": "(1) If a CDR participant makes a disclosure of a kind referred to in paragraphs\n56EN(3)(a) and (b) of the Act to an accredited person, the CDR participant must\nprovide the CDR consumer on whose behalf the disclosure was made, by\nelectronic means, with a written notice that:",
      "skos:definition": "(1) If a CDR participant makes a disclosure of a kind referred to in paragraphs\n56EN(3)(a) and (b) of the Act to an accredited person, the CDR participant must\nprovide the CDR consumer on whose behalf the disclosure was made, by\nelectronic means, with a written notice that:",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-16-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-16-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-16-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "0bd0b74c7cc7c3eb23babddbd611bdfbbf9d53f4778b8ff10fc7b61fa05f4f2d",
      "skos:note": "Must provide written notice to CDR consumer upon disclosure of certain information",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-16",
      "@type": "cof:Section",
      "cof:title": "7 10  Rule relating to privacy safeguard 11—quality of CDR data",
      "values:kind": "section",
      "cof:pageNumber": 135,
      "values:originalText": "(1) If a CDR participant makes a disclosure of a kind referred to in paragraphs\n56EN(3)(a) and (b) of the Act to an accredited person, the CDR participant must\nprovide the CDR consumer on whose behalf the disclosure was made, by\nelectronic means, with a written notice that:"
    },
