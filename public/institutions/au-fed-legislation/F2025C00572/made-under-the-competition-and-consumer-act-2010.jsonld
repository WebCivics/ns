      "values:originalText": "(2) An accredited data recipient must not charge a fee for responding to or actioning\na request under subsection 56EP(2) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-21-ss-2-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-21-ss-2"
      },
      "values:deonticStatus": {
