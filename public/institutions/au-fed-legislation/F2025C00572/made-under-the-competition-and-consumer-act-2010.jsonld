      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Authorisation for use or disclosure of CDR data.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
