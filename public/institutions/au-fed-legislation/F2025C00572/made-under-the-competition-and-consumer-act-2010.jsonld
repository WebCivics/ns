      "@type": "cml:Concept",
      "skos:prefLabel": "1(7) 23  SR data request by an accredited person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-35-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
