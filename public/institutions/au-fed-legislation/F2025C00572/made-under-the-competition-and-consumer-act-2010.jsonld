    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-7-ss-1",
      "@type": "cof:Section",
      "cof:title": "5(1) 2  Applying to be an accredited person",
      "values:kind": "subsection",
      "cof:pageNumber": 107,
      "values:originalText": "(1) A person may apply to the CDR Accreditor to be an accredited person."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-7-ss-1-norm",
