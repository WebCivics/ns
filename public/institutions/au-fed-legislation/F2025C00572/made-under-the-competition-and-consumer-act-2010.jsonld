    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 1A  Application of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.211",
      "values:originalText": "This Part does not apply in relation to a plan while it is a trial product.\nNote:\nIf a plan ceases to be a trial product in accordance with subclause 1.5(2) of this\nSchedule, the data holder must comply with its obligations under this Part in relation to\nthe plan. The obligations cover any CDR data generated while the plan was a trial\nproduct.",
      "skos:definition": "This Part does not apply in relation to a plan while it is a trial product.\nNote:\nIf a plan ceases to be a trial product in accordance with subclause 1.5(2) of this\nSchedule, the data holder must comply with its obligations under this Part in relation to\nthe plan. The obligations cover any CDR data generated while the plan was a trial\nproduct.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-9-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bd45b8965ad2ff3091e9692b9a9df6ae340a512b9cc96557d56bdcb12f9d02c2",
      "skos:note": "Comply with obligations under this Part if a plan ceases to be a trial product."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-9",
      "@type": "cof:Section",
      "cof:title": "3 1A  Application of Part",
      "values:kind": "section",
      "cof:pageNumber": 211,
      "values:originalText": "This Part does not apply in relation to a plan while it is a trial product.\nNote:\nIf a plan ceases to be a trial product in accordance with subclause 1.5(2) of this\nSchedule, the data holder must comply with its obligations under this Part in relation to\nthe plan. The obligations cover any CDR data generated while the plan was a trial\nproduct."
    },
