      "skos:note": "Update consumer dashboard upon change of required information.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-41-ss-1",
      "@type": "cof:Section",
      "cof:title": "4(1) 19  Updating consumer dashboard",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(1) An accredited person must update a CDR consumer’s consumer dashboard as\nsoon as practicable after the information required to be contained on the\ndashboard changes.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-41-ss-1-norm",
      "@type": "values:Obligation",
