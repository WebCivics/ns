    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 5  Civil penalties do not apply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.214",
      "values:originalText": "A civil penalty imposed by these rules for a breach of a provision of these rules,\nincluding one imposed by rule 9.8 by declaring the relevant provision to be a\ncivil penalty provision, does not apply in relation to AEMO, the AER or the\nVictorian agency in relation to energy sector data.\n\nProvisions relevant to the energy sector  Schedule 4\nDispute resolution—energy sector  Part 5\nClause 5.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "A civil penalty imposed by these rules for a breach of a provision of these rules,\nincluding one imposed by rule 9.8 by declaring the relevant provision to be a\ncivil penalty provision, does not apply in relation to AEMO, the AER or the\nVictorian agency in relation to energy sector data.\n\nProvisions relevant to the energy sector  Schedule 4\nDispute resolution—energy sector  Part 5\nClause 5.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-96-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-96-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db8e79d28708ccbaecd4d24f24e36d462d16eedcb2474b641869cbd9c2139cb2",
      "skos:note": "Civil penalties do not apply to energy sector data"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-96",
      "@type": "cof:Section",
      "cof:title": "4 5  Civil penalties do not apply",
      "values:kind": "section",
      "cof:pageNumber": 214,
      "values:originalText": "A civil penalty imposed by these rules for a breach of a provision of these rules,\nincluding one imposed by rule 9.8 by declaring the relevant provision to be a\ncivil penalty provision, does not apply in relation to AEMO, the AER or the\nVictorian agency in relation to energy sector data.\n\nProvisions relevant to the energy sector  Schedule 4\nDispute resolution—energy sector  Part 5\nClause 5.1\nCompetition and Consumer (Consumer Data Right) Rules 2020"
    },
