        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Receiving information from CDR and Data Recipient Accreditor is a prerequisite for updating the Register",
      "cml:conclusionText": "Updating the Register occurs after receiving this information"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-32-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "Permission to amend database upon request from Accreditation Registrar",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Accreditation Registrar may amend database",
      "cml:conclusionText": "Amending the database is permitted under certain conditions"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-32-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "Permission to make clerical amendments to entries in Register or database",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Accreditation Registrar may make clerical amendments",
      "cml:conclusionText": "Making clerical amendments is permitted under certain conditions"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 27  Publication or availability of specified information in the Register of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.120",
      "values:originalText": "Accredited Persons\nFor paragraph 56CE(4)(c) of the Act, the Accreditation Registrar must, in the\nmanner the Registrar thinks fit, make the following information publicly\navailable:\n(a) the information referred to in rule 5.24;\n(b) the information referred to in paragraphs 5.25(1)(a) and (b).",
      "skos:definition": "Accredited Persons\nFor paragraph 56CE(4)(c) of the Act, the Accreditation Registrar must, in the\nmanner the Registrar thinks fit, make the following information publicly\navailable:\n(a) the information referred to in rule 5.24;\n(b) the information referred to in paragraphs 5.25(1)(a) and (b).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-33-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "91bf4df3b684c2413a2c40a080791f6117f2a0b672d001bc74736b3b649abbd0",
      "skos:note": "Publicly available information must be provided by the Accreditation Registrar.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-33",
      "@type": "cof:Section",
      "cof:title": "5 27  Publication or availability of specified information in the Register of",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "Accredited Persons\nFor paragraph 56CE(4)(c) of the Act, the Accreditation Registrar must, in the\nmanner the Registrar thinks fit, make the following information publicly\navailable:\n(a) the information referred to in rule 5.24;\n(b) the information referred to in paragraphs 5.25(1)(a) and (b)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-33-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-33"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-33-logic-deontic-1",
