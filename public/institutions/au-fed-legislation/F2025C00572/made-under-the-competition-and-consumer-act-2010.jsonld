      },
      "cml:premiseText": "CDR representative may invite amendment if certain conditions are met.",
      "cml:conclusionText": "Amendment is permissible under specified conditions."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-52-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
