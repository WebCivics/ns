    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 20R  Notification if collection consent or AP disclosure consent expires",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-67"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.89",
      "values:originalText": "(1) This rule applies if:\n(a) a CDR representative principal has made a consumer data request to an\naccredited data recipient on behalf of a CDR representative, based on a\ncollection consent given under this Division relating to particular CDR data\nand that accredited data recipient; and\n(b) the accredited data recipient has an AP disclosure consent relating to that\nCDR data; and\n(c) the request has not been completely resolved.",
      "skos:definition": "(1) This rule applies if:\n(a) a CDR representative principal has made a consumer data request to an\naccredited data recipient on behalf of a CDR representative, based on a\ncollection consent given under this Division relating to particular CDR data\nand that accredited data recipient; and\n(b) the accredited data recipient has an AP disclosure consent relating to that\nCDR data; and\n(c) the request has not been completely resolved.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-67-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-67-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-67-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a74d5a63cc9a0524d1f503c64f93664762dbf33069422042bb537c62543b18ad",
      "skos:note": "Notification required if collection consent or AP disclosure consent expires"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-67",
      "@type": "cof:Section",
      "cof:title": "4 20R  Notification if collection consent or AP disclosure consent expires",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "(1) This rule applies if:\n(a) a CDR representative principal has made a consumer data request to an\naccredited data recipient on behalf of a CDR representative, based on a\ncollection consent given under this Division relating to particular CDR data\nand that accredited data recipient; and\n(b) the accredited data recipient has an AP disclosure consent relating to that\nCDR data; and\n(c) the request has not been completely resolved."
    },
    {
