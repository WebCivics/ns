    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-15-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(2) 6  Disclosing consumer data in response to a consumer data request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-15-ss-2"
      },
