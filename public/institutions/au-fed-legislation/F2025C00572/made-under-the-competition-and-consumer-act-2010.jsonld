      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.43",
      "values:originalText": "Compliance with CDR representative arrangement\n(1) If an accredited person is the CDR representative principal in a CDR\nrepresentative arrangement, it must ensure that the CDR representative complies\nwith its requirements under the arrangement.",
      "skos:definition": "Compliance with CDR representative arrangement\n(1) If an accredited person is the CDR representative principal in a CDR\nrepresentative arrangement, it must ensure that the CDR representative complies\nwith its requirements under the arrangement.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-27-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-27-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3e8e1dec2812c55e788bfea15ae4ad32a77e291a6565847804760c1abfb679cd",
      "skos:note": "CDR representative must comply with requirements under the arrangement."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-27",
      "@type": "cof:Section",
      "cof:title": "1 16A  Obligations relating to CDR representative arrangements",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "Compliance with CDR representative arrangement\n(1) If an accredited person is the CDR representative principal in a CDR\nrepresentative arrangement, it must ensure that the CDR representative complies\nwith its requirements under the arrangement."
    },
