    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-92",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 1  AER and the Victorian agency may act on each other’s behalf",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-92"
