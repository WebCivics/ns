    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-23-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Data holder must provide online services.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "(a) an online service that can be used by eligible CDR consumers to make consumer data requests directly to the data holder; and (b) an online service that can be used by accredited persons to make consumer data requests, on behalf of eligible CDR consumers, to the data holder;"
    },
