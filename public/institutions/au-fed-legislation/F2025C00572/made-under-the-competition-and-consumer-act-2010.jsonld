      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits data collection if conditions are met.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) if the CDR consumer ceases to be eligible...",
      "cml:conclusionText": "...data holder must cease data collection."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:logicSummary": "Data collection is within a 12-month period after authorization.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) the end of the period of 12 months...",
      "cml:conclusionText": "...data holder must cease data collection within this period."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Data collection is until the consumer ceases eligibility or notification of consent withdrawal.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) if the data holder was notified...",
      "cml:conclusionText": "...data holder must cease data collection until these conditions are met."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "If",
      "cml:logicSummary": "Data collection is conditional on notification of consent withdrawal or end of authorization period.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) if the CDR consumer ceases to be eligible...",
      "cml:conclusionText": "...data holder must diffuse this information."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Automated classification of eligibility for data collection based on conditions.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) if the CDR consumer ceases to be eligible...",
      "cml:conclusionText": "...data holder must classify the consumer as ineligible."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-81",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 26A  Notifications of expired authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-81"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.94",
      "values:originalText": "If an authorisation to disclose particular CDR data to an accredited person is\nwithdrawn or otherwise expires, the data holder must notify the accredited\nperson in accordance with the data standards.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "If an authorisation to disclose particular CDR data to an accredited person is\nwithdrawn or otherwise expires, the data holder must notify the accredited\nperson in accordance with the data standards.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-81-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-81-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6e846869a0e5329764d0093978145ccdb24e023976559b76e2a0f8aabe2c6617",
      "skos:note": "Notify accredited person of expired authorization",
      "dc:description": "Notification in accordance with data standards"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-81",
      "@type": "cof:Section",
      "cof:title": "4 26A  Notifications of expired authorisations",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "If an authorisation to disclose particular CDR data to an accredited person is\nwithdrawn or otherwise expires, the data holder must notify the accredited\nperson in accordance with the data standards.\nNote:\nThis rule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-81-norm",
