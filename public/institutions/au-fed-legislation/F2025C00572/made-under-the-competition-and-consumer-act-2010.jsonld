        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-83-ss-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "30db06b468740aa861e7169874b2e18ad58ed90b7387b61692016d43c8b4f1c1",
      "skos:note": "Notify account holder of data request",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-83-ss-2",
      "@type": "cof:Section",
      "cof:title": "4(2) 28  Notification requirements for consumer data requests on behalf of",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(2) The data holder must, as soon as practicable, notify the account holder of that\nfact through its ordinary means of contacting the account holder.\nNote:\nThis subclause is a civil penalty provision (see rule 9.8).\n\n\nJoint accounts  Part 4A\nPreliminary  Division 4A.1\nSection 4A.1\nCompetition and Consumer (Consumer Data Right) Rules 2020"
    },
