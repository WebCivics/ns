    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 22  When surrender, revocation or suspension takes effect",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.116",
      "values:originalText": "A surrender, revocation or suspension takes effect when the fact that the\naccreditation has been surrendered, revoked or suspended is included in the\nRegister of Accredited Persons.",
      "skos:definition": "A surrender, revocation or suspension takes effect when the fact that the\naccreditation has been surrendered, revoked or suspended is included in the\nRegister of Accredited Persons.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-28-norm"
        }
      ],
      "cml:integrityHash": "97366b2caf6c91fdedb9093ac6c4e49ac12ad950133ea8452937bcbab38edf97",
      "skos:note": "Surrender, revocation or suspension takes effect when included in the Register of Accredited Persons."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-28",
      "@type": "cof:Section",
      "cof:title": "5 22  When surrender, revocation or suspension takes effect",
      "values:kind": "section",
      "cof:pageNumber": 116,
      "values:originalText": "A surrender, revocation or suspension takes effect when the fact that the\naccreditation has been surrendered, revoked or suspended is included in the\nRegister of Accredited Persons."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-28-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
