    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-1-sec-2-3-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2(2) 1  Ongoing reporting obligation on accredited persons without streamlined",
