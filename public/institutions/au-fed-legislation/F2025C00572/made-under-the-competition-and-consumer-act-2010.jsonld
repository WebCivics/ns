    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-2-sec-1-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 1  Purpose of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-2-sec-1-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.167",
      "values:originalText": "This Part sets out steps for the purposes of subsection 56EO(1) of the Act, which\nrelate to privacy safeguard 12 (see rule 7.11 and paragraph 5.12(1)(a) of these\nrules).\nNote:\nAn accredited data recipient must take the steps set out in this Schedule to protect CDR\ndata from misuse, interference and loss, and unauthorised access, modification or\ndisclosure, under subsection 56EO(1) of the Act. Subsection 56EO(1) is a civil penalty\nprovision (see section 56EU of the Act).",
      "skos:definition": "This Part sets out steps for the purposes of subsection 56EO(1) of the Act, which\nrelate to privacy safeguard 12 (see rule 7.11 and paragraph 5.12(1)(a) of these\nrules).\nNote:\nAn accredited data recipient must take the steps set out in this Schedule to protect CDR\ndata from misuse, interference and loss, and unauthorised access, modification or\ndisclosure, under subsection 56EO(1) of the Act. Subsection 56EO(1) is a civil penalty\nprovision (see section 56EU of the Act).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-2-sec-1-8-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-2-sec-1-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3dc6a93c5e5eabc7fb12d690adf2380fccf528f0c1ebc61affc92c86d04d213b",
      "skos:note": "An accredited data recipient must take steps to protect CDR data."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-2-sec-1-8",
      "@type": "cof:Section",
      "cof:title": "1 1  Purpose of Part",
      "values:kind": "section",
      "cof:pageNumber": 167,
      "values:originalText": "This Part sets out steps for the purposes of subsection 56EO(1) of the Act, which\nrelate to privacy safeguard 12 (see rule 7.11 and paragraph 5.12(1)(a) of these\nrules).\nNote:\nAn accredited data recipient must take the steps set out in this Schedule to protect CDR\ndata from misuse, interference and loss, and unauthorised access, modification or\ndisclosure, under subsection 56EO(1) of the Act. Subsection 56EO(1) is a civil penalty\nprovision (see section 56EU of the Act)."
    },
    {
