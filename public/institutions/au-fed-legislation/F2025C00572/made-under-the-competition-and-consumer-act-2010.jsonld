    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 6  Consumer data requests under Part 4 of these rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.221",
      "values:originalText": "Tranche 1 — 15 November 2022\n(2) Part 4 of these rules applies in relation to an initial retailer, except in relation to a\ncomplex request, on and from the tranche 1 date.\n(3) Part 4 of these rules applies to AEMO on and from the tranche 1 date.\nTranche 2 — 15 May 2023\n(4) Part 4 of these rules applies in relation to an initial retailer in relation to a\ncomplex request on and from the tranche 2 date.\n\nSchedule 4  Provisions relevant to the energy sector",
      "skos:definition": "Tranche 1 — 15 November 2022\n(2) Part 4 of these rules applies in relation to an initial retailer, except in relation to a\ncomplex request, on and from the tranche 1 date.\n(3) Part 4 of these rules applies to AEMO on and from the tranche 1 date.\nTranche 2 — 15 May 2023\n(4) Part 4 of these rules applies in relation to an initial retailer in relation to a\ncomplex request on and from the tranche 2 date.\n\nSchedule 4  Provisions relevant to the energy sector",
      "cml:hasPart": [
        {
