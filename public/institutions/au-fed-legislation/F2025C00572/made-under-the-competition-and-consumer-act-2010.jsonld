    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 18  CDR data deletion process",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.45",
      "values:originalText": "For these rules, the CDR data deletion process in relation to a person that holds\nCDR data that is to be deleted consists of the following steps:\n(a) delete, to the extent reasonably practicable, that CDR data and any copies\nof that CDR data;\n(b) make a record to evidence the deletion; and",
      "skos:definition": "For these rules, the CDR data deletion process in relation to a person that holds\nCDR data that is to be deleted consists of the following steps:\n(a) delete, to the extent reasonably practicable, that CDR data and any copies\nof that CDR data;\n(b) make a record to evidence the deletion; and",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-30-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-30-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1a712714b896604c961733b55bc8ffdef0711d901c99e1ad313eb7dab6e6b686",
      "skos:note": "Delete CDR data to the extent reasonably practicable."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-30",
      "@type": "cof:Section",
      "cof:title": "1 18  CDR data deletion process",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "For these rules, the CDR data deletion process in relation to a person that holds\nCDR data that is to be deleted consists of the following steps:\n(a) delete, to the extent reasonably practicable, that CDR data and any copies\nof that CDR data;\n(b) make a record to evidence the deletion; and"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-30-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
