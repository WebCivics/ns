    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 2  Meaning of required consumer data and voluntary consumer data—energy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
