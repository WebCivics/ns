    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-2-sec-1-13-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(5) 6  Step 4—Implement a formal controls assessment program",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-2-sec-1-13-ss-5"
