      "cml:operator": "MAY",
      "cml:logicSummary": "Data holder may disclose voluntary consumer data upon request.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
