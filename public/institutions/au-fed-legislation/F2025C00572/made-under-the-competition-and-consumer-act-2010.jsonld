      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-5-logic-deontic-1",
