      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to update Register",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Receiving information from CDR and Data Recipient Accreditor",
      "cml:conclusionText": "Updating the Register"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-32-logic-alleninterval-2",
