    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 6  Use of data disclosed pursuant to product data request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-2-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.53",
      "values:originalText": "A data holder that discloses CDR data in response to a product data request must\nnot impose conditions, restrictions or limitations of any kind on the use of the\ndisclosed data.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "A data holder that discloses CDR data in response to a product data request must\nnot impose conditions, restrictions or limitations of any kind on the use of the\ndisclosed data.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-9-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9aad70f5ec9aa40b25035164befc0fdce2925323e8d0f252b690ccc0ac2a7699",
      "skos:note": "No conditions or restrictions on use of disclosed data"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-2-9",
      "@type": "cof:Section",
      "cof:title": "2 6  Use of data disclosed pursuant to product data request",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "A data holder that discloses CDR data in response to a product data request must\nnot impose conditions, restrictions or limitations of any kind on the use of the\ndisclosed data.\nNote:\nThis rule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-9-norm",
