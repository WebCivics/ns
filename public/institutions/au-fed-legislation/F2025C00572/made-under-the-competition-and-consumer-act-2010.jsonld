    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A 13.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
