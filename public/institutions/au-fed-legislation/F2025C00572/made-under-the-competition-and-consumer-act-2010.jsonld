      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.79",
      "values:originalText": "Where this Subdivision would, if not for this rule, require both an affiliate and\nthe affiliate’s sponsor to give a notice to a CDR consumer, the sponsor and the\naffiliate may choose which will give the notice.",
      "skos:definition": "Where this Subdivision would, if not for this rule, require both an affiliate and\nthe affiliate’s sponsor to give a notice to a CDR consumer, the sponsor and the\naffiliate may choose which will give the notice.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-43-norm"
        }
      ],
      "cml:integrityHash": "bd758d121307eaca6dfce37495177ce93977745ae86fa3a3e58398ab9113d78d",
      "skos:note": "Sponsor and affiliate may choose which will give notice to CDR consumer."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-43",
      "@type": "cof:Section",
      "cof:title": "4 20A  Application of Subdivision to sponsor and affiliate",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "Where this Subdivision would, if not for this rule, require both an affiliate and\nthe affiliate’s sponsor to give a notice to a CDR consumer, the sponsor and the\naffiliate may choose which will give the notice."
    },
