      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(8) 23  SR data request by an accredited person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-35-ss-8"
      },
