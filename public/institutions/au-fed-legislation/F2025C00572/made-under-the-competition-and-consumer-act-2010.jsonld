    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-10-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A(3) 9  Application of Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-10-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
