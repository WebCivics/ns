      ],
      "cml:integrityHash": "94ae3daf8ccf691f78dd8a9b61b1d1fdbfe1e687f438b60a932847ebcd33f15f",
      "skos:note": "Notification requirements for consumer data requests on joint accounts",
      "dc:description": "approval notification"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-17",
      "@type": "cof:Section",
      "cof:title": "4A 14  Notification requirements for consumer data requests on joint accounts",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "(1) For this rule, an approval notification is a notice given by the data holder:\n(a) to a relevant account holder, to inform them that the requester has given,\namended or withdrawn an authorisation, or that the authorisation has\nexpired; or\n(b) to the requester, to inform them that:"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-17-norm",
      "@type": "values:Obligation",
      "cml:modality": {
