      "cml:integrityHash": "6d4627d7d9fa83426d2e6276e6670410ffe61d3551d823e0dfebb10b8531eb27",
      "skos:note": "Notice must specify direction and period of application.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-40-ss-2",
      "@type": "cof:Section",
      "cof:title": "5(2) 34  Temporary direction to refrain from processing consumer data requests",
      "values:kind": "subsection",
      "cof:pageNumber": 122,
      "values:originalText": "(2) The notice must specify:\n(a) whether the direction applies to all consumer data requests or to requests\nmade to a particular data holder or by a particular accredited person; and\n(b) the period of application."
    },
