      "cml:premiseText": "larger retailer has the meaning given by clause 8.3.",
      "cml:conclusionText": "tranche 1 (VA) date means a date specified by the Minister in a notifiable instrument made for the purposes of this definition."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-20-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "small retailer means a retailer that is not either an initial retailer or a larger retailer.",
      "cml:conclusionText": "tranche 2 date means 15 May 2023."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-20-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
