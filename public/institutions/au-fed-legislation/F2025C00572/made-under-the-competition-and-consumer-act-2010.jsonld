      "cml:logicSummary": "Specifies conditions under which CDR representative may invite amendment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
