    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-8-2-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "8(6) 1  Moving from the NBL sector to the banking sector",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-8-2-ss-6"
      },
