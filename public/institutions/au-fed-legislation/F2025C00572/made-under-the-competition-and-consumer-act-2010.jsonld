    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-5-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(3) 1B  Sponsored accreditation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-5-ss-3"
