    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 1  Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.54",
      "values:originalText": "This Part deals with consumer data requests that are made directly by eligible\nCDR consumers to data holders. Such requests are made using the data holder’s\ndirect request service.\nA request may be for the CDR consumer’s required consumer data, their\nvoluntary consumer data, or both.\nWhen validly requested in accordance with this Part, a data holder:\n•\nmust, subject to an exception outlined in this Part, disclose required\nconsumer data; and\n•\nmay, but is not required to, disclose voluntary consumer data.\nIn either case, the data is disclosed to the CDR consumer who made the request,\nin human-readable form and in accordance with the data standards.\nSpecial rules apply to joint accounts with 2 or more individual joint account\nholders. These are set out in Part 4A.\nA fee cannot be charged for the disclosure of required consumer data, but could\nbe charged for the disclosure of voluntary consumer data.\n\n\nConsumer data requests made by eligible CDR consumers  Part 3\nPreliminary  Division 3.1\nSection 3.2\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "This Part deals with consumer data requests that are made directly by eligible\nCDR consumers to data holders. Such requests are made using the data holder’s\ndirect request service.\nA request may be for the CDR consumer’s required consumer data, their\nvoluntary consumer data, or both.\nWhen validly requested in accordance with this Part, a data holder:\n•\nmust, subject to an exception outlined in this Part, disclose required\nconsumer data; and\n•\nmay, but is not required to, disclose voluntary consumer data.\nIn either case, the data is disclosed to the CDR consumer who made the request,\nin human-readable form and in accordance with the data standards.\nSpecial rules apply to joint accounts with 2 or more individual joint account\nholders. These are set out in Part 4A.\nA fee cannot be charged for the disclosure of required consumer data, but could\nbe charged for the disclosure of voluntary consumer data.\n\n\nConsumer data requests made by eligible CDR consumers  Part 3\nPreliminary  Division 3.1\nSection 3.2\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-4-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1bdc1124e6abf889213f066c7729ca23de49bbafb0c71c183e2ea8cdcbc6fbf2",
      "skos:note": "Data holder must disclose required consumer data upon valid request.",
      "dc:description": "required consumer data"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-4",
      "@type": "cof:Section",
      "cof:title": "3 1  Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "This Part deals with consumer data requests that are made directly by eligible\nCDR consumers to data holders. Such requests are made using the data holder’s\ndirect request service.\nA request may be for the CDR consumer’s required consumer data, their\nvoluntary consumer data, or both.\nWhen validly requested in accordance with this Part, a data holder:\n•\nmust, subject to an exception outlined in this Part, disclose required\nconsumer data; and\n•\nmay, but is not required to, disclose voluntary consumer data.\nIn either case, the data is disclosed to the CDR consumer who made the request,\nin human-readable form and in accordance with the data standards.\nSpecial rules apply to joint accounts with 2 or more individual joint account\nholders. These are set out in Part 4A.\nA fee cannot be charged for the disclosure of required consumer data, but could\nbe charged for the disclosure of voluntary consumer data.\n\n\nConsumer data requests made by eligible CDR consumers  Part 3\nPreliminary  Division 3.1\nSection 3.2\nCompetition and Consumer (Consumer Data Right) Rules 2020"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-4-norm",
