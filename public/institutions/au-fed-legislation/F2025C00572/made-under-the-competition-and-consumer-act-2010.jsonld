      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.81",
      "values:originalText": "20F(1). After the end of the period, redundant data would need to be dealt with in\naccordance with subsection 56EO(2) of the Act (privacy safeguard 12) and rules 7.12\nand 7.13.",
      "skos:definition": "20F(1). After the end of the period, redundant data would need to be dealt with in\naccordance with subsection 56EO(2) of the Act (privacy safeguard 12) and rules 7.12\nand 7.13.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-49-norm"
        }
      ],
      "cml:integrityHash": "a307b310f9e6305884426c90a30303fdb2dcccb3c7ca3dc4b6c4a379c38007b4",
      "skos:note": "Redundant data handling after the end of a period"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-49",
      "@type": "cof:Section",
      "cof:title": "4 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "20F(1). After the end of the period, redundant data would need to be dealt with in\naccordance with subsection 56EO(2) of the Act (privacy safeguard 12) and rules 7.12\nand 7.13."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-49-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
