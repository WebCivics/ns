    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(5) 10  Meaning of direct OSP, indirect OSP and related terms",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-15-ss-5"
