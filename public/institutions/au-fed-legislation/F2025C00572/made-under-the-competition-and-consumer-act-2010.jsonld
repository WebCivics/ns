    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 14  No fee for responding to or actioning correction request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.138",
      "values:originalText": "(1) A data holder must not charge a fee for responding to or actioning a request\nunder subsection 56EP(1) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).\n(2) An accredited data recipient must not charge a fee for responding to or actioning\na request under subsection 56EP(2) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "(1) A data holder must not charge a fee for responding to or actioning a request\nunder subsection 56EP(1) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).\n(2) An accredited data recipient must not charge a fee for responding to or actioning\na request under subsection 56EP(2) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-21-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-21-ss-2"
        }
      ],
      "cml:integrityHash": "9e22264abc6db2b263752c60dd2ce7eac48b4d72ee24fb189ee401f9eb031cee"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-21",
      "@type": "cof:Section",
      "cof:title": "7 14  No fee for responding to or actioning correction request",
      "values:kind": "section",
      "cof:pageNumber": 138,
      "values:originalText": "(1) A data holder must not charge a fee for responding to or actioning a request\nunder subsection 56EP(1) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8).\n(2) An accredited data recipient must not charge a fee for responding to or actioning\na request under subsection 56EP(2) of the Act.\nNote:\nThis subrule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-21-ss-1",
      "@type": "cml:Concept",
