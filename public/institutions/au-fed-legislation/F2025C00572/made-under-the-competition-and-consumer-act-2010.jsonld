      "values:originalText": "(1) This rule applies if:\n(a) an accredited person has made a consumer data request to an accredited\ndata recipient on behalf of a CDR representative, based on a collection\nconsent given under this Division relating to particular CDR data and that\naccredited data recipient; and\n(b) the accredited data recipient has an AP disclosure consent relating to that\nCDR data; and\n(c) the request has not been completely resolved.",
      "skos:definition": "(1) This rule applies if:\n(a) an accredited person has made a consumer data request to an accredited\ndata recipient on behalf of a CDR representative, based on a collection\nconsent given under this Division relating to particular CDR data and that\naccredited data recipient; and\n(b) the accredited data recipient has an AP disclosure consent relating to that\nCDR data; and\n(c) the request has not been completely resolved.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-39"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-39-ss-1-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-39-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dc0f3da56820d20c17e6afad25807eca20e7da5b878a2ac9adb72617616b1a34",
      "skos:note": "Notify accredited data recipient of expired consent."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-39-ss-1",
      "@type": "cof:Section",
      "cof:title": "4(1) 18B  Notification if collection consent or AP disclosure consent expires",
      "values:kind": "subsection",
      "cof:pageNumber": 77,
      "values:originalText": "(1) This rule applies if:\n(a) an accredited person has made a consumer data request to an accredited\ndata recipient on behalf of a CDR representative, based on a collection\nconsent given under this Division relating to particular CDR data and that\naccredited data recipient; and\n(b) the accredited data recipient has an AP disclosure consent relating to that\nCDR data; and\n(c) the request has not been completely resolved."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-39-ss-1-norm",
