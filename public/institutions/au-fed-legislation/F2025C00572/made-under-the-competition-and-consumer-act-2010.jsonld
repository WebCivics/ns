      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-26-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to inform and hear",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-26-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(3) 20  General process for suspension of accreditation or extension of suspension",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-26-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.115",
      "values:originalText": "(3) If the Accreditor suspends an accredited person’s accreditation under rule 5.17,\nthe Accreditor must notify the person, in writing, of the suspension and the\nperiod of the suspension.\nNote:\nThe decision to suspend an accredited person’s accreditation can be reviewed by the\nAdministrative Appeals Tribunal: see paragraph 9.2(b).",
      "skos:definition": "(3) If the Accreditor suspends an accredited person’s accreditation under rule 5.17,\nthe Accreditor must notify the person, in writing, of the suspension and the\nperiod of the suspension.\nNote:\nThe decision to suspend an accredited person’s accreditation can be reviewed by the\nAdministrative Appeals Tribunal: see paragraph 9.2(b).",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-26"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-26-ss-3-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-26-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fcace94fa068bd3b73347856ca48da7ac0ec774e70291ce1e07834f748c3ddad",
      "skos:note": "Accreditor must notify accredited person of suspension and period."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-26-ss-3",
      "@type": "cof:Section",
      "cof:title": "5(3) 20  General process for suspension of accreditation or extension of suspension",
      "values:kind": "subsection",
      "cof:pageNumber": 115,
      "values:originalText": "(3) If the Accreditor suspends an accredited person’s accreditation under rule 5.17,\nthe Accreditor must notify the person, in writing, of the suspension and the\nperiod of the suspension.\nNote:\nThe decision to suspend an accredited person’s accreditation can be reviewed by the\nAdministrative Appeals Tribunal: see paragraph 9.2(b)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-26-ss-3-norm",
