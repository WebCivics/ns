      },
      "cml:operator": "Recurrent",
      "cml:logicSummary": "Indicates a recurring relationship between revocation/surrender and consent expiration.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
