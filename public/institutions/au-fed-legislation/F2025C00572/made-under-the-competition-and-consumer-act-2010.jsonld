      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 27  Updating consumer dashboard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.94",
      "values:originalText": "A data holder must update a CDR consumer’s consumer dashboard as soon as\npracticable after the information required to be contained on the dashboard\nchanges.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "A data holder must update a CDR consumer’s consumer dashboard as soon as\npracticable after the information required to be contained on the dashboard\nchanges.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-82-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-82-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8bea035bc3a6e5b6792e434adaa10dc4fbf75ca10331ca1b61b437f0dcb303a5",
      "skos:note": "Update consumer dashboard upon change of required information.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-82",
      "@type": "cof:Section",
      "cof:title": "4 27  Updating consumer dashboard",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "A data holder must update a CDR consumer’s consumer dashboard as soon as\npracticable after the information required to be contained on the dashboard\nchanges.\nNote:\nThis rule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-82-norm",
