    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 20J(1)(a)―when the consent is withdrawn;",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.86",
      "values:originalText": "(b) if the consent is withdrawn in accordance with paragraph 4.20J(1)(b)―the\nearlier of the following:\n(i) when the CDR representative principal and CDR representative give\neffect to the withdrawal;\n(ii) 2 business days after the CDR representative principal or CDR\nrepresentative receive the communication;\n(c) the end of the period of 12 months after the later of the following:\n(i) the day the consent was given; or\n(ii) if the period of the consent has been amended in accordance with this\nDivision―the day the consent was last amended;\n(d) at the end of the period the CDR consumer consented to in accordance with\nrule 4.20E;\n(e) if the consent expires as a result of the operation of another provision of\nthese rules that references this paragraph—when the consent expires.\n(2) If:\n(a) a CDR representative principal is notified by a data holder, under rule",
      "skos:definition": "(b) if the consent is withdrawn in accordance with paragraph 4.20J(1)(b)―the\nearlier of the following:\n(i) when the CDR representative principal and CDR representative give\neffect to the withdrawal;\n(ii) 2 business days after the CDR representative principal or CDR\nrepresentative receive the communication;\n(c) the end of the period of 12 months after the later of the following:\n(i) the day the consent was given; or\n(ii) if the period of the consent has been amended in accordance with this\nDivision―the day the consent was last amended;\n(d) at the end of the period the CDR consumer consented to in accordance with\nrule 4.20E;\n(e) if the consent expires as a result of the operation of another provision of\nthese rules that references this paragraph—when the consent expires.\n(2) If:\n(a) a CDR representative principal is notified by a data holder, under rule",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-56-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-56-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-56-logic-deontic-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-56-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "3f054f5c96f5f51c665a4ed9966b4231f4e5a955607ce051a27b6320f7a78bb2",
      "skos:note": "Withdrawal of consent"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-56",
      "@type": "cof:Section",
      "cof:title": "4 20J(1)(a)―when the consent is withdrawn;",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "(b) if the consent is withdrawn in accordance with paragraph 4.20J(1)(b)―the\nearlier of the following:\n(i) when the CDR representative principal and CDR representative give\neffect to the withdrawal;\n(ii) 2 business days after the CDR representative principal or CDR\nrepresentative receive the communication;\n(c) the end of the period of 12 months after the later of the following:\n(i) the day the consent was given; or\n(ii) if the period of the consent has been amended in accordance with this\nDivision―the day the consent was last amended;\n(d) at the end of the period the CDR consumer consented to in accordance with\nrule 4.20E;\n(e) if the consent expires as a result of the operation of another provision of\nthese rules that references this paragraph—when the consent expires.\n(2) If:\n(a) a CDR representative principal is notified by a data holder, under rule"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-56-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
