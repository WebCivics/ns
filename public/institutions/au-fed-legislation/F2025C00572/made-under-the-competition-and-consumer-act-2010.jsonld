    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 10  Rule relating to privacy safeguard 11—quality of CDR data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-16"
