    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 10A  Rule relating to privacy safeguard 11—quality of data—CDR",
      "cml:realizedBy": {
