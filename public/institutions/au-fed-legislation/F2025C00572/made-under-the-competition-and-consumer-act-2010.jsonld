      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.214",
      "values:originalText": "On receiving an SR data request under Part 3 or Part 4 of these rules, a retailer\nmust request from AEMO, using the service mentioned in subrule 1.20(2), any\nSR data to be used in responding to the request\nNote:\nAEMO is the secondary data holder for the SR data.  This provision requires a retailer\nthat happens to be the direct holder of any AEMO data that is subject to a consumer\ndata request to ignore its data holding in responding to the request, and obtain the data\nfrom AEMO for that purpose.",
      "skos:definition": "On receiving an SR data request under Part 3 or Part 4 of these rules, a retailer\nmust request from AEMO, using the service mentioned in subrule 1.20(2), any\nSR data to be used in responding to the request\nNote:\nAEMO is the secondary data holder for the SR data.  This provision requires a retailer\nthat happens to be the direct holder of any AEMO data that is subject to a consumer\ndata request to ignore its data holding in responding to the request, and obtain the data\nfrom AEMO for that purpose.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-95-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-95-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "89fd0e3ea3a9addda1acbb55123021d2343071d3e33ac94ca1a36d2ee0da8100",
      "skos:note": "Retailer must obtain SR data from AEMO upon request.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-95",
      "@type": "cof:Section",
      "cof:title": "4 4  SR data must be obtained from AEMO",
      "values:kind": "section",
      "cof:pageNumber": 214,
      "values:originalText": "On receiving an SR data request under Part 3 or Part 4 of these rules, a retailer\nmust request from AEMO, using the service mentioned in subrule 1.20(2), any\nSR data to be used in responding to the request\nNote:\nAEMO is the secondary data holder for the SR data.  This provision requires a retailer\nthat happens to be the direct holder of any AEMO data that is subject to a consumer\ndata request to ignore its data holding in responding to the request, and obtain the data\nfrom AEMO for that purpose."
    },
    {
