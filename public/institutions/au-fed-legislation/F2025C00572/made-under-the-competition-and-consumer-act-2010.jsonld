    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A 10(4)(b) is current, unless withdrawn sooner in accordance with this",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-15"
      },
