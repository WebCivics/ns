      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 2  Applying to be an accredited person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.107",
      "values:originalText": "(1) A person may apply to the CDR Accreditor to be an accredited person.\n(2) The application must:\n(a) be in the form approved, by the CDR Accreditor, for the purposes of this\nparagraph (the approved form); and\n(aa) indicate the level of accreditation that is sought; and\n(b) include any documentation or other information required by the approved\nform; and\n(c) state:\n(i) the applicant’s addresses for service; or\n(ii) if the applicant is a foreign entity:\n(A) the applicant’s local agent; and\n(B) the local agent’s addresses for service; and\n(d) describe the sorts of goods or services using CDR data that the applicant\nintends to offer to CDR consumers if they are accredited; and\n(e) if the applicant is not a person who was specified in a designation\ninstrument (see paragraph 56AC(2)(b) of the Act)—indicate whether it is\nor expects to be the data holder of any CDR data that is specified in a\ndesignation instrument.\nNote 1:\nFor paragraph (c), see rule 1.7 for the meaning of “addresses for service”. The physical\naddress for service could be a registered office (within the meaning of the Corporations\nAct 2001).\nNote 2:\nFor paragraph (c), changes to the addresses for service must be notified in accordance\nwith paragraph 5.14(1)(c). Documents may be served on an applicant in accordance\nwith regulation 12 of the Competition and Consumer Regulations 2010 by the\nCommission, or in accordance with section 28A of the Acts Interpretation Act 1901\nand section 9 of the Electronic Transactions Act 1999.\nSubdivision 5.2.2—Consideration of application to be accredited person",
      "skos:definition": "(1) A person may apply to the CDR Accreditor to be an accredited person.\n(2) The application must:\n(a) be in the form approved, by the CDR Accreditor, for the purposes of this\nparagraph (the approved form); and\n(aa) indicate the level of accreditation that is sought; and\n(b) include any documentation or other information required by the approved\nform; and\n(c) state:\n(i) the applicant’s addresses for service; or\n(ii) if the applicant is a foreign entity:\n(A) the applicant’s local agent; and\n(B) the local agent’s addresses for service; and\n(d) describe the sorts of goods or services using CDR data that the applicant\nintends to offer to CDR consumers if they are accredited; and\n(e) if the applicant is not a person who was specified in a designation\ninstrument (see paragraph 56AC(2)(b) of the Act)—indicate whether it is\nor expects to be the data holder of any CDR data that is specified in a\ndesignation instrument.\nNote 1:\nFor paragraph (c), see rule 1.7 for the meaning of “addresses for service”. The physical\naddress for service could be a registered office (within the meaning of the Corporations\nAct 2001).\nNote 2:\nFor paragraph (c), changes to the addresses for service must be notified in accordance\nwith paragraph 5.14(1)(c). Documents may be served on an applicant in accordance\nwith regulation 12 of the Competition and Consumer Regulations 2010 by the\nCommission, or in accordance with section 28A of the Acts Interpretation Act 1901\nand section 9 of the Electronic Transactions Act 1999.\nSubdivision 5.2.2—Consideration of application to be accredited person",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-7-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-7-ss-2"
        }
      ],
      "cml:integrityHash": "876fcaeeff3507c973d1c160b26d641341fddd3918f9e5234f10b6529e1242ff"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-7",
      "@type": "cof:Section",
      "cof:title": "5 2  Applying to be an accredited person",
      "values:kind": "section",
      "cof:pageNumber": 107,
      "values:originalText": "(1) A person may apply to the CDR Accreditor to be an accredited person.\n(2) The application must:\n(a) be in the form approved, by the CDR Accreditor, for the purposes of this\nparagraph (the approved form); and\n(aa) indicate the level of accreditation that is sought; and\n(b) include any documentation or other information required by the approved\nform; and\n(c) state:\n(i) the applicant’s addresses for service; or\n(ii) if the applicant is a foreign entity:\n(A) the applicant’s local agent; and\n(B) the local agent’s addresses for service; and\n(d) describe the sorts of goods or services using CDR data that the applicant\nintends to offer to CDR consumers if they are accredited; and\n(e) if the applicant is not a person who was specified in a designation\ninstrument (see paragraph 56AC(2)(b) of the Act)—indicate whether it is\nor expects to be the data holder of any CDR data that is specified in a\ndesignation instrument.\nNote 1:\nFor paragraph (c), see rule 1.7 for the meaning of “addresses for service”. The physical\naddress for service could be a registered office (within the meaning of the Corporations\nAct 2001).\nNote 2:\nFor paragraph (c), changes to the addresses for service must be notified in accordance\nwith paragraph 5.14(1)(c). Documents may be served on an applicant in accordance\nwith regulation 12 of the Competition and Consumer Regulations 2010 by the\nCommission, or in accordance with section 28A of the Acts Interpretation Act 1901\nand section 9 of the Electronic Transactions Act 1999.\nSubdivision 5.2.2—Consideration of application to be accredited person"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-7-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(1) 2  Applying to be an accredited person",
