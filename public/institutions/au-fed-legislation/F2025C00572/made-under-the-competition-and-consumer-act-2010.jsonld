    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-26-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "8(3) 7  Authorisation to disclose CDR data before being required to do so",
      "cml:realizedBy": {
