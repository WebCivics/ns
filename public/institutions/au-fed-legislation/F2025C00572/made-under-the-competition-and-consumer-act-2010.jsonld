    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-40-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(3) 34  Temporary direction to refrain from processing consumer data requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-40-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.122",
      "values:originalText": "(3) Before, or as soon as practicable after, giving a direction, the Accreditation\nRegistrar must give the accredited person or data holder a reasonable opportunity\nto be heard in relation to the matter.",
      "skos:definition": "(3) Before, or as soon as practicable after, giving a direction, the Accreditation\nRegistrar must give the accredited person or data holder a reasonable opportunity\nto be heard in relation to the matter.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-40"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-40-ss-3-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-40-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c9111b6485f42eac85ad27848f76413598831ac6bb3fddb848674cd384fdcfde",
      "skos:note": "Accredited person or data holder must be heard before giving a direction."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-40-ss-3",
      "@type": "cof:Section",
      "cof:title": "5(3) 34  Temporary direction to refrain from processing consumer data requests",
      "values:kind": "subsection",
      "cof:pageNumber": 122,
      "values:originalText": "(3) Before, or as soon as practicable after, giving a direction, the Accreditation\nRegistrar must give the accredited person or data holder a reasonable opportunity\nto be heard in relation to the matter."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-40-ss-3-norm",
