    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-91-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(4) 20L(b):",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-91-ss-4"
      },
