      "cml:conclusionText": "The provider is an OSP of the person."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-15-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
