    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 1  Laws relevant to the management of CDR data—banking sector and NBL",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-7-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.199",
      "values:originalText": "sector\nFor paragraph (f) of the definition of “law relevant to the management of CDR\ndata” in rule 1.7 of these rules, the Australian Securities and Investments\nCommission Act 2001 is a law relevant to the management of CDR data in\nrelation to the banking sector and NBL sector.",
      "skos:definition": "sector\nFor paragraph (f) of the definition of “law relevant to the management of CDR\ndata” in rule 1.7 of these rules, the Australian Securities and Investments\nCommission Act 2001 is a law relevant to the management of CDR data in\nrelation to the banking sector and NBL sector.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-8-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-8-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-8-logic-alleninterval-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-7-8-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "92a9f73d581a0764f256b9e9c4f48e64b25e69487ead2ad6ba5e9772a0e1a9a2",
      "skos:note": "Australian Securities and Investments Commission Act 2001 is a law relevant to the management of CDR data in relation to the banking sector and NBL sector."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-7-8",
      "@type": "cof:Section",
      "cof:title": "7 1  Laws relevant to the management of CDR data—banking sector and NBL",
      "values:kind": "section",
      "cof:pageNumber": 199,
      "values:originalText": "sector\nFor paragraph (f) of the definition of “law relevant to the management of CDR\ndata” in rule 1.7 of these rules, the Australian Securities and Investments\nCommission Act 2001 is a law relevant to the management of CDR data in\nrelation to the banking sector and NBL sector."
    },
