    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 1  Laws relevant to the management of CDR data—energy sector",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-9-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.224",
      "values:originalText": "For paragraph (f) of the definition of “law relevant to the management of CDR\ndata” in rule 1.7 of these rules:\n(a) the National Electricity Law; and\n(b) the National Energy Retail Law; and\n(c) the Electricity Industry Act 2000 (Vic);\nare laws relevant to the management of CDR data in relation to the energy sector.",
      "skos:definition": "For paragraph (f) of the definition of “law relevant to the management of CDR\ndata” in rule 1.7 of these rules:\n(a) the National Electricity Law; and\n(b) the National Energy Retail Law; and\n(c) the Electricity Industry Act 2000 (Vic);\nare laws relevant to the management of CDR data in relation to the energy sector.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-15-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-15-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-15-logic-deontic-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-15-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "3332f4b69232ea013c2f9e8ce7d89af1bba3b3b15c13acd84d481d375543c1db",
      "skos:note": "Laws relevant to CDR data management in the energy sector"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-9-15",
      "@type": "cof:Section",
      "cof:title": "9 1  Laws relevant to the management of CDR data—energy sector",
      "values:kind": "section",
      "cof:pageNumber": 224,
      "values:originalText": "For paragraph (f) of the definition of “law relevant to the management of CDR\ndata” in rule 1.7 of these rules:\n(a) the National Electricity Law; and\n(b) the National Energy Retail Law; and\n(c) the Electricity Industry Act 2000 (Vic);\nare laws relevant to the management of CDR data in relation to the energy sector."
    },
