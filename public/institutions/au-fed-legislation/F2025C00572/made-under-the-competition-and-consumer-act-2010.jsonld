      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.48",
      "values:originalText": "(8) Subrule 4.6(4) does not apply in relation to SR data that the secondary data\nholder has refused to disclose to the primary data holder.",
      "skos:definition": "(8) Subrule 4.6(4) does not apply in relation to SR data that the secondary data\nholder has refused to disclose to the primary data holder.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35"
      },
      "cml:asserts": [
