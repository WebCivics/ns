    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-6-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 2  Requirement for data holders—external resolution",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-6-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.123",
      "values:originalText": "A data holder must meet the external dispute resolution requirements for each\ndesignated sector in which the data the holder operates.\nNote 1:\nSee the definition of “recognised external dispute resolution scheme” in subrule 1.7(1),\nand see subrule 1.7(3) for the interpretation of references to “data holder”.\nNote 2:\nAn accredited person must also meet the external dispute resolution requirements: see\nparagraph 5.12(1)(c). See also:\n•\nfor the banking sector and non-bank lenders sector—clause 5.2 of Schedule 3;\n•\nfor the energy sector—clause 5.2 of Schedule 4.\nNote 3:\nThis rule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "A data holder must meet the external dispute resolution requirements for each\ndesignated sector in which the data the holder operates.\nNote 1:\nSee the definition of “recognised external dispute resolution scheme” in subrule 1.7(1),\nand see subrule 1.7(3) for the interpretation of references to “data holder”.\nNote 2:\nAn accredited person must also meet the external dispute resolution requirements: see\nparagraph 5.12(1)(c). See also:\n•\nfor the banking sector and non-bank lenders sector—clause 5.2 of Schedule 3;\n•\nfor the energy sector—clause 5.2 of Schedule 4.\nNote 3:\nThis rule is a civil penalty provision (see rule 9.8).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-6-3-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-6-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1b0b0dd5373d9b9556c28bc123d043a31c43702795475c5fdda2c644fff8fcb3",
      "skos:note": "Data holder must meet external dispute resolution requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-6-3",
      "@type": "cof:Section",
      "cof:title": "6 2  Requirement for data holders—external resolution",
      "values:kind": "section",
      "cof:pageNumber": 123,
      "values:originalText": "A data holder must meet the external dispute resolution requirements for each\ndesignated sector in which the data the holder operates.\nNote 1:\nSee the definition of “recognised external dispute resolution scheme” in subrule 1.7(1),\nand see subrule 1.7(3) for the interpretation of references to “data holder”.\nNote 2:\nAn accredited person must also meet the external dispute resolution requirements: see\nparagraph 5.12(1)(c). See also:\n•\nfor the banking sector and non-bank lenders sector—clause 5.2 of Schedule 3;\n•\nfor the energy sector—clause 5.2 of Schedule 4.\nNote 3:\nThis rule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-6-3-norm",
