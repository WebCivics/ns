      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.93",
      "values:originalText": "(c) if the CDR consumer ceases to be eligible in relation to the data holder;\n(d) if the data holder was notified, under rule 4.18AA or 4.20P, of the\nwithdrawal of a consent to collect that CDR data―when the data holder\nreceived that notification;\n(e) the end of the period of 12 months after the authorisation was given;",
      "skos:definition": "(c) if the CDR consumer ceases to be eligible in relation to the data holder;\n(d) if the data holder was notified, under rule 4.18AA or 4.20P, of the\nwithdrawal of a consent to collect that CDR data―when the data holder\nreceived that notification;\n(e) the end of the period of 12 months after the authorisation was given;",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-alleninterval-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-ltl-3"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-diffusion-4"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "e8526f2f9fbcca69218c7bffee9e9c7f35d9fec75c4bf796e3869bef5129ec7e",
      "skos:note": "Cease eligibility for data collection if notified of consent withdrawal or end of authorization period."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-80",
      "@type": "cof:Section",
      "cof:title": "4 25(1)(a)―when the authorisation was withdrawn;",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "(c) if the CDR consumer ceases to be eligible in relation to the data holder;\n(d) if the data holder was notified, under rule 4.18AA or 4.20P, of the\nwithdrawal of a consent to collect that CDR data―when the data holder\nreceived that notification;\n(e) the end of the period of 12 months after the authorisation was given;"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-80-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
