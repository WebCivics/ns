    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 7  Rule relating to privacy safeguard 6—use or disclosure of CDR by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.133",
      "values:originalText": "accredited data recipients\nNote:\nParagraph 56EI(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or\ndisclose it unless the use or disclosure is otherwise required, or authorised, under the consumer data\nrules. This rule provides an authorisation for that paragraph.\nSection 56EI of the Act applies only in relation to CDR data for which there are one or more CDR\nconsumers: subsection 56EB(1) of the Act.\nFor paragraph 56EI(1)(b) of the Act, the use or disclosure of CDR data for which\nthere is a CDR consumer by an accredited data recipient of the CDR data is\nauthorised under these rules if it is a permitted use or disclosure, other than one\nthat relates to direct marketing.",
      "skos:definition": "accredited data recipients\nNote:\nParagraph 56EI(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or\ndisclose it unless the use or disclosure is otherwise required, or authorised, under the consumer data\nrules. This rule provides an authorisation for that paragraph.\nSection 56EI of the Act applies only in relation to CDR data for which there are one or more CDR\nconsumers: subsection 56EB(1) of the Act.\nFor paragraph 56EI(1)(b) of the Act, the use or disclosure of CDR data for which\nthere is a CDR consumer by an accredited data recipient of the CDR data is\nauthorised under these rules if it is a permitted use or disclosure, other than one\nthat relates to direct marketing.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-alleninterval-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-ltl-3"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-diffusion-4"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "331f25fbd9d505c22d80e80ead68c13a3ab334993f6d8e2a11af5612c08cc33f",
      "skos:note": "Use or disclosure of CDR by accredited data recipients is permitted, subject to certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-11",
      "@type": "cof:Section",
      "cof:title": "7 7  Rule relating to privacy safeguard 6—use or disclosure of CDR by",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "accredited data recipients\nNote:\nParagraph 56EI(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or\ndisclose it unless the use or disclosure is otherwise required, or authorised, under the consumer data\nrules. This rule provides an authorisation for that paragraph.\nSection 56EI of the Act applies only in relation to CDR data for which there are one or more CDR\nconsumers: subsection 56EB(1) of the Act.\nFor paragraph 56EI(1)(b) of the Act, the use or disclosure of CDR data for which\nthere is a CDR consumer by an accredited data recipient of the CDR data is\nauthorised under these rules if it is a permitted use or disclosure, other than one\nthat relates to direct marketing."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Permission granted for use or disclosure of CDR by accredited data recipients.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 56EI(1)(b) of the Act provides that an accredited data recipient of CDR data must not use or disclose it unless...",
      "cml:conclusionText": "Use or disclosure is permitted under these rules if it is a permitted use or disclosure, other than one that relates to direct marketing."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Use or disclosure must occur within the same temporal interval as the CDR consumer.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "For paragraph 56EI(1)(b) of the Act, the use or disclosure of CDR data for which there is a CDR consumer by an accredited data recipient of the CDR data is authorized under these rules if it is a permitted use or disclosure...",
      "cml:conclusionText": "Use or disclosure must occur within the same temporal interval as the CDR consumer."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
