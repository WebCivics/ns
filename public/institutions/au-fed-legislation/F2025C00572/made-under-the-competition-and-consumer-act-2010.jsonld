      },
      "cml:premiseText": "(a) an accredited person makes a consumer data request under this Part on behalf of a secondary user for a particular account; and (b) the secondary user amends or withdraws an authorisation, or an authorisation given by the secondary user expires.",
      "cml:conclusionText": "Notification must occur between when the request is made and when the authorisation expires or is amended."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-83-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Notification must occur within a specific time frame.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an accredited person makes a consumer data request under this Part on behalf of a secondary user for a particular account; and (b) the secondary user amends or withdraws an authorisation, or an authorisation given by the secondary user expires.",
      "cml:conclusionText": "Notification must occur within a specific time frame."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-83-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Accredited person must notify secondary user of data request on their behalf.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an accredited person makes a consumer data request under this Part on behalf of a secondary user for a particular account; and (b) the secondary user amends or withdraws an authorisation, or an authorisation given by the secondary user expires.",
      "cml:conclusionText": "This rule applies if: (a) an accredited person makes a consumer data request under this Part on behalf of a secondary user for a particular account; and (b) the secondary user amends or withdraws an authorisation, or an authorisation given by the secondary user expires."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-83-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Notification is implied when a request is made on behalf of a secondary user.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an accredited person makes a consumer data request under this Part on behalf of a secondary user for a particular account; and (b) the secondary user amends or withdraws an authorisation, or an authorisation given by the secondary user expires.",
      "cml:conclusionText": "If an accredited person makes a consumer data request under this Part on behalf of a secondary user for a particular account, then they must notify the secondary user."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-83-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(2) 28  Notification requirements for consumer data requests on behalf of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-83-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.94",
      "values:originalText": "(2) The data holder must, as soon as practicable, notify the account holder of that\nfact through its ordinary means of contacting the account holder.\nNote:\nThis subclause is a civil penalty provision (see rule 9.8).\n\n\nJoint accounts  Part 4A\nPreliminary  Division 4A.1\nSection 4A.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "(2) The data holder must, as soon as practicable, notify the account holder of that\nfact through its ordinary means of contacting the account holder.\nNote:\nThis subclause is a civil penalty provision (see rule 9.8).\n\n\nJoint accounts  Part 4A\nPreliminary  Division 4A.1\nSection 4A.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "values:partOf": {
