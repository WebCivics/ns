      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits certain actions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) The service must not do any of the following...",
      "cml:conclusionText": "...so as to reduce comprehensibility;"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-7-ss-6-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits offering pre-selected options.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
