      ],
      "cml:integrityHash": "1a6f515982d8497ce9a2ad310c08c2c1c28d8a9ba1c85e865d8d3f14fea5ab26",
      "skos:note": "Must provide a unique accreditation number to an accredited applicant.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-12",
      "@type": "cof:Section",
      "cof:title": "5 6  Accreditation decision—accreditation number",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "The CDR Accreditor must, if it accredits an accreditation applicant, give the\napplicant a unique number by which it may be identified as an accredited person\n(their accreditation number)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-12-norm",
