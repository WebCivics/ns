      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Allows CDR representative to request disclosure consent.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
