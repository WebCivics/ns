        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The accredited person was, at the time of accreditation, a retailer.",
      "cml:conclusionText": "The accredited person is a retailer at the time of accreditation."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The suspension or revocation of authorisation or licence occurs after the accreditation.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
