    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 20O  CDR receipts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.88",
      "values:originalText": "A CDR representative must give the CDR consumer a notice that complies with\nthe data standards as soon as practicable after:\n(a) the CDR consumer gives the CDR representative a collection consent, a\nuse consent or a disclosure consent; or\n(b) the CDR consumer amends such a consent in accordance with this\nDivision; or\n(c) the CDR consumer withdraws such a consent in accordance with rule",
      "skos:definition": "A CDR representative must give the CDR consumer a notice that complies with\nthe data standards as soon as practicable after:\n(a) the CDR consumer gives the CDR representative a collection consent, a\nuse consent or a disclosure consent; or\n(b) the CDR consumer amends such a consent in accordance with this\nDivision; or\n(c) the CDR consumer withdraws such a consent in accordance with rule",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-63-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-63-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b904b4022cf3a5578d72f806beef335274f61f308b503607b47453b52b6b8d2c",
      "skos:note": "Notice must be given to CDR consumer upon consent amendment or withdrawal",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-63",
      "@type": "cof:Section",
      "cof:title": "4 20O  CDR receipts",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "A CDR representative must give the CDR consumer a notice that complies with\nthe data standards as soon as practicable after:\n(a) the CDR consumer gives the CDR representative a collection consent, a\nuse consent or a disclosure consent; or\n(b) the CDR consumer amends such a consent in accordance with this\nDivision; or\n(c) the CDR consumer withdraws such a consent in accordance with rule"
    },
