    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-29-ss-3",
      "@type": "cof:Section",
      "cof:title": "1(3) 17A  Identification of otherwise redundant data that is not to be deleted",
      "values:kind": "subsection",
      "cof:pageNumber": 45,
      "values:originalText": "(3) For the purposes of paragraph 56BAA(2)(c) of the Act, in relation to CDR data\nof a CDR consumer, the person may:\n(a) request the CDR consumer to state whether or not proceedings of the kind\nmentioned in that paragraph are current or anticipated; and\n(b) rely on that statement."
    },
