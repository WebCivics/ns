      "cml:premiseText": "The accredited person was, at the time of accreditation, a retailer.",
      "cml:conclusionText": "If its authorisation or licence to sell electricity in the National Electricity Market has been suspended or revoked, the accredited person ceases to satisfy the condition."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "The accredited person is a retailer at the time of accreditation.",
      "cml:executionSurface": "modalities::dl",
