    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-2-5-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
