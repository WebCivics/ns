    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 5  Termination of appointment and resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.141",
      "values:originalText": "(1) The Data Standards Chair may, by writing, terminate an appointment to a Data\nStandards Advisory Committee at any time.\n(2) An appointee to a Committee may resign his or her appointment by giving the\nChair a written resignation.\n(3) The resignation takes effect on the day it is received by the Chair or, if a later\nday is specified in the resignation, on that later day.",
      "skos:definition": "(1) The Data Standards Chair may, by writing, terminate an appointment to a Data\nStandards Advisory Committee at any time.\n(2) An appointee to a Committee may resign his or her appointment by giving the\nChair a written resignation.\n(3) The resignation takes effect on the day it is received by the Chair or, if a later\nday is specified in the resignation, on that later day.",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12-ss-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-12-ss-3"
        }
      ],
      "cml:integrityHash": "a607ec43127b5c738b001b702d5d5cb90a7f6fb6928231117bd9921c1125223d"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-12",
      "@type": "cof:Section",
      "cof:title": "8 5  Termination of appointment and resignation",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "(1) The Data Standards Chair may, by writing, terminate an appointment to a Data\nStandards Advisory Committee at any time.\n(2) An appointee to a Committee may resign his or her appointment by giving the\nChair a written resignation.\n(3) The resignation takes effect on the day it is received by the Chair or, if a later\nday is specified in the resignation, on that later day."
    },
