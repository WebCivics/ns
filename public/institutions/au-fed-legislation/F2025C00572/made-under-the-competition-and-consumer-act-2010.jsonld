    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A 15  Avoidance of harm",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.104",
      "values:originalText": "A data holder is not liable under these rules for a failure to comply with this Part\nif it considered that the relevant act or omission was necessary in order to\nprevent physical, psychological or financial harm or abuse to any person.\n\n\nRules relating to accreditation etc.  Part 5\nPreliminary  Division 5.1\nSection 5.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "A data holder is not liable under these rules for a failure to comply with this Part\nif it considered that the relevant act or omission was necessary in order to\nprevent physical, psychological or financial harm or abuse to any person.\n\n\nRules relating to accreditation etc.  Part 5\nPreliminary  Division 5.1\nSection 5.1\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-19-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9cf2918bad1f746fc878d6771f160442f06272476f80df06e0ddc8ebf7c08e16",
      "skos:note": "Data holder not liable for failure to comply if necessary to prevent harm."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-19",
      "@type": "cof:Section",
      "cof:title": "4A 15  Avoidance of harm",
      "values:kind": "section",
      "cof:pageNumber": 104,
      "values:originalText": "A data holder is not liable under these rules for a failure to comply with this Part\nif it considered that the relevant act or omission was necessary in order to\nprevent physical, psychological or financial harm or abuse to any person.\n\n\nRules relating to accreditation etc.  Part 5\nPreliminary  Division 5.1\nSection 5.1\nCompetition and Consumer (Consumer Data Right) Rules 2020"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-19-norm",
