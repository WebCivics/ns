    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate",
      "cml:logicSummary": "Defines who is the requester and relevant account holders in a joint account for consumer data requests.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-4-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Defines a class hierarchy",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The requester is the person on whose behalf the consumer data request was made.",
      "cml:conclusionText": "The requester is a joint account holder or secondary user."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-4-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Defines a subclass relationship",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The relevant account holders are all joint account holders if the requester is a secondary user.",
      "cml:conclusionText": "The other joint account holders are relevant account holders."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-4-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Defines an attribute",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CDR data that can be requested on behalf of a CDR consumer is governed by the relevant general provisions in the sector Schedules.",
      "cml:conclusionText": "The joint account data is the CDR data relating to the joint account that was the subject of the request."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A 4  Simplified outline of this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.97",
      "values:originalText": "This Division sets out the disclosure options that can apply to a joint account.\nThese disclosure options are relevant when an accredited person makes a\nconsumer data request on behalf of one joint account holder or a secondary user\nunder Part 4.\nThe default option is the pre-approval option. If this option applies, when the\ndata holder receives a consumer data request, the other account holders are\ntreated as having approved disclosing the data relating to the joint account in\nresponse to that request.  However, the other account holders can withdraw this\npresumed approval in relation to that request at any time.\nAnother option is the non-disclosure option. If this option applies, joint account\ndata cannot be disclosed under these rules.\nThe third option is the co-approval option. If this option applies, joint account\ndata can be disclosed under these rules only with the approval of all the account\nholders.\nData holders must offer the pre-approval option and non-disclosure option on\njoint accounts, and may offer the co-approval option.\nThe process for changing the disclosure option is set out in this Division.\nFor each joint account, a data holder must offer a disclosure option management\nservice that can be used by joint account holders to select and manage these\ndisclosure options.\nHowever, the data holder will not be liable for a failure to comply with this Part\nif it considered that the relevant act or omission was necessary in order to\nprevent physical, psychological or financial harm or abuse to any person.",
      "skos:definition": "This Division sets out the disclosure options that can apply to a joint account.\nThese disclosure options are relevant when an accredited person makes a\nconsumer data request on behalf of one joint account holder or a secondary user\nunder Part 4.\nThe default option is the pre-approval option. If this option applies, when the\ndata holder receives a consumer data request, the other account holders are\ntreated as having approved disclosing the data relating to the joint account in\nresponse to that request.  However, the other account holders can withdraw this\npresumed approval in relation to that request at any time.\nAnother option is the non-disclosure option. If this option applies, joint account\ndata cannot be disclosed under these rules.\nThe third option is the co-approval option. If this option applies, joint account\ndata can be disclosed under these rules only with the approval of all the account\nholders.\nData holders must offer the pre-approval option and non-disclosure option on\njoint accounts, and may offer the co-approval option.\nThe process for changing the disclosure option is set out in this Division.\nFor each joint account, a data holder must offer a disclosure option management\nservice that can be used by joint account holders to select and manage these\ndisclosure options.\nHowever, the data holder will not be liable for a failure to comply with this Part\nif it considered that the relevant act or omission was necessary in order to\nprevent physical, psychological or financial harm or abuse to any person.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-5-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b44332d7a24eb22ff336f3e0c88a66b3b0b0e9a560575f79f6bfa53c6d23f8b8",
      "skos:note": "Data holder must offer disclosure options to joint account holders.",
      "dc:description": "Disclosure option management service"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-5",
      "@type": "cof:Section",
      "cof:title": "4A 4  Simplified outline of this Division",
      "values:kind": "section",
      "cof:pageNumber": 97,
      "values:originalText": "This Division sets out the disclosure options that can apply to a joint account.\nThese disclosure options are relevant when an accredited person makes a\nconsumer data request on behalf of one joint account holder or a secondary user\nunder Part 4.\nThe default option is the pre-approval option. If this option applies, when the\ndata holder receives a consumer data request, the other account holders are\ntreated as having approved disclosing the data relating to the joint account in\nresponse to that request.  However, the other account holders can withdraw this\npresumed approval in relation to that request at any time.\nAnother option is the non-disclosure option. If this option applies, joint account\ndata cannot be disclosed under these rules.\nThe third option is the co-approval option. If this option applies, joint account\ndata can be disclosed under these rules only with the approval of all the account\nholders.\nData holders must offer the pre-approval option and non-disclosure option on\njoint accounts, and may offer the co-approval option.\nThe process for changing the disclosure option is set out in this Division.\nFor each joint account, a data holder must offer a disclosure option management\nservice that can be used by joint account holders to select and manage these\ndisclosure options.\nHowever, the data holder will not be liable for a failure to comply with this Part\nif it considered that the relevant act or omission was necessary in order to\nprevent physical, psychological or financial harm or abuse to any person."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
