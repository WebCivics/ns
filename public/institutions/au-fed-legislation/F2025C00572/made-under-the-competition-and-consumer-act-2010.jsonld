      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.118",
      "values:originalText": "(4) Subrule (5) applies if a data holder or an accredited person:\n(a) has provided information to the Accreditation Registrar in accordance with\nthis rule; and\n(b) becomes aware that the information:\n(i) is out of date; or\n(ii) needs to be amended in order for product data requests and consumer\ndata requests made under these rules to be processed in accordance\nwith these rules and the data standards.",
      "skos:definition": "(4) Subrule (5) applies if a data holder or an accredited person:\n(a) has provided information to the Accreditation Registrar in accordance with\nthis rule; and\n(b) becomes aware that the information:\n(i) is out of date; or\n(ii) needs to be amended in order for product data requests and consumer\ndata requests made under these rules to be processed in accordance\nwith these rules and the data standards.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-31"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-31-ss-4-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-31-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ab28ee75e8161cdf8e8c1c04c37829a0e89271916fce46510c073b19148fe779",
      "skos:note": "Data holder or accredited person must update information if it is out of date or needs to be amended.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-31-ss-4",
      "@type": "cof:Section",
      "cof:title": "5(4) 25  Other information to be kept in association with Register of Accredited",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(4) Subrule (5) applies if a data holder or an accredited person:\n(a) has provided information to the Accreditation Registrar in accordance with\nthis rule; and\n(b) becomes aware that the information:\n(i) is out of date; or\n(ii) needs to be amended in order for product data requests and consumer\ndata requests made under these rules to be processed in accordance\nwith these rules and the data standards."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-31-ss-4-norm",
