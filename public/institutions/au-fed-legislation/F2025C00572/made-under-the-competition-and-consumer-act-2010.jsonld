      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 28  Making information available to the Commission, the Information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.120",
      "values:originalText": "Commissioner and the Data Recipient Accreditor\nThe Accreditation Registrar must make available to the Commission, the\nInformation Commissioner and the CDR Accreditor, on request:\n(a) all or part of the Register of Accredited Persons or the associated database;\nor\n(b) specified information in the Register or the associated database; or\n(c) any information held by the Registrar in relation to the Register or the\nassociated database.",
      "skos:definition": "Commissioner and the Data Recipient Accreditor\nThe Accreditation Registrar must make available to the Commission, the\nInformation Commissioner and the CDR Accreditor, on request:\n(a) all or part of the Register of Accredited Persons or the associated database;\nor\n(b) specified information in the Register or the associated database; or\n(c) any information held by the Registrar in relation to the Register or the\nassociated database.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-34-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "13d120fa57e62db5fcd7ea98ce3ead0ba9ef43be757d413eb38c77bf60bfcef7",
      "skos:note": "Must provide information to the Commission, Information Commissioner, and CDR Accreditor on request.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-34",
      "@type": "cof:Section",
      "cof:title": "5 28  Making information available to the Commission, the Information",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "Commissioner and the Data Recipient Accreditor\nThe Accreditation Registrar must make available to the Commission, the\nInformation Commissioner and the CDR Accreditor, on request:\n(a) all or part of the Register of Accredited Persons or the associated database;\nor\n(b) specified information in the Register or the associated database; or\n(c) any information held by the Registrar in relation to the Register or the\nassociated database."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-34-norm",
