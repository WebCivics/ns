    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-60",
      "@type": "cof:Section",
      "cof:title": "4 20M, to have the de-identified data deleted once it becomes redundant",
      "values:kind": "section",
