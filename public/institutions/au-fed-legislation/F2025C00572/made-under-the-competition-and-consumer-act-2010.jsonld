    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 18  CDR receipts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.76",
      "values:originalText": "An accredited person must give the CDR consumer a notice that complies with\nthe data standards as soon as practicable after the CDR consumer:\n(a) gives the accredited person a collection consent, use consent or disclosure\nconsent; or\n(b) amends a collection consent, use consent or disclosure consent given to an\naccredited person in accordance with this Division; or\n(c) withdraws a collection consent, use consent or disclosure consent given to\nan accredited person in accordance with rule 4.13.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "skos:definition": "An accredited person must give the CDR consumer a notice that complies with\nthe data standards as soon as practicable after the CDR consumer:\n(a) gives the accredited person a collection consent, use consent or disclosure\nconsent; or\n(b) amends a collection consent, use consent or disclosure consent given to an\naccredited person in accordance with this Division; or\n(c) withdraws a collection consent, use consent or disclosure consent given to\nan accredited person in accordance with rule 4.13.\nNote:\nThis rule is a civil penalty provision (see rule 9.8).",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-36-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "982cb843d347f3d7ae5481292c411a0679af0fb9f0fe54e31144bf09594c27be",
      "skos:note": "Accredited person must notify CDR consumer of changes to consent.",
      "dc:description": "Notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-36",
      "@type": "cof:Section",
      "cof:title": "4 18  CDR receipts",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "An accredited person must give the CDR consumer a notice that complies with\nthe data standards as soon as practicable after the CDR consumer:\n(a) gives the accredited person a collection consent, use consent or disclosure\nconsent; or\n(b) amends a collection consent, use consent or disclosure consent given to an\naccredited person in accordance with this Division; or\n(c) withdraws a collection consent, use consent or disclosure consent given to\nan accredited person in accordance with rule 4.13.\nNote:\nThis rule is a civil penalty provision (see rule 9.8)."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-36-norm",
      "@type": "values:Obligation",
