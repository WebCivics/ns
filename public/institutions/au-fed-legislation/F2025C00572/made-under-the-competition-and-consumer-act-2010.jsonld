    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 12A  Amendment of consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-26"
      },
