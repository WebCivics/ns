      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-3-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f995663cb2f0036bc76c3277470d04b839057f4bcef523f70c27dd01e0f6412e",
      "skos:note": "Collection consent expires upon notification of withdrawn consent."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-31-ss-3",
      "@type": "cof:Section",
      "cof:title": "4(3) 13(1)(a)―when the consent was withdrawn;",
      "values:kind": "subsection",
      "cof:pageNumber": 74,
      "values:originalText": "(3) If:\n(a) an accredited person is notified by a data holder, under rule 4.26A, of the\nwithdrawal of an authorisation to disclose CDR data that relates to a\ncollection consent given under this Division; and\n(b) the collection consent has not expired in accordance with subrule (1);\nthe collection consent expires when the accredited person receives that\nnotification.\nNote:\nThis would not result in the use consent relating to any CDR data that had already been\ncollected expiring. However, see the notification requirement of rule 4.18A."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits collection consent expiration upon notification.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) If:\n(a) an accredited person is notified by a data holder, under rule 4.26A, of the\nwithdrawal of an authorisation to disclose CDR data that relates to a\ncollection consent given under this Division; and\n(b) the collection consent has not expired in accordance with subrule (1);\nthe collection consent expires when the accredited person receives that\nnotification.",
      "cml:conclusionText": "(3) If:\n(a) an accredited person is notified by a data holder, under rule 4.26A, of the\ndefaulted consent; and\n(b) the consent has not expired in accordance with subrule (1);\nthe consent expires when the accredited person receives that notification."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-31-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(4) 13(1)(a)―when the consent was withdrawn;",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-31-ss-4"
