          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-8-2-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8388e071d8763a36a4d27dcd7e922a74b7cf144e47f20472b6038658bf38de2a",
      "skos:note": "Notify accredited persons of data holder's sector change",
