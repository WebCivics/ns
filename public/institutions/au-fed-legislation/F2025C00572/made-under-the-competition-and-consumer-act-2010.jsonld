      },
      "cml:premiseText": "(6) The service must not do any of the following...",
      "cml:conclusionText": "...offer any pre-selected options."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-7-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "4A(7) 6  Obligation to provide disclosure option management service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-7-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.98",
      "values:originalText": "(7) The service must indicate to the joint account holder which disclosure option\ncurrently applies.",
      "skos:definition": "(7) The service must indicate to the joint account holder which disclosure option\ncurrently applies.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-7"
      },
      "cml:asserts": [
