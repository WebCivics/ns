        }
      ],
      "cml:integrityHash": "a3a95eadacf061a3b19ab8cd71178f6f86f5de2aa74d8f45687863c1156fc2ba",
      "skos:note": "Provide English translation of records upon request",
      "dc:description": "Yes"
    },
    {
