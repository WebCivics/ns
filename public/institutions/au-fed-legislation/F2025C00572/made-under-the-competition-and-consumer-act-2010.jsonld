    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-86",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 20K(2); and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-86"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.117",
      "values:originalText": "-\nany authorisations to disclose CDR data expire: see subrule 4.26(2); and\n•\nif an accreditation is suspended, the accredited person is not able to collect data\nwhile the suspension is in effect.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\n(5) For the purposes of paragraph (4)(e), if paragraphs (4)(a) to (d) apply in relation\nto the CDR data of the CDR consumer, the person may:\n(a) request the CDR consumer to state whether or not such proceedings are\ncurrent or anticipated; and\n(b) rely on that statement.",
      "skos:definition": "-\nany authorisations to disclose CDR data expire: see subrule 4.26(2); and\n•\nif an accreditation is suspended, the accredited person is not able to collect data\nwhile the suspension is in effect.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\n(5) For the purposes of paragraph (4)(e), if paragraphs (4)(a) to (d) apply in relation\nto the CDR data of the CDR consumer, the person may:\n(a) request the CDR consumer to state whether or not such proceedings are\ncurrent or anticipated; and\n(b) rely on that statement.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-86-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-86-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "83d137d8bcc6700efb3c2d9fd8db6e0701a951f99c4e553db00c667f780ddd93",
      "skos:note": "Disclosing CDR data without authorization is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-86",
      "@type": "cof:Section",
      "cof:title": "4 20K(2); and",
      "values:kind": "section",
      "cof:pageNumber": 117,
      "values:originalText": "-\nany authorisations to disclose CDR data expire: see subrule 4.26(2); and\n•\nif an accreditation is suspended, the accredited person is not able to collect data\nwhile the suspension is in effect.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\n(5) For the purposes of paragraph (4)(e), if paragraphs (4)(a) to (d) apply in relation\nto the CDR data of the CDR consumer, the person may:\n(a) request the CDR consumer to state whether or not such proceedings are\ncurrent or anticipated; and\n(b) rely on that statement."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-86-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-86"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
