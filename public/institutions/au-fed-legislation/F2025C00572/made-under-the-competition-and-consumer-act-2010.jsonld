    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-10-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(4) Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-10-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
