      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.182",
      "values:originalText": "(2) A covered product will cease to be a trial product from the first time any of the\nfollowing occurs:\n(a) the product is supplied or offered after the end of the trial period;\n(b) the product begins to be supplied to more than 1,000 customers.\n\nSchedule 3  Provisions relevant to the banking and non-bank lenders sectors",
      "skos:definition": "(2) A covered product will cease to be a trial product from the first time any of the\nfollowing occurs:\n(a) the product is supplied or offered after the end of the trial period;\n(b) the product begins to be supplied to more than 1,000 customers.\n\nSchedule 3  Provisions relevant to the banking and non-bank lenders sectors",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-1-12"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-1-12-ss-2-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-1-12-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ad96baecb32cccce5242ddea11ca8fc2154d0016fb30a2cbc77e84b499b92670",
      "skos:note": "Product ceases to be trial product under specified conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-1-12-ss-2",
      "@type": "cof:Section",
      "cof:title": "1(2) 5  Meaning of trial product",
      "values:kind": "subsection",
      "cof:pageNumber": 182,
      "values:originalText": "(2) A covered product will cease to be a trial product from the first time any of the\nfollowing occurs:\n(a) the product is supplied or offered after the end of the trial period;\n(b) the product begins to be supplied to more than 1,000 customers.\n\nSchedule 3  Provisions relevant to the banking and non-bank lenders sectors"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-1-12-ss-2-norm",
