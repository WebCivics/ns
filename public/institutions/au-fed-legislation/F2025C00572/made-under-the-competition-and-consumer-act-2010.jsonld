      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.48",
      "values:originalText": "(7) Subject to subrule (8), rule 4.6 (disclosing consumer data in response to a\nconsumer data request) applies as if the primary data holder were the data holder\nfor any SR data covered by the SR data request.",
      "skos:definition": "(7) Subject to subrule (8), rule 4.6 (disclosing consumer data in response to a\nconsumer data request) applies as if the primary data holder were the data holder\nfor any SR data covered by the SR data request.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35"
