      },
      "cml:premiseText": "Retailer collects non-energy sector CDR data",
      "cml:conclusionText": "Retailer must not collect non-energy sector CDR data"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-43-ss-4-logic-deontic-5",
