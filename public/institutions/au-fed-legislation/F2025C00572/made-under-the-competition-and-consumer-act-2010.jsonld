        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-41-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(2) 19  Updating consumer dashboard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-41-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.78",
      "values:originalText": "(2) Where a CDR representative provides the consumer dashboard on behalf of a\nCDR representative principal (see subrule 1.14(5)), the CDR representative\nprincipal may arrange for the CDR representative to update the consumer\ndashboard on the CDR representative principal’s behalf.",
      "skos:definition": "(2) Where a CDR representative provides the consumer dashboard on behalf of a\nCDR representative principal (see subrule 1.14(5)), the CDR representative\nprincipal may arrange for the CDR representative to update the consumer\ndashboard on the CDR representative principal’s behalf.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-41"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-41-ss-2-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-41-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e0c22ed912b0a15c87a06b86ca2cc1263bfb97ba7ead59b92e1eeb7663b404ae",
      "skos:note": "May arrange for CDR representative to update consumer dashboard on behalf."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-41-ss-2",
      "@type": "cof:Section",
      "cof:title": "4(2) 19  Updating consumer dashboard",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(2) Where a CDR representative provides the consumer dashboard on behalf of a\nCDR representative principal (see subrule 1.14(5)), the CDR representative\nprincipal may arrange for the CDR representative to update the consumer\ndashboard on the CDR representative principal’s behalf."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-41-ss-2-norm",
      "@type": "values:Obligation",
