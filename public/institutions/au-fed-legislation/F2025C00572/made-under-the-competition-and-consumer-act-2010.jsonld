    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 1  Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.105",
      "values:originalText": "A person may apply under this Part to be an accredited person. The CDR\nAccreditor may accredit a person, under section 56CA of the Act, if satisfied that\nthe person meets the criteria for accreditation specified in this Part. This Part also\ndeals with:\n•\nhow applications are dealt with by the CDR Accreditor; and\n•\nobligations of accredited persons; and\n•\nthe transfer, suspension, surrender and revocation of accreditations;\nand\n•\nrelated functions of the CDR Accreditor.\nThis Part deals with how entries are added to the Register of Accredited Persons,\nand how that Register is updated, amended and corrected.",
      "skos:definition": "A person may apply under this Part to be an accredited person. The CDR\nAccreditor may accredit a person, under section 56CA of the Act, if satisfied that\nthe person meets the criteria for accreditation specified in this Part. This Part also\ndeals with:\n•\nhow applications are dealt with by the CDR Accreditor; and\n•\nobligations of accredited persons; and\n•\nthe transfer, suspension, surrender and revocation of accreditations;\nand\n•\nrelated functions of the CDR Accreditor.\nThis Part deals with how entries are added to the Register of Accredited Persons,\nand how that Register is updated, amended and corrected.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-3-norm"
        }
      ],
      "cml:integrityHash": "33c322e17ed3783af1bec2ebca0ed4c7e88a4d8182cb91eecc78154e823d1318",
      "skos:note": "Application for accreditation under this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-3",
      "@type": "cof:Section",
      "cof:title": "5 1  Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 105,
      "values:originalText": "A person may apply under this Part to be an accredited person. The CDR\nAccreditor may accredit a person, under section 56CA of the Act, if satisfied that\nthe person meets the criteria for accreditation specified in this Part. This Part also\ndeals with:\n•\nhow applications are dealt with by the CDR Accreditor; and\n•\nobligations of accredited persons; and\n•\nthe transfer, suspension, surrender and revocation of accreditations;\nand\n•\nrelated functions of the CDR Accreditor.\nThis Part deals with how entries are added to the Register of Accredited Persons,\nand how that Register is updated, amended and corrected."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-3-norm",
      "@type": "values:Permission",
      "cml:modality": {
