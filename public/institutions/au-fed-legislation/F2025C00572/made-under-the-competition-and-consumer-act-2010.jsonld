    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 11  Simplified outline of Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.38",
      "values:originalText": "This Division sets out:\n•\ngeneral obligations of data holders which relate to product data\nrequests and consumer data requests; and\n•\ngeneral obligations for data holders and accredited persons to provide\nCDR consumers with consumer dashboards, which contain\ninformation relating to consumer data requests, and allow CDR\nconsumers to manage consents and authorisations, under these rules.\nSubdivision 1.4.2—Services for making requests under these rules",
      "skos:definition": "This Division sets out:\n•\ngeneral obligations of data holders which relate to product data\nrequests and consumer data requests; and\n•\ngeneral obligations for data holders and accredited persons to provide\nCDR consumers with consumer dashboards, which contain\ninformation relating to consumer data requests, and allow CDR\nconsumers to manage consents and authorisations, under these rules.\nSubdivision 1.4.2—Services for making requests under these rules",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-21-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "02f9a1daa651c1882739af80a54e2ca91a9b82924c2e0f525b673d97f297ac52",
      "skos:note": "General obligations of data holders for product and consumer data requests."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-21",
      "@type": "cof:Section",
      "cof:title": "1 11  Simplified outline of Division",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "This Division sets out:\n•\ngeneral obligations of data holders which relate to product data\nrequests and consumer data requests; and\n•\ngeneral obligations for data holders and accredited persons to provide\nCDR consumers with consumer dashboards, which contain\ninformation relating to consumer data requests, and allow CDR\nconsumers to manage consents and authorisations, under these rules.\nSubdivision 1.4.2—Services for making requests under these rules"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-21-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-21"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-21-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "General obligations of data holders.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 12  Product data request service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.38",
      "values:originalText": "(1) A data holder must provide an online service that:\n(a) can be used to make product data requests in relation to data that it holds;\nand\n(b) enables requested data to be disclosed in machine-readable form; and\n(c) conforms with the data standards.\nNote 1:\nSee rule 2.3 for the meaning of “product data request”.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nNote 3:\nFor the energy sector, this rule is modified by clause 4.2 of Schedule 4.\n(2) Such a service is a product data request service.",
      "skos:definition": "(1) A data holder must provide an online service that:\n(a) can be used to make product data requests in relation to data that it holds;\nand\n(b) enables requested data to be disclosed in machine-readable form; and\n(c) conforms with the data standards.\nNote 1:\nSee rule 2.3 for the meaning of “product data request”.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nNote 3:\nFor the energy sector, this rule is modified by clause 4.2 of Schedule 4.\n(2) Such a service is a product data request service.",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-22-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-22-ss-2"
        }
      ],
      "cml:integrityHash": "f6f8905dd681c53f0b5c8c41e7eeb128a7a8e6715315fe436aaedb81fd5578dd"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-22",
      "@type": "cof:Section",
      "cof:title": "1 12  Product data request service",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "(1) A data holder must provide an online service that:\n(a) can be used to make product data requests in relation to data that it holds;\nand\n(b) enables requested data to be disclosed in machine-readable form; and\n(c) conforms with the data standards.\nNote 1:\nSee rule 2.3 for the meaning of “product data request”.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nNote 3:\nFor the energy sector, this rule is modified by clause 4.2 of Schedule 4.\n(2) Such a service is a product data request service."
    },
