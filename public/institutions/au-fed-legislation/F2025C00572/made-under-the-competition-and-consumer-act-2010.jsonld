    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-19-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(3) 10C  Trusted advisers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-19-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.36",
      "values:originalText": "(3) Where the accredited person or CDR representative has taken reasonable steps to\nconfirm that a person nominated as a trusted adviser was, and remains, a member\nof a class mentioned in subrule (2), the person is taken to be a member of that\nclass for the purposes of this rule.",
      "skos:definition": "(3) Where the accredited person or CDR representative has taken reasonable steps to\nconfirm that a person nominated as a trusted adviser was, and remains, a member\nof a class mentioned in subrule (2), the person is taken to be a member of that\nclass for the purposes of this rule.",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-19"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-19-ss-3-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-19-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "91c2e5334c56cc65ca25a2c19cc95e2ee530f32d09d3b1dbd9c825020ba9a63f",
      "skos:note": "Member of a class must confirm nomination of trusted adviser."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-19-ss-3",
      "@type": "cof:Section",
      "cof:title": "1(3) 10C  Trusted advisers",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(3) Where the accredited person or CDR representative has taken reasonable steps to\nconfirm that a person nominated as a trusted adviser was, and remains, a member\nof a class mentioned in subrule (2), the person is taken to be a member of that\nclass for the purposes of this rule."
    },
