      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.134",
      "values:originalText": "(1) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EK of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nPrivacy safeguard 9—government related identifiers",
      "skos:definition": "(1) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EK of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nPrivacy safeguard 9—government related identifiers",
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14"
      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-logic-ltl-3"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-logic-deontic-4"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "9c6a446e39ac69cfbd9acf046a4bde622a1fdb8ba2af93af4376b0a23d1d30b1",
      "skos:note": "Failure to comply with section 56EK of the Act in relation to service data of a CDR consumer as if it were an accredited data recipient of the service data is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-7-14-ss-1",
      "@type": "cof:Section",
      "cof:title": "7(1) Section 7",
      "values:kind": "subsection",
      "cof:pageNumber": 134,
      "values:originalText": "(1) An accredited person breaches this subrule if a direct or indirect OSP of:\n(a) the accredited person; or\n(b) a CDR representative of the accredited person;\nfails to comply with section 56EK of the Act in relation to service data of a CDR\nconsumer as if it were an accredited data recipient of the service data.\nNote 1:\nSee rule 1.10AA for the definition of “service data” in relation to a CDR representative\narrangement.\nNote 2:\nThis subrule is a civil penalty provision (see rule 9.8).\nPrivacy safeguard 9—government related identifiers"
    },
