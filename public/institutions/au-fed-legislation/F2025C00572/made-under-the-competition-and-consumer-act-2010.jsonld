    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-84",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 4; and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-84"
