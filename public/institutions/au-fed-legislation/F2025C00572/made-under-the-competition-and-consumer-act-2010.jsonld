        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35-ss-8-logic-linearlogic-2"
        }
      ],
      "cml:integrityHash": "9af390d31e6d8279b232ceb2f4910a86ca9b1d6b68dfa65e0011b7968eff7305",
      "skos:note": "Refusal to disclose SR data does not affect primary data holder's right."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-35-ss-8",
      "@type": "cof:Section",
      "cof:title": "1(8) 23  SR data request by an accredited person",
      "values:kind": "subsection",
      "cof:pageNumber": 48,
      "values:originalText": "(8) Subrule 4.6(4) does not apply in relation to SR data that the secondary data\nholder has refused to disclose to the primary data holder."
    },
    {
