      }
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 3  Consumer data requests made by CDR consumers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.56",
      "values:originalText": "(1) A CDR consumer may, using the data holder’s direct request service, request a\ndata holder to disclose some or all of their CDR data.\n(2) Such a request is a consumer data request made by a CDR consumer.\nNote:\nA fee cannot be charged for the disclosure of required consumer data: see section 56BU\nof the Act.\n(3) A consumer data request made under this Part is valid if it is made by a CDR\nconsumer who is eligible to make the request.",
      "skos:definition": "(1) A CDR consumer may, using the data holder’s direct request service, request a\ndata holder to disclose some or all of their CDR data.\n(2) Such a request is a consumer data request made by a CDR consumer.\nNote:\nA fee cannot be charged for the disclosure of required consumer data: see section 56BU\nof the Act.\n(3) A consumer data request made under this Part is valid if it is made by a CDR\nconsumer who is eligible to make the request.",
      "cml:hasPart": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-6-ss-1"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-6-ss-2"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-6-ss-3"
        }
      ],
      "cml:integrityHash": "bdd84cca64340a3f7b711a7f750857ba82ddca8b5d820bc86b94927af061642c"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-6",
      "@type": "cof:Section",
      "cof:title": "3 3  Consumer data requests made by CDR consumers",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "(1) A CDR consumer may, using the data holder’s direct request service, request a\ndata holder to disclose some or all of their CDR data.\n(2) Such a request is a consumer data request made by a CDR consumer.\nNote:\nA fee cannot be charged for the disclosure of required consumer data: see section 56BU\nof the Act.\n(3) A consumer data request made under this Part is valid if it is made by a CDR\nconsumer who is eligible to make the request."
    },
