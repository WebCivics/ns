      "@type": "cml:Concept",
      "skos:prefLabel": "7 5  Grounds for revocation, suspension and surrender of accreditation—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-3-sec-7-12"
