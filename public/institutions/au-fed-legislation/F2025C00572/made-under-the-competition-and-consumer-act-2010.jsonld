      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.103",
      "values:originalText": "(1) For this rule, an approval notification is a notice given by the data holder:\n(a) to a relevant account holder, to inform them that the requester has given,\namended or withdrawn an authorisation, or that the authorisation has\nexpired; or\n(b) to the requester, to inform them that:",
      "skos:definition": "(1) For this rule, an approval notification is a notice given by the data holder:\n(a) to a relevant account holder, to inform them that the requester has given,\namended or withdrawn an authorisation, or that the authorisation has\nexpired; or\n(b) to the requester, to inform them that:",
      "cml:asserts": [
        {
