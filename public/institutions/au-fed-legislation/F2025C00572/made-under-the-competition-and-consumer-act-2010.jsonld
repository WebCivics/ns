      "@type": "cml:Concept",
      "skos:prefLabel": "9 4  AEMO not to appear on Registrar’s database (rule 5.25)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-9-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.225",
      "values:originalText": "For the purposes of subrule 5.25(1), AEMO is not to be treated as a data holder.\nNote:\nThe function of the database to be maintained under subrule 5.25(1) is to provide\ninformation for the making of consumer data requests to data holders. Since requests\nfor AEMO data will be made to the relevant retailer, the database will not require\ndetails relating to AEMO.",
      "skos:definition": "For the purposes of subrule 5.25(1), AEMO is not to be treated as a data holder.\nNote:\nThe function of the database to be maintained under subrule 5.25(1) is to provide\ninformation for the making of consumer data requests to data holders. Since requests\nfor AEMO data will be made to the relevant retailer, the database will not require\ndetails relating to AEMO.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-18-norm"
        }
      ],
      "cml:integrityHash": "5aa6e76264164b998e692c987ef73494ca301cfcc2b68fc49847b202cd151df9",
      "skos:note": "AEMO is not to be treated as a data holder."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-9-18",
      "@type": "cof:Section",
      "cof:title": "9 4  AEMO not to appear on Registrar’s database (rule 5.25)",
      "values:kind": "section",
      "cof:pageNumber": 225,
      "values:originalText": "For the purposes of subrule 5.25(1), AEMO is not to be treated as a data holder.\nNote:\nThe function of the database to be maintained under subrule 5.25(1) is to provide\ninformation for the making of consumer data requests to data holders. Since requests\nfor AEMO data will be made to the relevant retailer, the database will not require\ndetails relating to AEMO."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-18-norm",
      "@type": "values:Obligation",
