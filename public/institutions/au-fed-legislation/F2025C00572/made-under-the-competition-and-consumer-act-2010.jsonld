        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Data Standards Chair must have regard to the following:"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 9;",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.144",
      "values:originalText": "(c) any advice from any other relevant committee, advisory panel or\nconsultative group that has been established by the Chair (see paragraph\n56FH(2)(a) of the Act).\n\n\nRules relating to data standards  Part 8\nData standards that must be made  Division 8.4\nSection 8.11\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "skos:definition": "(c) any advice from any other relevant committee, advisory panel or\nconsultative group that has been established by the Chair (see paragraph\n56FH(2)(a) of the Act).\n\n\nRules relating to data standards  Part 8\nData standards that must be made  Division 8.4\nSection 8.11\nCompetition and Consumer (Consumer Data Right) Rules 2020",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-18-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "52c7b4734971056d2d69431e3a6ca050122e9a7323dde6b275d4144da7c61e70",
      "skos:note": "Must provide advice from other relevant committees, panels or groups.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-18",
      "@type": "cof:Section",
      "cof:title": "8 9;",
      "values:kind": "section",
      "cof:pageNumber": 144,
      "values:originalText": "(c) any advice from any other relevant committee, advisory panel or\nconsultative group that has been established by the Chair (see paragraph\n56FH(2)(a) of the Act).\n\n\nRules relating to data standards  Part 8\nData standards that must be made  Division 8.4\nSection 8.11\nCompetition and Consumer (Consumer Data Right) Rules 2020"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-18-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-18"
