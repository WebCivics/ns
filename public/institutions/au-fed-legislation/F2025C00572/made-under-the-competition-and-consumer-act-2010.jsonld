    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-22-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Corrected data is accurate, up to date, complete and not misleading",
      "cml:executionSurface": "modalities::dl",
