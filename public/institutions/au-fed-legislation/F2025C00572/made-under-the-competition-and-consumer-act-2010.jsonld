      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If its authorisation or licence to sell electricity in the National Electricity Market has been suspended or revoked, the accredited person ceases to satisfy the condition.",
      "cml:conclusionText": "The suspension or revocation of authorisation or licence occurs after the accreditation."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "The accredited person must cease to satisfy the condition if its authorisation or licence is suspended or revoked repeatedly.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If its authorisation or licence to sell electricity in the National Electricity Market has been suspended or revoked, the accredited person ceases to satisfy the condition.",
      "cml:conclusionText": "The accredited person must cease to satisfy the condition if its authorisation or licence is suspended or revoked repeatedly."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The accredited person has a duty to cease satisfying the condition if its authorisation or licence is suspended or revoked.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The accredited person was, at the time of accreditation, a retailer.",
      "cml:conclusionText": "The accredited person has a duty to cease satisfying the condition if its authorisation or licence is suspended or revoked."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-9-19-logic-argumentation-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "If the accredited person ceases to satisfy the condition, it implies that its authorisation or licence has been suspended or revoked.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
