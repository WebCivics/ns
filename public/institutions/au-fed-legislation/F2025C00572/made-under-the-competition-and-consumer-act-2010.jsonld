    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-8-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 4  Appointment to Data Standards Advisory Committee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-8-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
