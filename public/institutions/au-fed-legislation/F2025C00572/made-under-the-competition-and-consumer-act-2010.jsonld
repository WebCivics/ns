      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.102",
      "values:originalText": "Division.\n(2) Any relevant account holder may withdraw an approval given under this\nDivision at any time, using their consumer dashboard.",
      "skos:definition": "Division.\n(2) Any relevant account holder may withdraw an approval given under this\nDivision at any time, using their consumer dashboard.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-15-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4a-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "08e914bce04240895c2cb6f2e476bdbacb9f5dcdf0cd24c38da5c17d7861e765",
      "skos:note": "Consumer may withdraw approval at any time using their consumer dashboard."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4a-15",
      "@type": "cof:Section",
      "cof:title": "4A 10(4)(b) is current, unless withdrawn sooner in accordance with this",
