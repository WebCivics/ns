        }
      ],
      "cml:integrityHash": "5f63c1806179303a41722636e6fbd278d8541a84aee64304998be2842ef1e06d",
      "skos:note": "Consents expire if person becomes data holder instead of recipient."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-31-ss-5",
