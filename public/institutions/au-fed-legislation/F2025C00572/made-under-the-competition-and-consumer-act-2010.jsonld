      },
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-2-5-ss-2-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-3-sec-2-5-ss-2-logic-deontic-1"
        },
        {
