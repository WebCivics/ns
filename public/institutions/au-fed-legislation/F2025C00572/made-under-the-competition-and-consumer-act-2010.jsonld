      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to comply with section 56EK.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 7(1) states that a breach occurs if service data is not handled in accordance with section 56EK.",
      "cml:conclusionText": "The accredited person has an obligation to handle service data in accordance with section 56EK."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-7-14-ss-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusion",
      "cml:logicSummary": "Diffusion of the breach.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
