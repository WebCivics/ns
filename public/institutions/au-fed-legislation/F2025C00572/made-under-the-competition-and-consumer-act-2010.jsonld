      "skos:note": "Data holder must take reasonable steps to ensure online service complies with subparagraph (1)(a)(ii)"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-23-ss-4",
      "@type": "cof:Section",
