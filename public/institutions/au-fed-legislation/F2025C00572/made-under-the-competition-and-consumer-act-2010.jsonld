    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 16A  Obligations relating to CDR representative arrangements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-27"
      },
      "cml:curationStatus": {
