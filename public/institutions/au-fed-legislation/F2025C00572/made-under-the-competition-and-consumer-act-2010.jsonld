        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-1-35-ss-11-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "442ecdc0ed90a4e244ed55116bcaeb939075e6ab7175eb07572f3175b17839b0",
      "skos:note": "Secondary data holder must cancel current requests upon withdrawal of authorization."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-1-35-ss-11",
      "@type": "cof:Section",
      "cof:title": "1(11) 23  SR data request by an accredited person",
      "values:kind": "subsection",
      "cof:pageNumber": 48,
      "values:originalText": "(11) Division 4.4 (authorisations to disclose CDR data) applies as if:\n(a) a reference to the data holder were a reference to the primary data holder;\nand\n(b) the following subrule were added after subrule 4.25(2) (withdrawal of\nauthorisation by CDR consumer):\n“(3) For subrule (2), giving effect to withdrawal includes cancelling any\ncurrent requests to the secondary data holder by the primary data\nholder under subrule 1.23(4).”."
    },
