    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 2  How an eligible CDR consumer makes a consumer data request—flowchart",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.55",
      "values:originalText": "The following is a flowchart for how an eligible CDR consumer makes a\nconsumer data request under this Part:\nA CDR consumer who is eligible to do so makes a\nconsumer data request to a data holder via the data\nholder’s direct request service.\nFor any required consumer data, the data holder must\n(unless covered by an exception) disclose the requested\ndata to the CDR consumer.\nFor any voluntary consumer data, the data holder may\n(but is not required to) disclose the requested data to the\nCDR consumer.\nIn either case, the data is disclosed through the data\nholder’s direct request service.",
      "skos:definition": "The following is a flowchart for how an eligible CDR consumer makes a\nconsumer data request under this Part:\nA CDR consumer who is eligible to do so makes a\nconsumer data request to a data holder via the data\nholder’s direct request service.\nFor any required consumer data, the data holder must\n(unless covered by an exception) disclose the requested\ndata to the CDR consumer.\nFor any voluntary consumer data, the data holder may\n(but is not required to) disclose the requested data to the\nCDR consumer.\nIn either case, the data is disclosed through the data\nholder’s direct request service.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-5-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5a9b95c9657335b1869404ca07bd155b6295cff1b5538fe1d3a8cd0008cd6d24",
      "skos:note": "Data holder must disclose required consumer data to CDR consumer upon request.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-5",
      "@type": "cof:Section",
      "cof:title": "3 2  How an eligible CDR consumer makes a consumer data request—flowchart",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "The following is a flowchart for how an eligible CDR consumer makes a\nconsumer data request under this Part:\nA CDR consumer who is eligible to do so makes a\nconsumer data request to a data holder via the data\nholder’s direct request service.\nFor any required consumer data, the data holder must\n(unless covered by an exception) disclose the requested\ndata to the CDR consumer.\nFor any voluntary consumer data, the data holder may\n(but is not required to) disclose the requested data to the\nCDR consumer.\nIn either case, the data is disclosed through the data\nholder’s direct request service."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-5-norm",
