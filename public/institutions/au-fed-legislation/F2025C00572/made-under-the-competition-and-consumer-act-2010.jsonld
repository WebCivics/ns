      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 1A  Levels of accreditation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.106",
      "values:originalText": "Accreditation may be at either of the following levels:\n(a) unrestricted;\n(b) sponsored.",
      "skos:definition": "Accreditation may be at either of the following levels:\n(a) unrestricted;\n(b) sponsored.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-4-norm"
        }
      ],
      "cml:integrityHash": "b0f946ffacae29a4e90311f939a5b25fe62fdac786af0e307ae61fe90b04d6a2",
      "skos:note": "Levels of accreditation may be unrestricted or sponsored."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-4",
      "@type": "cof:Section",
      "cof:title": "5 1A  Levels of accreditation",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "Accreditation may be at either of the following levels:\n(a) unrestricted;\n(b) sponsored."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-4-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
