    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-3-6-ss-3",
      "@type": "cof:Section",
      "cof:title": "3(3) 3  Consumer data requests made by CDR consumers",
      "values:kind": "subsection",
      "cof:pageNumber": 56,
      "values:originalText": "(3) A consumer data request made under this Part is valid if it is made by a CDR\nconsumer who is eligible to make the request."
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-3-6-ss-3-norm",
