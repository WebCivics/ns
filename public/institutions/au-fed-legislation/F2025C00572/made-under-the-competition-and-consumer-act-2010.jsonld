    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-49"
      },
      "cml:curationStatus": {
