    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-73",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 22  Requirements relating to data holder's processes for seeking authorisation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-73"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.92",
      "values:originalText": "A data holder’s processes for asking a CDR consumer to give or amend an\nauthorisation must:\n(a) accord with the data standards; and\n(b) having regard to any consumer experience guidelines developed by the\nData Standards Body, be as easy to understand as practicable, including by\nuse of concise language and, where appropriate, visual aids.",
      "skos:definition": "A data holder’s processes for asking a CDR consumer to give or amend an\nauthorisation must:\n(a) accord with the data standards; and\n(b) having regard to any consumer experience guidelines developed by the\nData Standards Body, be as easy to understand as practicable, including by\nuse of concise language and, where appropriate, visual aids.",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-73-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-4-73-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8b32ab30b02f9793bc8d9261b23a994ed5f66a754d806055aad7884610331f1",
      "skos:note": "Data holder's processes for seeking authorisation must be clear and easy to understand."
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-4-73",
      "@type": "cof:Section",
      "cof:title": "4 22  Requirements relating to data holder's processes for seeking authorisation",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "A data holder’s processes for asking a CDR consumer to give or amend an\nauthorisation must:\n(a) accord with the data standards; and\n(b) having regard to any consumer experience guidelines developed by the\nData Standards Body, be as easy to understand as practicable, including by\nuse of concise language and, where appropriate, visual aids."
    },
