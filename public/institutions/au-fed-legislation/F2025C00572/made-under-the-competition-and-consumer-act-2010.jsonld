    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 5  Criteria for accreditation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "made-under-the-competition-and-consumer-act-2010.pdf"
      },
      "dc:source": "made-under-the-competition-and-consumer-act-2010.pdf, p.108",
      "values:originalText": "Note:\nUnder subsection 56CA(1) of the Act, the CDR Accreditor may, in writing, accredit a person if the CDR\nAccreditor is satisfied that the person meets the criteria for accreditation specified in the consumer data\nrules.\nThe criterion for accreditation is that the accreditation applicant:\n(a) would, if accredited, be able to comply with the obligations set out in rule",
      "skos:definition": "Note:\nUnder subsection 56CA(1) of the Act, the CDR Accreditor may, in writing, accredit a person if the CDR\nAccreditor is satisfied that the person meets the criteria for accreditation specified in the consumer data\nrules.\nThe criterion for accreditation is that the accreditation applicant:\n(a) would, if accredited, be able to comply with the obligations set out in rule",
      "cml:asserts": [
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-10-norm"
        },
        {
          "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0d3e70f365c5bc191669c4316d80c3c98638f0e27ced058c433be715882486c3",
      "skos:note": "Must meet criteria for accreditation"
    },
    {
      "@id": "https://ns.webcivics.net/values/made-under-the-competition-and-consumer-act-2010#sch-4-sec-5-10",
      "@type": "cof:Section",
      "cof:title": "5 5  Criteria for accreditation",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "Note:\nUnder subsection 56CA(1) of the Act, the CDR Accreditor may, in writing, accredit a person if the CDR\nAccreditor is satisfied that the person meets the criteria for accreditation specified in the consumer data\nrules.\nThe criterion for accreditation is that the accreditation applicant:\n(a) would, if accredited, be able to comply with the obligations set out in rule"
    },
    {
      "@id": "concept:made-under-the-competition-and-consumer-act-2010-sch-4-sec-5-10-norm",
