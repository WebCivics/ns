concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3 cml:asserts concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-deontic-1 .
concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if-then" ;
    cml:logicSummary "Establishes the condition for retirement on invalidity grounds" ;
    cml:premiseText "(a) a person is engaged as an AFP employee under section 24 for a period; and (b) the person completes that period of engagement (the initial period); and (c) the person is not re-engaged under that section for a further period starting immediately after the end of the initial period;" ;
    cml:conclusionText "The Commissioner certifies in writing that the person’s physical or mental incapacity was the only reason why the person was not so re-engaged." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3 cml:asserts concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-alleninterval-2 .
concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "<>" ;
    cml:logicSummary "Defines the temporal interval for retirement on invalidity grounds" ;
    cml:premiseText "(3) If: (a) a person is engaged as an AFP employee under section 24 for a period; and (b) the person completes that period of engagement (the initial period); and (c) the person is not re-engaged under that section for a further period starting immediately after the end of the initial period;" ;
    cml:conclusionText "The person is taken, for the purposes of the Safety, Rehabilitation and Compensation Act 1988 and the Superannuation Act, to have been retired under this section on the day on which the initial period ended." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3 cml:asserts concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-ltl-3 .
concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "<>" ;
    cml:logicSummary "Establishes a temporal relationship between the initial period and the certification of incapacity" ;
    cml:premiseText "(3) If: (a) a person is engaged as an AFP employee under section 24 for a period; and (b) the person completes that period of engagement (the initial period); and (c) the person is not re-engaged under that section for a further period starting immediately after the end of the initial period;" ;
    cml:conclusionText "The Commissioner certifies in writing that the person’s physical or mental incapacity was the only reason why the person was not so re-engaged." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3 cml:asserts concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-deontic-4 .
concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-3-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Identifies the subject of the obligation" ;
    cml:premiseText "The person is taken to have been retired under this section on the day on which the initial period ended." ;
    cml:conclusionText "The Commissioner's certification is required for retirement on invalidity grounds." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2-ss-4 a cml:Concept ;
    skos:prefLabel "32(4) Retirement on invalidity grounds"@en ;
    cml:realizedBy doc:sch-1-sec-32-2-ss-4 ;
    cml:integrityHash "5f71fe17cc00016bdfd3f12a1aa88e8b0be83d804b9fad8b455a30043bdac5e9" ;
    values:partOf concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-32-2 ;
    skos:note "Commonwealth Superannuation Board of Trustees No. 2 must give a certificate under section 54C of the Superannuation Act 1976 for an AFP employee to be retired on invalidity grounds." ;
    cml:curationStatus cml:Proposed ;
