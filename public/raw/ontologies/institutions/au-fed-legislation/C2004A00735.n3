concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If something was done before the Act received Royal Assent, then it is taken to have been done under or for the purposes of the latter provision." ;
    cml:premiseText "(a) something was done (other than something covered by item 3), before this Act received the Royal Assent..." ;
    cml:conclusionText "...then, after the commencement of Schedule 1, the thing is taken to have been done under or for the purposes of the latter provision." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2 cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2-logic-alleninterval-2 .
