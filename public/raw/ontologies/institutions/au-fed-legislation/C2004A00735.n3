concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12l-ss-2 a cml:Concept ;
    skos:prefLabel "12L(2) Approval of draft standard marketing plan"@en ;
    cml:realizedBy doc:sch-1-sec-12l-ss-2 ;
    cml:integrityHash "e2bbbae7217c01875de69c8418d5236d5ca4de741fade2f5cc90823418e077dc" ;
    values:partOf concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12l ;
    skos:note "The ACA must approve the draft standard marketing plan if it meets certain conditions." ;
    dc:description "(a) the draft specifies appropriate equipment, goods or services that the provider will supply in fulfilment of the service obligation concerned, so far as it relates to the universal service area concerned; and (b) the draft adequately deals with how the provider will fulfil that service obligation, so far as it relates to that area; and (c) the draft sets out appropriate terms and conditions on which the equipment, goods or services are to be supplied; and (d) the draft sets out appropriate arrangements for the marketing of the supply of the equipment, goods or services to persons in the universal service area concerned." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
