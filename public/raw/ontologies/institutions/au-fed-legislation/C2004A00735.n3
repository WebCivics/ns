concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20a-ss-1 cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20a-ss-1-logic-alleninterval-1 .
concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20a-ss-1-logic-alleninterval-1 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Establishes temporal relationship between carrier status and eligibility." ;
    cml:premiseText "(1) For the purposes of this Act, a person is a participating person for an eligible revenue period if:" ;
    cml:conclusionText "(a) the person was a carrier at any time during the eligible revenue period; or (b) the Minister makes a written determination that carriage service providers are participating persons for the eligible revenue period and the person was a carriage service provider at any time during the eligible revenue period." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

