    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The thing is taken to have been done under or for the purposes of the latter provision if it was done before the commencement of Schedule 1." ;
    cml:premiseText "(1) If:  (a) something was done (other than something covered by item 3), before this Act received the Royal Assent..." ;
    cml:conclusionText "...then, after the commencement of Schedule 1, the thing is taken to have been done under or for the purposes of the latter provision." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2 cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2-logic-ltl-3 .
