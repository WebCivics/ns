concept:c2004a01078-sch-1-sec-73-ss-1 a cml:Concept ;
    skos:prefLabel "73(1) Section 73"@en ;
    cml:realizedBy doc:sch-1-sec-73-ss-1 ;
    cml:integrityHash "e35709674f4668eac36e33f10477def2fed965a35b10a8290a44e74bfad16f73" ;
    values:partOf concept:c2004a01078-sch-1-sec-73 ;
    skos:note "Organising or facilitating entry into a foreign country without complying with local law is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2004a01078.pdf> ;
    dc:source "c2004a01078.pdf, p.8" ;
    cml:asserts concept:c2004a01078-sch-1-sec-73-ss-1-norm .
concept:c2004a01078-sch-1-sec-73-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:c2004a01078-sch-1-sec-73-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:c2004a01078-sch-1-sec-73-ss-1 cml:asserts concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-1 .
concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits action" ;
    cml:premiseText "(a) the first person organises or facilitates the entry of another person into a foreign country (whether or not via Australia); and" ;
    cml:conclusionText "(the first person is guilty of an offence if...)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2004a01078-sch-1-sec-73-ss-1 cml:asserts concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-2 .
concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes obligation on the first person to comply with local law" ;
    cml:premiseText "(b) the entry of the other person into the foreign country does not comply with the requirements under that country’s law for entry into the country; and" ;
    cml:conclusionText "(the first person is guilty of an offence if...)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2004a01078-sch-1-sec-73-ss-1 cml:asserts concept:c2004a01078-sch-1-sec-73-ss-1-logic-alleninterval-3 .
concept:c2004a01078-sch-1-sec-73-ss-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines temporal overlap between actions" ;
    cml:premiseText "(c) the other person is not a citizen or permanent resident of the foreign country; and" ;
    cml:conclusionText "(the first person is guilty of an offence if...)" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2004a01078-sch-1-sec-73-ss-1 cml:asserts concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-4 .
concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits obtaining benefits from facilitating entry into a foreign country" ;
    cml:premiseText "(d) the first person organises or facilitates the entry: (i) having obtained (whether directly or indirectly) a benefit to do so; or" ;
    cml:conclusionText "(the first person is guilty of an offence if...)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2004a01078-sch-1-sec-73-ss-1 cml:asserts concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-5 .
concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits obtaining benefits from facilitating entry into a foreign country with intention" ;
    cml:premiseText "(d) the first person organises or facilitates the entry: (ii) with the intention of obtaining (whether directly or indirectly) a benefit." ;
    cml:conclusionText "(the first person is guilty of an offence if...)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


