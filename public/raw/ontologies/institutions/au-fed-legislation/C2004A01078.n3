concept:c2004a01078-sch-3-sec-7-ss-2 cml:asserts concept:c2004a01078-sch-3-sec-7-ss-2-logic-deontic-1 .
concept:c2004a01078-sch-3-sec-7-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits obtaining financial advantage from Commonwealth entity for ineligible person" ;
    cml:premiseText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:conclusionText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2004a01078-sch-3-sec-7-ss-2 cml:asserts concept:c2004a01078-sch-3-sec-7-ss-2-logic-alleninterval-2 .
concept:c2004a01078-sch-3-sec-7-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Defines temporal relation between obtaining financial advantage and Commonwealth entity eligibility" ;
    cml:premiseText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:conclusionText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2004a01078-sch-3-sec-7-ss-2 cml:asserts concept:c2004a01078-sch-3-sec-7-ss-2-logic-ltl-3 .
concept:c2004a01078-sch-3-sec-7-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Defines recurring trace of obtaining financial advantage from Commonwealth entity for ineligible person" ;
    cml:premiseText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:conclusionText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
