    cml:modality cml:Diffusion ;
    cml:operator "Diffuse" ;
    cml:logicSummary "Diffuses information about obtaining financial advantage from Commonwealth entity for ineligible person" ;
    cml:premiseText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:conclusionText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
