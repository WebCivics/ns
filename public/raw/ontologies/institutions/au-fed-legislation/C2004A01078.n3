    values:partOf concept:c2004a01078-sch-1-sec-73-3 ;
    skos:note "Organising or facilitating entry of non-compliant group into foreign country is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
