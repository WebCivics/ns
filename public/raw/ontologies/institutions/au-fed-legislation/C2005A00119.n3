concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1 cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1-logic-deontic-1 .
concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide draft variation of final operational separation plan" ;
    cml:premiseText "(1) This clause applies to a draft variation of a final operational separation plan unless:  (a) the draft variation was given to the Minister as a result of a direction under subclause 56A(2); or  (b) both:  (i) Telstra had previously given the Minister a written outline of the draft variation; and  (ii) the Minister, by written notice given to Telstra, had informed Telstra that the Minister was satisfied that the draft variation was of a minor nature." ;
    cml:conclusionText "(1) This clause applies to a draft variation of a final operational separation plan unless:  (a) the draft variation was given to the Minister as a result of a direction under subclause 56A(2); or  (b) both:  (i) Telstra had previously given the Minister a written outline of the draft variation; and  (ii) the Minister, by written notice given to Telstra, had informed Telstra that the Minister was satisfied that the draft variation was of a minor nature." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1 cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1-logic-alleninterval-2 .
