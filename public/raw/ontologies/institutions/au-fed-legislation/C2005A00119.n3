concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-21-ss-2a cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-21-ss-2a-logic-deontic-1 .
concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-21-ss-2a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Commission prohibits rejection of variation if information not given within time limit." ;
    cml:premiseText "(2A) If the Procedural Rules make provision for or in relation to a time limit for giving the information; and (b) the person does not give the Commission the information within the time limit allowed by the Procedural Rules;" ;
    cml:conclusionText "The Commission may, by written notice given to the person, reject the variation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-21-ss-2a cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-21-ss-2a-logic-alleninterval-2 .
