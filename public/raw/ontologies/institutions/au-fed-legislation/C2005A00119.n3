    cml:realizedBy doc:sch-11-sec-57-ss-1 ;
    cml:integrityHash "33d3a45ec200d7e3829387689163901396fdec10051b3f90ae54467613a8333a" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57 ;
    skos:note "Draft variation of final operational separation plan must be given to the Minister under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
