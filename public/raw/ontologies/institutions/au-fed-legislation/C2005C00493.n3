concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-descriptionlogic-2 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "is-a" ;
    cml:logicSummary "Definition includes offences against various Acts and sections" ;
    cml:premiseText "The definition of a protective service offence includes offences against section 24AB, 29, 46 (other than paragraph b), 47, 47A, 79, 89 or 89A of the Crimes Act 1914." ;
    cml:conclusionText "The definition of a protective service offence is a subset of the Crimes Act 1914" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-alleninterval-3 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Definition includes offences against certain sections and Acts" ;
    cml:premiseText "The definition of a protective service offence includes offences against section 91.1 of the Criminal Code." ;
    cml:conclusionText "The definition of a protective service offence is greater than or equal to the Criminal Code section 91.1" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-argumentation-4 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-argumentation-4 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "implies" ;
    cml:logicSummary "Definition implies certain conditions for an offence to be considered a protective service offence" ;
    cml:premiseText "The definition of a protective service offence includes offences against Division 72 of the Criminal Code that relates to a person, place or thing in respect of which the Australian Federal Police is performing protective service functions." ;
    cml:conclusionText "If an offence falls under Division 72 of the Criminal Code, it implies that the Australian Federal Police is performing protective service functions" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-diffusion-5 .
