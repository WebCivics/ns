    cml:modality cml:Diffusion ;
    cml:operator "and" ;
    cml:logicSummary "Definition includes multiple conditions for an offence to be considered a protective service offence" ;
    cml:premiseText "The definition of a protective service offence includes offences against section 6 of the Crimes Act 1914, or section 11.1 or 11.4 of the Criminal Code that relates to an offence mentioned in paragraph (a)" ;
    cml:conclusionText "The definition of a protective service offence is and includes multiple conditions" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-cogai-6 .
