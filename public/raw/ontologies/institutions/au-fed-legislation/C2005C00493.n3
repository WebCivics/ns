    cml:operator "is" ;
    cml:logicSummary "Protective service offence is defined" ;
    cml:premiseText "The Australian Federal Police is performing protective service functions." ;
    cml:conclusionText "There exists an offence that falls under the definition of a protective service offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
