    values:partOf concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-4aa ;
    skos:note "Identify State offences with a federal aspect" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
