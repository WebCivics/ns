concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 a cml:Concept ;
    skos:prefLabel "42(1) Australian Federal Police and Other Legislation Amendment Act"@en ;
    cml:realizedBy doc:sch-3-sec-42-ss-1 ;
    cml:integrityHash "7021436beb0e922c0506b8719f76e4139c52bee38a7d0b986d5ef77200f054e0" ;
    values:partOf concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42 ;
    skos:note "A State offence has a federal aspect if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-and-other-legislation-amendment-act-2004.pdf> ;
    dc:source "australian-federal-police-and-other-legislation-amendment-act-2004.pdf, p.46" ;
    cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-norm .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-1 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "The provision creating the State offence had been enacted by the Parliament of the Commonwealth instead of by the Parliament of the State." ;
    cml:conclusionText "The State offence has a federal aspect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-2 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "Assuming that the Parliament of the Commonwealth had enacted a provision that created an offence penalising the specific acts or omissions involved in committing the State offence—that provision would have been a valid law of the Commonwealth." ;
    cml:conclusionText "The State offence has a federal aspect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-3 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "Both: (i) the Australian Federal Police is investigating a matter relating to a relevant criminal activity that relates to an offence against a law of the Commonwealth or a Territory; and (ii) if the Australian Federal Police is investigating, or were to investigate, a matter relating to a relevant criminal activity that relates to the State offence—that investigation is, or would be, incidental to the investigation mentioned in subparagraph (i)." ;
    cml:conclusionText "The State offence has a federal aspect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-4 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "Both: (i) the State offence is not an ancillary offence; and (ii) assuming that the provision creating the State offence had been enacted by the Parliament of the Commonwealth instead of by the Parliament of the State—the provision would have been a valid law of the Commonwealth." ;
    cml:conclusionText "The State offence has a federal aspect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1 cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-5 .
concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "Both: (i) the State offence is an ancillary offence that relates to a particular primary offence; and (ii) assuming that the provision creating the primary offence had been enacted by the Parliament of the Commonwealth instead of by the Parliament of the State—the provision would have been a valid law of the Commonwealth." ;
    cml:conclusionText "The State offence has a federal aspect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


