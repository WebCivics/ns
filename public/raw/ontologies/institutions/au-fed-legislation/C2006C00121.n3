concept:privacy-amendment-act-2004-sch-1-sec-6-ss-2 cml:asserts concept:privacy-amendment-act-2004-sch-1-sec-6-ss-2-logic-diffusion-4 .
concept:privacy-amendment-act-2004-sch-1-sec-6-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "if-then" ;
    cml:logicSummary "The excerpt describes a conditional relationship between the approved privacy code and the Act." ;
    cml:premiseText "An approved privacy code covers exempt acts or practices, and the Act applies in relation to the code as if those acts or practices were not exempt." ;
    cml:conclusionText "If an approved privacy code covers exempt acts or practices, then the Act applies in relation to the code as if those acts or practices were not exempt." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

