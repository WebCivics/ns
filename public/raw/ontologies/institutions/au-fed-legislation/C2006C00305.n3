    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits sending unsolicited sexual messages to minors." ;
    cml:premiseText "(a) the sender uses a carriage service to transmit a communication to another person (the recipient); and (b) the sender does this with the intention of procuring the recipient to engage in, or submit to, sexual activity with the sender; and (c) the recipient is someone who is, or who the sender believes to be, under 16 years of age;" ;
    cml:conclusionText "(d) the sender commits an offence if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


