concept:act-sch-1-sec-473-4 a cml:Concept ;
    skos:prefLabel "473 Section 473"@en ;
    cml:realizedBy doc:sch-1-sec-473-4 ;
    cml:integrityHash "72f4efb1dfa1cd9bc45276ddbef3f213f6911a817a1b86ad713f70717e83e1ac" ;
    skos:note "Consider standards of morality, decency and propriety when deciding if material is offensive." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.16" ;
    cml:asserts concept:act-sch-1-sec-473-4-norm .
concept:act-sch-1-sec-473-4-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-1-sec-473-4 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-1-sec-473-4 cml:asserts concept:act-sch-1-sec-473-4-logic-deontic-1 .
concept:act-sch-1-sec-473-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "should" ;
    cml:logicSummary "Moral obligation" ;
    cml:premiseText "Reasonable adults generally accept certain standards of morality, decency and propriety." ;
    cml:conclusionText "Material should be considered offensive if it violates these standards." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-1-sec-473-4 cml:asserts concept:act-sch-1-sec-473-4-logic-alleninterval-2 .
concept:act-sch-1-sec-473-4-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Temporal consideration of material's publication date" ;
    cml:premiseText "The material was published during a time when certain standards were generally accepted." ;
    cml:conclusionText "Material should be considered offensive if it was published during this time." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-1-sec-473-4 cml:asserts concept:act-sch-1-sec-473-4-logic-argumentation-3 .
concept:act-sch-1-sec-473-4-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "if-then" ;
    cml:logicSummary "Conditional reasoning based on context" ;
    cml:premiseText "If the material is of a medical, legal or scientific character, then it should be considered less offensive." ;
    cml:conclusionText "Material is considered less offensive if it has this characteristic." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-1-sec-473-4 cml:asserts concept:act-sch-1-sec-473-4-logic-diffusion-4 .
concept:act-sch-1-sec-473-4-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "through" ;
    cml:logicSummary "Spread of information and its impact on public opinion" ;
    cml:premiseText "The material's spread through the carriage service can influence public opinion." ;
    cml:conclusionText "Material should be considered offensive if it has a significant impact on public opinion." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-1-sec-473-4 cml:asserts concept:act-sch-1-sec-473-4-logic-cogai-5 .
concept:act-sch-1-sec-473-4-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "by" ;
    cml:logicSummary "Artificial intelligence analysis of material's content" ;
    cml:premiseText "The carriage service's AI can analyze the material's content and determine its offensiveness." ;
    cml:conclusionText "Material should be considered offensive if the AI determines it to be so." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


