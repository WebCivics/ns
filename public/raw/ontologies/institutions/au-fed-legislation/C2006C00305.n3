    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits causing unwanted communication reception." ;
    cml:premiseText "(a) a communication is in the course of telecommunications carriage; and (b) the person causes the communication to be received by a person or carriage service other than the person or service to whom it is directed." ;
    cml:conclusionText "Imprisonment for 1 year." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
