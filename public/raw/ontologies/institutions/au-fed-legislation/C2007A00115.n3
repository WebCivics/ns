concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8 cml:asserts concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-1 .
concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If an instrument contains a reference to the Centre or Director, it has effect from the commencement time as if the reference were a reference to the CEO." ;
    cml:premiseText "an instrument is in force immediately before the commencement time; and the instrument contains a reference to the Centre or to the Director;" ;
    cml:conclusionText "the instrument has effect from the commencement time as if the reference were a reference to the CEO." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8 cml:asserts concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-2 .
