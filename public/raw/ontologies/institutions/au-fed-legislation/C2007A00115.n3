    cml:operator "implies" ;
    cml:logicSummary "However, if an instrument is in force immediately before the commencement time; and the instrument relates to assets or liabilities covered by item 2 or 3; and the instrument refers to the Centre or to the Director;" ;
    cml:premiseText "an instrument is in force immediately before the commencement time; and the instrument relates to assets or liabilities covered by item 2 or 3; and the instrument refers to the Centre or to the Director;" ;
    cml:conclusionText "the reference is to be read as a reference to the Commonwealth as necessary to give effect to item 2 or 3, as the case requires." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


