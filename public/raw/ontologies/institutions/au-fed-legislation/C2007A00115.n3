    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "The Minister may, by writing, determine that subitem (1), (2) or (3) does not apply in relation to a specified reference;" ;
    cml:premiseText "the Minister may, by writing, determine that subitem (1), (2) or (3);" ;
    cml:conclusionText "subitem (1), (2) or (3) does not apply in relation to a specified reference." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8 cml:asserts concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-3 .
