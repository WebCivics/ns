concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5h-ss-1 a cml:Concept ;
    skos:prefLabel "5H(1) When a communication is accessible to the intended recipient"@en ;
    cml:realizedBy doc:sch-1-sec-5h-ss-1 ;
