concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "includes" ;
    cml:logicSummary "Includes AFP employees and their superiors." ;
    cml:premiseText "(2) In addition to the person who is the intended recipient of a communication under subsection (1), if a communication is addressed to a person at an address on a computer network operated by or on behalf of the Australian Federal Police, each of the following is also an intended recipient of the communication for the purposes of this Act:" ;
    cml:conclusionText "(a) any AFP employee responsible for operating, protecting and maintaining the network;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

