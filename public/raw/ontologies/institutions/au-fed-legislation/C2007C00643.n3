concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5f-ss-1 cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5f-ss-1-logic-deontic-1 .
concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5f-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "starts" ;
    cml:logicSummary "Communication starts" ;
    cml:premiseText "(a) is taken to start passing over a telecommunications system when it is sent or transmitted by the person sending the communication." ;
    cml:conclusionText "(1) For the purposes of this Act, a communication:  (a) is taken to start passing over a telecommunications system when it is sent or transmitted by the person sending the communication." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5f-ss-1 cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5f-ss-1-logic-deontic-2 .
concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5f-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "continues" ;
    cml:logicSummary "Communication continues" ;
    cml:premiseText "(b) is taken to continue to pass over the system until it becomes accessible to the intended recipient of the communication." ;
    cml:conclusionText "(1) For the purposes of this Act, a communication:  (a) is taken to start passing over a telecommunications system when it is sent or transmitted by the person sending the communication.  (b) is taken to continue to pass over the system until it becomes accessible to the intended recipient of the communication." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

