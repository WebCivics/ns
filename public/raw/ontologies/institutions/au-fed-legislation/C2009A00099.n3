    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Tribunal has a duty to consider certain factors." ;
    cml:premiseText "(1) In determining whether the Tribunal is satisfied that it is desirable to make an order or orders under subsection 35(2) of the Administrative Appeals Tribunal Act 1975, the Tribunal must:" ;
    cml:conclusionText "The Tribunal must have regard to..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

