    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits sending explicit sexual content to minors." ;
    cml:premiseText "(a) the sender causes an article to be carried by a postal or similar service to another person (the recipient); and (b) the sender does this with the intention of procuring the recipient to engage in sexual activity with the sender; and (c) the recipient is someone who is, or who the sender believes to be, under 16; and (d) the sender is at least 18." ;
    cml:conclusionText "Imprisonment for 15 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


