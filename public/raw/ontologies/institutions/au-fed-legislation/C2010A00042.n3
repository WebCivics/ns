    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Conduct is recurring if it extends beyond public benefit" ;
    cml:premiseText "(b) does not extend beyond what is of public benefit." ;
    cml:conclusionText "The conduct is recurring if it extends beyond the public benefit." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-4 .
concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to determine whether conduct is of public benefit" ;
    cml:premiseText "In determining whether the person is, under this subsection, not criminally responsible for the offence, the question whether the conduct is of public benefit is a question of fact and the person’s motives in engaging in the conduct are irrelevant." ;
    cml:conclusionText "The person must determine whether the conduct is of public benefit." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-5 .
