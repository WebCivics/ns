    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to prosecute within Australia" ;
    cml:premiseText "The person must be an Australian citizen, resident, or incorporated body corporate." ;
    cml:conclusionText "If not, prosecution is not allowed." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
