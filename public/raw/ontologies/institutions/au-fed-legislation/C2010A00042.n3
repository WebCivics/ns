    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "Recognizes the prohibition on arrest before consent in AI systems." ;
    cml:premiseText "(2) However, a person may be arrested for, charged with, or remanded in custody or on bail in connection with, such an offence before the necessary consent has been given." ;
    cml:conclusionText "The system recognizes that arrest before consent is prohibited." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


