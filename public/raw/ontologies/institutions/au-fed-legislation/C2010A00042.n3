    cml:operator "Until" ;
    cml:logicSummary "Defines a temporal relationship between arrest and consent." ;
    cml:premiseText "(2) However, a person may be arrested for, charged with, or remanded in custody or on bail in connection with, such an offence before the necessary consent has been given." ;
    cml:conclusionText "Arrest occurs until consent is given." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-3-ss-2 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-3-ss-2-logic-diffusion-4 .
