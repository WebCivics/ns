concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-1 .
concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to not be criminally responsible for an offence against section 471.19 or 471.20 if the conduct is of public benefit and does not extend beyond what is of public benefit." ;
    cml:premiseText "(1) A person is not criminally responsible for an offence against section 471.19 (using a postal or similar service for child abuse material) or 471.20 (possessing etc. child abuse material for use through a postal or similar service) because of engaging in particular conduct if the conduct:  (a) is of public benefit; and  (b) does not extend beyond what is of public benefit." ;
    cml:conclusionText "The person is not criminally responsible for the offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-alleninterval-2 .
concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Conduct overlaps with public benefit" ;
    cml:premiseText "(a) is of public benefit; and (b) does not extend beyond what is of public benefit." ;
    cml:conclusionText "The conduct overlaps with the public benefit." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-ltl-3 .
