concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-ss-3 a cml:Concept ;
    skos:prefLabel "273(3) Section 273"@en ;
    cml:realizedBy doc:sch-1-sec-273-ss-3 ;
    cml:integrityHash "4053d901b382d1db33474c9ac0cd4c119e9c245c807271f5227512af046ad29e" ;
