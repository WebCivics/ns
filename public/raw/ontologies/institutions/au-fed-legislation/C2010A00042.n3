concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1-logic-deontic-1 .
concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to not be criminally responsible for an offence against section 471.16 or 471.17 if the conduct is of public benefit and does not extend beyond what is of public benefit." ;
    cml:premiseText "(1) A person is not criminally responsible for an offence against section 471.16 (using a postal or similar service for child pornography material) or 471.17 (possessing etc. child pornography material for use through a postal or similar service)" ;
    cml:conclusionText "The conduct must be of public benefit and does not extend beyond what is of public benefit." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


