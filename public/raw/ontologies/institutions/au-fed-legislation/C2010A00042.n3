    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to bear evidential burden" ;
    cml:premiseText "A defendant bears an evidential burden in relation to the matter in this subsection, see subsection 13.3(3)." ;
    cml:conclusionText "The defendant must bear the evidential burden." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


