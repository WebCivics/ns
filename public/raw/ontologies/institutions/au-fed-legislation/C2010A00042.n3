concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-13-ss-1 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-13-ss-1-logic-deontic-1 .
concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-13-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits sending unsolicited sexual material to minors." ;
    cml:premiseText "(a) the sender causes an article to be carried by a postal or similar service to another person (the recipient); and (b) the sender does this with the intention of making it easier to procure the recipient to engage in sexual activity with the sender; and (c) the recipient is someone who is, or who the sender believes to be, under 16; and (d) the sender is at least 18." ;
    cml:conclusionText "Imprisonment for 12 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


