concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1 a cml:Concept ;
    skos:prefLabel "471(1) Section 471"@en ;
    cml:realizedBy doc:sch-1-sec-471-3-ss-1 ;
    cml:integrityHash "e9425243ed77b21f1827c3505e7a8a93a111c5309d8b12b0f3dc09ab1683cbba" ;
    values:partOf concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3 ;
    skos:note "A person is not criminally responsible for an offence against section 471.16 or 471.17 if the conduct is of public benefit and does not extend beyond what is of public benefit." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
