    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Diffuses the concept of arrest before consent to related offenses." ;
    cml:premiseText "(2) However, a person may be arrested for, charged with, or remanded in custody or on bail in connection with, such an offence before the necessary consent has been given." ;
    cml:conclusionText "The diffusion of this concept applies to all offenses where consent is not required." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-3-ss-2 cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-3-ss-2-logic-cogai-5 .
