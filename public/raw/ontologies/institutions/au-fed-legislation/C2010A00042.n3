    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition" ;
    cml:premiseText "(a) the person engages in sexual intercourse with another person (the young person); and (b) the young person is at least 16 but under 18; and (c) the person is in a position of trust or authority in relation to the young person; and (d) the sexual intercourse is engaged in outside Australia." ;
    cml:conclusionText "(1) A person commits an offence if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


