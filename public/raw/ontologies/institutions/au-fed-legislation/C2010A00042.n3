    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines a temporal interval for offenses where arrest before consent is allowed." ;
    cml:premiseText "(2) However, a person may be arrested for, charged with, or remanded in custody or on bail in connection with, such an offence before the necessary consent has been given." ;
    cml:conclusionText "The temporal interval for offenses where consent is not required overlaps with this class." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

