concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1 a cml:Concept ;
    skos:prefLabel "471(1) Section 471"@en ;
    cml:realizedBy doc:sch-1-sec-471-6-ss-1 ;
    cml:integrityHash "1835333bc91f510b1a447a10a6c31a7c91ca99cd1c94afb170ebd0549f0664d4" ;
    values:partOf concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6 ;
    skos:note "A person is not criminally responsible for an offence against section 471.19 or 471.20 if the conduct is of public benefit and does not extend beyond what is of public benefit." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.42" ;
    cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-norm .
