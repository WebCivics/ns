concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 a cml:Concept ;
    skos:prefLabel "24(6) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011"@en ;
    cml:realizedBy doc:sch-1-sec-24-ss-6 ;
    cml:integrityHash "19132da9162b8fd4c2bdbe6aaf5462fc7eca803ebc7a2600ccbc6674c95e8ecb" ;
    values:partOf concept:competition-and-consumer-amendment-act-sch-1-sec-24 ;
    skos:note "A relevant person must be notified of a borrower insolvency situation if there are reasonable grounds for suspecting that the borrower or someone who gave a guarantee may become insolvent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-act.pdf> ;
    dc:source "competition-and-consumer-amendment-act.pdf, p.28" ;
    cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-norm .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-1 .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide notification" ;
    cml:premiseText "There are reasonable grounds for suspecting that the borrower or someone who gave a guarantee may become insolvent." ;
    cml:conclusionText "The relevant person must be notified of the situation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-2 .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide notification if notified by the borrower or guarantor" ;
    cml:premiseText "The notification is given by the borrower, or by a person referred to in subparagraph (a)(ii)." ;
    cml:conclusionText "The relevant person must be notified of the situation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-alleninterval-3 .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Notification must occur before the borrower becomes insolvent" ;
    cml:premiseText "If:  (a) proceedings are brought against a person in respect of section 44ZZW or 44ZZX; and  (b) the person seeks to rely on subsection 44ZZU(2) or (4), or on a subsection of section 44ZZY or 44ZZZ;" ;
    cml:conclusionText "The notification must occur before the borrower becomes insolvent." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-4 .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Person bears evidential burden if seeking to rely on subsections of section 44ZZY or 44ZZZ" ;
    cml:premiseText "If:  (a) proceedings are brought against a person in respect of section 44ZZW or 44ZZX; and  (b) the person seeks to rely on subsection 44ZZU(2) or (4), or on a subsection of section 44ZZY or 44ZZZ;" ;
    cml:conclusionText "The person bears an evidential burden." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-5 .
concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Person must provide evidence if seeking to rely on subsections of section 44ZZY or 44ZZZ" ;
    cml:premiseText "If:  (a) proceedings are brought against a person in respect of section 44ZZW or 44ZZX; and  (b) the person seeks to rely on subsection 44ZZU(2) or (4), or on a subsection of section 44ZZY or 44ZZZ;" ;
    cml:conclusionText "The person must provide evidence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
