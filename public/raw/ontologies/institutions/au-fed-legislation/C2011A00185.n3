    cml:conclusionText "The corporation must be notified of the borrower insolvency situation if the person bears an evidential burden in relation to the matters set out in that subsection on which the person seeks to rely." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
