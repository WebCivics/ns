concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1 a cml:Concept ;
    skos:prefLabel "16(1) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011"@en ;
    cml:realizedBy doc:sch-1-sec-16-2-ss-1 ;
    cml:integrityHash "82d87ad156dd9dc58fd9abc5624f1d5589372affbafda2fb6a26d974c07ead5b" ;
    values:partOf concept:competition-and-consumer-amendment-act-sch-1-sec-16-2 ;
    skos:note "Disclosure of information to a person's agent is taken to have been made by the discloser to that person. Disclosure of information to competitors or potential competitors is private." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-act.pdf> ;
