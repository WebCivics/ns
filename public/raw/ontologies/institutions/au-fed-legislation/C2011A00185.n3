    cml:modality cml:Deontic ;
    cml:operator "takes" ;
    cml:logicSummary "The law takes action on behalf of the discloser." ;
    cml:premiseText "Discloser makes disclosure to person's agent." ;
    cml:conclusionText "Disclosure is taken to have been made by discloser to that person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-logic-deontic-2 .
