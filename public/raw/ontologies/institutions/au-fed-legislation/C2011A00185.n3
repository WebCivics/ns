concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-2 a cml:Concept ;
    skos:prefLabel "16(2) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011"@en ;
    cml:realizedBy doc:sch-1-sec-16-2-ss-2 ;
    cml:integrityHash "6496a47341d113ecb926576f5d263b642ec395633dc760977fc1613ad52d4201" ;
    values:partOf concept:competition-and-consumer-amendment-act-sch-1-sec-16-2 ;
    skos:note "Disclosure of information by a person to another person is disregarded if made in the other person's capacity as an agent. Duty to determine private disclosure to competitors in relation to a particular market." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
