concept:competition-and-consumer-amendment-act-sch-1-sec-4-ss-3 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-4-ss-3-logic-deontic-3 .
concept:competition-and-consumer-amendment-act-sch-1-sec-4-ss-3-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "takes" ;
    cml:logicSummary "The disclosure of information is taken to have been made by the corporation." ;
    cml:premiseText "(a) a corporation makes a disclosure of information to a person (the intermediary); and (b) the corporation makes the disclosure to the intermediary for the purpose of the intermediary disclosing (or arranging for the disclosure of) the information to one or more other persons; and (c) the information is so disclosed to one or more of those other persons (the recipients);" ;
    cml:conclusionText "(d) the disclosure of the information to the recipients is taken to have been made by the corporation;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

