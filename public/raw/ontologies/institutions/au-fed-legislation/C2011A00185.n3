concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3-logic-alleninterval-2 .
concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Disclosure overlaps with recipient disclosure" ;
    cml:premiseText "(d) the disclosure of the information to the recipients is taken to have been made by the first person;" ;
    cml:conclusionText "The disclosure of the information to the intermediary is disregarded unless it overlaps with the recipient disclosure." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3 cml:asserts concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3-logic-deontic-3 .
concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permission" ;
    cml:logicSummary "Intermediary may disclose information to others" ;
    cml:premiseText "(b) the first person makes the disclosure to the intermediary for the purpose of the intermediary disclosing (or arranging for the disclosure of) the information to one or more other persons;" ;
    cml:conclusionText "The intermediary is permitted to disclose the information to others." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

