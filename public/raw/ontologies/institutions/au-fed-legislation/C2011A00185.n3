concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to disclose information" ;
    cml:premiseText "The first person makes a disclosure of information to the intermediary." ;
    cml:conclusionText "The disclosure of the information is taken to have been made by the first person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
