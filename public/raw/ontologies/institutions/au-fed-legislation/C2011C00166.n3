    cml:conclusionText "...the thing is being used, or is required to be used, for a purpose mentioned in section 3ZQU or for other judicial or administrative review proceedings;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
