concept:act-sch-4-sec-390-2-ss-2 a cml:Concept ;
    skos:prefLabel "390(2) Section 390"@en ;
    cml:realizedBy doc:sch-4-sec-390-2-ss-2 ;
    cml:integrityHash "3d6e7d5614f2303435de131cb0868c90743b12f0bc719bf5f8b1ecdc18af34b9" ;
    values:partOf concept:act-sch-4-sec-390-2 ;
    skos:note "A State offence has a federal aspect if it is not an ancillary offence and the provision creating it had been enacted by the Parliament of the Commonwealth." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.105" ;
    cml:asserts concept:act-sch-4-sec-390-2-ss-2-norm .
concept:act-sch-4-sec-390-2-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-4-sec-390-2-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-4-sec-390-2-ss-2 cml:asserts concept:act-sch-4-sec-390-2-ss-2-logic-deontic-1 .
concept:act-sch-4-sec-390-2-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if-and-only-if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "(a) both: (i) the State offence is not an ancillary offence; and (ii) assuming that the provision creating the State offence had been enacted by the Parliament of the Commonwealth instead of by the Parliament of the CommonLaw Authoritative Act C2011C00166" ;
    cml:conclusionText "A State offence has a federal aspect if it is not an ancillary offence and the provision creating it had been enacted by the Parliament of the Commonwealth." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-4-sec-390-2-ss-2 cml:asserts concept:act-sch-4-sec-390-2-ss-2-logic-alleninterval-2 .
concept:act-sch-4-sec-390-2-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "between" ;
    cml:logicSummary "Temporal interval for the creation of the provision" ;
    cml:premiseText "(2) For the purposes of this Act, a State offence has a federal aspect if..." ;
    cml:conclusionText "The provision creating the State offence had been enacted by the Parliament of the Commonwealth instead of by the Parliament of the CommonLaw Authoritative Act C2011C00166 between the time it was created and now." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

