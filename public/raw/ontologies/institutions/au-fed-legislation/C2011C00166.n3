    cml:operator "Overlap" ;
    cml:logicSummary "Temporal overlap between disclosure and assessment as State participant." ;
    cml:premiseText "(f) if the person disclosing the information is a person other than a person referred to in subparagraph (a)(i), (ii) or (iv)—there is a risk that disclosure of the information will adversely affect the integrity of the NWPP." ;
    cml:conclusionText "There is an overlap between disclosure and assessment as State participant." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
