    cml:operator "is" ;
    cml:logicSummary "State offences with a federal aspect must be identified." ;
    cml:premiseText "(1) The object of this section is to identify State offences that have a federal aspect;" ;
    cml:conclusionText "State offences with a federal aspect must be identified" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
