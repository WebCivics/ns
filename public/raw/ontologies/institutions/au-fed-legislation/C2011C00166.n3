concept:act-sch-2-sec-64-ss-2 a cml:Concept ;
    skos:prefLabel "64(2) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-2-sec-64-ss-2 ;
    cml:integrityHash "8b64778acec5daa8f7c6afe89ca4743a2d9c70faa5a5d10d983d4c8e75eb95b8" ;
    values:partOf concept:act-sch-2-sec-64 ;
    skos:note "Magistrate must allow owner to appear and be heard in determining an application by the Commissioner. Commissioner does not have to take steps if certain conditions are met. Magistrate may order retention of thing for specified period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
