    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of disclosing information about individuals who are participants or have a current NWPP identity." ;
    cml:premiseText "(a) the person is:  (i) a Commonwealth officer; or  (ii) a Commonwealth participant; or  (iii) a State participant; or  (iv) a Territory participant; or  (v) any other person;" ;
    cml:conclusionText "A person commits an offence if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
