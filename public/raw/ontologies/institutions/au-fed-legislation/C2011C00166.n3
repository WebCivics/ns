    cml:modality cml:Deontic ;
    cml:operator "wholly or partly" ;
    cml:logicSummary "Part of the conduct must occur on board an Australian aircraft or ship" ;
    cml:premiseText "(i) wholly or partly in Australia; (ii) wholly or partly on board an Australian aircraft or an Australian ship" ;
    cml:conclusionText "...the conduct constituting the alleged offence occurs wholly or partly in Australia; or wholly or partly on board an Australian aircraft or an Australian ship;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
