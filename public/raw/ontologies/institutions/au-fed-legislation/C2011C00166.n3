    cml:modality cml:Deontic ;
    cml:operator "exemption" ;
    cml:logicSummary "Commissioner exempt from taking steps if certain conditions are met." ;
    cml:premiseText "The Commissioner does not have to take those steps if..." ;
    cml:conclusionText "...the thing is likely to be used by the owner or another person in the commission of a terrorist act, a terrorism offence or a serious offence;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

