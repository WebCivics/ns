    cml:modality cml:Deontic ;
    cml:operator "wholly or partly" ;
    cml:logicSummary "Part of the conduct must occur in Australia" ;
    cml:premiseText "The conduct constituting the alleged offence occurs wholly or partly in Australia" ;
    cml:conclusionText "A person does not commit an offence against this Division unless..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

