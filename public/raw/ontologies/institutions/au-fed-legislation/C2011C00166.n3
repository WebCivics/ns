    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-5-sec-16-ss-1 cml:asserts concept:act-sch-5-sec-16-ss-1-logic-deontic-1 .
concept:act-sch-5-sec-16-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "Implies imprisonment for 3 years or penalty units" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-16-ss-1 cml:asserts concept:act-sch-5-sec-16-ss-1-logic-alleninterval-2 .
concept:act-sch-5-sec-16-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "overlaps" ;
    cml:logicSummary "Temporal interval of dealing with proceeds of crime" ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person deals with money or other property; and  (b) it is reasonable to suspect that the money or property is proceeds of crime; and  (c) at the time of the dealing, the value of the money and other property is $100,000 or more." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-16-ss-1 cml:asserts concept:act-sch-5-sec-16-ss-1-logic-ltl-3 .
concept:act-sch-5-sec-16-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "holdsForAll" ;
    cml:logicSummary "Holds for all temporal intervals of dealing with proceeds of crime" ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person deals with money or other property; and  (b) it is reasonable to suspect that the money or property is proceeds of crime; and  (c) at the time of the dealing, the value of the money and other property is $100,000 or more." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-16-ss-1 cml:asserts concept:act-sch-5-sec-16-ss-1-logic-diffusion-4 .
concept:act-sch-5-sec-16-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "diffusesInto" ;
    cml:logicSummary "Diffuses into a set of agents with authority to investigate" ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person deals with money or other property; and  (b) it is reasonable to suspect that the money or property is proceeds of crime; and  (c) at the time of the dealing, the value of the money and other property is $100,000 or more." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-16-ss-1 cml:asserts concept:act-sch-5-sec-16-ss-1-logic-cogai-5 .
concept:act-sch-5-sec-16-ss-1-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "recognizes" ;
    cml:logicSummary "Recognizes a pattern in data related to proceeds of crime" ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person deals with money or other property; and  (b) it is reasonable to suspect that the money or property is proceeds of crime; and  (c) at the time of the dealing, the value of the money and other property is $100,000 or more." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


