concept:act-sch-2-sec-64-ss-3 a cml:Concept ;
    skos:prefLabel "64(3) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-2-sec-64-ss-3 ;
    cml:integrityHash "33c74fc85a7ef7fd76ec4f72d159fe511549ec336035ff843645398400048cbc" ;
    values:partOf concept:act-sch-2-sec-64 ;
    skos:note "Magistrate may order retention of thing for specified period. Commissioner must notify persons with interest in thing before making application. Return of seized thing within 90 days" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
