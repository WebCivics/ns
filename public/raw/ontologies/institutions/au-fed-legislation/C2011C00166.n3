    cml:logicSummary "Recognition of refusal as offence." ;
    cml:premiseText "(7) A person commits an offence if:  (a) the person is given a notice under subsection (6); and  (b) the person refuses or fails to comply with the notice." ;
    cml:conclusionText "The refusal is recognized as an offence." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


