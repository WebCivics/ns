    skos:prefLabel "16(1) Subsection 400.9(1) of the Criminal Code"@en ;
    cml:realizedBy doc:sch-5-sec-16-ss-1 ;
    cml:integrityHash "c542c98fc69a9c88dd9e511431b5e03cdc19a01cb0f3405e79413e2c54e3c412" ;
    values:partOf concept:act-sch-5-sec-16 ;
    skos:note "Dealing with proceeds of crime over $100,000 is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
