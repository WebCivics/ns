    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Establishes a recurring trace of the association and the conduct." ;
    cml:premiseText "(c) the second person engages, or proposes to engage, in conduct (the second person’s conduct) that constitutes, or is part of conduct constituting, an offence against any law;" ;
    cml:conclusionText "The association and the conduct are recurring traces." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

