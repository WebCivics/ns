    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Commissioner must perform actions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-64-ss-3 cml:asserts concept:act-sch-2-sec-64-ss-3-logic-deontic-3 .
concept:act-sch-2-sec-64-ss-3-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Duty to return seized thing" ;
    cml:premiseText "The owner requests the return of the thing." ;
    cml:conclusionText "The Commissioner must take reasonable steps to return the thing to the owner." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-64-ss-3 cml:asserts concept:act-sch-2-sec-64-ss-3-logic-alleninterval-4 .
concept:act-sch-2-sec-64-ss-3-logic-alleninterval-4 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">P" ;
    cml:logicSummary "Time interval for return request" ;
    cml:premiseText "If subsection 3UF(2) applied in relation to the thing so that a seizure notice was not served—within 90 days after the day on which the thing was seized." ;
    cml:conclusionText "The Commissioner must take reasonable steps to return the thing to the owner within 90 days." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-64-ss-3 cml:asserts concept:act-sch-2-sec-64-ss-3-logic-ltl-5 .
concept:act-sch-2-sec-64-ss-3-logic-ltl-5 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator ">P" ;
    cml:logicSummary "Time interval for return request" ;
    cml:premiseText "(i) within 90 days after the date of the seizure notice served under section 3UF in relation to the thing; or (ii) if subsection 3UF(2) applied in relation to the thing so that a seizure notice was not served—within 90 days after the day on which the thing was seized." ;
    cml:conclusionText "The Commissioner must take reasonable steps to return the thing to the owner within 90 days." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-64-ss-3 cml:asserts concept:act-sch-2-sec-64-ss-3-logic-deontic-6 .
concept:act-sch-2-sec-64-ss-3-logic-deontic-6 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Duty to apply for magistrate order if not returned" ;
    cml:premiseText "(b) The thing has not been returned to the owner by the end of the 90th day;" ;
    cml:conclusionText "The Commissioner must apply to a magistrate for an order under section 3ZQZB." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-64-ss-3 cml:asserts concept:act-sch-2-sec-64-ss-3-logic-deontic-7 .
concept:act-sch-2-sec-64-ss-3-logic-deontic-7 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Duty to return thing if requested" ;
    cml:premiseText "(a) The owner of a thing requests the return of the thing:" ;
    cml:conclusionText "The Commissioner must take reasonable steps to return the thing to the owner." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


