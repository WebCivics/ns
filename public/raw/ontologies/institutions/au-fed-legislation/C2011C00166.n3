    values:partOf concept:act-sch-2-sec-62 ;
    skos:note "The Commonwealth must pay reasonable compensation for damage or corruption. Commissioner does not have to take steps if proceedings are instituted before end of 60 days or thing is retained due to an order under section 3ZQZ. Commissioner does not have to take steps if thing may be retained, destroyed or disposed of under a law or court order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
