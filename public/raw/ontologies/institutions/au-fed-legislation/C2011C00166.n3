    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Establishes a temporal relation between the conviction and the association." ;
    cml:premiseText "(a) the first person has previously been convicted of an offence against subsection (1); and (b) the first person associates with another person (the second person);" ;
    cml:conclusionText "The conviction occurred before the association." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

