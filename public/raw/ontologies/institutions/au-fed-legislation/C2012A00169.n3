    values:partOf concept:c2012a00169-sch-3-sec-4 ;
    skos:note "Reference to appealing to a designated court is permitted if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
