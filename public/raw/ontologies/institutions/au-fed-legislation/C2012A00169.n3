    cml:modality cml:Diffusion ;
    cml:operator "=>" ;
    cml:logicSummary "Implication" ;
    cml:premiseText "Society or association being a registered charity implies that hospital carried on by society or association can be shared with others." ;
    cml:conclusionText "If society or association is not a registered charity, then hospital carried on by society or association cannot be shared with others." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

