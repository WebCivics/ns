    cml:modality cml:CogAI ;
    cml:operator "=>" ;
    cml:logicSummary "Implication" ;
    cml:premiseText "Society or association being a registered charity implies that hospital carried on by society or association can be automated." ;
    cml:conclusionText "If society or association is not a registered charity, then hospital carried on by society or association cannot be automated." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


