concept:c2012a00169-sch-3-sec-4-ss-2-norm a values:Permission ;
    cml:modality cml:Deontic ;
    values:partOf concept:c2012a00169-sch-3-sec-4-ss-2 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:c2012a00169-sch-3-sec-4-ss-2 cml:asserts concept:c2012a00169-sch-3-sec-4-ss-2-logic-deontic-1 .
concept:c2012a00169-sch-3-sec-4-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permit" ;
    cml:logicSummary "Permission to appeal to a designated court." ;
    cml:premiseText "(a) the person may appeal to the designated court against an objection decision under that Act (the ACNC objection decision); and (b) the objection decision mentioned in subsection (1) (the taxation objection decision) and the ACNC objection decision are related, or it would be efficient for the designated court to consider the decisions together." ;
    cml:conclusionText "(2) Treat a reference in subsection (1) to appealing to the Federal Court as being a reference to appealing to a designated court (within the meaning of the Australian Charities and Not-for-profits Commission Act 2012)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2012a00169-sch-3-sec-4-ss-2 cml:asserts concept:c2012a00169-sch-3-sec-4-ss-2-logic-descriptionlogic-2 .
concept:c2012a00169-sch-3-sec-4-ss-2-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classification of courts within the Australian Charities and Not-for-profits Commission Act 2012." ;
    cml:premiseText "designated court means the Federal Court of Australia or a Supreme Court of a State or Territory that has jurisdiction in relation to matters arising under that Act." ;
    cml:conclusionText "the Federal Court of Australia or a Supreme Court of a State or Territory" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

