concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2 cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-1 .
concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "excludes" ;
    cml:logicSummary "Exclusion of evidence based on criminal activity" ;
    cml:premiseText "(2) In determining whether evidence should be admitted or excluded in any proceedings..." ;
    cml:conclusionText "The fact that the evidence was obtained as a result of a person engaging in criminal activity is to be disregarded..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2 cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-alleninterval-2 .
concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "overlaps" ;
    cml:logicSummary "Temporal overlap between controlled operations and criminal activities" ;
    cml:premiseText "(ii) the person was a participant in an operation authorized under a corresponding State controlled operations law acting in the course of that operation..." ;
    cml:conclusionText "The criminal activity was conduct constituting an offence for which a person would, but for section 15HH, be criminally responsible." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2 cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-3 .
concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "includes" ;
    cml:logicSummary "Inclusion of certain conditions in the exclusion of evidence" ;
    cml:premiseText "(a) both: ComLaw Authoritative Act C2012C00115..." ;
    cml:conclusionText "The fact that the evidence was obtained as a result of a person engaging in criminal activity is to be disregarded if... (i) the person was a participant in a controlled operation authorized under this Part acting in the course of the controlled operation; and (ii) the criminal activity was controlled conduct." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2 cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-4 .
concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "includes" ;
    cml:logicSummary "Inclusion of certain conditions in the exclusion of evidence" ;
    cml:premiseText "(b) both: ComLaw Authoritative Act C2012C00115..." ;
    cml:conclusionText "The fact that the evidence was obtained as a result of a person engaging in criminal activity is to be disregarded if... (i) the person was a participant in an operation authorized under a corresponding State controlled operations law acting in the course of that operation; and (ii) the criminal activity was conduct constituting an offence for which a person would, but for section 15HH, be criminally responsible." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


