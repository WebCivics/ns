    cml:conclusionText "and (c) the acquisition or use is not both: (i) in accordance with an authority; and (ii) in the course of duty;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

