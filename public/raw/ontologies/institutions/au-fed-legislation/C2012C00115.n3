    cml:modality cml:Deontic ;
    cml:operator "N" ;
    cml:logicSummary "Negative obligation" ;
    cml:premiseText "Given a freezing order, the institution must not be given a copy of the order after the end of the first working day." ;
    cml:conclusionText "The order does not come into force if the copy is given after that time." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
