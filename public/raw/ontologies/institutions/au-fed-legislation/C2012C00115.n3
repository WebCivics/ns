    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal interval between order and institution" ;
    cml:premiseText "The order does not come into force if the copy is given to the institution after the end of the first working day." ;
    cml:conclusionText "This temporal relation must be greater than or equal to one working day." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

