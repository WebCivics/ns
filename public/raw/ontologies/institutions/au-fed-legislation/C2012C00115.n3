    cml:operator "must" ;
    cml:logicSummary "Participant must not induce a Commonwealth offence or an offence under a law of a State or Territory." ;
    cml:premiseText "(c) the conduct does not involve the participant intentionally inducing a person to commit a Commonwealth offence or an offence under a law of a State or Territory that the person would not otherwise have intended to commit;" ;
    cml:conclusionText "The participant must not induce." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

