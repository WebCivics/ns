    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Acquiring or using an assumed identity without authority is prohibited." ;
    cml:premiseText "(a) the person is an authorised person (other than an authorised civilian); and (b) the person acquires evidence of, or uses, an assumed identity;" ;
    cml:conclusionText "(c) the acquisition or use is not both: (i) in accordance with an authority; and (ii) in the course of duty;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

