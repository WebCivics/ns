concept:act-sch-2-sec-11-2 a cml:Concept ;
    skos:prefLabel "11 References to acquisition, supply and re-supply"@en ;
    cml:realizedBy doc:sch-2-sec-11-2 ;
    cml:integrityHash "2f660f29a42b253e4d9ddae46b6ed40fee4ab07518bf6e4790ab6bd9c249ecb7" ;
    skos:note "Definitions for references to acquisition, supply and re-supply" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.43" ;
    cml:asserts concept:act-sch-2-sec-11-2-norm .
concept:act-sch-2-sec-11-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-11-2 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-2-sec-11-2 cml:asserts concept:act-sch-2-sec-11-2-logic-descriptionlogic-1 .
concept:act-sch-2-sec-11-2-logic-descriptionlogic-1 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy definition" ;
    cml:premiseText "a reference to the acquisition of goods includes a reference to the acquisition of property in, or rights in relation to, goods" ;
    cml:conclusionText "The class hierarchy is defined" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-11-2 cml:asserts concept:act-sch-2-sec-11-2-logic-descriptionlogic-2 .
concept:act-sch-2-sec-11-2-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy definition" ;
    cml:premiseText "a reference to the supply or acquisition of services includes a reference to the supply or acquisition of services together with property or other services, or both" ;
    cml:conclusionText "The class hierarchy is defined" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-11-2 cml:asserts concept:act-sch-2-sec-11-2-logic-alleninterval-3 .
concept:act-sch-2-sec-11-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "includes" ;
    cml:logicSummary "Temporal interval definition for supply and re-supply" ;
    cml:premiseText "(i) a supply of the goods to another person in an altered form or condition; and (ii) a supply to another person of goods in which the first-mentioned goods have been incorporated" ;
    cml:conclusionText "The temporal interval includes these events" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-11-2 cml:asserts concept:act-sch-2-sec-11-2-logic-ltl-4 .
concept:act-sch-2-sec-11-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "includes" ;
    cml:logicSummary "Temporal interval definition for re-supply of services" ;
    cml:premiseText "(i) a supply of the original services to another person in an altered form or condition; and (ii) a supply to another person of other services that are substantially similar to the original services, and could not have been supplied if the original services had not been acquired by the person who acquired them from the original supplier" ;
    cml:conclusionText "The temporal interval includes these events" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-11-2 cml:asserts concept:act-sch-2-sec-11-2-logic-deontic-5 .
concept:act-sch-2-sec-11-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Definition of supply and acquisition" ;
    cml:premiseText "a reference to the supply or acquisition of goods or services includes a reference to agreeing to supply or acquire goods or services" ;
    cml:conclusionText "The definition is equal to agreement" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-11-2 cml:asserts concept:act-sch-2-sec-11-2-logic-deontic-6 .
concept:act-sch-2-sec-11-2-logic-deontic-6 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Definition of supply and acquisition" ;
    cml:premiseText "a reference to the supply or acquisition of goods includes a reference to the supply or acquisition of goods together with other property or services, or both" ;
    cml:conclusionText "The definition is equal to combined supply and acquisition" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


