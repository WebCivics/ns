    cml:modality cml:AllenInterval ;
    cml:operator "Within" ;
    cml:logicSummary "Limits the scope of the provisions to within specific temporal intervals." ;
    cml:premiseText "The provisions are to be confined in their operation...within a Territory, between a State and a Territory or between 2 Territories; or..." ;
    cml:conclusionText "...the supply of goods or services to the Commonwealth or an authority or instrumentality of the Commonwealth;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

