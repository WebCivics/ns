concept:act-sch-2-sec-159-2-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of false or misleading representations" ;
    cml:premiseText "The representation is false or misleading in a material particular." ;
    cml:conclusionText "The person commits an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-159-2-ss-1 cml:asserts concept:act-sch-2-sec-159-2-ss-1-logic-alleninterval-2 .
concept:act-sch-2-sec-159-2-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Overlap between business activities and residence" ;
    cml:premiseText "The representation concerns the profitability, risk or any other material aspect of any business activity that the person has represented as one that can be, or can be to a considerable extent, carried on at or from a person’s place of residence." ;
    cml:conclusionText "There is an overlap between the business activities and residence." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

