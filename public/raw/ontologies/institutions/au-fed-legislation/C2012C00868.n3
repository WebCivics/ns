    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the specified provisions from operating beyond their restricted scope." ;
    cml:premiseText "The provisions are to be confined in their operation..." ;
    cml:conclusionText "...to trade or commerce between Australia and places outside Australia; or..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-30 cml:asserts concept:act-sch-5-sec-30-logic-alleninterval-2 .
