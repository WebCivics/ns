    skos:prefLabel "34 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-34-2 ;
    cml:integrityHash "2e2071d5e2733adae3b612cc927ab84a2fe8c08cf79e029e14c14d3fdd1ee0ee" ;
    skos:note "Donation of goods or services for non-promotional purposes is not treated as a supply." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
