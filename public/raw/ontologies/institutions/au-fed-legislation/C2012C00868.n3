    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Defines the temporal interval for the offence." ;
    cml:premiseText "(1) A person commits an offence if:" ;
    cml:conclusionText "The period begins on the day after the card is sent and ends two years after that day;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

