concept:act-sch-2-sec-59-2-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Express warranty obligation for goods supplied in trade or commerce" ;
    cml:premiseText "(1) If: a person supplies, in trade or commerce, goods to a consumer; and the supply does not occur by way of sale by auction;" ;
    cml:conclusionText "there is a guarantee that the manufacturer of the goods will comply with any express warranty given or made by the manufacturer in relation to the goods." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

