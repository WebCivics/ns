    cml:modality cml:Argumentation ;
    cml:operator "Restrict" ;
    cml:logicSummary "Restricts the operation of the provisions to specific types of conduct through argumentative means." ;
    cml:premiseText "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..." ;
    cml:conclusionText "...the supply of goods or services to the Commonwealth or an authority or instrumentality of the Commonwealth;" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


