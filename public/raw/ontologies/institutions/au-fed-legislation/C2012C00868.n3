    values:partOf concept:act-sch-2-sec-157-2 ;
    skos:note "Advertising goods or services at a specified price without reasonable grounds for believing it can be offered at that price for a period and quantity." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
