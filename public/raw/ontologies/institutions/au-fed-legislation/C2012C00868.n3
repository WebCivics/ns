    values:partOf concept:act-sch-2-sec-36-3 ;
    skos:note "Accepting payment for goods or services with intention to supply different goods or services is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
