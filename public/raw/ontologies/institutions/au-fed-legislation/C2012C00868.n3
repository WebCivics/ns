    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy" ;
    cml:premiseText "a reference to a party to a contract, in relation to such a lease or licence, includes a reference to any person bound by, or entitled to the benefit of, any provision contained in the lease or licence" ;
    cml:conclusionText "a reference to a party to a contract includes a reference to any person bound by, or entitled to the benefit of, any provision contained in the lease or licence" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

