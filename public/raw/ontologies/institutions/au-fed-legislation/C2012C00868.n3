concept:act-sch-2-sec-36-3-ss-2-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-36-3-ss-2 ;
    values:borneBy values:Agent ;
    skos:scopeNote "borne by: Agent" ;
    values:deonticStatus values:HeuristicDerived ;
