    cml:modality cml:Diffusion ;
    cml:operator "Spread" ;
    cml:logicSummary "Spreads the restricted scope of the provisions to specific types of conduct." ;
    cml:premiseText "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..." ;
    cml:conclusionText "...trade or commerce within a Territory, between a State and a Territory or between 2 Territories; or..." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

