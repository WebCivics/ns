    cml:operator "Recurring Trace" ;
    cml:logicSummary "Defines the recurring trace for the offence." ;
    cml:premiseText "(1) A person commits an offence if:" ;
    cml:conclusionText "The person must be sent a card at least once every two years;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

