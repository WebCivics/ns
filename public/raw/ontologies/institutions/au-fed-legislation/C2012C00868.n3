    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of non-promotional donations." ;
    cml:premiseText "(a) a donation of goods or services is not treated as a supply of the goods or services unless the donation is for promotional purposes;" ;
    cml:conclusionText "Donation of goods or services for non-promotional purposes is not treated as a supply." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
