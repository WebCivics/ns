    cml:modality cml:Deontic ;
    cml:operator "authorizes" ;
    cml:logicSummary "Describes the authorization required for compliance with the regulation" ;
    cml:premiseText "The regulations require that the person authorizing the placement of an advertisement must also authorize the sending of such documents." ;
    cml:conclusionText "Compliance with the regulation requires authorization from the person placing the advertisement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


