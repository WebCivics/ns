    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-12-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-2-sec-12-3 cml:asserts concept:act-sch-2-sec-12-3-logic-descriptionlogic-1 .
concept:act-sch-2-sec-12-3-logic-descriptionlogic-1 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy" ;
    cml:premiseText "a reference to a contract includes a reference to a lease of, or a licence in respect of, land or a building" ;
    cml:conclusionText "a reference to a contract includes a reference to a lease or licence" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-12-3 cml:asserts concept:act-sch-2-sec-12-3-logic-descriptionlogic-2 .
concept:act-sch-2-sec-12-3-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy" ;
    cml:premiseText "a reference to making or entering into a contract, in relation to such a lease or licence, is a reference to granting or taking the lease or licence" ;
    cml:conclusionText "a reference to making or entering into a contract includes a reference to granting or taking the lease or licence" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
