concept:act-sch-2-sec-112-3-ss-1 a cml:Concept ;
    skos:prefLabel "112(1) Interaction of multiple interim bans"@en ;
    cml:realizedBy doc:sch-2-sec-112-3-ss-1 ;
    cml:integrityHash "2c327331dac4572335c0f422399c2314d21fcbeba2d874fc361abd9c7b83b1b5" ;
    values:partOf concept:act-sch-2-sec-112-3 ;
    skos:note "Original ban ceases to be in force immediately before the Commonwealth ban comes into force." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
