    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-158-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-deontic-1 .
concept:act-sch-2-sec-158-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition" ;
    cml:premiseText "(b) the representation is false or misleading in a material partical;" ;
    cml:conclusionText "The representation must not be false or misleading." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-alleninterval-2 .
concept:act-sch-2-sec-158-3-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Temporal interval for representation" ;
    cml:premiseText "(i) that the person invites (whether by advertisement or otherwise) other persons to engage or participate in, or" ;
    cml:conclusionText "The temporal interval is from the time of invitation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-ltl-3 .
