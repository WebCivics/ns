    cml:operator "Entity Recognition" ;
    cml:logicSummary "Recognizes the entities involved in the offence." ;
    cml:premiseText "(1) A person commits an offence if:" ;
    cml:conclusionText "The person and the card are the relevant entities;" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
