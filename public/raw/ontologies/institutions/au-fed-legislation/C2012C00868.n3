concept:act-sch-2-sec-158-3 a cml:Concept ;
    skos:prefLabel "158 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-158-3 ;
    cml:integrityHash "d8ef56fcaeed61188913ecf08665071af72709e1c6ef3252653d4bb9d58be3b1" ;
    skos:note "False or misleading representation in material aspect of business activity is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
