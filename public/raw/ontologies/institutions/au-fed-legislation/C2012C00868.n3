    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits making misleading representations with respect to future matters." ;
    cml:premiseText "(a) a person makes a representation with respect to any future matter (including the doing of, or the refusing to do, any act); and (b) the person does not have reasonable grounds for making the representation;" ;
