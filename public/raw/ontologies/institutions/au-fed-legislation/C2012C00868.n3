    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "The provision forbids asserting a right to payment for unsolicited goods or services without reasonable cause." ;
    cml:premiseText "A person must not, in trade or commerce, assert a right to payment from another person for unsolicited goods unless the person has reasonable cause to believe that there is a right to the payment." ;
    cml:conclusionText "There is no right to payment without reasonable cause." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

