    cml:modality cml:LTL ;
    cml:operator "Recurring Trace" ;
    cml:logicSummary "Recurring trace for representation" ;
    cml:premiseText "(ii) that requires the performance of work by other persons," ;
    cml:conclusionText "The recurring trace is from the time of requirement." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-deontic-4 .
concept:act-sch-2-sec-158-3-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Strict Liability" ;
    cml:logicSummary "Strict liability for false or misleading representation" ;
    cml:premiseText "(3) Subsections (1) and (2) are offences of strict liability." ;
    cml:conclusionText "The person is strictly liable for the false or misleading representation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-diffusion-5 .
concept:act-sch-2-sec-158-3-logic-diffusion-5 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuse" ;
    cml:logicSummary "Diffusion of penalty" ;
    cml:premiseText "(a) if the person is a body corporate—$1,100,000;" ;
    cml:conclusionText "The penalty is diffused to all persons who are bodies corporate." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


