    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Manufacturer has an obligation to compensate a person for loss or damage caused by safety defect." ;
    cml:premiseText "(1) A manufacturer of goods is liable to compensate a person if..." ;
    cml:conclusionText "...the person suffers loss or damage as a result of the destruction or damage." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
