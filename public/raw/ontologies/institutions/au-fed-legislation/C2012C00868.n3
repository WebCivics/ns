concept:act-sch-2-sec-165-2-ss-1 a cml:Concept ;
    skos:prefLabel "165(1) Multiple pricing"@en ;
    cml:realizedBy doc:sch-2-sec-165-2-ss-1 ;
    cml:integrityHash "6548a85825b61208c943c1f386fd483a58d553a43b7c1cb7c277245204be47e2" ;
    values:partOf concept:act-sch-2-sec-165-2 ;
    skos:note "Supplying goods with more than one displayed price is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
