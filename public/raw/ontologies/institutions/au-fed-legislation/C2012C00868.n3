    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibition on asserting a right to payment without reasonable cause." ;
    cml:premiseText "A person must not assert a right to payment from another person for unsolicited goods unless the person has reasonable cause to believe that there is a right to the payment." ;
    cml:conclusionText "There is no right to payment without reasonable cause." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-40-3-ss-1 cml:asserts concept:act-sch-2-sec-40-3-ss-1-logic-deontic-2 .
