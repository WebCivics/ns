concept:act-sch-2-sec-140g a cml:Concept ;
    skos:prefLabel "140G When an application law imposes a duty"@en ;
    cml:realizedBy doc:sch-2-sec-140g ;
    cml:integrityHash "d83b448128b4fe190cf7ca4d4d2bdae50fbcab24806269c1e54b0d670f7ca336" ;
    skos:note "Application law imposes a duty on Commonwealth entity if it confers a function or power and gives rise to an obligation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.344" ;
    cml:asserts concept:act-sch-2-sec-140g-norm .
concept:act-sch-2-sec-140g-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-140g ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-2-sec-140g cml:asserts concept:act-sch-2-sec-140g-logic-deontic-1 .
concept:act-sch-2-sec-140g-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the law confers a function or power, then it imposes an obligation." ;
    cml:premiseText "The law confers a function or power." ;
    cml:conclusionText "Therefore, it imposes an obligation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-140g cml:asserts concept:act-sch-2-sec-140g-logic-deontic-2 .
concept:act-sch-2-sec-140g-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the circumstances in which the function or power is conferred give rise to an obligation, then the law imposes a duty." ;
    cml:premiseText "The circumstances give rise to an obligation." ;
    cml:conclusionText "Therefore, the law imposes a duty." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-140g cml:asserts concept:act-sch-2-sec-140g-logic-deontic-3 .
concept:act-sch-2-sec-140g-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the law confers a function or power and gives rise to an obligation, then it imposes a duty on Commonwealth entity." ;
    cml:premiseText "The law confers a function or power." ;
    cml:conclusionText "Therefore, it imposes a duty." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-140g cml:asserts concept:act-sch-2-sec-140g-logic-deontic-4 .
concept:act-sch-2-sec-140g-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the circumstances in which the function or power is conferred give rise to an obligation, then Commonwealth entity must perform the function or exercise the power." ;
    cml:premiseText "The circumstances give rise to an obligation." ;
    cml:conclusionText "Therefore, it must perform the function or exercise the power." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-140g cml:asserts concept:act-sch-2-sec-140g-logic-deontic-5 .
concept:act-sch-2-sec-140g-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "If the law confers a function or power and gives rise to an obligation, then Commonwealth entity has a right to perform the function or exercise the power." ;
    cml:premiseText "The law confers a function or power." ;
    cml:conclusionText "Therefore, it has a right to perform the function or exercise the power." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


