    cml:asserts concept:act-sch-4-sec-356-ss-8-norm .
concept:act-sch-4-sec-356-ss-8-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-4-sec-356-ss-8 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-4-sec-356-ss-8 cml:asserts concept:act-sch-4-sec-356-ss-8-logic-deontic-1 .
concept:act-sch-4-sec-356-ss-8-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Non-party bound by order." ;
    cml:premiseText "(a) an order is made under subsection (1) against a person; and (b) the loss or damage suffered, or likely to be suffered, by a non-party..." ;
    cml:conclusionText "then: (d) the non-party is bound by the order;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-4-sec-356-ss-8 cml:asserts concept:act-sch-4-sec-356-ss-8-logic-deontic-2 .
concept:act-sch-4-sec-356-ss-8-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "No claim, action, or demand may be made against person." ;
    cml:premiseText "(f) despite any other provision of this Act or any other law of the Commonwealth, or a State or Territory..." ;
    cml:conclusionText "no claim, action or demand may be made or taken against the person by the non-party in relation to that loss or damage." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-4-sec-356-ss-8 cml:asserts concept:act-sch-4-sec-356-ss-8-logic-alleninterval-3 .
concept:act-sch-4-sec-356-ss-8-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Redress, prevention, or reduction of loss or damage." ;
    cml:premiseText "(b) the loss or damage suffered, or likely to be suffered, by a non-party..." ;
    cml:conclusionText "in accordance with the order;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-4-sec-356-ss-8 cml:asserts concept:act-sch-4-sec-356-ss-8-logic-ltl-4 .
concept:act-sch-4-sec-356-ss-8-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Redress, prevention, or reduction of loss or damage." ;
    cml:premiseText "(b) the loss or damage suffered, or likely to be suffered, by a non-party..." ;
    cml:conclusionText "has been redressed, prevented or reduced in accordance with the order;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-4-sec-356-ss-8 cml:asserts concept:act-sch-4-sec-356-ss-8-logic-deontic-5 .
concept:act-sch-4-sec-356-ss-8-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Non-party accepts redress, prevention, or reduction." ;
    cml:premiseText "(c) the non-party has accepted the redress, prevention or reduction;" ;
    cml:conclusionText "then: (d) the non-party is bound by the order;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


