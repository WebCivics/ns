    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "a reference to making or entering into a contract includes a reference to granting or taking the lease or licence" ;
    cml:conclusionText "the event of making or entering into a contract occurs after the event of granting or taking the lease or licence" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

