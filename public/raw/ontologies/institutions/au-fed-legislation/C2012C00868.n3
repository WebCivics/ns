    cml:asserts concept:act-sch-2-sec-165-2-ss-1-norm .
concept:act-sch-2-sec-165-2-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-165-2-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-2-sec-165-2-ss-1 cml:asserts concept:act-sch-2-sec-165-2-ss-1-logic-deontic-1 .
concept:act-sch-2-sec-165-2-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits supplying goods with more than one displayed price." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person, in trade or commerce, supplies goods; and  (b) the goods have more than one displayed price; and  (c) the supply takes place for a price that is not the lower, or lowest, of the displayed prices." ;
    cml:conclusionText "(a) if the person is a body corporate—$5,000; or  (b) if the person is not a body corporate—$1,000." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

