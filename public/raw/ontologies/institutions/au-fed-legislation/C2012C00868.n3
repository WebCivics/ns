    values:partOf concept:act-sch-4-sec-356 ;
    skos:note "Non-party bound by order if loss or damage is redressed, prevented, or reduced." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
