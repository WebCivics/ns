concept:act-sch-2-sec-60-2-ss-5 cml:asserts concept:act-sch-2-sec-60-2-ss-5-logic-deontic-1 .
concept:act-sch-2-sec-60-2-ss-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "excuse" ;
    cml:logicSummary "Excuse for non-supply due to circumstances beyond control." ;
    cml:premiseText "(a) the person’s failure to supply all the goods or services within the period, or within a reasonable time, was due to the act or omission of another person, or to some other cause beyond the person’s control;" ;
    cml:conclusionText "(b) the person took reasonable precautions and exercised due diligence to avoid the failure." ;
    cml:executionSurface "modalities::logic::deontic" ;
