    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Repetition of false or misleading representations" ;
    cml:premiseText "The representation is false or misleading in a material particular." ;
    cml:conclusionText "The person commits an offence repeatedly." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


