    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If an act is both an offense under the Australian Consumer Law and a State law, then prosecution for one does not imply prosecution for the other." ;
    cml:premiseText "(3) Despite subsection (1):" ;
    cml:conclusionText "he or she is not liable to be convicted of the other of those offenses." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

