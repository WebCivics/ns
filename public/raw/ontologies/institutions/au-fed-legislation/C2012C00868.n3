concept:act-sch-2-sec-69-2-ss-1a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Consumer has not invited the dealer to come to that place or make a telephone call." ;
    cml:premiseText "(1A) The consumer is not taken, for the purposes of subsection (1)(c), to have invited the dealer to come to that place, or to make a telephone call." ;
    cml:conclusionText "The consumer has not invited the dealer to come to that place or make a telephone call." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-69-2-ss-1a cml:asserts concept:act-sch-2-sec-69-2-ss-1a-logic-linearlogic-2 .
concept:act-sch-2-sec-69-2-ss-1a-logic-linearlogic-2 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "Implication" ;
    cml:logicSummary "Consumer has not invited the dealer to come to that place or make a telephone call if the consumer has given their name or contact details for another purpose." ;
    cml:premiseText "(a) given his or her name or contact details other than for the predominant purpose of entering into negotiations relating to the supply of the goods or services referred to in subsection (1)(c);" ;
    cml:conclusionText "Consumer has not invited the dealer to come to that place or make a telephone call if the consumer has given their name or contact details for another purpose." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-69-2-ss-1a cml:asserts concept:act-sch-2-sec-69-2-ss-1a-logic-linearlogic-3 .
