    cml:modality cml:Deontic ;
    values:partOf concept:c2012c00870-sch-1-sec-40-2-ss-5 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:c2012c00870-sch-1-sec-40-2-ss-5 cml:asserts concept:c2012c00870-sch-1-sec-40-2-ss-5-logic-deontic-1 .
concept:c2012c00870-sch-1-sec-40-2-ss-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits removal of material from statement in Register." ;
    cml:premiseText "(a) publication of particular material contained in a statement could reasonably be expected to prejudice substantially the commercial interests of a person; and (b) the prejudice outweighs the public interest in the publication of the matter;" ;
    cml:conclusionText "the Commission may remove the material from the version of the statement that is included in the Register." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

