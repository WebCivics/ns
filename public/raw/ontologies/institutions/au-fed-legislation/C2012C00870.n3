    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Commission's reasonable grounds are a temporal interval that must be considered." ;
    cml:premiseText "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe..." ;
    cml:conclusionText "The Commission's decision is contingent on the duration of its reasonable grounds." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

