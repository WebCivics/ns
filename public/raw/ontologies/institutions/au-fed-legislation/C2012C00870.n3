concept:c2012c00870-sch-1-sec-155-ss-1 a cml:Concept ;
    skos:prefLabel "155(1) When a person is in a position to exercise control of a network"@en ;
    cml:realizedBy doc:sch-1-sec-155-ss-1 ;
    cml:integrityHash "99257b827d424080ee26b0e21c4329e07c49336901f01252b17d65260bd6d219" ;
    values:partOf concept:c2012c00870-sch-1-sec-155 ;
    skos:note "A person is in a position to exercise control of a telecommunications network if they meet certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012c00870.pdf> ;
