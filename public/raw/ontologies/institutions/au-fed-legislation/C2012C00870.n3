    values:partOf concept:c2012c00870-sch-1-sec-40-2 ;
    skos:note "Commission may remove material from statement in Register if it prejudices substantially commercial interests and outweighs public interest." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
