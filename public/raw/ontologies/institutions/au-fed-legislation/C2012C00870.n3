    cml:modality cml:AllenInterval ;
    cml:operator "disjoint" ;
    cml:logicSummary "Temporal disjointness" ;
    cml:premiseText "(a) they do not act together in any relevant dealings relating to the network or company;" ;
    cml:conclusionText "the conditions in (a) and (b) are met." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
