    cml:logicSummary "Commission has an obligation to ensure access seeker complies with terms and conditions." ;
    cml:premiseText "Subsection (4G) does not prevent discrimination against an access seeker." ;
    cml:conclusionText "The Commission must take reasonable grounds into account when determining whether the access seeker would comply with the terms and conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
