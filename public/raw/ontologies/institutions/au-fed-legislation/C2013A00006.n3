    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition on committing offence with cruel treatment or danger of death." ;
    cml:premiseText "(b) the offender, in committing the offence, subjects the victim to cruel, inhuman or degrading treatment;" ;
    cml:conclusionText "Imprisonment for 7 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
