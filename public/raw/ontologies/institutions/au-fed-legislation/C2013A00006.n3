    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits conduct causing forced labour." ;
    cml:premiseText "(a) the person engages in conduct; and (b) the conduct causes another person to enter into or remain in forced labour." ;
    cml:conclusionText "The conduct is prohibited." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
