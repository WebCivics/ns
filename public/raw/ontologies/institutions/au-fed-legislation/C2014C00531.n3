    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If a determination reduces the benefit to an employee under an enterprise agreement, then it has no effect." ;
    cml:premiseText "(2) A determination under subsection (1) is of no effect to the extent that it would reduce the benefit to an Australian Civilian Corps employee of an individual term or condition applicable to the employee under an enterprise agreement." ;
    cml:conclusionText "(2) A determination under subsection (1) is of no effect." ;
    cml:executionSurface "modalities::logic::deontic" ;
