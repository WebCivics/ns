concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "hasPriority" ;
    cml:logicSummary "Has priority over other encumbrances." ;
    cml:premiseText "(3) The charge:  (a) is subject to every *encumbrance on the property (other than an encumbrance in which the person referred to in paragraph (1)(a) has an *interest) that came into existence before the charge and that would, apart from this subsection, have priority over the charge; and  (b) has priority over all other encumbrances; and  (c) subject to subsection (2), is not affected by any change of ownership of the property." ;
    cml:conclusionText "(3) The charge:  (a) is subject to every *encumbrance on the property (other than an encumbrance in which the person referred to in paragraph (1)(a) has an *interest) that came into existence before the charge and that would, apart from this subsection, have priority over the charge; and" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

