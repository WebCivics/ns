    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Temporal interval for data retention plan implementation phase" ;
    cml:premiseText "(a) comes into force when the Communications Access Co-ordinator notifies the service provider of the approval of the plan; (b) ceases to be in force in relation to that service: ..." ;
