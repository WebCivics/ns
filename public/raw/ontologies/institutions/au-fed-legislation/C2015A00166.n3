    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits ceasing to be an Australian citizen under certain conditions." ;
    cml:premiseText "(a) the person is a national or citizen of a country other than Australia; and (b) the person: ComLaw Authoritative Act C2015A00166  Main amendments  Schedule 1  No. 166, 2015" ;
    cml:conclusionText "ceases to be an Australian citizen if serves in armed forces of enemy country or fights for declared terrorist organisation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

