    cml:operator "Until" ;
    cml:logicSummary "The temporal interval of a person's citizenship status is until the specified conditions are met" ;
    cml:premiseText "The temporal interval of a person's citizenship status is defined as the period during which they are considered to be a citizen." ;
    cml:conclusionText "A person's citizenship is not taken to have ceased under this section if certain conditions are met." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

