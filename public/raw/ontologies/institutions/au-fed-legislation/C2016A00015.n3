    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of making, altering, destroying or concealing an accounting document." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person:  (i) makes, alters, destroys or conceals an accounting document;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
