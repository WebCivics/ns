    cml:conclusionText "The temporal interval of hostage-taking overlaps with the temporal intervals of offences punishable by imprisonment for life or for any lesser term" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

