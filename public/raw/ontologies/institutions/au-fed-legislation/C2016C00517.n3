    cml:operator "obligation" ;
    cml:logicSummary "Obligation to commit an act of hostage-taking" ;
    cml:premiseText "(1) A person who, at any time after the Convention enters into force for Australia, commits an act of hostage-taking." ;
    cml:conclusionText "A person who commits an act of hostage-taking after the Convention enters into force for Australia commits an offence against this subsection." ;
    cml:executionSurface "modalities::logic::deontic" ;
