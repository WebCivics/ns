concept:crimes-hostages-act-1989-sec-3 cml:asserts concept:crimes-hostages-act-1989-sec-3-logic-descriptionlogic-2 .
concept:crimes-hostages-act-1989-sec-3-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy for Australian aircraft and coastal sea" ;
    cml:premiseText "(Australian aircraft) = (an aircraft registered under regulations made under the Civil Aviation Act 1988) or (an aircraft that is owned by, or is in the possession or control of, the Commonwealth or an authority of the Commonwealth) or (an aircraft of any part of the Defence Force)" ;
    cml:conclusionText "(Australian coastal sea) = (the territorial sea of Australia) and (the sea on the landward side of the territorial sea of Australia)" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


