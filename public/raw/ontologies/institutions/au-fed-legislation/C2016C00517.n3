    values:partOf concept:crimes-hostages-act-1989-sec-8 ;
    skos:note "Subject to section 9, a person shall not be charged with an offence against this Act unless certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
