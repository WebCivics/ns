concept:crimes-hostages-act-1989-sec-8-ss-3 cml:asserts concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-1 .
concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If the act was committed outside Australia, then the person must be an Australian citizen." ;
    cml:premiseText "(ii) The person is not an Australian citizen." ;
    cml:conclusionText "(i) The person is an Australian citizen." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-hostages-act-1989-sec-8-ss-3 cml:asserts concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-2 .
concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If the act was committed outside Australia, then the person must be present in Australia." ;
    cml:premiseText "(ii) The person is not present in Australia." ;
    cml:conclusionText "(i) The person is present in Australia." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-hostages-act-1989-sec-8-ss-3 cml:asserts concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-3 .
concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If the act was committed outside Australia, then the act must be committed to compel a legislative, executive or judicial institution in Australia." ;
    cml:premiseText "(iii) The person is not committing the act to compel an institution." ;
    cml:conclusionText "(i) The act is committed to compel an institution." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-hostages-act-1989-sec-8-ss-3 cml:asserts concept:crimes-hostages-act-1989-sec-8-ss-3-logic-alleninterval-4 .
