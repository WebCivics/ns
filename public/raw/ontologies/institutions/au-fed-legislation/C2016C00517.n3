concept:crimes-hostages-act-1989-sec-8-ss-2 cml:asserts concept:crimes-hostages-act-1989-sec-8-ss-2-logic-linearlogic-2 .
concept:crimes-hostages-act-1989-sec-8-ss-2-logic-linearlogic-2 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "Implication" ;
    cml:logicSummary "Implies that hostage-taking is an offence if it is punishable by imprisonment for life or for any lesser term" ;
    cml:premiseText "(2) The punishment for an offence against subsection (1) is imprisonment for life or for any lesser term." ;
    cml:conclusionText "If the punishment for an offence against subsection (1) includes imprisonment for life or for any lesser term, then hostage-taking is an offence" ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

