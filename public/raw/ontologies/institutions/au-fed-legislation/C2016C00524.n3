    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "Implies no conviction under this Act if convicted abroad" ;
    cml:premiseText "(3) Where a person has been convicted of an offence under the law of a country outside Australia in respect of any conduct, that person is not liable to be convicted of an offence against this Act in respect of that conduct." ;
    cml:conclusionText "If A, then not B" ;
    cml:executionSurface "modalities::logic::deontic" ;
