concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2-ss-2 a cml:Concept ;
    skos:prefLabel "2(2) Subsections 255(1) to (4) of Schedule 2"@en ;
    cml:realizedBy doc:sch-1-sec-2-ss-2 ;
    cml:integrityHash "9d2fb6c304808dc6531bd2081f70c07d0371438543c90e93bb521e8ee943cdba" ;
    values:partOf concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2 ;
    skos:note "Goods must meet specific requirements to be considered substantially transformed in a country." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-country-of-origin-act-2017.pdf> ;
