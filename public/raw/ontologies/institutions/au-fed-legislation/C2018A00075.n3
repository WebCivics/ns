    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to prevent misconduct" ;
    cml:premiseText "Commonwealth entity has the meaning given by section 10 of the Public Governance, Performance and Accountability Act 2013." ;
    cml:conclusionText "Preventing, detecting, investigating or dealing with misconduct of a serious nature." ;
    cml:executionSurface "modalities::logic::deontic" ;
