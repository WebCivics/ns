concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1 cml:asserts concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-descriptionlogic-2 .
concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "ClassInclusion" ;
    cml:logicSummary "Target entity is an APP entity as defined in section 6 of the Privacy Act 1988." ;
    cml:premiseText "A target entity is an APP entity as defined in section 6 of the Privacy Act 1988, because it is either an agency or an organisation for the purposes of that Act (as a wholly-owned Commonwealth company is an organisation as defined in section 6C of that Act)." ;
    cml:conclusionText "Target entity means: ... (a) a Privacy Act agency; or (b) a wholly-owned Commonwealth company." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1 cml:asserts concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-alleninterval-3 .
concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Temporal intervals for dealing with misconduct" ;
    cml:premiseText "An integrity purpose relating to misconduct of a person covered by a subparagraph of paragraph (a) does not cease to exist merely because the person ceases to be covered by that subparagraph after the misconduct occurs." ;
    cml:conclusionText "Dealing with misconduct may occur at any time before or after the misconduct occurs." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1 cml:asserts concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-ltl-4 .
concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Repeating actions for dealing with misconduct" ;
    cml:premiseText "Taking legal proceedings, disciplinary proceedings or other administrative action is an example of dealing with matters described in paragraphs (a), (b), (c) and (d)." ;
    cml:conclusionText "Dealing with misconduct may involve repeating actions such as taking legal proceedings." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1 cml:asserts concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-diffusion-5 .
