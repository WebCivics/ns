    cml:modality cml:Deontic ;
    cml:operator "delegation" ;
    cml:logicSummary "Commissioner's delegation of powers, functions or duties to an AFP employee." ;
    cml:premiseText "The Commissioner has delegated one or more powers, functions or duties under subsection (3)." ;
    cml:conclusionText "The Commissioner is taken to have delegated the powers, functions or duties mentioned in paragraph (a) to the AFP employee mentioned in paragraph (b)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

