    cml:operator "Implication" ;
    cml:logicSummary "Concurrent operation requirement for the Territory Plan" ;
    cml:premiseText "The Territory Plan shall be taken to be consistent with the National Capital Plan to the extent it is capable of operating concurrently." ;
