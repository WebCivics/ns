    cml:premiseText "Amounts may be debited from the Account for the purposes of the Account, which include paying the costs of making investments." ;
    cml:conclusionText "The Minister MUST determine that the balance of the Account be reduced." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-business-securitisation-fund-act-2019-sec-9 cml:asserts concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-3 .
concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide" ;
    cml:premiseText "A total of $2 billion must be credited to the Account, with an initial amount of $250 million credited on 1 July 2019 and additional amounts credited on each 1 July for the following 4 years." ;
    cml:conclusionText "The Minister MUST determine that additional amounts be credited to the Fund." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-business-securitisation-fund-act-2019-sec-9 cml:asserts concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-4 .
