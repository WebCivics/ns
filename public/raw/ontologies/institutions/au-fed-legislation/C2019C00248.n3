    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Definition of Australian ship" ;
    cml:premiseText "(a) a ship registered in Australia; or (b) a ship that operates, or is controlled, from a base in Australia and is not registered under the law of another country; or (c) a ship that belongs to an arm of the Defence Force." ;
