    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy definition" ;
    cml:premiseText "cooperative scheme means the legislative and administrative scheme for applying and enforcing criminal law in the areas adjacent to the coast of Australia set out in Schedule 1." ;
    cml:conclusionText "substantive criminal law has the same meaning as in clause 1 of Schedule 1." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

