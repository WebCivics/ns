    cml:modality cml:LTL ;
    cml:operator "as reduced by any remissions or reductions under section 19AA" ;
    cml:logicSummary "Temporal relation between parole and sentencing with reduction" ;
    cml:premiseText "(b) the person is expected to be serving a State or Territory sentence on the specified date, as reduced by any remissions or reductions under section 19AA" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
