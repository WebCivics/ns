    cml:modality cml:Deontic ;
    cml:operator "must" ;
    cml:logicSummary "Obligation to decline fixing a non-parole period if conditions are met" ;
    cml:premiseText "(a) the court is satisfied that doing so is appropriate, having regard to (i) the serious nature and circumstances of the offence or offences; (ii) the antecedents of the person" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
