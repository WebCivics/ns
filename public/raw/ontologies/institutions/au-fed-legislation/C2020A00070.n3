concept:c2020a00070-sch-7-sec-4-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Grants prohibition on bail to the specified individuals" ;
    cml:premiseText "(2) In addition to any other matters, in determining whether the bail authority is satisfied that circumstances exist to grant bail to a person..." ;
    cml:conclusionText "The bail authority must not grant bail to the person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-7-sec-4-ss-2 cml:asserts concept:c2020a00070-sch-7-sec-4-ss-2-logic-deontic-2 .
concept:c2020a00070-sch-7-sec-4-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Grants prohibition on granting bail to individuals who would not comply with conditions" ;
    cml:premiseText "(f) if the person has pleaded guilty to the charge in respect of the offence or been convicted of the offence—whether the bail authority considers that the person would not be likely to undertake a rehabilitation program, or not be likely to comply with any bail conditions relating to rehabilitation or treatment, while released on bail." ;
    cml:conclusionText "The bail authority must not grant bail to the person if they would not comply with conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


