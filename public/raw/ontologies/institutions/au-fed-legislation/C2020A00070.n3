concept:c2020a00070-sch-4-sec-474-3-ss-1 a cml:Concept ;
    skos:prefLabel "474(1) Section 474"@en ;
    cml:realizedBy doc:sch-4-sec-474-3-ss-1 ;
    cml:integrityHash "3eaa2a8f6dea6daf4fcdaeff8f6a6522750a6d25abaab4a07d06b5225e2d484c" ;
    values:partOf concept:c2020a00070-sch-4-sec-474-3 ;
    skos:note "Sending unsolicited sexual messages to minors is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2020a00070.pdf> ;
    dc:source "c2020a00070.pdf, p.23" ;
    cml:asserts concept:c2020a00070-sch-4-sec-474-3-ss-1-norm .
concept:c2020a00070-sch-4-sec-474-3-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:c2020a00070-sch-4-sec-474-3-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:c2020a00070-sch-4-sec-474-3-ss-1 cml:asserts concept:c2020a00070-sch-4-sec-474-3-ss-1-logic-deontic-1 .
concept:c2020a00070-sch-4-sec-474-3-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits sending unsolicited sexual messages to minors." ;
    cml:premiseText "(a) the sender uses a carriage service to transmit a communication to another person (the recipient); and (b) the sender does this with the intention of making it easier to procure a person (the child) to engage in sexual activity with the sender; and (c) the child is someone who is, or who the sender believes to be, under 16 years of age;" ;
    cml:conclusionText "(1) A person (the sender) commits an offence if:..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


