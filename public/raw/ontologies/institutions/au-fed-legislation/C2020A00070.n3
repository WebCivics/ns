    cml:integrityHash "1f59976718aac3a4967c1042beed5e629a43c876e8bfe4a5bc056b86dc3b261c" ;
    values:partOf concept:c2020a00070-sch-4-sec-272-2 ;
    skos:note "Prohibition of impossible sexual activity" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
