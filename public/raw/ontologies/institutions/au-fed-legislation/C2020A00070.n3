concept:c2020a00070-sch-4-sec-272-2-ss-3 cml:asserts concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-deontic-1 .
concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Imposes prohibition" ;
    cml:premiseText "(3) A person may be found guilty of an offence against subsection (1)" ;
    cml:conclusionText "A person cannot engage in the sexual activity referred to in subsection (1)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-4-sec-272-2-ss-3 cml:asserts concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-linearlogic-2 .
concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-linearlogic-2 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "Imply" ;
    cml:logicSummary "Implies prohibition of impossible sexual activity" ;
    cml:premiseText "(3) A person may be found guilty of an offence against subsection (1) even if it is impossible for the sexual activity referred to in that subsection to take place." ;
    cml:conclusionText "The person cannot engage in the sexual activity referred to in subsection (1)" ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-4-sec-272-2-ss-3 cml:asserts concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-alleninterval-3 .
