    cml:modality cml:AllenInterval ;
    cml:operator "Within" ;
    cml:logicSummary "Describes the temporal relationship between the section and the prohibited action" ;
    cml:premiseText "(3) A person may be found guilty of an offence against subsection (1) even if it is impossible for the sexual activity referred to in that subsection to take place." ;
    cml:conclusionText "The section applies within the same time frame as the prohibited action" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-4-sec-272-2-ss-3 cml:asserts concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-diffusion-4 .
concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Imply" ;
    cml:logicSummary "Implies diffusion of prohibition through impossible sexual activity" ;
    cml:premiseText "(3) A person may be found guilty of an offence against subsection (1) even if it is impossible for the sexual activity referred to in that subsection to take place." ;
    cml:conclusionText "The section implies that the prohibited action cannot occur" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-4-sec-272-2-ss-3 cml:asserts concept:c2020a00070-sch-4-sec-272-2-ss-3-logic-cogai-5 .
