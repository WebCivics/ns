    cml:modality cml:CogAI ;
    cml:operator "Classify" ;
    cml:logicSummary "Classifies the section as a prohibition using AI" ;
    cml:premiseText "(3) A person may be found guilty of an offence against subsection (1) even if it is impossible for the sexual activity referred to in that subsection to take place." ;
    cml:conclusionText "The section prohibits engaging in the sexual activity referred to in subsection (1)" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


