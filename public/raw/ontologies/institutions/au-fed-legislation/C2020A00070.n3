    cml:modality cml:AllenInterval ;
    cml:operator "on the day after the end of the federal sentence, or the last to be served of the federal sentences" ;
    cml:logicSummary "Temporal relation between parole and sentencing" ;
    cml:premiseText "(b) the person is expected to be serving a State or Territory sentence on the specified date" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
