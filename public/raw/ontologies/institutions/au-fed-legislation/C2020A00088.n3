    cml:operator "Obligation" ;
    cml:logicSummary "Imposes an obligation on the Minister to determine ceasing citizenship." ;
    cml:premiseText "(1) The Minister may determine in writing that a person aged 14 or older ceases to be an Australian citizen if..." ;
    cml:conclusionText "...The Minister may determine in writing that a person aged 14 or older ceases to be an Australian citizen if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1 cml:asserts concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1-logic-argumentation-4 .
