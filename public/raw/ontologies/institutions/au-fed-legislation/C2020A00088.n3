concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1 cml:asserts concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1-logic-deontic-1 .
concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits ceasing to be an Australian citizen under specified conditions." ;
    cml:premiseText "(a) the person: (i) engaged in conduct specified in subsection (5) while outside Australia; or (ii) engaged in conduct specified in any of paragraphs (5)(a) to (h) while in Australia, has since left Australia and has not been tried for an offence in relation to the conduct;" ;
    cml:conclusionText "(1) The Minister may determine in writing that a person aged 14 or older ceases to be an Australian citizen if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1 cml:asserts concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1-logic-alleninterval-2 .
concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Defines a temporal interval for ceasing citizenship." ;
    cml:premiseText "(c) it would be contrary to the public interest for the person to remain an Australian citizen (see section 36E)." ;
    cml:conclusionText "...and (c) it would be contrary to the public interest for the person to remain an Australian citizen;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1 cml:asserts concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36b-ss-1-logic-deontic-3 .
