    cml:modality cml:Deontic ;
    cml:operator "Permission" ;
    cml:logicSummary "Allows person to engage in conduct with proceeds of general crime if value exceeds $1,000,000." ;
    cml:premiseText "(e) when the conduct occurs, the value of the money and other property is $1,000,000 or more." ;
    cml:conclusionText "The person has permission to engage in conduct with proceeds of general crime if the value exceeds $1,000,000." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a cml:asserts concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-5 .
