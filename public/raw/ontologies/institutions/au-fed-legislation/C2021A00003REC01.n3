    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Requires person to be negligent about nature of money or property." ;
    cml:premiseText "(c) the person is negligent as to the fact that the money or property is proceeds of general crime;" ;
    cml:conclusionText "The person has a duty to disclose the nature of the money or property." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a cml:asserts concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-alleninterval-3 .
