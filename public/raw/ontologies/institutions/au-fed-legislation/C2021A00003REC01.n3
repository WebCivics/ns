concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits conduct with proceeds of general crime." ;
    cml:premiseText "(a) the person engages in conduct in relation to money or other property; and (b) the money or property is proceeds of general crime;" ;
    cml:conclusionText "The conduct is an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a cml:asserts concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-2 .
