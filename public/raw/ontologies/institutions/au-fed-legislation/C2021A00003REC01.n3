    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits money laundering conduct" ;
    cml:premiseText "(a) the person engages in conduct in relation to money or other property; and (b) the money or property is, and the person believes it to be, proceeds of general crime;" ;
    cml:conclusionText "The person commits an offence if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
