    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines temporal interval for conduct with proceeds of general crime." ;
    cml:premiseText "(e) when the conduct occurs, the value of the money and other property is $1,000,000 or more." ;
    cml:conclusionText "The conduct occurs within a specific temporal interval." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a cml:asserts concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-4 .
