    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Time has passed since application could be made under section 95 of the Family Law Act 1975" ;
    cml:premiseText "on the day before the commencement day, an application for special leave to appeal could be made under section 95 of the Family Law Act 1975;" ;
    cml:conclusionText "Application may be made" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-25 cml:asserts concept:c2021a00013rec01-sch-5-sec-25-logic-ltl-3 .
