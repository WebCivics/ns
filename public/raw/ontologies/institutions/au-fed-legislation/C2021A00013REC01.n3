concept:c2021a00013rec01-sch-5-sec-1 cml:asserts concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-2 .
concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "Family Court of a State means a court to which section 41 of the Family Law Act 1975, as amended by this Act, applies." ;
    cml:conclusionText "Family Court of Australia means the federal court known, immediately before the commencement day, as the Family Court of Australia." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

