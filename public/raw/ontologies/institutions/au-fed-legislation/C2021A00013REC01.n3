    cml:premiseText "(1) If a thing was done by, or in relation to, the Chief Executive Officer..." ;
    cml:conclusionText "...then, despite the repeal of the Federal Circuit Court of Australia Act 1999..." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

