    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies terms into categories" ;
    cml:premiseText "Federal Circuit and Family Court of Australia has the same meaning as in the new law." ;
    cml:conclusionText "Federal Circuit Court of Australia means the federal court known, immediately before the commencement day, as the Federal Circuit Court of Australia." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-1 cml:asserts concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-4 .
