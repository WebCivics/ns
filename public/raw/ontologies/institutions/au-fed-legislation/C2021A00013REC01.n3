    cml:premiseText "If: (a) on the day before the commencement day, an application for special leave to appeal could be made under section 95 of the Family Law Act 1975; and (b) despite the amendments to the Family Law Act 1975 made by this Act, on the commencement day the time for making the application has not ended;" ;
    cml:conclusionText "Application may be made" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

