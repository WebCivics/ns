    cml:operator "according to" ;
    cml:logicSummary "Appeal is determined according to multiple laws" ;
    cml:premiseText "(3) To avoid doubt, the Federal Circuit and Family Court of Australia (Division 1) is to hear and determine..." ;
    cml:conclusionText "...according to: (a) the Federal Circuit and Family Court of Australia Act 2021; and (b) the Family Law Act 1975, as amended by this Act; and (c) any other law of the Commonwealth, as relevant." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
