    cml:logicSummary "Doing a thing includes making an instrument." ;
    cml:premiseText "(3) To avoid doubt, doing a thing includes making an instrument." ;
    cml:conclusionText "...doing a thing includes making an instrument." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

