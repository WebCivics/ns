    cml:premiseText "(a) on the day before the commencement day, either..." ;
    cml:conclusionText "...the appeal or application may be made to the Federal Circuit and Family Court of Australia" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
