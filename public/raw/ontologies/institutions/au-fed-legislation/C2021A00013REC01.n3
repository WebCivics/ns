    cml:modality cml:Deontic ;
    cml:operator "on or after" ;
    cml:logicSummary "Application must be made on or after commencement day" ;
    cml:premiseText "then, on or after the commencement day, the application may be made to the High Court." ;
    cml:conclusionText "Application may be made" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


