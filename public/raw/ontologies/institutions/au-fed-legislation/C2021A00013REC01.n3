concept:c2021a00013rec01-sch-5-sec-13-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Chief Justice must deal with complaint." ;
    cml:premiseText "Complaint made on or after commencement day." ;
    cml:conclusionText "Chief Justice deals with complaint." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-13 cml:asserts concept:c2021a00013rec01-sch-5-sec-13-logic-alleninterval-2 .
concept:c2021a00013rec01-sch-5-sec-13-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Complaint must be made on or after commencement day for Chief Justice to deal with complaint." ;
    cml:premiseText "Complaint must occur before commencement day for Chief Justice not to deal with complaint." ;
    cml:conclusionText "Complaint made on or after commencement day implies Chief Justice deals with complaint." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

