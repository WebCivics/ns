    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "vehicles manufactured on or after a later date prescribed by the scheme rules are considered scheme vehicles" ;
    cml:conclusionText "vehicle is a scheme vehicle if it was manufactured on or after this date" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

