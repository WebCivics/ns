    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "vehicles manufactured on or after January 1, 2002, are considered scheme vehicles" ;
    cml:conclusionText "vehicle is a scheme vehicle if it was manufactured on or after this date" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

