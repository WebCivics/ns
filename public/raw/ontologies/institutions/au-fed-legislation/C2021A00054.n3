    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Scope of scheme vehicle definition" ;
    cml:premiseText "scheme rules prescribe definitions and categories for vehicles" ;
    cml:conclusionText "vehicle is a scheme vehicle if it meets the criteria prescribed by the scheme rules" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00054-sch-1-sec-57ba cml:asserts concept:c2021a00054-sch-1-sec-57ba-logic-deontic-6 .
