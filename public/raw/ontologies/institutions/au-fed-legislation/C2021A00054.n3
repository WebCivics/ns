    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy" ;
    cml:premiseText "scheme rules prescribe definitions and categories for vehicles" ;
    cml:conclusionText "vehicle is a scheme vehicle if it meets these criteria" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
