    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Definition of scheme vehicle" ;
    cml:premiseText "scheme vehicle is defined as a light goods vehicle, passenger vehicle, or another kind of vehicle prescribed by the scheme rules" ;
    cml:conclusionText "vehicle is a scheme vehicle if it meets these criteria" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

