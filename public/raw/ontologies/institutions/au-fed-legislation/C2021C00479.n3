    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibition of refusing to attend a conference after notice." ;
    cml:premiseText "(5) A person commits an offence if:  (a) the person has been given a notice under subsection (3) requiring the person to attend a conference; and  (b) the person refuses or fails to comply with the requirement." ;
    cml:conclusionText "Penalty: 10 penalty units." ;
    cml:executionSurface "modalities::logic::deontic" ;
