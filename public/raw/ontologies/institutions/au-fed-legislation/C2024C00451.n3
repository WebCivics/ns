concept:gene-technology-act-2000-sec-156-ss-3 cml:asserts concept:gene-technology-act-2000-sec-156-ss-3-logic-deontic-1 .
concept:gene-technology-act-2000-sec-156-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits seizure without practicable documentary form or copying" ;
    cml:premiseText "(3) An inspector may seize equipment under paragraph (2)(a) only if: (a) it is not practicable to put the material in documentary form as mentioned in paragraph (2)(b) or to copy the material as mentioned in paragraph (2)(c); or (b) possession by the occupier of the equipment could constitute an offence." ;
    cml:conclusionText "(3) An inspector may seize equipment under paragraph (2)(a) only if: (a) it is not practicable to put the material in documentary form as mentioned in paragraph (2)(b) or to copy the material as mentioned in paragraph (2)(c); or (b) possession by the occupier of the equipment could constitute an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


