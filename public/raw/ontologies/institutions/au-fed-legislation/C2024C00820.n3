    cml:modality cml:Deontic ;
    cml:operator "not-applicable" ;
    cml:logicSummary "No criminal penalty in foreign country" ;
    cml:premiseText "(d) there is not in force, in the foreign country or the part of the foreign country where the conduct constituting the alleged contravention or offence occurred, a law creating a pecuniary or criminal penalty for conduct corresponding to the conduct constituting the alleged contravention or offence." ;
    cml:conclusionText "...if the person is not an Australian entity, an Australian citizen or a permanent resident of Australia..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


