    cml:modality cml:Deontic ;
    cml:operator "exempts" ;
    cml:logicSummary "Exempts from civil penalty" ;
    cml:premiseText "(2) Despite subsection (1), a person does not contravene a civil penalty provision of this Act..." ;
    cml:conclusionText "...if the conduct constituting the alleged contravention or offence occurs wholly in a foreign country..." ;
    cml:executionSurface "modalities::logic::deontic" ;
