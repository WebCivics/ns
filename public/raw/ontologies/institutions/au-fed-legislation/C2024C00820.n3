    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Conduct outside Australia" ;
    cml:premiseText "(b) the conduct constituting the alleged contravention or offence occurs wholly in a foreign country, but not on board an Australian aircraft or Australian ship..." ;
    cml:conclusionText "...if the person is not an Australian entity, an Australian citizen or a permanent resident of Australia..." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
