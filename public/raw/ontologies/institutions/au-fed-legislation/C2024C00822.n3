concept:australian-information-commissioner-act-2010-sec-29-ss-1 a cml:Concept ;
    skos:prefLabel "29(1) Unauthorised dealing with information"@en ;
    cml:realizedBy doc:sec-29-ss-1 ;
    cml:integrityHash "070ebc70d31f679827b96d7c4a57b1efe386a0a8ec9c2778b0a6c4662aca067c" ;
    values:partOf concept:australian-information-commissioner-act-2010-sec-29 ;
    skos:note "Making a record of, disclosing or using information acquired in the course of performing certain functions is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
