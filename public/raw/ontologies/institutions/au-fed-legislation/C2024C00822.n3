concept:australian-information-commissioner-act-2010-sec-29-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:australian-information-commissioner-act-2010-sec-29-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:australian-information-commissioner-act-2010-sec-29-ss-1 cml:asserts concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-deontic-1 .
concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits making a record of, disclosing or using information acquired in the course of performing certain functions." ;
    cml:premiseText "(a) the person makes a record of, discloses or otherwise uses information; and (b) the information was acquired by the person in the course of performing functions or exercising powers conferred for the purposes of an information commissioner function, a freedom of information function or a privacy function." ;
    cml:conclusionText "(1) A person commits an offence if: (a) the person makes a record of, discloses or otherwise uses information; and (b) the information was acquired by the person in the course of performing functions or exercising powers conferred for the purposes of an information commissioner function, a freedom of information function or a privacy function." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

