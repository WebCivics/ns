    cml:operator "Disjointness" ;
    cml:logicSummary "Compliance with requirements and decision validity are independent temporal events." ;
    cml:premiseText "(4) Any failure to comply with the requirements of subsection (3) in relation to a decision does not affect the validity of the decision." ;
    cml:conclusionText "The compliance event is disjoint from the decision validity event." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
