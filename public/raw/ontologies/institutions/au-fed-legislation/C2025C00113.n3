    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Obligation on state" ;
    cml:premiseText "(2) If, for the purposes of the application of this section..." ;
    cml:conclusionText "the value on that day of any of those assets is taken to be the value of the assets concerned as shown in the accounting records of the corporation" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


