    cml:operator "may" ;
    cml:logicSummary "APRA may request variation of reporting document" ;
    cml:premiseText "APRA thinks that a reporting document given to APRA by a financial sector entity is incorrect, incomplete or misleading; or does not comply with a reporting standard that applies to it; or does not contain information, or adequate information, about a matter." ;
    cml:conclusionText "APRA may give the entity written notice requesting it to give APRA in writing such explanation or information as is specified in the notice." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


