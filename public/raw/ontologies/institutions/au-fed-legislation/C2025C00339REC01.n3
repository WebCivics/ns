    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Recurring trace of the person's attempts to evade service of summons." ;
    cml:premiseText "The authorized officer has reasonable grounds to believe that the person is likely to abscond or is otherwise attempting, or likely to attempt, to evade service of the summons." ;
