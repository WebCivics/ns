    cml:modality cml:AllenInterval ;
    cml:operator "Overlap" ;
    cml:logicSummary "Overlaps with the time period during which the person is likely to leave Australia to avoid giving evidence." ;
    cml:premiseText "The authorized officer has reasonable grounds to believe that the person is likely to leave Australia for the purpose of avoiding giving evidence at a hearing before the Integrity Commissioner." ;
    cml:conclusionText "The authorized officer may apply for a warrant to arrest the person if they have not complied with the order or are likely to leave Australia to avoid giving evidence." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

