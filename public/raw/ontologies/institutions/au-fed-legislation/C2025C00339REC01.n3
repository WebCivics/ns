concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am-ss-2 a cml:Concept ;
    skos:prefLabel "19AM(2) Release on parole—when is a person released"@en ;
    cml:realizedBy doc:sch-7-sec-19am-ss-2 ;
    cml:integrityHash "d54dd93cf6ff5844bb72dbb340d93fdbd96525efa9534ace1b4f363bfeb0ff09" ;
    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-7-sec-19am ;
    skos:note "A person must certify acceptance of parole conditions. A person must be released from prison on parole if they are eligible for release under subsection (1) but were imprisoned for a State or Territory offence on the day of eligibility." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
