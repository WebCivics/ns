concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2 a cml:Concept ;
    skos:prefLabel "24AB(2) When returnable items must be returned"@en ;
    cml:realizedBy doc:sch-3-sec-24ab-ss-2 ;
    cml:integrityHash "a4b6cdf2bae08b4619c493ffe802a33e6d092ce76826bc8c091e4de5d6bebb2c" ;
    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab ;
    skos:note "No obligation to take steps if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
