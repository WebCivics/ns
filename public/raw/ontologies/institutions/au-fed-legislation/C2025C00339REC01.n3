concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-4-sec-77a-ss-7-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibits disclosure of notice after investigation concludes and proceedings commence." ;
    cml:premiseText "(7) A notation included in the notice is cancelled by this subsection if: (a) the Integrity Commissioner concludes the investigation to which the notice relates; and (b) any criminal proceedings or civil penalty proceedings resulting from the investigation are commenced." ;
    cml:conclusionText "The disclosure of notice is prohibited." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

