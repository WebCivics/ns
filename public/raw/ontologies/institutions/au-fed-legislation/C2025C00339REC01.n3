    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the person from attempting to evade service of summons." ;
    cml:premiseText "The person is to be served with a summons under section 83." ;
    cml:conclusionText "The authorized officer may apply for a warrant to arrest the person if they have not complied with the order or are likely to leave Australia to avoid giving evidence." ;
    cml:executionSurface "modalities::logic::deontic" ;
