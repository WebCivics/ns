concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2 cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-1 .
concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "EXCEPT" ;
    cml:logicSummary "No obligation if conditions are met" ;
    cml:premiseText "if the returnable item may be retained because of an order under subsection 24AC(2), or any other order under that subsection has been made in relation to the item, then the CEO does not have to take those steps" ;
    cml:conclusionText "the CEO does not have to take those steps if the conditions are met" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2 cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-2 .
concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "EXCEPT" ;
    cml:logicSummary "No obligation if application is pending" ;
    cml:premiseText "if the CEO has applied for such an order and the application has not been determined, then the CEO does not have to take those steps" ;
    cml:conclusionText "the CEO does not have to take those steps if the application is pending" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2 cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-3 .
concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "EXCEPT" ;
    cml:logicSummary "No obligation under law or court order" ;
    cml:premiseText "if the returnable item may otherwise be retained, destroyed or disposed of under a law, or an order of a court or tribunal, of the Commonwealth or of a State or a Territory, then the CEO does not have to take those steps" ;
    cml:conclusionText "the CEO does not have to take those steps if the returnable item is subject to such a law or order" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2 cml:asserts concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-4 .
concept:crimes-legislation-amendment-powers-and-offences-act-2012-sch-3-sec-24ab-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "EXCEPT" ;
    cml:logicSummary "No obligation due to dispute over ownership" ;
    cml:premiseText "if the returnable item is forfeited or forfeitable to the Commonwealth or is the subject of a dispute as to ownership, then the CEO does not have to take those steps" ;
    cml:conclusionText "the CEO does not have to take those steps if there is a dispute over ownership" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


