    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits supplying a medical device without proper authority." ;
    cml:premiseText "(a) the person has been granted an authority under subsection 41HC(1) relating to a specified kind of medical device; and (b) the person supplies a medical device of that kind: ..." ;
    cml:conclusionText "...the supply is not in accordance with the authority; or the supply is not in accordance with the conditions to which the authority is subject; or the supply is not in accordance with regulations made for the purpose of subsection 41HC(5)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
