    cml:modality cml:Diffusion ;
    cml:operator "includes" ;
    cml:logicSummary "The text implies a diffusion of information between convictions and outstanding orders." ;
    cml:premiseText "A court that has found a person to have committed an offence can take action without proceeding to record a conviction." ;
    cml:conclusionText "A reference to a person convicted of an offence includes a reference to a person in respect of whom an order has been made relating to the offence." ;
    cml:executionSurface "modalities::diffusion" ;
