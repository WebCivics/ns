    cml:modality cml:Deontic ;
    cml:operator "Permits" ;
    cml:logicSummary "Imprisonment permits other forms of punishment" ;
    cml:premiseText "(5) Where: ... the person is not liable to be punished by imprisonment for that offence." ;
    cml:conclusionText "If a person would not have been convicted of the offence if subsections (3) and (4) had not been enacted, then they are permitted to receive other forms of punishment" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

