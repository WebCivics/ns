    cml:modality cml:LTL ;
    cml:operator "includes" ;
    cml:logicSummary "The text implies a recurring trace between convictions and outstanding orders." ;
    cml:premiseText "An order has been made relating to the offence under section 19B of the Crimes Act 1914." ;
    cml:conclusionText "A reference to a person convicted of an offence includes a reference to a person in respect of whom an order has been made relating to the offence." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-41et-ss-1a cml:asserts concept:therapeutic-goods-act-1989-sec-41et-ss-1a-logic-diffusion-5 .
