concept:therapeutic-goods-act-1989-sec-41ep-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-41ep-ss-1-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-41ep-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Obligation to revoke suspension" ;
    cml:premiseText "(a) the ground on which the conformity assessment certificate was suspended no longer applies; and (b) there are no other grounds for suspending the certificate." ;
    cml:conclusionText "The Secretary must revoke the suspension." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-41ep-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-41ep-ss-1-logic-alleninterval-2 .
concept:therapeutic-goods-act-1989-sec-41ep-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval of revocation obligation" ;
    cml:premiseText "(1) The Secretary must revoke the suspension if the Secretary is satisfied that: (a) the ground on which the conformity assessment certificate was suspended no longer applies; and (b) there are no other grounds for suspending the certificate." ;
    cml:conclusionText "Revocation obligation applies between specified temporal intervals" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

