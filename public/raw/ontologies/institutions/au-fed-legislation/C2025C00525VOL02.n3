concept:therapeutic-goods-act-1989-sec-41eo-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:therapeutic-goods-act-1989-sec-41eo-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
