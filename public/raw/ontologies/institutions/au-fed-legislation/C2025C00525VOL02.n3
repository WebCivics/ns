concept:therapeutic-goods-act-1989-sec-46a-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of unauthorized entry into residential premises." ;
    cml:premiseText "(2) An authorised person must not, under subsection (1), enter premises that are a residence unless: (a) the occupier of the premises has consented to the entry; or (b) the premises are used for commercial purposes in relation to therapeutic goods or vaping goods, in addition to residential purposes." ;
    cml:conclusionText "(2) An authorised person must not enter premises that are a residence unless: (a) the occupier of the premises has consented to the entry; or (b) the premises are used for commercial purposes in relation to therapeutic goods or vaping goods, in addition to residential purposes." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


