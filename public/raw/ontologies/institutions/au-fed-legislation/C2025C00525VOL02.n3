    cml:modality cml:DescriptionLogic ;
    cml:operator "includes" ;
    cml:logicSummary "The text defines a class hierarchy for persons with outstanding orders." ;
    cml:premiseText "A person convicted of an offence is included in this class." ;
    cml:conclusionText "A reference to a person convicted of an offence includes a reference to a person in respect of whom an order has been made relating to the offence." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:therapeutic-goods-act-1989-sec-41et-ss-1a cml:asserts concept:therapeutic-goods-act-1989-sec-41et-ss-1a-logic-alleninterval-3 .
