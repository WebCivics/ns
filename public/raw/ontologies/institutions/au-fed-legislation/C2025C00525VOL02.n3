    cml:conclusionText "the current Poisons Standard is the document last prepared under paragraph 52D(2)(b)." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

