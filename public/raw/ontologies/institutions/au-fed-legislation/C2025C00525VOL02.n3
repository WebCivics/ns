concept:therapeutic-goods-act-1989-sec-41me-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-41me-ss-1-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-41me-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the manufacture, supply or use of non-exempt medical devices without conformity assessment" ;
    cml:premiseText "(ca) the device is not of a kind covered by an exemption in force under section 41GS; and (d) either: (i) the use of the device has resulted in, will result in, or is likely to result in, harm or injury to any person; or (ii) the use of the device, if the device were used, would result in, or would be likely to result in, harm or injury to any person;" ;
    cml:conclusionText "(1) A person commits an offence..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

