    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of advertising therapeutic goods without compliance with the Therapeutic Goods Advertising Code." ;
    cml:premiseText "(1) A person commits an offence if: (a) the person: (i) advertises, by any means, therapeutic goods; or (ii) causes the advertising, by any means, of therapeutic goods; and" ;
