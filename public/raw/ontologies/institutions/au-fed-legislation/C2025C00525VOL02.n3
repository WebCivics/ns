    cml:modality cml:AllenInterval ;
    cml:operator "includes" ;
    cml:logicSummary "The text implies a temporal relationship between convictions and outstanding orders." ;
    cml:premiseText "An order has been made relating to the offence under section 19B of the Crimes Act 1914." ;
    cml:conclusionText "A reference to a person convicted of an offence includes a reference to a person in respect of whom an order has been made relating to the offence." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

