concept:therapeutic-goods-act-1989-sec-41eo-ss-1 cml:asserts concept:therapeutic-goods-act-1989-sec-41eo-ss-1-logic-deontic-1 .
concept:therapeutic-goods-act-1989-sec-41eo-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "takesEffect" ;
    cml:logicSummary "Suspension takes effect on specified day after notice is given." ;
    cml:premiseText "(1) The suspension takes effect: (a) if the notice under section 41EM states that the suspension is necessary to prevent imminent risk of death, serious illness or serious injury—on the day on which the notice is given to the person; or (b) in any other case—on the day specified for the purpose in the notice, being a day not earlier than 20 working days after the notice is given to the person." ;
    cml:conclusionText "(1) The suspension takes effect: (a) if the notice under section 41EM states that the suspension is necessary to prevent imminent risk of death, serious illness or serious injury—on the day on which the notice is given to the person; or (b) in any other case—on the day specified for the purpose in the notice, being a day not earlier than 20 working days after the notice is given to the person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

