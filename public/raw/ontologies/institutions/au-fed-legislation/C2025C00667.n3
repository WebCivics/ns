concept:australian-communications-and-media-authority-act-2005-sec-39-ss-2 cml:asserts concept:australian-communications-and-media-authority-act-2005-sec-39-ss-2-logic-deontic-1 .
concept:australian-communications-and-media-authority-act-2005-sec-39-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Quorum requirement when a member cannot participate due to rules made under section 29 of the Public Governance, Performance and Accountability Act 2013." ;
    cml:premiseText "(2) However, if: (a) rules made for the purposes of section 29 of the Public Governance, Performance and Accountability Act 2013 prevent a member from participating in the deliberations, or decisions, of the ACMA with respect to a particular matter; and (b) when the member leaves the meeting concerned there is no longer a quorum present;" ;
    cml:conclusionText "the remaining members at the meeting constitute a quorum for the purpose of any deliberation or decision at that meeting with respect to that matter." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

