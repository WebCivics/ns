    cml:premiseText "(2) A person can be appointed as an associate member more than once." ;
    cml:conclusionText "However, a later appointment must not result in the sum of the person’s periods of appointment exceeding 10 years." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


