concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-48b-ss-3 a cml:Concept ;
    skos:prefLabel "48B(3) Subscription contracts"@en ;
    cml:realizedBy doc:sch-1-sec-48b-ss-3 ;
    cml:integrityHash "2f312b1010ce89f61ac79878279097cbd089a9d13c02e39b5808cc6523849deb" ;
    values:partOf concept:competition-and-consumer-amendment-unfair-trading-practices-act-2026-sch-1-sec-48b ;
    skos:note "Contract terms must provide for automatic liability and termination rights." ;
    dc:description "(a) supply of goods or services in a fixed period, (b) supply of goods or services to continue after the end of the fixed period, (c) a person to automatically incur liability to pay for supplies or continuing supply, and (d) a right for that person to end the contract." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
