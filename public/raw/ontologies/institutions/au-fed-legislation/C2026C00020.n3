    cml:modality cml:LTL ;
    cml:operator "Recurring Trace" ;
    cml:logicSummary "Defines recurring traces for conditional exemptions." ;
    cml:premiseText "(a) influencing a decision or action of a person or entity; or (b) giving a person (or class of persons) an undue benefit or detriment, in relation to business carried on by the person (or class), by providing premature knowledge of proposed or possible action or inaction of a person or entity." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

