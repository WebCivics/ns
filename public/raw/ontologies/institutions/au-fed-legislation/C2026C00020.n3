    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The agency must consider the temporal relationship between the document and the person's association with the matters dealt with." ;
    cml:premiseText "(b) whether the person to whom the information relates is known to be (or to have been) associated with the matters dealt with in the document;" ;
    cml:conclusionText "...the person to whom the information relates is known to be (or to have been) associated with the matters dealt with in the document;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-ltl-3 .
