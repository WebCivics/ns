concept:freedom-of-information-act-1982-sch-4-sec-7-ss-1 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-7-ss-1-logic-deontic-1 .
concept:freedom-of-information-act-1982-sch-4-sec-7-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "exemption" ;
    cml:logicSummary "Exempts entities from a duty." ;
    cml:premiseText "(1) The bodies specified in Division 1 of Part I of Schedule 2, and a person holding and performing the duties of an office specified in that Division, are to be deemed not to be prescribed authorities for the purposes of this Act." ;
    cml:conclusionText "These entities are exempt from being prescribed authorities." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

