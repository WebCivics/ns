    cml:modality cml:Deontic ;
    values:partOf concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-deontic-1 .
concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Agency has an obligation to consider personal information." ;
    cml:premiseText "(2) In determining whether the disclosure of the document would involve the unreasonable disclosure of personal information, an agency or Minister must have regard to..." ;
    cml:conclusionText "...the person to whom the information relates is known to be (or to have been) associated with the matters dealt with in the document;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-alleninterval-2 .
