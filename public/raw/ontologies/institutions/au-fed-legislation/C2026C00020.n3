    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Describes the temporal relationship between exemption and prescribed authority." ;
    cml:premiseText "(1) The bodies specified in Division 1 of Part I of Schedule 2, and a person holding and performing the duties of an office specified in that Division, are to be deemed not to be prescribed authorities for the purposes of this Act." ;
    cml:conclusionText "The exemption occurs during the period when these entities would otherwise be prescribed authorities." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

