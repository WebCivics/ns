    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "The agency must consider whether the person's association with the matters dealt with has changed over time." ;
    cml:premiseText "(b) whether the person to whom the information relates is known to be (or to have been) associated with the matters dealt with in the document;" ;
    cml:conclusionText "...the person to whom the information relates is known to be (or to have been) associated with the matters dealt with in the document;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-diffusion-4 .
concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Spreads" ;
    cml:logicSummary "The agency must consider how the disclosure of the document would affect the person's privacy." ;
    cml:premiseText "(a) the extent to which the information is well known;" ;
    cml:conclusionText "...the availability of the information from publicly accessible sources;" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-47f-ss-2-logic-cogai-5 .
