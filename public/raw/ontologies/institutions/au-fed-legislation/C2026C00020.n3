concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3-logic-deontic-1 .
concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits access if it would interfere with agency operations or infringe copyright." ;
    cml:premiseText "(a) would interfere unreasonably with the operations of the agency, or the performance by the Minister of his or her functions, as the case may be;" ;
    cml:conclusionText "access in that form may be refused and access given in another form." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3 cml:asserts concept:freedom-of-information-act-1982-sch-4-sec-20-ss-3-logic-deontic-2 .
