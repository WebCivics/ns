    cml:modality cml:Deontic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classifies reasons for refusing access." ;
    cml:premiseText "(b) would be detrimental to the preservation of the document or, having regard to the physical nature of the document, would not be appropriate;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

