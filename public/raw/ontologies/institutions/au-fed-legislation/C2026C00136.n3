    cml:modality cml:Deontic ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-56-ss-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:international-war-crimes-tribunals-act-1995-sec-56-ss-3 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-56-ss-3-logic-deontic-1 .
concept:international-war-crimes-tribunals-act-1995-sec-56-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "can" ;
    cml:logicSummary "Warrant execution can proceed despite court order revocation" ;
    cml:premiseText "(a) the execution of a search warrant is stopped by an order of a court; and (b) the order is later revoked or reversed on appeal; and (c) the warrant is still in force;" ;
    cml:conclusionText "the execution of the warrant may be completed." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

