    cml:modality cml:AllenInterval ;
    cml:operator ">" ;
    cml:logicSummary "Temporal interval for criminal proceeding in respect of Tribunal offence" ;
    cml:premiseText "It being reasonably suspected that criminal proceedings are about to commence against the person in the Tribunal in respect of a Tribunal offence" ;
    cml:conclusionText "...reasonably suspected that criminal proceedings are about to commence..." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-2 .
concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator ">" ;
    cml:logicSummary "References to indictable offence are references to Tribunal offence" ;
    cml:premiseText "That Part applies as if references in that Part to an indictable offence were references to the Tribunal offence that is the subject of the proceeds request" ;
    cml:conclusionText "...references to the Tribunal offence that is the subject of the proceeds request" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-3 .
concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator ">" ;
    cml:logicSummary "References to person charged with indictable offence are references to person against whom criminal proceeding in respect of Tribunal offence has commenced" ;
    cml:premiseText "That Part applies as if references in that Part to a person charged with an indictable offence were references to a person against whom a criminal proceeding in respect of a Tribunal offence has commenced in the Tribunal" ;
    cml:conclusionText "...a person against whom a criminal proceeding in respect of a Tribunal offence has commenced in the Tribunal" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-4 .
concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator ">" ;
    cml:logicSummary "References to it being proposed to charge person with indictable offence are references to it being reasonably suspected that criminal proceedings are about to commence against the person in the Tribunal in respect of a Tribunal offence" ;
    cml:premiseText "That Part applies as if references in that Part to it being proposed to charge a person with an indictable offence were references to it being reasonably suspected that criminal proceedings are about to commence against the person in the Tribunal in respect of a Tribunal offence" ;
    cml:conclusionText "...it being reasonably suspected that criminal proceedings are about to commence against the person in the Tribunal in respect of a Tribunal offence" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-40ac-ss-4-logic-deontic-5 .
