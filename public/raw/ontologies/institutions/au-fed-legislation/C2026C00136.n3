    cml:premiseText "A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9." ;
    cml:conclusionText "Cancel the warrant if no such request is received within a certain time." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
