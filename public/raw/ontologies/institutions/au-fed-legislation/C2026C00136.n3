    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibition on hindering Tribunal functions." ;
    cml:premiseText "A person must not otherwise intentionally hinder a Tribunal in performing its functions while sitting in Australia." ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
