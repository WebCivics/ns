    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "The Attorney-General must provide adequate undertakings in respect of the matters referred to in section 37." ;
    cml:premiseText "the Attorney-General is satisfied that the prisoner has consented to giving evidence or assisting in the foreign country;" ;
    cml:conclusionText "The Attorney-General must provide adequate undertakings." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-4 .
