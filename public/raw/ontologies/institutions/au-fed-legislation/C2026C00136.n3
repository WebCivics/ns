    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Paragraphs omitted from Part" ;
    cml:premiseText "That Part applies as if paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and sections 18 to 20A, 29, 29A and 44 to 45A of that Act were omitted" ;
    cml:conclusionText "...paragraphs 17(1)(e) and (f), subsections 17(3) and (4) and sections 18 to 20A, 29, 29A and 44 to 45A of that Act were omitted" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


