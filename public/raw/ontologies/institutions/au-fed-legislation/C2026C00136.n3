    cml:premiseText "The person has not been arrested under the warrant and A request from a Tribunal would oblige the Attorney-General to issue a notice under section 9." ;
    cml:conclusionText "Cancel the warrant if both conditions are met." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
