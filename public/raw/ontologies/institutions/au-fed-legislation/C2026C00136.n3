    cml:operator "during" ;
    cml:logicSummary "Temporal relation between contravention and imprisonment." ;
    cml:premiseText "A person must not intentionally contravene an order that a Tribunal makes while sitting in Australia; or A person must not otherwise intentionally hinder a Tribunal in performing its functions while sitting in Australia." ;
    cml:conclusionText "Imprisonment occurs during the period of contravention or hindering." ;
    cml:executionSurface "modalities::interval_reasoning" ;
