    cml:operator "until" ;
    cml:logicSummary "Warrant revocation ends warrant execution completion" ;
    cml:premiseText "(a) the execution of a search warrant is stopped by an order of a court; and (b) the order is later revoked or reversed on appeal; and (c) the warrant is still in force;" ;
    cml:conclusionText "the execution of the warrant may be completed." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
