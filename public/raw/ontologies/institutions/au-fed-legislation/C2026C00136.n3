    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Property must be dealt with within 30 days." ;
    cml:premiseText "(1) Property must be dealt with in accordance with this section if: (a) it has been seized under a POCA search warrant in relation to a Tribunal offence; and (b) it is not: (i) evidential material; or (ii) property of a kind referred to in subparagraph 40AR(a)(iv) or (v.)." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

