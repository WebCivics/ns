    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits warrantless searches without emergency justification." ;
    cml:premiseText "(a) evidential material is in or on a conveyance; and (b) it is necessary to exercise a power under subsection (2) in order to prevent the material from being concealed, lost or destroyed;" ;
    cml:conclusionText "No warrantless search allowed." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

