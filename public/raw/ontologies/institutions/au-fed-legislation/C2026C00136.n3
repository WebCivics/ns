concept:international-war-crimes-tribunals-act-1995-sec-43-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibition on contravening Tribunal orders." ;
    cml:premiseText "A person must not intentionally contravene an order that a Tribunal makes while sitting in Australia." ;
    cml:conclusionText "Imprisonment for 2 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

