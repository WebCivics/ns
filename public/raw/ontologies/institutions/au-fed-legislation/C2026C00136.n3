    cml:modality cml:Deontic ;
    cml:operator "Permit" ;
    cml:logicSummary "Permission granted by occupier" ;
    cml:premiseText "(a) it is not practicable to examine or process the things at the warrant premises; or (b) the occupier of the premises consents in writing;" ;
    cml:conclusionText "The use of equipment to examine or process things is permitted if the occupier consents." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
