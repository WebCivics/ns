    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "The Attorney-General must be satisfied that the prisoner has consented to giving evidence or assisting in the foreign country." ;
    cml:premiseText "the Attorney-General is satisfied that the Tribunal has given, to the extent (if any) required by the Attorney-General, adequate undertakings in respect of the matters referred to in section 37." ;
    cml:conclusionText "The Attorney-General must be satisfied that the prisoner has consented." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


