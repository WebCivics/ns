concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:international-war-crimes-tribunals-act-1995-sec-53-ss-5 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
