    cml:operator ">=" ;
    cml:logicSummary "The cancellation must occur after the person has not been arrested." ;
    cml:premiseText "The person has not been arrested under the warrant." ;
    cml:conclusionText "Cancel the warrant after the person has not been arrested." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
