    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "The Tribunal must give evidence relevant to the proceeding or assist the investigation if requested by the Attorney-General." ;
    cml:premiseText "the Attorney-General is satisfied that the prisoner has consented to giving evidence or assisting in the foreign country;" ;
    cml:conclusionText "The Tribunal must give evidence relevant to the proceeding or assist the investigation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-5 .
