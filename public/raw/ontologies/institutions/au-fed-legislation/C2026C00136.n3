    cml:premiseText "The release of a person from custody must occur before the Attorney-General's next action." ;
    cml:conclusionText "The direction is an instance of the obligation to direct a magistrate in relation to the release." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

