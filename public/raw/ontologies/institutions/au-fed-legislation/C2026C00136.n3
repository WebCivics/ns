    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "There are reasonable grounds to believe that the prisoner can give evidence relevant to the proceeding or assist the investigation." ;
    cml:premiseText "there are reasonable grounds to believe that the prisoner can give evidence relevant to the proceeding or assist the investigation;" ;
    cml:conclusionText "The time of the request is before the time of the investigation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1 cml:asserts concept:international-war-crimes-tribunals-act-1995-sec-36-ss-1-logic-deontic-3 .
