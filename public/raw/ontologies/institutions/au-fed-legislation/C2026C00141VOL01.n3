    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Employee must have completed at least 12 months of continuous service or be employed on a regular casual basis during a period of at least 12 months" ;
    cml:premiseText "Employee has completed at least 12 months of continuous service or is employed on a regular casual basis during a period of at least 12 months" ;
