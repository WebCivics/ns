    cml:integrityHash "874c3476cd234795f1ce1afbab97482ece796e36ee344e9fe3228c5a4e1f25e1" ;
    values:partOf concept:fair-work-act-2009-sec-77a ;
    skos:note "Employee entitled to unpaid parental leave despite stillbirth of child." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.231" ;
    cml:asserts concept:fair-work-act-2009-sec-77a-ss-1-norm .
concept:fair-work-act-2009-sec-77a-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-77a-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-77a-ss-1 cml:asserts concept:fair-work-act-2009-sec-77a-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-77a-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Entails" ;
    cml:logicSummary "Employee has an obligation to receive unpaid parental leave." ;
    cml:premiseText "(1) If a child is stillborn; and (b) an employee would have been entitled to unpaid parental leave that is birth-related leave, if the child had been born alive;" ;
    cml:conclusionText "then the employee is taken to be entitled to the unpaid parental leave" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-77a-ss-1 cml:asserts concept:fair-work-act-2009-sec-77a-ss-1-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-77a-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "OverlapsWith" ;
    cml:logicSummary "Stillbirth does not interrupt the start of unpaid parental leave." ;
    cml:premiseText "(1) If a child is stillborn; and (b) an employee would have been entitled to unpaid parental leave that is birth-related leave, if the child had been born alive;" ;
    cml:conclusionText "then the employee is taken to be entitled to the unpaid parental leave" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-77a-ss-1 cml:asserts concept:fair-work-act-2009-sec-77a-ss-1-logic-ltl-3 .
concept:fair-work-act-2009-sec-77a-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "RepeatsEvery" ;
    cml:logicSummary "Stillbirth does not interrupt the repetition of unpaid parental leave." ;
    cml:premiseText "(1) If a child is stillborn; and (b) an employee would have been entitled to unpaid parental leave that is birth-related leave, if the child had been born alive;" ;
    cml:conclusionText "then the employee is taken to be entitled to the unpaid parental leave" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-77a-ss-1 cml:asserts concept:fair-work-act-2009-sec-77a-ss-1-logic-diffusion-4 .
concept:fair-work-act-2009-sec-77a-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "DiffusesInto" ;
    cml:logicSummary "Stillbirth does not diffuse into other employees' unpaid parental leave entitlements." ;
    cml:premiseText "(1) If a child is stillborn; and (b) an employee would have been entitled to unpaid parental leave that is birth-related leave, if the child had been born alive;" ;
    cml:conclusionText "then the employee is taken to be entitled to the unpaid parental leave" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-77a-ss-1 cml:asserts concept:fair-work-act-2009-sec-77a-ss-1-logic-cogai-5 .
concept:fair-work-act-2009-sec-77a-ss-1-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "Stillbirth recognized as a factor in determining unpaid parental leave entitlement." ;
    cml:premiseText "(1) If a child is stillborn; and (b) an employee would have been entitled to unpaid parental leave that is birth-related leave, if the child had been born alive;" ;
    cml:conclusionText "then the employee is taken to be entitled to the unpaid parental leave" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


