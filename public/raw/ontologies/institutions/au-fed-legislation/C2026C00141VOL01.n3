    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-68 cml:asserts concept:fair-work-act-2009-sec-68-logic-deontic-2 .
concept:fair-work-act-2009-sec-68-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "and" ;
    cml:logicSummary "Child must meet both conditions to be eligible" ;
    cml:premiseText "(a) is, or will be, under 16 as at the day of placement, or the expected day of placement, of the child; and (b) has not, or will not have, lived continuously with the employee for a period of 6 months or more as at the day of placement, or the expected day of placement, of the child;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

