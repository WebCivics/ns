    cml:modality cml:LTL ;
    cml:operator "holdsForAll" ;
    cml:logicSummary "Section 137 implies that terms of modern awards with effect must comply with section 136 for all possible traces." ;
    cml:premiseText "Terms of a modern award have no effect to the extent that it contravenes section 136." ;
    cml:conclusionText "If a term of a modern award has effect, then it holds for all possible traces that it complies with section 136." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-137 cml:asserts concept:fair-work-act-2009-sec-137-logic-diffusion-4 .
