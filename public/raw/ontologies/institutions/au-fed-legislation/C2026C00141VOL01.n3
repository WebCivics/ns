    cml:modality cml:Deontic ;
    cml:operator "Must Not" ;
    cml:logicSummary "Prohibition of using employee information for unauthorized purposes." ;
    cml:premiseText "Employer must not use such information for a purpose other than satisfying itself in relation to the employee’s entitlement to leave under this Subdivision." ;
    cml:conclusionText "An employer must not use such information for a purpose other than satisfying itself in relation to the employee’s entitlement to leave under this Subdivision." ;
    cml:executionSurface "modalities::logic::deontic" ;
