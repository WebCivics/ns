    cml:modality cml:Deontic ;
    cml:operator "and" ;
    cml:logicSummary "Child cannot be employee's child or spouse/partner" ;
    cml:premiseText "is not (otherwise than because of the adoption) a child of the employee or the employee’s spouse or de facto partner." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

