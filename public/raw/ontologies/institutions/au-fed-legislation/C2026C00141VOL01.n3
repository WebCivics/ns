    cml:conclusionText "...the condition in this subsection is satisfied." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-227a-ss-2 cml:asserts concept:fair-work-act-2009-sec-227a-ss-2-logic-descriptionlogic-2 .
