    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Employer is prohibited from requiring employee to take unpaid parental leave if certain conditions are met." ;
    cml:premiseText "Employee gives employer medical certificate stating fit for work but not advisable to continue in present position and has complied with notice and evidence requirements of section 74" ;
