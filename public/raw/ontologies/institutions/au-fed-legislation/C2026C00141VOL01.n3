    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Terms with no effect are those that occur during the commencement of the enterprise agreement." ;
    cml:premiseText "Note 1: A term of an enterprise agreement has no effect to the extent that it contravenes section 55 (see section 56)." ;
    cml:conclusionText "(1) A term of an enterprise agreement has no effect to the extent that it contravenes section 55." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

