    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits enterprise agreements from covering employees after operation ends." ;
    cml:premiseText "(5) Despite subsections (1), (2) and (3), an enterprise agreement that has ceased to operate does not cover an employee, employer or employee organisation." ;
    cml:conclusionText "An enterprise agreement ceases to cover employees after it has ceased to operate." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
