concept:fair-work-act-2009-sec-229-ss-4 cml:asserts concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-1 .
concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must provide written notice to relevant bargaining representatives." ;
    cml:premiseText "(b) has given a written notice setting out those concerns..." ;
    cml:conclusionText "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-229-ss-4 cml:asserts concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-2 .
concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must respond to written notice within a reasonable time." ;
    cml:premiseText "(c) has given the relevant bargaining representatives a reasonable time..." ;
    cml:conclusionText "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-229-ss-4 cml:asserts concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-3 .
concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must meet good faith bargaining requirements." ;
    cml:premiseText "(a) has concerns that one or more of the bargaining representatives for the agreement have not met, or are not meeting, the good faith bargaining requirements..." ;
    cml:conclusionText "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-229-ss-4 cml:asserts concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-4 .
concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must proceed with bargaining process fairly and efficiently." ;
    cml:premiseText "(a) has concerns that the bargaining process is not proceeding efficiently or fairly because there are multiple bargaining representatives for the agreement..." ;
    cml:conclusionText "...and (d) considers that the relevant bargaining representatives have not responded appropriately to those concerns." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-229-ss-4 cml:asserts concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-5 .
concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must comply with notice requirements." ;
    cml:premiseText "(4) The bargaining representative may only apply for the bargaining order if..." ;
    cml:conclusionText "...Non-compliance with notice requirements may be permitted" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-229-ss-4 cml:asserts concept:fair-work-act-2009-sec-229-ss-4-logic-deontic-6 .
