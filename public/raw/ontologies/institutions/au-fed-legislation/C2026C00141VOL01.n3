concept:fair-work-act-2009-sec-46-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "Award application is necessary for entitlement" ;
    cml:premiseText "(2) A modern award does not give a person an entitlement unless the award applies to the person." ;
    cml:conclusionText "If the award applies, then the person has an entitlement" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
