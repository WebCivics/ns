    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Indicates that the conditions under which the FWC may refuse to approve an enterprise agreement repeat in certain circumstances." ;
    cml:premiseText "The FWC considers that compliance with the terms of the agreement may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty." ;
    cml:conclusionText "The conditions under which the FWC may refuse to approve the agreement repeat in certain circumstances." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

