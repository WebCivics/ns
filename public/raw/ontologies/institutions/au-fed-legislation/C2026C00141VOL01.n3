    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires employee to meet certain conditions before making a request" ;
    cml:premiseText "Employee must have completed at least 12 months of continuous service or be a regular casual employee with a reasonable expectation of continuing employment" ;
    cml:conclusionText "Request for flexible working arrangements is only allowed under these conditions" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
