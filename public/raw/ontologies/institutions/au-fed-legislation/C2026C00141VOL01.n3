    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Indicates that the conditions under which the FWC may refuse to approve an enterprise agreement diffuse into other areas of law." ;
    cml:premiseText "The FWC considers that compliance with the terms of the agreement may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty." ;
    cml:conclusionText "The conditions under which the FWC may refuse to approve the agreement diffuse into other areas of law." ;
    cml:executionSurface "modalities::diffusion" ;
