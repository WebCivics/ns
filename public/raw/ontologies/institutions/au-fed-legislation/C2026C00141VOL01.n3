    cml:modality cml:Deontic ;
    cml:operator "Must Not" ;
    cml:logicSummary "Prohibition of taking adverse action against an employee." ;
    cml:premiseText "In particular, an employer must not use such information to take adverse action against an employee." ;
    cml:conclusionText "An employer must not use such information to take adverse action against an employee." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

