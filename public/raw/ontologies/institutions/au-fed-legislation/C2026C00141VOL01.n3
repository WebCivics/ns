    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "The FWC must approve the agreement." ;
    cml:premiseText "The FWC has a duty to approve cooperative workplace agreements." ;
    cml:conclusionText "The agreement must be approved by the FWC." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-186-ss-2a cml:asserts concept:fair-work-act-2009-sec-186-ss-2a-logic-deontic-2 .
concept:fair-work-act-2009-sec-186-ss-2a-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST_NOT" ;
    cml:logicSummary "The agreement must not cover employees in relation to general building and construction work." ;
    cml:premiseText "Multi-enterprise agreements must not cover employees in relation to general building and construction work." ;
    cml:conclusionText "The agreement cannot cover employees in relation to general building and construction work." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-186-ss-2a cml:asserts concept:fair-work-act-2009-sec-186-ss-2a-logic-alleninterval-3 .
