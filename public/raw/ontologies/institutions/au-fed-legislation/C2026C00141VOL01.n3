    cml:modality cml:LTL ;
    cml:operator "<=" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "(xiii) work in the asphalt industry within the meaning of clause 4.2 of the Asphalt Industry Award 2020 as in force at the applicable time;" ;
    cml:conclusionText "...or (xiv) work, in that part of the industry of civil construction described in subparagraph 4.3(b)(i) of the Building and Construction General On-site Award 2020 as in force at the applicable time, that is the construction, repair, maintenance or demolition of power houses or other structures..." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

