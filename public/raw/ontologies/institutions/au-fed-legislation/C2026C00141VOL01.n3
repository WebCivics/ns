concept:fair-work-act-2009-sec-214-ss-1 a cml:Concept ;
    skos:prefLabel "214(1) When the FWC may refuse to approve a variation of an"@en ;
    cml:realizedBy doc:sec-214-ss-1 ;
    cml:integrityHash "701ee8f3ca491074592dd492a7faebf366dee8fa5fb315591b5662697af23dab" ;
    values:partOf concept:fair-work-act-2009-sec-214 ;
    skos:note "FWC may refuse to approve a variation of an enterprise agreement if it may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.425" ;
    cml:asserts concept:fair-work-act-2009-sec-214-ss-1-norm .
concept:fair-work-act-2009-sec-214-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-214-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-214-ss-1 cml:asserts concept:fair-work-act-2009-sec-214-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-214-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of approving the variation if it may result in a crime or penalty." ;
    cml:premiseText "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth." ;
    cml:conclusionText "The FWC may refuse to approve the variation if it may result in a crime or penalty." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

