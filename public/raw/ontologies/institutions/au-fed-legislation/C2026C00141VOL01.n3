    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "The FWC's approval is conditional on the representation of some employees during bargaining." ;
    cml:premiseText "The FWC's approval is dependent on certain conditions being met." ;
    cml:conclusionText "The FWC's approval is conditional on the representation of some employees during bargaining." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

