    cml:modality cml:AllenInterval ;
    cml:operator "overlaps" ;
    cml:logicSummary "Section 137 implies that terms of modern awards with effect must comply with section 136 within the same temporal interval." ;
    cml:premiseText "Terms of a modern award have no effect to the extent that it contravenes section 136." ;
    cml:conclusionText "If a term of a modern award has effect, then it overlaps with section 136 within the same temporal interval." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

