    cml:modality cml:CogAI ;
    cml:operator "implies" ;
    cml:logicSummary "Section 137 implies that terms of modern awards with effect must be processed by AI systems in accordance with section 136." ;
    cml:premiseText "Terms of a modern award have no effect to the extent that it contravenes section 136." ;
