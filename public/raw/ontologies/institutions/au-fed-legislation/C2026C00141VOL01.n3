    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the FWC from approving an enterprise agreement under certain conditions." ;
    cml:premiseText "The FWC may refuse to approve an enterprise agreement if it considers that compliance with the terms of the agreement may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty." ;
    cml:conclusionText "The FWC shall not approve the agreement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-192-ss-1 cml:asserts concept:fair-work-act-2009-sec-192-ss-1-logic-alleninterval-2 .
concept:fair-work-act-2009-sec-192-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Indicates that the conditions under which the FWC may refuse to approve an enterprise agreement overlap with the conditions under which a person commits an offence against a law of the Commonwealth or is liable to pay a pecuniary penalty." ;
    cml:premiseText "The FWC considers that compliance with the terms of the agreement may result in a person committing an offence against a law of the Commonwealth or being liable to pay a pecuniary penalty." ;
    cml:conclusionText "The conditions under which the FWC may refuse to approve the agreement overlap with the conditions under which a person commits an offence against a law of the Commonwealth or is liable to pay a pecuniary penalty." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

