    values:partOf concept:fair-work-act-2009-sec-122 ;
    skos:note "Employee is not entitled to redundancy pay if service with first employer counts as service with second employer" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
