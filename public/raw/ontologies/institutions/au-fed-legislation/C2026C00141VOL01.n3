concept:fair-work-act-2009-sec-98-ss-2 cml:asserts concept:fair-work-act-2009-sec-98-ss-2-logic-deontic-1 .
concept:fair-work-act-2009-sec-98-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If employee takes paid personal/carer’s leave, then they are not on paid family and domestic violence leave." ;
    cml:premiseText "(2) If the period during which an employee takes paid personal/carer’s leave includes a period of paid family and domestic violence leave," ;
    cml:conclusionText "the employee is taken not to be on paid personal/carer’s leave for the period of that paid family and domestic violence leave." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-98-ss-2 cml:asserts concept:fair-work-act-2009-sec-98-ss-2-logic-descriptionlogic-2 .
concept:fair-work-act-2009-sec-98-ss-2-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "ClassInclusion" ;
    cml:logicSummary "Employee's leave includes paid family and domestic violence leave if they are taken not to be on paid personal/carer’s leave for that period." ;
    cml:premiseText "(2) If the period during which an employee takes paid personal/carer’s leave includes a period of paid family and domestic violence leave," ;
    cml:conclusionText "the employee's leave includes paid family and domestic violence leave if they are taken not to be on paid personal/carer’s leave for that period." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-98-ss-2 cml:asserts concept:fair-work-act-2009-sec-98-ss-2-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-98-ss-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Paid family and domestic violence leave overlaps with paid personal/carer’s leave." ;
    cml:premiseText "(2) If the period during which an employee takes paid personal/carer’s leave includes a period of paid family and domestic violence leave," ;
    cml:conclusionText "the periods overlap if they are taken not to be on paid personal/carer’s leave for that period." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-98-ss-2 cml:asserts concept:fair-work-act-2009-sec-98-ss-2-logic-ltl-4 .
concept:fair-work-act-2009-sec-98-ss-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Paid family and domestic violence leave repeats with paid personal/carer’s leave." ;
    cml:premiseText "(2) If the period during which an employee takes paid personal/carer’s leave includes a period of paid family and domestic violence leave," ;
    cml:conclusionText "the periods repeat if they are taken not to be on paid personal/carer’s leave for that period." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-98-ss-2 cml:asserts concept:fair-work-act-2009-sec-98-ss-2-logic-diffusion-5 .
concept:fair-work-act-2009-sec-98-ss-2-logic-diffusion-5 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Paid family and domestic violence leave diffuses into paid personal/carer’s leave." ;
    cml:premiseText "(2) If the period during which an employee takes paid personal/carer’s leave includes a period of paid family and domestic violence leave," ;
    cml:conclusionText "the diffusion spreads if they are taken not to be on paid personal/carer’s leave for that period." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-98-ss-2 cml:asserts concept:fair-work-act-2009-sec-98-ss-2-logic-cogai-6 .
concept:fair-work-act-2009-sec-98-ss-2-logic-cogai-6 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Recognizes" ;
    cml:logicSummary "The system recognizes the overlap between paid family and domestic violence leave and paid personal/carer’s leave." ;
    cml:premiseText "(2) If the period during which an employee takes paid personal/carer’s leave includes a period of paid family and domestic violence leave," ;
    cml:conclusionText "the system recognizes the overlap if they are taken not to be on paid personal/carer’s leave for that period." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


