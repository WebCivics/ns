concept:fair-work-act-2009-sec-137-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "Section 137 implies that terms of modern awards with effect must comply with section 136." ;
    cml:premiseText "Terms of a modern award have no effect to the extent that it contravenes section 136." ;
    cml:conclusionText "If a term of a modern award has effect, then it complies with section 136." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-137 cml:asserts concept:fair-work-act-2009-sec-137-logic-alleninterval-2 .
