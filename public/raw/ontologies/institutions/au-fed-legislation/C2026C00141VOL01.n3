    cml:operator "=" ;
    cml:logicSummary "Classifies the entitlement to a casual loading or specific rate of pay for casual employees" ;
    cml:premiseText "(b) the employee would be entitled to a casual loading or a specific rate of pay for casual employees under the terms of a fair work instrument if the employee were a casual employee, or the employee is entitled to such a loading or rate of pay under the contract of employment." ;
    cml:conclusionText "The employee is entitled to a casual loading or specific rate of pay if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


concept:fair-work-act-2009-sec-15a-ss-2 a cml:Concept ;
    skos:prefLabel "15A(2) Meaning of casual employee"@en ;
    cml:realizedBy doc:sec-15a-ss-2 ;
    cml:integrityHash "d9f02a9a39c8143cc5b0735fa776e930bb1cee964ad28ce5f120c55b3c64abba" ;
    values:partOf concept:fair-work-act-2009-sec-15a ;
    skos:note "Employment relationship characterized by absence of firm advance commitment to continuing and indefinite work is to be assessed based on real substance, practical reality, and true nature." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.94" ;
    cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-norm .
concept:fair-work-act-2009-sec-15a-ss-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-15a-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-deontic-1 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Employer has obligation to provide continuing work" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-descriptionlogic-2 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classification of employment relationship based on real substance, practical reality, and true nature" ;
    cml:premiseText "(2) For the purposes of paragraph (1)(a), whether the employment relationship is characterised by an absence of a firm advance commitment to continuing and indefinite work is to be assessed:" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-alleninterval-3 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Employer's ability to offer or not offer work may indicate presence of firm advance commitment" ;
    cml:premiseText "(i) whether there is an inability of the employer to elect to offer, or not offer, work or an inability of the employee to elect to accept or reject work (and whether this occurs in practice);" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-ltl-4 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Future availability of continuing work may indicate presence of firm advance commitment" ;
    cml:premiseText "(ii) whether, having regard to the nature of the employer’s enterprise, it is reasonably likely that there will be future availability of continuing work in that enterprise of the kind usually performed by the employee;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-deontic-5 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Employee has obligation to accept or reject work" ;
    cml:premiseText "(b) on the basis that a firm advance commitment can be in the form of the contract of employment or, in addition to the terms of that contract, in the form of a mutual understanding or expectation between the employer and employee not rising to the level of a term of that contract (or to a variation of any such term);" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-2 cml:asserts concept:fair-work-act-2009-sec-15a-ss-2-logic-descriptionlogic-6 .
concept:fair-work-act-2009-sec-15a-ss-2-logic-descriptionlogic-6 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classification of mutual understanding or expectation between employer and employee" ;
    cml:premiseText "(b) on the basis that a firm advance commitment can be in the form of the contract of employment or, in addition to the terms of that contract, in the form of a mutual understanding or expectation between the employer and employee not rising to the level of a term of that contract (or to a variation of any such term);" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


