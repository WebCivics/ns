    cml:modality cml:Diffusion ;
    cml:operator "diffuses" ;
    cml:logicSummary "Section 137 implies that terms of modern awards with effect must diffuse to all agents affected by the term." ;
    cml:premiseText "Terms of a modern award have no effect to the extent that it contravenes section 136." ;
    cml:conclusionText "If a term of a modern award has effect, then it diffuses to all agents affected by the term." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-137 cml:asserts concept:fair-work-act-2009-sec-137-logic-cogai-5 .
