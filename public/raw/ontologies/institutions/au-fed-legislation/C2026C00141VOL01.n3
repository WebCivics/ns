    cml:modality cml:LTL ;
    cml:operator ">=" ;
    cml:logicSummary "The agreement must be approved by the FWC if some employees were represented by an employee organisation during bargaining." ;
    cml:premiseText "The agreement's approval is dependent on certain conditions being met." ;
    cml:conclusionText "The agreement must be approved by the FWC if some employees were represented by an employee organisation during bargaining." ;
    cml:executionSurface "modalities::temporal_ltl" ;
