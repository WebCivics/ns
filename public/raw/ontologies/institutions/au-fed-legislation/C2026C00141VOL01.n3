    cml:operator "Recurring" ;
    cml:logicSummary "The provision requires an employee to take unpaid parental leave if certain conditions are met." ;
    cml:premiseText "Employee has not complied with notice and evidence requirements of section 74 for taking unpaid parental leave" ;
    cml:conclusionText "The provision applies to employees who have not complied with notice and evidence requirements of section 74" ;
    cml:executionSurface "modalities::temporal_ltl" ;
