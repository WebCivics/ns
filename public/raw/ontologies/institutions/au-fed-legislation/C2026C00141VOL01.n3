    cml:modality cml:DescriptionLogic ;
    cml:operator "IS A CLASS OF EMPLOYEES" ;
    cml:logicSummary "Work on Saturdays and Sundays is a class of employees." ;
    cml:premiseText "(i) the award covered employees for the agreement; and (ii) if the agreement is a single-enterprise agreement that covers one or more employees to whom a supported bargaining agreement or a single interest employer agreement applies—those employees..." ;
    cml:conclusionText "...the FWC did not have regard, under subsection 193A(6), to this pattern of work." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

