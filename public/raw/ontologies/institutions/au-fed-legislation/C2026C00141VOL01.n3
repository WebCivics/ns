concept:fair-work-act-2009-sec-122-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sec-122-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sec-122-ss-1 cml:asserts concept:fair-work-act-2009-sec-122-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-122-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits redundancy pay for employees whose service is counted with the second employer" ;
    cml:premiseText "(1) Subsection 22(5) does not apply (for the purpose of this Subdivision) to a transfer of employment between non-associated entities in relation to an employee if the second employer decides not to recognise the employee’s service with the first employer (for the purpose of this Subdivision)." ;
    cml:conclusionText "(Employee is not entitled to redundancy pay if service with first employer counts as service with second employer)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

