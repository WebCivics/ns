concept:fair-work-act-2009-sec-253-ss-1 cml:asserts concept:fair-work-act-2009-sec-253-ss-1-logic-deontic-1 .
concept:fair-work-act-2009-sec-253-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "invalidates" ;
    cml:logicSummary "Invalidates a term if it is not about permitted matters, unlawful terms, or designated outworker terms." ;
    cml:premiseText "(a) it is not a term about a permitted matter; (b) it is an unlawful term; (c) it is a designated outworker term." ;
    cml:conclusionText "(1) A term of an enterprise agreement has no effect to the extent that: (a) it is not a term about a permitted matter; or (b) it is an unlawful term; or (c) it is a designated outworker term." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

