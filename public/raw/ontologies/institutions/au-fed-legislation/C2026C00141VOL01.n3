concept:fair-work-act-2009-sec-15a-ss-1 cml:asserts concept:fair-work-act-2009-sec-15a-ss-1-logic-alleninterval-1 .
concept:fair-work-act-2009-sec-15a-ss-1-logic-alleninterval-1 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Describes the duration of employment as a casual employee" ;
    cml:premiseText "An employee who commences employment as a casual employee remains a casual employee until the occurrence of a specified event (see subsection (5));" ;
    cml:conclusionText "The employment relationship lasts for at least..." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-15a-ss-1 cml:asserts concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-2 .
concept:fair-work-act-2009-sec-15a-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies the conditions for an employee to be considered a casual employee" ;
    cml:premiseText "(a) the employment relationship is characterised by an absence of a firm advance commitment to continuing and indefinite work; and (b) the employee would be entitled to a casual loading or a specific rate of pay for casual employees under the terms of a fair work instrument if the employee were a casual employee, or the employee is entitled to such a loading or rate of pay under the contract of employment." ;
    cml:conclusionText "The conditions are:" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

