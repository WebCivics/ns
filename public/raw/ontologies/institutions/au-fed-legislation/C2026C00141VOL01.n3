concept:fair-work-act-2009-sec-214-ss-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Overlap between the proposed variation and potential legal consequences." ;
    cml:premiseText "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth." ;
    cml:conclusionText "The FWC may refuse to approve the variation if it overlaps with potential legal consequences." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-214-ss-1 cml:asserts concept:fair-work-act-2009-sec-214-ss-1-logic-ltl-4 .
concept:fair-work-act-2009-sec-214-ss-1-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Repetition of the condition that the FWC may refuse to approve the variation if it may result in a crime or penalty." ;
    cml:premiseText "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth." ;
    cml:conclusionText "The FWC may refuse to approve the variation if it repeats the condition that it may result in a crime or penalty." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sec-214-ss-1 cml:asserts concept:fair-work-act-2009-sec-214-ss-1-logic-diffusion-5 .
concept:fair-work-act-2009-sec-214-ss-1-logic-diffusion-5 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "Diffusion of the prohibition from the FWC to the applicant." ;
    cml:premiseText "(a) a person committing an offence against a law of the Commonwealth; or (b) a person being liable to pay a pecuniary penalty in relation to a contravention of a law of the Commonwealth." ;
    cml:conclusionText "The diffusion of the prohibition from the FWC to the applicant is that they may refuse to approve the variation if it may result in a crime or penalty." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


