    cml:modality cml:LTL ;
    cml:operator "until" ;
    cml:logicSummary "Specifies the temporal interval until which the exemption applies" ;
    cml:premiseText "(2) However, if: (a) an enterprise agreement that was made before the commencement of that Part included a term referred to in paragraph 194(ba) (as inserted by Part 3 of Schedule 4 to the amending Act); and (b) a person made an election in accordance with that term before the commencement of that Part;" ;
    cml:conclusionText "then the amendment does not apply in relation to that person" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

