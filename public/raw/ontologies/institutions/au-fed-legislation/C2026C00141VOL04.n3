concept:fair-work-act-2009-sch-3-sec-6-ss-2 cml:asserts concept:fair-work-act-2009-sch-3-sec-6-ss-2-logic-deontic-1 .
concept:fair-work-act-2009-sch-3-sec-6-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "exemption" ;
    cml:logicSummary "Exempts persons who made an election before the commencement of Part 3 from the amendment" ;
    cml:premiseText "(a) an enterprise agreement that was made before the commencement of that Part included a term referred to in paragraph 194(ba)" ;
    cml:conclusionText "(b) a person made an election in accordance with that term before the commencement of that Part" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

