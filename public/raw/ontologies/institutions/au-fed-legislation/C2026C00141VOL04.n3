    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Specifies the temporal interval during which the exemption applies" ;
    cml:premiseText "(b) a person made an election in accordance with that term before the commencement of that Part" ;
    cml:conclusionText "then the amendment does not apply in relation to that person" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

