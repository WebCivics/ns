concept:fair-work-act-2009-sch-1-sec-122-ss-3 a cml:Concept ;
    skos:prefLabel "122(3) Other general provisions about regulations"@en ;
    cml:realizedBy doc:sch-1-sec-122-ss-3 ;
    cml:integrityHash "07ca90661e3f364baa7f68300daf806a304998da0395e6ba1db7afdcbf25e668" ;
    values:partOf concept:fair-work-act-2009-sch-1-sec-122 ;
    skos:note "Exempts conduct from prosecution if it would not have been a contravention without the retrospective effect of regulations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <fair-work-act-2009.pdf> ;
    dc:source "fair-work-act-2009.pdf, p.110" ;
    cml:asserts concept:fair-work-act-2009-sch-1-sec-122-ss-3-norm .
concept:fair-work-act-2009-sch-1-sec-122-ss-3-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:fair-work-act-2009-sch-1-sec-122-ss-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:fair-work-act-2009-sch-1-sec-122-ss-3 cml:asserts concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-deontic-1 .
concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Exemption" ;
    cml:logicSummary "Regulations exempt conduct from prosecution if it would not have been a contravention without the retrospective effect of regulations." ;
    cml:premiseText "(3) If: ... (c) but for the retrospective effect of the regulations, the conduct would not have contravened a provision of this Act;" ;
    cml:conclusionText "then a court must not convict the person of an offence, or order the person to pay a pecuniary penalty, in relation to the conduct on the grounds that it contravened a provision of this Act." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-122-ss-3 cml:asserts concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-alleninterval-2 .
concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The exemption is related to the temporal interval between registration and commencement dates." ;
    cml:premiseText "(3) If: ... (a) regulations are expressed to commence from a date (the registration date) before the regulations are registered under the Legislation Act 2003;" ;
    cml:conclusionText "then a court must not convict the person of an offence, or order the person to pay a pecuniary penalty, in relation to the conduct on the grounds that it contravened a provision of this Act." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-122-ss-3 cml:asserts concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-ltl-3 .
concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "The exemption is related to recurring conduct before registration dates." ;
    cml:premiseText "(3) If: ... (b) a person engaged in conduct before the registration date;" ;
    cml:conclusionText "then a court must not convict the person of an offence, or order the person to pay a pecuniary penalty, in relation to the conduct on the grounds that it contravened a provision of this Act." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-122-ss-3 cml:asserts concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-deontic-4 .
concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Justification" ;
    cml:logicSummary "The exemption is justified by the retrospective effect of regulations." ;
    cml:premiseText "(3) If: ... (c) but for the retrospective effect of the regulations, the conduct would not have contravened a provision of this Act;" ;
    cml:conclusionText "then a court must not convict the person of an offence, or order the person to pay a pecuniary penalty, in relation to the conduct on the grounds that it contravened a provision of this Act." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:fair-work-act-2009-sch-1-sec-122-ss-3 cml:asserts concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-epistemic-5 .
concept:fair-work-act-2009-sch-1-sec-122-ss-3-logic-epistemic-5 a cml:LogicApplication ;
    cml:modality cml:Epistemic ;
    cml:operator "Belief" ;
    cml:logicSummary "The exemption is believed by courts to be applicable under certain conditions." ;
    cml:premiseText "(3) If: ... (a) regulations are expressed to commence from a date (the registration date) before the regulations are registered under the Legislation Act 2003;" ;
    cml:conclusionText "then a court must not convict the person of an offence, or order the person to pay a pecuniary penalty, in relation to the conduct on the grounds that it contravened a provision of this Act." ;
    cml:executionSurface "modalities::epistemic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


