    cml:operator "Classifies" ;
    cml:logicSummary "Service classification based on regime or access undertaking" ;
    cml:premiseText "(a) the service is the subject of a regime for which a decision under section 44N that the regime is an effective access regime is in force (including as a result of an extension under section 44NB); or" ;
    cml:conclusionText "The service is not eligible to be declared if it is part of a regime with an effective access regime in force" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
