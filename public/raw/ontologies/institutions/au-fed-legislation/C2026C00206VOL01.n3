    cml:conclusionText "The finding of guilt repeats in time with the acquittal of other parties." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-45ah-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-45ah-ss-2-logic-deontic-4 .
concept:competition-and-consumer-act-2010-sec-45ah-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If all other parties are acquitted, then the corporation is not found guilty." ;
    cml:premiseText "All other parties to the contract have been acquitted." ;
    cml:conclusionText "The corporation is not found guilty of an offence against section 45AF or 45AG." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-45ah-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-45ah-ss-2-logic-deontic-5 .
concept:competition-and-consumer-act-2010-sec-45ah-ss-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If a finding of guilt would be inconsistent with the acquittal, then the corporation cannot be found guilty." ;
    cml:premiseText "A finding of guilt would be inconsistent with their acquittal." ;
    cml:conclusionText "The corporation cannot be found guilty of an offence against section 45AF or 45AG." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


