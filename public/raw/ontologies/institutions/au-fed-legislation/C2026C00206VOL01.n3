    cml:operator "Implies" ;
    cml:logicSummary "If all other parties are acquitted, then the corporation cannot be found guilty." ;
    cml:premiseText "All other parties to the contract have been acquitted." ;
    cml:conclusionText "The corporation cannot be found guilty of an offence against section 45AF or 45AG." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-45ah-ss-2 cml:asserts concept:competition-and-consumer-act-2010-sec-45ah-ss-2-logic-alleninterval-2 .
