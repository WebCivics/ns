concept:competition-and-consumer-act-2010-sec-29ba-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibition on conferral of function or power by State/Territory energy law." ;
    cml:premiseText "(2) Subsection (1) does not authorise the conferral of a function or power, or the imposition of a duty," ;
    cml:conclusionText "the conferral or imposition, or the authorisation, would contravene any constitutional doctrines restricting the duties that may be imposed on the Council;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

