    skos:note "Corporation cannot be found guilty of an offence against section 45AF or 45AG if all other parties have been acquitted." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
