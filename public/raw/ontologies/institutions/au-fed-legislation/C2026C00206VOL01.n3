concept:competition-and-consumer-act-2010-sec-45ax-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:competition-and-consumer-act-2010-sec-45ax-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:competition-and-consumer-act-2010-sec-45ax-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-1 .
concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must notify the Commission" ;
    cml:premiseText "(a) a person is the notifying party of a notification of an acquisition; and (b) a change of fact occurs; and (c) the change of fact is material to the Commission making a determination under subsection 51ABZE(1) in respect of the notification;" ;
    cml:conclusionText "The person must notify the Commission." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-45ax-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-alleninterval-2 .
concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Applicable" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "(i) occurring on or after the effective notification date of the notification; and (ii) at which the Commission has not decided to cease considering the notification under section 51ABZD;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-act-2010-sec-45ax-ss-1 cml:asserts concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-3 .
concept:competition-and-consumer-act-2010-sec-45ax-ss-1-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must notify the Commission within a timeframe" ;
    cml:premiseText "(iii) at which the Commission has not made a determination in respect of the notification under subsection 51ABZE(1); and (iv) if the notification is subject to phase 2 review—occurring at least 15 business days (within the meaning of section 51ABK) before the end of the phase 2 determination period for the notification." ;
    cml:conclusionText "The person must notify the Commission within a timeframe." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

