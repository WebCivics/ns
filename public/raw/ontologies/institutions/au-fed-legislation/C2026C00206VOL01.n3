concept:competition-and-consumer-act-2010-sec-44zo-ss-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "prevails" ;
    cml:logicSummary "Obligation to prioritize final determination over interim determination." ;
    cml:premiseText "(5) If a provision of a final determination is expressed to apply from a day when an interim determination was in effect, the provision of the final determination prevails over the interim determination to the extent set out in the final determination." ;
    cml:conclusionText "The final determination prevails over the interim determination." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
