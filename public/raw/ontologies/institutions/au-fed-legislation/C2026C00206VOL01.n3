    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The finding of guilt overlaps with the acquittal of other parties." ;
    cml:premiseText "A finding of guilt would be inconsistent with their acquittal." ;
    cml:conclusionText "The finding of guilt overlaps with the acquittal of other parties." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

