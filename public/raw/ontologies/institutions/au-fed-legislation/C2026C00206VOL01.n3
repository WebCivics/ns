concept:competition-and-consumer-act-2010-sec-52s-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "(a) a change is planned to be made to an algorithm of the designated digital platform service;" ;
    cml:conclusionText "(b) the dominant purpose of the change is to bring about an identified alteration to the ways in which the designated digital platform service distributes content that is made available by the service;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

