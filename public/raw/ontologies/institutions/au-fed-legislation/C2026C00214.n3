    cml:modality cml:AllenInterval ;
    cml:operator "temporal interval" ;
    cml:logicSummary "Temporal interval for exemption from obligation." ;
    cml:premiseText "The individual has a reasonable excuse for refusing to answer a question or produce a document on the ground that the answer or the production of the document might tend to incriminate the individual or to expose the individual to a penalty." ;
    cml:conclusionText "The exemption from obligation is valid within the specified temporal interval." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
