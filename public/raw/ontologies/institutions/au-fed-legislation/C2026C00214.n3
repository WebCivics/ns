    cml:modality cml:Deontic ;
    cml:operator "exemption" ;
    cml:logicSummary "Exemption from providing information or documents under certain circumstances." ;
    cml:premiseText "The individual has a reasonable excuse for refusing to answer a question or produce a document." ;
    cml:conclusionText "There is no obligation to provide the information or document." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
