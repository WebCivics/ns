    cml:operator "Obligation" ;
    cml:logicSummary "Anyone who is arrested or detained on a criminal charge shall be brought promptly before a judge or other officer authorized by law to exercise judicial power." ;
    cml:premiseText "Anyone arrested or detained on a criminal charge shall be brought promptly before a judge or other officer authorized by law to exercise judicial power and shall be entitled to trial within a reasonable time or to release." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


