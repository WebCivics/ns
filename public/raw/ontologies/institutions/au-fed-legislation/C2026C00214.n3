    cml:modality cml:Deontic ;
    cml:operator "hasObligationTo" ;
    cml:logicSummary "State has obligation to provide notice" ;
    cml:premiseText "(1) If: (a) a complaint has been terminated by the President under section 46PE, paragraph 46PF(1)(b) or section 46PH; and (b) the President has given a notice to any person under subsection 46PH(2) in relation to the termination;" ;
    cml:conclusionText "(an application may be made to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2), alleging unlawful discrimination by one or more of the respondents to the terminated complaint.)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

