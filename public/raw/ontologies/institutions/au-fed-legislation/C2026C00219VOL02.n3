    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-17b-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-17b-ss-1 cml:asserts concept:crimes-act-1914-sec-17b-ss-1-logic-deontic-1 .
concept:crimes-act-1914-sec-17b-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Court must not pass sentence of imprisonment unless exceptional circumstances warrant it." ;
    cml:premiseText "(a) a person is convicted of one or more section 17B offences relating to property, money or both, whose total value is not more than $2,000;" ;
    cml:conclusionText "the court convicting the person is not to pass a sentence of imprisonment for that offence, or for any of those offences, unless the court is satisfied that there are exceptional circumstances that warrant it." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-17b-ss-1 cml:asserts concept:crimes-act-1914-sec-17b-ss-1-logic-alleninterval-2 .
concept:crimes-act-1914-sec-17b-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The offence occurred before the sentence was passed" ;
    cml:premiseText "(b) the person has not previously been sentenced to imprisonment for any federal, State or Territory offence;" ;
    cml:conclusionText "the offence occurred before the sentence was passed" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-17b-ss-1 cml:asserts concept:crimes-act-1914-sec-17b-ss-1-logic-ltl-3 .
concept:crimes-act-1914-sec-17b-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "The sentence must be passed after the offence occurred" ;
    cml:premiseText "(b) the person has not previously been sentenced to imprisonment for any federal, State or Territory offence;" ;
    cml:conclusionText "the sentence must be passed after the offence occurred" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-17b-ss-1 cml:asserts concept:crimes-act-1914-sec-17b-ss-1-logic-deontic-4 .
