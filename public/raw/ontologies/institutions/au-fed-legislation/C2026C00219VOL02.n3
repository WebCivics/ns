    values:partOf concept:crimes-act-1914-sec-17b ;
    skos:note "Court must not pass sentence of imprisonment unless exceptional circumstances warrant it." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
