    cml:modality cml:Deontic ;
    cml:operator ">=" ;
    cml:logicSummary "Period of effect must not exceed 3 months" ;
    cml:premiseText "(a) in the case of a formal variation of authority—the period that would result in the period of effect of the authority exceeding 3 months (including any previous extensions);" ;
    cml:conclusionText "(2) For the purposes of paragraph (1)(f), the period of the extension must not exceed:" ;
    cml:executionSurface "modalities::logic::deontic" ;
