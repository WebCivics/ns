    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Temporal relation between cancellation and disclosure" ;
    cml:premiseText "(b) the certificate has not been cancelled under section 15MQ;" ;
    cml:conclusionText "The person commits an offence if..." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

