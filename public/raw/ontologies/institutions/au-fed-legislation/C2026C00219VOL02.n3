    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "Observer must be an appropriate person for the purposes of this section." ;
    cml:premiseText "(5) The court must not specify a person for the purposes of this section unless..." ;
    cml:conclusionText "...the court is satisfied that the person is independent of the prosecutor and defendants, in a position to give a report to the court about what the person observes in relation to the giving of evidence by the witness, and reasonably available to observe the giving of evidence by the witness." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


