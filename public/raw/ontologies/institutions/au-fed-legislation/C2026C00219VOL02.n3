concept:crimes-act-1914-sec-16ab-ss-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prevents reading or considering victim impact statements under certain conditions." ;
    cml:premiseText "(5) A victim impact statement is not to be read to the court, or otherwise taken into account, to the extent that:  (a) it expresses an opinion about an appropriate sentence; or  (b) it is offensive, threatening, intimidating or harassing; or  (c) admitting it into evidence would otherwise not be in the interests of justice." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

