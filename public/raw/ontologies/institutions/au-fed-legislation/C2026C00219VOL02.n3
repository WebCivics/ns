    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Recurring trace of disclosure offences" ;
    cml:premiseText "(d) the conduct results in the disclosure of the operative’s identity or where the operative lives;" ;
    cml:conclusionText "The person commits an offence if..." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

