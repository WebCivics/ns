    cml:modality cml:Deontic ;
    cml:operator "Permission" ;
    cml:logicSummary "The court may pass a sentence if exceptional circumstances warrant it" ;
    cml:premiseText "(b) the person has not previously been sentenced to imprisonment for any federal, State or Territory offence;" ;
    cml:conclusionText "the court may pass a sentence if exceptional circumstances warrant it" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
