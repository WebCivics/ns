    cml:conclusionText "The person commits an offence if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-15ms-ss-1 cml:asserts concept:crimes-act-1914-sec-15ms-ss-1-logic-deontic-5 .
concept:crimes-act-1914-sec-15ms-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permission" ;
    cml:logicSummary "Permission for disclosure under certain conditions" ;
    cml:premiseText "(i) the conduct is required by section 15ML; (ii) the conduct is authorised by leave or by an order under section 15MM; (iii) the conduct is permitted under section 15MR;" ;
    cml:conclusionText "The person commits an offence if..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


