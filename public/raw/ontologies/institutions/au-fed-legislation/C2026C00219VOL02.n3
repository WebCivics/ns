    cml:modality cml:AllenInterval ;
    cml:operator "=" ;
    cml:logicSummary "The parole order or licence revocation and the person becoming liable to serve occur at the same time" ;
    cml:premiseText "(4) If the parole order or licence relating to a person is taken to have been revoked under subsection (1) or (2)," ;
    cml:conclusionText "the person becomes liable to serve" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
