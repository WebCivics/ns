    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prevents disclosure of sensitive information." ;
    cml:premiseText "(a) endanger a person’s safety; or (b) prejudice an investigation or prosecution;" ;
    cml:conclusionText "The chief officer must not include this information in the report." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

