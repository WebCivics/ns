    cml:asserts concept:crimes-act-1914-sec-23dc-ss-1-norm .
concept:crimes-act-1914-sec-23dc-ss-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-act-1914-sec-23dc-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-act-1914-sec-23dc-ss-1 cml:asserts concept:crimes-act-1914-sec-23dc-ss-1-logic-deontic-1 .
concept:crimes-act-1914-sec-23dc-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes a duty on the state to specify the period during which suspension or delay of questioning may be applied." ;
    cml:premiseText "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence." ;
    cml:conclusionText "The state must specify the period during which suspension or delay of questioning may be applied." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23dc-ss-1 cml:asserts concept:crimes-act-1914-sec-23dc-ss-1-logic-alleninterval-2 .
concept:crimes-act-1914-sec-23dc-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "During" ;
    cml:logicSummary "Specifies the temporal interval during which suspension or delay of questioning may be applied." ;
    cml:premiseText "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence." ;
    cml:conclusionText "The period during which suspension or delay of questioning may be applied starts when the person is arrested and ends when the investigation is completed." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23dc-ss-1 cml:asserts concept:crimes-act-1914-sec-23dc-ss-1-logic-ltl-3 .
concept:crimes-act-1914-sec-23dc-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Specifies the temporal interval until which suspension or delay of questioning may not be applied." ;
    cml:premiseText "(1) This section applies if:  (a) a person is arrested for a terrorism offence; and  (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence." ;
    cml:conclusionText "The period during which suspension or delay of questioning may not be applied starts when the investigation is completed and ends at the end of the relevant temporal interval." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23dc-ss-1 cml:asserts concept:crimes-act-1914-sec-23dc-ss-1-logic-diffusion-4 .
concept:crimes-act-1914-sec-23dc-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "If" ;
    cml:logicSummary "Specifies the conditions under which the obligation applies." ;
    cml:premiseText "(a) a person is arrested for a terrorism offence; and (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence." ;
    cml:conclusionText "The obligation applies if both conditions are met." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23dc-ss-1 cml:asserts concept:crimes-act-1914-sec-23dc-ss-1-logic-argumentation-5 .
concept:crimes-act-1914-sec-23dc-ss-1-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Therefore" ;
    cml:logicSummary "Draws a conclusion based on the premises." ;
    cml:premiseText "(a) a person is arrested for a terrorism offence; and (b) an investigation is being conducted into whether the person committed that terrorism offence or another terrorism offence." ;
    cml:conclusionText "The state must specify the period during which suspension or delay of questioning may be applied because both conditions are met." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


