concept:crimes-act-1914-sec-15yw-ss-5 cml:asserts concept:crimes-act-1914-sec-15yw-ss-5-logic-deontic-2 .
concept:crimes-act-1914-sec-15yw-ss-5-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "Observer must be reasonably available to observe evidence giving." ;
    cml:premiseText "(5) The court must not specify a person for the purposes of this section unless..." ;
    cml:conclusionText "...the court is satisfied that the person is independent of the prosecutor and defendants, and in a position to give a report to the court about what the person observes in relation to the giving of evidence by the witness." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

