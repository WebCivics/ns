concept:crimes-act-1914-sec-19am-ss-2 a cml:Concept ;
    skos:prefLabel "19AM(2) Release on parole—when is a person released"@en ;
    cml:realizedBy doc:sec-19am-ss-2 ;
    cml:integrityHash "d54dd93cf6ff5844bb72dbb340d93fdbd96525efa9534ace1b4f363bfeb0ff09" ;
    values:partOf concept:crimes-act-1914-sec-19am ;
    skos:note "A person must be released from prison on parole if imprisoned for a State or Territory offence on the day they would otherwise be eligible for release." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
    dc:source "crimes-act-1914.pdf, p.258" ;
    cml:asserts concept:crimes-act-1914-sec-19am-ss-2-norm .
