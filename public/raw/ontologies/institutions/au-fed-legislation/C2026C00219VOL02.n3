concept:crimes-act-1914-sec-15yw-ss-6-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implication" ;
    cml:logicSummary "Independence is not guaranteed by being an Australian diplomatic officer or consular officer." ;
    cml:premiseText "(6) For the purposes of this section, the mere fact that a person is an Australian diplomatic officer or Australian consular officer does not mean that the person is not independent of the prosecutor." ;
    cml:conclusionText "The person's independence is not guaranteed by their status." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-15yw-ss-6 cml:asserts concept:crimes-act-1914-sec-15yw-ss-6-logic-alleninterval-2 .
