concept:crimes-act-1914-sec-20ba-ss-1 cml:asserts concept:crimes-act-1914-sec-20ba-ss-1-logic-deontic-1 .
concept:crimes-act-1914-sec-20ba-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Court must dismiss charge and order release." ;
    cml:premiseText "(1) Where the court determines that there has not been established a prima facie case that the person committed the offence, the court must, by order, dismiss the charge against the person..." ;
    cml:conclusionText "...the court must, by order, dismiss the charge against the person and, if the person is in custody, order the release of the person from custody." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

