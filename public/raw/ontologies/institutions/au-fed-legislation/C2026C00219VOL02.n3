    values:partOf concept:crimes-act-1914-sec-23dc ;
    skos:note "Suspension or delay of questioning may be specified during an investigation into a terrorism offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-act-1914.pdf> ;
