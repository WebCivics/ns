concept:crimes-act-1914-sec-19ar-ss-1 a cml:Concept ;
    skos:prefLabel "19AR(1) Fixing of non-parole period etc. where parole or licence taken"@en ;
    cml:realizedBy doc:sec-19ar-ss-1 ;
