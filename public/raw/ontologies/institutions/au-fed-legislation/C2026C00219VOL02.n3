    cml:modality cml:LinearLogic ;
    cml:operator "∧" ;
    cml:logicSummary "The person's parole order or licence is both revoked and the person becomes liable to serve" ;
    cml:premiseText "(4) If the parole order or licence relating to a person is taken to have been revoked under subsection (1) or (2)," ;
    cml:conclusionText "the person becomes liable to serve" ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

