concept:crimes-act-1914-sec-23b-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligate" ;
    cml:logicSummary "Defines terms for Aboriginal legal assistance organisation, arrested person, and authorising officer." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23b cml:asserts concept:crimes-act-1914-sec-23b-logic-descriptionlogic-2 .
concept:crimes-act-1914-sec-23b-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Defines terms for Aboriginal legal assistance organisation" ;
    cml:premiseText "(Aboriginal legal assistance organisation means an organisation that is funded by the Commonwealth, a State or a Territory to provide legal assistance to Aboriginal persons and Torres Strait Islanders.)" ;
    cml:conclusionText "(Aboriginal legal assistance organisation) = (an organisation that is funded by the Commonwealth, a State or a Territory to provide legal assistance to Aboriginal persons and Torres Strait Islanders.)" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23b cml:asserts concept:crimes-act-1914-sec-23b-logic-descriptionlogic-3 .
concept:crimes-act-1914-sec-23b-logic-descriptionlogic-3 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Defines terms for arrested person" ;
    cml:premiseText "(arrested: a person is arrested if: (a) the person is arrested for a Commonwealth offence; and (b) the person’s arrest has not ceased under subsection (3) or (4); and (c) the person has not been released.)" ;
    cml:conclusionText "(arrested: a person is arrested if: (a) the person is arrested for a Commonwealth offence; and (b) the person’s arrest has not ceased under subsection (3) or (4); and (c) the person has not been released.)" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23b cml:asserts concept:crimes-act-1914-sec-23b-logic-descriptionlogic-4 .
concept:crimes-act-1914-sec-23b-logic-descriptionlogic-4 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Defines terms for authorising officer" ;
    cml:premiseText "(authorising officer, in relation to an investigating official, means: (a) if the investigating official is a member or special member of the Australian Federal Police—a person for the time being holding office or acting as: (i) the Commissioner; or (ii) a Deputy Commissioner; or (iii) a member or special member of the Australian Federal Police who is of the rank of superintendent or higher; or (b) if the investigating official is a member of the police force of a State or Territory—a person for the time being holding office or acting as: (i) the Commissioner or the person holding equivalent rank; or (ii) an Assistant Commissioner or a person holding equivalent rank; or (iii) a superintendent or a person holding equivalent rank; of the police force of that State or Territory.)" ;
    cml:conclusionText "(authorising officer, in relation to an investigating official, means: (a) if the investigating official is a member or special member of the Australian Federal Police—a person for the time being holding office or acting as: (i) the Commissioner; or (ii) a Deputy Commissioner; or (iii) a member or special member of the Australian Federal Police who is of the rank of superintendent or higher; or (b) if the investigating official is a member of the police force of a State or Territory—a person for the time being holding office or acting as: (i) the Commissioner or the person holding equivalent rank; or (ii) an Assistant Commissioner or a person holding equivalent rank; or (iii) a superintendent or a person holding equivalent rank; of the police force of that State or Territory.)" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-act-1914-sec-23b cml:asserts concept:crimes-act-1914-sec-23b-logic-descriptionlogic-5 .
concept:crimes-act-1914-sec-23b-logic-descriptionlogic-5 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Defines term for Commonwealth offence" ;
    cml:premiseText "(Commonwealth offence means: ...)" ;
    cml:conclusionText "(Commonwealth offence) = (...)" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


