concept:crimes-act-1914-sec-19aq-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "→" ;
    cml:logicSummary "If the parole order or licence is revoked, then the person becomes liable to serve" ;
    cml:premiseText "(4) If the parole order or licence relating to a person is taken to have been revoked under subsection (1) or (2)," ;
    cml:conclusionText "the person becomes liable to serve" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

