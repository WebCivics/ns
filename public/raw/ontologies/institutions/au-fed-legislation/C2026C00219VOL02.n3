    cml:modality cml:Deontic ;
    cml:operator "<=" ;
    cml:logicSummary "Period of effect must not exceed 3 months" ;
    cml:premiseText "(b) in the case of an urgent variation of authority—the lesser of: (i) 7 days; and (ii) a period that would result in the period of effect of the authority exceeding 3 months (including any previous extensions);" ;
    cml:conclusionText "(2) For the purposes of paragraph (1)(f), the period of the extension must not exceed:" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

