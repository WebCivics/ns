concept:crimes-act-1914-sec-15yw-ss-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "Court must ensure observer is independent." ;
    cml:premiseText "(5) The court must not specify a person for the purposes of this section unless..." ;
    cml:conclusionText "...the court is satisfied that the person is independent of the prosecutor and defendants." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
