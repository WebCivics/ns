    cml:operator "justification" ;
    cml:logicSummary "Justifying the authorisation" ;
    cml:premiseText "(2) A person identified in an authority as being authorised to engage in controlled conduct for the purposes of the controlled operation is authorised to do so..." ;
    cml:conclusionText "...for the period of effect of the authority..." ;
    cml:executionSurface "modalities::argumentation" ;
