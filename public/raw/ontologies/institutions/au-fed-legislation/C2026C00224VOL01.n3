    cml:modality cml:CogAI ;
    cml:operator "Classify" ;
    cml:logicSummary "Describes exempt disclosures using CogAI" ;
    cml:premiseText "(2) Section 277 does not prohibit a use of information or a document" ;
    cml:conclusionText "if: (a) the use is made for the purposes of, or in connection with, a disclosure of the information or document by the person; and (b) because of this Division, the disclosure is not prohibited by section 277." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


