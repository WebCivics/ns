concept:telecommunications-act-1997-sec-158a-ss-1 a cml:Concept ;
    skos:prefLabel "158A(1) Deemed local access lines"@en ;
    cml:realizedBy doc:sec-158a-ss-1 ;
    cml:integrityHash "6c04cd9983fc55475831f951291a6c2dd6c9ec2398c7427b80ed99754eccbb4d" ;
    values:partOf concept:telecommunications-act-1997-sec-158a ;
    skos:note "Local access line deemed to have come into existence on or after the designated commencement date if it was in existence immediately before and is extended on or after that date." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.288" ;
