    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Describes the temporal relationship between occupation and use" ;
    cml:premiseText "(a) occupies the property; or (b) uses the property for the purpose that is the sole or principal purpose for which the property is used." ;
    cml:conclusionText "The person who occupies the property during a certain period of time also uses it for its sole or principal purpose." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

