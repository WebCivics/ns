concept:telecommunications-act-1997-sec-155 a cml:Concept ;
    skos:prefLabel "155 When a person is in a position to exercise control of a network"@en ;
    cml:realizedBy doc:sec-155 ;
    cml:integrityHash "9f19af02888ee9bbdb7ef961196b9490db534edf7591fd854a175adf1211599b" ;
    skos:note "A person is in a position to exercise control of a telecommunications network if they meet certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
