concept:telecommunications-act-1997-sec-143f-ss-1 cml:asserts concept:telecommunications-act-1997-sec-143f-ss-1-logic-deontic-1 .
concept:telecommunications-act-1997-sec-143f-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes an obligation on the state to exempt certain lines" ;
    cml:premiseText "(a) a telecommunications network came into existence on or after 1 January 2011; and (b) a line came into existence on or after the designated commencement date for the purposes of connecting particular premises to the network;" ;
    cml:conclusionText "the line mentioned in paragraph (b) is exempt from section 142C" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

