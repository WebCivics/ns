concept:telecommunications-act-1997-sec-306a-ss-1 cml:asserts concept:telecommunications-act-1997-sec-306a-ss-1-logic-deontic-1 .
concept:telecommunications-act-1997-sec-306a-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "requires" ;
    cml:logicSummary "Requires authorisation for disclosure." ;
    cml:premiseText "(1) This section applies if:  (a) an eligible person or an eligible number-database person discloses information or a document; and  (b) the disclosure or disclosures are authorised by an authorisation under section 180 or 180B of the Telecommunications (Interception and Access) Act 1979 (in so far as the authorisation is of a kind referred to in subsection 180(2) or 180B(2) of that Act)." ;
    cml:conclusionText "(1) This section applies if:  (a) an eligible person or an eligible number-database person discloses information or a document; and  (b) the disclosure or disclosures are authorised by an authorisation under section 180 or 180B of the Telecommunications (Interception and Access) Act 1979 (in so far as the authorisation is of a kind referred to in subsection 180(2) or 180B(2) of that Act)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


