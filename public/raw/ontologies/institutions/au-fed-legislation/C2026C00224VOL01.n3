concept:telecommunications-act-1997-sec-284-ss-1-norm a values:Permission ;
    cml:modality cml:Deontic ;
    values:partOf concept:telecommunications-act-1997-sec-284-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:telecommunications-act-1997-sec-284-ss-1 cml:asserts concept:telecommunications-act-1997-sec-284-ss-1-logic-deontic-1 .
concept:telecommunications-act-1997-sec-284-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Permit" ;
    cml:logicSummary "Permission granted to disclose information or document." ;
    cml:premiseText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:conclusionText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-284-ss-1 cml:asserts concept:telecommunications-act-1997-sec-284-ss-1-logic-alleninterval-2 .
concept:telecommunications-act-1997-sec-284-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "During" ;
    cml:logicSummary "Disclosure made during ACMA's function execution." ;
    cml:premiseText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:conclusionText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-284-ss-1 cml:asserts concept:telecommunications-act-1997-sec-284-ss-1-logic-ltl-3 .
concept:telecommunications-act-1997-sec-284-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Disclosure allowed until ACMA's function execution ends." ;
    cml:premiseText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:conclusionText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-284-ss-1 cml:asserts concept:telecommunications-act-1997-sec-284-ss-1-logic-deontic-4 .
concept:telecommunications-act-1997-sec-284-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Allow" ;
    cml:logicSummary "Disclosure allowed under certain conditions." ;
    cml:premiseText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:conclusionText "(1) Sections 276 and 277 do not prohibit a disclosure by a person of information or a document if:  (a) the disclosure is made to, or to a member of the staff of, the ACMA; and  (b) the information or document may assist the ACMA to carry out its functions or powers." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-284-ss-1 cml:asserts concept:telecommunications-act-1997-sec-284-ss-1-logic-argumentation-5 .
