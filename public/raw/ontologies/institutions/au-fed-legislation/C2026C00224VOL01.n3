concept:telecommunications-act-1997-sec-143f-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Between" ;
    cml:logicSummary "Defines the temporal interval for exemption" ;
    cml:premiseText "(c) the coming into existence of the line enables or enabled the occupier of the premises to become a customer in relation to carriage services supplied using the line;" ;
    cml:conclusionText "the line mentioned in paragraph (b) is used to supply a superfast carriage service; and the line mentioned in paragraph (b) is exempt from section 142C" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

