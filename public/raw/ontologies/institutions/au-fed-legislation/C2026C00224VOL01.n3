    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Primary network's principal function is during the carriage service period." ;
    cml:premiseText "(b) the principal function of the primary network is to supply carriage services between customer equipment connected to the primary network and other such equipment;" ;
    cml:conclusionText "The primary network's principal function must be during the carriage service period for it to be exempt." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-32-ss-2 cml:asserts concept:telecommunications-act-1997-sec-32-ss-2-logic-ltl-4 .
concept:telecommunications-act-1997-sec-32-ss-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "until" ;
    cml:logicSummary "Primary network cannot be used in carrying a communication between equipment connected to network units and other such equipment until the carriage service period ends." ;
    cml:premiseText "(d) despite the connection or connections referred to in paragraph (a), the primary network cannot be used in carrying a communication, as a single transaction, between equipment connected to the network units and other such equipment;" ;
    cml:conclusionText "The primary network must not be used in carrying a communication until the carriage service period ends." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-32-ss-2 cml:asserts concept:telecommunications-act-1997-sec-32-ss-2-logic-deontic-5 .
concept:telecommunications-act-1997-sec-32-ss-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "permission" ;
    cml:logicSummary "Permits primary network to supply services between customer equipment and other such equipment for exemption purposes." ;
    cml:premiseText "(c) the supply of carriage services between such equipment and equipment connected to the network units is, at most, an ancillary function of the primary network;" ;
    cml:conclusionText "The primary network may supply services between customer equipment and other such equipment as an ancillary function for exemption purposes." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

