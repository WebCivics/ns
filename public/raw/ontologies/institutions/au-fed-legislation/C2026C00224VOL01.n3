concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes a duty on the state to treat the local access line as having come into existence on or after the designated commencement date." ;
    cml:premiseText "(a) a local access line was in existence immediately before the designated commencement date;" ;
    cml:conclusionText "the extension is taken to be a local access line in its own right;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-158a-ss-1 cml:asserts concept:telecommunications-act-1997-sec-158a-ss-1-logic-alleninterval-2 .
concept:telecommunications-act-1997-sec-158a-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Describes a temporal relationship between the designated commencement date and the date when the local access line was in existence immediately before." ;
    cml:premiseText "(a) a local access line was in existence immediately before the designated commencement date;" ;
    cml:conclusionText "the extension is taken to be a local access line in its own right;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-158a-ss-1 cml:asserts concept:telecommunications-act-1997-sec-158a-ss-1-logic-ltl-3 .
concept:telecommunications-act-1997-sec-158a-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Describes a temporal relationship between the designated commencement date and the date when the local access line was extended." ;
    cml:premiseText "(b) the line is extended on or after the designated commencement date;" ;
    cml:conclusionText "the extension is taken to be a local access line in its own right;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-158a-ss-1 cml:asserts concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-4 .
concept:telecommunications-act-1997-sec-158a-ss-1-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes a duty on the state to treat the local access line as having come into existence on or after the designated commencement date." ;
    cml:premiseText "(d) the local access line referred to in paragraph (c) is taken to have come into existence on or after the designated commencement date." ;
    cml:conclusionText "the extension is taken to be a local access line in its own right;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


