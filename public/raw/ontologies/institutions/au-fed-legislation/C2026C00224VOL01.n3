    cml:modality cml:Deontic ;
    values:partOf concept:telecommunications-act-1997-sec-295za-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:telecommunications-act-1997-sec-295za-ss-2 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-1 .
concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of disclosing or using information without permission." ;
    cml:premiseText "Information is disclosed to the person as permitted by subsection 295V(3) or 295W(2);" ;
    cml:conclusionText "The use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-2 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-2 .
concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of using or disclosing information for testing purposes." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-2 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-2-logic-alleninterval-3 .
concept:telecommunications-act-1997-sec-295za-ss-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Temporal relation between information disclosure and use." ;
    cml:premiseText "(2) A person commits an offence if:  (a) information is disclosed to the person as permitted by subsection 295V(3) or 295W(2); and  (b) the person uses or discloses the information;" ;
    cml:conclusionText "The temporal relation between information disclosure and use is that the use occurs after the disclosure." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-2 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-2-logic-ltl-4 .
concept:telecommunications-act-1997-sec-295za-ss-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Recurring trace of information disclosure and use." ;
    cml:premiseText "(2) A person commits an offence if:  (a) information is disclosed to the person as permitted by subsection 295V(3) or 295W(2); and  (b) the person uses or discloses the information;" ;
    cml:conclusionText "The recurring trace of information disclosure and use indicates that the person has committed an offence." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-2 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-5 .
concept:telecommunications-act-1997-sec-295za-ss-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of using or disclosing information for emergency purposes." ;
    cml:premiseText "(c) the use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency." ;
    cml:conclusionText "The use or disclosure referred to in paragraph (b) of this subsection is not for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


