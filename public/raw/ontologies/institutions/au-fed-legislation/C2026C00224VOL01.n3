    cml:premiseText "(1) If the Home Affairs Minister, after consulting the Prime Minister and the Minister administering this Act..." ;
    cml:conclusionText "The grant of a carrier licence occurs during the period where national security is at risk." ;
    cml:executionSurface "modalities::interval_reasoning" ;
