    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to supply service to public." ;
    cml:premiseText "(a) a carriage service is used to supply point-to-multipoint services to end-users; and (b) at least one end-user is outside the immediate circle of the supplier of the service;" ;
    cml:conclusionText "the service is supplied to the public." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
