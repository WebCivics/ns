    cml:modality cml:DescriptionLogic ;
    cml:operator "subclassOf" ;
    cml:logicSummary "Defines a subclass of 'carriage service' for exemption purposes." ;
    cml:premiseText "(2) For the purposes of this section, a carriage service is an exempt service if..." ;
    cml:conclusionText "The primary network must supply services between customer equipment and other such equipment for the carriage service to be exempt." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-32-ss-2 cml:asserts concept:telecommunications-act-1997-sec-32-ss-2-logic-alleninterval-3 .
