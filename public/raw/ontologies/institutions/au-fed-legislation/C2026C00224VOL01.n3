    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Defines the recurring nature of exemption" ;
    cml:premiseText "(d) the premises are in close proximity to a line that forms part of the infrastructure of the network as the network stood immediately before the designated commencement date;" ;
    cml:conclusionText "the line mentioned in paragraph (b) is used to supply a superfast carriage service; and the line mentioned in paragraph (b) is exempt from section 142C" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

