    cml:integrityHash "a7cecf9c70697176652943785ccc59ed75b382fd047c670d32825c0971f8bd58" ;
    values:partOf concept:telecommunications-act-1997-sec-284 ;
    skos:note "Disclosure of information or document to assist ACMA in carrying out its functions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
