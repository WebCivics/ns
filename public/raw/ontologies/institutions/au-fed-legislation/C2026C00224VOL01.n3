concept:telecommunications-act-1997-sec-295za-ss-1 a cml:Concept ;
    skos:prefLabel "295ZA(1) Offence—use or disclosure of information by other persons"@en ;
    cml:realizedBy doc:sec-295za-ss-1 ;
    cml:integrityHash "568a1e052d84544d915b427c28d8f08c8848d862427360380047d12d6b3a805a" ;
    values:partOf concept:telecommunications-act-1997-sec-295za ;
    skos:note "Disclosing or using information without permission is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-act-1997.pdf> ;
    dc:source "telecommunications-act-1997.pdf, p.328" ;
    cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-norm .
concept:telecommunications-act-1997-sec-295za-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:telecommunications-act-1997-sec-295za-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-deontic-1 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of disclosing or using information without permission." ;
    cml:premiseText "(a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and (b) the person uses or discloses the information;" ;
    cml:conclusionText "The use or disclosure referred to in paragraph (b) of this subsection is not for a purpose connected with persons being alerted to the emergency or likely emergency concerned." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-alleninterval-2 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Temporal interval of when the person uses or discloses the information." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The temporal interval is from the time the person receives the information to the time they use or disclose it." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-ltl-3 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring Trace" ;
    cml:logicSummary "Recurring trace of when the person uses or discloses the information." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The recurring trace is from the time the person receives the information to the present." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-diffusion-4 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Spread" ;
    cml:logicSummary "Spread of information through use or disclosure." ;
    cml:premiseText "(b) the person uses or discloses the information;" ;
    cml:conclusionText "The information spreads from the person to others through their actions." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-act-1997-sec-295za-ss-1 cml:asserts concept:telecommunications-act-1997-sec-295za-ss-1-logic-cogai-5 .
concept:telecommunications-act-1997-sec-295za-ss-1-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Knowledge Graph" ;
    cml:logicSummary "Knowledge graph of permitted and prohibited information." ;
    cml:premiseText "(a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and" ;
    cml:conclusionText "The knowledge graph contains entries for permitted and prohibited information." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


