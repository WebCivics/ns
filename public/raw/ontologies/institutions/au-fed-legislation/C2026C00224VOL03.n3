    values:partOf concept:telecommunications-act-1997-sch-1-sec-86 ;
    skos:note "Persons are not associates if they do not act together in relevant dealings and cannot exert influence over each other's business dealings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
