    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval for decision-making." ;
    cml:premiseText "A decision must be made within 25 business days or as specified by written notice." ;
    cml:conclusionText "The timeframe is between 25 business days and 35 business days." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

