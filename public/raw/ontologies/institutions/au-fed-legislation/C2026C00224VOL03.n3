    cml:modality cml:LTL ;
    cml:operator "RECURSIVE" ;
    cml:logicSummary "Recurring trace for decision-making." ;
    cml:premiseText "A decision must be made within a specified timeframe after receiving further information." ;
    cml:conclusionText "The decision-making process is recursive and depends on the receipt of further information." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

