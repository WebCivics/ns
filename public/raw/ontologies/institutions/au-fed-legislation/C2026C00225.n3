    cml:operator "Temporal relation" ;
    cml:logicSummary "Temporal relation between engagement and reprisal" ;
    cml:premiseText "When the conduct is engaged in, the first person believes or suspects that the second person has made a public interest disclosure" ;
    cml:conclusionText "The engagement occurs before the belief or suspicion of the second person making a public interest disclosure." ;
    cml:executionSurface "modalities::interval_reasoning" ;
