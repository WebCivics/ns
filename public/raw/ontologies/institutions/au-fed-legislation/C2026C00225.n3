    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Agency is prohibited from investigating disclosure." ;
    cml:premiseText "(a) decides under section 48 not to investigate the disclosure, or (b) does not decide to investigate the disclosure further; and (c) is satisfied, on reasonable grounds, that the conduct disclosed would be more appropriately investigated under another law or power." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

