concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Reckless conduct is an obligation." ;
    cml:premiseText "(a) the first person engages in conduct; and (b) engaging in the conduct consists of, or results in, a threat to cause detriment to the second person;" ;
    cml:conclusionText "The first person commits an offence if they engage in reckless conduct." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:public-interest-disclosure-act-2013-sec-19-ss-2 cml:asserts concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-2 .
concept:public-interest-disclosure-act-2013-sec-19-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Engaging in conduct with reckless disregard is an obligation." ;
    cml:premiseText "(d) when the conduct is engaged in, the first person believes or suspects that the second person, or any other person: (i) has made a public interest disclosure; or (ii) may have made a public interest disclosure;" ;
    cml:conclusionText "The first person's belief or suspicion of a public interest disclosure is an obligation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

