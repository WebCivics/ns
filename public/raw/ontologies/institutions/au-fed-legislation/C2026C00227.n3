concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-1 .
concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must pay overdue payment" ;
    cml:premiseText "(a) the provider has given the individual written notice of the borrower’s default that gave rise to the individual’s obligation to make the overdue payment; and (b) the notice requests that the individual pay the amount of the overdue payment;" ;
    cml:conclusionText "The individual must pay the overdue payment." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-2 .
concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must pay overdue payment after recovery attempts" ;
    cml:premiseText "(d) in addition to giving the notice, the provider has taken other steps to recover the amount of the overdue payment from the individual; and (e) the provider is not prevented by a statute of limitations from recovering the amount of the overdue payment." ;
    cml:conclusionText "The individual must pay the overdue payment after recovery attempts." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-epistemic-3 .
concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-epistemic-3 a cml:LogicApplication ;
    cml:modality cml:Epistemic ;
    cml:operator "CAN" ;
    cml:logicSummary "Can recover overdue payment" ;
    cml:premiseText "(e) the provider is not prevented by a statute of limitations from recovering the amount of the overdue payment." ;
    cml:conclusionText "The provider can recover the overdue payment." ;
    cml:executionSurface "modalities::epistemic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-ltl-4 .
