    cml:operator "overlaps" ;
    cml:logicSummary "Defines a temporal interval for 'subsequent publication' based on the definition of 'materially different'." ;
    cml:premiseText "(c) the manner of the subsequent publication is not materially different from the manner of the first publication." ;
    cml:conclusionText "The subsequent publication overlaps with the first publication in terms of time." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

