concept:entries-found-privacy-act-1988-sch-2-sec-26wf-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-26wf-ss-1 ;
    values:borneBy values:Agent ;
