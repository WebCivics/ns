    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of refusal to provide information or answer questions." ;
    cml:premiseText "The person is required to give information, answer a question, or produce a document or record under this Act." ;
    cml:conclusionText "The person contravenes subsection (1) if the person refuses or fails to do so." ;
    cml:executionSurface "modalities::logic::deontic" ;
