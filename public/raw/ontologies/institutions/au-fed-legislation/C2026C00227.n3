concept:entries-found-privacy-act-1988-sch-2-sec-20k-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits use or disclosure of credit reporting information during a ban period" ;
    cml:premiseText "The individual requests the body not to use or disclose the information under this Division." ;
    cml:conclusionText "The body shall not use or disclose the information." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
