concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-logic-deontic-2 .
concept:entries-found-privacy-act-1988-sch-2-sec-66-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of refusal to provide information or answer questions for corporations." ;
    cml:premiseText "(1AA) A person commits an offence if: the person is a corporation; and the person engages in conduct that constitutes a system of conduct or a pattern of behaviour; and the system of conduct or pattern of behaviour results in 2 or more contraventions of subsection (1)." ;
    cml:conclusionText "The person commits an offence if the person is a corporation and engages in conduct that constitutes a system of conduct or a pattern of behaviour." ;
    cml:executionSurface "modalities::logic::deontic" ;
