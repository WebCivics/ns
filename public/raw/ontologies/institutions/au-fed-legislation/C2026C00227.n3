concept:entries-found-privacy-act-1988-sch-2-sec-20k cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-20k-logic-alleninterval-2 .
concept:entries-found-privacy-act-1988-sch-2-sec-20k-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "During" ;
    cml:logicSummary "Restricts use or disclosure to a specific time period" ;
    cml:premiseText "(1) If: (a) a credit reporting body holds credit reporting information about an individual; and (b) the individual believes on reasonable grounds that the individual has been, or is likely to be, a victim of fraud (including identity fraud); and (c) the individual requests the body not to use or disclose the information under this Division;" ;
    cml:conclusionText "(1) If: (a) a credit reporting body holds credit reporting information about an individual; and (b) the individual believes on reasonable grounds that the individual has been, or is likely to be, a victim of fraud (including identity fraud); and (c) the individual requests the body not to use or disclose the information under this Division." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


