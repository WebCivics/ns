    cml:operator "Trace" ;
    cml:logicSummary "Traces disclosure of personal information over time." ;
    cml:premiseText "(1) A person (the first person) commits an offence if:  (a) personal information that relates to an individual is disclosed to the first person because of the operation of this Division; and  (b) the first person subsequently discloses the personal information." ;
    cml:conclusionText "Penalty: 60 penalty units or imprisonment for 1 year, or both." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

