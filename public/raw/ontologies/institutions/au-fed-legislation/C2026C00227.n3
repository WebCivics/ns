concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-deontic-1 .
concept:entries-found-privacy-act-1988-sch-2-sec-26xc-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits disclosure of personal information." ;
    cml:premiseText "(1) A person (the first person) commits an offence if:  (a) personal information that relates to an individual is disclosed to the first person because of the operation of this Division; and  (b) the first person subsequently discloses the personal information." ;
    cml:conclusionText "Penalty: 60 penalty units or imprisonment for 1 year, or both." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

