    cml:modality cml:CogAI ;
    cml:operator "⊆" ;
    cml:logicSummary "Knowledge representation" ;
    cml:premiseText "The knowledge representation of a reference to collection, use or disclosure outside Australia is a subset of the knowledge representation of a reference to collection, use or disclosure within Australia." ;
    cml:conclusionText "Then it has the same effect as if it were confined within Australia." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


