concept:entries-found-privacy-act-1988-sch-2-sec-26xf-ss-9 a cml:Concept ;
    skos:prefLabel "26XF(9) Additional operation of this Division"@en ;
    cml:realizedBy doc:sch-2-sec-26xf-ss-9 ;
    cml:integrityHash "c83d7eda2f126abf3b969c732f328542f557bc3c543f3c60952322504f6254c4" ;
    values:partOf concept:entries-found-privacy-act-1988-sch-2-sec-26xf ;
    skos:note "Reference to collection, use or disclosure outside Australia has the same effect as if it were confined within Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <entries-found-privacy-act-1988.pdf> ;
