    cml:conclusionText "The provider takes recurring recovery attempts." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2 cml:asserts concept:entries-found-privacy-act-1988-sch-2-sec-6q-ss-2-logic-deontic-5 .
