concept:australian-citizenship-act-2007-sec-22a-ss-1 cml:asserts concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-1 .
concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "The applicant must be an Australian citizen." ;
    cml:premiseText "The applicant is seeking to engage in an activity specified under subsection 22C(1)." ;
    cml:conclusionText "Therefore, the applicant needs to be an Australian citizen in order to engage in that activity." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-22a-ss-1 cml:asserts concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-2 .
concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "The applicant must have been present in Australia for a certain period of time." ;
    cml:premiseText "The applicant was seeking to engage in an activity specified under subsection 22C(1)." ;
    cml:conclusionText "Therefore, the applicant must have been present in Australia for at least 180 days during the period of 2 years immediately before the day the applicant made the application." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-22a-ss-1 cml:asserts concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-alleninterval-3 .
concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The applicant's presence in Australia overlaps with a certain time period." ;
    cml:premiseText "The applicant was present in Australia for a total of at least 90 days during the period of 12 months immediately before the day the applicant made the application." ;
    cml:conclusionText "Therefore, the applicant's presence in Australia overlaps with the period of 12 months immediately before the day the applicant made the application." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-22a-ss-1 cml:asserts concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-ltl-4 .
concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurrently" ;
    cml:logicSummary "The applicant was present in Australia repeatedly during a certain time period." ;
    cml:premiseText "The applicant was present in Australia for a total of at least 180 days during the period of 2 years immediately before the day the applicant made the application." ;
    cml:conclusionText "Therefore, the applicant was present in Australia repeatedly during the period of 2 years immediately before the day the applicant made the application." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-22a-ss-1 cml:asserts concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-5 .
concept:australian-citizenship-act-2007-sec-22a-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "The applicant must not be an unlawful non-citizen." ;
    cml:premiseText "The applicant was seeking to engage in an activity specified under subsection 22C(1)." ;
    cml:conclusionText "Therefore, the applicant must not have been present in Australia as an unlawful non-citizen at any time during the period of 2 years immediately before the day the applicant made the application." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


