concept:australian-citizenship-act-2007-sec-44-ss-1 cml:asserts concept:australian-citizenship-act-2007-sec-44-ss-1-logic-deontic-1 .
concept:australian-citizenship-act-2007-sec-44-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits unauthorized modification or impairment of identifying information." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person causes any unauthorised modification of identifying information; and  (b) the person intends to cause the modification; and  (c) the person knows that the modification is unauthorised." ;
    cml:conclusionText "Penalty: Imprisonment for 2 years, or 120 penalty units, or both." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

