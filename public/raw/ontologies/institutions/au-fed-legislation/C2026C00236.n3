    cml:modality cml:Deontic ;
    values:partOf concept:australian-citizenship-act-2007-sec-2a ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:australian-citizenship-act-2007-sec-2a cml:asserts concept:australian-citizenship-act-2007-sec-2a-logic-deontic-1 .
concept:australian-citizenship-act-2007-sec-2a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "You must be born in Australia and have one or both parents as Australian citizens or permanent residents to become a citizen automatically." ;
    cml:premiseText "You are born in Australia." ;
    cml:conclusionText "You become an Australian citizen." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-2a cml:asserts concept:australian-citizenship-act-2007-sec-2a-logic-alleninterval-2 .
concept:australian-citizenship-act-2007-sec-2a-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "You must be born before the commencement date to acquire citizenship automatically." ;
    cml:premiseText "The section commences on 04/06/2026." ;
    cml:conclusionText "You are born before the commencement date." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-2a cml:asserts concept:australian-citizenship-act-2007-sec-2a-logic-deontic-3 .
concept:australian-citizenship-act-2007-sec-2a-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "must" ;
    cml:logicSummary "You must be a permanent resident and willing to make a pledge of commitment to apply for citizenship by conferral." ;
    cml:premiseText "You need to be a permanent resident." ;
    cml:conclusionText "You can apply for citizenship by conferral." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-2a cml:asserts concept:australian-citizenship-act-2007-sec-2a-logic-deontic-4 .
concept:australian-citizenship-act-2007-sec-2a-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "must" ;
    cml:logicSummary "You must successfully complete a citizenship test to apply for citizenship by conferral." ;
    cml:premiseText "You need to be willing to make a pledge of commitment." ;
    cml:conclusionText "You can apply for citizenship by conferral." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


