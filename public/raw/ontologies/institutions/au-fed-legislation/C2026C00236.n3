    cml:modality cml:Deontic ;
    cml:operator "if-and-only-if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "(a) a parent of the person is an Australian citizen, or a permanent resident, at the time the person is born." ;
