concept:australian-citizenship-act-2007-sec-2a a cml:Concept ;
    skos:prefLabel "2A Simplified outline"@en ;
    cml:realizedBy doc:sec-2a ;
    cml:integrityHash "d995c7da238a2abcaa7cfa3f5786deab395959b0efb396f52b2e44b26dd3063f" ;
    skos:note "You become an Australian citizen automatically if you are born in Australia and one or both of your parents are Australian citizens or permanent residents when you are born." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-act-2007.pdf> ;
    dc:source "australian-citizenship-act-2007.pdf, p.8" ;
    cml:asserts concept:australian-citizenship-act-2007-sec-2a-norm .
