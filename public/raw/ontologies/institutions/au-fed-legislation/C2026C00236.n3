concept:australian-citizenship-act-2007-sec-9-ss-2 cml:asserts concept:australian-citizenship-act-2007-sec-9-ss-2-logic-deontic-1 .
concept:australian-citizenship-act-2007-sec-9-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Exclusion" ;
    cml:logicSummary "Exclude quashed convictions from prison confinement periods" ;
    cml:premiseText "(2) For the purposes of this Act, the period during which a person is confined to a prison does not include a period during which the person has been so confined by reason only of the person serving a sentence relating to a conviction that is later quashed." ;
    cml:conclusionText "The period of confinement in prison or psychiatric institution does not include a period during which the person has been so confined by reason only of the person serving a sentence relating to a conviction that is later quashed." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

