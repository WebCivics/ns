concept:australian-citizenship-act-2007-sec-145 cml:asserts concept:australian-citizenship-act-2007-sec-145-logic-deontic-1 .
concept:australian-citizenship-act-2007-sec-145-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "The Minister has an obligation to approve the applicant." ;
    cml:premiseText "The Minister is required to give approval before the offence can be committed." ;
    cml:conclusionText "The applicant cannot commit the offence until approved." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

