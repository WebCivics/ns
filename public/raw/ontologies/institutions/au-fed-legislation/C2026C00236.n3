concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "has" ;
    cml:logicSummary "Parent must be an Australian citizen." ;
    cml:premiseText "(a) a parent of the person was an Australian citizen at the time of the birth;" ;
    cml:conclusionText "The parent is an Australian citizen." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-16-2-ss-2 cml:asserts concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-2 .
concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "has" ;
    cml:logicSummary "Parent must have been present in Australia for at least 2 years." ;
    cml:premiseText "(ii) the parent has been present in Australia (except as an unlawful non-citizen) for a total period of at least 2 years at any time before the person made the application;" ;
    cml:conclusionText "The parent has been present in Australia for at least 2 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-16-2-ss-2 cml:asserts concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-3 .
concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "has" ;
    cml:logicSummary "Person must not be a national or citizen of any country." ;
    cml:premiseText "(ii) the person is not a national or a citizen of any country at the time the person made the application and the person has never been such a national or citizen;" ;
    cml:conclusionText "The person is not a national or citizen of any country." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-16-2-ss-2 cml:asserts concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-4 .
concept:australian-citizenship-act-2007-sec-16-2-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "has" ;
    cml:logicSummary "Person must be of good character." ;
    cml:premiseText "(c) if the person is or has ever been a national or citizen of any country, or if article 1(2)(iii) of the Stateless Persons Convention applies to the person, and the person is aged 18 or over at the time the person made the application—the Minister is satisfied that the person is of good character at the time of the Minister’s decision on the application." ;
    cml:conclusionText "The Minister is satisfied that the person is of good character." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

