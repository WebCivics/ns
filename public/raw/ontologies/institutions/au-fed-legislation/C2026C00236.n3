    cml:modality cml:DescriptionLogic ;
    cml:operator "IS_A" ;
    cml:logicSummary "The provision describes a condition for committing an offence." ;
    cml:premiseText "The provision states that the act or omission must be connected with the Minister's approval." ;
    cml:conclusionText "The provision defines a necessary condition for committing the offence." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-act-2007-sec-145 cml:asserts concept:australian-citizenship-act-2007-sec-145-logic-alleninterval-3 .
