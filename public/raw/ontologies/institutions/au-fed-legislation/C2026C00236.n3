    cml:modality cml:Deontic ;
    cml:operator "hasObligation" ;
    cml:logicSummary "General residence requirement is an obligation for permanent residency application" ;
    cml:premiseText "(1) Subject to this section, for the purposes of section 21 a person satisfies the general residence requirement if..." ;
    cml:conclusionText "...the person was present in Australia as a permanent resident for the period of 12 months immediately before the day the person made the application." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
